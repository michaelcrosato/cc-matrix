{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014r4b1VPGmvwSX8x7a3JBLh","type":"tool_result","content":"1\t// The TACTICS kit's game (an isometric battle on a map of heights: charge time or phases, facing, arcs, areas, a scoring AI), readable: the starter's shell (src/starter/00-shell.js), then\n2\t// the slice from line 159 (src/starter/47-tactics.js: its header says what it plays and how), then the start (90-start.js), as the\n3\t// single-file kit holds them between GAME START and GAME END. tactics.html plays it; node kits/test.mjs tactics runs it headless.\n4\t/* ============================== GAME START ==============================\n5\t * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n6\t * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n7\t * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n8\t * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n9\t * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n10\t * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n11\t * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n12\t * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n13\t * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n14\t * ======================================================================== */\n15\t(() => {\n16\t'use strict';\n17\tconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n18\t\n19\t/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n20\t * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\n21\tconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\n22\tconst P = game.particles, L = game.lights, A = game.audio;\n23\tconst scenes = {};\n24\tlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\n25\tconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n26\t// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n27\t// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\n28\tconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n29\t// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\n30\tconst SLICES = [\n31\t  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n32\t  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n33\t  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n34\t  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n35\t  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n36\t  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n37\t  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n38\t  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n39\t  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n40\t  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n41\t  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n42\t  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n43\t  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n44\t  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n45\t  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n46\t  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n47\t  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n48\t  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n49\t  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n50\t  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n51\t  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n52\t  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n53\t];\n54\t/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n55\t   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n56\t   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n57\t   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\n58\tconst camOpt = () => (game.scene && game.scene.camera) || {};\n59\taddEventListener('keydown', e => {\n60\t  if (e.repeat) return;\n61\t  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n62\t  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n63\t  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n64\t  else if (e.code === 'KeyM') A.mute();\n65\t  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n66\t});\n67\t\n68\t/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n69\t * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\n70\tconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n71\t  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\n72\tconst titleBg = new E.Backdrop('castle-night');\n73\tconst HEROES = [   // six heroes, each dressed with the HD rig options\n74\t  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n75\t  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n76\t  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n77\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n78\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n79\t  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n80\t];\n81\tHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n82\t// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\n83\tconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n84\t// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\n85\tconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n86\t/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n87\t * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n88\t * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n89\t * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n90\t * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\n91\tconst proof = (id, n, script, state, fresh) => {\n92\t  const was = Math.random, I = game.input, held = new Set();\n93\t  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n94\t  Math.random = E.rng(7);\n95\t  try {\n96\t    if (fresh) fresh();\n97\t    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n98\t    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n99\t    const s = JSON.stringify(state()); let h = 2166136261;\n100\t    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n101\t    return h >>> 0;\n102\t  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n103\t};\n104\t// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\n105\tconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n106\t// START picks too (the touch START, a pad's Start), as Enter does: any player's\n107\tconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n108\t/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n109\t *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\n110\tconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\n111\tlet titleMenu = null;   // (made at the start, once the file's slices are known)\n112\tscenes.title = {\n113\t  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n114\t  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n115\t  update(dt) {\n116\t    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n117\t    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n118\t    const t = game.time;\n119\t    HEROES.forEach((h, i) => {\n120\t      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n121\t      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n122\t    });\n123\t  },\n124\t  draw(r) {\n125\t    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n126\t    titleMenu.y = 76 + top;\n127\t    titleBg.draw(r);\n128\t    stage.draw(r);\n129\t    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n130\t    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n131\t    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n132\t    r.overlay(g => {\n133\t      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n134\t      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n135\t      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n136\t    });\n137\t    titleMenu.draw(r);\n138\t    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n139\t      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n140\t    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n141\t  }\n142\t};\n143\t\n144\t/* ---- GAME OVER: shared by every slice ---- */\n145\tconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\n146\tconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n147\t  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\n148\tscenes.over = {\n149\t  view: 'side', input: 'DEFAULT', res: 'ps1',\n150\t  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n151\t  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n152\t  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n153\t  draw(r) {   // centred on any screen\n154\t    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n155\t    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n156\t  }\n157\t};\n158\t\n159\t/* =====================================================================================\n160\t * SLICE 15  TACTICS  (Final Fantasy Tactics, Tactics Ogre, Shining Force, Fire Emblem). @modules grid story\n161\t * THE TAKING OF THORNWATCH: four heroes storm a hill fort held by the Ash Legion's five (Grimwald, the knight who leads\n162\t * them, at the gate; an archer on the wall; a mage on the tower; a priest in the yard; a thief out on the hills). An\n163\t * isometric map of heights (E.HEIGHTS.level, 8, a level): a unit walks MOVE cells, climbs and drops what its JUMP allows,\n164\t * and the river's shallows cost two. Blows land harder from the side (x1.25) and from behind (x1.5) and from higher\n165\t * ground (+8% a level). Turns come by speed (charge time: the order ahead is on the left) or, picked before the battle,\n166\t * by phases (every hero in the order you like, then every foe: Fire Emblem). A turn: MOVE and ACT once each, either\n167\t * first (ATTACK or the unit's skill), then WAIT and face a way. Bows arc over what stands between (map.arcClear) and\n168\t * reach further from up high; FIRE burns a diamond (friend and foe alike), VOLLEY rains on a cross, CURE heals one,\n169\t * BASH knocks a foe back a cell, CLEAVE cuts the three cells ahead. The Legion scores every place it can stand and every\n170\t * blow it can strike from there (the damage, a kill, a heal, the danger of the place: grid.threat). Win: the Legion falls.\n171\t * Lose: every hero falls.\n172\t * Keys: arrows / WASD move the cursor (the camera follows), Enter / Z confirm, Esc / X back (before acting, back undoes a\n173\t * move), Q and E turn the view a quarter, the wheel or - and = zoom. The mouse: the cursor follows the pointer\n174\t * (map.pick, the cell under it in every view and turn); a click confirms. TOUCH: a tap selects a unit, a tap on a blue\n175\t * cell moves there, a tap on a foe in range strikes; the command list's rows are a thumb's height; a finger dragging\n176\t * pans the camera, two pinch it; TURN turns the view.\n177\t * HOW IT WORKS: the map is a TileMap whose cells all stand on a base (the earth shows at its edges) at their heights; the\n178\t * grid is E.Grid.from(map, { tops: true }) with the shallows' cost; E.Turns ('ct') orders the turns, grid.reach the\n179\t * moves (allies passed through), grid.shape the areas, grid.side where a blow lands, grid.threat the AI's danger; E.Story\n180\t * runs the scene before the battle and its choice of the order. bot() lets the heroes' own AI play the battle\n181\t * (tools/kits-test.mjs). Deep links: #tactics/battle (no scene, charge time), #tactics/phases.\n182\t * ===================================================================================== */\n183\tconst TACTICS = (() => {\n184\t  const T = 16, LV = E.HEIGHTS.level, STEP = .16, BASE = 16;   // a cell; a level (8); a step's seconds; the ground's height\n185\t  // THORNWATCH's march: G major, a snare under a brave lead (the step sequencer's format)\n186\t  const SONG = { bpm: 112, steps: 4, tracks: [\n187\t    { wave: 'pulse25', vol: .11, notes: 'G4 - B4 - D5 - - - E5 - D5 - B4 - G4 - | A4 - - - B4 - C5 - D5 - - - . . . . | G4 - B4 - D5 - G5 - F#5 - E5 - D5 - B4 - | C5 - B4 - A4 - F#4 - G4 - - - . . . .' },\n188\t    { wave: 'triangle', vol: .28, notes: 'G2 - . . G2 . D3 . G2 - . . G2 . D3 . | D2 - . . D2 . A2 . D2 - . . D2 . A2 . | E2 - . . E2 . B2 . C3 - . . C3 . G2 . | D2 - . . D2 . A2 . G2 - . . G2 . . .' },\n189\t    { wave: 'drums', vol: .09, notes: 'k . h . s . h . k . h k s . h h' }] };\n190\t  // the fort (top left: the camera looks from the south east), its gate, the hills, the river's shallows (~) and its ford\n191\t  const ROWS = [\n192\t    'Bccce3221111....',\n193\t    'cbbbc2211.......',\n194\t    'cbbbc211....T...',\n195\t    'cbbbc11.....~~..',\n196\t    'cBaBc1.....~~...',\n197\t    '..a.......~~..T.',\n198\t    '.,,,,,...~~.....',\n199\t    '..T..,..~~...1..',\n200\t    '.....,.~~...122.',\n201\t    '.R...,~~....12..',\n202\t    '.....~~,,,,,....',\n203\t    '..T.~~.....,....',\n204\t    '...~~...T..,....',\n205\t    '..~~.......,....'];\n206\t  const GRASS = { top: '#5c8a3c', side: '#6a5034', face: 'rock', roof: 'grass' }, STONE = { top: '#8c8a90', side: '#6c6a78', face: 'stone', roof: 'slab' };\n207\t  const TYPES = { 1: { ...GRASS, h: BASE }, 2: { top: '#a88c5a', side: '#6a5034', face: 'rock', roof: '#9a7e52 noise', h: BASE }, 3: { top: '#3a72a8', side: '#5a4a34', face: 'rock', roof: '#3a6aa8 glaze', h: BASE - 6 },\n208\t    4: { ...GRASS, h: BASE + LV }, 5: { ...GRASS, h: BASE + 2 * LV }, 6: { ...GRASS, h: BASE + 3 * LV },\n209\t    7: { ...STONE, h: BASE + LV }, 8: { ...STONE, h: BASE + 2 * LV }, 9: { ...STONE, h: BASE + 3 * LV, face: 'brick' }, 10: { ...STONE, h: BASE + 5 * LV, face: 'brick', roof: 'cobble' } };\n210\t  const LEGEND = { '.': 1, ',': 2, '~': { tile: 3, floor: 'water' }, 1: 4, 2: 5, 3: 6, a: 7, b: 8, c: 9, e: 10, T: { tile: 1, block: true, spawn: 'tree' }, R: { tile: 1, block: true, spawn: 'rock' }, B: { tile: 9, block: true, spawn: 'banner' } };\n211\t\n212\t  /* ---- THE UNITS: stats, a look, two actions. kind: melee (a step's reach, two levels up or down at most), bow (an arc\n213\t   * over what is between; a cell further for each two levels higher), magic, heal. area: a grid.shape round the target\n214\t   * ([kind, n]; cone: along the way from the user) ---- */\n215\t  const ACTS = {\n216\t    sword:  { label: 'ATTACK', kind: 'melee', range: [1, 1], power: 1, anim: 'slash' },\n217\t    dagger: { label: 'ATTACK', kind: 'melee', range: [1, 1], power: .9, anim: 'thrust' },\n218\t    staff:  { label: 'ATTACK', kind: 'melee', range: [1, 1], power: .8, anim: 'overhead' },\n219\t    bow:    { label: 'ATTACK', kind: 'bow', range: [2, 4], power: 1, anim: 'throw' },\n220\t    bash:   { label: 'BASH', kind: 'melee', range: [1, 1], power: 1.2, mp: 4, push: true, anim: 'bash' },\n221\t    cleave: { label: 'CLEAVE', kind: 'melee', range: [1, 1], power: .9, mp: 5, area: ['cone', 2], anim: 'spin' },\n222\t    volley: { label: 'VOLLEY', kind: 'bow', range: [3, 5], power: .7, mp: 6, area: ['cross', 1], anim: 'throw' },\n223\t    fire:   { label: 'FIRE', kind: 'magic', range: [1, 4], power: 1.5, mp: 6, area: ['diamond', 1], anim: 'cast' },\n224\t    cure:   { label: 'CURE', kind: 'heal', range: [0, 3], power: 2, mp: 5, anim: 'rising' }\n225\t  };\n226\t  const ROSTER = [   // side, name, class, stats, its two actions, where it starts, its look\n227\t    { side: 'hero', name: 'ALDO', cls: 'PALADIN', hp: 54, mp: 10, atk: 13, def: 7, mag: 4, res: 4, speed: 95, move: 4, jump: 2, acts: ['sword', 'bash'], at: [11, 10],\n228\t      rig: { build: 'heroic', armor: true, hair: 'short', cape: { len: 5, width: 5, seg: 2.4 }, colors: { cloth: '#2c5cc0', cape: '#e8e4d8', capeIn: '#a8a090', hair: '#e0b050', trim: '#e8c860', metal: '#c8d0e0' } } },\n229\t    { side: 'hero', name: 'WREN', cls: 'RANGER', hp: 40, mp: 12, atk: 12, def: 4, mag: 4, res: 5, speed: 110, move: 4, jump: 3, acts: ['bow', 'volley'], at: [13, 10], bow: true,\n230\t      rig: { hood: true, outfit: 'tunic', weapon: null, sleeves: 'long', colors: { cloth: '#3a7a3a', pants: '#5a4a32', hair: '#8a4a2a', trim: '#c8a860', boot: '#4a3020' } } },\n231\t    { side: 'hero', name: 'SABLE', cls: 'MAGE', hp: 32, mp: 24, atk: 5, def: 3, mag: 14, res: 9, speed: 100, move: 3, jump: 2, acts: ['staff', 'fire'], at: [11, 12],\n232\t      rig: { outfit: 'robe', weapon: 'staff', sleeves: 'long', hair: 'long', hat: { style: 'pointed', color: '#2a2a6a' }, colors: { cloth: '#4a3ab0', pants: '#3a2e90', hair: '#e8e0f0', orb: '#ff9040', trim: '#f0c860' } } },\n233\t    { side: 'hero', name: 'LIORA', cls: 'CLERIC', hp: 36, mp: 24, atk: 6, def: 4, mag: 11, res: 10, speed: 100, move: 4, jump: 2, acts: ['staff', 'cure'], at: [13, 12],\n234\t      rig: { outfit: 'robe', weapon: 'staff', sleeves: 'long', hair: 'ponytail', hat: { style: 'band', color: '#c83a4a' }, colors: { cloth: '#f2eee2', pants: '#e2dccc', trim: '#c8a040', hair: '#6a3a24', orb: '#8affc0' } } },\n235\t    { side: 'foe', name: 'GRIMWALD', cls: 'KNIGHT', hp: 60, mp: 10, atk: 13, def: 8, mag: 3, res: 3, speed: 85, move: 3, jump: 1, acts: ['sword', 'cleave'], at: [2, 4], lead: true,\n236\t      rig: { build: 'bulky', size: 1.1, armor: true, hair: 'bald', hat: { style: 'helmet', color: '#4a4652' }, cape: { len: 6, width: 6, seg: 2.6 }, eyeGlow: '#ff6040', colors: { cloth: '#2e2a34', pants: '#3a3640', metal: '#6a6878', cape: '#a01c2c', capeIn: '#6a1020', trim: '#c89040', skin: '#12060c' } } },\n237\t    { side: 'foe', name: 'ARCHER', cls: 'ARCHER', hp: 30, mp: 0, atk: 10, def: 3, mag: 3, res: 3, speed: 105, move: 4, jump: 2, acts: ['bow'], at: [4, 3], bow: true,\n238\t      rig: { hood: true, outfit: 'tunic', weapon: null, sleeves: 'long', colors: { cloth: '#7a2a2a', pants: '#3a3036', hair: '#2a2024', trim: '#5a5a62', boot: '#2a2024' } } },\n239\t    { side: 'foe', name: 'MAGE', cls: 'MAGE', hp: 28, mp: 20, atk: 4, def: 2, mag: 12, res: 7, speed: 95, move: 3, jump: 2, acts: ['staff', 'fire'], at: [4, 0],\n240\t      rig: { outfit: 'robe', weapon: 'staff', sleeves: 'long', hair: 'bald', hat: { style: 'pointed', color: '#1a1420' }, colors: { cloth: '#2a2030', pants: '#221a28', trim: '#c83a3a', orb: '#ff4a2a', skin: '#c8b0a0' } } },\n241\t    { side: 'foe', name: 'PRIEST', cls: 'PRIEST', hp: 30, mp: 20, atk: 5, def: 3, mag: 9, res: 8, speed: 90, move: 3, jump: 2, acts: ['staff', 'cure'], at: [2, 2],\n242\t      rig: { outfit: 'robe', weapon: 'staff', hood: true, sleeves: 'long', colors: { cloth: '#5a5462', pants: '#4a4452', trim: '#a01c2c', orb: '#c8ffd8' } } },\n243\t    { side: 'foe', name: 'THIEF', cls: 'THIEF', hp: 30, mp: 0, atk: 10, def: 3, mag: 3, res: 3, speed: 125, move: 5, jump: 3, acts: ['dagger'], at: [8, 1],\n244\t      rig: { hood: true, outfit: 'tunic', bladeLen: 7, colors: { cloth: '#3a2a4a', pants: '#2a2232', hair: '#1a1420', trim: '#8a6a3a', boot: '#1e1824' } } }\n245\t  ];\n246\t  const PEOPLE = { aldo: 'ALDO', wren: 'WREN', sable: 'SABLE', liora: 'LIORA', grim: 'GRIMWALD' };\n247\t  // the scene before the battle (E.Story): each line looks at its speaker; its last choice sets the turn order\n248\t  const NODES = { intro: [\n249\t    { event: 'look', at: 'grim' },\n250\t    { who: 'grim', say: 'So the Crown sends {c=#8ad0ff}four{/c}. Thornwatch has stood a hundred years, little lord.', emote: 'dots' },\n251\t    { event: 'look', at: 'aldo' },\n252\t    { who: 'aldo', say: 'Then a hundred years is long enough. Open the gate, Grimwald.' },\n253\t    { event: 'look', at: 'grim' },\n254\t    { who: 'grim', say: '{shake}Legion! To the walls!{/shake}', emote: '!' },\n255\t    { event: 'look', at: 'liora' },\n256\t    { who: 'liora', say: 'Mind the archer on the wall. {w=.3}And keep out of the river: the shallows {c=#8ad0ff}slow{/c} you.' },\n257\t    { who: 'wren', say: 'From up there their bows reach further. {w=.2}So will mine, from the hill.' },\n258\t    { event: 'look', at: 'aldo' },\n259\t    { who: 'aldo', say: 'How shall we fight?', choices: [{ text: 'Each in turn, by speed', set: { order: 'ct' } }, { text: 'Side by side: phases', set: { order: 'phase' } }] }] };\n260\t\n261\t  let map = null, grid = null, story = null, turns = null, units = [], active = null, mode = 'scene', order = 'ct', cursor = [11, 10], look = [0, 0, 0], menuI = 0;\n262\t  let sel = null, pending = null, cells = null, queue = [], wait = 0, banner = null, msg = null, over = null, round = 1, phase = 'hero', left = [], auto = false, stats = null, hold = 0, held = null, ptr = null, base = null;\n263\t  const endMenu = new E.Menu(game, ['RETRY', 'TITLE'], { y: 0, onPick: i => i === 0 ? game.go('tactics', { part: 'battle' }, { fade: 'iris' }) : game.go('title') });\n264\t  const top = (cx, cy) => map.height(cx, cy), key = c => c[0] + ',' + c[1], same = (a, b) => a && b && a[0] === b[0] && a[1] === b[1];\n265\t  const living = side => units.filter(u => !u.dead && (!side || u.side === side)), unitAt = c => units.find(u => !u.dead && u.cx === c[0] && u.cy === c[1]) || null;\n266\t  const foesOf = u => living(u.side === 'hero' ? 'foe' : 'hero'), mates = u => living(u.side).filter(o => o !== u), cell = u => [u.cx, u.cy];\n267\t  const water = c => map.floorTags && map.floorTags[c[1] * map.w + c[0]] === 'water';\n268\t  const say = (s, c = '#fff2c4') => { msg = { s, c, t: 0 }; };\n269\t\n270\t  /* ---- 1. RULES: where a unit can go, what it can strike from where, how hard ---- */\n271\t  const moveOpts = u => ({ climb: u.jump * LV, drop: (u.jump + 1) * LV, blocked: (x, y) => foesOf(u).some(o => o.cx === x && o.cy === y), pass: (x, y) => mates(u).some(o => o.cx === x && o.cy === y) });\n272\t  const reachOf = u => grid.reach(cell(u), u.moved ? 0 : u.move, moveOpts(u));\n273\t  // the cells action a can be aimed at from cell c (each with a unit it touches, or any cell for an area)\n274\t  function aims(u, a, c) {\n275\t    const [lo, hi0] = a.range, h = top(...c), out = [];\n276\t    for (let y = c[1] - hi0 - 3; y <= c[1] + hi0 + 3; y++) for (let x = c[0] - hi0 - 3; x <= c[0] + hi0 + 3; x++) {\n277\t      if (!grid.inside([x, y])) continue;\n278\t      const d = grid.dist(c, [x, y]), dz = h - top(x, y), hi = a.kind === 'bow' ? hi0 + Math.max(0, Math.floor(dz / (2 * LV))) : hi0;\n279\t      if (d < lo || d > hi) continue;\n280\t      if (a.kind === 'melee' && Math.abs(dz) > 2 * LV) continue;\n281\t      if (a.kind === 'bow' && !arcs(c, [x, y])) continue;\n282\t      out.push([x, y]);\n283\t    }\n284\t    return out;\n285\t  }\n286\t  // an arrow's arc from a unit's chest over the tops between (map.arcClear: the core's jump arcs)\n287\t  const arcs = (a, b) => { const [ax, ay] = map.center(...a), [bx, by] = map.center(...b), d = Math.hypot(bx - ax, by - ay); return map.arcClear({ x: ax, y: ay, z: top(...a) + 16 }, { x: bx, y: by, z: top(...b) + 12 }, 8 + d * .25); };\n288\t  const area = (a, from, t) => a.area ? grid.shape(t, a.area[0], a.area[1], grid.face(from, t)).filter(c => !(a.area[0] === 'cone' && same(c, from))) : [t];\n289\t  const hitCells = (a, from, t) => a.area && a.area[0] === 'cone' ? grid.shape(from, 'cone', a.area[1], grid.face(from, t)) : area(a, from, t);\n290\t  // how hard a blows v from cell from: { amount, side, heal }\n291\t  function blow(u, a, from, v) {\n292\t    if (a.kind === 'heal') return { heal: true, amount: Math.min(v.max - v.hp, Math.round(u.mag * a.power)) };\n293\t    const side = a.kind === 'magic' ? 'front' : grid.side(cell(v), v.facing, from), dl = (top(...from) - top(v.cx, v.cy)) / LV;\n294\t    const raw = a.kind === 'magic' ? u.mag * a.power - v.res * .6 : u.atk * a.power - v.def * .7;\n295\t    return { side, amount: Math.max(1, Math.round(raw * (side === 'back' ? 1.5 : side === 'side' ? 1.25 : 1) * (1 + clamp(dl, -2, 3) * .08))) };\n296\t  }\n297\t\n298\t  /* ---- 2. THE AI: every place it can stop and every blow from there, scored; the best (the first of equals) wins ---- */\n299\t  function plan(u) {\n300\t    const foes = foesOf(u), reach = reachOf(u), heal = u.acts.map(id => ACTS[id]).find(a => a.kind === 'heal');\n301\t    const danger = grid.threat(foes.map(o => ({ cx: o.cx, cy: o.cy, move: o.move, range: ACTS[o.acts[0]].range, climb: o.jump * LV, drop: (o.jump + 1) * LV })), { blocked: (x, y) => living(u.side).some(o => o !== u && o.cx === x && o.cy === y) });\n302\t    const ranged = ACTS[u.acts[0]].kind === 'bow' || u.acts.some(id => ACTS[id].kind === 'magic');\n303\t    let best = null;\n304\t    for (const [cx, cy] of reach.cells) {\n305\t      const c = [cx, cy], near = Math.min(...foes.map(o => grid.dist(c, cell(o))));\n306\t      let pos = (top(cx, cy) - BASE) / LV * 1.2 - danger.count(c) * (u.hp < u.max * .4 ? 5 : 2.5) - (water(c) ? 2 : 0);\n307\t      if (heal) { const hurt = living(u.side).filter(o => o.hp < o.max * .7); pos -= hurt.length ? Math.min(...hurt.map(o => grid.dist(c, cell(o)))) * .8 : 0; }\n308\t      pos -= ranged ? Math.abs(near - 3) * 1.5 : near * 1.6;\n309\t      if (u.lead && near > 2) pos -= 3;   // (the knight holds his gate until they come)\n310\t      const take = s => { if (!best || s.score > best.score + 1e-9) best = s; };\n311\t      take({ cell: c, score: pos });\n312\t      if (u.acted) continue;\n313\t      for (const id of u.acts) {\n314\t        const a = ACTS[id]; if ((a.mp || 0) > u.mp) continue;\n315\t        for (const t of aims(u, a, c)) {\n316\t          let v = 0;\n317\t          for (const hc of hitCells(a, c, t)) {\n318\t            const o = same(hc, c) ? u : same(hc, cell(u)) ? null : unitAt(hc); if (!o || (o === u && a.kind !== 'heal')) continue;\n319\t            const b = blow(u, a, c, o), ally = o.side === u.side;\n320\t            if (b.heal) v += ally ? b.amount * 1.3 : -b.amount;\n321\t            else v += ally ? -b.amount * 1.6 : b.amount + (b.amount >= o.hp ? 25 + (o.lead ? 15 : 0) : 0);\n322\t          }\n323\t          if (v > 2) take({ cell: c, act: id, aim: t, score: pos + v * 2 });\n324\t        }\n325\t      }\n326\t    }\n327\t    return best;\n328\t  }\n329\t\n330\t  /* ---- 3. ORDERS: a move along its path, an action and its effects, the wait and its facing. The player's commands, the\n331\t   * AI and the bot all give these ---- */\n332\t  function march(u, to, done) {\n333\t    const p = grid.reach(cell(u), u.move, moveOpts(u)).path(to); if (p.length < 2) { done && done(); return; }\n334\t    u.from = cell(u); u.path = p; u.seg = 0; u.st = 0; u.after = done; A.sfx('step');\n335\t  }\n336\t  function act(u, id, t, done) {\n337\t    const a = ACTS[id], from = cell(u), fin = () => { acting--; if (done) done(); }; acting++; u.acted = true; u.mp -= a.mp || 0; u.facing = same(t, from) ? u.facing : grid.face(from, t);\n338\t    u.swing = new E.Attack(a.anim); u.swing.start(); A.sfx(a.kind === 'magic' || a.kind === 'heal' ? 'charge' : 'swing');\n339\t    const land = () => {\n340\t      const hit = hitCells(a, from, t), [tx, ty] = map.center(...t), tz = top(...t);\n341\t      if (a.kind === 'magic') { for (const c of hit) { const [x, y] = map.center(...c); P.fire(x, y, top(...c) + 4, 8, { speed: 50 }); P.smoke(x, y, top(...c) + 8, 2); } A.sfx('explode', { vol: .5 }); game.shake(3); }\n342\t      if (a.kind === 'heal') { P.glints(tx, ty, tz + 14, 14, '#8affc0', 14); P.ring(tx, ty, 4, 16, '#8affc0', .5, tz); A.sfx('heal'); }\n343\t      for (const c of hit) {\n344\t        const v = same(c, from) && a.kind !== 'heal' ? null : unitAt(c); if (!v) continue;\n345\t        const b = blow(u, a, from, v), [x, y] = map.center(v.cx, v.cy), z = top(v.cx, v.cy);\n346\t        if (b.heal) { v.hp += b.amount; P.text(x, y, z + 30, '+' + b.amount, '#8affc0', { bounce: true }); continue; }\n347\t        v.hp -= b.amount; v.hit = .3; stats.dealt[u.name] = (stats.dealt[u.name] || 0) + b.amount;\n348\t        game.hitFx(x, y, z + 14, { damage: b.amount, power: b.side === 'back' ? 1.5 : 1, angle: Math.atan2(u.facing[1], u.facing[0]), textColor: v.side === 'hero' ? '#ff9a8a' : '#fff2c4', sound: a.kind === 'magic' ? false : 'hit' });\n349\t        if (b.side !== 'front') P.text(x, y, z + 40, b.side === 'back' ? 'BACK!' : 'SIDE', '#ffd040');\n350\t        if (a.push && v.hp > 0) push(u, v);\n351\t        if (v.hp <= 0) fall(v);\n352\t      }\n353\t      check();\n354\t    };\n355\t    if (a.kind === 'bow') game.after(.2, () => { arrows.push({ a: [u.x, u.y, top(...from) + 18], b: [...map.center(...t), top(...t) + 12], t: 0, dur: .32 + grid.dist(from, t) * .04, then: () => { land(); game.after(.35, fin); } }); A.sfx('whoosh'); });\n356\t    else game.after(a.kind === 'magic' ? .55 : .22, () => { land(); game.after(.5, fin); });\n357\t  }\n358\t  const arrows = []; let acting = 0;\n359\t  // BASH: the foe goes back a cell, falling to a lower one (hurt by the drop), or slams into what is there\n360\t  function push(u, v) {\n361\t    const d = grid.face(cell(u), cell(v)), to = [v.cx + d[0], v.cy + d[1]];\n362\t    if (grid.walk(to) && !unitAt(to) && top(...to) <= top(v.cx, v.cy) + LV / 2) {\n363\t      const drop = Math.max(0, Math.floor((top(v.cx, v.cy) - top(...to)) / LV)); v.from = cell(v); v.cx = to[0]; v.cy = to[1]; v.path = [v.from, to]; v.seg = 0; v.st = 0; v.after = null;\n364\t      if (drop) { v.hp -= drop * 3; game.after(.2, () => P.text(v.x, v.y, top(v.cx, v.cy) + 30, drop * 3, '#ffb070')); }\n365\t    } else { v.hp -= 4; game.after(.15, () => P.text(v.x, v.y, top(v.cx, v.cy) + 30, 'SLAM 4', '#ffb070')); }\n366\t  }\n367\t  function fall(v) {\n368\t    v.dead = true; v.die = 0; v.hp = 0; left = left.filter(o => o !== v); if (turns) turns.remove(v);\n369\t    P.dust(v.x, v.y, top(v.cx, v.cy), 10); A.sfx('die'); say(v.name + ' FALLS', v.side === 'hero' ? '#ff8a8a' : '#a8e0a0');\n370\t  }\n371\t  function check() {\n372\t    if (over) return;\n373\t    const won = !living('foe').length, lost = !living('hero').length; if (!won && !lost) return;\n374\t    over = { won, t: 0 }; queue = []; mode = 'over'; A.sfx(won ? 'powerup' : 'die'); if (won) A.music(null);\n375\t  }\n376\t\n377\t  /* ---- 4. TURNS: charge time (E.Turns 'ct': the fastest acts first, a turn of less costs less) or phases ---- */\n378\t  function nextTurn() {\n379\t    if (over) return;\n380\t    let u;\n381\t    if (order === 'ct') u = turns.next();\n382\t    else {\n383\t      if (!left.length) { phase = phase === 'hero' ? 'foe' : 'hero'; if (phase === 'hero') round++; left = living(phase); banner = { s: phase === 'hero' ? 'PLAYER PHASE' : 'ENEMY PHASE', t: 0, c: phase === 'hero' ? '#8ad0ff' : '#ff8a7a' }; }\n384\t      u = left[0];\n385\t    }\n386\t    if (!u) return;\n387\t    active = u; u.moved = u.acted = false; u.at0 = cell(u); u.mp = Math.min(u.mmp, u.mp + 2); cursor = cell(u); aimLook(cursor); stats.turns++;\n388\t    if (order === 'ct') banner = { s: u.name + \"'S TURN\", t: 0, c: u.side === 'hero' ? '#8ad0ff' : '#ff8a7a' };\n389\t    if (u.side === 'hero' && !auto) { mode = 'command'; menuI = u.moved ? 1 : 0; A.sfx('blip'); }\n390\t    else { mode = 'ai'; aiTurn(u); }\n391\t  }\n392\t  // the end of a unit's turn: its cost to its charge (100 a move and an act, 80 one, 60 neither), then the next\n393\t  function endTurn(u, face) {\n394\t    if (over) return;\n395\t    if (face) u.facing = face;\n396\t    if (order === 'ct') turns.done(u, 60 + (u.moved ? 20 : 0) + (u.acted ? 20 : 0)); else left = left.filter(o => o !== u);\n397\t    mode = 'busy'; sel = null; cells = null; queue.push([.25, nextTurn]);\n398\t  }\n399\t  // the AI's turn, a beat at a time: the cursor to where it goes, the move, the cursor to its target, the blow, its facing\n400\t  function aiTurn(u) {\n401\t    const p = plan(u) || { cell: cell(u) }, foes = foesOf(u);\n402\t    queue.push([.35, () => { cursor = p.cell; aimLook(p.cell); }]);\n403\t    queue.push([.25, () => { if (!same(p.cell, cell(u))) { u.moved = true; march(u, p.cell, () => { if (!over) mode = 'ai'; }); mode = 'anim'; } }]);\n404\t    if (p.act) {\n405\t      queue.push([.3, () => { cursor = p.aim; cells = hitCells(ACTS[p.act], p.cell, p.aim); }]);\n406\t      queue.push([.35, () => { cells = null; mode = 'anim'; act(u, p.act, p.aim, () => { if (!over) mode = 'ai'; }); }]);\n407\t    }\n408\t    queue.push([.3, () => { const f = foes.filter(o => !o.dead).sort((a, b) => grid.dist(cell(u), cell(a)) - grid.dist(cell(u), cell(b)))[0]; endTurn(u, f ? grid.face(cell(u), cell(f)) : u.facing); }]);\n409\t  }\n410\t\n411\t  /* ---- 5. THE BATTLE ---- */\n412\t  function build() {\n413\t    map = new E.TileMap({ rows: ROWS, legend: LEGEND, types: TYPES, ao: 0, outside: false, shimmer: false, floorTex: () => [0, 0, 0] });\n414\t    grid = E.Grid.from(map, { tops: true, cost: (x, y) => water([x, y]) ? 2 : 1 });\n415\t  }\n416\t  const rigOf = r => new E.Humanoid(Object.assign({ size: 1 }, r));\n417\t  function start(data) {\n418\t    if (!map) build();\n419\t    const part = data && data.part; order = part === 'phases' ? 'phase' : 'ct'; auto = !!(data && data.auto);\n420\t    units = ROSTER.map((d, i) => { const [x, y] = map.center(...d.at); return Object.assign({}, d, { id: i, cx: d.at[0], cy: d.at[1], x, y, z: top(...d.at), max: d.hp, mmp: d.mp, facing: d.side === 'hero' ? [-1, 0] : [1, 0], rig: rigOf(d.rig), swing: null, hit: 0, dead: false, die: 0, path: null }); });\n421\t    units.forEach(u => { if (u.side === 'foe') u.facing = grid.face(cell(u), [12, 11]); });\n422\t    turns = new E.Turns(units, { mode: 'ct' }); active = null; over = null; queue = []; wait = 0; banner = null; msg = null; round = 0; phase = 'foe'; left = []; cells = null; sel = null; arrows.length = 0;\n423\t    stats = { turns: 0, dealt: {} }; base = null; acting = 0;\n424\t    const g = units.find(u => u.lead); cursor = cell(g); aimLook(cursor); game.cam.snap = true; game.cam.bounds = null; L.enabled = false; A.music(SONG); game.input.steer = 'drag';\n425\t    const people = {}; for (const k in PEOPLE) { const u = units.find(o => o.name === PEOPLE[k]); people[k] = { name: u.name, portrait: u.rig, at: Object.assign(u, { h: 32 }) }; }\n426\t    story = new E.Story(game, { people, nodes: NODES, vars: { order: 'ct' }, on: { look(s, st) { const u = people[st.at].at; cursor = cell(u); aimLook(cursor); } } });\n427\t    if (part) begin(); else { mode = 'scene'; story.run('intro', { onDone: () => { order = story.get('order') || 'ct'; begin(); } }); }\n428\t  }\n429\t  function begin() { mode = 'busy'; banner = { s: order === 'ct' ? 'BATTLE!' : 'BATTLE! BY PHASES', t: 0, c: '#ffe070' }; A.sfx('confirm'); queue.push([.9, nextTurn]); }\n430\t  // the camera looks at a cell's top (the cursor, a speaker, the unit whose turn it is)\n431\t  const aimLook = c => { const [x, y] = map.center(...c); look = [x, y, top(...c)]; };\n432\t\n433\t  /* ---- 6. THE PLAYER: a command list, then a cell to move to or a target, then a way to face ---- */\n434\t  const skillOf = u => ACTS[u.acts[1]];\n435\t  const rows = u => {\n436\t    const sk = skillOf(u), out = [{ id: 'move', label: 'MOVE', off: u.moved }, { id: 'act', act: u.acts[0], label: ACTS[u.acts[0]].label, off: u.acted }];\n437\t    if (sk) out.push({ id: 'act', act: u.acts[1], label: sk.label, note: sk.mp + ' MP', off: u.acted || u.mp < sk.mp });\n438\t    if (order === 'phase') out.push({ id: 'end', label: 'END PHASE' });\n439\t    out.push({ id: 'wait', label: 'WAIT' }); return out;\n440\t  };\n441\t  function command(r) {\n442\t    const u = active; if (!r || r.off) { A.sfx('bump'); return; }\n443\t    A.sfx('confirm');\n444\t    if (r.id === 'move') { mode = 'move'; cells = reachOf(u).cells.map(c => [c[0], c[1]]); cursor = cell(u); }\n445\t    else if (r.id === 'act') { mode = 'target'; pending = r.act; cells = aims(u, ACTS[r.act], cell(u)); const t = cells.find(c => { const o = unitAt(c); return o && (ACTS[r.act].kind === 'heal' ? o.side === u.side : o.side !== u.side); }); cursor = t || cell(u); }\n446\t    else if (r.id === 'wait') { mode = 'face'; cells = grid.neighbours(cell(u)); const f = foesOf(u).sort((a, b) => grid.dist(cell(u), cell(a)) - grid.dist(cell(u), cell(b)))[0]; u.facing = f ? grid.face(cell(u), cell(f)) : u.facing; cursor = cell(u); }\n447\t    else if (r.id === 'end') { for (const h of left.slice()) if (h !== u) left = left.filter(o => o !== h); endTurn(u); }\n448\t  }\n449\t  // confirm on cell c: what it means in each mode (a key, a click, a tap)\n450\t  function confirmAt(c) {\n451\t    const u = active;\n452\t    if (mode === 'move') {\n453\t      if (!cells.some(k => same(k, c))) { A.sfx('bump'); return; }\n454\t      if (same(c, cell(u))) { mode = 'command'; cells = null; return; }\n455\t      u.moved = true; cells = null; mode = 'anim'; A.sfx('confirm'); march(u, c, () => { mode = 'command'; menuI = rows(u).findIndex(r => !r.off); });\n456\t    } else if (mode === 'target') {\n457\t      if (!cells.some(k => same(k, c)) || (!ACTS[pending].area && !unitAt(c))) { A.sfx('bump'); return; }\n458\t      cells = null; mode = 'anim'; act(u, pending, c, () => { mode = over ? 'over' : 'command'; menuI = rows(u).findIndex(r => !r.off); });\n459\t    } else if (mode === 'face') {\n460\t      if (!same(c, cell(u))) u.facing = grid.face(cell(u), c);\n461\t      A.sfx('confirm'); endTurn(u);\n462\t    } else if (mode === 'command') {\n463\t      const o = unitAt(c); sel = o;\n464\t      if (o && order === 'phase' && o.side === 'hero' && left.includes(o) && o !== u && !u.moved && !u.acted) { active = o; o.moved = o.acted = false; o.at0 = cell(o); A.sfx('blip'); }   // phases: any hero who hasn't gone"}]},"parent_tool_use_id":null,"session_id":"2ba7a3b6-c05c-41f2-add8-99edaaa21587","uuid":"1eda568a-7cc1-42d6-bc8c-1bbb6d83661b","timestamp":"2026-11-04T12:03:42.339Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build--20261104-050223--x7910ab-work/2ba7a3b6-c05c-41f2-add8-99edaaa21587/tool-results/bvyyh32d1.txt","content":"// The TACTICS kit's game (an isometric battle on a map of heights: charge time or phases, facing, arcs, areas, a scoring AI), readable: the starter's shell (src/starter/00-shell.js), then\n// the slice from line 159 (src/starter/47-tactics.js: its header says what it plays and how), then the start (90-start.js), as the\n// single-file kit holds them between GAME START and GAME END. tactics.html plays it; node kits/test.mjs tactics runs it headless.\n/* ============================== GAME START ==============================\n * MY-3D2DGE STARTER: a title menu and vertical slices, one per genre (a genre kit file holds one; the file with every\n * slice adds an animation lab). Each slice is a complete small game, written to be copied and changed: its own header\n * (below this shell) says what it plays, its keys and touch controls, its deep links and how it works.\n * FULL SCREEN, ANY SHAPE: res: 'ps1', expand: true. 320 x 240 is the least the screen shows; a wider or taller window\n * shows more world (r.W x r.H grows), so every HUD anchors to r.W and r.H, never to 320 and 240, and every level fills\n * what a wide screen or an upright phone shows. Prompts name the player's own keys: prompt('attack', 'Sword').\n * To make your own game: change the slice closest to your genre into yours, with its own title, play and game-over\n * scenes, and delete this menu and the slices you do not use; this shell (the game, its scenes, prompt, best and the\n * proof) stays unless you replace it. Deep links: #<slice> starts a slice, #<slice>/<part> jumps into a part.\n * ======================================================================== */\n(() => {\n'use strict';\nconst E = My3D2dge, { px, clamp, lerp, approach, TAU } = E;\n\n/* ---- SHELL: one game, several scenes. Each slice switches view, keys and resolution on entry ----\n * expand: the picture fills the window, any shape, with no bars: at least 320 x 240 (a slice's res), more on the long side */\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, view: 'side', bg: '#07060d' });\nconst P = game.particles, L = game.lights, A = game.audio;\nconst scenes = {};\nlet gpu = null;                               // WebGPU lighting, used by the adventure slice only\nconst best = (k, v) => { const old = E.store.get('best:' + k, 0); if (v > old) E.store.set('best:' + k, v); return Math.max(old, v); };\n// a prompt in the player's own controls, after rebinding: 'J Sword' on a keyboard, 'X Sword' on a pad, 'ATTACK Sword' (the\n// button's name) on a touch screen, where the buttons sit over the bottom corner: touch() says so, to move a prompt off it\nconst prompt = (a, word) => game.input.label(a) + ' ' + word, touch = () => game.input.lastDevice === 'touch';\n// each slice: its scene's id, its title entry, a line about it, and its family (the title groups them under it)\nconst SLICES = [\n  { id: 'adventure', label: 'ADVENTURE', about: 'TOP-DOWN ACTION ADVENTURE', family: 'ACTION ADVENTURE' },\n  { id: 'pointclick', label: 'POINT-AND-CLICK', about: 'RELIGHT THE LIGHTHOUSE ON GULL ROCK', family: 'ADVENTURE' },\n  { id: 'platformer', label: 'PLATFORMER', about: 'SIDE-SCROLLING PLATFORMER', family: 'PLATFORM' },\n  { id: 'metroidvania', label: 'METROIDVANIA', about: 'A WORLD OF ROOMS, ITS MAP, ITS GATES', family: 'PLATFORM' },\n  { id: 'brawler', label: 'BRAWLER', about: 'SIDE-SCROLLING BEAT-EM-UP', family: 'FIGHTING' },\n  { id: 'fighting', label: 'FIGHTING', about: 'ONE ON ONE, BEST OF THREE', family: 'FIGHTING' },\n  { id: 'shooter', label: 'SHOOTER', about: 'VERTICAL SHOOT-EM-UP', family: 'ARCADE' },\n  { id: 'arcade', label: 'ARCADE', about: 'A CABINET OF THREE CLASSICS', family: 'ARCADE' },\n  { id: 'pinball', label: 'PINBALL', about: 'ONE TABLE: RAMP, MULTIBALL, JACKPOT', family: 'ARCADE' },\n  { id: 'kart', label: 'KART', about: 'MODE 7 KARTS, THREE LAPS', family: 'RACING' },\n  { id: 'road', label: 'ROAD', about: 'A COAST ROAD AGAINST THE CLOCK', family: 'RACING' },\n  { id: 'puzzle', label: 'PUZZLE', about: 'FALLING BLOCKS AND FALLING PAIRS', family: 'PUZZLE' },\n  { id: 'rhythm', label: 'RHYTHM', about: 'STEP UP! FOUR LANES, TWO SONGS', family: 'MUSIC' },\n  { id: 'rpg', label: 'RPG', about: 'A JOURNEY: TOWN, WORLD, CAVE, BATTLES', family: 'RPG' },\n  { id: 'roguelike', label: 'ROGUELIKE', about: 'A CRYPT OF TEN GENERATED FLOORS', family: 'RPG' },\n  { id: 'tactics', label: 'TACTICS', about: 'TAKE THE HILL FORT, TURN BY TURN', family: 'STRATEGY' },\n  { id: 'rts', label: 'RTS', about: 'GATHER GOLD, RAISE AN ARMY, BURN THEIR CAMP', family: 'STRATEGY' },\n  { id: 'artillery', label: 'ARTILLERY', about: 'TWO TEAMS OF THREE ON AN ISLAND THAT BLOWS APART', family: 'STRATEGY' },\n  { id: 'sim', label: 'SIM', about: 'BUILD A THEME PARK, KEEP THEM SMILING', family: 'SIMULATION' },\n  { id: 'stealth', label: 'STEALTH', about: 'ROOFTOP STEALTH AND PARKOUR', family: 'ACTION ADVENTURE' },\n  { id: 'sports', label: 'SPORTS', about: 'TWO AGAINST TWO IN THE CAGE', family: 'SPORTS' },\n  { id: 'animlab', label: 'ANIMATION LAB', about: 'EVERY MOVE, SKIN AND VIEW', family: 'TOOLS' }\n];\n/* the camera: each slice's scene says how the player may zoom it, camera: { zoom: [min, max] | false, start, tall }: the\n   engine zooms it with the mouse wheel, - and =, a pinch on a phone and Settings, Camera zoom (the player's own, kept, on\n   top of the slice's start: tall on a phone held upright). Keys every slice shares besides: V changes the camera view,\n   [ and ] turn it (camera.rotate), 0 resets it (the player's zoom too), G toggles GPU lighting, M mutes */\nconst camOpt = () => (game.scene && game.scene.camera) || {};\naddEventListener('keydown', e => {\n  if (e.repeat) return;\n  if (e.code === 'KeyV') { game.nextView(); game.note(game.view.label.toUpperCase() + ' VIEW'); }\n  else if (e.code === 'Digit0') { game.settings.set('zoom', 1); game.resetCamera(); game.note('CAMERA RESET'); }   // (resetCamera draws it at once)\n  else if ((e.code === 'BracketLeft' || e.code === 'BracketRight') && camOpt().rotate) { game.rotateView(e.code === 'BracketLeft' ? -45 : 45); game.note('TURN ' + game.yaw); }\n  else if (e.code === 'KeyM') A.mute();\n  else if (e.code === 'KeyG' && gpu) gpu.enabled = !gpu.enabled;\n});\n\n/* ---- TITLE: a lineup of HD heroes on a torch-lit castle ledge under a dusk sky. The ledge is wide enough for a wide\n * screen and sits on the screen's bottom edge whatever its height; the logo and menu hang from the top ---- */\nconst MID = 480, stage = new E.PlatformMap({ rows: ['S'.repeat(60), 'S'.repeat(60)], legend: { S: 1 },\n  types: { 1: { style: 'stone', side: '#6a5a78', moss: '#4a6a3a' } }, edges: 'open' });\nconst titleBg = new E.Backdrop('castle-night');\nconst HEROES = [   // six heroes, each dressed with the HD rig options\n  { face: 0, rig: new E.Humanoid({ size: 1.25, build: 'heroic', armor: true, hair: 'short', cape: { len: 6, width: 6, seg: 2.6 }, colors: { cloth: '#3a5ab0', cape: '#b02a3a', capeIn: '#5a1020', hair: '#e0b050', trim: '#e8c860' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.25, outfit: 'tunic', hair: 'spiky', hat: { style: 'pointed', color: '#3aa050' }, colors: { cloth: '#3aa050', pants: '#e8dcc0', hair: '#e0b040', trim: '#8a5a2a' } }) },\n  { face: 0, rig: new E.Humanoid({ size: 1.3, build: 'bulky', weapon: null, hat: { style: 'band', color: '#e03a3a' }, colors: { cloth: '#f0f0f0', pants: '#2f5fd0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'gun', hat: 'cap', sleeves: 'long', colors: { cloth: '#d83a2a', pants: '#2f5fd0', glove: '#f0f0f0' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, weapon: 'staff', outfit: 'robe', hair: 'ponytail', sleeves: 'long', colors: { cloth: '#6a3ab0', hair: '#c8402a', trim: '#e8c860' } }) },\n  { face: Math.PI, rig: new E.Humanoid({ size: 1.25, build: 'heroic', hood: true, outfit: 'coat', sleeves: 'long', colors: { cloth: '#e8e4dc', coat: '#d8d2c8', trim: '#b02a2a', belt: '#b02a2a', pants: '#4a4a5a', boot: '#3a2e2a' } }) }   // the stealth slice's hooded assassin\n];\nHEROES.forEach((h, i) => { h.x = MID + (i - 2.5) * 35; });\n// the corner's buttons (menu, full screen, the page's ? API) in game pixels: about 170 x 60 CSS pixels at the top right\nconst corner = () => { const S = game.screen, k = S.dpr / S.S; return [170 * k, 60 * k]; };\n// where a HUD's top-right corner ends: left of the corner's menu button while it stays there (a touch screen), else the edge\nconst cornerX = () => { const ca = touch() && game.cornerArea(); return ca && ca.y0 < 40 ? Math.floor(ca.x0) - 4 : game.W; };\n/* ---- THE PROOF (tools/kits-test.mjs runs each slice's twice and compares): proof(id, n, script, state, fresh) enters the\n * slice afresh on a game clock at 0, with Math.random seeded, runs n fixed steps of 1/120 s with script(i, key) pressing\n * keys (key.hold('right'), key.up('right'), key.tap('attack')), and gives a hash of what state() returns: the numbers that\n * say how the run went. fresh(), when given, runs first (seeded): it puts back what the slice keeps between visits. A\n * slice's run(n) is one (__game.scenes.adventure.run(600)): the same number every time ---- */\nconst proof = (id, n, script, state, fresh) => {\n  const was = Math.random, I = game.input, held = new Set();\n  const key = { hold: a => { held.add(a); I.hold(a); }, up: a => { held.delete(a); I.hold(a, false); }, tap: a => I.tap(a) };\n  Math.random = E.rng(7);\n  try {\n    if (fresh) fresh();\n    game.time = 0; game.timeScale = 1; game.go(id, null, { fade: 0 }); game.advance(1 / 120);\n    for (let i = 0; i < n; i++) { script(i, key); game.advance(1 / 120); }\n    const s = JSON.stringify(state()); let h = 2166136261;\n    for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);\n    return h >>> 0;\n  } finally { for (const a of held) I.hold(a, false); Math.random = was; }\n};\n// a proof's walk: every `every` steps it lets go of the directions and holds the next of `dirs`\nconst walk = (i, key, dirs, every) => { if (i % every) return; for (const d of dirs) key.up(d); key.hold(dirs[(i / every) % dirs.length]); };\n// START picks too (the touch START, a pad's Start), as Enter does: any player's\nconst pickOnStart = m => { const P = game.players; if (P.some(I => I.pressed('start'))) { P.forEach(I => I.consumeAll()); m.onPick(m.i, m.items[m.i]); } };\n/** the title's menu for the slices in this file: grouped by family when there are several (FamilyMenu, in 05-families.js:\n *  the reference editions carry it, a genre kit of one slice doesn't), else a plain E.Menu */\nconst menuOf = (slices, o) => new Set(slices.map(s => s.family)).size > 1 ? new FamilyMenu(slices, o) : new E.Menu(game, slices.map(s => s.label), o);\nlet titleMenu = null;   // (made at the start, once the file's slices are known)\nscenes.title = {\n  view: 'side', views: ['side', 'brawler'], input: 'DEFAULT', res: 'ps1',\n  enter() { A.music('title'); game.resetCamera(); game.follow(null); game.cam.room = null; game.cam.bounds = null; if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) {\n    if (!titleMenu.update(dt)) pickOnStart(titleMenu);\n    game.focus(MID, 0, 32 + (game.H / 2 - 42) / -game.view.bz);   // the ledge's top 42 px above the screen's bottom edge\n    const t = game.time;\n    HEROES.forEach((h, i) => {\n      const u = (t * .45 + i * .37) % 3, swing = u < .5 ? { spec: { a0: 1.4, a1: -1.6, z0: 12, z1: 8, reach: 7.5 }, phase: u < .15 ? 'wind' : 'active', u: u < .15 ? u / .15 : (u - .15) / .35 } : null;\n      h.rig.update(dt, { x: h.x, y: 0, z: 32, facing: h.face, vx: 0, vy: 0, attack: swing, point: i === 3 && u < .6 });\n    });\n  },\n  draw(r) {\n    const [cw, ch] = corner(), top = r.W / 2 + 132 > r.W - cw ? Math.round(ch) : 0;   // the logo drops below the corner's buttons where it would reach them (an upright phone)\n    titleMenu.y = 76 + top;\n    titleBg.draw(r);\n    stage.draw(r);\n    for (const x of [MID - 100, MID + 100]) r.prop('torch', x, 0, 32, { size: 1.3, light: false });\n    for (const x of [MID - 53, MID + 53]) r.prop('banner', x, -8, 64, { size: 1.1, color: '#8a1a2a' });\n    for (const h of HEROES) r.actor(h.x, 0, 32, (g, ox, oy) => h.rig.draw(g, ox, oy, r.view));\n    r.overlay(g => {\n      E.font.title(g, 'my-3D2dge', r.W / 2, 12 + top, { align: 'center', scale: 4, colors: ['#fffbe8', '#ffe08a', '#ffb347', '#e0662a'], depth: 3 });\n      E.font.text(g, 'My \"3D\" 2D Game Engine', r.W / 2, 48 + top, '#e8e0ff', { align: 'center', gradient: ['#ffffff', '#c8b8f0'], shadow: '#140c1c', outline: false });\n      E.font.text(g, SLICES[titleMenu.i].about, r.W / 2, r.H - 14, '#ffe7a8', { align: 'center', shadow: '#000', outline: false });\n    });\n    titleMenu.draw(r);\n    const dev = game.input.lastDevice, how = dev === 'touch' ? 'Tap a game to play it' : dev === 'gamepad' ? 'D-pad + ' + game.input.label('confirm') + '   ' + game.input.label('start') + ' menu'\n      : 'Arrows + Enter or click   V view   - = zoom   M mute';\n    r.text(how, r.W / 2, r.H - 26, '#b8b0d8', { align: 'center', shadow: '#000', outline: false });\n  }\n};\n\n/* ---- GAME OVER: shared by every slice ---- */\nconst overMenu = new E.Menu(game, ['Retry', 'Title'], { y: 118, onPick: i => game.go(i === 0 ? overMenu.from : 'title') });\nconst overBg = new E.Backdrop({ sky: ['#12040c', '#3a0c1c', '#6a1a28'], moon: { x: .5, y: .3, r: 16, color: '#e8a0a0' }, stars: 30,\n  layers: [{ kind: 'mountains', color: '#2a0c16', y: .72, height: .3, parallax: 0 }, { kind: 'fog', color: '#8a2a3a', y: .9, height: .12, parallax: 0, drift: 4 }] });\nscenes.over = {\n  view: 'side', input: 'DEFAULT', res: 'ps1',\n  enter(d) { overMenu.from = d.from; overMenu.i = 0; A.music(null); A.sfx('die'); game.follow(null); game.focus(0, 0, 0); if (gpu) gpu.enabled = false; L.enabled = false; },\n  update(dt) { if (!overMenu.update(dt)) pickOnStart(overMenu); },\n  back() { game.go('title'); return true; },   // a phone's back gesture: to the title, not off the page\n  draw(r) {   // centred on any screen\n    const y = Math.round(r.H / 2) - 60; overMenu.y = y + 58;\n    overBg.draw(r); r.overlay(g => E.font.title(g, 'GAME OVER', r.W / 2, y, { align: 'center', scale: 4, colors: ['#ffe0e0', '#ff7a6a', '#c8202a'], depthColor: '#3a0810' })); overMenu.draw(r);\n  }\n};\n\n/* =====================================================================================\n * SLICE 15  TACTICS  (Final Fantasy Tactics, Tactics Ogre, Shining Force, Fire Emblem). @modules grid story\n * THE TAKING OF THORNWATCH: four heroes storm a hill fort held by the Ash Legion's five (Grimwald, the knight who leads\n * them, at the gate; an archer on the wall; a mage on the tower; a priest in the yard; a thief out on the hills). An\n * isometric map of heights (E.HEIGHTS.level, 8, a level): a unit walks MOVE cells, climbs and drops what its JUMP allows,\n * and the river's shallows cost two. Blows land harder from the side (x1.25) and from behind (x1.5) and from higher\n * ground (+8% a level). Turns come by speed (charge time: the order ahead is on the left) or, picked before the battle,\n * by phases (every hero in the order you like, then every foe: Fire Emblem). A turn: MOVE and ACT once each, either\n * first (ATTACK or the unit's skill), then WAIT and face a way. Bows arc over what stands between (map.arcClear) and\n * reach further from up high; FIRE burns a diamond (friend and foe alike), VOLLEY rains on a cross, CURE heals one,\n * BASH knocks a foe back a cell, CLEAVE cuts the three cells ahead. The Legion scores every place it can stand and every\n * blow it can strike from there (the damage, a kill, a heal, the danger of the place: grid.threat). Win: the Legion falls.\n * Lose: every hero falls.\n * Keys: arrows / WASD move the cursor (the camera follows), Enter / Z confirm, Esc / X back (before acting, back undoes a\n * move), Q and E turn the view a quarter, the wheel or - and = zoom. The mouse: the cursor follows the pointer\n * (map.pick, the cell under it in every view and turn); a click confirms. TOUCH: a tap selects a unit, a tap on a blue\n * cell moves there, a tap on a foe in range strikes; the command list's rows are a thumb's height; a finger dragging\n * pans the camera, two pinch it; TURN turns the view.\n * HOW IT WORKS: the map is a TileMap whose cells all stand on a base (the earth shows at its edges) at their heights; the\n * grid is E.Grid.from(map, { tops: true }) with the shallows' cost; E.Turns ('ct') orders the turns, grid.reach the\n * moves (allies passed through), grid.shape the areas, grid.side where a blow lands, grid.threat the AI's danger; E.Story\n * runs the scene before the battle and its choice of the order. bot() lets the heroes' own AI play the battle\n * (tools/kits-test.mjs). Deep links: #tactics/battle (no scene, charge time), #tactics/phases.\n * ===================================================================================== */\nconst TACTICS = (() => {\n  const T = 16, LV = E.HEIGHTS.level, STEP = .16, BASE = 16;   // a cell; a level (8); a step's seconds; the ground's height\n  // THORNWATCH's march: G major, a snare under a brave lead (the step sequencer's format)\n  const SONG = { bpm: 112, steps: 4, tracks: [\n    { wave: 'pulse25', vol: .11, notes: 'G4 - B4 - D5 - - - E5 - D5 - B4 - G4 - | A4 - - - B4 - C5 - D5 - - - . . . . | G4 - B4 - D5 - G5 - F#5 - E5 - D5 - B4 - | C5 - B4 - A4 - F#4 - G4 - - - . . . .' },\n    { wave: 'triangle', vol: .28, notes: 'G2 - . . G2 . D3 . G2 - . . G2 . D3 . | D2 - . . D2 . A2 . D2 - . . D2 . A2 . | E2 - . . E2 . B2 . C3 - . . C3 . G2 . | D2 - . . D2 . A2 . G2 - . . G2 . . .' },\n    { wave: 'drums', vol: .09, notes: 'k . h . s . h . k . h k s . h h' }] };\n  // the fort (top left: the camera looks from the south east), its gate, the hills, the river's shallows (~) and its ford\n  const ROWS = [\n    'Bccce3221111....',\n    'cbbbc2211.......',\n    'cbbbc211....T...',\n    'cbbbc11.....~~..',\n    'cBaBc1.....~~...',\n    '..a.......~~..T.',\n    '.,,,,,...~~.....',\n    '..T..,..~~...1..',\n    '.....,.~~...122.',\n    '.R...,~~....12..',\n    '.....~~,,,,,....',\n    '..T.~~.....,....',\n    '...~~...T..,....',\n    '..~~.......,....'];\n  const GRASS = { top: '#5c8a3c', side: '#6a5034', face: 'rock', roof: 'grass' }, STONE = { top: '#8c8a90', side: '#6c6a78', face: 'stone', roof: 'slab' };\n  const TYPES = { 1: { ...GRASS, h: BASE }, 2: { top: '#a88c5a', side: '#6a5034', face: 'rock', roof: '#9a7e52 noise', h: BASE }, 3: { top: '#3a72a8', side: '#5a4a34', face: 'rock', roof: '#3a6aa8 glaze', h: BASE - 6 },\n    4: { ...GRASS, h: BASE + LV }, 5: { ...GRASS, h: BASE + 2 * LV }, 6: { ...GRASS, h: BASE + 3 * LV },\n    7: { ...STONE, h: BASE + LV }, 8: { ...STONE, h: BASE + 2 * LV }, 9: { ...STONE, h: BASE + 3 * LV, face: 'brick' }, 10: { ...STONE, h: BASE + 5 * LV, face: 'brick', roof: 'cobble' } };\n  const LEGEND = { '.': 1, ',': 2, '~': { tile: 3, floor: 'water' }, 1: 4, 2: 5, 3: 6, a: 7, b: 8, c: 9, e: 10, T: { tile: 1, block: true, spawn: 'tree' }, R: { tile: 1, block: true, spawn: 'rock' }, B: { tile: 9, block: true, spawn: 'banner' } };\n\n  /* ---- THE UNITS: stats, a look, two actions. kind: melee (a step's reach, two levels up or down at most), bow (an arc\n   * over what is between; a cell further for each two levels higher), magic, heal. area: a grid.shape round the target\n   * ([kind, n]; cone: along the way from the user) ---- */\n  const ACTS = {\n    sword:  { label: 'ATTACK', kind: 'melee', range: [1, 1], power: 1, anim: 'slash' },\n    dagger: { label: 'ATTACK', kind: 'melee', range: [1, 1], power: .9, anim: 'thrust' },\n    staff:  { label: 'ATTACK', kind: 'melee', range: [1, 1], power: .8, anim: 'overhead' },\n    bow:    { label: 'ATTACK', kind: 'bow', range: [2, 4], power: 1, anim: 'throw' },\n    bash:   { label: 'BASH', kind: 'melee', range: [1, 1], power: 1.2, mp: 4, push: true, anim: 'bash' },\n    cleave: { label: 'CLEAVE', kind: 'melee', range: [1, 1], power: .9, mp: 5, area: ['cone', 2], anim: 'spin' },\n    volley: { label: 'VOLLEY', kind: 'bow', range: [3, 5], power: .7, mp: 6, area: ['cross', 1], anim: 'throw' },\n    fire:   { label: 'FIRE', kind: 'magic', range: [1, 4], power: 1.5, mp: 6, area: ['diamond', 1], anim: 'cast' },\n    cure:   { label: 'CURE', kind: 'heal', range: [0, 3], power: 2, mp: 5, anim: 'rising' }\n  };\n  const ROSTER = [   // side, name, class, stats, its two actions, where it starts, its look\n    { side: 'hero', name: 'ALDO', cls: 'PALADIN', hp: 54, mp: 10, atk: 13, def: 7, mag: 4, res: 4, speed: 95, move: 4, jump: 2, acts: ['sword', 'bash'], at: [11, 10],\n      rig: { build: 'heroic', armor: true, hair: 'short', cape: { len: 5, width: 5, seg: 2.4 }, colors: { cloth: '#2c5cc0', cape: '#e8e4d8', capeIn: '#a8a090', hair: '#e0b050', trim: '#e8c860', metal: '#c8d0e0' } } },\n    { side: 'hero', name: 'WREN', cls: 'RANGER', hp: 40, mp: 12, atk: 12, def: 4, mag: 4, res: 5, speed: 110, move: 4, jump: 3, acts: ['bow', 'volley'], at: [13, 10], bow: true,\n      rig: { hood: true, outfit: 'tunic', weapon: null, sleeves: 'long', colors: { cloth: '#3a7a3a', pants: '#5a4a32', hair: '#8a4a2a', trim: '#c8a860', boot: '#4a3020' } } },\n    { side: 'hero', name: 'SABLE', cls: 'MAGE', hp: 32, mp: 24, atk: 5, def: 3, mag: 14, res: 9, speed: 100, move: 3, jump: 2, acts: ['staff', 'fire'], at: [11, 12],\n      rig: { outfit: 'robe', weapon: 'staff', sleeves: 'long', hair: 'long', hat: { style: 'pointed', color: '#2a2a6a' }, colors: { cloth: '#4a3ab0', pants: '#3a2e90', hair: '#e8e0f0', orb: '#ff9040', trim: '#f0c860' } } },\n    { side: 'hero', name: 'LIORA', cls: 'CLERIC', hp: 36, mp: 24, atk: 6, def: 4, mag: 11, res: 10, speed: 100, move: 4, jump: 2, acts: ['staff', 'cure'], at: [13, 12],\n      rig: { outfit: 'robe', weapon: 'staff', sleeves: 'long', hair: 'ponytail', hat: { style: 'band', color: '#c83a4a' }, colors: { cloth: '#f2eee2', pants: '#e2dccc', trim: '#c8a040', hair: '#6a3a24', orb: '#8affc0' } } },\n    { side: 'foe', name: 'GRIMWALD', cls: 'KNIGHT', hp: 60, mp: 10, atk: 13, def: 8, mag: 3, res: 3, speed: 85, move: 3, jump: 1, acts: ['sword', 'cleave'], at: [2, 4], lead: true,\n      rig: { build: 'bulky', size: 1.1, armor: true, hair: 'bald', hat: { style: 'helmet', color: '#4a4652' }, cape: { len: 6, width: 6, seg: 2.6 }, eyeGlow: '#ff6040', colors: { cloth: '#2e2a34', pants: '#3a3640', metal: '#6a6878', cape: '#a01c2c', capeIn: '#6a1020', trim: '#c89040', skin: '#12060c' } } },\n    { side: 'foe', name: 'ARCHER', cls: 'ARCHER', hp: 30, mp: 0, atk: 10, def: 3, mag: 3, res: 3, speed: 105, move: 4, jump: 2, acts: ['bow'], at: [4, 3], bow: true,\n      rig: { hood: true, outfit: 'tunic', weapon: null, sleeves: 'long', colors: { cloth: '#7a2a2a', pants: '#3a3036', hair: '#2a2024', trim: '#5a5a62', boot: '#2a2024' } } },\n    { side: 'foe', name: 'MAGE', cls: 'MAGE', hp: 28, mp: 20, atk: 4, def: 2, mag: 12, res: 7, speed: 95, move: 3, jump: 2, acts: ['staff', 'fire'], at: [4, 0],\n      rig: { outfit: 'robe', weapon: 'staff', sleeves: 'long', hair: 'bald', hat: { style: 'pointed', color: '#1a1420' }, colors: { cloth: '#2a2030', pants: '#221a28', trim: '#c83a3a', orb: '#ff4a2a', skin: '#c8b0a0' } } },\n    { side: 'foe', name: 'PRIEST', cls: 'PRIEST', hp: 30, mp: 20, atk: 5, def: 3, mag: 9, res: 8, speed: 90, move: 3, jump: 2, acts: ['staff', 'cure'], at: [2, 2],\n      rig: { outfit: 'robe', weapon: 'staff', hood: true, sleeves: 'long', colors: { cloth: '#5a5462', pants: '#4a4452', trim: '#a01c2c', orb: '#c8ffd8' } } },\n    { side: 'foe', name: 'THIEF', cls: 'THIEF', hp: 30, mp: 0, atk: 10, def: 3, mag: 3, res: 3, speed: 125, move: 5, jump: 3, acts: ['dagger'], at: [8, 1],\n      rig: { hood: true, outfit: 'tunic', bladeLen: 7, colors: { cloth: '#3a2a4a', pants: '#2a2232', hair: '#1a1420', trim: '#8a6a3a', boot: '#1e1824' } } }\n  ];\n  const PEOPLE = { aldo: 'ALDO', wren: 'WREN', sable: 'SABLE', liora: 'LIORA', grim: 'GRIMWALD' };\n  // the scene before the battle (E.Story): each line looks at its speaker; its last choice sets the turn order\n  const NODES = { intro: [\n    { event: 'look', at: 'grim' },\n    { who: 'grim', say: 'So the Crown sends {c=#8ad0ff}four{/c}. Thornwatch has stood a hundred years, little lord.', emote: 'dots' },\n    { event: 'look', at: 'aldo' },\n    { who: 'aldo', say: 'Then a hundred years is long enough. Open the gate, Grimwald.' },\n    { event: 'look', at: 'grim' },\n    { who: 'grim', say: '{shake}Legion! To the walls!{/shake}', emote: '!' },\n    { event: 'look', at: 'liora' },\n    { who: 'liora', say: 'Mind the archer on the wall. {w=.3}And keep out of the river: the shallows {c=#8ad0ff}slow{/c} you.' },\n    { who: 'wren', say: 'From up there their bows reach further. {w=.2}So will mine, from the hill.' },\n    { event: 'look', at: 'aldo' },\n    { who: 'aldo', say: 'How shall we fight?', choices: [{ text: 'Each in turn, by speed', set: { order: 'ct' } }, { text: 'Side by side: phases', set: { order: 'phase' } }] }] };\n\n  let map = null, grid = null, story = null, turns = null, units = [], active = null, mode = 'scene', order = 'ct', cursor = [11, 10], look = [0, 0, 0], menuI = 0;\n  let sel = null, pending = null, cells = null, queue = [], wait = 0, banner = null, msg = null, over = null, round = 1, phase = 'hero', left = [], auto = false, stats = null, hold = 0, held = null, ptr = null, base = null;\n  const endMenu = new E.Menu(game, ['RETRY', 'TITLE'], { y: 0, onPick: i => i === 0 ? game.go('tactics', { part: 'battle' }, { fade: 'iris' }) : game.go('title') });\n  const top = (cx, cy) => map.height(cx, cy), key = c => c[0] + ',' + c[1], same = (a, b) => a && b && a[0] === b[0] && a[1] === b[1];\n  const living = side => units.filter(u => !u.dead && (!side || u.side === side)), unitAt = c => units.find(u => !u.dead && u.cx === c[0] && u.cy === c[1]) || null;\n  const foesOf = u => living(u.side === 'hero' ? 'foe' : 'hero'), mates = u => living(u.side).filter(o => o !== u), cell = u => [u.cx, u.cy];\n  const water = c => map.floorTags && map.floorTags[c[1] * map.w + c[0]] === 'water';\n  const say = (s, c = '#fff2c4') => { msg = { s, c, t: 0 }; };\n\n  /* ---- 1. RULES: where a unit can go, what it can strike from where, how hard ---- */\n  const moveOpts = u => ({ climb: u.jump * LV, drop: (u.jump + 1) * LV, blocked: (x, y) => foesOf(u).some(o => o.cx === x && o.cy === y), pass: (x, y) => mates(u).some(o => o.cx === x && o.cy === y) });\n  const reachOf = u => grid.reach(cell(u), u.moved ? 0 : u.move, moveOpts(u));\n  // the cells action a can be aimed at from cell c (each with a unit it touches, or any cell for an area)\n  function aims(u, a, c) {\n    const [lo, hi0] = a.range, h = top(...c), out = [];\n    for (let y = c[1] - hi0 - 3; y <= c[1] + hi0 + 3; y++) for (let x = c[0] - hi0 - 3; x <= c[0] + hi0 + 3; x++) {\n      if (!grid.inside([x, y])) continue;\n      const d = grid.dist(c, [x, y]), dz = h - top(x, y), hi = a.kind === 'bow' ? hi0 + Math.max(0, Math.floor(dz / (2 * LV))) : hi0;\n      if (d < lo || d > hi) continue;\n      if (a.kind === 'melee' && Math.abs(dz) > 2 * LV) continue;\n      if (a.kind === 'bow' && !arcs(c, [x, y])) continue;\n      out.push([x, y]);\n    }\n    return out;\n  }\n  // an arrow's arc from a unit's chest over the tops between (map.arcClear: the core's jump arcs)\n  const arcs = (a, b) => { const [ax, ay] = map.center(...a), [bx, by] = map.center(...b), d = Math.hypot(bx - ax, by - ay); return map.arcClear({ x: ax, y: ay, z: top(...a) + 16 }, { x: bx, y: by, z: top(...b) + 12 }, 8 + d * .25); };\n  const area = (a, from, t) => a.area ? grid.shape(t, a.area[0], a.area[1], grid.face(from, t)).filter(c => !(a.area[0] === 'cone' && same(c, from))) : [t];\n  const hitCells = (a, from, t) => a.area && a.area[0] === 'cone' ? grid.shape(from, 'cone', a.area[1], grid.face(from, t)) : area(a, from, t);\n  // how hard a blows v from cell from: { amount, side, heal }\n  function blow(u, a, from, v) {\n    if (a.kind === 'heal') return { heal: true, amount: Math.min(v.max - v.hp, Math.round(u.mag * a.power)) };\n    const side = a.kind === 'magic' ? 'front' : grid.side(cell(v), v.facing, from), dl = (top(...from) - top(v.cx, v.cy)) / LV;\n    const raw = a.kind === 'magic' ? u.mag * a.power - v.res * .6 : u.atk * a.power - v.def * .7;\n    return { side, amount: Math.max(1, Math.round(raw * (side === 'back' ? 1.5 : side === 'side' ? 1.25 : 1) * (1 + clamp(dl, -2, 3) * .08))) };\n  }\n\n  /* ---- 2. THE AI: every place it can stop and every blow from there, scored; the best (the first of equals) wins ---- */\n  function plan(u) {\n    const foes = foesOf(u), reach = reachOf(u), heal = u.acts.map(id => ACTS[id]).find(a => a.kind === 'heal');\n    const danger = grid.threat(foes.map(o => ({ cx: o.cx, cy: o.cy, move: o.move, range: ACTS[o.acts[0]].range, climb: o.jump * LV, drop: (o.jump + 1) * LV })), { blocked: (x, y) => living(u.side).some(o => o !== u && o.cx === x && o.cy === y) });\n    const ranged = ACTS[u.acts[0]].kind === 'bow' || u.acts.some(id => ACTS[id].kind === 'magic');\n    let best = null;\n    for (const [cx, cy] of reach.cells) {\n      const c = [cx, cy], near = Math.min(...foes.map(o => grid.dist(c, cell(o))));\n      let pos = (top(cx, cy) - BASE) / LV * 1.2 - danger.count(c) * (u.hp < u.max * .4 ? 5 : 2.5) - (water(c) ? 2 : 0);\n      if (heal) { const hurt = living(u.side).filter(o => o.hp < o.max * .7); pos -= hurt.length ? Math.min(...hurt.map(o => grid.dist(c, cell(o)))) * .8 : 0; }\n      pos -= ranged ? Math.abs(near - 3) * 1.5 : near * 1.6;\n      if (u.lead && near > 2) pos -= 3;   // (the knight holds his gate until they come)\n      const take = s => { if (!best || s.score > best.score + 1e-9) best = s; };\n      take({ cell: c, score: pos });\n      if (u.acted) continue;\n      for (const id of u.acts) {\n        const a = ACTS[id]; if ((a.mp || 0) > u.mp) continue;\n        for (const t of aims(u, a, c)) {\n          let v = 0;\n          for (const hc of hitCells(a, c, t)) {\n            const o = same(hc, c) ? u : same(hc, cell(u)) ? null : unitAt(hc); if (!o || (o === u && a.kind !== 'heal')) continue;\n            const b = blow(u, a, c, o), ally = o.side === u.side;\n            if (b.heal) v += ally ? b.amount * 1.3 : -b.amount;\n            else v += ally ? -b.amount * 1.6 : b.amount + (b.amount >= o.hp ? 25 + (o.lead ? 15 : 0) : 0);\n          }\n          if (v > 2) take({ cell: c, act: id, aim: t, score: pos + v * 2 });\n        }\n      }\n    }\n    return best;\n  }\n\n  /* ---- 3. ORDERS: a move along its path, an action and its effects, the wait and its facing. The player's commands, the\n   * AI and the bot all give these ---- */\n  function march(u, to, done) {\n    const p = grid.reach(cell(u), u.move, moveOpts(u)).path(to); if (p.length < 2) { done && done(); return; }\n    u.from = cell(u); u.path = p; u.seg = 0; u.st = 0; u.after = done; A.sfx('step');\n  }\n  function act(u, id, t, done) {\n    const a = ACTS[id], from = cell(u), fin = () => { acting--; if (done) done(); }; acting++; u.acted = true; u.mp -= a.mp || 0; u.facing = same(t, from) ? u.facing : grid.face(from, t);\n    u.swing = new E.Attack(a.anim); u.swing.start(); A.sfx(a.kind === 'magic' || a.kind === 'heal' ? 'charge' : 'swing');\n    const land = () => {\n      const hit = hitCells(a, from, t), [tx, ty] = map.center(...t), tz = top(...t);\n      if (a.kind === 'magic') { for (const c of hit) { const [x, y] = map.center(...c); P.fire(x, y, top(...c) + 4, 8, { speed: 50 }); P.smoke(x, y, top(...c) + 8, 2); } A.sfx('explode', { vol: .5 }); game.shake(3); }\n      if (a.kind === 'heal') { P.glints(tx, ty, tz + 14, 14, '#8affc0', 14); P.ring(tx, ty, 4, 16, '#8affc0', .5, tz); A.sfx('heal'); }\n      for (const c of hit) {\n        const v = same(c, from) && a.kind !== 'heal' ? null : unitAt(c); if (!v) continue;\n        const b = blow(u, a, from, v), [x, y] = map.center(v.cx, v.cy), z = top(v.cx, v.cy);\n        if (b.heal) { v.hp += b.amount; P.text(x, y, z + 30, '+' + b.amount, '#8affc0', { bounce: true }); continue; }\n        v.hp -= b.amount; v.hit = .3; stats.dealt[u.name] = (stats.dealt[u.name] || 0) + b.amount;\n        game.hitFx(x, y, z + 14, { damage: b.amount, power: b.side === 'back' ? 1.5 : 1, angle: Math.atan2(u.facing[1], u.facing[0]), textColor: v.side === 'hero' ? '#ff9a8a' : '#fff2c4', sound: a.kind === 'magic' ? false : 'hit' });\n        if (b.side !== 'front') P.text(x, y, z + 40, b.side === 'back' ? 'BACK!' : 'SIDE', '#ffd040');\n        if (a.push && v.hp > 0) push(u, v);\n        if (v.hp <= 0) fall(v);\n      }\n      check();\n    };\n    if (a.kind === 'bow') game.after(.2, () => { arrows.push({ a: [u.x, u.y, top(...from) + 18], b: [...map.center(...t), top(...t) + 12], t: 0, dur: .32 + grid.dist(from, t) * .04, then: () => { land(); game.after(.35, fin); } }); A.sfx('whoosh'); });\n    else game.after(a.kind === 'magic' ? .55 : .22, () => { land(); game.after(.5, fin); });\n  }\n  const arrows = []; let acting = 0;\n  // BASH: the foe goes back a cell, falling to a lower one (hurt by the drop), or slams into what is there\n  function push(u, v) {\n    const d = grid.face(cell(u), cell(v)), to = [v.cx + d[0], v.cy + d[1]];\n    if (grid.walk(to) && !unitAt(to) && top(...to) <= top(v.cx, v.cy) + LV / 2) {\n      const drop = Math.max(0, Math.floor((top(v.cx, v.cy) - top(...to)) / LV)); v.from = cell(v); v.cx = to[0]; v.cy = to[1]; v.path = [v.from, to]; v.seg = 0; v.st = 0; v.after = null;\n      if (drop) { v.hp -= drop * 3; game.after(.2, () => P.text(v.x, v.y, top(v.cx, v.cy) + 30, drop * 3, '#ffb070')); }\n    } else { v.hp -= 4; game.after(.15, () => P.text(v.x, v.y, top(v.cx, v.cy) + 30, 'SLAM 4', '#ffb070')); }\n  }\n  function fall(v) {\n    v.dead = true; v.die = 0; v.hp = 0; left = left.filter(o => o !== v); if (turns) turns.remove(v);\n    P.dust(v.x, v.y, top(v.cx, v.cy), 10); A.sfx('die'); say(v.name + ' FALLS', v.side === 'hero' ? '#ff8a8a' : '#a8e0a0');\n  }\n  function check() {\n    if (over) return;\n    const won = !living('foe').length, lost = !living('hero').length; if (!won && !lost) return;\n    over = { won, t: 0 }; queue = []; mode = 'over'; A.sfx(won ? 'powerup' : 'die'); if (won) A.music(null);\n  }\n\n  /* ---- 4. TURNS: charge time (E.Turns 'ct': the fastest acts first, a turn of less costs less) or phases ---- */\n  function nextTurn() {\n    if (over) return;\n    let u;\n    if (order === 'ct') u = turns.next();\n    else {\n      if (!left.length) { phase = phase === 'hero' ? 'foe' : 'hero'; if (phase === 'hero') round++; left = living(phase); banner = { s: phase === 'hero' ? 'PLAYER PHASE' : 'ENEMY PHASE', t: 0, c: phase === 'hero' ? '#8ad0ff' : '#ff8a7a' }; }\n      u = left[0];\n    }\n    if (!u) return;\n    active = u; u.moved = u.acted = false; u.at0 = cell(u); u.mp = Math.min(u.mmp, u.mp + 2); cursor = cell(u); aimLook(cursor); stats.turns++;\n    if (order === 'ct') banner = { s: u.name + \"'S TURN\", t: 0, c: u.side === 'hero' ? '#8ad0ff' : '#ff8a7a' };\n    if (u.side === 'hero' && !auto) { mode = 'command'; menuI = u.moved ? 1 : 0; A.sfx('blip'); }\n    else { mode = 'ai'; aiTurn(u); }\n  }\n  // the end of a unit's turn: its cost to its charge (100 a move and an act, 80 one, 60 neither), then the next\n  function endTurn(u, face) {\n    if (over) return;\n    if (face) u.facing = face;\n    if (order === 'ct') turns.done(u, 60 + (u.moved ? 20 : 0) + (u.acted ? 20 : 0)); else left = left.filter(o => o !== u);\n    mode = 'busy'; sel = null; cells = null; queue.push([.25, nextTurn]);\n  }\n  // the AI's turn, a beat at a time: the cursor to where it goes, the move, the cursor to its target, the blow, its facing\n  function aiTurn(u) {\n    const p = plan(u) || { cell: cell(u) }, foes = foesOf(u);\n    queue.push([.35, () => { cursor = p.cell; aimLook(p.cell); }]);\n    queue.push([.25, () => { if (!same(p.cell, cell(u))) { u.moved = true; march(u, p.cell, () => { if (!over) mode = 'ai'; }); mode = 'anim'; } }]);\n    if (p.act) {\n      queue.push([.3, () => { cursor = p.aim; cells = hitCells(ACTS[p.act], p.cell, p.aim); }]);\n      queue.push([.35, () => { cells = null; mode = 'anim'; act(u, p.act, p.aim, () => { if (!over) mode = 'ai'; }); }]);\n    }\n    queue.push([.3, () => { const f = foes.filter(o => !o.dead).sort((a, b) => grid.dist(cell(u), cell(a)) - grid.dist(cell(u), cell(b)))[0]; endTurn(u, f ? grid.face(cell(u), cell(f)) : u.facing); }]);\n  }\n\n  /* ---- 5. THE BATTLE ---- */\n  function build() {\n    map = new E.TileMap({ rows: ROWS, legend: LEGEND, types: TYPES, ao: 0, outside: false, shimmer: false, floorTex: () => [0, 0, 0] });\n    grid = E.Grid.from(map, { tops: true, cost: (x, y) => water([x, y]) ? 2 : 1 });\n  }\n  const rigOf = r => new E.Humanoid(Object.assign({ size: 1 }, r));\n  function start(data) {\n    if (!map) build();\n    const part = data && data.part; order = part === 'phases' ? 'phase' : 'ct'; auto = !!(data && data.auto);\n    units = ROSTER.map((d, i) => { const [x, y] = map.center(...d.at); return Object.assign({}, d, { id: i, cx: d.at[0], cy: d.at[1], x, y, z: top(...d.at), max: d.hp, mmp: d.mp, facing: d.side === 'hero' ? [-1, 0] : [1, 0], rig: rigOf(d.rig), swing: null, hit: 0, dead: false, die: 0, path: null }); });\n    units.forEach(u => { if (u.side === 'foe') u.facing = grid.face(cell(u), [12, 11]); });\n    turns = new E.Turns(units, { mode: 'ct' }); active = null; over = null; queue = []; wait = 0; banner = null; msg = null; round = 0; phase = 'foe'; left = []; cells = null; sel = null; arrows.length = 0;\n    stats = { turns: 0, dealt: {} }; base = null; acting = 0;\n    const g = units.find(u => u.lead); cursor = cell(g); aimLook(cursor); game.cam.snap = true; game.cam.bounds = null; L.enabled = false; A.music(SONG); game.input.steer = 'drag';\n    const people = {}; for (const k in PEOPLE) { const u = units.find(o => o.name === PEOPLE[k]); people[k] = { name: u.name, portrait: u.rig, at: Object.assign(u, { h: 32 }) }; }\n    story = new E.Story(game, { people, nodes: NODES, vars: { order: 'ct' }, on: { look(s, st) { const u = people[st.at].at; cursor = cell(u); aimLook(cursor); } } });\n    if (part) begin(); else { mode = 'scene'; story.run('intro', { onDone: () => { order = story.get('order') || 'ct'; begin(); } }); }\n  }\n  function begin() { mode = 'busy'; banner = { s: order === 'ct' ? 'BATTLE!' : 'BATTLE! BY PHASES', t: 0, c: '#ffe070' }; A.sfx('confirm'); queue.push([.9, nextTurn]); }\n  // the camera looks at a cell's top (the cursor, a speaker, the unit whose turn it is)\n  const aimLook = c => { const [x, y] = map.center(...c); look = [x, y, top(...c)]; };\n\n  /* ---- 6. THE PLAYER: a command list, then a cell to move to or a target, then a way to face ---- */\n  const skillOf = u => ACTS[u.acts[1]];\n  const rows = u => {\n    const sk = skillOf(u), out = [{ id: 'move', label: 'MOVE', off: u.moved }, { id: 'act', act: u.acts[0], label: ACTS[u.acts[0]].label, off: u.acted }];\n    if (sk) out.push({ id: 'act', act: u.acts[1], label: sk.label, note: sk.mp + ' MP', off: u.acted || u.mp < sk.mp });\n    if (order === 'phase') out.push({ id: 'end', label: 'END PHASE' });\n    out.push({ id: 'wait', label: 'WAIT' }); return out;\n  };\n  function command(r) {\n    const u = active; if (!r || r.off) { A.sfx('bump'); return; }\n    A.sfx('confirm');\n    if (r.id === 'move') { mode = 'move'; cells = reachOf(u).cells.map(c => [c[0], c[1]]); cursor = cell(u); }\n    else if (r.id === 'act') { mode = 'target'; pending = r.act; cells = aims(u, ACTS[r.act], cell(u)); const t = cells.find(c => { const o = unitAt(c); return o && (ACTS[r.act].kind === 'heal' ? o.side === u.side : o.side !== u.side); }); cursor = t || cell(u); }\n    else if (r.id === 'wait') { mode = 'face'; cells = grid.neighbours(cell(u)); const f = foesOf(u).sort((a, b) => grid.dist(cell(u), cell(a)) - grid.dist(cell(u), cell(b)))[0]; u.facing = f ? grid.face(cell(u), cell(f)) : u.facing; cursor = cell(u); }\n    else if (r.id === 'end') { for (const h of left.slice()) if (h !== u) left = left.filter(o => o !== h); endTurn(u); }\n  }\n  // confirm on cell c: what it means in each mode (a key, a click, a tap)\n  function confirmAt(c) {\n    const u = active;\n    if (mode === 'move') {\n      if (!cells.some(k => same(k, c))) { A.sfx('bump'); return; }\n      if (same(c, cell(u))) { mode = 'command'; cells = null; return; }\n      u.moved = true; cells = null; mode = 'anim'; A.sfx('confirm'); march(u, c, () => { mode = 'command'; menuI = rows(u).findIndex(r => !r.off); });\n    } else if (mode === 'target') {\n      if (!cells.some(k => same(k, c)) || (!ACTS[pending].area && !unitAt(c))) { A.sfx('bump'); return; }\n      cells = null; mode = 'anim'; act(u, pending, c, () => { mode = over ? 'over' : 'command'; menuI = rows(u).findIndex(r => !r.off); });\n    } else if (mode === 'face') {\n      if (!same(c, cell(u))) u.facing = grid.face(cell(u), c);\n      A.sfx('confirm'); endTurn(u);\n    } else if (mode === 'command') {\n      const o = unitAt(c); sel = o;\n      if (o && order === 'phase' && o.side === 'hero' && left.includes(o) && o !== u && !u.moved && !u.acted) { active = o; o.moved = o.acted = false; o.at0 = cell(o); A.sfx('blip'); }   // phases: any hero who hasn't gone","numLines":464,"startLine":1,"totalLines":703,"truncatedByTokenCap":true}},"tool_result_meta":[{"id":"toolu_014r4b1VPGmvwSX8x7a3JBLh","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cghra7iCDJ7qALVJUXGk6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0188RqcF8SuV3jq2LAvhGjnc","name":"Read","input":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build--20261104-050223--x7910ab-work/2ba7a3b6-c05c-41f2-add8-99edaaa21587/tool-results/bvyyh32d1.txt","offset":465,"limit":240},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":21667,"cache_read_input_tokens":153922,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":21667},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ba7a3b6-c05c-41f2-add8-99edaaa21587","uuid":"cbb6d644-8d89-47ba-a34f-57fe794dfcce","timestamp":"2026-11-04T12:03:44.798Z","request_id":"req_011Cghra7LNhYd5m6Yi9mJj9","wire_tool_inputs":{"toolu_0188RqcF8SuV3jq2LAvhGjnc":{"file_path":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build--20261104-050223--x7910ab-work/2ba7a3b6-c05c-41f2-add8-99edaaa21587/tool-results/bvyyh32d1.txt","offset":465,"limit":240}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0188RqcF8SuV3jq2LAvhGjnc","type":"tool_result","content":"465\t      else A.sfx('select');\n466\t    }\n467\t  }\n468\t  function back() {\n469\t    const u = active;\n470\t    if (mode === 'move' || mode === 'target' || mode === 'face') { mode = 'command'; cells = null; cursor = cell(u); A.sfx('cancel'); return; }\n471\t    if (mode === 'command' && u.moved && !u.acted && !u.path) {   // undo the move\n472\t      const [x, y] = map.center(...u.at0); u.cx = u.at0[0]; u.cy = u.at0[1]; u.x = x; u.y = y; u.z = top(...u.at0); u.moved = false; cursor = cell(u); A.sfx('cancel'); menuI = 0;\n473\t    }\n474\t  }\n475\t  // the step the keys ask for, on the grid: turned from the screen (a small bias splits iso's diagonals the same way each time)\n476\t  const tapped = () => { const I = game.input, x = (I.pressed('right') ? 1 : 0) - (I.pressed('left') ? 1 : 0), y = (I.pressed('down') ? 1 : 0) - (I.pressed('up') ? 1 : 0); return x || y ? [x, y] : null; };\n477\t  function keyDir() {\n478\t    const t = tapped(), m = t || game.input.move(); if (Math.hypot(m[0], m[1]) < .5) return null;\n479\t    if (t) hold = 0;   // (a tap shorter than a step still moves it)\n480\t    const g = game.view.screenDirToGround(m[0], m[1]), a = Math.atan2(g[1], g[0]) + .01, k = Math.round(a / (Math.PI / 2));\n481\t    return [Math.round(Math.cos(k * Math.PI / 2)), Math.round(Math.sin(k * Math.PI / 2))];\n482\t  }\n483\t  // the HUD's boxes this frame (taps and clicks hit them): the command list's rows, TURN\n484\t  let ui = { rows: [], turn: null };\n485\t  const hitBox = (b, p) => b && p && p[0] >= b.x && p[0] < b.x + b.w && p[1] >= b.y && p[1] < b.y + b.h;\n486\t  function playerInput(dt) {\n487\t    const I = game.input, u = active, tap = I.clicked(), p = I.pointer();\n488\t    if (I.pressed('turnL') || I.pressed('turnR') || (tap && hitBox(ui.turn, tap))) { game.rotateView(I.pressed('turnL') ? -90 : 90); A.sfx('select'); return; }\n489\t    if (mode === 'command') {\n490\t      const rs = rows(u), k = tap ? ui.rows.findIndex(b => hitBox(b, tap)) : -1;\n491\t      if (k >= 0) { menuI = k; command(rs[k]); return; }\n492\t      if (p && !same(p, ptr)) { const h = ui.rows.findIndex(b => hitBox(b, p)); if (h >= 0) menuI = h; }\n493\t      const t = tapped(), m = t || I.move(), dy = Math.abs(m[1]) > .5 ? Math.sign(m[1]) : 0; if (t) hold = 0;\n494\t      if (dy && hold <= 0) { menuI = (menuI + dy + rs.length) % rs.length; A.sfx('select'); hold = held ? .09 : .25; held = true; } else if (!dy) { held = false; hold = 0; }\n495\t      hold -= dt;\n496\t      if (I.pressed('confirm')) { command(rs[menuI]); return; }\n497\t      if (I.pressed('cancel')) { back(); return; }\n498\t    } else {\n499\t      const d = keyDir();\n500\t      if (d && hold <= 0) { const c = [clamp(cursor[0] + d[0], 0, map.w - 1), clamp(cursor[1] + d[1], 0, map.h - 1)]; if (!same(c, cursor)) { cursor = c; aimLook(c); A.sfx('blip'); } hold = held ? .09 : .22; held = true; } else if (!d) { held = false; hold = 0; }\n501\t      hold -= dt;\n502\t      if (I.pressed('confirm')) { confirmAt(cursor); return; }\n503\t      if (I.pressed('cancel')) { back(); return; }\n504\t    }\n505\t    // the mouse's pointer moves the cursor over the map; a click or tap there confirms on that cell (map.pick)\n506\t    if (p && !same(p, ptr) && I.lastDevice !== 'touch' && !ui.rows.some(b => hitBox(b, p))) { const h = map.pick(p[0], p[1], game); if (h && !same([h.cx, h.cy], cursor)) cursor = [h.cx, h.cy]; }\n507\t    if (tap && !ui.rows.some(b => hitBox(b, tap))) {\n508\t      const h = map.pick(tap[0], tap[1], game); if (!h) return;\n509\t      const c = [h.cx, h.cy]; cursor = c;\n510\t      if (mode === 'command') confirmAt(c);\n511\t      else if (cells && cells.some(k => same(k, c))) confirmAt(c);\n512\t      else if (mode !== 'face') { sel = unitAt(c); A.sfx('select'); }\n513\t      else confirmAt(c);\n514\t    }\n515\t  }\n516\t\n517\t  /* ---- 7. EACH STEP: the rigs, the walks, the arrows, the queue of beats, the player or the scene ---- */\n518\t  function update(dt) {\n519\t    const I = game.input;\n520\t    for (const u of units) {\n521\t      if (u.path) {   // along the path a step at a time, hopping up or down a level\n522\t        u.st += dt / STEP;\n523\t        while (u.path && u.st >= 1) { u.st -= 1; u.seg++; if (u.seg >= u.path.length - 1) { const [cx, cy] = u.path[u.path.length - 1]; u.cx = cx; u.cy = cy; u.path = null; const f = u.after; u.after = null; if (f) f(); } else A.sfx('step', { vol: .4 }); }\n524\t        if (u.path) {\n525\t          const a = u.path[u.seg], b = u.path[u.seg + 1], [ax, ay] = map.center(...a), [bx, by] = map.center(...b), k = u.st, za = top(...a), zb = top(...b);\n526\t          u.x = lerp(ax, bx, k); u.y = lerp(ay, by, k); u.z = lerp(za, zb, k) + (za !== zb ? Math.sin(k * Math.PI) * (6 + Math.abs(zb - za) * .4) : 0); u.facing = [b[0] - a[0], b[1] - a[1]]; u.cx = b[0]; u.cy = b[1];\n527\t        }\n528\t      }\n529\t      if (!u.path) { const [x, y] = map.center(u.cx, u.cy); u.x = x; u.y = y; u.z = top(u.cx, u.cy); }\n530\t      if (u.swing) { u.swing.update(dt); if (!u.swing.phase) u.swing = null; }\n531\t      u.hit = Math.max(0, u.hit - dt); if (u.dead) u.die += dt;\n532\t      const walking = !!u.path, f = Math.atan2(u.facing[1], u.facing[0]);\n533\t      u.rig.update(dt, { x: u.x, y: u.y, z: u.z, vx: walking ? Math.cos(f) * T / STEP : 0, vy: walking ? Math.sin(f) * T / STEP : 0, facing: f, attack: u.swing ? u.swing.state : null,\n534\t        pose: u.dead ? 'die' : over && over.won && u.side === 'hero' ? 'cheer' : null, hurt: u.hit > 0 ? u.hit * 4 : 0, look: [Math.cos(f), Math.sin(f)] });\n535\t    }\n536\t    for (let i = arrows.length - 1; i >= 0; i--) { const a = arrows[i]; a.t += dt / a.dur; if (a.t >= 1) { arrows.splice(i, 1); a.then(); } }\n537\t    if (banner) banner.t += dt; if (msg) msg.t += dt;\n538\t    // the camera: toward what it looks at, a drag panning it (touch)\n539\t    const dr = I.drag(); if (dr && (Math.abs(dr[0]) + Math.abs(dr[1]) > 0)) { const g = game.view.screenDirToGround(-dr[0], -dr[1]), l = Math.hypot(dr[0], dr[1]) / (game.view.scale || 1); look[0] += g[0] * l; look[1] += g[1] * l; }\n540\t    game.focus(look[0], look[1], look[2]);\n541\t    if (mode === 'scene') { if (I.pressed('skip')) { story.stop(); order = 'ct'; begin(); } else story.update(dt); ptr = I.pointer(); return; }\n542\t    if (mode === 'over') { over.t += dt; if (over.t > 1.6) endMenu.update(dt); return; }\n543\t    if (queue.length && !units.some(u => u.path) && !arrows.length && !acting) { wait += dt; if (wait >= queue[0][0]) { wait = 0; queue.shift()[1](); } }\n544\t    if (!auto && active && active.side === 'hero' && (mode === 'command' || mode === 'move' || mode === 'target' || mode === 'face')) playerInput(dt);\n545\t    if (mode === 'face') { const d = keyDir(); if (d) active.facing = d; }\n546\t    ptr = I.pointer();\n547\t  }\n548\t\n549\t  /* ---- 8. DRAWING: a sky, the map on its base, its trees and banners, the ranges, the units, the cursor, the HUD ---- */\n550\t  function draw(r) {\n551\t    r.sky(['#16203e', '#2e4a78', '#7a9ab8', '#c8c0a8']);\n552\t    map.drawFloor(r); map.queueWalls(r);\n553\t    for (const s of map.spawns) { const z = top(s.cx, s.cy); if (s.tag === 'tree') r.prop(E.hash2(s.cx, s.cy) < .5 ? 'tree' : 'pine', s.x, s.y, z); else r.prop(s.tag, s.x, s.y, z); }\n554\t    // ranges: blue to move, red to strike, gold the blow's area, the selected unit's reach faint when it isn't its turn\n555\t    const h = (x, y) => top(x, y) + .5;\n556\t    if (cells && mode === 'move') E.tint(r, cells, '#3a9aff', .6, T, h);\n557\t    if (cells && mode === 'target') { E.tint(r, cells, '#ff3a4a', .55, T, h); if (cells.some(c => same(c, cursor))) E.tint(r, hitCells(ACTS[pending], cell(active), cursor), '#ffd040', .7, T, h); }\n558\t    if (cells && mode === 'ai') E.tint(r, cells, '#ff6a2a', .5, T, h);\n559\t    if (cells && mode === 'face') E.tint(r, cells, '#ffe060', .3, T, h);\n560\t    if (mode !== 'scene') for (const u of units) if (!u.dead) E.tint(r, [cell(u)], u.side === 'hero' ? '#4ab0ff' : '#ff4a4a', u === active ? .55 : .22, T, h);\n561\t    for (const u of units) {\n562\t      if (u.dead && u.die > 1.2) continue;\n563\t      r.shadow(u.x, u.y, 6, .4, '#0c0818', u.z);\n564\t      r.actor(u.x, u.y, u.z, (g, ox, oy) => { u.rig.draw(g, ox, oy, r.view); if (u.bow) bowOf(g, u, ox, oy, r.view); }, { flash: u.hit > .15 && '#ffffff', alpha: u.dead ? Math.max(0, 1 - (u.die - .6) * 1.6) : 1, xray: u === active && !u.dead });   // (x-ray is for one: the unit whose turn it is)\n565\t    }\n566\t    for (const a of arrows) {   // an arrow on its arc, pointing along it\n567\t      const k = a.t, z = lerp(a.a[2], a.b[2], k) + Math.sin(k * Math.PI) * 18, x = lerp(a.a[0], a.b[0], k), y = lerp(a.a[1], a.b[1], k), k2 = Math.min(1, k + .06), z2 = lerp(a.a[2], a.b[2], k2) + Math.sin(k2 * Math.PI) * 18;\n568\t      const x2 = lerp(a.a[0], a.b[0], k2), y2 = lerp(a.a[1], a.b[1], k2);\n569\t      r.actor(x, y, z, (g, ox, oy) => { const [p, q] = r.view.p(x2 - x, y2 - y, z2 - z), l = Math.hypot(p, q) || 1; px.line(g, ox - p / l * 4, oy - q / l * 4, ox + p / l * 3, oy + q / l * 3, '#e8dcc0'); px.dot(g, ox + p / l * 3, oy + q / l * 3, '#ffffff'); });\n570\t    }\n571\t    cursorDraw(r);\n572\t    hud(r);\n573\t    if (mode === 'scene') story.draw(r);\n574\t  }\n575\t  // an archer's bow in the left hand: a curve of wood and its string, upright\n576\t  function bowOf(g, u, ox, oy, v) {\n577\t    const [hx, hy, hz] = u.rig.hand('L'), [p, q] = v.p(hx - u.x, hy - u.y, hz - u.z), x = Math.round(ox + p), y = Math.round(oy + q);\n578\t    for (let i = -6; i <= 6; i++) px.dot(g, x + Math.round(2.4 * Math.cos(i / 6 * 1.2)) - 2, y + i, i % 3 ? '#8a5a2a' : '#5a3a1a');\n579\t    px.line(g, x - 1, y - 6, x - 1, y + 6, '#e8e0d0');\n580\t  }\n581\t  // the cursor: a pulsing diamond round the cell's top, and an arrow over a unit there\n582\t  function cursorDraw(r) {\n583\t    if (mode === 'scene' || mode === 'over' || !map) return;\n584\t    const [cx, cy] = cursor, z = top(cx, cy), pts = [[cx, cy], [cx + 1, cy], [cx + 1, cy + 1], [cx, cy + 1]].map(([a, b]) => r.w(a * T, b * T, z)), k = .5 + .5 * Math.sin(game.real * 7), o = unitAt(cursor);\n585\t    r.overlay(g => {\n586\t      for (let i = 0; i < 4; i++) { const [a, b] = pts[i], [c, d] = pts[(i + 1) % 4]; px.line(g, a, b, c, d, k > .5 ? '#ffffff' : '#ffe070'); }\n587\t      if (o) { const [x, y] = r.w(o.x, o.y, o.z + 40 + Math.sin(game.real * 6) * 2); px.poly(g, [[x - 4, y - 4], [x + 4, y - 4], [x, y + 1]], '#ffe070'); px.line(g, x - 4, y - 5, x + 4, y - 5, '#fff8d0'); }\n588\t    });\n589\t  }\n590\t  function hud(r) {\n591\t    const W = r.W, H = r.H, tc = touch(), u = active;\n592\t    r.overlay(g => {\n593\t      // small HP bars over every unit\n594\t      for (const o of units) { if (o.dead || mode === 'scene') continue; const [x, y] = r.w(o.x, o.y, o.z + 36); px.rect(g, x - 8, y, 16, 3, '#140c18'); px.rect(g, x - 7, y + 1, Math.max(1, Math.round(14 * o.hp / o.max)), 1, o.side === 'hero' ? '#5ad86a' : '#ff5a4a'); }\n595\t      if (over) return;   // (the results alone)\n596\t      if (mode === 'scene') { if (!tc) E.font.text(g, prompt('skip', 'SKIPS'), W - 4, 4, '#a8a0c0', { align: 'right', outline: false, font: 'tiny' }); return; }\n597\t      // the order ahead (charge time) or who is left this phase\n598\t      const list = order === 'ct' ? (turns && u ? turns.order(7) : []) : left;\n599\t      E.ui.box(g, 4, 4, 74, 12 + list.length * 10, { alpha: .78 });\n600\t      E.font.text(g, order === 'ct' ? 'ORDER' : phase === 'hero' ? 'PLAYER PHASE' : 'ENEMY PHASE', 9, 7, '#ffe8b0', { outline: false, font: 'tiny' });\n601\t      list.forEach((o, i) => { const y = 16 + i * 10; px.rect(g, 9, y + 1, 4, 5, o.side === 'hero' ? '#4ab0ff' : '#ff5a4a'); E.font.text(g, o.name, 16, y, o === u ? '#ffffff' : '#c8c0d8', o === u ? { outline: false } : { outline: false, font: 'tiny' }); });\n602\t      if (order === 'phase') E.font.text(g, 'ROUND ' + round, 9, 18 + list.length * 10, '#a8a0c0', { outline: false, font: 'tiny' });\n603\t      // the unit whose turn it is (bottom left) and the one under the cursor or selected (bottom right)\n604\t      const shown = sel && !sel.dead ? sel : unitAt(cursor);\n605\t      if (u && !u.dead) panel(g, u, 4, H - 46, u.side === 'hero' ? 'TURN' : 'ENEMY');\n606\t      if (shown && shown !== u) panel(g, shown, Math.max(84, (tc ? cornerX() : W) - 118), H - 46, shown.side === 'hero' ? 'ALLY' : 'FOE');\n607\t      // the forecast while aiming: what the blow does to the unit under the cursor\n608\t      if (mode === 'target' && cells && cells.some(c => same(c, cursor))) {\n609\t        const a = ACTS[pending], hit = hitCells(a, cell(u), cursor).map(unitAt).filter(o => o && (o !== u || a.kind === 'heal'));\n610\t        const lines = hit.slice(0, 3).map(o => { const b = blow(u, a, cell(u), o); return [o.name + (b.heal ? '  +' + b.amount : '  -' + b.amount + (b.side !== 'front' ? ' ' + b.side.toUpperCase() : '')), o.side === u.side ? '#8affc0' : '#ffd0a0']; });\n611\t        if (lines.length) { const w = Math.max(...lines.map(l => E.font.width(l[0]))) + 12, x = Math.round(W / 2 - w / 2); E.ui.box(g, x, H - 64, w, 8 + lines.length * 10, { alpha: .85 }); lines.forEach((l, i) => E.font.text(g, l[0], x + 6, H - 60 + i * 10, l[1], { outline: false })); }\n612\t      }\n613\t      // the banner, the message, the hint\n614\t      if (banner && banner.t < 1.4) { const a = banner.t < .2 ? banner.t / .2 : banner.t > 1.1 ? (1.4 - banner.t) / .3 : 1; px.blend(g, a * .75, 'normal', () => px.rect(g, 0, H / 2 - 22, W, 26, '#0a0816')); E.font.title(g, banner.s, W / 2, H / 2 - 18, { align: 'center', scale: 2, colors: ['#ffffff', banner.c, E.mix(banner.c, '#000000', .4)] }); }\n615\t      if (msg && msg.t < 2.2) E.font.text(g, msg.s, W / 2, 6, msg.c, { align: 'center', shadow: '#000', outline: false });\n616\t      if (!tc && u && u.side === 'hero' && mode !== 'busy' && mode !== 'anim' && mode !== 'ai') E.font.text(g, mode === 'command' ? 'UP DOWN CHOOSE  Z OK  X BACK  Q E TURN' : mode === 'face' ? 'ARROWS FACE  Z OK  X BACK' : 'ARROWS MOVE  Z OK  X BACK  Q E TURN', W / 2, H - 9, '#a8a0c0', { align: 'center', outline: false, font: 'tiny' });\n617\t      // TURN (touch)\n618\t      ui.turn = null;\n619\t      if (tc) { const bw = 40, bh = Math.max(16, Math.ceil(44 * game.screen.dpr / game.screen.S)), x = cornerX() - bw - 2, y = 4; ui.turn = { x, y, w: bw, h: bh }; E.ui.box(g, x, y, bw, bh, { alpha: .8 }); E.font.text(g, 'TURN', x + bw / 2, y + bh / 2 - 3, '#ffffff', { align: 'center', outline: false }); }\n620\t    });\n621\t    commandDraw(r);\n622\t    if (over) overDraw(r);\n623\t  }\n624\t  // a unit's card: name and class, HP and MP, move and jump, the way it faces\n625\t  function panel(g, o, x, y, tag) {\n626\t    E.ui.box(g, x, y, 114, 42, { alpha: .82 });\n627\t    E.font.text(g, o.name, x + 5, y + 4, o.side === 'hero' ? '#a8d8ff' : '#ffb0a0', { outline: false });\n628\t    E.font.text(g, o.cls + '  ' + tag, x + 109, y + 5, '#a8a0c0', { align: 'right', outline: false, font: 'tiny' });\n629\t    E.ui.bar(g, x + 5, y + 15, 70, 4, o.hp / o.max, o.hp > o.max * .3 ? '#5ad86a' : '#ff4a4a'); E.font.text(g, o.hp + '/' + o.max, x + 79, y + 14, '#e8e0f0', { outline: false, font: 'tiny' });\n630\t    if (o.mmp) { E.ui.bar(g, x + 5, y + 22, 70, 3, o.mp / o.mmp, '#5a8aff'); E.font.text(g, o.mp + ' MP', x + 79, y + 21, '#b0c8ff', { outline: false, font: 'tiny' }); }\n631\t    E.font.text(g, 'MOVE ' + o.move + '  JUMP ' + o.jump + '  SPD ' + Math.round(o.speed / 10), x + 5, y + 31, '#c8c0d8', { outline: false, font: 'tiny' });\n632\t  }\n633\t  // the command list (right): rows a thumb's height on a touch screen\n634\t  function commandDraw(r) {\n635\t    ui.rows = [];\n636\t    if (mode !== 'command' || !active || active.side !== 'hero' || auto) return;\n637\t    const rs = rows(active), tc = touch(), rh = tc ? Math.max(16, Math.ceil(44 * game.screen.dpr / game.screen.S)) : 12, w = 86, x = (tc ? cornerX() : r.W) - w - 4, h = rs.length * rh + 14, y = Math.max(tc ? 30 : 20, Math.round(r.H / 2 - h / 2) - 10);\n638\t    r.overlay(g => {\n639\t      E.ui.box(g, x, y, w, h, { alpha: .88 });\n640\t      E.font.text(g, active.name, x + 6, y + 3, '#ffe8b0', { outline: false, font: 'tiny' });\n641\t      rs.forEach((row, i) => {\n642\t        const ry = y + 11 + i * rh; ui.rows.push({ x, y: ry, w, h: rh });\n643\t        if (i === menuI) { px.rect(g, x + 3, ry, w - 6, rh - 1, '#2a3a7a'); px.poly(g, [[x + 5, ry + rh / 2 - 3], [x + 9, ry + rh / 2], [x + 5, ry + rh / 2 + 3]], '#ffe070'); }\n644\t        E.font.text(g, row.label, x + 12, ry + rh / 2 - 3, row.off ? '#5a5670' : '#ffffff', { outline: false });\n645\t        if (row.note) E.font.text(g, row.note, x + w - 6, ry + rh / 2 - 2, row.off ? '#5a5670' : '#8ab0ff', { align: 'right', outline: false, font: 'tiny' });\n646\t      });\n647\t    });\n648\t  }\n649\t  function overDraw(r) {\n650\t    const k = Math.min(1, over.t / .8), W = r.W, H = r.H, cy = Math.round(H / 2);\n651\t    r.overlay(g => {\n652\t      g.fillStyle = 'rgba(4,2,10,' + (.6 * k).toFixed(2) + ')'; g.fillRect(0, 0, r.bw, r.bh); E.px.reset(g);\n653\t      E.font.title(g, over.won ? 'VICTORY' : 'DEFEAT', W / 2, cy - 70, { align: 'center', scale: 3, colors: over.won ? ['#fff8d0', '#ffd060', '#e07a2a'] : ['#ffd0d0', '#ff5a5a', '#8a1a2a'] });\n654\t      const mvp = Object.entries(stats.dealt).sort((a, b) => b[1] - a[1])[0], lines = [over.won ? 'THORNWATCH IS TAKEN' : 'THE LEGION HOLDS THORNWATCH', 'TURNS ' + stats.turns + '   HEROES STANDING ' + living('hero').length + ' OF 4', mvp ? 'MOST DAMAGE: ' + mvp[0] + ' (' + mvp[1] + ')' : ''];\n655\t      lines.forEach((s, i) => E.font.text(g, s, W / 2, cy - 20 + i * 11, i ? '#e8e0f0' : '#ffe070', { align: 'center', shadow: '#000', outline: false }));\n656\t      endMenu.y = cy + 26;\n657\t    });\n658\t    if (over.t > 1.6) endMenu.draw(r);\n659\t  }\n660\t\n661\t  /* ---- 9. THE BOT: the heroes' own AI plays the battle, through the same orders a player's commands give: by charge\n662\t   * time twice (the AI's turns repeat: the same battle), then by phases (tools/kits-test.mjs) ---- */\n663\t  function bot(o = {}) {\n664\t    const was = Math.random, one = phases => {\n665\t      Math.random = E.rng(o.seed || 1);\n666\t      game.time = 0; game.timeScale = 1; game.go('tactics', { part: phases ? 'phases' : 'battle', auto: true }, { fade: 0 }); game.advance(1 / 120);\n667\t      for (let i = 0; i < 40000 && !over; i++) game.advance(1 / 30);\n668\t      return { won: !!(over && over.won), turns: stats.turns, heroes: living('hero').length, hp: living('hero').map(u => u.hp), dealt: stats.dealt };\n669\t    };\n670\t    try {\n671\t      const a = one(false), b = one(false), p = one(true);\n672\t      return Object.assign(a, { repeat: JSON.stringify(a) === JSON.stringify(b), phases: p, errors: game.errors.length });\n673\t    } finally { Math.random = was; }\n674\t  }\n675\t\n676\t  return { view: 'iso', views: ['iso'], res: 'ps1', pausable: true, propSize: 1, touch: [], camera: { zoom: [.75, 2], start: 1, tall: 1.35 },\n677\t    input: { ...E.Input.DEFAULT, turnL: ['KeyQ', 'Pad4'], turnR: ['KeyE', 'Pad5'], skip: ['KeyX', 'Pad8'], skill: ['KeyL', 'Mouse2', 'Pad2'] },\n678\t    enter: start, update, draw, bot,\n679\t    exit() { game.input.steer = 'stick'; game.resetCamera(); },\n680\t    back() { if (mode === 'move' || mode === 'target' || mode === 'face') { back(); return true; } return false; },   // a phone's back: aiming goes back to the commands\n681\t    /** for tests: the state, and helpers to find a cell or a row on the screen and to place a unit */\n682\t    state: () => ({ mode, order, phase, round, active, cursor, sel, units, cells, over, stats, map, grid, turns, rows: active ? rows(active) : [], ui,\n683\t      at: (cx, cy) => { const v = game.view, [x, y] = map.center(cx, cy), q = v.p(x, y, top(cx, cy)); return [q[0] - game.screen.ix, q[1] - game.screen.iy]; },\n684\t      place: (u, cx, cy) => { u.cx = cx; u.cy = cy; u.path = null; }, plan: u => plan(u), reach: u => reachOf(u) }),\n685\t    /** the proof: the scene's lines and its first choice (charge time), then the cursor walked about and confirmed; the\n686\t     *  Legion's turns between; a hash of every unit's cell and HP and the turns taken */\n687\t    run: (n = 600) => proof('tactics', n, (i, k) => { if (i % 30 === 10) k.tap('confirm'); walk(i, k, ['up', 'left', 'down', 'right'], 50); },\n688\t      () => [mode, stats.turns, units.map(u => [u.cx, u.cy, u.hp, u.mp, u.dead])]) };\n689\t})();\n690\tscenes.tactics = TACTICS;\n691\t\n692\t/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n693\t// a genre kit file holds one slice: the menu lists only the slices in this file\n694\tfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\n695\ttitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n696\t// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n697\t// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\n698\tconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\n699\tgame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\n700\twindow.__game = { game, scenes, titleMenu };   // for tests\n701\t})();\n702\t/* =============================== GAME END =============================== */\n703\t"}]},"parent_tool_use_id":null,"session_id":"2ba7a3b6-c05c-41f2-add8-99edaaa21587","uuid":"85453cb5-067e-4f4d-87da-beac306099bf","timestamp":"2026-11-04T12:03:44.803Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/.claude/projects/-home-micha-dev-cc-matrix-runs-claude-opus-5-5-medium-build--20261104-050223--x7910ab-work/2ba7a3b6-c05c-41f2-add8-99edaaa21587/tool-results/bvyyh32d1.txt","content":"      else A.sfx('select');\n    }\n  }\n  function back() {\n    const u = active;\n    if (mode === 'move' || mode === 'target' || mode === 'face') { mode = 'command'; cells = null; cursor = cell(u); A.sfx('cancel'); return; }\n    if (mode === 'command' && u.moved && !u.acted && !u.path) {   // undo the move\n      const [x, y] = map.center(...u.at0); u.cx = u.at0[0]; u.cy = u.at0[1]; u.x = x; u.y = y; u.z = top(...u.at0); u.moved = false; cursor = cell(u); A.sfx('cancel'); menuI = 0;\n    }\n  }\n  // the step the keys ask for, on the grid: turned from the screen (a small bias splits iso's diagonals the same way each time)\n  const tapped = () => { const I = game.input, x = (I.pressed('right') ? 1 : 0) - (I.pressed('left') ? 1 : 0), y = (I.pressed('down') ? 1 : 0) - (I.pressed('up') ? 1 : 0); return x || y ? [x, y] : null; };\n  function keyDir() {\n    const t = tapped(), m = t || game.input.move(); if (Math.hypot(m[0], m[1]) < .5) return null;\n    if (t) hold = 0;   // (a tap shorter than a step still moves it)\n    const g = game.view.screenDirToGround(m[0], m[1]), a = Math.atan2(g[1], g[0]) + .01, k = Math.round(a / (Math.PI / 2));\n    return [Math.round(Math.cos(k * Math.PI / 2)), Math.round(Math.sin(k * Math.PI / 2))];\n  }\n  // the HUD's boxes this frame (taps and clicks hit them): the command list's rows, TURN\n  let ui = { rows: [], turn: null };\n  const hitBox = (b, p) => b && p && p[0] >= b.x && p[0] < b.x + b.w && p[1] >= b.y && p[1] < b.y + b.h;\n  function playerInput(dt) {\n    const I = game.input, u = active, tap = I.clicked(), p = I.pointer();\n    if (I.pressed('turnL') || I.pressed('turnR') || (tap && hitBox(ui.turn, tap))) { game.rotateView(I.pressed('turnL') ? -90 : 90); A.sfx('select'); return; }\n    if (mode === 'command') {\n      const rs = rows(u), k = tap ? ui.rows.findIndex(b => hitBox(b, tap)) : -1;\n      if (k >= 0) { menuI = k; command(rs[k]); return; }\n      if (p && !same(p, ptr)) { const h = ui.rows.findIndex(b => hitBox(b, p)); if (h >= 0) menuI = h; }\n      const t = tapped(), m = t || I.move(), dy = Math.abs(m[1]) > .5 ? Math.sign(m[1]) : 0; if (t) hold = 0;\n      if (dy && hold <= 0) { menuI = (menuI + dy + rs.length) % rs.length; A.sfx('select'); hold = held ? .09 : .25; held = true; } else if (!dy) { held = false; hold = 0; }\n      hold -= dt;\n      if (I.pressed('confirm')) { command(rs[menuI]); return; }\n      if (I.pressed('cancel')) { back(); return; }\n    } else {\n      const d = keyDir();\n      if (d && hold <= 0) { const c = [clamp(cursor[0] + d[0], 0, map.w - 1), clamp(cursor[1] + d[1], 0, map.h - 1)]; if (!same(c, cursor)) { cursor = c; aimLook(c); A.sfx('blip'); } hold = held ? .09 : .22; held = true; } else if (!d) { held = false; hold = 0; }\n      hold -= dt;\n      if (I.pressed('confirm')) { confirmAt(cursor); return; }\n      if (I.pressed('cancel')) { back(); return; }\n    }\n    // the mouse's pointer moves the cursor over the map; a click or tap there confirms on that cell (map.pick)\n    if (p && !same(p, ptr) && I.lastDevice !== 'touch' && !ui.rows.some(b => hitBox(b, p))) { const h = map.pick(p[0], p[1], game); if (h && !same([h.cx, h.cy], cursor)) cursor = [h.cx, h.cy]; }\n    if (tap && !ui.rows.some(b => hitBox(b, tap))) {\n      const h = map.pick(tap[0], tap[1], game); if (!h) return;\n      const c = [h.cx, h.cy]; cursor = c;\n      if (mode === 'command') confirmAt(c);\n      else if (cells && cells.some(k => same(k, c))) confirmAt(c);\n      else if (mode !== 'face') { sel = unitAt(c); A.sfx('select'); }\n      else confirmAt(c);\n    }\n  }\n\n  /* ---- 7. EACH STEP: the rigs, the walks, the arrows, the queue of beats, the player or the scene ---- */\n  function update(dt) {\n    const I = game.input;\n    for (const u of units) {\n      if (u.path) {   // along the path a step at a time, hopping up or down a level\n        u.st += dt / STEP;\n        while (u.path && u.st >= 1) { u.st -= 1; u.seg++; if (u.seg >= u.path.length - 1) { const [cx, cy] = u.path[u.path.length - 1]; u.cx = cx; u.cy = cy; u.path = null; const f = u.after; u.after = null; if (f) f(); } else A.sfx('step', { vol: .4 }); }\n        if (u.path) {\n          const a = u.path[u.seg], b = u.path[u.seg + 1], [ax, ay] = map.center(...a), [bx, by] = map.center(...b), k = u.st, za = top(...a), zb = top(...b);\n          u.x = lerp(ax, bx, k); u.y = lerp(ay, by, k); u.z = lerp(za, zb, k) + (za !== zb ? Math.sin(k * Math.PI) * (6 + Math.abs(zb - za) * .4) : 0); u.facing = [b[0] - a[0], b[1] - a[1]]; u.cx = b[0]; u.cy = b[1];\n        }\n      }\n      if (!u.path) { const [x, y] = map.center(u.cx, u.cy); u.x = x; u.y = y; u.z = top(u.cx, u.cy); }\n      if (u.swing) { u.swing.update(dt); if (!u.swing.phase) u.swing = null; }\n      u.hit = Math.max(0, u.hit - dt); if (u.dead) u.die += dt;\n      const walking = !!u.path, f = Math.atan2(u.facing[1], u.facing[0]);\n      u.rig.update(dt, { x: u.x, y: u.y, z: u.z, vx: walking ? Math.cos(f) * T / STEP : 0, vy: walking ? Math.sin(f) * T / STEP : 0, facing: f, attack: u.swing ? u.swing.state : null,\n        pose: u.dead ? 'die' : over && over.won && u.side === 'hero' ? 'cheer' : null, hurt: u.hit > 0 ? u.hit * 4 : 0, look: [Math.cos(f), Math.sin(f)] });\n    }\n    for (let i = arrows.length - 1; i >= 0; i--) { const a = arrows[i]; a.t += dt / a.dur; if (a.t >= 1) { arrows.splice(i, 1); a.then(); } }\n    if (banner) banner.t += dt; if (msg) msg.t += dt;\n    // the camera: toward what it looks at, a drag panning it (touch)\n    const dr = I.drag(); if (dr && (Math.abs(dr[0]) + Math.abs(dr[1]) > 0)) { const g = game.view.screenDirToGround(-dr[0], -dr[1]), l = Math.hypot(dr[0], dr[1]) / (game.view.scale || 1); look[0] += g[0] * l; look[1] += g[1] * l; }\n    game.focus(look[0], look[1], look[2]);\n    if (mode === 'scene') { if (I.pressed('skip')) { story.stop(); order = 'ct'; begin(); } else story.update(dt); ptr = I.pointer(); return; }\n    if (mode === 'over') { over.t += dt; if (over.t > 1.6) endMenu.update(dt); return; }\n    if (queue.length && !units.some(u => u.path) && !arrows.length && !acting) { wait += dt; if (wait >= queue[0][0]) { wait = 0; queue.shift()[1](); } }\n    if (!auto && active && active.side === 'hero' && (mode === 'command' || mode === 'move' || mode === 'target' || mode === 'face')) playerInput(dt);\n    if (mode === 'face') { const d = keyDir(); if (d) active.facing = d; }\n    ptr = I.pointer();\n  }\n\n  /* ---- 8. DRAWING: a sky, the map on its base, its trees and banners, the ranges, the units, the cursor, the HUD ---- */\n  function draw(r) {\n    r.sky(['#16203e', '#2e4a78', '#7a9ab8', '#c8c0a8']);\n    map.drawFloor(r); map.queueWalls(r);\n    for (const s of map.spawns) { const z = top(s.cx, s.cy); if (s.tag === 'tree') r.prop(E.hash2(s.cx, s.cy) < .5 ? 'tree' : 'pine', s.x, s.y, z); else r.prop(s.tag, s.x, s.y, z); }\n    // ranges: blue to move, red to strike, gold the blow's area, the selected unit's reach faint when it isn't its turn\n    const h = (x, y) => top(x, y) + .5;\n    if (cells && mode === 'move') E.tint(r, cells, '#3a9aff', .6, T, h);\n    if (cells && mode === 'target') { E.tint(r, cells, '#ff3a4a', .55, T, h); if (cells.some(c => same(c, cursor))) E.tint(r, hitCells(ACTS[pending], cell(active), cursor), '#ffd040', .7, T, h); }\n    if (cells && mode === 'ai') E.tint(r, cells, '#ff6a2a', .5, T, h);\n    if (cells && mode === 'face') E.tint(r, cells, '#ffe060', .3, T, h);\n    if (mode !== 'scene') for (const u of units) if (!u.dead) E.tint(r, [cell(u)], u.side === 'hero' ? '#4ab0ff' : '#ff4a4a', u === active ? .55 : .22, T, h);\n    for (const u of units) {\n      if (u.dead && u.die > 1.2) continue;\n      r.shadow(u.x, u.y, 6, .4, '#0c0818', u.z);\n      r.actor(u.x, u.y, u.z, (g, ox, oy) => { u.rig.draw(g, ox, oy, r.view); if (u.bow) bowOf(g, u, ox, oy, r.view); }, { flash: u.hit > .15 && '#ffffff', alpha: u.dead ? Math.max(0, 1 - (u.die - .6) * 1.6) : 1, xray: u === active && !u.dead });   // (x-ray is for one: the unit whose turn it is)\n    }\n    for (const a of arrows) {   // an arrow on its arc, pointing along it\n      const k = a.t, z = lerp(a.a[2], a.b[2], k) + Math.sin(k * Math.PI) * 18, x = lerp(a.a[0], a.b[0], k), y = lerp(a.a[1], a.b[1], k), k2 = Math.min(1, k + .06), z2 = lerp(a.a[2], a.b[2], k2) + Math.sin(k2 * Math.PI) * 18;\n      const x2 = lerp(a.a[0], a.b[0], k2), y2 = lerp(a.a[1], a.b[1], k2);\n      r.actor(x, y, z, (g, ox, oy) => { const [p, q] = r.view.p(x2 - x, y2 - y, z2 - z), l = Math.hypot(p, q) || 1; px.line(g, ox - p / l * 4, oy - q / l * 4, ox + p / l * 3, oy + q / l * 3, '#e8dcc0'); px.dot(g, ox + p / l * 3, oy + q / l * 3, '#ffffff'); });\n    }\n    cursorDraw(r);\n    hud(r);\n    if (mode === 'scene') story.draw(r);\n  }\n  // an archer's bow in the left hand: a curve of wood and its string, upright\n  function bowOf(g, u, ox, oy, v) {\n    const [hx, hy, hz] = u.rig.hand('L'), [p, q] = v.p(hx - u.x, hy - u.y, hz - u.z), x = Math.round(ox + p), y = Math.round(oy + q);\n    for (let i = -6; i <= 6; i++) px.dot(g, x + Math.round(2.4 * Math.cos(i / 6 * 1.2)) - 2, y + i, i % 3 ? '#8a5a2a' : '#5a3a1a');\n    px.line(g, x - 1, y - 6, x - 1, y + 6, '#e8e0d0');\n  }\n  // the cursor: a pulsing diamond round the cell's top, and an arrow over a unit there\n  function cursorDraw(r) {\n    if (mode === 'scene' || mode === 'over' || !map) return;\n    const [cx, cy] = cursor, z = top(cx, cy), pts = [[cx, cy], [cx + 1, cy], [cx + 1, cy + 1], [cx, cy + 1]].map(([a, b]) => r.w(a * T, b * T, z)), k = .5 + .5 * Math.sin(game.real * 7), o = unitAt(cursor);\n    r.overlay(g => {\n      for (let i = 0; i < 4; i++) { const [a, b] = pts[i], [c, d] = pts[(i + 1) % 4]; px.line(g, a, b, c, d, k > .5 ? '#ffffff' : '#ffe070'); }\n      if (o) { const [x, y] = r.w(o.x, o.y, o.z + 40 + Math.sin(game.real * 6) * 2); px.poly(g, [[x - 4, y - 4], [x + 4, y - 4], [x, y + 1]], '#ffe070'); px.line(g, x - 4, y - 5, x + 4, y - 5, '#fff8d0'); }\n    });\n  }\n  function hud(r) {\n    const W = r.W, H = r.H, tc = touch(), u = active;\n    r.overlay(g => {\n      // small HP bars over every unit\n      for (const o of units) { if (o.dead || mode === 'scene') continue; const [x, y] = r.w(o.x, o.y, o.z + 36); px.rect(g, x - 8, y, 16, 3, '#140c18'); px.rect(g, x - 7, y + 1, Math.max(1, Math.round(14 * o.hp / o.max)), 1, o.side === 'hero' ? '#5ad86a' : '#ff5a4a'); }\n      if (over) return;   // (the results alone)\n      if (mode === 'scene') { if (!tc) E.font.text(g, prompt('skip', 'SKIPS'), W - 4, 4, '#a8a0c0', { align: 'right', outline: false, font: 'tiny' }); return; }\n      // the order ahead (charge time) or who is left this phase\n      const list = order === 'ct' ? (turns && u ? turns.order(7) : []) : left;\n      E.ui.box(g, 4, 4, 74, 12 + list.length * 10, { alpha: .78 });\n      E.font.text(g, order === 'ct' ? 'ORDER' : phase === 'hero' ? 'PLAYER PHASE' : 'ENEMY PHASE', 9, 7, '#ffe8b0', { outline: false, font: 'tiny' });\n      list.forEach((o, i) => { const y = 16 + i * 10; px.rect(g, 9, y + 1, 4, 5, o.side === 'hero' ? '#4ab0ff' : '#ff5a4a'); E.font.text(g, o.name, 16, y, o === u ? '#ffffff' : '#c8c0d8', o === u ? { outline: false } : { outline: false, font: 'tiny' }); });\n      if (order === 'phase') E.font.text(g, 'ROUND ' + round, 9, 18 + list.length * 10, '#a8a0c0', { outline: false, font: 'tiny' });\n      // the unit whose turn it is (bottom left) and the one under the cursor or selected (bottom right)\n      const shown = sel && !sel.dead ? sel : unitAt(cursor);\n      if (u && !u.dead) panel(g, u, 4, H - 46, u.side === 'hero' ? 'TURN' : 'ENEMY');\n      if (shown && shown !== u) panel(g, shown, Math.max(84, (tc ? cornerX() : W) - 118), H - 46, shown.side === 'hero' ? 'ALLY' : 'FOE');\n      // the forecast while aiming: what the blow does to the unit under the cursor\n      if (mode === 'target' && cells && cells.some(c => same(c, cursor))) {\n        const a = ACTS[pending], hit = hitCells(a, cell(u), cursor).map(unitAt).filter(o => o && (o !== u || a.kind === 'heal'));\n        const lines = hit.slice(0, 3).map(o => { const b = blow(u, a, cell(u), o); return [o.name + (b.heal ? '  +' + b.amount : '  -' + b.amount + (b.side !== 'front' ? ' ' + b.side.toUpperCase() : '')), o.side === u.side ? '#8affc0' : '#ffd0a0']; });\n        if (lines.length) { const w = Math.max(...lines.map(l => E.font.width(l[0]))) + 12, x = Math.round(W / 2 - w / 2); E.ui.box(g, x, H - 64, w, 8 + lines.length * 10, { alpha: .85 }); lines.forEach((l, i) => E.font.text(g, l[0], x + 6, H - 60 + i * 10, l[1], { outline: false })); }\n      }\n      // the banner, the message, the hint\n      if (banner && banner.t < 1.4) { const a = banner.t < .2 ? banner.t / .2 : banner.t > 1.1 ? (1.4 - banner.t) / .3 : 1; px.blend(g, a * .75, 'normal', () => px.rect(g, 0, H / 2 - 22, W, 26, '#0a0816')); E.font.title(g, banner.s, W / 2, H / 2 - 18, { align: 'center', scale: 2, colors: ['#ffffff', banner.c, E.mix(banner.c, '#000000', .4)] }); }\n      if (msg && msg.t < 2.2) E.font.text(g, msg.s, W / 2, 6, msg.c, { align: 'center', shadow: '#000', outline: false });\n      if (!tc && u && u.side === 'hero' && mode !== 'busy' && mode !== 'anim' && mode !== 'ai') E.font.text(g, mode === 'command' ? 'UP DOWN CHOOSE  Z OK  X BACK  Q E TURN' : mode === 'face' ? 'ARROWS FACE  Z OK  X BACK' : 'ARROWS MOVE  Z OK  X BACK  Q E TURN', W / 2, H - 9, '#a8a0c0', { align: 'center', outline: false, font: 'tiny' });\n      // TURN (touch)\n      ui.turn = null;\n      if (tc) { const bw = 40, bh = Math.max(16, Math.ceil(44 * game.screen.dpr / game.screen.S)), x = cornerX() - bw - 2, y = 4; ui.turn = { x, y, w: bw, h: bh }; E.ui.box(g, x, y, bw, bh, { alpha: .8 }); E.font.text(g, 'TURN', x + bw / 2, y + bh / 2 - 3, '#ffffff', { align: 'center', outline: false }); }\n    });\n    commandDraw(r);\n    if (over) overDraw(r);\n  }\n  // a unit's card: name and class, HP and MP, move and jump, the way it faces\n  function panel(g, o, x, y, tag) {\n    E.ui.box(g, x, y, 114, 42, { alpha: .82 });\n    E.font.text(g, o.name, x + 5, y + 4, o.side === 'hero' ? '#a8d8ff' : '#ffb0a0', { outline: false });\n    E.font.text(g, o.cls + '  ' + tag, x + 109, y + 5, '#a8a0c0', { align: 'right', outline: false, font: 'tiny' });\n    E.ui.bar(g, x + 5, y + 15, 70, 4, o.hp / o.max, o.hp > o.max * .3 ? '#5ad86a' : '#ff4a4a'); E.font.text(g, o.hp + '/' + o.max, x + 79, y + 14, '#e8e0f0', { outline: false, font: 'tiny' });\n    if (o.mmp) { E.ui.bar(g, x + 5, y + 22, 70, 3, o.mp / o.mmp, '#5a8aff'); E.font.text(g, o.mp + ' MP', x + 79, y + 21, '#b0c8ff', { outline: false, font: 'tiny' }); }\n    E.font.text(g, 'MOVE ' + o.move + '  JUMP ' + o.jump + '  SPD ' + Math.round(o.speed / 10), x + 5, y + 31, '#c8c0d8', { outline: false, font: 'tiny' });\n  }\n  // the command list (right): rows a thumb's height on a touch screen\n  function commandDraw(r) {\n    ui.rows = [];\n    if (mode !== 'command' || !active || active.side !== 'hero' || auto) return;\n    const rs = rows(active), tc = touch(), rh = tc ? Math.max(16, Math.ceil(44 * game.screen.dpr / game.screen.S)) : 12, w = 86, x = (tc ? cornerX() : r.W) - w - 4, h = rs.length * rh + 14, y = Math.max(tc ? 30 : 20, Math.round(r.H / 2 - h / 2) - 10);\n    r.overlay(g => {\n      E.ui.box(g, x, y, w, h, { alpha: .88 });\n      E.font.text(g, active.name, x + 6, y + 3, '#ffe8b0', { outline: false, font: 'tiny' });\n      rs.forEach((row, i) => {\n        const ry = y + 11 + i * rh; ui.rows.push({ x, y: ry, w, h: rh });\n        if (i === menuI) { px.rect(g, x + 3, ry, w - 6, rh - 1, '#2a3a7a'); px.poly(g, [[x + 5, ry + rh / 2 - 3], [x + 9, ry + rh / 2], [x + 5, ry + rh / 2 + 3]], '#ffe070'); }\n        E.font.text(g, row.label, x + 12, ry + rh / 2 - 3, row.off ? '#5a5670' : '#ffffff', { outline: false });\n        if (row.note) E.font.text(g, row.note, x + w - 6, ry + rh / 2 - 2, row.off ? '#5a5670' : '#8ab0ff', { align: 'right', outline: false, font: 'tiny' });\n      });\n    });\n  }\n  function overDraw(r) {\n    const k = Math.min(1, over.t / .8), W = r.W, H = r.H, cy = Math.round(H / 2);\n    r.overlay(g => {\n      g.fillStyle = 'rgba(4,2,10,' + (.6 * k).toFixed(2) + ')'; g.fillRect(0, 0, r.bw, r.bh); E.px.reset(g);\n      E.font.title(g, over.won ? 'VICTORY' : 'DEFEAT', W / 2, cy - 70, { align: 'center', scale: 3, colors: over.won ? ['#fff8d0', '#ffd060', '#e07a2a'] : ['#ffd0d0', '#ff5a5a', '#8a1a2a'] });\n      const mvp = Object.entries(stats.dealt).sort((a, b) => b[1] - a[1])[0], lines = [over.won ? 'THORNWATCH IS TAKEN' : 'THE LEGION HOLDS THORNWATCH', 'TURNS ' + stats.turns + '   HEROES STANDING ' + living('hero').length + ' OF 4', mvp ? 'MOST DAMAGE: ' + mvp[0] + ' (' + mvp[1] + ')' : ''];\n      lines.forEach((s, i) => E.font.text(g, s, W / 2, cy - 20 + i * 11, i ? '#e8e0f0' : '#ffe070', { align: 'center', shadow: '#000', outline: false }));\n      endMenu.y = cy + 26;\n    });\n    if (over.t > 1.6) endMenu.draw(r);\n  }\n\n  /* ---- 9. THE BOT: the heroes' own AI plays the battle, through the same orders a player's commands give: by charge\n   * time twice (the AI's turns repeat: the same battle), then by phases (tools/kits-test.mjs) ---- */\n  function bot(o = {}) {\n    const was = Math.random, one = phases => {\n      Math.random = E.rng(o.seed || 1);\n      game.time = 0; game.timeScale = 1; game.go('tactics', { part: phases ? 'phases' : 'battle', auto: true }, { fade: 0 }); game.advance(1 / 120);\n      for (let i = 0; i < 40000 && !over; i++) game.advance(1 / 30);\n      return { won: !!(over && over.won), turns: stats.turns, heroes: living('hero').length, hp: living('hero').map(u => u.hp), dealt: stats.dealt };\n    };\n    try {\n      const a = one(false), b = one(false), p = one(true);\n      return Object.assign(a, { repeat: JSON.stringify(a) === JSON.stringify(b), phases: p, errors: game.errors.length });\n    } finally { Math.random = was; }\n  }\n\n  return { view: 'iso', views: ['iso'], res: 'ps1', pausable: true, propSize: 1, touch: [], camera: { zoom: [.75, 2], start: 1, tall: 1.35 },\n    input: { ...E.Input.DEFAULT, turnL: ['KeyQ', 'Pad4'], turnR: ['KeyE', 'Pad5'], skip: ['KeyX', 'Pad8'], skill: ['KeyL', 'Mouse2', 'Pad2'] },\n    enter: start, update, draw, bot,\n    exit() { game.input.steer = 'stick'; game.resetCamera(); },\n    back() { if (mode === 'move' || mode === 'target' || mode === 'face') { back(); return true; } return false; },   // a phone's back: aiming goes back to the commands\n    /** for tests: the state, and helpers to find a cell or a row on the screen and to place a unit */\n    state: () => ({ mode, order, phase, round, active, cursor, sel, units, cells, over, stats, map, grid, turns, rows: active ? rows(active) : [], ui,\n      at: (cx, cy) => { const v = game.view, [x, y] = map.center(cx, cy), q = v.p(x, y, top(cx, cy)); return [q[0] - game.screen.ix, q[1] - game.screen.iy]; },\n      place: (u, cx, cy) => { u.cx = cx; u.cy = cy; u.path = null; }, plan: u => plan(u), reach: u => reachOf(u) }),\n    /** the proof: the scene's lines and its first choice (charge time), then the cursor walked about and confirmed; the\n     *  Legion's turns between; a hash of every unit's cell and HP and the turns taken */\n    run: (n = 600) => proof('tactics', n, (i, k) => { if (i % 30 === 10) k.tap('confirm'); walk(i, k, ['up', 'left', 'down', 'right'], 50); },\n      () => [mode, stats.turns, units.map(u => [u.cx, u.cy, u.hp, u.mp, u.dead])]) };\n})();\nscenes.tactics = TACTICS;\n\n/* ---- START: the title menu, or a slice named in the address (#platformer) ---- */\n// a genre kit file holds one slice: the menu lists only the slices in this file\nfor (let i = SLICES.length - 1; i >= 0; i--) if (!scenes[SLICES[i].id]) SLICES.splice(i, 1);\ntitleMenu = menuOf(SLICES, { y: 76, onPick: i => game.go(SLICES[i].id) });\n// #<slice>/<part> jumps in (#arcade/maze, #shooter/horizontal): the slice's enter(data) gets { part }; a part that is a\n// scene of its own (the slice's parts: { battle: 'rpg-battle' }) starts there\nconst [first, part] = (location.hash || '').slice(1).split('/'), sc = scenes[first], to = sc && part && sc.parts && sc.parts[part];\ngame.start({ scenes, scene: to || (sc ? first : 'title'), data: sc && part ? { part } : undefined });\nwindow.__game = { game, scenes, titleMenu };   // for tests\n})();\n/* =============================== GAME END =============================== */\n","numLines":239,"startLine":465,"totalLines":703}},"tool_result_meta":[{"id":"toolu_0188RqcF8SuV3jq2LAvhGjnc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
