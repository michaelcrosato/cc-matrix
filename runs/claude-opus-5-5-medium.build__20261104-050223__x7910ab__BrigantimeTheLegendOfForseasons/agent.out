)) { V.update(dt); return; }\\n    if (G.dev.open) { G.devUpdate(dt); V.update(dt); return; }\"\nnew=\"    if (G.dev.open) { G.devUpdate(dt); V.update(dt); return; }\\n    if (this.talk.open) { this.talk.update(dt); V.update(dt); this.cam(dt); return; }\\n    if (this.confirm.update(dt)) { V.update(dt); return; }\"\nassert old in s; s=s.replace(old,new); open(p,'w').write(s)\nEOF\nnode tests/run.mjs front","description":"Dev panel first in battle update; rerun"}}}
