-pointer phone): the notice shows and nothing is a touch control', async () => {\n  const ph = await b.newPage({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 3, isMobile: true, hasTouch: true }); await ph.goto(new URL(name, root).href); await ph.waitForTimeout(2500);\n  const s = await ph.evaluate(() => ({ t: window.__game.game.debug.snapshot().touchOnly, te: window.__game.game.input.touchEnabled })); await ph.close(); if (!s.t || s.te) throw new Error(JSON.stringify(s));\n});\nawait b.close(); console.log(\"\"\"\nassert old in s; s=s.replace(old,new,1); open(p,'w').write(s)\np='tests/run.mjs'; s=open(p).read(); s=s.replace(\"pass += 5;\",\"pass += 7;\"); open(p,'w').write(s)\nEOF\nexport TMPDIR=$(pwd)/.tmp && node tests/browser.mjs && node tests/run.mjs --browser 2>&1 | tail -1","description":"Add mouse and phone touch-only checks to browser suite; full run"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":3672,"cache_read_input_tokens":727719,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3672},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2ba7a3b6-c05c-41f2-add8-99edaaa21587","uuid":"d1ab3a12-732e-479e-a26e-5b4843dec649","timestamp":"2026-11-04T13:20:27.570Z","request_id":"req_011CghxQbmaRqEpzvUh4ke2a","wire_tool_inputs":{"toolu_01RNzazjdZ4LGwKLKEXuAxAP":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261104-050223__x7910ab/work/Brig*/ && python3 - <<'EOF'\np='tests/browser.mjs'; s=open(p).read()\nold=\"await b.close(); console.log(\"\nnew=\"\"\"await t('mouse: hover moves the battle cursor, a click on a unit opens its commands', async () => {\n  await p.goto(new URL(name, root).href + '#battle/border_meadow/spring'); await p.w