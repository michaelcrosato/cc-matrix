f.........ff',\n  '.1..h....8hh...',\n  '.........hhhh..',\n  ',2,,,,,,,hK7hf.',\n  '.........hhhh..',\n  '.3..h....9hh...',\n  '...ff........ff',\n  '..fffff.....fff',\n  '...fffff.....ff']);\nMAP('marsh_keep', 'Marsh Keep', [\n  '...............',\n  '..fss.fss......',\n  '...sss.sss.8.f.',\n  '.1.ss~.ss~..h..',\n  '...............',\n  ',2,,,,,,,,,K7..',\n  '......sss......',\n  '.3ss.ss~s...9..',\n  '..ssssssss.~ss.',\n  '..ss.sss~..sss.',\n  '......sss...ss.'], { flood: true });\nMAP('lakeside', 'Lakeside', [\n  '.fff........ff.',\n  '.ff..LLLL..fff.',\n  '.....LLLLLh.ff.',\n  '.1...LLLLL..8..',\n  '......LLLL.....',\n  '..2...LLL..K7..',\n  '...........,...',\n  ',3,.....,,,9...',\n  '.ff,,,,,,h...ff',\n  'ffffff......fff',\n  '.ff.ff.......ff']);\nMAP('ruined_abbey', 'Ruined Abbey', [\n  '.ff........ffff',\n  'fff........ffff',\n  '.ff..#..#....ff',\n  '.1...#.r...r8..',\n  '........r.r....',\n  ',2,,,,,,,,,K7..',\n  '..........r....',\n  '.3...r.r.#.r9..',\n  '..ff..#..#...ff',\n  '.fff........fff',\n  '..ff.........ff']);\nMAP('crossroads', 'Crossroads', [\n  'f......,.....f.',\n  '..FF...,FF.....',\n  '..FFF..,FFF.#..',\n  '.1FF.#.,FF.8...',\n  '.......,.#.....',\n  ',2,,,,,,,,,K7,,',\n  '.......,.#.....',\n  '.3FF.#.,FF.9...',\n  '..FFF..,FFF.#..',\n  '..FF...,FF.....',\n  'f......,.....f.'], { blockShape: 'cottage' });\nMAP('capital_citadel', 'Capital Citadel', [\n  '..fffff.......fff',\n  '.fffff........ff.',\n  '..ff.............',\n  '......h...####...',\n  '.1........#8gg#..',\n  '.....h...#gggg#ff',\n  ',,,,,,,,,,ggK7g#f',\n  '.2.......#gggg#ff',\n  '..........#g9g#..',\n  '......h..,g###...',\n  '.ff3....,,.......',\n  'fff..,,,......ff.',\n  '.ff.,,ff......fff']);\nMAP('meridian_clockyard', 'Meridian Clockyard', [\n  '..,,...........rr',\n  '...,,,,.......rrr',\n  '...rr..,g####..rr',\n  '..rrr..#gg8g#....',\n  '.1.rr..#g#gg##...',\n  '......#gggggg#...',\n  ',2,,,,,gggK7g##..',\n  '......#gggggg#...',\n  '.3.rr..#g#gg##...',\n  '..rrr..#gg9g#....