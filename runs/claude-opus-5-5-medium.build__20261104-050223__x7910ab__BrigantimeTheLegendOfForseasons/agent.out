 === ' ') menu.items[menu.at].act();\n}\n/** The local stick: keys, the first gamepad, or a held pointer. Still while the menu is open. */\nfunction stick(me) {\n  if (menu.open) return { x: 0, y: 0, sprint: false };\n  let x = 0, y = 0;\n  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n  if (keys.has('arrowright') || keys.has('d')) x += 1;\n  if (keys.has('arrowup') || keys.has('w')) y -= 1;\n  if (keys.has('arrowdown') || keys.has('s')) y += 1;\n  if (pad) {\n    if (Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n    if (Math.abs(pad.axes[1]) > 0.2) y = pad.axes[1];\n    if (padNow[12]) y = -1;\n    if (padNow[13]) y = 1;\n    if (padNow[14]) x = -1;\n    if (padNow[15]) x = 1;\n  }\n  if (pointer && me) {\n    const p = toWorld(pointer);\n    const dx = p.x - me.x, dy = p.y - me.y, d = Math.hypot(dx, dy);\n    if (d > 8) { x = dx / d; y = dy / d; }\n  }\n  const sprint = keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7];\n  const len = Math.hypot(x, y);\n  return len > 1 ? { x: x / len, y: y / len, sprint } : { x, y, sprint };\n}\nfunction toWorld(e) {\n  const r = canvas.getBoundingClientRect(), s = Math.min(r.width / W, r.height / H);\n  return { x: (e.clientX - r.left - (r.width - W * s) / 2) / s, y: (e.clientY - r.top - (r.height - H * s) / 2) / s };\n}\n// ---- state shared by both modes\nconst game = {\n  phase: 'title',            // title | waiting | playing | over\n  players: [],               // {id, name, color, x, y, score, gone}, drawn at x, y\n  star: { x: W / 2, y: H / 2, n: 0 },   // n numbers the stars, so a claim names the one it touched\n  rng: Math.random,\n  message: '',\n  standings: null,\n};\nlet felt = { x: 0, y: 0, sprint: false };   // the local stick as last read\nfunction place(players) {\n  players.forEach((p, i) => {\n    const a = (i / Math.max(players.length, 1)) * Math.PI * 2;\n    p.tx = p.x = W / 2 + Math.cos(a) * 200; p.ty = p.y = H / 2 + Math.sin(a) * 180;\n  });\n}\nfunction newStar() {\n  game.star = { x: 40 + game.rng() * (W - 80), y: 40 + game.rng() * (H - 80), n: game.star.n + 1 };\n}\n/** Your own player, from your own stick. Every copy moves its own, every frame, host or not. */\nfunction move(p, s, dt) {\n  const speed = SPEED * (s.sprint ? 1.5 : 1);\n  p.x = Math.max(R, Math.min(W - R, p.x + s.x * speed * dt));\n  p.y = Math.max(R, Math.min(H - R, p.y + s.y * speed * dt));\n}\nconst touching = (p) => Math.hypot(p.x - game.star.x, p.y - game.star.y) < R + 12;\n// ---- solo: the game as it plays on its own\nfunction solo() {\n  game.players = [{ id: 0, name: 'You', color: '#f5b700', x: W / 2, y: H / 2, score: 0 }];\n  game.phase = 'title';\n  game.message = 'Star Arena — press any key or tap to play';\n}\nlet soloEnds = 0;\n// ---- hub mode. Every other player also has tx, ty: where it last said it is\n// (and on the host, at: when). It is drawn easing toward there; your own player\n// is drawn where you put it.\nlet hub = null;\nlet lastSent = 0;\nlet lastSnap = -Infinity;    // the newest snapshot taken, by its AIHub.time()\nlet claimed = -1;            // the star this copy claimed last: one claim a star\nasync function connect() {\n  const info = await AIHub.connect({ mode: 'shared-world', seats: [2, 4] });\n  if (!info) return solo();\n  hub = info;\n  game.rng = AIHub.rng('stars');\n  game.players = info.players.map((p) => ({ ...p, x: 0, y: 0, score: 0, gone: false, at: -Infinity }));\n  place(game.players);\n  newStar();                 // the first star comes from the seed: the same on every copy\n  // The hub's card collects everyone's ready: ready up as soon as the arena is built.\n  game.phase = 'waiting';\n  game.message = 'Get ready…';\n  AIHub.ready();\n  AIHub.on('start', () => { game.phase = 'playing'; unlockAudio(); });\n  AIHub.on('message', (data, from) => {\n    if (hub.isHost && data.t === 'me') heard(from, data);\n    if (hub.isHost && data.t === 'claim') take(from, data.n);\n    if (from === hub.host && data.t === 's') applySnapshot(data);\n    if (from === hub.host && data.t === 'pick' && data.id !== hub.me) beep(330);   // your own cheered at the claim\n  });\n  AIHub.on('leave', ({ id }) => {\n    const p = game.players.find((q) => q.id === id);\n    if (p) p.gone = true;\n    if (hub.isHost && game.phase === 'playing' && game.players.filter((q) => !q.gone).length < 2) finish();\n  });\n  AIHub.on('time-up', () => { if (hub.isHost) finish(); });\n  AIHub.on('end', ({ reason, standings }) => {\n    game.phase = 'over';\n    game.standings = standings;\n    game.message = reason === 'finished' ? 'Round over' : reason === 'sat-out' ? 'You sat this one out' : 'Round cancelled';\n  });\n}\nconst inside = (v, max) => Math.max(R, Math.min(max - R, Number(v) || 0));\n/** Host: a player says where it is, and there it is, unless an older report arrived late. */\nfunction heard(id, m) {\n  const p = game.players.find((q) => q.id === id);\n  if (!p || !(m.at > p.at)) return;\n  p.at = m.at; p.tx = inside(m.x, W); p.ty = inside(m.y, H);\n}\n/** Host: player id touched star n. It scores, unless someone else got there first. */\nfunction take(id, n) {\n  const p = game.players.find((q) => q.id === id);\n  if (game.phase !== 'playing' || !p || p.gone || n !== game.star.n) return;\n  p.score++;\n  newStar();\n  beep(id === hub.me ? 660 : 330);\n  AIHub.send({ t: 'pick', id, n });\n  if (p.score >= TARGET) finish();\n}\n/** Host: one snapshot for everyone: every player still here with its score, and the star. */\nfunction snapshot() {\n  const spot = (p) => (p.id === hub.me ? [p.x, p.y] : [p.tx, p.ty]);   // the others: where they said\n  return {\n    t: 's',\n    at: Math.round(AIHub.time()),\n    p: game.players.filter((p) => !p.gone).map((p) => [p.id, ...spot(p).map(Math.round), p.score]),\n    s: [Math.round(game.star.x), Math.round(game.star.y), game.star.n],\n  };\n}\n/** Not the host: take the scores, the star and the other players from the snapshot, never your own player. */\nfunction applySnapshot(s) {\n  if (s.at < lastSnap) return;   // unreliable: an older one that arrived late\n  lastSnap = s.at;\n  for (const [id, x, y, score] of s.p) {\n    const p = game.players.find((q) => q.id === id);\n    if (!p) continue;\n    p.score = score;\n    if (id !== hub.me) { p.tx = x; p.ty = y; }\n  }\n  game.star = { x: s.s[0], y: s.s[1], n: s.s[2] };\n  if (s.over) { game.phase = 'over'; game.message = 'Round over'; }\n}\n/** Host: standings by score, ties together, best first. A last snapshot, reliable, ends every copy on the same scores. */\nfunction finish() {\n  if (game.phase === 'over') return;\n  AIHub.send({ ...snapshot(), over: 1 });\n  const live = game.players.filter((p) => !p.gone).sort((a, b) => b.score - a.score);\n  const standings = [];\n  for (const p of live) {\n    const last = standings[standings.length - 1];\n    if (last && last.score === p.score) last.ids.push(p.id);\n    else standings.push({ score: p.score, ids: [p.id] });\n  }\n  const scores = Object.fromEntries(game.players.map((p) => [p.id, p.score]));\n  AIHub.finish({ standings: standings.map((g) => g.ids), scores });\n  game.phase = 'over';\n  game.message = 'Round over';\n}\nfunction unlockAudio() {\n  if (!audio) {\n    try { audio = new AudioContext(); } catch { audio = null; }\n  }\n  audio?.resume?.().catch(() => {});\n}\nfunction gesture() {\n  unlockAudio();\n  if (!hub && (game.phase === 'title' || game.phase === 'over')) {\n    solo();\n    game.phase = 'playing';\n    soloEnds = performance.now() + 60_000;\n  }\n}\n// ---- the loop: advance by elapsed time, never pause\nlet last = performance.now();\nfunction frame(now) {\n  const dt = Math.min((now - last) / 1000, 0.25);\n  last = now;\n  readPad();\n  const me = game.players.find((p) => p.id === (hub ? hub.me : 0));\n  felt = stick(me);\n  if (game.phase === 'playing' && (!hub || AIHub.time() >= 0)) {\n    if (me) move(me, felt, dt);   // now, on every copy: your controls never wait for the network\n    if (hub) play(now, dt, me);\n    else {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WkyGyQC8X4WHaWqGUbSKKY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
