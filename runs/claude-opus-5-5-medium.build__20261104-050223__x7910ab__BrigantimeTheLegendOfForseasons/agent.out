his.lanes = o.lanes || ['left', 'down', 'up', 'right']; this.windows = Object.assign({ perfect: 40, great: 80, good: 120 }, o.windows); this.lead = o.lead || 1.6; this.voice = Object.assign({ wave: 'square', vol: .2, dur: .09 }, o.voice); this.on = o.on || {};\n13015:      if (n.call) { if (!n.played && (n.step - s) * spb < .1) { n.played = true; A.sfx(Object.assign({ freq: CALL[n.lane % CALL.length] }, this.voice), { step: n.step }); } if (!n.j && s >= n.step) { n.j = 'call'; this._flash[n.lane] = this.game.time; } continue; }\n7555:      this._master = c.createGain(); this._master.connect(c.destination);\n7556:      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n7557:      this._musBus = c.createGain(); this._musBus.connect(this._master);\n7589:    const g = c.createGain(); g.gain.setValueAtTime(0, t); g.gain.linearRampToValueAtTime(vol, t + att);\n7604:      if (p.vib) { const lfo = c.createOscillator(), lg = c.createGain(); lfo.frequency.value = p.vib[0]; lg.gain.value = f0 * p.vib[1]; lfo.connect(lg); lg.connect(src.frequency); lfo.start(t); lfo.stop(end + .05); }\n7739:    const c = this.ctx, bus = c.createGain(); bus.connect(this._musBus); C.bus = bus;\n7741:    for (const t of C.tracks) { t.gain = c.createGain(); t.gain.gain.value = C.vols[t.i]; t.gain.connect(bus); }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HQGFvrGQfnv35wBizimSgo","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
