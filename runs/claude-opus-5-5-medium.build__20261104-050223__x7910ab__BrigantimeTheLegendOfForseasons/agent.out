 'ai') this.startHuman();\"\nassert old in s; s=s.replace(old,new); open(p,'w').write(s)\np='src/61-battle-view.js'; s=open(p).read()\ns=s.replace(\"      if (su.eff.stop) r.queue(p.x, p.y, p.vis.height + 4, g => {}, {});\\n\",\"\")\nopen(p,'w').write(s)\nEOF\necho ok","description":"Fix post-move flow and remove dead line"}}}
