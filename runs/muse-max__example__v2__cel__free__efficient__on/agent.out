{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb3f","stream":{"kind":"session","id":"01a17fba-2f1e-7182-82b3-77aaff0059d2"},"sequence":1018,"recorded_at":1780531400002031,"record_type":"event","durability":"durable","causation_id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","event":{"chunk":"Read text file `Wahoo-Wheels-64-Mario-Kart-64-muse-wonder-1.0-max-20261027-1637.html`.\n(719 line(s) above)\n720|function refreshFocus(){ const active=$('.screen.active'); if(!active) return; const items=focusablesIn(active); items.forEach(el=>el.classList.remove('focused'));\n721|  if(items.length){ focusIdx=clamp(focusIdx,0,items.length-1); items[focusIdx].classList.add('focused'); items[focusIdx].focus?.({preventScroll:true}); } }\n722|function moveFocus(dir){ const active=$('.screen.active'); if(!active) return; const items=focusablesIn(active); if(!items.length) return;\n723|  focusIdx=(focusIdx+dir+items.length)%items.length; refreshFocus(); audio.beep('select'); }\n724|function activateFocused(){ const active=$('.screen.active'); if(!active) return; const items=focusablesIn(active); const el=items[focusIdx]; if(el) { el.click(); audio.beep('select'); } }\n725|function handleMenuKey(code){\n726|  if(gameState==='racing'||gameState==='countdown'||gameState==='battle'){ if(code==='Escape') togglePause(); return; }\n727|  if(!$('.screen.active')) return;\n728|  if(code==='ArrowDown'||code==='KeyS') moveFocus(1);\n729|  if(code==='ArrowUp'||code==='KeyW') moveFocus(-1);\n730|  if(code==='Enter'||code==='Space') activateFocused();\n731|  if(code==='Escape') onBack();\n732|}\n733|function onBack(){\n734|  if($('#screen-setup').classList.contains('active')||$('#screen-settings').classList.contains('active')||$('#screen-about').classList.contains('active')){ goTitle(); }\n735|  else if($('#screen-pause').classList.contains('active')){ resumeRace(); }\n736|  else if($('#screen-results').classList.contains('active')){ goTitle(); }\n737|}\n738|function goTitle(){ gameState='title'; cleanupAttractRaceIfNeeded(); showScreen('screen-title'); $('#hud').classList.remove('active'); $('#minimap').style.display='none'; updateSplitLinesOff(); anyInputAt=performance.now(); hideCenter(); }\n739|function openSetup(mode){ selectedMode=mode; gameState='setup';\n740|  $('#setup-title').textContent = mode==='grandprix'?'🏁 Grand Prix':mode==='timetrial'?'⏱️ Time Trial':mode==='battle'?'💥 Battle — Balloon Bop':'👥 VS Race';\n741|  $('#setup-sub').textContent = mode==='timetrial'?'Chase the ghost of your best lap. No rivals, just you and the clock. Wahoo!':mode==='battle'?'Same tracks, new grudge: pop balloons, keep yours. Last kart rolling wins.':'Pick your racer, engine class and track. Wahoo!';\n742|  $('#players-label').style.display = (mode==='timetrial')?'none':''; $('#players-row').style.display=(mode==='timetrial')?'none':'';\n743|  if(mode==='timetrial') numPlayers=1; if(mode==='versus') numPlayers=Math.max(2,numPlayers);\n744|  showScreen('screen-setup'); buildSetupGrids();\n745|}\n746|function buildSetupGrids(){\n747|  const cg=$('#char-grid'); cg.innerHTML=RACERS.map((r,i)=>`<div class=\"card ${i===selectedChar?'focused':''}\" data-char=\"${i}\" tabindex=\"0\"><div class=\"swatch\" style=\"background:#${r.color.toString(16).padStart(6,'0')}\"></div>${r.name}<p>${r.blurb}</p><p>SPD ${(r.speed*100)|0} · ACC ${(r.accel*100)|0} · WGT ${(r.weight*100)|0}</p></div>`).join('');\n748|  cg.querySelectorAll('.card').forEach(c=> c.addEventListener('click', ()=>{ selectedChar=+c.dataset.char; buildSetupGrids(); audio.beep('select'); }));\n749|  $$('#class-row .btn').forEach(b=>{ b.classList.toggle('focused', b.dataset.class===selectedClass); b.onclick=()=>{ selectedClass=b.dataset.class; buildSetupGrids(); }; });\n750|  const tg=$('#track-grid'); tg.innerHTML=TRACKS.map((t,i)=>`<div class=\"card ${i===selectedTrack?'focused':''}\" data-track=\"${i}\" tabindex=\"0\"><div class=\"swatch\" style=\"background:#${t.sky.toString(16).padStart(6,'0')}\"></div>${t.name}<p>${t.desc}</p></div>`).join('');\n751|  tg.querySelectorAll('.card').forEach(c=> c.addEventListener('click', ()=>{ selectedTrack=+c.dataset.track; buildSetupGrids(); }));\n752|  $$('#players-row .btn').forEach(b=>{ b.classList.toggle('focused', +b.dataset.players===numPlayers); b.onclick=()=>{ numPlayers=+b.dataset.players; buildSetupGrids(); }; });\n753|}\n754|function togglePause(){ if(!race) return; if(gameState==='paused'){ resumeRace(); } else if(gameState==='racing'||gameState==='countdown'||gameState==='battle'){ gameState='paused'; showScreen('screen-pause'); } }\n755|function resumeRace(){ if(!race) return; gameState= race.state==='battle'?'battle':(race.state==='countdown'?'countdown':'racing'); showScreen(null); }\n756|function quitToTitle(){ cleanupRace(); goTitle(); }\n757|\n758|/* ============================== attract mode (10s idle on title) ============================== */\n759|let attractTimerCheck=0;\n760|function startAttract(){\n761|  if(attractActive||gameState!=='title') return; attractActive=true; $('#attract-badge').style.display='block';\n762|  // reuse race engine with all-AI field on Wahoo Circuit\n763|  const keepTrack=selectedTrack, keepPlayers=numPlayers, keepMode=selectedMode;\n764|  selectedTrack=0; numPlayers=1; selectedMode='grandprix';\n765|  startRace(); // creates humans too — convert P1 to AI by flagging demo control\n766|  race.state='racing'; race.racers.forEach(r=>{ r._demo=true; }); gameState='attract';\n767|  race._attractRestore={keepTrack,keepPlayers,keepMode};\n768|  centerMsg('WAHOO WHEELS 64','Attract mode — press any button to play!');\n769|}\n770|function exitAttract(){ if(!attractActive) return; attractActive=false; $('#attract-badge').style.display='none';\n771|  const rest=race?._attractRestore; cleanupRace(); selectedTrack=rest?.keepTrack??selectedTrack; numPlayers=rest?.keepPla