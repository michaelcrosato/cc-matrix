{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c99f","stream":{"kind":"session","id":"01a17fba-2f1e-7182-82b3-77aaff0059d2"},"sequence":810,"recorded_at":1780531400001615,"record_type":"event","durability":"durable","causation_id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","event":{"chunk":"edited\nchanged lines: lines 616-617\n--- original\n+++ updated\n@@\n-  if(propGroup) propGroup.children.forEach(c=>{ if(c.name==='cloud'){ c.position.x+=dt*.55; if(c.position.x>130) c.position.x=-130; } });\n-}\n+  if(propGroup) propGroup.children.forEach(c=>{ if(c.name==='cloud'){ c.position.x+=dt*.55; if(c.position.x>130) c.position.x=-130; } });\n+}\n+\n+/* ============================== HUD / cameras / minimap ============================== */\n+function toast(msg){ const el=$('#toast'); el.textContent=msg; el.style.display='block'; clearTimeout(toast._t); toast._t=setTimeout(()=> el.style.display='none', 2600); }\n+function centerMsg(big, sub=''){ const w=$('#center-msg'); $('#center-big').textContent=big; $('#center-sub').textContent=sub; w.style.display='block'; clearTimeout(centerMsg._t); centerMsg._t=setTimeout(()=> w.style.display='none', 1600); }\n+function hideCenter(){ $('#center-msg').style.display='none'; }\n+function suffix(n){ return n===1?'st':n===2?'nd':n===3?'rd':'th'; }\n+function buildHUD(){\n+  const hud=$('#hud'); hud.innerHTML='';\n+  const humans=race.racers.filter(r=>r.isHuman);\n+  humans.forEach((r,i)=>{\n+    const d=document.createElement('div'); d.className='viewport-hud'; d.id=`vhud-${i}`;\n+    d.innerHTML=`<div class=\"pos-badge\"><span class=\"pos-num\">8</span><sup class=\"pos-suf\">th</sup></div>\n+    <div><span class=\"pill lap-pill\">LAP 1/${race.totalLaps}</span><span class=\"pill time-pill\">0:00.000</span><span class=\"pill speed-pill\">0 km/h</span></div>\n+    <div style=\"margin-top:6px\"><span class=\"item-box\"><span class=\"item-icon\">—</span><span class=\"item-name\">No item</span></span><span class=\"pill drift-pill\" style=\"display:none\">DRIFT</span></div>\n+    <div class=\"pill wrong-pill\" style=\"display:none;background:#e63946\">⚠ WRONG WAY!</div>\n+    <div class=\"pill off-pill\" style=\"display:none\">Off-track — grip gone!</div>\n+    <div style=\"font-weight:900;margin-top:4px\">${r.def.name} · P${i+1}</div>`;\n+    hud.appendChild(d);\n+  });\n+  layoutHUD();\n+}\n+function layoutHUD(){\n+  const humans=race?race.racers.filter(r=>r.isHuman):[]; const n=humans.length||numPlayers;\n+  humans.forEach((r,i)=>{ const el=document.getElementById(`vhud-${i}`); if(!el) return;\n+    if(n===1){ el.style.left='14px'; el.style.top='12px'; el.style.right='auto'; el.style.bottom='auto'; }\n+    else if(n===2){ el.style.left='14px'; el.style.right='auto'; el.style.top= i===0?'12px':'52%'; el.style.bottom='auto'; }\n+    else { el.style.top= (i<2?'12px':'52%'); el.style.left= (i%2===0?'14px':'52%'); el.style.right='auto'; el.style.bottom='auto'; }\n+  });\n+}\n+function updateSplitLines(){\n+  $('#split-h').style.display = numPlayers>=2?'block':'none';\n+  $('#split-v').style.display = numPlayers>=3?'block':'none';\n+}\n+function updateHUD(){\n+  if(!race) return;\n+  const humans=race.racers.filter(r=>r.isHuman);\n+  const sorted=[...race.racers].sort((a,b)=>b.progress-a.progress);\n+  humans.forEach((r,i)=>{ const el=document.getElementById(`vhud-${i}`); if(!el) return;\n+    const pos=sorted.indexOf(r)+1;\n+    el.querySelector('.pos-num').textContent=pos; el.querySelector('.pos-suf').textContent=suffix(pos);\n+    el.querySelector('.lap-pill').textContent = race.state==='battle' ? `🎈×${r.balloons}` : `LAP ${Math.min(r.lap,race.totalLaps)}/${race.totalLaps}`;\n+    el.querySelector('.time-pill').textContent=fmtTime(r.raceTime*1000);\n+    el.querySelector('.speed-pill').textContent=`${Math.round(Math.abs(r.speed)*3.6)} km/h`;\n+    const def=r.item?ITEM_DEFS[r.item]:null;\n+    el.querySelector('.item-icon').textContent=def?def.icon:'—'; el.querySelector('.item-name').textContent=def?`${def.name}${r.itemUses>1?' ×'+r.itemUses:''}`:'No item — hit a ? box';\n+    el.querySelector('.drift-pill').style.display=r.drifting?'inline-block':'none';\n+    if(r.drifting) el.querySelector('.drift-pill').textContent = r.driftCharge>1.55?'DRIFT · PURPLE!':r.driftCharge>.85?'DRIFT · ORANGE!':r.driftCharge>.35?'DRIFT · BLUE':'DRIFT…';\n+    el.querySelector('.wrong-pill').style.display=r.wrongWay?'inline-block':'none';\n+    el.querySelector('.off-pill').style.display=r.offTrack?'inline-block':'none';\n+  });\n+  drawMinimap();\n+}\n+function drawMinimap(){\n+  const cv=$('#minimap'); if(!race||cv.style.display==='none') return; const ctx=cv.getContext('2d'); const W=cv.width,H=cv.height;\n+  ctx.clearRect(0,0,W,H); ctx.strokeStyle='#fff'; ctx.lineWidth=5; ctx.beginPath();\n+  for(let i=0;i<=80;i++){ const p=race.curve.getPointAt(i/80); const x=W/2+p.x*1.05, y=H/2+p.z*1.05; i===0?ctx.moveTo(x,y):ctx.lineTo(x,y); } ctx.stroke();\n+  race.racers.forEach(r=>{ const x=W/2+r.mesh.position.x*1.05, y=H/2+r.mesh.position.z*1.05; ctx.fillStyle=r.isHuman?'#ffd23f':'#fff'; ctx.strokeStyle='#17233b'; ctx.lineWidth=2;\n+    ctx.beginPath(); ctx.arc(x,y,r.isHuman?6:4,0,7); ctx.fill(); ctx.stroke(); });\n+}\n+function updateCameraFor(r, cam, dt){\n+  const fwd=new THREE.Vector3(Math.sin(r.heading),0,Math.cos(r.heading));\n+  const mode=settings.cam; const dist= mode==='hood'? .5 : mode==='near'? 7.5 : 10.5; const height= mode==='hood'? 2.1 : mode==='near'? 3.4 : 4.4;\n+  const inp = r.isHuman? readPlayerInput(r.humanIdx) : {lookBack:false};\n+  const lookBack = inp.lookBack;\n+  const dir = lookBack? fwd.clone() : fwd.clone().negate();\n+  const desired=r.mesh.position.clone().addScaledVector(dir, dist); desired.y+=height;\n+  if(settings.reduced){ cam.position.copy(desired); } else { r.camPos.lerp(desired, 1-Math.pow(.0015, dt)); cam.position.copy(r.camPos); }\n+  if(settings.shake && r.shake>0 && !settings.reduced){ cam.position.x+=rand(-1,1)*r.shake*.25; cam.position.y+=rand(-1,1)*r.shake*.18; }\n+  const look=r.mesh.position.clone().addScaledVector(lookBack? dir.clone().negate(): fwd, 8); look.y+=1.4;\n+  r.camLook.lerp(look, 1-Math.pow(.0005, dt)); if(settings.reduced) r.camLook.copy(look);\n+  cam.lookAt(r.camLook);\n+}\n+function onHumanFinished(r){\n+  centerMsg('🏁 FINISH!', `${r.def.name} — ${fmtTime(r.raceTime*1000)} · Best ${fmtTime(r.bestLap)}`);\n+  audio.beep('lap');\n+  // persist best for time trial / any mode on this track\n+  try{ const key='wahoo-best'; const all=JSON.parse(localStorage.getItem(key)||'{}'); const k=`${race.trackDef.id}-${selectedClass}`;\n+    if(!all[k]||r.bestLap<all[k]){ all[k]=r.bestLap; localStorage.setItem(key, JSON.stringify(all)); } }catch{}\n+}\n+function checkRaceEnd(){\n+  if(!race) return;\n+  const humans=race.racers.filter(r=>r.isHuman);\n+  const allHumansDone=humans.every(r=>r.finished||r.balloons<=0);\n+  const battleDone = race.state==='battle' && race.racers.filter(r=>r.balloons>0).length<=1;\n+  if(battleDone || (race.state!=='battle' && allHumansDone)) setTimeout(showResults, 900);\n+}\n+function showResults(){\n+  if(!race) return; gameState='finished'; showScreen('screen-results'); $('#hud').classList.remove('active'); $('#minimap').style.display='none'; updateSplitLinesOff();\n+  const sorted=[...race.racers].sort((a,b)=>{ if(race.state==='battle') return b.balloons-a.balloons; if(a.finished&&b.finished) return a.finishTime-b.finishTime; if(a.finished) return -1; if(b.finished) return 1; return b.progress-a.progress; });\n+  $('#results-title').textContent = selectedMode==='grandprix' ? '🏆 Grand Prix — Results' : selectedMode==='battle' ? '💥 Battle — Results' : '🏁 Results';\n+  $('#results-flavour').textContent = pick(['What a race! Someone definitely shouted “wahoo”.','Photo finish energy. The crowd (three clouds) went wild.','Bananas were harmed in the making of this result.','The trophy is shiny. The excuses are shinier.']);\n+  $('#results-body').innerHTML=sorted.map((r,i)=>`<tr><td>${i+1}${suffix(i+1)}</td><td>${r.isHuman?'👤 ':''}${r.def.name}${race.state==='battle'?` · 🎈×${r.balloons}`:''}</td><td>${r.finished?fmtTime(r.finishTime*1000):'DNF · '+fmtTime(r.raceTime*1000)}</td><td>${fmtTime(r.bestLap)}</td></tr>`).join('');\n+  let bestLine=''; try{ const all=JSON.parse(localStorage.getItem('wahoo-best')||'{}'); const k=`${race.trackDef.id}-${selectedClass}`; if(all[k]) bestLine=`Best lap on ${race.trackDef.name} (${selectedClass}cc): ${fmtTime(all[k])}`; }catch{}\n+  $('#results-best').textContent=bestLine;\n+  anyInputAt=performance.now();\n+}\n+function updateSplitLinesOff(){ $('#split-h').style.display='none'; $('#split-v').style.display='none'; }\n","final_result":true,"kind":"output","task_id":"01a17fbd-5eba-73e2-8547-ec6f359a2dc9"},"kind":"task_lifecycle","run_stream":{"id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","kind":"run"},"task_id":"01a17fbd-5eba-73e2-8547-ec6f359a2dc9","task_stream":{"id":"01a17fbd-5eba-73e2-8547-ec6f359a2dc9","kind":"task"}}}
