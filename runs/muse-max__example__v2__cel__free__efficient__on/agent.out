{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9fd","stream":{"kind":"session","id":"01a17fba-2f1e-7182-82b3-77aaff0059d2"},"sequence":857,"recorded_at":1780531400001709,"record_type":"event","durability":"durable","causation_id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","event":{"chunk":"edited\nchanged lines: line 714\n--- original\n+++ updated\n@@\n-function updateSplitLinesOff(){ $('#split-h').style.display='none'; $('#split-v').style.display='none'; }\n+function updateSplitLinesOff(){ $('#split-h').style.display='none'; $('#split-v').style.display='none'; }\n+\n+/* ============================== screens & menu (10-foot, controller-first) ============================== */\n+function showScreen(id){ $$('.screen').forEach(s=> s.classList.toggle('active', s.id===id)); if(!id) $$('.screen').forEach(s=>s.classList.remove('active')); refreshFocus(); }\n+function focusablesIn(scope){ return [...scope.querySelectorAll('button, .card, select, input')].filter(el=> el.offsetParent!==null||el.classList.contains('card')); }\n+let focusIdx=0;\n+function refreshFocus(){ const active=$('.screen.active'); if(!active) return; const items=focusablesIn(active); items.forEach(el=>el.classList.remove('focused'));\n+  if(items.length){ focusIdx=clamp(focusIdx,0,items.length-1); items[focusIdx].classList.add('focused'); items[focusIdx].focus?.({preventScroll:true}); } }\n+function moveFocus(dir){ const active=$('.screen.active'); if(!active) return; const items=focusablesIn(active); if(!items.length) return;\n+  focusIdx=(focusIdx+dir+items.length)%items.length; refreshFocus(); audio.beep('select'); }\n+function activateFocused(){ const active=$('.screen.active'); if(!active) return; const items=focusablesIn(active); const el=items[focusIdx]; if(el) { el.click(); audio.beep('select'); } }\n+function handleMenuKey(code){\n+  if(gameState==='racing'||gameState==='countdown'||gameState==='battle'){ if(code==='Escape') togglePause(); return; }\n+  if(!$('.screen.active')) return;\n+  if(code==='ArrowDown'||code==='KeyS') moveFocus(1);\n+  if(code==='ArrowUp'||code==='KeyW') moveFocus(-1);\n+  if(code==='Enter'||code==='Space') activateFocused();\n+  if(code==='Escape') onBack();\n+}\n+function onBack(){\n+  if($('#screen-setup').classList.contains('active')||$('#screen-settings').classList.contains('active')||$('#screen-about').classList.contains('active')){ goTitle(); }\n+  else if($('#screen-pause').classList.contains('active')){ resumeRace(); }\n+  else if($('#screen-results').classList.contains('active')){ goTitle(); }\n+}\n+function goTitle(){ gameState='title'; cleanupAttractRaceIfNeeded(); showScreen('screen-title'); $('#hud').classList.remove('active'); $('#minimap').style.display='none'; updateSplitLinesOff(); anyInputAt=performance.now(); hideCenter(); }\n+function openSetup(mode){ selectedMode=mode; gameState='setup';\n+  $('#setup-title').textContent = mode==='grandprix'?'🏁 Grand Prix':mode==='timetrial'?'⏱️ Time Trial':mode==='battle'?'💥 Battle — Balloon Bop':'👥 VS Race';\n+  $('#setup-sub').textContent = mode==='timetrial'?'Chase the ghost of your best lap. No rivals, just you and the clock. Wahoo!':mode==='battle'?'Same tracks, new grudge: pop balloons, keep yours. Last kart rolling wins.':'Pick your racer, engine class and track. Wahoo!';\n+  $('#players-label').style.display = (mode==='timetrial')?'none':''; $('#players-row').style.display=(mode==='timetrial')?'none':'';\n+  if(mode==='timetrial') numPlayers=1; if(mode==='versus') numPlayers=Math.max(2,numPlayers);\n+  showScreen('screen-setup'); buildSetupGrids();\n+}\n+function buildSetupGrids(){\n+  const cg=$('#char-grid'); cg.innerHTML=RACERS.map((r,i)=>`<div class=\"card ${i===selectedChar?'focused':''}\" data-char=\"${i}\" tabindex=\"0\"><div class=\"swatch\" style=\"background:#${r.color.toString(16).padStart(6,'0')}\"></div>${r.name}<p>${r.blurb}</p><p>SPD ${(r.speed*100)|0} · ACC ${(r.accel*100)|0} · WGT ${(r.weight*100)|0}</p></div>`).join('');\n+  cg.querySelectorAll('.card').forEach(c=> c.addEventListener('click', ()=>{ selectedChar=+c.dataset.char; buildSetupGrids(); audio.beep('select'); }));\n+  $$('#class-row .btn').forEach(b=>{ b.classList.toggle('focused', b.dataset.class===selectedClass); b.onclick=()=>{ selectedClass=b.dataset.class; buildSetupGrids(); }; });\n+  const tg=$('#track-grid'); tg.innerHTML=TRACKS.map((t,i)=>`<div class=\"card ${i===selectedTrack?'focused':''}\" data-track=\"${i}\" tabindex=\"0\"><div class=\"swatch\" style=\"background:#${t.sky.toString(16).padStart(6,'0')}\"></div>${t.name}<p>${t.desc}</p></div>`).join('');\n+  tg.querySelectorAll('.card').forEach(c=> c.addEventListener('click', ()=>{ selectedTrack=+c.dataset.track; buildSetupGrids(); }));\n+  $$('#players-row .btn').forEach(b=>{ b.classList.toggle('focused', +b.dataset.players===numPlayers); b.onclick=()=>{ numPlayers=+b.dataset.players; buildSetupGrids(); }; });\n+}\n+function togglePause(){ if(!race) return; if(gameState==='paused'){ resumeRace(); } else if(gameState==='racing'||gameState==='countdown'||gameState==='battle'){ gameState='paused'; showScreen('screen-pause'); } }\n+function resumeRace(){ if(!race) return; gameState= race.state==='battle'?'battle':(race.state==='countdown'?'countdown':'racing'); showScreen(null); }\n+function quitToTitle(){ cleanupRace(); goTitle(); }\n+\n+/* ============================== attract mode (10s idle on title) ============================== */\n+let attractTimerCheck=0;\n+function startAttract(){\n+  if(attractActive||gameState!=='title') return; attractActive=true; $('#attract-badge').style.display='block';\n+  // reuse race engine with all-AI field on Wahoo Circuit\n+  const keepTrack=selectedTrack, keepPlayers=numPlayers, keepMode=selectedMode;\n+  selectedTrack=0; numPlayers=1; selectedMode='grandprix';\n+  startRace(); // creates humans too — convert P1 to AI by flagging demo control\n+  race.state='racing'; race.racers.forEach(r=>{ r._demo=true; }); gameState='attract';\n+  race._attractRestore={keepTrack,keepPlayers,keepMode};\n+  centerMsg('WAHOO WHEELS 64','Attract mode — press any button to play!');\n+}\n+function exitAttract(){ if(!attractActive) return; attractActive=false; $('#attract-badge').style.display='none';\n+  const rest=race?._attractRestore; cleanupRace(); selectedTrack=rest?.keepTrack??selectedTrack; numPlayers=rest?.keepPlayers??1; selectedMode=rest?.keepMode??'grandprix'; goTitle(); }\n+function cleanupAttractRaceIfNeeded(){ if(attractActive){ attractActive=false; $('#attract-badge').style.display='none'; cleanupRace(); } }\n+\n+/* ============================== main loop ============================== */\n+let hudTick=0;\n+function shouldCountAsRacing(){ return race && (gameState==='racing'||gameState==='countdown'||gameState==='battle'||gameState==='attract'); }\n+function animate(){\n+  requestAnimationFrame(animate);\n+  const dt=Math.min(clock.getDelta(), .05);\n+  const now=performance.now();\n+  // attract trigger: 10s without input on title/menu screens\n+  if((gameState==='title'||gameState==='setup') && !attractActive && now-anyInputAt>10000){ startAttract(); }\n+  // gamepad menu navigation (polled edges)\n+  pollGamepadMenu();\n+  if(race && gameState!=='paused' && gameState!=='finished'){\n+    if(race.state==='countdown'){\n+      const remain=race.countdownEnds-now;\n+      const n=Math.ceil(remain/1000);\n+      if(remain<=0){ race.state='racing'; race.startedAt=now; race.racers.forEach(r=>{ r.lapStart=now; if(readPlayerInput(r.isHuman?r.humanIdx:0).throttle>.5 && r.isHuman) r.boostT=.7; }); centerMsg('GO!','Wahoo!'); audio.beep('go'); hideCenterSoon(); }\n+      else { const label=String(clamp(n,1,3)); if($('#center-big').textContent!==label){ $('#center-big').textContent=label; audio.beep('count'); } }\n+    }\n+    if(race.state==='racing'||race.state==='battle'||gameState==='attract'){\n+      race.time+=dt;\n+      race.racers.forEach(r=>{ r.raceTime+= (r.finished?0:dt); });\n+      race.racers.forEach(r=>{\n+        let inp;\n+        if(gameState==='attract'||r._demo) inp=aiInput(r,dt);\n+        else if(r.isHuman){ inp=readPlayerInput(r.humanIdx);\n+          if(inp.pause && !prevPause[r.humanIdx]) togglePause();\n+          prevPause[r.humanIdx]=inp.pause;\n+          if(inp.item && !prevItem[r.humanIdx]) useItem(r);\n+          prevItem[r.humanIdx]=!!inp.item;\n+          if(inp.hop && !prevHop[r.humanIdx]){ /* hop edge consumed in stepRacer via _hopHeld */ }\n+          prevHop[r.humanIdx]=!!inp.hop;\n+        } else inp=aiInput(r,dt);\n+        if(!r.finished) stepRacer(r, inp, dt);\n+        else { r.speed=Math.max(0,r.speed-8*dt); const vx=Math.sin(r.heading)*r.speed, vz=Math.cos(r.heading)*r.speed; const cur=r.body.linvel(); r.body.setLinvel({x:vx,y:cur.y,z:vz},true); const t=r.body.translation(); r.mesh.position.set(t.x,.1,t.z); }\n+      });\n+      stepProjectiles(dt);\n+      world.timestep=Math.min(dt,1/30); world.step();\n+      // battle win check\n+      if(race.state==='battle'){ const alive=race.racers.filter(r=>r.balloons>0); if(alive.length<=1) checkRaceEnd(); }\n+      // engine audio from P1\n+      const p1=race.racers.find(r=>r.isHuman); if(p1) audio.setEngine(clamp(Math.abs(p1.speed)/32,0,1), true);\n+    }\n+    // cameras + render viewports (splitscreen)\n+    const humans=race.racers.filter(r=>r.isHuman);\n+    const focusRacers = gameState==='attract' ? [race.racers[0]] : humans;\n+    renderer.setScissorTest(focusRacers.length>1);\n+    focusRacers.forEach((r,i)=>{\n+      const cam=cameras[i]; const n=focusRacers.length;\n+      let x=0,y=0,w=innerWidth,h=innerHeight;\n+      if(n===2){ w=innerWidth; h=innerHeight/2; y= i===0? innerHeight/2:0; }\n+      else if(n>=3){ w=innerWidth/2; h=innerHeight/2; x=(i%2)*w; y= i<2? innerHeight/2:0; }\n+      cam.aspect=w/h; cam.updateProjectionMatrix();\n+      if(gameState==='attract'){ // orbiting showcase camera\n+        const t=now*.00025; cam.position.set(Math.sin(t)*34, 16+Math.sin(now*.0004)*3, Math.cos(t)*34); cam.lookAt(race.racers[0].mesh.position);\n+      } else updateCameraFor(r, cam, dt);\n+      renderer.setViewport(x,y,w,h); renderer.setScissor(x,y,w,h);\n+      renderer.render(scene, cam);\n+    });\n+    if(focusRacers.length<=1){ renderer.setScissorTest(false); renderer.setViewport(0,0,innerWidth,innerHeight); }\n+    hudTick+=dt; if(hudTick>.08){ hudTick=0; updateHUD(); }\n+  } else if(scene && renderer && cameras[0]){\n+    // title background: slow orbit over current track (built at boot)\n+    const t=now*.00018; cameras[0].position.set(Math.sin(t)*36, 15, Math.cos(t)*36); cameras[0].lookAt(0,0,0); cameras[0].aspect=innerWidth/innerHeight; cameras[0].updateProjectionMatrix();\n+    if(propGroup) propGroup.children.forEach(c=>{ if(c.name==='cloud') c.position.x+=dt*.4; });\n+    if(world){ world.timestep=Math.min(dt,1/30); world.step(); }\n+    renderer.setViewport(0,0,innerWidth,innerHeight); renderer.setScissorTest(false); renderer.render(scene, cameras[0]);\n+    audio.setEngine(0,false);\n+  }\n+}\n+function hideCenterSoon(){ setTimeout(hideCenter, 700); }\n+let padNavCooldown=0, padPrevButtons=[];\n+function pollGamepadMenu(){\n+  const now=performance.now(); if(now<padNavCooldown) return;\n+  const pads=pollPads(); const pad=pads[0]; if(!pad) return;\n+  const down=padBtn(pad,13), up=padBtn(pad,12), confirm=padBtn(pad,0), back=padBtn(pad,1), start=padBtn(pad,9);\n+  const was=padPrevButtons; padPrevButtons=[down,up,confirm,back,start];\n+  if($('.screen.active')){\n+    if(down&&!was[0]){ moveFocus(1); padNavCooldown=now+180; anyInputAt=now; if(attractActive) exitAttract(); }\n+    if(up&&!was[1]){ moveFocus(-1); padNavCooldown=now+180; anyInputAt=now; if(attractActive) exitAttract(); }\n+    if(confirm&&!was[2]){ activateFocused(); padNavCooldown=now+220; anyInputAt=now; audio.init(); }\n+    if(back&&!was[3]){ onBack(); padNavCooldown=now+220; anyInputAt=now; }\n+  } else if(start && !was[4] && (gameState==='racing'||gameState==='countdown'||gameState==='battle')){ togglePause(); padNavCooldown=now+260; }\n+  if(pad.buttons.some(b=>b.pressed)){ anyInputAt=now; if(attractActive) exitAttract(); }\n+}\n","final_result":true,"kind":"output","task_id":"01a17fbd-98de-7471-b78f-f58265a82416"},"kind":"task_lifecycle","run_stream":{"id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","kind":"run"},"task_id":"01a17fbd-98de-7471-b78f-f58265a82416","task_stream":{"id":"01a17fbd-98de-7471-b78f-f58265a82416","kind":"task"}}}
