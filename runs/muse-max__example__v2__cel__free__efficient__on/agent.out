{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c887","stream":{"kind":"session","id":"01a17fba-2f1e-7182-82b3-77aaff0059d2"},"sequence":670,"recorded_at":1780531400001335,"record_type":"event","durability":"durable","causation_id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"command_id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","event":{"chunk":"edited\nchanged lines: lines 457-458\n--- original\n+++ updated\n@@\n-    raceTime:0, balloons:3, camPos:new THREE.Vector3(px,4,pz-8), camLook:new THREE.Vector3(), shake:0, aiOffset:rand(-3,3), aiSkill:rand(.9,1.05), itemCooldown:0 };\n-}\n+    raceTime:0, balloons:3, camPos:new THREE.Vector3(px,4,pz-8), camLook:new THREE.Vector3(), shake:0, aiOffset:rand(-3,3), aiSkill:rand(.9,1.05), itemCooldown:0 };\n+}\n+\n+function cleanupRace(){\n+  if(!race) return;\n+  race.racers.forEach(r=>{ scene.remove(r.mesh); world.removeRigidBody(r.body); });\n+  race.hazards.forEach(h=> scene.remove(h.mesh));\n+  race.projectiles.forEach(p=> scene.remove(p.mesh));\n+  race=null;\n+}\n+function startRace(){\n+  cleanupRace();\n+  const trackDef=TRACKS[selectedTrack];\n+  const built=buildTrack(trackDef);\n+  const curve=built.curve;\n+  const sp=curve.getPointAt(0), tan=curve.getTangentAt(0), side=new THREE.Vector3(-tan.z,0,tan.x).normalize();\n+  const racers=[];\n+  const used=new Set([selectedChar]);\n+  // humans first (P1 uses selectedChar; extra humans take next free characters)\n+  for(let i=0;i<numPlayers;i++){ let ci = i===0? selectedChar : 0; while(used.has(ci)) ci=(ci+1)%RACERS.length; if(i>0) used.add(ci);\n+    racers.push(makeRacer(RACERS[ci], true, i, sp, tan, side, (i%2===0?-2.6:2.6))); }\n+  // AI fill to 8 (or to 4 in battle arena shorthand — still 8 for chaos, battle uses balloons)\n+  let aiIdx=0;\n+  while(racers.length<8){ while(used.has(aiIdx)) aiIdx=(aiIdx+1)%RACERS.length; used.add(aiIdx);\n+    const lane=(racers.length%2===0?-3.4:3.4); const r=makeRacer(RACERS[aiIdx], false, racers.length, sp, tan, side, lane); racers.push(r); aiIdx++; }\n+  // stagger AI rows behind\n+  racers.forEach((r,i)=>{ const back=Math.floor(i/2)*4.2; const t=r.body.translation(); r.body.setTranslation({x:t.x - tan.x*back, y:t.y, z:t.z - tan.z*back}, true); r.mesh.position.set(t.x - tan.x*back,.1,t.z - tan.z*back); });\n+  race={ trackDef, built, curve, racers, hazards:[], projectiles:[], startedAt:performance.now(), countdownEnds:performance.now()+3400,\n+    state: selectedMode==='battle' ? 'battle' : 'countdown', totalLaps: selectedMode==='timetrial'?3:3, classMult: CLASS_SPEED[selectedClass]||1,\n+    gpRaceIndex: race?.gpRaceIndex||0, finishedCount:0, time:0 };\n+  if(selectedMode==='battle'){ racers.forEach(r=>{ r.balloons=3; }); centerMsg('BATTLE!','Pop 3 balloons — last kart rolling wins!'); }\n+  else centerMsg('3','Get ready… hold accelerate on GO for a boost start!');\n+  gameState= selectedMode==='battle' ? 'battle' : 'countdown';\n+  buildHUD(); showScreen(null); $('#hud').classList.add('active'); $('#minimap').style.display='block';\n+  updateSplitLines();\n+  audio.beep('count');\n+}\n+function rollItem(position){\n+  const table = position<=2 ? ['banana','shell','banana','shroom','bomb','shell'] : position>=7 ? ['shroom','star','bolt','triple','shroom','shell'] : ['shroom','banana','shell','star','triple','bomb','bolt'];\n+  return pick(table);\n+}\n+function giveItem(r){ if(r.item) return; r.item=rollItem(currentPosition(r)); r.itemUses = r.item==='triple'?3:1; if(r.isHuman) audio.beep('item'); updateHUD(); }\n+function currentPosition(r){ if(!race) return 1; const sorted=[...race.racers].sort((a,b)=>b.progress-a.progress); return sorted.indexOf(r)+1; }\n+function hitRacer(r, kind){\n+  if(r.starT>0 && kind!=='bolt') return;\n+  if(kind==='bolt'){ r.shrinkT=4; r.speed*=.6; }\n+  else if(kind==='banana'||kind==='shell'||kind==='bomb'){ if(r.starT>0) return; r.spinT=1.1; r.speed*=.25; r.shake=.5; audio.beep('hit'); if(r.isHuman) vibrate(r.humanIdx,.9,.6,220); }\n+  if(race && race.state==='battle' && (kind==='shell'||kind==='banana'||kind==='bomb')){ r.balloons=Math.max(0,r.balloons-1); if(r.isHuman) toast(`${r.def.name}: balloon popped! ${r.balloons} left`); }\n+}\n+function useItem(r){\n+  if(!r.item || r.finished) return;\n+  const kind=r.item; const fwd=new THREE.Vector3(Math.sin(r.heading),0,Math.cos(r.heading));\n+  const pos=r.mesh.position.clone();\n+  if(kind==='shroom'){ r.boostT=Math.max(r.boostT,.9); audio.beep('boost'); }\n+  if(kind==='triple'){ r.boostT=Math.max(r.boostT,.8); audio.beep('boost'); }\n+  if(kind==='star'){ r.starT=5; audio.beep('boost'); }\n+  if(kind==='bolt'){ race.racers.forEach(o=>{ if(o!==r) hitRacer(o,'bolt'); }); centerMsg('⚡ MINI BOLT!','Everyone got a little… smaller.'); audio.beep('hit'); }\n+  if(kind==='banana'){ const m=new THREE.Group(); const peel=new THREE.Mesh(new THREE.ConeGeometry(.42,.8,7), toonMat(0xffd23f)); peel.position.y=.35; m.add(peel); outline(peel,1.1);\n+    m.position.copy(pos).addScaledVector(fwd,-2.2); m.position.y=.05; scene.add(m); race.hazards.push({mesh:m, kind:'banana', owner:r, pos:m.position.clone()}); }\n+  if(kind==='shell'){ const m=new THREE.Group(); const sh=new THREE.Mesh(new THREE.SphereGeometry(.42,12,10), toonMat(0x2a9d8f)); sh.scale.y=.7; sh.position.y=.35; m.add(sh); outline(sh,1.08);\n+    m.position.copy(pos).addScaledVector(fwd,2.2); m.position.y=.2; scene.add(m);\n+    // target: racer ahead\n+    const ahead=race.racers.filter(o=>o!==r).sort((a,b)=> (b.progress)-(a.progress)).find(o=>o.progress>r.progress) || race.racers.find(o=>o!==r);\n+    race.projectiles.push({mesh:m, kind:'shell', owner:r, target:ahead, speed:30, life:6}); audio.beep('boost'); }\n+  if(kind==='bomb'){ const m=new THREE.Group(); const b=new THREE.Mesh(new THREE.SphereGeometry(.5,12,10), toonMat(0x22223b)); b.position.y=.5; m.add(b); outline(b,1.07);\n+    m.position.copy(pos).addScaledVector(fwd,-2.4); m.position.y=.1; scene.add(m); race.hazards.push({mesh:m, kind:'bomb', owner:r, pos:m.position.clone(), fuse:1.6}); }\n+  r.itemUses--; if(r.itemUses<=0) r.item=null; updateHUD();\n+}\n","final_result":true,"kind":"output","task_id":"01a17fbc-cd6c-7e93-992f-6ac13a94d0c2"},"kind":"task_lifecycle","run_stream":{"id":"01a17fba-31ec-7b21-b31a-a331456b2f5f","kind":"run"},"task_id":"01a17fbc-cd6c-7e93-992f-6ac13a94d0c2","task_stream":{"id":"01a17fbc-cd6c-7e93-992f-6ac13a94d0c2","kind":"task"}}}
