{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > probe.py <<'PY'\nfrom playwright.sync_api import sync_playwright\nimport json\nfrom pathlib import Path\nbase=Path(__file__).resolve().parent\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-dev-shm-usage'])\n page=b.new_page(viewport={'width':1600,'height':900},device_scale_factor=1)\n page.on('pageerror',lambda e:print('PAGEERROR',e))\n page.on('console',lambda m:print('CONSOLE',m.type,m.text[:500]) if m.type in ['error','warning'] else None)\n page.goto('http://127.0.0.1:33141/'+base.name+'.html')\n try: page.wait_for_function('window.__game?.ready || window.__bootError',timeout=90000)\n except Exception as e: print(e)\n print('BOOT',page.evaluate('window.__bootError || window.__game?.state'))\n page.evaluate('window.__game?.external(true)')\n page.screenshot(path=str(base/'test-artifacts/title-initial.png'))\n if page.evaluate('\"'!!window.__game'\"'):\n  print('BOT',page.evaluate('''()=>{__game.start();__game.external(true);let log=[];for(let i=0;i<100;i++){let s=__game.advance(1,'bot');if(i%10===0||s.phase==='win'||s.phase==='lose')log.push({t:i,...s});if(s.phase==='win'||s.phase==='lose')break;}return log;}'''))\n  page.evaluate('__game.render()')\n  page.screenshot(path=str(base/'test-artifacts/game-initial.png'))\n b.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python probe.py > test-artifacts/probe.txt 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > probe.py <<'PY'\nfrom playwright.sync_api import sync_playwright\nimport json\nfrom pathlib import Path\nbase=Path(__file__).resolve().parent\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-dev-shm-usage'])\n page=b.new_page(viewport={'width':1600,'height':900},device_scale_factor=1)\n page.on('pageerror',lambda e:print('PAGEERROR',e))\n page.on('console',lambda m:print('CONSOLE',m.type,m.text[:500]) if m.type in ['error','warning'] else None)\n page.goto('http://127.0.0.1:33141/'+base.name+'.html')\n try: page.wait_for_function('window.__game?.ready || window.__bootError',timeout=90000)\n except Exception as e: print(e)\n print('BOOT',page.evaluate('window.__bootError || window.__game?.state'))\n page.evaluate('window.__game?.external(true)')\n page.screenshot(path=str(base/'test-artifacts/title-initial.png'))\n if page.evaluate('\"'!!window.__game'\"'):\n  print('BOT',page.evaluate('''()=>{__game.start();__game.external(true);let log=[];for(let i=0;i<100;i++){let s=__game.advance(1,'bot');if(i%10===0||s.phase==='win'||s.phase==='lose')log.push({t:i,...s});if(s.phase==='win'||s.phase==='lose')break;}return log;}'''))\n  page.evaluate('__game.render()')\n  page.screenshot(path=str(base/'test-artifacts/game-initial.png'))\n b.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python probe.py > test-artifacts/probe.txt 2>&1\"","aggregated_output":"","exit_code":0,"status":"completed"}}
