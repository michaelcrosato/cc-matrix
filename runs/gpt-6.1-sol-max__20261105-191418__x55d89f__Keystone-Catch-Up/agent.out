{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport os,signal,json\nbase=Path.cwd();root=base.parent\nmatches=[]\nfor entry in Path('/proc').iterdir():\n if not entry.name.isdigit():continue\n try:\n  args=(entry/'cmdline').read_bytes().split(b'\\\\0')\n  if args[:7]==[b'python3',b'-u',b'-m',b'http.server',b'0',b'--bind',b'127.0.0.1'] and (entry/'cwd').resolve()==root:matches.append(int(entry.name))\n except (OSError,PermissionError):pass\nfor pid in matches:os.kill(pid,signal.SIGINT)\nprint('Stopped owned development server PID(s):',matches)\nd=json.loads((root/'exit-interview.json').read_text());s=json.loads((base/'src/credits.json').read_text());assert d==s\nassert list(d)==['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub']\nassert [len(d[k]) for k in ['testingFeedback','engineFeedback','promptFeedback']]==[4,6,4]\nname=json.loads((base/'title-selection.json').read_text())['base'];html=(root/(name+'.html')).read_text()\nassert html==(base/(name+'.html')).read_text()\nassert (base/'vendor/hub-session.js').read_text() in html\nassert 'Copyright © 2010-2025 three.js authors' in html\nassert '/*GAME_CODE*/' not in html and '/*STYLES*/' not in html\nprint('Package and exit interview are consistent:',len(html.encode()),'bytes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
