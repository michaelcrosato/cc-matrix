{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016P7uphebyLRr4T8avhzX6C","type":"tool_result","content":"4052\tclass Humanoid {\n4053\t  /** new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a\n4054\t   *  character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each\n4055\t   *  step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style,\n4056\t   *  color }); hood: true (drawn in colors.hair) */\n4057\t  constructor(o = {}) {\n4058\t    if (o.build && !BUILDS[o.build]) warn('build:' + o.build, 'Humanoid build \"' + o.build + '\" is unknown (chibi, heroic, bulky, skeleton)');\n4059\t    o = Object.assign({}, BUILDS[o.build] || {}, o);\n4060\t    /** o: its options, with the build's proportions and the defaults filled in (size, build, weapon, outfit, ...;\n4061\t     *  legUpper, torso, headR and the other lengths are at size 1) */\n4062\t    this.o = Object.assign({\n4063\t      legUpper: 6, legLower: 6, hipZ: 11.6, hipHalf: 1.9, footSpread: 1.9, torso: 8, shoulderHalf: 3.3, neck: 1.2, headR: 3.4,\n4064\t      armUpper: 4.6, armLower: 4.6, limbW: 2, torsoW: 3, lean: 0, hunch: 0, stride: 6.5, lift: 3.4, swing: 4, speedRef: 70,\n4065\t      weapon: 'sword', bladeLen: 11, cape: null, hood: false, eyeGlow: null, hat: null,\n4066\t      style: 'hd', size: 1, hair: 'short', outfit: 'shirt', sleeves: 'short', armor: false, cheat: .5\n4067\t    }, o);\n4068\t    /** trail: recent points of the blade (or fist) tip, for the swing's smear */\n4069\t    this._cheat = 0; this.trail = [];\n4070\t    if (typeof this.o.hair === 'string' || !this.o.hair) this.o.hair = { style: this.o.hair || 'short' };\n4071\t    /** hairPts: the long hair's simulated points (null until it has some) */\n4072\t    this._hairPts = null;\n4073\t    if (this.o.weapon && !['sword', 'gun', 'staff'].includes(this.o.weapon)) { warn('weapon:' + this.o.weapon, 'Humanoid weapon \"' + this.o.weapon + '\" is not built in (sword, gun, staff or null); drawing a sword'); this.o.weapon = 'sword'; }\n4074\t    if (typeof this.o.hat === 'string') this.o.hat = { style: this.o.hat };\n4075\t    /** C: its colors (skin, hair, cloth, pants, boot, belt, cape, capeIn, metal, hilt, eye, ...), the defaults with\n4076\t     *  o.colors over them; change one and it shows at the next draw */\n4077\t    this.C = Object.assign({}, HUMAN_COLORS, o.colors || {});\n4078\t    const C = this.C;\n4079\t    if (this.o.skeleton) C.skin = C.pants = C.boot = C.glove = C.bone || '#e6dfc8';\n4080\t    C.clothDk = C.clothDk || shade(C.cloth, -.3); C.clothLt = C.clothLt || shade(C.cloth, .25);\n4081\t    C.pantsDk = C.pantsDk || shade(C.pants, -.3); C.bootDk = C.bootDk || shade(C.boot, -.3); C.skinDk = C.skinDk || shade(C.skin, -.2);\n4082\t    /** t: seconds of its own clock (idle breathing, blinks); phase: the walk cycle's phase, radians; mv: the last\n4083\t     *  ground direction it moved, a unit vector; hurtW: 0..1, how far into the hurt flinch */\n4084\t    this.t = Math.random() * 10; this.phase = 0; this._spW = 0; this._mv = [1, 0]; this._dashW = 0; this.hurtW = 0; this._atkW = 0;\n4085\t    /** atkZ: the height of the weapon hand during an attack; reach: how far it reaches forward; spin: the body's\n4086\t     *  extra turn during a spinning move, radians */\n4087\t    this._theta = 1.2; this.atkZ = 10; this.reach = 7; this._twist = 0; this.spin = 0; this._atkLean = 0;\n4088\t    /** sq: squash and stretch, -0.45..0.45 (kick adds to it); sqV: its speed; blink: seconds to the next blink;\n4089\t     *  facing: the angle it faces, radians; x, y, z: where its feet are (from the last update); J: its joints this\n4090\t     *  step in its own frame ({ hipL, kneeL, footL, shC, head, handR, ... }; rig.worldOffset(J.handR) gives one in\n4091\t     *  the world); smear: the swing's smear arc, or null */\n4092\t    this.sq = 0; this.sqV = 0; this.blink = 2; this.facing = 0; this.x = 0; this.y = 0; this.z = 0; this.J = {}; this._smear = null;\n4093\t    /** capeL: the cape's left edge points (null until it has a cape and has moved) */\n4094\t    this.capeL = null; this._airW = 0; this._pointW = 0; this._kicking = false;\n4095\t    this.solvePose();\n4096\t  }\n4097\t  /** a squash-and-stretch kick: + stretches (a jump), - squashes (a landing, a hit) */\n4098\t  kick(v) { this.sqV += v; }\n4099\t  /** a heavy landing: knees bend deep and spring back over a moment; strength 1 or more drops a hand to the ground\n4100\t   *  (a three-point landing), .3-.6 is a soft one. Call it on the step the body lands */\n4101\t  land(strength = 1) { this._landT = 0; this._landK = clamp(strength, 0, 1.5); this.kick(-1.5 * Math.min(1, strength)); }\n4102\t  /** how much a stride stretches: shorter while sneaking, longer while sprinting */\n4103\t  _strideK() { return 1 - .35 * (this._sneakW || 0) + .25 * (this._sprintW || 0); }\n4104\t  /** the roll (state flip: u 0..1, a forward somersault about the hips, tucked in the middle): turns every joint, and the\n4105\t   *  cape and hair for this step's drawing only (the next update puts them back before they simulate, so they never\n4106\t   *  jump or gain speed). Emberdeep's dodge roll, moved into the rig */\n4107\t  _roll(u) {\n4108\t    const J = this.J, o = this.o, a = -ease.inOut(clamp(u, 0, 1)) * TAU, c = Math.cos(a), s = Math.sin(a), cz = o.hipZ * .55, tuck = Math.sin(clamp(u, 0, 1) * Math.PI);\n4109\t    const T0 = p => { const f = p[0] * (1 - .35 * tuck), z = (p[2] - cz) * (1 - .45 * tuck); return [f * c - z * s, p[1] * (1 - .25 * tuck), f * s + z * c + cz * (1 - .55 * tuck)]; };\n4110\t    let lift = 0; for (const k in J) { const p = J[k]; if (p && k !== 'bladeDir') lift = Math.max(lift, -T0(p)[2] + (k === 'head' ? o.headR : .5)); }   // rolls over on the shoulders: nothing goes through the floor\n4111\t    const T = p => { const q = T0(p); q[2] += lift; return q; };\n4112\t    for (const k in J) { const p = J[k]; if (p && k !== 'bladeDir') J[k] = T(p); }\n4113\t    const b = J.bladeDir; if (b) J.bladeDir = [b[0] * c - b[2] * s, b[1], b[0] * s + b[2] * c];\n4114\t    const an = this.facing + this.spin + this._cheat, ca = Math.cos(an), sa = Math.sin(an), k = (1 - this.sq * .4) * o.size, kz = (1 + this.sq) * o.size, keep = this._unroll = [];\n4115\t    for (const ch of [this.capeL, this.capeR, this._hairPts]) if (ch) for (const n of ch) {\n4116\t      keep.push(n, n.x, n.y, n.z);\n4117\t      const dx = n.x - this.x, dy = n.y - this.y, q = T([(dx * ca + dy * sa) / k, (-dx * sa + dy * ca) / k, (n.z - this.z) / kz]);\n4118\t      n.x = this.x + (q[0] * ca - q[1] * sa) * k; n.y = this.y + (q[0] * sa + q[1] * ca) * k; n.z = this.z + q[2] * kz;\n4119\t    }\n4120\t  }\n4121\t  /** world position of a hand ('R' holds the weapon): spawn bullets, sparks or thrown things here */\n4122\t  hand(which = 'R') { const w = this._w(this.J['hand' + which] || this.J.handR); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\n4123\t  /** world position of the weapon tip (sword tip, gun muzzle, staff orb) */\n4124\t  tip() { const J = this.J, L = this.o.weapon === 'gun' ? 5 : this.o.weapon === 'staff' ? 10 : this.o.bladeLen, w = this._w(V3.add(J.handR, V3.mul(J.bladeDir, L))); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\n4125\t  /** where a point in the rig's own frame ([forward, right, up]; a joint such as rig.J.head, or one offset from it)\n4126\t   *  sits, in world units from the rig's feet: add rig.x, y, z for the world point, or project it to draw at a joint */\n4127\t  worldOffset(p) { return this._w(p); }\n4128\t  /** local (f, r, z) -> world offset */\n4129\t  _w(p) {\n4130\t    const a = this.facing + this.spin + this._cheat, c = Math.cos(a), s = Math.sin(a), sz = this.o.size, k = (1 - this.sq * .4) * sz;\n4131\t    return [(p[0] * c - p[1] * s) * k, (p[0] * s + p[1] * c) * k, p[2] * (1 + this.sq) * sz];\n4132\t  }\n4133\t  /**\n4134\t   * s: { x, y, z, vx, vy, facing, dash, hurt, attack, air, point }\n4135\t   *   air: true while jumping or falling (legs tuck), point: true to hold the weapon hand forward (aiming a gun)\n4136\t   *   attack: { spec, phase: 'wind' | 'active' | 'recover', u: 0..1 }. spec.kick = true swings the right foot instead of the hand\n4137\t   *   also aim (radians up), crouch, sprint, climb, hang (hangZ: the top it hangs from, above the feet), flip: 0..1 (a roll),\n4138\t   *   pose: 'cheer' | 'cast' | 'guard' | 'kneel' | 'crouch' | 'wave' | 'hips' | 'down' | 'die' | 'block',\n4139\t   *   stance: 'guard' | 'ready', down: 0..1, vz (with climb: the climbing speed), land: k (a heavy landing),\n4140\t   *   expr: 'smile' | 'shout' | 'angry' | 'wince', run: 0..1 (run in place)\n4141\t   */\n4142\t  update(dt, s = {}) {\n4143\t    const o = this.o;\n4144\t    const un = this._unroll; if (un) { this._unroll = null; for (let i = 0; i < un.length; i += 4) { un[i].x = un[i + 1]; un[i].y = un[i + 2]; un[i].z = un[i + 3]; } }   // last step's roll turned the cloth for drawing only\n4145\t    if (this.t > 0 && Math.hypot((s.x || 0) - this.x, (s.y || 0) - this.y, (s.z || 0) - this.z) > 24 * o.size) { this.capeL = null; this._hairPts = null; this.trail.length = 0; }   // teleported: cloth and hair start fresh\n4146\t    /** expr: the face shown ('smile', 'shout', 'angry', 'wince'), or null */\n4147\t    this.t += dt; this.x = s.x; this.y = s.y; this.z = s.z || 0; this.facing = s.facing || 0; this.expr = s.expr || null;\n4148\t    const speed = s.run ? s.run * o.speedRef : Math.hypot(s.vx || 0, s.vy || 0);   // run: 0..1 runs in place (an RPG 'run away', a treadmill)\n4149\t    // traversal: hang from a ledge (hangZ: its top above the feet), a sneaking crouch while moving, a sprint's lean, and a\n4150\t    // heavy landing from land(); a roll (flip) turns the whole body after posing\n4151\t    this._hangW = approach(this._hangW || 0, s.hang ? 1 : 0, dt * 14); if (s.hang) this._hangZ = s.hangZ;\n4152\t    this._sneakW = approach(this._sneakW || 0, s.crouch ? 1 : 0, dt * 8); this._sprintW = approach(this._sprintW || 0, s.sprint ? 1 : 0, dt * 6);\n4153\t    if (s.land > 0 && this._landT === undefined) this.land(s.land);   // (an action's landing step)\n4154\t    if (this._landT !== undefined) {\n4155\t      const k = this._landK, lt = this._landT += dt, dur = .22 + .3 * Math.min(1, k);\n4156\t      this._landW = lt < .05 ? lt / .05 * k : lt < dur ? k * (1 - ease.inOut((lt - .05) / (dur - .05))) : 0;\n4157\t      if (lt >= dur) this._landT = undefined;\n4158\t    }\n4159\t    this._spW = approach(this._spW, clamp(speed / o.speedRef, 0, 1.25), dt * 7);\n4160\t    if (speed > 3 && !s.run) {\n4161\t      const c = Math.cos(this.facing), sn = Math.sin(this.facing), k = Math.min(1, dt * 10), vx = +s.vx || 0, vy = +s.vy || 0;   // (vx alone, or a NaN, is no move on that axis: never a NaN gait)\n4162\t      this._mv[0] = lerp(this._mv[0], (vx * c + vy * sn) / speed, k); this._mv[1] = lerp(this._mv[1], (-vx * sn + vy * c) / speed, k);\n4163\t    }\n4164\t    this.phase += dt * speed / (o.stride * o.size * this._strideK() * Math.max(.4, Math.min(1, this._spW)));\n4165\t    this._dashW = approach(this._dashW, s.dash ? 1 : 0, dt * (s.dash ? 24 : 8));\n4166\t    this.hurtW = approach(this.hurtW, s.hurt ? 1 : 0, dt * 14);\n4167\t    this._atkW = approach(this._atkW, s.attack ? 1 : 0, dt * (s.attack ? 30 : 7));\n4168\t    this._airW = approach(this._airW, s.air ? 1 : 0, dt * (s.air ? 10 : 18));\n4169\t    // held poses: 'cheer' (item get, victory), 'cast' (both hands forward), 'guard' (fists up), 'kneel', 'crouch', 'wave', 'hips'\n4170\t    // (hands on hips), and down: 0..1 (knocked flat). stance: 'guard' (fists up while moving) | 'ready' (weapon held forward)\n4171\t    const pk = this.poseW || (this.poseW = { cheer: 0, cast: 0, guard: 0, kneel: 0, crouch: 0, wave: 0, hips: 0, block: 0 });\n4172\t    for (const k in pk) pk[k] = approach(pk[k], s.pose === k ? 1 : 0, dt * 9);\n4173\t    this._stW = approach(this._stW || 0, s.stance === 'guard' ? 1 : 0, dt * 10); this._rdW = approach(this._rdW || 0, s.stance === 'ready' ? 1 : 0, dt * 10);\n4174\t    this._climbW = approach(this._climbW || 0, s.climb ? 1 : 0, dt * 12); if (s.climb) this._climbP = (this._climbP || 0) + dt * Math.hypot(s.vz || 0, s.vx || 0, s.vy || 0) / (.4 * (o.armUpper + o.armLower) * o.size) * Math.PI;   // hands keep pace with the climb   // climb: hand over hand on a ladder\n4175\t    this.dieT = s.pose === 'die' ? (this.dieT || 0) + dt : 0;   // pose 'die': a stagger, the knees give, then the body topples\n4176\t    const dT = s.down !== undefined ? clamp(+s.down, 0, 1) : s.pose === 'down' || this.dieT > .45 ? 1 : 0;\n4177\t    /** downW: how far down it is, 0..1 (state down, pose 'down' or 'die'): it falls faster and faster and gets up steadily */\n4178\t    this.downW = approach(this.downW || 0, dT, dt * (dT > (this.downW || 0) ? 2.5 + 10 * (this.downW || 0) : 3.2));\n4179\t    if (this.dieT > 0) { this.hurtW = approach(this.hurtW, this.dieT < .25 ? 1 : 0, dt * 14); pk.kneel = approach(pk.kneel, this.dieT > .2 && this.dieT < .6 ? 1 : 0, dt * 10); }\n4180\t    this._pointW = approach(this._pointW, s.point ? 1 : 0, dt * (s.point ? 30 : 8));\n4181\t    this._aimA = approach(this._aimA || 0, s.aim || 0, dt * 14);   // aim: radians above (+) or below (-) level while pointing\n4182\t    if (s.attack) this._kicking = !!s.attack.spec.kick;\n4183\t    this.blink -= dt; if (this.blink < -.12) this.blink = 2 + Math.random() * 3;\n4184\t    this.sqV += (-260 * this.sq - 15 * this.sqV) * dt; this.sq = clamp(this.sq + this.sqV * dt, -.3, .3);\n4185\t\n4186\t    const A = s.attack; let tLean = 0, tTwist = 0, tLunge = 0, tHop = 0, tCrouch = 0, armT = A ? 1 : 0;\n4187\t    this.spin = 0;\n4188\t    // side views swing weapons in the screen plane (an overhead chop), ground views in the ground plane.\n4189\t    // spec.plane or the rig option swingPlane ('side' | 'ground') choose it yourself.\n4190\t    this._sidePlane = !!A && !A.spec.kick && (A.spec.plane ? A.spec.plane === 'side' : o.swingPlane ? o.swingPlane === 'side' : this._pitch !== undefined && this._pitch < 15 && !!o.weapon && A.spec.blade !== 0 && A.spec.hand !== 'L');\n4191\t    if (A) {\n4192\t      // wind: anticipation (pull back, crouch). active: the strike, with a lunge, lead-foot step, lean, twist and hop.\n4193\t      // recover: follow through, hold the end pose, then blend back to the stance by position (never swing backwards)\n4194\t      const sp = A.spec, side = this._sidePlane, rest = side ? -.9 : 1.1, RS = sp.rel ? (o.armUpper + o.armLower) / 9.2 : 1, R = (sp.reach || 7.5) * RS, r0 = sp.r0 === undefined ? R : sp.r0 * RS, r1 = sp.r1 === undefined ? R : sp.r1 * RS;\n4195\t      /** atkRel: the attack's heights are relative to the shoulders (its spec's rel) */\n4196\t      this._atkRel = !!sp.rel; const zRest = sp.rel ? (sp.kick ? .1 : -7) : 9, z0 = sp.z0 === undefined ? zRest : sp.z0, z1 = sp.z1 === undefined ? z0 : sp.z1;   // side-plane moves have no heights\n4197\t      // lunge / hop / crouch are body motion in local units, clamped so a game's own 'lunge' speed field can't stretch the rig\n4198\t      const hold = sp.hold === undefined ? .3 : sp.hold, lean = sp.lean === undefined ? (sp.kick ? -.22 : .3) : clamp(sp.lean, -.8, .8), lunge = sp.lunge === undefined ? (sp.kick ? .4 : 1.2) : clamp(sp.lunge, -4, 5);\n4199\t      if (A.phase === 'wind' && (this._aPh !== 'wind' || this._aSp !== sp)) {   // a chained hit starts where the arm is\n4200\t        const chain = (this._armW || 0) > .3 && this._theta !== undefined, fists = !o.weapon || sp.hand === 'L' || sp.blade === 0;\n4201\t        this._th0 = chain ? this._theta : rest; this._z0 = chain && this._atkRel === !!sp.rel && isFinite(this.atkZ) ? this.atkZ : fists ? z0 : zRest; this._r0 = chain ? this.reach : R * .75;\n4202\t        const J = this.J; if (J.handR) this._from = { R: J.handR.slice(), L: J.handL.slice(), bd: J.bladeDir.slice() };   // the wind blends from the real pose: no snaps\n4203\t      }\n4204\t      this._aPh = A.phase; this._aSp = sp; this._atkHand = sp.hand || 'R'; if (A.phase !== 'wind') this._windK = 1;\n4205\t      if (A.phase === 'wind') {\n4206\t        const k = ease.outQuad(A.u);\n4207\t        this._theta = lerp(this._th0, sp.a0, k); this.atkZ = lerp(this._z0, z0, A.u); this.reach = lerp(this._r0, r0, k); this._windK = k;\n4208\t        tLean = -Math.abs(lean) * .45; tLunge = -lunge * .3 * k; tCrouch = clamp(sp.crouch === undefined ? (sp.kick ? 0 : .15) : sp.crouch, 0, 1) * k;   // coil: lean back, draw back, dip\n4209\t      } else if (A.phase === 'active') {\n4210\t        const k = ease.outCubic(A.u);\n4211\t        this._theta = sp.spin ? sp.a0 : lerp(sp.a0, sp.a1, k); this.atkZ = lerp(z0, z1, k); this.reach = lerp(r0, r1, k);\n4212\t        tLean = lean; tLunge = lunge * k; tHop = clamp(sp.hop || 0, 0, 12) * Math.sin(k * Math.PI); tCrouch = clamp(sp.crouch === undefined ? (sp.kick ? 0 : .15) : sp.crouch, 0, 1) * (1 - k);\n4213\t        if (sp.spin) { if (side) this._theta = sp.a0 - TAU * k; else this.spin = -TAU * k; }   // side views: the blade loops a full circle in front (a windmill) instead of a turn the camera sees edge-on\n4214\t      } else {\n4215\t        const k = ease.outQuad(clamp(A.u / hold, 0, 1)), span = sp.spin ? 0 : sp.a1 - sp.a0;\n4216\t        this._theta = (sp.spin ? sp.a0 : sp.a1) + span * .08 * k; this.atkZ = z1; this.reach = r1;\n4217\t        armT = A.u < hold ? 1 : 1 - ease.inOut((A.u - hold) / (1 - hold));\n4218\t        tLean = lean * armT; tLunge = lunge * armT;\n4219\t      }\n4220\t      tTwist = sp.spin ? 0 : clamp(this._theta * (side ? .08 : .32) * (sp.twist === undefined ? 1 : sp.twist) * (this._atkHand === 'L' ? -1 : 1), -.7, .7);\n4221\t      // smear arc in absolute ground angles\n4222\t      if (this._sidePlane) this._smear = null;\n4223\t      else if (sp.blade !== 0) {\n4224\t        const base = this.facing, len = ((sp.reach || 7.5) + (sp.blade || o.bladeLen)) * o.size;\n4225\t        if (A.phase === 'active') this._smear = { a0: base + sp.a0, a1: base + this.spin + this._theta, r0: len * .45, r1: len, z: (this.atkZ + 1) * o.size, fade: 1 };\n4226\t        else if (A.phase === 'recover' && this._smear) { const u = clamp(A.u / .5, 0, 1); const end = base + (sp.spin ? sp.a0 - TAU : sp.a1); this._smear.a0 = lerp(base + sp.a0, end, ease.inQuad(u)); this._smear.a1 = end; this._smear.fade = 1 - u; if (u >= 1) this._smear = null; }\n4227\t        else if (A.phase === 'wind') this._smear = null;\n4228\t      }\n4229\t    } else { this._smear = null; this._windK = 1; this._aPh = null; }\n4230\t    this._armW = approach(this._armW || 0, armT, dt * (armT > (this._armW || 0) ? 30 : 12));\n4231\t    /** lunge: how far the body leans into an attack now, world units; hop: how high an attack's hop lifts it now */\n4232\t    this.lunge = lerp(this.lunge || 0, tLunge, Math.min(1, dt * 22)); this.hop = lerp(this.hop || 0, tHop, Math.min(1, dt * 25)); this._crouchA = lerp(this._crouchA || 0, tCrouch, Math.min(1, dt * 20));\n4233\t    this._atkLean = lerp(this._atkLean, tLean, Math.min(1, dt * 25));\n4234\t    this._twist = lerp(this._twist, tTwist, Math.min(1, dt * 25));\n4235\t    this.solvePose();\n4236\t    if (o.cape) this._cape(dt);\n4237\t    if (o.hair.style === 'long' || o.hair.style === 'ponytail') this._hair(dt);\n4238\t    if (HOOKS.pose) HOOKS.pose.call(this, dt, s);   // (crawling, swimming, swinging: section 16c)\n4239\t    if (s.flip > 0 && s.flip < 1) this._roll(s.flip);\n4240\t    // weapon trail: remember where the blade (or fist, or foot) really went, so the smear works in every view\n4241\t    const T = this.trail;\n4242\t    for (const p of T) p.age += dt;\n4243\t    const maxAge = s.attack && s.attack.phase === 'active' ? .14 : .07;   // after the strike the ribbon clears quickly: no ghost slivers\n4244\t    while (T.length && T[0].age > maxAge) T.shift();\n4245\t    const atk = s.attack, swinging = atk && (atk.phase === 'active' || (atk.phase === 'recover' && atk.u < .12));\n4246\t    if (swinging && (atk.spec.blade !== 0 || atk.spec.kick || !o.weapon || atk.spec.hand === 'L')) {\n4247\t      const J = this.J, kick = atk.spec.kick, left = atk.spec.hand === 'L', sword = o.weapon === 'sword' && !kick && !left;\n4248\t      const b = kick ? J.kneeR : sword ? V3.add(J.handR, V3.mul(J.bladeDir, 2)) : left ? J.elbowL : J.elbowR, t = kick ? J.footR : sword ? V3.add(J.handR, V3.mul(J.bladeDir, o.bladeLen)) : left ? J.handL : J.handR;\n4249\t      const wb = this._w(b), wt = this._w(t), last = T[T.length - 1];\n4250\t      if (last && Math.hypot(this.x + wt[0] - last.t[0], this.y + wt[1] - last.t[1], this.z + wt[2] - last.t[2]) > 14 * o.size) T.length = 0;   // a jump (teleport, respawn): start a new ribbon\n4251\t      T.push({ b: [this.x + wb[0], this.y + wb[1], this.z + wb[2]], t: [this.x + wt[0], this.y + wt[1], this.z + wt[2]], o: [this.x, this.y, this.z], age: 0, w: sword ? 1 : .6 });\n4252\t      if (T.length > 12) T.shift();\n4253\t    }\n4254\t  }\n4255\t  /** long hair and ponytails: a verlet strand that trails behind the head */\n4256\t  _hair(dt) {\n4257\t    const o = this.o, long = o.hair.style === 'long', N = o.hair.len || (long ? 6 : 4), seg = (long ? 1.9 : 1.6) * o.size;\n4258\t    const J = this.J, anchor = () => { const w = this._w([J.head[0] - o.headR * .8, 0, J.head[2] + (long ? o.headR * .1 : o.headR * .55)]); return [this.x + w[0], this.y + w[1], this.z + w[2]]; };\n4259\t    if (!this._hairPts) { const a = anchor(), hx = -Math.cos(this.facing) * .8 * o.size, hy = -Math.sin(this.facing) * .8 * o.size; this._hairPts = Array.from({ length: N }, (_, i) => ({ x: a[0] + hx * i * .3, y: a[1] + hy * i * .3, z: a[2] - i * seg, px: a[0] + hx * i * .3, py: a[1] + hy * i * .3, pz: a[2] - i * seg })); }\n4260\t    const P = this._hairPts, a = anchor(), damp = Math.pow(.97, dt * 120), fx = Math.cos(this.facing + this.spin), fy = Math.sin(this.facing + this.spin), dt2 = dt * dt;   // trails behind the body's turn\n4261\t    Object.assign(P[0], { x: a[0], y: a[1], z: a[2], px: a[0], py: a[1], pz: a[2] });\n4262\t    for (let i = 1; i < P.length; i++) { const n = P[i], vx = (n.x - n.px) * damp, vy = (n.y - n.py) * damp, vz = (n.z - n.pz) * damp; n.px = n.x; n.py = n.y; n.pz = n.z; n.x += vx - fx * 20 * dt2; n.y += vy - fy * 20 * dt2; n.z += vz - 200 * dt2; }\n4263\t    const shZ = this.z + J.shC[2] * o.size, bodyR = (o.torsoW * .75 + .6) * o.size, headTop = this.z + (J.head[2] + o.headR * .6) * o.size;\n4264\t    for (let it = 0; it < 3; it++) for (let i = 1; i < P.length; i++) {\n4265\t      const A = P[i - 1], B = P[i], dx = B.x - A.x, dy = B.y - A.y, dz = B.z - A.z, d = Math.hypot(dx, dy, dz) || 1e-6, kk = (d - seg) / d;\n4266\t      if (i === 1) { B.x -= dx * kk; B.y -= dy * kk; B.z -= dz * kk; } else { A.x += dx * kk * .5; A.y += dy * kk * .5; A.z += dz * kk * .5; B.x -= dx * kk * .5; B.y -= dy * kk * .5; B.z -= dz * kk * .5; }\n4267\t      const rx = B.x - this.x, ry = B.y - this.y, rd = Math.hypot(rx, ry);\n4268\t      if (B.z < shZ + 2 * o.size && rd < bodyR) { const ux = rd > .01 ? rx / rd : -fx, uy = rd > .01 ? ry / rd : -fy; B.x = this.x + ux * bodyR; B.y = this.y + uy * bodyR; }\n4269\t      if (B.z < this.z + .5) B.z = this.z + .5;\n4270\t      if (B.z > headTop) B.z = headTop;   // no plume over the head on attacks and knockbacks\n4271\t    }\n4272\t  }\n4273\t  /** set the joints J from the rig's state this step (update and setPose call it); a clip player may wrap it on one rig:\n4274\t   *  const base = rig.solvePose; rig.solvePose = function () { base.call(this); ...move J... } */\n4275\t  solvePose() {\n4276\t    const o = this.o, J = this.J, sp = Math.min(1, this._spW), mf = this._mv[0], mr = this._mv[1], ph = this.phase, dash = this._dashW, hurt = this.hurtW, rz = V3.rz, add = V3.add;\n4277\t    const breathe = Math.sin(this.t * 2.3) * (1 - sp);\n4278\t    const bob = (.5 - Math.abs(Math.cos(ph)) * 1.3) * sp;\n4279\t    const PW = this.poseW || { cheer: 0, cast: 0, guard: 0, kneel: 0 }, kn = PW.kneel, lg = this.lunge || 0, cw = this._climbW || 0;\n4280\t    const hw = this._hangW || 0, snk = this._sneakW || 0, spr = (this._sprintW || 0) * sp, ld = this._landW || 0, sk = this._strideK();\n4281\t    const cr = Math.max(PW.crouch || 0, this._crouchA || 0, Math.sin(clamp(this.downW || 0, 0, 1) * Math.PI) * .85);   // falling (and getting up) buckles the knees\n4282\t    const sway = Math.sin(this.t * 1.15) * .3 * (1 - sp) * (1 - this._atkW);   // idle weight shift from foot to foot\n4283\t    const hipC = [mf * .4 * sp - .4 * hurt + lg * .55, mr * .3 * sp + sway, o.hipZ + bob + breathe * .3 - dash * 2.2 - hurt * .6 - kn * o.hipZ * .42 - PW.guard * .9 - cr * o.hipZ * .32 - snk * o.hipZ * .3 - ld * o.hipZ * .42 + (this.hop || 0)];\n4284\t    J.hipL = add(hipC, rz([0, -o.hipHalf, 0], this._twist * .4)); J.hipR = add(hipC, rz([0, o.hipHalf, 0], this._twist * .4));\n4285\t    for (const s of [-1, 1]) {\n4286\t      const p = ph + (s > 0 ? Math.PI : 0), along = Math.sin(p) * o.stride * sp * sk;\n4287\t      let foot = [mf * along + (s > 0 ? .8 : -.6) * (1 - sp), s * o.footSpread + mr * along, Math.max(0, Math.cos(p)) * o.lift * sp];\n4288\t      foot = V3.lerp(foot, [s > 0 ? 4 : -5, s * 2.2, s > 0 ? 1.5 : .3], dash);\n4289\t      if (this._airW > 0) foot = V3.lerp(foot, [s > 0 ? 3.2 : -2.6, s * 1.9, s > 0 ? 6 : 3.6], this._airW);\n4290\t      if (kn > 0) foot = V3.lerp(foot, [s > 0 ? 3.4 : -4.2, s * 2, s > 0 ? 0 : 0], kn);\n4291\t      if (PW.guard > 0) foot = V3.lerp(foot, [s > 0 ? 2.6 : -2.8, s * 2.6, 0], PW.guard * (1 - sp));\n4292\t      if (cr > 0) foot = V3.lerp(foot, [s > 0 ? 1.6 : -1.4, s * (o.footSpread + .7), foot[2] * (1 - cr)], cr * (1 - sp * .5));\n4293\t      if (lg > 0) foot[0] += (s === (this._atkHand === 'L' ? 1 : -1) ? lg * 1.3 : -lg * .15) * (1 - sp);   // the lead foot steps into the strike\n4294\t      if (this.hop) foot[2] += this.hop;\n4295\t      if (cw > 0) foot = V3.lerp(foot, [.6, s * 1.5, Math.max(0, Math.sin(this._climbP + (s > 0 ? Math.PI : 0))) * 3.4], cw);\n4296\t      if (snk > 0) foot[1] += s * .6 * snk;                                                                     // a wider, lower stance\n4297\t      if (ld > 0) foot = V3.lerp(foot, [s > 0 ? 2.6 : -2.4, s * (o.footSpread + 1), 0], Math.min(1, ld));      // planted wide\n4298\t      if (hw > 0) foot = V3.lerp(foot, [1.3, s * 1.3, o.hipZ * .08 + (s > 0 ? .8 : 0)], hw);                   // dangling against the wall\n4299\t      if (s > 0 && this._kicking && this._atkW > 0) foot = V3.lerp(foot, [Math.cos(this._theta) * (this.reach + 3), Math.sin(this._theta) * (this.reach + 3), (this._atkRel ? this.atkZ * o.hipZ : this.atkZ) + (this.hop || 0)], this._armW || 0);\n4300\t      const hip = s > 0 ? J.hipR : J.hipL;\n4301\t      const [knee, f2] = ik3(hip, foot, o.legUpper, o.legLower, [1, s * .15, .1]);\n4302\t      J[s > 0 ? 'kneeR' : 'kneeL'] = knee; J[s > 0 ? 'footR' : 'footL'] = f2;\n4303\t    }\n4304\t    const leanF = (o.lean + .16 * sp * mf + .45 * dash + this._atkLean - .35 * hurt + cr * .22 + snk * .34 + spr * .3 + ld * .42) * (1 - hw) + hw * .06, leanR = .1 * sp * mr;\n4305\t    const dir = V3.norm([Math.sin(leanF), Math.sin(leanR), Math.cos(leanF)]);\n4306\t    const shC = add(hipC, V3.mul(dir, o.torso));\n4307\t    J.hipC = hipC; J.shC = shC;\n4308\t    J.shL = add(shC, rz([0, -o.shoulderHalf, 0], this._twist)); J.shR = add(shC, rz([0, o.shoulderHalf, 0], this._twist));\n4309\t    J.head = add(shC, V3.mul(V3.norm([dir[0] + o.hunch * .9, dir[1], dir[2]]), o.neck + o.headR));\n4310\t    const armLen = o.armUpper + o.armLower, aw = this._armW || 0, sA = this._atkHand === 'L' ? -1 : 1, two = this._atkHand === 'both', fists = !o.weapon || this._stW > .5;\n4311\t    // where the striking hand goes, and the weapon's direction, for the current attack angle\n4312\t    const aT = this._sidePlane ? add(shC, [Math.cos(this._theta) * this.reach, sA * .8, Math.sin(this._theta) * this.reach]) : add(shC, [Math.cos(this._theta) * this.reach, Math.sin(this._theta) * this.reach, this._atkRel ? this.atkZ : this.atkZ - shC[2]]);\n4313\t    const aDir = this._sidePlane ? V3.norm([Math.cos(this._theta), .05, Math.sin(this._theta)]) : V3.norm([Math.cos(this._theta), Math.sin(this._theta), -.12]);\n4314\t    for (const s of [-1, 1]) {\n4315\t      const sh = s > 0 ? J.shR : J.shL, q = ph + (s > 0 ? 0 : Math.PI), along = -Math.sin(q) * o.swing * sp * (1 + .6 * spr) * (1 - .4 * snk);\n4316\t      let hand = add(sh, [mf * along + .5 * (1 - sp) + o.hunch * 3, s * .9 + mr * along, -armLen * .86 + Math.abs(Math.sin(q)) * 1.2 * sp]);\n4317\t      hand = V3.lerp(hand, add(sh, [-4.5, s * 1.6, -5]), dash);\n4318\t      hand = V3.lerp(hand, add(sh, s > 0 ? [1.4, -.6, .6] : [-1.6, s * 2.2, -3.2]), hurt);   // a flinch: one arm up to shield the face, the other flung back\n4319\t      if (this._airW > 0) hand = V3.lerp(hand, add(sh, [1.2, s * 2.6, -1.2]), this._airW * .7);\n4320\t      if (s > 0 && this._pointW > 0) { const aa = this._aimA || 0; hand = V3.lerp(hand, add(sh, [armLen * .92 * Math.cos(aa), -.6, armLen * .92 * Math.sin(aa) - .4]), this._pointW); }\n4321\t      if (PW.cheer > 0) hand = V3.lerp(hand, add(sh, [.6, s * 1.4, armLen * (.74 + .12 * Math.sin(this.t * 9 + (s > 0 ? 0 : .7)))]), PW.cheer);   // fists pump\n4322\t      if (PW.cast > 0) hand = V3.lerp(hand, add(shC, [armLen * .82, s * 1.3, -1.2]), PW.cast);\n4323\t      const guardAt = add(shC, s < 0 ? [3.8, -1, .4] : [2.3, 1.5, -.6]);   // boxer's guard: lead fist out at chin height, face stays visible\n4324\t      if (PW.guard > 0) hand = V3.lerp(hand, guardAt, PW.guard);\n4325\t      if (this._stW > 0) hand = V3.lerp(hand, guardAt, this._stW * (1 - dash));\n4326\t      if (this._rdW > 0 && o.weapon) hand = V3.lerp(hand, s > 0 ? add(shC, [2.8, .9, -3]) : add(shC, [2.2, .2, -3.6]), this._rdW * (1 - dash));   // ready: weapon held forward in both hands\n4327\t      if (PW.wave > 0 && s === (o.weapon ? -1 : (this._camSide || 1))) { const w = Math.sin(this.t * 11); hand = V3.lerp(hand, add(sh, [.8 + w * 1.7, s * (2 + Math.max(0, w) * 1.4), armLen * .8]), PW.wave); }   // the free hand waves (the camera-side one when both are free)\n4328\t      if (PW.hips > 0) hand = V3.lerp(hand, add(s > 0 ? J.hipR : J.hipL, [-.2, s * 1.5, 1.5]), PW.hips);\n4329\t      if (PW.block > 0) hand = V3.lerp(hand, add(shC, s > 0 ? [2.6, .6, -2.4] : [2.4, -.2, -3.4]), PW.block);   // block: weapon upright across the body, both hands on it\n4330\t      if (cw > 0) hand = V3.lerp(hand, add(sh, [1.7, s * .5, armLen * (.08 + .8 * (.5 + .5 * Math.sin(this._climbP + (s > 0 ? 0 : Math.PI))))]), cw);   // hands on the rails, one reaching high above the head while the other pulls down\n4331\t      if (snk > 0) hand = V3.lerp(hand, add(sh, [2.2 + along * .3, s * 1.3, -armLen * .6]), snk * .55);       // sneaking: hands low and forward\n4332\t      if (ld > 0) hand = V3.lerp(hand, s > 0 && this._landK >= 1 ? [3.2, 1.6, .3] : add(sh, [-1.4, s * 3.2, -armLen * .3]), Math.min(1, ld));   // a three-point landing: one hand on the ground, the other back\n4333\t      if (hw > 0) hand = V3.lerp(hand, add(sh, [2.4, s * .4, clamp((this._hangZ === undefined ? sh[2] + armLen : this._hangZ) - sh[2], 1, armLen * .96)]), hw);   // gripping the edge above\n4334\t      const wk = this._from && this._windK < 1 ? this._windK : 1, from = wk < 1 ? this._from[s > 0 ? 'R' : 'L'] : null;\n4335\t      if (aw > 0 && !this._kicking) {\n4336\t        if (s === sA) hand = V3.lerp(hand, from ? V3.lerp(from, aT, wk) : aT, aw);                // the striking hand\n4337\t        else if (two) hand = V3.lerp(hand, add(aT, V3.mul(aDir, -1.7)), aw);                      // two-handed grip below it\n4338\t        else { const offT = fists ? guardAt : add(shC, [1.6, s * 1.6, -1.6]); hand = V3.lerp(hand, from ? V3.lerp(from, offT, wk) : offT, from ? aw : aw * .85); }   // the other hand guards the chin (fists) or pulls back\n4339\t      }\n4340\t      if (this._kicking && aw > 0) hand = V3.lerp(hand, add(shC, [1.8, s * 2.2, .6 - (s > 0 ? 1.5 : 0)]), aw * .85);   // arms up for balance during a kick\n4341\t      const [elbow, h2] = ik3(sh, hand, o.armUpper, o.armLower, [-1, s * .7, -.2]);\n4342\t      J[s > 0 ? 'elbowR' : 'elbowL'] = elbow; J[s > 0 ? 'handR' : 'handL'] = h2;\n4343\t    }\n4344\t    const wp = o.weapon, rest = V3.norm(wp === 'staff' ? [.3, .15, 1] : wp === 'gun' ? [.8, 0, -.6] : [.55, .35, -.75]), atk = aDir;\n4345\t    let bd = V3.lerp(rest, atk, this._kicking || sA < 0 ? 0 : aw);\n4346\t    if (this._from && this._windK < 1 && !this._kicking && sA > 0) bd = V3.lerp(this._from.bd, bd, this._windK);   // the weapon turns from where it was\n4347\t    if (PW.cheer > 0) bd = V3.lerp(bd, [.15, .05, 1], PW.cheer);   // raised in triumph, point up\n4348\t    if (PW.block > 0) bd = V3.lerp(bd, [.35, -.3, .9], PW.block);   // held upright across the body\n4349\t    if (this._rdW > 0) bd = V3.lerp(bd, [.62, .08, .78], this._rdW * (1 - aw));\n4350\t    if (this._pointW > 0) bd = V3.lerp(bd, [Math.cos(this._aimA || 0), 0, Math.sin(this._aimA || 0)], this._pointW);\n4351\t    J.bladeDir = V3.norm(bd);\n4352\t    const dw = this.downW || 0;\n4353\t    if (dw > 0) J.bladeDir = V3.norm(V3.lerp(J.bladeDir, [0, .9, -.4], dw));   // a dropped weapon lies flat once the body is down\n4354\t    if (dw > 0) {   // knocked down: rotate the whole skeleton backward so it lies flat, face up, centred on the rig's position\n4355\t      const a = dw * Math.PI / 2 * .96, ca = Math.cos(a), sa = Math.sin(a), lift = dw * 1.4, shift = dw * (o.hipZ + o.torso) * .5;\n4356\t      for (const k in J) { if (k === 'bladeDir') continue; const p = J[k]; J[k] = [p[0] * ca - p[2] * sa + shift, p[1], p[0] * sa + p[2] * ca + lift]; }\n4357\t      const b = J.bladeDir; J.bladeDir = [b[0] * ca - b[2] * sa, b[1], b[0] * sa + b[2] * ca];\n4358\t    }\n4359\t  }\n4360\t  /** world position of the head (for speech bubbles, portraits, halos) */\n4361\t  head() { const w = this._w(this.J.head); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\n4362\t  /**\n4363\t   * a close-up bust for dialog boxes and menus, drawn live from the rig (blinks, hair and hats included):\n4364\t   *   rig.drawPortrait(g, x, y, 40, { zoom: 3, turn: .6, bg: '#1a2050', frame: true })   // inside r.overlay(g => ...)\n4365\t   * zoom: pixels per world unit (3 = face fills the frame), turn: 0 = facing you, .6 = three-quarter.\n4366\t   * The bust stays upright while the rig kneels or lies down (upright: false shows the real pose); cape: false hides the cape;\n4367\t   * tint: '#808080' greys it out (a KO'd party member).\n4368\t   */\n4369\t  drawPortrait(g, x, y, size = 40, o = {}) {\n4370\t    const S = Math.round(size), zoom = o.zoom || 3, turn = o.turn === undefined ? .6 : o.turn, pitch = o.pitch || 12;\n4371\t    const v = this._pv || (this._pv = new View('portrait', 'Portrait', 0, pitch, zoom, 1));\n4372\t    v.set((Math.PI / 2 - this.facing - this.spin + turn) / DEG, pitch, zoom, 1);\n4373\t    const cache = this._pcs || (this._pcs = new Map());\n4374\t    let cvs = cache.get(S); if (!cvs) { cvs = [mkCanvas(S, S), mkCanvas(S, S)]; cache.set(S, cvs); }\n4375\t    const [cv, c2] = cvs, cg = cv.getContext('2d'), g2 = c2.getContext('2d');\n4376\t    cg.clearRect(0, 0, S, S); g2.clearRect(0, 0, S, S);\n4377\t    const PW = this.poseW || {}, keep = { trail: this.trail, cheat: this._cheat, pitch: this._pitch, cape: this.o.cape, weapon: this.o.weapon, down: this.downW, kneel: PW.kneel, cheer: PW.cheer, cast: PW.cast, hurt: this.hurtW };\n4378\t    const pose = o.upright !== false && (keep.down > 0 || keep.kneel > 0 || keep.cheer > 0 || keep.cast > 0 || keep.hurt > 0);\n4379\t    if (pose) { this.downW = 0; this.hurtW = 0; if (this.poseW) PW.kneel = PW.cheer = PW.cast = 0; this.solvePose(); }\n4380\t    if (o.cape === false) this.o.cape = null;\n4381\t    if (o.weapon === false) this.o.weapon = null;\n4382\t    { const st = clamp(1 - v.pitchDeg / 45, 0, 1), camA = Math.atan2(v.fy, v.fx); this._cheat = st > 0 && this.o.cheat ? clamp(angDiff(this.facing, camA), -this.o.cheat, this.o.cheat) * st : 0; }   // frame the head where draw() will put it\n4383\t    this.trail = [];\n4384\t    try {\n4385\t      const hw = this._w(this.J.head), hp = v.p(hw[0], hw[1], hw[2]);\n4386\t      this.draw(cg, Math.round(S / 2 - hp[0]), Math.round(S * (o.headY || .46) - hp[1]), v);\n4387\t    } finally {\n4388\t      this.trail = keep.trail; this._cheat = keep.cheat; this._pitch = keep.pitch; this.o.cape = keep.cape; this.o.weapon = keep.weapon;\n4389\t      if (pose) { this.downW = keep.down; this.hurtW = keep.hurt; if (this.poseW) { PW.kneel = keep.kneel; PW.cheer = keep.cheer; PW.cast = keep.cast; } this.solvePose(); }\n4390\t    }\n4391\t    if (o.tint) { cg.globalCompositeOperation = 'source-atop'; cg.globalAlpha = .6; cg.fillStyle = o.tint; cg.fillRect(0, 0, S, S); cg.globalAlpha = 1; cg.globalCompositeOperation = 'source-over'; }\n4392\t    for (const [dx, dy] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) g2.drawImage(cv, dx, dy);   // outline like the in-game sprite\n4393\t    g2.globalCompositeOperation = 'source-in'; g2.fillStyle = o.outline || '#0c0818'; g2.fillRect(0, 0, S, S); g2.globalCompositeOperation = 'source-over';\n4394\t    g2.drawImage(cv, 0, 0);\n4395\t    if (o.frame !== false) E.ui.box(g, x - 2, y - 2, S + 4, S + 4, { bg: o.bg || '#1a2050', border: o.border, shadow: o.shadow });\n4396\t    g.drawImage(c2, 1, 1, S - 2, S - 2, Math.round(x) + 1, Math.round(y) + 1, S - 2, S - 2);\n4397\t  }\n4398\t  _cape(dt) {\n4399\t    const c = this.o.cape, sz = this.o.size, N = c.len || 6, seg = (c.seg || 2.4) * sz, W0 = (c.width || 5) * sz;\n4400\t    const anchor = s => { const J = this.J, sh = s > 0 ? J.shR : J.shL, w = this._w(V3.add(sh, [-1.3, -s * .6, -.6])); return [this.x + w[0], this.y + w[1], this.z + w[2]]; };\n4401\t    if (!this.capeL) {\n4402\t      /** capeR: the cape's right edge points */\n4403\t      this.capeL = []; this.capeR = [];\n4404\t      const bx = -Math.cos(this.facing) * (c.body || 3.4) * sz, by = -Math.sin(this.facing) * (c.body || 3.4) * sz;   // start hanging behind the back, not inside the body\n4405\t      for (const s of [-1, 1]) { const a = anchor(s), ch = s < 0 ? this.capeL : this.capeR; for (let i = 0; i < N; i++) { const k = Math.min(1, i / 2); ch.push({ x: a[0] + bx * k, y: a[1] + by * k, z: a[2] - i * seg, px: a[0] + bx * k, py: a[1] + by * k, pz: a[2] - i * seg }); } }\n4406\t    }\n4407\t    const damp = Math.pow(.982, dt * 120), dt2 = dt * dt, fx = Math.cos(this.facing + this.spin), fy = Math.sin(this.facing + this.spin);   // trails behind the body's turn\n4408\t    for (const [ch, s] of [[this.capeL, -1], [this.capeR, 1]]) {\n4409\t      const a = anchor(s); Object.assign(ch[0], { x: a[0], y: a[1], z: a[2], px: a[0], py: a[1], pz: a[2] });\n4410\t      for (let i = 1; i < N; i++) {\n4411\t        const n = ch[i], vx = (n.x - n.px) * damp, vy = (n.y - n.py) * damp, vz = (n.z - n.pz) * damp;\n4412\t        n.px = n.x; n.py = n.y; n.pz = n.z;\n4413\t        const fl = Math.sin(this.t * 11 - i * .8 + s) * 40 * (i / N);\n4414\t        n.x += vx - fx * 30 * dt2; n.y += vy - fy * 30 * dt2; n.z += vz + (-230 + fl) * dt2;\n4415\t      }\n4416\t    }\n4417\t    const L = this.capeL, R = this.capeR, bodyR = (c.body || 3.4) * sz, shZ = this.z + this.J.shC[2] * sz;\n4418\t    for (let it = 0; it < 4; it++) {\n4419\t      for (const ch of [L, R]) for (let i = 1; i < N; i++) {\n4420\t        const a = ch[i - 1], b = ch[i], dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, d = Math.hypot(dx, dy, dz) || 1e-6, k = (d - seg) / d;\n4421\t        if (i === 1) { b.x -= dx * k; b.y -= dy * k; b.z -= dz * k; } else { a.x += dx * k * .5; a.y += dy * k * .5; a.z += dz * k * .5; b.x -= dx * k * .5; b.y -= dy * k * .5; b.z -= dz * k * .5; }\n4422\t      }\n4423\t      for (let i = 1; i < N; i++) {\n4424\t        const a = L[i], b = R[i], w = W0 * (1 + .25 * i / N), dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, d = Math.hypot(dx, dy, dz) || 1e-6, k = (d - w) / d * .5;\n4425\t        a.x += dx * k; a.y += dy * k; a.z += dz * k; b.x -= dx * k; b.y -= dy * k; b.z -= dz * k;\n4426\t      }\n4427\t      for (const ch of [L, R]) for (let i = 1; i < N; i++) {\n4428\t        const n = ch[i]; if (n.z < this.z + .4) n.z = this.z + .4; if (n.z > shZ + seg * .6) n.z = shZ + seg * .6;   // never whips up over the head\n4429\t        const rx = n.x - this.x, ry = n.y - this.y, d = Math.hypot(rx, ry), fwd = rx * fx + ry * fy;\n4430\t        if (n.z < shZ + 1 && fwd > -bodyR * .35) { n.x -= fx * (fwd + bodyR * .35); n.y -= fy * (fwd + bodyR * .35); }   // cloth stays behind the back plane, never across the chest\n4431\t        else if (n.z < shZ + 1 && d < bodyR) { const ux = d > .01 ? rx / d : -fx, uy = d > .01 ? ry / d : -fy; n.x = this.x + ux * bodyR; n.y = this.y + uy * bodyR; }\n4432\t      }\n4433\t    }\n4434\t  }\n4435\t  /**\n4436\t   * Sp(joint, f, r, z): a detail drawn around a joint (the face, hair, belt, toes) at offsets in the body's own frame,\n4437\t   * projected by S. A knocked-down body turns them backward with it. While a motion clip plays (Mocap.drive sets\n4438\t   * mocapTilt: the clip's body and head frames, 3x3, columns forward, right, up) they lean, roll and turn upside down with\n4439\t   * the body, and the face with the head; the weapon hand's offsets (the blade) are already in the rig's frame.\n4440\t   */\n4441\t  _offsets(S) {\n4442\t    const J = this.J, T = this.mocapTilt;\n4443\t    if (T) return (p, df = 0, dr = 0, dz = 0) => {\n4444\t      if (p === J.handR) return S(p[0] + df, p[1] + dr, p[2] + dz);\n4445\t      const m = p === J.head ? T.head : T.body;\n4446\t      return S(p[0] + m[0] * df + m[1] * dr + m[2] * dz, p[1] + m[3] * df + m[4] * dr + m[5] * dz, p[2] + m[6] * df + m[7] * dr + m[8] * dz);\n4447\t    };\n4448\t    const dA = (this.downW || 0) * Math.PI / 2 * .96, dca = Math.cos(dA), dsa = Math.sin(dA);\n4449\t    return dA ? (p, df = 0, dr = 0, dz = 0) => S(p[0] + df * dca - dz * dsa, p[1] + dr, p[2] + df * dsa + dz * dca) : (p, df = 0, dr = 0, dz = 0) => S(p[0] + df, p[1] + dr, p[2] + dz);\n4450\t  }\n4451\t  /** draw into g with (ox, oy) = projected position of the rig's root */\n4452\t  draw(g, ox, oy, view) {\n4453\t    this._pitch = view.pitchDeg;\n4454\t    if (this.o.charView !== false) view = charView(view);\n4455\t    if (view.id !== 'portrait') this.lastView = view;   // drawSmear projects the trail with the same view\n4456\t    // cheated 3/4 pose: in side-ish views turn the body partly toward the camera, like hand-drawn sprites\n4457\t    const st = clamp(1 - view.pitchDeg / 45, 0, 1), camA = Math.atan2(view.fy, view.fx);\n4458\t    this._camSide = Math.cos(camA - this.facing - Math.PI / 2) >= 0 ? 1 : -1;   // which hand the camera sees\n4459\t    this._cheat = st > 0 && this.o.cheat ? clamp(angDiff(this.facing, camA), -this.o.cheat, this.o.cheat) * st : 0;\n4460\t    if (this.o.style === 'classic') this._drawClassic(g, ox, oy, view); else this._drawHD(g, ox, oy, view);\n4461\t  }\n4462\t  /**\n4463\t   * HD style: volumetric limbs, shaped torso, outfits, hair styles, hands and boots, each shaded with\n4464\t   * hue-shifted tones and a light from the upper left (the look of hand-drawn PS1 / N64 era sprites).\n4465\t   */\n4466\t  _drawHD(g, ox, oy, view) {\n4467\t    const o = this.o, C = this.C, J = this.J, sz = o.size, sc = view.scale * sz, ops = this._ops || (this._ops = []);\n4468\t    ops.length = 0;\n4469\t    const an = this.facing + this.spin + this._cheat, ca = Math.cos(an), sa = Math.sin(an), k = (1 - this.sq * .4) * sz, kz = (1 + this.sq) * sz;\n4470\t    const vax = view.ax, vay = view.ay, vbx = view.bx, vby = view.by, vbz = view.bz, vdx = view.dx, vdy = view.dy, vdz = view.dz;\n4471\t    const S = (f, r, z) => { const wx = (f * ca - r * sa) * k, wy = (f * sa + r * ca) * k, wz = z * kz; return [ox + vax * wx + vay * wy, oy + vbx * wx + vby * wy + vbz * wz, vdx * wx + vdy * wy + vdz * wz]; };"}]},"parent_tool_use_id":null,"session_id":"c21bae92-846f-4b71-8d0d-098b4791d47c","uuid":"a52076b0-4160-478b-8924-742c6e9ec017","timestamp":"2026-11-05T04:22:43.391Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211853__x57f432/work/_research/engine/dist/handoff/my-3d2dge.js","content":"class Humanoid {\n  /** new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a\n   *  character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each\n   *  step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style,\n   *  color }); hood: true (drawn in colors.hair) */\n  constructor(o = {}) {\n    if (o.build && !BUILDS[o.build]) warn('build:' + o.build, 'Humanoid build \"' + o.build + '\" is unknown (chibi, heroic, bulky, skeleton)');\n    o = Object.assign({}, BUILDS[o.build] || {}, o);\n    /** o: its options, with the build's proportions and the defaults filled in (size, build, weapon, outfit, ...;\n     *  legUpper, torso, headR and the other lengths are at size 1) */\n    this.o = Object.assign({\n      legUpper: 6, legLower: 6, hipZ: 11.6, hipHalf: 1.9, footSpread: 1.9, torso: 8, shoulderHalf: 3.3, neck: 1.2, headR: 3.4,\n      armUpper: 4.6, armLower: 4.6, limbW: 2, torsoW: 3, lean: 0, hunch: 0, stride: 6.5, lift: 3.4, swing: 4, speedRef: 70,\n      weapon: 'sword', bladeLen: 11, cape: null, hood: false, eyeGlow: null, hat: null,\n      style: 'hd', size: 1, hair: 'short', outfit: 'shirt', sleeves: 'short', armor: false, cheat: .5\n    }, o);\n    /** trail: recent points of the blade (or fist) tip, for the swing's smear */\n    this._cheat = 0; this.trail = [];\n    if (typeof this.o.hair === 'string' || !this.o.hair) this.o.hair = { style: this.o.hair || 'short' };\n    /** hairPts: the long hair's simulated points (null until it has some) */\n    this._hairPts = null;\n    if (this.o.weapon && !['sword', 'gun', 'staff'].includes(this.o.weapon)) { warn('weapon:' + this.o.weapon, 'Humanoid weapon \"' + this.o.weapon + '\" is not built in (sword, gun, staff or null); drawing a sword'); this.o.weapon = 'sword'; }\n    if (typeof this.o.hat === 'string') this.o.hat = { style: this.o.hat };\n    /** C: its colors (skin, hair, cloth, pants, boot, belt, cape, capeIn, metal, hilt, eye, ...), the defaults with\n     *  o.colors over them; change one and it shows at the next draw */\n    this.C = Object.assign({}, HUMAN_COLORS, o.colors || {});\n    const C = this.C;\n    if (this.o.skeleton) C.skin = C.pants = C.boot = C.glove = C.bone || '#e6dfc8';\n    C.clothDk = C.clothDk || shade(C.cloth, -.3); C.clothLt = C.clothLt || shade(C.cloth, .25);\n    C.pantsDk = C.pantsDk || shade(C.pants, -.3); C.bootDk = C.bootDk || shade(C.boot, -.3); C.skinDk = C.skinDk || shade(C.skin, -.2);\n    /** t: seconds of its own clock (idle breathing, blinks); phase: the walk cycle's phase, radians; mv: the last\n     *  ground direction it moved, a unit vector; hurtW: 0..1, how far into the hurt flinch */\n    this.t = Math.random() * 10; this.phase = 0; this._spW = 0; this._mv = [1, 0]; this._dashW = 0; this.hurtW = 0; this._atkW = 0;\n    /** atkZ: the height of the weapon hand during an attack; reach: how far it reaches forward; spin: the body's\n     *  extra turn during a spinning move, radians */\n    this._theta = 1.2; this.atkZ = 10; this.reach = 7; this._twist = 0; this.spin = 0; this._atkLean = 0;\n    /** sq: squash and stretch, -0.45..0.45 (kick adds to it); sqV: its speed; blink: seconds to the next blink;\n     *  facing: the angle it faces, radians; x, y, z: where its feet are (from the last update); J: its joints this\n     *  step in its own frame ({ hipL, kneeL, footL, shC, head, handR, ... }; rig.worldOffset(J.handR) gives one in\n     *  the world); smear: the swing's smear arc, or null */\n    this.sq = 0; this.sqV = 0; this.blink = 2; this.facing = 0; this.x = 0; this.y = 0; this.z = 0; this.J = {}; this._smear = null;\n    /** capeL: the cape's left edge points (null until it has a cape and has moved) */\n    this.capeL = null; this._airW = 0; this._pointW = 0; this._kicking = false;\n    this.solvePose();\n  }\n  /** a squash-and-stretch kick: + stretches (a jump), - squashes (a landing, a hit) */\n  kick(v) { this.sqV += v; }\n  /** a heavy landing: knees bend deep and spring back over a moment; strength 1 or more drops a hand to the ground\n   *  (a three-point landing), .3-.6 is a soft one. Call it on the step the body lands */\n  land(strength = 1) { this._landT = 0; this._landK = clamp(strength, 0, 1.5); this.kick(-1.5 * Math.min(1, strength)); }\n  /** how much a stride stretches: shorter while sneaking, longer while sprinting */\n  _strideK() { return 1 - .35 * (this._sneakW || 0) + .25 * (this._sprintW || 0); }\n  /** the roll (state flip: u 0..1, a forward somersault about the hips, tucked in the middle): turns every joint, and the\n   *  cape and hair for this step's drawing only (the next update puts them back before they simulate, so they never\n   *  jump or gain speed). Emberdeep's dodge roll, moved into the rig */\n  _roll(u) {\n    const J = this.J, o = this.o, a = -ease.inOut(clamp(u, 0, 1)) * TAU, c = Math.cos(a), s = Math.sin(a), cz = o.hipZ * .55, tuck = Math.sin(clamp(u, 0, 1) * Math.PI);\n    const T0 = p => { const f = p[0] * (1 - .35 * tuck), z = (p[2] - cz) * (1 - .45 * tuck); return [f * c - z * s, p[1] * (1 - .25 * tuck), f * s + z * c + cz * (1 - .55 * tuck)]; };\n    let lift = 0; for (const k in J) { const p = J[k]; if (p && k !== 'bladeDir') lift = Math.max(lift, -T0(p)[2] + (k === 'head' ? o.headR : .5)); }   // rolls over on the shoulders: nothing goes through 