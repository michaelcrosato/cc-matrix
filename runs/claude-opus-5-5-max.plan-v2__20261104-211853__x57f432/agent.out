elete data[k];\n      },\n      key: function (i) {\n        var keys = Object.keys(data);\nround.js:48: * Math.random and every copy starts the same: read from the game's own tag,\nround.js:50: * (ids it makes from Math.random must differ between its copies), so it keeps one.\nharness.html:113: * For a game tagged parallel or ghost, the seed rides in the address: the client seeds Math.random with it before the game's scripts run.\nharness.html:379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\nharness.html:412:  window.__hubCheck = report;\nharness.html:458:    const randomly = async (ms) => {\nharness.html:461:        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\nharness.html:465:    await randomly(Math.min(1500, playMs / 4));\nharness.html:474:      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame\nharness.html:479:    await randomly(playMs / 2);\nbridge.js:283:export function createLocalNetwork({ latency = 0, jitter = 0, loss = 0, random = Math.random, clock = globalThis } = {}) {\nbridge.js:311:        if (!reliable && random() < settings.loss) return;\nbridge.js:313:        const delay = to === key ? 0 : Math.max(0, settings.latency + (random() * 2 - 1) * settings.jitter);","is_error":false}]},"parent_tool_use_id":null,"session_id":"c21bae92-846f-4b71-8d0d-098b4791d47c","uuid":"69fc8d07-b322-43c4-b169-d7bd827dfc78","timestamp":"2026-11-05T04:27:16.292Z","tool_use_result":{"stdout":"/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub neve