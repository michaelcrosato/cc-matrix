{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pz74pSggp5StHcbeYEdp7G","type":"tool_result","content":"1\t<!doctype html>\n2\t<html lang=\"en\">\n3\t<head>\n4\t<meta charset=\"utf-8\">\n5\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n6\t<title>Comet Dash — AI Hub session example (ghost)</title>\n7\t<meta name=\"description\" content=\"A minimal ghost game for the AI Hub Session Protocol: everyone runs the same seeded course on their own device and sees the others as ghosts.\">\n8\t<meta name=\"theme-color\" content=\"#0f1b2e\">\n9\t<meta name=\"hub:type\" content=\"Tech demo\">\n10\t<meta name=\"hub:players\" content=\"1\">\n11\t<meta name=\"hub:session\" content=\"1\">\n12\t<meta name=\"hub:session-players\" content=\"2-4\">\n13\t<meta name=\"hub:session-mode\" content=\"ghost\">\n14\t<meta name=\"hub:session-minutes\" content=\"1\">\n15\t<meta name=\"hub:session-goal\" content=\"Fastest to the end of the course wins\">\n16\t<meta name=\"hub:session-howto\" content=\"Steer: ← →, A D or a stick · boost: Space or Cross · or drag a finger\">\n17\t<style>\n18\t  html, body { margin: 0; height: 100%; background: #0f1b2e; color: #eef3fb; font: 16px system-ui, sans-serif; overflow: hidden; }\n19\t  canvas { display: block; width: 100%; height: 100%; touch-action: none; }\n20\t</style>\n21\t<script>\n22\t/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n23\t(function (root) {\n24\t  'use strict';\n25\t  if (root.AIHub) return;\n26\t\n27\t  var VERSION = '1.4.0';\n28\t  var HELLO_EVERY_MS = 500;\n29\t  var HELLO_TIMEOUT_MS = 10000;\n30\t  var PROGRESS_EVERY_MS = 1000;\n31\t  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n32\t  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n33\t\n34\t  var framed = false;\n35\t  try {\n36\t    framed = root.parent && root.parent !== root;\n37\t  } catch (e) {\n38\t    framed = true;\n39\t  }\n40\t  var search = String(root.location && root.location.search);\n41\t  var flagged = /[?&]aihub=/.test(search);\n42\t  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n43\t\n44\t  var hub = {\n45\t    version: VERSION,\n46\t    protocol: 1,\n47\t    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n48\t    active: !!(flagged && framed),\n49\t    me: null,\n50\t    host: null,\n51\t    isHost: false,\n52\t    players: [],\n53\t    mode: null,\n54\t    seed: 0,\n55\t    limitMs: 0,\n56\t    round: 0,\n57\t    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n58\t    splash: false,\n59\t    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n60\t    seeded: false,\n61\t  };\n62\t\n63\t  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n64\t  function memoryStorage() {\n65\t    var data = Object.create(null);\n66\t    var api = {\n67\t      getItem: function (k) {\n68\t        k = String(k);\n69\t        return k in data ? data[k] : null;\n70\t      },\n71\t      setItem: function (k, v) {\n72\t        data[String(k)] = String(v);\n73\t      },\n74\t      removeItem: function (k) {\n75\t        delete data[String(k)];\n76\t      },\n77\t      clear: function () {\n78\t        for (var k in data) delete data[k];\n79\t      },\n80\t      key: function (i) {\n81\t        var keys = Object.keys(data);\n82\t        return i >= 0 && i < keys.length ? keys[i] : null;\n83\t      },\n84\t    };\n85\t    if (typeof Proxy !== 'function') return api;\n86\t    return new Proxy(api, {\n87\t      get: function (t, k) {\n88\t        if (k === 'length') return Object.keys(data).length;\n89\t        if (typeof k === 'symbol' || k in t) return t[k];\n90\t        return k in data ? data[k] : undefined;\n91\t      },\n92\t      set: function (t, k, v) {\n93\t        if (typeof k !== 'symbol') data[k] = String(v);\n94\t        return true;\n95\t      },\n96\t      has: function (t, k) {\n97\t        return k in data || k in t;\n98\t      },\n99\t      deleteProperty: function (t, k) {\n100\t        delete data[k];\n101\t        return true;\n102\t      },\n103\t      ownKeys: function () {\n104\t        return Object.keys(data);\n105\t      },\n106\t      getOwnPropertyDescriptor: function (t, k) {\n107\t        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n108\t      },\n109\t    });\n110\t  }\n111\t\n112\t  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n113\t  function generator(a) {\n114\t    return function () {\n115\t      a = (a + 0x6d2b79f5) >>> 0;\n116\t      var t = a;\n117\t      t = Math.imul(t ^ (t >>> 15), t | 1);\n118\t      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n119\t      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n120\t    };\n121\t  }\n122\t\n123\t  // A fair start: in a session the game gets an empty storage of its own, so\n124\t  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n125\t  // and nothing the round saves touches the player's own saves.\n126\t  if (hub.active) {\n127\t    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n128\t      try {\n129\t        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n130\t      } catch (e) {\n131\t        warn('could not give the game a fresh ' + stores[s]);\n132\t      }\n133\t    }\n134\t  }\n135\t\n136\t  // Side by side: before any of the game's own scripts run, Math.random becomes\n137\t  // a generator seeded by the hub, so every copy builds the same start.\n138\t  var realRandom = Math.random;\n139\t  var seededRandom = null;\n140\t  if (hub.active && seedArg) {\n141\t    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n142\t    hub.seeded = true;\n143\t  }\n144\t\n145\t  // In a session the hub owns fullscreen: a game that asks for it gets the\n146\t  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n147\t  // hub says when its page goes in and out, so the game's own toggle and its\n148\t  // fullscreenchange listeners work as they always did.\n149\t  var fullscreenOn = false;\n150\t  if (hub.active && root.Element && root.document) {\n151\t    var asks = function (on) {\n152\t      return function () {\n153\t        post('fullscreen', { on: on });\n154\t        return Promise.resolve();\n155\t      };\n156\t    };\n157\t    var proto = root.Element.prototype;\n158\t    proto.requestFullscreen = proto.webkitRequestFullscreen = asks(true);\n159\t    root.document.exitFullscreen = root.document.webkitExitFullscreen = asks(false);\n160\t    var shown = function () {\n161\t      return fullscreenOn ? root.document.documentElement || null : null;\n162\t    };\n163\t    try {\n164\t      Object.defineProperty(root.document, 'fullscreenElement', { configurable: true, get: shown });\n165\t      Object.defineProperty(root.document, 'webkitFullscreenElement', { configurable: true, get: shown });\n166\t    } catch (e) {}\n167\t  }\n168\t\n169\t  /**\n170\t   * No hub after all: play on, with Math.random the page's own again. The\n171\t   * empty storage stays: the game has read it already, and what it writes\n172\t   * must never land on the player's real saves.\n173\t   */\n174\t  function standAlone() {\n175\t    hub.active = false;\n176\t    if (seededRandom && Math.random === seededRandom) Math.random = realRandom;\n177\t    hub.seeded = false;\n178\t  }\n179\t\n180\t  var origin = '*';\n181\t  var welcomed = false;\n182\t  var ended = false;\n183\t  var connecting = null;\n184\t  var goAt = null;\n185\t  var sentReady = false;\n186\t  var reported = false;\n187\t  var handlers = {};\n188\t  var pending = {};\n189\t  var tokens = limits.burst;\n190\t  var refilled = now();\n191\t  var probeFn = null;\n192\t  var lastProgress = -Infinity;\n193\t  var nextProgress = null;\n194\t  var progressTimer = null;\n195\t\n196\t  function now() {\n197\t    return root.performance && root.performance.now ? root.performance.now() : Date.now();\n198\t  }\n199\t\n200\t  function warn(text) {\n201\t    if (root.console) root.console.warn('[AIHub] ' + text);\n202\t  }\n203\t\n204\t  function own(o, k) {\n205\t    return Object.prototype.hasOwnProperty.call(o, k);\n206\t  }\n207\t\n208\t  /** This client's own fields, which no welcome may overwrite. */\n209\t  var KEEP = { aihub: 1, type: 1, version: 1, protocol: 1, active: 1, seeded: 1 };\n210\t\n211\t  /** A plain JSON copy, or undefined when it is not JSON. */\n212\t  function json(value) {\n213\t    try {\n214\t      var text = JSON.stringify(value);\n215\t      return text === undefined ? undefined : JSON.parse(text);\n216\t    } catch (e) {\n217\t      return undefined;\n218\t    }\n219\t  }\n220\t\n221\t  function post(type, fields) {\n222\t    var msg = { aihub: 1, type: type };\n223\t    for (var key in fields) if (own(fields, key)) msg[key] = fields[key];\n224\t    try {\n225\t      root.parent.postMessage(msg, origin);\n226\t    } catch (e) {\n227\t      warn('could not reach the hub: ' + e.message);\n228\t    }\n229\t  }\n230\t\n231\t  function emit(type, args) {\n232\t    var list = handlers[type];\n233\t    if (!list || !list.length || pending[type]) {\n234\t      (pending[type] = pending[type] || []).push(args);\n235\t      return;\n236\t    }\n237\t    for (var i = 0; i < list.length; i++) {\n238\t      try {\n239\t        list[i].apply(null, args);\n240\t      } catch (e) {\n241\t        setTimeout(function () {\n242\t          throw e;\n243\t        });\n244\t      }\n245\t    }\n246\t  }\n247\t\n248\t  function onMessage(event) {\n249\t    if (event.source !== root.parent) return;\n250\t    var m = event.data;\n251\t    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\n252\t    if (m.type === 'welcome') {\n253\t      if (welcomed) return;\n254\t      welcomed = true;\n255\t      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\n256\t      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\n257\t      for (var key in m) {\n258\t        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\n259\t        hub[key] = m[key];\n260\t      }\n261\t      hub.players = (m.players || []).slice();\n262\t      hub.seed = m.seed >>> 0;\n263\t      hub.isHost = m.me === m.host;\n264\t      hub.splash = m.splash === true;\n265\t      if (m.limits) {\n266\t        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n267\t        tokens = limits.burst;\n268\t      }\n269\t      if (connecting) connecting.resolve(info());\n270\t      return;\n271\t    }\n272\t    if (m.type === 'fullscreen') {\n273\t      fullscreenOn = m.on === true;\n274\t      try {\n275\t        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n276\t      } catch (e) {}\n277\t      return;\n278\t    }\n279\t    if (!welcomed || ended) return;\n280\t    if (m.type === 'start') {\n281\t      goAt = now() + Number(m.in || 0);\n282\t      emit('start', [{ in: Number(m.in || 0) }]);\n283\t    } else if (m.type === 'message') {\n284\t      emit('message', [m.data, m.from]);\n285\t    } else if (m.type === 'leave') {\n286\t      hub.players = hub.players.filter(function (p) {\n287\t        return p.id !== m.id;\n288\t      });\n289\t      emit('leave', [{ id: m.id, reason: m.reason }]);\n290\t    } else if (m.type === 'time-up') {\n291\t      emit('time-up', [{ graceMs: m.graceMs }]);\n292\t    } else if (m.type === 'end') {\n293\t      ended = true;\n294\t      if (progressTimer) clearTimeout(progressTimer);\n295\t      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n296\t    } else {\n297\t      // An event this client has never heard of: hand it on as it came.\n298\t      var detail = {};\n299\t      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n300\t      emit(m.type, [detail]);\n301\t    }\n302\t  }\n303\t\n304\t  function info() {\n305\t    var out = {};\n306\t    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n307\t    out.players = hub.players.slice();\n308\t    return out;\n309\t  }\n310\t\n311\t  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n312\t  hub.connect = function (opts) {\n313\t    if (connecting) return connecting.promise;\n314\t    var done;\n315\t    var promise = new Promise(function (resolve) {\n316\t      done = resolve;\n317\t    });\n318\t    connecting = { promise: promise, resolve: done };\n319\t    if (!hub.active) {\n320\t      done(null);\n321\t      return promise;\n322\t    }\n323\t    opts = opts || {};\n324\t    root.addEventListener('message', onMessage);\n325\t    var started = now();\n326\t    var hello = function () {\n327\t      if (welcomed) return;\n328\t      if (now() - started > HELLO_TIMEOUT_MS) {\n329\t        standAlone();\n330\t        warn('no hub answered; playing normally');\n331\t        done(null);\n332\t        return;\n333\t      }\n334\t      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n335\t      setTimeout(hello, HELLO_EVERY_MS);\n336\t    };\n337\t    hello();\n338\t    return promise;\n339\t  };\n340\t\n341\t  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n342\t  hub.ready = function () {\n343\t    if (!welcomed || sentReady || ended) return;\n344\t    sentReady = true;\n345\t    post('ready', {});\n346\t  };\n347\t\n348\t  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n349\t  hub.answer = function (what) {\n350\t    if (!welcomed || ended || goAt !== null) return;\n351\t    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n352\t    post('answer', { answer: what });\n353\t  };\n354\t\n355\t  hub.on = function (type, fn) {\n356\t    (handlers[type] = handlers[type] || []).push(fn);\n357\t    if (pending[type] && !pending[type].flushing) {\n358\t      pending[type].flushing = true;\n359\t      setTimeout(function () {\n360\t        var queued = pending[type];\n361\t        delete pending[type];\n362\t        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n363\t      });\n364\t    }\n365\t    return function () {\n366\t      var list = handlers[type] || [];\n367\t      var at = list.indexOf(fn);\n368\t      if (at !== -1) list.splice(at, 1);\n369\t    };\n370\t  };\n371\t\n372\t  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n373\t  hub.send = function (data, opts) {\n374\t    if (!welcomed || ended) return false;\n375\t    opts = opts || {};\n376\t    var text;\n377\t    try {\n378\t      text = JSON.stringify(data);\n379\t    } catch (e) {\n380\t      warn('send: data is not JSON');\n381\t      return false;\n382\t    }\n383\t    if (text === undefined) return false;\n384\t    if (text.length > limits.maxBytes) {\n385\t      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n386\t      return false;\n387\t    }\n388\t    var t = now();\n389\t    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n390\t    refilled = t;\n391\t    if (tokens < 1) {\n392\t      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n393\t      return false;\n394\t    }\n395\t    tokens -= 1;\n396\t    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n397\t    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n398\t    post('send', fields);\n399\t    return true;\n400\t  };\n401\t\n402\t  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n403\t  hub.time = function () {\n404\t    return goAt === null ? -Infinity : now() - goAt;\n405\t  };\n406\t\n407\t  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n408\t  hub.rng = function (label) {\n409\t    var h = 2166136261;\n410\t    var s = String(label === undefined ? '' : label);\n411\t    for (var i = 0; i < s.length; i++) {\n412\t      h ^= s.charCodeAt(i);\n413\t      h = Math.imul(h, 16777619);\n414\t    }\n415\t    return generator((hub.seed ^ h) >>> 0);\n416\t  };\n417\t\n418\t  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n419\t  function finite(v) {\n420\t    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n421\t  }\n422\t\n423\t  /**\n424\t   * The whole outcome as plain JSON, field by field: the hub checks and trims\n425\t   * it, so new optional fields need no new client. A field that is not JSON\n426\t   * (a cycle, a BigInt) is left out, not the whole outcome.\n427\t   */\n428\t  function outcomeOf(outcome) {\n429\t    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n430\t      warn('the outcome is not a plain object');\n431\t      return null;\n432\t    }\n433\t    var copy = {};\n434\t    for (var key in outcome) {\n435\t      if (!own(outcome, key)) continue;\n436\t      var value = json(outcome[key]);\n437\t      if (value !== undefined) copy[key] = value;\n438\t      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n439\t    }\n440\t    return copy;\n441\t  }\n442\t\n443\t  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n444\t  hub.result = function (outcome) {\n445\t    if (!welcomed || ended || reported) return;\n446\t    var fields = outcomeOf(outcome);\n447\t    if (!fields) return;\n448\t    var given = outcome || {};\n449\t    delete fields.time;\n450\t    delete fields.score;\n451\t    if (finite(given.time)) fields.time = Number(given.time);\n452\t    if (finite(given.score)) fields.score = Number(given.score);\n453\t    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n454\t    reported = true;\n455\t    if (progressTimer) clearTimeout(progressTimer);\n456\t    post('result', fields);\n457\t  };\n458\t\n459\t  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n460\t  hub.finish = function (outcome) {\n461\t    if (!welcomed || ended || reported) return;\n462\t    if (!hub.isHost) return warn('finish is for the host only');\n463\t    var fields = outcomeOf(outcome);\n464\t    if (!fields) return;\n465\t    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n466\t    reported = true;\n467\t    post('finish', fields);\n468\t  };\n469\t\n470\t  function sendProgress() {\n471\t    progressTimer = null;\n472\t    if (!nextProgress || ended || reported) return;\n473\t    lastProgress = now();\n474\t    post('progress', nextProgress);\n475\t    nextProgress = null;\n476\t  }\n477\t\n478\t  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n479\t  hub.progress = function (p) {\n480\t    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n481\t    nextProgress = { score: Number(p.score) };\n482\t    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n483\t    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n484\t    if (wait <= 0) sendProgress();\n485\t    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n486\t  };\n487\t\n488\t  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n489\t  hub.probe = function (fn) {\n490\t    probeFn = typeof fn === 'function' ? fn : null;\n491\t  };\n492\t\n493\t  hub.inspect = function () {\n494\t    if (!probeFn) return null;\n495\t    try {\n496\t      return JSON.parse(JSON.stringify(probeFn()));\n497\t    } catch (e) {\n498\t      return { error: String((e && e.message) || e) };\n499\t    }\n500\t  };\n501\t\n502\t  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n503\t  hub.fail = function (message) {\n504\t    if (!hub.active) return;\n505\t    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n506\t  };\n507\t\n508\t  root.AIHub = hub;\n509\t})(typeof window !== 'undefined' ? window : globalThis);\n510\t</script>\n511\t</head>\n512\t<body>\n513\t<canvas id=\"c\" aria-label=\"Comet Dash\"></canvas>\n514\t<script>\n515\t'use strict';\n516\t// Comet Dash: the smallest honest ghost game. Every copy runs its own comet\n517\t// down the same course (built from the session seed), sends its comet and the\n518\t// area it is in ten times a second, and draws the others as ghosts while they\n519\t// are in its area. Each copy reports its own progress and result; the hub ranks\n520\t// them.\n521\tconst W = 600, H = 800, LENGTH = 9000, SPEED = 330, R = 14, ROW = 260;\n522\tconst canvas = document.getElementById('c');\n523\tconst ctx = canvas.getContext('2d');\n524\tconst keys = new Set();\n525\tlet pointerX = null;\n526\tlet audio = null;\n527\t\n528\taddEventListener('keydown', (e) => {\n529\t  if (e.key === 'Escape') return toggleMenu();\n530\t  if (menu.open) return menuKey(e.key);\n531\t  keys.add(e.key.toLowerCase());\n532\t  gesture();\n533\t});\n534\taddEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));\n535\t\n536\t// ---- the controller, in the browser's standard mapping (a PS5 DualSense:\n537\t// Cross 0, Circle 1, Create 8, Options 9, D-pad 12-15, left stick axis 0).\n538\t// Buttons count on the frame they go down.\n539\tconst PAD = { cross: 0, circle: 1, create: 8, options: 9, up: 12, down: 13, left: 14, right: 15 };\n540\tlet pad = null, padNow = [], padWas = [];\n541\tfunction readPad() {\n542\t  pad = navigator.getGamepads ? [...navigator.getGamepads()].find((p) => p && p.connected) || null : null;\n543\t  padWas = padNow;\n544\t  padNow = pad ? pad.buttons.map((b) => b.pressed) : [];\n545\t  // Create + Options is the hub's: it opens the hub's corner bar, so Options alone opens the menu.\n546\t  if (pressed(PAD.options) && !padNow[PAD.create]) return toggleMenu();\n547\t  if (menu.open) {\n548\t    if (pressed(PAD.up)) menuKey('ArrowUp');\n549\t    if (pressed(PAD.down)) menuKey('ArrowDown');\n550\t    if (pressed(PAD.cross)) menuKey('Enter');\n551\t    if (pressed(PAD.circle)) toggleMenu();\n552\t  } else if (padNow.some((b, i) => b && !padWas[i] && i !== PAD.create && i !== PAD.options)) gesture();\n553\t}\n554\tconst pressed = (b) => !!padNow[b] && !padWas[b];\n555\t\n556\t// ---- the settings menu: Esc or Options, over the running race. It never\n557\t// pauses anything; while it is open your comet just flies straight.\n558\tlet muted = false;\n559\tconst menu = {\n560\t  open: false,\n561\t  at: 0,\n562\t  items: [\n563\t    { label: () => `Sound: ${muted ? 'off' : 'on'}`, act: () => { muted = !muted; } },\n564\t    { label: () => 'Back to the race', act: () => toggleMenu() },\n565\t  ],\n566\t};\n567\tfunction toggleMenu() { menu.open = !menu.open; menu.at = 0; keys.clear(); }\n568\tfunction menuKey(key) {\n569\t  if (key === 'ArrowUp' || key === 'w') menu.at = (menu.at + menu.items.length - 1) % menu.items.length;\n570\t  if (key === 'ArrowDown' || key === 's') menu.at = (menu.at + 1) % menu.items.length;\n571\t  if (key === 'Enter' || key === ' ') menu.items[menu.at].act();\n572\t}\n573\tcanvas.addEventListener('pointerdown', (e) => { pointerX = e.clientX; gesture(); });\n574\tcanvas.addEventListener('pointermove', (e) => { if (pointerX !== null) pointerX = e.clientX; });\n575\taddEventListener('pointerup', () => { pointerX = null; });\n576\t\n577\tfunction beep(freq) {\n578\t  if (!audio || muted) return;\n579\t  const o = audio.createOscillator(), g = audio.createGain();\n580\t  o.frequency.value = freq; g.gain.value = 0.05;\n581\t  o.connect(g).connect(audio.destination);\n582\t  o.start(); o.stop(audio.currentTime + 0.1);\n583\t}\n584\t\n585\t/** Rocks in rows, the same on every device: built only from integers off the seeded generator. */\n586\tfunction course(rng) {\n587\t  const rocks = [];\n588\t  for (let y = 600; y < LENGTH - 200; y += ROW) {\n589\t    const gaps = 1 + Math.floor(rng() * 2);\n590\t    const lanes = [0, 1, 2, 3, 4];\n591\t    for (let i = 0; i < gaps; i++) lanes.splice(Math.floor(rng() * lanes.length), 1);\n592\t    for (const lane of lanes) if (rng() < 0.7) rocks.push({ x: 60 + lane * 120, y });\n593\t  }\n594\t  return rocks;\n595\t}\n596\t\n597\tconst run = {\n598\t  phase: 'title',     // title | waiting | racing | done | over\n599\t  x: W / 2, d: 0, stun: 0,\n600\t  rocks: course(Math.random),\n601\t  finishedAt: null,\n602\t  message: 'Comet Dash — press any key or tap to race',\n603\t};\n604\tconst ghosts = new Map();   // id -> {x, d, area, name, color, done}\n605\t/** The whole course is one area, so every ghost on it is in view. */\n606\tconst AREA = 'course';\n607\tlet hub = null;\n608\tlet soloStart = 0;\n609\tlet lastSent = 0;\n610\tlet felt = 0;    // the local steering as last read\n611\tlet boost = false;   // Space or Cross held: a little faster\n612\t\n613\tfunction steer() {\n614\t  if (menu.open) return 0;\n615\t  let x = 0;\n616\t  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n617\t  if (keys.has('arrowright') || keys.has('d')) x += 1;\n618\t  if (pad && Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n619\t  if (padNow[PAD.left]) x = -1;\n620\t  if (padNow[PAD.right]) x = 1;\n621\t  if (pointerX !== null) {\n622\t    const r = canvas.getBoundingClientRect();\n623\t    const target = ((pointerX - r.left) / r.width) * W;\n624\t    x = Math.max(-1, Math.min(1, (target - run.x) / 40));\n625\t  }\n626\t  return x;\n627\t}\n628\t\n629\tasync function connect() {\n630\t  const info = await AIHub.connect({ mode: 'ghost', seats: [2, 4] });\n631\t  if (!info) return;\n632\t  hub = info;\n633\t  run.rocks = course(AIHub.rng('course'));\n634\t  for (const p of info.players) if (p.id !== info.me) ghosts.set(p.id, { ...p, x: W / 2, d: 0, done: null });\n635\t  // The hub's card collects everyone's ready: ready up as soon as the course is built.\n636\t  run.phase = 'waiting';\n637\t  run.message = 'Get ready…';\n638\t  AIHub.ready();\n639\t  AIHub.on('start', () => { run.phase = 'racing'; unlockAudio(); });\n640\t  AIHub.on('message', (data, from) => {\n641\t    const g = ghosts.get(from);\n642\t    if (!g) return;\n643\t    if (data.t === 'g') { g.tx = data.x; g.td = data.d; g.area = data.area; }\n644\t    if (data.t === 'done') { g.done = data.time; beep(330); }\n645\t  });\n646\t  AIHub.on('leave', ({ id }) => ghosts.delete(id));\n647\t  AIHub.on('time-up', () => {\n648\t    if (run.phase === 'racing') AIHub.result({ score: Math.floor(run.d) });\n649\t  });\n650\t  AIHub.on('end', ({ reason, standings }) => {\n651\t    run.phase = 'over';\n652\t    run.standings = standings;\n653\t    run.message = reason === 'finished' ? 'Race over' : reason === 'sat-out' ? 'You sat this one out' : 'Race cancelled';\n654\t  });\n655\t}\n656\t\n657\tfunction unlockAudio() {\n658\t  if (!audio) {\n659\t    try { audio = new AudioContext(); } catch { audio = null; }\n660\t  }\n661\t  audio?.resume?.().catch(() => {});\n662\t}\n663\t\n664\tfunction gesture() {\n665\t  unlockAudio();\n666\t  if (!hub && (run.phase === 'title' || run.phase === 'over')) {\n667\t    Object.assign(run, { phase: 'racing', x: W / 2, d: 0, stun: 0, rocks: course(Math.random), finishedAt: null });\n668\t    soloStart = performance.now();\n669\t  }\n670\t}\n671\t\n672\t/** Race time: the hub's shared clock in a session, the local one alone. */\n673\tconst raceTime = () => (hub ? AIHub.time() : performance.now() - soloStart);\n674\t\n675\tlet last = performance.now();\n676\tfunction frame(now) {\n677\t  const dt = Math.min((now - last) / 1000, 0.25);\n678\t  last = now;\n679\t  readPad();\n680\t  felt = steer();\n681\t  boost = !menu.open && (keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7]);\n682\t  if (run.phase === 'racing' && raceTime() >= 0) {\n683\t    run.x = Math.max(R + 20, Math.min(W - R - 20, run.x + felt * 320 * dt));\n684\t    if (run.stun > 0) run.stun -= dt;\n685\t    else run.d += SPEED * (boost ? 1.3 : 1) * dt;\n686\t    for (const rock of run.rocks) {\n687\t      if (Math.abs(rock.y - run.d) < 18 && Math.abs(rock.x - run.x) < 40 && run.stun <= 0) {\n688\t        run.stun = 0.7; run.d -= 20; beep(140);\n689\t      }\n690\t    }\n691\t    if (run.d >= LENGTH) {\n692\t      run.d = LENGTH;\n693\t      run.finishedAt = Math.round(raceTime());\n694\t      run.phase = 'done';\n695\t      run.message = `Finished in ${(run.finishedAt / 1000).toFixed(2)} s`;\n696\t      beep(880);\n697\t      if (hub) {\n698\t        AIHub.result({ time: run.finishedAt });\n699\t        AIHub.send({ t: 'done', time: run.finishedAt });\n700\t        run.message += ' — waiting for the others';\n701\t      }\n702\t    }\n703\t  }\n704\t  if (hub && (run.phase === 'racing' || run.phase === 'done') && now - lastSent > 100) {\n705\t    lastSent = now;\n706\t    AIHub.send({ t: 'g', area: AREA, x: Math.round(run.x), d: Math.round(run.d) }, { reliable: false });\n707\t    if (run.phase === 'racing') AIHub.progress({ score: Math.round(run.d), label: `${Math.round((run.d / LENGTH) * 100)}% of the course` });\n708\t  }\n709\t  for (const g of ghosts.values()) if (g.tx !== undefined) {\n710\t    const k = 1 - Math.pow(0.002, dt);\n711\t    g.x += (g.tx - g.x) * k; g.d += (g.td - g.d) * k;\n712\t  }\n713\t  draw();\n714\t  requestAnimationFrame(frame);\n715\t}\n716\t\n717\tfunction draw() {\n718\t  const r = canvas.getBoundingClientRect();\n719\t  const dpr = devicePixelRatio || 1;\n720\t  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n721\t    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n722\t  }\n723\t  const s = Math.min(canvas.width / W, canvas.height / H);\n724\t  ctx.setTransform(1, 0, 0, 1, 0, 0);\n725\t  ctx.fillStyle = '#081120'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n726\t  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n727\t  ctx.fillStyle = '#0f1b2e'; ctx.fillRect(0, 0, W, H);\n728\t\n729\t  const screenY = (d) => H - 160 - (d - run.d);\n730\t  ctx.fillStyle = '#5b6b86';\n731\t  for (const rock of run.rocks) {\n732\t    const y = screenY(rock.y);\n733\t    if (y > -40 && y < H + 40) ctx.fillRect(rock.x - 34, y - 12, 68, 24);\n734\t  }\n735\t  const fy = screenY(LENGTH);\n736\t  if (fy > -10 && fy < H) { ctx.fillStyle = '#eef3fb'; ctx.fillRect(0, fy - 3, W, 6); }\n737\t\n738\t  ctx.textAlign = 'center';\n739\t  ctx.font = '13px system-ui';\n740\t  for (const g of ghosts.values()) {\n741\t    if (g.area !== AREA) continue;\n742\t    const y = screenY(g.d);\n743\t    ctx.globalAlpha = 0.45;\n744\t    ctx.fillStyle = g.color;\n745\t    ctx.beginPath(); ctx.arc(g.x, Math.max(20, Math.min(H - 20, y)), R, 0, Math.PI * 2); ctx.fill();\n746\t    ctx.globalAlpha = 1;\n747\t    ctx.fillText(g.name, g.x, Math.max(20, Math.min(H - 20, y)) - R - 6);\n748\t  }\n749\t  const mine = hub ? hub.players.find((p) => p.id === hub.me) : null;\n750\t  ctx.fillStyle = run.stun > 0 ? '#ffffff' : (mine?.color || '#f5b700');\n751\t  ctx.beginPath(); ctx.arc(run.x, H - 160, R, 0, Math.PI * 2); ctx.fill();\n752\t\n753\t  // progress strip: everyone's distance down the course\n754\t  const bar = (d, color) => { ctx.fillStyle = color; ctx.fillRect(W - 14, H - 20 - (H - 40) * Math.min(1, d / LENGTH), 10, 4); };\n755\t  ctx.fillStyle = '#1d2c45'; ctx.fillRect(W - 14, 20, 10, H - 40);\n756\t  for (const g of ghosts.values()) bar(g.d, g.color);\n757\t  bar(run.d, mine?.color || '#f5b700');\n758\t\n759\t  ctx.fillStyle = '#eef3fb';\n760\t  ctx.font = '20px system-ui';\n761\t  if (run.phase === 'racing') {\n762\t    const t = raceTime();\n763\t    if (t < 0) { ctx.font = 'bold 96px system-ui'; ctx.fillText(String(Math.ceil(-t / 1000)), W / 2, H / 2); }\n764\t    else ctx.fillText(`${(t / 1000).toFixed(1)} s`, W / 2, 34);\n765\t  } else {\n766\t    ctx.fillStyle = 'rgba(0,0,0,.6)'; ctx.fillRect(0, H / 2 - 130, W, 260);\n767\t    ctx.fillStyle = '#eef3fb';\n768\t    ctx.fillText(run.message, W / 2, H / 2 - 80);\n769\t    if (run.standings && hub) {\n770\t      ctx.font = '18px system-ui';\n771\t      let row = 0;\n772\t      run.standings.forEach((ids, place) => ids.forEach((id) => {\n773\t        const p = hub.players.find((q) => q.id === id) || { name: `Player ${id + 1}`, color: '#eef3fb' };\n774\t        ctx.fillStyle = p.color;\n775\t        ctx.fillText(`${place + 1}. ${p.name}${id === hub.me ? ' (you)' : ''}`, W / 2, H / 2 - 40 + row++ * 28);\n776\t      }));\n777\t    }\n778\t  }\n779\t  if (menu.open) drawMenu();\n780\t}\n781\t\n782\tfunction drawMenu() {\n783\t  ctx.fillStyle = 'rgba(4,10,20,.85)'; ctx.fillRect(W / 2 - 160, 250, 320, 70 + menu.items.length * 40);\n784\t  ctx.textAlign = 'center';\n785\t  ctx.fillStyle = '#eef3fb'; ctx.font = 'bold 22px system-ui';\n786\t  ctx.fillText('Settings', W / 2, 286);\n787\t  ctx.font = '18px system-ui';\n788\t  menu.items.forEach((item, i) => {\n789\t    ctx.fillStyle = i === menu.at ? '#ffd34d' : '#eef3fb';\n790\t    ctx.fillText(`${i === menu.at ? '▸ ' : ''}${item.label()}`, W / 2, 326 + i * 40);\n791\t  });\n792\t}\n793\t\n794\tconnect();\n795\trequestAnimationFrame(frame);\n796\t</script>\n797\t</body>\n798\t</html>\n799\t"}]},"parent_tool_use_id":null,"session_id":"c21bae92-846f-4b71-8d0d-098b4791d47c","uuid":"b151a44c-c2b9-42a5-8409-383f3c91bb13","timestamp":"2026-11-05T04:27:17.588Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211853__x57f432/work/_research/engine/_research/hub/lib/hub/examples/ghost.html","content":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Comet Dash — AI Hub session example (ghost)</title>\n<meta name=\"description\" content=\"A minimal ghost game for the AI Hub Session Protocol: everyone runs the same seeded course on their own device and sees the others as ghosts.\">\n<meta name=\"theme-color\" content=\"#0f1b2e\">\n<meta name=\"hub:type\" content=\"Tech demo\">\n<meta name=\"hub:players\" content=\"1\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"2-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-minutes\" content=\"1\">\n<meta name=\"hub:session-goal\" content=\"Fastest to the end of the course wins\">\n<meta name=\"hub:session-howto\" content=\"Steer: ← →, A D or a stick · boost: Space or Cross · or drag a finger\">\n<style>\n  html, body { margin: 0; height: 100%; background: #0f1b2e; color: #eef3fb; font: 16px system-ui, sans-serif; overflow: hidden; }\n  canvas { display: block; width: 100%; height: 100%; touch-action: none; }\n</style>\n<script>\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n    var api = {\n      getItem: function (k) {\n        k = String(k);\n        return k in data ? data[k] : null;\n      },\n      setItem: function (k, v) {\n        data[String(k)] = String(v);\n      },\n      removeItem: function (k) {\n        delete data[String(k)];\n      },\n      clear: function () {\n        for (var k in data) delete data[k];\n      },\n      key: function (i) {\n        var keys = Object.keys(data);\n        return i >= 0 && i < keys.length ? keys[i] : null;\n      },\n    };\n    if (typeof Proxy !== 'function') return api;\n    return new Proxy(api, {\n      get: function (t, k) {\n        if (k === 'length') return Object.keys(data).length;\n        if (typeof k === 'symbol' || k in t) return t[k];\n        return k in data ? data[k] : undefined;\n      },\n      set: function (t, k, v) {\n        if (typeof k !== 'symbol') data[k] = String(v);\n        return true;\n      },\n      has: function (t, k) {\n        return k in data || k in t;\n      },\n      deleteProperty: function (t, k) {\n        delete data[k];\n        return true;\n      },\n      ownKeys: function () {\n        return Object.keys(data);\n      },\n      getOwnPropertyDescriptor: function (t, k) {\n        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n      },\n    });\n  }\n\n  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n  function generator(a) {\n    return function () {\n      a = (a + 0x6d2b79f5) >>> 0;\n      var t = a;\n      t = Math.imul(t ^ (t >>> 15), t | 1);\n      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n\n  // A fair start: in a session the game gets an empty storage of its own, so\n  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n  // and nothing the round saves touches the player's own saves.\n  if (hub.active) {\n    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n      try {\n        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n      } catch (e) {\n        warn('could not give the game a fresh ' + stores[s]);\n      }\n    }\n  }\n\n  // Side by side: before any of the game's own scripts run, Math.random becomes\n  // a generator seeded by the hub, so every copy builds the same start.\n  var realRandom = Math.random;\n  var seededRandom = null;\n  if (hub.active && seedArg) {\n    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n    hub.seeded = true;\n  }\n\n  // In a session the hub owns fullscreen: a game that asks for it gets the\n  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n  // hub says when its page goes in and out, so the game's own toggle and its\n  // fullscreenchange listeners work as they always did.\n  var fullscreenOn = false;\n  if (hub.active && root.Element && root.document) {\n    var asks = function (on) {\n      return function () {\n        post('fullscreen', { on: on });\n        return Promise.resolve();\n      };\n    };\n    var proto = root.Element.prototype;\n    proto.requestFullscreen = proto.webkitRequestFullscreen = asks(true);\n    root.document.exitFullscreen = root.document.webkitExitFullscreen = asks(false);\n    var shown = function () {\n      return fullscreenOn ? root.document.documentElement || null : null;\n    };\n    try {\n      Object.defineProperty(root.document, 'fullscreenElement', { configurable: true, get: shown });\n      Object.defineProperty(root.document, 'webkitFullscreenElement', { configurable: true, get: shown });\n    } catch (e) {}\n  }\n\n  /**\n   * No hub after all: play on, with Math.random the page's own again. The\n   * empty storage stays: the game has read it already, and what it writes\n   * must never land on the player's real saves.\n   */\n  function standAlone() {\n    hub.active = false;\n    if (seededRandom && Math.random === seededRandom) Math.random = realRandom;\n    hub.seeded = false;\n  }\n\n  var origin = '*';\n  var welcomed = false;\n  var ended = false;\n  var connecting = null;\n  var goAt = null;\n  var sentReady = false;\n  var reported = false;\n  var handlers = {};\n  var pending = {};\n  var tokens = limits.burst;\n  var refilled = now();\n  var probeFn = null;\n  var lastProgress = -Infinity;\n  var nextProgress = null;\n  var progressTimer = null;\n\n  function now() {\n    return root.performance && root.performance.now ? root.performance.now() : Date.now();\n  }\n\n  function warn(text) {\n    if (root.console) root.console.warn('[AIHub] ' + text);\n  }\n\n  function own(o, k) {\n    return Object.prototype.hasOwnProperty.call(o, k);\n  }\n\n  /** This client's own fields, which no welcome may overwrite. */\n  var KEEP = { aihub: 1, type: 1, version: 1, protocol: 1, active: 1, seeded: 1 };\n\n  /** A plain JSON copy, or undefined when it is not JSON. */\n  function json(value) {\n    try {\n      var text = JSON.stringify(value);\n      return text === undefined ? undefined : JSON.parse(text);\n    } catch (e) {\n      return undefined;\n    }\n  }\n\n  function post(type, fields) {\n    var msg = { aihub: 1, type: type };\n    for (var key in fields) if (own(fields, key)) msg[key] = fields[key];\n    try {\n      root.parent.postMessage(msg, origin);\n    } catch (e) {\n      warn('could not reach the hub: ' + e.message);\n    }\n  }\n\n  function emit(type, args) {\n    var list = handlers[type];\n    if (!list || !list.length || pending[type]) {\n      (pending[type] = pending[type] || []).push(args);\n      return;\n    }\n    for (var i = 0; i < list.length; i++) {\n      try {\n        list[i].apply(null, args);\n      } catch (e) {\n        setTimeout(function () {\n          throw e;\n        });\n      }\n    }\n  }\n\n  function onMessage(event) {\n    if (event.source !== root.parent) return;\n    var m = event.data;\n    if (!m || m.aihub !== 1 || typeof m.type !== 'string') return;\n    if (m.type === 'welcome') {\n      if (welcomed) return;\n      welcomed = true;\n      origin = event.origin && event.origin !== 'null' ? event.origin : '*';\n      // Every field the hub sends is kept, so a newer hub can add one without a newer client.\n      for (var key in m) {\n        if (!own(m, key) || KEEP[key] || typeof hub[key] === 'function') continue;\n        hub[key] = m[key];\n      }\n      hub.players = (m.players || []).slice();\n      hub.seed = m.seed >>> 0;\n      hub.isHost = m.me === m.host;\n      hub.splash = m.splash === true;\n      if (m.limits) {\n        for (var l in limits) if (own(limits, l) && Number(m.limits[l]) > 0) limits[l] = Number(m.limits[l]);\n        tokens = limits.burst;\n      }\n      if (connecting) connecting.resolve(info());\n      return;\n    }\n    if (m.type === 'fullscreen') {\n      fullscreenOn = m.on === true;\n      try {\n        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n      } catch (e) {}\n      return;\n    }\n    if (!welcomed || ended) return;\n    if (m.type === 'start') {\n      goAt = now() + Number(m.in || 0);\n      emit('start', [{ in: Number(m.in || 0) }]);\n    } else if (m.type === 'message') {\n      emit('message', [m.data, m.from]);\n    } else if (m.type === 'leave') {\n      hub.players = hub.players.filter(function (p) {\n        return p.id !== m.id;\n      });\n      emit('leave', [{ id: m.id, reason: m.reason }]);\n    } else if (m.type === 'time-up') {\n      emit('time-up', [{ graceMs: m.graceMs }]);\n    } else if (m.type === 'end') {\n      ended = true;\n      if (progressTimer) clearTimeout(progressTimer);\n      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n    } else {\n      // An event this client has never heard of: hand it on as it came.\n      var detail = {};\n      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n      emit(m.type, [detail]);\n    }\n  }\n\n  function info() {\n    var out = {};\n    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n    out.players = hub.players.slice();\n    return out;\n  }\n\n  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n  hub.connect = function (opts) {\n    if (connecting) return connecting.promise;\n    var done;\n    var promise = new Promise(function (resolve) {\n      done = resolve;\n    });\n    connecting = { promise: promise, resolve: done };\n    if (!hub.active) {\n      done(null);\n      return promise;\n    }\n    opts = opts || {};\n    root.addEventListener('message', onMessage);\n    var started = now();\n    var hello = function () {\n      if (welcomed) return;\n      if (now() - started > HELLO_TIMEOUT_MS) {\n        standAlone();\n        warn('no hub answered; playing normally');\n        done(null);\n        return;\n      }\n      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n      setTimeout(hello, HELLO_EVERY_MS);\n    };\n    hello();\n    return promise;\n  };\n\n  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n  hub.ready = function () {\n    if (!welcomed || sentReady || ended) return;\n    sentReady = true;\n    post('ready', {});\n  };\n\n  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n  hub.answer = function (what) {\n    if (!welcomed || ended || goAt !== null) return;\n    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n    post('answer', { answer: what });\n  };\n\n  hub.on = function (type, fn) {\n    (handlers[type] = handlers[type] || []).push(fn);\n    if (pending[type] && !pending[type].flushing) {\n      pending[type].flushing = true;\n      setTimeout(function () {\n        var queued = pending[type];\n        delete pending[type];\n        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n      });\n    }\n    return function () {\n      var list = handlers[type] || [];\n      var at = list.indexOf(fn);\n      if (at !== -1) list.splice(at, 1);\n    };\n  };\n\n  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n  hub.send = function (data, opts) {\n    if (!welcomed || ended) return false;\n    opts = opts || {};\n    var text;\n    try {\n      text = JSON.stringify(data);\n    } catch (e) {\n      warn('send: data is not JSON');\n      return false;\n    }\n    if (text === undefined) return false;\n    if (text.length > limits.maxBytes) {\n      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n      return false;\n    }\n    var t = now();\n    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n    refilled = t;\n    if (tokens < 1) {\n      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n      return false;\n    }\n    tokens -= 1;\n    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n    post('send', fields);\n    return true;\n  };\n\n  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n  hub.time = function () {\n    return goAt === null ? -Infinity : now() - goAt;\n  };\n\n  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n  hub.rng = function (label) {\n    var h = 2166136261;\n    var s = String(label === undefined ? '' : label);\n    for (var i = 0; i < s.length; i++) {\n      h ^= s.charCodeAt(i);\n      h = Math.imul(h, 16777619);\n    }\n    return generator((hub.seed ^ h) >>> 0);\n  };\n\n  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n  function finite(v) {\n    return (typeof v === 'number' || (typeof v === 'string' && v.trim() !== '')) && isFinite(v);\n  }\n\n  /**\n   * The whole outcome as plain JSON, field by field: the hub checks and trims\n   * it, so new optional fields need no new client. A field that is not JSON\n   * (a cycle, a BigInt) is left out, not the whole outcome.\n   */\n  function outcomeOf(outcome) {\n    if (!outcome || typeof outcome !== 'object' || Array.isArray(outcome)) {\n      warn('the outcome is not a plain object');\n      return null;\n    }\n    var copy = {};\n    for (var key in outcome) {\n      if (!own(outcome, key)) continue;\n      var value = json(outcome[key]);\n      if (value !== undefined) copy[key] = value;\n      else if (outcome[key] !== undefined) warn('the outcome\\'s ' + key + ' is not JSON: left out');\n    }\n    return copy;\n  }\n\n  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n  hub.result = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    var given = outcome || {};\n    delete fields.time;\n    delete fields.score;\n    if (finite(given.time)) fields.time = Number(given.time);\n    if (finite(given.score)) fields.score = Number(given.score);\n    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n    reported = true;\n    if (progressTimer) clearTimeout(progressTimer);\n    post('result', fields);\n  };\n\n  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n  hub.finish = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    if (!hub.isHost) return warn('finish is for the host only');\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n    reported = true;\n    post('finish', fields);\n  };\n\n  function sendProgress() {\n    progressTimer = null;\n    if (!nextProgress || ended || reported) return;\n    lastProgress = now();\n    post('progress', nextProgress);\n    nextProgress = null;\n  }\n\n  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n  hub.progress = function (p) {\n    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n    nextProgress = { score: Number(p.score) };\n    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n    if (wait <= 0) sendProgress();\n    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n  };\n\n  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n  hub.probe = function (fn) {\n    probeFn = typeof fn === 'function' ? fn : null;\n  };\n\n  hub.inspect = function () {\n    if (!probeFn) return null;\n    try {\n      return JSON.parse(JSON.stringify(probeFn()));\n    } catch (e) {\n      return { error: String((e && e.message) || e) };\n    }\n  };\n\n  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n  hub.fail = function (message) {\n    if (!hub.active) return;\n    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n  };\n\n  root.AIHub = hub;\n})(typeof window !== 'undefined' ? window : globalThis);\n</script>\n</head>\n<body>\n<canvas id=\"c\" aria-label=\"Comet Dash\"></canvas>\n<script>\n'use strict';\n// Comet Dash: the smallest honest ghost game. Every copy runs its own comet\n// down the same course (built from the session seed), sends its comet and the\n// area it is in ten times a second, and draws the others as ghosts while they\n// are in its area. Each copy reports its own progress and result; the hub ranks\n// them.\nconst W = 600, H = 800, LENGTH = 9000, SPEED = 330, R = 14, ROW = 260;\nconst canvas = document.getElementById('c');\nconst ctx = canvas.getContext('2d');\nconst keys = new Set();\nlet pointerX = null;\nlet audio = null;\n\naddEventListener('keydown', (e) => {\n  if (e.key === 'Escape') return toggleMenu();\n  if (menu.open) return menuKey(e.key);\n  keys.add(e.key.toLowerCase());\n  gesture();\n});\naddEventListener('keyup', (e) => keys.delete(e.key.toLowerCase()));\n\n// ---- the controller, in the browser's standard mapping (a PS5 DualSense:\n// Cross 0, Circle 1, Create 8, Options 9, D-pad 12-15, left stick axis 0).\n// Buttons count on the frame they go down.\nconst PAD = { cross: 0, circle: 1, create: 8, options: 9, up: 12, down: 13, left: 14, right: 15 };\nlet pad = null, padNow = [], padWas = [];\nfunction readPad() {\n  pad = navigator.getGamepads ? [...navigator.getGamepads()].find((p) => p && p.connected) || null : null;\n  padWas = padNow;\n  padNow = pad ? pad.buttons.map((b) => b.pressed) : [];\n  // Create + Options is the hub's: it opens the hub's corner bar, so Options alone opens the menu.\n  if (pressed(PAD.options) && !padNow[PAD.create]) return toggleMenu();\n  if (menu.open) {\n    if (pressed(PAD.up)) menuKey('ArrowUp');\n    if (pressed(PAD.down)) menuKey('ArrowDown');\n    if (pressed(PAD.cross)) menuKey('Enter');\n    if (pressed(PAD.circle)) toggleMenu();\n  } else if (padNow.some((b, i) => b && !padWas[i] && i !== PAD.create && i !== PAD.options)) gesture();\n}\nconst pressed = (b) => !!padNow[b] && !padWas[b];\n\n// ---- the settings menu: Esc or Options, over the running race. It never\n// pauses anything; while it is open your comet just flies straight.\nlet muted = false;\nconst menu = {\n  open: false,\n  at: 0,\n  items: [\n    { label: () => `Sound: ${muted ? 'off' : 'on'}`, act: () => { muted = !muted; } },\n    { label: () => 'Back to the race', act: () => toggleMenu() },\n  ],\n};\nfunction toggleMenu() { menu.open = !menu.open; menu.at = 0; keys.clear(); }\nfunction menuKey(key) {\n  if (key === 'ArrowUp' || key === 'w') menu.at = (menu.at + menu.items.length - 1) % menu.items.length;\n  if (key === 'ArrowDown' || key === 's') menu.at = (menu.at + 1) % menu.items.length;\n  if (key === 'Enter' || key === ' ') menu.items[menu.at].act();\n}\ncanvas.addEventListener('pointerdown', (e) => { pointerX = e.clientX; gesture(); });\ncanvas.addEventListener('pointermove', (e) => { if (pointerX !== null) pointerX = e.clientX; });\naddEventListener('pointerup', () => { pointerX = null; });\n\nfunction beep(freq) {\n  if (!audio || muted) return;\n  const o = audio.createOscillator(), g = audio.createGain();\n  o.frequency.value = freq; g.gain.value = 0.05;\n  o.connect(g).connect(audio.destination);\n  o.start(); o.stop(audio.currentTime + 0.1);\n}\n\n/** Rocks in rows, the same on every device: built only from integers off the seeded generator. */\nfunction course(rng) {\n  const rocks = [];\n  for (let y = 600; y < LENGTH - 200; y += ROW) {\n    const gaps = 1 + Math.floor(rng() * 2);\n    const lanes = [0, 1, 2, 3, 4];\n    for (let i = 0; i < gaps; i++) lanes.splice(Math.floor(rng() * lanes.length), 1);\n    for (const lane of lanes) if (rng() < 0.7) rocks.push({ x: 60 + lane * 120, y });\n  }\n  return rocks;\n}\n\nconst run = {\n  phase: 'title',     // title | waiting | racing | done | over\n  x: W / 2, d: 0, stun: 0,\n  rocks: course(Math.random),\n  finishedAt: null,\n  message: 'Comet Dash — press any key or tap to race',\n};\nconst ghosts = new Map();   // id -> {x, d, area, name, color, done}\n/** The whole course is one area, so every ghost on it is in view. */\nconst AREA = 'course';\nlet hub = null;\nlet soloStart = 0;\nlet lastSent = 0;\nlet felt = 0;    // the local steering as last read\nlet boost = false;   // Space or Cross held: a little faster\n\nfunction steer() {\n  if (menu.open) return 0;\n  let x = 0;\n  if (keys.has('arrowleft') || keys.has('a')) x -= 1;\n  if (keys.has('arrowright') || keys.has('d')) x += 1;\n  if (pad && Math.abs(pad.axes[0]) > 0.2) x = pad.axes[0];\n  if (padNow[PAD.left]) x = -1;\n  if (padNow[PAD.right]) x = 1;\n  if (pointerX !== null) {\n    const r = canvas.getBoundingClientRect();\n    const target = ((pointerX - r.left) / r.width) * W;\n    x = Math.max(-1, Math.min(1, (target - run.x) / 40));\n  }\n  return x;\n}\n\nasync function connect() {\n  const info = await AIHub.connect({ mode: 'ghost', seats: [2, 4] });\n  if (!info) return;\n  hub = info;\n  run.rocks = course(AIHub.rng('course'));\n  for (const p of info.players) if (p.id !== info.me) ghosts.set(p.id, { ...p, x: W / 2, d: 0, done: null });\n  // The hub's card collects everyone's ready: ready up as soon as the course is built.\n  run.phase = 'waiting';\n  run.message = 'Get ready…';\n  AIHub.ready();\n  AIHub.on('start', () => { run.phase = 'racing'; unlockAudio(); });\n  AIHub.on('message', (data, from) => {\n    const g = ghosts.get(from);\n    if (!g) return;\n    if (data.t === 'g') { g.tx = data.x; g.td = data.d; g.area = data.area; }\n    if (data.t === 'done') { g.done = data.time; beep(330); }\n  });\n  AIHub.on('leave', ({ id }) => ghosts.delete(id));\n  AIHub.on('time-up', () => {\n    if (run.phase === 'racing') AIHub.result({ score: Math.floor(run.d) });\n  });\n  AIHub.on('end', ({ reason, standings }) => {\n    run.phase = 'over';\n    run.standings = standings;\n    run.message = reason === 'finished' ? 'Race over' : reason === 'sat-out' ? 'You sat this one out' : 'Race cancelled';\n  });\n}\n\nfunction unlockAudio() {\n  if (!audio) {\n    try { audio = new AudioContext(); } catch { audio = null; }\n  }\n  audio?.resume?.().catch(() => {});\n}\n\nfunction gesture() {\n  unlockAudio();\n  if (!hub && (run.phase === 'title' || run.phase === 'over')) {\n    Object.assign(run, { phase: 'racing', x: W / 2, d: 0, stun: 0, rocks: course(Math.random), finishedAt: null });\n    soloStart = performance.now();\n  }\n}\n\n/** Race time: the hub's shared clock in a session, the local one alone. */\nconst raceTime = () => (hub ? AIHub.time() : performance.now() - soloStart);\n\nlet last = performance.now();\nfunction frame(now) {\n  const dt = Math.min((now - last) / 1000, 0.25);\n  last = now;\n  readPad();\n  felt = steer();\n  boost = !menu.open && (keys.has(' ') || !!padNow[PAD.cross] || !!padNow[7]);\n  if (run.phase === 'racing' && raceTime() >= 0) {\n    run.x = Math.max(R + 20, Math.min(W - R - 20, run.x + felt * 320 * dt));\n    if (run.stun > 0) run.stun -= dt;\n    else run.d += SPEED * (boost ? 1.3 : 1) * dt;\n    for (const rock of run.rocks) {\n      if (Math.abs(rock.y - run.d) < 18 && Math.abs(rock.x - run.x) < 40 && run.stun <= 0) {\n        run.stun = 0.7; run.d -= 20; beep(140);\n      }\n    }\n    if (run.d >= LENGTH) {\n      run.d = LENGTH;\n      run.finishedAt = Math.round(raceTime());\n      run.phase = 'done';\n      run.message = `Finished in ${(run.finishedAt / 1000).toFixed(2)} s`;\n      beep(880);\n      if (hub) {\n        AIHub.result({ time: run.finishedAt });\n        AIHub.send({ t: 'done', time: run.finishedAt });\n        run.message += ' — waiting for the others';\n      }\n    }\n  }\n  if (hub && (run.phase === 'racing' || run.phase === 'done') && now - lastSent > 100) {\n    lastSent = now;\n    AIHub.send({ t: 'g', area: AREA, x: Math.round(run.x), d: Math.round(run.d) }, { reliable: false });\n    if (run.phase === 'racing') AIHub.progress({ score: Math.round(run.d), label: `${Math.round((run.d / LENGTH) * 100)}% of the course` });\n  }\n  for (const g of ghosts.values()) if (g.tx !== undefined) {\n    const k = 1 - Math.pow(0.002, dt);\n    g.x += (g.tx - g.x) * k; g.d += (g.td - g.d) * k;\n  }\n  draw();\n  requestAnimationFrame(frame);\n}\n\nfunction draw() {\n  const r = canvas.getBoundingClientRect();\n  const dpr = devicePixelRatio || 1;\n  if (canvas.width !== Math.round(r.width * dpr) || canvas.height !== Math.round(r.height * dpr)) {\n    canvas.width = Math.round(r.width * dpr); canvas.height = Math.round(r.height * dpr);\n  }\n  const s = Math.min(canvas.width / W, canvas.height / H);\n  ctx.setTransform(1, 0, 0, 1, 0, 0);\n  ctx.fillStyle = '#081120'; ctx.fillRect(0, 0, canvas.width, canvas.height);\n  ctx.setTransform(s, 0, 0, s, (canvas.width - W * s) / 2, (canvas.height - H * s) / 2);\n  ctx.fillStyle = '#0f1b2e'; ctx.fillRect(0, 0, W, H);\n\n  const screenY = (d) => H - 160 - (d - run.d);\n  ctx.fillStyle = '#5b6b86';\n  for (const rock of run.rocks) {\n    const y = screenY(rock.y);\n    if (y > -40 && y < H + 40) ctx.fillRect(rock.x - 34, y - 12, 68, 24);\n  }\n  const fy = screenY(LENGTH);\n  if (fy > -10 && fy < H) { ctx.fillStyle = '#eef3fb'; ctx.fillRect(0, fy - 3, W, 6); }\n\n  ctx.textAlign = 'center';\n  ctx.font = '13px system-ui';\n  for (const g of ghosts.values()) {\n    if (g.area !== AREA) continue;\n    const y = screenY(g.d);\n    ctx.globalAlpha = 0.45;\n    ctx.fillStyle = g.color;\n    ctx.beginPath(); ctx.arc(g.x, Math.max(20, Math.min(H - 20, y)), R, 0, Math.PI * 2); ctx.fill();\n    ctx.globalAlpha = 1;\n    ctx.fillText(g.name, g.x, Math.max(20, Math.min(H - 20, y)) - R - 6);\n  }\n  const mine = hub ? hub.players.find((p) => p.id === hub.me) : null;\n  ctx.fillStyle = run.stun > 0 ? '#ffffff' : (mine?.color || '#f5b700');\n  ctx.beginPath(); ctx.arc(run.x, H - 160, R, 0, Math.PI * 2); ctx.fill();\n\n  // progress strip: everyone's distance down the course\n  const bar = (d, color) => { ctx.fillStyle = color; ctx.fillRect(W - 14, H - 20 - (H - 40) * Math.min(1, d / LENGTH), 10, 4); };\n  ctx.fillStyle = '#1d2c45'; ctx.fillRect(W - 14, 20, 10, H - 40);\n  for (const g of ghosts.values()) bar(g.d, g.color);\n  bar(run.d, mine?.color || '#f5b700');\n\n  ctx.fillStyle = '#eef3fb';\n  ctx.font = '20px system-ui';\n  if (run.phase === 'racing') {\n    const t = raceTime();\n    if (t < 0) { ctx.font = 'bold 96px system-ui'; ctx.fillText(String(Math.ceil(-t / 1000)), W / 2, H / 2); }\n    else ctx.fillText(`${(t / 1000).toFixed(1)} s`, W / 2, 34);\n  } else {\n    ctx.fillStyle = 'rgba(0,0,0,.6)'; ctx.fillRect(0, H / 2 - 130, W, 260);\n    ctx.fillStyle = '#eef3fb';\n    ctx.fillText(run.message, W / 2, H / 2 - 80);\n    if (run.standings && hub) {\n      ctx.font = '18px system-ui';\n      let row = 0;\n      run.standings.forEach((ids, place) => ids.forEach((id) => {\n        const p = hub.players.find((q) => q.id === id) || { name: `Player ${id + 1}`, color: '#eef3fb' };\n        ctx.fillStyle = p.color;\n        ctx.fillText(`${place + 1}. ${p.name}${id === hub.me ? ' (you)' : ''}`, W / 2, H / 2 - 40 + row++ * 28);\n      }));\n    }\n  }\n  if (menu.open) drawMenu();\n}\n\nfunction drawMenu() {\n  ctx.fillStyle = 'rgba(4,10,20,.85)'; ctx.fillRect(W / 2 - 160, 250, 320, 70 + menu.items.length * 40);\n  ctx.textAlign = 'center';\n  ctx.fillStyle = '#eef3fb'; ctx.font = 'bold 22px system-ui';\n  ctx.fillText('Settings', W / 2, 286);\n  ctx.font = '18px system-ui';\n  menu.items.forEach((item, i) => {\n    ctx.fillStyle = i === menu.at ? '#ffd34d' : '#eef3fb';\n    ctx.fillText(`${i === menu.at ? '▸ ' : ''}${item.label()}`, W / 2, 326 + i * 40);\n  });\n}\n\nconnect();\nrequestAnimationFrame(frame);\n</script>\n</body>\n</html>\n","numLines":799,"startLine":1,"totalLines":799}},"tool_result_meta":[{"id":"toolu_01Pz74pSggp5StHcbeYEdp7G","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
