{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R33t1g2CokoL5BzJCgihZi","type":"tool_result","content":"160\t}\n161\t/** a frame turned a about the up axis, and eased toward upright by w (0 = upright, 1 = the frame) */\n162\tfunction frameMix(m, a, w) {\n163\t  const col = i => turn([m[i], m[i + 3], m[i + 6]], a), f = col(0), u = col(2);\n164\t  return w >= 1 ? frame3(u, f) : frame3(V.lerp([0, 0, 1], u, w), V.lerp([1, 0, 0], f, w));\n165\t}\n166\t/**\n167\t * Mocap.drive(rig, lib): after the rig poses itself each step it takes the pose in rig.mocap (a sampled pose, or\n168\t * null to play its own animation). The rig keeps its build: each bone takes the clip's direction at its own length,\n169\t * the feet and hands are placed in proportion and solved with the engine's two-bone IK, so the cape and hair follow.\n170\t * The rig turns with the clip's chest (rig.spin: a spinning kick turns the face, hair and cape with it), and what it\n171\t * draws around the joints follows the clip's body and head (rig.mocapTilt: upside down in a cartwheel, a face that\n172\t * looks down). A held sword never goes through the floor.\n173\t * rig.mocapW fades the clip over the rig's own pose; rig.mocapMask = 'upper' leaves the hips and legs to the rig.\n174\t */\n175\tfunction drive(rig, lib) {\n176\t  const base = E.Humanoid.prototype.solvePose, update = E.Humanoid.prototype.update, R = lib.rest, hipH = R.hipZ, ankleH = R.ankleZ;\n177\t  const legSrc = R.thigh + R.shin, armSrc = R.up + R.fore + R.fist * .6;\n178\t  // the rig's own turn this step (an attack's spin), read before the clip turns it: solvePose can run more than once a step\n179\t  rig.update = function (dt, s) { this._ownSpin = null; return update.call(this, dt, s); };\n180\t  rig.solvePose = function () {\n181\t    base.call(this);\n182\t    const pose = this.mocap, w = this.mocapW === undefined ? 1 : Math.max(0, Math.min(1, this.mocapW));\n183\t    if (this._ownSpin == null) this._ownSpin = this.spin || 0;\n184\t    if (!pose || w <= 0) { this.mocapTilt = null; this.spin = this._ownSpin; return; }\n185\t    const o = this.o, J = this.J, k = o.hipZ / hipH, upper = this.mocapMask === 'upper';\n186\t    // the body's heading: where the chest faces, flat on the floor. The rig turns to it, so the clip is read in a frame\n187\t    // turned with the body. A chest that faces up or down (lying, bent double) has no heading to trust: the rig faces ahead\n188\t    let yaw = 0;\n189\t    if (!upper) {\n190\t      const c = lib.pt(pose, 'chest'), cf = lib.pt(pose, 'chestF'), fx = cf[0] - c[0], fy = cf[1] - c[1], fl = Math.hypot(fx, fy);\n191\t      const trust = Math.max(0, Math.min(1, (fl / (Math.hypot(fx, fy, cf[2] - c[2]) || 1) - .3) / .3));\n192\t      if (trust > 0) yaw = Math.atan2(fy, fx) * trust;\n193\t    }\n194\t    const pt = yaw ? n => turn(lib.pt(pose, n), -yaw) : n => lib.pt(pose, n);\n195\t    const keep = w < 1 ? {} : null; if (keep) for (const key of DRIVEN) keep[key] = J[key] && J[key].slice();\n196\t    const mid = (a, b) => V.lerp(pt(a), pt(b), .5), hipsS = mid('hipL', 'hipR'), shS = mid('shL', 'shR');\n197\t    if (!upper) {\n198\t      // a clip that dips below the ground (an in-place jump's pointed toes, a zombie climbing out of a grave) is lifted\n199\t      // until its lowest point stands on it: the floor here hides nothing beneath it\n200\t      let lo = 0; for (let i = 2; i < pose.length; i += 3) if (pose[i] < lo) lo = pose[i];\n201\t      const hipC = V.add(V.mul(hipsS, k), [0, 0, -lo * k]), across = V.norm(V.sub(pt('hipR'), pt('hipL')));\n202\t      J.hipC = hipC; J.hipL = V.add(hipC, V.mul(across, -o.hipHalf)); J.hipR = V.add(hipC, V.mul(across, o.hipHalf));\n203\t      const legK = (o.legUpper + o.legLower) / legSrc;\n204\t      for (const s of ['L', 'R']) {\n205\t        const hip = J['hip' + s], hipSrc = pt('hip' + s), ank = pt('ankle' + s), knee = pt('knee' + s);\n206\t        const footSrc = V.sub(ank, [0, 0, ankleH * Math.min(1, Math.max(0, 1 - (ank[2] - ankleH) / 300))]);   // the sole, not the ankle, touches the ground\n207\t        let foot = V.add(hip, V.mul(V.sub(footSrc, hipSrc), legK)); if (foot[2] < 0) foot = [foot[0], foot[1], 0];\n208\t        const hint = V.norm(V.sub(knee, V.lerp(hipSrc, ank, .5)));\n209\t        const [kn, ft] = E.ik3(hip, foot, o.legUpper, o.legLower, hint); J['knee' + s] = kn; J['foot' + s] = ft;\n210\t      }\n211\t    }\n212\t    J.shC = V.add(J.hipC, V.mul(V.norm(V.sub(shS, hipsS)), o.torso));\n213\t    const sAcross = V.norm(V.sub(pt('shR'), pt('shL')));\n214\t    J.shL = V.add(J.shC, V.mul(sAcross, -o.shoulderHalf)); J.shR = V.add(J.shC, V.mul(sAcross, o.shoulderHalf));\n215\t    const headC = V.lerp(pt('head'), pt('headTop'), .45);\n216\t    J.head = V.add(J.shC, V.mul(V.norm(V.sub(headC, shS)), o.neck + o.headR));\n217\t    const armK = (o.armUpper + o.armLower) / armSrc;\n218\t    for (const s of ['L', 'R']) {\n219\t      const sh = J['sh' + s], shSrc = pt('sh' + s), fist = pt('fist' + s), el = pt('elbow' + s);\n220\t      const hand = V.add(sh, V.mul(V.sub(fist, shSrc), armK));\n221\t      const hint = V.norm(V.sub(el, V.lerp(shSrc, fist, .5)));\n222\t      const [e, h] = E.ik3(sh, hand, o.armUpper, o.armLower, hint); J['elbow' + s] = e; J['hand' + s] = h;\n223\t    }\n224\t    // a sword in a fist runs along the knuckles, out past the index finger (otherwise the blade keeps its resting angle)\n225\t    if (this.mocapBlade) J.bladeDir = V.norm(V.sub(pt('indexR'), pt('pinkyR')));\n226\t    // the frames the rig draws its details in (Humanoid._offsets): the chest's and the head's, as turned from how they sit\n227\t    // at rest. Only a whole-body clip sets them; an upper-body one keeps the rig's own\n228\t    const src = lib.set.sources[pose.src] || lib.set.sources[Object.keys(lib.set.sources)[0]], rest = src && src.rest;\n229\t    const body = upper ? null : tiltFrom(V.sub(pt('neck'), pt('chest')), V.sub(pt('chestF'), pt('chest')), rest && rest.Cr);\n230\t    const head = upper ? null : tiltFrom(V.sub(pt('headTop'), pt('head')), V.sub(pt('faceF'), pt('head')), rest && rest.Hr);\n231\t    // the turn the rig is drawn with: the clip's heading, faded in with the clip over the rig's own (an attack's spin)\n232\t    const own = this._ownSpin, spin = upper ? own : own * (1 - w) + yaw * w;\n233\t    if (keep) {\n234\t      const toM = yaw - spin, toK = own - spin;   // both poses into the frame the rig is drawn with, then blended\n235\t      for (const key of upper ? UPPER : DRIVEN) if (keep[key]) {\n236\t        const m = upper ? J[key] : turn(J[key], toM), kp = upper ? keep[key] : turn(keep[key], toK);\n237\t        J[key] = key === 'bladeDir' ? V.norm(V.lerp(kp, m, w)) : V.lerp(kp, m, w);\n238\t      }\n239\t    }\n240\t    this.spin = spin;\n241\t    this.mocapTilt = body ? { body: frameMix(body, yaw - spin, w), head: frameMix(head, yaw - spin, w) } : null;\n242\t    // lying on the back: the rig's knocked-down measure follows the torso (the game reads it: shadows, what a body on\n243\t    // the floor can do); the face, hair and toes it draws around the joints lie with the body through mocapTilt\n244\t    if (!upper) {\n245\t      const d = V.sub(shS, hipsS), back = Math.max(0, -d[0]), side = Math.hypot(d[0], d[1]), tilt = Math.atan2(side, d[2]);\n246\t      const down = side > 1e-6 ? Math.max(0, Math.min(1, tilt / (Math.PI / 2 * .96))) * back / side : 0;\n247\t      this.downW = (this.downW || 0) * (1 - w) + down * w;\n248\t      // and a weapon he is not holding up (no mocapBlade) drops flat on the floor beside the hand as he goes down\n249\t      const kn = V.sub(pt('indexR'), pt('pinkyR')), kl = Math.hypot(kn[0], kn[1]);\n250\t      if (!this.mocapBlade && down > 0 && kl > 1e-6 && J.bladeDir) J.bladeDir = V.norm(V.lerp(J.bladeDir, [kn[0] / kl, kn[1] / kl, -.08], Math.min(1, down * 1.5) * w));\n251\t    }\n252\t    // a sword never goes through the floor (hands planted in a cartwheel, a roll): the blade lowers no further than\n253\t    // to lie along it\n254\t    if (o.weapon === 'sword' && J.handR && J.bladeDir) {\n255\t      const h = J.handR[2], b = J.bladeDir, L = o.bladeLen, floor = .3;\n256\t      if (h + b[2] * L < floor && h > floor - L) {\n257\t        const bz = (floor - h) / L, hl = Math.hypot(b[0], b[1]), r = Math.sqrt(Math.max(0, 1 - bz * bz));\n258\t        J.bladeDir = hl > 1e-6 ? [b[0] / hl * r, b[1] / hl * r, bz] : [r, 0, bz];\n259\t      }\n260\t    }\n261\t  };\n262\t  return rig;\n263\t}\n264\t\n265\treturn { load, Mannequin, drive, LEGEND: MR.LEGEND };"}]},"parent_tool_use_id":null,"session_id":"c21bae92-846f-4b71-8d0d-098b4791d47c","uuid":"c6b798c4-5906-4795-b351-10a93849e6b3","timestamp":"2026-11-05T04:23:36.797Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211853__x57f432/work/_research/mocap/mocap.js","content":"}\n/** a frame turned a about the up axis, and eased toward upright by w (0 = upright, 1 = the frame) */\nfunction frameMix(m, a, w) {\n  const col = i => turn([m[i], m[i + 3], m[i + 6]], a), f = col(0), u = col(2);\n  return w >= 1 ? frame3(u, f) : frame3(V.lerp([0, 0, 1], u, w), V.lerp([1, 0, 0], f, w));\n}\n/**\n * Mocap.drive(rig, lib): after the rig poses itself each step it takes the pose in rig.mocap (a sampled pose, or\n * null to play its own animation). The rig keeps its build: each bone takes the clip's direction at its own length,\n * the feet and hands are placed in proportion and solved with the engine's two-bone IK, so the cape and hair follow.\n * The rig turns with the clip's chest (rig.spin: a spinning kick turns the face, hair and cape with it), and what it\n * draws around the joints follows the clip's body and head (rig.mocapTilt: upside down in a cartwheel, a face that\n * looks down). A held sword never goes through the floor.\n * rig.mocapW fades the clip over the rig's own pose; rig.mocapMask = 'upper' leaves the hips and legs to the rig.\n */\nfunction drive(rig, lib) {\n  const base = E.Humanoid.prototype.solvePose, update = E.Humanoid.prototype.update, R = lib.rest, hipH = R.hipZ, ankleH = R.ankleZ;\n  const legSrc = R.thigh + R.shin, armSrc = R.up + R.fore + R.fist * .6;\n  // the rig's own turn this step (an attack's spin), read before the clip turns it: solvePose can run more than once a step\n  rig.update = function (dt, s) { this._ownSpin = null; return update.call(this, dt, s); };\n  rig.solvePose = function () {\n    base.call(this);\n    const pose = this.mocap, w = this.mocapW === undefined ? 1 : Math.max(0, Math.min(1, this.mocapW));\n    if (this._ownSpin == null) this._ownSpin = this.spin || 0;\n    if (!pose || w <= 0) { this.mocapTilt = null; this.spin = this._ownSpin; return; }\n    const o = this.o, J = this.J, k = o.hipZ / hipH, upper = this.mocapMask === 'upper';\n    // the body's heading: where the chest faces, flat on the floor. The rig turns to it, so the clip is read in a frame\n    // turned with the body. A chest that faces up or down (lying, bent double) has no heading to trust: the rig faces ahead\n    let yaw = 0;\n    if (!upper) {\n      const c = lib.pt(pose, 'chest'), cf = lib.pt(pose, 'chestF'), fx = cf[0] - c[0], fy = cf[1] - c[1], fl = Math.hypot(fx, fy);\n      const trust = Math.max(0, Math.min(1, (fl / (Math.hypot(fx, fy, cf[2] - c[2]) || 1) - .3) / .3));\n      if (trust > 0) yaw = Math.atan2(fy, fx) * trust;\n    }\n    const pt = yaw ? n => turn(lib.pt(pose, n), -yaw) : n => lib.pt(pose, n);\n    const keep = w < 1 ? {} : null; if (keep) for (const key of DRIVEN) keep[key] = J[key] && J[key].slice();\n    const mid = (a, b) => V.lerp(pt(a), pt(b), .5), hipsS = mid('hipL', 'hipR'), shS = mid('shL', 'shR');\n    if (!upper) {\n      // a clip that dips below the ground (an in-place jump's pointed toes, a zombie climbing out of a grave) is lifted\n      // until its lowest point stands on it: the floor here hides nothing beneath it\n      let lo = 0; for (let i = 2; i < pose.length; i += 3) if (pose[i] < lo) lo = pose[i];\n      const hipC = V.add(V.mul(hipsS, k), [0, 0, -lo * k]), across = V.norm(V.sub(pt('hipR'), pt('hipL')));\n      J.hipC = hipC; J.hipL = V.add(hipC, V.mul(across, -o.hipHalf)); J.hipR = V.add(hipC, V.mul(across, o.hipHalf));\n      const legK = (o.legUpper + o.legLower) / legSrc;\n      for (const s of ['L', 'R']) {\n        const hip = J['hip' + s], hipSrc = pt('hip' + s), ank = pt('ankle' + s), knee = pt('knee' + s);\n        const footSrc = V.sub(ank, [0, 0, ankleH * Math.min(1, Math.max(0, 1 - (ank[2] - ankleH) / 300))]);   // the sole, not the ankle, touches the ground\n        let foot = V.add(hip, V.mul(V.sub(footSrc, hipSrc), legK)); if (foot[2] < 0) foot = [foot[0], foot[1], 0];\n        const hint = V.norm(V.sub(knee, V.lerp(hipSrc, ank, .5)));\n        const [kn, ft] = E.ik3(hip, foot, o.legUpper, o.legLower, hint); J['knee' + s] = kn; J['foot' + s] = ft;\n      }\n    }\n    J.shC = V.add(J.hipC, V.mul(V.norm(V.sub(shS, hipsS)), o.torso));\n    const sAcross = V.norm(V.sub(pt('shR'), pt('shL')));\n    J.shL = V.add(J.shC, V.mul(sAcross, -o.shoulderHalf)); J.shR = V.add(J.shC, V.mul(sAcross, o.shoulderHalf));\n    const headC = V.lerp(pt('head'), pt('headTop'), .45);\n    J.head = V.add(J.shC, V.mul(V.norm(V.sub(headC, shS)), o.neck + o.headR));\n    const armK = (o.armUpper + o.armLower) / armSrc;\n    for (const s of ['L', 'R']) {\n      const sh = J['sh' + s], shSrc = pt('sh' + s), fist = pt('fist' + s), el = pt('elbow' + s);\n      const hand = V.add(sh, V.mul(V.sub(fist, shSrc), armK));\n      const hint = V.norm(V.sub(el, V.lerp(shSrc, fist, .5)));\n      const [e, h] = E.ik3(sh, hand, o.armUpper, o.armLower, hint); J['elbow' + s] = e; J['hand' + s] = h;\n    }\n    // a sword in a fist runs along the knuckles, out past the index finger (otherwise the blade keeps its resting angle)\n    if (this.mocapBlade) J.bladeDir = V.norm(V.sub(pt('indexR'), pt('pinkyR')));\n    // the frames the rig draws its details in (Humanoid._offsets): the chest's and the head's, as turned from how they sit\n    // at rest. Only a whole-body clip sets them; an upper-body one keeps the rig's own\n    const src = lib.set.sources[pose.src] || lib.set.sources[Object.keys(lib.set.sources)[0]], rest = src && src.rest;\n    const body = upper ? null : tiltFrom(V.sub(pt('neck'), pt('chest')), V.sub(pt('chestF'), pt('chest')), rest && rest.Cr);\n    const head = upper ? null : tiltFrom(V.sub(pt('headTop'), pt('head')), V.sub(pt('faceF'), pt('head')), rest && rest.Hr);\n    // the turn the rig is drawn with: the clip's heading, faded in with the clip over the rig's own (an attack's spin)\n    const own = this._ownSpin, spin = upper ? own : own * (1 - w) + yaw * w;\n    if (keep) {\n      const toM = yaw - spin, toK = own - spin;   // both poses into the frame the rig is drawn with, then blended\n      for (const key of upper ? UPPER : DRIVEN) if (keep[key]) {\n        const m = upper ? J[key] : turn(J[key], toM), kp = upper ? keep[key] : turn(keep[key], toK);\n        J[key] = key === 'bladeDir' ? V.norm(V.lerp(kp, m, w)) : V.lerp(kp, m, w);\n      }\n    }\n    this.spin = spin;\n    this.mocapTilt = body ? { body: frameMix(body, yaw - spin, w), head: frameMix(head, yaw - spin, w) } : null;\n    // lying on the back: the rig's knocked-down measure follows the torso (the game reads it: shadows, what a body on\n    // the floor can do); the face, hair and toes it draws around the joints lie with the body through mocapTilt\n    if (!upper) {\n      const d = V.sub(shS, hipsS), back = Math.max(0, -d[0]), side = Math.hypot(d[0], d[1]), tilt = Math.atan2(side, d[2]);\n      const down = side > 1e-6 ? Math.max(0, Math.min(1, tilt / (Math.PI / 2 * .96))) * back / side : 0;\n      this.downW = (this.downW || 0) * (1 - w) + down * w;\n      // and a weapon he is not holding up (no mocapBlade) drops flat on the floor beside the hand as he goes down\n      const kn = V.sub(pt('indexR'), pt('pinkyR')), kl = Math.hypot(kn[0], kn[1]);\n      if (!this.mocapBlade && down > 0 && kl > 1e-6 && J.bladeDir) J.bladeDir = V.norm(V.lerp(J.bladeDir, [kn[0] / kl, kn[1] / kl, -.08], Math.min(1, down * 1.5) * w));\n    }\n    // a sword never goes through the floor (hands planted in a cartwheel, a roll): the blade lowers no further than\n    // to lie along it\n    if (o.weapon === 'sword' && J.handR && J.bladeDir) {\n      const h = J.handR[2], b = J.bladeDir, L = o.bladeLen, floor = .3;\n      if (h + b[2] * L < floor && h > floor - L) {\n        const bz = (floor - h) / L, hl = Math.hypot(b[0], b[1]), r = Math.sqrt(Math.max(0, 1 - bz * bz));\n        J.bladeDir = hl > 1e-6 ? [b[0] / hl * r, b[1] / hl * r, bz] : [r, 0, bz];\n      }\n    }\n  };\n  return rig;\n}\n\nreturn { load, Mannequin, drive, LEGEND: MR.LEGEND };","numLines":106,"startLine":160,"totalLines":269}},"tool_result_meta":[{"id":"toolu_01R33t1g2CokoL5BzJCgihZi","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9HqEn7GXR5ZRv3H32u","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Qq7VJLxzv141bZa7epV54P","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211853__x57f432/work/_research/mocap/anim-set.mjs"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2543,"cache_read_input_tokens":198532,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2543},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c21bae92-846f-4b71-8d0d-098b4791d47c","uuid":"3b8a852d-f7d0-46c9-82f8-cc491806f3d6","timestamp":"2026-11-05T04:23:38.367Z","request_id":"req_011Cgj9HpvgE1EX6LSX6KUvw","wire_tool_inputs":{"toolu_01Qq7VJLxzv141bZa7epV54P":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211853__x57f432/work/_research/mocap/anim-set.mjs"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qq7VJLxzv141bZa7epV54P","type":"tool_result","content":"1\t// A smaller animation set from bigger ones: the clips a game adopts (for example a hero's), with the records of the\n2\t// libraries they came from (their proportions and origins) and the mannequin's look. No source files needed: it reads\n3\t// and writes readable set files. The first set's first library gives the proportions every clip is rebuilt on.\n4\t// Usage: node tools/anim-set.mjs src/mocap/sets/quaternius.js [src/mocap/sets/mesh2motion.js ...] --clips Death01,Land_Three_Point,...\n5\t//          --name HERO --out src/mocap/sets/hero.js [--credit \"...\"] [--title Hero]\n6\t// A clip name found in more than one of the sets is picked as SET:Clip (QUATERNIUS:Interact).\n7\timport { resolve } from 'node:path';\n8\timport { readSet, writeSet } from './mocap-lib.mjs';\n9\t\n10\tconst args = process.argv.slice(2), opt = name => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : undefined; };\n11\tconst files = args.filter((a, i) => !a.startsWith('--') && !(args[i - 1] || '').startsWith('--'));\n12\tif (!files.length || !opt('clips') || !opt('name') || !opt('out')) { console.error('Usage: node tools/anim-set.mjs a.js [b.js ...] --clips A,SET:B --name NAME --out out.js [--credit \"...\"] [--title Title]'); process.exit(2); }\n13\tconst srcs = files.map(f => readSet(resolve(f))), clips = {}, fit = {}, used = new Set(), from = [];\n14\tfor (const want of opt('clips').split(',')) {\n15\t  const [setName, clipName] = want.includes(':') ? want.split(':') : [null, want];\n16\t  const hits = srcs.filter(S => (!setName || S.set === setName) && S.clips[clipName]);\n17\t  if (!hits.length) { console.error('no clip ' + want + ' in ' + srcs.map(S => S.set).join(', ')); process.exit(1); }\n18\t  if (hits.length > 1) { console.error(clipName + ' is in ' + hits.map(S => S.set).join(' and ') + ': pick one as SET:' + clipName); process.exit(1); }\n19\t  const S = hits[0], c = S.clips[clipName];\n20\t  if (clips[clipName]) { console.error(clipName + ' is picked twice'); process.exit(1); }\n21\t  if (!S.sources[c.src]) { console.error(S.set + ' ' + clipName + ': its library ' + c.src + ' is not on record'); process.exit(1); }\n22\t  clips[clipName] = c; fit[clipName] = S.fit[clipName]; used.add(S.set + '/' + c.src); if (!from.includes(S.set)) from.push(S.set);\n23\t}\n24\t// the libraries the picked clips came from, with their records; the first set's first library leads (its proportions)\n25\tconst sources = {}, first = srcs[0], lead = Object.keys(first.sources)[0];\n26\tsources[lead] = first.sources[lead];\n27\tfor (const S of srcs) for (const [id, rec] of Object.entries(S.sources)) if (used.has(S.set + '/' + id)) {\n28\t  if (sources[id] && sources[id] !== rec) { console.error('two sets name a library ' + id + ': rename one'); process.exit(1); }\n29\t  sources[id] = rec;\n30\t}\n31\tconst out = Object.assign({ set: opt('name') }, opt('title') ? { title: opt('title') } : {}, { format: first.format, credit: opt('credit') || first.credit,\n32\t  from: from.length === 1 ? from[0] : from, fps: first.fps, sources, body: first.body, fit, clips });\n33\tconst w = writeSet(out, resolve(opt('out')));\n34\tconsole.log(`wrote ${opt('out')}: ${w.clips} clips from ${from.join(' and ')}, ${w.keys} key poses, ${w.kb.toFixed(0)} KB`);\n35\t"}]},"parent_tool_use_id":null,"session_id":"c21bae92-846f-4b71-8d0d-098b4791d47c","uuid":"8afac161-bd99-439c-9933-9e1cb7b27e9b","timestamp":"2026-11-05T04:23:38.388Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211853__x57f432/work/_research/mocap/anim-set.mjs","content":"// A smaller animation set from bigger ones: the clips a game adopts (for example a hero's), with the records of the\n// libraries they came from (their proportions and origins) and the mannequin's look. No source files needed: it reads\n// and writes readable set files. The first set's first library gives the proportions every clip is rebuilt on.\n// Usage: node tools/anim-set.mjs src/mocap/sets/quaternius.js [src/mocap/sets/mesh2motion.js ...] --clips Death01,Land_Three_Point,...\n//          --name HERO --out src/mocap/sets/hero.js [--credit \"...\"] [--title Hero]\n// A clip name found in more than one of the sets is picked as SET:Clip (QUATERNIUS:Interact).\nimport { resolve } from 'node:path';\nimport { readSet, writeSet } from './mocap-lib.mjs';\n\nconst args = process.argv.slice(2), opt = name => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : undefined; };\nconst files = args.filter((a, i) => !a.startsWith('--') && !(args[i - 1] || '').startsWith('--'));\nif (!files.length || !opt('clips') || !opt('name') || !opt('out')) { console.error('Usage: node tools/anim-set.mjs a.js [b.js ...] --clips A,SET:B --name NAME --out out.js [--credit \"...\"] [--title Title]'); process.exit(2); }\nconst srcs = files.map(f => readSet(resolve(f))), clips = {}, fit = {}, used = new Set(), from = [];\nfor (const want of opt('clips').split(',')) {\n  const [setName, clipName] = want.includes(':') ? want.split(':') : [null, want];\n  const hits = srcs.filter(S => (!setName || S.set === setName) && S.clips[clipName]);\n  if (!hits.length) { console.error('no clip ' + want + ' in ' + srcs.map(S => S.set).join(', ')); process.exit(1); }\n  if (hits.length > 1) { console.error(clipName + ' is in ' + hits.map(S => S.set).join(' and ') + ': pick one as SET:' + clipName); process.exit(1); }\n  const S = hits[0], c = S.clips[clipName];\n  if (clips[clipName]) { console.error(clipName + ' is picked twice'); process.exit(1); }\n  if (!S.sources[c.src]) { console.error(S.set + ' ' + clipName + ': its library ' + c.src + ' is not on record'); process.exit(1); }\n  clips[clipName] = c; fit[clipName] = S.fit[clipName]; used.add(S.set + '/' + c.src); if (!from.includes(S.set)) from.push(S.set);\n}\n// the libraries the picked clips came from, with their records; the first set's first library leads (its proportions)\nconst sources = {}, first = srcs[0], lead = Object.keys(first.sources)[0];\nsources[lead] = first.sources[lead];\nfor (const S of srcs) for (const [id, rec] of Object.entries(S.sources)) if (used.has(S.set + '/' + id)) {\n  if (sources[id] && sources[id] !== rec) { console.error('two sets name a library ' + id + ': rename one'); process.exit(1); }\n  sources[id] = rec;\n}\nconst out = Object.assign({ set: opt('name') }, opt('title') ? { title: opt('title') } : {}, { format: first.format, credit: opt('credit') || first.credit,\n  from: from.length === 1 ? from[0] : from, fps: first.fps, sources, body: first.body, fit, clips });\nconst w = writeSet(out, resolve(opt('out')));\nconsole.log(`wrote ${opt('out')}: ${w.clips} clips from ${from.join(' and ')}, ${w.keys} key poses, ${w.kb.toFixed(0)} KB`);\n","numLines":35,"startLine":1,"totalLines":35}},"tool_result_meta":[{"id":"toolu_01Qq7VJLxzv141bZa7epV54P","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
