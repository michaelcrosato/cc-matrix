art3', 2.2, 5.2], ['111_39_part3', 6.6, 7.6], ['111_38_part1', 2.9, 5], ['111_38_part2', 2.8, 5.2], ['111_38_part2', 8, 8.8], ['111_41_part3', 3.4, 6.4], ['22_14', 1.1, 1.72]];\n  out.poses = POSES.every(([c, a, b]) => { const k = lib.clip(c); return k && b <= k.dur && a < b; });\n  for (const n of ['Meditate','Pushup','22_14','Jumping Jacks','Run_Loop','Walk_Loop','Hop_One_Foot_Loop','Dizzy','Get_Up_From_Back','Victory','Cheering_Two_Hands','Stretch_Yawn','Sleeping','Greeting','Wave_Hello','Waiting_Loop','Idle_Subtle']) if (!lib.clip(n)) out['missing ' + n] = true;\n  // each move: rig stays together (bones keep their length) and feet stay on or above the floor\n  const moves = { lunge: sideLunge(.8), lungeL: sideLunge(-.6), hula: hula(1.1), step0: stepUp(0), step1: stepUp(1) };\n  for (const k in moves) { rig.mocap = null; rig.body = moves[k]; rig.wob = [0, 0]; rig.update(1 / 120, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: 1.57 });\n    const J = rig.J, d = (a, b) => Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]), o = rig.o;\n    out[k] = { thighL: +d(J.hipL, J.kneeL).toFixed(2), shin: +d(J.kneeL, J.footL).toFixed(2), upper: +d(J.shL, J.elbowL).toFixed(2), footZ: +J.footL[2].toFixed(2), finite: Object.values(J).every(p => !p || p.every(Number.isFinite)) };\n  }\n  // the wobble tilts the head away from the feet's vertical, and the feet stay down\n  rig.body = null; rig.mocap = lib.sample(lib.clip('111_39_part1'), 5); rig.wob = [0, 0]; rig.update(1 / 120, { x: 0, y: 0, z: 0, facing: 1.57 }); const h0 = rig.J.head.slice();\n  rig.wob = [.5, .2]; rig.update(1 / 120, { x: 0, y: 0, z: 0, facing: 1.57 - (rig.spin || 0) }); out.wobbleMovesHead = +Math.hypot(rig.J.head[0] - h0[0], rig.J.head[1] - h0[1]).toFixed(2); out.minZ = +Math.min(...['footL', 'footR'].map(k => rig.J[k][2])).toFixed(2);\n  out.music = game.settings.music; out.actions = Object.keys(game.input.map).length;\n  return out; })()`;\nconsole.log(JSON.stringify(vm.runInContext(src, ctx), null, 0));\nEOF\nn