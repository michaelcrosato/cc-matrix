i % COLS === 0) E.font.text(g, c.name || names[Math.floor(i / COLS)], Math.round(cx - cw/2 + 3), Math.round(cy - ch + 18), '#a33', { outline: false });\n    });\n  });\n} });\ngame.advance(.1, { draw: true }); game.advance(1/120, { draw: true });\nwindow.__ready = true;\n})();\nEOF\npython3 shot.py sheet2.html \"clips=Pushup,Meditate,Jumping%20Jacks,22_14,Hop_One_Foot_Loop\" m1.png 1280 720 | cut -c1-260; python3 shot.py sheet2.html \"clips=Victory,Cheering_Two_Hands,Dizzy,Fighting%20Idle,Get_Up_From_Back\" m2.png 1280 720 | cut -c1-260","description":"Render sheets of the exercise and reaction clips","timeout":120000}}}
