 page threw any error or never drew anything, so agents and CI can rely on it.\n// A game that sets game.debug = { snapshot() { return {...} } } gets its snapshot printed after play (its own state:\n// the hero, the objective, what an agent needs to see the game is where it should be).\nimport { chromium } from 'playwright';\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { resolve, join } from 'node:path';\nimport { pathToFileURL } from 'node:url';\n\nconst args = process.argv.slice(2);\nconst file = args.find(a => !a.startsWith('--') && !/^\\d+(\\.\\d+)?$/.test(a));\nconst opt = (name, def) => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : def; };\nif (!file) { console.error('Usage: node tools/check.mjs path/to/game.html [--seconds 4] [--out check-output]'); process.exit(2); }\nconst seconds = +opt('seconds', 4), out = resolve(opt('out', 'check-output'));\nconst [, sw, sh, sd] = (opt('size', '1280x720') || '').match(/^(\\d+)x(\\d+)(?:@(\\d+(?:\\.\\d+)?))?$/) || [0, 1280, 720];\nconst dpr = +(sd || 1), size = { viewport: { width: +sw, height: +sh }, deviceScaleFactor: dpr, ...(dpr >= 2 && { isMobile: true, hasTouch: true }) };\nmkdirSync(out, { recursive: true });\n\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--autoplay-policy=no-user-gesture-required'] });\nconst page = await browser.newPage(size);\nconst errors = [], warnings = [], engineWarnings = [], external = new Set();\npage.on('pageerror', e => errors.push(String(e && e.stack || e)));\npage.on('console', m => {\n  const t = m.text();\n  if (m.type() === 'error') errors.push(t);\n  else if (m.type() === 'warning') (t.startsWith('my-3D2dge:') ? engineWarnings : warnings).push(t);\n});\npage.on('request', r => { const u = r.url(); if (/^https?:/i.test(u)) external.add(u.split('?')[0]); });\n\n// a #hash after the file name is kept, so deep links like game.html#platformer work\nconst [filePath, hash] = file.split('#');\nawait page.goto(pathToFileURL(resolve(filePath)).href + (hash ? '#' + hash : ''));\nawait page.waitForTimeout(1200);\ntools/check.mjs:6://                 npx playwright install chromium\ntools/check.mjs:12:import { chromium } from 'playwright';\nkenney-nature:bed-floor            shape     155 tok  bedroll on the ground, white mat, teal blanket  [furniture camp]\nkenney-survival:bedroll            shape     234 tok  orange sleeping mat laid flat, rolled pillow end  [furniture camp survival]\nkaykit-restaurant-bits:food-ingredient-tomato shape     269 tok  red tomato with a green leafy top  [food vegetable kitchen]\nkenney-food:salad                  shape     235 tok  brown bowl of green salad, red tomatoes  [food bowl kitchen dining]\nkenney-nature:bed                  shape     305 tok  low wooden cot, white mattress, teal blanket  [furniture camp bedroom]\n5 of 5 matches; --show <id> prints an entry to copy\nno match for \"dumbbell\"\nbench                              shape      57 tok  plank bench on two trestles  [furniture tavern]\nkaykit-halloween-bits:bench        shape     204 tok  low weathered grey-brown wooden bench on slab legs  [furniture bench graveyard park]\nkenney-fantasy-town:stall-bench    shape     101 tok  long low wooden bench, solid plank ends  [furniture market town]\nkenney-graveyard:bench             shape     280 tok  wooden bench with backrest on grey stone legs  [furniture graveyard park]\nkenney-holiday:bench               shape     224 tok  wooden slat bench on grey metal legs  [furniture town park winter]\nkenney-survival:workbench          shape     520 tok  wooden workbench, grey vise and wood shavings on top  [furniture camp workshop]\nkenney-survival:workbench-anvil    shape     385 tok  grey anvil on a low wooden stand  [furniture camp smithy]\nkenney-survival:workbench-grind    shape     201 tok  grey grindstone wheel in a wooden frame  [furniture camp workshop]\nkaykit-furniture-bits:cactus-medium-a shape     283 tok  leafy green succulent in a round terracotta pot  [plant decoration house]\nkaykit-furniture-bits:cactus-medium-b shape     455 tok  bushy green succulent in a terracotta pot  [plant decoration house]\nkaykit-furniture-bits:cactus-small-b shape     298 tok  small green succulent in a little terracotta pot  [plant decoration house]\nkenney-nature:pot-small            shape      86 tok  small round wooden plant pot, flared rim  [container garden house]\nkenney-nature:pot-large            shape      78 tok  wide low wooden planter tub  [container garden farm]\nkenney-tiny-town:tile-0029         sprite    163 tok  two red mushrooms with white spots  [plant mushroom forest]\nkaykit-furniture-bits:cabinet-medium-decorated shape     570 tok  low brown wooden cabinet with potted plants on top  [furniture bedroom house]\nbush                               shape      65 tok  round bush, r wide (7)  [plant garden]\naction3d.js\nadventure.js\nambientcg.js\nanimlab.js\nbrawler.js\nemberdeep.js\nkaykit-dungeon-remastered.js\nkaykit-furniture-bits.js\nkaykit-halloween-bits.js\nkaykit-restaurant-bits.js\nkenney-fantasy-town.js\nkenney-food.js\nkenney-furniture.js\nkenney-graveyard.js\nkenney-holiday.js\nkenney-mini-dungeon.js\nkenney-nature.js\nkenney-pirate.js\nkenney-platformer.js\nkenney-survival.js\nkenney-tiny-battle.js\nkenney-tiny-dungeon.js\nkenney-tiny-town.js\nplatformer.js\nplatformer3d.js\nrpg.js\nshooter.js\nstealth.js\ntavern.js","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01T3zCDFJdxGnw7fk8YBZkUB","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
