"-B.monWalk = (fid, x, y) => B.open(fid, x, y) && !B.pitOpen(fid, x, y) && !B.pitIn(fid, x, y) && B.ch(fid, x, y) !== '<' && B.ch(fid, x, y) !== '>' && B.ch(fid, x, y) !== 'I' && B.ch(fid, x, y) !== '^';","+B.monWalk = (fid, x, y) => B.open(fid, x, y) && !((p) => p && !p.p.bridged)(B.pitIn(fid, x, y)) && B.ch(fid, x, y) !== '<' && B.ch(fid, x, y) !== '>' && B.ch(fid, x, y) !== 'I' && B.ch(fid, x, y) !== '^';"," B.monsAt = (x, y, fid = B.S.floor) => B.S.floors[fid].mons.filter(m => m.hp > 0 && m.cx === x && m.cy === y);"," B.unitsAt = (x, y, fid, except) => B.monsAt(x, y, fid).reduce((n, m) => n + (m === except ? 0 : B.MONSTERS[m.type].size), 0);"," B.itemsAt = (x, y, fid = B.S.floor) => B.S.floors[fid].items[key(x, y)] || [];"]},{"oldStart":64,"oldLines":7,"newStart":64,"newLines":8,"lines":[" B.updateDoors = dt => {","   for (const fid of Object.keys(B.S.floors)) {","     const FS = B.S.floors[fid]; let changed = false;","-    for (const d of Object.values(FS.doors)) {","+    for (const [id, d] of Object.entries(FS.doors)) {","+      if (d.blockedClose) { const at = B.FLOORS[fid].doors[id].at, P = B.S.party; if (!(fid === B.S.floor && P.cx === at[0] && P.cy === at[1]) && !B.monsAt(at[0], at[1], fid).length) { d.blockedClose = false; d.want = 0; } }","       const rate = d.kind === 'door' ? 2 : d.kind === 'undergate' ? .25 : 1.1, was = d.open;","       d.open = d.want > d.open ? Math.min(d.want, d.open + rate * dt) : Math.max(d.want, d.open - rate * dt);","       if ((was < .5) !== (d.open < .5) || (was < .85) !== (d.open < .85)) changed = true;"]}]}],"moreFiles":0,"changedFiles":["/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-185013__xe162c9/agent.out","/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-185330__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-medium-20261103-185330/src/21-sim-map.js"]}},"tool_result_meta":[{"id":"toolu_016BoeMXBWE3Xido5c5rp8hL","permission_decision":{"decision":"accept