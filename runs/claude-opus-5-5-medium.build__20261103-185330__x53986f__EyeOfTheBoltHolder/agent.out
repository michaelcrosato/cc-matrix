 at: [9, 10], once: true, do: [['msg', 'The stench of rats is overwhelming.']] },\n    { at: [16, 1], once: true, do: [['story', 'snick1']] },\n    { at: [2, 12], once: true, do: [['hint', 'party']] },\n    { at: [8, 7], once: true, do: [['hint', 'map']] },\n    { at: [13, 6], once: true, do: [['hint', 'hold']] },\n    { at: [3, 13], once: true, do: [['hint', 'examine']] }],\n  hints: [{ near: [[13, 6], [14, 6], [15, 6]], after: 20, unless: { door: 'G2' }, text: 'plate' }],\n  waypoints: [['F1 Start', 2, 14, 0], ['F1 Rat Channel', 2, 7, 0], ['F1 Latchkin Den', 2, 4, 0], ['F1 Junction', 10, 6, 1], ['F1 Snick\\'s Hall', 17, 4, 0], ['F1 Sluice', 13, 10, 1], ['F1 Cistern', 18, 12, 2]]\n};\nB.FLOORS.f2 = {\n  name: 'The Tumbler Halls', music: 'tumbler', step: 'stepGrate', depth: 2,\n  look: { ground: '#5a4a3a', dark: '#3e3228', light: '#7a6450', wall: '#6a5a48', side: 'block', fog: '#0a0806', near: 40, far: 220, amb: ['#7a6048', '#2a2018', 3.0] },\n  map: [\n    '######################',\n    '#<@..........###.....#',\n    '#...####.....K.......#',\n    '########.....###.....#',\n    '#.....##########.....#',\n    '#.P.P.=...#....####.##',\n    '#.....#...M....####.##',\n    '#.....#...#....####.##',\n    '##=########...>####.##',\n    '##..P##############.##',\n    '####.o.############.##',\n    '####O#.####.#######^##',\n    '####.#.####=#######.##',\n    '####.#.##.....###....#',\n    '####............+.S..#',\n    '#########.....###....#',\n    '######################'],\n  start: [2, 1, 1],\n  doors: { K1: { at: [13, 2], key: 'gearKey', kind: 'warded' }, G5: { at: [11, 12] }, G6: { at: [2, 8] }, G7: { at: [6, 5] }, M1: { at: [10, 6], seal: true }, D3: { at: [16, 14] } },\n  plates: { P2: { at: [4, 9], mode: 'latch' }, P3: { at: [2, 5], mode: 'latch' }, P4: { at: [4, 5], mode: 'latch' } },\n  pits: { O1: { at: [4, 11] }, O2: { at: [5, 10], trapdoor: true } },\n  fall: { to: 'f3', at: [2, 15, 0] },\n  teleports: { TP1: { at: [19, 11], to: [19, 5, 2], silent: true } },\n  stairs: { '1,1': { to: 'f1', at: [15, 13, 0] }, '14,8': { to: 'f3', at: [1, 2, 2] } },\n  arrive: { f3: [13, 8, 3] },\n  safe: [[11, 11]],\n  features: [\n    ['N5', 'inscription', 8, 3, 'S', { text: \"THE TUMBLERWRIGHT'S CREED: THE FIRST FALLS. THE SECOND RISES. THE THIRD FALLS.\" }],\n    ['CN1', 'gearNiche', 16, 1, 'N'], ['CN2', 'gearNiche', 17, 1, 'N'], ['CF', 'clockFace', 18, 1, 'N'], ['CN3', 'gearNiche', 19, 1, 'N'], ['CN4', 'gearNiche', 20, 1, 'N'],\n    ['AL2', 'alcove', 19, 6, 'W', { holds: ['tumblerGear'] }], ['SW2', 'catch', 19, 8, 'E', { rivet: true }],\n    ['LA', 'lever', 10, 15, 'S', { up: true }], ['LB', 'lever', 11, 15, 'S', { up: true }], ['LC', 'lever', 12, 15, 'S', { up: true }],\n    ['N6', 'inscription', 3, 9, 'N', { text: 'I HAVE TEETH, YET NEVER BITE. I TURN, YET HAVE NO FEET. GIVE ME WHAT OPENS, AND I OPEN.' }],\n    ['AL3', 'alcove', 2, 9, 'W', { riddle: true }], ['N7', 'inscription', 8, 5, 'N', { text: 'THE GUILD VAULT. WHAT IS SEALED BY ART, ART UNSEALS.' }],\n    ['AL4', 'alcove', 14, 6, 'E', { holds: ['brassWard'] }], ['SH1', 'shrine', 12, 5, 'N'],\n    ['t1', 'torch', 10, 1, 'N'], ['t2', 'torch', 20, 4, 'E'], ['t3', 'torch', 9, 13, 'W'], ['t4', 'torch', 11, 8, 'S'], ['t5', 'torch', 1, 6, 'W'],\n    ['g1', 'gearWall', 8, 1, 'N'], ['g2', 'gearWall', 12, 1, 'N'], ['g3', 'gearWall', 16, 4, 'S'], ['g4', 'gearWall', 13, 15, 'S'], ['g5', 'gearWall', 3, 7, 'S']],\n  items: [[9, 1, 'tumblerGear'], [12, 3, 'gearKey'], [11, 3, 'warhammer'], [8, 1, 'scroll_featherStep'], [10, 3, 'guildLedger'], [8, 2, 'ration', 2],\n    [16, 4, 'scroll_unlatch'], [20, 3, 'potionHealing'], [20, 15, 'tumblerGear'], [17, 15, 'chainShirt'], [13, 15, 'ironShield'], [9, 15, 'tumblersPick'], [13, 13, 'ration'],\n    [6, 10, 'potionGreaterHealing'], [4, 13, 'rock'], [5, 14, 'rock'], [3, 9, 'bentKey'], [5, 7, 'ironIngot'], [1, 7, 'wandUnlatching'], [1, 4, 'ration', 2],\n    [12, 8, 'scroll_frostbite'], [11, 5, 'scrollRaising'], [13, 5, 'lockbreaker'], [14, 5, 'ironRation']],\n  mons: [['skeleton', 10, 2, 2], ['rustling', 11, 1, 3], ['spider', 18, 3, 1], ['rustling', 19, 9, 2, { patrol: [[19, 6], [19, 10]] }], ['spider', 20, 13, 1],\n    ['skeleton', 12, 14, 2], ['spider', 4, 13, 1], ['skeleton', 3, 6, 2], ['sentinel', 12, 6, 1, { id: 'sentinel' }]],\n  wanderers: { budget: 3, types: [['rustling', 2], ['skeleton', 1]], at: [[10, 2], [18, 2], [11, 14]] },\n  wires: [\n    { when: { catch: 'SW2' }, once: true, do: [['teleporter', 'TP1', false], ['msg', 'Something clicks deep in the wall. The air in the corridor stills.'], ['xpSecret']] },\n    { when: { levers: ['LA', 'LB', 'LC'], is: [false, true, false] }, once: true, do: [['open', 'G5'], ['msg', 'The tumblers fall into place. A gate rises.'], ['story', 'durgan2']], fail: [['sfx', 'tumblers'], ['msg', 'Somewhere inside the wall, tumblers clatter and reset.']] },\n    { when: { plate: 'P2' }, once: true, do: [['bridge', 'O1'], ['msg', 'A stone bridge grinds up out of the pit.']] },\n    { when: { alcove: 'AL3', kind: 'key' }, do: [['return'], ['open', 'G6'], ['msg', 'The alcove takes the key, turns it, and gives it back. Far off, a gate rises.']] },\n    { when: { plates: ['P3', 'P4'] }, once: true, do: [['open', 'G7'], ['msg', 'With a loud CLACK, the gate locks open.']] },\n    { when: { gears: ['CN1', 'CN2', 'CN3', 'CN4'] }, once: true, do: [['clock'], ['special', 'sq2'], ['give', 'tumblerwrightsGoggles', 'CF'], ['msg', 'The Great Clock chimes the hour. A little door in its face swings open.']] },\n    { when: { killed: ['sentinel'] }, once: true, do: [['story', 'ysolde2']] }],\n  events: [\n    { area: [16, 1, 20, 4], once: true, do: [['story', 'ysolde1']] },\n    { at: [11, 13], once: true, do: [['story', 'durgan1']] },\n    { at: [4, 14], once: true, do: [['msg', 'The floor ahead is broken away into darkness.']] }],\n  hints: [{ loops: 'TP1', n: 2, text: 'teleport' }, { loops: 'TP1', n: 4, story: 'ysoldeHint' }],\n  waypoints: [['F2 Landing', 2, 1, 1], ['F2 Workshop', 10, 2, 1], ['F2 Clock Hall', 18, 3, 0], ['F2 Endless Hall', 19, 7, 2], ['F2 Spinner Room', 17, 13, 1], ['F2 Lock Room', 11, 14, 2], ['F2 Pit Run', 4, 14, 0], ['F2 Weight Hall', 3, 6, 0], ['F2 Vault', 12, 7, 0]]\n};\nB.FLOORS.f3 = {\n  name: 'The Gloam Deeps', music: 'gloam', step: 'stepDust', depth: 3,\n  look: { ground: '#2a2434', dark: '#1a1622', light: '#3a3248', wall: '#2e2838', side: 'block', fog: '#040306', near: 20, far: 130, amb: ['#3a3a5a', '#141220', 2.2] },\n  map: [\n    '########################',\n    '#<########....#.......##',\n    '#@########....#.......##',\n    '#.########............##',\n    '#.....####....#.......##',\n    '#.....######U##.......##',\n    '#.....######>######L####',\n    '#.....###.###.###.#.####',\n    '#...................####',\n    '###########.#######.####',\n    '#########.....##.......#',\n    '#########.....##.......#',\n    '#############=#######=##',\n    '#############.H........#',\n    '#...################...#',\n    '#.*.####################',\n    '#<..####################',\n    '########################'],\n  start: [1, 2, 2],\n  doors: { L3: { at: [19, 6], key: 'boneKey', kind: 'warded' }, G8: { at: [13, 12] }, G9: { at: [21, 12] }, U1: { at: [12, 5], undergate: true } },\n  secrets: { H2: [14, 13] },\n  stairs: { '1,1': { to: 'f2', at: [13, 8, 3] }, '12,6': { to: 'f4', at: [6, 11, 0] }, '1,16': { to: 'f2', at: [6, 10, 2] } },\n  arrive: { f4: [12, 4, 0] },\n  safe: [[13, 13]],\n  features: [\n    ['N8', 'inscription', 3, 4, 'N', { text: 'HERE LIE THE EYELESS, WHO SAW TRUE.' }],\n    ['C1', 'candle', 16, 1, 'N'], ['C2', 'candle', 16, 5, 'S'], ['C3', 'candle', 18, 1, 'N'], ['C4', 'candle', 18, 5, 'S'], ['C5', 'candle', 20, 1, 'N'], ['C6', 'candle', 20, 5, 'S'],\n    ['N9', 'inscription', 11, 4, 'S', { text: 'HERE THE GUILD SET ITS WATCHER. COPPER, BRASS AND IRON: THREE WARDS FOR ONE GATE.' }],\n    ['UG', 'undergate', 12, 4, 'S'], ['LV3', 'lever', 13, 11, 'E'], ['LV4', 'lever', 22, 10, 'N'], ['AL5', 'alcove', 22, 14, '