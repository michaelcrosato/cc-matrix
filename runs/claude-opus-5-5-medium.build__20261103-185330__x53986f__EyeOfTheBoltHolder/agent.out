       const better = !cur || (d.def || 0) > (cur.def || 0) || (d.seeing && !cur.seeing && (cur.def || 0) === 0) || (d.int && !cur.int);","-        if (slot === 'off' && m.slots.off && B.def(m.slots.off).kind !== 'shield') continue;","-        if (better) { B.dispatch({ c: 'equip', m: P.members.indexOf(m), uid: f.it.uid, slot }); }","-      }","-      if (P.members.length > 4 || true) this.arrangeLater = true;","-      if (B.rowOf(m) === 1) for (const f of this.packItems()) { const d = B.def(f.it), cur = B.def(m.slots.main); if (d.kind === 'weapon' && !d.two && !d.throw && cur && cur.kind === 'weapon' && B.diceAvg(d.dmg) + (d.hit || 0) > B.diceAvg(cur.dmg) + (cur.hit || 0) + (m.slots.main.rust ? -m.slots.main.rust : 0) && !B.canEquip(m, f.it, 'main')) B.dispatch({ c: 'equip', m: P.members.indexOf(m), uid: f.it.uid, slot: 'main' }); }","-    }","-    return cmds;","-  },","-  /** the sturdiest fighters in front; back-row members with a bow or crossbow take it up */","-  arrange() {","-    const P = B.S.party, F = P.formation, score = i => { const m = P.members[i]; if (!m || m.state !== 'ok') return -1; return m.max * (['F', 'P'].includes(m.cls) ? 1.4 : m.cls === 'R' ? 1.1 : m.cls === 'M' ? .3 : .8); };","-    const order = F.slice().sort((a, b) => score(b) - score(a));","-    if (order.slice(0, 2).some(i => F.indexOf(i) > 1)) { for (let k = 0; k < order.length; k++) if (F[k] !== order[k]) { const j = F.indexOf(order[k]); B.dispatch({ c: 'formation', a: k, b: j }); } }","-    for (const m of P.members) {","-      if (m.state !== 'ok' || B.rowOf(m) === 1) continue;","-      const main = B.def(m.slots.main); if (main && (main.kind === 'missile' || main.reach || main.kind === 'book' || main.kind === 'symbol')) continue;","-      if (B.casterKind(m)) continue;","-      const bow = this.packItems().find(f => { const d = B.def(f.it); return d.kind === 'missile' && (m.slots.quiver && m.slots.quiver.id === d.ammo || B.countItem(d.ammo) > 0) && !B.canEquip(m, f.it, 'main') || (d.kind === 'missile' && d.two && m.slots.off && !B.canEquip(m, f.it, 'off') === false); });","-      if (!bow) continue; const d = B.def(bow.it);","-      if (m.slots.off) { const off = m.slots.off; delete m.slots.off; B.giveParty(off); }","-      if (B.canEquip(m, bow.it, 'main')) continue;","-      B.dispatch({ c: 'equip', m: P.members.indexOf(m), uid: bow.it.uid, slot: 'main' });","-      if (!m.slots.quiver || m.slots.quiver.id !== d.ammo) { const am = B.findItem(it => it.id === d.ammo); if (am && am.where === 'pack') { B.removeFound(am); if (m.slots.quiver) B.giveParty(m.slots.quiver); m.slots.quiver = am.it; } }","-    }","-  },","-  packItems() { const out = []; for (const m of B.S.party.members) for (let i = 0; i < 12; i++) if (m.pack[i]) out.push({ m, i, it: m.pack[i] }); return out; },","-  /** the boss: turn the three locks between attacks, fight the Eye, turn the relocked lock again */","-  bossStep() {","-    const S = B.S, P = S.party, mon = B.bossMon();","-    if (!mon || mon.hp <= 0) { this.next(); return null; }","-    const hl = this.heal(true) || this.healBoss(); if (hl) return hl;","-    const b = mon.boss, spots = { 0: [3, 3, 'W'], 1: [9, 3, 'E'], 2: [6, 1, 'N'] };","-    const lockI = b.locks.findIndex(v => !v);","-    if (b.tele && b.tele.cells.some(([x, y]) => x === P.cx && y === P.cy)) {   // dodge: a step out of the marked cells or the line","-      for (const rel of ['l', 'r', 'b', 'f']) { const d = B.relDir(P.dir, rel), nx = P.cx + DX[d], ny = P.cy + DY[d]; if (B.open('f4', nx, ny) && !B.monsAt(nx, ny).length && !b.tele.cells.some(([x, y]) => x === nx && y === ny) && !(nx === mon.cx && ny === mon.cy)) return [{ c: 'move', d: rel }]; }","-    }","-    if (lockI >= 0) { const [x, y, f] = spots[lockI]; if (P.cx !== x || P.cy !== y) return this.moveToward(x, y); if (P.dir !== FACE[f]) return this.faceTo(FACE[f]); return [{ c: 'use' }]; }","-    const d = B.manh(mon.cx, mon.cy, P.cx, P.cy);","-    if (d === 1) { const want = B.dirTo(P.cx, P.cy, mon.cx, mon.cy); if (P.dir !== want) return this.faceTo(want); const out = [{ c: 'strike' }]; const sp = this.spell(['blazingOrb', 'sparkDart', 'frostbite']); if (sp) out.push(sp); return out; }","-    if (B.inLineClear(P.cx, P.cy, mon.cx, mon.cy, 6)) { const sp = this.spell(['blazingOrb', 'sparkDart']); if (sp) { const want = B.dirTo(P.cx, P.cy, mon.cx, mon.cy); return P.dir !== want ? this.faceTo(want) : [sp]; } }","-    const adj = [0, 1, 2, 3].map(k => [mon.cx + DX[k], mon.cy + DY[k]]).filter(([x, y]) => B.open('f4', x, y) && !B.monsAt(x, y).length).sort((p, q) => B.manh(p[0], p[1], P.cx, P.cy) - B.manh(q[0], q[1], P.cx, P.cy))[0];","-    return adj ? this.moveToward(adj[0], adj[1]) : [];","-  }","-};","-/** run the bot headlessly on the sim alone (tests): steps of 1/120 s until the plan is done or time runs out */","-B.runBot = (o = {}, maxSeconds = 3600) => {","-  B.Bot.start(o); const dt = 1 / 120; let t = 0;","-  while (B.Bot.active && t < maxSeconds && !B.S.over) { const cmds = B.Bot.step(dt); B.update(dt, cmds); B.drain(); t += dt; if (o.until && o.until()) break; }","-  return { t, done: B.Bot.done, stuck: B.Bot.stuck, log: B.Bot.log, over: B.S.over };","-};"]}],"deleted":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-185330__x53986f/work/EyeOfTheBoltHolder-EyeOfTheBeholder1991-claude-opus-5-5-medium-20261103-185330/tests/botrun.mjs","hunks":[{"oldStart":2,"oldLines":7,"newStart":2,"newLines":7,"lines":[" const here = new URL('..', import.meta.url).pathname;"," const ctx = { console }; ctx.window = ctx; vm.createContext(ctx);"," vm.runInContext(readFileSync(here + 'engine/my-3d2dge.js', 'utf8'), ctx);","-const files = readdirSync(here + 'src').filter(f => f.endsWith('.js') && (f < '32' || f === '72-bot.js')).sort();","+const files = readdirSync(here + 'src').filter(f => f.endsWith('.js') && (f < '32' || f === '69-bot.js')).sort();"," vm.runInContext('(()=>{' + files.map(f => readFileSync(here + 'src/' + f, 'utf