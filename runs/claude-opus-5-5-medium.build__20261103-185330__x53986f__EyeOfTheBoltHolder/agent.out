'\\ndef edit(p, pairs):\\n    s=open(p, encoding='utf-8').read()\\n    for old,new in pairs:\\n        n=s.count(old); assert n==1,(p,n,old[:70]); s=s.replace(old,new)\\n    open(p,'w', encoding='utf-8').write(s)\\nedit('engine/my-3d2dge.js',[\\n(\\\"\\\"\\\"    el.addEventListener('wheel', e => {\\n      if (!this._wheelOn) return; e.preventDefault();\\\"\\\"\\\",\\\"\\\"\\\"    el.addEventListener('wheel', e => {\\n      if (e.deltaY) (this._wheelQ || (this._wheelQ = [])).push(e.deltaY < 0 ? 'WheelUp' : 'WheelDown');\\n      if (!this._wheelOn) return; e.preventDefault();\\\"\\\"\\\"),\\n(\\\"\\\"\\\"  tick(dt) {\\n    this._suppressed.clear();\\n    this.clock += dt;\\\"\\\"\\\",\\\"\\\"\\\"  tick(dt) {\\n    this._suppressed.clear();\\n    this.clock += dt;\\n    // mouse wheel notches (patch 2): each is a press of 'WheelUp' or 'WheelDown' for one step\\n    if (this._wheelHeld) { for (const c of this._wheelHeld) this.release(c); this._wheelHeld = null; }\\n    if (this._wheelQ && this._wheelQ.length) { this._wheelHeld = [this._wheelQ[0]]; this._wheelQ = []; for (const c of this._wheelHeld) this.press(c); }\\\"\\\"\\\"),\\n(\\\"\\\"\\\"  codeLabel(code) {\\\"\\\"\\\",\\\"\\\"\\\"  codeLabel(code) {\\n    if (code === 'WheelUp') return 'Wheel up';\\n    if (code === 'WheelDown') return 'Wheel down';\\\"\\\"\\\"),\\n])\\nopen('engine/PATCHES.md','a',encoding='utf-8').write(\\\"\\\"\\\"2. **Mouse-wheel codes.** The canvas `wheel` listener queues `'WheelUp'` or `'WheelDown'` per notch (also when the\\n   camera zoom is off); `tick` presses the queued code for one step and releases it on the next. `codeLabel` gives\\n   \\\"Wheel up\\\" and \\\"Wheel down\\\". The play presets bind them to previous and next weapon (TASK.md: wheel for weapon\\n   switching is in the plan's controls table).\\n\\\"\\\"\\\")\\nprint('engine ok')\\nEOF\\necho ---; python3 -I - <<'EOF'\\ndef edit(p, pairs):\\n    s=open(p).read()\\n    for old,new in pairs:\\n        n=s.count(old); assert n==1,(p,n,old[:70]); s=s.replace(old,new)\\n    open(p,'w').write(s)\\nedit('src/00-core.js',[(\\\"    fov: 55, hitVolumes: false, colliders: false, aiLabels: false, threatDebug: false, hideHud: false, threatBig: false,\\\",\\n\\\"    fov: 55, hitVolumes: false, colliders: false, aiLabels: false, threatDebug: false, perf: false, hideHud: false, threatBig: false,\\\")])\\nedit('src/44-dev.js',[(\\\"      { t: 'toggle', path: 'view.threatDebug', label: 'Show threat timers' },\\\",\\n\\\"\\\"\\\"      { t: 'toggle', path: 'view.threatDebug', label: 'Show threat timers' },\\n      { t: 'toggle', path: 'view.perf', label: 'Show performance readout' },\\\"\\\"\\\")])\\nedit('src/52-devview.js',[\\n(\\\"\\\"\\\"  if (!v.hitVolumes && !v.colliders && !v.aiLabels && !v.threatDebug) return;\\\"\\\"\\\",\\n\\\"\\\"\\\"  if (v.perf && vp.i === 0) {\\n    const ms = play.frameMs || 0;\\n    const lines = ['FRAME ' + ms.toFixed(1) + ' MS (' + (ms > 0 ? Math.round(1000 / ms) : 0) + ' FPS)', 'ENEMIES ' + play.sim.enemies.length, 'THREATS ' + play.sim.threats.length, 'BOXES ' + play.world.boxes.length, 'PROJECTILES ' + play.sim.projectiles.length];\\n    lines.forEach((ln, i) => TC.text(g, ln, vp.x + 4, vp.y + 88 + i * 8, '#9fffb0', { scale: 1 }));\\n  }\\n  if (!v.hitVolumes && !v.colliders && !v.aiLabels && !v.threatDebug) return;\\\"\\\"\\\"),\\n])\\nedit('src/41-play.js',[\\n(\\\"\\\"\\\"  update(dt) {\\n    const tg = TC.tune.time.gameSpeed || 1;\\n    this.time += dt;\\\"\\\"\\\",\\\"\\\"\\\"  update(dt) {\\n    const tg = TC.tune.time.gameSpeed || 1;\\n    this.time += dt;\\n    // The wall-clock cost of the last frame, for the performance readout (presentation only).\\n    const now = (typeof performance !== 'undefined') ? performance.now() : 0;\\n    if (this.lastNow) this.frameMs = now - this.lastNow;\\n    this.lastNow = now;\\\"\\\"\\\"),\\n(\\\"\\\"\\\"        if (TC.Hub.lastSnap) TC.Hub.applySnap(this, TC.Hub.lastSnap.snap);\\\"\\\"\\\",\\\"\\\"\\\"        if (TC.Hub.