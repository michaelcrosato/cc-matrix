5, 400); await ph.waitForTimeout(800); say(await ph.evaluate(() => B.game.sceneName) === 'title', 'phone: a touch returns to the title (notice shown again)');\nawait ctx.close(); await b.close();\nconst films = readdirSync(shots).filter(f => f.startsWith('film-1920-'));\nsay(films.length === 7 && films.every(f => statSync(shots + f).size > 20000), '1920x1080 filmstrips: ' + films.join(', '));\nEOF\ntimeout 300 node tests/browser/evidence.mjs","description":"Print browser evidence for glyphs, touch and filmstrips","timeout":320000}}}
