umbler', step: 'stepGrate', depth: 2,\n  look: { ground: '#5a4a3a', dark: '#3e3228', light: '#7a6450', wall: '#6a5a48', side: 'block', fog: '#0a0806', near: 40, far: 220, amb: ['#7a6048', '#2a2018', 3.0] },\n  map: [\n    '######################',\n    '#<@..........###.....#',\n    '#...####.....K.......#',\n    '########.....###.....#',\n    '#.....##########.....#',\n    '#.P.P.=...#....####.##',\n    '#.....#...M....####.##',\n    '#.....#...#....####.##',\n    '##=########...>####.##',\n    '##..P##############.##',\n    '####.o.############.##',\n    '####O#.####.#######^##',\n    '####.#.####=#######.##',\n    '####.#.##.....###....#',\n    '####............+.S..#',\n    '#########.....###....#',\n    '######################'],\n  start: [2, 1, 1],\n  doors: { K1: { at: [13, 2], key: 'gearKey', kind: 'warded' }, G5: { at: [11, 12] }, G6: { at: [2, 8] }, G7: { at: [6, 5] }, M1: { at: [10, 6], seal: true }, D3: { at: [16, 14] } },\n  plates: { P2: { at: [4, 9], mode: 'latch' }, P3: { at: [2, 5], mode: 'latch' }, P4: { at: [4, 5], mode: 'latch' } },\n  pits: { O1: { at: [4, 11] }, O2: { at: [5, 10], trapdoor: true } },\n  fall: { to: 'f3', at: [2, 15, 0] },\n  teleports: { TP1: { at: [19, 11], to: [19, 5, 2], silent: true } },\n  stairs: { '1,1': { to: 'f1', at: [15, 13, 0] }, '14,8': { to: 'f3', at: [1, 2, 2] } },\n  arrive: { f3: [13, 8, 3] },\n  safe: [[11, 11]],\n  features: [\n    ['N5', 'inscription', 8, 3, 'S', { text: \"THE TUMBLERWRIGHT'S CREED: THE FIRST FALLS. THE SECOND RISES. THE THIRD FALLS.\" }],\n    ['CN1', 'gearNiche', 16, 1, 'N'], ['CN2', 'gearNiche', 17, 1, 'N'], ['CF', 'clockFace', 18, 1, 'N'], ['CN3', 'gearNiche', 19, 1, 'N'], ['CN4', 'gearNiche', 20, 1, 'N'],\n    ['AL2', 'alcove', 19, 6, 'W', { holds: ['tumblerGear'] }], ['SW2', 'catch', 19, 8, 'E', { rivet: true }],\n    ['LA', 'lever', 10, 15, 'S', { up: true }], ['LB', 'lever', 11, 15, 'S', { up: true }], ['LC', 'lever', 12, 15, 'S', { up: true }],\n    ['N6', 'inscription', 3, 9, 'N',