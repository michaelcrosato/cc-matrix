'U1'], ['story', 'undergate'], ['music', 'gate']] }],\n  events: [{ at: [6, 8], once: true, do: [['msg', 'Pale lights flicker at the far end of the hall.']] }, { at: [15, 3], once: true, do: [['msg', 'Six empty sconces ring a black altar.']] }],\n  waypoints: [['F3 Ossuary', 3, 6, 0], ['F3 Gauntlet', 6, 8, 1], ['F3 Chapel', 18, 4, 0], ['F3 Undergate', 12, 3, 2], ['F3 Penance', 11, 10, 0], ['F3 Barracks', 19, 10, 2], ['F3 Sump', 2, 15, 0]]\n};\nB.FLOORS.f4 = {\n  name: \"The Eye's Vault\", music: 'vault', step: 'stepStone', depth: 4,\n  look: { ground: '#3a3e46', dark: '#2a2e36', light: '#4a4e58', wall: '#30343c', side: 'block', fog: '#020204', near: 30, far: 200, amb: ['#2a3040', '#0c0e14', 2.0], runes: true },\n  map: [\n    '#############',\n    '###.......###',\n    '###.#...#.###',\n    '###...B...###',\n    '###.#...#.###',\n    '###.......###',\n    '######=######',\n    '####.....####',\n    '####.....####',\n    '######.######',\n    '######.######',\n    '######@######',\n    '######<######',\n    '#############'],\n  start: [6, 11, 0],\n  doors: { G10: { at: [6, 6] } },\n  stairs: { '6,12': { to: 'f3', at: [12, 4, 0] } },\n  noRest: true,\n  features: [['N10', 'inscription', 4, 8, 'W', { text: 'BEYOND WAKES THE WATCHER. TURN ITS LOCKS, AND IT IS BLIND.' }],\n    ['GL1', 'greatLock', 3, 3, 'W'], ['GL2', 'greatLock', 9, 3, 'E'], ['GL3', 'greatLock', 6, 1, 'N'],\n    ['t1', 'torch', 8, 7, 'E'], ['t2', 'torch', 4, 7, 'W']],\n  items: [],\n  mons: [['gazer', 6, 9, 2], ['golem', 5, 7, 1, { id: 'golemA', drop: 'potionGreaterHealing' }], ['golem', 7, 7, 1, { id: 'golemB' }], ['boltholder', 6, 3, 1, { id: 'boss' }]],\n  wires: [{ when: { killed: ['golemA', 'golemB'] }, once: true, do: [['open', 'G10'], ['msg', 'The Vault Door grinds open.']] }],\n  events: [{ at: [6, 5], once: true, do: [['bossWake']] }],\n  waypoints: [['F4 Approach', 6, 10, 0], ['F4 Antechamber', 6, 8, 0], ['F4 Arena', 6, 5, 0]]\n};\nB.FLOORS.race = {\n  name: 'The Rat Run', music: 'race', step: 'stepWet', depth: 1, race: true,\n  look: { ground: '#3e4a44', dark: '#2a332f', light: '#55615a', wall: '#4a5048', side: 'brick', fog: '#06080a', near: 30, far: 170, amb: ['#5a6a6a', '#1a201e', 3.0] },\n  map: [\n    '##############',\n    '#....L...###>#',\n    '#....###.###.#',\n    '#....###.###.#',\n    '#....###.###=#',\n    '#....###.P...#',\n    '#=######.....#',\n    '#.#.##.#######',\n    '#.#.##.#######',\n    '#......#######',\n    '#@############',\n    '##############'],\n  start: [1, 10, 0],\n  doors: { RG1: { at: [1, 6] }, RL: { at: [5, 1], key: 'ironKey', kind: 'simple' }, RG2: { at: [12, 4] } },\n  plates: { RP: { at: [9, 5], mode: 'hold' } },\n  stairs: { '12,1': { exit: true } },\n  features: [['RLV', 'lever', 1, 8, 'E'], ['RAL', 'alcove', 1, 2, 'W', { holds: ['ironKey'] }], ['t1', 'torch', 4, 1, 'N'], ['t2', 'torch', 12, 6, 'S'], ['t3', 'torch', 6, 9, 'S']],\n  items: [[11, 6, 'rock'], [3, 7, 'ratCrown'], [6, 7, 'ratCrown'], [4, 9, 'ratCrown'], [1, 1, 'ratCrown'], [4, 5, 'ratCrown'], [10, 6, 'ratCrown']],\n  mons: [['rat', 3, 3, 3], ['rat', 2, 5, 2], ['latchkin', 8, 3, 2], ['rat', 5, 9, 2]],\n  wires: [{ when: { lever: 'RLV' }, once: true, do: [['open', 'RG1'], ['race', 'Gate open']] }, { when: { plate: 'RP' }, mode: 'hold', do: [['open', 'RG2']], undo: [['close', 'RG2']] },\n    { when: { plate: 'RP' }, once: true, do: [['race', 'Plate held']] }, { when: { opened: 'RL' }, once: true, do: [['race', 'Door open']] }],\n  events: [],\n  waypoints: [['Rat Run', 1, 10, 0]]\n};\nB.FLOOR_ORDER = ['f1', 'f2', 'f3', 'f4'];\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01BfA6aUTh9UKFdeWJTfBvn1","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
