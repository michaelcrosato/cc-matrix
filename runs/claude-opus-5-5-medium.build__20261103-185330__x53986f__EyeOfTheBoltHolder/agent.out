eTo(FACE[c]); const [fx, fy] = B.front(), d = B.doorIn(S.floor, fx, fy); if (!d || d[1].want) { this.next(); return null; } return [{ c: 'use' }]; }","-      case 'grabAt': {","-        if (P.hand) return [{ c: 'stow' }];","-        if (!B.itemsAt(a, b).length) { this.next(); this.equip(); return null; }","-        if (P.cx !== a || P.cy !== b) return this.moveToward(a, b);","-        return [{ c: 'pick', here: true }];","-      }","-      case 'loot': {","-        if (P.hand) return [{ c: 'stow' }];","-        const cells = Object.entries(B.FS().items).filter(([k, l]) => l.some(it => !['rock', 'bone', 'ironIngot', 'slingStones'].includes(it.id))).map(([k]) => k.split(',').map(Number)).filter(([x, y]) => B.manh(x, y, P.cx, P.cy) <= a && this.path(x, y));","-        if (!cells.length) { this.next(); this.equip(); return null; }","-        const [x, y] = cells.sort((p, q) => B.manh(p[0], p[1], P.cx, P.cy) - B.manh(q[0], q[1], P.cx, P.cy))[0];","-        if (P.cx !== x || P.cy !== y) return this.moveToward(x, y);","-        const list = B.itemsAt(x, y), top = list[list.length - 1];","-        if (['rock', 'bone', 'ironIngot', 'slingStones'].includes(top.id)) { B.FS().items[key(x, y)] = [top, ...list.slice(0, -1)]; return null; }","-        return [{ c: 'pick', here: true }];","-      }","-      case 'hold': { this.next(); if (P.hand && P.hand.id === a) return null; return P.hand ? [{ c: 'stow' }, { c: 'toHand', id: a }] : [{ c: 'toHand', id: a }]; }","-      case 'stow': this.next(); return P.hand ? [{ c: 'stow' }] : null;","-      case 'put': this.next(); return [{ c: 'putDown' }];","-      case 'throw': this.next(); return [{ c: 'throw' }];","-      case 'zap': this.next(); return [{ c: 'useItem', id: a }];","-      case 'wait': if (this.t >= a) this.next(); return null;","-      case 'clear': { if (this.t > .6 && !this.foes(7).length) { this.next(); return null; } return this.huntNearest(); }","-      case 'rest': case 'rest4': { const live = P.members.filter(m => m