'#3a2a4a', '#1a1028'], border: this.chosen === id ? '#ffd060' : '#4a3a5a' });","-          E.font.text(g, locked ? '?' : KC.DATA.roster[id].short, x + 28, y + 10, locked ? '#5a5a6a' : '#fff6d0', { align: 'center', outline: '#0b0814', font: 'tiny' });","+        this.ids.forEach((id, i) => {","+          const x = 20 + (i % 5) * 62, y = 230 + Math.floor(i / 5) * 36;","+          const on = i === this.p1 || i === this.p2;","+          E.ui.box(g, x, y, 56, 30, { bg: ['#3a2a4a', '#1a1028'], border: on ? '#ffd060' : '#4a3a5a' });","+          E.font.text(g, KC.DATA.roster[id].short, x + 28, y + 10, '#fff6d0', { align: 'center', outline: '#0b0814', font: 'tiny' });","         });","       });","       this.menu.draw(r);","     }","   };","-  KC.versusData = (w, r, st) => ({ mode: 'versus', w, r, stage: st.id, roundsToWin: 2, pointsToWin: KC.TUNE.pointsToWin, cpuW: false, cpuR: true, p2: 'cpu' });","+  KC.versusData = (w, r, st, p2) => ({ mode: 'versus', w, r, stage: st.id, roundsToWin: 2, pointsToWin: KC.TUNE.pointsToWin, cpuW: false, cpuR: p2 !== 'keys', p2: p2 || 'cpu' });"," ","   // ------------------------------------------------ the dojo: lessons and free spar (7.5), and the move list (8.6)","   S.dojo = {"]},{"oldStart":1532,"oldLines":7,"newStart":1547,"newLines":7,"lines":["     rigs: { w: KC.View.rigFor(wId, 'w'), r: KC.View.rigFor(rId, 'r') },","     judge: KC.View.rigFor('genkotsu', 'w', '#1d2b52'),","     aiW: new KC.KarateAI(w, seed + 11, { level: lvl(wId) }), aiR: new KC.KarateAI(r, seed + 23, { level: lvl(rId) }),","-    prevW: {}, prevR: {}, popup: null, hint: null, p2Input: null, node: d.node, onEnd: d.onEnd || null","+    prevW: {}, prevR: {}, popup: null, hint: null, p2Input: null, p2: d.p2 || 'cpu', node: d.node, onEnd: d.onEnd || null","   };","   F.bout = new KC.Bout({ white: w, red: r, seed, roundsToWin: d.roundsToWin || KC.TUNE.roundsToWin, pointsToWin: d.pointsToWin || KC.TUNE.pointsToWin, intro: d.intro !== false });","   F.bout.on('point', (p) => { F.popup = { t: 1.2, text: (p.full ? 'FULL' : 'HALF') + (p.counter ? ' COUNTER' : '') + ' · ' + KC.DATA.techniques[p.tech].name + ' ' + p.pts, color: p.full ? '#ffe070' : '#ffffff' }; KC.A.sfx(KC.game, p.full ? 'thwackFull' : 'thwackHalf'); if (p.full) KC.game.flash('#ffffff', 0.08); KC.game.shake(p.full ? 4 : 2); });"]},{"oldStart":2224,"oldLines":6,"newStart":2239,"newLines":73,"lines":["   };"," };"," ","+// ---- src/66-kach.js","+// ---------------------------------------------------------------- local Kachinuki (9, 12.1): 2-4 seats on one machine, the winner stays on","+// Seat 0 is the keyboard player; the other seats are CPU rivals. The queue rotates: the winner stays, the loser goes to the back.","+// The first to 5 bout wins is the champion.","+KC.makeKach = (game, S) => {","+  const K = { seats: 2, queue: [], wins: [], ids: [], bout: null, a: null, b: null, rigs: {}, boutN: 0, over: false, popup: null, t: 0, champion: null };","+  KC.kach = K;","+  const boutStart = () => {","+    if (K.queue.length < 2) return;","+    const aSeat = K.queue[0], bSeat = K.queue[1];","+    K.a = new KC.Karateka({ id: K.ids[aSeat], side: 'w' }); K.b = new KC.Karateka({ id: K.ids[bSeat], side: 'r' });","+    K.aSeat = aSeat; K.bSeat = bSeat;","+    const seed = 500 + K.boutN * 31;","+    K.bout = new KC.Bout({ white: K.a, red: K.b, seed, roundsToWin: 1, pointsToWin: 2, intro: true });","+    K.boutN++;","+    K.aiA = aSeat === 0 ? null : new KC.KarateAI(K.a, seed + 3, { level: KC.DATA.roster[K.ids[aSeat]].ai.level });","+    K.aiB = bSeat === 0 ? null : new KC.KarateAI(K.b, seed + 5, { level: KC.DATA.roster[K.ids[bSeat]].ai.level });","+    K.rigs = { w: KC.View.rigFor(K.ids[aSeat], 'w'), r: KC.View.rigFor(K.ids[bSeat], 'r') };","+    K.bout.on('point', (p) => { K.popup = { t: 1.2, text: (p.full ? 'FULL' : 'HALF') + ' · ' + KC.DATA.techniques[p.tech].name + ' ' + p.pts, color: p.full ? '#ffe070' : '#ffffff' }; });","+    K.bout.on('aiuchi', () => { K.popup = { t: 1, text: 'AIUCHI! NO POINT', color: '#ffffff' }; });","+  };","+  const boutEnd = () => {","+    const side = K.bout.matchOver;","+    const winSeat = side === 0 ? K.aSeat : K.bSeat, loseSeat = side === 0 ? K.bSeat : K.aSeat;","+    K.wins[winSeat]++;","+    K.queue = [winSeat].concat(K.queue.slice(2), [loseSeat]);","+    K.bout = null;","+    if (K.wins[winSeat] >= 5) { K.over = true; K.champion = winSeat; return; }","+    K.nextAt = K.t + 2.5;","+  };","+  S.kach = {","+    pausable: false,","+    enter(data) {","+      K.seats = data.seats || 2; K.ids = data.roster.slice(0, K.seats); K.stage = KC.DATA.stages[data.stage] || KC.DATA.stages.dojo;","+      K.queue = K.ids.map((_, i) => i); K.wins = K.ids.map(() => 0); K.boutN = 0; K.over = false; K.t = 0; K.champion = null; K.nextAt = 0;","+      K.prev = {};","+      boutStart(); KC.A.music(game, K.stage.music);","+    },","+    update(d) {","+      K.t += d; game.focus(200, 0, 30);","+      if (K.over) { if (game.input.pressed('confirm')) return game.go('title'); return; }","+      if (!K.bout) { if (K.t >= K.nextAt) boutStart(); return; }","+      const dirA = K.a.x < K.b.x ? 1 : -1, dirB = -dirA;","+      const iA = K.aiA ? K.aiA.intent(K.b, d) : KC.readControl(game.input, dirA, K.prev);","+      const iB = K.aiB ? K.aiB.intent(K.a, d) : { posture: 'n', tech: null };","+      K.bout.step(d, { a: () => iA, b: () => iB });","+      KC.stepPoses({ w: K.a, r: K.b, rigs: K.rigs }, d);","+      if (K.popup && K.popup.t > 0) K.popup.t -= d;","+      if (K.bout.phase === 'matchEnd' && K.bout.phaseT > K.bout.phaseLen - 0.01) boutEnd();","+    },","+    draw(r) {","+      KC.View.drawStage(r, K.stage, game.time);","+      if (K.bout) {","+        KC.View.drawFighters(r, [K.a, K.b], { w: K.rigs.w, r: K.rigs.r });","+        KC.View.hud(r, K.bout, { popup: K.popup ? Object.assign({ x: r.W / 2, y: r.H * 0.6 }, K.popup) : null });","+      }","+      r.overlay(g => {","+        E.ui.box(g, 6, r.H - 30, r.W - 12, 24, { bg: ['#1a1428', '#0e0a18'], border: '#c8a060' });","+        const parts = K.queue.map(seat => (seat === 0 ? 'YOU' : 'CPU ' + KC.DATA.roster[K.ids[seat]].short) + ' ' + K.wins[seat]);","+        E.font.text(g, 'KACHINUKI  ' + parts.join('  -  '), 12, r.H - 24, '#fff6d0', { outline: '#0b0814' });","+        if (K.over) E.font.title(g, (K.champion === 0 ? 'YOU ARE CHAMP' : 'CPU ' + KC.DATA.roster[K.ids[K.champion]].short + ' WINS') + '!', r.W / 2, r.H * 0.4, { scale: 2, colors: ['#fffbe8', '#ffe08a'], align: 'center', outline: '#0b0814' });","+        if (K.over) E.font.text(g, 'CROSS: TITLE', r.W / 2, r.H * 0.55, '#fff6d0', { align: 'center', outline: '#0b0814' });","+      });","+    }","+  };","+};","+"," // ---- src/70-dev.js"," // ---------------------------------------------------------------- dev mode (14): live sliders over KC.TUNE, toggles, warps, reset"," KC.DEV_SLIDERS = ["]},{"oldStart":2372,"oldLines":6,"newStart":2454,"newLines":7,"lines":[" KC.makeBonus(game, KC.S);"," KC.makeDev(game, KC.S);"," KC.makeOnline(game, KC.S);","+KC.makeKach(game, KC.S);"," // the ladder's VS card for story matches and the fight's retry data"," const wrapFight = KC.S.fight;"," KC.S.fight.enter = function (data) {"]}]},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184315__x1295cd/work/KarateChampon-KarateChamp1984-claude-haiku-5-5-medium-20261103-184315/src/40-scenes.js","hunks":[{"oldStart":560,"oldLines":7,"newStart":560,"newLines":7,"lines":["     rigs: { w: KC.View.rigFor(wId, 'w'), r: KC.View.rigFor(rId, 'r') },","     judge: KC.View.rigFor('genkotsu', 'w', '#1d2b52'),","     aiW: new KC.KarateAI(w, seed + 11, { level: lvl(wId) }), aiR: new KC.KarateAI(r, seed + 23, { level: lvl(rId) }),","-    prevW: {}, prevR: {}, popup: null, hint: null, p2Input: null, node: d.node, onEnd: d.onEnd || null","+    prevW: {}, prevR: {}, popup: null, hint: null, p2Input: null, p2: d.p2 || 'cpu', node: d.node, onEnd: d.onEnd || null","   };","   F.bout = new KC.Bout({