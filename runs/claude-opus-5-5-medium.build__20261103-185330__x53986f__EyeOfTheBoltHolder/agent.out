| P.members.some(m => m.state === 'ok' && m.food < 30); if\"\"\"\nassert a in s; s=s.replace(a,b)\nopen(p,'w').write(s)\nEOF\ntimeout 120 node tests/dbg3.mjs > /tmp/eotb_out.txt 2>&1; echo exit $?; grep -v \"drinks\\|mends\\|is mended\" /tmp/eotb_out.txt | head -60","description":"Fix bot boss targeting and rest criteria; rerun f4"}}}
