= B.pitIn(fid, x, y); if (pit && !pit.p.bridged && S.party.fx.float <= 0) return false;","-    if (!tgt && (c === 'S' || c === '<' || c === '>')) return false;","-    const tp = B.RF().tpAt[key(x, y)]; if (tp && B.FS().tps[tp].on && !tgt) return false;","-    return true;","-  },","-  path(tx, ty, avoidMons = true) {","-    if (avoidMons === true) { const p = this.path(tx, ty, 'strict'); if (p) return p; return this.path(tx, ty, false); }","-    const strict = avoidMons === 'strict';","-    const P = B.S.party, R = B.RF(), prev = new Map(), q = [[P.cx, P.cy]], k0 = key(P.cx, P.cy); prev.set(k0, null);","-    while (q.length) {","-      const [x, y] = q.shift(); if (x === tx && y === ty) break;","-      for (let d = 0; d < 4; d++) { const nx = x + DX[d], ny = y + DY[d], k = key(nx, ny); if (prev.has(k) || nx < 0 || ny < 0 || nx >= R.w || ny >= R.h) continue; if (!this.passable(nx, ny, tx, ty)) continue; if (strict && !(nx === tx && ny === ty) && B.monsAt(nx, ny).length) continue; prev.set(k, [x, y]); q.push([nx, ny]); }","-    }","-    if (!prev.has(key(tx, ty))) return null;","-    const out = []; let cur = [tx, ty]; while (cur) { out.unshift(cur); cur = prev.get(key(cur[0], cur[1])); } return out;","-  },","-  moveToward(tx, ty) {","-    const S = B.S, P = S.party, path = this.path(tx, ty);","-    if (!path || path.length < 2) { if (this.t > 3) { this.say('no path to ' + tx + ',' + ty); this.stuck = this.stuck || ['go', tx, ty]; this.next(); } return null; }","-    const [nx, ny] = path[1], d = B.dirTo(P.cx, P.cy, nx, ny);","-    const door = B.doorIn(S.floor, nx, ny);","-    if (door && door[1].open < .85) { if (door[1].want) return null; if (P.dir !== d) return this.faceTo(d); return [{ c: 'use' }]; }","-    if (B.monsAt(nx, ny).length) { if (P.dir !== d) return this.faceTo(d); return [{ c: 'strike' }]; }","-    const rel = (d - P.dir + 4) % 4;","-    if (rel === 0) return [{ c: 'move', d: 'f' }];","-    if (rel === 2 && path.length > 3) return this.faceTo(d);","-    return [{ c: 'move', d: ['f', 'r', 'b', 'l'][rel] }];","-  },","-  faceTo(d) { const P = B.S.party, rel = (d - P.dir + 4) % 4; if (!rel) return null; return [{ c: 'turn', s: rel === 3 ? -1 : 1 }]; },","-  /* ---- fighting ---- */","-  foes(r = 6) { const P = B.S.party; return B.FS().mons.filter(m => m.hp > 0 && (m.aware || B.manh(m.cx, m.cy, P.cx, P.cy) <= 1) && B.manh(m.cx, m.cy, P.cx, P.cy) <= r && m.type !== 'boltholder'); },","-  fight() {","-    const S = B.S, P = S.party, foes = this.foes(5); if (!foes.length) return null;","-    const heal = this.heal(true); if (heal) return heal;","-    const adj = foes.filter(m => B.manh(m.cx, m.cy, P.cx, P.cy) === 1);","-    const [fx, fy] = B.front();","-    if (adj.length) {","-      if (!adj.some(m => m.cx === fx && m.cy === fy)) return this.faceTo(B.dirTo(P.cx, P.cy, adj[0].cx, adj[0].cy));","-      const out = []; if (P.members.some(m => B.canAct(m) && m.cool.main <= 0)) out.push({ c: 'strike' });","-      const sp = this.spell(['blazingOrb', 'sparkDart', 'frostbite']); if (sp && adj.length && (adj.length > 1 || adj[0].max > 15)) out.push(sp);","-      if (P.members.some(m => B.canAct(m) && m.cool.off <= 0 && B.handAction(m, 'off') === 'melee' && B.colOf(m) >= 0 && B.rowOf(m) === 1)) P.members.forEach((m, i) => { if (B.canAct(m) && m.cool.off <= 0 && B.rowOf(m) === 1 && B.handAction(m, 'off') === 'melee') out.push({ c: 'hand', m: i, h: 'off' }); });","-      return out.length ? out : [];","-    }","-    // a foe down the line: darts of light; else let it come (a short wait), then go to it","-    const line = foes.find(m => B.inLineClear(P.cx, P.cy, m.cx, m.cy, 6) && B.dirTo(P.cx, P.cy, m.cx, m.cy) === P.dir);","-    if (line) { const sp = this.spell(['sparkDart', 'blazingOrb']); if (sp) return [sp]; }","-    const near = foes.sort((a, b) => B.manh(a.cx, a.cy, P.cx, P.cy) - B.manh(b.cx, b.cy, P.cx, P.cy))[0];","-    const anyLine = foes.find(m => B.inLineClear(P.cx, P.cy, m.cx, m.cy, 6));","-    if (anyLine && thi