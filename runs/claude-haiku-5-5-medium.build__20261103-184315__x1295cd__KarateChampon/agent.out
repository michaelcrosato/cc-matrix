{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh3TrzXfdcXh3eS5dciL","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1870,"cache_read_input_tokens":149620,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1870},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"14f34045-19a9-4c91-b4b0-8ef52e3ad772","uuid":"39e1dd9b-bbf8-4da1-910f-351ea8a697e4","timestamp":"2026-11-04T01:46:46.212Z","request_id":"req_011Cgh3TqsoCeUYYxj3BL9vL","thinking_duration_ms":48176,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh3TrzXfdcXh3eS5dciL","type":"message","role":"assistant","content":[{"type":"text","text":"The core data is in place. Next is the simulation, which is the most important part. It has the fighter state machine, technique timing, the hit and scoring rules from the plan (quality, counters, blocks, aiuchi), the bout phases, and the CPU AI. It's all plain JavaScript with no rendering, so tests can drive it headless."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1870,"cache_read_input_tokens":149620,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1870},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"14f34045-19a9-4c91-b4b0-8ef52e3ad772","uuid":"abc32f8d-8bde-4a74-957b-943311640877","timestamp":"2026-11-04T01:46:46.650Z","request_id":"req_011Cgh3TqsoCeUYYxj3BL9vL"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh3TrzXfdcXh3eS5dciL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011uxDR63UvAkbCrRNTSHYQT","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184315__x1295cd/work/KarateChampon-KarateChamp1984-claude-haiku-5-5-medium-20261103-184315/src/10-sim.js","content":"// ---------------------------------------------------------------- the fight simulation (no drawing; deterministic; 120 Hz steps)\n// Positions: x 0..400 (the arena), z is height. Directions in the sim are RELATIVE to the foe: 't' toward, 'a' away.\nKC.ARENA = { x0: 0, x1: 400, marks: [150, 250] };\nKC.BODY_W = 18;           // push box width: contact means a gap of 0\nKC.STEP = 1 / 120;\nKC.WALK_AWAY = 56;\n\n// a screen direction ('l' | 'r' | 'u' | 'd' | 'n') to a relative one for a fighter whose foe is on side foeDir (+1 right, -1 left)\nKC.relDir = (screen, foeDir) => {\n  if (screen === 'r') return foeDir > 0 ? 't' : 'a';\n  if (screen === 'l') return foeDir > 0 ? 'a' : 't';\n  return screen;\n};\nKC.screenDir = (rel, foeDir) => {\n  if (rel === 't') return foeDir > 0 ? 'r' : 'l';\n  if (rel === 'a') return foeDir > 0 ? 'l' : 'r';\n  return rel;\n};\n\n// the input of a human: posture from the left stick / WASD (held) and the technique from the press edges of the right stick\nKC.readControl = (input, foeDir, prev) => {\n  const held = (a) => input.down(a);\n  let px = 'n';\n  if (held('up') && !held('down')) px = 'u';\n  else if (held('down') && !held('up')) px = 'd';\n  else if (held('left') && !held('right')) px = 'l';\n  else if (held('right') && !held('left')) px = 'r';\n  // when jumping, the posture stays up; when crouching it stays down\n  const pad = input.padAim || null;\n  let edge = null;\n  if (input.pressed('tUp')) edge = 'u';\n  else if (input.pressed('tDown')) edge = 'd';\n  else if (input.pressed('tLeft')) edge = 'l';\n  else if (input.pressed('tRight')) edge = 'r';\n  // right stick (the DualSense's), read directly with a 4-way gate and hysteresis\n  if (pad && prev) {\n    const q = KC.quantize(pad[0], -pad[1]);  // stick y is down-positive; flip so up is up\n    if (q && q !== prev.padQ) edge = edge || q;\n    prev.padQ = q;\n  } else if (prev) prev.padQ = null;\n  const pr = (s) => (s === 'u' || s === 'd') ? s : KC.relDir(s, foeDir);\n  let rel = pr(px);\n  // a posture of 'n' (no left-stick direction) keeps neutral; a press of the right stick uses it\n  return { posture: rel === 'n' ? 'n' : rel, tech: edge ? (edge === 'u' || edge === 'd' ? edge : KC.relDir(edge, foeDir)) : null };\n};\n\n// Karateka: one fighter. Its control: intent = { posture, tech } in relative terms (t, a, u, d, n) and tech stick (u, t, d, a).\nKC.Karateka = class Karateka {\n  constructor(o) {\n    this.id = o.id; this.r = KC.DATA.roster[o.id]; this.side = o.side; this.ai = o.ai || null;\n    this.stats = Object.assign({ walk: 1, reach: 1, speed: 1 }, this.r.stats || {});\n    this.reset(true);\n    this.score = 0; this.hitsMade = { full: 0, half: 0, blocks: 0, counters: 0 }; this.best = null;\n    this.bestPts = 0;\n  }\n  reset(full) {\n    this.x = this.side === 'w' ? KC.ARENA.marks[0] : KC.ARENA.marks[1];\n    this.z = 0; this.vz = 0; this.vx = 0; this.facing = this.side === 'w' ? 1 : -1;\n    this.state = 'idle'; this.tech = null; this.guard = 0; this.stun = 0; this.downT = 0; this.crouch = false;\n    this.pending = null; this.pendingT = 0; this.recoilT = 0; this.flipping = false; this.lastDown = false; this.turn = 0;\n    this.lastTech = null; this.knocked = false; this.pose = null; this.spinT = 0;\n    if (full) this.flip = false;\n  }\n  get dir() { return this.side === 'w' ? 1 : -1; }\n  get airborne() { return this.z > 0.01 || this.vz > 0.01; }\n  // frames (60 Hz) to steps (120 Hz), scaled by this fighter's speed and the tuning\n  steps(frames) { return Math.max(1, Math.round(frames * 2 / (this.stats.speed * KC.TUNE.techSpeed))); }\n  // a technique's phase lengths (steps)\n  techSteps(id) {\n    const T = KC.DATA.techniques[id];\n    if (T.block) return { s: 1, a: Math.round(KC.TUNE.blockWindow * 2), r: 8 };\n    return { s: this.steps(T.f[0]), a: this.steps(T.f[1]), r: this.steps(T.f[2]) };\n  }\n  // start a technique (relative stick). posture is the rel posture at the press\n  startTech(id, posture) {\n    const T = KC.DATA.techniques[id], d = this.techSteps(id);\n    this.tech = { id, ph: 0, t: 0, s: d.s, a: d.a, r: d.r, hit: false, posture, upT: T.flip || T.air || T.block ? 0 : 8, startX: this.x, t0: 0, counterOpen: false };\n    this.lastTech = id;\n    this.state = 'tech';\n    if (T.air || T.flip || id === 'jump') { this.vz = KC.TUNE.jump * (T.flip ? 1.03 : 1); if (T.flip) this.vz = 370; if (id === 'jump') this.vz = KC.TUNE.jump; this.flipping = !!T.flip; }\n    if (id === 'jumpSide' || id === 'jumpBack') this.vz = KC.TUNE.jump;\n    if (T.travel && !T.air && !T.flip && !T.roll) this.travelPerStep = T.travel * this.dir / Math.max(1, (d.s + d.a));\n    else this.travelPerStep = 0;\n    if (T.flip) this.vx = (T.travel * this.dir) / 0.67;\n    if (T.roll) this.vx = T.travel * this.dir / 0.75;\n    if (id === 'block') this.guard = 0;\n    if (id === 'crouch') this.crouch = true;\n    this.turn = 0;\n    this.spinT = T.spin ? 1 : 0;\n  }\n  // the foe is 'hittable' by this fighter's technique at all? (height and state rules, 4.3)\n  hittableBy(tech, foe) {\n    const T = tech;\n    if (foe.state === 'down' || foe.state === 'rise' || foe.flipping && foe.z > 0 && T.height !== 'high' && !T.antiAir) return false;\n    if (foe.state === 'hit' && foe.downT <= 0 && false) return false;\n    if (foe.airborne) {\n      if (T.height === 'high' || T.antiAir) return T.antiAir ? foe.vz > 0 || foe.tech && foe.tech.id === 'frontFlip' || foe.z > 0 : true;\n      return false;\n    }\n    if (foe.crouch) {\n      if (T.height === 'high') return false;\n      if (T.height === 'mid') return !!T.hitsCrouch;\n      return true;\n    }\n    return true;\n  }\n  rigState(extra) { return null; }\n};\n\n// ---------------------------------------------------------------- Bout: the referee's state machine (5.2) plus the scoring (4.5)\nKC.Bout = class Bout {\n  constructor(o) {\n    this.a = o.white; this.b = o.red;              // the two fighters (a = white, the left mark)\n    this.seed = o.seed >>> 0 || 1;\n    this.rng = E.rng(this.seed);\n    this.judgeRng = [E.rng(this.seed + 1), E.rng(this.seed + 2)];\n    this.roundsToWin = o.roundsToWin || KC.TUNE.roundsToWin;\n    this.pointsToWin = o.pointsToWin || KC.TUNE.pointsToWin;\n    this.listeners = {};\n    this.round = 1; this.roundWins = [0, 0]; this.matchOver = null;\n    this.rounds = [];\n    this.intro = o.intro !== false;\n    this.clock = KC.TUNE.clock; this.clockStart = KC.TUNE.clock;\n    this.pace = KC.TUNE.refPace || 1;\n    this.phase = 'intro'; this.phaseT = 0; this.stepCount = 0;\n    this.points = [0, 0]; this.roundStats = [{ full: 0, half: 0, blocks: 0 }, { full: 0, half: 0, blocks: 0 }];\n    this.techPts = [0, 0]; this.attempts = [0, 0]; this.blocksRound = [0, 0];\n    this.pendingHit = null; this.lastCall = null; this.lastPoint = null; this.hitstopT = 0;\n    this.log = [];\n    this.stopped = false; this.hantei = null;\n    this.setPhase(this.intro ? 'intro' : 'rei');\n  }\n  on(name, fn) { (this.listeners[name] = this.listeners[name] || []).push(fn); return this; }\n  emit(name, data) { this.log.push([name, data && (data.text || data.side || '')]); if (this.log.length > 400) this.log.shift(); (this.listeners[name] || []).forEach(f => f(data)); (this.listeners['*'] || []).forEach(f => f(name, data)); }\n  call(id, sub) { const t = KC.TEXT.calls[id] ? KC.TEXT.calls[id][KC.calls === 'Japanese' ? 1 : 0] : id; this.lastCall = { id, text: t, sub: sub || null, at: this.stepCount }; this.emit('call', { id, text: t, sub }); return t; }\n  pt(sec) { return sec * this.pace; }\n  setPhase(p) {\n    this.phase = p; this.phaseT = 0;\n    const P = { intro: 1.2, rei: 0.9, card: 0.9, ready: 0.4, hajime: 0.6, yame: 0.9, award: 1.2, reset: 1.2, roundEnd: 2.0, time: 0.8, hantei: 2.4, matchEnd: 2.5 };\n    this.phaseLen = P[p] !== undefined ? this.pt(P[p]) : 0;\n    if (p === 'intro') { this.a.x = 0 + 8; this.b.x = 400 - 8; this.a.facing = 1; this.b.facing = -1; this.a.state = 'walk'; this.b.state = 'walk'; }\n    if (p === 'rei') { this.a.state = 'bow'; this.b.state = 'bow'; this.call('bow'); }\n    if (p === 'card') { this.a.state = 'idle'; this.b.state = 'idle'; this.a.crouch = false; this.b.crouch = false; this.emit('card', { round: this.round, decider: this.round === 3 }); }\n    if (p === 'ready') { this.a.reset(false); this.b.reset(false); this.a.x = KC.ARENA.marks[0]; this.b.x = KC.ARENA.marks[1]; this.a.facing = 1; this.b.facing = -1; }\n    if (p === 'hajime') { this.call('begin'); this.emit('begin', {}); }\n    if (p === 'fight') { this.clock = this.clockStart; this.attempts = [0, 0]; this.techPts = [0, 0]; this.blocksRound = [0, 0]; this.emit('fight', {}); }\n    if (p === 'yame') { this.call('stop'); this.emit('yame', {}); }\n    if (p === 'roundEnd') { this.emit('roundEnd', { winner: this.roundWinner }); }\n    if (p === 'matchEnd') { this.emit('matchEnd', { winner: this.matchOver }); }\n  }\n  get fighters() { return [this.a, this.b]; }\n  // the sim's one step (dt in seconds; sim uses fixed steps)\n  step(dt, ctl) {\n    this.stepCount++; this.phaseT += dt;\n    const f = this.phase;\n    if (f === 'intro') { this.walkTo(dt, 'marks', 60); if (this.phaseT >= this.phaseLen) this.setPhase('rei'); return; }\n    if (f === 'rei') { if (this.phaseT >= this.phaseLen) this.setPhase('card'); return; }\n    if (f === 'card') { if (this.phaseT >= this.phaseLen) this.setPhase('ready'); return; }\n    if (f === 'ready') { this.a.state = 'idle'; this.b.state = 'idle'; if (this.phaseT >= this.phaseLen) this.setPhase('hajime'); return; }\n    if (f === 'hajime') { if (this.phaseT >= this.phaseLen) this.setPhase('fight'); return; }\n    if (f === 'fight') return this.fightStep(dt, ctl);\n    if (f === 'stop') { this.tickFighters(dt, null); if (this.hitstopT > 0) { this.hitstopT -= dt; if (this.hitstopT <= 0) this.phaseT = 0; return; } }\n    if (f === 'yame') { this.tickFighters(dt, null); if (this.phaseT >= this.phaseLen) this.setPhase('award'); return; }\n    if (f === 'award') { this.tickFighters(dt, null); if (this.phaseT >= this.phaseLen) this.afterAward(); return; }\n    if (f === 'reset') { this.walkTo(dt, 'marks', 2 * 72); const at = Math.abs(this.a.x - KC.ARENA.marks[0]) < 0.5 && Math.abs(this.b.x - KC.ARENA.marks[1]) < 0.5; if (at || this.phaseT > 1.2 * 1.5) this.setPhase('card'); return; }\n    if (f === 'roundEnd') { if (this.phaseT >= this.phaseLen) { this.matchOver ? this.setPhase('matchEnd') : this.nextRound(); } return; }\n    if (f === 'time') { if (this.phaseT >= this.phaseLen) this.setPhase('hantei'); return; }\n    if (f === 'hantei') { if (this.phaseT >= this.phaseLen) this.afterHantei(); return; }\n    if (f === 'matchEnd') { if (this.phaseT >= this.phaseLen) this.emit('done', { winner: this.matchOver }); return; }\n  }\n  walkTo(dt, what, speed) {\n    const tgt = KC.ARENA.marks;\n    for (const [f, t] of [[this.a, tgt[0]], [this.b, tgt[1]]]) {\n      const d = t - f.x, s = Math.min(Math.abs(d), speed * dt);\n      f.x += Math.sign(d) * s; f.state = Math.abs(d) > 0.5 ? 'walk' : 'idle';\n      f.facing = this.a === f ? 1 : -1;\n    }\n  }\n  nextRound() {\n    this.round++; this.points = [0, 0]; this.a.reset(false); this.b.reset(false);\n    this.setPhase('reset');\n  }\n  afterAward() {\n    this.roundCheckAfterAward ? null : null;\n    if (this.clock <= 0 && !this.pendingDecider) { }\n    if (this.points[0] >= this.pointsToWin || this.points[1] >= this.pointsToWin) return this.endRound(this.points[0] >= this.pointsToWin ? 0 : 1);\n    this.setPhase('reset');\n  }\n  endRound(side, why) {\n    this.roundWinner = side; this.roundWins[side]++;\n    this.rounds.push({ winner: side, points: this.points.slice(), why: why || 'points', stats: this.roundStats.map(s => Object.assign({}, s)) });\n    this.roundStats = [{ full: 0, half: 0, blocks: 0 }, { full: 0, half: 0, blocks: 0 }];\n    this.matchOver = this.roundWins[side] >= this.roundsToWin ? side : null;\n    this.call(side === 0 ? 'whiteWins' : 'redWins');\n    this.setPhase('roundEnd');\n  }\n  fightStep(dt, ctl) {\n    // time runs only in the fight\n    if (!KC.TOGGLES.infiniteTime) this.clock = Math.max(0, this.clock - dt * KC.TUNE.gameSpeed);\n    if (this.clock <= 0 && !this.pendingHit) {\n      this.call('time');\n      return this.setPhase('time');\n    }\n    const cA = ctl && ctl.a ? ctl.a() : null, cB = ctl && ctl.b ? ctl.b() : null;\n    if (this.phaseT >= 0.35 * this.pace && !this.pendingHit) {\n      this.a.control(cA, this.b); this.b.control(cB, this.a);\n    }\n    this.tickFighters(dt, true);\n    // attacks connect: check each active technique\n    const hitA = this.checkHit(this.a, this.b), hitB = this.checkHit(this.b, this.a);\n    if (this.pendingHit) {\n      this.pendingHit.t -= 1;\n      if (this.pendingHit.t <= 0) {\n        this.resolveFirst();\n      }\n      if (hitA || hitB) { this.aiuchiWindow = true; }\n    } else if (hitA || hitB) {\n      const first = hitA || hitB;\n      // the other fighter may land in the same window\n      this.pendingHit = { t: 6, first, other: hitA ? hitB : hitA };\n      if (hitA && hitB) this.pendingHit.both = true;\n    }\n    if (this.pendingHit && (this.pendingHit.both)) { this.resolveAiuchi(); }\n  }\n  checkHit(att, def) {\n    if (att.state !== 'tech' || !att.tech) return false;\n    const T = KC.DATA.techniques[att.tech.id];\n    if (!T.reach || att.tech.hit || att.tech.ph !== 1) return false;\n    const gap = Math.abs(def.x - att.x) - KC.BODY_W;\n    // must be in front of the attacker: their technique is toward the foe\n    const dirOk = Math.sign(def.x - att.x) === att.dir || (att.tech && (T.spin || T.block));\n    if (!dirOk && !T.spin) return false;\n    const maxR = T.reach[1] * KC.TUNE.reachScale * att.stats.reach;\n    if (gap > maxR || gap < -KC.BODY_W) return false;\n    if (!att.hittableBy(T, def)) { if (!att.blockedOnce) { } return false; }\n    // blocks: a guard stops high and mid techniques\n    if (def.state === 'tech' && def.tech && def.tech.id === 'block' && def.tech.ph === 1 && !T.unblockable) {\n      this.blocked(att, def, T);\n      att.tech.hit = true;\n      return false;\n    }\n    att.tech.hit = true;\n    att.tech.gap = gap;\n    this.landed(att, def, T);\n    return true;\n  }\n  blocked(att, def, T) {\n    this.blocksRound[def === this.a ? 0 : 1]++; this.roundStats[def === this.a ? 0 : 1].blocks++;\n    att.x -= att.dir * 14; if (att.tech) att.tech.r += 20;\n    att.recoilT = 0.2;\n    def.tech.ph = 2; def.tech.r = 0; def.guard = 0;\n    this.emit('block', { by: def.side, tech: T.name });\n  }\n  landed(att, def, T) {\n    const d = att.tech, stepsIn = d.a > 0 ? Math.max(0, d.t) : 0;\n    const frac = d.a > 1 ? Math.min(1, d.t / (d.a - 1)) : 0;\n    const timingQ = frac <= 0.4 ? 1 : Math.max(0.3, 1 - (frac - 0.4) / 0.6 * 0.7);\n    const r0 = T.reach[0], r1 = T.reach[1] * KC.TUNE.reachScale * att.stats.reach;\n    const band = Math.max(1, r1 - r0), t = KC.clamp((d.gap - r0) / band, 0, 1);\n    const spacingQ = Math.min(1, t / 0.7);\n    let q = Math.max(0.15, 0.5 * timingQ + 0.5 * spacingQ);\n    if (att.r.sig === d.id) q = Math.min(1, q + 0.1);\n    if (T.antiAir && def.airborne) q = Math.min(1, q + 0.25);\n    let pts = T.pts[0] + Math.round((T.pts[1] - T.pts[0]) * q / 100) * 100;\n    pts = KC.clamp(pts, T.pts[0], T.pts[1]);\n    const counter = def.state === 'tech' && !!def.tech && def.tech.id !== 'block' || def.recoilT > 0;\n    if (counter) pts = Math.min(1000, Math.round(pts * KC.TUNE.counterMul));\n    const full = pts >= KC.TUNE.fullAt;\n    const side = att === this.a ? 0 : 1;\n    this.pendingLanded = { att, def, T, pts, full, counter, q, timingQ, spacingQ, side, id: d.id, gap: d.gap };\n    if (!this.pendingHit) this.pendingHit = null;\n    this.pendingGood = this.pendingLanded;\n    // remember this so an aiuchi can cancel both\n    this.lastLanded = this.pendingLanded;\n  }\n  resolveFirst() {\n    const p = this.pendingGood || this.lastLanded;\n    this.pendingHit = null;\n    if (p && !p.resolved) this.award(p);\n    this.pendingGood = null;\n  }\n  resolveAiuchi() {\n    this.pendingHit = null; this.pendingGood = null;\n    this.call('aiuchi');\n    this.emit('aiuchi', {});\n    this.setPhase('yame');\n  }\n  award(p) {\n    p.resolved = true;\n    const si = p.side, sc = si === 0 ? 0 : 1;\n    const e = p.def;\n    if (p.full || p.pts >= 600) this.roundStats[sc].full++; else this.roundStats[sc].half++;\n    const pointsValue = p.full ? 1 : 0.5;\n    this.points[sc] += pointsValue;\n    this.techPts[sc] += p.pts;\n    this.attempts[sc]++;\n    p.att.score += p.pts; p.att.bestPts = Math.max(p.att.bestPts, p.pts);\n    if (p.full) p.att.hitsMade.full++; else p.att.hitsMade.half++;\n    if (p.counter) p.att.hitsMade.counters++;\n    this.lastPoint = { side: si, pts: p.pts, full: p.full, counter: p.counter, tech: p.id, q: p.q, timingQ: p.timingQ, spacingQ: p.spacingQ };\n    // the defender's reaction\n    if (p.full || KC.DATA.techniques[p.id].knockdown) { e.knock(p.att.dir); }\n    else { e.stagger(p.att.dir); }\n    this.emit('point', this.lastPoint);\n    this.call(p.full ? 'full' : 'half', p.counter ? 'COUNTER' : null);\n    this.setPhase('yame');\n  }\n  // step the fighters' technique and movement, outside or during the fight\n  tickFighters(dt, live) {\n    for (const f of this.fighters) f.tick(dt, this.foeOf(f), live, this);\n  }\n  foeOf(f) { return f === this.a ? this.b : this.a; }\n  afterHantei() {\n    const sA = this.techPts[0] + 60 * this.attempts[0] + 40 * this.blocksRound[0];\n    const sB = this.techPts[1] + 60 * this.attempts[1] + 40 * this.blocksRound[1];\n    const na = (this.judgeRng[0]() * 2 - 1) * 120, nb = (this.judgeRng[1]() * 2 - 1) * 120;\n    const winner = (sA + na) === (sB + nb) ? (this.lastLanded && this.lastLanded.side === 1 ? 1 : 0) : ((sA + na) > (sB + nb) ? 0 : 1);\n    this.emit('hantei', { winner });\n    this.call('judges');\n    if (this.points[0] !== this.points[1]) {\n      this.endRound(this.points[0] > this.points[1] ? 0 : 1, 'time');\n    } else {\n      this.endRound(winner, 'hantei');\n    }\n  }\n};\n\n// Fighter methods (added to the prototype so the sim stays one readable class above)\n(function () {\n  const P = KC.Karateka.prototype;\n  P.knock = function (dir) { this.state = 'down'; this.downT = KC.TUNE.gameSpeed ? 96 : 96; this.stun = 0; this.tech = null; this.vx = -dir * 40; this.knocked = true; this.x -= dir * 18; this.clampX(); };\n  P.stagger = function (dir) { this.state = 'hit'; this.stun = 30; this.tech = null; this.x -= dir * 10; this.clampX(); };\n  P.clampX = function () { this.x = KC.clamp(this.x, KC.ARENA.x0 + KC.BODY_W / 2, KC.ARENA.x1 - KC.BODY_W / 2); };\n  // a free step: move, face, jump; or act on the intent\n  P.control = function (intent, foe) {\n    this.intent = intent || { posture: 'n', tech: null };\n    if (this.state === 'down' || this.state === 'hit' || this.state === 'rise') return;\n    if (this.state === 'tech') {\n      // buffer a press made while busy: kept for 0.15 s and fired on the first free step\n      if (intent && intent.tech) { this.pending = intent.tech; this.pendingPost = intent.posture; this.pendingT = 18; }\n      return;\n    }\n    if (this.state === 'block') return;\n    if (intent && intent.tech) { this.tryStart(intent.tech, intent.posture, foe); }\n  };\n  P.tryStart = function (stick, posture, foe) {\n    const gap = Math.abs(foe.x - this.x) - KC.BODY_W;\n    const grounded = !this.airborne;\n    if (this.state === 'idle' || this.state === 'walk' || this.state === 'bow' || this.state === 'pivot') {\n      let id = KC.DATA.techFor(posture || 'n', stick, gap);\n      if (!id) return false;\n      const T = KC.DATA.techniques[id];\n      if (T.air && grounded && (id === 'jumpSide' || id === 'jumpBack' || id === 'frontFlip' || id === 'backFlip')) { this.vz = KC.TUNE.jump; }\n      if (id === 'jump') this.vz = KC.TUNE.jump;\n      if (id === 'crouch') { this.crouch = true; this.state = 'crouch'; return true; }\n      if (id === 'block') { this.startTech('block', posture); return true; }\n      this.startTech(id, posture);\n      return true;\n    }\n    return false;\n  };\n  // each step: technique progress, movement, buffered presses\n  P.tick = function (dt, foe, live, bout) {\n    if (this.state === 'down') { this.downT--; if (this.downT <= 0) { this.state = 'rise'; this.stun = 36; } return; }\n    if (this.state === 'rise') { this.stun--; if (this.stun <= 0) { this.state = 'idle'; } return; }\n    if (this.state === 'hit') { this.stun--; if (this.stun <= 0) this.state = 'idle'; return; }\n    if (this.recoilT > 0) this.recoilT -= dt;\n    // flight: gravity\n    if (this.z > 0 || this.vz !== 0) {\n      this.vz -= KC.TUNE.gravity * dt;\n      this.z += this.vz * dt;\n      if (this.z <= 0) { this.z = 0; this.vz = 0; this.flipping = false; this.vx = 0; this.justLanded = true; if (this.tech && (KC.DATA.techniques[this.tech.id].air || KC.DATA.techniques[this.tech.id].flip)) this.tech.ph = 2; }\n    }\n    if (this.state === 'tech' && this.tech) {\n      const T = KC.DATA.techniques[this.tech.id];\n      const tch = this.tech;\n      if (tch.ph === 0) { tch.t++; if (tch.t >= tch.s) { tch.ph = 1; tch.t = 0; } }\n      else if (tch.ph === 1) {\n        tch.t++;\n        if (T.block) { this.guard = tch.t; }\n        if (this.travelPerStep && !T.air) this.x += this.travelPerStep * (this.tech.ph === 1 ? 1 : 0) * dt * 120 / 120;\n        if (!T.air && !T.flip && !T.roll && this.travelPerStep) this.x += this.travelPerStep;\n        if (tch.t >= tch.a) { tch.ph = 2; tch.t = 0; }\n      } else if (tch.ph === 2) {\n        tch.t++;\n        if (tch.t >= tch.r) { this.endTech(); }\n      }\n      if (this.state === 'tech' && this.tech) {\n        // buffered press\n        if (this.pending && this.tech.ph === 2 && this.pendingT > 0) { }\n      }\n      if (this.tech && (T.flip || T.roll) && this.tech.ph === 2 && !this.airborne) { }\n      if (this.tech && this.tech.id === 'backRoll') this.x += this.dir * 0;\n    }\n    if (this.state === 'tech' && this.tech && this.tech.ph === 1 && this.tech.id === 'backRoll') { this.x -= 0; }\n    if (this.state === 'crouch') { if (!(this.intent && this.intent.posture === 'd')) { this.state = 'idle'; this.crouch = false; } }\n    if (this.state === 'walk' || this.state === 'idle' || this.state === 'pivot') {\n      if (live && this.intent) this.walkIntent(dt, foe);\n      if (this.pendingT > 0) { this.pendingT--; }\n    }\n    // the pivot to face the foe\n    if (this.state !== 'tech' && !this.airborne) this.facing = foe.x >= this.x ? 1 : -1;\n    // separation\n    this.clampX();\n    if (bout) this.separate(foe);\n    if (this.pendingT > 0 && this.state !== 'tech') this.pendingT--;\n    // if free, use a buffered technique\n    if (this.pending && this.state !== 'tech' && this.pendingT > 0 && (this.state === 'idle' || this.state === 'walk')) {\n      const st = this.pending; this.pending = null; this.pendingT = 0;\n      this.tryStart(st, this.pendingPost, foe);\n    }\n    // a technique that ends while the foe is in the air? nothing special\n  };\n  P.endTech = function () {\n    const id = this.tech.id;\n    this.tech = null; this.pending = null;\n    this.state = 'idle'; this.guard = 0; this.flipping = false; this.travelPerStep = 0;\n    this.crouch = false;\n    if (this.z > 0) { this.state = 'idle'; }\n  };\n  P.walkIntent = function (dt, foe) {\n    const p = this.intent.posture;\n    const toward = this.dir * (foe.x > this.x ? 1 : -1);\n    let vx = 0;\n    if (p === 't') vx = this.dir * 0 + (foe.x > this.x ? 1 : -1) * KC.TUNE.walk * this.stats.walk * (this.r.ai && this.r.ai.walk && this.id !== 'buta' ? 1 : 1);\n    else if (p === 'a') vx = -(foe.x > this.x ? 1 : -1) * KC.WALK_AWAY * this.stats.walk;\n    if (this.id === 'buta' && p === 't') vx = (foe.x > this.x ? 1 : -1) * 60 * this.stats.walk;\n    this.x += vx * dt; this.vx = vx;\n    this.state = vx !== 0 ? 'walk' : 'idle';\n    if (p === 'd' && !this.airborne) { this.crouch = true; this.state = 'crouch'; }\n    else this.crouch = false;\n    if (p === 'u' && !this.airborne && !this.tech) { this.vz = KC.TUNE.jump; this.state = 'jump'; }\n    this.clampX();\n  };\n  P.separate = function (foe) {\n    const d = this.x - foe.x, min = KC.BODY_W;\n    if (Math.abs(d) < min && !this.airborne && !foe.airborne) {\n      const push = (min - Math.abs(d)) / 2 * (d >= 0 ? 1 : -1 || 1);\n      if (d === 0) { return; }\n      this.x += push; foe.x -= push;\n      this.clampX(); foe.clampX();\n    }\n  };\n  // the rig state for the view: serializable (6.1's rule, so online guests pose the same way)\n  P.poseState = function () {\n    const tech = this.tech ? this.tech.id : null;\n    return { id: this.id, x: this.x, z: this.z, facing: this.facing, state: this.state, tech, ph: this.tech ? this.tech.ph : -1, t: this.tech ? this.tech.t : 0, crouch: this.crouch, down: this.state === 'down' ? 1 : 0, flip: this.flipping, guard: this.guard > 0 || this.state === 'tech' && this.tech && this.tech.id === 'block' };\n  };\n})();\n\n// ---------------------------------------------------------------- the CPU (6)\nKC.levelParams = (L) => {\n  const t = (L - 1) / 9;\n  const s = (a, b) => a + (b - a) * t;\n  return { react: s(0.55, 0.12) * KC.TUNE.cpuReact, think: s(0.50, 0.14), readP: s(0.25, 0.92), mistake: s(0.30, 0.02) };\n};\n// the stick that makes a technique from posture 'n' or its posture, inverse of the matrix\nKC.DATA.inverse = (() => {\n  const inv = {};\n  for (const p of Object.keys(KC.DATA.matrix)) for (const s of Object.keys(KC.DATA.matrix[p])) {\n    const id = KC.DATA.matrix[p][s];\n    if (!inv[id]) inv[id] = { posture: p, stick: s };\n  }\n  return inv;\n})();\nKC.KarateAI = class KarateAI {\n  constructor(fighter, seed, o = {}) {\n    this.f = fighter; this.rng = E.rng(seed >>> 0 || 1);\n    this.level = o.level || (fighter.r.ai ? fighter.r.ai.level : 3);\n    const L = KC.TUNE.cpuLevel > 0 && !o.noOverride ? KC.TUNE.cpuLevel : this.level;\n    this.L = L;\n    this.p = KC.levelParams(L);\n    this.ai = fighter.r.ai || { aggr: 0.5, patience: 0.4, jump: 0.1, block: 0.3, gap: 40, weights: { roundKick: 1 } };\n    this.aggr = KC.TUNE.cpuAggression >= 0 ? KC.TUNE.cpuAggression : this.ai.aggr;\n    this.think = 0; this.hold = null; this.holdT = 0; this.obsQueue = []; this.habit = {};\n    this.lastSeen = null; this.punishT = 0;\n  }\n  observe(foe) {\n    const tech = foe.tech ? foe.tech.id : null;\n    return { tech, ph: foe.tech ? foe.tech.ph : -1, air: foe.airborne, crouch: foe.crouch, down: foe.state === 'down' || foe.state === 'rise', gap: Math.abs(foe.x - this.f.x) - KC.BODY_W };\n  }\n  intent(foe, dt) {\n    const f = this.f;\n    this.obsQueue.push(this.observe(foe));\n    const delay = Math.max(1, Math.round(this.p.react * 120));\n    while (this.obsQueue.length > delay) this.lastSeen = this.obsQueue.shift();\n    if (this.holdT > 0) { this.holdT -= dt; return this.hold; }\n    this.think -= dt;\n    if (this.think > 0) return this.idleIntent(foe);\n    this.think = this.p.think * (0.9 + 0.2 * this.rng());\n    const seen = this.lastSeen || this.observe(foe);\n    const gap = Math.abs(foe.x - f.x) - KC.BODY_W;\n    let out = null;\n    // react to a seen technique\n    if (seen.tech && (seen.ph === 0 || seen.ph === 1) && this.rng() < this.p.readP) {\n      const T = KC.DATA.techniques[seen.tech];\n      if (T.height === 'low') out = this.rng() < this.ai.jump + 0.4 ? { posture: 'u', tech: null } : null;\n      else if (T.height === 'high') out = this.rng() < 0.6 ? { posture: 'd', tech: null } : { posture: 'a', tech: null };\n      else if (T.height === 'mid') out = this.rng() < this.ai.block ? { posture: 'a', tech: 't' } : { posture: 'a', tech: null };\n      if (seen.air && gap < 40) out = { posture: 'd', tech: 'u' };\n    }\n    // punish a foe in recovery\n    if (!out && seen.ph === 2 && gap <= 40 && this.rng() < 0.85) out = this.best(gap);\n    if (!out) {\n      const pick = this.pickWeighted(gap);\n      if (pick && this.rng() < this.aggr) out = pick;\n      else if (this.rng() < this.ai.patience * 0.3) out = { posture: 'a', tech: null };\n      else out = { posture: gap > this.ai.gap + 6 ? 't' : (gap < this.ai.gap - 6 ? 'a' : 'n'), tech: null };\n    }\n    if (this.rng() < this.p.mistake) out = { posture: 'n', tech: KC.pick(this.rng, ['u', 't', 'd', 'a']) };\n    if (out && out.tech && out.posture === 'n' && this.rng() < 0.3) out.posture = 't';\n    this.hold = out || { posture: 'n', tech: null }; this.holdT = 0.08;\n    return this.hold;\n  }\n  idleIntent(foe) { return this.hold ? { posture: this.hold.posture, tech: null } : { posture: 'n', tech: null }; }\n  best(gap) {\n    const ids = Object.keys(this.ai.weights);\n    let best = null, bestW = -1;\n    for (const id of ids) {\n      const T = KC.DATA.techniques[id]; if (!T || !T.reach) continue;\n      if (gap < T.reach[0] || gap > T.reach[1]) continue;\n      const w = this.ai.weights[id];\n      if (w > bestW) { bestW = w; best = id; }\n    }\n    if (!best) return null;\n    const inv = KC.DATA.inverse[best]; if (!inv) return null;\n    return { posture: inv.posture === 'n' ? 'n' : inv.posture, tech: inv.stick };\n  }\n  pickWeighted(gap) {\n    const ids = Object.keys(this.ai.weights).filter(id => { const T = KC.DATA.techniques[id]; return T && T.reach && gap >= T.reach[0] - 6 && gap <= T.reach[1] + 6; });\n    if (!ids.length) return null;\n    let total = 0; for (const id of ids) total += this.ai.weights[id];\n    let r = this.rng() * total, pick = ids[0];\n    for (const id of ids) { r -= this.ai.weights[id]; if (r <= 0) { pick = id; break; } }\n    const inv = KC.DATA.inverse[pick]; if (!inv) return null;\n    return { posture: inv.posture, tech: inv.stick };\n  }\n};\nKC.pick = (rng, arr) => arr[Math.floor(rng() * arr.length) % arr.length];\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1870,"cache_read_input_tokens":149620,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1870},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"14f34045-19a9-4c91-b4b0-8ef52e3ad772","uuid":"4dbf7424-dfe1-4346-8e89-e168d49f7cc6","timestamp":"2026-11-04T01:47:35.850Z","request_id":"req_011Cgh3TqsoCeUYYxj3BL9vL","wire_tool_inputs":{"toolu_011uxDR63UvAkbCrRNTSHYQT":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184315__x1295cd/work/KarateChampon-KarateChamp1984-claude-haiku-5-5-medium-20261103-184315/src/10-sim.js","content":"// ---------------------------------------------------------------- the fight simulation (no drawing; deterministic; 120 Hz steps)\n// Positions: x 0..400 (the arena), z is height. Directions in the sim are RELATIVE to the foe: 't' toward, 'a' away.\nKC.ARENA = { x0: 0, x1: 400, marks: [150, 250] };\nKC.BODY_W = 18;           // push box width: contact means a gap of 0\nKC.STEP = 1 / 120;\nKC.WALK_AWAY = 56;\n\n// a screen direction ('l' | 'r' | 'u' | 'd' | 'n') to a relative one for a fighter whose foe is on side foeDir (+1 right, -1 left)\nKC.relDir = (screen, foeDir) => {\n  if (screen === 'r') return foeDir > 0 ? 't' : 'a';\n  if (screen === 'l') return foeDir > 0 ? 'a' : 't';\n  return screen;\n};\nKC.screenDir = (rel, foeDir) => {\n  if (rel === 't') return foeDir > 0 ? 'r' : 'l';\n  if (rel === 'a') return foeDir > 0 ? 'l' : 'r';\n  return rel;\n};\n\n// the input of a human: posture from the left stick / WASD (held) and the technique from the press edges of the right stick\nKC.readControl = (input, foeDir, prev) => {\n  const held = (a) => input.down(a);\n  let px = 'n';\n  if (held('up') && !held('down')) px = 'u';\n  else if (held('down') && !held('up')) px = 'd';\n  else if (held('left') && !held('right')) px = 'l';\n  else if (held('right') && !held('left')) px = 'r';\n  // when jumping, the posture stays up; when crouching it stays down\n  const pad = input.padAim || null;\n  let edge = null;\n  if (input.pressed('tUp')) edge = 'u';\n  else if (input.pressed('tDown')) edge = 'd';\n  else if (input.pressed('tLeft')) edge = 'l';\n  else if (input.pressed('tRight')) edge = 'r';\n  // right stick (the DualSense's), read directly with a 4-way gate and hysteresis\n  if (pad && prev) {\n    const q = KC.quantize(pad[0], -pad[1]);  // stick y is down-positive; flip so up is up\n    if (q && q !== prev.padQ) edge = edge || q;\n    prev.padQ = q;\n  } else if (prev) prev.padQ = null;\n  const pr = (s) => (s === 'u' || s === 'd') ? s : KC.relDir(s, foeDir);\n  let rel = pr(px);\n  // a posture of 'n' (no left-stick direction) keeps neutral; a press of the right stick uses it\n  return { posture: rel === 'n' ? 'n' : rel, tech: edge ? (edge === 'u' || edge === 'd' ? edge : KC.relDir(edge, foeDir)) : null };\n};\n\n// Karateka: one fighter. Its control: intent = { posture, tech } in relative terms (t, a, u, d, n) and tech stick (u, t, d, a).\nKC.Karateka = class Karateka {\n  constructor(o) {\n    this.id = o.id; this.r = KC.DATA.roster[o.id]; this.side = o.side; this.ai = o.ai || null;\n    this.stats = Object.assign({ walk: 1, reach: 1, speed: 1 }, this.r.stats || {});\n    this.reset(true);\n    this.score = 0; this.hitsMade = { full: 0, half: 0, blocks: 0, counters: 0 }; this.best = null;\n    this.bestPts = 0;\n  }\n  reset(full) {\n    this.x = this.side === 'w' ? KC.ARENA.marks[0] : KC.ARENA.marks[1];\n    this.z = 0; this.vz = 0; this.vx = 0; this.facing = this.side === 'w' ? 1 : -1;\n    this.state = 'idle'; this.tech = null; this.guard = 0; this.stun = 0; this.downT = 0; this.crouch = false;\n    this.pending = null; this.pendingT = 0; this.recoilT = 0; this.flipping = false; this.lastDown = false; this.turn = 0;\n    this.lastTech = null; this.knocked = false; this.pose = null; this.spinT = 0;\n    if (full) this.flip = false;\n  }\n  get dir() { return this.side === 'w' ? 1 : -1; }\n  get airborne() { return this.z > 0.01 || this.vz > 0.01; }\n  // frames (60 Hz) to steps (120 Hz), scaled by this fighter's speed and the tuning\n  steps(frames) { return Math.max(1, Math.round(frames * 2 / (this.stats.speed * KC.TUNE.techSpeed))); }\n  // a technique's phase lengths (steps)\n  techSteps(id) {\n    const T = KC.DATA.techniques[id];\n    if (T.block) return { s: 1, a: Math.round(KC.TUNE.blockWindow * 2), r: 8 };\n    return { s: this.steps(T.f[0]), a: this.steps(T.f[1]), r: this.steps(T.f[2]) };\n  }\n  // start a technique (relative stick). posture is the rel posture at the press\n  startTech(id, posture) {\n    const T = KC.DATA.techniques[id], d = this.techSteps(id);\n    this.tech = { id, ph: 0, t: 0, s: d.s, a: d.a, r: d.r, hit: false, posture, upT: T.flip || T.air || T.block ? 0 : 8, startX: this.x, t0: 0, counterOpen: false };\n    this.lastTech = id;\n    this.state = 'tech';\n    if (T.air || T.flip || id === 'jump') { this.vz = KC.TUNE.jump * (T.flip ? 1.03 : 1); if (T.flip) this.vz = 370; if (id === 'jump') this.vz = KC.TUNE.jump; this.flipping = !!T.flip; }\n    if (id === 'jumpSide' || id === 'jumpBack') this.vz = KC.TUNE.jump;\n    if (T.travel && !T.air && !T.flip && !T.roll) this.travelPerStep = T.travel * this.dir / Math.max(1, (d.s + d.a));\n    else this.travelPerStep = 0;\n    if (T.flip) this.vx = (T.travel * this.dir) / 0.67;\n    if (T.roll) this.vx = T.travel * this.dir / 0.75;\n    if (id === 'block') this.guard = 0;\n    if (id === 'crouch') this.crouch = true;\n    this.turn = 0;\n    this.spinT = T.spin ? 1 : 0;\n  }\n  // the foe is 'hittable' by this fighter's technique at all? (height and state rules, 4.3)\n  hittableBy(tech, foe) {\n    const T = tech;\n    if (foe.state === 'down' || foe.state === 'rise' || foe.flipping && foe.z > 0 && T.height !== 'high' && !T.antiAir) return false;\n    if (foe.state === 'hit' && foe.downT <= 0 && false) return false;\n    if (foe.airborne) {\n      if (T.height === 'high' || T.antiAir) return T.antiAir ? foe.vz > 0 || foe.tech && foe.tech.id === 'frontFlip' || foe.z > 0 : true;\n      return false;\n    }\n    if (foe.crouch) {\n      if (T.height === 'high') return false;\n      if (T.height === 'mid') return !!T.hitsCrouch;\n      return true;\n    }\n    return true;\n  }\n  rigState(extra) { return null; }\n};\n\n// ---------------------------------------------------------------- Bout: the referee's state machine (5.2) plus the scoring (4.5)\nKC.Bout = class Bout {\n  constructor(o) {\n    this.a = o.white; this.b = o.red;              // the two fighters (a = white, the left mark)\n    this.seed = o.seed >>> 0 || 1;\n    this.rng = E.rng(this.seed);\n    this.judgeRng = [E.rng(this.seed + 1), E.rng(this.seed + 2)];\n    this.roundsToWin = o.roundsToWin || KC.TUNE.roundsToWin;\n    this.pointsToWin = o.pointsToWin || KC.TUNE.pointsToWin;\n    this.listeners = {};\n    this.round = 1; this.roundWins = [0, 0]; this.matchOver = null;\n    this.rounds = [];\n    this.intro = o.intro !== false;\n    this.clock = KC.TUNE.clock; this.clockStart = KC.TUNE.clock;\n    this.pace = KC.TUNE.refPace || 1;\n    this.phase = 'intro'; this.phaseT = 0; this.stepCount = 0;\n    this.points = [0, 0]; this.roundStats = [{ full: 0, half: 0, blocks: 0 }, { full: 0, half: 0, blocks: 0 }];\n    this.techPts = [0, 0]; this.attempts = [0, 0]; this.blocksRound = [0, 0];\n    this.pendingHit = null; this.lastCall = null; this.lastPoint = null; this.hitstopT = 0;\n    this.log = [];\n    this.stopped = false; this.hantei = null;\n    this.setPhase(this.intro ? 'intro' : 'rei');\n  }\n  on(name, fn) { (this.listeners[name] = this.listeners[name] || []).push(fn); return this; }\n  emit(name, data) { this.log.push([name, data && (data.text || data.side || '')]); if (this.log.length > 400) this.log.shift(); (this.listeners[name] || []).forEach(f => f(data)); (this.listeners['*'] || []).forEach(f => f(name, data)); }\n  call(id, sub) { const t = KC.TEXT.calls[id] ? KC.TEXT.calls[id][KC.calls === 'Japanese' ? 1 : 0] : id; this.lastCall = { id, text: t, sub: sub || null, at: this.stepCount }; this.emit('call', { id, text: t, sub }); return t; }\n  pt(sec) { return sec * this.pace; }\n  setPhase(p) {\n    this.phase = p; this.phaseT = 0;\n    const P = { intro: 1.2, rei: 0.9, card: 0.9, ready: 0.4, hajime: 0.6, yame: 0.9, award: 1.2, reset: 1.2, roundEnd: 2.0, time: 0.8, hantei: 2.4, matchEnd: 2.5 };\n    this.phaseLen = P[p] !== undefined ? this.pt(P[p]) : 0;\n    if (p === 'intro') { this.a.x = 0 + 8; this.b.x = 400 - 8; this.a.facing = 1; this.b.facing = -1; this.a.state = 'walk'; this.b.state = 'walk'; }\n    if (p === 'rei') { this.a.state = 'bow'; this.b.state = 'bow'; this.call('bow'); }\n    if (p === 'card') { this.a.state = 'idle'; this.b.state = 'idle'; this.a.crouch = false; this.b.crouch = false; this.emit('card', { round: this.round, decider: this.round === 3 }); }\n    if (p === 'ready') { this.a.reset(false); this.b.reset(false); this.a.x = KC.ARENA.marks[0]; this.b.x = KC.ARENA.marks[1]; this.a.facing = 1; this.b.facing = -1; }\n    if (p === 'hajime') { this.call('begin'); this.emit('begin', {}); }\n    if (p === 'fight') { this.clock = this.clockStart; this.attempts = [0, 0]; this.techPts = [0, 0]; this.blocksRound = [0, 0]; this.emit('fight', {}); }\n    if (p === 'yame') { this.call('stop'); this.emit('yame', {}); }\n    if (p === 'roundEnd') { this.emit('roundEnd', { winner: this.roundWinner }); }\n    if (p === 'matchEnd') { this.emit('matchEnd', { winner: this.matchOver }); }\n  }\n  get fighters() { return [this.a, this.b]; }\n  // the sim's one step (dt in seconds; sim uses fixed steps)\n  step(dt, ctl) {\n    this.stepCount++; this.phaseT += dt;\n    const f = this.phase;\n    if (f === 'intro') { this.walkTo(dt, 'marks', 60); if (this.phaseT >= this.phaseLen) this.setPhase('rei'); return; }\n    if (f === 'rei') { if (this.phaseT >= this.phaseLen) this.setPhase('card'); return; }\n    if (f === 'card') { if (this.phaseT >= this.phaseLen) this.setPhase('ready'); return; }\n    if (f === 'ready') { this.a.state = 'idle'; this.b.state = 'idle'; if (this.phaseT >= this.phaseLen) this.setPhase('hajime'); return; }\n    if (f === 'hajime') { if (this.phaseT >= this.phaseLen) this.setPhase('fight'); return; }\n    if (f === 'fight') return this.fightStep(dt, ctl);\n    if (f === 'stop') { this.tickFighters(dt, null); if (this.hitstopT > 0) { this.hitstopT -= dt; if (this.hitstopT <= 0) this.phaseT = 0; return; } }\n    if (f === 'yame') { this.tickFighters(dt, null); if (this.phaseT >= this.phaseLen) this.setPhase('award'); return; }\n    if (f === 'award') { this.tickFighters(dt, null); if (this.phaseT >= this.phaseLen) this.afterAward(); return; }\n    if (f === 'reset') { this.walkTo(dt, 'marks', 2 * 72); const at = Math.abs(this.a.x - KC.ARENA.marks[0]) < 0.5 && Math.abs(this.b.x - KC.ARENA.marks[1]) < 0.5; if (at || this.phaseT > 1.2 * 1.5) this.setPhase('card'); return; }\n    if (f === 'roundEnd') { if (this.phaseT >= this.phaseLen) { this.matchOver ? this.setPhase('matchEnd') : this.nextRound(); } return; }\n    if (f === 'time') { if (this.phaseT >= this.phaseLen) this.setPhase('hantei'); return; }\n    if (f === 'hantei') { if (this.phaseT >= this.phaseLen) this.afterHantei(); return; }\n    if (f === 'matchEnd') { if (this.phaseT >= this.phaseLen) this.emit('done', { winner: this.matchOver }); return; }\n  }\n  walkTo(dt, what, speed) {\n    const tgt = KC.ARENA.marks;\n    for (const [f, t] of [[this.a, tgt[0]], [this.b, tgt[1]]]) {\n      const d = t - f.x, s = Math.min(Math.abs(d), speed * dt);\n      f.x += Math.sign(d) * s; f.state = Math.abs(d) > 0.5 ? 'walk' : 'idle';\n      f.facing = this.a === f ? 1 : -1;\n    }\n  }\n  nextRound() {\n    this.round++; this.points = [0, 0]; this.a.reset(false); this.b.reset(false);\n    this.setPhase('reset');\n  }\n  afterAward() {\n    this.roundCheckAfterAward ? null : null;\n    if (this.clock <= 0 && !this.pendingDecider) { }\n    if (this.points[0] >= this.pointsToWin || this.points[1] >= this.pointsToWin) return this.endRound(this.points[0] >= this.pointsToWin ? 0 : 1);\n    this.setPhase('reset');\n  }\n  endRound(side, why) {\n    this.roundWinner = side; this.roundWins[side]++;\n    this.rounds.push({ winner: side, points: this.points.slice(), why: why || 'points', stats: this.roundStats.map(s => Object.assign({}, s)) });\n    this.roundStats = [{ full: 0, half: 0, blocks: 0 }, { full: 0, half: 0, blocks: 0 }];\n    this.matchOver = this.roundWins[side] >= this.roundsToWin ? side : null;\n    this.call(side === 0 ? 'whiteWins' : 'redWins');\n    this.setPhase('roundEnd');\n  }\n  fightStep(dt, ctl) {\n    // time runs only in the fight\n    if (!KC.TOGGLES.infiniteTime) this.clock = Math.max(0, this.clock - dt * KC.TUNE.gameSpeed);\n    if (this.clock <= 0 && !this.pendingHit) {\n      this.call('time');\n      return this.setPhase('time');\n    }\n    const cA = ctl && ctl.a ? ctl.a() : null, cB = ctl && ctl.b ? ctl.b() : null;\n    if (this.phaseT >= 0.35 * this.pace && !this.pendingHit) {\n      this.a.control(cA, this.b); this.b.control(cB, this.a);\n    }\n    this.tickFighters(dt, true);\n    // attacks connect: check each active technique\n    const hitA = this.checkHit(this.a, this.b), hitB = this.checkHit(this.b, this.a);\n    if (this.pendingHit) {\n      this.pendingHit.t -= 1;\n      if (this.pendingHit.t <= 0) {\n        this.resolveFirst();\n      }\n      if (hitA || hitB) { this.aiuchiWindow = true; }\n    } else if (hitA || hitB) {\n      const first = hitA || hitB;\n      // the other fighter may land in the same window\n      this.pendingHit = { t: 6, first, other: hitA ? hitB : hitA };\n      if (hitA && hitB) this.pendingHit.both = true;\n    }\n    if (this.pendingHit && (this.pendingHit.both)) { this.resolveAiuchi(); }\n  }\n  checkHit(att, def) {\n    if (att.state !== 'tech' || !att.tech) return false;\n    const T = KC.DATA.techniques[att.tech.id];\n    if (!T.reach || att.tech.hit || att.tech.ph !== 1) return false;\n    const gap = Math.abs(def.x - att.x) - KC.BODY_W;\n    // must be in front of the attacker: their technique is toward the foe\n    const dirOk = Math.sign(def.x - att.x) === att.dir || (att.tech && (T.spin || T.block));\n    if (!dirOk && !T.spin) return false;\n    const maxR = T.reach[1] * KC.TUNE.reachScale * att.stats.reach;\n    if (gap > maxR || gap < -KC.BODY_W) return false;\n    if (!att.hittableBy(T, def)) { if (!att.blockedOnce) { } return false; }\n    // blocks: a guard stops high and mid techniques\n    if (def.state === 'tech' && def.tech && def.tech.id === 'block' && def.tech.ph === 1 && !T.unblockable) {\n      this.blocked(att, def, T);\n      att.tech.hit = true;\n      return false;\n    }\n    att.tech.hit = true;\n    att.tech.gap = gap;\n    this.landed(att, def, T);\n    return true;\n  }\n  blocked(att, def, T) {\n    this.blocksRound[def === this.a ? 0 : 1]++; this.roundStats[def === this.a ? 0 : 1].blocks++;\n    att.x -= att.dir * 14; if (att.tech) att.tech.r += 20;\n    att.recoilT = 0.2;\n    def.tech.ph = 2; def.tech.r = 0; def.guard = 0;\n    this.emit('block', { by: def.side, tech: T.name });\n  }\n  landed(att, def, T) {\n    const d = att.tech, stepsIn = d.a > 0 ? Math.max(0, d.t) : 0;\n    const frac = d.a > 1 ? Math.min(1, d.t / (d.a - 1)) : 0;\n    const timingQ = frac <= 0.4 ? 1 : Math.max(0.3, 1 - (frac - 0.4) / 0.6 * 0.7);\n    const r0 = T.reach[0], r1 = T.reach[1] * KC.TUNE.reachScale * att.stats.reach;\n    const band = Math.max(1, r1 - r0), t = KC.clamp((d.gap - r0) / band, 0, 1);\n    const spacingQ = Math.min(1, t / 0.7);\n    let q = Math.max(0.15, 0.5 * timingQ + 0.5 * spacingQ);\n    if (att.r.sig === d.id) q = Math.min(1, q + 0.1);\n    if (T.antiAir && def.airborne) q = Math.min(1, q + 0.25);\n    let pts = T.pts[0] + Math.round((T.pts[1] - T.pts[0]) * q / 100) * 100;\n    pts = KC.clamp(pts, T.pts[0], T.pts[1]);\n    const counter = def.state === 'tech' && !!def.tech && def.tech.id !== 'block' || def.recoilT > 0;\n    if (counter) pts = Math.min(1000, Math.round(pts * KC.TUNE.counterMul));\n    const full = pts >= KC.TUNE.fullAt;\n    const side = att === this.a ? 0 : 1;\n    this.pendingLanded = { att, def, T, pts, full, counter, q, timingQ, spacingQ, side, id: d.id, gap: d.gap };\n    if (!this.pendingHit) this.pendingHit = null;\n    this.pendingGood = this.pendingLanded;\n    // remember this so an aiuchi can cancel both\n    this.lastLanded = this.pendingLanded;\n  }\n  resolveFirst() {\n    const p = this.pendingGood || this.lastLanded;\n    this.pendingHit = null;\n    if (p && !p.resolved) this.award(p);\n    this.pendingGood = null;\n  }\n  resolveAiuchi() {\n    this.pendingHit = null; this.pendingGood = null;\n    this.call('aiuchi');\n    this.emit('aiuchi', {});\n    this.setPhase('yame');\n  }\n  award(p) {\n    p.resolved = true;\n    const si = p.side, sc = si === 0 ? 0 : 1;\n    const e = p.def;\n    if (p.full || p.pts >= 600) this.roundStats[sc].full++; else this.roundStats[sc].half++;\n    const pointsValue = p.full ? 1 : 0.5;\n    this.points[sc] += pointsValue;\n    this.techPts[sc] += p.pts;\n    this.attempts[sc]++;\n    p.att.score += p.pts; p.att.bestPts = Math.max(p.att.bestPts, p.pts);\n    if (p.full) p.att.hitsMade.full++; else p.att.hitsMade.half++;\n    if (p.counter) p.att.hitsMade.counters++;\n    this.lastPoint = { side: si, pts: p.pts, full: p.full, counter: p.counter, tech: p.id, q: p.q, timingQ: p.timingQ, spacingQ: p.spacingQ };\n    // the defender's reaction\n    if (p.full || KC.DATA.techniques[p.id].knockdown) { e.knock(p.att.dir); }\n    else { e.stagger(p.att.dir); }\n    this.emit('point', this.lastPoint);\n    this.call(p.full ? 'full' : 'half', p.counter ? 'COUNTER' : null);\n    this.setPhase('yame');\n  }\n  // step the fighters' technique and movement, outside or during the fight\n  tickFighters(dt, live) {\n    for (const f of this.fighters) f.tick(dt, this.foeOf(f), live, this);\n  }\n  foeOf(f) { return f === this.a ? this.b : this.a; }\n  afterHantei() {\n    const sA = this.techPts[0] + 60 * this.attempts[0] + 40 * this.blocksRound[0];\n    const sB = this.techPts[1] + 60 * this.attempts[1] + 40 * this.blocksRound[1];\n    const na = (this.judgeRng[0]() * 2 - 1) * 120, nb = (this.judgeRng[1]() * 2 - 1) * 120;\n    const winner = (sA + na) === (sB + nb) ? (this.lastLanded && this.lastLanded.side === 1 ? 1 : 0) : ((sA + na) > (sB + nb) ? 0 : 1);\n    this.emit('hantei', { winner });\n    this.call('judges');\n    if (this.points[0] !== this.points[1]) {\n      this.endRound(this.points[0] > this.points[1] ? 0 : 1, 'time');\n    } else {\n      this.endRound(winner, 'hantei');\n    }\n  }\n};\n\n// Fighter methods (added to the prototype so the sim stays one readable class above)\n(function () {\n  const P = KC.Karateka.prototype;\n  P.knock = function (dir) { this.state = 'down'; this.downT = KC.TUNE.gameSpeed ? 96 : 96; this.stun = 0; this.tech = null; this.vx = -dir * 40; this.knocked = true; this.x -= dir * 18; this.clampX(); };\n  P.stagger = function (dir) { this.state = 'hit'; this.stun = 30; this.tech = null; this.x -= dir * 10; this.clampX(); };\n  P.clampX = function () { this.x = KC.clamp(this.x, KC.ARENA.x0 + KC.BODY_W / 2, KC.ARENA.x1 - KC.BODY_W / 2); };\n  // a free step: move, face, jump; or act on the intent\n  P.control = function (intent, foe) {\n    this.intent = intent || { posture: 'n', tech: null };\n    if (this.state === 'down' || this.state === 'hit' || this.state === 'rise') return;\n    if (this.state === 'tech') {\n      // buffer a press made while busy: kept for 0.15 s and fired on the first free step\n      if (intent && intent.tech) { this.pending = intent.tech; this.pendingPost = intent.posture; this.pendingT = 18; }\n      return;\n    }\n    if (this.state === 'block') return;\n    if (intent && intent.tech) { this.tryStart(intent.tech, intent.posture, foe); }\n  };\n  P.tryStart = function (stick, posture, foe) {\n    const gap = Math.abs(foe.x - this.x) - KC.BODY_W;\n    const grounded = !this.airborne;\n    if (this.state === 'idle' || this.state === 'walk' || this.state === 'bow' || this.state === 'pivot') {\n      let id = KC.DATA.techFor(posture || 'n', stick, gap);\n      if (!id) return false;\n      const T = KC.DATA.techniques[id];\n      if (T.air && grounded && (id === 'jumpSide' || id === 'jumpBack' || id === 'frontFlip' || id === 'backFlip')) { this.vz = KC.TUNE.jump; }\n      if (id === 'jump') this.vz = KC.TUNE.jump;\n      if (id === 'crouch') { this.crouch = true; this.state = 'crouch'; return true; }\n      if (id === 'block') { this.startTech('block', posture); return true; }\n      this.startTech(id, posture);\n      return true;\n    }\n    return false;\n  };\n  // each step: technique progress, movement, buffered presses\n  P.tick = function (dt, foe, live, bout) {\n    if (this.state === 'down') { this.downT--; if (this.downT <= 0) { this.state = 'rise'; this.stun = 36; } return; }\n    if (this.state === 'rise') { this.stun--; if (this.stun <= 0) { this.state = 'idle'; } return; }\n    if (this.state === 'hit') { this.stun--; if (this.stun <= 0) this.state = 'idle'; return; }\n    if (this.recoilT > 0) this.recoilT -= dt;\n    // flight: gravity\n    if (this.z > 0 || this.vz !== 0) {\n      this.vz -= KC.TUNE.gravity * dt;\n      this.z += this.vz * dt;\n      if (this.z <= 0) { this.z = 0; this.vz = 0; this.flipping = false; this.vx = 0; this.justLanded = true; if (this.tech && (KC.DATA.techniques[this.tech.id].air || KC.DATA.techniques[this.tech.id].flip)) this.tech.ph = 2; }\n    }\n    if (this.state === 'tech' && this.tech) {\n      const T = KC.DATA.techniques[this.tech.id];\n      const tch = this.tech;\n      if (tch.ph === 0) { tch.t++; if (tch.t >= tch.s) { tch.ph = 1; tch.t = 0; } }\n      else if (tch.ph === 1) {\n        tch.t++;\n        if (T.block) { this.guard = tch.t; }\n        if (this.travelPerStep && !T.air) this.x += this.travelPerStep * (this.tech.ph === 1 ? 1 : 0) * dt * 120 / 120;\n        if (!T.air && !T.flip && !T.roll && this.travelPerStep) this.x += this.travelPerStep;\n        if (tch.t >= tch.a) { tch.ph = 2; tch.t = 0; }\n      } else if (tch.ph === 2) {\n        tch.t++;\n        if (tch.t >= tch.r) { this.endTech(); }\n      }\n      if (this.state === 'tech' && this.tech) {\n        // buffered press\n        if (this.pending && this.tech.ph === 2 && this.pendingT > 0) { }\n      }\n      if (this.tech && (T.flip || T.roll) && this.tech.ph === 2 && !this.airborne) { }\n      if (this.tech && this.tech.id === 'backRoll') this.x += this.dir * 0;\n    }\n    if (this.state === 'tech' && this.tech && this.tech.ph === 1 && this.tech.id === 'backRoll') { this.x -= 0; }\n    if (this.state === 'crouch') { if (!(this.intent && this.intent.posture === 'd')) { this.state = 'idle'; this.crouch = false; } }\n    if (this.state === 'walk' || this.state === 'idle' || this.state === 'pivot') {\n      if (live && this.intent) this.walkIntent(dt, foe);\n      if (this.pendingT > 0) { this.pendingT--; }\n    }\n    // the pivot to face the foe\n    if (this.state !== 'tech' && !this.airborne) this.facing = foe.x >= this.x ? 1 : -1;\n    // separation\n    this.clampX();\n    if (bout) this.separate(foe);\n    if (this.pendingT > 0 && this.state !== 'tech') this.pendingT--;\n    // if free, use a buffered technique\n    if (this.pending && this.state !== 'tech' && this.pendingT > 0 && (this.state === 'idle' || this.state === 'walk')) {\n      const st = this.pending; this.pending = null; this.pendingT = 0;\n      this.tryStart(st, this.pendingPost, foe);\n    }\n    // a technique that ends while the foe is in the air? nothing special\n  };\n  P.endTech = function () {\n    const id = this.tech.id;\n    this.tech = null; this.pending = null;\n    this.state = 'idle'; this.guard = 0; this.flipping = false; this.travelPerStep = 0;\n    this.crouch = false;\n    if (this.z > 0) { this.state = 'idle'; }\n  };\n  P.walkIntent = function (dt, foe) {\n    const p = this.intent.posture;\n    const toward = this.dir * (foe.x > this.x ? 1 : -1);\n    let vx = 0;\n    if (p === 't') vx = this.dir * 0 + (foe.x > this.x ? 1 : -1) * KC.TUNE.walk * this.stats.walk * (this.r.ai && this.r.ai.walk && this.id !== 'buta' ? 1 : 1);\n    else if (p === 'a') vx = -(foe.x > this.x ? 1 : -1) * KC.WALK_AWAY * this.stats.walk;\n    if (this.id === 'buta' && p === 't') vx = (foe.x > this.x ? 1 : -1) * 60 * this.stats.walk;\n    this.x += vx * dt; this.vx = vx;\n    this.state = vx !== 0 ? 'walk' : 'idle';\n    if (p === 'd' && !this.airborne) { this.crouch = true; this.state = 'crouch'; }\n    else this.crouch = false;\n    if (p === 'u' && !this.airborne && !this.tech) { this.vz = KC.TUNE.jump; this.state = 'jump'; }\n    this.clampX();\n  };\n  P.separate = function (foe) {\n    const d = this.x - foe.x, min = KC.BODY_W;\n    if (Math.abs(d) < min && !this.airborne && !foe.airborne) {\n      const push = (min - Math.abs(d)) / 2 * (d >= 0 ? 1 : -1 || 1);\n      if (d === 0) { return; }\n      this.x += push; foe.x -= push;\n      this.clampX(); foe.clampX();\n    }\n  };\n  // the rig state for the view: serializable (6.1's rule, so online guests pose the same way)\n  P.poseState = function () {\n    const tech = this.tech ? this.tech.id : null;\n    return { id: this.id, x: this.x, z: this.z, facing: this.facing, state: this.state, tech, ph: this.tech ? this.tech.ph : -1, t: this.tech ? this.tech.t : 0, crouch: this.crouch, down: this.state === 'down' ? 1 : 0, flip: this.flipping, guard: this.guard > 0 || this.state === 'tech' && this.tech && this.tech.id === 'block' };\n  };\n})();\n\n// ---------------------------------------------------------------- the CPU (6)\nKC.levelParams = (L) => {\n  const t = (L - 1) / 9;\n  const s = (a, b) => a + (b - a) * t;\n  return { react: s(0.55, 0.12) * KC.TUNE.cpuReact, think: s(0.50, 0.14), readP: s(0.25, 0.92), mistake: s(0.30, 0.02) };\n};\n// the stick that makes a technique from posture 'n' or its posture, inverse of the matrix\nKC.DATA.inverse = (() => {\n  const inv = {};\n  for (const p of Object.keys(KC.DATA.matrix)) for (const s of Object.keys(KC.DATA.matrix[p])) {\n    const id = KC.DATA.matrix[p][s];\n    if (!inv[id]) inv[id] = { posture: p, stick: s };\n  }\n  return inv;\n})();\nKC.KarateAI = class KarateAI {\n  constructor(fighter, seed, o = {}) {\n    this.f = fighter; this.rng = E.rng(seed >>> 0 || 1);\n    this.level = o.level || (fighter.r.ai ? fighter.r.ai.level : 3);\n    const L = KC.TUNE.cpuLevel > 0 && !o.noOverride ? KC.TUNE.cpuLevel : this.level;\n    this.L = L;\n    this.p = KC.levelParams(L);\n    this.ai = fighter.r.ai || { aggr: 0.5, patience: 0.4, jump: 0.1, block: 0.3, gap: 40, weights: { roundKick: 1 } };\n    this.aggr = KC.TUNE.cpuAggression >= 0 ? KC.TUNE.cpuAggression : this.ai.aggr;\n    this.think = 0; this.hold = null; this.holdT = 0; this.obsQueue = []; this.habit = {};\n    this.lastSeen = null; this.punishT = 0;\n  }\n  observe(foe) {\n    const tech = foe.tech ? foe.tech.id : null;\n    return { tech, ph: foe.tech ? foe.tech.ph : -1, air: foe.airborne, crouch: foe.crouch, down: foe.state === 'down' || foe.state === 'rise', gap: Math.abs(foe.x - this.f.x) - KC.BODY_W };\n  }\n  intent(foe, dt) {\n    const f = this.f;\n    this.obsQueue.push(this.observe(foe));\n    const delay = Math.max(1, Math.round(this.p.react * 120));\n    while (this.obsQueue.length > delay) this.lastSeen = this.obsQueue.shift();\n    if (this.holdT > 0) { this.holdT -= dt; return this.hold; }\n    this.think -= dt;\n    if (this.think > 0) return this.idleIntent(foe);\n    this.think = this.p.think * (0.9 + 0.2 * this.rng());\n    const seen = this.lastSeen || this.observe(foe);\n    const gap = Math.abs(foe.x - f.x) - KC.BODY_W;\n    let out = null;\n    // react to a seen technique\n    if (seen.tech && (seen.ph === 0 || seen.ph === 1) && this.rng() < this.p.readP) {\n      const T = KC.DATA.techniques[seen.tech];\n      if (T.height === 'low') out = this.rng() < this.ai.jump + 0.4 ? { posture: 'u', tech: null } : null;\n      else if (T.height === 'high') out = this.rng() < 0.6 ? { posture: 'd', tech: null } : { posture: 'a', tech: null };\n      else if (T.height === 'mid') out = this.rng() < this.ai.block ? { posture: 'a', tech: 't' } : { posture: 'a', tech: null };\n      if (seen.air && gap < 40) out = { posture: 'd', tech: 'u' };\n    }\n    // punish a foe in recovery\n    if (!out && seen.ph === 2 && gap <= 40 && this.rng() < 0.85) out = this.best(gap);\n    if (!out) {\n      const pick = this.pickWeighted(gap);\n      if (pick && this.rng() < this.aggr) out = pick;\n      else if (this.rng() < this.ai.patience * 0.3) out = { posture: 'a', tech: null };\n      else out = { posture: gap > this.ai.gap + 6 ? 't' : (gap < this.ai.gap - 6 ? 'a' : 'n'), tech: null };\n    }\n    if (this.rng() < this.p.mistake) out = { posture: 'n', tech: KC.pick(this.rng, ['u', 't', 'd', 'a']) };\n    if (out && out.tech && out.posture === 'n' && this.rng() < 0.3) out.posture = 't';\n    this.hold = out || { posture: 'n', tech: null }; this.holdT = 0.08;\n    return this.hold;\n  }\n  idleIntent(foe) { return this.hold ? { posture: this.hold.posture, tech: null } : { posture: 'n', tech: null }; }\n  best(gap) {\n    const ids = Object.keys(this.ai.weights);\n    let best = null, bestW = -1;\n    for (const id of ids) {\n      const T = KC.DATA.techniques[id]; if (!T || !T.reach) continue;\n      if (gap < T.reach[0] || gap > T.reach[1]) continue;\n      const w = this.ai.weights[id];\n      if (w > bestW) { bestW = w; best = id; }\n    }\n    if (!best) return null;\n    const inv = KC.DATA.inverse[best]; if (!inv) return null;\n    return { posture: inv.posture === 'n' ? 'n' : inv.posture, tech: inv.stick };\n  }\n  pickWeighted(gap) {\n    const ids = Object.keys(this.ai.weights).filter(id => { const T = KC.DATA.techniques[id]; return T && T.reach && gap >= T.reach[0] - 6 && gap <= T.reach[1] + 6; });\n    if (!ids.length) return null;\n    let total = 0; for (const id of ids) total += this.ai.weights[id];\n    let r = this.rng() * total, pick = ids[0];\n    for (const id of ids) { r -= this.ai.weights[id]; if (r <= 0) { pick = id; break; } }\n    const inv = KC.DATA.inverse[pick]; if (!inv) return null;\n    return { posture: inv.posture, tech: inv.stick };\n  }\n};\nKC.pick = (rng, arr) => arr[Math.floor(rng() * arr.length) % arr.length];\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011uxDR63UvAkbCrRNTSHYQT","type":"tool_result","content":"File created successfully at: /home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184315__x1295cd/work/KarateChampon-KarateChamp1984-claude-haiku-5-5-medium-20261103-184315/src/10-sim.js (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"14f34045-19a9-4c91-b4b0-8ef52e3ad772","uuid":"fbcf1756-334a-4b1c-904a-1e6eed37e2ad","timestamp":"2026-11-04T01:47:35.875Z","tool_use_result":{"type":"create","filePath":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-184315__x1295cd/work/KarateChampon-KarateChamp1984-claude-haiku-5-5-medium-20261103-184315/src/10-sim.js","content":"// ---------------------------------------------------------------- the fight simulation (no drawing; deterministic; 120 Hz steps)\n// Positions: x 0..400 (the arena), z is height. Directions in the sim are RELATIVE to the foe: 't' toward, 'a' away.\nKC.ARENA = { x0: 0, x1: 400, marks: [150, 250] };\nKC.BODY_W = 18;           // push box width: contact means a gap of 0\nKC.STEP = 1 / 120;\nKC.WALK_AWAY = 56;\n\n// a screen direction ('l' | 'r' | 'u' | 'd' | 'n') to a relative one for a fighter whose foe is on side foeDir (+1 right, -1 left)\nKC.relDir = (screen, foeDir) => {\n  if (screen === 'r') return foeDir > 0 ? 't' : 'a';\n  if (screen === 'l') return foeDir > 0 ? 'a' : 't';\n  return screen;\n};\nKC.screenDir = (rel, foeDir) => {\n  if (rel === 't') return foeDir > 0 ? 'r' : 'l';\n  if (rel === 'a') return foeDir > 0 ? 'l' : 'r';\n  return rel;\n};\n\n// the input of a human: posture from the left stick / WASD (held) and the technique from the press edges of the right stick\nKC.readControl = (input, foeDir, prev) => {\n  const held = (a) => input.down(a);\n  let px = 'n';\n  if (held('up') && !held('down')) px = 'u';\n  else if (held('down') && !held('up')) px = 'd';\n  else if (held('left') && !held('right')) px = 'l';\n  else if (held('right') && !held('left')) px = 'r';\n  // when jumping, the posture stays up; when crouching it stays down\n  const pad = input.padAim || null;\n  let edge = null;\n  if (input.pressed('tUp')) edge = 'u';\n  else if (input.pressed('tDown')) edge = 'd';\n  else if (input.pressed('tLeft')) edge = 'l';\n  else if (input.pressed('tRight')) edge = 'r';\n  // right stick (the DualSense's), read directly with a 4-way gate and hysteresis\n  if (pad && prev) {\n    const q = KC.quantize(pad[0], -pad[1]);  // stick y is down-positive; flip so up is up\n    if (q && q !== prev.padQ) edge = edge || q;\n    prev.padQ = q;\n  } else if (prev) prev.padQ = null;\n  const pr = (s) => (s === 'u' || s === 'd') ? s : KC.relDir(s, foeDir);\n  let rel = pr(px);\n  // a posture of 'n' (no left-stick direction) keeps neutral; a press of the right stick uses it\n  return { posture: rel === 'n' ? 'n' : rel, tech: edge ? (edge === 'u' || edge === 'd' ? edge : KC.relDir(edge, foeDir)) : null };\n};\n\n// Karateka: one fighter. Its control: intent = { posture, tech } in relative terms (t, a, u, d, n) and tech stick (u, t, d, a).\nKC.Karateka = class Karateka {\n  constructor(o) {\n    this.id = o.id; this.r = KC.DATA.roster[o.id]; this.side = o.side; this.ai = o.ai || null;\n    this.stats = Object.assign({ walk: 1, reach: 1, speed: 1 }, this.r.stats || {});\n    this.reset(true);\n    this.score = 0; this.hitsMade = { full: 0, half: 0, blocks: 0, counters: 0 }; this.best = null;\n    this.bestPts = 0;\n  }\n  reset(full) {\n    this.x = this.side === 'w' ? KC.ARENA.marks[0] : KC.ARENA.marks[1];\n    this.z = 0; this.vz = 0; this.vx = 0; this.facing = this.side === 'w' ? 1 : -1;\n    this.state = 'idle'; this.tech = null; this.guard = 0; this.stun = 0; this.downT = 0; this.crouch = false;\n    this.pending = null; this.pendingT = 0; this.recoilT = 0; this.flipping = false; this.lastDown = false; this.turn = 0;\n    this.lastTech = null; this.knocked = false; this.pose = null; this.spinT = 0;\n    if (full) this.flip = false;\n  }\n  get dir() { return this.side === 'w' ? 1 : -1; }\n  get airborne() { return this.z > 0.01 || this.vz > 0.01; }\n  // frames (60 Hz) to steps (120 Hz), scaled by this fighter's speed and the tuning\n  steps(frames) { return Math.max(1, Math.round(frames * 2 / (this.stats.speed * KC.TUNE.techSpeed))); }\n  // a technique's phase lengths (steps)\n  techSteps(id) {\n    const T = KC.DATA.techniques[id];\n    if (T.block) return { s: 1, a: Math.round(KC.TUNE.blockWindow * 2), r: 8 };\n    return { s: this.steps(T.f[0]), a: this.steps(T.f[1]), r: this.steps(T.f[2]) };\n  }\n  // start a technique (relative stick). posture is the rel posture at the press\n  startTech(id, posture) {\n    const T = KC.DATA.techniques[id], d = this.techSteps(id);\n    this.tech = { id, ph: 0, t: 0, s: d.s, a: d.a, r: d.r, hit: false, posture, upT: T.flip || T.air || T.block ? 0 : 8, startX: this.x, t0: 0, counterOpen: false };\n    this.lastTech = id;\n    this.state = 'tech';\n    if (T.air || T.flip || id === 'jump') { this.vz = KC.TUNE.jump * (T.flip ? 1.03 : 1); if (T.flip) this.vz = 370; if (id === 'jump') this.vz = KC.TUNE.jump; this.flipping = !!T.flip; }\n    if (id === 'jumpSide' || id === 'jumpBack') this.vz = KC.TUNE.jump;\n    if (T.travel && !T.air && !T.flip && !T.roll) this.travelPerStep = T.travel * this.dir / Math.max(1, (d.s + d.a));\n    else this.travelPerStep = 0;\n    if (T.flip) this.vx = (T.travel * this.dir) / 0.67;\n    if (T.roll) this.vx = T.travel * this.dir / 0.75;\n    if (id === 'block') this.guard = 0;\n    if (id === 'crouch') this.crouch = true;\n    this.turn = 0;\n    this.spinT = T.spin ? 1 : 0;\n  }\n  // the foe is 'hittable' by this fighter's technique at all? (height and state rules, 4.3)\n  hittableBy(tech, foe) {\n    const T = tech;\n    if (foe.state === 'down' || foe.state === 'rise' || foe.flipping && foe.z > 0 && T.height !== 'high' && !T.antiAir) return false;\n    if (foe.state === 'hit' && foe.downT <= 0 && false) return false;\n    if (foe.airborne) {\n      if (T.height === 'high' || T.antiAir) return T.antiAir ? foe.vz > 0 || foe.tech && foe.tech.id === 'frontFlip' || foe.z > 0 : true;\n      return false;\n    }\n    if (foe.crouch) {\n      if (T.height === 'high') return false;\n      if (T.height === 'mid') return !!T.hitsCrouch;\n      return true;\n    }\n    return true;\n  }\n  rigState(extra) { return null; }\n};\n\n// ---------------------------------------------------------------- Bout: the referee's state machine (5.2) plus the scoring (4.5)\nKC.Bout = class Bout {\n  constructor(o) {\n    this.a = o.white; this.b = o.red;              // the two fighters (a = white, the left mark)\n    this.seed = o.seed >>> 0 || 1;\n    this.rng = E.rng(this.seed);\n    this.judgeRng = [E.rng(this.seed + 1), E.rng(this.seed + 2)];\n    this.roundsToWin = o.roundsToWin || KC.TUNE.roundsToWin;\n    this.pointsToWin = o.pointsToWin || KC.TUNE.pointsToWin;\n    this.listeners = {};\n    this.round = 1; this.roundWins = [0, 0]; this.matchOver = null;\n    this.rounds = [];\n    this.intro = o.intro !== false;\n    this.clock = KC.TUNE.clock; this.clockStart = KC.TUNE.clock;\n    this.pace = KC.TUNE.refPace || 1;\n    this.phase = 'intro'; this.phaseT = 0; this.stepCount = 0;\n    this.points = [0, 0]; this.roundStats = [{ full: 0, half: 0, blocks: 0 }, { full: 0, half: 0, blocks: 0 }];\n    this.techPts = [0, 0]; this.attempts = [0, 0]; this.blocksRound = [0, 0];\n    this.pendingHit = null; this.lastCall = null; this.lastPoint = null; this.hitstopT = 0;\n    this.log = [];\n    this.stopped = false; this.hantei = null;\n    this.setPhase(this.intro ? 'intro' : 'rei');\n  }\n  on(name, fn) { (this.listeners[name] = this.listeners[name] || []).push(fn); return this; }\n  emit(name, data) { this.log.push([name, data && (data.text || data.side || '')]); if (this.log.length > 400) this.log.shift(); (this.listeners[name] || []).forEach(f => f(data)); (this.listeners['*'] || []).forEach(f => f(name, data)); }\n  call(id, sub) { const t = KC.TEXT.calls[id] ? KC.TEXT.calls[id][KC.calls === 'Japanese' ? 1 : 0] : id; this.lastCall = { id, text: t, sub: sub || null, at: this.stepCount }; this.emit('call', { id, text: t, sub }); return t; }\n  pt(sec) { return sec * this.pace; }\n  setPhase(p) {\n    this.phase = p; this.phaseT = 0;\n    const P = { intro: 1.2, rei: 0.9, card: 0.9, ready: 0.4, hajime: 0.6, yame: 0.9, award: 1.2, reset: 1.2, roundEnd: 2.0, time: 0.8, hantei: 2.4, matchEnd: 2.5 };\n    this.phaseLen = P[p] !== undefined ? this.pt(P[p]) : 0;\n    if (p === 'intro') { this.a.x = 0 + 8; this.b.x = 400 - 8; this.a.facing = 1; this.b.facing = -1; this.a.state = 'walk'; this.b.state = 'walk'; }\n    if (p === 'rei') { this.a.state = 'bow'; this.b.state = 'bow'; this.call('bow'); }\n    if (p === 'card') { this.a.state = 'idle'; this.b.state = 'idle'; this.a.crouch = false; this.b.crouch = false; this.emit('card', { round: this.round, decider: this.round === 3 }); }\n    if (p === 'ready') { this.a.reset(false); this.b.reset(false); this.a.x = KC.ARENA.marks[0]; this.b.x = KC.ARENA.marks[1]; this.a.facing = 1; this.b.facing = -1; }\n    if (p === 'hajime') { this.call('begin'); this.emit('begin', {}); }\n    if (p === 'fight') { this.clock = this.clockStart; this.attempts = [0, 0]; this.techPts = [0, 0]; this.blocksRound = [0, 0]; this.emit('fight', {}); }\n    if (p === 'yame') { this.call('stop'); this.emit('yame', {}); }\n    if (p === 'roundEnd') { this.emit('roundEnd', { winner: this.roundWinner }); }\n    if (p === 'matchEnd') { this.emit('matchEnd', { winner: this.matchOver }); }\n  }\n  get fighters() { return [this.a, this.b]; }\n  // the sim's one step (dt in seconds; sim uses fixed steps)\n  step(dt, ctl) {\n    this.stepCount++; this.phaseT += dt;\n    const f = this.phase;\n    if (f === 'intro') { this.walkTo(dt, 'marks', 60); if (this.phaseT >= this.phaseLen) this.setPhase('rei'); return; }\n    if (f === 'rei') { if (this.phaseT >= this.phaseLen) this.setPhase('card'); return; }\n    if (f === 'card') { if (this.phaseT >= this.phaseLen) this.setPhase('ready'); return; }\n    if (f === 'ready') { this.a.state = 'idle'; this.b.state = 'idle'; if (this.phaseT >= this.phaseLen) this.setPhase('hajime'); return; }\n    if (f === 'hajime') { if (this.phaseT >= this.phaseLen) this.setPhase('fight'); return; }\n    if (f === 'fight') return this.fightStep(dt, ctl);\n    if (f === 'stop') { this.tickFighters(dt, null); if (this.hitstopT > 0) { this.hitstopT -= dt; if (this.hitstopT <= 0) this.phaseT = 0; return; } }\n    if (f === 'yame') { this.tickFighters(dt, null); if (this.phaseT >= this.phaseLen) this.setPhase('award'); return; }\n    if (f === 'award') { this.tickFighters(dt, null); if (this.phaseT >= this.phaseLen) this.afterAward(); return; }\n    if (f === 'reset') { this.walkTo(dt, 'marks', 2 * 72); const at = Math.abs(this.a.x - KC.ARENA.marks[0]) < 0.5 && Math.abs(this.b.x - KC.ARENA.marks[1]) < 0.5; if (at || this.phaseT > 1.2 * 1.5) this.setPhase('card'); return; }\n    if (f === 'roundEnd') { if (this.phaseT >= this.phaseLen) { this.matchOver ? this.setPhase('matchEnd') : this.nextRound(); } return; }\n    if (f === 'time') { if (this.phaseT >= this.phaseLen) this.setPhase('hantei'); return; }\n    if (f === 'hantei') { if (this.phaseT >= this.phaseLen) this.afterHantei(); return; }\n    if (f === 'matchEnd') { if (this.phaseT >= this.phaseLen) this.emit('done', { winner: this.matchOver }); return; }\n  }\n  walkTo(dt, what, speed) {\n    const tgt = KC.ARENA.marks;\n    for (const [f, t] of [[this.a, tgt[0]], [this.b, tgt[1]]]) {\n      const d = t - f.x, s = Math.min(Math.abs(d), speed * dt);\n      f.x += Math.sign(d) * s; f.state = Math.abs(d) > 0.5 ? 'walk' : 'idle';\n      f.facing = this.a === f ? 1 : -1;\n    }\n  }\n  nextRound() {\n    this.round++; this.points = [0, 0]; this.a.reset(false); this.b.reset(false);\n    this.setPhase('reset');\n  }\n  afterAward() {\n    this.roundCheckAfterAward ? null : null;\n    if (this.clock <= 0 && !this.pendingDecider) { }\n    if (this.points[0] >= this.pointsToWin || this.points[1] >= this.pointsToWin) return this.endRound(this.points[0] >= this.pointsToWin ? 0 : 1);\n    this.setPhase('reset');\n  }\n  endRound(side, why) {\n    this.roundWinner = side; this.roundWins[side]++;\n    this.rounds.push({ winner: side, points: this.points.slice(), why: why || 'points', stats: this.roundStats.map(s => Object.assign({}, s)) });\n    this.roundStats = [{ full: 0, half: 0, blocks: 0 }, { full: 0, half: 0, blocks: 0 }];\n    this.matchOver = this.roundWins[side] >= this.roundsToWin ? side : null;\n    this.call(side === 0 ? 'whiteWins' : 'redWins');\n    this.setPhase('roundEnd');\n  }\n  fightStep(dt, ctl) {\n    // time runs only in the fight\n    if (!KC.TOGGLES.infiniteTime) this.clock = Math.max(0, this.clock - dt * KC.TUNE.gameSpeed);\n    if (this.clock <= 0 && !this.pendingHit) {\n      this.call('time');\n      return this.setPhase('time');\n    }\n    const cA = ctl && ctl.a ? ctl.a() : null, cB = ctl && ctl.b ? ctl.b() : null;\n    if (this.phaseT >= 0.35 * this.pace && !this.pendingHit) {\n      this.a.control(cA, this.b); this.b.control(cB, this.a);\n    }\n    this.tickFighters(dt, true);\n    // attacks connect: check each active technique\n    const hitA = this.checkHit(this.a, this.b), hitB = this.checkHit(this.b, this.a);\n    if (this.pendingHit) {\n      this.pendingHit.t -= 1;\n      if (this.pendingHit.t <= 0) {\n        this.resolveFirst();\n      }\n      if (hitA || hitB) { this.aiuchiWindow = true; }\n    } else if (hitA || hitB) {\n      const first = hitA || hitB;\n      // the other fighter may land in the same window\n      this.pendingHit = { t: 6, first, other: hitA ? hitB : hitA };\n      if (hitA && hitB) this.pendingHit.both = true;\n    }\n    if (this.pendingHit && (this.pendingHit.both)) { this.resolveAiuchi(); }\n  }\n  checkHit(att, def) {\n    if (att.state !== 'tech' || !att.tech) return false;\n    const T = KC.DATA.techniques[att.tech.id];\n    if (!T.reach || att.tech.hit || att.tech.ph !== 1) return false;\n    const gap = Math.abs(def.x - att.x) - KC.BODY_W;\n    // must be in front of the attacker: their technique is toward the foe\n    const dirOk = Math.sign(def.x - att.x) === att.dir || (att.tech && (T.spin || T.block));\n    if (!dirOk && !T.spin) return false;\n    const maxR = T.reach[1] * KC.TUNE.reachScale * att.stats.reach;\n    if (gap > maxR || gap < -KC.BODY_W) return false;\n    if (!att.hittableBy(T, def)) { if (!att.blockedOnce) { } return false; }\n    // blocks: a guard stops high and mid techniques\n    if (def.state === 'tech' && def.tech && def.tech.id === 'block' && def.tech.ph === 1 && !T.unblockable) {\n      this.blocked(att, def, T);\n      att.tech.hit = true;\n      return false;\n    }\n    att.tech.hit = true;\n    att.tech.gap = gap;\n    this.landed(att, def, T);\n    return true;\n  }\n  blocked(att, def, T) {\n    this.blocksRound[def === this.a ? 0 : 1]++; this.roundStats[def === this.a ? 0 : 1].blocks++;\n    att.x -= att.dir * 14; if (att.tech) att.tech.r += 20;\n    att.recoilT = 0.2;\n    def.tech.ph = 2; def.tech.r = 0; def.guard = 0;\n    this.emit('block', { by: def.side, tech: T.name });\n  }\n  landed(att, def, T) {\n    const d = att.tech, stepsIn = d.a > 0 ? Math.max(0, d.t) : 0;\n    const frac = d.a > 1 ? Math.min(1, d.t / (d.a - 1)) : 0;\n    const timingQ = frac <= 0.4 ? 1 : Math.max(0.3, 1 - (frac - 0.4) / 0.6 * 0.7);\n    const r0 = T.reach[0], r1 = T.reach[1] * KC.TUNE.reachScale * att.stats.reach;\n    const band = Math.max(1, r1 - r0), t = KC.clamp((d.gap - r0) / band, 0, 1);\n    const spacingQ = Math.min(1, t / 0.7);\n    let q = Math.max(0.15, 0.5 * timingQ + 0.5 * spacingQ);\n    if (att.r.sig === d.id) q = Math.min(1, q + 0.1);\n    if (T.antiAir && def.airborne) q = Math.min(1, q + 0.25);\n    let pts = T.pts[0] + Math.round((T.pts[1] - T.pts[0]) * q / 100) * 100;\n    pts = KC.clamp(pts, T.pts[0], T.pts[1]);\n    const counter = def.state === 'tech' && !!def.tech && def.tech.id !== 'block' || def.recoilT > 0;\n    if (counter) pts = Math.min(1000, Math.round(pts * KC.TUNE.counterMul));\n    const full = pts >= KC.TUNE.fullAt;\n    const side = att === this.a ? 0 : 1;\n    this.pendingLanded = { att, def, T, pts, full, counter, q, timingQ, spacingQ, side, id: d.id, gap: d.gap };\n    if (!this.pendingHit) this.pendingHit = null;\n    this.pendingGood = this.pendingLanded;\n    // remember this so an aiuchi can cancel both\n    this.lastLanded = this.pendingLanded;\n  }\n  resolveFirst() {\n    const p = this.pendingGood || this.lastLanded;\n    this.pendingHit = null;\n    if (p && !p.resolved) this.award(p);\n    this.pendingGood = null;\n  }\n  resolveAiuchi() {\n    this.pendingHit = null; this.pendingGood = null;\n    this.call('aiuchi');\n    this.emit('aiuchi', {});\n    this.setPhase('yame');\n  }\n  award(p) {\n    p.resolved = true;\n    const si = p.side, sc = si === 0 ? 0 : 1;\n    const e = p.def;\n    if (p.full || p.pts >= 600) this.roundStats[sc].full++; else this.roundStats[sc].half++;\n    const pointsValue = p.full ? 1 : 0.5;\n    this.points[sc] += pointsValue;\n    this.techPts[sc] += p.pts;\n    this.attempts[sc]++;\n    p.att.score += p.pts; p.att.bestPts = Math.max(p.att.bestPts, p.pts);\n    if (p.full) p.att.hitsMade.full++; else p.att.hitsMade.half++;\n    if (p.counter) p.att.hitsMade.counters++;\n    this.lastPoint = { side: si, pts: p.pts, full: p.full, counter: p.counter, tech: p.id, q: p.q, timingQ: p.timingQ, spacingQ: p.spacingQ };\n    // the defender's reaction\n    if (p.full || KC.DATA.techniques[p.id].knockdown) { e.knock(p.att.dir); }\n    else { e.stagger(p.att.dir); }\n    this.emit('point', this.lastPoint);\n    this.call(p.full ? 'full' : 'half', p.counter ? 'COUNTER' : null);\n    this.setPhase('yame');\n  }\n  // step the fighters' technique and movement, outside or during the fight\n  tickFighters(dt, live) {\n    for (const f of this.fighters) f.tick(dt, this.foeOf(f), live, this);\n  }\n  foeOf(f) { return f === this.a ? this.b : this.a; }\n  afterHantei() {\n    const sA = this.techPts[0] + 60 * this.attempts[0] + 40 * this.blocksRound[0];\n    const sB = this.techPts[1] + 60 * this.attempts[1] + 40 * this.blocksRound[1];\n    const na = (this.judgeRng[0]() * 2 - 1) * 120, nb = (this.judgeRng[1]() * 2 - 1) * 120;\n    const winner = (sA + na) === (sB + nb) ? (this.lastLanded && this.lastLanded.side === 1 ? 1 : 0) : ((sA + na) > (sB + nb) ? 0 : 1);\n    this.emit('hantei', { winner });\n    this.call('judges');\n    if (this.points[0] !== this.points[1]) {\n      this.endRound(this.points[0] > this.points[1] ? 0 : 1, 'time');\n    } else {\n      this.endRound(winner, 'hantei');\n    }\n  }\n};\n\n// Fighter methods (added to the prototype so the sim stays one readable class above)\n(function () {\n  const P = KC.Karateka.prototype;\n  P.knock = function (dir) { this.state = 'down'; this.downT = KC.TUNE.gameSpeed ? 96 : 96; this.stun = 0; this.tech = null; this.vx = -dir * 40; this.knocked = true; this.x -= dir * 18; this.clampX(); };\n  P.stagger = function (dir) { this.state = 'hit'; this.stun = 30; this.tech = null; this.x -= dir * 10; this.clampX(); };\n  P.clampX = function () { this.x = KC.clamp(this.x, KC.ARENA.x0 + KC.BODY_W / 2, KC.ARENA.x1 - KC.BODY_W / 2); };\n  // a free step: move, face, jump; or act on the intent\n  P.control = function (intent, foe) {\n    this.intent = intent || { posture: 'n', tech: null };\n    if (this.state === 'down' || this.state === 'hit' || this.state === 'rise') return;\n    if (this.state === 'tech') {\n      // buffer a press made while busy: kept for 0.15 s and fired on the first free step\n      if (intent && intent.tech) { this.pending = intent.tech; this.pendingPost = intent.posture; this.pendingT = 18; }\n      return;\n    }\n    if (this.state === 'block') return;\n    if (intent && intent.tech) { this.tryStart(intent.tech, intent.posture, foe); }\n  };\n  P.tryStart = function (stick, posture, foe) {\n    const gap = Math.abs(foe.x - this.x) - KC.BODY_W;\n    const grounded = !this.airborne;\n    if (this.state === 'idle' || this.state === 'walk' || this.state === 'bow' || this.state === 'pivot') {\n      let id = KC.DATA.techFor(posture || 'n', stick, gap);\n      if (!id) return false;\n      const T = KC.DATA.techniques[id];\n      if (T.air && grounded && (id === 'jumpSide' || id === 'jumpBack' || id === 'frontFlip' || id === 'backFlip')) { this.vz = KC.TUNE.jump; }\n      if (id === 'jump') this.vz = KC.TUNE.jump;\n      if (id === 'crouch') { this.crouch = true; this.state = 'crouch'; return true; }\n      if (id === 'block') { this.startTech('block', posture); return true; }\n      this.startTech(id, posture);\n      return true;\n    }\n    return false;\n  };\n  // each step: technique progress, movement, buffered presses\n  P.tick = function (dt, foe, live, bout) {\n    if (this.state === 'down') { this.downT--; if (this.downT <= 0) { this.state = 'rise'; this.stun = 36; } return; }\n    if (this.state === 'rise') { this.stun--; if (this.stun <= 0) { this.state = 'idle'; } return; }\n    if (this.state === 'hit') { this.stun--; if (this.stun <= 0) this.state = 'idle'; return; }\n    if (this.recoilT > 0) this.recoilT -= dt;\n    // flight: gravity\n    if (this.z > 0 || this.vz !== 0) {\n      this.vz -= KC.TUNE.gravity * dt;\n      this.z += this.vz * dt;\n      if (this.z <= 0) { this.z = 0; this.vz = 0; this.flipping = false; this.vx = 0; this.justLanded = true; if (this.tech && (KC.DATA.techniques[this.tech.id].air || KC.DATA.techniques[this.tech.id].flip)) this.tech.ph = 2; }\n    }\n    if (this.state === 'tech' && this.tech) {\n      const T = KC.DATA.techniques[this.tech.id];\n      const tch = this.tech;\n      if (tch.ph === 0) { tch.t++; if (tch.t >= tch.s) { tch.ph = 1; tch.t = 0; } }\n      else if (tch.ph === 1) {\n        tch.t++;\n        if (T.block) { this.guard = tch.t; }\n        if (this.travelPerStep && !T.air) this.x += this.travelPerStep * (this.tech.ph === 1 ? 1 : 0) * dt * 120 / 120;\n        if (!T.air && !T.flip && !T.roll && this.travelPerStep) this.x += this.travelPerStep;\n        if (tch.t >= tch.a) { tch.ph = 2; tch.t = 0; }\n      } else if (tch.ph === 2) {\n        tch.t++;\n        if (tch.t >= tch.r) { this.endTech(); }\n      }\n      if (this.state === 'tech' && this.tech) {\n        // buffered press\n        if (this.pending && this.tech.ph === 2 && this.pendingT > 0) { }\n      }\n      if (this.tech && (T.flip || T.roll) && this.tech.ph === 2 && !this.airborne) { }\n      if (this.tech && this.tech.id === 'backRoll') this.x += this.dir * 0;\n    }\n    if (this.state === 'tech' && this.tech && this.tech.ph === 1 && this.tech.id === 'backRoll') { this.x -= 0; }\n    if (this.state === 'crouch') { if (!(this.intent && this.intent.posture === 'd')) { this.state = 'idle'; this.crouch = false; } }\n    if (this.state === 'walk' || this.state === 'idle' || this.state === 'pivot') {\n      if (live && this.intent) this.walkIntent(dt, foe);\n      if (this.pendingT > 0) { this.pendingT--; }\n    }\n    // the pivot to face the foe\n    if (this.state !== 'tech' && !this.airborne) this.facing = foe.x >= this.x ? 1 : -1;\n    // separation\n    this.clampX();\n    if (bout) this.separate(foe);\n    if (this.pendingT > 0 && this.state !== 'tech') this.pendingT--;\n    // if free, use a buffered technique\n    if (this.pending && this.state !== 'tech' && this.pendingT > 0 && (this.state === 'idle' || this.state === 'walk')) {\n      const st = this.pending; this.pending = null; this.pendingT = 0;\n      this.tryStart(st, this.pendingPost, foe);\n    }\n    // a technique that ends while the foe is in the air? nothing special\n  };\n  P.endTech = function () {\n    const id = this.tech.id;\n    this.tech = null; this.pending = null;\n    this.state = 'idle'; this.guard = 0; this.flipping = false; this.travelPerStep = 0;\n    this.crouch = false;\n    if (this.z > 0) { this.state = 'idle'; }\n  };\n  P.walkIntent = function (dt, foe) {\n    const p = this.intent.posture;\n    const toward = this.dir * (foe.x > this.x ? 1 : -1);\n    let vx = 0;\n    if (p === 't') vx = this.dir * 0 + (foe.x > this.x ? 1 : -1) * KC.TUNE.walk * this.stats.walk * (this.r.ai && this.r.ai.walk && this.id !== 'buta' ? 1 : 1);\n    else if (p === 'a') vx = -(foe.x > this.x ? 1 : -1) * KC.WALK_AWAY * this.stats.walk;\n    if (this.id === 'buta' && p === 't') vx = (foe.x > this.x ? 1 : -1) * 60 * this.stats.walk;\n    this.x += vx * dt; this.vx = vx;\n    this.state = vx !== 0 ? 'walk' : 'idle';\n    if (p === 'd' && !this.airborne) { this.crouch = true; this.state = 'crouch'; }\n    else this.crouch = false;\n    if (p === 'u' && !this.airborne && !this.tech) { this.vz = KC.TUNE.jump; this.state = 'jump'; }\n    this.clampX();\n  };\n  P.separate = function (foe) {\n    const d = this.x - foe.x, min = KC.BODY_W;\n    if (Math.abs(d) < min && !this.airborne && !foe.airborne) {\n      const push = (min - Math.abs(d)) / 2 * (d >= 0 ? 1 : -1 || 1);\n      if (d === 0) { return; }\n      this.x += push; foe.x -= push;\n      this.clampX(); foe.clampX();\n    }\n  };\n  // the rig state for the view: serializable (6.1's rule, so online guests pose the same way)\n  P.poseState = function () {\n    const tech = this.tech ? this.tech.id : null;\n    return { id: this.id, x: this.x, z: this.z, facing: this.facing, state: this.state, tech, ph: this.tech ? this.tech.ph : -1, t: this.tech ? this.tech.t : 0, crouch: this.crouch, down: this.state === 'down' ? 1 : 0, flip: this.flipping, guard: this.guard > 0 || this.state === 'tech' && this.tech && this.tech.id === 'block' };\n  };\n})();\n\n// ---------------------------------------------------------------- the CPU (6)\nKC.levelParams = (L) => {\n  const t = (L - 1) / 9;\n  const s = (a, b) => a + (b - a) * t;\n  return { react: s(0.55, 0.12) * KC.TUNE.cpuReact, think: s(0.50, 0.14), readP: s(0.25, 0.92), mistake: s(0.30, 0.02) };\n};\n// the stick that makes a technique from posture 'n' or its posture, inverse of the matrix\nKC.DATA.inverse = (() => {\n  const inv = {};\n  for (const p of Object.keys(KC.DATA.matrix)) for (const s of Object.keys(KC.DATA.matrix[p])) {\n    const id = KC.DATA.matrix[p][s];\n    if (!inv[id]) inv[id] = { posture: p, stick: s };\n  }\n  return inv;\n})();\nKC.KarateAI = class KarateAI {\n  constructor(fighter, seed, o = {}) {\n    this.f = fighter; this.rng = E.rng(seed >>> 0 || 1);\n    this.level = o.level || (fighter.r.ai ? fighter.r.ai.level : 3);\n    const L = KC.TUNE.cpuLevel > 0 && !o.noOverride ? KC.TUNE.cpuLevel : this.level;\n    this.L = L;\n    this.p = KC.levelParams(L);\n    this.ai = fighter.r.ai || { aggr: 0.5, patience: 0.4, jump: 0.1, block: 0.3, gap: 40, weights: { roundKick: 1 } };\n    this.aggr = KC.TUNE.cpuAggression >= 0 ? KC.TUNE.cpuAggression : this.ai.aggr;\n    this.think = 0; this.hold = null; this.holdT = 0; this.obsQueue = []; this.habit = {};\n    this.lastSeen = null; this.punishT = 0;\n  }\n  observe(foe) {\n    const tech = foe.tech ? foe.tech.id : null;\n    return { tech, ph: foe.tech ? foe.tech.ph : -1, air: foe.airborne, crouch: foe.crouch, down: foe.state === 'down' || foe.state === 'rise', gap: Math.abs(foe.x - this.f.x) - KC.BODY_W };\n  }\n  intent(foe, dt) {\n    const f = this.f;\n    this.obsQueue.push(this.observe(foe));\n    const delay = Math.max(1, Math.round(this.p.react * 120));\n    while (this.obsQueue.length > delay) this.lastSeen = this.obsQueue.shift();\n    if (this.holdT > 0) { this.holdT -= dt; return this.hold; }\n    this.think -= dt;\n    if (this.think > 0) return this.idleIntent(foe);\n    this.think = this.p.think * (0.9 + 0.2 * this.rng());\n    const seen = this.lastSeen || this.observe(foe);\n    const gap = Math.abs(foe.x - f.x) - KC.BODY_W;\n    let out = null;\n    // react to a seen technique\n    if (seen.tech && (seen.ph === 0 || seen.ph === 1) && this.rng() < this.p.readP) {\n      const T = KC.DATA.techniques[seen.tech];\n      if (T.height === 'low') out = this.rng() < this.ai.jump + 0.4 ? { posture: 'u', tech: null } : null;\n      else if (T.height === 'high') out = this.rng() < 0.6 ? { posture: 'd', tech: null } : { posture: 'a', tech: null };\n      else if (T.height === 'mid') out = this.rng() < this.ai.block ? { posture: 'a', tech: 't' } : { posture: 'a', tech: null };\n      if (seen.air && gap < 40) out = { posture: 'd', tech: 'u' };\n    }\n    // punish a foe in recovery\n    if (!out && seen.ph === 2 && gap <= 40 && this.rng() < 0.85) out = this.best(gap);\n    if (!out) {\n      const pick = this.pickWeighted(gap);\n      if (pick && this.rng() < this.aggr) out = pick;\n      else if (this.rng() < this.ai.patience * 0.3) out = { posture: 'a', tech: null };\n      else out = { posture: gap > this.ai.gap + 6 ? 't' : (gap < this.ai.gap - 6 ? 'a' : 'n'), tech: null };\n    }\n    if (this.rng() < this.p.mistake) out = { posture: 'n', tech: KC.pick(this.rng, ['u', 't', 'd', 'a']) };\n    if (out && out.tech && out.posture === 'n' && this.rng() < 0.3) out.posture = 't';\n    this.hold = out || { posture: 'n', tech: null }; this.holdT = 0.08;\n    return this.hold;\n  }\n  idleIntent(foe) { return this.hold ? { posture: this.hold.posture, tech: null } : { posture: 'n', tech: null }; }\n  best(gap) {\n    const ids = Object.keys(this.ai.weights);\n    let best = null, bestW = -1;\n    for (const id of ids) {\n      const T = KC.DATA.techniques[id]; if (!T || !T.reach) continue;\n      if (gap < T.reach[0] || gap > T.reach[1]) continue;\n      const w = this.ai.weights[id];\n      if (w > bestW) { bestW = w; best = id; }\n    }\n    if (!best) return null;\n    const inv = KC.DATA.inverse[best]; if (!inv) return null;\n    return { posture: inv.posture === 'n' ? 'n' : inv.posture, tech: inv.stick };\n  }\n  pickWeighted(gap) {\n    const ids = Object.keys(this.ai.weights).filter(id => { const T = KC.DATA.techniques[id]; return T && T.reach && gap >= T.reach[0] - 6 && gap <= T.reach[1] + 6; });\n    if (!ids.length) return null;\n    let total = 0; for (const id of ids) total += this.ai.weights[id];\n    let r = this.rng() * total, pick = ids[0];\n    for (const id of ids) { r -= this.ai.weights[id]; if (r <= 0) { pick = id; break; } }\n    const inv = KC.DATA.inverse[pick]; if (!inv) return null;\n    return { posture: inv.posture, tech: inv.stick };\n  }\n};\nKC.pick = (rng, arr) => arr[Math.floor(rng() * arr.length) % arr.length];\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_011uxDR63UvAkbCrRNTSHYQT","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
