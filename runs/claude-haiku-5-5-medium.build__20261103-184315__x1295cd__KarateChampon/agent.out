ech; this.pendingPost = intent.posture; this.pendingT = 18; }","+  }","+  // one step of this fighter. live: the fight is on (movement and techniques); otherwise only the body settles.","+  tick(dt, foe, live) {","+    if (this.state === 'down') { this.downT--; if (this.downT <= 0) { this.state = 'rise'; this.stun = 36; } return; }","+    if (this.state === 'rise') { this.stun--; if (this.stun <= 0) this.state = 'idle'; return; }","+    if (this.state === 'hit') { this.stun--; if (this.stun <= 0) this.state = 'idle'; return; }","+    if (this.recoilT > 0) this.recoilT -= dt;","+    // flight","+    if (this.z > 0 || this.vz !== 0) {","+      this.vz -= KC.TUNE.gravity * dt; this.z += this.vz * dt;","+      if (this.z <= 0) { this.z = 0; this.vz = 0; this.flipping = false; this.vx = 0; if (this.tech && this.tech.ph < 2 && (KC.DATA.techniques[this.tech.id].air || KC.DATA.techniques[this.tech.id].flip)) { this.tech.ph = 2; this.tech.t = 0; } }","+    }","+    if (this.state === 'tech' && this.tech) {","+      const T = KC.DATA.techniques[this.tech.id], k = this.tech;","+      if (k.ph === 0) { k.t++; if (k.t >= k.s) { k.ph = 1; k.t = 0; } }","+      if (k.ph === 1) {","+        k.t++;","+        if (!this.airborne && this.travel) this.x += this.travel;","+        if (T.block) this.guardOn = true;","+        if (k.t >= k.a) { k.ph = 2; k.t = 0; this.guardOn = false; }","+      }","+      if (k.ph === 2) {","+        k.t++;","+        if (T.roll || T.flip) { this.x += this.vx * dt; }","+        if (k.t >= k.r) this.endTech();","+      }","+      if (T.roll && this.tech && this.tech.ph === 2) this.vx *= 0.9;","+      if (this.tech && (T.flip || T.air)) this.x += this.vx * dt;","+    }","+    if (this.state === 'tech' && this.tech && this.tech.ph === 1 && this.tech.id === 'block') this.guardOn = true;","+    if (this.pendingT > 0) { this.pendingT--; if (this.pendingT <= 0) this.pending = null; }","+    if (live && this.state !== 'tech' && this.intent) {","+      // a buffe