notes: D('k . . . s . . k | . k . . s . h h', 1) + ' | k . . . s . . k | . k . . s s s c' }] },","+  paint: { name: 'Paint Job', bpm: 110, steps: 2, tracks: [","+    { wave: 'triangle', vol: .26, name: 'bass', notes: 'F2 A2 C3 E3 D3 C3 A2 G2 | D2 F2 A2 C3 Bb2 A2 F2 E2 | G2 Bb2 D3 F3 E3 D3 Bb2 A2 | C3 E3 G3 Bb3 A3 G3 E3 C3' },","+    { wave: 'pulse', vol: .06, name: 'keys', notes: '. A4 . E5 . A4 . E5 | . F4 . C5 . F4 . C5 | . Bb4 . F5 . Bb4 . F5 | . E5 . Bb5 . G5 . E5' },","+    { wave: 'square', vol: .06, name: 'lead', notes: 'C6 - A5 - G5 F5 E5 F5 | A5 - - - . . . . | D6 - Bb5 - A5 G5 F5 G5 | Bb5 - A5 - G5 - E5 - ' },","+    { wave: 'drums', vol: .07, name: 'drums', notes: D('k h h s h k h s', 4) }] },","+  victory: { name: 'Victory Lap', bpm: 120, steps: 2, tracks: [","+    { wave: 'triangle', vol: .28, name: 'bass', notes: 'C3 C3 C3 C3 G2 G2 G2 G2 | A2 A2 A2 A2 F2 F2 F2 F2 | C3 C3 C3 C3 G2 G2 G2 G2 | F2 F2 G2 G2 C3 C3 C3 C3' },","+    { wave: 'square', vol: .08, name: 'lead', notes: 'E5 - - D5 C5 - G4 - | A4 - C5 - F5 - E5 D5 | E5 - - G5 E5 - C5 - | D5 - E5 - C5 - - - ' },","+    { wave: 'pulse', vol: .05, name: 'harm', notes: 'C5 - - B4 G4 - E4 - | F4 - A4 - C5 - C5 B4 | C5 - - E5 C5 - G4 - | B4 - C5 - G4 - - -' },","+    { wave: 'drums', vol: .1, name: 'drums', notes: 'k h s h k h s h | k h s h k h s h | k h s h k h s h | k s k s s s c c' }] }","+};","+export const STINGS = {","+  bronze: [{ wave: 'square', freq: 'G4', dur: .15, vol: .15 }, { wave: 'square', freq: 'C5', dur: .15, vol: .15, delay: .15 }, { wave: 'square', freq: 'E5', dur: .4, vol: .15, delay: .3 }],","+  silver: [{ wave: 'square', freq: 'C5', dur: .12, vol: .15 }, { wave: 'square', freq: 'E5', dur: .12, vol: .15, delay: .12 }, { wave: 'square', freq: 'G5', dur: .12, vol: .15, delay: .24 }, { wave: 'square', freq: 'C6', dur: .5, vol: .16, delay: .36 }],","+  gold: [{ wave: 'square', freq: 'C5', dur: .7, vol: .14, arp: [0, 4, 7, 12, 16, 19, 24], step: .07 }, { wave: 'noise', freq: 6000, dur: .8, vol: .25, filter: 'highpass', delay: .5 }, { wave: 'triangle', freq: 'C4', dur: .9, vol: .25, delay: .5 }],","+  author: [{ wave: 'square', freq: 'C5', dur: 1.1, vol: .14, arp: [0, 4, 7, 12, 16, 19, 24, 28, 31, 36], step: .07 }, { wave: 'noise', freq: 6000, dur: 1, vol: .25, filter: 'highpass', delay: .7 }, { wave: 'pulse', freq: 'G5', dur: .8, vol: .1, delay: .7, vib: [6, .03] }],","+  record: { wave: 'square', freq: 'E5', dur: .5, vol: .12, arp: [0, 3, 7, 12, 15, 19], step: .06 },","+  none: [{ wave: 'triangle', freq: 'E4', dur: .2, vol: .2 }, { wave: 'triangle', freq: 'C4', dur: .4, vol: .2, delay: .2 }]","+};","+export class Music {","+  constructor(game) { this.game = game; this.cur = null; }","+  play(name, o = {}) { if (this.game.headless) { this.cur = name; return; } if (this.cur === name && !o.restart) return; this.cur = name; this.game.audio.music(name ? SONGS[name] : null, { fade: o.fade ?? .6 }); }","+  race(env, kind) { this.play(kind === 'survival' ? 'guild' : kind === 'puzzle' || kind === 'validate' ? 'blueprint' : { dustbowl: 'heat', hedgerow: 'hedge', frostpeak: 'ice' }[env] || 'heat'); }","+  layer(name, v = 1) { if (!this.game.headless) try { this.game.audio.layer(name, v, .8); } catch (e) { /* not this song */ } }","+  sting(name) { if (!this.game.headless) this.game.audio.sfx(STINGS[name] || STINGS.none); }","+}"]}],"originalFile":"export class Music { constructor(g) { this.g = g; } race() {} play() {} }\n","userModified":false},"tool_result_meta":[{"id":"toolu_018EW8KhvytR4t7g8PXUj47M","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
