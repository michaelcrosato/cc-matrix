l';\nEOF\nsed -i \"s|^export const OUT_NAME = .*|import { OUT_NAME } from './build-name.mjs';|\" tools/build.mjs; node tools/build.mjs && timeout 180 node tools/shot.mjs '#race/D3' d3a 9000 --keys \"KeyW:3000\"","description":"Write the screenshot tool and capture D3 in the browser"}}}
