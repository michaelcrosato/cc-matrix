} from './debug.js';\nimport { TRACKS } from './data/tracks.js';\nimport { compile } from './track/track.js';\nimport { bakeAll } from './race/medals.js';\n\nimport { VERSION } from './version.js';\nexport { VERSION };\nexport async function createGame(o = {}) {\n  const headless = !!o.headless || typeof document === 'undefined';\n  ctx.headless = headless; ctx.E = E;\n  const settings = [\n    ...E.World3D.SETTINGS.map(s => s.key === 'look3d' ? Object.assign({}, s, { label: 'Characters' }) : s),\n    { key: 'units', label: 'Speed units', group: 'Game', value: 'kmh', options: [['kmh', 'km/h'], ['mph', 'mph']] },\n    { key: 'defaultCam', label: 'Default camera', group: 'Game', value: 'far', options: [['far', 'Far chase'], ['close', 'Close chase'], ['hood', 'Hood']] },\n    { key: 'myGhost', label: 'My ghost', group: 'Game', value: true, help: 'Race against your best run' },\n    { key: 'cocoGhost', label: \"Coco's ghost\", group: 'Game', value: false, help: 'Race against the author time' },\n    { key: 'loopAssist', label: 'Loop assist', group: 'Game', value: true, help: 'Keeps you in the lane round the loops', apply: (g, v) => { ctx.loopAssistSetting = v; } },\n    { key: 'steerSens', label: 'Steering sensitivity', group: 'Game', value: 1, min: .5, max: 1.5, step: .05 },\n    { key: 'hints', label: 'Hints', group: 'Game', value: true, help: \"Coco's first-time tips\" }\n  ];\n  const game = new E.Game({ canvas: headless ? undefined : 'screen', res: 'ps1', expand: true, bg: null, input: MENU_INPUT, headless, id: 'crackmania',\n    menu: { settings, items: () => pauseItems(), quit: false, controls: { gas: 'Gas', brake: 'Brake / reverse', respawn: 'Respawn', restart: 'Restart', camera: 'Camera', ghost: 'Ghosts', horn: 'Horn', cam1: false, cam2: false, cam3: false, tabL: false, tabR: false, secondary: false, tertiary: false, trigL: false, trigR: false } } });\n  ctx.game = game;\n  ctx.worlds = new Worlds(game);\n  ctx.profile = new Profile(game, { temp: !!(globalThis.AIHub && AIHub.active) });\n  ctx.sound = new Sound(game); ctx.music = new Music(game);\n  ctx.dev = new Dev(game); ctx.attract = new Attract(game); ctx.talk = new Talk(game); ctx.online = new Online(game);\n  game.debug = { snapshot, api: null };\n  const scenes = Object.assign({ race: raceScene }, frontScenes);\n  const steps = [\n    ['Starting the engines', () => E.World3D.init(game)],\n    ['Reading your profile', () => ctx.profile.load()],\n    ...ENV_IDS.map(id => ['Pouring asphalt: ' + id.toUpperCase(), () => { ctx.worlds.make(id); }]),\n    ['Compiling tracks', () => { ctx.tracks = {}; for (const d of TRACKS) ctx.tracks[d.id] = compile(d); bakeAll(); }],\n    ['Teaching cacti to wave', () => { ctx.showcase = frontScenes.title.prepareShowcase && frontScenes.title.prepareShowcase(); }],\n    ['Building the shaders', () => { ctx.worlds.prepare(); }]\n  ];\n  game.start({ scenes, scene: 'title', boot: { title: 'CRACKMANIA', version: VERSION, steps, messages: ['Polishing medals', 'Counting coppers', 'Warming up the ghosts', 'Inflating the loops', 'Hiding the cabbages'] } });\n  if (game.booted && game.booted.then) await game.booted;\n  ctx.api = (await import('./api.js')).makeApi();\n  game.debug.api = ctx.api;\n  if (!headless) { window.__crack = { game, api: ctx.api, snapshot, ctx }; ctx.online.start(); }\n  return { game, api: ctx.api };\n}\nfunction pauseItems() {\n  const s = ctx.game.scene, sess = ctx.session, items = [];\n  if (s && s.pauseItems) items.push(...s.pauseItems());\n  items.push(['Dev Mode', () => { ctx.game.resume(); ctx.dev.show(); }]);\n  if (!(globalThis.AIHub && AIHub.active) && s && s.quitTo) items.push(['Quit to menu', () => { ctx.game.resume(); s.quitTo(); }]);\n  return items;\n}\nexport { deepLink };\n","userModified":false},"tool_result_meta":[{"id":"toolu_01SwabefbsqoTyAuz2GdAq7X","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
