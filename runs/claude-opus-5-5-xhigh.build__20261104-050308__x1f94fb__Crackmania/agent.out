 asks = function (on) {\n      return function () {\n        post('fullscreen', { on: on });\n        return Promise.resolve();\n      };\n    };\n    var proto = root.Element.prototype;\n    proto.requestFullscreen = proto.webkitRequestFullscreen = asks(true);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_012CxFfX5Qp1hhEYK3AVD5kE","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
