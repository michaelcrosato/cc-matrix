;\")\ns=s.replace(\"  y += 4; row('done', 'DONE', '', { onPick: () => { save(); ctx.game.go('menu'); } });\\n  return rows;\",\"  y += 4; row('done', 'DONE', '', { onPick: () => { save(); ctx.game.go('menu'); } });\\n  const f = rows[st.focus.i], bot = r.H - 30; if (f && f.y + h > bot) st.scroll = (st.scroll || 0) + (f.y + h - bot); else if (f && f.y < top) st.scroll = Math.max(0, (st.scroll || 0) - (top - f.y));\\n  return rows;\")\ns=s.replace(\"      st.focus.set(garageRows(r)); st.focus.draw(g);\",\"      st.focus.set(garageRows(r)); g.save(); g.beginPath(); g.rect(0, 46, r.W, r.H - 74); g.clip(); st.focus.draw(g); g.restore(); g._c = null;\")\ns=s.replace(\"  const a = st.t * .25, d = 7.5, pos = [cx / U + Math.cos(a) * d, cy / U + Math.sin(a) * d + 1.5, 3];\\n  const pose = poseOf(null, { pos, look: [cx / U, cy / U, .6], up: [0, 0, 1], fov: 55 });\",\"  const a = Math.PI / 2 + Math.sin(st.t * .2) * .35, d = 8.5, pos = [cx / U + Math.cos(a) * d, cy / U + Math.sin(a) * d, 3.2], lft = [Math.sin(a), -Math.cos(a)];\\n  const pose = poseOf(null, { pos, look: [cx / U + lft[0] * 2.6, cy / U + lft[1] * 2.6, .7], up: [0, 0, 1], fov: 55 });\")\nopen(p,'w').write(s)\np='src/ui/kit.js'; s=open(p).read()\ns=s.replace(\"\"\"  T2(g, q.label, q.x + 10, q.y + q.h / 2 - 7, q.disabled ? '#6a6688' : '#ffffff');\n  if (q.value !== undefined) T2(g, String(q.value), q.x + q.w - 10, q.y + q.h / 2 - 7, foc ? ac : UI.dim, 'right');\"\"\",\"\"\"  const vs = q.value !== undefined && q.value !== '' ? String(q.value) : '', vw = vs ? F().width(vs, { scale: 2 }) : 0, room = q.w - 20 - vw - 8, big = F().width(q.label, { scale: 2 }) <= room;\n  if (big) T2(g, q.label, q.x + 10, q.y + q.h / 2 - 7, q.disabled ? '#6a6688' : '#ffffff'); else T1(g, q.label, q.x + 10, q.y + q.h / 2 - 4, q.disabled ? '#6a6688' : '#ffffff');\n  if (vs) T2(g, vs, q.x + q.w - 10, q.y + q.h / 2 - 7, foc ? ac : UI.dim, 'right');\"\"\")\nopen(p,'w').write(s)\nEOF\necho ok","description":"Fix editor prompt overlap and garage 