cks[O.trackId], model = ENVS[track.env].car, me = O.info.players.find(p => p.id === O.info.me);","+  const sess = startRace({ kind: 'online', stay: true, track, intro: false, countdown: 99, label: 'ONLINE', canRestart: true, noSlowmo: true, orbit: false,","+    players: [{ input: ctx.game.input, name: me ? me.name : 'YOU', color: me ? me.color : '#ffffff', model, paint: ctx.profile.paint(model) }],","+    ghosts: [...O.ghosts.values()].map(g => ({ live: () => O.pose(g), steps: () => 0, model, paint: { body: g.color, accent: '#ffffff', pattern: 1, patternColor: '#ffffff', number: g.id + 1, rims: 0, helmet: g.color }, name: g.name, color: g.color, always: true, id: g.id, ghost: true })),","+    roundClock: () => { const left = Math.max(0, O.roundMs - Math.max(0, H().time())); return isFinite(left) ? fmt(Math.round(left * 120 / 1000)).replace(/\\.\\d\\d$/, '') : '3:00'; },","+    targets: () => O.best !== null ? { medal: 3, steps: Math.round(O.best * 120 / 1000), best: null } : null,","+    onFinish(s, P) { const ms = Math.round(P.results.steps * 1000 / 120), better = O.finished(ms); if (better) fx.note(P, 'NEW BEST!', '#5ab4ff', 2); s.after = () => restart(O); s.afterTime = 1.8; },","+    onRestart() { O.runs++; },","+    update: dt => { O.step(dt); if (O.phase === 'waiting' || O.phase === 'over') ctx.session.locked = true; }","+  });","+  sess.ghosts = sess.ghosts.filter(g => g.live);","+  return sess;","+}","+function restart(O) {","+  const s = ctx.session; if (!s || O.phase !== 'racing') return; const P = s.players[0]; O.respawns += P.run.respawns; O.runs++;","+  P.run = new Run(s.course, P.model, { countdown: 1 }); P.cam.snap();","+}","+/* ---- the scene: the card, then the round ---- */","+const st = { t: 0, answered: false, more: false, sess: null };","+export const onlineScene = {","+  input: Object.assign({}, RACE_INPUT, { more: ['KeyM', 'Pad3'] }), touch: [], camera: { zoom: false },","+  enter() {","+    const O = ctx.online; st.t = 0; st.answered = false;","+    if (!O.info) { this.game && 0; return; }","+    O.phase = 'card'; st.sess = startRound(O); ctx.music.play('title');","+    try { H().ready(); } catch (e) { /* already */ }","+  },","+  update(dt) {","+    const O = ctx.online, I = ctx.game.input; st.t += dt;","+    if (!O.info) return;","+    if (O.phase === 'over') return;   // (the hub shows the results; nothing moves)","+    // Create + Options is the hub's: Options is ignored while Create is held (no pause here anyway)","+    if (O.phase === 'card') {","+      const ck = I.clicked && I.clicked();","+      if (I.pressed('confirm') || I.pressed('start') || ck) { H().answer('ready'); st.answered = true; ctx.sound.sfx('confirm'); }","+      if (I.pressed('more')) { H().answer('more'); st.more = !st.more; ctx.sound.sfx('tick'); }","+      O.step(dt);","+      return;","+    }","+    if (O.phase === 'countdown' && ctx.music.cur !== 'heat') ctx.music.race(ctx.session.env, 'online');","+    rememberSteps(); raceUpdate(dt);","+  },","+  draw(r) {","+    const O = ctx.online;","+    if (!O.info || !ctx.session) { r.overlay(g => T2(g, 'CONNECTING…', r.W / 2, r.H / 2, '#ffffff', 'center')); return; }","+    if (O.phase === 'card') return cardDraw(r, O);","+    raceDraw(r);","+    r.overlay(g => {","+      if (O.phase === 'waiting') { panel(g, r.W / 2 - 130, r.H * .4, 260, 40, { border: '#ffd060' }); T2(g, 'WAITING FOR THE OTHERS', r.W / 2, r.H * .4 + 6, '#ffffff', 'center'); T1(g, O.best !== null ? 'YOUR BEST ' + fmt(Math.round(O.best * 120 / 1000)) : 'NO FINISH THIS ROUND', r.W / 2, r.H * .4 + 26, '#ffd060', 'center'); }","+      let y = 70; for (const g2 of O.ghosts.values()) { T1(g, g2.name + (g2.best !== null ? ' ' + fmt(Math.round(g2.best * 120 / 1000)) : ''), 8, y, g2.color); y += 11; }","+    });","+  }","+};","+function cardDraw(r, O) {","+  // the track from above, slowly turning (no Math.random on the card)","+  const track = ctx.tracks[O.trackId], w = ctx.worlds.world;","+  ctx.worlds.draw3d = ww => { const c = ctx.session.course.samples, mid = c[Math.floor(c.length / 2)].p, a = st.t * .15, d = 260, pos = [mid[0] + Math.cos(a) * d, mid[1] + Math.sin(a) * d, 160]; const pose = poseOf(null, { pos, look: mid, up: [0, 0, 1], fov: 50 }); ww.camera.pose = pose; ww.camera.fixed = pose; ww.camera.target.x = mid[0] * U; ww.camera.target.y = mid[1] * U; ww.camera.target.z = 0; ctx.worlds.cur.view.draw(ww.pen, { t: st.t, lights: 0, near: mid }); ctx.worlds.drawScenery(ww.pen, st.t, mid); };","+  ctx.worlds.draw(r);","+  const C = O.cardState || {}, ready = new Set(C.ready || []);","+  r.overlay(g => {","+    E.px.blend(g, .45, 'normal', () => E.px.rect(g, 0, 0, r.W, r.H, '#05040a'));","+    logo(g, r.W / 2, 10, r.W > 400 ? 3 : 2, 9);","+    T2(g, track.name.toUpperCase() + ' · ' + ENVS[track.env].name, r.W / 2, 44, '#ffd060', 'center');","+    panel(g, r.W / 2 - 170, 64, 340, 22 + O.info.players.length * 18, {});","+    O.info.players.forEach((p, i) => { const y = 70 + i * 18; E.px.rect(g, r.W / 2 - 160, y + 2, 10, 10, p.color); T2(g, p.name + (p.id === O.info.me ? ' (YOU)' : ''), r.W / 2 - 144, y, p.color); T2(g, ready.has(p.id) ? '✓ READY' : '...', r.W / 2 + 160, y, ready.has(p.id) ? '#5ad06a' : UI.dim, 'right'); });","+    const y0 = 92 + O.info.players.length * 18;","+    T1(g, 'BEST TIME IN 3 MINUTES WINS · RETRY AS OFTEN AS YOU LIKE', r.W / 2, y0, '#ffffff', 'center');","+    const dev = ctx.game.input.lastDevice;","+    promptRow(g, r.W / 2, y0 + 16, [['gas', 'GAS'], ['brake', 'BRAKE'], ['left', 'STEER'], ['respawn', 'RESPAWN'], ['restart', 'RESTART']], { align: 'center' });","+    drawMinimap(g, track, r.W / 2 - 60, y0 + 34, 120, Math.max(30, r.H - y0 - 90), '#ffffff');","+    const left = C.left; T2(g, C.paused ? 'PAUSED: MORE TIME ASKED' : C.starting ? 'STARTING…' : left !== null && left !== undefined ? 'STARTS IN ' + Math.ceil(left / 1000) : 'GET READY', r.W / 2, r.H - 44, '#ffd060', 'center');","+    promptBar(g, r, [['confirm', st.answered ? 'READY ✓' : 'READY'], ['more', st.more ? 'MORE TIME ✓' : 'MORE TIME']]);","+  });","+}"]}],"originalFile":"export class Online { constructor(g) { this.g = g; } start() {} }\n","userModified":false},"tool_result_meta":[{"id":"toolu_01PTcQVSSuvNW5uBivpkQf4f","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
