ll; const game = async () => G || (G = await makeGame());\nfor (const f of run) {\n  const mod = await import(pathToFileURL(DIR + f + '.mjs').href);\n  const T = { check(name, ok, detail) { n++; if (!ok) fail(f, name, typeof detail === 'function' ? detail() : detail); return !!ok; }, eq(name, a, b, tol = 0) { n++; const ok = typeof a === 'number' && typeof b === 'number' ? Math.abs(a - b) <= tol : JSON.stringify(a) === JSON.stringify(b); if (!ok) fail(f, name, 'got ' + JSON.stringify(a) + ', want ' + JSON.stringify(b) + (tol ? ' ±' + tol : '')); return ok; }, game, E };\n  try { await mod.default(T); } catch (e) { fail(f, 'threw', (e && e.stack || String(e)).split('\\n').slice(0, 4).join(' | ')); }\n  if (G && G.game.errors.length) { for (const e of G.game.errors) fail(f, 'engine error', e.where + ': ' + e.message); G.game.errors.length = 0; }\n}\nif (args.includes('--browser') || all) { const { browser } = await import('./browser.mjs'); const r = await browser(); n += r.n; for (const [c, d] of r.fails) fail('browser', c, d); }\nif (args.includes('--hub') || all) { const { hub } = await import('./hub.mjs'); const r = await hub(); n += r.n; for (const [c, d] of r.fails) fail('hub', c, d); }\nconsole.log(n + ' checks, ' + failed + ' failed, ' + ((Date.now() - t0) / 1000).toFixed(1) + ' s');\nprocess.exit(failed ? 1 : 0);\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_013zk72TqVxUSLWWSBViF62n","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CghwKXDxxbY8mxrXqW83U","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01TyF4WUbAvjm5EpLyQiMjh6","name":"Bash","input":{"command":"cat > tools/tests/turtle.mjs <<'EOF'\n// covers: src/track/track.js, src/data/tracks.js, src/modes/puzzle.js\nimport { TRACKS, PUZZLES } from '../../src/data/tracks.js';\nimport { compile } from '../../src/track/track.js';\nimport { TYPES } from '../../src/track/blocks.js';\nimport { puzzleTrack } from '../../src/modes/puzzle.js';\nconst CPS = { D1: 1, D2: 1, D3: 1, D4: 2, D5: 3, R1: 1, R2: 2, R3: 1, R4: 2, R5: 3, S1: 1, S2: 2, S3: 2, S4: 1, S5: 3 };\nexport default T => {\n  for (const d of TRACKS) {\n    const t = compile(d);\n    T.check(d.id + ' compiles', !t.errors.length, t.errors.join('; '));\n    T.eq(d.id + ' checkpoints', t.cps.length, CPS[d.id]);\n    const R = t.route(); T.check(d.id + ' route reaches the finish', R.ok, R.why);\n    for (const k of t.blocks.filter(b => TYPES[b.type].kicker)) T.check(d.id + ' kicker lands', !!t.jumpFrom(k));\n    T.check(d.id + ' env tokens', t.blocks.every(b => !TYPES[b.type].envs || TYPES[b.type].envs.includes(d.env)), t.blocks.filter(b => TYPES[b.type].envs && !TYPES[b.type].envs.includes(d.env)).map(b => b.type).join(','));\n  }\n  T.check('D2 canyons', compile(TRACKS[1]).chasms.size === 4);\n  T.check('D5 big crack', compile(TRACKS.find(t => t.id === 'D5')).chasms.size === 3);\n  T.check('R2 stream is water', [...compile(TRACKS.find(t => t.id === 'R2')).chasms.values()].every(v => v === 'water'));\n  for (const p of PUZZLES) {\n    const sol = puzzleTrack(p, true), base = puzzleTrack(p, false);\n    T.check(p.id + ' solution compiles', !sol.errors.length, (sol.errors || []).join('; '));\n    T.check(p.id + ' solution route', sol.route().ok, sol.route().why);\n    const key = b => b.type + b.cx + ',' + b.cy + ',' + b.L + ',' + b.rot;\n    T.eq(p.id + ' fixed = solution ST/CP/FN', base.blocks.map(key).sort(), sol.blocks.filter(b => ['ST', 'CP', 'FN'].includes(b.type)).map(key).sort());\n    const need = {}; for (const b of sol.blocks) if (!['ST', 'CP', 'FN'].includes(b.type) && !TYPES[b.type].gap) need[b.type] = (need[b.type] || 0) + 1;\n    T.check(p.id + ' inventory covers the solution', Object.entries(need).every(([k, v]) => (p.inventory[k] || 0) >= v), JSON.stringify(need));\n    const [x0, x1, y0, y1, l0, l1] = p.zone; T.check(p.id + ' solution inside the zone', sol.blocks.every(b => sol.cellsOf(b).every(([x, y, l]) => x >= x0 && x <= x1 && y >= y0 && y <= y1 && l >= l0 && l <= l1)));\n    T.check(p.id + ' solution avoids no-build cells', sol.blocks.every(b => sol.cellsOf(b).every(([x, y, l, k]) => k !== 'solid' || !(p.nobuild || []).some(([nx, ny]) => nx === x && ny === y) || l > 1)));\n  }\n};\nEOF\ncat > tools/tests/blocks.mjs <<'EOF'\n// covers: src/track/blocks.js, src/track/geometry.js\nimport { TYPES, frameAt, endsOf } from '../../src/track/blocks.js';\nimport { blockGeometry, plateGeometry } from '../../src/track/geometry.js';\nimport { TRACKS } from '../../src/data/tracks.js';\nimport { compile } from '../../src/track/track.js';\nimport { dot, cross, sub, len, norm } from '../../src/lib/v3.js';\nexport default T => {\n  for (const T0 of Object.values(TYPES)) {\n    if (!T0.path || T0.deco) continue;\n    const pl = { type: T0.id, cx: 4, cy: 4, L: 2, rot: 1 }; let bad = '';\n    let prev = frameAt(pl, 0);\n    for (let s = .25; s <= T0.len; s += .25) {\n      const f = frameAt(pl, s);\n      if (Math.abs(len(f.t) - 1) > 1e-6 || Math.abs(len(f.u) - 1) > 1e-6) bad = 'not unit at ' + s;\n      if (Math.abs(dot(f.t, f.u)) > 1e-4) bad = 'u not square to t at ' + s;\n      if (len(sub(f.p, prev.p)) > .3) bad = 'jump in p at ' + s;\n      if (Math.acos(Math.min(1, dot(f.t, prev.t))) > (T0.loop ? .05 : .03)) bad = 'kink in t at ' + s;\n      prev = f;\n    }\n    T.check(T0.id + ' path continuous', !bad, bad);\n    const g = blockGeometry(pl, 'dustbowl', null);\n    let nan = false; for (const p of Object.values(g.parts)) for (const v of p.pos) if (!isFinite(v)) nan = true;\n    T.check(T0.id + ' mesh finite', !nan);\n    // the road's collision triangles face up the path (Rapier winding); three's are the mirror\n    const road = g.coll.find(c => ['road', 'dirt', 'ice', 'boost'].includes(c.surface) && c.pos.length > 9);\n    if (road) { let worst = 1; for (let i = 0; i < road.idx.length; i += 3) { const P = k => [road.pos[road.idx[k] * 3], road.pos[road.idx[k] * 3 + 1], road.pos[road.idx[k] * 3 + 2]]; const a = P(i), b = P(i + 1), c = P(i + 2), n = norm(cross(sub(b, a), sub(c, a))); const m = [(a[0] + b[0] + c[0]) / 3, (a[1] + b[1] + c[1]) / 3, (a[2] + b[2] + c[2]) / 3]; let best = null, bd = 1e9; for (let s = 0; s <= T0.len; s += 1) { const f = frameAt(pl, s), d = len(sub(f.p, m)); if (d < bd) { bd = d; best = f; } } worst = Math.min(worst, dot(n, best.u)); }\n      T.check(T0.id + ' road normals agree with up', worst > .5, 'worst ' + worst.toFixed(2)); }\n  }\n  // every link of every shipped track: the two ends meet (1 cm) facing each other (0.5 degrees)\n  for (const d of TRACKS) {\n    const t = compile(d); let bad = 0, worst = '';\n    for (const b of t.blocks) for (const e of endsOf(b)) { const q = t.partner(b, e); if (!q) continue; const dp = len(sub(e.p, q.e.p)), ang = Math.acos(Math.max(-1, Math.min(1, -dot(e.t, q.e.t)))) * 180 / Math.PI; if (dp > .01 || ang > .5) { bad++; worst = b.type + '->' + q.b.type; } }\n    T.check(d.id + ' links meet', !bad, bad + ' bad, e.g. ' + worst);\n    const R = t.route(); let gap = 0; const S = t.samples(2); for (let i = 1; i < S.length; i++) if (!S[i].air && !S[i - 1].air) gap = Math.max(gap, len(sub(S[i].p, S[i - 1].p)));\n    T.check(d.id + ' route samples continuous', gap < 3.5, 'max gap ' + gap.toFixed(2));\n  }\n  const pg = plateGeometry(compile(TRACKS[1]), 'dustbowl'); T.check('plate has holes for the canyon', pg.parts.rock && pg.parts.rock.idx.length > 0);\n};\nEOF\necho ok","description":"Write turtle and blocks test suites"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2180,"cache_read_input_tokens":684997,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2180},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"66d97bf5-dd15-40b7-85f8-8eecadfc963f","uuid":"f7c24d37-63ba-446d-8e89-8c7a118f3885","timestamp":"2026-11-04T13:06:41.652Z","request_id":"req_011CghwKWrdxm3JwjBGkEn9B","wire_tool_inputs":{"toolu_01TyF4WUbAvjm5EpLyQiMjh6":{"command":"cat > tools/tests/turtle.mjs <<'EOF'\n// covers: src/track/track.js, src/data/tracks.js, src/modes/puzzle.js\nimport { TRACKS, PUZZLES } from '../../src/data/tracks.js';\nimport { compile } from '../../src/track/track.js';\nimport { TYPES } from '../../src/track/blocks.js';\nimport { puzzleTrack } from '../../src/modes/puzzle.js';\nconst CPS = { D1: 1, D2: 1, D3: 1, D4: 2, D5: 3, R1: 1, R2: 2, R3: 1, R4: 2, R5: 3, S1: 1, S2: 2, S3: 2, S4: 1, S5: 3 };\nexport default T => {\n  for (const d of TRACKS) {\n    const t = compile(d);\n    T.check(d.id + ' compiles', !t.errors.length, t.errors.join('; '));\n    T.eq(d.id + ' checkpoints', t.cps.length, CPS[d.id]);\n    const R = t.route(); T.check(d.id + ' route reaches the finish', R.ok, R.why);\n    for (const k of t.blocks.filter(b => TYPES[b.type].kicker)) T.check(d.id + ' kicker lands', !!t.jumpFrom(k));\n    T.check(d.id + ' env tokens', t.blocks.every(b => !TYPES[b.type].envs || TYPES[b.type].envs.includes(d.env)), t.blocks.filter(b => TYPES[b.type].envs && !TYPES[b.type].envs.includes(d.env)).map(b => b.type).join(','));\n  }\n  T.check('D2 canyons', compile(TRACKS[1]).chasms.size === 4);\n  T.check('D5 big crack', compile(TRACKS.find(t => t.id === 'D5')).chasms.size === 3);\n  T.check('R2 stream is water', [...compile(TRACKS.find(t => t.id === 'R2')).chasms.values()].every(v => v === 'water'));\n  for (const p of PUZZLES) {\n    const sol = puzzleTrack(p, true), base = puzzleTrack(p, false);\n    T.check(p.id + ' solution compiles', !sol.errors.length, (sol.errors || []).join('; '));\n    T.check(p.id + ' solution route', sol.route().ok, sol.route().why);\n    const key = b => b.type + b.cx + ',' + b.cy + ',' + b.L + ',' + b.rot;\n    T.eq(p.id + ' fixed = solution ST/CP/FN', base.blocks.map(key).sort(), sol.blocks.filter(b => ['ST', 'CP', 'FN'].includes(b.type)).map(key).sort());\n    const need = {}; for (const b of sol.blocks) if (!['ST', 'CP', 'FN'].includes(b.type) && !TYPES[b.type].gap) need[b.type] = (need[b.type] || 0) + 1;\n    T.check(p.id + ' inventory covers the solution', Object.entries(need).every(([k, v]) => (p.inventory[k] || 0) >= v), JSON.stringify(need));\n    const [x0, x1, y0, y1, l0, l1] = p.zone; T.check(p.id + ' solution inside the zone', sol.blocks.every(b => sol.cellsOf(b).every(([x, y, l]) => x >= x0 && x <= x1 && y >= y0 && y <= y1 && l >= l0 && l <= l1)));\n    T.check(p.id + ' solution avoids no-build cells', sol.blocks.every(b => sol.cellsOf(b).every(([x, y, l, k]) => k !== 'solid' || !(p.nobuild || []).some(([nx, ny]) => nx === x && ny === y) || l > 1)));\n  }\n};\nEOF\ncat > tools/tests/blocks.mjs <<'EOF'\n// covers: src/track/blocks.js, src/track/geometry.js\nimport { TYPES, frameAt, endsOf } from '../../src/track/blocks.js';\nimport { blockGeometry, plateGeometry } from '../../src/track/geometry.js';\nimport { TRACKS } from '../../src/data/tracks.js';\nimport { compile } from '../../src/track/track.js';\nimport { dot, cross, sub, len, norm } from '../../src/lib/v3.js';\nexport default T => {\n  for (const T0 of Object.values(TYPES)) {\n    if (!T0.path || T0.deco) continue;\n    const pl = { type: T0.id, cx: 4, cy: 4, L: 2, rot: 1 }; let bad = '';\n    let prev = frameAt(pl, 0);\n    for (let s = .25; s <= T0.len; s += .25) {\n      const f = frameAt(pl, s);\n      if (Math.abs(len(f.t) - 1) > 1e-6 || Math.abs(len(f.u) - 1) > 1e-6) bad = 'not unit at ' + s;\n      if (Math.abs(dot(f.t, f.u)) > 1e-4) bad = 'u not square to t at ' + s;\n      if (len(sub(f.p, prev.p)) > .3) bad = 'jump in p at ' + s;\n      if (Math.acos(Math.min(1, dot(f.t, prev.t))) > (T0.loop ? .05 : .03)) bad = 'kink in t at ' + s;\n      prev = f;\n    }\n    T.check(T0.id + ' path continuous', !bad, bad);\n    const g = blockGeometry(pl, 'dustbowl', null);\n    let nan = false; for (const p of Object.values(g.parts)) for (const v of p.pos) if (!isFinite(v)) nan = true;\n    T.check(T0.id + ' mesh finite', !nan);\n    // the road's collision triangles face up the path (Rapier winding); three's are the mirror\n    const road = g.coll.find(c => ['road', 'dirt', 'ice', 'boost'].includes(c.surface) && c.pos.length > 9);\n    if (road) { let worst = 1; for (let i = 0; i < road.idx.length; i += 3) { const P = k => [road.pos[road.idx[k] * 3], road.pos[road.idx[k] * 3 + 1], road.pos[road.idx[k] * 3 + 2]]; const a = P(i), b = P(i + 1), c = P(i + 2), n = norm(cross(sub(b, a), sub(c, a))); const m = [(a[0] + b[0] + c[0]) / 3, (a[1] + b[1] + c[1]) / 3, (a[2] + b[2] + c[2]) / 3]; let best = null, bd = 1e9; for (let s = 0; s <= T0.len; s += 1) { const f = frameAt(pl, s), d = len(sub(f.p, m)); if (d < bd) { bd = d; best = f; } } worst = Math.min(worst, dot(n, best.u)); }\n      T.check(T0.id + ' road normals agree with up', worst > .5, 'worst ' + worst.toFixed(2)); }\n  }\n  // every link of every shipped track: the two ends meet (1 cm) facing each other (0.5 degrees)\n  for (const d of TRACKS) {\n    const t = compile(d); let bad = 0, worst = '';\n    for (const b of t.blocks) for (const e of endsOf(b)) { const q = t.partner(b, e); if (!q) continue; const dp = len(sub(e.p, q.e.p)), ang = Math.acos(Math.max(-1, Math.min(1, -dot(e.t, q.e.t)))) * 180 / Math.PI; if (dp > .01 || ang > .5) { bad++; worst = b.type + '->' + q.b.type; } }\n    T.check(d.id + ' links meet', !bad, bad + ' bad, e.g. ' + worst);\n    const R = t.route(); let gap = 0; const S = t.samples(2); for (let i = 1; i < S.length; i++) if (!S[i].air && !S[i - 1].air) gap = Math.max(gap, len(sub(S[i].p, S[i - 1].p)));\n    T.check(d.id + ' route samples continuous', gap < 3.5, 'max gap ' + gap.toFixed(2));\n  }\n  const pg = plateGeometry(compile(TRACKS[1]), 'dustbowl'); T.check('plate has holes for the canyon', pg.parts.rock && pg.parts.rock.idx.length > 0);\n};\nEOF\necho ok","description":"Write turtle and blocks test suites"}}}
