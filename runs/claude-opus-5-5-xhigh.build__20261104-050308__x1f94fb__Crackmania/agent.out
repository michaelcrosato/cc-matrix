= this.view, span = Math.max(1, Math.min(50, 85 - z));\n2373:    this.stats = { updateMs: 0, renderMs: 0, frameMs: 16.7, steps: 0, items: 0, actors: 0, culled: 0 };\n2913:    const v = this.view, k = this.zoom / (this._zoomTo || this.zoom);\n3055:  default(key) { const s = this._specs[key]; if (!s) return undefined; const v = typeof s.value === 'function' ? s.value(this._g) : s.value; return v === undefined && s.type === 'toggle' ? false : v; }\n3519:  const v = g.view, c = g.cam, W = g.W, H = g.H;\n3728:  const v = { i, x: 0, y: 0, w: 0, h: 0, target: null, z: 16, cam: { tx: 0, ty: 0, tz: 0, x: undefined, y: 0, vx: 0, vy: 0, smooth: .12, snap: true, bounds: null } };\n4258:    const v = this._pv || (this._pv = new View('portrait', 'Portrait', 0, pitch, zoom, 1));\n4777:  /** new E.Combo(items, { window: .3 }): items are move names, specs or Attacks. moves: the Attacks; window: seconds\n4780:  constructor(specs, o = {}) { this.moves = specs.map(sp => sp instanceof Attack ? sp : new Attack(sp)); this.window = o.window === undefined ? .3 : o.window; this.step = -1; this.idle = 99; }   // items: specs, Attacks or move names\n5350:    const v = at.view, c = at.screen || at, px = sx + (c.ix || 0), py = sy + (c.iy || 0), T = this.T;\n5492:    const v = r.view; if (!v.inv) return [0, 0, this.w - 1, this.h - 1];\n5621:    if (!g._info && roof === 'speckle') { const tt = tones(t.top); scan(top, (xa, xb, y) => { for (let x = xa; x <= xb; x++) { const v = hash2(x * 3 + cx * 71, y * 5 + cy * 37); if (v < .08 || v > .96) { px.col(g, v < .08 ? tt.sh : tt.lt); g.fillRect(x, y, 1, 1); } } }); }\n3020:class Settings {\n3043:  define(sp) {\n7627:  define(name, voice) { this.presets[name] = voice; }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017cVYZneh1Xo472pSx8SnJq","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
