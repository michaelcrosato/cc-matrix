rgin:12px 0}.lede{font-size:16px;max-width:315px;margin-bottom:18px}.menu-stack{width:100%;max-width:340px}.action{padding:13px 16px;font-size:15px;border-radius:15px}.brand{font-size:10px}.footer{font-size:9px}.card-grid,.split{grid-template-columns:1fr}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.activity{padding:10px;min-height:92px}.activity-icon{width:34px;height:34px;font-size:18px}.activity strong{font-size:13px}.activity small{font-size:11px}.card h1{font-size:34px}.card p{font-size:15px}.hud-box{padding:10px 12px}.hud-box strong{font-size:16px}.meter{width:110px}.play-instruction{font-size:12px;max-width:90%;padding:10px 14px}.class-players{grid-template-columns:repeat(2,1fr)}.map-actions .action{min-width:0;flex:1}.map-actions{width:90%}.scroll{max-height:55vh}}\n","exit_code":0,"status":"completed"}}
