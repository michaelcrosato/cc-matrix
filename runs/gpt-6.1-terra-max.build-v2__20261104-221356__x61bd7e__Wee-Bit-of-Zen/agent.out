play:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.activity-grid{display:grid;gri\nd-template-columns:repeat(3,minmax(0,1fr));gap:12px}.activity{border:1px solid #e4eee7;background:#f8fbf7;border-radius:19px;padding:15px;text-align:left;min-height:114px;position:\nrelative}.activity:hover,.activity.is-focused{background:#edf8f1;border-color:#8ec9b3;transform:translateY(-2px)}.activity:disabled{opacity:.5;cursor:not-allowed}.activity-icon{dis\nplay:grid;place-items:center;float:left;width:42px;height:42px;border-radius:13px;background:var(--tint,#e2f2e9);font-size:23px;margin-right:12px}.activity strong{display:block;fon\nt-size:16px}.activity small{display:block;color:#83948e;margin-top:5px}.activity .stars{color:#e4ad4f;font-size:13px;margin-top:8px}.chip{display:inline-flex;align-items:center;gap\n:7px;border-radius:99px;background:#edf6ef;color:#56836f;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;padding:9px 12px}.chip.orange{background:#fff1\nd5;color:#ae7e31}.chip.pink{background:#fce9df;color:#b77e6e}.split{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center}.row{display:flex;align-items:center;just\nify-content:space-between;gap:16px}.divider{height:1px;background:#e7efe9;margin:19px 0}.field{display:grid;gap:8px;margin:16px 0;color:#748c83;font-weight:800;font-size:12px;text-\ntransform:uppercase;letter-spacing:.12em}.field input,.field select{width:100%;border:2px solid #e3eee6;border-radius:14px;padding:13px 15px;color:var(--ink);background:#fbfdf9;fon\nt-size:17px;letter-spacing:0;text-transform:none}.options{display:flex;flex-wrap:wrap;gap:8px}.option{border:2px solid #e6eee6;border-radius:13px;padding:10px 14px;background:#f8fb\nf8;font-weight:800}.option.selected{border-color:#63b2a0;background:#e7f7ec}.dialogue{background:#eef8f2;border-radius:20px;padding:18px 20px;color:#42665c;font-size:18px;line-heig\nht:1.45}.dialogue strong{color:#278f82}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.actions .action{min-width:160px}.play-hud{position:absolute;inset:0;pointer-ev\nents:none;padding:clamp(18px,3vw,40px);display:flex;flex-direction:column;justify-content:space-between}.play-hud button{pointer-events:auto}.hud-top,.hud-bottom{display:flex;align\n-items:flex-start;justify-content:space-between;gap:12px}.hud-box{background:rgba(255,255,250,.92);border:1px solid rgba(255,255,255,.8);border-radius:20px;padding:14px 20px;box-sh\nadow:0 9px 28px rgba(44,83,75,.09)}.hud-box strong{font-size:20px;letter-spacing:-.03em}.hud-box small{display:block;font-size:11px;color:#79938a;text-transform:uppercase;letter-sp\nacing:.12em;font-weight:900;margin-bottom:3px}.meter{height:9px;width:180px;border-radius:20px;background:#e5efe6;overflow:hidden;margin-top:8px}.meter>i{display:block;height:100%;\nbackground:#efba68;border-radius:20px}.play-instruction{text-align:center;align-self:center;background:rgba(255,255,250,.91);border-radius:999px;padding:12px 20px;font-weight:800;c\nolor:#57776c;box-shadow:var(--shadow)}.progress-dots{display:flex;gap:6px}.progress-dots i{width:9px;height:9px;border-radius:50%;background:#dcebe2}.progress-dots i.on{background:\n#4cae9c}.score-big{font-size:clamp(48px,7vw,76px);font-weight:900;letter-spacing:-.07em;color:#2b9991;line-height:1}.stars-big{font-size:30px;color:#efb956;letter-spacing:5px}.note\n{font-size:13px!important;color:#91a39b!important}.scroll{max-height:min(57vh,570px);overflow:auto;padding-right:8px}.about-group{border-top:1px solid #e7efe9;padding:12px 0}.about\n-group h3{font-size:18px}.about-group p{font-size:14px;margin:5px 0;overflow-wrap:anywhere}.touch-notice{position:fixed;inset:0;z-index:20;display:grid;place-items:center;padding:2\n0px;background:rgba(230,244,236,.92);text-align:center}.touch-notice .card{width:min(100%,460px)}.hidden{display:none!important}.toast{position:fixed;bottom:25px;left:50%;transform\n:translateX(-50%);background:#284e49;color:#fff;border-radius:99px;padding:12px 22px;z-index:10;font-weight:800}.class-players{display:grid;grid-template-columns:repeat(4,1fr);gap:\n10px}.player-tile{padding:18px;background:#f2f8f1;border-radius:18px;text-align:center}.player-tile .face{font-size:35px}.slider{width:100%;accent-color:#38a597}.island-message{pos\nition:absolute;top:12%;left:50%;transform:translateX(-50%);text-align:center;white-space:nowrap;pointer-events:none}.island-message h1{font-size:clamp(24px,3.2vw,40px);margin:6px;l\netter-spacing:-.04em}.island-message p{margin:0;color:#708e82;font-weight:700}.map-actions{position:absolute;bottom:clamp(20px,4vh,45px);left:50%;transform:translateX(-50%);width:m\nin(92%,760px);display:flex;justify-content:center;gap:10px}.map-actions .action{min-width:180px}.map-actions button{pointer-events:auto}.center-copy{text-align:center}.center-copy \np{max-width:580px;margin-left:auto;margin-right:auto}\n@media(max-width:850px){.hero-copy{width:58%}.logo{font-size:clamp(48px,8vw,72px)}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.footer .weather{display:none}.card{p\nadding:26px}.main-wrap{align-items:flex-start;padding:25px 0}.page{min-height:100%;padding:22px}.play-hud{padding:16px}.island-message{top:12%}}\n@media(max-width:540px){.page{padding:18px}.hero{align-items:flex-end}.hero-copy{width:100%;padding:30px 0 20px}.logo{font-size:58px;max-width:320px;margin:12px 0}.lede{font-size:1\n6px;max-width:315px;margin-bottom:18px}.menu-stack{width:100%;max-width:340px}.action{padding:13px 16px;font-size:15px;border-radius:15px}.brand{font-size:10px}.footer{font-size:9p\nx}.card-grid,.split{grid-template-columns:1fr}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.activity{padding:10px;min-height:92px}.activity-icon{width:34px;\nheight:34px;font-size:18px}.activity strong{font-size:13px}.activity small{font-size:11px}.card h1{font-size:34px}.card p{font-size:15px}.hud-box{padding:10px 12px}.hud-box strong{\nfont-size:16px}.meter{width:110px}.play-instruction{font-size:12px;max-width:90%;padding:10px 14px}.class-players{grid-template-columns:repeat(2,1fr)}.map-actions .action{min-width\n:0;flex:1}.map-actions{width:90%}.scroll{max-height:55vh}}\n","exit_code":0,"status":"completed"}}
