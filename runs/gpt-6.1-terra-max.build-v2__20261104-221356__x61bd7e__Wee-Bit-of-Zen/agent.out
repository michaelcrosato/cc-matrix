(255,255,251,.96);border:1px solid rgba(255,255,255,.9);box-shadow:var(--shadow);border-radius:30px;padding:clamp(24px,4vw,50px);position:relative}.card.wide{width:min(100%,1060px)}.card.narrow{width:min(100%,560px)}.card h1,.card h2{letter-spacing:-.045em;line-height:1.05;margin:10px 0 12px}.card h1{font-size:clamp(32px,4.3vw,53px)}.card h2{font-size:clamp(25px,3vw,36px)}.card p{line-height:1.5;color:#667c79;font-size:17px}.card .action{background:#f4f8f4;box-shadow:none}.card .action.primary{background:#2b9991;color:white}.card .action:hover,.card .action.is-focused{background:#e7f3ed}.card .action.primary:hover,.card .action.primary.is-focused{background:#218b83}.card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.activity-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.activity{border:1px solid #e4eee7;background:#f8fbf7;border-radius:19px;padding:15px;text-align:left;min-height:114px;position:relative}.activity:hover,.activity.is-focused{background:#edf8f1;border-color:#8ec9b3;transform:translateY(-2px)}.activity:disabled{opacity:.5;cursor:not-allowed}.activity-icon{display:grid;place-items:center;float:left;width:42px;height:42px;border-radius:13px;background:var(--tint,#e2f2e9);font-size:23px;margin-right:12px}.activity strong{display:block;font-size:16px}.activity small{display:block;color:#83948e;margin-top:5px}.activity .stars{color:#e4ad4f;font-size:13px;margin-top:8px}.chip{display:inline-flex;align-items:center;gap:7px;border-radius:99px;background:#edf6ef;color:#56836f;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;padding:9px 12px}.chip.orange{background:#fff1d5;color:#ae7e31}.chip.pink{background:#fce9df;color:#b77e6e}.split{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center}.row{display:flex;align-items:center;justify-content:space-between;gap:16px}.divider{height:1px;background:#e7efe9;margin:19px 0}.field{display:grid;gap:8px;margin:16px 0;color:#748c83;font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.12em}.field input,.field select{width:100%;border:2px solid #e3eee6;border-radius:14px;padding:13px 15px;color:var(--ink);background:#fbfdf9;font-size:17px;letter-spacing:0;text-transform:none}.options{display:flex;flex-wrap:wrap;gap:8px}.option{border:2px solid #e6eee6;border-radius:13px;padding:10px 14px;background:#f8fbf8;font-weight:800}.option.selected{border-color:#63b2a0;background:#e7f7ec}.dialogue{background:#eef8f2;border-radius:20px;padding:18px 20px;color:#42665c;font-size:18px;line-height:1.45}.dialogue strong{color:#278f82}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.actions .action{min-width:160px}.play-hud{position:absolute;inset:0;pointer-events:none;padding:clamp(18px,3vw,40px);display:flex;flex-direction:column;justify-content:space-between}.play-hud button{pointer-events:auto}.hud-top,.hud-bottom{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.hud-box{background:rgba(255,255,250,.92);border:1px solid rgba(255,255,255,.8);border-radius:20px;padding:14px 20px;box-shadow:0 9px 28px rgba(44,83,75,.09)}.hud-box strong{font-size:20px;letter-spacing:-.03em}.hud-box small{display:block;font-size:11px;color:#79938a;text-transform:uppercase;letter-spacing:.12em;font-weight:900;margin-bottom:3px}.meter{height:9px;width:180px;border-radius:20px;background:#e5efe6;overflow:hidden;margin-top:8px}.meter>i{display:block;height:100%;background:#efba68;border-radius:20px}.play-instruction{text-align:center;align-self:center;background:rgba(255,255,250,.91);border-radius:999px;padding:12px 20px;font-weight:800;color:#57776c;box-shadow:var(--shadow)}.progress-dots{display:flex;gap:6px}.progress-dots i{width:9px;height:9px;border-radius:50%;background:#dcebe2}.progress-dots i.on{background:#4cae9c}.score-big{font-size:clamp(48px,7vw,76px);font-weight:900;letter-spacing:-.07em;color:#2b9991;line-height:1}.stars-big{font-size:30px;color:#efb956;