k: 1.2, headR: 3.4,\n      armUpper: 4.6, armLower: 4.6, limbW: 2, torsoW: 3, lean: 0, hunch: 0, stride: 6.5, lift: 3.4, swing: 4, speedRef: 70,\n      weapon: 'sword', bladeLen: 11, cape: null, hood: false, eyeGlow: null, hat: null,\n      style: 'hd', size: 1, hair: 'short', outfit: 'shirt', sleeves: 'short', armor: false, cheat: .5\n    }, o);\n    /** trail: recent points of the blade (or fist) tip, for the swing's smear */\n    this._cheat = 0; this.trail = [];\n    if (typeof this.o.hair === 'string' || !this.o.hair) this.o.hair = { style: this.o.hair || 'short' };\n    /** hairPts: the long hair's simulated points (null until it has some) */\n    this._hairPts = null;\n    if (this.o.weapon && !HUMANOID_WEAPONS[this.o.weapon]) { warn('weapon:' + this.o.weapon, 'Humanoid weapon \"' + this.o.weapon + '\" is not on E.Humanoid.weapons (sword, gun, staff, a game\\'s own by E.Humanoid.weapon(id, spec), or null); drawing a sword'); this.o.weapon = 'sword'; }\n    if (typeof this.o.hat === 'string') this.o.hat = { style: this.o.hat };\n    /** C: its colors (skin, hair, cloth, pants, boot, belt, cape, capeIn, metal, hilt, eye, ...), the defaults with\n     *  o.colors over them; change one and it shows at the next draw */\n    this.C = Object.assign({}, HUMAN_COLORS, o.colors || {});\n    const C = this.C;\n    if (this.o.skeleton) C.skin = C.pants = C.boot = C.glove = C.bone || '#e6dfc8';\n    C.clothDk = C.clothDk || shade(C.cloth, -.3); C.clothLt = C.clothLt || shade(C.cloth, .25);\n    C.pantsDk = C.pantsDk || shade(C.pants, -.3); C.bootDk = C.bootDk || shade(C.boot, -.3); C.skinDk = C.skinDk || shade(C.skin, -.2);\n    this._rnd = rng(o.seed !== undefined ? o.seed : Math.floor(Math.random() * 2147483647) + 1);   // (its own stream: o.seed, else one draw of Math.random; its blinks never draw from Math.random)\n    /** t: seconds of its own clock (idle breathing, blinks); phase: the walk cycle's phase, radians; mv: the last\n     *  ground direction it moved, a unit vector; hurtW: 0..1, how far into the hurt flinch */\n    this.t = this._rnd() * 10; this.phase = 0; this._spW = 0; this._mv = [1, 0]; this._dashW = 0; this.hurtW = 0; this._atkW = 0;\n    /** atkZ: the height of the weapon hand during an attack; reach: how far it reaches forward; spin: the body's\n     *  extra turn during a spinning move, radians */\n    this._theta = 1.2; this.atkZ = 10; this.reach = 7; this._twist = 0; this.spin = 0; this._atkLean = 0;\n    /** sq: squash and stretch, -0.45..0.45 (kick adds to it); sqV: its speed; blink: seconds to the next blink;\n     *  facing: the angle it faces, radians; x, y, z: where its feet are (from the last update); J: its joints this\n     *  step in its own frame ({ hipL, kneeL, footL, shC, head, handR, ... }; rig.worldOffset(J.handR) gives one in\n     *  the world); smear: the swing's smear arc, or null */\n    this.sq = 0; this.sqV = 0; this.blink = 2; this.facing = 0; this.x = 0; this.y = 0; this.z = 0; this.J = {}; this._smear = null;\n    /** capeL: the cape's left edge points (null until it has a cape and has moved) */\n    this.capeL = null; this._airW = 0; this._pointW = 0; this._kicking = false;\n    this.solvePose();\n  }\n  /** a squash-and-stretch kick: + stretches (a jump), - squashes (a landing, a hit) */\n  kick(v) { this.sqV += v; }\n  /** a heavy landing: knees bend deep and spring back over a moment; strength 1 or more drops a hand to the ground\n   *  (a three-point landing), .3-.6 is a soft one. Call it on the step the body lands */\n  land(strength = 1) { this._landT = 0; this._landK = clamp(strength, 0, 1.5); this.kick(-1.5 * Math.min(1, strength)); }\n  /** how much a stride stretches: shorter while sneaking, longer while sprinting */\n  _strideK() { return 1 - .35 * (this._sneakW || 0) + .25 * (this._sprintW || 0); }\n  /** the roll (state flip: u 0..1, a forward somersault about the hips, tucked in the middle): turns every joint, and the\n   *  cape and hair for this step's drawing only (the next update puts them back before they simulate, so they never\n4093:     *  step in its own frame ({ hipL, kneeL, footL, shC, head, handR, ... }; rig.worldOffset(J.handR) gives one in\n4095:    this.sq = 0; this.sqV = 0; this.blink = 2; this.facing = 0; this.x = 0; this.y = 0; this.z = 0; this.J = {}; this._smear = null;\n4125:  hand(which = 'R') { const w = this._w(this.J['hand' + which] || this.J.handR); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\n4127:  tip() { const J = this.J, W = HUMANOID_WEAPONS[this.o.weapon], l = W ? W.length : this.o.bladeLen, L = typeof l === 'function' ? l(this) : l, w = this._w(V3.add(J.handR, V3.mul(J.bladeDir, L))); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\n4128:  /** where a point in the rig's own frame ([forward, right, up]; a joint such as rig.J.head, or one offset from it)\n4206:        const J = this.J; if (J.handR) this._from = { R: J.handR.slice(), L: J.handL.slice(), bd: J.bladeDir.slice() };   // the wind blends from the real pose: no snaps\n4256:      const b = kick ? J.kneeR : sword ? V3.add(J.handR, V3.mul(J.bladeDir, 2)) : left ? J.elbowL : J.elbowR, t = kick ? J.footR : sword ? V3.add(J.handR, V3.mul(J.bladeDir, o.bladeLen)) : left ? J.handL : J.handR;\n4266:    const J = this.J, anchor = () => { const w = this._w([J.head[0] - o.headR * .8, 0, J.head[2] + (long ? o.headR * .1 : o.headR * .55)]); return [this.x + w[0], this.y + w[1], this.z + w[2]]; };\n4271:    const shZ = this.z + J.shC[2] * o.size, bodyR = (o.torsoW * .75 + .6) * o.size, headTop = this.z + (J.head[2] + o.headR * .6) * o.size;\n4292:    J.hipL = add(hipC, rz([0, -o.hipHalf, 0], this._twist * .4)); J.hipR = add(hipC, rz([0, o.hipHalf, 0], this._twist * .4));\n4308:      const hip = s > 0 ? J.hipR : J.hipL;\n4315:    J.hipC = hipC; J.shC = shC;\n4316:    J.shL = add(shC, rz([0, -o.shoulderHalf, 0], this._twist)); J.shR = add(shC, rz([0, o.shoulderHalf, 0], this._twist));\n4317:    J.head = add(shC, V3.mul(V3.norm([dir[0] + o.hunch * .9, dir[1], dir[2]]), o.neck + o.headR));\n4323:      const sh = s > 0 ? J.shR : J.shL, q = ph + (s > 0 ? 0 : Math.PI), along = -Math.sin(q) * o.swing * sp * (1 + .6 * spr) * (1 - .4 * snk);\n4336:      if (PW.hips > 0) hand = V3.lerp(hand, add(s > 0 ? J.hipR : J.hipL, [-.2, s * 1.5, 1.5]), PW.hips);\n4369:  head() { const w = this._w(this.J.head); return [this.x + w[0], this.y + w[1], this.z + w[2]]; }\n4393:      const hw = this._w(this.J.head), hp = v.p(hw[0], hw[1], hw[2]);\n4408:    const anchor = s => { const J = this.J, sh = s > 0 ? J.shR : J.shL, w = this._w(V3.add(sh, [-1.3, -s * .6, -.6])); return [this.x + w[0], this.y + w[1], this.z + w[2]]; };\n4452:      if (p === J.handR) return S(p[0] + df, p[1] + dr, p[2] + dz);\n4453:      const m = p === J.head ? T.head : T.body;\n4508:      const ank = lq(knee, foot, .62), toe = Sp(s > 0 ? J.footR : J.footL, 1.9, 0, .3);\n4515:    const out = o.outfit, hz = Math.max(J.hipL[2], J.hipR[2]) + .9;\n4519:      const lat = [Sp([J.hipC[0], -o.hipHalf * 1.25, hz]), Sp([J.hipC[0], o.hipHalf * 1.25, hz]), Sp([J.hipC[0] + tail * .5 + fwd, o.hipHalf * 1.25 * fl, hz - len]), Sp([J.hipC[0] + tail * .5 + fwd, -o.hipHalf * 1.25 * fl, hz - len])];\n4520:      const sag = [Sp([J.hipC[0] + dep, 0, hz]), Sp([J.hipC[0] + (out === 'coat' ? dep * .3 : dep * fl) + fwd, 0, hz - len * (out === 'coat' ? .45 : 1)]), Sp([J.hipC[0] - dep * fl + tail, 0, hz - len]), Sp([J.hipC[0] - dep, 0, hz])];\n4528:    const shL = Sp(J.shL, 0, -.4, 0), shR = Sp(J.shR, 0, .4, 0), hL = Sp(J.hipL, 0, -.25, .5), hR = Sp(J.hipR, 0, .25, .5);\n4529:    const wL = lq(Sp(J.hipL, 0, -.2, 0), shL, .5), wR = lq(Sp(J.hipR, 0, .2, 0), shR, .5), core0 = Sp(J.hipC, 0, 0, .8), core1 = Sp(J.shC, 0, 0, -.4);\n4532:      const b = tones(C.skin), rib0 = Sp(J.shC, .2, 0, -.7), rib1 = lq(Sp(J.shC, .3, 0, -.7), Sp(J.hipC, .2, 0, 1), .55), gap = '#1a1018';\n4534:      const pl = Sp(J.hipL, 0, -.2, .9), pr = Sp(J.hipR, 0, .2, .9); cap(pl, pr, .75 * u, .75 * u, b.sh); cap(pl, pr, Math.max(.4, .75 * u - .8), Math.max(.4, .75 * u - .8), b.base, -.5, -.5);\n4549:      if (facingCam) { const n0 = Sp(J.shC, .9, 0, -.8), n1 = Sp(J.hipC, 1.1, 0, 1.4); px.line(g, n0[0], n0[1], n1[0], n1[1], t.sh); const c0 = Sp(J.shC, .7, -.9, -.2), c1 = Sp(J.shC, 1.1, 0, -1.3), c2 = Sp(J.shC, .7, .9, -.2); px.line(g, c0[0], c0[1], c1[0], c1[1], tones(C.trim || C.clothLt).base); px.line(g, c1[0], c1[1], c2[0], c2[1], tones(C.trim || C.clothLt).base); }\n4550:      else { const n0 = Sp(J.shC, .3, 0, -.6), n1 = Sp(J.hipC, .3, 0, 1.6); px.line(g, n0[0], n0[1], n1[0], n1[1], t.lt); }\n4551:      const bl = Sp(J.hipL, 0, -.3, .7), br = Sp(J.hipR, 0, .3, .7), bt = tones(C.belt);\n4553:      if (facingCam) { const bk = Sp(J.hipC, 1.1, 0, .7); px.rect(g, bk[0] - 1, bk[1] - 1, 2, 2, bt.hi); }\n4554:      if (o.armor) { const m = tones(C.plate || C.metal); const p0 = Sp(J.shC, .5, 0, -1), p1 = Sp(J.hipC, .5, 0, 3.2); cap(p0, p1, o.torsoW * .5 * u, o.torsoW * .4 * u, m.sh); cap(p0, p1, o.torsoW * .5 * u - 1, o.torsoW * .4 * u - 1, m.base, -.6, -.6); px.dot(g, p0[0] - 1, p0[1] + 1, m.hi); }\n4579:    const neck0 = Sp(J.shC, 0, 0, -.2), neck1 = Sp(J.head, 0, 0, -o.headR * .6);\n4584:      const H = Sp(J.head, R * .1, 0, -R * .05), back = Sp(J.head, -R * .42, 0, R * .18), cap = Sp(J.head, -R * .2, 0, R * .74);\n4587:        const bt = tones(C.skin), jaw = Sp(J.head, R * .45, 0, -R * .78), gap = '#1a1018';\n4590:        const t0 = Sp(J.head, R * .72, -R * .34, -R * .5), t1 = Sp(J.head, R * .72, R * .34, -R * .5);   // tooth row: a dark gap with white teeth\n4593:          const E2 = Sp(J.head, R * .78, sd * R * .4, -R * .02); if (E2[2] <= H[2] + .1) continue;\n4594:          const br = Sp(J.head, R * .82, sd * R * .4, R * .3); px.line(g, br[0] - r * .3, br[1], br[0] + r * .3, br[1], bt.sh);   // brow ridge\n1:/* FITCLIPS: an animation set in my-3D2dge's readable format (written by the tools in tools/; clips may be edited by hand).\n20:(window.MOCAP = window.MOCAP || {})