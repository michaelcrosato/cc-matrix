{"type":"item.started","item":{"id":"item_238","type":"command_execution","command":"/bin/bash -lc \"rg -n 'case |function (render|startActivity|completeActivity|updateActivity|pollGamepad|attemptInput|updateHUD|frame)|AIHub|class-result|classPlayers|screen === .hub|screen === .class' src/game.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_238","type":"command_execution","command":"/bin/bash -lc \"rg -n 'case |function (render|startActivity|completeActivity|updateActivity|pollGamepad|attemptInput|updateHUD|frame)|AIHub|class-result|classPlayers|screen === .hub|screen === .class' src/game.js\"","aggregated_output":"11:  selection: null, activity: null, returnScreen: 'title', check: null, toast: '', classPlayers: [],\n12:  festival: false, festivalIndex: 0, hub: { active: !!window.AIHub?.active, started: false, finished: false, score: 0, lastSend: 0, lastProgress: 0, ghosts: {} }\n68:function render() {\n115:  } else if (state.screen === 'class') {\n117:    const players = state.classPlayers;\n119:  } else if (state.screen === 'class-result') {\n121:    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\n134:  } else if (state.screen === 'hub') {\n153:function startActivity(activity, options = {}) {\n159:function completeActivity() {\n169:function attemptInput(key) {\n184:function updateActivity(dt) {\n219:    const now = window.AIHub.time();\n220:    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n221:    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n225:function updateHUD() {\n259:    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n260:    case 'slots': screen('slots'); break;\n261:    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n262:    case 'outfit': state.member.outfit = Number(id); render(); break;\n263:    case 'instructor': state.member.instructor = id; render(); break;\n264:    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n265:    case 'check': beginCheck(); break;\n266:    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n267:    case 'island': state.classMode = false; screen('island'); break;\n268:    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n269:    case 'locked': notify('A new mat opens on a later day.'); break;\n270:    case 'start-activity': startActivity(state.selection); break;\n271:    case 'retry': startActivity(state.selection, { seconds: state.festival ? 30 : undefined }); break;\n272:    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n273:    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n274:    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n275:    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n276:    case 'ending': screen('ending'); break;\n277:    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n278:    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad' }, { name: 'Gertrude', type: 'Bot' }]; state.selection = state.selection || ACTIVITIES[0]; screen('class'); break;\n279:    case 'class-toggle': { const index = Number(id); if (index === 0) break; state.classPlayers[index] = state.classPlayers[index] ? null : { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot' }; render(); break; }\n280:    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n281:    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection); break;\n282:    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n283:    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n284:    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n285:    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n286:    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n287:    case 'pause': pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); break;\n288:    case 'resume': screen(pausedFrom || 'play'); break;\n289:    case 'restart': startActivity(state.selection, { seconds: state.festival ? 30 : undefined }); break;\n290:    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n291:    case 'dev': screen('dev'); break;\n292:    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n293:    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n294:    case 'about-back': screen(state.aboutReturn || 'title'); break;\n309:  if (key === 'escape' || key === 'backspace') { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (state.screen === 'dev') screen('pause'); else if (state.screen === 'activity') action('island'); else if (state.screen === 'slots' || state.screen === 'class') action('home'); return; }\n317:function pollGamepad() {\n339:function frame(now) {\n354:  window.AIHub.on('start', () => { state.hub.started = true; state.hub.startedAt = window.AIHub.time(); startActivity(ACTIVITIES.find(activity => activity.id === 'stork'), { seconds: 60 }); });\n355:  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n356:  window.AIHub.on('time-up', () => { if (!state.hub.finished) { state.hub.finished = true; if (state.activity && state.screen === 'play') state.hub.score += state.activity.score / Math.max(1, state.activity.samples) * 1000; window.AIHub.result({ score: Math.round(state.hub.score) }); screen('hub'); } });\n357:  window.AIHub.on('end', () => { state.hub.finished = true; screen('hub'); });\n358:  window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }).then(() => window.AIHub.ready()).catch(() => notify('Unable to connect to the Hub.'));\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_239","type":"command_execution","command":"/bin/bash -lc \"sed -n '65,165p' src/game.js | fold -w 220 -s; sed -n '165,245p' src/game.js; sed -n '245,365p' src/game.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_239","type":"command_execution","command":"/bin/bash -lc \"sed -n '65,165p' src/game.js | fold -w 220 -s; sed -n '165,245p' src/game.js; sed -n '245,365p' src/game.js\"","aggregated_output":"  const info = window.BUILD_INFO || {}, sections = [ ['Source Information', info.sourceInformation], ['Testing Feedback', info.testingFeedback], ['Engine Feedback', info.engineFeedback], ['Prompt Feedback', \ninfo.promptFeedback] ];\n  return sections.map(([title, value]) => `<div class=\"about-group\"><h3>${title}</h3>${Array.isArray(value) ? value.map((item, index) => `<p><b>${index + 1}.</b> ${escapeHTML(item)}</p>`).join('') : Object.entries(value \n|| {}).map(([key, item]) => `<p><b>${escapeHTML(key)}:</b> ${escapeHTML(item)}</p>`).join('')}</div>`).join('');\n}\nfunction render() {\n  const member = person();\n  let content = '', heading = '';\n  if (state.screen === 'title' || state.screen === 'attract') {\n    content = `<main class=\"hero\"><section class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"sun-dot\">✳</span> A LITTLE ISLAND FOR YOURSELF</div><h1 class=\"logo\">wee bit<br><em>of zen</em><span \nclass=\"logo-dot\">.</span></h1><p class=\"lede\">A pleasantly imperfect retreat for<br>your body, mind, and general wobble.</p><div class=\"menu-stack\">${button('Begin your stay', 'slots', true, '', 'A little time just for \nyou')}${button('Local Class', 'class', false, '', 'Practice together, up to four')}${button('About & credits', 'about')}</div></section><div class=\"island-message\"><span>✦ &nbsp; TAKE IT AT YOUR OWN \nPACE</span><strong>Good things happen<br>one wobble at a time.</strong></div></main>`;\n    if (state.screen === 'attract') content += '<div class=\"center-copy\">DEMONSTRATION &nbsp; · &nbsp; PRESS ANY KEY</div>';\n  } else if (state.screen === 'slots') {\n    heading = 'YOUR STAY';\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; THE GUEST BOOK</div><h1>Make yourself at home.</h1><p>Choose a room for your island stay.</p></div></div><div \nclass=\"card-grid\">${state.slots.map((slot, index) => `<button class=\"card slot-card\" data-action=\"slot\" data-id=\"${index}\"><span class=\"slot-num\">0${index + 1}</span><span class=\"slot-avatar\">${slot ? '☺' : \n'+'}</span><strong>${slot ? escapeHTML(slot.name) : 'New member'}</strong><small>${slot ? `${slot.finished ? 'Free practice' : `Day ${slot.day}`} · ${Math.floor(slot.minutes || 0)} fit minutes` : 'A fresh start \nawaits'}</small><span class=\"arrow\">↗</span></button>`).join('')}</div><div class=\"actions\">${button('Back', 'home')}</div></main>`;\n  } else if (state.screen === 'setup') {\n    heading = 'NEW MEMBER';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; NICE TO MEET YOU</div><h1>A little about you.</h1><p>There is no wrong way to arrive.</p></div></div><div \nclass=\"card setup-card\"><label class=\"field\">WHAT SHOULD WE CALL YOU?<input id=\"nickname\" maxlength=\"16\" value=\"${escapeHTML(member.name === 'Guest' ? '' : member.name)}\" placeholder=\"Your name\" \nautocomplete=\"off\"></label><p class=\"field-label\">CHOOSE YOUR COLOUR</p><div class=\"options\">${OUTFITS.map((color, index) => `<button class=\"option swatch ${member.outfit === index ? 'selected' : ''}\" \ndata-action=\"outfit\" data-id=\"${index}\" style=\"--swatch:${color}\" aria-label=\"Outfit ${index + 1}\">${member.outfit === index ? '✓' : ''}</button>`).join('')}</div><p class=\"field-label\">YOUR INSTRUCTOR</p><div \nclass=\"options\">${['Birch', 'Alder'].map(name => `<button class=\"option ${member.instructor === name ? 'selected' : ''}\" data-action=\"instructor\" data-id=\"${name}\">${name === 'Birch' ? '✳' : '✦'} &nbsp; \n${name}</button>`).join('')}</div><div class=\"actions\">${button('Back', 'slots')}${button('Arrive on the island', 'create-member', true)}</div></div></main>`;\n  } else if (state.screen === 'intro') {\n    heading = labelDay();\n    content = `<main class=\"main-wrap narrow\"><div class=\"dialogue card\"><div class=\"eyebrow\">✳ &nbsp; A NOTE FROM TARE</div><div class=\"speaker\">☺</div><h1>Welcome${member.day === 1 ? ', ' + escapeHTML(member.name) : ' \nback'}.</h1><p>“${DAY_INTROS[Math.min(4, member.day - 1)]}”</p><p class=\"note\">Your stay starts with a gentle body check. No weights, no judgement, and absolutely no pop quizzes. Well, one tiny quiz.</p><div \nclass=\"actions\">${button('Begin body check', 'check', true)}</div></div></main>`;\n  } else if (state.screen === 'check') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">✳ &nbsp; BODY CHECK</div><h2>Just checking in.</h2><p id=\"check-text\">Find a comfortable center.</p></div><div \nclass=\"hud-box timer\" id=\"check-timer\">05</div></div><div class=\"hud-bottom\"><div class=\"play-instruction\">${state.check?.phase === 'lean' ? 'Lean in each direction: ← ↑ → ↓' : 'Stay steady. Small wobbles are \nwelcome.'}</div><div class=\"meter\"><span id=\"check-progress\"></span></div></div></main>`;\n  } else if (state.screen === 'question') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ONE VERY SCIENTIFIC QUESTION</div><h1>How are you arriving today?</h1><p>Your answer helps us calibrate the island's \nextremely sophisticated vibes.</p><div class=\"menu-stack\">${button('Bright-eyed and bushy-tailed', 'question-answer', true, 'bright')}${button('A little wobbly, honestly', 'question-answer', false, \n'wobbly')}${button('Mostly thinking about snacks', 'question-answer', false, 'snacks')}</div></div></main>`;\n  } else if (state.screen === 'check-result') {\n    heading = 'BODY CHECK COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ACCORDING TO TARE</div><div class=\"score-big\">${state.check.spine}</div><h1>Your Spine Age</h1><p>“A completely \nimaginary number. Your actual spine remains splendid.”</p><p class=\"note\">Today is a fine day to practice being here.</p><div class=\"actions\">${button('Explore the island', 'island', true)}</div></div></main>`;\n  } else if (state.screen === 'island') {\n    heading = labelDay();\n    const dialogue = CAST[(member.day + member.sessions) % CAST.length];\n    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of \nmovement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || \n0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div \nclass=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the \nday', member.finished ? 'ending' : 'sleep', true)}</div></div></main>`;\n  } else if (state.screen === 'activity') {\n    const activity = state.selection, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div \nclass=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>How to \nplay</h3><p>${activity.instruction}</p><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle mode is on.' : 'Make small, comfortable movements.'}</p><div \nclass=\"actions\">${button('Back to island', state.classMode ? 'class' : 'island')}${button('Begin practice', 'start-activity', true)}</div></div></main>`;\n  } else if (state.screen === 'play') {\n    const activity = state.activity, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your \ncenter.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" \nid=\"plate-ring\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"play-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span \nid=\"play-progress\"></span></div><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE START</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\n  } else if (state.screen === 'result') {\n    const result = state.result;\n    heading = 'SESSION COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue result-card\"><div class=\"eyebrow\">✳ &nbsp; PRACTICE COMPLETE</div><div class=\"stars-big\">${'★'.repeat(result.stars)}<span>${'☆'.repeat(3 - \nresult.stars)}</span></div><h1>Lovely work${state.classMode ? ', everyone' : ''}.</h1><p>“${result.message}”</p><div \nclass=\"result-stats\"><div><strong>${result.percent}%</strong><small>STEADINESS</small></div><div><strong>+${result.minutes}</strong><small>FIT \nMINUTES</small></div><div><strong>${result.stumbles}</strong><small>WOBBLES</small></div></div><div class=\"actions\">${button('Practice again', 'retry')}${button(state.festival ? 'Continue the Games' : state.classMode ? \n'Class results' : 'Back to island', 'result-continue', true)}</div></div></main>`;\n  } else if (state.screen === 'recap') {\n    heading = 'DAY COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ANOTHER DAY WELL SPENT</div><h1>Rest is part of it.</h1><p>“${member.sessions} sessions today. Gerald the ceramic \nhippo has made a careful note.”</p><div class=\"result-stats\"><div><strong>${Math.floor(member.minutes)}</strong><small>FIT MINUTES</small></div><div><strong>${Object.keys(member.stars || {}).length}</strong><small>MATS \nVISITED</small></div></div><div class=\"actions\">${button('Wake up to day ' + (member.day + 1), 'next-day', true)}</div></div></main>`;\n  } else if (state.screen === 'festival') {\n    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Three friendly challenges, ending in the \nGrand Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div \nclass=\"actions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n  } else if (state.screen === 'ending') {\n    heading = 'THANK YOU FOR STAYING';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little steadier.<br><em>A lot more \nyou.</em></h1><p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for five days of moving, breathing, and making room. The mats are yours \nwhenever you wish.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits', 'about')}</div></div></main>`;\n  } else if (state.screen === 'class') {\n    heading = 'LOCAL CLASS';\n    const players = state.classPlayers;\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect \ncontrollers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? \nescapeHTML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" \ndata-id=\"${index}\">${players[index] ? 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => \n`<button class=\"option ${state.selection?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div \nclass=\"actions\">${button('Back', member.name === 'Guest' ? 'home' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n  } else if (state.screen === 'class-result') {\n    heading = 'LOCAL CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold \nstar.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; \n★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\n  } else if (state.screen === 'settings') {\n    heading = 'SETTINGS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card \nsettings-card\">${settingRow('Music', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : \n'OFF', 'toggle', 'voice')}${settingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', \n'breathToggle')}${settingRow('Tips', state.settings.tips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from \n0% to 100%. Gentle mode makes balancing more forgiving.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n  } else if (state.screen === 'pause') {\n    heading = 'PAUSED';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', \ntrue)}${button('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', \n'leave-play')}</div></div></main>`;\n  } else if (state.screen === 'dev') {\n    heading = 'DEVELOPER MODE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the \nwobble.</h1>${[['spring','Spring',4,20,.5],['damping','Damping',1,12,.5],['instability','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output \nid=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"actions\">${button('Reset tuning', \n'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n  } else if (state.screen === 'about') {\n    heading = 'ABOUT & CREDITS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card scroll\"><div class=\"eyebrow\">✳ &nbsp; A LITTLE NOTE FROM THE MAKERS</div><h1>About & credits.</h1><p>Made with care for everyone who has ever \nwobbled.</p>${aboutContent()}<div class=\"actions\">${button('Back', 'about-back', true)}</div></div></main>`;\n  } else if (state.screen === 'hub') {\n    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A little steadiness, \nshared.'}</h1><p>${state.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; everyone gets a moment to breathe.'}</p><div \nclass=\"result-stats\"><div><strong>${Math.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.started ? 'The class is underway.' : 'Waiting for the other \nguests…'}</p></div></main>`;\n  }\n  app.innerHTML = shell(content, heading, state.screen !== 'play' && state.screen !== 'check');\n  if (state.screen === 'play') updateHUD();\n  if (state.screen === 'check') updateCheckHUD();\n  const touchOnly = matchMedia('(pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n  if (touchOnly && !['settings','about'].includes(state.screen)) {\n    const notice = document.createElement('div'); notice.className = 'touch-notice'; notice.innerHTML = '<div><span>✳</span><h2>Controller or keyboard required</h2><p>Connect a controller or keyboard to enjoy the \nisland.</p><button class=\"action primary\" data-action=\"settings\">Settings <span class=\"arrow\">↗</span></button></div>'; app.appendChild(notice);\n  }\n}\nfunction currentButtons() { return [...app.querySelectorAll('button:not([disabled])')].filter(node => node.offsetParent !== null && !node.closest('.touch-notice')); }\nfunction focusMove(direction) {\n  const buttons = currentButtons(); if (!buttons.length) return;\n  const index = buttons.indexOf(document.activeElement); buttons[(index + direction + buttons.length) % buttons.length].focus();\n}\nfunction memberDefault() { return { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\nfunction beginCheck() { state.check = { phase: 'still', elapsed: 0, directions: new Set(), spine: 25 + Math.floor(Math.random() * 25) }; state.activity = null; screen('check'); }\nfunction startActivity(activity, options = {}) {\n  const selected = { ...activity }, duration = options.seconds || selected.seconds;\n  state.selection = selected;\n  state.activity = { ...selected, seconds: duration, elapsed: 0, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, ringX: 0, ringY: 0, flame: .6, score: 0, samples: 0, stumbles: 0, stun: 0, effort: 0, reps: 0, beatHits: 0, \nlastBeat: -1, lastJog: '', jogHits: 0, hoopHits: 0, good: 0, tray: 0, lastDirection: 0, motions: 0, rng: seeded(841 + selected.name.length) };\n  mouseLean = null; keys.clear(); toggledBreath = false; screen('play');\n}\nfunction completeActivity() {\n  const activity = state.activity;\n  if (!activity) return;\n  const percent = Math.round(clamp(activity.score / Math.max(1, activity.samples) * 100, 0, 100));\n  const stars = percent >= 90 ? 3 : percent >= 65 ? 2 : percent >= 35 ? 1 : 0;\n  const minutes = Math.max(1, Math.round(activity.seconds / 60 * (1 + stars * .25)));\n  state.result = { percent, stars, minutes, stumbles: activity.stumbles, message: stars >= 2 ? 'You made the wobble look rather elegant.' : 'A little practice is still a lovely thing.' };\n  state.result = { percent, stars, minutes, stumbles: activity.stumbles, message: stars >= 2 ? 'You made the wobble look rather elegant.' : 'A little practice is still a lovely thing.' };\n  if (!state.hub.active && !state.classMode) { const member = state.member; member.sessions = (member.sessions || 0) + 1; member.minutes = (member.minutes || 0) + minutes; member.stars[activity.id] = Math.max(member.stars[activity.id] || 0, stars); save(); }\n  tone(523, .3); if (state.hub.active) { state.hub.score += percent * 10; screen('hub'); } else screen('result');\n}\nfunction attemptInput(key) {\n  const activity = state.activity;\n  if (!activity || state.screen !== 'play') return;\n  if (activity.kind === 'step') {\n    const directions = ['arrowleft','arrowup','arrowright','arrowdown'];\n    const aliases = { a:'arrowleft', w:'arrowup', d:'arrowright', s:'arrowdown' };\n    const direction = aliases[key] || key, beat = Math.round(activity.elapsed * 100 / 60), phase = Math.abs(activity.elapsed * 100 / 60 - beat);\n    if (direction === directions[(beat + 4) % 4] && phase < .34 && beat !== activity.lastBeat) { activity.beatHits++; activity.lastBeat = beat; tone(520, .08, .35); }\n  }\n  if (activity.kind === 'jog' && (key === 'j' || key === 'k') && key !== activity.lastJog) { activity.lastJog = key; activity.jogHits++; }\n  if (activity.kind === 'hoop' && (key === 'q' || key === 'e')) { activity.hoopHits++; tone(660, .1, .3); }\n  if ((key === ' ' || key === 'enter') && state.settings.breathToggle) toggledBreath = !toggledBreath;\n}\nconst tuningDefaults = { spring: 11, damping: 6, instability: 1.3, noise: .19 };\nconst tuning = { ...tuningDefaults };\nfunction updateActivity(dt) {\n  const activity = state.activity; if (!activity) return;\n  activity.elapsed += dt;\n  const pad = Array.from(navigator.getGamepads?.() || []).find(Boolean), axisX = pad && Math.abs(pad.axes[0]) > .12 ? pad.axes[0] : 0, axisY = pad && Math.abs(pad.axes[1]) > .12 ? pad.axes[1] : 0;\n  const dx = (keys.has('arrowright') || keys.has('d') ? 1 : 0) - (keys.has('arrowleft') || keys.has('a') ? 1 : 0);\n  const dy = (keys.has('arrowdown') || keys.has('s') ? 1 : 0) - (keys.has('arrowup') || keys.has('w') ? 1 : 0);\n  if (activity.stun <= 0) {\n    if (mouseLean) { activity.ux = mouseLean.x; activity.uy = mouseLean.y; }\n    else if (axisX || axisY) { activity.ux = axisX; activity.uy = axisY; }\n    else { activity.ux = clamp(activity.ux + dx * 2.2 * dt, -1, 1); activity.uy = clamp(activity.uy + dy * 2.2 * dt, -1, 1); if (!dx) activity.ux *= Math.max(0, 1 - .5 * dt); if (!dy) activity.uy *= Math.max(0, 1 - .5 * dt); }\n  } else activity.stun -= dt;\n  const gentle = state.settings.gentle ? .7 : 1, time = activity.elapsed, disturbance = tuning.noise * gentle;\n  const ax = tuning.spring * (activity.ux - activity.px) - tuning.damping * activity.vx + tuning.instability * gentle * activity.px + disturbance * (Math.sin(time * 1.7) + .5 * Math.sin(time * 3.23));\n  const ay = tuning.spring * (activity.uy - activity.py) - tuning.damping * activity.vy + tuning.instability * gentle * activity.py + disturbance * (Math.sin(time * 1.19 + 1) + .5 * Math.sin(time * 2.71));\n  activity.vx += ax * dt; activity.vy += ay * dt; activity.px += activity.vx * dt; activity.py += activity.vy * dt;\n  if (Math.hypot(activity.px, activity.py) >= 1 && activity.stun <= 0) { activity.stumbles++; activity.stun = 1; activity.px *= .5; activity.py *= .5; activity.vx *= -.2; activity.vy *= -.2; tone(196, .18); }\n  const phase = Math.floor(time / 12), rng = seeded(phase * 667 + 43);\n  activity.ringX = activity.id === 'stork' ? (rng() - .5) * .65 : activity.kind === 'slalom' ? Math.sin(time * .55) * .46 : 0;\n  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n  let quality = steadiness;\n  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n  activity.score += quality; activity.samples++;\n  if (state.hub.active) {\n    const now = window.AIHub.time();\n    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n  }\n  if (activity.elapsed >= activity.seconds) completeActivity();\n}\nfunction updateHUD() {\n  const activity = state.activity; if (!activity) return;\n  const timer = document.getElementById('play-timer'), status = document.getElementById('play-status'), instruction = document.getElementById('play-instruction'), progress = document.getElementById('play-progress'), dot = document.getElementById('plate-dot'), ring = document.getElementById('plate-ring'), score = document.getElementById('play-score');\n  if (!timer) return;\n  timer.textContent = Math.max(0, Math.ceil(activity.seconds - activity.elapsed));\n  if (activity.kind === 'step') { const arrows = ['←','↑','→','↓']; const beat = Math.round(activity.elapsed * 100 / 60); status.textContent = `NEXT STEP  ${arrows[(beat + 4) % 4]}   ·   ${activity.beatHits} on beat`; instruction.textContent = `Press ${arrows[(beat + 4) % 4]} on the beat · ${activity.instruction}`; }\n  else if (activity.kind === 'rep') status.textContent = `Rep ${activity.reps + 1} · ${Math.sin(activity.elapsed * Math.PI / 2 - Math.PI / 2) > 0 ? 'Rise gently' : 'Lower gently'}`;\n  else if (activity.kind === 'breath') status.textContent = Math.sin(activity.elapsed * Math.PI / 4) > 0 ? 'Breathe in · hold' : 'Breathe out · release';\n  else if (activity.kind === 'candle') status.textContent = `Flame ${Math.round(activity.flame * 100)}% · ${activity.flame < .15 ? 'settle to relight' : 'let it glow'}`;\n  else if (activity.kind === 'jog') status.textContent = `${activity.jogHits} steps · alternate J and K`;\n  else if (activity.kind === 'hoop') status.textContent = `${activity.hoopHits} catches · circle your lean`;\n  else status.textContent = activity.stun > 0 ? 'A wobble! Take a moment.' : 'Find the ring. Breathe naturally.';\n  progress.style.width = `${clamp(activity.elapsed / activity.seconds * 100, 0, 100)}%`;\n  dot.style.transform = `translate(${activity.px * 70}px, ${activity.py * 70}px)`;\n  ring.style.transform = `translate(${activity.ringX * 70}px, ${activity.ringY * 70}px)`;\n  score.textContent = `${Math.round(activity.score / Math.max(1, activity.samples) * 100)}% STEADY`;\n}\nfunction updateCheckHUD() {\n  if (!state.check) return;\n  const timer = document.getElementById('check-timer'), text = document.getElementById('check-text'), progress = document.getElementById('check-progress');\n  if (!timer) return;\n  if (!timer) return;\n  timer.textContent = state.check.phase === 'still' ? String(Math.max(0, Math.ceil(5 - state.check.elapsed))).padStart(2, '0') : `${state.check.directions.size}/4`;\n  text.textContent = state.check.phase === 'still' ? 'Find a comfortable center.' : 'Lean left, up, right and down.';\n  progress.style.width = `${state.check.phase === 'still' ? clamp(state.check.elapsed / 5 * 50, 0, 50) : 50 + state.check.directions.size * 12.5}%`;\n}\nfunction update(dt) {\n  state.clock += dt;\n  if (state.screen === 'title') { state.idle += dt; if (state.idle >= 10 && !state.hub.active) screen('attract'); }\n  if (state.screen === 'check') { state.check.elapsed += dt; if (state.check.phase === 'still' && state.check.elapsed >= 5) { state.check.phase = 'lean'; state.check.elapsed = 0; } if (state.check.phase === 'lean' && (state.check.directions.size === 4 || state.check.elapsed >= 14)) screen('question'); }\n  if (state.screen === 'play') updateActivity(dt);\n}\nfunction action(name, id) {\n  unlockAudio(); state.idle = 0; tone(440, .07, .2);\n  switch (name) {\n    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n    case 'slots': screen('slots'); break;\n    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n    case 'outfit': state.member.outfit = Number(id); render(); break;\n    case 'instructor': state.member.instructor = id; render(); break;\n    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n    case 'check': beginCheck(); break;\n    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n    case 'island': state.classMode = false; screen('island'); break;\n    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n    case 'locked': notify('A new mat opens on a later day.'); break;\n    case 'start-activity': startActivity(state.selection); break;\n    case 'retry': startActivity(state.selection, { seconds: state.festival ? 30 : undefined }); break;\n    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n    case 'ending': screen('ending'); break;\n    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad' }, { name: 'Gertrude', type: 'Bot' }]; state.selection = state.selection || ACTIVITIES[0]; screen('class'); break;\n    case 'class-toggle': { const index = Number(id); if (index === 0) break; state.classPlayers[index] = state.classPlayers[index] ? null : { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot' }; render(); break; }\n    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection); break;\n    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n    case 'pause': pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); break;\n    case 'resume': screen(pausedFrom || 'play'); break;\n    case 'restart': startActivity(state.selection, { seconds: state.festival ? 30 : undefined }); break;\n    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n    case 'dev': screen('dev'); break;\n    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n    case 'about-back': screen(state.aboutReturn || 'title'); break;\n  }\n}\napp.addEventListener('click', event => { const target = event.target.closest('[data-action]'); if (target) action(target.dataset.action, target.dataset.id); });\napp.addEventListener('mouseover', event => { const target = event.target.closest('button'); if (target && state.input !== 'gamepad') target.focus({ preventScroll: true }); });\napp.addEventListener('input', event => { const key = event.target.dataset.tuning; if (key) { tuning[key] = Number(event.target.value); document.getElementById(`out-${key}`).value = tuning[key]; } });\nwindow.addEventListener('keydown', event => {\n  if (event.repeat && event.key !== ' ') return;\n  state.input = 'keyboard'; state.idle = 0; const key = event.key.toLowerCase();\n  if (state.screen === 'attract') { event.preventDefault(); screen('title'); return; }\n  if (event.target instanceof HTMLInputElement && event.target.type === 'text') { if (key === 'enter') { event.preventDefault(); action('create-member'); } return; }\n  if (['arrowup','arrowdown','arrowleft','arrowright',' '].includes(key)) event.preventDefault();\n  keys.add(key); unlockAudio();\n  if (state.screen === 'check' && state.check.phase === 'lean') { const mapping = { a:'left', arrowleft:'left', w:'up', arrowup:'up', d:'right', arrowright:'right', s:'down', arrowdown:'down' }; if (mapping[key]) state.check.directions.add(mapping[key]); return; }\n  if (state.screen === 'play') { if (key === 'escape') action('pause'); else attemptInput(key); return; }\n  if (key === 'escape' || key === 'backspace') { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (state.screen === 'dev') screen('pause'); else if (state.screen === 'activity') action('island'); else if (state.screen === 'slots' || state.screen === 'class') action('home'); return; }\n  if (key === 'arrowdown' || key === 's') focusMove(1); else if (key === 'arrowup' || key === 'w') focusMove(-1); else if ((key === 'enter' || key === ' ') && document.activeElement?.tagName !== 'BUTTON') { const buttons = currentButtons(); if (buttons.length) buttons[0].focus(); }\n});\nwindow.addEventListener('keyup', event => keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur', () => { keys.clear(); if (state.screen === 'play' && !state.hub.active) action('pause'); });\nwindow.addEventListener('mousemove', event => { if (state.screen !== 'play' || event.buttons === 0) return; state.input = 'mouse'; mouseLean = { x: clamp((event.clientX - innerWidth / 2) / (innerHeight * .33), -1, 1), y: clamp((event.clientY - innerHeight / 2) / (innerHeight * .33), -1, 1) }; });\nwindow.addEventListener('mousedown', event => { if (state.screen === 'play' && event.button === 0) keys.add(' '); });\nwindow.addEventListener('mouseup', () => keys.delete(' '));\nfunction pollGamepad() {\n  const pads = Array.from(navigator.getGamepads?.() || []);\n  for (const pad of pads) {\n    if (!pad) continue;\n    const previous = gamepadPrevious[pad.index] || [];\n    pad.buttons.forEach((item, index) => {\n      if (item.pressed && !previous[index]) {\n        state.input = 'gamepad'; state.idle = 0; unlockAudio();\n        if (state.screen === 'attract') screen('title');\n        else if (state.screen === 'play') { if (index === 9) action('pause'); else if (index === 4 || index === 5) attemptInput(index === 4 ? 'q' : 'e'); else if (index === 6 || index === 7) attemptInput(index === 6 ? 'j' : 'k'); }\n        else if (state.screen === 'check' && state.check.phase === 'lean') { if (index === 12) state.check.directions.add('up'); if (index === 13) state.check.directions.add('down'); if (index === 14) state.check.directions.add('left'); if (index === 15) state.check.directions.add('right'); }\n        else if (index === 0) { const selected = document.activeElement; if (selected?.tagName === 'BUTTON') selected.click(); else currentButtons()[0]?.focus(); }\n        else if (index === 1) { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (!state.hub.active) action('home'); }\n        else if (index === 12) focusMove(-1); else if (index === 13) focusMove(1);\n      }\n    });\n    if (state.screen === 'check' && state.check.phase === 'lean') { if (pad.axes[0] < -.45) state.check.directions.add('left'); if (pad.axes[0] > .45) state.check.directions.add('right'); if (pad.axes[1] < -.45) state.check.directions.add('up'); if (pad.axes[1] > .45) state.check.directions.add('down'); }\n    gamepadPrevious[pad.index] = pad.buttons.map(item => item.pressed);\n  }\n}\nconst simulation = new My3D2dge.Game({ headless: true, step: 1 / 120 });\nsimulation.start({ update, draw() {} });\nfunction frame(now) {\n  const dt = lastFrame ? Math.min(.1, (now - lastFrame) / 1000) : 0; lastFrame = now;\n  pollGamepad(); simulation.advance(dt); music(); drawWorld({ ...state, shirt: OUTFITS[person().outfit || 0] });\n  if (now - lastHud > 100) { if (state.screen === 'play') updateHUD(); if (state.screen === 'check') updateCheckHUD(); lastHud = now; }\n  requestAnimationFrame(frame);\n}\nwindow.__ZEN = {\n  state, action, startActivity, tuning,\n  advance(seconds) { simulation.advance(seconds); render(); },\n  snapshot() { return JSON.parse(JSON.stringify({ screen: state.screen, member: state.member, activity: state.activity && { id: state.activity.id, elapsed: state.activity.elapsed, px: state.activity.px, py: state.activity.py, score: state.activity.score, stumbles: state.activity.stumbles }, result: state.result, hub: state.hub, settings: state.settings })); }\n};\nrender(); requestAnimationFrame(frame);\n\nif (state.hub.active) {\n  screen('hub');\n  window.AIHub.on('start', () => { state.hub.started = true; state.hub.startedAt = window.AIHub.time(); startActivity(ACTIVITIES.find(activity => activity.id === 'stork'), { seconds: 60 }); });\n  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n  window.AIHub.on('time-up', () => { if (!state.hub.finished) { state.hub.finished = true; if (state.activity && state.screen === 'play') state.hub.score += state.activity.score / Math.max(1, state.activity.samples) * 1000; window.AIHub.result({ score: Math.round(state.hub.score) }); screen('hub'); } });\n  window.AIHub.on('end', () => { state.hub.finished = true; screen('hub'); });\n  window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }).then(() => window.AIHub.ready()).catch(() => notify('Unable to connect to the Hub.'));\n}\n","exit_code":0,"status":"completed"}}
