{"type":"item.started","item":{"id":"item_378","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,54p' src/game.js; sed -n '92,137p' src/game.js; sed -n '204,250p' src/game.js; sed -n '250,360p' src/game.js; sed -n '55,83p' src/art.js; sed -n '1,110p' vendor/mocap.js; cat src/extra.css | tail -n 8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_378","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,54p' src/game.js; sed -n '92,137p' src/game.js; sed -n '204,250p' src/game.js; sed -n '250,360p' src/game.js; sed -n '55,83p' src/art.js; sed -n '1,110p' vendor/mocap.js; cat src/extra.css | tail -n 8\"","aggregated_output":"'use strict';\n\nconst app = document.getElementById('app');\nconst STORAGE = 'wee-bit-of-zen-v1';\nconst DEFAULT_SETTINGS = { music: 10, sound: 10, voice: true, gentle: false, breathToggle: false, tips: true, glyphs: 'PlayStation' };\nlet stored;\ntry { stored = JSON.parse(localStorage.getItem(STORAGE) || '{}'); } catch (_) { stored = {}; }\nconst state = {\n  screen: 'title', clock: 0, idle: 0, input: 'keyboard', settings: { ...DEFAULT_SETTINGS, ...(stored.settings || {}) },\n  slots: Array.isArray(stored.slots) ? stored.slots : [null, null, null], slot: 0, member: null,\n  selection: null, activity: null, returnScreen: 'title', check: null, toast: '', classPlayers: [],\n  festival: false, festivalIndex: 0, hub: { active: !!window.AIHub?.active, started: false, finished: false, score: 0, lastSend: 0, lastProgress: 0, ghosts: {} }\n};\nwhile (state.slots.length < 3) state.slots.push(null);\nconst keys = new Set();\nlet mouseLean = null, lastFrame = 0, lastHud = 0, audioContext = null, nextMusic = 0, gamepadPrevious = [];\nlet toggledBreath = false, pausedFrom = null;\n\nfunction save() {\n  if (state.hub.active) return;\n  if (state.member) state.slots[state.slot] = state.member;\n  try { localStorage.setItem(STORAGE, JSON.stringify({ settings: state.settings, slots: state.slots })); } catch (_) { notify('Saving is unavailable in this browser.'); }\n}\nfunction notify(text) {\n  state.toast = text;\n  const node = document.getElementById('toast');\n  if (node) { node.textContent = text; node.hidden = false; }\n  setTimeout(() => { if (state.toast === text) { state.toast = ''; const toast = document.getElementById('toast'); if (toast) toast.hidden = true; } }, 3000);\n}\nfunction tone(frequency, duration = .14, volume = .5, type = 'sine') {\n  if (!audioContext || audioContext.state !== 'running' || !state.settings.sound) return;\n  const oscillator = audioContext.createOscillator(), gain = audioContext.createGain(), now = audioContext.currentTime;\n  oscillator.type = type; oscillator.frequency.setValueAtTime(frequency, now);\n  gain.gain.setValueAtTime(.0001, now); gain.gain.exponentialRampToValueAtTime(Math.max(.00011, state.settings.sound / 100 * volume * .18), now + .015); gain.gain.exponentialRampToValueAtTime(.0001, now + duration);\n  oscillator.connect(gain); gain.connect(audioContext.destination); oscillator.start(now); oscillator.stop(now + duration + .01);\n}\nfunction unlockAudio() {\n  try { if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)(); if (audioContext.state === 'suspended') audioContext.resume(); } catch (_) {}\n}\nfunction music() {\n  if (!audioContext || audioContext.state !== 'running' || !state.settings.music || state.clock < nextMusic) return;\n  nextMusic = state.clock + 1.25;\n  const notes = [261.63, 329.63, 392, 493.88, 392, 329.63, 293.66, 349.23];\n  const oscillator = audioContext.createOscillator(), gain = audioContext.createGain(), now = audioContext.currentTime;\n  oscillator.type = 'sine'; oscillator.frequency.value = notes[Math.floor(state.clock / 1.25) % notes.length];\n  gain.gain.setValueAtTime(.0001, now); gain.gain.exponentialRampToValueAtTime(Math.max(.00011, state.settings.music / 100 * .035), now + .08); gain.gain.exponentialRampToValueAtTime(.0001, now + 1.1);\n  oscillator.connect(gain); gain.connect(audioContext.destination); oscillator.start(now); oscillator.stop(now + 1.15);\n}\nfunction hint() { return state.input === 'gamepad' ? (state.settings.glyphs === 'Xbox' ? 'A SELECT  ·  B BACK' : '✕ SELECT  ·  ○ BACK') : '↑ ↓ CHOOSE  ·  ENTER SELECT  ·  ESC BACK'; }\nfunction button(label, action, primary = false, id = '', detail = '') {\n  return `<button class=\"action${primary ? ' primary' : ''}\" data-action=\"${action}\" data-id=\"${escapeHTML(id)}\"><span>${label}${detail ? `<small>${detail}</small>` : ''}</span><span class=\"arrow\">↗</span></button>`;\n}\nfunction shell(content, label = '', footer = true) {\n  return `<div class=\"page\"><header class=\"topbar\"><button class=\"brand\" data-action=\"home\" aria-label=\"Return to title\"><span class=\"brand-mark\">✳</span><span>WEE BIT <b>OF ZEN</b></span></button><span class=\"top-label\">${label}</span><button class=\"settings-link\" data-action=\"settings\" aria-label=\"Settings\">⚙ <span>SETTINGS</span></button></header>${content}${footer ? `<footer class=\"footer\"><span>${hint()}</span><span>THE INSTITUTE FOR GENTLE IMPROVEMENT&nbsp; ✳ &nbsp; LUMBAR ISLAND</span></footer>` : ''}</div><div class=\"toast\" id=\"toast\" hidden></div>`;\n  } else if (state.screen === 'island') {\n    heading = labelDay();\n    const dialogue = CAST[(member.day + member.sessions) % CAST.length];\n    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of movement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished ? 'ending' : 'sleep', true)}</div></div></main>`;\n  } else if (state.screen === 'activity') {\n    const activity = state.selection, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>How to play</h3><p>${activity.instruction}</p><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle mode is on.' : 'Make small, comfortable movements.'}</p><div class=\"actions\">${button('Back to island', state.classMode ? 'class' : 'island')}${button('Begin practice', 'start-activity', true)}</div></div></main>`;\n  } else if (state.screen === 'play') {\n    const activity = state.activity, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your center.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"play-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span id=\"play-progress\"></span></div><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE START</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\n  } else if (state.screen === 'result') {\n    const result = state.result;\n    heading = 'SESSION COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue result-card\"><div class=\"eyebrow\">✳ &nbsp; PRACTICE COMPLETE</div><div class=\"stars-big\">${'★'.repeat(result.stars)}<span>${'☆'.repeat(3 - result.stars)}</span></div><h1>Lovely work${state.classMode ? ', everyone' : ''}.</h1><p>“${result.message}”</p><div class=\"result-stats\"><div><strong>${result.percent}%</strong><small>STEADINESS</small></div><div><strong>+${result.minutes}</strong><small>FIT MINUTES</small></div><div><strong>${result.stumbles}</strong><small>WOBBLES</small></div></div><div class=\"actions\">${button('Practice again', 'retry')}${button(state.festival ? 'Continue the Games' : state.classMode ? 'Class results' : 'Back to island', 'result-continue', true)}</div></div></main>`;\n  } else if (state.screen === 'recap') {\n    heading = 'DAY COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ANOTHER DAY WELL SPENT</div><h1>Rest is part of it.</h1><p>“${member.sessions} sessions today. Gerald the ceramic hippo has made a careful note.”</p><div class=\"result-stats\"><div><strong>${Math.floor(member.minutes)}</strong><small>FIT MINUTES</small></div><div><strong>${Object.keys(member.stars || {}).length}</strong><small>MATS VISITED</small></div></div><div class=\"actions\">${button('Wake up to day ' + (member.day + 1), 'next-day', true)}</div></div></main>`;\n  } else if (state.screen === 'festival') {\n    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Three friendly challenges, ending in the Grand Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"actions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n  } else if (state.screen === 'ending') {\n    heading = 'THANK YOU FOR STAYING';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little steadier.<br><em>A lot more you.</em></h1><p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for five days of moving, breathing, and making room. The mats are yours whenever you wish.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits', 'about')}</div></div></main>`;\n  } else if (state.screen === 'class') {\n    heading = 'LOCAL CLASS';\n    const players = state.classPlayers;\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect controllers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHTML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ? 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selection?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.name === 'Guest' ? 'home' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n  } else if (state.screen === 'class-result') {\n    heading = 'LOCAL CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\n  } else if (state.screen === 'settings') {\n    heading = 'SETTINGS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card settings-card\">${settingRow('Music', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${settingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.tips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n  } else if (state.screen === 'pause') {\n    heading = 'PAUSED';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', true)}${button('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', 'leave-play')}</div></div></main>`;\n  } else if (state.screen === 'dev') {\n    heading = 'DEVELOPER MODE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the wobble.</h1>${[['spring','Spring',4,20,.5],['damping','Damping',1,12,.5],['instability','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output id=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"actions\">${button('Reset tuning', 'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n  } else if (state.screen === 'about') {\n    heading = 'ABOUT & CREDITS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card scroll\"><div class=\"eyebrow\">✳ &nbsp; A LITTLE NOTE FROM THE MAKERS</div><h1>About & credits.</h1><p>Made with care for everyone who has ever wobbled.</p>${aboutContent()}<div class=\"actions\">${button('Back', 'about-back', true)}</div></div></main>`;\n  } else if (state.screen === 'hub') {\n    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A little steadiness, shared.'}</h1><p>${state.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; everyone gets a moment to breathe.'}</p><div class=\"result-stats\"><div><strong>${Math.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.started ? 'The class is underway.' : 'Waiting for the other guests…'}</p></div></main>`;\n  }\n  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n  let quality = steadiness;\n  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n  activity.score += quality; activity.samples++;\n  if (state.classMode && !state.hub.active) updateClass(dt);\n  if (state.hub.active) {\n    const now = window.AIHub.time();\n    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n  }\n  if (!state.hub.active && activity.elapsed >= activity.seconds) completeActivity();\n}\nfunction updateHUD() {\n  const activity = state.activity; if (!activity) return;\n  const timer = document.getElementById('play-timer'), status = document.getElementById('play-status'), instruction = document.getElementById('play-instruction'), progress = document.getElementById('play-progress'), dot = document.getElementById('plate-dot'), ring = document.getElementById('plate-ring'), score = document.getElementById('play-score');\n  if (!timer) return;\n  timer.textContent = Math.max(0, Math.ceil(activity.seconds - activity.elapsed));\n  if (activity.kind === 'step') { const arrows = ['←','↑','→','↓']; const beat = Math.round(activity.elapsed * 100 / 60); status.textContent = `NEXT STEP  ${arrows[(beat + 4) % 4]}   ·   ${activity.beatHits} on beat`; instruction.textContent = `Press ${arrows[(beat + 4) % 4]} on the beat · ${activity.instruction}`; }\n  else if (activity.kind === 'rep') status.textContent = `Rep ${activity.reps + 1} · ${Math.sin(activity.elapsed * Math.PI / 2 - Math.PI / 2) > 0 ? 'Rise gently' : 'Lower gently'}`;\n  else if (activity.kind === 'breath') status.textContent = Math.sin(activity.elapsed * Math.PI / 4) > 0 ? 'Breathe in · hold' : 'Breathe out · release';\n  else if (activity.kind === 'candle') status.textContent = `Flame ${Math.round(activity.flame * 100)}% · ${activity.flame < .15 ? 'settle to relight' : 'let it glow'}`;\n  else if (activity.kind === 'jog') status.textContent = `${activity.jogHits} steps · alternate J and K`;\n  else if (activity.kind === 'hoop') status.textContent = `${activity.hoopHits} catches · circle your lean`;\n  else status.textContent = activity.stun > 0 ? 'A wobble! Take a moment.' : 'Find the ring. Breathe naturally.';\n  progress.style.width = `${clamp(activity.elapsed / activity.seconds * 100, 0, 100)}%`;\n  dot.style.transform = `translate(${activity.px * 70}px, ${activity.py * 70}px)`;\n  ring.style.transform = `translate(${activity.ringX * 70}px, ${activity.ringY * 70}px)`;\n  score.textContent = `${Math.round(activity.score / Math.max(1, activity.samples) * 100)}% STEADY`;\n}\nfunction updateCheckHUD() {\n  if (!state.check) return;\n  const timer = document.getElementById('check-timer'), text = document.getElementById('check-text'), progress = document.getElementById('check-progress');\n  if (!timer) return;\n  timer.textContent = state.check.phase === 'still' ? String(Math.max(0, Math.ceil(5 - state.check.elapsed))).padStart(2, '0') : `${state.check.directions.size}/4`;\n  text.textContent = state.check.phase === 'still' ? 'Find a comfortable center.' : 'Lean left, up, right and down.';\n  text.textContent = state.check.phase === 'still' ? 'Find a comfortable center.' : 'Lean left, up, right and down.';\n  progress.style.width = `${state.check.phase === 'still' ? clamp(state.check.elapsed / 5 * 50, 0, 50) : 50 + state.check.directions.size * 12.5}%`;\n}\nfunction update(dt) {\n  state.clock += dt;\n  if (state.screen === 'title') { state.idle += dt; if (state.idle >= 10 && !state.hub.active) screen('attract'); }\n  if (state.screen === 'check') { state.check.elapsed += dt; if (state.check.phase === 'still' && state.check.elapsed >= 5) { state.check.phase = 'lean'; state.check.elapsed = 0; } if (state.check.phase === 'lean' && (state.check.directions.size === 4 || state.check.elapsed >= 14)) screen('question'); }\n  if (state.screen === 'play') updateActivity(dt);\n}\nfunction action(name, id) {\n  unlockAudio(); state.idle = 0; tone(440, .07, .2);\n  switch (name) {\n    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n    case 'slots': screen('slots'); break;\n    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n    case 'outfit': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.outfit = Number(id); render(); break;\n    case 'instructor': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.instructor = id; render(); break;\n    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n    case 'check': beginCheck(); break;\n    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n    case 'island': state.classMode = false; screen('island'); break;\n    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n    case 'locked': notify('A new mat opens on a later day.'); break;\n    case 'start-activity': startActivity(state.selection); break;\n    case 'retry': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n    case 'ending': screen('ending'); break;\n    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad', source: 'primary' }, { name: 'Gertrude', type: 'Bot', source: 'bot' }]; if (!CLASS_IDS.includes(state.selection?.id)) state.selection = ACTIVITIES[0]; screen('class'); break;\n    case 'class-toggle': { const index = Number(id); if (index === 0) break; const current = state.classPlayers[index]; state.classPlayers[index] = !current ? { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot', source: 'bot' } : index === 1 && current.source === 'bot' ? { name: 'Player 2', type: 'Keyboard 2', source: 'keyboard' } : null; render(); break; }\n    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection, { seconds: 35 }); break;\n    case 'hub-ready': window.AIHub.answer('ready'); notify('Ready to go!'); break;\n    case 'hub-more': window.AIHub.answer('more'); notify('Waiting for more players.'); break;\n    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n    case 'pause': pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); break;\n    case 'resume': screen(pausedFrom || 'play'); break;\n    case 'restart': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n    case 'dev': screen('dev'); break;\n    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n    case 'about-back': screen(state.aboutReturn || 'title'); break;\n  }\n}\napp.addEventListener('click', event => { const target = event.target.closest('[data-action]'); if (target) action(target.dataset.action, target.dataset.id); });\napp.addEventListener('mouseover', event => { const target = event.target.closest('button'); if (target && state.input !== 'gamepad') target.focus({ preventScroll: true }); });\napp.addEventListener('input', event => { const key = event.target.dataset.tuning; if (key) { tuning[key] = Number(event.target.value); document.getElementById(`out-${key}`).value = tuning[key]; } });\nwindow.addEventListener('keydown', event => {\n  if (event.repeat && event.key !== ' ') return;\n  state.input = 'keyboard'; state.idle = 0; const key = event.key.toLowerCase();\n  if (state.screen === 'attract') { event.preventDefault(); screen('title'); return; }\n  if (event.target instanceof HTMLInputElement && event.target.type === 'text') { if (key === 'enter') { event.preventDefault(); action('create-member'); } return; }\n  if (['arrowup','arrowdown','arrowleft','arrowright',' '].includes(key)) event.preventDefault();\n  keys.add(key); unlockAudio();\n  if (state.screen === 'check' && state.check.phase === 'lean') { const mapping = { a:'left', arrowleft:'left', w:'up', arrowup:'up', d:'right', arrowright:'right', s:'down', arrowdown:'down' }; if (mapping[key]) state.check.directions.add(mapping[key]); return; }\n  if (state.screen === 'play') { if (key === 'escape') action('pause'); else attemptInput(key); return; }\n  if (key === 'escape' || key === 'backspace') { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (state.screen === 'dev') screen('pause'); else if (state.screen === 'activity') action('island'); else if (state.screen === 'slots' || state.screen === 'class') action('home'); return; }\n  if (key === 'arrowdown' || key === 's') focusMove(1); else if (key === 'arrowup' || key === 'w') focusMove(-1); else if ((key === 'enter' || key === ' ') && document.activeElement?.tagName !== 'BUTTON') { const buttons = currentButtons(); if (buttons.length) buttons[0].focus(); }\n});\nwindow.addEventListener('keyup', event => keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur', () => { keys.clear(); if (state.screen === 'play' && !state.hub.active) action('pause'); });\nwindow.addEventListener('mousemove', event => { if (state.screen !== 'play' || event.buttons === 0) return; state.input = 'mouse'; mouseLean = { x: clamp((event.clientX - innerWidth / 2) / (innerHeight * .33), -1, 1), y: clamp((event.clientY - innerHeight / 2) / (innerHeight * .33), -1, 1) }; });\nwindow.addEventListener('mousedown', event => { if (state.screen === 'play' && event.button === 0) keys.add(' '); });\nwindow.addEventListener('mouseup', () => keys.delete(' '));\nfunction pollGamepad() {\n  const pads = Array.from(navigator.getGamepads?.() || []);\n  for (const pad of pads) {\n    if (!pad) continue;\n    const previous = gamepadPrevious[pad.index] || [];\n    pad.buttons.forEach((item, index) => {\n      if (item.pressed && !previous[index]) {\n        state.input = 'gamepad'; state.idle = 0; unlockAudio();\n        if (state.screen === 'attract') screen('title');\n        else if (state.screen === 'play') { if (index === 9) action('pause'); else if (index === 4 || index === 5) attemptInput(index === 4 ? 'q' : 'e'); else if (index === 6 || index === 7) attemptInput(index === 6 ? 'j' : 'k'); }\n        else if (state.screen === 'check' && state.check.phase === 'lean') { if (index === 12) state.check.directions.add('up'); if (index === 13) state.check.directions.add('down'); if (index === 14) state.check.directions.add('left'); if (index === 15) state.check.directions.add('right'); }\n        else if (index === 0) { const selected = document.activeElement; if (selected?.tagName === 'BUTTON') selected.click(); else currentButtons()[0]?.focus(); }\n        else if (index === 1) { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (!state.hub.active) action('home'); }\n        else if (index === 12) focusMove(-1); else if (index === 13) focusMove(1);\n      }\n    });\n    if (state.screen === 'check' && state.check.phase === 'lean') { if (pad.axes[0] < -.45) state.check.directions.add('left'); if (pad.axes[0] > .45) state.check.directions.add('right'); if (pad.axes[1] < -.45) state.check.directions.add('up'); if (pad.axes[1] > .45) state.check.directions.add('down'); }\n    gamepadPrevious[pad.index] = pad.buttons.map(item => item.pressed);\n  }\n}\nconst simulation = new My3D2dge.Game({ headless: true, step: 1 / 120 });\nsimulation.start({ update, draw() {} });\nfunction frame(now) {\n  const dt = lastFrame ? Math.min(.1, (now - lastFrame) / 1000) : 0; lastFrame = now;\n  pollGamepad(); simulation.advance(dt); music(); drawWorld({ ...state, shirt: OUTFITS[person().outfit || 0] });\n  if (now - lastHud > 100) { if (state.screen === 'play') updateHUD(); if (state.screen === 'check') updateCheckHUD(); lastHud = now; }\n  requestAnimationFrame(frame);\n}\nwindow.__ZEN = {\n  state, action, startActivity, tuning,\n  advance(seconds) { simulation.advance(seconds); render(); },\n  snapshot() { return JSON.parse(JSON.stringify({ screen: state.screen, member: state.member, activity: state.activity && { id: state.activity.id, elapsed: state.activity.elapsed, px: state.activity.px, py: state.activity.py, score: state.activity.score, stumbles: state.activity.stumbles }, result: state.result, hub: state.hub, settings: state.settings })); }\n};\nrender(); requestAnimationFrame(frame);\n\nif (state.hub.active) {\n  screen('hub');\n  window.AIHub.on('start', () => { state.hub.started = true; state.hub.startedAt = window.AIHub.time(); startActivity(ACTIVITIES.find(activity => activity.id === 'stork'), { seconds: 60 }); });\n  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n  ellipse(x - size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n  ellipse(x + size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n  context.strokeStyle = '#416b60'; context.lineWidth = Math.max(1, size * .015); context.beginPath();\n  context.arc(x, y - size * .2, size * .045, .2, Math.PI - .2); context.stroke();\n  if (mood) { context.fillStyle = '#e6ad65'; context.font = `bold ${size * .2}px sans-serif`; context.fillText('✦', x + size * .57, y - size * .46); }\n}\nfunction drawPerson(x, ground, size, options = {}) {\n  const sway = (options.lean || 0) * size * .13 + Math.sin((options.time || 0) * 1.3) * size * .008;\n  const movement = options.movement || 0;\n  const skin = options.skin || '#e8b69b';\n  const shirt = options.shirt || '#f1c86c';\n  const trousers = options.trousers || '#527d75';\n  ellipse(x, ground + size * .035, size * .39, size * .065, 'rgba(56,95,80,.13)');\n  line(x - size * .1, ground - size * .31, x - size * (.16 + movement * .08), ground - size * .03, size * .105, trousers);\n  line(x + size * .1, ground - size * .31, x + size * (.16 - movement * .08), ground - size * .03, size * .105, trousers);\n  line(x - size * (.16 + movement * .08), ground - size * .03, x - size * (.23 + movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n  line(x + size * (.16 - movement * .08), ground - size * .03, x + size * (.23 - movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n  line(x - size * .13 + sway, ground - size * .6, x - size * .35 + sway, ground - size * (.49 + Math.abs(movement) * .12), size * .08, skin);\n  line(x + size * .13 + sway, ground - size * .6, x + size * .35 + sway, ground - size * (.49 - Math.abs(movement) * .12), size * .08, skin);\n  rounded(x - size * .19 + sway, ground - size * .68, size * .38, size * .4, size * .12, shirt);\n  line(x + sway, ground - size * .71, x + sway, ground - size * .65, size * .105, skin);\n  ellipse(x + sway, ground - size * .85, size * .19, size * .22, skin);\n  ellipse(x + sway, ground - size * .99, size * .19, size * .105, '#52655a');\n  ellipse(x - size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n  ellipse(x + size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n  context.strokeStyle = '#a56d61'; context.lineWidth = Math.max(1, size * .012); context.beginPath();\n  context.arc(x + sway, ground - size * .81, size * .045, .1, Math.PI - .1); context.stroke();\n}\nfunction drawScenery(time) {\n/* =============================================================================\n * MOCAP  plays animation sets in the readable format (src/mocap/readable.js; written by tools/anim-import.mjs) on\n * my-3D2dge rigs.\n *   const lib = Mocap.load(window.MOCAP.QUATERNIUS);   // a set: its clips, and the bodies they were measured on\n *   const clip = lib.clip('Dance_Loop');               // { name, dur, loop, tags, desc, keys }\n *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n *   const man = new Mocap.Mannequin(lib, { height: 34 });  man.draw(g, ox, oy, view, pose, facing)\n *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n *     window.Mocap.)\n *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n *     only the chest, head and arms over the rig's own legs (an interaction while walking); humanoid.mocapBlade = true\n *     while the clip holds a sword (the blade follows the fist).\n * Points are in the rig's local frame: f = forward, r = right, z = up, centred on the root on the ground.\n * ============================================================================= */\nconst Mocap = (() => {\n'use strict';\nconst E = My3D2dge, { px } = E, MR = MocapReadable;\n\n/* ---- sets ---- */\n/**\n * Every clip is rebuilt on the first library's proportions (the format does not depend on size); each keeps how its own\n * library bends the spine, since the key poses were measured that way.\n */\nfunction load(set) {\n  const P = MR.P, idx = MR.IDX, ids = Object.keys(set.sources), base = set.sources[ids[0]].rest, rests = {};\n  for (const id of ids) rests[id] = Object.assign({}, base, { spineW: set.sources[id].rest.spineW, neckW: set.sources[id].rest.neckW });\n  const meta = c => ({ name: c.clip, fps: set.fps, n: Math.round(c.dur * set.fps) + 1 }), clips = {};\n  for (const [name, c] of Object.entries(set.clips)) clips[name] = Object.assign(meta(Object.assign({ clip: name }, c)), c);\n  const restOf = c => rests[c.src] || base;\n  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n  lib.clip = name => clips[name] || null;\n  /** the pose at time t (seconds): key poses in-betweened, loops wrap, one-shots hold their last pose */\n  lib.sample = (clip, t, out = new Float32Array(P * 3)) => { MR.pose(restOf(clip), clip, t, out); out.src = clip.src; return out; };   // (src: whose rest it is measured against)\n  /** a clip that travels: how far it has carried the body at time t ([forward, right] mm), or null */\n  lib.moveAt = (clip, t) => MR.moveAt(restOf(clip), clip, t);\n  /** swap in an edited clip (readable text a person or a model changed); the original is kept for restore() */\n  const originals = {};\n  lib.replace = (name, edited) => { if (!originals[name]) originals[name] = clips[name]; clips[name] = Object.assign({}, originals[name], edited, { name, keys: edited.keys }); return clips[name]; };\n  lib.restore = name => { if (originals[name]) { clips[name] = originals[name]; delete originals[name]; } return clips[name]; };\n  lib.edited = name => !!originals[name];\n  /** the clip as the text a model reads (its header and its key poses) */\n  lib.text = clip => { const o = { clip: clip.clip || clip.name }; for (const k of ['src', 'take', 'orig', 'dur', 'loop', 'tags', 'desc']) if (clip[k] !== undefined) o[k] = clip[k]; o.keys = clip.keys; return MR.text(o); };\n  /** where a clip came from: its library's label, origin and license (from the set's sources), the clip it was made from,\n   *  and (a capture database's) the take and the stretch of it: '13_29 2.30-3.42' */\n  lib.origin = clip => { const s = set.sources[clip.src] || {}; return { src: clip.src, label: s.label || clip.src, origin: s.origin || '', license: s.license || '', url: s.url || '', orig: clip.orig || null, take: clip.take || null }; };\n  /** a pose blended from a to b (crossfades between clips) */\n  lib.blend = (a, b, k, out = new Float32Array(P * 3)) => { for (let i = 0; i < P * 3; i++) out[i] = a[i] + (b[i] - a[i]) * k; out.src = (k < .5 ? a : b).src; return out; };\n  lib.pt = (pose, name) => { const i = idx[name] * 3; return [pose[i], pose[i + 1], pose[i + 2]]; };\n  lib.error = MR.error;\n  return lib;\n}\n\n/* ---- the look-alike mannequin: shaded capsules in the source model's proportions, with its joint bands ---- */\nconst lerp3 = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\nconst add3 = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];\nconst sub3 = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\nconst norm3 = a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\nclass Mannequin {\n  /** o: { height: world units tall (34), main: '#e8aa3a', joint: '#aa66db' } (the colors of the source model's two materials) */\n  constructor(lib, o = {}) {\n    this.lib = lib; this.o = Object.assign({ height: 34, main: '#e8aa3a', joint: '#aa66db' }, o);\n    this.k = this.o.height / ((lib.body && lib.body.height) || 1829);   // world units per mm\n    this._ops = [];\n  }\n  /**\n   * draw the pose into g with (ox, oy) = the projected root. Every part is a capsule between two body points,\n   * sorted by true camera depth, drawn dark-then-lit like the engine's HD rigs.\n   */\n  draw(g, ox, oy, view, pose, facing = 0) {\n    const L = this.lib, o = this.o, k = this.k, ca = Math.cos(facing), sa = Math.sin(facing), sc = view.scale;\n    const pt = name => L.pt(pose, name);\n    const S = p => { const wx = (p[0] * ca - p[1] * sa) * k, wy = (p[0] * sa + p[1] * ca) * k, wz = p[2] * k; return [ox + view.ax * wx + view.ay * wy, oy + view.bx * wx + view.by * wy + view.bz * wz, view.dx * wx + view.dy * wy + view.dz * wz]; };\n    const R = mm => mm * k * sc;   // a radius in mm -> screen pixels\n    const ops = this._ops; ops.length = 0;\n    const main = E.tones(o.main), joint = E.tones(o.joint);\n    // centre depth of the body: parts behind it are drawn a touch darker (the far arm and leg)\n    const mid = S(pt('spine1'))[2];\n    const capsule = (A, B, ra, rb, col, dx = 0, dy = 0) => {\n      const ax = A[0] + dx, ay = A[1] + dy, bx = B[0] + dx, by = B[1] + dy, vx = bx - ax, vy = by - ay, l = Math.hypot(vx, vy);\n      if (l > .01) { const nx = -vy / l, ny = vx / l; px.poly(g, [[ax + nx * ra, ay + ny * ra], [bx + nx * rb, by + ny * rb], [bx - nx * rb, by - ny * rb], [ax - nx * ra, ay - ny * ra]], col); }\n      px.disc(g, ax, ay, Math.max(.5, ra - .3), col); px.disc(g, bx, by, Math.max(.5, rb - .3), col);\n    };\n    // a shaded part: dark silhouette, the base color shifted toward the light (upper left), a soft highlight\n    const part = (a, b, ra, rb, T, bias = 0) => {\n      const A = S(a), B = S(b), pa = R(ra), pb = R(rb), far = (A[2] + B[2]) * .5 < mid - 2 * k * 60;\n      ops.push({ d: (A[2] + B[2]) * .5 + bias, f: () => {\n        capsule(A, B, pa, pb, far ? T.deep : T.sh);\n        capsule(A, B, Math.max(.5, pa - .9), Math.max(.5, pb - .9), far ? T.sh : T.base, -.5, -.6);\n        if (pa > 2.2 && !far) capsule(A, B, pa * .32, pb * .32, T.lt, -pa * .38, -pa * .42);\n      } });\n    };\n    // a ring painted round a limb (the second material): a straight-edged stripe across the capsule, no round ends,\n    // so a thin band reads as a band from every side. Seen end-on (the limb points at the camera) it is hidden.\n    const band = (a, b, t0, t1, ra, rb, T) => {\n      const A = S(lerp3(a, b, t0)), B = S(lerp3(a, b, t1)), axis = S(a), end = S(b), vx = end[0] - axis[0], vy = end[1] - axis[1], l = Math.hypot(vx, vy);\n      if (l < R(Math.max(ra, rb)) * .5) return;\n      const nx = -vy / l, ny = vx / l, wa = R(ra + (rb - ra) * t0) + .2, wb = R(ra + (rb - ra) * t1) + .2;\n      ops.push({ d: (axis[2] + end[2]) * .5 + .02, f: () => {\n        const q = (w0, w1, dx, dy) => [[A[0] + nx * w0 + dx, A[1] + ny * w0 + dy], [B[0] + nx * w1 + dx, B[1] + ny * w1 + dy], [B[0] - nx * w1 + dx, B[1] - ny * w1 + dy], [A[0] - nx * w0 + dx, A[1] - ny * w0 + dy]];\n        px.poly(g, q(wa, wb, 0, 0), T.sh); px.poly(g, q(Math.max(.5, wa - .9), Math.max(.5, wb - .9), -.5, -.6), T.base);\n      } });\n    };\n\n    const pelvis = pt('pelvis'), sp1 = pt('spine1'), sp2 = pt('spine2'), chest = pt('chest'), neck = pt('neck'), head = pt('head'), top = pt('headTop'), face = pt('faceF'), chestF = pt('chestF');\n    const fwdC = norm3(sub3(chestF, chest)), fwdH = norm3(sub3(face, head));\n    // legs: thigh, shin, foot (heel to ball), toes; purple at the hip, knee and ankle\n    for (const s of ['L', 'R']) {\n      const hip = pt('hip' + s), knee = pt('knee' + s), ank = pt('ankle' + s), b = pt('ball' + s), toe = pt('toe' + s);\n      const heel = add3(lerp3(ank, b, -.28), [0, 0, -1], 45);\n      part(hip, knee, 80, 60, main); band(hip, knee, .02, .1, 80, 62, joint);\n.balance-plate{position:absolute;left:50%;bottom:20%;width:clamp(94px,13vw,160px);aspect-ratio:1;transform:translateX(-50%);border:2px solid #719f98;border-radius:50%;background:#ecfaf2cf;box-shadow:0 8px 24px #4d85732b;pointer-events:none}.plate-ring{position:absolute;inset:20%;border:2px dashed #8db9a4;border-radius:50%}.plate-dot{position:absolute;left:50%;top:50%;width:17px;height:17px;transform:translate(-50%,-50%);border:3px solid white;border-radius:50%;background:#e5785c;box-shadow:0 2px 6px #416e5e88}\n.brand,.settings-link{border:0;background:transparent;padding:0;cursor:pointer}\n.settings-link{display:flex;align-items:center;gap:8px;color:#527b70;font:800 11px/1 sans-serif;letter-spacing:.12em}\n.action small{display:block;margin-top:5px;font-size:11px;font-weight:600;letter-spacing:0;opacity:.72}\n.island-message span,.island-message strong{display:block}\n.island-message strong{margin-top:5px;font-size:18px;line-height:1.2}\n.class-live{position:absolute;left:18px;bottom:18px;z-index:3;display:flex;flex-wrap:wrap;gap:6px;max-width:calc(100% - 36px)}\n.class-live span{padding:7px 10px;border-radius:12px;background:#fffef0e8;color:#315d50;font-size:12px;font-weight:800;box-shadow:0 2px 10px #345a4b18}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_379","type":"reasoning","text":"**Extracting small sections**"}}
{"type":"item.started","item":{"id":"item_380","type":"command_execution","command":"/bin/bash -lc \"sed -n '108,132p' src/game.js; sed -n '191,240p' src/game.js; sed -n '245,335p' src/game.js; sed -n '55,82p' src/art.js; rg -n 'Mocap|function load|function pt|sample\\\\(' vendor/mocap.js | tail -n 20; rg -n 'probe|time-up|rng\\\\(' vendor/session.js | head -n 25\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_380","type":"command_execution","command":"/bin/bash -lc \"sed -n '108,132p' src/game.js; sed -n '191,240p' src/game.js; sed -n '245,335p' src/game.js; sed -n '55,82p' src/art.js; rg -n 'Mocap|function load|function pt|sample\\\\(' vendor/mocap.js | tail -n 20; rg -n 'probe|time-up|rng\\\\(' vendor/session.js | head -n 25\"","aggregated_output":"    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ANOTHER DAY WELL SPENT</div><h1>Rest is part of it.</h1><p>“${member.sessions} sessions today. Gerald the ceramic hippo has made a careful note.”</p><div class=\"result-stats\"><div><strong>${Math.floor(member.minutes)}</strong><small>FIT MINUTES</small></div><div><strong>${Object.keys(member.stars || {}).length}</strong><small>MATS VISITED</small></div></div><div class=\"actions\">${button('Wake up to day ' + (member.day + 1), 'next-day', true)}</div></div></main>`;\n  } else if (state.screen === 'festival') {\n    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Three friendly challenges, ending in the Grand Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"actions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n  } else if (state.screen === 'ending') {\n    heading = 'THANK YOU FOR STAYING';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little steadier.<br><em>A lot more you.</em></h1><p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for five days of moving, breathing, and making room. The mats are yours whenever you wish.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits', 'about')}</div></div></main>`;\n  } else if (state.screen === 'class') {\n    heading = 'LOCAL CLASS';\n    const players = state.classPlayers;\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect controllers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHTML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ? 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selection?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.name === 'Guest' ? 'home' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n  } else if (state.screen === 'class-result') {\n    heading = 'LOCAL CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\n  } else if (state.screen === 'settings') {\n    heading = 'SETTINGS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card settings-card\">${settingRow('Music', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${settingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.tips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n  } else if (state.screen === 'pause') {\n    heading = 'PAUSED';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', true)}${button('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', 'leave-play')}</div></div></main>`;\n  } else if (state.screen === 'dev') {\n    heading = 'DEVELOPER MODE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the wobble.</h1>${[['spring','Spring',4,20,.5],['damping','Damping',1,12,.5],['instability','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output id=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"actions\">${button('Reset tuning', 'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n  } else if (state.screen === 'about') {\n    heading = 'ABOUT & CREDITS';\n  const dy = (keys.has('arrowdown') || keys.has('s') ? 1 : 0) - (keys.has('arrowup') || keys.has('w') ? 1 : 0);\n  if (activity.stun <= 0) {\n    if (mouseLean) { activity.ux = mouseLean.x; activity.uy = mouseLean.y; }\n    else if (axisX || axisY) { activity.ux = axisX; activity.uy = axisY; }\n    else { activity.ux = clamp(activity.ux + dx * 2.2 * dt, -1, 1); activity.uy = clamp(activity.uy + dy * 2.2 * dt, -1, 1); if (!dx) activity.ux *= Math.max(0, 1 - .5 * dt); if (!dy) activity.uy *= Math.max(0, 1 - .5 * dt); }\n  } else activity.stun -= dt;\n  const gentle = state.settings.gentle ? .7 : 1, time = activity.elapsed, disturbance = tuning.noise * gentle;\n  const ax = tuning.spring * (activity.ux - activity.px) - tuning.damping * activity.vx + tuning.instability * gentle * activity.px + disturbance * (Math.sin(time * 1.7) + .5 * Math.sin(time * 3.23));\n  const ay = tuning.spring * (activity.uy - activity.py) - tuning.damping * activity.vy + tuning.instability * gentle * activity.py + disturbance * (Math.sin(time * 1.19 + 1) + .5 * Math.sin(time * 2.71));\n  activity.vx += ax * dt; activity.vy += ay * dt; activity.px += activity.vx * dt; activity.py += activity.vy * dt;\n  if (Math.hypot(activity.px, activity.py) >= 1 && activity.stun <= 0) { activity.stumbles++; activity.stun = 1; activity.px *= .5; activity.py *= .5; activity.vx *= -.2; activity.vy *= -.2; tone(196, .18); }\n  const phase = Math.floor(time / 12), rng = seeded(phase * 667 + 43);\n  activity.ringX = activity.id === 'stork' ? (rng() - .5) * .65 : activity.kind === 'slalom' ? Math.sin(time * .55) * .46 : 0;\n  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n  let quality = steadiness;\n  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n  activity.score += quality; activity.samples++;\n  if (state.classMode && !state.hub.active) updateClass(dt);\n  if (state.hub.active) {\n    const now = window.AIHub.time();\n    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n  }\n  if (!state.hub.active && activity.elapsed >= activity.seconds) completeActivity();\n}\nfunction updateHUD() {\n  const activity = state.activity; if (!activity) return;\n  const timer = document.getElementById('play-timer'), status = document.getElementById('play-status'), instruction = document.getElementById('play-instruction'), progress = document.getElementById('play-progress'), dot = document.getElementById('plate-dot'), ring = document.getElementById('plate-ring'), score = document.getElementById('play-score');\n  if (!timer) return;\n  timer.textContent = Math.max(0, Math.ceil(activity.seconds - activity.elapsed));\n  if (activity.kind === 'step') { const arrows = ['←','↑','→','↓']; const beat = Math.round(activity.elapsed * 100 / 60); status.textContent = `NEXT STEP  ${arrows[(beat + 4) % 4]}   ·   ${activity.beatHits} on beat`; instruction.textContent = `Press ${arrows[(beat + 4) % 4]} on the beat · ${activity.instruction}`; }\n  else if (activity.kind === 'rep') status.textContent = `Rep ${activity.reps + 1} · ${Math.sin(activity.elapsed * Math.PI / 2 - Math.PI / 2) > 0 ? 'Rise gently' : 'Lower gently'}`;\n  else if (activity.kind === 'breath') status.textContent = Math.sin(activity.elapsed * Math.PI / 4) > 0 ? 'Breathe in · hold' : 'Breathe out · release';\n  else if (activity.kind === 'candle') status.textContent = `Flame ${Math.round(activity.flame * 100)}% · ${activity.flame < .15 ? 'settle to relight' : 'let it glow'}`;\n  else if (activity.kind === 'jog') status.textContent = `${activity.jogHits} steps · alternate J and K`;\n  else if (activity.kind === 'hoop') status.textContent = `${activity.hoopHits} catches · circle your lean`;\n  else status.textContent = activity.stun > 0 ? 'A wobble! Take a moment.' : 'Find the ring. Breathe naturally.';\n  progress.style.width = `${clamp(activity.elapsed / activity.seconds * 100, 0, 100)}%`;\nfunction updateCheckHUD() {\n  if (!state.check) return;\n  const timer = document.getElementById('check-timer'), text = document.getElementById('check-text'), progress = document.getElementById('check-progress');\n  if (!timer) return;\n  timer.textContent = state.check.phase === 'still' ? String(Math.max(0, Math.ceil(5 - state.check.elapsed))).padStart(2, '0') : `${state.check.directions.size}/4`;\n  text.textContent = state.check.phase === 'still' ? 'Find a comfortable center.' : 'Lean left, up, right and down.';\n  progress.style.width = `${state.check.phase === 'still' ? clamp(state.check.elapsed / 5 * 50, 0, 50) : 50 + state.check.directions.size * 12.5}%`;\n}\nfunction update(dt) {\n  state.clock += dt;\n  if (state.screen === 'title') { state.idle += dt; if (state.idle >= 10 && !state.hub.active) screen('attract'); }\n  if (state.screen === 'check') { state.check.elapsed += dt; if (state.check.phase === 'still' && state.check.elapsed >= 5) { state.check.phase = 'lean'; state.check.elapsed = 0; } if (state.check.phase === 'lean' && (state.check.directions.size === 4 || state.check.elapsed >= 14)) screen('question'); }\n  if (state.screen === 'play') updateActivity(dt);\n}\nfunction action(name, id) {\n  unlockAudio(); state.idle = 0; tone(440, .07, .2);\n  switch (name) {\n    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n    case 'slots': screen('slots'); break;\n    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n    case 'outfit': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.outfit = Number(id); render(); break;\n    case 'instructor': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.instructor = id; render(); break;\n    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n    case 'check': beginCheck(); break;\n    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n    case 'island': state.classMode = false; screen('island'); break;\n    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n    case 'locked': notify('A new mat opens on a later day.'); break;\n    case 'start-activity': startActivity(state.selection); break;\n    case 'retry': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n    case 'ending': screen('ending'); break;\n    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad', source: 'primary' }, { name: 'Gertrude', type: 'Bot', source: 'bot' }]; if (!CLASS_IDS.includes(state.selection?.id)) state.selection = ACTIVITIES[0]; screen('class'); break;\n    case 'class-toggle': { const index = Number(id); if (index === 0) break; const current = state.classPlayers[index]; state.classPlayers[index] = !current ? { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot', source: 'bot' } : index === 1 && current.source === 'bot' ? { name: 'Player 2', type: 'Keyboard 2', source: 'keyboard' } : null; render(); break; }\n    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection, { seconds: 35 }); break;\n    case 'hub-ready': window.AIHub.answer('ready'); notify('Ready to go!'); break;\n    case 'hub-more': window.AIHub.answer('more'); notify('Waiting for more players.'); break;\n    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n    case 'pause': pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); break;\n    case 'resume': screen(pausedFrom || 'play'); break;\n    case 'restart': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n    case 'dev': screen('dev'); break;\n    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n    case 'about-back': screen(state.aboutReturn || 'title'); break;\n  }\n}\napp.addEventListener('click', event => { const target = event.target.closest('[data-action]'); if (target) action(target.dataset.action, target.dataset.id); });\napp.addEventListener('mouseover', event => { const target = event.target.closest('button'); if (target && state.input !== 'gamepad') target.focus({ preventScroll: true }); });\napp.addEventListener('input', event => { const key = event.target.dataset.tuning; if (key) { tuning[key] = Number(event.target.value); document.getElementById(`out-${key}`).value = tuning[key]; } });\nwindow.addEventListener('keydown', event => {\n  if (event.repeat && event.key !== ' ') return;\n  state.input = 'keyboard'; state.idle = 0; const key = event.key.toLowerCase();\n  if (state.screen === 'attract') { event.preventDefault(); screen('title'); return; }\n  if (event.target instanceof HTMLInputElement && event.target.type === 'text') { if (key === 'enter') { event.preventDefault(); action('create-member'); } return; }\n  if (['arrowup','arrowdown','arrowleft','arrowright',' '].includes(key)) event.preventDefault();\n  keys.add(key); unlockAudio();\n  if (state.screen === 'check' && state.check.phase === 'lean') { const mapping = { a:'left', arrowleft:'left', w:'up', arrowup:'up', d:'right', arrowright:'right', s:'down', arrowdown:'down' }; if (mapping[key]) state.check.directions.add(mapping[key]); return; }\n  if (state.screen === 'play') { if (key === 'escape') action('pause'); else attemptInput(key); return; }\n  if (key === 'escape' || key === 'backspace') { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (state.screen === 'dev') screen('pause'); else if (state.screen === 'activity') action('island'); else if (state.screen === 'slots' || state.screen === 'class') action('home'); return; }\n  if (key === 'arrowdown' || key === 's') focusMove(1); else if (key === 'arrowup' || key === 'w') focusMove(-1); else if ((key === 'enter' || key === ' ') && document.activeElement?.tagName !== 'BUTTON') { const buttons = currentButtons(); if (buttons.length) buttons[0].focus(); }\n});\nwindow.addEventListener('keyup', event => keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur', () => { keys.clear(); if (state.screen === 'play' && !state.hub.active) action('pause'); });\nwindow.addEventListener('mousemove', event => { if (state.screen !== 'play' || event.buttons === 0) return; state.input = 'mouse'; mouseLean = { x: clamp((event.clientX - innerWidth / 2) / (innerHeight * .33), -1, 1), y: clamp((event.clientY - innerHeight / 2) / (innerHeight * .33), -1, 1) }; });\nwindow.addEventListener('mousedown', event => { if (state.screen === 'play' && event.button === 0) keys.add(' '); });\nwindow.addEventListener('mouseup', () => keys.delete(' '));\nfunction pollGamepad() {\n  const pads = Array.from(navigator.getGamepads?.() || []);\n  for (const pad of pads) {\n    if (!pad) continue;\n    const previous = gamepadPrevious[pad.index] || [];\n    pad.buttons.forEach((item, index) => {\n      if (item.pressed && !previous[index]) {\n        state.input = 'gamepad'; state.idle = 0; unlockAudio();\n        if (state.screen === 'attract') screen('title');\n        else if (state.screen === 'play') { if (index === 9) action('pause'); else if (index === 4 || index === 5) attemptInput(index === 4 ? 'q' : 'e'); else if (index === 6 || index === 7) attemptInput(index === 6 ? 'j' : 'k'); }\n        else if (state.screen === 'check' && state.check.phase === 'lean') { if (index === 12) state.check.directions.add('up'); if (index === 13) state.check.directions.add('down'); if (index === 14) state.check.directions.add('left'); if (index === 15) state.check.directions.add('right'); }\n        else if (index === 0) { const selected = document.activeElement; if (selected?.tagName === 'BUTTON') selected.click(); else currentButtons()[0]?.focus(); }\n        else if (index === 1) { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (!state.hub.active) action('home'); }\n        else if (index === 12) focusMove(-1); else if (index === 13) focusMove(1);\n  ellipse(x - size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n  ellipse(x + size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n  context.strokeStyle = '#416b60'; context.lineWidth = Math.max(1, size * .015); context.beginPath();\n  context.arc(x, y - size * .2, size * .045, .2, Math.PI - .2); context.stroke();\n  if (mood) { context.fillStyle = '#e6ad65'; context.font = `bold ${size * .2}px sans-serif`; context.fillText('✦', x + size * .57, y - size * .46); }\n}\nfunction drawPerson(x, ground, size, options = {}) {\n  const sway = (options.lean || 0) * size * .13 + Math.sin((options.time || 0) * 1.3) * size * .008;\n  const movement = options.movement || 0;\n  const skin = options.skin || '#e8b69b';\n  const shirt = options.shirt || '#f1c86c';\n  const trousers = options.trousers || '#527d75';\n  ellipse(x, ground + size * .035, size * .39, size * .065, 'rgba(56,95,80,.13)');\n  line(x - size * .1, ground - size * .31, x - size * (.16 + movement * .08), ground - size * .03, size * .105, trousers);\n  line(x + size * .1, ground - size * .31, x + size * (.16 - movement * .08), ground - size * .03, size * .105, trousers);\n  line(x - size * (.16 + movement * .08), ground - size * .03, x - size * (.23 + movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n  line(x + size * (.16 - movement * .08), ground - size * .03, x + size * (.23 - movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n  line(x - size * .13 + sway, ground - size * .6, x - size * .35 + sway, ground - size * (.49 + Math.abs(movement) * .12), size * .08, skin);\n  line(x + size * .13 + sway, ground - size * .6, x + size * .35 + sway, ground - size * (.49 - Math.abs(movement) * .12), size * .08, skin);\n  rounded(x - size * .19 + sway, ground - size * .68, size * .38, size * .4, size * .12, shirt);\n  line(x + sway, ground - size * .71, x + sway, ground - size * .65, size * .105, skin);\n  ellipse(x + sway, ground - size * .85, size * .19, size * .22, skin);\n  ellipse(x + sway, ground - size * .99, size * .19, size * .105, '#52655a');\n  ellipse(x - size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n  ellipse(x + size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n  context.strokeStyle = '#a56d61'; context.lineWidth = Math.max(1, size * .012); context.beginPath();\n  context.arc(x + sway, ground - size * .81, size * .045, .1, Math.PI - .1); context.stroke();\n}\n4: *   const lib = Mocap.load(window.MOCAP.QUATERNIUS);   // a set: its clips, and the bodies they were measured on\n6: *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n7: *   const man = new Mocap.Mannequin(lib, { height: 34 });  man.draw(g, ox, oy, view, pose, facing)\n8: *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n9: *     window.Mocap.)\n15:const Mocap = (() => {\n17:const E = My3D2dge, { px } = E, MR = MocapReadable;\n24:function load(set) {\n167: * Mocap.drive(rig, lib): after the rig poses itself each step it takes the pose in rig.mocap (a sampled pose, or\n267:// also window.Mocap (a top-level const is no property of window: a game that looked for window.Mocap found nothing, and its clips silently never played)\n268:if (typeof globalThis !== 'undefined') globalThis.Mocap = Mocap;\n170:  var probeFn = null;\n269:    } else if (m.type === 'time-up') {\n270:      emit('time-up', [{ graceMs: m.graceMs }]);\n468:  hub.probe = function (fn) {\n469:    probeFn = typeof fn === 'function' ? fn : null;\n473:    if (!probeFn) return null;\n475:      return JSON.parse(JSON.stringify(probeFn()));\n","exit_code":0,"status":"completed"}}
