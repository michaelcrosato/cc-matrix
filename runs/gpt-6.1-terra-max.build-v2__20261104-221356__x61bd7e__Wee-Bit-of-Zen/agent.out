{"type":"item.completed","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"sed -n '90,190p' src/art.js; sed -n '2308,2360p' engine/my-3d2dge.js; sed -n '2840,2860p' engine/my-3d2dge.js; tail -25 engine/my-3d2dge.js; rg -n 'hub:|connect\\\\(|on\\\\(|answer\\\\(|AIHub|probe\\\\(' ../PLAN.md | tail -45; cat ../TASK.md\"","aggregated_output":"  drawCloud(width * .92, height * .27, width * .05);\n  context.fillStyle = '#c9e7d7'; context.beginPath(); context.moveTo(0, height * .64); context.quadraticCurveTo(width * .24, height * .31, width * .45, height * .61); context.quadraticCurveTo(width * .67, height * .36, width, height * .63); context.lineTo(width, height); context.lineTo(0, height); context.fill();\n  context.fillStyle = '#aedbc9'; context.beginPath(); context.moveTo(0, height * .69); context.quadraticCurveTo(width * .21, height * .51, width * .44, height * .68); context.quadraticCurveTo(width * .72, height * .46, width, height * .65); context.lineTo(width, height); context.lineTo(0, height); context.fill();\n  context.fillStyle = '#cdebe0'; context.fillRect(0, height * .7, width, height * .3);\n  for (let index = 0; index < 11; index++) {\n    const rippleX = ((index * 191 + time * 5) % (width + 100)) - 50;\n    line(rippleX, height * (.74 + (index % 4) * .045), rippleX + 42 + index * 3, height * (.74 + (index % 4) * .045), 2, 'rgba(255,255,255,.35)');\n  }\n}\nfunction drawWorld(state) {\n  const width = artWidth, height = artHeight, time = state.clock || 0;\n  context.clearRect(0, 0, width, height);\n  drawScenery(time);\n  const compact = width < 700;\n  const active = state.screen === 'play' || state.screen === 'check';\n  const cx = compact ? width * .52 : active ? width * .5 : width * .73;\n  const cy = active ? height * .76 : compact ? height * .46 : height * .68;\n  const size = Math.min(width * (compact ? .63 : .30), height * .52);\n  ellipse(cx, cy + size * .19, size * 1.05, size * .28, '#a9cfb5');\n  ellipse(cx, cy + size * .13, size, size * .26, '#d5e7c4');\n  ellipse(cx, cy + size * .07, size * .91, size * .2, '#e9efd4');\n  drawTree(cx - size * .7, cy - size * .1, size * .42);\n  drawTree(cx + size * .72, cy - size * .08, size * .3);\n  if (!active) {\n    rounded(cx - size * .37, cy - size * .39, size * .53, size * .32, size * .025, '#fff9e9');\n    context.fillStyle = '#dfaa88'; context.beginPath(); context.moveTo(cx - size * .43, cy - size * .39); context.lineTo(cx - size * .11, cy - size * .58); context.lineTo(cx + size * .21, cy - size * .39); context.closePath(); context.fill();\n    rounded(cx - size * .12, cy - size * .29, size * .11, size * .2, size * .012, '#9ec6b2');\n    rounded(cx - size * .31, cy - size * .29, size * .12, size * .1, size * .01, '#b4ddd2');\n    ellipse(cx + size * .28, cy + size * .02, size * .31, size * .09, '#a4cfc1');\n    drawPerson(cx + size * .27, cy, size * .6, { time, movement: Math.sin(time * 1.2) * .2 });\n    drawTare(cx + size * .58, cy + size * .08, size * .24, true);\n    for (let index = 0; index < 5; index++) ellipse(cx - size * .6 + index * size * .07, cy + size * .12, 3, 3, index % 2 ? '#f6c888' : '#fff8e5');\n  } else {\n    const activity = state.activity;\n    const lean = activity ? activity.px : 0;\n    const movement = activity ? Math.sin(activity.elapsed * (activity.kind === 'jog' ? 5 : 2)) * .6 : 0;\n    ellipse(cx, cy + size * .05, size * .55, size * .12, '#a5d2bf');\n    drawPerson(cx, cy, size * .95, { time, lean, movement, shirt: state.shirt });\n    drawTare(cx + size * .55, cy + size * .06, size * .22, false);\n    if (activity && activity.kind === 'candle') {\n      rounded(cx - size * .65, cy - size * .14, size * .11, size * .16, 4, '#fffaf0');\n      ellipse(cx - size * .595, cy - size * .16, size * .035, size * (.055 + activity.flame * .06), '#f7c05b');\n    }\n    if (activity && activity.kind === 'hoop') {\n      context.strokeStyle = '#f5ae80'; context.lineWidth = size * .035; context.beginPath(); context.ellipse(cx, cy - size * .35, size * .36, size * .09, -.08, 0, Math.PI * 2); context.stroke();\n    }\n    if (activity && activity.kind === 'tray') {\n      line(cx - size * .38, cy - size * .49, cx + size * .38, cy - size * .49 + lean * size * .1, size * .045, '#bb8b6d');\n      ellipse(cx, cy - size * .52, size * .06, size * .035, '#849e67');\n    }\n  }\n}\nclass Game {\n  /**\n   * new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu,\n   * fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features\n   * (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\n   * - res: a fixed resolution ('ps1' or [w, h]), whole pixels\n   * - expand: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars\n   *   (expand: { maxW, maxH } stops it growing there)\n   * - bg: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture\n   *   under it (a 3D world, engine/my-3d2dge-3d.js)\n   * - headless: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default):\n   *   scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\n   * - draw: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\n   * - loop: false makes a game in a page that runs only by advance()\n   * - menu: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\n   * - fullscreen: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it\n   *   off), 'button' (only when asked) or false\n   * - corner, backGesture: corner: the menu and full-screen buttons (top right); backGesture: a\n   *   phone's back steps back in the game first (false: it leaves the page)\n   * - autoPause: a pausable scene pauses when the page is hidden or loses focus\n   * - live: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it,\n   *   the scene's update goes on (game.paused says a menu is up) and the menu holds that player's input back\n   * - id: the name the player's settings are saved under (the page's path)\n   * - pace: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every\n   *   other one, evenly), unless the player picks Frame rate 60\n   * - camera: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\n   */\n  constructor(o = {}) {\n    o = Object.assign({}, o);\n    /** true for a game with no display (o.headless, or no DOM: Node) */\n    this.headless = !!o.headless || typeof document === 'undefined';\n    if (this.headless) o.canvas = null;\n    else {\n      if (typeof o.canvas === 'string') o.canvas = document.getElementById(o.canvas.replace(/^#/, '')) || document.querySelector(o.canvas);\n      if (!o.canvas) o.canvas = document.getElementById('screen') || document.querySelector('canvas') || Game._makeCanvas();\n    }\n    if (typeof o.input === 'string') o.input = Input[o.input.toUpperCase()] || (warn('input:' + o.input, 'unknown input preset \"' + o.input + '\" (use DEFAULT, PLATFORMER or SHMUP)'), Input.DEFAULT);\n    /** o: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg,\n     *  step, input, loop, headless) */\n    this.o = Object.assign({ view: 'iso', minH: 190, minW: 300, maxW: 560, maxH: 330, bg: '#07060d', step: 1 / 120, input: Input.DEFAULT, loop: !this.headless }, o);\n    // every listener the engine adds to the window, the document, the canvas and its buttons goes through this: dispose() removes them all\n    this._abort = typeof AbortController === 'function' ? new AbortController() : null;\n    const signal = this._abort ? this._abort.signal : undefined;\n    /** screen: the low-resolution screen (its W, H, scale and buffer) */\n    this.screen = new Screen(this.o.canvas, this.o, signal);\n    /** input: keyboard, mouse, gamepad and touch, read as actions (pressed, down, move, ...) */\n    this.input = new Input(this.screen, this.o.input, signal);\n    /** view: the view the game draws in now (the chosen one, with zoom and turn: read it, change it with setView);\n     *  baseView: the chosen view without zoom and turn */\n    this.view = this.baseView = this._view(this.o.view) || E.VIEWS.iso;\n    /** zoom: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's\n     *  (settings.zoom: the wheel, a pinch), within the scene's camera.zoom range; yaw: its turn in degrees on top of the\n     *  view (rotateView) */\n   * that catches what a player would see break). Returns the updates run\n   */\n  advance(seconds = this.o.step, o = {}) {\n    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n    this._acc += Math.max(0, seconds);\n    const n = this._steps(); this.stats.steps = n;\n    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n    return n;\n  }\n  /**\n   * the clock: an exact fixed step. Real time (at most 50 ms a frame, so a stall can't run away) fills an accumulator;\n   * each whole o.step of it (1/120 s) runs one update of o.step * timeScale game seconds (split in two or more when\n   * timeScale > 1, so no step is longer than o.step), and the remainder waits for the next frame (game.alpha = its\n   * fraction of a step). 60 Hz runs two steps a frame, 120 Hz one, 144 Hz one on most frames: the same steps at any rate.\n   * Slow motion makes steps shorter, never fewer. Paused or at timeScale 0 the steps still run (dt 0), so input ticks.\n   * The first frame always updates (with dt 0 when its time is short of a step), so draw never comes before update.\n   * Returns the updates run\n   */\n  _run(real) { this._acc += Math.min(.05, real); return this._steps(); }\n  /** run the whole steps the accumulator holds (see _run) */\n  _steps() {\n    for (let cy = 0; cy * k < this.h; cy++) for (let cx = 0; cx * k < this.w; cx++) {\n      const wx = this.x + cx * k, wy = this.y + this.h - cy * k, [sx, sy] = r.w(wx, 0, wy);\n      if (sx > W || sy > H || sx + k * s < 0 || sy + k * s * v.zBoost < 0) continue;\n      const key = cx + ',' + cy; let cv = this._cv.get(key);\n      if (!cv || this._dirty.has(key)) { cv = this._paint(cx, cy, cv); this._cv.set(key, cv); this._dirty.delete(key); this.drawn++; }\n      r.decal(g => { const was = g.imageSmoothingEnabled; g.imageSmoothingEnabled = false; g.drawImage(cv, Math.round(sx), Math.round(sy), Math.round(k * s), Math.round(k * s * v.zBoost)); g.imageSmoothingEnabled = was; });\n    }\n  }\n  // one chunk's picture: each cell its material's color, varied a little; the lit top (air above), a dark rim elsewhere\n  _paint(cx, cy, cv) {\n    const k = this.chunk; cv = cv || E.mkCanvas(k, k); const g = E.ctx2d(cv), img = g.createImageData(k, k), D = img.data, W = this.w, C = this.cells;\n    for (let y = 0; y < k; y++) for (let x = 0; x < k; x++) {\n      const c = cx * k + x, row = cy * k + y, o = (y * k + x) * 4; if (c >= W || row >= this.h) continue;\n      const id = C[row * W + c]; if (!id) continue;\n      const M = this.materials[id - 1], P = this._rgb[id - 1], air = (cc, rr) => cc >= 0 && rr >= 0 && cc < W && rr < this.h && !C[rr * W + cc];\n      let up = 0; for (let d = 1; d <= M.depth; d++) if (air(c, row - d)) { up = d; break; }\n      const rim = air(c - 1, row) || air(c + 1, row) || air(c, row + 1), n = (hash(c, row) - .5) * 18 + (hash(c >> 2, row >> 2) - .5) * 14;\n      const base = up ? P.t : rim ? P.e : P.c, l = up === 1 ? 24 : 0;\n      D[o] = Math.max(0, Math.min(255, base[0] + n + l)); D[o + 1] = Math.max(0, Math.min(255, base[1] + n + l)); D[o + 2] = Math.max(0, Math.min(255, base[2] + n * .7 + l)); D[o + 3] = 255;\n    }\n    g.putImageData(img, 0, 0); return cv;\n  }\n}\nE.Terrain = Terrain;\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);\n456:**AI Hub session (`ghost` mode, 1 to 4).** Follow the protocol README (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); it is short, read it. Outside a session the game is unaffected and `connect()` answers `null`. ✔ This exact shape passed the harness at 1, 2, 3 and 4 players, on the bad network, and with the host leaving.\n458:**The round: \"Morning Class\".** Everyone plays the same 3 events on their own copy, in lockstep, seeing others as translucent seat-coloured ghosts on neighbouring mats (or in the world for Slalom and Jog). About 150 s: each event is 5 s intro + 40 s play + 5 s scores. Deal with `AIHub.rng('deal')`: one from Stork/Candle/Squat/Push-Up, one from Step/Hoop, one from Slalom/Jog.\n461:const inSession = !!(window.AIHub && AIHub.active);\n467:  const info = await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n469:  AIHub.on('card', c => { card = c; });\n470:  AIHub.on('start', () => {});\n471:  AIHub.on('message', (d, from) => { /* ghost state */ });\n472:  AIHub.on('leave', ({ id }) => { /* remove that ghost */ });\n473:  AIHub.on('time-up', () => report());                  // result() at once if not reported\n474:  AIHub.on('end', () => { over = true; game.audio.stopMusic(); game.audio.mute(true); game.input.clear(); });\n475:  await game.booted; AIHub.ready();                     // no key press\n479:- **Card (yours, `card: true`):** the studio with the players lined up on mats, Tare hopping, the title, each player's name and colour with a ready tick, how to win, this player's controls, seconds left. While `AIHub.time() === -Infinity`: `confirm` or `start` → `AIHub.answer('ready')`, `more` (△) → `AIHub.answer('more')`, clicks on Ready/More too. No menus or choices on the card. Show \"More time\" state from the `card` event (`asked`, `paused`).\n480:- **Clock:** all event timing comes from `AIHub.time()`, not `game.time`. A frame over 50 ms gives up its time, so a slow machine's game clock lags and would desync. Countdown while negative. Play at ≥ 0. If `info.limitMs` is shorter than the round, shrink the events.\n481:- **Randomness:** every activity takes its disturbances from `AIHub.rng('e' + eventIndex)` (and a seeded `E.rng` offline). `Math.random` is only for cosmetics like particles and blinks, because copies draw it at different rates.\n482:- **Ghost data:** `AIHub.send({ t: 'g', a: eventIndex, l: [x, y], p: phase, w: [wx, wy], s: score }, { reliable: false })` about 10 times a second. Draw only if `a` matches your current event. `r.actor(..., { alpha: .5 })`, name tag in seat colour. Names come from `info.players`, drawn with `E.font` only (never HTML). Limit: 20 messages/s.\n483:- **Reporting:** `AIHub.progress({ score: total, label: total + ' pts' })` about once a second; at the end `AIHub.result({ score: total, stats: { Steadiness: '84%' }, awards: [{ title: 'Most Still', detail: '...' }] })` once.\n495:<meta name=\"hub:type\" content=\"Game\"><meta name=\"hub:players\" content=\"1–4\"><meta name=\"hub:source\" content=\"Wii Fit\">\n496:<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\">\n497:<meta name=\"hub:session-minutes\" content=\"3\">\n498:<meta name=\"hub:session-goal\" content=\"Stay steadiest over 3 exercises; most points wins\">\n499:<meta name=\"hub:session-howto\" content=\"Lean: left stick, WASD or mouse. Breathe: R2, Space or click\">\n560:  class: true, hub: true, tiers: [ {/* numbers */}, {/* numbers */} ], stars: [.35, .65, .90], lines: {/* ... */},\n600:- Class: 4 inputs, scores, podium. Hub logic with a fake `AIHub` object: same seed, same deal; time-up reports once; end stops input.\n608:- Sound: after a gesture, an `AnalyserNode` on the music bus is non-silent and `game.settings.music === .1` on fresh storage; the voice bus sounds during dialog; `OfflineAudioContext` renders `babble` non-silent; no audio files and no network requests at all (`page.on('request')`).\nSOURCE: Wii Fit\n\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\n\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\n\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\n\nResearch: Whether and how much to research is your choice.\n\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-221356].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\n\nTech Stack: Build on https://github.com/michaelcrosato/my-3d2dge/tree/main/dist/handoff. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\n\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\n\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\n\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\n\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\n\nWorking Environment and deliverable:\nCreate a subfolder called [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-221356] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-221356].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\n\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\n\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\n\nEffort: Spend effort however you see fit.\n\n## This computer\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\n\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software-rendered, when started with --enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader), Firefox 155.0 (WebGL 2, software-rendered), WebKit 26.6 (WebGL 2) already downloaded. Phone and tablet device profiles are built in.\n  WebGPU only works on a secure page: file:// or http://127.0.0.1. A WebGPU canvas can come out blank in a headless screenshot, so check the game's state instead.\n  For Node, `npm install playwright@1.63.0` in your folder uses the browsers already downloaded; another version downloads its own.\n  Playwright runs here with PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 (already set for runs): this OS isn't one it supports by name.\n- **Tools:** node 24.22.1, npm 11.19.1, python3 3.14.8, pip3 26.2.1, git 2.56.0, gh 2.46.0, curl 8.22.0, wget 1.25.0, jq 1.8.1, ffmpeg 9.0.2, ffprobe 9.0.2, sqlite3 3.53.4, zip 3.0, unzip 6.00, rustc 1.99.0, cargo 1.99.0, go 1.27.1, java 27, lighthouse 13.5.0, shot-scraper 1.12, xvfb-run, magick 7.1.2, esbuild 0.28.2, uv 0.12.23, tsc 7.0.2, wasm-bindgen 0.2.129.\n- **Rust:** rustup's toolchains 1.96.0, 1.98.1, stable; the wasm32-unknown-unknown target on 1.98.1.\n- **Not installed:** sox, bun, deno.\n- **Network:** internet works (github.com, registry.npmjs.org).\n- **Memory:** earlyoom is on: when memory runs out it ends the biggest browser, so \"Target closed\", \"page crashed\" or \"browser has been closed\" means memory ran out, not a bug in your game. Run fewer browsers at once rather than retrying.\n\n### What this computer doesn't have\n\nNo script can check these, so they're written by hand. Test with the stand-ins; anything that needs the real thing is checked as far as it can be here, never required.\n\n- **No physical controller.** Emulate one: replace navigator.getGamepads with a stub that returns a pad in the standard mapping (Playwright's add_init_script / addInitScript).\n- **No touch device.** Use Playwright's phone and tablet profiles, which have touch, and tap with page.touchscreen.\n- **Nobody to listen.** Check sound by what Web Audio produces: render it with an OfflineAudioContext, or read levels from an AnalyserNode.\n- **No second player.** Play multiplayer with two browser pages (or contexts) on this computer.\n- **No real iPhone or iPad.** WebKit with an iPhone profile is the closest; it isn't iOS Safari.\n- **No TV.** Judge the 10-foot view from screenshots at 1920×1080.\n\n### Sharing this computer\n\n- Other agents run here at the same time. Keep one or two browsers open at once, and close them when you're done.\n- Keep every file you make inside your own folder, not /tmp or a parent folder: /tmp is shared.\n- The browsers are already downloaded: don't run `playwright install` or `playwright install-deps`.\n- The system Python has Playwright and nothing else. For one (Pillow, numpy …), use uv: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` when the script drives a browser too (a newer Playwright can't find the browsers here).\n\n## Goal\n\nBuild an original game inspired by the source.\n\nScope\n\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\n\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\n\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game.\n\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\n\nNarrative tone: Use a writing style similar to the source’s.\n\n## UI & UX: 10-Foot Controller-First Philosophy\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\n\nDo not use overly dense, web-style data screens.\n\nTouch-only devices: no touch controls; show \"Controller or keyboard required\" and the settings button. Let the attract mode run.\n\n## Done\nNo TODOs, placeholders, or stubbed features. The demo is complete.\n\n## Source Information\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \"unknown\" for anything you can't confirm.\n- Date: 2026-11-04 22:13:56\n- Source: the work it's based on\n- Plan: the file name of the plan you were given to build from, or none\n- Genre and Perspective: genre and camera perspective used\n- Tech: stack, libraries/engines, with versions if applicable\n- Art Direction: style used\n- Animation: system used\n- Audio: music, sound effects and voice used\n- Online: network features used, or none\n- Testing: testing parameters allowed\n- Research: research done, or none\n- Environment: Codex CLI (headless); Linux\n- Model: OpenAI, gpt-6.1-terra, reasoning effort max\n- Usage: write \"added on import\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\n\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\"unknown\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\n{\n  \"sourceInformation\": {\"date\": \"\", \"source\": \"\", \"plan\": \"\", \"genre\": \"\", \"perspective\": \"\", \"tech\": \"\", \"artDirection\": \"\", \"animation\": \"\", \"audio\": \"\", \"online\": \"\", \"testing\": \"\", \"research\": \"\", \"environment\": \"\", \"model\": \"\", \"usage\": \"added on import\"},\n  \"testingFeedback\": [\"your answer to each Testing Feedback question, in order\"],\n  \"engineFeedback\": [\"your answer to each Engine Feedback question, in order\"],\n  \"promptFeedback\": [\"your answer to each Prompt Feedback question, in order\"],\n  \"aiHub\": {\n    \"name\": \"the game's title, as on its title screen\",\n    \"tagline\": \"a few words to go under the title\",\n    \"description\": \"one or two sentences for the catalogue\",\n    \"type\": \"Game, Tech demo or Tool\",\n    \"genre\": \"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\",\n    \"source\": \"the work it's based on, e.g. Moby-Dick\",\n    \"series\": \"its franchise, e.g. Star Fox, or empty\",\n    \"players\": \"how many can play: 1, 1–2 or 1–4\",\n    \"controls\": \"the controls, in one line\",\n    \"tags\": [\"3 to 6 lowercase tags, e.g. 2d, 3d, arcade, story, co-op, versus, first-person, third-person, top-down, side-scrolling, pixel art, low-poly, retro, sci-fi, fantasy, comedy, vehicles, boss fights, exploration\"]\n  }\n}\nThe catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\n\nTesting Feedback\n\n- How many issues did testing catch?\n- How many would be considered critical issues / game breaking?\n- What was the most helpful test you ran?\n- What was the least helpful test you ran?\n\nEngine Feedback\n\n- What did you like most about the engine?\n- Did you get stuck or guess wrong?\n- What was the most important thing you had to build yourself?\n- What was the hardest part about using the engine?\n- What did you change in the engine, and why? (none if nothing)\n- If you could change one thing about the engine, what would it be?\n\nPrompt Feedback\n\n- What did you like most about this prompt?\n- What was confusing?\n- What was the hardest thing to do?\n- What would you change in this prompt?\n","exit_code":0,"status":"completed"}}
