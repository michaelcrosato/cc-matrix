{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"rg -n 'class Game |class Renderer |class Input |booted|class Humanoid|class View|class Render|class Mocap' engine/my-3d2dge.js vendor/mocap.js | head -45; tail -35 engine/game/game.js; sed -n '305,355p' ../PLAN.md; sed -n '61,125p' ../PLAN.md; sed -n '130,169p' ../PLAN.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"rg -n 'class Game |class Renderer |class Input |booted|class Humanoid|class View|class Render|class Mocap' engine/my-3d2dge.js vendor/mocap.js | head -45; tail -35 engine/game/game.js; sed -n '305,355p' ../PLAN.md; sed -n '61,125p' ../PLAN.md; sed -n '130,169p' ../PLAN.md\"","aggregated_output":"engine/my-3d2dge.js:558:class View {\nengine/my-3d2dge.js:754:class Input {\nengine/my-3d2dge.js:1685:class Renderer {\nengine/my-3d2dge.js:2308:class Game {\nengine/my-3d2dge.js:2430:    this.booted = Promise.resolve(this);\nengine/my-3d2dge.js:2794:    let res; this.booted = new Promise(r => { res = r; });\nengine/my-3d2dge.js:4052:class Humanoid {\n    r.decal(() => r.groundArc(guard.x, guard.y, 6, 110, guard.facing - .6, guard.facing + .6, alert > 0 ? '#ff6040' : '#ffe080', .4));   // its sight cone\n    const gem = map.find('gem');\n    if (!got) { r.sprite(gem.x, gem.y, ROOF + 6 + Math.sin(game.time * 3) * 2, GEM, { glow: .8 }); game.lights.add(gem.x, gem.y, ROOF + 6, 44, .9, { color: '#80d8ff' }); }\n    if (hero.gliding) r.queue(hero.x, hero.y, hero.z + 40, g => {   // the sail, over the hands the rig holds up\n      const c = Math.cos(hero.facing), s = Math.sin(hero.facing), P = (f, w, z) => r.w(hero.x + c * f - s * w, hero.y + s * f + c * w, hero.z + z);\n      const q = [P(9, -17, 43), P(9, 17, 43), P(-7, 15, 37), P(-7, -15, 37)], h = P(0, 0, 30);\n      for (const t of [q[0], q[1]]) E.px.line(g, t[0], t[1], h[0], h[1], '#3a2a20');\n      E.px.poly(g, q, '#d8603a'); E.px.line(g, q[0][0], q[0][1], q[1][0], q[1][1], '#f4a070');\n    });\n    for (const [b, rig] of [[hero, heroRig], [guard, guardRig]]) {\n      r.shadow(b.x, b.y, 7, .35, undefined, b.groundZ || 0);\n      r.actor(b.x, b.y, b.z, (g, ox, oy) => rig.draw(g, ox, oy, r.view));\n    }\n  }\n};\n\nconst end = {\n  update() { if (game.input.pressed('start')) { reset(); game.go('play'); } },\n  draw(r) {\n    r.sky(won ? ['#103020', '#2a6a48'] : ['#301010', '#6a2a2a']);\n    const m = Math.round(r.H / 2);\n    r.overlay(g => E.font.title(g, won ? 'STOLEN' : 'CAUGHT', r.W / 2, m - 42, { scale: 3, align: 'center' }));\n    r.text(('PRESS ' + game.input.label('start') + ' TO TRY AGAIN').toUpperCase(), r.W / 2, m + 28, '#ffffff', { align: 'center', shadow: '#000' });\n  }\n};\n\nreset();\n// a handle for tests and tools (node game/test.mjs, tools/check.mjs prints snapshot(), tools/replay.mjs logs it)\ngame.debug = {\n  snapshot: () => ({ scene: game.sceneName, hero: [hero.x, hero.y, hero.z].map(v => Math.round(v * 10) / 10), climbing: !!(hero.wall || hero.action),\n    guard: [Math.round(guard.x), Math.round(guard.y), guard.facing], alert: Math.round(alert * 100) / 100, got, won }),\n  teleport(x, y, z = 0, facing = hero.facing) { Object.assign(hero, { x, y, z, vx: 0, vy: 0, vz: 0, onGround: true, facing, wall: null, action: null }); }\n};\ngame.start({ scenes: { title, play, end }, scene: 'title' });\n})();\nRigs are `E.Humanoid` (`weapon: null`). Player and Regulars `chibi`; instructors `build: 'heroic', limbW: 1.5, torsoW: 2.5, hair: 'bald'` (Alder `'ponytail'`) with every colour key in wood tones. Their ball joints: after `rig.draw`, in the same `r.actor`, for `kneeL kneeR elbowL elbowR shL shR`: `const w = rig.worldOffset(rig.J[k]), p = (rig.lastView || r.view).p(w[0], w[1], w[2]);` then `px.disc` radius 3 and radius 2 in two wood tones at `(ox + p[0], oy + p[1])`.\n\n**Real motion capture, including actual yoga, plays on these rigs.** Cut the small set in section 15. Then:\n\n```js\nconst lib = Mocap.load(window.MOCAP.FITCLIPS);\nfunction makeRig(opts) {\n  const rig = new E.Humanoid(Object.assign({ weapon: null }, opts));\n  Mocap.drive(rig, lib);              // first\n  const base = rig.solvePose;         // then our layer: a hand-posed body, then the wobble\n  rig.wob = [0, 0]; rig.body = null;\n  rig.solvePose = function () {\n    base.call(this);\n    if (this.body) setBody(this, this.body(this));\n    const [ax, ay] = this.wob; if (!ax && !ay) return;\n    const J = this.J, a = ax * .45, b = ay * .3, ca = Math.cos(a), sa = Math.sin(a), cb = Math.cos(b), sb = Math.sin(b);\n    for (const k in J) { if (k === 'bladeDir' || !J[k]) continue; const p = J[k];   // turn every joint about the feet\n      const r2 = p[1] * ca + p[2] * sa, z2 = -p[1] * sa + p[2] * ca, f2 = p[0] * cb + z2 * sb, z3 = -p[0] * sb + z2 * cb;\n      p[0] = f2; p[1] = r2; p[2] = Math.max(z3, 0); }\n  };\n  return rig;\n}\n// each step. A clip turns the rig by its own heading, so aim with tgt minus that turn:\nrig.wob = [p.x, p.y];  rig.mocap = lib.sample(clip, t);   // rig.mocap = null to stop\nrig.update(dt, { x, y, z: 0, vx: 0, vy: 0, facing: tgt - (rig.spin || 0) });\n```\n\nFacing: π/2 looks at the camera; 0 is profile. **To hold a pose,** sample inside its window and drift slowly: `t = a + (b - a) * .3 * (.5 + .5 * Math.sin(time * .7))`. Clip motion keeps it alive.\n\n**Pose table** (windows ✔ seen on contact sheets; stork, triangle and dog ✔ seen in the studio):\n\n| Pose | Clip | Window (s) | `tgt` |\n|---|---|---|---|\n| Stork (one leg, arms wide) | `111_39_part1` | 3.6 to 7.0 | 1.57 |\n| Knee Lift | `111_39_part2` | .5 to 2.4 | 1.57 |\n| Triangle | `111_39_part3` | 2.2 to 5.2 | 1.2 |\n| Warrior (wide stance, arms wide) | `111_39_part3` | 6.6 to 7.6 | 1.57 |\n| Low Lunge | `111_38_part1` | 2.9 to 5.0 | .25 |\n| Down Dog | `111_38_part2` | 2.8 to 5.2 | .25 |\n| Forward Fold | `111_38_part2` | 8.0 to 8.8 | .25 |\n| Low Plank | `111_41_part3` | 3.4 to 6.4 | .25 |\n\nOther clips in the set: `Meditate` (Candle), `Pushup`, `22_14`, `Jumping Jacks`, `Run_Loop`, `Walk_Loop`, `Hop_One_Foot_Loop` (regaining balance), `Dizzy` (stumble), `Get_Up_From_Back` (falls), `Victory`, `Cheering_Two_Hands` (3★), `Stretch_Yawn` (morning), `Sleeping` (Lou, bed), `Greeting` (instructor's bow), `Wave_Hello`, `Waiting_Loop`, `Idle_Subtle` (Regulars). Crossfade with `lib.blend(a, b, k)`, or fade a clip over the rig with `rig.mocapW`.\n\n**Moves with no clip: pose the body yourself.** You set hips, feet, hands; IK does knees and elbows:\n\n```js\nconst { V3 } = E;  // V3.add, V3.mul, V3.norm\nfunction setBody(rig, b) {\n  const o = rig.o, J = rig.J, hipC = b.hip;\n  J.hipC = hipC; J.hipL = V3.add(hipC, [0, -o.hipHalf, 0]); J.hipR = V3.add(hipC, [0, o.hipHalf, 0]);\n## 3. The core mechanic: the Lean\n\nEvery player has a **centre of balance** `p` (x right, y forward, both -1..1) with velocity `v`. Input sets a lean target `u`. The body chases it like a heavy person on an unstable board:\n\n```js\n// one fixed step (dt = 1/120). nx, ny: smooth noise. fx, fy: scripted pushes (a gull, a gust, a thought)\nax = k * (ux - px) - c * vx + s * px + A * nx(t) + fx;\nay = k * (uy - py) - c * vy + s * py + A * ny(t) + fy;\nvx += ax * dt; vy += ay * dt; px += vx * dt; py += vy * dt;\nif (Math.hypot(px, py) >= 1) stumble();   // 1 s: input ignored, p eases home, stumble animation, score penalty\n// noise: three sines with seeded phases\nconst noise = (rng, f) => { const ph = [rng()*6.28, rng()*6.28, rng()*6.28];\n  return t => (Math.sin(t*f+ph[0]) + .6*Math.sin(t*f*1.73+ph[1]) + .35*Math.sin(t*f*2.61+ph[2])) / 1.3; };\n```\n\n`k` is responsiveness, `c` damping, `s` instability (the further you lean, the further you fall), `A` tremble, `nf` tremble speed, `R` the target ring's radius. **Steadiness** is the share of time inside the ring.\n\n**Tested defaults (✔ simulated over 45 s runs with modelled players):**\n\n| Set | k | c | s | A | nf | R | Push (speed, every s) | Passive | Poor | Average | Good |\n|---|---|---|---|---|---|---|---|---|---|---|---|\n| Body Check | 14 | 7 | 4 | 3 | 1.1 | .20 | none | 50% | 76% | 99% | 100% |\n| Sun Flow | 12 | 6 | 6 | 3.2 | 1.3 | .28 | .5, 9 | 53% | 78% | 99% | 100% |\n| Stork Stand 1 | 12 | 5 | 13 | 3 | 1.5 | .24 | .6, 7 | 20% (5 falls) | 30% | 68% | 95% |\n| Stork Stand 2 | 11 | 4.5 | 15 | 3.6 | 1.7 | .22 | .7, 6 | 22% (15 falls) | 15% | 29% | 54% |\n| Quiet Candle | 10 | 5 | 11 | 1.4 | .8 | .20 | .55, 5 | 14% (4 falls) | 59% | 95% | 100% |\n| Laundry Line | 10 | 3.5 | 16 | 3.5 | 1.2 | .40 | .9, 5 | 35% (19 falls) | 31% | 39% | 79% |\n\n**Bots use this model** (tests, attract, Class fill-ins). It reacts to where `p` was `tau` seconds ago:\n`target = -gain * pSeen - damp * vSeen + noise * smoothNoise(t)`; `u += (target - u) * min(1, dt * 16)`; clamp length to 1.\n\n| Bot | tau | gain | damp | noise |\n|---|---|---|---|---|\n| poor | .34 | 1.1 | .22 | .16 |\n| average | .25 | 1.4 | .30 | .08 |\n| good | .18 | 1.8 | .36 | .04 |\n| expert | .14 | 2.2 | .42 | .02 |\n\n**Input (the same game on three devices, each native).** All of it fills one `intent` object, and activities read only `intent`, never a device. Bots and attract fill the same object.\n\n| | Controller | Keyboard | Mouse |\n|---|---|---|---|\n| Lean | Left stick: `u` = stick position | WASD or arrows: **nudge**. While held, `u` moves toward the direction at 2.2/s; released, it drifts home at .5/s. Tapping makes fine corrections (✔ simulated: at 2.2/s keys score the same as a stick; at 1.6/s the rope is unplayable) | Pointer: `u` = pointer offset from screen centre / (`r.H` × .33). It stays where you leave it |\n| Breath / Effort | L2 or R2, analog (`input.value`) | Space (level ramps over 4 s) | Left button (same ramp) |\n| Left/right catch | L1 / R1 | Q / E | Left / right button |\n| Confirm, Back, Pause | ✕, ○, Options | Enter or Space, Esc, Esc or P | Click, right click, the corner button |\n\n✔ Tell which device is leaning like this: `input.lastDevice` becomes `'gamepad'` for a pad, but **moving the mouse does not change it away from `'keyboard'`**, so compare `input.mouse.t` (when the mouse last moved) with the time of your last key press. Use `input.pointer()` for the position. With a mouse, also hide the OS cursor over the canvas during activities and draw a small soft hand instead.\n\n✔ The input map must keep the engine's menu actions. **A custom map replaces the whole preset**: without `confirm` and `start`, menus and the hub card's Enter silently stop working.\n\n```js\nconst D = E.Input.DEFAULT, INPUT = { up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\n  confirm: D.confirm, cancel: D.cancel,\n  breath: ['Space', 'Mouse0', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Mouse0', 'Pad4'], catchR: ['KeyE', 'Mouse2', 'Pad5'],\n  jump: ['Space', 'Pad0'], interact: ['KeyE', 'Enter', 'Pad0'], more: ['Tab', 'KeyM', 'Pad3'], retry: ['KeyR', 'Pad2'],\n  paceL: ['KeyJ', 'Mouse0', 'Pad6'], paceR: ['KeyK', 'Mouse2', 'Pad7'],\n  stepL: ['KeyA', 'ArrowLeft', 'Mouse0', 'Pad14', 'PadAxisLeft'], stepR: ['KeyD', 'ArrowRight', 'Mouse2', 'Pad15', 'PadAxisRight'],\n  stepU: ['KeyW', 'ArrowUp', 'WheelUp', 'Pad12', 'PadAxisUp'], stepD: ['KeyS', 'ArrowDown', 'WheelDown', 'Pad13', 'PadAxisDown'] };\n```\n\n**The Plate** is the game's signature HUD: a large white disc at bottom centre (✔ radius 26 at `r.H - 34` reads well) with the ring, the dot, and a fading trail of the last second. In-ring: the ring glows mint, a soft chime rises with the streak, small glints appear. Near the edge: the rig flails, a creak plays, the controller rumbles harder (`input.rumble`). **Gentle Mode** (a setting): ring ×1.25, `s` and `A` ×.7. Tare says: \"Gentle Mode is on. I won't tell anyone. I don't know anyone.\"\n\n---\n\n### Stillness\n\n**Stork Stand** (`hold`). Stand on one leg on the deck. Hold the dot in the ring, which moves to a new spot every 12 s. A gull lands on your outstretched arm: a constant push to that side (`fx` = ±2.5) until it leaves with a little kick. 45 s. `pct` = steadiness - .05 × falls. The rig tilts with `p` (section 9). Tier 2, **Eyes Closed**: the Plate disappears and the screen dims. You balance by the rig's tilt, a stereo tone (pan = x, pitch = y) and rumble. This is the tutorial, guided on Day 1: \"Lean\" (move into the ring), \"Hold\", \"Recover\" (gull).\n\n**Sun Flow** (`hold` + breath). Five poses, two breaths each: Low Lunge → Down Dog → Triangle → Warrior → Stork. A guide ring swells for 4 s (breathe in: hold L2/R2, Space or left button) and shrinks for 4 s (let go). Analog players match the level; on digital the level ramps ±1 over 4 s. Crossfade poses with `lib.blend` over .6 s. 80 s. `pct` = .6 steadiness + .4 breath match (level within .25 of the guide), stars at .5, .75, .92 (doing nothing scores about .4 here). The instructor mirrors you on the next mat. Setting: Breath Hold or Toggle.\n\n**Quiet Candle** (`candle`). Sit cross-legged (`Meditate`). A candle burns in front of you. Its flame reacts to the **speed** of the dot: `|v|` over .55 drains flame .4/s, in-ring refills .12/s. Thought bubbles drift in with captions and push you slowly their way (`f` 3 to 5 for 2.5 s), so you must correct gently; any jerk hurts the flame. One relight (-15%), then it ends. 60 s. `pct` = .6 steadiness + .4 mean flame. If the input is perfectly untouched for the first 20 s, the thoughts drift you out and Tare says: \"Did you put the controller down? I can tell. This is not that kind of stillness.\" Tier 2 adds Dennis's blender and a goose.\n\n### Strength (all three are `rep`: one code path, three data rows)\n\n**The Rail.** A vertical rail beside the rig; a bead rides it at the instructor's tempo. Your lean **is** the body: `depth = clamp(-py, 0, 1)` scrubs the exercise as you move, so holding the stick halfway holds you halfway. `k` 16, `c` 8, `s` 0 on the main axis; the other axis has `s` 8 and is **form**: drift there and the rig visibly twists. Each rep scores 1.0 if mean `|depth - bead|` ≤ .08, 0 at ≥ .35, and shows Perfect/Good/Late. Tempo: 2 s down, 2 s up (tier 2: 3 s down, a hold, 1 s up). **Fatigue:** after 60% of the reps, `A` rises, `k` falls and the rig shakes. **\"Two more\":** if you are scoring above .8, the instructor adds two bonus reps. (\"You're doing so well, so I've added some.\") `pct` = mean rep × (1 - form penalty, up to .3).\n\n| Activity | Reps | Drive | Rig | Facing `tgt` |\n|---|---|---|---|---|\n| **Squat Rail** | 8 / 12 | down = deep | ✔ clip `22_14`: t = 1.1 (top) to 1.72 (bottom) | 1.2 |\n| **Push-Up** | 6 / 10 | down = low | ✔ clip `Pushup`: t = 0 (top) to dur × .5 (bottom) | .1 |\n| **Side Lunge** | 8 / 12 (horizontal rail; bead swings left and right) | `u = px` | ✔ `body` override `sideLunge(u)` (section 9) | π/2 |\n\n### Cardio\n\n**Step Class** (`step`, `E.Rhythm`). A bench, an instructor, three Regulars behind you all stepping on the beat. Always four lanes in the order `arrows: true` draws: `lanes: ['stepL', 'stepD', 'stepU', 'stepR']`. Tier 1's charts use only left and right at 100 bpm; tier 2 uses all four at 120 bpm. 60 s, windows 45/90/135 ms, a song with `loop: false` and a `len`. Input: d-pad or stick flicks, arrows or WASD, mouse buttons and wheel (see `INPUT`). The rig steps with `stepUp(k)`, triggered by your press, not by the chart. `pct` = `rh.accuracy`; stars at .5, .75, .92. Draw `rh.draw` with `arrows: true`, large, above the Plate's place. **Trap: music is 10% by default, so the beat must not depend on it.** Play a soft click on the sfx bus with `audio.onBeat`, and the instructor counts in gibberish on the beat. Charts are data ✔: `{ parts: { A: ['x.......x.......', '.', '.', '....x.......x...'], B: ['x...x...x.......', '.', '.', '..x...x.....x...'] }, order: 'A A B A' }`.\n\n**Hoop Hips** (`hoop`). Circle the lean to spin a hoop. Only movement with `|u|` > .55 counts; angular speed fills a big dial: \"Too slow / Just right / Too eager\". The good band is 7 to 11 rad/s (keyboard, by quadrant steps W→D→S→A: ×.6; mouse: circles round the screen centre, same as the stick). Regulars toss hoops from the sides: press catch left/right (L1/R1, Q/E, buttons) inside ±.25 s of arrival to stack it, up to 6. More hoops score faster and need a little more speed. 1.5 s out of band drops the top hoop. Halfway: \"Other way!\" 60 s. Mr. Okafor cheers. `pct` = score / best possible. ✔ Rig: `hula(phase)`. ✔ Hoops: back half queued with `bias: -6`, front half `bias: 6`.\n\n**Coastal Jog** (`jog`, `E.Road`; copy `engine/kits/road.js`). Alternate L2/R2 (J/K; left/right buttons) to set a cadence; lean steers. Stay in Marisol's pacing zone (cadence band 2.6 to 3.4 steps/s, shown as a calm gauge). Sprint over 4.2 for 2 s and you get a Stitch (3 s hobble). Weave round pigeons and other joggers, grab water cups. About 70 s for a lap. `pct` = .7 time in zone + .3 cups. Rig: `Run_Loop` scaled by cadence, drawn on the overlay from behind. Lou on his bench, the pier and bungalows go by as scenery.\n\n### Balance games\n\n**Mount Posture Slalom** (`slalom`, `E.Mode7`; copy `engine/kits/kart.js`). Lean left/right steers, forward tucks (speed ×1.35), back brakes (×.6). 18 gates (data: x offsets), base speed 220 units/s (start), about 60 s. A missed gate is +3 s; a snowman or pine is a 1.2 s tumble. `pct` from time between `par` and `worst`. Weather `snow`. Billboards: rig in `pose: 'crouch'`, skis, gates, snowmen. Show Regulars' times at the finish (\"Gertrude 0:58. She walked.\"). Tier 2: narrower gates and fog.\n\n**Tray Service** (`tray`, `E.Physics`, `sleep: false`). Dennis needs olives in cocktail glasses. He cannot say why. Lean tilts a tea tray: `world.gravity = [px * G, -py * G]` with G 420 (start), then `world.wake()`. Olives are circles; glasses are sensors (`on.enter` → plop, remove). Three trays in one run: 3 olives, then 5 with bumpers and a gap, then 7 with a slowly walking gecko. Layouts are ASCII in `game/data/trays.js`. 60 s total. `pct` = olives in / total × (.8 + .2 × time left share). Draw the tray with `new E.View('tray', 'Tray', 0, 55, 1, 1)` and tilt corners by `p` so the tilt is visible. Excellent with a mouse.\n\n**Laundry Line** (`laundry`, `side` view). Walk a clothesline between bungalows, x axis only, with the Laundry Line set. Walk speed is the Effort trigger (R2 analog; Space or left button .6); going faster adds up to +4 to `s`. Jump (✕, Space) over clothespins; in the air `p` freezes. Gusts (`fx` ±9 for .6 s) are telegraphed .8 s early by wind lines and a flying sock. Fall: you dangle, drop into a hamper, restart from the last post, -3 s. Three spans, about 70 s. `pct` from time, -.06 per fall. Sign: \"Please do not walk on the laundry line. Walking on the laundry line: 10:30 daily.\"\n\n### The Gentle Games (Day 5)\nShort versions in order, one continuous festival with bunting, music and crowd: Stork Stand, Step Class, Slalom, then **the Grand Stillness**, a Quiet Candle duel with Gertrude on a raft at dusk (90 s). Two flames, hers and yours. Distractions escalate: gull, blender, conga line, fireworks (`game.flash` soft, respect Comfort), Tare singing, a goose. Her flame only weakens after 75 s, and only if yours is above half. Win or lose, the story continues; winning gives -1 Spine Age and her line: \"Well done, dear. I've been waiting since Thursday.\"\n\n---\n\n## 5. Progress\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_45","type":"reasoning","text":"**Inspecting game renderer sizing**"}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"sed -n '1685,1750p' engine/my-3d2dge.js; sed -n '2308,2455p' engine/my-3d2dge.js; sed -n '2720,2835p' engine/my-3d2dge.js; sed -n '754,865p' engine/my-3d2dge.js; sed -n '1,90p' tests/hub/harness.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"sed -n '1685,1750p' engine/my-3d2dge.js; sed -n '2308,2455p' engine/my-3d2dge.js; sed -n '2720,2835p' engine/my-3d2dge.js; sed -n '754,865p' engine/my-3d2dge.js; sed -n '1,90p' tests/hub/harness.html\"","aggregated_output":"class Renderer {\n  /** the r handed to draw(r), made by the game */\n  constructor(game) {\n    /** game: its game; items: this frame's queue (sorted by depth when the frame ends) */\n    this.game = game; this._items = []; this._decals = []; this._overlays = [];\n    this._aCv = mkCanvas(AS, AS); this._aG = ctx2d(this._aCv);\n    // track what each actor actually draws, so outlines, tints and rim light only touch that rectangle\n    const aG = this._aG, bb = this._bb = [AS, AS, 0, 0], fr = aG.fillRect.bind(aG), di = aG.drawImage.bind(aG);\n    const grow = (x, y, w, h) => { if (x < bb[0]) bb[0] = x; if (y < bb[1]) bb[1] = y; if (x + w > bb[2]) bb[2] = x + w; if (y + h > bb[3]) bb[3] = y + h; };\n    aG.fillRect = (x, y, w, h) => { grow(x, y, w, h); fr(x, y, w, h); };\n    aG.drawImage = (img, ...a) => { if (a.length >= 8) grow(a[4], a[5], a[6], a[7]); else if (a.length >= 4) grow(a[0], a[1], a[2], a[3]); else grow(a[0], a[1], img.width, img.height); di(img, ...a); };\n    for (const m of ['fill', 'stroke', 'fillText', 'strokeText', 'putImageData']) { const f = aG[m].bind(aG); aG[m] = (...a) => { grow(0, 0, AS, AS); return f(...a); }; }\n    this._R = [0, 0, AS, AS];\n    this._mCv = mkCanvas(AS, AS); this._mG = ctx2d(this._mCv);\n    this._rCv = mkCanvas(AS, AS); this._rG = ctx2d(this._rCv);\n    this._xCv = mkCanvas(8, 8); this._xG = ctx2d(this._xCv); this._xoCv = mkCanvas(8, 8); this._xoG = ctx2d(this._xoCv);   // x-ray silhouettes (checkered fill) and their solid outlines\n    this._oCv = mkCanvas(8, 8); this._oG = ctx2d(this._oCv);\n    this._eCv = mkCanvas(8, 8); this._eG = ctx2d(this._eCv); this._sCv = mkCanvas(8, 8); this._sG = ctx2d(this._sCv);   // canvas lighting: the glow mask, a scratch layer\n    this._ghostPool = Array.from({ length: 10 }, () => { const c = mkCanvas(AS, AS); return { cv: c, g: ctx2d(c) }; });\n    /** ghosts: the afterimages fading out (actor option ghost) */\n    this._ghostIdx = 0; this._ghosts = [];\n    const ck = mkCanvas(2, 2), cg = ck.getContext('2d'); cg.fillStyle = '#000'; cg.fillRect(0, 0, 1, 1); cg.fillRect(1, 1, 1, 1);\n    /** checker: a 2 x 2 checkerboard canvas (a pattern for x-ray and dithered fills) */\n    this._checker = ck;\n    /** outline: the color of the 1-pixel outline round every actor; rim: the rim light's color on actors' lit edges;\n     *  rimAlpha: its strength 0..1; xrayColor: the default color of x-ray silhouettes; xrayOutline: the default 1-px\n     *  outline round a silhouette's hidden part (null for none); glowMask: false lets emissive\n     *  glows show over everything under canvas lighting (cheaper: the default keeps walls and bodies in front of a glow\n     *  dark) */\n    this.outline = '#140c1c'; this.rim = '#ffe2b8'; this.rimAlpha = .28; this.xrayColor = '#8fe3ff'; this.xrayOutline = '#e8fdff'; this.glowMask = true;\n    // GPU mode: a hidden \"info\" image (height, surface type, glow) and an unlit overlay image\n    this._iCv = mkCanvas(8, 8); this._iG = this._iCv.getContext('2d'); this._iG._info = true; this._iG._r = this; this._iG._mat = '#000';\n    /** gpu: true during a frame drawn with GPU lighting (draw code can check r.gpu) */\n    this._vCv = mkCanvas(8, 8); this._vG = ctx2d(this._vCv); this.gpu = false; this._tg = null;\n  }\n  /** current draw target for ground helpers (switches during GPU info and overlay passes) */\n  get tgt() { return this._tg || this.ctx; }\n  /** the low-resolution buffer's 2D context: draw on it with E.px */\n  get ctx() { return this.game.screen.ctx; }\n  /** the view this frame is drawn in (the game's, with zoom and turn) */\n  get view() { return this.game.view; }\n  /** pixels per world unit on the ground here: the view's scale times the zoom (iso 1.41, the others 1.5, overhead 1, at\n   *  zoom 1). Rigs, maps and props grow with it; a sprite's pixel is a screen pixel at zoom 1 unless drawn with world: true */\n  get ppu() { return (this.view.scale || 1) * (this.view.zoom || 1); }\n  /** the screen's width in game pixels */\n  get W() { return this.game.screen.W; }\n  /** the screen's height in game pixels */\n  get H() { return this.game.screen.H; }\n  /** the buffer's width (W + 2: a pixel of margin each side for the sub-pixel camera) */\n  get bw() { return this.game.screen.buf.width; }\n  /** the buffer's height (H + 2) */\n  get bh() { return this.game.screen.buf.height; }\n  /** start a frame with the camera at (cx, cy) projected pixels (the game calls it before your draw) */\n  _begin(cx, cy, vp) {\n    const sc = this.game.screen; this._frameNo = (this._frameNo || 0) + 1;   // (kept actor images count frames drawn)\n    sc._begin(cx, cy, this.game.o.bg, vp); this._vp = vp || null;\n    if (vp) { const g = this.ctx; g.save(); g.beginPath(); g.rect(vp.x, vp.y, vp.w, vp.h); g.clip(); }   // (a viewport: the scene drawn inside it, the floor too)\n    /** ix, iy: the camera's whole-pixel offset this frame (a world point is at r.w(x, y, z) on the buffer) */\n    this.ix = sc.ix; this.iy = sc.iy; this._items.length = 0; this._decals.length = 0; this._overlays.length = 0; this._map = null; (this._emis || (this._emis = [])).length = 0;\n    const st = this.game.stats; st.actors = 0; st.culled = 0;\n    if (this._xCv.width !== this.bw || this._xCv.height !== this.bh) { this._xCv.width = this._xoCv.width = this._oCv.width = this._eCv.width = this._sCv.width = this.bw; this._xCv.height = this._xoCv.height = this._oCv.height = this._eCv.height = this._sCv.height = this.bh; }\n    this._xrayUsed = false; this._xrayOl = false; this._emOn = false;\n    const gpu = this.game.gpu;\n    this.gpu = !!(gpu && gpu.active(this.view)) && !this.game._split;   // (no GPU lighting on a split screen)\n    if (gpu) gpu._show(this.gpu);\n    if (this.gpu) {\nclass Game {\n  /**\n   * new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu,\n   * fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features\n   * (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\n   * - res: a fixed resolution ('ps1' or [w, h]), whole pixels\n   * - expand: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars\n   *   (expand: { maxW, maxH } stops it growing there)\n   * - bg: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture\n   *   under it (a 3D world, engine/my-3d2dge-3d.js)\n   * - headless: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default):\n   *   scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\n   * - draw: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\n   * - loop: false makes a game in a page that runs only by advance()\n   * - menu: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\n   * - fullscreen: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it\n   *   off), 'button' (only when asked) or false\n   * - corner, backGesture: corner: the menu and full-screen buttons (top right); backGesture: a\n   *   phone's back steps back in the game first (false: it leaves the page)\n   * - autoPause: a pausable scene pauses when the page is hidden or loses focus\n   * - live: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it,\n   *   the scene's update goes on (game.paused says a menu is up) and the menu holds that player's input back\n   * - id: the name the player's settings are saved under (the page's path)\n   * - pace: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every\n   *   other one, evenly), unless the player picks Frame rate 60\n   * - camera: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\n   */\n  constructor(o = {}) {\n    o = Object.assign({}, o);\n    /** true for a game with no display (o.headless, or no DOM: Node) */\n    this.headless = !!o.headless || typeof document === 'undefined';\n    if (this.headless) o.canvas = null;\n    else {\n      if (typeof o.canvas === 'string') o.canvas = document.getElementById(o.canvas.replace(/^#/, '')) || document.querySelector(o.canvas);\n      if (!o.canvas) o.canvas = document.getElementById('screen') || document.querySelector('canvas') || Game._makeCanvas();\n    }\n    if (typeof o.input === 'string') o.input = Input[o.input.toUpperCase()] || (warn('input:' + o.input, 'unknown input preset \"' + o.input + '\" (use DEFAULT, PLATFORMER or SHMUP)'), Input.DEFAULT);\n    /** o: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg,\n     *  step, input, loop, headless) */\n    this.o = Object.assign({ view: 'iso', minH: 190, minW: 300, maxW: 560, maxH: 330, bg: '#07060d', step: 1 / 120, input: Input.DEFAULT, loop: !this.headless }, o);\n    // every listener the engine adds to the window, the document, the canvas and its buttons goes through this: dispose() removes them all\n    this._abort = typeof AbortController === 'function' ? new AbortController() : null;\n    const signal = this._abort ? this._abort.signal : undefined;\n    /** screen: the low-resolution screen (its W, H, scale and buffer) */\n    this.screen = new Screen(this.o.canvas, this.o, signal);\n    /** input: keyboard, mouse, gamepad and touch, read as actions (pressed, down, move, ...) */\n    this.input = new Input(this.screen, this.o.input, signal);\n    /** view: the view the game draws in now (the chosen one, with zoom and turn: read it, change it with setView);\n     *  baseView: the chosen view without zoom and turn */\n    this.view = this.baseView = this._view(this.o.view) || E.VIEWS.iso;\n    /** zoom: the camera's zoom now (1 = as the view is): the game's (setZoom, a scene's camera.start) times the player's\n     *  (settings.zoom: the wheel, a pinch), within the scene's camera.zoom range; yaw: its turn in degrees on top of the\n     *  view (rotateView) */\n    this.zoom = 1; this.yaw = 0; this._zoomBase = 1; this._zoomTo = null; this._zoomAt = 0; this._wall = 0;   // camera zoom and turn on top of the chosen view (setZoom, rotateView)\n    /** views this game is designed for (view cycling and the checker use it). null = every view */\n    this.views = this.o.views || null;\n    /** time: game seconds since start (it stops during pause and hit-stop, and slows with timeScale); real: seconds\n     *  the game has stepped through, pauses and hit-stop included (blinking HUD, notes); hitstop: seconds of\n     *  hit-stop left (freeze: a scene's entry ends it); timeScale: game speed, 1 normal, .25 slow motion, 0 stopped (it outlives a scene change: a game's speed setting; restore a slow motion with a kept timer); reduceMotion: the player\n     *  asked for less motion (prefers-reduced-motion): shake and flashes are softened */\n    this.time = 0; this.real = 0; this.hitstop = 0; this.timeScale = 1; this._shakeAmt = 0; this.reduceMotion = !this.headless && !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);\n    /** camera. smooth = seconds of lag; bounds(view) = clamp rect; room = [w, h] world units for screen-by-screen\n     *  rooms; moving = sliding between rooms; offset = [dx, dy] screen pixels from the screen's centre to where the\n     *  focus sits (above a phone's touch buttons: [0, -40]); x, y: 