g in the Grand Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"actions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:117:    const players = state.classPlayers;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:121:    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:154:function startActivity(activity, options = {}) {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:161:function completeActivity() {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:171:function attemptInput(key) {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:259:function action(name, id) {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:274:    case 'retry': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:275:    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:276:    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:278:    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:281:    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad', source: 'primary' }, { name: 'Gertrude', type: 'Bot', source: 'bot' }]; if (!CLASS_IDS.includes(state.selection?.id)) state.selection = ACTIVITIES[0]; screen('class'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:282:    case 'class-toggle': { const index = Number(id); if (index === 0) break; const current = state.classPlayers[index]; state.classPlayers[index] = !current ? { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot', source: 'bot' } : index === 1 && current.source === 'bot' ? { name: 'Player 2', type: 'Keyboard 2', source: 'keyboard' } : null; render(); break; }\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:284:    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection, { seconds: 35 }); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:294:    case 'restart': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max