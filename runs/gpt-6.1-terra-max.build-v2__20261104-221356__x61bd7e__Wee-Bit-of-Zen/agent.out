 index = buttons.indexOf(document.activeElement); buttons[(index + direction + buttons.length) % buttons.length].focus();\n}\nfunction memberDefault() { return { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\nfunction beginCheck() { state.check = { phase: 'still', elapsed: 0, directions: new Set(), spine: 25 + Math.floor(Math.random() * 25) }; state.activity = null; screen('check'); }\nfunction startActivity(activity, options = {}) {\n  const selected = { ...activity }, duration = options.seconds || selected.seconds;\n  state.selection = selected;\n  state.activity = { ...selected, seconds: duration, elapsed: 0, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, ringX: 0, ringY: 0, flame: .6, score: 0, samples: 0, stumbles: 0, stun: 0, effort: 0, reps: 0, beatHits: 0, lastBeat: -1, lastJog: '', jogHits: 0, hoopHits: 0, good: 0, tray: 0, lastDirection: 0, motions: 0, rng: seeded(841 + selected.name.length) };\n  mouseLean = null; keys.clear(); toggledBreath = false; screen('play');\n}\nfunction completeActivity() {\n  const activity = state.activity;\n  if (!activity) return;\n  const percent = Math.round(clamp(activity.score / Math.max(1, activity.samples) * 100, 0, 100));\n  const stars = percent >= 90 ? 3 : percent >= 65 ? 2 : percent >= 35 ? 1 : 0;\n  const minutes = Math.max(1, Math.round(activity.seconds / 60 * (1 + stars * .25)));\n  state.result = { percent, stars, minutes, stumbles: activity.stumbles, message: stars >= 2 ? 'You made the wobble look rather elegant.' : 'A little practice is still a lovely thing.' };\n  if (!state.hub.active && !state.classMode) { const member = state.member; member.sessions = (member.sessions || 0) + 1; member.minutes = (member.minutes || 0) + minutes; member.stars[activity.id] = Math.max(member.stars[activity.id] || 0, stars); save(); }\n  tone(523, .3); if (state.hub.active) { state.hub.score += percent * 10; screen('hub'); } else screen('result');\n}\nfunction attemptInput(key) {\n  const activity = state.activity;\n  if (!activity || state.screen !== 'play') return;\n  if (activity.kind === 'step') {\n    const directions = ['arrowleft','arrowup','arrowright','arrowdown'];\n    const aliases = { a:'arrowleft', w:'arrowup', d:'arrowright', s:'arrowdown' };\n    const direction = aliases[key] || key, beat = Math.round(activity.elapsed * 100 / 60), phase = Math.abs(activity.elapsed * 100 / 60 - beat);\n    if (direction === directions[(beat + 4) % 4] && phase < .34 && beat !== activity.lastBeat) { activity.beatHits++; activity.lastBeat = beat; tone(520, .08, .35); }\n  }\n  if (activity.kind === 'jog' && (key === 'j' || key === 'k') && key !== activity.lastJog) { activity.lastJog = key; activity.jogHits++; }\n  if (activity.kind === 'hoop' && (key === 'q' || key === 'e')) { activity.hoopHits++; tone(660, .1, .3); }\n  if ((key === ' ' || key === 'enter') && state.settings.breathToggle) toggledBreath = !toggledBreath;\n}\nconst tuningDefaults = { spring: 11, damping: 6, instability: 1.3, noise: .19 };\nconst tuning = { ...tuningDefaults };\nfunction updateActivity(dt) {\n  const activity = state.activity; if (!activity) return;\n  activity.elapsed += dt;\n  const pad = Array.from(navigator.getGamepads?.() || []).find(Boolean), axisX = pad && Math.abs(pad.axes[0]) > .12 ? pad.axes[0] : 0, axisY = pad && Math.abs(pad.axes[1]) > .12 ? pad.axes[1] : 0;\n  const dx = (keys.has('arrowright') || keys.has('d') ? 1 : 0) - (keys.has('arrowleft') || keys.has('a') ? 1 : 0);\n  const dy = (keys.has('arrowdown') || keys.has('s') ? 1 : 0) - (keys.has('arrowup') || keys.has('w') ? 1 : 0);\n  if (activity.stun <= 0) {\n    if (mouseLean) { activity.ux = mouseLean.x; activity.uy = mouseLean.y; }\n    else if (axisX || axisY) { activity.ux = axisX; activity.uy = axisY; }\n    else { activity.ux = clamp(activity.ux + dx * 2.2 * dt, -1, 1); activity.uy = clamp(activity.uy + dy * 2.2 * dt, -1, 1); if (!dx) activity.ux *= Math.max(0, 1 - .5 * dt); if (!dy) activity.uy *= Math.max(0, 1 - .5 * dt); }\n  } else activity.stun -= dt;\n  const gentle = state.settings.gentle ? .7 : 1, time = activity.elapsed, disturbance = tuning.noise * gentle;\n  const ax = tuning.spring * (activity.ux - activity.px) - tuning.damping * activity.vx + tuning.instability * gentle * activity.px + disturbance * (Math.sin(time * 1.7) + .5 * Math.sin(time * 3.23));\n  const ay = tuning.spring * (activity.uy - activity.py) - tuning.damping * activity.vy + tuning.instability * gentle * activity.py + disturbance * (Math.sin(time * 1.19 + 1) + .5 * Math.sin(time * 2.71));\n  activity.vx += ax * dt; activity.vy += ay * dt; activity.px += activity.vx * dt; activity.py += activity.vy * dt;\n  if (Math.hypot(activity.px, activity.py) >= 1 && activity.stun <= 0) { activity.stumbles++; activity.stun = 1; activity.px *= .5; activity.py *= .5; activity.vx *= -.2; activity.vy *= -.2; tone(196, .18); }\n  const phase = Math.floor(time / 12), rng = seeded(phase * 667 + 43);\n  activity.ringX = activity.id === 'stork' ? (rng() - .5) * .65 : activity.kind === 'slalom' ? Math.sin(time * .55) * .46 : 0;\n  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n  let quality = steadiness;\n  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n  activity.score += quality; activity.samples++;\n  if (state.hub.active) {\n    const now = window.AIHub.time();\n    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n  }\n  if (activity.elapsed >= activity.seconds) completeActivity();\n}\nfunction updateHUD() {\n  const activity = state.activity; if (!activity) return;\n  const timer = document.getElementById('play-timer'), status = document.getElementById('play-status'), instruction = document.getElementById('play-instruction'), progress = document.getElementById('play-progress'), dot = document.getElementById('plate-dot'), ring = document.getElementById('plate-ring'), score = document.getElementById('play-score');\n  if (!timer) return;\n  timer.textContent = Math.max(0, Math.ceil(activity.seconds - activity.elapsed));\n  if (activity.kind === 'step') { const arrows = ['←','↑','→','↓']; const beat = Math.round(activity.elapsed * 100 / 60); status.textContent = `NEXT STEP  ${arrows[(beat + 4) % 4]}   ·   ${activity.beatHits} on beat`; instruction.textContent = `Press ${arrows[(beat + 4) % 4]} on the beat · ${activity.instruction}`; }\n  else if (activity.kind === 'rep') status.textContent = `Rep ${activity.reps + 1} · ${Math.sin(activity.elapsed * Math.PI / 2 - Math.PI / 2) > 0 ? 'Rise gently' : 'Lower gently'}`;\n  else if (activity.kind === 'breath') status.textContent = Math.sin(activity.elapsed * Math.PI / 4) > 0 ? 'Breathe in · hold' : 'Breathe out · release';\n  else if (activity.kind === 'candle') status.textContent = `Flame ${Math.round(activity.flame * 100)}% · ${activity.flame < .15 ? 'settle to relight' : 'let it glow'}`;\n  else if (activity.kind === 'jog') status.textContent = `${activity.jogHits} steps · alternate J and K`;\n  else if (activity.kind === 'hoop') status.textContent = `${activity.hoopHits} catches · circle your lean`;\n  else status.textContent = activity.stun > 0 ? 'A wobble! Take a moment.' : 'Find the ring. Breathe naturally.';\n  progress.style.width = `${clamp(activity.elapsed / activity.seconds * 100, 0, 100)}%`;\n  dot.style.transform = `translate(${activity.px * 70}px, ${activity.py * 70}px)`;\n  ring.style.transform = `translate(${activity.ringX * 70}px, ${activity.ringY * 70}px)`;\n  score.textContent = `${Math.round(activity.score / Math.max(1, activity.samples) * 100)}% STEADY`;\n}\nfunction updateCheckHUD() {\n  if (!state.check) return;\n  const timer = document.getElementById('check-timer'), text = document.getElementById('check-text'), progress = document.getElementById('check-progress');\n  if (!timer) return;\n  timer.textContent = state.check.phase === 'still' ? String(Math.max(0, Math.ceil(5 - state.check.elapsed))).padStart(2, '0') : `${state.check.directions.size}/4`;\n  text.textContent = state.check.phase === 'still' ? 'Find a comfortable center.' : 'Lean left, up, right and down.';\n  progress.style.width = `${state.check.phase === 'still' ? clamp(state.check.elapsed / 5 * 50, 0, 50) : 50 + state.check.directions.size * 12.5}%`;\n}\nfunction update(dt) {\n  state.clock += dt;\n  if (state.screen === 'title') { state.idle += dt; if (state.idle >= 10 && !state.hub.active) screen('attract'); }\n  if (state.screen === 'check') { state.check.elapsed += dt; if (state.check.phase === 'still' && state.check.elapsed >= 5) { state.check.phase = 'lean'; state.check.elapsed = 0; } if (state.check.phase === 'lean' && (state.check.directions.size === 4 || state.check.elapsed >= 14)) screen('question'); }\n  if (state.screen === 'play') updateActivity(dt);\n}\nfunction action(name, id) {\n  unlockAudio(); state.idle = 0; tone(440, .07, .2);\n  switch (name) {\n    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n    case 'slots': screen('slots'); break;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_175","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; sed -n '90,140p' \\\"\"'$D/src/game.js\" | fold -w 180; sed -n '\"'200,230p' \\\"\"'$D/src/game.js\"; sed -n '\"'250,305p' \\\"\"'$D/vendor/session.js\"; sed -n '\"'305,390p' \\\"\"'$D/vendor/session.js\"; sed -n '\"'440,485p' \\\"\"'$D/vendor/session.js\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_175","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; sed -n '90,140p' \\\"\"'$D/src/game.js\" | fold -w 180; sed -n '\"'200,230p' \\\"\"'$D/src/game.js\"; sed -n '\"'250,305p' \\\"\"'$D/vendor/session.js\"; sed -n '\"'305,390p' \\\"\"'$D/vendor/session.js\"; sed -n '\"'440,485p' \\\"\"'$D/vendor/session.js\"'","aggregated_output":"    heading = 'BODY CHECK COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ACCORDING TO TARE</div><div class=\"score-big\">${state.check.spine}</div><h1>Y\nour Spine Age</h1><p>“A completely imaginary number. Your actual spine remains splendid.”</p><p class=\"note\">Today is a fine day to practice being here.</p><div class=\"actions\">${b\nutton('Explore the island', 'island', true)}</div></div></main>`;\n  } else if (state.screen === 'island') {\n    heading = labelDay();\n    const dialogue = CAST[(member.day + member.sessions) % CAST.length];\n    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT\n MINUTES</div><h1>Find your kind of movement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and set\ntle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVIT\nIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div cl\nass=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished ? 'ending' : 'sleep'\n, true)}</div></div></main>`;\n  } else if (state.screen === 'activity') {\n    const activity = state.selection, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activ\nity.icon}</div><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline\n}</p><div class=\"divider\"></div><h3>How to play</h3><p>${activity.instruction}</p><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle\n mode is on.' : 'Make small, comfortable movements.'}</p><div class=\"actions\">${button('Back to island', state.classMode ? 'class' : 'island')}${button('Begin practice', 'start-act\nivity', true)}</div></div></main>`;\n  } else if (state.screen === 'play') {\n    const activity = state.activity, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2>\n<p id=\"play-status\">Find your center.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balan\nce-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"pla\ny-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span id=\"play-progress\"></span></div><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE S\nTART</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\n  } else if (state.screen === 'result') {\n    const result = state.result;\n    heading = 'SESSION COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue result-card\"><div class=\"eyebrow\">✳ &nbsp; PRACTICE COMPLETE</div><div class=\"stars-big\">${'★'.repeat(result\n.stars)}<span>${'☆'.repeat(3 - result.stars)}</span></div><h1>Lovely work${state.classMode ? ', everyone' : ''}.</h1><p>“${result.message}”</p><div class=\"result-stats\"><div><stron\ng>${result.percent}%</strong><small>STEADINESS</small></div><div><strong>+${result.minutes}</strong><small>FIT MINUTES</small></div><div><strong>${result.stumbles}</strong><small>W\nOBBLES</small></div></div><div class=\"actions\">${button('Practice again', 'retry')}${button(state.festival ? 'Continue the Games' : state.classMode ? 'Class results' : 'Back to isl\nand', 'result-continue', true)}</div></div></main>`;\n  } else if (state.screen === 'recap') {\n    heading = 'DAY COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ANOTHER DAY WELL SPENT</div><h1>Rest is part of it.</h1><p>“${member.sessions\n} sessions today. Gerald the ceramic hippo has made a careful note.”</p><div class=\"result-stats\"><div><strong>${Math.floor(member.minutes)}</strong><small>FIT MINUTES</small></div\n><div><strong>${Object.keys(member.stars || {}).length}</strong><small>MATS VISITED</small></div></div><div class=\"actions\">${button('Wake up to day ' + (member.day + 1), 'next-day\n', true)}</div></div></main>`;\n  } else if (state.screen === 'festival') {\n    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Thre\ne friendly challenges, ending in the Grand Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; $\n{['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"actions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n  } else if (state.screen === 'ending') {\n    heading = 'THANK YOU FOR STAYING';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little st\neadier.<br><em>A lot more you.</em></h1><p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for fiv\ne days of moving, breathing, and making room. The mats are yours whenever you wish.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits'\n, 'about')}</div></div></main>`;\n  } else if (state.screen === 'class') {\n    heading = 'LOCAL CLASS';\n    const players = state.classPlayers;\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same\n screen. One keyboard player; connect controllers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot\n-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHTML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].t\nype) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ? 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div \nclass=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selection?.id === id ? 'sel\nected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.na\nme === 'Guest' ? 'home' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n  } else if (state.screen === 'class-result') {\n    heading = 'LOCAL CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind \nof gold star.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, stat\ne.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\n  } else if (state.screen === 'settings') {\n    heading = 'SETTINGS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div cl\nass=\"card settings-card\">${settingRow('Music', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${setting\nRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${settingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Brea\nthing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.tips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controll\ner symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving.</p><div class=\"act\nions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n  } else if (state.screen === 'pause') {\n    heading = 'PAUSED';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\"\n>${button('Resume', 'resume', true)}${button('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.ac\ntive ? '' : button('Leave session', 'leave-play')}</div></div></main>`;\n  } else if (state.screen === 'dev') {\n    heading = 'DEVELOPER MODE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the wobble.</h1>${[['spring','Spring',4,20,.\n5],['damping','Damping',1,12,.5],['instability','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output \nid=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"acti\nons\">${button('Reset tuning', 'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n  } else if (state.screen === 'about') {\n    heading = 'ABOUT & CREDITS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card scroll\"><div class=\"eyebrow\">✳ &nbsp; A LITTLE NOTE FROM THE MAKERS</div><h1>About & credits.</h1><p>Made with care f\nor everyone who has ever wobbled.</p>${aboutContent()}<div class=\"actions\">${button('Back', 'about-back', true)}</div></div></main>`;\n  } else if (state.screen === 'hub') {\n    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A\n little steadiness, shared.'}</h1><p>${state.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; every\none gets a moment to breathe.'}</p><div class=\"result-stats\"><div><strong>${Math.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.starte\nd ? 'The class is underway.' : 'Waiting for the other guests…'}</p></div></main>`;\n  }\n  app.innerHTML = shell(content, heading, state.screen !== 'play' && state.screen !== 'check');\n  if (state.screen === 'play') updateHUD();\n  if (state.screen === 'check') updateCheckHUD();\n  const phase = Math.floor(time / 12), rng = seeded(phase * 667 + 43);\n  activity.ringX = activity.id === 'stork' ? (rng() - .5) * .65 : activity.kind === 'slalom' ? Math.sin(time * .55) * .46 : 0;\n  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n  let quality = steadiness;\n  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n  activity.score += quality; activity.samples++;\n  if (state.hub.active) {\n    const now = window.AIHub.time();\n    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n  }\n  if (activity.elapsed >= activity.seconds) completeActivity();\n}\nfunction updateHUD() {\n  const activity = state.activity; if (!activity) return;\n  const timer = document.getElementById('play-timer'), status = document.getElementById('play-status'), instruction = document.getElementById('play-instruction'), progress = document.getElementById('play-progress'), dot = document.getElementById('plate-dot'), ring = document.getElementById('plate-ring'), score = document.getElementById('play-score');\n  if (!timer) return;\n  timer.textContent = Math.max(0, Math.ceil(activity.seconds - activity.elapsed));\n  if (activity.kind === 'step') { const arrows = ['←','↑','→','↓']; const beat = Math.round(activity.elapsed * 100 / 60); status.textContent = `NEXT STEP  ${arrows[(beat + 4) % 4]}   ·   ${activity.beatHits} on beat`; instruction.textContent = `Press ${arrows[(beat + 4) % 4]} on the beat · ${activity.instruction}`; }\n    }\n    if (m.type === 'fullscreen') {\n      fullscreenOn = m.on === true;\n      try {\n        root.document.dispatchEvent(new root.Event('fullscreenchange'));\n      } catch (e) {}\n      return;\n    }\n    if (!welcomed || ended) return;\n    if (m.type === 'start') {\n      goAt = now() + Number(m.in || 0);\n      emit('start', [{ in: Number(m.in || 0) }]);\n    } else if (m.type === 'message') {\n      emit('message', [m.data, m.from]);\n    } else if (m.type === 'leave') {\n      hub.players = hub.players.filter(function (p) {\n        return p.id !== m.id;\n      });\n      emit('leave', [{ id: m.id, reason: m.reason }]);\n    } else if (m.type === 'time-up') {\n      emit('time-up', [{ graceMs: m.graceMs }]);\n    } else if (m.type === 'end') {\n      ended = true;\n      if (progressTimer) clearTimeout(progressTimer);\n      emit('end', [{ reason: m.reason, standings: m.standings || null }]);\n    } else {\n      // An event this client has never heard of: hand it on as it came.\n      var detail = {};\n      for (var k in m) if (own(m, k) && k !== 'aihub' && k !== 'type') detail[k] = m[k];\n      emit(m.type, [detail]);\n    }\n  }\n\n  function info() {\n    var out = {};\n    for (var key in hub) if (own(hub, key) && typeof hub[key] !== 'function' && !KEEP[key]) out[key] = hub[key];\n    out.players = hub.players.slice();\n    return out;\n  }\n\n  /** Join the session. Resolves with the round's info, or null when there is no hub: play normally. */\n  hub.connect = function (opts) {\n    if (connecting) return connecting.promise;\n    var done;\n    var promise = new Promise(function (resolve) {\n      done = resolve;\n    });\n    connecting = { promise: promise, resolve: done };\n    if (!hub.active) {\n      done(null);\n      return promise;\n    }\n    opts = opts || {};\n    root.addEventListener('message', onMessage);\n    var started = now();\n    var hello = function () {\n    var hello = function () {\n      if (welcomed) return;\n      if (now() - started > HELLO_TIMEOUT_MS) {\n        standAlone();\n        warn('no hub answered; playing normally');\n        done(null);\n        return;\n      }\n      post('hello', { v: 1, client: VERSION, mode: opts.mode || null, seats: opts.seats || null, card: opts.card === true });\n      setTimeout(hello, HELLO_EVERY_MS);\n    };\n    hello();\n    return promise;\n  };\n\n  /** Everything is loaded: at once when info.splash, otherwise from the player's ready gesture. */\n  hub.ready = function () {\n    if (!welcomed || sentReady || ended) return;\n    sentReady = true;\n    post('ready', {});\n  };\n\n  /** On the game's own card (connect({ card: true })): this player is 'ready', or asks for 'more' time (again takes it back). */\n  hub.answer = function (what) {\n    if (!welcomed || ended || goAt !== null) return;\n    if (what !== 'ready' && what !== 'more') return warn('answer is ready or more');\n    post('answer', { answer: what });\n  };\n\n  hub.on = function (type, fn) {\n    (handlers[type] = handlers[type] || []).push(fn);\n    if (pending[type] && !pending[type].flushing) {\n      pending[type].flushing = true;\n      setTimeout(function () {\n        var queued = pending[type];\n        delete pending[type];\n        for (var i = 0; i < queued.length; i++) emit(type, queued[i]);\n      });\n    }\n    return function () {\n      var list = handlers[type] || [];\n      var at = list.indexOf(fn);\n      if (at !== -1) list.splice(at, 1);\n    };\n  };\n\n  /** Send JSON data to every other player, or to one with {to: id}. {reliable: false} may drop or reorder. */\n  hub.send = function (data, opts) {\n    if (!welcomed || ended) return false;\n    opts = opts || {};\n    var text;\n    try {\n      text = JSON.stringify(data);\n    } catch (e) {\n      warn('send: data is not JSON');\n      return false;\n    }\n    if (text === undefined) return false;\n    if (text.length > limits.maxBytes) {\n      warn('send: message over ' + limits.maxBytes + ' bytes dropped');\n      return false;\n    }\n    var t = now();\n    tokens = Math.min(limits.burst, tokens + ((t - refilled) / 1000) * limits.ratePerS);\n    refilled = t;\n    if (tokens < 1) {\n      warn('send: over ' + limits.ratePerS + ' messages a second, dropped');\n      return false;\n    }\n    tokens -= 1;\n    var fields = { data: JSON.parse(text), reliable: opts.reliable !== false };\n    if (opts.to !== undefined && opts.to !== null) fields.to = opts.to;\n    post('send', fields);\n    return true;\n  };\n\n  /** Milliseconds since the synchronized start: negative during the countdown, -Infinity before start. */\n  hub.time = function () {\n    return goAt === null ? -Infinity : now() - goAt;\n  };\n\n  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n  hub.rng = function (label) {\n    var h = 2166136261;\n    var s = String(label === undefined ? '' : label);\n    for (var i = 0; i < s.length; i++) {\n    if (!welcomed || ended || reported) return;\n    if (!hub.isHost) return warn('finish is for the host only');\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n    reported = true;\n    post('finish', fields);\n  };\n\n  function sendProgress() {\n    progressTimer = null;\n    if (!nextProgress || ended || reported) return;\n    lastProgress = now();\n    post('progress', nextProgress);\n    nextProgress = null;\n  }\n\n  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n  hub.progress = function (p) {\n    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n    nextProgress = { score: Number(p.score) };\n    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n    if (wait <= 0) sendProgress();\n    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n  };\n\n  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n  hub.probe = function (fn) {\n    probeFn = typeof fn === 'function' ? fn : null;\n  };\n\n  hub.inspect = function () {\n    if (!probeFn) return null;\n    try {\n      return JSON.parse(JSON.stringify(probeFn()));\n    } catch (e) {\n      return { error: String((e && e.message) || e) };\n    }\n  };\n\n  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n  hub.fail = function (message) {\n    if (!hub.active) return;\n    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n  };\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_176","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; sed -n '110,140p' \\\"\"'$D/src/game.js\" | fold -w 220; sed -n '\"'100,180p' \\\"\"'$D/src/art.js\"; sed -n '\"'1,100p' \\\"\"'$D/vendor/mocap.js\" | head -70; head -c 350 \"$D/vendor/fitclips.js\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_176","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; sed -n '110,140p' \\\"\"'$D/src/game.js\" | fold -w 220; sed -n '\"'100,180p' \\\"\"'$D/src/art.js\"; sed -n '\"'1,100p' \\\"\"'$D/vendor/mocap.js\" | head -70; head -c 350 \"$D/vendor/fitclips.js\"'","aggregated_output":"    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Three friendly challenges, ending in the Gra\nnd Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"\nactions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n  } else if (state.screen === 'ending') {\n    heading = 'THANK YOU FOR STAYING';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little steadier.<br><em>A lot more you.</em></h1>\n<p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for five days of moving, breathing, and making room. The mats are yours whenever you wi\nsh.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits', 'about')}</div></div></main>`;\n  } else if (state.screen === 'class') {\n    heading = 'LOCAL CLASS';\n    const players = state.classPlayers;\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect co\nntrollers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHT\nML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ?\n 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selecti\non?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.name === 'Guest' ? 'ho\nme' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n  } else if (state.screen === 'class-result') {\n    heading = 'LOCAL CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.ma\np((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"\nactions\">${button('Back to class', 'class', true)}</div></div></main>`;\n  } else if (state.screen === 'settings') {\n    heading = 'SETTINGS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card settings-card\">${settingRow('M\nusic', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${se\nttingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.t\nips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving\n.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n  } else if (state.screen === 'pause') {\n    heading = 'PAUSED';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', true)}${bu\ntton('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', 'leave-play')}</div></div></main>`;\n  } else if (state.screen === 'dev') {\n    heading = 'DEVELOPER MODE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the wobble.</h1>${[['spring','Spring',4,20,.5],['damping','Damping',1,12,.5],['insta\nbility','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output id=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" \nmin=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"actions\">${button('Reset tuning', 'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n  } else if (state.screen === 'about') {\n    heading = 'ABOUT & CREDITS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card scroll\"><div class=\"eyebrow\">✳ &nbsp; A LITTLE NOTE FROM THE MAKERS</div><h1>About & credits.</h1><p>Made with care for everyone who has ever wobbled.</p>${a\nboutContent()}<div class=\"actions\">${button('Back', 'about-back', true)}</div></div></main>`;\n  } else if (state.screen === 'hub') {\n    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A little steadiness, shared.'}</h1><p>${s\ntate.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; everyone gets a moment to breathe.'}</p><div class=\"result-stats\"><div><strong>${Math\n.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.started ? 'The class is underway.' : 'Waiting for the other guests…'}</p></div></main>`;\n  }\n  app.innerHTML = shell(content, heading, state.screen !== 'play' && state.screen !== 'check');\n  if (state.screen === 'play') updateHUD();\n  if (state.screen === 'check') updateCheckHUD();\n  const width = artWidth, height = artHeight, time = state.clock || 0;\n  context.clearRect(0, 0, width, height);\n  drawScenery(time);\n  const compact = width < 700;\n  const active = state.screen === 'play' || state.screen === 'check';\n  const cx = compact ? width * .52 : active ? width * .5 : width * .73;\n  const cy = active ? height * .76 : compact ? height * .46 : height * .68;\n  const size = Math.min(width * (compact ? .63 : .30), height * .52);\n  ellipse(cx, cy + size * .19, size * 1.05, size * .28, '#a9cfb5');\n  ellipse(cx, cy + size * .13, size, size * .26, '#d5e7c4');\n  ellipse(cx, cy + size * .07, size * .91, size * .2, '#e9efd4');\n  drawTree(cx - size * .7, cy - size * .1, size * .42);\n  drawTree(cx + size * .72, cy - size * .08, size * .3);\n  if (!active) {\n    rounded(cx - size * .37, cy - size * .39, size * .53, size * .32, size * .025, '#fff9e9');\n    context.fillStyle = '#dfaa88'; context.beginPath(); context.moveTo(cx - size * .43, cy - size * .39); context.lineTo(cx - size * .11, cy - size * .58); context.lineTo(cx + size * .21, cy - size * .39); context.closePath(); context.fill();\n    rounded(cx - size * .12, cy - size * .29, size * .11, size * .2, size * .012, '#9ec6b2');\n    rounded(cx - size * .31, cy - size * .29, size * .12, size * .1, size * .01, '#b4ddd2');\n    ellipse(cx + size * .28, cy + size * .02, size * .31, size * .09, '#a4cfc1');\n    drawPerson(cx + size * .27, cy, size * .6, { time, movement: Math.sin(time * 1.2) * .2 });\n    drawTare(cx + size * .58, cy + size * .08, size * .24, true);\n    for (let index = 0; index < 5; index++) ellipse(cx - size * .6 + index * size * .07, cy + size * .12, 3, 3, index % 2 ? '#f6c888' : '#fff8e5');\n  } else {\n    const activity = state.activity;\n    const lean = activity ? activity.px : 0;\n    const movement = activity ? Math.sin(activity.elapsed * (activity.kind === 'jog' ? 5 : 2)) * .6 : 0;\n    ellipse(cx, cy + size * .05, size * .55, size * .12, '#a5d2bf');\n    drawPerson(cx, cy, size * .95, { time, lean, movement, shirt: state.shirt });\n    drawTare(cx + size * .55, cy + size * .06, size * .22, false);\n    if (activity && activity.kind === 'candle') {\n      rounded(cx - size * .65, cy - size * .14, size * .11, size * .16, 4, '#fffaf0');\n      ellipse(cx - size * .595, cy - size * .16, size * .035, size * (.055 + activity.flame * .06), '#f7c05b');\n    }\n    if (activity && activity.kind === 'hoop') {\n      context.strokeStyle = '#f5ae80'; context.lineWidth = size * .035; context.beginPath(); context.ellipse(cx, cy - size * .35, size * .36, size * .09, -.08, 0, Math.PI * 2); context.stroke();\n    }\n    if (activity && activity.kind === 'tray') {\n      line(cx - size * .38, cy - size * .49, cx + size * .38, cy - size * .49 + lean * size * .1, size * .045, '#bb8b6d');\n      ellipse(cx, cy - size * .52, size * .06, size * .035, '#849e67');\n    }\n  }\n}\n/* =============================================================================\n * MOCAP  plays animation sets in the readable format (src/mocap/readable.js; written by tools/anim-import.mjs) on\n * my-3D2dge rigs.\n *   const lib = Mocap.load(window.MOCAP.QUATERNIUS);   // a set: its clips, and the bodies they were measured on\n *   const clip = lib.clip('Dance_Loop');               // { name, dur, loop, tags, desc, keys }\n *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n *   const man = new Mocap.Mannequin(lib, { height: 34 });  man.draw(g, ox, oy, view, pose, facing)\n *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n *     window.Mocap.)\n *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n *     only the chest, head and arms over the rig's own legs (an interaction while walking); humanoid.mocapBlade = true\n *     while the clip holds a sword (the blade follows the fist).\n * Points are in the rig's local frame: f = forward, r = right, z = up, centred on the root on the ground.\n * ============================================================================= */\nconst Mocap = (() => {\n'use strict';\nconst E = My3D2dge, { px } = E, MR = MocapReadable;\n\n/* ---- sets ---- */\n/**\n * Every clip is rebuilt on the first library's proportions (the format does not depend on size); each keeps how its own\n * library bends the spine, since the key poses were measured that way.\n */\nfunction load(set) {\n  const P = MR.P, idx = MR.IDX, ids = Object.keys(set.sources), base = set.sources[ids[0]].rest, rests = {};\n  for (const id of ids) rests[id] = Object.assign({}, base, { spineW: set.sources[id].rest.spineW, neckW: set.sources[id].rest.neckW });\n  const meta = c => ({ name: c.clip, fps: set.fps, n: Math.round(c.dur * set.fps) + 1 }), clips = {};\n  for (const [name, c] of Object.entries(set.clips)) clips[name] = Object.assign(meta(Object.assign({ clip: name }, c)), c);\n  const restOf = c => rests[c.src] || base;\n  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n  lib.clip = name => clips[name] || null;\n  /** the pose at time t (seconds): key poses in-betweened, loops wrap, one-shots hold their last pose */\n  lib.sample = (clip, t, out = new Float32Array(P * 3)) => { MR.pose(restOf(clip), clip, t, out); out.src = clip.src; return out; };   // (src: whose rest it is measured against)\n  /** a clip that travels: how far it has carried the body at time t ([forward, right] mm), or null */\n  lib.moveAt = (clip, t) => MR.moveAt(restOf(clip), clip, t);\n  /** swap in an edited clip (readable text a person or a model changed); the original is kept for restore() */\n  const originals = {};\n  lib.replace = (name, edited) => { if (!originals[name]) originals[name] = clips[name]; clips[name] = Object.assign({}, originals[name], edited, { name, keys: edited.keys }); return clips[name]; };\n  lib.restore = name => { if (originals[name]) { clips[name] = originals[name]; delete originals[name]; } return clips[name]; };\n  lib.edited = name => !!originals[name];\n  /** the clip as the text a model reads (its header and its key poses) */\n  lib.text = clip => { const o = { clip: clip.clip || clip.name }; for (const k of ['src', 'take', 'orig', 'dur', 'loop', 'tags', 'desc']) if (clip[k] !== undefined) o[k] = clip[k]; o.keys = clip.keys; return MR.text(o); };\n  /** where a clip came from: its library's label, origin and license (from the set's sources), the clip it was made from,\n   *  and (a capture database's) the take and the stretch of it: '13_29 2.30-3.42' */\n  lib.origin = clip => { const s = set.sources[clip.src] || {}; return { src: clip.src, label: s.label || clip.src, origin: s.origin || '', license: s.license || '', url: s.url || '', orig: clip.orig || null, take: clip.take || null }; };\n  /** a pose blended from a to b (crossfades between clips) */\n  lib.blend = (a, b, k, out = new Float32Array(P * 3)) => { for (let i = 0; i < P * 3; i++) out[i] = a[i] + (b[i] - a[i]) * k; out.src = (k < .5 ? a : b).src; return out; };\n  lib.pt = (pose, name) => { const i = idx[name] * 3; return [pose[i], pose[i + 1], pose[i + 2]]; };\n  lib.error = MR.error;\n  return lib;\n}\n\n/* ---- the look-alike mannequin: shaded capsules in the source model's proportions, with its joint bands ---- */\nconst lerp3 = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\nconst add3 = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];\nconst sub3 = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\nconst norm3 = a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\nclass Mannequin {\n  /** o: { height: world units tall (34), main: '#e8aa3a', joint: '#aa66db' } (the colors of the source model's two materials) */\n  constructor(lib, o = {}) {\n    this.lib = lib; this.o = Object.assign({ height: 34, main: '#e8aa3a', joint: '#aa66db' }, o);\n    this.k = this.o.height / ((lib.body && lib.body.height) || 1829);   // world units per mm\n    this._ops = [];\n  }\n  /**\n   * draw the pose into g with (ox, oy) = the projected root. Every part is a capsule between two body points,\n   * sorted by true camera depth, drawn dark-then-lit like the engine's HD rigs.\n   */\n  draw(g, ox, oy, view, pose, facing = 0) {\n    const L = this.lib, o = this.o, k = this.k, ca = Math.cos(facing), sa = Math.sin(facing), sc = view.scale;\n/* FITCLIPS: an animation set in my-3D2dge's readable format (written by the tools in tools/; clips may be edited by hand).\n * Mesh2Motion (CC0), Quaternius (CC0), CMU Graphics Lab Motion Capture Database (free for all uses)\n * 23 clips, 560 key poses. Played by src/mocap/mocap.js with src/mocap/readable.js. \"sources\" holds the proportions\n * each ","exit_code":0,"status":"completed"}}
