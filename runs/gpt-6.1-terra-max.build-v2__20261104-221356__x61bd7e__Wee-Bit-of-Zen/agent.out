tions to pause.\",\n    \"tags\": [\"2d\", \"sports\", \"simulation\", \"comedy\", \"story\", \"versus\"]\n  }\n}\n:root{color-scheme:light;--ink:#263d42;--muted:#708485;--teal:#248e8b;--line:#d9e9e2;--paper:#fffefa;--sun:#f8cc76;--shadow:0 18px 50px rgba(41,78,72,.12)}\n*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden}body{font-family:ui-rounded,\"Avenir Next\",Avenir,\"Trebuchet MS\",sans-serif;background:#e9f4ed;colo\nr:var(--ink);-webkit-font-smoothing:antialiased}button,input,select{font:inherit}button{color:inherit;cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible{o\nutline:4px solid #f3bb5d;outline-offset:3px}#world{position:fixed;inset:0;width:100%;height:100%;display:block}#app{position:fixed;inset:0;overflow:auto;scrollbar-width:thin}#app:e\nmpty{pointer-events:none}.page{min-height:100%;padding:clamp(20px,4vw,64px);display:flex;flex-direction:column;position:relative}.topbar{display:flex;justify-content:space-between;\nalign-items:center;gap:15px;z-index:2}.brand{font-weight:900;letter-spacing:.15em;text-transform:uppercase;font-size:clamp(10px,.9vw,13px);display:flex;align-items:center;gap:10px}\n.brand-mark{display:grid;place-items:center;background:var(--teal);color:white;border-radius:50%;width:30px;height:30px;font-size:17px;letter-spacing:0}.top-actions{display:flex;ga\np:8px}.icon-btn,.small-btn{border:1px solid rgba(72,116,105,.18);background:rgba(255,255,250,.83);border-radius:999px;box-shadow:0 4px 12px rgba(42,72,64,.05);font-weight:800;paddi\nng:11px 17px}.icon-btn:hover,.small-btn:hover{background:#fff;transform:translateY(-2px)}.hero{flex:1;display:flex;align-items:center;min-height:0}.hero-copy{width:min(50%,620px);p\nadding:28px 0 54px}.eyebrow{font-size:12px;font-weight:900;letter-spacing:.19em;text-transform:uppercase;color:#5b9186}.eyebrow:before{content:'';display:inline-block;width:25px;he\night:2px;background:#8fb9a5;vertical-align:middle;margin-right:10px}.logo{font-size:cl