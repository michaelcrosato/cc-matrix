 === 'still' && state.check.elapsed >= 5) { state.check.phase = 'lean'; state.check.elapsed = 0; } if (state.check.phase === 'lean' && (state.check.directions.size === 4 || state.check.elapsed >= 14)) screen('question'); }\n  if (state.screen === 'play') updateActivity(dt);\n}\n134:  } else if (state.screen === 'hub') {\n(window.MOCAP = window.MOCAP || {})[\"FITCLIPS\"] = {\n24:function load(set) {\n28:  for (const [name, c] of Object.entries(set.clips)) clips[name] = Object.assign(meta(Object.assign({ clip: name }, c)), c);\n42:  lib.text = clip => { const o = { clip: clip.clip || clip.name }; for (const k of ['src', 'take', 'orig', 'dur', 'loop', 'tags', 'desc']) if (clip[k] !== undefined) o[k] = clip[k]; o.keys = clip.keys; return MR.text(\n","exit_code":0,"status":"completed"}}
