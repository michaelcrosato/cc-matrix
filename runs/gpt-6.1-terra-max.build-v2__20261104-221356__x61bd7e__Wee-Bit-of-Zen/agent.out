ckground:#fbfdf9;font-size:17px;letter-spacing:0;text-transform:none}.options{display:flex;flex-wrap:wrap;gap:8px}.option{border:2px solid #e6eee6;border-radius:13px;padding:10px 14px;background:#f8fbf8;font-weight:800}.option.selected{border-color:#63b2a0;background:#e7f7ec}.dialogue{background:#eef8f2;border-radius:20px;padding:18px 20px;color:#42665c;font-size:18px;line-height:1.45}.dialogue strong{color:#278f82}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.actions .action{min-width:160px}.play-hud{position:absolute;inset:0;pointer-events:none;padding:clamp(18px,3vw,40px);display:flex;flex-direction:column;justify-content:space-between}.play-hud button{pointer-events:auto}.hud-top,.hud-bottom{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.hud-box{background:rgba(255,255,250,.92);border:1px solid rgba(255,255,255,.8);border-radius:20px;padding:14px 20px;box-shadow:0 9px 28px rgba(44,83,75,.09)}.hud-box strong{font-size:20px;letter-spacing:-.03em}.hud-box small{display:block;font-size:11px;color:#79938a;text-transform:uppercase;letter-spacing:.12em;font-weight:900;margin-bottom:3px}.meter{height:9px;width:180px;border-radius:20px;background:#e5efe6;overflow:hidden;margin-top:8px}.meter>i{display:block;height:100%;background:#efba68;border-radius:20px}.play-instruction{text-align:center;align-self:center;background:rgba(255,255,250,.91);border-radius:999px;padding:12px 20px;font-weight:800;color:#57776c;box-shadow:var(--shadow)}.progress-dots{display:flex;gap:6px}.progress-dots i{width:9px;height:9px;border-radius:50%;background:#dcebe2}.progress-dots i.on{background:#4cae9c}.score-big{font-size:clamp(48px,7vw,76px);font-weight:900;letter-spacing:-.07em;color:#2b9991;line-height:1}.stars-big{font-size:30px;color:#efb956;letter-spacing:5px}.note{font-size:13px!important;color:#91a39b!important}.scroll{max-height:min(57vh,570px);overflow:auto;padding-right:8px}.about-group{border-top:1px solid #e7efe9;padding:12px 0}.about-group h3{font-size:18px}.about-group p{font-size:14px;margin:5px 0;overflow-wrap:anywhere}.touch-notice{position:fixed;inset:0;z-index:20;display:grid;place-items:center;padding:20px;background:rgba(230,244,236,.92);text-align:center}.touch-notice .card{width:min(100%,460px)}.hidden{display:none!important}.toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:#284e49;color:#fff;border-radius:99px;padding:12px 22px;z-index:10;font-weight:800}.class-players{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.player-tile{padding:18px;background:#f2f8f1;border-radius:18px;text-align:center}.player-tile .face{font-size:35px}.slider{width:100%;accent-color:#38a597}.island-message{position:absolute;top:12%;left:50%;transform:translateX(-50%);text-align:center;white-space:nowrap;pointer-events:none}.island-message h1{font-size:clamp(24px,3.2vw,40px);margin:6px;letter-spacing:-.04em}.island-message p{margin:0;color:#708e82;font-weight:700}.map-actions{position:absolute;bottom:clamp(20px,4vh,45px);left:50%;transform:translateX(-50%);width:min(92%,760px);display:flex;justify-content:center;gap:10px}.map-actions .action{min-width:180px}.map-actions button{pointer-events:auto}.center-copy{text-align:center}.center-copy p{max-width:580px;margin-left:auto;margin-right:auto}\n@media(max-width:850px){.hero-copy{width:58%}.logo{font-size:clamp(48px,8vw,72px)}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.footer .weather{display:none}.card{padding:26px}.main-wrap{align-items:flex-start;padding:25px 0}.page{min-height:100%;padding:22px}.play-hud{padding:16px}.island-message{top:12%}}\n@media(max-width:540px){.page{padding:18px}.hero{align-items:flex-end}.hero-copy{width:100%;padding:30px 0 20px}.logo{font-size:58px;max-width:320px;margin:12px 0}.lede{font-size:16px;max-width:315px;margin-bottom:18px}.menu-stack{width:100%;max-width:340px}.action{padding:13px 16px;font-size:15px;border-radius:15px}.brand{font-size:10px}.footer{font-size:9px}.card-grid,.split{grid-template-columns:1fr}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.activity{padding:10px;min-height:92px}.activity-icon{width:34px;height:34px;font-size:18px}.activity strong{font-size:13px}.activity small{font-size:11px}.card h1{font-size:34px}.card p{font-size:15px}.hud-box{padding:10px 12px}.hud-box strong{font-size:16px}.meter{width:110px}.play-instruction{font-size:12px;max-width:90%;padding:10px 14px}.class-players{grid-template-columns:repeat(2,1fr)}.map-actions .action{min-width:0;flex:1}.map-actions{width:90%}.scroll{max-height:55vh}}\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\n\nDo not use overly dense, web-style data screens.\n\nTouch-only devices: no touch controls; show \"Controller or keyboard required\" and the settings button. Let the attract mode run.\n\n## Done\nNo TODOs, placeholders, or stubbed features. The demo is complete.\n\n## Source Information\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \"unknown\" for anything you can't confirm.\n- Date: 2026-11-04 22:13:56\n- Source: the work it's based on\n- Plan: the file name of the plan you were given to build from, or none\n- Genre and Perspective: genre and camera perspective used\n- Tech: stack, libraries/engines, with versions if applicable\n- Art Direction: style used\n- Animation: system used\n- Audio: music, sound effects and voice used\n- Online: network features used, or none\n- Testing: testing parameters allowed\n- Research: research done, or none\n- Environment: Codex CLI (headless); Linux\n- Model: OpenAI, gpt-6.1-terra, reasoning effort max\n- Usage: write \"added on import\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\n\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\"unknown\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\n{\n  \"sourceInformation\": {\"date\": \"\", \"source\": \"\", \"plan\": \"\", \"genre\": \"\", \"perspective\": \"\", \"tech\": \"\", \"artDirection\": \"\", \"animation\": \"\", \"audio\": \"\", \"online\": \"\", \"testing\": \"\", \"research\": \"\", \"environment\": \"\", \"model\": \"\", \"usage\": \"added on import\"},\n  \"testingFeedback\": [\"your answer to each Testing Feedback question, in order\"],\n  \"engineFeedback\": [\"your answer to each Engine Feedback question, in order\"],\n  \"promptFeedback\": [\"your answer to each Prompt Feedback question, in order\"],\n  \"aiHub\": {\n    \"name\": \"the game's title, as on its title screen\",\n    \"tagline\": \"a few words to go under the title\",\n    \"description\": \"one or two sentences for the catalogue\",\n    \"type\": \"Game, Tech demo or Tool\",\n    \"genre\": \"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\",\n    \"source\": \"the work it's based on, e.g. Moby-Dick\",\n    \"series\": \"its franchise, e.g. Star Fox, or empty\",\n    \"players\": \"how many can play: 1, 1–2 or 1–4\",\n    \"controls\": \"the controls, in one line\",\n    \"tags\": [\"3 to 6 lowercase tags, e.g. 2d, 3d, arcade, story, co-op, versus, first-person, third-person, top-down, side-scrolling, pixel art, low-poly, retro, sci-fi, fantasy, comedy, vehicles, boss fights, exploration\"]\n  }\n}\nThe catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\n\nTesting Feedback\n\n- How many issues did testing catch?\n- How many would be considered critical issues / game breaking?\n- What was the most helpful test you ran?\n- What was the least helpful test you ran?\n\nEngine Feedback\n\n- What did you like most about the engine?\n- Did you get stuck or guess wrong?\n- What was the most important thing you had to build yourself?\n- What was the hardest part about using the engine?\n- What did you change in the engine, and why? (none if nothing)\n- If you could change one thing about the engine, what would it be?\n\nPrompt Feedback\n\n- What did you like most about this prompt?\n- What was confusing?\n- What was the hardest thing to do?\n- What would you change in this prompt?\n2308:class Game {\n2725:  start(hooks) {\n2842:  advance(seconds = this.o.step, o = {}) {\n4906:  start(canCancel = false) {\n10670:  start(players = 1, o = {}) {\n13240:  start() { this.reset(); this.game.audio.music(this.song, { sync: true, restart: true, loop: false }); this.started = true; }\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n310:const lib = Mocap.load(window.MOCAP.FITCLIPS);\n311:function makeRig(opts) {\n312:  const rig = new E.Humanoid(Object.assign({ weapon: null }, opts));\n314:  const base = rig.solvePose;         // then our layer: a hand-posed body, then the wobble\n316:  rig.solvePose = function () {\n544:  rigs.js      makeRig, setBody and moves, Tare, Gerald, joints, cast\n624:| M1 | Lean, intent, devices, bots, Plate; `makeRig`; Tare and voice; studio scene; **Stork Stand** with Card and Results | Feels good on stick, keys and mouse. Bands hold. **Stop and tune here: it is the whole game** |\n","exit_code":0,"status":"completed"}}
