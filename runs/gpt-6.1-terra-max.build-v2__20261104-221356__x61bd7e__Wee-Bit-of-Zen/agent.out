{"type":"item.completed","item":{"id":"item_579","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; sed -n '1,160p' \\\"\"'$D/src/game.js\"; cat \"$D/src/style.css\"; cat \"$D/src/extra.css\"'","aggregated_output":"'use strict';\n\nconst app = document.getElementById('app');\nconst STORAGE = 'wee-bit-of-zen-v1';\nconst DEFAULT_SETTINGS = { music: 10, sound: 10, voice: true, gentle: false, breathToggle: false, tips: true, glyphs: 'PlayStation' };\nlet stored;\ntry { stored = JSON.parse(localStorage.getItem(STORAGE) || '{}'); } catch (_) { stored = {}; }\nconst state = {\n  screen: 'title', clock: 0, idle: 0, input: 'keyboard', settings: { ...DEFAULT_SETTINGS, ...(stored.settings || {}) },\n  slots: Array.isArray(stored.slots) ? stored.slots : [null, null, null], slot: 0, member: null,\n  selection: null, activity: null, returnScreen: 'title', check: null, toast: '', classPlayers: [],\n  festival: false, festivalIndex: 0, hub: { active: !!window.AIHub?.active, started: false, finished: false, score: 0, lastSend: 0, lastProgress: 0, ghosts: {} }\n};\nwhile (state.slots.length < 3) state.slots.push(null);\nconst keys = new Set();\nlet mouseLean = null, lastFrame = 0, lastHud = 0, audioContext = null, nextMusic = 0, gamepadPrevious = [];\nlet toggledBreath = false, pausedFrom = null;\n\nfunction save() {\n  if (state.hub.active) return;\n  if (state.member) state.slots[state.slot] = state.member;\n  try { localStorage.setItem(STORAGE, JSON.stringify({ settings: state.settings, slots: state.slots })); } catch (_) { notify('Saving is unavailable in this browser.'); }\n}\nfunction notify(text) {\n  state.toast = text;\n  const node = document.getElementById('toast');\n  if (node) { node.textContent = text; node.hidden = false; }\n  setTimeout(() => { if (state.toast === text) { state.toast = ''; const toast = document.getElementById('toast'); if (toast) toast.hidden = true; } }, 3000);\n}\nfunction tone(frequency, duration = .14, volume = .5, type = 'sine') {\n  if (!audioContext || audioContext.state !== 'running' || !state.settings.sound) return;\n  const oscillator = audioContext.createOscillator(), gain = audioContext.createGain(), now = audioContext.currentTime;\n  oscillator.type = type; oscillator.frequency.setValueAtTime(frequency, now);\n  gain.gain.setValueAtTime(.0001, now); gain.gain.exponentialRampToValueAtTime(Math.max(.00011, state.settings.sound / 100 * volume * .18), now + .015); gain.gain.exponentialRampToValueAtTime(.0001, now + duration);\n  oscillator.connect(gain); gain.connect(audioContext.destination); oscillator.start(now); oscillator.stop(now + duration + .01);\n}\nfunction unlockAudio() {\n  try { if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)(); if (audioContext.state === 'suspended') audioContext.resume(); } catch (_) {}\n}\nfunction music() {\n  if (!audioContext || audioContext.state !== 'running' || !state.settings.music || state.clock < nextMusic) return;\n  nextMusic = state.clock + 1.25;\n  const notes = [261.63, 329.63, 392, 493.88, 392, 329.63, 293.66, 349.23];\n  const oscillator = audioContext.createOscillator(), gain = audioContext.createGain(), now = audioContext.currentTime;\n  oscillator.type = 'sine'; oscillator.frequency.value = notes[Math.floor(state.clock / 1.25) % notes.length];\n  gain.gain.setValueAtTime(.0001, now); gain.gain.exponentialRampToValueAtTime(Math.max(.00011, state.settings.music / 100 * .035), now + .08); gain.gain.exponentialRampToValueAtTime(.0001, now + 1.1);\n  oscillator.connect(gain); gain.connect(audioContext.destination); oscillator.start(now); oscillator.stop(now + 1.15);\n}\nfunction hint() { return state.input === 'gamepad' ? (state.settings.glyphs === 'Xbox' ? 'A SELECT  ·  B BACK' : '✕ SELECT  ·  ○ BACK') : '↑ ↓ CHOOSE  ·  ENTER SELECT  ·  ESC BACK'; }\nfunction button(label, action, primary = false, id = '', detail = '') {\n  return `<button class=\"action${primary ? ' primary' : ''}\" data-action=\"${action}\" data-id=\"${escapeHTML(id)}\"><span>${label}${detail ? `<small>${detail}</small>` : ''}</span><span class=\"arrow\">↗</span></button>`;\n}\nfunction shell(content, label = '', footer = true) {\n  return `<div class=\"page\"><header class=\"topbar\"><button class=\"brand\" data-action=\"home\" aria-label=\"Return to title\"><span class=\"brand-mark\">✳</span><span>WEE BIT <b>OF ZEN</b></span></button><span class=\"top-label\">${label}</span><button class=\"settings-link\" data-action=\"settings\" aria-label=\"Settings\">⚙ <span>SETTINGS</span></button></header>${content}${footer ? `<footer class=\"footer\"><span>${hint()}</span><span>THE INSTITUTE FOR GENTLE IMPROVEMENT&nbsp; ✳ &nbsp; LUMBAR ISLAND</span></footer>` : ''}</div><div class=\"toast\" id=\"toast\" hidden></div>`;\n}\nfunction screen(name) { state.screen = name; state.idle = 0; render(); }\nfunction person() { return state.member || { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\nfunction labelDay() { const member = person(); return member.finished ? 'FREE PRACTICE' : `DAY ${member.day} OF 5`; }\nfunction tile(activity, locked = false) {\n  const group = GROUPS[activity.group], stars = person().stars?.[activity.id] || 0;\n  return `<button class=\"activity ${locked ? 'locked' : ''}\" data-action=\"${locked ? 'locked' : 'select-activity'}\" data-id=\"${activity.id}\" style=\"--group:${group.color};--group-light:${group.light}\"><span class=\"activity-icon\">${activity.icon}</span><span class=\"activity-copy\"><span class=\"activity-group\">${group.name}</span><strong>${activity.name}</strong><small>${locked ? `Opens day ${activity.day}` : activity.tagline}</small></span><span class=\"activity-end\">${locked ? '⌁' : (stars ? '★'.repeat(stars) : '↗')}</span></button>`;\n}\nfunction settingRow(label, value, action, id = '') { return `<div class=\"row\"><span>${label}</span><button class=\"chip setting-button\" data-action=\"${action}\" data-id=\"${id}\">${value}</button></div>`; }\nfunction aboutContent() {\n  const info = window.BUILD_INFO || {}, sections = [ ['Source Information', info.sourceInformation], ['Testing Feedback', info.testingFeedback], ['Engine Feedback', info.engineFeedback], ['Prompt Feedback', info.promptFeedback] ];\n  return sections.map(([title, value]) => `<div class=\"about-group\"><h3>${title}</h3>${Array.isArray(value) ? value.map((item, index) => `<p><b>${index + 1}.</b> ${escapeHTML(item)}</p>`).join('') : Object.entries(value || {}).map(([key, item]) => `<p><b>${escapeHTML(key)}:</b> ${escapeHTML(item)}</p>`).join('')}</div>`).join('');\n}\nfunction render() {\n  const member = person();\n  let content = '', heading = '';\n  if (state.screen === 'title' || state.screen === 'attract') {\n    content = `<main class=\"hero\"><section class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"sun-dot\">✳</span> A LITTLE ISLAND FOR YOURSELF</div><h1 class=\"logo\">wee bit<br><em>of zen</em><span class=\"logo-dot\">.</span></h1><p class=\"lede\">A pleasantly imperfect retreat for<br>your body, mind, and general wobble.</p><div class=\"menu-stack\">${button('Begin your stay', 'slots', true, '', 'A little time just for you')}${button('Local Class', 'class', false, '', 'Practice together, up to four')}${button('About & credits', 'about')}</div></section><div class=\"island-message\"><span>✦ &nbsp; TAKE IT AT YOUR OWN PACE</span><strong>Good things happen<br>one wobble at a time.</strong></div></main>`;\n    if (state.screen === 'attract') content += '<div class=\"center-copy\">DEMONSTRATION &nbsp; · &nbsp; PRESS ANY KEY</div>';\n  } else if (state.screen === 'slots') {\n    heading = 'YOUR STAY';\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; THE GUEST BOOK</div><h1>Make yourself at home.</h1><p>Choose a room for your island stay.</p></div></div><div class=\"card-grid\">${state.slots.map((slot, index) => `<button class=\"card slot-card\" data-action=\"slot\" data-id=\"${index}\"><span class=\"slot-num\">0${index + 1}</span><span class=\"slot-avatar\">${slot ? '☺' : '+'}</span><strong>${slot ? escapeHTML(slot.name) : 'New member'}</strong><small>${slot ? `${slot.finished ? 'Free practice' : `Day ${slot.day}`} · ${Math.floor(slot.minutes || 0)} fit minutes` : 'A fresh start awaits'}</small><span class=\"arrow\">↗</span></button>`).join('')}</div><div class=\"actions\">${button('Back', 'home')}</div></main>`;\n  } else if (state.screen === 'setup') {\n    heading = 'NEW MEMBER';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; NICE TO MEET YOU</div><h1>A little about you.</h1><p>There is no wrong way to arrive.</p></div></div><div class=\"card setup-card\"><label class=\"field\">WHAT SHOULD WE CALL YOU?<input id=\"nickname\" maxlength=\"16\" value=\"${escapeHTML(member.name === 'Guest' ? '' : member.name)}\" placeholder=\"Your name\" autocomplete=\"off\"></label><p class=\"field-label\">CHOOSE YOUR COLOUR</p><div class=\"options\">${OUTFITS.map((color, index) => `<button class=\"option swatch ${member.outfit === index ? 'selected' : ''}\" data-action=\"outfit\" data-id=\"${index}\" style=\"--swatch:${color}\" aria-label=\"Outfit ${index + 1}\">${member.outfit === index ? '✓' : ''}</button>`).join('')}</div><p class=\"field-label\">YOUR INSTRUCTOR</p><div class=\"options\">${['Birch', 'Alder'].map(name => `<button class=\"option ${member.instructor === name ? 'selected' : ''}\" data-action=\"instructor\" data-id=\"${name}\">${name === 'Birch' ? '✳' : '✦'} &nbsp; ${name}</button>`).join('')}</div><div class=\"actions\">${button('Back', 'slots')}${button('Arrive on the island', 'create-member', true)}</div></div></main>`;\n  } else if (state.screen === 'intro') {\n    heading = labelDay();\n    content = `<main class=\"main-wrap narrow\"><div class=\"dialogue card\"><div class=\"eyebrow\">✳ &nbsp; A NOTE FROM TARE</div><div class=\"speaker\">☺</div><h1>Welcome${member.day === 1 ? ', ' + escapeHTML(member.name) : ' back'}.</h1><p>“${DAY_INTROS[Math.min(4, member.day - 1)]}”</p><p class=\"note\">Your stay starts with a gentle body check. No weights, no judgement, and absolutely no pop quizzes. Well, one tiny quiz.</p><div class=\"actions\">${button('Begin body check', 'check', true)}</div></div></main>`;\n  } else if (state.screen === 'check') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">✳ &nbsp; BODY CHECK</div><h2>Just checking in.</h2><p id=\"check-text\">Find a comfortable center.</p></div><div class=\"hud-box timer\" id=\"check-timer\">05</div></div><div class=\"hud-bottom\"><div class=\"play-instruction\">${state.check?.phase === 'lean' ? 'Lean in each direction: ← ↑ → ↓' : 'Stay steady. Small wobbles are welcome.'}</div><div class=\"meter\"><span id=\"check-progress\"></span></div></div></main>`;\n  } else if (state.screen === 'question') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ONE VERY SCIENTIFIC QUESTION</div><h1>How are you arriving today?</h1><p>Your answer helps us calibrate the island's extremely sophisticated vibes.</p><div class=\"menu-stack\">${button('Bright-eyed and bushy-tailed', 'question-answer', true, 'bright')}${button('A little wobbly, honestly', 'question-answer', false, 'wobbly')}${button('Mostly thinking about snacks', 'question-answer', false, 'snacks')}</div></div></main>`;\n  } else if (state.screen === 'check-result') {\n    heading = 'BODY CHECK COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ACCORDING TO TARE</div><div class=\"score-big\">${state.check.spine}</div><h1>Your Spine Age</h1><p>“A completely imaginary number. Your actual spine remains splendid.”</p><p class=\"note\">Today is a fine day to practice being here.</p><div class=\"actions\">${button('Explore the island', 'island', true)}</div></div></main>`;\n  } else if (state.screen === 'island') {\n    heading = labelDay();\n    const dialogue = CAST[(member.day + member.sessions) % CAST.length];\n    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of movement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished ? 'ending' : 'sleep', true)}</div></div></main>`;\n  } else if (state.screen === 'activity') {\n    const activity = state.selection, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>How to play</h3><p>${activity.instruction}</p><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle mode is on.' : 'Make small, comfortable movements.'}</p><div class=\"actions\">${button('Back to island', state.classMode ? 'class' : 'island')}${button('Begin practice', 'start-activity', true)}</div></div></main>`;\n  } else if (state.screen === 'play') {\n    const activity = state.activity, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your center.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"play-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span id=\"play-progress\"></span></div><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE START</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\n  } else if (state.screen === 'result') {\n    const result = state.result;\n    heading = 'SESSION COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue result-card\"><div class=\"eyebrow\">✳ &nbsp; PRACTICE COMPLETE</div><div class=\"stars-big\">${'★'.repeat(result.stars)}<span>${'☆'.repeat(3 - result.stars)}</span></div><h1>Lovely work${state.classMode ? ', everyone' : ''}.</h1><p>“${result.message}”</p><div class=\"result-stats\"><div><strong>${result.percent}%</strong><small>STEADINESS</small></div><div><strong>+${result.minutes}</strong><small>FIT MINUTES</small></div><div><strong>${result.stumbles}</strong><small>WOBBLES</small></div></div><div class=\"actions\">${button('Practice again', 'retry')}${button(state.festival ? 'Continue the Games' : state.classMode ? 'Class results' : 'Back to island', 'result-continue', true)}</div></div></main>`;\n  } else if (state.screen === 'recap') {\n    heading = 'DAY COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ANOTHER DAY WELL SPENT</div><h1>Rest is part of it.</h1><p>“${member.sessions} sessions today. Gerald the ceramic hippo has made a careful note.”</p><div class=\"result-stats\"><div><strong>${Math.floor(member.minutes)}</strong><small>FIT MINUTES</small></div><div><strong>${Object.keys(member.stars || {}).length}</strong><small>MATS VISITED</small></div></div><div class=\"actions\">${button('Wake up to day ' + (member.day + 1), 'next-day', true)}</div></div></main>`;\n  } else if (state.screen === 'festival') {\n    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Three friendly challenges, ending in the Grand Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"actions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n  } else if (state.screen === 'ending') {\n    heading = 'THANK YOU FOR STAYING';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little steadier.<br><em>A lot more you.</em></h1><p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for five days of moving, breathing, and making room. The mats are yours whenever you wish.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits', 'about')}</div></div></main>`;\n  } else if (state.screen === 'class') {\n    heading = 'LOCAL CLASS';\n    const players = state.classPlayers;\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect controllers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHTML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ? 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selection?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.name === 'Guest' ? 'home' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n  } else if (state.screen === 'class-result') {\n    heading = 'LOCAL CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\n  } else if (state.screen === 'settings') {\n    heading = 'SETTINGS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card settings-card\">${settingRow('Music', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${settingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.tips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n  } else if (state.screen === 'pause') {\n    heading = 'PAUSED';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', true)}${button('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', 'leave-play')}</div></div></main>`;\n  } else if (state.screen === 'dev') {\n    heading = 'DEVELOPER MODE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the wobble.</h1>${[['spring','Spring',4,20,.5],['damping','Damping',1,12,.5],['instability','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output id=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"actions\">${button('Reset tuning', 'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n  } else if (state.screen === 'about') {\n    heading = 'ABOUT & CREDITS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card scroll\"><div class=\"eyebrow\">✳ &nbsp; A LITTLE NOTE FROM THE MAKERS</div><h1>About & credits.</h1><p>Made with care for everyone who has ever wobbled.</p>${aboutContent()}<div class=\"actions\">${button('Back', 'about-back', true)}</div></div></main>`;\n  } else if (state.screen === 'hub') {\n    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A little steadiness, shared.'}</h1><p>${state.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; everyone gets a moment to breathe.'}</p><div class=\"result-stats\"><div><strong>${Math.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.started ? 'The class is underway.' : 'Waiting for the other guests…'}</p></div></main>`;\n  }\n  app.innerHTML = shell(content, heading, state.screen !== 'play' && state.screen !== 'check');\n  enhanceModes();\n  if (state.screen === 'play') updateHUD();\n  if (state.screen === 'check') updateCheckHUD();\n  const touchOnly = matchMedia('(pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n  if (touchOnly && !['settings','about'].includes(state.screen)) {\n    const notice = document.createElement('div'); notice.className = 'touch-notice'; notice.innerHTML = '<div><span>✳</span><h2>Controller or keyboard required</h2><p>Connect a controller or keyboard to enjoy the island.</p><button class=\"action primary\" data-action=\"settings\">Settings <span class=\"arrow\">↗</span></button></div>'; app.appendChild(notice);\n  }\n}\nfunction currentButtons() { return [...app.querySelectorAll('button:not([disabled])')].filter(node => node.offsetParent !== null && !node.closest('.touch-notice')); }\nfunction focusMove(direction) {\n  const buttons = currentButtons(); if (!buttons.length) return;\n  const index = buttons.indexOf(document.activeElement); buttons[(index + direction + buttons.length) % buttons.length].focus();\n}\nfunction memberDefault() { return { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\nfunction beginCheck() { state.check = { phase: 'still', elapsed: 0, directions: new Set(), spine: 25 + Math.floor(Math.random() * 25) }; state.activity = null; screen('check'); }\nfunction startActivity(activity, options = {}) {\n  const selected = { ...activity }, duration = options.seconds || selected.seconds;\n  state.selection = selected;\n  state.activity = { ...selected, seconds: duration, elapsed: 0, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, ringX: 0, ringY: 0, flame: .6, score: 0, samples: 0, stumbles: 0, stun: 0, effort: 0, reps: 0, beatHits: 0, lastBeat: -1, lastJog: '', jogHits: 0, hoopHits: 0, good: 0, tray: 0, lastDirection: 0, motions: 0, rng: seeded(841 + selected.name.length) };\n  if (state.classMode && !state.hub.active) prepareClass();\n  mouseLean = null; keys.clear(); toggledBreath = false; screen('play');\n}\n:root{color-scheme:light;--ink:#263d42;--muted:#708485;--teal:#248e8b;--line:#d9e9e2;--paper:#fffefa;--sun:#f8cc76;--shadow:0 18px 50px rgba(41,78,72,.12)}\n*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden}body{font-family:ui-rounded,\"Avenir Next\",Avenir,\"Trebuchet MS\",sans-serif;background:#e9f4ed;color:var(--ink);-webkit-font-smoothing:antialiased}button,input,select{font:inherit}button{color:inherit;cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible{outline:4px solid #f3bb5d;outline-offset:3px}#world{position:fixed;inset:0;width:100%;height:100%;display:block}#app{position:fixed;inset:0;overflow:auto;scrollbar-width:thin}#app:empty{pointer-events:none}.page{min-height:100%;padding:clamp(20px,4vw,64px);display:flex;flex-direction:column;position:relative}.topbar{display:flex;justify-content:space-between;align-items:center;gap:15px;z-index:2}.brand{font-weight:900;letter-spacing:.15em;text-transform:uppercase;font-size:clamp(10px,.9vw,13px);display:flex;align-items:center;gap:10px}.brand-mark{display:grid;place-items:center;background:var(--teal);color:white;border-radius:50%;width:30px;height:30px;font-size:17px;letter-spacing:0}.top-actions{display:flex;gap:8px}.icon-btn,.small-btn{border:1px solid rgba(72,116,105,.18);background:rgba(255,255,250,.83);border-radius:999px;box-shadow:0 4px 12px rgba(42,72,64,.05);font-weight:800;padding:11px 17px}.icon-btn:hover,.small-btn:hover{background:#fff;transform:translateY(-2px)}.hero{flex:1;display:flex;align-items:center;min-height:0}.hero-copy{width:min(50%,620px);padding:28px 0 54px}.eyebrow{font-size:12px;font-weight:900;letter-spacing:.19em;text-transform:uppercase;color:#5b9186}.eyebrow:before{content:'';display:inline-block;width:25px;height:2px;background:#8fb9a5;vertical-align:middle;margin-right:10px}.logo{font-size:clamp(50px,7.5vw,108px);letter-spacing:-.075em;line-height:.88;margin:20px 0 22px;font-weight:900;color:#244944}.logo span{color:#49a99d}.lede{font-size:clamp(17px,1.6vw,23px);line-height:1.45;max-width:470px;color:#58716e;margin:0 0 28px}.menu-stack{display:grid;gap:10px;width:min(100%,370px)}.action{display:flex;align-items:center;justify-content:space-between;gap:20px;text-align:left;border:1px solid rgba(61,119,103,.11);background:rgba(255,255,250,.92);border-radius:18px;padding:16px 19px;box-shadow:0 6px 20px rgba(50,95,80,.06);font-weight:850;font-size:17px;transition:transform .15s,box-shadow .15s,background .15s}.action:hover,.action.is-focused{transform:translateX(6px);box-shadow:0 8px 24px rgba(46,112,98,.15);background:#fff}.action.primary{background:#2b9991;color:white;border-color:#2b9991}.action .arrow{font-size:19px;opacity:.75}.footer{display:flex;justify-content:space-between;gap:15px;align-items:center;font-size:11px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#76918a;z-index:2}.footer strong{color:#44655e}.footer .hint{letter-spacing:.02em;text-transform:none}.main-wrap{flex:1;width:100%;max-width:1160px;margin:0 auto;display:flex;align-items:center;justify-content:center;padding:28px 0}.card{width:min(100%,760px);background:rgba(255,255,251,.96);border:1px solid rgba(255,255,255,.9);box-shadow:var(--shadow);border-radius:30px;padding:clamp(24px,4vw,50px);position:relative}.card.wide{width:min(100%,1060px)}.card.narrow{width:min(100%,560px)}.card h1,.card h2{letter-spacing:-.045em;line-height:1.05;margin:10px 0 12px}.card h1{font-size:clamp(32px,4.3vw,53px)}.card h2{font-size:clamp(25px,3vw,36px)}.card p{line-height:1.5;color:#667c79;font-size:17px}.card .action{background:#f4f8f4;box-shadow:none}.card .action.primary{background:#2b9991;color:white}.card .action:hover,.card .action.is-focused{background:#e7f3ed}.card .action.primary:hover,.card .action.primary.is-focused{background:#218b83}.card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.activity-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.activity{border:1px solid #e4eee7;background:#f8fbf7;border-radius:19px;padding:15px;text-align:left;min-height:114px;position:relative}.activity:hover,.activity.is-focused{background:#edf8f1;border-color:#8ec9b3;transform:translateY(-2px)}.activity:disabled{opacity:.5;cursor:not-allowed}.activity-icon{display:grid;place-items:center;float:left;width:42px;height:42px;border-radius:13px;background:var(--tint,#e2f2e9);font-size:23px;margin-right:12px}.activity strong{display:block;font-size:16px}.activity small{display:block;color:#83948e;margin-top:5px}.activity .stars{color:#e4ad4f;font-size:13px;margin-top:8px}.chip{display:inline-flex;align-items:center;gap:7px;border-radius:99px;background:#edf6ef;color:#56836f;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;padding:9px 12px}.chip.orange{background:#fff1d5;color:#ae7e31}.chip.pink{background:#fce9df;color:#b77e6e}.split{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center}.row{display:flex;align-items:center;justify-content:space-between;gap:16px}.divider{height:1px;background:#e7efe9;margin:19px 0}.field{display:grid;gap:8px;margin:16px 0;color:#748c83;font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.12em}.field input,.field select{width:100%;border:2px solid #e3eee6;border-radius:14px;padding:13px 15px;color:var(--ink);background:#fbfdf9;font-size:17px;letter-spacing:0;text-transform:none}.options{display:flex;flex-wrap:wrap;gap:8px}.option{border:2px solid #e6eee6;border-radius:13px;padding:10px 14px;background:#f8fbf8;font-weight:800}.option.selected{border-color:#63b2a0;background:#e7f7ec}.dialogue{background:#eef8f2;border-radius:20px;padding:18px 20px;color:#42665c;font-size:18px;line-height:1.45}.dialogue strong{color:#278f82}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.actions .action{min-width:160px}.play-hud{position:absolute;inset:0;pointer-events:none;padding:clamp(18px,3vw,40px);display:flex;flex-direction:column;justify-content:space-between}.play-hud button{pointer-events:auto}.hud-top,.hud-bottom{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.hud-box{background:rgba(255,255,250,.92);border:1px solid rgba(255,255,255,.8);border-radius:20px;padding:14px 20px;box-shadow:0 9px 28px rgba(44,83,75,.09)}.hud-box strong{font-size:20px;letter-spacing:-.03em}.hud-box small{display:block;font-size:11px;color:#79938a;text-transform:uppercase;letter-spacing:.12em;font-weight:900;margin-bottom:3px}.meter{height:9px;width:180px;border-radius:20px;background:#e5efe6;overflow:hidden;margin-top:8px}.meter>i{display:block;height:100%;background:#efba68;border-radius:20px}.play-instruction{text-align:center;align-self:center;background:rgba(255,255,250,.91);border-radius:999px;padding:12px 20px;font-weight:800;color:#57776c;box-shadow:var(--shadow)}.progress-dots{display:flex;gap:6px}.progress-dots i{width:9px;height:9px;border-radius:50%;background:#dcebe2}.progress-dots i.on{background:#4cae9c}.score-big{font-size:clamp(48px,7vw,76px);font-weight:900;letter-spacing:-.07em;color:#2b9991;line-height:1}.stars-big{font-size:30px;color:#efb956;letter-spacing:5px}.note{font-size:13px!important;color:#91a39b!important}.scroll{max-height:min(57vh,570px);overflow:auto;padding-right:8px}.about-group{border-top:1px solid #e7efe9;padding:12px 0}.about-group h3{font-size:18px}.about-group p{font-size:14px;margin:5px 0;overflow-wrap:anywhere}.touch-notice{position:fixed;inset:0;z-index:20;display:grid;place-items:center;padding:20px;background:rgba(230,244,236,.92);text-align:center}.touch-notice .card{width:min(100%,460px)}.hidden{display:none!important}.toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:#284e49;color:#fff;border-radius:99px;padding:12px 22px;z-index:10;font-weight:800}.class-players{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.player-tile{padding:18px;background:#f2f8f1;border-radius:18px;text-align:center}.player-tile .face{font-size:35px}.slider{width:100%;accent-color:#38a597}.island-message{position:absolute;top:12%;left:50%;transform:translateX(-50%);text-align:center;white-space:nowrap;pointer-events:none}.island-message h1{font-size:clamp(24px,3.2vw,40px);margin:6px;letter-spacing:-.04em}.island-message p{margin:0;color:#708e82;font-weight:700}.map-actions{position:absolute;bottom:clamp(20px,4vh,45px);left:50%;transform:translateX(-50%);width:min(92%,760px);display:flex;justify-content:center;gap:10px}.map-actions .action{min-width:180px}.map-actions button{pointer-events:auto}.center-copy{text-align:center}.center-copy p{max-width:580px;margin-left:auto;margin-right:auto}\n@media(max-width:850px){.hero-copy{width:58%}.logo{font-size:clamp(48px,8vw,72px)}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.footer .weather{display:none}.card{padding:26px}.main-wrap{align-items:flex-start;padding:25px 0}.page{min-height:100%;padding:22px}.play-hud{padding:16px}.island-message{top:12%}}\n@media(max-width:540px){.page{padding:18px}.hero{align-items:flex-end}.hero-copy{width:100%;padding:30px 0 20px}.logo{font-size:58px;max-width:320px;margin:12px 0}.lede{font-size:16px;max-width:315px;margin-bottom:18px}.menu-stack{width:100%;max-width:340px}.action{padding:13px 16px;font-size:15px;border-radius:15px}.brand{font-size:10px}.footer{font-size:9px}.card-grid,.split{grid-template-columns:1fr}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.activity{padding:10px;min-height:92px}.activity-icon{width:34px;height:34px;font-size:18px}.activity strong{font-size:13px}.activity small{font-size:11px}.card h1{font-size:34px}.card p{font-size:15px}.hud-box{padding:10px 12px}.hud-box strong{font-size:16px}.meter{width:110px}.play-instruction{font-size:12px;max-width:90%;padding:10px 14px}.class-players{grid-template-columns:repeat(2,1fr)}.map-actions .action{min-width:0;flex:1}.map-actions{width:90%}.scroll{max-height:55vh}}\n.balance-plate{position:absolute;left:50%;bottom:20%;width:clamp(94px,13vw,160px);aspect-ratio:1;transform:translateX(-50%);border:2px solid #719f98;border-radius:50%;background:#ecfaf2cf;box-shadow:0 8px 24px #4d85732b;pointer-events:none}.plate-ring{position:absolute;inset:20%;border:2px dashed #8db9a4;border-radius:50%}.plate-dot{position:absolute;left:50%;top:50%;width:17px;height:17px;transform:translate(-50%,-50%);border:3px solid white;border-radius:50%;background:#e5785c;box-shadow:0 2px 6px #416e5e88}\n.brand,.settings-link{border:0;background:transparent;padding:0;cursor:pointer}\n.settings-link{display:flex;align-items:center;gap:8px;color:#527b70;font:800 11px/1 sans-serif;letter-spacing:.12em}\n.action small{display:block;margin-top:5px;font-size:11px;font-weight:600;letter-spacing:0;opacity:.72}\n.island-message span,.island-message strong{display:block}\n.island-message strong{margin-top:5px;font-size:18px;line-height:1.2}\n.class-live{position:absolute;left:18px;bottom:18px;z-index:3;display:flex;flex-wrap:wrap;gap:6px;max-width:calc(100% - 36px)}\n.class-live span{padding:7px 10px;border-radius:12px;background:#fffef0e8;color:#315d50;font-size:12px;font-weight:800;box-shadow:0 2px 10px #345a4b18}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_580","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; printf '%s\\\\n' '--- Island and play markup ---'; sed -n '55,155p' \\\"\"'$D/src/game.js\" | fold -w 220; printf '\"'%s\\\\n' '--- Relevant styles ---'; sed 's/}/}\\\\n/g' \\\"\"'$D/src/style.css\" | rg -n '\"'page|topbar|island|activity|play-|hud|footer|tile|map-|speech'; printf '%s\\\\n' '--- Overrides ---'; cat \\\"\"'$D/src/extra.css\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_580","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; printf '%s\\\\n' '--- Island and play markup ---'; sed -n '55,155p' \\\"\"'$D/src/game.js\" | fold -w 220; printf '\"'%s\\\\n' '--- Relevant styles ---'; sed 's/}/}\\\\n/g' \\\"\"'$D/src/style.css\" | rg -n '\"'page|topbar|island|activity|play-|hud|footer|tile|map-|speech'; printf '%s\\\\n' '--- Overrides ---'; cat \\\"\"'$D/src/extra.css\"'","aggregated_output":"--- Island and play markup ---\n}\nfunction screen(name) { state.screen = name; state.idle = 0; render(); }\nfunction person() { return state.member || { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\nfunction labelDay() { const member = person(); return member.finished ? 'FREE PRACTICE' : `DAY ${member.day} OF 5`; }\nfunction tile(activity, locked = false) {\n  const group = GROUPS[activity.group], stars = person().stars?.[activity.id] || 0;\n  return `<button class=\"activity ${locked ? 'locked' : ''}\" data-action=\"${locked ? 'locked' : 'select-activity'}\" data-id=\"${activity.id}\" style=\"--group:${group.color};--group-light:${group.light}\"><span class=\"activi\nty-icon\">${activity.icon}</span><span class=\"activity-copy\"><span class=\"activity-group\">${group.name}</span><strong>${activity.name}</strong><small>${locked ? `Opens day ${activity.day}` : activity.tagline}</small></spa\nn><span class=\"activity-end\">${locked ? '⌁' : (stars ? '★'.repeat(stars) : '↗')}</span></button>`;\n}\nfunction settingRow(label, value, action, id = '') { return `<div class=\"row\"><span>${label}</span><button class=\"chip setting-button\" data-action=\"${action}\" data-id=\"${id}\">${value}</button></div>`; }\nfunction aboutContent() {\n  const info = window.BUILD_INFO || {}, sections = [ ['Source Information', info.sourceInformation], ['Testing Feedback', info.testingFeedback], ['Engine Feedback', info.engineFeedback], ['Prompt Feedback', info.promptFe\nedback] ];\n  return sections.map(([title, value]) => `<div class=\"about-group\"><h3>${title}</h3>${Array.isArray(value) ? value.map((item, index) => `<p><b>${index + 1}.</b> ${escapeHTML(item)}</p>`).join('') : Object.entries(value \n|| {}).map(([key, item]) => `<p><b>${escapeHTML(key)}:</b> ${escapeHTML(item)}</p>`).join('')}</div>`).join('');\n}\nfunction render() {\n  const member = person();\n  let content = '', heading = '';\n  if (state.screen === 'title' || state.screen === 'attract') {\n    content = `<main class=\"hero\"><section class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"sun-dot\">✳</span> A LITTLE ISLAND FOR YOURSELF</div><h1 class=\"logo\">wee bit<br><em>of zen</em><span class=\"logo-dot\">.</span\n></h1><p class=\"lede\">A pleasantly imperfect retreat for<br>your body, mind, and general wobble.</p><div class=\"menu-stack\">${button('Begin your stay', 'slots', true, '', 'A little time just for you')}${button('Local Cla\nss', 'class', false, '', 'Practice together, up to four')}${button('About & credits', 'about')}</div></section><div class=\"island-message\"><span>✦ &nbsp; TAKE IT AT YOUR OWN PACE</span><strong>Good things happen<br>one w\nobble at a time.</strong></div></main>`;\n    if (state.screen === 'attract') content += '<div class=\"center-copy\">DEMONSTRATION &nbsp; · &nbsp; PRESS ANY KEY</div>';\n  } else if (state.screen === 'slots') {\n    heading = 'YOUR STAY';\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; THE GUEST BOOK</div><h1>Make yourself at home.</h1><p>Choose a room for your island stay.</p></div></div><div class=\"car\nd-grid\">${state.slots.map((slot, index) => `<button class=\"card slot-card\" data-action=\"slot\" data-id=\"${index}\"><span class=\"slot-num\">0${index + 1}</span><span class=\"slot-avatar\">${slot ? '☺' : '+'}</span><strong>${sl\not ? escapeHTML(slot.name) : 'New member'}</strong><small>${slot ? `${slot.finished ? 'Free practice' : `Day ${slot.day}`} · ${Math.floor(slot.minutes || 0)} fit minutes` : 'A fresh start awaits'}</small><span class=\"arr\now\">↗</span></button>`).join('')}</div><div class=\"actions\">${button('Back', 'home')}</div></main>`;\n  } else if (state.screen === 'setup') {\n    heading = 'NEW MEMBER';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; NICE TO MEET YOU</div><h1>A little about you.</h1><p>There is no wrong way to arrive.</p></div></div><div class=\"\ncard setup-card\"><label class=\"field\">WHAT SHOULD WE CALL YOU?<input id=\"nickname\" maxlength=\"16\" value=\"${escapeHTML(member.name === 'Guest' ? '' : member.name)}\" placeholder=\"Your name\" autocomplete=\"off\"></label><p cl\nass=\"field-label\">CHOOSE YOUR COLOUR</p><div class=\"options\">${OUTFITS.map((color, index) => `<button class=\"option swatch ${member.outfit === index ? 'selected' : ''}\" data-action=\"outfit\" data-id=\"${index}\" style=\"--sw\natch:${color}\" aria-label=\"Outfit ${index + 1}\">${member.outfit === index ? '✓' : ''}</button>`).join('')}</div><p class=\"field-label\">YOUR INSTRUCTOR</p><div class=\"options\">${['Birch', 'Alder'].map(name => `<button cla\nss=\"option ${member.instructor === name ? 'selected' : ''}\" data-action=\"instructor\" data-id=\"${name}\">${name === 'Birch' ? '✳' : '✦'} &nbsp; ${name}</button>`).join('')}</div><div class=\"actions\">${button('Back', 'slots\n')}${button('Arrive on the island', 'create-member', true)}</div></div></main>`;\n  } else if (state.screen === 'intro') {\n    heading = labelDay();\n    content = `<main class=\"main-wrap narrow\"><div class=\"dialogue card\"><div class=\"eyebrow\">✳ &nbsp; A NOTE FROM TARE</div><div class=\"speaker\">☺</div><h1>Welcome${member.day === 1 ? ', ' + escapeHTML(member.name) : ' \nback'}.</h1><p>“${DAY_INTROS[Math.min(4, member.day - 1)]}”</p><p class=\"note\">Your stay starts with a gentle body check. No weights, no judgement, and absolutely no pop quizzes. Well, one tiny quiz.</p><div class=\"actio\nns\">${button('Begin body check', 'check', true)}</div></div></main>`;\n  } else if (state.screen === 'check') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">✳ &nbsp; BODY CHECK</div><h2>Just checking in.</h2><p id=\"check-text\">Find a comfortable center.</p></div><div class=\"h\nud-box timer\" id=\"check-timer\">05</div></div><div class=\"hud-bottom\"><div class=\"play-instruction\">${state.check?.phase === 'lean' ? 'Lean in each direction: ← ↑ → ↓' : 'Stay steady. Small wobbles are welcome.'}</div><di\nv class=\"meter\"><span id=\"check-progress\"></span></div></div></main>`;\n  } else if (state.screen === 'question') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ONE VERY SCIENTIFIC QUESTION</div><h1>How are you arriving today?</h1><p>Your answer helps us calibrate the island's \nextremely sophisticated vibes.</p><div class=\"menu-stack\">${button('Bright-eyed and bushy-tailed', 'question-answer', true, 'bright')}${button('A little wobbly, honestly', 'question-answer', false, 'wobbly')}${button('Mo\nstly thinking about snacks', 'question-answer', false, 'snacks')}</div></div></main>`;\n  } else if (state.screen === 'check-result') {\n    heading = 'BODY CHECK COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ACCORDING TO TARE</div><div class=\"score-big\">${state.check.spine}</div><h1>Your Spine Age</h1><p>“A completely imagi\nnary number. Your actual spine remains splendid.”</p><p class=\"note\">Today is a fine day to practice being here.</p><div class=\"actions\">${button('Explore the island', 'island', true)}</div></div></main>`;\n  } else if (state.screen === 'island') {\n    heading = labelDay();\n    const dialogue = CAST[(member.day + member.sessions) % CAST.length];\n    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of move\nment.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>\n/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\n\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished \n? 'ending' : 'sleep', true)}</div></div></main>`;\n  } else if (state.screen === 'activity') {\n    const activity = state.selection, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div class=\"eyebrow\">${gr\noup.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>How to play</h3><p>${activity.instruction}</\np><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle mode is on.' : 'Make small, comfortable movements.'}</p><div class=\"actions\">${button('Back to island', state.classMode\n ? 'class' : 'island')}${button('Begin practice', 'start-activity', true)}</div></div></main>`;\n  } else if (state.screen === 'play') {\n    const activity = state.activity, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your center.</p\n></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\n\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"play-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span id=\"play-progress\"></span></d\niv><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE START</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\n  } else if (state.screen === 'result') {\n    const result = state.result;\n    heading = 'SESSION COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue result-card\"><div class=\"eyebrow\">✳ &nbsp; PRACTICE COMPLETE</div><div class=\"stars-big\">${'★'.repeat(result.stars)}<span>${'☆'.repeat(3 - result.st\nars)}</span></div><h1>Lovely work${state.classMode ? ', everyone' : ''}.</h1><p>“${result.message}”</p><div class=\"result-stats\"><div><strong>${result.percent}%</strong><small>STEADINESS</small></div><div><strong>+${resu\nlt.minutes}</strong><small>FIT MINUTES</small></div><div><strong>${result.stumbles}</strong><small>WOBBLES</small></div></div><div class=\"actions\">${button('Practice again', 'retry')}${button(state.festival ? 'Continue t\nhe Games' : state.classMode ? 'Class results' : 'Back to island', 'result-continue', true)}</div></div></main>`;\n  } else if (state.screen === 'recap') {\n    heading = 'DAY COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ANOTHER DAY WELL SPENT</div><h1>Rest is part of it.</h1><p>“${member.sessions} sessions today. Gerald the ceramic hip\npo has made a careful note.”</p><div class=\"result-stats\"><div><strong>${Math.floor(member.minutes)}</strong><small>FIT MINUTES</small></div><div><strong>${Object.keys(member.stars || {}).length}</strong><small>MATS VISI\nTED</small></div></div><div class=\"actions\">${button('Wake up to day ' + (member.day + 1), 'next-day', true)}</div></div></main>`;\n  } else if (state.screen === 'festival') {\n    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Three friendly challenges, ending in the Gra\nnd Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"\nactions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n  } else if (state.screen === 'ending') {\n    heading = 'THANK YOU FOR STAYING';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little steadier.<br><em>A lot more you.</em></h1>\n<p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for five days of moving, breathing, and making room. The mats are yours whenever you wi\nsh.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits', 'about')}</div></div></main>`;\n  } else if (state.screen === 'class') {\n    heading = 'LOCAL CLASS';\n    const players = state.classPlayers;\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect co\nntrollers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHT\nML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ?\n 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selecti\non?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.name === 'Guest' ? 'ho\nme' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n  } else if (state.screen === 'class-result') {\n    heading = 'LOCAL CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.ma\np((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"\nactions\">${button('Back to class', 'class', true)}</div></div></main>`;\n  } else if (state.screen === 'settings') {\n    heading = 'SETTINGS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card settings-card\">${settingRow('M\nusic', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${se\nttingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.t\nips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving\n.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n  } else if (state.screen === 'pause') {\n    heading = 'PAUSED';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', true)}${bu\ntton('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', 'leave-play')}</div></div></main>`;\n  } else if (state.screen === 'dev') {\n    heading = 'DEVELOPER MODE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the wobble.</h1>${[['spring','Spring',4,20,.5],['damping','Damping',1,12,.5],['insta\nbility','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output id=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" \nmin=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"actions\">${button('Reset tuning', 'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n  } else if (state.screen === 'about') {\n    heading = 'ABOUT & CREDITS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card scroll\"><div class=\"eyebrow\">✳ &nbsp; A LITTLE NOTE FROM THE MAKERS</div><h1>About & credits.</h1><p>Made with care for everyone who has ever wobbled.</p>${a\nboutContent()}<div class=\"actions\">${button('Back', 'about-back', true)}</div></div></main>`;\n  } else if (state.screen === 'hub') {\n    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A little steadiness, shared.'}</h1><p>${s\ntate.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; everyone gets a moment to breathe.'}</p><div class=\"result-stats\"><div><strong>${Math\n.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.started ? 'The class is underway.' : 'Waiting for the other guests…'}</p></div></main>`;\n  }\n  app.innerHTML = shell(content, heading, state.screen !== 'play' && state.screen !== 'check');\n  enhanceModes();\n  if (state.screen === 'play') updateHUD();\n  if (state.screen === 'check') updateCheckHUD();\n  const touchOnly = matchMedia('(pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n  if (touchOnly && !['settings','about'].includes(state.screen)) {\n    const notice = document.createElement('div'); notice.className = 'touch-notice'; notice.innerHTML = '<div><span>✳</span><h2>Controller or keyboard required</h2><p>Connect a controller or keyboard to enjoy the island.\n</p><button class=\"action primary\" data-action=\"settings\">Settings <span class=\"arrow\">↗</span></button></div>'; app.appendChild(notice);\n  }\n}\nfunction currentButtons() { return [...app.querySelectorAll('button:not([disabled])')].filter(node => node.offsetParent !== null && !node.closest('.touch-notice')); }\nfunction focusMove(direction) {\n  const buttons = currentButtons(); if (!buttons.length) return;\n  const index = buttons.indexOf(document.activeElement); buttons[(index + direction + buttons.length) % buttons.length].focus();\n}\nfunction memberDefault() { return { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\nfunction beginCheck() { state.check = { phase: 'still', elapsed: 0, directions: new Set(), spine: 25 + Math.floor(Math.random() * 25) }; state.activity = null; screen('check'); }\nfunction startActivity(activity, options = {}) {\n  const selected = { ...activity }, duration = options.seconds || selected.seconds;\n--- Relevant styles ---\n12:.page{min-height:100%;padding:clamp(20px,4vw,64px);display:flex;flex-direction:column;position:relative}\n13:.topbar{display:flex;justify-content:space-between;align-items:center;gap:15px;z-index:2}\n31:.footer{display:flex;justify-content:space-between;gap:15px;align-items:center;font-size:11px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#76918a;z-index:2}\n32:.footer strong{color:#44655e}\n33:.footer .hint{letter-spacing:.02em;text-transform:none}\n47:.activity-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}\n48:.activity{border:1px solid #e4eee7;background:#f8fbf7;border-radius:19px;padding:15px;text-align:left;min-height:114px;position:relative}\n49:.activity:hover,.activity.is-focused{background:#edf8f1;border-color:#8ec9b3;transform:translateY(-2px)}\n50:.activity:disabled{opacity:.5;cursor:not-allowed}\n51:.activity-icon{display:grid;place-items:center;float:left;width:42px;height:42px;border-radius:13px;background:var(--tint,#e2f2e9);font-size:23px;margin-right:12px}\n52:.activity strong{display:block;font-size:16px}\n53:.activity small{display:block;color:#83948e;margin-top:5px}\n54:.activity .stars{color:#e4ad4f;font-size:13px;margin-top:8px}\n70:.play-hud{position:absolute;inset:0;pointer-events:none;padding:clamp(18px,3vw,40px);display:flex;flex-direction:column;justify-content:space-between}\n71:.play-hud button{pointer-events:auto}\n72:.hud-top,.hud-bottom{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}\n73:.hud-box{background:rgba(255,255,250,.92);border:1px solid rgba(255,255,255,.8);border-radius:20px;padding:14px 20px;box-shadow:0 9px 28px rgba(44,83,75,.09)}\n74:.hud-box strong{font-size:20px;letter-spacing:-.03em}\n75:.hud-box small{display:block;font-size:11px;color:#79938a;text-transform:uppercase;letter-spacing:.12em;font-weight:900;margin-bottom:3px}\n78:.play-instruction{text-align:center;align-self:center;background:rgba(255,255,250,.91);border-radius:999px;padding:12px 20px;font-weight:800;color:#57776c;box-shadow:var(--shadow)}\n94:.player-tile{padding:18px;background:#f2f8f1;border-radius:18px;text-align:center}\n95:.player-tile .face{font-size:35px}\n97:.island-message{position:absolute;top:12%;left:50%;transform:translateX(-50%);text-align:center;white-space:nowrap;pointer-events:none}\n98:.island-message h1{font-size:clamp(24px,3.2vw,40px);margin:6px;letter-spacing:-.04em}\n99:.island-message p{margin:0;color:#708e82;font-weight:700}\n100:.map-actions{position:absolute;bottom:clamp(20px,4vh,45px);left:50%;transform:translateX(-50%);width:min(92%,760px);display:flex;justify-content:center;gap:10px}\n101:.map-actions .action{min-width:180px}\n102:.map-actions button{pointer-events:auto}\n108:.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n109:.footer .weather{display:none}\n112:.page{min-height:100%;padding:22px}\n113:.play-hud{padding:16px}\n114:.island-message{top:12%}\n117:@media(max-width:540px){.page{padding:18px}\n125:.footer{font-size:9px}\n127:.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}\n128:.activity{padding:10px;min-height:92px}\n129:.activity-icon{width:34px;height:34px;font-size:18px}\n130:.activity strong{font-size:13px}\n131:.activity small{font-size:11px}\n134:.hud-box{padding:10px 12px}\n135:.hud-box strong{font-size:16px}\n137:.play-instruction{font-size:12px;max-width:90%;padding:10px 14px}\n139:.map-actions .action{min-width:0;flex:1}\n140:.map-actions{width:90%}\n--- Overrides ---\n.balance-plate{position:absolute;left:50%;bottom:20%;width:clamp(94px,13vw,160px);aspect-ratio:1;transform:translateX(-50%);border:2px solid #719f98;border-radius:50%;background:#ecfaf2cf;box-shadow:0 8px 24px #4d85732b;pointer-events:none}.plate-ring{position:absolute;inset:20%;border:2px dashed #8db9a4;border-radius:50%}.plate-dot{position:absolute;left:50%;top:50%;width:17px;height:17px;transform:translate(-50%,-50%);border:3px solid white;border-radius:50%;background:#e5785c;box-shadow:0 2px 6px #416e5e88}\n.brand,.settings-link{border:0;background:transparent;padding:0;cursor:pointer}\n.settings-link{display:flex;align-items:center;gap:8px;color:#527b70;font:800 11px/1 sans-serif;letter-spacing:.12em}\n.action small{display:block;margin-top:5px;font-size:11px;font-weight:600;letter-spacing:0;opacity:.72}\n.island-message span,.island-message strong{display:block}\n.island-message strong{margin-top:5px;font-size:18px;line-height:1.2}\n.class-live{position:absolute;left:18px;bottom:18px;z-index:3;display:flex;flex-wrap:wrap;gap:6px;max-width:calc(100% - 36px)}\n.class-live span{padding:7px 10px;border-radius:12px;background:#fffef0e8;color:#315d50;font-size:12px;font-weight:800;box-shadow:0 2px 10px #345a4b18}\n","exit_code":0,"status":"completed"}}
