ZEN.action('settings-back')\")\n    50\t    check('accessibility setting toggles', page.evaluate('__ZEN.state.settings.gentle === true'))\n    51\t    page.evaluate(\"__ZEN.action('slots'); __ZEN.action('slot', '0')\")\n    52\t    page.locator('#nickname').fill('Test Walker')\n    53\t    page.evaluate(\"__ZEN.action('create-member')\")\n    54\t    check('create a named profile', page.evaluate(\"__ZEN.state.screen === 'intro' && __ZEN.state.member.name === 'Test Walker'\"))\n    55\t    page.reload(wait_until='load')\n    56\t    page.evaluate(\"__ZEN.action('slots'); __ZEN.action('slot', '0')\")\n    57\t    check('profile survives reload', page.evaluate(\"__ZEN.state.member.name === 'Test Walker'\"))\n    58\t    check('setting survives reload', page.evaluate('__ZEN.state.settings.gentle === true'))\n    59\t\n    60\t    results = page.evaluate('''() => {\n    61\t      const z = window.__ZEN, found = [];\n    62\t      const verify = (name, value) => found.push({ name, pass: !!value });\n    63\t      for (let day = 1; day <= 5; day++) {\n    64\t        verify(`day ${day} starts`, z.state.member.day === day);\n    65\t        z.action('check'); z.step(20);\n    66\t        verify(`day ${day} check-in`, z.state.screen === 'question');\n    67\t        z.action('question-answer', 'bright'); z.action('island');\n    68\t        for (let session = 0; session < 3; session++) {\n    69\t          z.startActivity(ACTIVITIES[(day * 3 + session) % ACTIVITIES.length], { seconds: .1 });\n    70\t          z.step(.2);\n    71\t          verify(`day ${day} session ${session + 1}`, z.state.screen === 'result');\n    72\t          z.action('result-continue');\n    73\t        }\n    74\t        verify(`day ${day} records sessions`, z.state.member.sessions >= 3);\n    75\t        z.action('sleep');\n    76\t        if (day < 5) { verify(`day ${day} recap`, z.state.screen === 'recap'); z.action('next-day'); }\n    77\t      }\n    78\t      verify('festival unlocks', z.state.screen === 'festival');\n    79\t      for (let event = 0; event < 3; event++) {\n    80\t        z.action('festival-start'); z.step(31);\n    81\t        verify(`festival event ${event + 1}`, z.state.screen === 'result');\n    82\t        z.action('result-continue');\n    83\t      }\n    84\t      verify('story reaches the ending', z.state.screen === 'ending' && z.state.member.finished);\n    85\t      z.action('free-play');\n    86\t      verify('free practice follows ending', z.state.screen === 'island');\n    87\t      for (const activity of ACTIVITIES) {\n    88\t        z.startActivity(activity, { seconds: 1 });\n    89\t        if (activity.id === 'step') attemptInput('arrowleft');\n    90\t        if (activity.id === 'jog') { attemptInput('j'); attemptInput('k'); }\n    91\t        if (activity.id === 'hoop') { attemptInput('q'); attemptInput('e'); }\n    92\t        z.step(1.1);\n    93\t        verify(`${activity.name} completes`, z.state.screen === 'result' && Number.isFinite(z.state.result.percent));\n    94\t        z.action('result-continue');\n    95\t      }\n    96\t      z.startActivity(ACTIVITIES.find(activity => activity.id === 'stork'));\n    97\t      z.step(46);\n    98\t      verify('full-length session completes', z.state.screen === 'result');\n    99\t      z.action('result-continue');\n   100\t      z.startActivity(ACTIVITIES[0], { seconds: 5 }); z.step(.5); z.action('pause');\n   101\t      const paused = z.state.activity.elapsed; z.step(2);\n   102\t      verify('pause freezes the workout', z.state.activity.elapsed === paused);\n   103\t      z.action('dev'); tuning.spring = 3; z.action('reset-tuning');\n   104\t      verify('developer tuning resets', tuning.spring === tuningDefaults.spring);\n   105\t      z.action('resume'); verify('pause resumes', z.state.screen === 'play');\n   106\t      z.action('leave-play');\n   107\t      for (const count of [2, 3, 4]) {\n   108\t        z.state.classPlayers = [];\n   109\t        z.action('class');\n   110\t        if (count >= 3) z.action('class-toggle', '2');\n   111\t        if (count >= 4) z.action('class-toggle', '3');\n   112\t        z.action('start-class');\n   113\t        verify(`${count}-person class starts`, z.state.classActors.length === count - 1);\n   114\t        z.step(36);\n   115\t        verify(`${count}-person class finishes`, z.state.screen === 'class-result' && z.state.classScores.length === count);\n   116\t        verify(`${count}-person class has independent scores`, new Set(z.state.classScores.map(item => item.score)).size > 1);\n   117\t      }\n   118\t      z.state.classPlayers = []; z.action('class'); z.action('class-toggle', '1');\n   119\t      verify('second keyboard player joins', z.state.classPlayers[1].source === 'keyboard');\n   120\t      z.action('start-class'); keys.add('l'); z.step(1); keys.delete('l');\n   121\t      verify('second keyboard controls their own player', z.state.classActors[0].px > 0);\n   122\t      z.action('leave-play'); z.action('island');\n   123\t      return found;\n   124\t    }''')\n   125\t    for result in results:\n   126\t        check(result['name'], result['pass'])\n   127\t\n   128\t    gamepad = page.evaluate('''() => {\n   129\t      const z = window.__ZEN;\n   130\t      const makePad = index => ({ index, connected: true, mapping: 'standard', axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0 })) });\n   131\t      const first = makePad(0), second = makePad(1);\n   132\t      Object.defineProperty(navigator, 'getGamepads', { configurable: true, value: () => [first, second] });\n   133\t      z.action('home'); document.querySelector('[data-action=\"slots\"]').focus();\n   134\t      first.buttons[0].pressed = true; pollGamepad();\n   135\t      const selected = z.state.screen === 'slots';\n    78\t    heading = 'NEW MEMBER';\n    79\t    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; NICE TO MEET YOU</div><h1>A little about you.</h1><p>There is no wrong way to arrive.</p></div></div><div class=\"card setup-card\"><label class=\"field\">WHAT SHOULD WE CALL YOU?<input id=\"nickname\" maxlength=\"16\" value=\"${escapeHTML(member.name === 'Guest' ? '' : member.name)}\" placeholder=\"Your name\" autocomplete=\"off\"></label><p class=\"field-label\">CHOOSE YOUR COLOUR</p><div class=\"options\">${OUTFITS.map((color, index) => `<button class=\"option swatch ${member.outfit === index ? 'selected' : ''}\" data-action=\"outfit\" data-id=\"${index}\" style=\"--swatch:${color}\" aria-label=\"Outfit ${index + 1}\">${member.outfit === index ? '✓' : ''}</button>`).join('')}</div><p class=\"field-label\">YOUR INSTRUCTOR</p><div class=\"options\">${['Birch', 'Alder'].map(name => `<button class=\"option ${member.instructor === name ? 'selected' : ''}\" data-action=\"instructor\" data-id=\"${name}\">${name === 'Birch' ? '✳' : '✦'} &nbsp; ${name}</button>`).join('')}</div><div class=\"actions\">${button('Back', 'slots')}${button('Arrive on the island', 'create-member', true)}</div></div></main>`;\n    80\t  } else if (state.screen === 'intro') {\n    81\t    heading = labelDay();\n    82\t    content = `<main class=\"main-wrap narrow\"><div class=\"dialogue card\"><div class=\"eyebrow\">✳ &nbsp; A NOTE FROM TARE</div><div class=\"speaker\">☺</div><h1>Welcome${member.day === 1 ? ', ' + escapeHTML(member.name) : ' back'}.</h1><p>“${DAY_INTROS[Math.min(4, member.day - 1)]}”</p><p class=\"note\">Your stay starts with a gentle body check. No weights, no judgement, and absolutely no pop quizzes. Well, one tiny quiz.</p><div class=\"actions\">${button('Begin body check', 'check', true)}</div></div></main>`;\n    83\t  } else if (state.screen === 'check') {\n    84\t    heading = 'BODY CHECK';\n    85\t    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">✳ &nbsp; BODY CHECK</div><h2>Just checking in.</h2><p id=\"check-text\">Find a comfortable center.</p></div><div class=\"hud-box timer\" id=\"check-timer\">05</div></div><div class=\"hud-bottom\"><div class=\"play-instruction\">${state.check?.phase === 'lean' ? 'Lean in each direction: ← ↑ → ↓' : 'Stay steady. Small wobbles are welcome.'}</div><div class=\"meter\"><span id=\"check-progress\"></span></div></div></main>`;\n    86\t  } else if (state.screen === 'question') {\n    87\t    heading = 'BODY CHECK';\n    88\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ONE VERY SCIENTIFIC QUESTION</div><h1>How are you arriving today?</h1><p>Your answer helps us calibrate the island's extremely sophisticated vibes.</p><div class=\"menu-stack\">${button('Bright-eyed and bushy-tailed', 'question-answer', true, 'bright')}${button('A little wobbly, honestly', 'question-answer', false, 'wobbly')}${button('Mostly thinking about snacks', 'question-answer', false, 'snacks')}</div></div></main>`;\n    89\t  } else if (state.screen === 'check-result') {\n    90\t    heading = 'BODY CHECK COMPLETE';\n    91\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ACCORDING TO TARE</div><div class=\"score-big\">${state.check.spine}</div><h1>Your Spine Age</h1><p>“A completely imaginary number. Your actual spine remains splendid.”</p><p class=\"note\">Today is a fine day to practice being here.</p><div class=\"actions\">${button('Explore the island', 'island', true)}</div></div></main>`;\n    92\t  } else if (state.screen === 'island') {\n    93\t    heading = labelDay();\n    94\t    const dialogue = CAST[(member.day + member.sessions) % CAST.length];\n    95\t    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of movement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished ? 'ending' : 'sleep', true)}</div></div></main>`;\n    96\t  } else if (state.screen === 'activity') {\n    97\t    const activity = state.selection, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    98\t    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>How to play</h3><p>${activity.instruction}</p><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle mode is on.' : 'Make small, comfortable movements.'}</p><div class=\"actions\">${button('Back to island', state.classMode ? 'class' : 'island')}${button('Begin practice', 'start-activity', true)}</div></div></main>`;\n    99\t  } else if (state.screen === 'play') {\n   100\t    const activity = state.activity, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n   101\t    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your center.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"play-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span id=\"play-progress\"></span></div><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE START</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\n   102\t  } else if (state.screen === 'result') {\n   103\t    const result = state.result;\n.activity-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}\n.activity{border:1px solid #e4eee7;background:#f8fbf7;border-radius:19px;padding:15px;text-align:left;min-height:114px;position:relative}\n.activity:hover,.activity.is-focused{background:#edf8f1;border-color:#8ec9b3;transform:translateY(-2px)}\n.activity:disabled{opacity:.5;cursor:not-allowed}\n.activity-icon{display:grid;place-items:center;float:left;width:42px;height:42px;border-radius:13px;background:var(--tint,#e2f2e9);font-size:23px;margin-right:12px}\n.activity strong{display:block;font-size:16px}\n.activity small{display:block;color:#83948e;margin-top:5px}\n.activity .stars{color:#e4ad4f;font-size:13px;margin-top:8px}\n.hud-box{background:rgba(255,255,250,.92);border:1px solid rgba(255,255,255,.8);border-radius:20px;padding:14px 20px;box-shadow:0 9px 28px rgba(44,83,75,.09)}\n.hud-box strong{font-size:20px;letter-spacing:-.03em}\n.hud-box small{display:block;font-size:11px;color:#79938a;text-transform:uppercase;letter-spacing:.12em;font-weight:900;margin-bottom:3px}\n.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}\n.activity{padding:10px;min-height:92px}\n.activity-icon{width:34px;height:34px;font-size:18px}\n.activity strong{font-size:13px}\n.activity small{font-size:11px}\n.hud-box{padding:10px 12px}\n.hud-box strong{font-size:16px}\n","exit_code":0,"status":"completed"}}
