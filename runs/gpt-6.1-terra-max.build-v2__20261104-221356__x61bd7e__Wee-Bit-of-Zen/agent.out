ifts by itself after ten seconds (more when a player asks), as in a session;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:272:/** A game's own card, as the hub drives it: the countdown and who is ready, to every copy that shows one. */\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:278:    const card = { left, paused: false, starting: left === null, ready, asking: state.answers.more.size, asked: state.answers.more.has(cell.key) };\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:279:    const id = JSON.stringify({ ...card, left: left === null ? null : Math.ceil(left / 1000) });\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:280:    if (cell.cardSent === id) continue;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:281:    cell.cardSent = id;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:282:    cell.bridge.card(card);\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:286:/** A player answered on the game's own card: Ready, or more time (+10 s; again takes it back). */\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:300:  log(`${cell.key} answers ${what} on the game's card`);\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:440:    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:442:    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:443:    // A game that shows its own card takes the players' answers on it: Enter is Ready.\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:444:    if (caps.some((c) => c?.card)) {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:446:      const sent = await until(() => players.every((c) => c.cardSent), 2000);\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:449:      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/harness.html:453:    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:23:  maxRoundMs: 15 * 60_000,\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:64:  return Math.min(maxRoundMs, Math.round(typical * 1.5 * 60_000));\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:69: * then anyone who reported nothing, tied last. Equal times or scores share a\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:342:    toPresent({ type: 'time-up', graceMs: t.graceMs });\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:359:    const scores = {};\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:360:    for (const [id, r] of results) scores[id] = Number.isFinite(r.time) ? r.time : r.score;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:363:    finishPlayed(gone.length ? [...ranked, gone] : ranked, { scores, results: Object.fromEntries(results), stats, awards });\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:401:        seat.caps = { v: msg.v, client: msg.client, mode: msg.mode ?? null, seats: msg.seats ?? null, card: msg.card === true };\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:435:        const scores = msg.scores && typeof msg.scores === 'object' ? msg.scores : undefined;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:441:        return finishPlayed(checked.standings, { scores, won, stats, awards });\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests/hub/round.js:447:          markOut(seat, 'disconnected');\n","exit_code":0,"status":"completed"}}
