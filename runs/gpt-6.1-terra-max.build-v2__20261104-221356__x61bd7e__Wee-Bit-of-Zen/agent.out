board.getLayoutMap().then(m => { this._layout = m; }).catch(() => {}); } catch (e) { /* no layout map */ }\n    if (screen.listeners) screen.listeners.push(() => { if (this.stickOn) this._stickEnd({ pointerId: this.stickId }); });   // a resize or a turn of the phone moves the stick's origin: lift it (a screen of a page's own may have no listeners)\n    const on = (t, type, fn) => t.addEventListener(type, fn, { signal });\n    const typing = e => {\n      const t = e.target; if (!t || !t.tagName) return false;\n      if (t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable) return true;\n      return t.tagName === 'INPUT' && !['range', 'checkbox', 'radio', 'button', 'submit', 'color'].includes(t.type);\n    };\n    on(window, 'keydown', e => {\n      if (typing(e)) return;\n      const share = this.keysTo && this.keysTo.filter(q => q._codes[e.code]);   // (players sharing the keyboard: each answers to its half)\n      if (this._codes[e.code] || (share && share.length)) { e.preventDefault(); if (!e.repeat) { if (this._codes[e.code]) this.press(e.code); if (share) for (const q of share) q.press(e.code); } }\n      else if (this._zoomOn && ZOOM_KEYS[e.code] && !e.ctrlKey && !e.metaKey && !e.altKey) { e.preventDefault(); if (!e.repeat) this._zoomAcc *= ZOOM_KEYS[e.code]; }   // - and =, where no action uses them\n    });\n    // the wheel zooms where the game lets it (a mouse's notch 10%; a trackpad's pinch comes as the wheel with ctrlKey);\n    // not over a menu, which scrolls\n    el.addEventListener('wheel', e => {\n      const wc = e.deltaY < 0 ? 'WheelUp' : e.deltaY > 0 ? 'WheelDown' : null;\n      if (wc && this._codes[wc]) { e.preventDefault(); this._tapCode(wc); this.lastDevice = 'mouse'; return; }   // (a wheel bound to an action: a notch taps it, no zoom)\n      if (!this._wheelOn) return; e.preventDefault();\n      const d = e.deltaY * (e.deltaMode === 1 ? 33 : e.deltaMode === 2 ? 100 : 1);\n      this._zoomAcc *= clamp(Math.exp(-d * (e.ctrlKey ? .01 : .001)), .8, 1.25); this._zoomPt = this.screenPoint(e.clientX, e.clientY);\n    }, { signal, passive: false });\n    const all = f => { f(this); if (this.keysTo) for (const q of this.keysTo) f(q); };\n    on(window, 'keyup', e => all(q => q.release(e.code)));\n    on(window, 'blur', () => all(q => q.clear()));\n    on(document, 'visibilitychange', () => { if (document.hidden) all(q => q.clear()); });\n    on(el, 'contextmenu', e => e.preventDefault());\n    on(el, 'pointermove', e => { if (e.pointerType === 'mouse') { if (this.lastDevice !== 'mouse' && this.lastDevice !== 'keyboard' && Math.hypot(e.clientX - this.mouse.cx, e.clientY - this.mouse.cy) > 3) this.lastDevice = 'mouse'; this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.mouse.t = this.clock; this.aimSource = 'mouse'; this._fedAt = null; } else { this._pinchMove(e); this._stickMove(e); } if (this._g && this._g.id === e.pointerId) this._gesture('move', ...this.screenPoint(e.clientX, e.clientY)); });\n    on(el, 'pointerdown', e => {\n      if (e.pointerType !== 'mouse') this.lastDevice = 'touch';   // any touch, on the stick's half or not: prompts follow it\n      if (e.pointerType !== 'mouse' || e.button === 0) this._down = { id: e.pointerId, x: e.clientX, y: e.clientY };   // a click or tap once it lifts near here (pointerup)\n      if (e.pointerType === 'mouse') { this.mouse.cx = e.clientX; this.mouse.cy = e.clientY; this.mouse.active = true; this.aimSource = 'mouse'; this.press('Mouse' + e.button); }\n      else {\n        if (e.pointerType === 'touch' && !this._touched) { this._touched = true; if (this._touchArgs && !this._touchEl) this._touchSync(); }\n        this._fingers.set(e.pointerId, { x: e.clientX, y: e.clientY }); this._pinchArm();\n        const rc = this.zones && el.getBoundingClientRect(), z = rc && this._zone((e.clientX - rc.left) / rc.width, (e.clientY - rc.top) / rc.height);\n        if (z) this._zoneDown(e.pointerId, z); else if (!this.touchFilter || this.touchFilter(e)) this._stickStart(e);\n      }\n      if (e.pointerType === 'mouse' || this._fingers.size === 1) this._gesture('down', ...this.screenPoint(e.clientX, e.clientY), { touch: e.pointerType !== 'mouse', button: e.button, id: e.pointerId }); else this._g = this._gBox = null;   // (a second finger: a pinch, no gesture)\n    });\n    on(window, 'pointerup', e => {\n      const d = this._down; this._down = null;   // a click or tap: lifted within a few pixels of where it landed (a drag, the stick's, is none): clicked() for a step,\n      // in screen pixels now: where it touched what was drawn, before a phone's first tap goes full screen and moves the canvas\n      if (d && d.id === e.pointerId && Math.hypot(e.clientX - d.x, e.clientY - d.y) < 12) this._click = this.screenPoint(e.clientX, e.clientY);\n      if (this._g && this._g.id === e.pointerId) this._gesture('up', ...this.screenPoint(e.clientX, e.clientY));\n      if (e.pointerType === 'mouse') this.release('Mouse' + e.button); else { this._fingerUp(e); this._stickEnd(e); this._zoneUp(e.pointerId); }\n    });\n    on(window, 'pointercancel', e => { this._down = null; this._g = this._gBox = null; this._fingerUp(e); this._stickEnd(e); this._zoneUp(e.pointerId); });\n    on(el, 'lostpointercapture', e => this._stickEnd(e));\n  }\n  /** switch key layout at runtime: input.use(E.Input.PLATFORMER) or input.use('SHMUP'). The player's own bindings\n   *  (bindings, set by rebind() and the Controls screen) are laid over it. Every preset (E.Input.DEFAULT, PLATFORMER,\n   *  THIRDPERSON, SHMUP) has the moves (up, down, left, right) and the menu's actions (start, pause, confirm, cancel).\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AI Hub Session Harness</title>\n<meta name=\"description\" content=\"Test a game against the AI Hub Session Protocol: 1–4 copies next to each other on a simulated network.\">\n<style>\n  :root { color-scheme: dark; --bg: #0e0c14; --panel: #191623; --line: #2c2838; --ink: #ece8f4; --dim: #9a93ab; --ok: #4ade80; --bad: #f87171; --warn: #fbbf24; }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--ink); font: 14px/1.4 system-ui, sans-serif; }\n  body { display: grid; grid-template-rows: auto 1fr; }\n  header { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; padding: 8px 12px; background: var(--panel); border-bottom: 1px solid var(--line); }\n  header h1 { font-size: 15px; margin: 0 8px 0 0; }\n  header label { color: var(--dim); display: inline-flex; gap: 6px; align-items: center; }\n  input, select, button { font: inherit; color: var(--ink); background: #241f31; border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }\n  input[type=number] { width: 70px; }\n  input.game { width: 300px; }\n  button { cursor: pointer; }\n  button:hover { border-color: var(--dim); }\n  main { display: grid; grid-template-columns: 1fr 340px; min-height: 0; }\n  #grid { display: grid; gap: 6px; padding: 6px; min-height: 0; }\n  .cell { position: relative; display: grid; grid-template-rows: auto 1fr; min-height: 0; border: 2px solid var(--line); border-radius: 8px; overflow: hidden; background: #000; }\n  .cell__bar { display: flex; gap: 8px; align-items: center; padding: 3px 8px; background: var(--panel); font-size: 12px; }\n  .cell__dot { width: 10px; height: 10px; border-radius: 50%; }\n  .cell__state { margin-left: auto; color: var(--dim); }\n  .cell iframe { width: 100%; height: 100%; border: 0; background: #000; }\n  .cell.is-out { opacity: .35; }\n  aside { display: grid; grid-template-rows: auto auto 1fr; min-height: 0; border-left: 1px solid var(--line); background: var(--panel); }\n  aside section { padding: 8px 12px; border-bottom: 1px solid var(--line); }\n  aside h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--dim); margin: 0 0 6px; }\n  #checks li { list-style: none; }\n  #checks ul { margin: 0; padding: 0; }\n  .ok::before { content: '✓ '; color: var(--ok); }\n  .bad::before { content: '✗ '; color: var(--bad); }\n  .wait::before { content: '… '; color: var(--warn); }\n  #log { overflow: auto; font: 12px/1.35 ui-monospace, monospace; padding: 8px 12px; margin: 0; white-space: pre-wrap; }\n  #round { white-space: pre-wrap; font-size: 13px; }\n  .hint { color: var(--dim); }\n</style>\n</head>\n<body>\n<header>\n  <h1>AI Hub session harness</h1>\n  <label>Game <input class=\"game\" id=\"game\" placeholder=\"mygame.html or /games/mygame/index.html\"></label>\n  <label>Players <select id=\"players\"><option>1</option><option selected>2</option><option>3</option><option>4</option></select></label>\n  <label>Latency <input type=\"number\" id=\"latency\" min=\"0\" value=\"60\"> ms</label>\n  <label>Jitter <input type=\"number\" id=\"jitter\" min=\"0\" value=\"20\"> ms</label>\n  <label>Loss <input type=\"number\" id=\"loss\" min=\"0\" max=\"50\" value=\"0\"> %</label>\n  <button id=\"restart\" type=\"button\">New round</button>\n  <button id=\"release\" type=\"button\" title=\"End the splash now: the round starts once every game has loaded\">Start now</button>\n  <button id=\"timeup\" type=\"button\">Time up</button>\n  <label>Remove <select id=\"who\"></select></label>\n  <button id=\"remove\" type=\"button\">Remove player</button>\n  <button id=\"hide\" type=\"button\" aria-pressed=\"false\">Hide host tab</button>\n</header>\n<main>\n  <div id=\"grid\"><p class=\"hint\" style=\"padding:16px\">Name a game above (a path or URL served alongside this page), then press New round. Click a player's frame to control that player.</p></div>\n  <aside>\n    <section><h2>Round</h2><div id=\"round\" class=\"hint\">No round yet.</div></section>\n    <section id=\"checks\"><h2>Conformance</h2><ul id=\"checklist\"><li class=\"hint\">Run with <code>?auto=1</code> for the automatic checks.</li></ul></section>\n    <pre id=\"log\" aria-live=\"off\"></pre>\n  </aside>\n</main>\n<script type=\"module\">\nimport { createBridge, attachFrame, postTo, createLocalNetwork } from './bridge.js';\nimport { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n\nconst NAMES = ['Red Fox', 'Blue Otter', 'Green Heron', 'Gold Lynx'];\nconst params = new URLSearchParams(location.search);\nconst $ = (id) => document.getElementById(id);\nconst auto = params.get('auto') === '1';\nconst scenario = params.get('scenario') || 'standard';\n/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\nconst serverMode = scenario === 'server';\nconst playMs = Number(params.get('play')) || 6000;\nconst SPLASH_MS = 10_000;\n\nfor (const [id, key] of [['game', 'game'], ['players', 'players'], ['latency', 'latency'], ['jitter', 'jitter'], ['loss', 'loss']]) {\n  if (params.has(key)) $(id).value = params.get(key);\n}\n\nconst net = createLocalNetwork({});\nlet current = null;\nlet roundNo = 0;\nconst logLines = [];\nfunction log(text) {\n  const t = (performance.now() / 1000).toFixed(2).padStart(7);\n  logLines.push(`${t}  ${text}`);\n  if (logLines.length > 400) logLines.splice(0, logLines.length - 400);\n","exit_code":0,"status":"completed"}}
