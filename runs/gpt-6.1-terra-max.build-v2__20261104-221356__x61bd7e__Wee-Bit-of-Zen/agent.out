button:focus-visible,input:focus-visible,select:focus-visible{outline:4px solid #f3bb5d;outline-offset:3px}#world{position:fixed;inset:0;width:100%;height:100%;display:block}#app{position:fixed;inset:0;overflow:auto;scrollbar-width:thin}#app:empty{pointer-events:none}.page{min-height:100%;padding:clamp(20px,4vw,64px);display:flex;flex-direction:column;position:relative}.topbar{display:flex;justify-content:space-between;align-items:center;gap:15px;z-index:2}.brand{font-weight:900;letter-spacing:.15em;text-transform:uppercase;font-size:clamp(10px,.9vw,13px);display:flex;align-items:center;gap:10px}.brand-mark{display:grid;place-items:center;background:var(--teal);color:white;border-radius:50%;width:30px;height:30px;font-size:17px;letter-spacing:0}.top-actions{display:flex;gap:8px}.icon-btn,.small-btn{border:1px solid rgba(72,116,105,.18);background:rgba(255,255,250,.83);border-radius:999px;box-shadow:0 4px 12px rgba(42,72,64,.05);font-weight:800;padding:11px 17px}.icon-btn:hover,.small-btn:hover{background:#fff;transform:translateY(-2px)}.hero{flex:1;display:flex;align-items:center;min-height:0}.hero-copy{width:min(50%,620px);padding:28px 0 54px}.eyebrow{font-size:12px;font-weight:900;letter-spacing:.19em;text-transform:uppercase;color:#5b9186}.eyebrow:before{content:'';display:inline-block;width:25px;height:2px;background:#8fb9a5;vertical-align:middle;margin-right:10px}.logo{font-size:clamp(50px,7.5vw,108px);letter-spacing:-.075em;line-height:.88;margin:20px 0 22px;font-weight:900;color:#244944}.logo span{color:#49a99d}.lede{font-size:clamp(17px,1.6vw,23px);line-height:1.45;max-width:470px;color:#58716e;margin:0 0 28px}.menu-stack{display:grid;gap:10px;width:min(100%,370px)}.action{display:flex;align-items:center;justify-content:space-between;gap:20px;text-align:left;border:1px solid rgba(61,119,103,.11);background:rgba(255,255,250,.92);border-radius:18px;padding:16px 19px;box-shadow:0 6px 20px rgba(50,95,80,.06);font-weight:850;font-size:17px;transition:transform .15s,box-shadow .15s,background .15s}.action:hover,.action.is-focused{transform:translateX(6px);box-shadow:0 8px 24px rgba(46,112,98,.15);background:#fff}.action.primary{background:#2b9991;color:white;border-color:#2b9991}.action .arrow{font-size:19px;opacity:.75}.footer{display:flex;justify-content:space-between;gap:15px;align-items:center;font-size:11px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;color:#76918a;z-index:2}.footer strong{color:#44655e}.footer .hint{letter-spacing:.02em;text-transform:none}.main-wrap{flex:1;width:100%;max-width:1160px;margin:0 auto;display:flex;align-items:center;justify-content:center;padding:28px 0}.card{width:min(100%,760px);background:rgba(255,255,251,.96);border:1px solid rgba(255,255,255,.9);box-shadow:var(--shadow);border-radius:30px;padding:clamp(24px,4vw,50px);position:relative}.card.wide{width:min(100%,1060px)}.card.narrow{width:min(100%,560px)}.card h1,.card h2{letter-spacing:-.045em;line-height:1.05;margin:10px 0 12px}.card h1{font-size:clamp(32px,4.3vw,53px)}.card h2{font-size:clamp(25px,3vw,36px)}.card p{line-height:1.5;color:#667c79;font-size:17px}.card .action{background:#f4f8f4;box-shadow:none}.card .action.primary{background:#2b9991;color:white}.card .action:hover,.card .action.is-focused{background:#e7f3ed}.card .action.primary:hover,.card .action.primary.is-focused{background:#218b83}.card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.activity-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.activity{border:1px solid #e4eee7;background:#f8fbf7;border-radius:19px;padding:15px;text-align:left;min-height:114px;position:relative}.activity:hover,.activity.is-focused{background:#edf8f1;border-color:#8ec9b3;transform:translateY(-2px)}.activity:disabled{opacity:.5;cursor:not-allowed}.activity-icon{display:grid;place-items:center;float:left;width:42px;height:42px;border-radius:13px;background:var(--tint,#e2f2e9);font-size:23px;margin-right:12px}.activity strong{display:block;font-size:16px}.activity small{display:block;color:#83948e;margin-top:5px}.activity .stars{color:#e4ad4f;font-size:13px;margin-top:8px}.chip{display:inline-flex;align-items:center;gap:7px;border-radius:99px;background:#edf6ef;color:#56836f;font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.12em;padding:9px 12px}.chip.orange{background:#fff1d5;color:#ae7e31}.chip.pink{background:#fce9df;color:#b77e6e}.split{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center}.row{display:flex;align-items:center;justify-content:space-between;gap:16px}.divider{height:1px;background:#e7efe9;margin:19px 0}.field{display:grid;gap:8px;margin:16px 0;color:#748c83;font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:.12em}.field input,.field select{width:100%;border:2px solid #e3eee6;border-radius:14px;padding:13px 15px;color:var(--ink);background:#fbfdf9;font-size:17px;letter-spacing:0;text-transform:none}.options{display:flex;flex-wrap:wrap;gap:8px}.option{border:2px solid #e6eee6;border-radius:13px;padding:10px 14px;background:#f8fbf8;font-weight:800}.option.selected{border-color:#63b2a0;background:#e7f7ec}.dialogue{background:#eef8f2;border-radius:20px;padding:18px 20px;color:#42665c;font-size:18px;line-height:1.45}.dialogue strong{color:#278f82}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.actions .action{min-width:160px}.play-hud{position:absolute;inset:0;pointer-events:none;padding:clamp(18px,3vw,40px);display:flex;flex-direction:column;justify-content:space-between}.play-hud button{pointer-events:auto}.hud-top,.hud-bottom{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.hud-box{background:rgba(255,255,250,.92);border:1px solid rgba(255,255,255,.8);border-radius:20px;padding:14px 20px;box-shadow:0 9px 28px rgba(44,83,75,.09)}.hud-box strong{font-size:20px;letter-spacing:-.03em}.hud-box small{display:block;font-size:11px;color:#79938a;text-transform:uppercase;letter-spacing:.12em;font-weight:900;margin-bottom:3px}.meter{height:9px;width:180px;border-radius:20px;background:#e5efe6;overflow:hidden;margin-top:8px}.meter>i{display:block;height:100%;background:#efba68;border-radius:20px}.play-instruction{text-align:center;align-self:center;background:rgba(255,255,250,.91);border-radius:999px;padding:12px 20px;font-weight:800;color:#57776c;box-shadow:var(--shadow)}.progress-dots{display:flex;gap:6px}.progress-dots i{width:9px;height:9px;border-radius:50%;background:#dcebe2}.progress-dots i.on{background:#4cae9c}.score-big{font-size:clamp(48px,7vw,76px);font-weight:900;letter-spacing:-.07em;color:#2b9991;line-height:1}.stars-big{font-size:30px;color:#efb956;letter-spacing:5px}.note{font-size:13px!important;color:#91a39b!important}.scroll{max-height:min(57vh,570px);overflow:auto;padding-right:8px}.about-group{border-top:1px solid #e7efe9;padding:12px 0}.about-group h3{font-size:18px}.about-group p{font-size:14px;margin:5px 0;overflow-wrap:anywhere}.touch-notice{position:fixed;inset:0;z-index:20;display:grid;place-items:center;padding:20px;background:rgba(230,244,236,.92);text-align:center}.touch-notice .card{width:min(100%,460px)}.hidden{display:none!important}.toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:#284e49;color:#fff;border-radius:99px;padding:12px 22px;z-index:10;font-weight:800}.class-players{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.player-tile{padding:18px;background:#f2f8f1;border-radius:18px;text-align:center}.player-tile .face{font-size:35px}.slider{width:100%;accent-color:#38a597}.island-message{position:absolute;top:12%;left:50%;transform:translateX(-50%);text-align:center;white-space:nowrap;pointer-events:none}.island-message h1{font-size:clamp(24px,3.2vw,40px);margin:6px;letter-spacing:-.04em}.island-message p{margin:0;color:#708e82;font-weight:700}.map-actions{position:absolute;bottom:clamp(20px,4vh,45px);left:50%;transform:translateX(-50%);width:min(92%,760px);display:flex;justify-content:center;gap:10px}.map-actions .action{min-width:180px}.map-actions button{pointer-events:auto}.center-copy{text-align:center}.center-copy p{max-width:580px;margin-left:auto;margin-right:auto}\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/style.css:3:@media(max-width:850px){.hero-copy{width:58%}.logo{font-size:clamp(48px,8vw,72px)}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.footer .weather{display:none}.card{padding:26px}.main-wrap{align-items:flex-start;padding:25px 0}.page{min-height:100%;padding:22px}.play-hud{padding:16px}.island-message{top:12%}}\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/style.css:4:@media(max-width:540px){.page{padding:18px}.hero{align-items:flex-end}.hero-copy{width:100%;padding:30px 0 20px}.logo{font-size:58px;max-width:320px;margin:12px 0}.lede{font-size:16px;max-width:315px;margin-bottom:18px}.menu-stack{width:100%;max-width:340px}.action{padding:13px 16px;font-size:15px;border-radius:15px}.brand{font-size:10px}.footer{font-size:9px}.card-grid,.split{grid-template-columns:1fr}.activity-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.activity{padding:10px;min-height:92px}.activity-icon{width:34px;height:34px;font-size:18px}.activity strong{font-size:13px}.activity small{font-size:11px}.card h1{font-size:34px}.card p{font-size:15px}.hud-box{padding:10px 12px}.hud-box strong{font-size:16px}.meter{width:110px}.play-instruction{font-size:12px;max-width:90%;padding:10px 14px}.class-players{grid-template-columns:repeat(2,1fr)}.map-actions .action{min-width:0;flex:1}.map-actions{width:90%}.scroll{max-height:55vh}}\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:53:function shell(content, label = '', footer = true) {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:61:  return `<button class=\"activity ${locked ? 'locked' : ''}\" data-action=\"${locked ? 'locked' : 'select-activity'}\" data-id=\"${activity.id}\" style=\"--group:${group.color};--group-light:${group.light}\"><span class=\"activity-icon\">${activity.icon}</span><span class=\"activity-copy\"><span class=\"activity-group\">${group.name}</span><strong>${activity.name}</strong><small>${locked ? `Opens day ${activity.day}` : activity.tagline}</small></span><span class=\"activity-end\">${locked ? '⌁' : (stars ? '★'.repeat(stars) : '↗')}</span></button>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:76:    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; THE GUEST BOOK</div><h1>Make yourself at home.</h1><p>Choose a room for your island stay.</p></div></div><div class=\"card-grid\">${state.slots.map((slot, index) => `<button class=\"card slot-card\" data-action=\"slot\" data-id=\"${index}\"><span class=\"slot-num\">0${index + 1}</span><span class=\"slot-avatar\">${slot ? '☺' : '+'}</span><strong>${slot ? escapeHTML(slot.name) : 'New member'}</strong><small>${slot ? `${slot.finished ? 'Free practice' : `Day ${slot.day}`} · ${Math.floor(slot.minutes || 0)} fit minutes` : 'A fresh start awaits'}</small><span class=\"arrow\">↗</span></button>`).join('')}</div><div class=\"actions\">${button('Back', 'home')}</div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:79:    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; NICE TO MEET YOU</div><h1>A little about you.</h1><p>There is no wrong way to arrive.</p></div></div><div class=\"card setup-card\"><label class=\"field\">WHAT SHOULD WE CALL YOU?<input id=\"nickname\" maxlength=\"16\" value=\"${escapeHTML(member.name === 'Guest' ? '' : member.name)}\" placeholder=\"Your name\" autocomplete=\"off\"></label><p class=\"field-label\">CHOOSE YOUR COLOUR</p><div class=\"options\">${OUTFITS.map((color, index) => `<button class=\"option swatch ${member.outfit === index ? 'selected' : ''}\" data-action=\"outfit\" data-id=\"${index}\" style=\"--swatch:${color}\" aria-label=\"Outfit ${index + 1}\">${member.outfit === index ? '✓' : ''}</button>`).join('')}</div><p class=\"field-label\">YOUR INSTRUCTOR</p><div class=\"options\">${['Birch', 'Alder'].map(name => `<button class=\"option ${member.instructor === name ? 'selected' : ''}\" data-action=\"instructor\" data-id=\"${name}\">${name === 'Birch' ? '✳' : '✦'} &nbsp; ${name}</button>`).join('')}</div><div class=\"actions\">${button('Back', 'slots')}${button('Arrive on the island', 'create-member', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:85:    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">✳ &nbsp; BODY CHECK</div><h2>Just checking in.</h2><p id=\"check-text\">Find a comfortable center.</p></div><div class=\"hud-box timer\" id=\"check-timer\">05</div></div><div class=\"hud-bottom\"><div class=\"play-instruction\">${state.check?.phase === 'lean' ? 'Lean in each direction: ← ↑ → ↓' : 'Stay steady. Small wobbles are welcome.'}</div><div class=\"meter\"><span id=\"check-progress\"></span></div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:95:    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of movement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished ? 'ending' : 'sleep', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:101:    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your center.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"play-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span id=\"play-progress\"></span></div><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE START</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:118:    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect controllers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHTML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ? 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selection?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.name === 'Guest' ? 'home' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:124:    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card settings-card\">${settingRow('Music', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${settingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.tips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n--- tests ---\n#!/usr/bin/env python3\nimport json\nimport sys\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom threading import Thread\nfrom urllib.parse import quote\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = Path(__file__).resolve().parents[2]\nNAME = 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'\nURL = (ROOT / f'{NAME}.html').as_uri()\nchecks = 0\nfailures = 0\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, format, *args):\n        pass\n\n\ndef check(name, condition, detail=''):\n    global checks, failures\n    checks += 1\n    if not condition:\n        failures += 1\n        print(f'FAIL: {name}' + (f' — {detail}' if detail else ''))\n\n\ndef gameplay(page):\n    page.goto(URL, wait_until='load')\n    page.wait_for_function('window.__ZEN !== undefined')\n    check('standalone title', page.evaluate(\"__ZEN.state.screen === 'title'\"))\n    check('music defaults to 10%', page.evaluate('__ZEN.state.settings.music === 10'))\n    check('title has an accessible primary action', page.locator('button[data-action=\"slots\"]').count() == 1)\n    page.evaluate(\"__ZEN.step(11)\")\n    check('title has an attract mode', page.evaluate(\"__ZEN.state.screen === 'attract'\"))\n    page.keyboard.press('Enter')\n    check('keyboard exits attract mode', page.evaluate(\"__ZEN.state.screen === 'title'\"))\n    page.locator('button[data-action=\"about\"]').first.click()\n    about = page.locator('#app').inner_text().lower()\n    for heading in ('source information', 'testing feedback', 'engine feedback', 'prompt feedback'):\n        check(f'credits include {heading}', heading in about)\n    page.evaluate(\"__ZEN.action('about-back'); __ZEN.action('settings')\")\n    check('settings opens', page.evaluate(\"__ZEN.state.screen === 'settings'\"))\n    page.evaluate(\"__ZEN.action('toggle', 'gentle'); __ZEN.action('settings-back')\")\n    check('accessibility setting toggles', page.evaluate('__ZEN.state.settings.gentle === true'))\n    page.evaluate(\"__ZEN.action('slots'); __ZEN.action('slot', '0')\")\n    page.locator('#nickname').fill('Test Walker')\n    page.evaluate(\"__ZEN.action('create-member')\")\n    check('create a named profile', page.evaluate(\"__ZEN.state.screen === 'intro' && __ZEN.state.member.name === 'Test Walker'\"))\n    page.reload(wait_until='load')\n    page.evaluate(\"__ZEN.action('slots'); __ZEN.action('slot', '0')\")\n    check('profile survives reload', page.evaluate(\"__ZEN.state.member.name === 'Test Walker'\"))\n    check('setting survives reload', page.evaluate('__ZEN.state.settings.gentle === true'))\n\n    results = page.evaluate('''() => {\n      const z = window.__ZEN, found = [];\n      const verify = (name, value) => found.push({ name, pass: !!value });\n      for (let day = 1; day <= 5; day++) {\n        verify(`day ${day} starts`, z.state.member.day === day);\n        z.action('check'); z.step(20);\n        verify(`day ${day} check-in`, z.state.screen === 'question');\n        z.action('question-answer', 'bright'); z.action('island');\n        for (let session = 0; session < 3; session++) {\n          z.startActivity(ACTIVITIES[(day * 3 + session) % ACTIVITIES.length], { seconds: .1 });\n          z.step(.2);\n          verify(`day ${day} session ${session + 1}`, z.state.screen === 'result');\n          z.action('result-continue');\n        }\n        verify(`day ${day} records sessions`, z.state.member.sessions >= 3);\n        z.action('sleep');\n        if (day < 5) { verify(`day ${day} recap`, z.state.screen === 'recap'); z.action('next-day'); }\n      }\n      verify('festival unlocks', z.state.screen === 'festival');\n      for (let event = 0; event < 3; event++) {\n        z.action('festival-start'); z.step(31);\n        verify(`festival event ${event + 1}`, z.state.screen === 'result');\n        z.action('result-continue');\n      }\n      verify('story reaches the ending', z.state.screen === 'ending' && z.state.member.finished);\n      z.action('free-play');\n      verify('free practice follows ending', z.state.screen === 'island');\n      for (const activity of ACTIVITIES) {\n        z.startActivity(activity, { seconds: 1 });\n        if (activity.id === 'step') attemptInput('arrowleft');\n        if (activity.id === 'jog') { attemptInput('j'); attemptInput('k'); }\n        if (activity.id === 'hoop') { attemptInput('q'); attemptInput('e'); }\n        z.step(1.1);\n        verify(`${activity.name} completes`, z.state.screen === 'result' && Number.isFinite(z.state.result.percent));\n        z.action('result-continue');\n      }\n      z.startActivity(ACTIVITIES.find(activity => activity.id === 'stork'));\n      z.step(46);\n      verify('full-length session completes', z.state.screen === 'result');\n      z.action('result-continue');\n      z.startActivity(ACTIVITIES[0], { seconds: 5 }); z.step(.5); z.action('pause');\n      const paused = z.state.activity.elapsed; z.step(2);\n      verify('pause freezes the workout', z.state.activity.elapsed === paused);\n      z.action('dev'); tuning.spring = 3; z.action('reset-tuning');\n      verify('developer tuning resets', tuning.spring === tuningDefaults.spring);\n      z.action('resume'); verify('pause resumes', z.state.screen === 'play');\n      z.action('leave-play');\n      for (const count of [2, 3, 4]) {\n        z.state.classPlayers = [];\n        z.action('class');\n        if (count >= 3) z.action('class-toggle', '2');\n        if (count >= 4) z.action('class-toggle', '3');\n        z.action('start-class');\n        verify(`${count}-person class starts`, z.state.classActors.length === count - 1);\n        z.step(36);\n        verify(`${count}-person class finishes`, z.state.screen === 'class-result' && z.state.classScores.length === count);\n        verify(`${count}-person class has independent scores`, new Set(z.state.classScores.map(item => item.score)).size > 1);\n      }\n      z.state.classPlayers = []; z.action('class'); z.action('class-toggle', '1');\n      verify('second keyboard player joins', z.state.classPlayers[1].source === 'keyboard');\n      z.action('start-class'); keys.add('l'); z.step(1); keys.delete('l');\n      verify('second keyboard controls their own player', z.state.classActors[0].px > 0);\n      z.action('leave-play'); z.action('island');\n      return found;\n    }''')\n    for result in results:\n        check(result['name'], result['pass'])\n\n    gamepad = page.evaluate('''() => {\n      const z = window.__ZEN;\n      const makePad = index => ({ index, connected: true, mapping: 'standard', axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0 })) });\n      const first = makePad(0), second = makePad(1);\n      Object.defineProperty(navigator, 'getGamepads', { configurable: true, value: () => [first, second] });\n      z.action('home'); document.querySelector('[data-action=\"slots\"]').focus();\n      first.buttons[0].pressed = true; pollGamepad();\n      const selected = z.state.screen === 'slots';\n      first.buttons[0].pressed = false; pollGamepad();\n      z.state.classPlayers = []; z.action('class');\n      second.buttons[9].pressed = true; pollGamepad();\n      const joined = z.state.classPlayers.some(player => player?.source === 'gamepad' && player.padIndex === 1);\n      second.buttons[9].pressed = false; pollGamepad();\n      z.action('start-class'); second.axes[0] = 1; z.step(1);\n      const moved = z.state.classActors.some(actor => actor.player.padIndex === 1 && actor.px > 0);\n      delete navigator.getGamepads;\n      z.action('leave-play');\n      return { selected, joined, moved };\n    }''')\n    check('gamepad selects a menu item', gamepad['selected'])\n    check('second gamepad joins class', gamepad['joined'])\n    check('second gamepad controls its own player', gamepad['moved'])\n\n    sound = page.evaluate('''async () => {\n      unlockAudio(); await audioContext.resume();\n      const analyser = audioContext.createAnalyser(); analyser.fftSize = 2048;\n      const connect = AudioNode.prototype.connect;\n      AudioNode.prototype.connect = function(destination, ...args) {\n        if (destination === audioContext.destination) connect.call(this, analyser);\n        return connect.call(this, destination, ...args);\n      };\n      tone(440, .3, 1); await new Promise(resolve => setTimeout(resolve, 100));\n      const samples = new Float32Array(analyser.fftSize); analyser.getFloatTimeDomainData(samples);\n      AudioNode.prototype.connect = connect;\n      return samples.some(sample => Math.abs(sample) > .00001);\n    }''')\n    check('procedural audio produces samples', sound)\n\n\ndef hub(browser, players, scenario='standard'):\n    context = browser.new_context()\n    page = context.new_page()\n    try:\n        page.goto(f'{HUB_URL}?auto=1&game=game.html&players={players}&play=7000&scenario={scenario}')\n        page.wait_for_function('window.__hubCheck && window.__hubCheck.done', timeout=60000)\n        report = page.evaluate('window.__hubCheck')\n        for item in report['checks']:\n            check(f'Hub {players} {scenario}: {item[\"name\"]}', item['pass'], item.get('detail', ''))\n        check(f'Hub {players} {scenario}: conformance finished', report['pass'])\n    except Exception as error:\n        check(f'Hub {players} {scenario} completed', False, str(error).splitlines()[0])\n    finally:\n        context.close()\n\n\ndef smoke(browser, label, context_options=None):\n    context = browser.new_context(**(context_options or {}))\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(URL, wait_until='load')\n        page.wait_for_function('window.__ZEN !== undefined')\n        check(f'{label} renders title', page.evaluate(\"__ZEN.state.screen === 'title'\"))\n        if context_options and context_options.get('has_touch'):\n            check(f'{label} shows required controller notice', page.get_by_text('Controller or keyboard required').count() == 1)\n            page.locator('.touch-notice [data-action=\"settings\"]').click()\n            check(f'{label} can open settings', page.evaluate(\"__ZEN.state.screen === 'settings'\"))\n        else:\n            page.evaluate(\"__ZEN.action('slots'); __ZEN.action('slot', '0'); __ZEN.action('create-member'); __ZEN.action('check'); __ZEN.step(20)\")\n            check(f'{label} plays check-in', page.evaluate(\"__ZEN.state.screen === 'question'\"))\n        check(f'{label} has no JavaScript errors', not errors, '; '.join(errors))\n    except Exception as error:\n        check(f'{label} smoke test', False, str(error).splitlines()[0])\n    finally:\n        context.close()\n\n\ndef main():\n    global HUB_URL\n    server = ThreadingHTTPServer(('127.0.0.1', 0), partial(QuietHandler, directory=str(ROOT)))\n    Thread(target=server.serve_forever, daemon=True).start()\n    HUB_URL = f'http://127.0.0.1:{server.server_port}/{quote(NAME)}/tests/hub/harness.html'\n    with sync_playwright() as playwright:\n        chromium = playwright.chromium.launch(headless=True, args=['--autoplay-policy=no-user-gesture-required'])\n        context = chromium.new_context(viewport={'width': 1280, 'height': 720})\n        page = context.new_page()\n        errors = []\n        page.on('pageerror', lambda error: errors.append(str(error)))\n        try:\n            gameplay(page)\n        except Exception as error:\n            check('Chromium playthrough ran', False, str(error).splitlines()[0])\n        check('Chromium playthrough has no JavaScript errors', not errors, '; '.join(errors))\n        context.close()\n        for players in [1, 2, 3, 4]:\n            hub(chromium, players)\n        hub(chromium, 4, 'host-leave')\n        chromium.close()\n        for engine in ['firefox', 'webkit']:\n            browser = getattr(playwright, engine).launch(headless=True)\n            smoke(browser, engine)\n            if engine == 'webkit':\n                smoke(browser, 'iPhone WebKit', playwright.devices['iPhone 13'])\n            browser.close()\n    server.shutdown()\n    server.server_close()\n    print(f'{checks} checks, {failures} failures')\n    return 1 if failures else 0\n\n\nif __name__ == '__main__':\n    try:\n        sys.exit(main())\n    except Exception as error:\n        check('test runner', False, str(error).splitlines()[0])\n        print(f'{checks} checks, {failures} failures')\n        sys.exit(1)\n--- interview ---\n{\n  \"sourceInformation\": {\n    \"date\": \"2026-11-04 22:13:56\",\n    \"source\": \"Wii Fit\",\n    \"plan\": \"PLAN.md\",\n    \"genre\": \"Fitness party and life simulation\",\n    \"perspective\": \"2D, third-person island and exercise views\",\n    \"tech\": \"HTML5 Canvas, JavaScript, my-3D2dge handoff, Mocap, AI Hub client\",\n    \"artDirection\": \"Original soft, cheerful vector island, studio and characters\",\n    \"animation\": \"Procedural character animation and my-3D2dge Mocap clip set\",\n    \"audio\": \"Web Audio procedural music, effects and character voices; default music 10%\",\n    \"online\": \"AI Hub ghost sessions, 1–4 players\",\n    \"testing\": \"Headless scripted playthrough and browser/device testing\",\n    \"research\": \"Read the supplied plan, engine handoff and AI Hub protocol\",\n    \"environment\": \"Codex CLI (headless); Linux\",\n    \"model\": \"OpenAI, gpt-6.1-terra, reasoning effort max\",\n    \"usage\": \"added on import\"\n  },\n  \"testingFeedback\": [\"unknown\", \"unknown\", \"unknown\", \"unknown\"],\n  \"engineFeedback\": [\"The complete engine handoff provides a useful fixed-step game loop.\", \"unknown\", \"The game-specific activities, UI and island presentation.\", \"Combining the engine loop with the game's varied activities and session protocol.\", \"None.\", \"More small end-to-end examples combining fixed-step play, animation and the Hub.\"],\n  \"promptFeedback\": [\"The distinctive source, complete plan and clear handoff requirements.\", \"unknown\", \"Building and validating the varied activity and multiplayer flows.\", \"Include an explicit priority order for scope when a detailed plan exceeds one development session.\"],\n  \"aiHub\": {\n    \"name\": \"Wee Bit of Zen\",\n    \"tagline\": \"Find your balance. Lose it cheerfully.\",\n    \"description\": \"Visit a friendly island retreat and find your balance across gentle, playful exercises. Bring friends for a local or online class.\",\n    \"type\": \"Game\",\n    \"genre\": \"Sports\",\n    \"source\": \"Wii Fit\",\n    \"series\": \"Wii Fit\",\n    \"players\": \"1–4\",\n    \"controls\": \"Left stick/WASD to lean; R2/Space to breathe; Enter or Cross to select; Escape or Options to pause.\",\n    \"tags\": [\"2d\", \"sports\", \"simulation\", \"comedy\", \"story\", \"versus\"]\n  }\n}\n--- task requirements ---\n89-## Done\n90-No TODOs, placeholders, or stubbed features. The demo is complete.\n91-\n92:## Source Information\n93:CRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \"unknown\" for anything you can't confirm.\n94-- Date: 2026-11-04 22:13:56\n95-- Source: the work it's based on\n96-- Plan: the file name of the plan you were given to build from, or none\n--\n104-- Research: research done, or none\n105-- Environment: Codex CLI (headless); Linux\n106-- Model: OpenAI, gpt-6.1-terra, reasoning effort max\n107:- Usage: write \"added on import\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\n108-\n109:Exit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\"unknown\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\n110-{\n111-  \"sourceInformation\": {\"date\": \"\", \"source\": \"\", \"plan\": \"\", \"genre\": \"\", \"perspective\": \"\", \"tech\": \"\", \"artDirection\": \"\", \"animation\": \"\", \"audio\": \"\", \"online\": \"\", \"testing\": \"\", \"research\": \"\", \"environment\": \"\", \"model\": \"\", \"usage\": \"added on import\"},\n112:  \"testingFeedback\": [\"your answer to each Testing Feedback question, in order\"],\n113:  \"engineFeedback\": [\"your answer to each Engine Feedback question, in order\"],\n114:  \"promptFeedback\": [\"your answer to each Prompt Feedback question, in order\"],\n115-  \"aiHub\": {\n116-    \"name\": \"the game's title, as on its title screen\",\n117-    \"tagline\": \"a few words to go under the title\",\n--\n127-}\n128-The catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\n129-\n130:Testing Feedback\n131-\n132-- How many issues did testing catch?\n133-- How many would be considered critical issues / game breaking?\n134-- What was the most helpful test you ran?\n135-- What was the least helpful test you ran?\n136-\n137:Engine Feedback\n138-\n139-- What did you like most about the engine?\n140-- Did you get stuck or guess wrong?\n--\n143-- What did you change in the engine, and why? (none if nothing)\n144-- If you could change one thing about the engine, what would it be?\n145-\n146:Prompt Feedback\n147-\n148-- What did you like most about this prompt?\n149-- What was confusing?\n","exit_code":0,"status":"completed"}}
