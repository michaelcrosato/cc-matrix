uce the first self-contained HTML and a provisional structured exit interview.\n- [ ] Finish real multiplayer scoring, the three-event AI Hub session, and motion integration.\n- [ ] Exercise the game and inspect responsive, cross-browser screenshots; finalize the interview.\n\n## Notes\n- Keep all project work inside this run's workspace; do not inspect sibling runs.\n- Use Playwright's WebKit as the available approximation of iOS Safari.\n- The original handoff, motion sources, and hub client are in the development folder; `vendor/fitclips.js` is the generated local clip set.\n- Build with `node 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/build.mjs'`; this also copies the standalone build into the Hub harness.\n- A local preview is running at `http://127.0.0.1:32893/` in exec session `68330`; stop only that session when finished.\n- The first Chromium smoke test opened the standalone successfully. Title spacing, authentic class scoring, Hub sequencing, and applying the downloaded motion clips remain under review.\n\n--- game references ---\n20:  if (state.hub.active) return;\n68:function render() {\n98:    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>H\n105:    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue result-card\"><div class=\"eyebrow\">✳ &nbsp; PRACTICE COMPLETE</div><div class=\"stars-big\">${'★'.repeat(result.stars)}<span>${'☆'.repeat(3 - result.stars)}</span></div><h1>Lovely work${state.classMode ? ', everyone' : ''}.</h1><p>“${result.message}”</p><div class=\"result-stats\"><div><strong>${result.percent}%</strong><small>\n118:    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect controllers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+\n119:  } else if (state.screen === 'class-result') {\n127:    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', true)}${button('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', \n154:function startActivity(activity, options = {}) {\n158:  if (state.classMode && !state.hub.active) prepareClass();\n161:function completeActivity() {\n168:  if (!state.hub.active && !state.classMode) { const member = state.member; member.sessions = (member.sessions || 0) + 1; member.minutes = (member.minutes || 0) + minutes; member.stars[activity.id] = Math.max(member.stars[activity.id] || 0, stars); save(); }\n169:  tone(523, .3); if (state.hub.active) { finishHubEvent(); screen('hub'); } else if (state.classMode) screen('class-result'); else screen('result');\n186:function updateActivity(dt) {\n220:  if (state.classMode && !state.hub.active) updateClass(dt);\n221:  if (state.hub.active) {\n222:    const now = window.AIHub.time();\n223:    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n224:    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n226:  if (!state.hub.active && activity.elapsed >= activity.seconds) completeActivity();\n255:  if (state.screen === 'title') { state.idle += dt; if (state.idle >= 10 && !state.hub.active) screen('attract'); }\n262:    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n264:    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n270:    case 'island': state.classMode = false; screen('island'); break;\n271:    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n274:    case 'retry': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n275:    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n281:    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad', source: 'primary' }, { name: 'Gertrude', type: 'Bot', source: 'bot' }]; if (!CLASS_IDS.includes(state.selection?.id)) state.selection = ACTIVITIES[0]; screen('class'); break;\n282:    case 'class-toggle': { const index = Number(id); if (index === 0) break; const current = state.classPlayers[index]; state.classPlayers[index] = !current ? { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot', source: 'bot' } : index === 1 && current.source === 'bot' ? { name: 'Player 2', type: 'Keyboard 2', source: 'keyboard' } : null; render(); break; }\n283:    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n285:    case 'hub-ready': window.AIHub.answer('ready'); notify('Ready to go!'); break;\n286:    case 'hub-more': window.AIHub.answer('more'); notify('Waiting for more players.'); break;\n294:    case 'restart': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n295:    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n305:window.addEventListener('keydown', event => {\n317:window.addEventListener('keyup', event => keys.delete(event.key.toLowerCase()));\n318:window.addEventListener('blur', () => { keys.clear(); if (state.screen === 'play' && !state.hub.active) action('pause'); });\n322:function pollGamepad() {\n334:        else if (index === 1) { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (!state.hub.active) action('home'); }\n344:function frame(now) {\n357:if (state.hub.active) {\n359:  window.AIHub.on('start', () => { state.hub.started = true; state.hub.startedAt = window.AIHub.time(); startActivity(ACTIVITIES.find(activity => activity.id === 'stork'), { seconds: 60 }); });\n360:  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n361:  window.AIHub.on('time-up', () => { if (!state.hub.finished) { state.hub.finished = true; if (state.activity && state.screen === 'play') state.hub.score += state.activity.score / Math.max(1, state.activity.samples) * 1000; window.AIHub.result({ score: Math.round(state.hub.score) }); screen('hub'); } });\n362:  window.AIHub.on('end', () => { state.hub.finished = true; screen('hub'); });\n363:  window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }).then(() => window.AIHub.ready()).catch(() => notify('Unable to connect to the Hub.'));\n\n--- canvas refs ---\n61:function drawPerson(x, ground, size, options = {}) {\n99:function drawWorld(state) {\n119:    drawPerson(cx + size * .27, cy, size * .6, { time, movement: Math.sin(time * 1.2) * .2 });\n127:    drawPerson(cx, cy, size * .95, { time, lean, movement, shirt: state.shirt });\n","exit_code":0,"status":"completed"}}
