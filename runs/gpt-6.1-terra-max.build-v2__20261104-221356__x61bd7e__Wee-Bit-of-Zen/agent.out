{"type":"item.completed","item":{"id":"item_142","type":"command_execution","command":"/bin/bash -lc \"nl -ba 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js' | sed -n '1,68p;145,183p;245,370p'; nl -ba 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/art.js' | sed -n '50,145p'\"","aggregated_output":"     1\t'use strict';\n     2\t\n     3\tconst app = document.getElementById('app');\n     4\tconst STORAGE = 'wee-bit-of-zen-v1';\n     5\tconst DEFAULT_SETTINGS = { music: 10, sound: 10, voice: true, gentle: false, breathToggle: false, tips: true, glyphs: 'PlayStation' };\n     6\tlet stored;\n     7\ttry { stored = JSON.parse(localStorage.getItem(STORAGE) || '{}'); } catch (_) { stored = {}; }\n     8\tconst state = {\n     9\t  screen: 'title', clock: 0, idle: 0, input: 'keyboard', settings: { ...DEFAULT_SETTINGS, ...(stored.settings || {}) },\n    10\t  slots: Array.isArray(stored.slots) ? stored.slots : [null, null, null], slot: 0, member: null,\n    11\t  selection: null, activity: null, returnScreen: 'title', check: null, toast: '', classPlayers: [],\n    12\t  festival: false, festivalIndex: 0, hub: { active: !!window.AIHub?.active, started: false, finished: false, score: 0, lastSend: 0, lastProgress: 0, ghosts: {} }\n    13\t};\n    14\twhile (state.slots.length < 3) state.slots.push(null);\n    15\tconst keys = new Set();\n    16\tlet mouseLean = null, lastFrame = 0, lastHud = 0, audioContext = null, nextMusic = 0, gamepadPrevious = [];\n    17\tlet toggledBreath = false, pausedFrom = null;\n    18\t\n    19\tfunction save() {\n    20\t  if (state.hub.active) return;\n    21\t  if (state.member) state.slots[state.slot] = state.member;\n    22\t  try { localStorage.setItem(STORAGE, JSON.stringify({ settings: state.settings, slots: state.slots })); } catch (_) { notify('Saving is unavailable in this browser.'); }\n    23\t}\n    24\tfunction notify(text) {\n    25\t  state.toast = text;\n    26\t  const node = document.getElementById('toast');\n    27\t  if (node) { node.textContent = text; node.hidden = false; }\n    28\t  setTimeout(() => { if (state.toast === text) { state.toast = ''; const toast = document.getElementById('toast'); if (toast) toast.hidden = true; } }, 3000);\n    29\t}\n    30\tfunction tone(frequency, duration = .14, volume = .5, type = 'sine') {\n    31\t  if (!audioContext || audioContext.state !== 'running' || !state.settings.sound) return;\n    32\t  const oscillator = audioContext.createOscillator(), gain = audioContext.createGain(), now = audioContext.currentTime;\n    33\t  oscillator.type = type; oscillator.frequency.setValueAtTime(frequency, now);\n    34\t  gain.gain.setValueAtTime(.0001, now); gain.gain.exponentialRampToValueAtTime(Math.max(.00011, state.settings.sound / 100 * volume * .18), now + .015); gain.gain.exponentialRampToValueAtTime(.0001, now + duration);\n    35\t  oscillator.connect(gain); gain.connect(audioContext.destination); oscillator.start(now); oscillator.stop(now + duration + .01);\n    36\t}\n    37\tfunction unlockAudio() {\n    38\t  try { if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)(); if (audioContext.state === 'suspended') audioContext.resume(); } catch (_) {}\n    39\t}\n    40\tfunction music() {\n    41\t  if (!audioContext || audioContext.state !== 'running' || !state.settings.music || state.clock < nextMusic) return;\n    42\t  nextMusic = state.clock + 1.25;\n    43\t  const notes = [261.63, 329.63, 392, 493.88, 392, 329.63, 293.66, 349.23];\n    44\t  const oscillator = audioContext.createOscillator(), gain = audioContext.createGain(), now = audioContext.currentTime;\n    45\t  oscillator.type = 'sine'; oscillator.frequency.value = notes[Math.floor(state.clock / 1.25) % notes.length];\n    46\t  gain.gain.setValueAtTime(.0001, now); gain.gain.exponentialRampToValueAtTime(Math.max(.00011, state.settings.music / 100 * .035), now + .08); gain.gain.exponentialRampToValueAtTime(.0001, now + 1.1);\n    47\t  oscillator.connect(gain); gain.connect(audioContext.destination); oscillator.start(now); oscillator.stop(now + 1.15);\n    48\t}\n    49\tfunction hint() { return state.input === 'gamepad' ? (state.settings.glyphs === 'Xbox' ? 'A SELECT  ·  B BACK' : '✕ SELECT  ·  ○ BACK') : '↑ ↓ CHOOSE  ·  ENTER SELECT  ·  ESC BACK'; }\n    50\tfunction button(label, action, primary = false, id = '', detail = '') {\n    51\t  return `<button class=\"action${primary ? ' primary' : ''}\" data-action=\"${action}\" data-id=\"${escapeHTML(id)}\"><span>${label}${detail ? `<small>${detail}</small>` : ''}</span><span class=\"arrow\">↗</span></button>`;\n    52\t}\n    53\tfunction shell(content, label = '', footer = true) {\n    54\t  return `<div class=\"page\"><header class=\"topbar\"><button class=\"brand\" data-action=\"home\" aria-label=\"Return to title\"><span class=\"brand-mark\">✳</span><span>WEE BIT <b>OF ZEN</b></span></button><span class=\"top-label\">${label}</span><button class=\"settings-link\" data-action=\"settings\" aria-label=\"Settings\">⚙ <span>SETTINGS</span></button></header>${content}${footer ? `<footer class=\"footer\"><span>${hint()}</span><span>THE INSTITUTE FOR GENTLE IMPROVEMENT&nbsp; ✳ &nbsp; LUMBAR ISLAND</span></footer>` : ''}</div><div class=\"toast\" id=\"toast\" hidden></div>`;\n    55\t}\n    56\tfunction screen(name) { state.screen = name; state.idle = 0; render(); }\n    57\tfunction person() { return state.member || { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\n    58\tfunction labelDay() { const member = person(); return member.finished ? 'FREE PRACTICE' : `DAY ${member.day} OF 5`; }\n    59\tfunction tile(activity, locked = false) {\n    60\t  const group = GROUPS[activity.group], stars = person().stars?.[activity.id] || 0;\n    61\t  return `<button class=\"activity ${locked ? 'locked' : ''}\" data-action=\"${locked ? 'locked' : 'select-activity'}\" data-id=\"${activity.id}\" style=\"--group:${group.color};--group-light:${group.light}\"><span class=\"activity-icon\">${activity.icon}</span><span class=\"activity-copy\"><span class=\"activity-group\">${group.name}</span><strong>${activity.name}</strong><small>${locked ? `Opens day ${activity.day}` : activity.tagline}</small></span><span class=\"activity-end\">${locked ? '⌁' : (stars ? '★'.repeat(stars) : '↗')}</span></button>`;\n    62\t}\n    63\tfunction settingRow(label, value, action, id = '') { return `<div class=\"row\"><span>${label}</span><button class=\"chip setting-button\" data-action=\"${action}\" data-id=\"${id}\">${value}</button></div>`; }\n    64\tfunction aboutContent() {\n    65\t  const info = window.BUILD_INFO || {}, sections = [ ['Source Information', info.sourceInformation], ['Testing Feedback', info.testingFeedback], ['Engine Feedback', info.engineFeedback], ['Prompt Feedback', info.promptFeedback] ];\n    66\t  return sections.map(([title, value]) => `<div class=\"about-group\"><h3>${title}</h3>${Array.isArray(value) ? value.map((item, index) => `<p><b>${index + 1}.</b> ${escapeHTML(item)}</p>`).join('') : Object.entries(value || {}).map(([key, item]) => `<p><b>${escapeHTML(key)}:</b> ${escapeHTML(item)}</p>`).join('')}</div>`).join('');\n    67\t}\n    68\tfunction render() {\n   145\t}\n   146\tfunction currentButtons() { return [...app.querySelectorAll('button:not([disabled])')].filter(node => node.offsetParent !== null && !node.closest('.touch-notice')); }\n   147\tfunction focusMove(direction) {\n   148\t  const buttons = currentButtons(); if (!buttons.length) return;\n   149\t  const index = buttons.indexOf(document.activeElement); buttons[(index + direction + buttons.length) % buttons.length].focus();\n   150\t}\n   151\tfunction memberDefault() { return { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\n   152\tfunction beginCheck() { state.check = { phase: 'still', elapsed: 0, directions: new Set(), spine: 25 + Math.floor(Math.random() * 25) }; state.activity = null; screen('check'); }\n   153\tfunction startActivity(activity, options = {}) {\n   154\t  const selected = { ...activity }, duration = options.seconds || selected.seconds;\n   155\t  state.selection = selected;\n   156\t  state.activity = { ...selected, seconds: duration, elapsed: 0, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, ringX: 0, ringY: 0, flame: .6, score: 0, samples: 0, stumbles: 0, stun: 0, effort: 0, reps: 0, beatHits: 0, lastBeat: -1, lastJog: '', jogHits: 0, hoopHits: 0, good: 0, tray: 0, lastDirection: 0, motions: 0, rng: seeded(841 + selected.name.length) };\n   157\t  mouseLean = null; keys.clear(); toggledBreath = false; screen('play');\n   158\t}\n   159\tfunction completeActivity() {\n   160\t  const activity = state.activity;\n   161\t  if (!activity) return;\n   162\t  const percent = Math.round(clamp(activity.score / Math.max(1, activity.samples) * 100, 0, 100));\n   163\t  const stars = percent >= 90 ? 3 : percent >= 65 ? 2 : percent >= 35 ? 1 : 0;\n   164\t  const minutes = Math.max(1, Math.round(activity.seconds / 60 * (1 + stars * .25)));\n   165\t  state.result = { percent, stars, minutes, stumbles: activity.stumbles, message: stars >= 2 ? 'You made the wobble look rather elegant.' : 'A little practice is still a lovely thing.' };\n   166\t  if (!state.hub.active && !state.classMode) { const member = state.member; member.sessions = (member.sessions || 0) + 1; member.minutes = (member.minutes || 0) + minutes; member.stars[activity.id] = Math.max(member.stars[activity.id] || 0, stars); save(); }\n   167\t  tone(523, .3); if (state.hub.active) { state.hub.score += percent * 10; screen('hub'); } else screen('result');\n   168\t}\n   169\tfunction attemptInput(key) {\n   170\t  const activity = state.activity;\n   171\t  if (!activity || state.screen !== 'play') return;\n   172\t  if (activity.kind === 'step') {\n   173\t    const directions = ['arrowleft','arrowup','arrowright','arrowdown'];\n   174\t    const aliases = { a:'arrowleft', w:'arrowup', d:'arrowright', s:'arrowdown' };\n   175\t    const direction = aliases[key] || key, beat = Math.round(activity.elapsed * 100 / 60), phase = Math.abs(activity.elapsed * 100 / 60 - beat);\n   176\t    if (direction === directions[(beat + 4) % 4] && phase < .34 && beat !== activity.lastBeat) { activity.beatHits++; activity.lastBeat = beat; tone(520, .08, .35); }\n   177\t  }\n   178\t  if (activity.kind === 'jog' && (key === 'j' || key === 'k') && key !== activity.lastJog) { activity.lastJog = key; activity.jogHits++; }\n   179\t  if (activity.kind === 'hoop' && (key === 'q' || key === 'e')) { activity.hoopHits++; tone(660, .1, .3); }\n   180\t  if ((key === ' ' || key === 'enter') && state.settings.breathToggle) toggledBreath = !toggledBreath;\n   181\t}\n   182\tconst tuningDefaults = { spring: 11, damping: 6, instability: 1.3, noise: .19 };\n   183\tconst tuning = { ...tuningDefaults };\n   245\t  if (!timer) return;\n   246\t  timer.textContent = state.check.phase === 'still' ? String(Math.max(0, Math.ceil(5 - state.check.elapsed))).padStart(2, '0') : `${state.check.directions.size}/4`;\n   247\t  text.textContent = state.check.phase === 'still' ? 'Find a comfortable center.' : 'Lean left, up, right and down.';\n   248\t  progress.style.width = `${state.check.phase === 'still' ? clamp(state.check.elapsed / 5 * 50, 0, 50) : 50 + state.check.directions.size * 12.5}%`;\n   249\t}\n   250\tfunction update(dt) {\n   251\t  state.clock += dt;\n   252\t  if (state.screen === 'title') { state.idle += dt; if (state.idle >= 10 && !state.hub.active) screen('attract'); }\n   253\t  if (state.screen === 'check') { state.check.elapsed += dt; if (state.check.phase === 'still' && state.check.elapsed >= 5) { state.check.phase = 'lean'; state.check.elapsed = 0; } if (state.check.phase === 'lean' && (state.check.directions.size === 4 || state.check.elapsed >= 14)) screen('question'); }\n   254\t  if (state.screen === 'play') updateActivity(dt);\n   255\t}\n   256\tfunction action(name, id) {\n   257\t  unlockAudio(); state.idle = 0; tone(440, .07, .2);\n   258\t  switch (name) {\n   259\t    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n   260\t    case 'slots': screen('slots'); break;\n   261\t    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n   262\t    case 'outfit': state.member.outfit = Number(id); render(); break;\n   263\t    case 'instructor': state.member.instructor = id; render(); break;\n   264\t    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n   265\t    case 'check': beginCheck(); break;\n   266\t    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n   267\t    case 'island': state.classMode = false; screen('island'); break;\n   268\t    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n   269\t    case 'locked': notify('A new mat opens on a later day.'); break;\n   270\t    case 'start-activity': startActivity(state.selection); break;\n   271\t    case 'retry': startActivity(state.selection, { seconds: state.festival ? 30 : undefined }); break;\n   272\t    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n   273\t    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n   274\t    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n   275\t    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n   276\t    case 'ending': screen('ending'); break;\n   277\t    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n   278\t    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad' }, { name: 'Gertrude', type: 'Bot' }]; state.selection = state.selection || ACTIVITIES[0]; screen('class'); break;\n   279\t    case 'class-toggle': { const index = Number(id); if (index === 0) break; state.classPlayers[index] = state.classPlayers[index] ? null : { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot' }; render(); break; }\n   280\t    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n   281\t    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection); break;\n   282\t    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n   283\t    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n   284\t    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n   285\t    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n   286\t    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n   287\t    case 'pause': pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); break;\n   288\t    case 'resume': screen(pausedFrom || 'play'); break;\n   289\t    case 'restart': startActivity(state.selection, { seconds: state.festival ? 30 : undefined }); break;\n   290\t    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n   291\t    case 'dev': screen('dev'); break;\n   292\t    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n   293\t    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n   294\t    case 'about-back': screen(state.aboutReturn || 'title'); break;\n   295\t  }\n   296\t}\n   297\tapp.addEventListener('click', event => { const target = event.target.closest('[data-action]'); if (target) action(target.dataset.action, target.dataset.id); });\n   298\tapp.addEventListener('mouseover', event => { const target = event.target.closest('button'); if (target && state.input !== 'gamepad') target.focus({ preventScroll: true }); });\n   299\tapp.addEventListener('input', event => { const key = event.target.dataset.tuning; if (key) { tuning[key] = Number(event.target.value); document.getElementById(`out-${key}`).value = tuning[key]; } });\n   300\twindow.addEventListener('keydown', event => {\n   301\t  if (event.repeat && event.key !== ' ') return;\n   302\t  state.input = 'keyboard'; state.idle = 0; const key = event.key.toLowerCase();\n   303\t  if (state.screen === 'attract') { event.preventDefault(); screen('title'); return; }\n   304\t  if (event.target instanceof HTMLInputElement && event.target.type === 'text') { if (key === 'enter') { event.preventDefault(); action('create-member'); } return; }\n   305\t  if (['arrowup','arrowdown','arrowleft','arrowright',' '].includes(key)) event.preventDefault();\n   306\t  keys.add(key); unlockAudio();\n   307\t  if (state.screen === 'check' && state.check.phase === 'lean') { const mapping = { a:'left', arrowleft:'left', w:'up', arrowup:'up', d:'right', arrowright:'right', s:'down', arrowdown:'down' }; if (mapping[key]) state.check.directions.add(mapping[key]); return; }\n   308\t  if (state.screen === 'play') { if (key === 'escape') action('pause'); else attemptInput(key); return; }\n   309\t  if (key === 'escape' || key === 'backspace') { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (state.screen === 'dev') screen('pause'); else if (state.screen === 'activity') action('island'); else if (state.screen === 'slots' || state.screen === 'class') action('home'); return; }\n   310\t  if (key === 'arrowdown' || key === 's') focusMove(1); else if (key === 'arrowup' || key === 'w') focusMove(-1); else if ((key === 'enter' || key === ' ') && document.activeElement?.tagName !== 'BUTTON') { const buttons = currentButtons(); if (buttons.length) buttons[0].focus(); }\n   311\t});\n   312\twindow.addEventListener('keyup', event => keys.delete(event.key.toLowerCase()));\n   313\twindow.addEventListener('blur', () => { keys.clear(); if (state.screen === 'play' && !state.hub.active) action('pause'); });\n   314\twindow.addEventListener('mousemove', event => { if (state.screen !== 'play' || event.buttons === 0) return; state.input = 'mouse'; mouseLean = { x: clamp((event.clientX - innerWidth / 2) / (innerHeight * .33), -1, 1), y: clamp((event.clientY - innerHeight / 2) / (innerHeight * .33), -1, 1) }; });\n   315\twindow.addEventListener('mousedown', event => { if (state.screen === 'play' && event.button === 0) keys.add(' '); });\n   316\twindow.addEventListener('mouseup', () => keys.delete(' '));\n   317\tfunction pollGamepad() {\n   318\t  const pads = Array.from(navigator.getGamepads?.() || []);\n   319\t  for (const pad of pads) {\n   320\t    if (!pad) continue;\n   321\t    const previous = gamepadPrevious[pad.index] || [];\n   322\t    pad.buttons.forEach((item, index) => {\n   323\t      if (item.pressed && !previous[index]) {\n   324\t        state.input = 'gamepad'; state.idle = 0; unlockAudio();\n   325\t        if (state.screen === 'attract') screen('title');\n   326\t        else if (state.screen === 'play') { if (index === 9) action('pause'); else if (index === 4 || index === 5) attemptInput(index === 4 ? 'q' : 'e'); else if (index === 6 || index === 7) attemptInput(index === 6 ? 'j' : 'k'); }\n   327\t        else if (state.screen === 'check' && state.check.phase === 'lean') { if (index === 12) state.check.directions.add('up'); if (index === 13) state.check.directions.add('down'); if (index === 14) state.check.directions.add('left'); if (index === 15) state.check.directions.add('right'); }\n   328\t        else if (index === 0) { const selected = document.activeElement; if (selected?.tagName === 'BUTTON') selected.click(); else currentButtons()[0]?.focus(); }\n   329\t        else if (index === 1) { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (!state.hub.active) action('home'); }\n   330\t        else if (index === 12) focusMove(-1); else if (index === 13) focusMove(1);\n   331\t      }\n   332\t    });\n   333\t    if (state.screen === 'check' && state.check.phase === 'lean') { if (pad.axes[0] < -.45) state.check.directions.add('left'); if (pad.axes[0] > .45) state.check.directions.add('right'); if (pad.axes[1] < -.45) state.check.directions.add('up'); if (pad.axes[1] > .45) state.check.directions.add('down'); }\n   334\t    gamepadPrevious[pad.index] = pad.buttons.map(item => item.pressed);\n   335\t  }\n   336\t}\n   337\tconst simulation = new My3D2dge.Game({ headless: true, step: 1 / 120 });\n   338\tsimulation.start({ update, draw() {} });\n   339\tfunction frame(now) {\n   340\t  const dt = lastFrame ? Math.min(.1, (now - lastFrame) / 1000) : 0; lastFrame = now;\n   341\t  pollGamepad(); simulation.advance(dt); music(); drawWorld({ ...state, shirt: OUTFITS[person().outfit || 0] });\n   342\t  if (now - lastHud > 100) { if (state.screen === 'play') updateHUD(); if (state.screen === 'check') updateCheckHUD(); lastHud = now; }\n   343\t  requestAnimationFrame(frame);\n   344\t}\n   345\twindow.__ZEN = {\n   346\t  state, action, startActivity, tuning,\n   347\t  advance(seconds) { simulation.advance(seconds); render(); },\n   348\t  snapshot() { return JSON.parse(JSON.stringify({ screen: state.screen, member: state.member, activity: state.activity && { id: state.activity.id, elapsed: state.activity.elapsed, px: state.activity.px, py: state.activity.py, score: state.activity.score, stumbles: state.activity.stumbles }, result: state.result, hub: state.hub, settings: state.settings })); }\n   349\t};\n   350\trender(); requestAnimationFrame(frame);\n   351\t\n   352\tif (state.hub.active) {\n   353\t  screen('hub');\n   354\t  window.AIHub.on('start', () => { state.hub.started = true; state.hub.startedAt = window.AIHub.time(); startActivity(ACTIVITIES.find(activity => activity.id === 'stork'), { seconds: 60 }); });\n   355\t  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n   356\t  window.AIHub.on('time-up', () => { if (!state.hub.finished) { state.hub.finished = true; if (state.activity && state.screen === 'play') state.hub.score += state.activity.score / Math.max(1, state.activity.samples) * 1000; window.AIHub.result({ score: Math.round(state.hub.score) }); screen('hub'); } });\n   357\t  window.AIHub.on('end', () => { state.hub.finished = true; screen('hub'); });\n   358\t  window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }).then(() => window.AIHub.ready()).catch(() => notify('Unable to connect to the Hub.'));\n   359\t}\n    50\tfunction drawTare(x, y, size, mood) {\n    51\t  ellipse(x, y + size * .12, size * .58, size * .13, 'rgba(50,90,80,.13)');\n    52\t  rounded(x - size * .47, y - size * .37, size * .94, size * .48, size * .13, '#e4ede8');\n    53\t  rounded(x - size * .47, y - size * .43, size * .94, size * .48, size * .13, '#fffefa');\n    54\t  rounded(x - size * .22, y - size * .31, size * .44, size * .2, size * .05, '#d9efdf');\n    55\t  ellipse(x - size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n    56\t  ellipse(x + size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n    57\t  context.strokeStyle = '#416b60'; context.lineWidth = Math.max(1, size * .015); context.beginPath();\n    58\t  context.arc(x, y - size * .2, size * .045, .2, Math.PI - .2); context.stroke();\n    59\t  if (mood) { context.fillStyle = '#e6ad65'; context.font = `bold ${size * .2}px sans-serif`; context.fillText('✦', x + size * .57, y - size * .46); }\n    60\t}\n    61\tfunction drawPerson(x, ground, size, options = {}) {\n    62\t  const sway = (options.lean || 0) * size * .13 + Math.sin((options.time || 0) * 1.3) * size * .008;\n    63\t  const movement = options.movement || 0;\n    64\t  const skin = options.skin || '#e8b69b';\n    65\t  const shirt = options.shirt || '#f1c86c';\n    66\t  const trousers = options.trousers || '#527d75';\n    67\t  ellipse(x, ground + size * .035, size * .39, size * .065, 'rgba(56,95,80,.13)');\n    68\t  line(x - size * .1, ground - size * .31, x - size * (.16 + movement * .08), ground - size * .03, size * .105, trousers);\n    69\t  line(x + size * .1, ground - size * .31, x + size * (.16 - movement * .08), ground - size * .03, size * .105, trousers);\n    70\t  line(x - size * (.16 + movement * .08), ground - size * .03, x - size * (.23 + movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n    71\t  line(x + size * (.16 - movement * .08), ground - size * .03, x + size * (.23 - movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n    72\t  line(x - size * .13 + sway, ground - size * .6, x - size * .35 + sway, ground - size * (.49 + Math.abs(movement) * .12), size * .08, skin);\n    73\t  line(x + size * .13 + sway, ground - size * .6, x + size * .35 + sway, ground - size * (.49 - Math.abs(movement) * .12), size * .08, skin);\n    74\t  rounded(x - size * .19 + sway, ground - size * .68, size * .38, size * .4, size * .12, shirt);\n    75\t  line(x + sway, ground - size * .71, x + sway, ground - size * .65, size * .105, skin);\n    76\t  ellipse(x + sway, ground - size * .85, size * .19, size * .22, skin);\n    77\t  ellipse(x + sway, ground - size * .99, size * .19, size * .105, '#52655a');\n    78\t  ellipse(x - size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n    79\t  ellipse(x + size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n    80\t  context.strokeStyle = '#a56d61'; context.lineWidth = Math.max(1, size * .012); context.beginPath();\n    81\t  context.arc(x + sway, ground - size * .81, size * .045, .1, Math.PI - .1); context.stroke();\n    82\t}\n    83\tfunction drawScenery(time) {\n    84\t  const width = artWidth, height = artHeight;\n    85\t  const sky = context.createLinearGradient(0, 0, 0, height);\n    86\t  sky.addColorStop(0, '#e3f4ef'); sky.addColorStop(.55, '#eff8e9'); sky.addColorStop(1, '#bfe3d3');\n    87\t  context.fillStyle = sky; context.fillRect(0, 0, width, height);\n    88\t  ellipse(width * .77, height * .19, Math.min(width, height) * .11, Math.min(width, height) * .11, '#fae9b5');\n    89\t  drawCloud(width * .67 + Math.sin(time * .08) * 9, height * .15, width * .08);\n    90\t  drawCloud(width * .92, height * .27, width * .05);\n    91\t  context.fillStyle = '#c9e7d7'; context.beginPath(); context.moveTo(0, height * .64); context.quadraticCurveTo(width * .24, height * .31, width * .45, height * .61); context.quadraticCurveTo(width * .67, height * .36, width, height * .63); context.lineTo(width, height); context.lineTo(0, height); context.fill();\n    92\t  context.fillStyle = '#aedbc9'; context.beginPath(); context.moveTo(0, height * .69); context.quadraticCurveTo(width * .21, height * .51, width * .44, height * .68); context.quadraticCurveTo(width * .72, height * .46, width, height * .65); context.lineTo(width, height); context.lineTo(0, height); context.fill();\n    93\t  context.fillStyle = '#cdebe0'; context.fillRect(0, height * .7, width, height * .3);\n    94\t  for (let index = 0; index < 11; index++) {\n    95\t    const rippleX = ((index * 191 + time * 5) % (width + 100)) - 50;\n    96\t    line(rippleX, height * (.74 + (index % 4) * .045), rippleX + 42 + index * 3, height * (.74 + (index % 4) * .045), 2, 'rgba(255,255,255,.35)');\n    97\t  }\n    98\t}\n    99\tfunction drawWorld(state) {\n   100\t  const width = artWidth, height = artHeight, time = state.clock || 0;\n   101\t  context.clearRect(0, 0, width, height);\n   102\t  drawScenery(time);\n   103\t  const compact = width < 700;\n   104\t  const active = state.screen === 'play' || state.screen === 'check';\n   105\t  const cx = compact ? width * .52 : active ? width * .5 : width * .73;\n   106\t  const cy = active ? height * .76 : compact ? height * .46 : height * .68;\n   107\t  const size = Math.min(width * (compact ? .63 : .30), height * .52);\n   108\t  ellipse(cx, cy + size * .19, size * 1.05, size * .28, '#a9cfb5');\n   109\t  ellipse(cx, cy + size * .13, size, size * .26, '#d5e7c4');\n   110\t  ellipse(cx, cy + size * .07, size * .91, size * .2, '#e9efd4');\n   111\t  drawTree(cx - size * .7, cy - size * .1, size * .42);\n   112\t  drawTree(cx + size * .72, cy - size * .08, size * .3);\n   113\t  if (!active) {\n   114\t    rounded(cx - size * .37, cy - size * .39, size * .53, size * .32, size * .025, '#fff9e9');\n   115\t    context.fillStyle = '#dfaa88'; context.beginPath(); context.moveTo(cx - size * .43, cy - size * .39); context.lineTo(cx - size * .11, cy - size * .58); context.lineTo(cx + size * .21, cy - size * .39); context.closePath(); context.fill();\n   116\t    rounded(cx - size * .12, cy - size * .29, size * .11, size * .2, size * .012, '#9ec6b2');\n   117\t    rounded(cx - size * .31, cy - size * .29, size * .12, size * .1, size * .01, '#b4ddd2');\n   118\t    ellipse(cx + size * .28, cy + size * .02, size * .31, size * .09, '#a4cfc1');\n   119\t    drawPerson(cx + size * .27, cy, size * .6, { time, movement: Math.sin(time * 1.2) * .2 });\n   120\t    drawTare(cx + size * .58, cy + size * .08, size * .24, true);\n   121\t    for (let index = 0; index < 5; index++) ellipse(cx - size * .6 + index * size * .07, cy + size * .12, 3, 3, index % 2 ? '#f6c888' : '#fff8e5');\n   122\t  } else {\n   123\t    const activity = state.activity;\n   124\t    const lean = activity ? activity.px : 0;\n   125\t    const movement = activity ? Math.sin(activity.elapsed * (activity.kind === 'jog' ? 5 : 2)) * .6 : 0;\n   126\t    ellipse(cx, cy + size * .05, size * .55, size * .12, '#a5d2bf');\n   127\t    drawPerson(cx, cy, size * .95, { time, lean, movement, shirt: state.shirt });\n   128\t    drawTare(cx + size * .55, cy + size * .06, size * .22, false);\n   129\t    if (activity && activity.kind === 'candle') {\n   130\t      rounded(cx - size * .65, cy - size * .14, size * .11, size * .16, 4, '#fffaf0');\n   131\t      ellipse(cx - size * .595, cy - size * .16, size * .035, size * (.055 + activity.flame * .06), '#f7c05b');\n   132\t    }\n   133\t    if (activity && activity.kind === 'hoop') {\n   134\t      context.strokeStyle = '#f5ae80'; context.lineWidth = size * .035; context.beginPath(); context.ellipse(cx, cy - size * .35, size * .36, size * .09, -.08, 0, Math.PI * 2); context.stroke();\n   135\t    }\n   136\t    if (activity && activity.kind === 'tray') {\n   137\t      line(cx - size * .38, cy - size * .49, cx + size * .38, cy - size * .49 + lean * size * .1, size * .045, '#bb8b6d');\n   138\t      ellipse(cx, cy - size * .52, size * .06, size * .035, '#849e67');\n   139\t    }\n   140\t  }\n   141\t}\n","exit_code":0,"status":"completed"}}
