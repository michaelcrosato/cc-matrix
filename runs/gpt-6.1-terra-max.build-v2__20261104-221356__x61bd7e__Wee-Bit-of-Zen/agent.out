tate.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:174:  tone(523, .3); if (state.hub.active) { finishHubEvent(); screen('hub'); } else if (state.classMode) { finishClass(percent); screen('class-result'); } else screen('result');\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:280:    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:286:    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad', source: 'primary' }, { name: 'Gertrude', type: 'Bot', source: 'bot' }]; if (!CLASS_IDS.includes(state.selection?.id)) state.selection = ACTIVITIES[0]; screen('class'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:287:    case 'class-toggle': { const index = Number(id); if (index === 0) break; const current = state.classPlayers[index]; state.classPlayers[index] = !current ? { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot', source: 'bot' } : index === 1 && current.source === 'bot' ? { name: 'Player 2', type: 'Keyboard 2', source: 'keyboard' } : null; render(); break; }\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:289:    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection, { seconds: 35 }); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:14:    if (second && state.classPlayers[1]?.source === 'bot') second.textContent = 'USE KEYBOARD 2';\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:15:    else if (second && state.classPlayers[1]?.source === 'keyboard') second.textContent = 'REMOVE';\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:17:  if (state.screen === 'class-result' && state.classScores) {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:18:    main.innerHTML = `<div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Each score comes from that player's own practice.</p>${state.classScores.map((entry, index) => `<div class=\"row\"><span>${index === 0 ? '★ &nbsp;' : ''}${escapeHTML(entry.name)}${entry.bot ? ' · BOT' : ''}</span><b>${entry.score} points</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:42:  state.classActors = state.classPlayers.slice(1).map(player => ({ player, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, tray: 0, flame: .6, score: 0, samples: 0, hits: 0, lastBeat: -1 }));\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:43:  state.classScores = null;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:82:  board.innerHTML = `<span>${escapeHTML(state.classPlayers[0].name)} ${primary}</span>` + state.classActors.map(actor => `<span>${escapeHTML(actor.player.name)} ${Math.round(actor.score / Math.max(1, actor.samples) * 100)}${actor.player.source === 'bot' ? ' · BOT' : ''}</span>`).join('');\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:86:  state.classScores = [{ name: state.classPlayers[0].name, score: primary, bot: false }, ...state.classActors.map(actor => ({ name: actor.player.name, score: Math.round(actor.score / Math.max(1, actor.samples) * 100), bot: actor.player.source === 'bot' }))].sort((left, right) => right.score - left.score);\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:105:  if (state.classPlayers.some(player => player?.padIndex === index)) return;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:106:  const free = [1, 2, 3].find(slot => !state.classPlayers[slot] || state.classPlayers[slot].source === 'bot');\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/modes.js:108:  state.classPlayers[free] = { name: `Player ${free + 1}`, type: `Controller ${index + 1}`, source: 'gamepad', padIndex: index };\n--- tests ---\n#!/usr/bin/env python3\nimport json\nimport sys\nfrom functools import partial\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom pathlib import Path\nfrom threading import Thread\nfrom urllib.parse import quote\n\nfrom playwright.sync_api import sync_playwright\n\n\nROOT = Path(__file__).resolve().parents[2]\nNAME = 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'\nURL = (ROOT / f'{NAME}.html').as_uri()\nchecks = 0\nfailures = 0\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, format, *args):\n        pass\n\n\ndef check(name, condition, detail=''):\n    global checks, failures\n    checks += 1\n    if not condition:\n        failures += 1\n        print(f'FAIL: {name}' + (f' — {detail}' if detail else ''))\n\n\ndef gameplay(page):\n    page.goto(URL, wait_until='load')\n    page.wait_for_function('window.__ZEN !== undefined')\n    check('standalone title', page.evaluate(\"__ZEN.state.screen === 'title'\"))\n    check('music defaults to 10%', page.evaluate('__ZEN.state.settings.music === 10'))\n    check('title has an accessible primary action', page.locator('button[data-action=\"slots\"]').count() == 1)\n    page.evaluate(\"__ZEN.step(11)\")\n    check('title has an attract mode', page.evaluate(\"__ZEN.state.screen === 'attract'\"))\n    page.keyboard.press('Enter')\n    check('keyboard exits attract mode', page.evaluate(\"__ZEN.state.screen === 'title'\"))\n    page.locator('button[data-action=\"about\"]').first.click()\n    about = page.locator('#app').inner_text().lower()\n    for heading in ('source information', 'testing feedback', 'engine feedback', 'prompt feedback'):\n        check(f'credits include {heading}', heading in about)\n    page.evaluate(\"__ZEN.action('about-back'); __ZEN.action('settings')\")\n    check('settings opens', page.evaluate(\"__ZEN.state.screen === 'settings'\"))\n    page.evaluate(\"__ZEN.action('toggle', 'gentle'); __ZEN.action('settings-back')\")\n    check('accessibility setting toggles', page.evaluate('__ZEN.state.settings.gentle === true'))\n    page.evaluate(\"__ZEN.action('slots'); __ZEN.action('slot', '0')\")\n    page.locator('#nickname').fill('Test Walker')\n    page.evaluate(\"__ZEN.action('create-member')\")\n    check('create a named profile', page.evaluate(\"__ZEN.state.screen === 'intro' && __ZEN.state.member.name === 'Test Walker'\"))\n    page.reload(wait_until='load')\n    page.evaluate(\"__ZEN.action('slots'); __ZEN.action('slot', '0')\")\n    check('profile survives reload', page.evaluate(\"__ZEN.state.member.name === 'Test Walker'\"))\n    check('setting survives reload', page.evaluate('__ZEN.state.settings.gentle === true'))\n\n    results = page.evaluate('''() => {\n      const z = window.__ZEN, found = [];\n      const verify = (name, value) => found.push({ name, pass: !!value });\n      for (let day = 1; day <= 5; day++) {\n        verify(`day ${day} starts`, z.state.member.day === day);\n        z.action('check'); z.step(20);\n        verify(`day ${day} check-in`, z.state.screen === 'question');\n        z.action('question-answer', 'bright'); z.action('island');\n        for (let session = 0; session < 3; session++) {\n          z.startActivity(ACTIVITIES[(day * 3 + session) % ACTIVITIES.length], { seconds: .1 });\n          z.step(.2);\n          verify(`day ${day} session ${session + 1}`, z.state.screen === 'result');\n          z.action('result-continue');\n        }\n        verify(`day ${day} records sessions`, z.state.member.sessions >= 3);\n        z.action('sleep');\n        if (day < 5) { verify(`day ${day} recap`, z.state.screen === 'recap'); z.action('next-day'); }\n      }\n      verify('festival unlocks', z.state.screen === 'festival');\n      for (let event = 0; event < 3; event++) {\n        z.action('festival-start'); z.step(31);\n        verify(`festival event ${event + 1}`, z.state.screen === 'result');\n        z.action('result-continue');\n      }\n      verify('story reaches the ending', z.state.screen === 'ending' && z.state.member.finished);\n      z.action('free-play');\n      verify('free practice follows ending', z.state.screen === 'island');\n      for (const activity of ACTIVITIES) {\n        z.startActivity(activity, { seconds: 1 });\n        if (activity.id === 'step') attemptInput('arrowleft');\n        if (activity.id === 'jog') { attemptInput('j'); attemptInput('k'); }\n        if (activity.id === 'hoop') { attemptInput('q'); attemptInput('e'); }\n        z.step(1.1);\n        verify(`${activity.name} completes`, z.state.screen === 'result' && Number.isFinite(z.state.result.percent));\n        z.action('result-continue');\n      }\n      z.startActivity(ACTIVITIES.find(activity => activity.id === 'stork'));\n      z.step(46);\n      verify('full-length session completes', z.state.screen === 'result');\n      z.action('result-continue');\n      z.startActivity(ACTIVITIES[0], { seconds: 5 }); z.step(.5); z.action('pause');\n      const paused = z.state.activity.elapsed; z.step(2);\n      verify('pause freezes the workout', z.state.activity.elapsed === paused);\n      z.action('dev'); tuning.spring = 3; z.action('reset-tuning');\n      verify('developer tuning resets', tuning.spring === tuningDefaults.spring);\n      z.action('resume'); verify('pause resumes', z.state.screen === 'play');\n      z.action('leave-play');\n      for (const count of [2, 3, 4]) {\n        z.state.classPlayers = [];\n        z.action('class');\n        if (count >= 3) z.action('class-toggle', '2');\n        if (count >= 4) z.action('class-toggle', '3');\n        z.action('start-class');\n        verify(`${count}-person class starts`, z.state.classActors.length === count - 1);\n        z.step(36);\n        verify(`${count}-person class finishes`, z.state.screen === 'class-result' && z.state.classScores.length === count);\n        verify(`${count}-person class has independent scores`, new Set(z.state.classScores.map(item => item.score)).size > 1);\n      }\n      z.state.classPlayers = []; z.action('class'); z.action('class-toggle', '1');\n      verify('second keyboard player joins', z.state.classPlayers[1].source === 'keyboard');\n      z.action('start-class'); keys.add('l'); z.step(1); keys.delete('l');\n      verify('second keyboard controls their own player', z.state.classActors[0].px > 0);\n      z.action('leave-play'); z.action('island');\n      return found;\n    }''')\n    for result in results:\n        check(result['name'], result['pass'])\n\n    gamepad = page.evaluate('''() => {\n      const z = window.__ZEN;\n      const makePad = index => ({ index, connected: true, mapping: 'standard', axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0 })) });\n      const first = makePad(0), second = makePad(1);\n      Object.defineProperty(navigator, 'getGamepads', { configurable: true, value: () => [first, second] });\n      z.action('home'); document.querySelector('[data-action=\"slots\"]').focus();\n      first.buttons[0].pressed = true; pollGamepad();\n      const selected = z.state.screen === 'slots';\n      first.buttons[0].pressed = false; pollGamepad();\n      z.state.classPlayers = []; z.action('class');\n      second.buttons[9].pressed = true; pollGamepad();\n      const joined = z.state.classPlayers.some(player => player?.source === 'gamepad' && player.padIndex === 1);\n      second.buttons[9].pressed = false; pollGamepad();\n      z.action('start-class'); second.axes[0] = 1; z.step(1);\n      const moved = z.state.classActors.some(actor => actor.player.padIndex === 1 && actor.px > 0);\n      delete navigator.getGamepads;\n      z.action('leave-play');\n      return { selected, joined, moved };\n    }''')\n    check('gamepad selects a menu item', gamepad['selected'])\n    check('second gamepad joins class', gamepad['joined'])\n    check('second gamepad controls its own player', gamepad['moved'])\n\n    sound = page.evaluate('''async () => {\n      unlockAudio(); await audioContext.resume();\n      const analyser = audioContext.createAnalyser(); analyser.fftSize = 2048;\n      const connect = AudioNode.prototype.connect;\n      AudioNode.prototype.connect = function(destination, ...args) {\n        if (destination === audioContext.destination) connect.call(this, analyser);\n        return connect.call(this, destination, ...args);\n      };\n      tone(440, .3, 1); await new Promise(resolve => setTimeout(resolve, 100));\n      const samples = new Float32Array(analyser.fftSize); analyser.getFloatTimeDomainData(samples);\n      AudioNode.prototype.connect = connect;\n      return samples.some(sample => Math.abs(sample) > .00001);\n    }''')\n    check('procedural audio produces samples', sound)\n\n\ndef hub(browser, players, scenario='standard'):\n    context = browser.new_context()\n    page = context.new_page()\n    try:\n        page.goto(f'{HUB_URL}?auto=1&game=game.html&players={players}&play=7000&scenario={scenario}')\n        page.wait_for_function('window.__hubCheck && window.__hubCheck.done', timeout=60000)\n        report = page.evaluate('window.__hubCheck')\n        for item in report['checks']:\n            check(f'Hub {players} {scenario}: {item[\"name\"]}', item['pass'], item.get('detail', ''))\n        check(f'Hub {players} {scenario}: conformance finished', report['pass'])\n    except Exception as error:\n        check(f'Hub {players} {scenario} completed', False, str(error).splitlines()[0])\n    finally:\n        context.close()\n\n\ndef smoke(browser, label, context_options=None):\n    context = browser.new_context(**(context_options or {}))\n    page = context.new_page()\n    errors = []\n    page.on('pageerror', lambda error: errors.append(str(error)))\n    try:\n        page.goto(URL, wait_until='load')\n        page.wait_for_function('window.__ZEN !== undefined')\n        check(f'{label} renders title', page.evaluate(\"__ZEN.state.screen === 'title'\"))\n        if context_options and context_options.get('has_touch'):\n            check(f'{label} shows required controller notice', page.get_by_text('Controller or keyboard required').count() == 1)\n            page.locator('.touch-notice [data-action=\"settings\"]').click()\n            check(f'{label} can open settings', page.evaluate(\"__ZEN.state.screen === 'settings'\"))\n--- latest CSS ---\n.balance-plate{position:absolute;left:50%;bottom:20%;width:clamp(94px,13vw,160px);aspect-ratio:1;transform:translateX(-50%);border:2px solid #719f98;border-radius:50%;background:#ecfaf2cf;box-shadow:0 8px 24px #4d85732b;pointer-events:none}.plate-ring{position:absolute;inset:20%;border:2px dashed #8db9a4;border-radius:50%}.plate-dot{position:absolute;left:50%;top:50%;width:17px;height:17px;transform:translate(-50%,-50%);border:3px solid white;border-radius:50%;background:#e5785c;box-shadow:0 2px 6px #416e5e88}\n.brand,.settings-link{border:0;background:transparent;padding:0;cursor:pointer}\n.settings-link{display:flex;align-items:center;gap:8px;color:#527b70;font:800 11px/1 sans-serif;letter-spacing:.12em}\n.action small{display:block;margin-top:5px;font-size:11px;font-weight:600;letter-spacing:0;opacity:.72}\n.island-message span,.island-message strong{display:block}\n.island-message strong{margin-top:5px;font-size:18px;line-height:1.2}\n.class-live{position:absolute;left:18px;bottom:18px;z-index:3;display:flex;flex-wrap:wrap;gap:6px;max-width:calc(100% - 36px)}\n.class-live span{padding:7px 10px;border-radius:12px;background:#fffef0e8;color:#315d50;font-size:12px;font-weight:800;box-shadow:0 2px 10px #345a4b18}\n.page--play .topbar,.page--check .topbar{display:none}\n.island-main{flex-direction:column;align-items:stretch;gap:14px;padding:24px 0}\n.island-main .section-head{display:flex;align-items:center;justify-content:space-between;gap:20px}\n.island-main .section-head h1{margin:7px 0;font-size:clamp(28px,3vw,40px);letter-spacing:-.04em}\n.island-main .section-head p{margin:0;color:#69877d;font-weight:700}\n.day-badge{display:flex;align-items:center;gap:12px;flex-shrink:0;padding:12px 18px;border-radius:18px;background:#fffef0eb;box-shadow:0 6px 22px #345a4b12}\n.day-badge strong{font-size:30px;line-height:1;color:#278f82}.day-badge small{font-size:14px;color:#84a398}.day-badge span{font-size:10px;line-height:1.35;letter-spacing:.1em;font-weight:900;color:#749187}\n.island-main .activity-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}\n.island-main .activity{display:flex;align-items:flex-start;gap:10px;min-height:94px;padding:12px}\n.island-main .activity-icon{float:none;flex-shrink:0;margin:0;background:var(--group-light)}\n.activity-copy{display:flex;flex-direction:column;min-width:0}.activity-group{color:var(--group);font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}\n.activity-copy strong{margin-top:3px;line-height:1.12}.activity-copy small{line-height:1.2}.activity-end{flex-shrink:0;margin-left:auto;color:var(--group);font-weight:900}\n.activity.locked{opacity:.68}\n.island-bar{display:flex;justify-content:space-between;align-items:center;gap:14px}.island-bar p{margin:0;padding:12px 16px;border-radius:16px;background:#fffef0eb;color:#58796e;line-height:1.35}.island-bar p b{color:#278f82}\n.island-bar .map-actions{position:static;transform:none;width:auto;flex-shrink:0}.island-bar .map-actions .action{min-width:145px}\n.hud-box h2{margin:7px 0 3px;line-height:1.1}.hud-box p{margin:0;color:#718b80}.hud-box.timer{min-width:82px;text-align:center;font-size:30px;line-height:1;font-weight:900;color:#278f82}.hud-box.timer small{margin:4px 0 0}\n.hud-bottom{align-items:center}.hud-bottom .meter{width:clamp(100px,18vw,260px);margin:0}.meter>span{display:block;height:100%;border-radius:20px;background:#efba68}\n.hud-caption{display:flex;flex-direction:column;align-items:flex-end;gap:5px;padding:10px 14px;border-radius:16px;background:#fffef0eb;color:#52766a;font-size:11px;font-weight:900;letter-spacing:.08em}\n.class-live{top:clamp(140px,20vh,170px);bottom:auto;left:clamp(18px,3vw,40px)}\n@media(max-width:850px){.island-main{align-items:stretch}.island-main .activity-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.island-bar{flex-wrap:wrap}.island-bar .map-actions{width:100%;justify-content:flex-end}}\n@media(max-width:540px){.island-main{gap:12px}.island-main .section-head{align-items:flex-start}.island-main .section-head h1{font-size:28px}.day-badge{padding:10px;gap:7px}.day-badge strong{font-size:23px}.island-main .activity-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.island-main .activity{gap:7px;padding:10px;min-height:94px}.activity-copy strong{font-size:13px}.activity-copy small{font-size:10px}.activity-group{font-size:9px}.activity-end{font-size:11px}.island-bar .map-actions .action{min-width:0}.hud-bottom{display:grid;grid-template-columns:minmax(0,1fr) auto}.hud-bottom .meter{grid-column:1/-1;width:100%}.hud-caption{font-size:9px}.class-live{top:115px}}\n","exit_code":0,"status":"completed"}}
