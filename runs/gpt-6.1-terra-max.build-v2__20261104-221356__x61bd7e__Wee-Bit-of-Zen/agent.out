en === 'hub') {\n   135\t    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n   136\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A little steadiness, shared.'}</h1><p>${state.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; everyone gets a moment to breathe.'}</p><div class=\"result-stats\"><div><strong>${Math.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.started ? 'The class is underway.' : 'Waiting for the other guests…'}</p></div></main>`;\n   137\t  }\n   138\t  app.innerHTML = shell(content, heading, state.screen !== 'play' && state.screen !== 'check');\n   139\t  enhanceModes();\n   140\t  if (state.screen === 'play') updateHUD();\n   141\t  if (state.screen === 'check') updateCheckHUD();\n   142\t  const touchOnly = matchMedia('(pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n   143\t  if (touchOnly && !['settings','about'].includes(state.screen)) {\n   144\t    const notice = document.createElement('div'); notice.className = 'touch-notice'; notice.innerHTML = '<div><span>✳</span><h2>Controller or keyboard required</h2><p>Connect a controller or keyboard to enjoy the island.</p><button class=\"action primary\" data-action=\"settings\">Settings <span class=\"arrow\">↗</span></button></div>'; app.appendChild(notice);\n   145\t  }\n   146\t}\n   147\tfunction currentButtons() { return [...app.querySelectorAll('button:not([disabled])')].filter(node => node.offsetParent !== null && !node.closest('.touch-notice')); }\n   148\tfunction focusMove(direction) {\n   149\t  const buttons = currentButtons(); if (!buttons.length) return;\n   150\t  const index = buttons.indexOf(document.activeElement); buttons[(index + direction + buttons.length) % buttons.length].focus();\n   151\t}\n   152\tfunction memberDefault() { return { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\n   153\tfunction beginCheck() { state.check = { phase: 'still', elapsed: 0, directions: new Set(), spine: 25 + Math.floor(Math.random() * 25) }; state.activity = null; screen('check'); }\n   154\tfunction startActivity(activity, options = {}) {\n   155\t  const selected = { ...activity }, duration = options.seconds || selected.seconds;\n   156\t  state.selection = selected;\n   157\t  state.activity = { ...selected, seconds: duration, elapsed: 0, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, ringX: 0, ringY: 0, flame: .6, score: 0, samples: 0, stumbles: 0, stun: 0, effort: 0, reps: 0, beatHits: 0, lastBeat: -1, lastJog: '', jogHits: 0, hoopHits: 0, good: 0, tray: 0, lastDirection: 0, motions: 0, rng: seeded(841 + selected.name.length) };\n   158\t  if (state.classMode && !state.hub.active) prepareClass();\n   159\t  mouseLean = null; keys.clear(); toggledBreath = false; screen('play');\n   160\t}\n   161\tfunction completeActivity() {\n   162\t  const activity = state.activity;\n   163\t  if (!activity) return;\n   164\t  const percent = Math.round(clamp(activity.score / Math.max(1, activity.samples) * 100, 0, 100));\n   165\t  const stars = percent >= 90 ? 3 : percent >= 65 ? 2 : percent >= 35 ? 1 : 0;\n   166\t  const minutes = Math.max(1, Math.round(activity.seconds / 60 * (1 + stars * .25)));\n   167\t  state.result = { percent, stars, minutes, stumbles: activity.stumbles, message: stars >= 2 ? 'You made the wobble look rather elegant.' : 'A little practice is still a lovely thing.' };\n   168\t  if (!state.hub.active && !state.classMode) { const member = state.member; member.sessions = (member.sessions || 0) + 1; member.minutes = (member.minutes || 0) + minutes; member.stars[activity.id] = Math.max(member.stars[activity.id] || 0, stars); save(); }\n   169\t  tone(523, .3); if (state.hub.active) { finishHubEvent(); screen('hub'); } else if (state.classMode) screen('class-result'); else screen('result');\n   170\t}\n   171\tfunction attemptInput(key) {\n   172\t  const activity = state.activity;\n   173\t  if (!activity || state.screen !== 'play') return;\n   174\t  if (activity.kind === 'step') {\n   175\t    const directions = ['arrowleft','arrowup','arrowright','arrowdown'];\n   176\t    const aliases = { a:'arrowleft', w:'arrowup', d:'arrowright', s:'arrowdown' };\n   177\t    const direction = aliases[key] || key, beat = Math.round(activity.elapsed * 100 / 60), phase = Math.abs(activity.elapsed * 100 / 60 - beat);\n   178\t    if (direction === directions[(beat + 4) % 4] && phase < .34 && beat !== activity.lastBeat) { activity.beatHits++; activity.lastBeat = beat; tone(520, .08, .35); }\n   179\t  }\n   180\t  if (activity.kind === 'jog' && (key === 'j' || key === 'k') && key !== activity.lastJog) { activity.lastJog = key; activity.jogHits++; }\n   181\t  if (activity.kind === 'hoop' && (key === 'q' || key === 'e')) { activity.hoopHits++; tone(660, .1, .3); }\n   182\t  if ((key === ' ' || key === 'enter') && state.settings.breathToggle) toggledBreath = !toggledBreath;\n   183\t}\n   184\tconst tuningDefaults = { spring: 11, damping: 6, instability: 1.3, noise: .19 };\n   185\tconst tuning = { ...tuningDefaults };\n   186\tfunction updateActivity(dt) {\n   187\t  const activity = state.activity; if (!activity) return;\n   188\t  activity.elapsed += dt;\n   189\t  const pad = Array.from(navigator.getGamepads?.() || []).find(candidate => candidate && !state.classActors?.some(actor => actor.player.padIndex === candidate.index)), axisX = pad && Math.abs(pad.axes[0]) > .12 ? pad.axes[0] : 0, axisY = pad && Math.abs(pad.axes[1]) > .12 ? pad.axes[1] : 0;\n   190\t  const dx = (keys.has('arrowright') || keys.has('d') ? 1 : 0) - (keys.has('arrowleft') || keys.has('a') ? 1 : 0);\n   191\t  const dy = (keys.has('arrowdown') || keys.has('s') ? 1 : 0) - (keys.has('arrowup') || keys.has('w') ? 1 : 0);\n   192\t  if (activity.stun <= 0) {\n   193\t    if (mouseLean) { activity.ux = mouseLean.x; activity.uy = mouseLean.y; }\n   194\t    else if (axisX || axisY) { activity.ux = axisX; activity.uy = axisY; }\n   195\t    else { activity.ux = clamp(activity.ux + dx * 2.2 * dt, -1, 1); activity.uy = clamp(activity.uy + dy * 2.2 * dt, -1, 1); if (!dx) activity.ux *= Math.max(0, 1 - .5 * dt); if (!dy) activity.uy *= Math.max(0, 1 - .5 * dt); }\n   196\t  } else activity.stun -= dt;\n   197\t  const gentle = state.settings.gentle ? .7 : 1, time = activity.elapsed, disturbance = tuning.noise * gentle;\n   198\t  const ax = tuning.spring * (activity.ux - activity.px) - tuning.damping * activity.vx + tuning.instability * gentle * activity.px + disturbance * (Math.sin(time * 1.7) + .5 * Math.sin(time * 3.23));\n   199\t  const ay = tuning.spring * (activity.uy - activity.py) - tuning.damping * activity.vy + tuning.instability * gentle * activity.py + disturbance * (Math.sin(time * 1.19 + 1) + .5 * Math.sin(time * 2.71));\n   200\t  activity.vx += ax * dt; activity.vy += ay * dt; activity.px += activity.vx * dt; activity.py += activity.vy * dt;\n   201\t  if (Math.hypot(activity.px, activity.py) >= 1 && activity.stun <= 0) { activity.stumbles++; activity.stun = 1; activity.px *= .5; activity.py *= .5; activity.vx *= -.2; activity.vy *= -.2; tone(196, .18); }\n   202\t  const phase = Math.floor(time / 12), rng = seeded(phase * 667 + 43);\n   203\t  activity.ringX = activity.id === 'stork' ? (rng() - .5) * .65 : activity.kind === 'slalom' ? Math.sin(time * .55) * .46 : 0;\n   204\t  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n   205\t  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n   206\t  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n   207\t  let quality = steadiness;\n   208\t  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n   209\t  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n   210\t  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n   211\t  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n   212\t  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n   213\t  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n   214\t  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n   215\t  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n   216\t  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n   217\t  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n   218\t  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n   219\t  activity.score += quality; activity.samples++;\n   220\t  if (state.classMode && !state.hub.active) updateClass(dt);\n   221\t  if (state.hub.active) {\n   222\t    const now = window.AIHub.time();\n   223\t    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n   224\t    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n   225\t  }\n   226\t  if (!state.hub.active && activity.elapsed >= activity.seconds) completeActivity();\n   227\t}\n   228\tfunction updateHUD() {\n   229\t  const activity = state.activity; if (!activity) return;\n   230\t  const timer = document.getElementById('play-timer'), status = document.getElementById('play-status'), instruction = document.getElementById('play-instruction'), progress = document.getElementById('play-progress'), dot = document.getElementById('plate-dot'), ring = document.getElementById('plate-ring'), score = document.getElementById('play-score');\n   231\t  if (!timer) return;\n   232\t  timer.textContent = Math.max(0, Math.ceil(activity.seconds - activity.elapsed));\n   233\t  if (activity.kind === 'step') { const arrows = ['←','↑','→','↓']; const beat = Math.round(activity.elapsed * 100 / 60); status.textContent = `NEXT STEP  ${arrows[(beat + 4) % 4]}   ·   ${activity.beatHits} on beat`; instruction.textContent = `Press ${arrows[(beat + 4) % 4]} on the beat · ${activity.instruction}`; }\n   234\t  else if (activity.kind === 'rep') status.textContent = `Rep ${activity.reps + 1} · ${Math.sin(activity.elapsed * Math.PI / 2 - Math.PI / 2) > 0 ? 'Rise gently' : 'Lower gently'}`;\n   235\t  else if (activity.kind === 'breath') status.textContent = Math.sin(activity.elapsed * Math.PI / 4) > 0 ? 'Breathe in · hold' : 'Breathe out · release';\n   236\t  else if (activity.kind === 'candle') status.textContent = `Flame ${Math.round(activity.flame * 100)}% · ${activity.flame < .15 ? 'settle to relight' : 'let it glow'}`;\n   237\t  else if (activity.kind === 'jog') status.textContent = `${activity.jogHits} steps · alternate J and K`;\n   238\t  else if (activity.kind === 'hoop') status.textContent = `${activity.hoopHits} catches · circle your lean`;\n   239\t  else status.textContent = activity.stun > 0 ? 'A wobble! Take a moment.' : 'Find the ring. Breathe naturally.';\n   240\t  progress.style.width = `${clamp(activity.elapsed / activity.seconds * 100, 0, 100)}%`;\n   241\t  dot.style.transform = `translate(${activity.px * 70}px, ${activity.py * 70}px)`;\n   242\t  ring.style.transform = `translate(${activity.ringX * 70}px, ${activity.ringY * 70}px)`;\n   243\t  score.textContent = `${Math.round(activity.score / Math.max(1, activity.samples) * 100)}% STEADY`;\n   244\t}\n   245\tfunction updateCheckHUD() {\n   246\t  if (!state.check) return;\n   247\t  const timer = document.getElementById('check-timer'), text = document.getElementById('check-text'), progress = document.getElementById('check-progress');\n   248\t  if (!timer) return;\n   249\t  timer.textContent = state.check.phase === 'still' ? String(Math.max(0, Math.ceil(5 - state.check.elapsed))).padStart(2, '0') : `${state.check.directions.size}/4`;\n   250\t  text.textContent = state.check.phase === 'still' ? 'Find a comfortable center.' : 'Lean left, up, right and down.';\n   251\t  progress.style.width = `${state.check.phase === 'still' ? clamp(state.check.elapsed / 5 * 50, 0, 50) : 50 + state.check.directions.size * 12.5}%`;\n   252\t}\n   253\tfunction update(dt) {\n   254\t  state.clock += dt;\n   255\t  if (state.screen === 'title') { state.idle += dt; if (state.idle >= 10 && !state.hub.active) screen('attract'); }\n   256\t  if (state.screen === 'check') { state.check.elapsed += dt; if (state.check.phase === 'still' && state.check.elapsed >= 5) { state.check.phase = 'lean'; state.check.elapsed = 0; } if (state.check.phase === 'lean' && (state.check.directions.size === 4 || state.check.elapsed >= 14)) screen('question'); }\n   257\t  if (state.screen === 'play') updateActivity(dt);\n   258\t}\n   259\tfunction action(name, id) {\n   260\t  unlockAudio(); state.idle = 0; tone(440, .07, .2);\n   261\t  switch (name) {\n   262\t    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n   263\t    case 'slots': screen('slots'); break;\n   264\t    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n   265\t    case 'outfit': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.outfit = Number(id); render(); break;\n   266\t    case 'instructor': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.instructor = id; render(); break;\n   267\t    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n   268\t    case 'check': beginCheck(); break;\n   269\t    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n   270\t    case 'island': state.classMode = false; screen('island'); break;\n   271\t    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n   272\t    case 'locked': notify('A new mat opens on a later day.'); break;\n   273\t    case 'start-activity': startActivity(state.selection); break;\n   274\t    case 'retry': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n   275\t    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n   276\t    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n   277\t    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n   278\t    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n   279\t    case 'ending': screen('ending'); break;\n   280\t    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n   281\t    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad', source: 'primary' }, { name: 'Gertrude', type: 'Bot', source: 'bot' }]; if (!CLASS_IDS.includes(state.selection?.id)) state.selection = ACTIVITIES[0]; screen('class'); break;\n   282\t    case 'class-toggle': { const index = Number(id); if (index === 0) break; const current = state.classPlayers[index]; state.classPlayers[index] = !current ? { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot', source: 'bot' } : index === 1 && current.source === 'bot' ? { name: 'Player 2', type: 'Keyboard 2', source: 'keyboard' } : null; render(); break; }\n   283\t    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n   284\t    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection, { seconds: 35 }); break;\n   285\t    case 'hub-ready': window.AIHub.answer('ready'); notify('Ready to go!'); break;\n   286\t    case 'hub-more': window.AIHub.answer('more'); notify('Waiting for more players.'); break;\n   287\t    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n   288\t    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n   289\t    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n   290\t    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n   291\t    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n   292\t    case 'pause': pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); break;\n   293\t    case 'resume': screen(pausedFrom || 'play'); break;\n   294\t    case 'restart': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n   295\t    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n   296\t    case 'dev': screen('dev'); break;\n   297\t    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n   298\t    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n   299\t    case 'about-back': screen(state.aboutReturn || 'title'); break;\n   300\t  }\n   301\t}\n   302\tapp.addEventListener('click', event => { const target = event.target.closest('[data-action]'); if (target) action(target.dataset.action, target.dataset.id); });\n   303\tapp.addEventListener('mouseover', event => { const target = event.target.closest('button'); if (target && state.input !== 'gamepad') target.focus({ preventScroll: true }); });\n   304\tapp.addEventListener('input', event => { const key = event.target.dataset.tuning; if (key) { tuning[key] = Number(event.target.value); document.getElementById(`out-${key}`).value = tuning[key]; } });\n   305\twindow.addEventListener('keydown', event => {\n   306\t  if (event.repeat && event.key !== ' ') return;\n   307\t  state.input = 'keyboard'; state.idle = 0; const key = event.key.toLowerCase();\n   308\t  if (state.screen === 'attract') { event.preventDefault(); screen('title'); return; }\n   309\t  if (event.target instanceof HTMLInputElement && event.target.type === 'text') { if (key === 'enter') { event.preventDefault(); action('create-member'); } return; }\n   310\t  if (['arrowup','arrowdown','arrowleft','arrowright',' '].includes(key)) event.preventDefault();\n   311\t  keys.add(key); unlockAudio();\n   312\t  if (state.screen === 'check' && state.check.phase === 'lean') { const mapping = { a:'left', arrowleft:'left', w:'up', arrowup:'up', d:'right', arrowright:'right', s:'down', arrowdown:'down' }; if (mapping[key]) state.check.directions.add(mapping[key]); return; }\n   313\t  if (state.screen === 'play') { if (key === 'escape') action('pause'); else attemptInput(key); return; }\n   314\t  if (key === 'escape' || key === 'backspace') { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (state.screen === 'dev') screen('pause'); else if (state.screen === 'activity') action('island'); else if (state.screen === 'slots' || state.screen === 'class') action('home'); return; }\n   315\t  if (key === 'arrowdown' || key === 's') focusMove(1); else if (key === 'arrowup' || key === 'w') focusMove(-1); else if ((key === 'enter' || key === ' ') && document.activeElement?.tagName !== 'BUTTON') { const buttons = currentButtons(); if (buttons.length) buttons[0].focus(); }\n   316\t});\n   317\twindow.addEventListener('keyup', event => keys.delete(event.key.toLowerCase()));\n   318\twindow.addEventListener('blur', () => { keys.clear(); if (state.screen === 'play' && !state.hub.active) action('pause'); });\n   319\twindow.addEventListener('mousemove', event => { if (state.screen !== 'play' || event.buttons === 0) return; state.input = 'mouse'; mouseLean = { x: clamp((event.clientX - innerWidth / 2) / (innerHeight * .33), -1, 1), y: clamp((event.clientY - innerHeight / 2) / (innerHeight * .33), -1, 1) }; });\n   320\twindow.addEventListener('mousedown', event => { if (state.screen === 'play' && event.button === 0) keys.add(' '); });\n   321\twindow.addEventListener('mouseup', () => keys.delete(' '));\n   322\tfunction pollGamepad() {\n   323\t  const pads = Array.from(navigator.getGamepads?.() || []);\n   324\t  for (const pad of pads) {\n   325\t    if (!pad) continue;\n   326\t    const previous = gamepadPrevious[pad.index] || [];\n   327\t    pad.buttons.forEach((item, index) => {\n   328\t      if (item.pressed && !previous[index]) {\n   329\t        state.input = 'gamepad'; state.idle = 0; unlockAudio();\n   330\t        if (state.screen === 'attract') screen('title');\n   331\t        else if (state.screen === 'play') { if (index === 9) action('pause'); else if (index === 4 || index === 5) attemptInput(index === 4 ? 'q' : 'e'); else if (index === 6 || index === 7) attemptInput(index === 6 ? 'j' : 'k'); }\n   332\t        else if (state.screen === 'check' && state.check.phase === 'lean') { if (index === 12) state.check.directions.add('up'); if (index === 13) state.check.directions.add('down'); if (index === 14) state.check.directions.add('left'); if (index === 15) state.check.directions.add('right'); }\n   333\t        else if (index === 0) { const selected = document.activeElement; if (selected?.tagName === 'BUTTON') selected.click(); else currentButtons()[0]?.focus(); }\n   334\t        else if (index === 1) { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (!state.hub.active) action('home'); }\n   335\t        else if (index === 12) focusMove(-1); else if (index === 13) focusMove(1);\n   336\t      }\n   337\t    });\n   338\t    if (state.screen === 'check' && state.check.phase === 'lean') { if (pad.axes[0] < -.45) state.check.directions.add('left'); if (pad.axes[0] > .45) state.check.directions.add('right'); if (pad.axes[1] < -.45) state.check.directions.add('up'); if (pad.axes[1] > .45) state.check.directions.add('down'); }\n   339\t    gamepadPrevious[pad.index] = pad.buttons.map(item => item.pressed);\n   340\t  }\n   341\t}\n   342\tconst simulation = new My3D2dge.Game({ headless: true, step: 1 / 120 });\n   343\tsimulation.start({ update, draw() {} });\n   344\tfunction frame(now) {\n   345\t  const dt = lastFrame ? Math.min(.1, (now - lastFrame) / 1000) : 0; lastFrame = now;\n   346\t  pollGamepad(); simulation.advance(dt); music(); drawWorld({ ...state, shirt: OUTFITS[person().outfit || 0] });\n   347\t  if (now - lastHud > 100) { if (state.screen === 'play') updateHUD(); if (state.screen === 'check') updateCheckHUD(); lastHud = now; }\n   348\t  requestAnimationFrame(frame);\n   349\t}\n   350\twindow.__ZEN = {\n   351\t  state, action, startActivity, tuning,\n   352\t  advance(seconds) { simulation.advance(seconds); render(); },\n   353\t  snapshot() { return JSON.parse(JSON.stringify({ screen: state.screen, member: state.member, activity: state.activity && { id: state.activity.id, elapsed: state.activity.elapsed, px: state.activity.px, py: state.activity.py, score: state.activity.score, stumbles: state.activity.stumbles }, result: state.result, hub: state.hub, settings: state.settings })); }\n   354\t};\n   355\trender(); requestAnimationFrame(frame);\n   356\t\n   357\tif (state.hub.active) {\n   358\t  screen('hub');\n   359\t  window.AIHub.on('start', () => { state.hub.started = true; state.hub.startedAt = window.AIHub.time(); startActivity(ACTIVITIES.find(activity => activity.id === 'stork'), { seconds: 60 }); });\n   360\t  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n","exit_code":0,"status":"completed"}}
