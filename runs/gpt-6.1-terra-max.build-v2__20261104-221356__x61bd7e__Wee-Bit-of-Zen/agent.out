${result.percent}%</strong><small>STEADINESS</small></div><div><strong>+${result.minutes}</strong><small>FIT MINUTES</small></div><div><strong>${result.stumbles}</strong><small>WOBBLES</small></div></div><div class=\"actions\">${button('Practice again', 'retry')}${button(state.festival ? 'Continue the Games' : state.classMode ? 'Class results' : 'Back to island', 'result-continue', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:134:  } else if (state.screen === 'hub') {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:153:function startActivity(activity, options = {}) {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:159:function completeActivity() {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:166:  if (!state.hub.active && !state.classMode) { const member = state.member; member.sessions = (member.sessions || 0) + 1; member.minutes = (member.minutes || 0) + minutes; member.stars[activity.id] = Math.max(member.stars[activity.id] || 0, stars); save(); }\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:169:function attemptInput(key) {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:225:function updateHUD() {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:250:function update(dt) {\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:259:    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:261:    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:262:    case 'outfit': state.member.outfit = Number(id); render(); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:263:    case 'instructor': state.member.instructor = id; render(); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:267:    case 'island': state.classMode = false; screen('island'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:268:    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:271:    case 'retry': startActivity(state.selection, { seconds: state.festival ? 30 : undefined }); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:272:    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:278:    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad' }, { name: 'Gertrude', type: 'Bot' }]; state.selection = state.selection || ACTIVITIES[0]; screen('class'); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:279:    case 'class-toggle': { const index = Number(id); if (index === 0) break; state.classPlayers[index] = state.classPlayers[index] ? null : { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot' }; render(); break; }\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:281:    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection); break;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-22