etween socks.', instruction: 'Balance over the line, lean forward to walk, and collect the fluttering pegs.', clip: 'walk' }\n];\n\nconst DAY_INTROS = [\n  'Welcome to the Institute for Gentle Improvement. We have been expecting you, in a very relaxed way.',\n  'A new morning. The island has prepared absolutely no urgent emails.',\n  'The sea is calm. Dennis is less calm, but is working on it.',\n  'You have made space for yourself. The advanced mats have made space for you.',\n  'It is the Gentle Games! Participation is mandatory only for the gulls.'\n];\n\nconst CAST = [\n  ['Gertrude', 'I used to be competitive. Now I am competitively relaxed.'],\n  ['Dennis', 'I brought a towel in case of a personal breakthrough.'],\n  ['Marisol', 'A wobble is just your body writing in cursive.'],\n  ['Young Kevin', 'I am called Young Kevin because the other Kevin has tenure.']\n];\n\nconst COLORS = ['#d98a68', '#e8b28d', '#8c573f', '#f1ccad', '#b87956', '#704638'];\nconst OUTFITS = ['#e98d78', '#79b9ac', '#e7b961', '#9b9dd1', '#638ca5', '#d77f9c'];\nconst clamp = (number, min, max) => Math.max(min, Math.min(max, number));\n154:function startActivity(activity, options = {}) {\n186:function updateActivity(dt) {\n222:    const now = window.AIHub.time();\n223:    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n224:    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n228:function updateHUD() {\n245:function updateCheckHUD() {\n253:function update(dt) {\n259:function action(name, id) {\n262:    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n263:    case 'slots': screen('slots'); break;\n264:    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n265:    case 'outfit': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.outfit = Number(id); render(); break;\n266:    case 'instructor': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.instructor = id; render(); break;\n267:    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n268:    case 'check': beginCheck(); break;\n269:    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n270:    case 'island': state.classMode = false; screen('island'); break;\n271:    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n272:    case 'locked': notify('A new mat opens on a later day.'); break;\n273:    case 'start-activity': startActivity(state.selection); break;\n274:    case 'retry': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n275:    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n276:    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n277:    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n278:    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n279:    case 'ending': screen('ending'); break;\n280:    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n281:    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad', source: 'primary' }, { name: 'Gertrude', type: 'Bot', source: 'bot' }]; if (!CLASS_IDS.includes(state.selection?.id)) state.selection = ACTIVITIES[0]; screen('class'); break;\n282:    case 'class-toggle': { const index = Number(id); if (index === 0) break; const current = state.classPlayers[index]; state.classPlayers[index] = !current ? { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot', source: 'bot' } : index === 1 && current.source === 'bot' ? { name: 'Player 2', type: 'Keyboard 2', source: 'keyboard' } : null; render(); break; }\n283:    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n284:    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection, { seconds: 35 }); break;\n285:    case 'hub-ready': window.AIHub.answer('ready'); notify('Ready to go!'); break;\n286:    case 'hub-more': window.AIHub.answer('more'); notify('Waiting for more players.'); break;\n287:    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n288:    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n289:    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n290:    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n291:    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n292:    case 'pause': if (!state.hub.active) { pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); } break;\n293:    case 'resume': screen(pausedFrom || 'play'); break;\n294:    case 'restart': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n295:    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n296:    case 'dev': screen('dev'); break;\n297:    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n298:    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n299:    case 'about-back': screen(state.aboutReturn || 'title'); break;\n368:  window.AIHub.on('start', startHub);\n369:  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n370:  window.AIHub.on('time-up', finishHub);\n371:  window.AIHub.on('end', () => { state.hub.finished = true; screen('hub'); });\n372:  window.AIHub.probe(() => ({ screen: state.screen, phase: state.hub.phase, eventIndex: state.hub.eventIndex, score: state.hub.score }));\n373:  window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }).then(() => window.AIHub.ready()).catch(() => notify('Unable to connect to the Hub.'));\nhub\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { dirname, join } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst directory = dirname(fileURLToPath(import.meta.url));\nconst root = dirname(directory);\nconst basename = 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356';\nconst read = path => readFileSync(join(directory, path), 'utf8');\nconst interview = JSON.parse(readFileSync(join(root, 'exit-interview.json'), 'utf8'));\nconst scripts = ['engine/my-3d2dge.js', 'vendor/readable.js', 'vendor/mocap.js', 'vendor/fitclips.js', 'src/data.js', 'src/art.js', 'src/modes.js', 'src/game.js'];\nconst wrap = script => `<script>\\n${script.replace(/<\\/script/gi, '<\\\\/script')}\\n</script>`;\nconst html = `<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n${wrap(read('vendor/session.js'))}\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"description\" content=\"A pleasantly imperfect island retreat for your body, mind, and general wobble.\">\n<meta name=\"theme-color\" content=\"#d9eee6\">\n<meta name=\"hub:type\" content=\"Game\"><meta name=\"hub:players\" content=\"1–4\"><meta name=\"hub:source\" content=\"Wii Fit\">\n<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\"><meta name=\"hub:session-minutes\" content=\"3\">\n<meta name=\"hub:session-goal\" content=\"Stay steadiest over 3 exercises; most points wins\"><meta name=\"hub:session-howto\" content=\"Lean: left stick, WASD or mouse. Breathe: R2, Space or click\">\n<title>Wee Bit of Zen</title><style>${read('src/style.css')}\\n${read('src/extra.css')}</style></head>\n<body><canvas id=\"world\" aria-hidden=\"true\"></canvas><div id=\"app\"></div>\n${wrap(`window.BUILD_INFO = ${JSON.stringify(interview)};`)}\n${scripts.map(path => wrap(read(path))).join('\\n')}\n</body></html>`;\nwriteFileSync(join(root, `${basename}.html`), html);\nwriteFileSync(join(directory, 'tests/hub/game.html'), html);\nconsole.log(`Built ${basename}.html (${Buffer.byteLength(html)} bytes)`);\n/* FITCLIPS: an animation set in my-3D2dge's readable format (written by the tools in tools/; clips may be edited by hand).\n * Mesh2Motion (CC0), Quaternius (CC0), CMU Graphics Lab Motion Capture Database (free for all uses)\n * 23 clips, 560 key poses. Played by src/mocap/mocap.js with src/mocap/readable.js. \"sources\" holds the proportions\n * each library was measured with; \"fit\" each clip's average and worst body-point error against its capture (mm).\n * my-3D2dge readable clip. Times in seconds; every other number is a whole number. Rig frame: forward, right, up.\n * L and R are the figure's own sides. Directions are percentages and need not add up: [100, 0, 0] and [50, 0, 0] agree.\n * hips   [forward, right, up]   the pelvis, in percent of standing hip height (100 = standing, 55 = sitting on a chair)\n * body   [turn, lean, tilt]     the pelvis, degrees: turn + = toward the right, lean + = forward, tilt + = toward the right\n * chest  [turn, lean, tilt]     the chest, relative to the pelvis        head [turn, lean, tilt]  relative to the chest\n * shL shR    [reach, shrug]     degrees the shoulder swings forward (into a punch or an aim) and up, from rest\n * armL armR  [forward, out, up, bend, twist]  which way the arm points from the shoulder to the fist, in chest space\n *            (out + = away from the body on that side; [0, 0, -100] hangs down, [100, 0, 0] punches ahead);\n *            bend = elbow bend in degrees (0 = straight); twist = degrees the elbow swings round the arm from its\n *            natural direction (back and down)\n * legL legR  [forward, out, up, bend, twist]  hip to ankle in pelvis space; bend: the knee; twist: from pointing forward\n * footL footR [down, out, toes]   degrees the foot points down from standing, turns outward, and the toes bend up\n * blade  [forward, right, up]   (sword clips) the direction of a blade held in the right fist, in chest space\n * root   [forward, right]       (clips that travel) how far the whole body has moved, in percent of standing hip height\n */\n(window.MOCAP = window.MOCAP || {})[\"FITCLIPS\"] = {\n\"set\": \"FITCLIPS\",\n\"format\": 1,\n\"credit\": \"Mesh2Motion (CC0), Quaternius (CC0), CMU Graphics Lab Motion Capture Database (free for all uses)\",\n\"from\": [\"MESH2MOTION\",\"CMU\",\"CMU_111\",\"CMU_22\"],\n\"fps\": 30,\n\"sources\": {\"M2M_QUATERNIUS\":{\"file\":\"human-base-animations.glb\",\"rig\":\"unreal\",\"label\":\"Quaternius, via Mesh2Motion\",\"origin\":\"Quaternius' Universal Animation Library 1 and 2 as Mesh2Motion re-export\n\"body\": null,\n\"fit\": {\"Pushup\":[29,160],\"Meditate\":[15,54],\"Jumping Jacks\":[11,70],\"Sleeping\":[15,68],\"Victory\":[16,227],\"Cheering_Two_Hands\":[32,116],\"Dizzy\":[21,81],\"Idle_Subtle\":[15,61],\"Greeting\":[12,130],\"Run_\n\"clips\": {\n\"Pushup\": {\"clip\": \"Pushup\", \"src\": \"M2M_ANIMATED\", \"dur\": 1.542, \"loop\": true, \"tags\": [\"emote\",\"exercise\"], \"desc\": \"push-ups: the body held straight, arms bending and pressing up\", \"keys\": [\n  {\"t\":0,\n   \"hips\":[-7,0,49], \"body\":[0,75,0], \"chest\":[0,-12,0], \"head\":[0,17,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[95,28,-17,61,23], \"armR\":[95,28,-17,61,-23],\n   \"legL\":[-4,0,-100,4,-3], \"legR\":[-4,0,-100,4,3], \"footL\":[-3,0,48], \"footR\":[-3,0,48]},\n  {\"t\":0.167,\n   \"hips\":[-7,0,47], \"body\":[0,78,0], \"chest\":[0,-11,0], \"head\":[0,14,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[95,30,-9,75,-15], \"armR\":[95,30,-9,75,15],\n   \"legL\":[-1,0,-100,15,-3], \"legR\":[-1,0,-100,15,3], \"footL\":[-6,0,48], \"footR\":[-6,0,48]},\n  {\"t\":0.4,\n   \"hips\":[-5,0,40], \"body\":[0,86,0], \"chest\":[0,-6,0], \"head\":[0,3,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[90,41,15,111,-20], \"armR\":[90,41,15,111,20],\n   \"legL\":[5,0,-100,13,-2], \"legR\":[5,0,-100,13,2], \"footL\":[-14,0,48], \"footR\":[-14,0,48]},\n  {\"t\":0.6,\n   \"hips\":[-4,0,35], \"body\":[0,93,0], \"chest\":[0,-1,0], \"head\":[0,-7,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[72,55,42,133,-11], \"armR\":[72,55,42,133,11],\n   \"legL\":[11,0,-99,13,-2], \"legR\":[11,0,-99,13,2], \"footL\":[-21,0,48], \"footR\":[-21,0,48]},\n  {\"t\":0.767,\n   \"hips\":[-3,0,33], \"body\":[0,96,0], \"chest\":[0,-1,0], \"head\":[0,-9,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[62,62,48,140,-7], \"armR\":[62,62,48,140,7],\n   \"legL\":[14,0,-99,0,-1], \"legR\":[14,0,-99,0,1], \"footL\":[-24,0,48], \"footR\":[-24,0,48]},\n  {\"t\":0.967,\n   \"hips\":[-4,0,36], \"body\":[0,92,0], \"chest\":[0,-3,0], \"head\":[0,-4,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[78,52,35,129,-14], \"armR\":[78,52,35,129,14],\n   \"legL\":[10,0,-99,12,-2], \"legR\":[10,0,-99,12,2], \"footL\":[-20,0,48], \"footR\":[-20,0,48]},\n  {\"t\":1.3,\n   \"hips\":[-7,0,47], \"body\":[0,77,0], \"chest\":[0,-10,0], \"head\":[0,12,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[95,30,-10,74,-14], \"armR\":[95,30,-10,74,14],\n   \"legL\":[-3,0,-100,13,-3], \"legR\":[-3,0,-100,13,3], \"footL\":[-5,0,48], \"footR\":[-5,0,48]},\n  {\"t\":1.533,\n   \"hips\":[-7,0,49], \"body\":[0,75,0], \"chest\":[0,-12,0], \"head\":[0,17,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[95,28,-17,61,23], \"armR\":[95,28,-17,61,-23],\n   \"legL\":[-4,0,-100,4,-3], \"legR\":[-4,0,-100,4,3], \"footL\":[-3,0,48], \"footR\":[-3,0,48]}\n]},\n\n\"Meditate\": {\"clip\": \"Meditate\", \"src\": \"M2M_ANIMATED\", \"dur\": 1.5, \"loop\": true, \"tags\": [\"sit\",\"rest\",\"idle\"], \"desc\": \"sits cross-legged, hands on the knees, breathing slowly\", \"keys\": [\n  {\"t\":0,\n   \"hips\":[-44,0,5], \"body\":[0,-16,0], \"chest\":[0,15,0], \"head\":[0,-1,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[82,14,-55,67,23], \"armR\":[80,23,-55,83,-29],\n   \"legL\":[72,-66,-22,141,41], \"legR\":[89,-40,-24,127,-49], \"footL\":[-22,-61,-21], \"footR\":[-16,-77,-19]},\n  {\"t\":1.5,\n","exit_code":0,"status":"completed"}}
