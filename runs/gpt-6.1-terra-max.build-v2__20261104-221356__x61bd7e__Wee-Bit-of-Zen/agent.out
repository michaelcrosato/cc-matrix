{"type":"item.completed","item":{"id":"item_440","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; sed -n '1,60p' \\\"\"'$D/vendor/mocap.js\"; sed -n '\"'135,230p' \\\"\"'$D/src/art.js\"; sed -n '\"'1,200p' \\\"\"'$D/src/modes.js\"; sed -n '\"'377,546p' \\\"\"'$D/tests/hub/harness.html\"'","aggregated_output":"/* =============================================================================\n * MOCAP  plays animation sets in the readable format (src/mocap/readable.js; written by tools/anim-import.mjs) on\n * my-3D2dge rigs.\n *   const lib = Mocap.load(window.MOCAP.QUATERNIUS);   // a set: its clips, and the bodies they were measured on\n *   const clip = lib.clip('Dance_Loop');               // { name, dur, loop, tags, desc, keys }\n *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n *   const man = new Mocap.Mannequin(lib, { height: 34 });  man.draw(g, ox, oy, view, pose, facing)\n *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n *     window.Mocap.)\n *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n *     only the chest, head and arms over the rig's own legs (an interaction while walking); humanoid.mocapBlade = true\n *     while the clip holds a sword (the blade follows the fist).\n * Points are in the rig's local frame: f = forward, r = right, z = up, centred on the root on the ground.\n * ============================================================================= */\nconst Mocap = (() => {\n'use strict';\nconst E = My3D2dge, { px } = E, MR = MocapReadable;\n\n/* ---- sets ---- */\n/**\n * Every clip is rebuilt on the first library's proportions (the format does not depend on size); each keeps how its own\n * library bends the spine, since the key poses were measured that way.\n */\nfunction load(set) {\n  const P = MR.P, idx = MR.IDX, ids = Object.keys(set.sources), base = set.sources[ids[0]].rest, rests = {};\n  for (const id of ids) rests[id] = Object.assign({}, base, { spineW: set.sources[id].rest.spineW, neckW: set.sources[id].rest.neckW });\n  const meta = c => ({ name: c.clip, fps: set.fps, n: Math.round(c.dur * set.fps) + 1 }), clips = {};\n  for (const [name, c] of Object.entries(set.clips)) clips[name] = Object.assign(meta(Object.assign({ clip: name }, c)), c);\n  const restOf = c => rests[c.src] || base;\n  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n  lib.clip = name => clips[name] || null;\n  /** the pose at time t (seconds): key poses in-betweened, loops wrap, one-shots hold their last pose */\n  lib.sample = (clip, t, out = new Float32Array(P * 3)) => { MR.pose(restOf(clip), clip, t, out); out.src = clip.src; return out; };   // (src: whose rest it is measured against)\n  /** a clip that travels: how far it has carried the body at time t ([forward, right] mm), or null */\n  lib.moveAt = (clip, t) => MR.moveAt(restOf(clip), clip, t);\n  /** swap in an edited clip (readable text a person or a model changed); the original is kept for restore() */\n  const originals = {};\n  lib.replace = (name, edited) => { if (!originals[name]) originals[name] = clips[name]; clips[name] = Object.assign({}, originals[name], edited, { name, keys: edited.keys }); return clips[name]; };\n  lib.restore = name => { if (originals[name]) { clips[name] = originals[name]; delete originals[name]; } return clips[name]; };\n  lib.edited = name => !!originals[name];\n  /** the clip as the text a model reads (its header and its key poses) */\n  lib.text = clip => { const o = { clip: clip.clip || clip.name }; for (const k of ['src', 'take', 'orig', 'dur', 'loop', 'tags', 'desc']) if (clip[k] !== undefined) o[k] = clip[k]; o.keys = clip.keys; return MR.text(o); };\n  /** where a clip came from: its library's label, origin and license (from the set's sources), the clip it was made from,\n   *  and (a capture database's) the take and the stretch of it: '13_29 2.30-3.42' */\n  lib.origin = clip => { const s = set.sources[clip.src] || {}; return { src: clip.src, label: s.label || clip.src, origin: s.origin || '', license: s.license || '', url: s.url || '', orig: clip.orig || null, take: clip.take || null }; };\n  /** a pose blended from a to b (crossfades between clips) */\n  lib.blend = (a, b, k, out = new Float32Array(P * 3)) => { for (let i = 0; i < P * 3; i++) out[i] = a[i] + (b[i] - a[i]) * k; out.src = (k < .5 ? a : b).src; return out; };\n  lib.pt = (pose, name) => { const i = idx[name] * 3; return [pose[i], pose[i + 1], pose[i + 2]]; };\n  lib.error = MR.error;\n  return lib;\n}\n\n/* ---- the look-alike mannequin: shaded capsules in the source model's proportions, with its joint bands ---- */\nconst lerp3 = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\nconst add3 = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];\nconst sub3 = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\nconst norm3 = a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\nclass Mannequin {\n  /** o: { height: world units tall (34), main: '#e8aa3a', joint: '#aa66db' } (the colors of the source model's two materials) */\n  constructor(lib, o = {}) {\n    }\n    if (activity && activity.kind === 'tray') {\n      line(cx - size * .38, cy - size * .49, cx + size * .38, cy - size * .49 + lean * size * .1, size * .045, '#bb8b6d');\n      ellipse(cx, cy - size * .52, size * .06, size * .035, '#849e67');\n    }\n  }\n}\n'use strict';\n\nconst CLASS_IDS = ['stork', 'candle', 'step', 'slalom', 'tray'];\n\nfunction enhanceModes() {\n  const main = app.querySelector('main');\n  if (!main) return;\n  if (state.screen === 'class') {\n    const explanation = main.querySelector('.section-head p');\n    if (explanation) explanation.textContent = 'Up to four share the screen. Add bots, use I J K L for player 2, or press Start on another controller to join.';\n    const first = main.querySelector('[data-action=\"class-toggle\"][data-id=\"0\"]');\n    if (first) { first.textContent = 'YOU'; first.disabled = true; }\n    const second = main.querySelector('[data-action=\"class-toggle\"][data-id=\"1\"]');\n    if (second && state.classPlayers[1]?.source === 'bot') second.textContent = 'USE KEYBOARD 2';\n    else if (second && state.classPlayers[1]?.source === 'keyboard') second.textContent = 'REMOVE';\n  }\n  if (state.screen === 'class-result' && state.classScores) {\n    main.innerHTML = `<div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Each score comes from that player's own practice.</p>${state.classScores.map((entry, index) => `<div class=\"row\"><span>${index === 0 ? '★ &nbsp;' : ''}${escapeHTML(entry.name)}${entry.bot ? ' · BOT' : ''}</span><b>${entry.score} points</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div>`;\n  }\n  if (state.screen === 'play' && state.classActors?.length && !state.hub.active) {\n    const board = document.createElement('div');\n    board.className = 'class-live';\n    board.id = 'class-live';\n    main.append(board);\n    updateClassBoard();\n  }\n  if (state.screen === 'hub') {\n    const hub = state.hub;\n    let description = 'A shared class: three exercises, one gentle competition.';\n    let controls = `${button('I’m ready', 'hub-ready', true)}${button('Need more time', 'hub-more')}`;\n    if (hub.started && !hub.finished) {\n      const activity = hub.deck?.[hub.eventIndex];\n      description = hub.phase === 'score' ? `${activity?.name || 'Exercise'} complete. Class score: ${Math.round(hub.score)}.` : `Coming up: ${activity?.name || 'a new exercise'}. Get comfortable on your mat.`;\n      controls = '';\n    }\n    if (hub.finished) { description = `Class finished. Your total: ${Math.round(hub.score)} points. Thanks for moving with us!`; controls = ''; }\n    main.innerHTML = `<div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; AI GAME HUB</div><h1>${hub.finished ? 'Lovely work.' : hub.started ? 'A little breather.' : 'Welcome to class.'}</h1><p>${description}</p><div class=\"actions\">${controls}</div></div>`;\n  }\n}\n\nfunction prepareClass() {\n  state.classActors = state.classPlayers.slice(1).map(player => ({ player, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, tray: 0, flame: .6, score: 0, samples: 0, hits: 0, lastBeat: -1 }));\n  state.classScores = null;\n}\n\nfunction updateClass(delta) {\n  const activity = state.activity;\n  for (const [index, actor] of state.classActors.entries()) {\n    const pad = actor.player.source === 'gamepad' ? navigator.getGamepads?.()[actor.player.padIndex] : null;\n    if (actor.player.source === 'bot') {\n      actor.ux = activity.ringX * (.65 + index * .08) + Math.sin(activity.elapsed * (1.1 + index * .13) + index) * (.12 + index * .035);\n      actor.uy = activity.ringY * .7 + Math.cos(activity.elapsed * 1.3 + index) * .08;\n    } else if (pad) {\n      actor.ux = Math.abs(pad.axes[0]) > .12 ? pad.axes[0] : actor.ux * Math.max(0, 1 - delta * .5);\n      actor.uy = Math.abs(pad.axes[1]) > .12 ? pad.axes[1] : actor.uy * Math.max(0, 1 - delta * .5);\n    } else {\n      const horizontal = (keys.has('l') ? 1 : 0) - (keys.has('j') ? 1 : 0);\n      const vertical = (keys.has('k') ? 1 : 0) - (keys.has('i') ? 1 : 0);\n      actor.ux = clamp(actor.ux + horizontal * 2.2 * delta, -1, 1);\n      actor.uy = clamp(actor.uy + vertical * 2.2 * delta, -1, 1);\n      if (!horizontal) actor.ux *= Math.max(0, 1 - .5 * delta);\n      if (!vertical) actor.uy *= Math.max(0, 1 - .5 * delta);\n    }\n    actor.vx += (tuning.spring * (actor.ux - actor.px) - tuning.damping * actor.vx + tuning.noise * Math.sin(activity.elapsed * 1.7 + index)) * delta;\n    actor.vy += (tuning.spring * (actor.uy - actor.py) - tuning.damping * actor.vy + tuning.noise * Math.cos(activity.elapsed * 1.2 + index)) * delta;\n    actor.px = clamp(actor.px + actor.vx * delta, -1, 1);\n    actor.py = clamp(actor.py + actor.vy * delta, -1, 1);\n    let quality = clamp(1 - Math.hypot(actor.px - activity.ringX, actor.py - activity.ringY) * 1.5, 0, 1);\n    if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(actor.px - activity.ringX) * 1.5, 0, 1);\n    if (activity.kind === 'tray') { actor.tray += (actor.px - actor.tray) * delta * 1.5; quality = clamp(1 - Math.abs(actor.tray) * 2, 0, 1); }\n    if (activity.kind === 'candle') { actor.flame = clamp(actor.flame + (quality > .45 ? .13 : -.3) * delta, 0, 1); quality = actor.flame; }\n    if (activity.kind === 'step') quality = actor.player.source === 'bot' ? clamp(.67 + Math.sin(activity.elapsed + index) * .13, 0, 1) : clamp(actor.hits / Math.max(1, activity.elapsed * 100 / 60) * 1.3, 0, 1);\n    actor.score += quality;\n    actor.samples++;\n  }\n}\n\nfunction updateClassBoard() {\n  const board = document.getElementById('class-live');\n  if (!board || !state.activity) return;\n  const primary = Math.round(state.activity.score / Math.max(1, state.activity.samples) * 100);\n  board.innerHTML = `<span>${escapeHTML(state.classPlayers[0].name)} ${primary}</span>` + state.classActors.map(actor => `<span>${escapeHTML(actor.player.name)} ${Math.round(actor.score / Math.max(1, actor.samples) * 100)}${actor.player.source === 'bot' ? ' · BOT' : ''}</span>`).join('');\n}\n\nfunction finishClass(primary) {\n  state.classScores = [{ name: state.classPlayers[0].name, score: primary, bot: false }, ...state.classActors.map(actor => ({ name: actor.player.name, score: Math.round(actor.score / Math.max(1, actor.samples) * 100), bot: actor.player.source === 'bot' }))].sort((left, right) => right.score - left.score);\n}\n\nfunction classInput(key) {\n  const actor = state.classActors?.find(item => item.player.source === 'keyboard');\n  if (!actor || state.activity?.kind !== 'step') return;\n  const directions = ['j', 'i', 'l', 'k'];\n  const beat = Math.round(state.activity.elapsed * 100 / 60);\n  if (key === directions[(beat + 4) % 4] && Math.abs(state.activity.elapsed * 100 / 60 - beat) < .34 && beat !== actor.lastBeat) { actor.hits++; actor.lastBeat = beat; }\n}\n\nfunction classPadInput(actor, index) {\n  if (state.activity?.kind !== 'step') return;\n  const directions = [14, 12, 15, 13];\n  const beat = Math.round(state.activity.elapsed * 100 / 60);\n  if (index === directions[(beat + 4) % 4] && Math.abs(state.activity.elapsed * 100 / 60 - beat) < .34 && beat !== actor.lastBeat) { actor.hits++; actor.lastBeat = beat; }\n}\n\nfunction joinClassPad(index) {\n  if (state.classPlayers.some(player => player?.padIndex === index)) return;\n  const free = [1, 2, 3].find(slot => !state.classPlayers[slot] || state.classPlayers[slot].source === 'bot');\n  if (free === undefined) return;\n  state.classPlayers[free] = { name: `Player ${free + 1}`, type: `Controller ${index + 1}`, source: 'gamepad', padIndex: index };\n  render();\n}\n\nfunction startHub() {\n  const hub = state.hub;\n  const random = window.AIHub.rng('deal');\n  const deck = ACTIVITIES.filter(activity => CLASS_IDS.includes(activity.id)).slice();\n  for (let index = deck.length - 1; index > 0; index--) { const other = Math.floor(random() * (index + 1)); [deck[index], deck[other]] = [deck[other], deck[index]]; }\n  Object.assign(hub, { started: true, finished: false, score: 0, deck: deck.slice(0, 3), eventIndex: -1, phase: '', records: {}, lastSend: -100, lastProgress: -1000 });\n  syncHub();\n}\n\nfunction finishHubEvent() {\n  const hub = state.hub, activity = state.activity;\n  if (!activity || hub.records[hub.eventIndex] !== undefined) return;\n  hub.records[hub.eventIndex] = Math.round(activity.score / Math.max(1, activity.samples) * 1000);\n  hub.score = Object.values(hub.records).reduce((total, value) => total + value, 0);\n}\n\nfunction syncHub() {\n  const hub = state.hub;\n  if (!hub.active || !hub.started || hub.finished) return;\n  const time = window.AIHub.time();\n  if (!Number.isFinite(time) || time < 0 || time >= 150000) return;\n  const eventIndex = Math.floor(time / 50000), within = time % 50000;\n  const phase = within < 5000 ? 'intro' : within < 45000 ? 'play' : 'score';\n  if (hub.eventIndex !== eventIndex || hub.phase !== phase) {\n    if (hub.phase === 'play') finishHubEvent();\n    hub.eventIndex = eventIndex;\n    hub.phase = phase;\n    if (phase === 'play') startActivity(hub.deck[eventIndex], { seconds: 40 });\n    else screen('hub');\n  }\n  if (phase === 'play' && state.activity) state.activity.elapsed = Math.max(0, (within - 5000) / 1000);\n}\n\nfunction finishHub() {\n  const hub = state.hub;\n  if (hub.finished) return;\n  if (hub.phase === 'play') finishHubEvent();\n  hub.finished = true;\n  window.AIHub.result({ score: Math.round(hub.score) });\n  screen('hub');\n}\n * ?auto=1 — the conformance run. It presses keys inside each frame with\n * synthetic events while the round plays (the frames must be served from this\n * page's origin). Results land in window.__hubCheck, and body[data-complete]\n * turns \"true\".\n * ------------------------------------------------------------------------- */\n\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nasync function until(test, ms) {\n  const end = performance.now() + ms;\n  while (performance.now() < end) {\n    if (test()) return true;\n    await sleep(50);\n  }\n  return test();\n}\n\nfunction poke(cell, key) {\n  const doc = cell.frame.contentDocument;\n  const win = cell.frame.contentWindow;\n  if (!doc || !win) return false;\n  const target = doc.activeElement && doc.activeElement !== doc.documentElement ? doc.activeElement : doc.body || doc.documentElement;\n  const init = { key, code: key === ' ' ? 'Space' : key, bubbles: true, cancelable: true, view: win };\n  target.dispatchEvent(new win.KeyboardEvent('keydown', init));\n  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n  return true;\n}\n\nasync function conformance() {\n  const checks = [];\n  const check = (name, pass, detail = '') => {\n    checks.push({ name, pass: !!pass, detail });\n    renderChecks(checks);\n    return !!pass;\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n\nfunction renderChecks(checks) {\n  $('checklist').replaceChildren(\n    ...checks.map((c) => {\n      const li = document.createElement('li');\n      li.className = c.pass ? 'ok' : 'bad';\n      li.textContent = c.name + (c.detail && !c.pass ? ` — ${c.detail}` : '');\n      li.title = c.detail;\n      return li;\n    }),\n  );\n}\n\nif (auto) conformance();\nelse if ($('game').value) newRound();\n</script>\n","exit_code":0,"status":"completed"}}
