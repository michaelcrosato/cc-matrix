{"type":"item.completed","item":{"id":"item_198","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; sed -n '184,224p' \\\"\"'$D/src/game.js\"; sed -n '\"'256,301p' \\\"\"'$D/src/game.js\"; sed -n '\"'343,365p' \\\"\"'$D/src/game.js\"; sed -n '\"'454,485p' PLAN.md; sed -n '1,55p' \\\"\"'$D/vendor/readable.js\" | cut -c1-220'","aggregated_output":"function updateActivity(dt) {\n  const activity = state.activity; if (!activity) return;\n  activity.elapsed += dt;\n  const pad = Array.from(navigator.getGamepads?.() || []).find(Boolean), axisX = pad && Math.abs(pad.axes[0]) > .12 ? pad.axes[0] : 0, axisY = pad && Math.abs(pad.axes[1]) > .12 ? pad.axes[1] : 0;\n  const dx = (keys.has('arrowright') || keys.has('d') ? 1 : 0) - (keys.has('arrowleft') || keys.has('a') ? 1 : 0);\n  const dy = (keys.has('arrowdown') || keys.has('s') ? 1 : 0) - (keys.has('arrowup') || keys.has('w') ? 1 : 0);\n  if (activity.stun <= 0) {\n    if (mouseLean) { activity.ux = mouseLean.x; activity.uy = mouseLean.y; }\n    else if (axisX || axisY) { activity.ux = axisX; activity.uy = axisY; }\n    else { activity.ux = clamp(activity.ux + dx * 2.2 * dt, -1, 1); activity.uy = clamp(activity.uy + dy * 2.2 * dt, -1, 1); if (!dx) activity.ux *= Math.max(0, 1 - .5 * dt); if (!dy) activity.uy *= Math.max(0, 1 - .5 * dt); }\n  } else activity.stun -= dt;\n  const gentle = state.settings.gentle ? .7 : 1, time = activity.elapsed, disturbance = tuning.noise * gentle;\n  const ax = tuning.spring * (activity.ux - activity.px) - tuning.damping * activity.vx + tuning.instability * gentle * activity.px + disturbance * (Math.sin(time * 1.7) + .5 * Math.sin(time * 3.23));\n  const ay = tuning.spring * (activity.uy - activity.py) - tuning.damping * activity.vy + tuning.instability * gentle * activity.py + disturbance * (Math.sin(time * 1.19 + 1) + .5 * Math.sin(time * 2.71));\n  activity.vx += ax * dt; activity.vy += ay * dt; activity.px += activity.vx * dt; activity.py += activity.vy * dt;\n  if (Math.hypot(activity.px, activity.py) >= 1 && activity.stun <= 0) { activity.stumbles++; activity.stun = 1; activity.px *= .5; activity.py *= .5; activity.vx *= -.2; activity.vy *= -.2; tone(196, .18); }\n  const phase = Math.floor(time / 12), rng = seeded(phase * 667 + 43);\n  activity.ringX = activity.id === 'stork' ? (rng() - .5) * .65 : activity.kind === 'slalom' ? Math.sin(time * .55) * .46 : 0;\n  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n  let quality = steadiness;\n  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n  activity.score += quality; activity.samples++;\n  if (state.hub.active) {\n    const now = window.AIHub.time();\n    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n  }\n  if (activity.elapsed >= activity.seconds) completeActivity();\n}\nfunction action(name, id) {\n  unlockAudio(); state.idle = 0; tone(440, .07, .2);\n  switch (name) {\n    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n    case 'slots': screen('slots'); break;\n    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n    case 'outfit': state.member.outfit = Number(id); render(); break;\n    case 'instructor': state.member.instructor = id; render(); break;\n    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n    case 'check': beginCheck(); break;\n    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n    case 'island': state.classMode = false; screen('island'); break;\n    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n    case 'locked': notify('A new mat opens on a later day.'); break;\n    case 'start-activity': startActivity(state.selection); break;\n    case 'retry': startActivity(state.selection, { seconds: state.festival ? 30 : undefined }); break;\n    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n    case 'ending': screen('ending'); break;\n    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad' }, { name: 'Gertrude', type: 'Bot' }]; state.selection = state.selection || ACTIVITIES[0]; screen('class'); break;\n    case 'class-toggle': { const index = Number(id); if (index === 0) break; state.classPlayers[index] = state.classPlayers[index] ? null : { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot' }; render(); break; }\n    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection); break;\n    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n    case 'pause': pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); break;\n    case 'resume': screen(pausedFrom || 'play'); break;\n    case 'restart': startActivity(state.selection, { seconds: state.festival ? 30 : undefined }); break;\n    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n    case 'dev': screen('dev'); break;\n    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n    case 'about-back': screen(state.aboutReturn || 'title'); break;\n  }\n}\napp.addEventListener('click', event => { const target = event.target.closest('[data-action]'); if (target) action(target.dataset.action, target.dataset.id); });\napp.addEventListener('mouseover', event => { const target = event.target.closest('button'); if (target && state.input !== 'gamepad') target.focus({ preventScroll: true }); });\napp.addEventListener('input', event => { const key = event.target.dataset.tuning; if (key) { tuning[key] = Number(event.target.value); document.getElementById(`out-${key}`).value = tuning[key]; } });\nwindow.addEventListener('keydown', event => {\n  if (event.repeat && event.key !== ' ') return;\n  requestAnimationFrame(frame);\n}\nwindow.__ZEN = {\n  state, action, startActivity, tuning,\n  advance(seconds) { simulation.advance(seconds); render(); },\n  snapshot() { return JSON.parse(JSON.stringify({ screen: state.screen, member: state.member, activity: state.activity && { id: state.activity.id, elapsed: state.activity.elapsed, px: state.activity.px, py: state.activity.py, score: state.activity.score, stumbles: state.activity.stumbles }, result: state.result, hub: state.hub, settings: state.settings })); }\n};\nrender(); requestAnimationFrame(frame);\n\nif (state.hub.active) {\n  screen('hub');\n  window.AIHub.on('start', () => { state.hub.started = true; state.hub.startedAt = window.AIHub.time(); startActivity(ACTIVITIES.find(activity => activity.id === 'stork'), { seconds: 60 }); });\n  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n  window.AIHub.on('time-up', () => { if (!state.hub.finished) { state.hub.finished = true; if (state.activity && state.screen === 'play') state.hub.score += state.activity.score / Math.max(1, state.activity.samples) * 1000; window.AIHub.result({ score: Math.round(state.hub.score) }); screen('hub'); } });\n  window.AIHub.on('end', () => { state.hub.finished = true; screen('hub'); });\n  window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }).then(() => window.AIHub.ready()).catch(() => notify('Unable to connect to the Hub.'));\n}\n**Class (local, on its own, 2 to 4).** From the title: join with Start on a free pad or 2 on the keyboard (`game.allowJoin({ max: 4, onJoin })`; `game.players[i]` has the same input API; keyboard players get `E.Input.halfKeys`). ✔ Half a keyboard runs out of keys with the full `INPUT` (the step and pace actions get none), so the Class scene sets its own `input`: the moves and menu actions plus `breath`, `catchL`, `catchR` only (left half F G H, right half `. / ,`), and its Step Class reads `lanes: ['left', 'down', 'up', 'right']`. Everyone gets a mat, a colour (`E.PLAYER_COLORS`) and a pre-made rig, on one fixed screen at size 1.5 with a small Plate under each. Activities: Stork Stand, Quiet Candle, Squat Rail, Step Class (two lanes), Hoop Hips, 35 s each, or \"Surprise me\" (3 rounds). So every class-capable activity takes a list of **contestants** from the start, not one player. Scores are 0 to 1000 (`round(pct × 1000)`). Results: podium with polite titles (Most Still, Best Wobble, Participated). Tare reads them. Empty mats hold Regulars driven by bots, for life, not for score.\n\n**AI Hub session (`ghost` mode, 1 to 4).** Follow the protocol README (`https://raw.githubusercontent.com/michaelcrosato/ai-hub/main/lib/hub/README.md`); it is short, read it. Outside a session the game is unaffected and `connect()` answers `null`. ✔ This exact shape passed the harness at 1, 2, 3 and 4 players, on the bad network, and with the host leaving.\n\n**The round: \"Morning Class\".** Everyone plays the same 3 events on their own copy, in lockstep, seeing others as translucent seat-coloured ghosts on neighbouring mats (or in the world for Slalom and Jog). About 150 s: each event is 5 s intro + 40 s play + 5 s scores. Deal with `AIHub.rng('deal')`: one from Stork/Candle/Squat/Push-Up, one from Step/Hoop, one from Slalom/Jog.\n\n```js\nconst inSession = !!(window.AIHub && AIHub.active);\nconst game = new E.Game({ canvas: 'screen', id: 'GAMEID', res: 'ps1', expand: true, touch: 'never', input: INPUT,\n  autoPause: !inSession, live: inSession, fullscreen: inSession ? false : 'button',\n  menu: { quit: inSession ? false : 'title', items: inSession ? [] : [/* Restart, Dev Mode */], settings: [/* section 11 */] } });\ngame.start({ scenes, scene: inSession ? 'round' : 'title', boot: {/* steps */} });\nif (inSession) (async () => {\n  const info = await AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n  if (!info) return game.go('title');\n  AIHub.on('card', c => { card = c; });\n  AIHub.on('start', () => {});\n  AIHub.on('message', (d, from) => { /* ghost state */ });\n  AIHub.on('leave', ({ id }) => { /* remove that ghost */ });\n  AIHub.on('time-up', () => report());                  // result() at once if not reported\n  AIHub.on('end', () => { over = true; game.audio.stopMusic(); game.audio.mute(true); game.input.clear(); });\n  await game.booted; AIHub.ready();                     // no key press\n})();\n```\n\n- **Card (yours, `card: true`):** the studio with the players lined up on mats, Tare hopping, the title, each player's name and colour with a ready tick, how to win, this player's controls, seconds left. While `AIHub.time() === -Infinity`: `confirm` or `start` → `AIHub.answer('ready')`, `more` (△) → `AIHub.answer('more')`, clicks on Ready/More too. No menus or choices on the card. Show \"More time\" state from the `card` event (`asked`, `paused`).\n- **Clock:** all event timing comes from `AIHub.time()`, not `game.time`. A frame over 50 ms gives up its time, so a slow machine's game clock lags and would desync. Countdown while negative. Play at ≥ 0. If `info.limitMs` is shorter than the round, shrink the events.\n- **Randomness:** every activity takes its disturbances from `AIHub.rng('e' + eventIndex)` (and a seeded `E.rng` offline). `Math.random` is only for cosmetics like particles and blinks, because copies draw it at different rates.\n- **Ghost data:** `AIHub.send({ t: 'g', a: eventIndex, l: [x, y], p: phase, w: [wx, wy], s: score }, { reliable: false })` about 10 times a second. Draw only if `a` matches your current event. `r.actor(..., { alpha: .5 })`, name tag in seat colour. Names come from `info.players`, drawn with `E.font` only (never HTML). Limit: 20 messages/s.\n- **Reporting:** `AIHub.progress({ score: total, label: total + ' pts' })` about once a second; at the end `AIHub.result({ score: total, stats: { Steadiness: '84%' }, awards: [{ title: 'Most Still', detail: '...' }] })` once.\n- **In a session:** no title, attract, dev, quit, restart or saved progress. Options opens the settings over the running round (`live`). No chat, emotes or custom names. No other network. Engine already ignores Options while Create is held ✔.\n\n/* =============================================================================\n * READABLE KEY POSES: the animation format my-3D2dge stores, and the one AI models (and people) read and edit.\n * A clip is a short list of key poses. Each pose names what an animator would: where the hips are, how the body,\n * chest and head turn and lean, how the shoulders reach and shrug, which way each arm and leg points with how much\n * elbow or knee bend, and how the feet point. It does not depend on body size, so the same clip fits any build, and\n * it mirrors by swapping L and R. Limbs are a direction plus a bend, not joint angles: an arm swinging through\n * straight down has no angle that flips, a bend in degrees rounds well, and an IK rig consumes exactly this.\n *\n * Shared by tools/anim-import.mjs (Node: it measures a captured body, fits each clip, writes the set) and the\n * browser (src/mocap/mocap.js: it rebuilds every body point from a set to draw or drive a rig). No dependencies.\n *   const rest = MocapReadable.measure(captureClips)          // a body's proportions, from its own clips\n *   const { clip } = MocapReadable.fit(rest, capClip, 30)     // key poses within 30 mm of the capture\n *   MocapReadable.text(clip)  MocapReadable.parse(text)  MocapReadable.mirror(clip)\n *   MocapReadable.pose(rest, clip, t, out)                    // 36 body points (mm) at time t\n * ============================================================================= */\nvar MocapReadable = (() => {\n'use strict';\n\n/** the body points a pose rebuilds, in the rig's local frame (f forward, r right, z up), millimetres */\nconst POINTS = ['pelvis', 'spine1', 'spine2', 'chest', 'neck', 'head', 'headTop', 'faceF', 'chestF', 'pelvisF',\n  ...['L', 'R'].flatMap(s => ['clav', 'sh', 'elbow', 'wrist', 'index', 'knuck', 'pinky', 'fist', 'hip', 'knee', 'ankle', 'ball', 'toe'].map(p => p + s))];\nconst IDX = {}; POINTS.forEach((p, i) => IDX[p] = i);\nconst P = POINTS.length;\n\nconst LEGEND = `// my-3D2dge readable clip. Times in seconds; every other number is a whole number. Rig frame: forward, right, up.\n// L and R are the figure's own sides. Directions are percentages and need not add up: [100, 0, 0] and [50, 0, 0] agree.\n// hips   [forward, right, up]   the pelvis, in percent of standing hip height (100 = standing, 55 = sitting on a chair)\n// body   [turn, lean, tilt]     the pelvis, degrees: turn + = toward the right, lean + = forward, tilt + = toward the right\n// chest  [turn, lean, tilt]     the chest, relative to the pelvis        head [turn, lean, tilt]  relative to the chest\n// shL shR    [reach, shrug]     degrees the shoulder swings forward (into a punch or an aim) and up, from rest\n// armL armR  [forward, out, up, bend, twist]  which way the arm points from the shoulder to the fist, in chest space\n//            (out + = away from the body on that side; [0, 0, -100] hangs down, [100, 0, 0] punches ahead);\n//            bend = elbow bend in degrees (0 = straight); twist = degrees the elbow swings round the arm from its\n//            natural direction (back and down)\n// legL legR  [forward, out, up, bend, twist]  hip to ankle in pelvis space; bend: the knee; twist: from pointing forward\n// footL footR [down, out, toes]   degrees the foot points down from standing, turns outward, and the toes bend up\n// blade  [forward, right, up]   (sword clips) the direction of a blade held in the right fist, in chest space\n// root   [forward, right]       (clips that travel) how far the whole body has moved, in percent of standing hip height`;\n\n/* ---- vectors, frames, rotations ---- */\nconst RV = {\n  sub: (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]], add: (a, b) => [a[0] + b[0], a[1] + b[1], a[2] + b[2]], mul: (a, k) => [a[0] * k, a[1] * k, a[2] * k],\n  dot: (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2], len: a => Math.hypot(a[0], a[1], a[2]),\n  cross: (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]],\n  norm: a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; }\n};\n// a frame is [F, R, U]: its forward, right and up axes written in the parent's coordinates (f x r = u)\nconst frameFR = (right, fwd) => { const R = RV.norm(right), F = RV.norm(RV.sub(fwd, RV.mul(R, RV.dot(fwd, R)))); return [F, R, RV.cross(F, R)]; };\nconst frameUF = (up, fwd) => { const U = RV.norm(up), F = RV.norm(RV.sub(fwd, RV.mul(U, RV.dot(fwd, U)))); return [F, RV.cross(U, F), U]; };\nconst loc = (M, v) => [RV.dot(v, M[0]), RV.dot(v, M[1]), RV.dot(v, M[2])];\nconst wld = (M, l) => [M[0][0] * l[0] + M[1][0] * l[1] + M[2][0] * l[2], M[0][1] * l[0] + M[1][1] * l[1] + M[2][1] * l[2], M[0][2] * l[0] + M[1][2] * l[1] + M[2][2] * l[2]];\nconst rel = (Pm, Cm) => Cm.map(c => loc(Pm, c));          // child frame in parent coordinates\nconst compose = (Pm, Rm) => Rm.map(c => wld(Pm, c));      // parent then relative -> child in the grandparent's coordinates\nconst DG = Math.PI / 180;\n// rotations as quaternions [x, y, z, w], to spread a bend over the spine and the neck\n","exit_code":0,"status":"completed"}}
