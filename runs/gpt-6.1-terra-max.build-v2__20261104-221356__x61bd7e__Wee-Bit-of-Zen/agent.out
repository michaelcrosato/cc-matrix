{"type":"item.started","item":{"id":"item_643","type":"command_execution","command":"/bin/bash -lc \"set -e\nD='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'\nnode \\\"\"'$D/build.mjs\"\nNODE_PATH=\"$(npm root -g)\" PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 node <<'\"'NODE'\nconst {chromium, webkit} = require('playwright');\nconst path = '/tmp/viewport-matrix/wee-zen';\nconst url = 'http://127.0.0.1:32893/' + encodeURIComponent('Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356.html');\n(async () => {\n  for (const spec of [\n    {name:'desktop', browser:chromium, viewport:{width:1440,height:900}},\n    {name:'phone', browser:webkit, viewport:{width:375,height:667}},\n    {name:'tablet', browser:webkit, viewport:{width:768,height:1024}}\n  ]) {\n    const browser = await spec.browser.launch({headless:true});\n    const page = await browser.newPage({viewport:spec.viewport, deviceScaleFactor:1});\n    await page.goto(url);\n    await page.evaluate(() => { localStorage.clear(); location.reload(); });\n    await page.waitForFunction(() => window.__ZEN);\n    for (const [name, command] of [\n      ['slots', () => __ZEN.action('slots')],\n      ['setup', () => __ZEN.action('slot', '0')],\n      ['island', () => { __ZEN.action('create-member'); __ZEN.action('island'); }],\n      ['class', () => __ZEN.action('class')],\n      ['settings', () => __ZEN.action('settings')]\n    ]) {\n      await page.evaluate(command);\n      await page.screenshot({path:\"'`${path}/${spec.name}-${name}-finalcheck.png`});\n      const info = await page.evaluate(() => {\n        const app = document.querySelector('\"'#app');\n        const main = document.querySelector('.main-wrap');\n        return {scrollHeight:app.scrollHeight, clientHeight:app.clientHeight, mainTop:Math.round(main.getBoundingClientRect().top), direction:getComputedStyle(main).flexDirection};\n      });\n      console.log(spec.name, name, JSON.stringify(info));\n      if (info.scrollHeight > info.clientHeight) {\n        await page.evaluate(() => { const app=document.querySelector('#app'); app.scrollTop=app.scrollHeight; });\n        await page.screenshot({path:\"'`${path}/${spec.name}-${name}-scrolled-finalcheck.png`});\n      }\n    }\n    await browser.close();\n  }\n})().catch(error => { console.error(error); process.exit(1); });\nNODE'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
