{"type":"item.started","item":{"id":"item_329","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; cat \\\"\"'$D/src/game.js\"; sed -n '\"'1,155p' \\\"\"'$D/src/art.js\"; cat \"$D/src/data.js\"; sed -n '\"'1,180p' TASK.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_329","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; cat \\\"\"'$D/src/game.js\"; sed -n '\"'1,155p' \\\"\"'$D/src/art.js\"; cat \"$D/src/data.js\"; sed -n '\"'1,180p' TASK.md\"","aggregated_output":"'use strict';\n\nconst app = document.getElementById('app');\nconst STORAGE = 'wee-bit-of-zen-v1';\nconst DEFAULT_SETTINGS = { music: 10, sound: 10, voice: true, gentle: false, breathToggle: false, tips: true, glyphs: 'PlayStation' };\nlet stored;\ntry { stored = JSON.parse(localStorage.getItem(STORAGE) || '{}'); } catch (_) { stored = {}; }\nconst state = {\n  screen: 'title', clock: 0, idle: 0, input: 'keyboard', settings: { ...DEFAULT_SETTINGS, ...(stored.settings || {}) },\n  slots: Array.isArray(stored.slots) ? stored.slots : [null, null, null], slot: 0, member: null,\n  selection: null, activity: null, returnScreen: 'title', check: null, toast: '', classPlayers: [],\n  festival: false, festivalIndex: 0, hub: { active: !!window.AIHub?.active, started: false, finished: false, score: 0, lastSend: 0, lastProgress: 0, ghosts: {} }\n};\nwhile (state.slots.length < 3) state.slots.push(null);\nconst keys = new Set();\nlet mouseLean = null, lastFrame = 0, lastHud = 0, audioContext = null, nextMusic = 0, gamepadPrevious = [];\nlet toggledBreath = false, pausedFrom = null;\n\nfunction save() {\n  if (state.hub.active) return;\n  if (state.member) state.slots[state.slot] = state.member;\n  try { localStorage.setItem(STORAGE, JSON.stringify({ settings: state.settings, slots: state.slots })); } catch (_) { notify('Saving is unavailable in this browser.'); }\n}\nfunction notify(text) {\n  state.toast = text;\n  const node = document.getElementById('toast');\n  if (node) { node.textContent = text; node.hidden = false; }\n  setTimeout(() => { if (state.toast === text) { state.toast = ''; const toast = document.getElementById('toast'); if (toast) toast.hidden = true; } }, 3000);\n}\nfunction tone(frequency, duration = .14, volume = .5, type = 'sine') {\n  if (!audioContext || audioContext.state !== 'running' || !state.settings.sound) return;\n  const oscillator = audioContext.createOscillator(), gain = audioContext.createGain(), now = audioContext.currentTime;\n  oscillator.type = type; oscillator.frequency.setValueAtTime(frequency, now);\n  gain.gain.setValueAtTime(.0001, now); gain.gain.exponentialRampToValueAtTime(Math.max(.00011, state.settings.sound / 100 * volume * .18), now + .015); gain.gain.exponentialRampToValueAtTime(.0001, now + duration);\n  oscillator.connect(gain); gain.connect(audioContext.destination); oscillator.start(now); oscillator.stop(now + duration + .01);\n}\nfunction unlockAudio() {\n  try { if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)(); if (audioContext.state === 'suspended') audioContext.resume(); } catch (_) {}\n}\nfunction music() {\n  if (!audioContext || audioContext.state !== 'running' || !state.settings.music || state.clock < nextMusic) return;\n  nextMusic = state.clock + 1.25;\n  const notes = [261.63, 329.63, 392, 493.88, 392, 329.63, 293.66, 349.23];\n  const oscillator = audioContext.createOscillator(), gain = audioContext.createGain(), now = audioContext.currentTime;\n  oscillator.type = 'sine'; oscillator.frequency.value = notes[Math.floor(state.clock / 1.25) % notes.length];\n  gain.gain.setValueAtTime(.0001, now); gain.gain.exponentialRampToValueAtTime(Math.max(.00011, state.settings.music / 100 * .035), now + .08); gain.gain.exponentialRampToValueAtTime(.0001, now + 1.1);\n  oscillator.connect(gain); gain.connect(audioContext.destination); oscillator.start(now); oscillator.stop(now + 1.15);\n}\nfunction hint() { return state.input === 'gamepad' ? (state.settings.glyphs === 'Xbox' ? 'A SELECT  ·  B BACK' : '✕ SELECT  ·  ○ BACK') : '↑ ↓ CHOOSE  ·  ENTER SELECT  ·  ESC BACK'; }\nfunction button(label, action, primary = false, id = '', detail = '') {\n  return `<button class=\"action${primary ? ' primary' : ''}\" data-action=\"${action}\" data-id=\"${escapeHTML(id)}\"><span>${label}${detail ? `<small>${detail}</small>` : ''}</span><span class=\"arrow\">↗</span></button>`;\n}\nfunction shell(content, label = '', footer = true) {\n  return `<div class=\"page\"><header class=\"topbar\"><button class=\"brand\" data-action=\"home\" aria-label=\"Return to title\"><span class=\"brand-mark\">✳</span><span>WEE BIT <b>OF ZEN</b></span></button><span class=\"top-label\">${label}</span><button class=\"settings-link\" data-action=\"settings\" aria-label=\"Settings\">⚙ <span>SETTINGS</span></button></header>${content}${footer ? `<footer class=\"footer\"><span>${hint()}</span><span>THE INSTITUTE FOR GENTLE IMPROVEMENT&nbsp; ✳ &nbsp; LUMBAR ISLAND</span></footer>` : ''}</div><div class=\"toast\" id=\"toast\" hidden></div>`;\n}\nfunction screen(name) { state.screen = name; state.idle = 0; render(); }\nfunction person() { return state.member || { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\nfunction labelDay() { const member = person(); return member.finished ? 'FREE PRACTICE' : `DAY ${member.day} OF 5`; }\nfunction tile(activity, locked = false) {\n  const group = GROUPS[activity.group], stars = person().stars?.[activity.id] || 0;\n  return `<button class=\"activity ${locked ? 'locked' : ''}\" data-action=\"${locked ? 'locked' : 'select-activity'}\" data-id=\"${activity.id}\" style=\"--group:${group.color};--group-light:${group.light}\"><span class=\"activity-icon\">${activity.icon}</span><span class=\"activity-copy\"><span class=\"activity-group\">${group.name}</span><strong>${activity.name}</strong><small>${locked ? `Opens day ${activity.day}` : activity.tagline}</small></span><span class=\"activity-end\">${locked ? '⌁' : (stars ? '★'.repeat(stars) : '↗')}</span></button>`;\n}\nfunction settingRow(label, value, action, id = '') { return `<div class=\"row\"><span>${label}</span><button class=\"chip setting-button\" data-action=\"${action}\" data-id=\"${id}\">${value}</button></div>`; }\nfunction aboutContent() {\n  const info = window.BUILD_INFO || {}, sections = [ ['Source Information', info.sourceInformation], ['Testing Feedback', info.testingFeedback], ['Engine Feedback', info.engineFeedback], ['Prompt Feedback', info.promptFeedback] ];\n  return sections.map(([title, value]) => `<div class=\"about-group\"><h3>${title}</h3>${Array.isArray(value) ? value.map((item, index) => `<p><b>${index + 1}.</b> ${escapeHTML(item)}</p>`).join('') : Object.entries(value || {}).map(([key, item]) => `<p><b>${escapeHTML(key)}:</b> ${escapeHTML(item)}</p>`).join('')}</div>`).join('');\n}\nfunction render() {\n  const member = person();\n  let content = '', heading = '';\n  if (state.screen === 'title' || state.screen === 'attract') {\n    content = `<main class=\"hero\"><section class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"sun-dot\">✳</span> A LITTLE ISLAND FOR YOURSELF</div><h1 class=\"logo\">wee bit<br><em>of zen</em><span class=\"logo-dot\">.</span></h1><p class=\"lede\">A pleasantly imperfect retreat for<br>your body, mind, and general wobble.</p><div class=\"menu-stack\">${button('Begin your stay', 'slots', true, '', 'A little time just for you')}${button('Local Class', 'class', false, '', 'Practice together, up to four')}${button('About & credits', 'about')}</div></section><div class=\"island-message\"><span>✦ &nbsp; TAKE IT AT YOUR OWN PACE</span><strong>Good things happen<br>one wobble at a time.</strong></div></main>`;\n    if (state.screen === 'attract') content += '<div class=\"center-copy\">DEMONSTRATION &nbsp; · &nbsp; PRESS ANY KEY</div>';\n  } else if (state.screen === 'slots') {\n    heading = 'YOUR STAY';\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; THE GUEST BOOK</div><h1>Make yourself at home.</h1><p>Choose a room for your island stay.</p></div></div><div class=\"card-grid\">${state.slots.map((slot, index) => `<button class=\"card slot-card\" data-action=\"slot\" data-id=\"${index}\"><span class=\"slot-num\">0${index + 1}</span><span class=\"slot-avatar\">${slot ? '☺' : '+'}</span><strong>${slot ? escapeHTML(slot.name) : 'New member'}</strong><small>${slot ? `${slot.finished ? 'Free practice' : `Day ${slot.day}`} · ${Math.floor(slot.minutes || 0)} fit minutes` : 'A fresh start awaits'}</small><span class=\"arrow\">↗</span></button>`).join('')}</div><div class=\"actions\">${button('Back', 'home')}</div></main>`;\n  } else if (state.screen === 'setup') {\n    heading = 'NEW MEMBER';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; NICE TO MEET YOU</div><h1>A little about you.</h1><p>There is no wrong way to arrive.</p></div></div><div class=\"card setup-card\"><label class=\"field\">WHAT SHOULD WE CALL YOU?<input id=\"nickname\" maxlength=\"16\" value=\"${escapeHTML(member.name === 'Guest' ? '' : member.name)}\" placeholder=\"Your name\" autocomplete=\"off\"></label><p class=\"field-label\">CHOOSE YOUR COLOUR</p><div class=\"options\">${OUTFITS.map((color, index) => `<button class=\"option swatch ${member.outfit === index ? 'selected' : ''}\" data-action=\"outfit\" data-id=\"${index}\" style=\"--swatch:${color}\" aria-label=\"Outfit ${index + 1}\">${member.outfit === index ? '✓' : ''}</button>`).join('')}</div><p class=\"field-label\">YOUR INSTRUCTOR</p><div class=\"options\">${['Birch', 'Alder'].map(name => `<button class=\"option ${member.instructor === name ? 'selected' : ''}\" data-action=\"instructor\" data-id=\"${name}\">${name === 'Birch' ? '✳' : '✦'} &nbsp; ${name}</button>`).join('')}</div><div class=\"actions\">${button('Back', 'slots')}${button('Arrive on the island', 'create-member', true)}</div></div></main>`;\n  } else if (state.screen === 'intro') {\n    heading = labelDay();\n    content = `<main class=\"main-wrap narrow\"><div class=\"dialogue card\"><div class=\"eyebrow\">✳ &nbsp; A NOTE FROM TARE</div><div class=\"speaker\">☺</div><h1>Welcome${member.day === 1 ? ', ' + escapeHTML(member.name) : ' back'}.</h1><p>“${DAY_INTROS[Math.min(4, member.day - 1)]}”</p><p class=\"note\">Your stay starts with a gentle body check. No weights, no judgement, and absolutely no pop quizzes. Well, one tiny quiz.</p><div class=\"actions\">${button('Begin body check', 'check', true)}</div></div></main>`;\n  } else if (state.screen === 'check') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">✳ &nbsp; BODY CHECK</div><h2>Just checking in.</h2><p id=\"check-text\">Find a comfortable center.</p></div><div class=\"hud-box timer\" id=\"check-timer\">05</div></div><div class=\"hud-bottom\"><div class=\"play-instruction\">${state.check?.phase === 'lean' ? 'Lean in each direction: ← ↑ → ↓' : 'Stay steady. Small wobbles are welcome.'}</div><div class=\"meter\"><span id=\"check-progress\"></span></div></div></main>`;\n  } else if (state.screen === 'question') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ONE VERY SCIENTIFIC QUESTION</div><h1>How are you arriving today?</h1><p>Your answer helps us calibrate the island's extremely sophisticated vibes.</p><div class=\"menu-stack\">${button('Bright-eyed and bushy-tailed', 'question-answer', true, 'bright')}${button('A little wobbly, honestly', 'question-answer', false, 'wobbly')}${button('Mostly thinking about snacks', 'question-answer', false, 'snacks')}</div></div></main>`;\n  } else if (state.screen === 'check-result') {\n    heading = 'BODY CHECK COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ACCORDING TO TARE</div><div class=\"score-big\">${state.check.spine}</div><h1>Your Spine Age</h1><p>“A completely imaginary number. Your actual spine remains splendid.”</p><p class=\"note\">Today is a fine day to practice being here.</p><div class=\"actions\">${button('Explore the island', 'island', true)}</div></div></main>`;\n  } else if (state.screen === 'island') {\n    heading = labelDay();\n    const dialogue = CAST[(member.day + member.sessions) % CAST.length];\n    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of movement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished ? 'ending' : 'sleep', true)}</div></div></main>`;\n  } else if (state.screen === 'activity') {\n    const activity = state.selection, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>How to play</h3><p>${activity.instruction}</p><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle mode is on.' : 'Make small, comfortable movements.'}</p><div class=\"actions\">${button('Back to island', state.classMode ? 'class' : 'island')}${button('Begin practice', 'start-activity', true)}</div></div></main>`;\n  } else if (state.screen === 'play') {\n    const activity = state.activity, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your center.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"play-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span id=\"play-progress\"></span></div><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE START</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\n  } else if (state.screen === 'result') {\n    const result = state.result;\n    heading = 'SESSION COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue result-card\"><div class=\"eyebrow\">✳ &nbsp; PRACTICE COMPLETE</div><div class=\"stars-big\">${'★'.repeat(result.stars)}<span>${'☆'.repeat(3 - result.stars)}</span></div><h1>Lovely work${state.classMode ? ', everyone' : ''}.</h1><p>“${result.message}”</p><div class=\"result-stats\"><div><strong>${result.percent}%</strong><small>STEADINESS</small></div><div><strong>+${result.minutes}</strong><small>FIT MINUTES</small></div><div><strong>${result.stumbles}</strong><small>WOBBLES</small></div></div><div class=\"actions\">${button('Practice again', 'retry')}${button(state.festival ? 'Continue the Games' : state.classMode ? 'Class results' : 'Back to island', 'result-continue', true)}</div></div></main>`;\n  } else if (state.screen === 'recap') {\n    heading = 'DAY COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ANOTHER DAY WELL SPENT</div><h1>Rest is part of it.</h1><p>“${member.sessions} sessions today. Gerald the ceramic hippo has made a careful note.”</p><div class=\"result-stats\"><div><strong>${Math.floor(member.minutes)}</strong><small>FIT MINUTES</small></div><div><strong>${Object.keys(member.stars || {}).length}</strong><small>MATS VISITED</small></div></div><div class=\"actions\">${button('Wake up to day ' + (member.day + 1), 'next-day', true)}</div></div></main>`;\n  } else if (state.screen === 'festival') {\n    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Three friendly challenges, ending in the Grand Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"actions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n  } else if (state.screen === 'ending') {\n    heading = 'THANK YOU FOR STAYING';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little steadier.<br><em>A lot more you.</em></h1><p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for five days of moving, breathing, and making room. The mats are yours whenever you wish.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits', 'about')}</div></div></main>`;\n  } else if (state.screen === 'class') {\n    heading = 'LOCAL CLASS';\n    const players = state.classPlayers;\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect controllers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHTML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ? 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selection?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.name === 'Guest' ? 'home' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n  } else if (state.screen === 'class-result') {\n    heading = 'LOCAL CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\n  } else if (state.screen === 'settings') {\n    heading = 'SETTINGS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card settings-card\">${settingRow('Music', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${settingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.tips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n  } else if (state.screen === 'pause') {\n    heading = 'PAUSED';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', true)}${button('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', 'leave-play')}</div></div></main>`;\n  } else if (state.screen === 'dev') {\n    heading = 'DEVELOPER MODE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the wobble.</h1>${[['spring','Spring',4,20,.5],['damping','Damping',1,12,.5],['instability','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output id=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"actions\">${button('Reset tuning', 'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n  } else if (state.screen === 'about') {\n    heading = 'ABOUT & CREDITS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card scroll\"><div class=\"eyebrow\">✳ &nbsp; A LITTLE NOTE FROM THE MAKERS</div><h1>About & credits.</h1><p>Made with care for everyone who has ever wobbled.</p>${aboutContent()}<div class=\"actions\">${button('Back', 'about-back', true)}</div></div></main>`;\n  } else if (state.screen === 'hub') {\n    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A little steadiness, shared.'}</h1><p>${state.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; everyone gets a moment to breathe.'}</p><div class=\"result-stats\"><div><strong>${Math.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.started ? 'The class is underway.' : 'Waiting for the other guests…'}</p></div></main>`;\n  }\n  app.innerHTML = shell(content, heading, state.screen !== 'play' && state.screen !== 'check');\n  enhanceModes();\n  if (state.screen === 'play') updateHUD();\n  if (state.screen === 'check') updateCheckHUD();\n  const touchOnly = matchMedia('(pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n  if (touchOnly && !['settings','about'].includes(state.screen)) {\n    const notice = document.createElement('div'); notice.className = 'touch-notice'; notice.innerHTML = '<div><span>✳</span><h2>Controller or keyboard required</h2><p>Connect a controller or keyboard to enjoy the island.</p><button class=\"action primary\" data-action=\"settings\">Settings <span class=\"arrow\">↗</span></button></div>'; app.appendChild(notice);\n  }\n}\nfunction currentButtons() { return [...app.querySelectorAll('button:not([disabled])')].filter(node => node.offsetParent !== null && !node.closest('.touch-notice')); }\nfunction focusMove(direction) {\n  const buttons = currentButtons(); if (!buttons.length) return;\n  const index = buttons.indexOf(document.activeElement); buttons[(index + direction + buttons.length) % buttons.length].focus();\n}\nfunction memberDefault() { return { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\nfunction beginCheck() { state.check = { phase: 'still', elapsed: 0, directions: new Set(), spine: 25 + Math.floor(Math.random() * 25) }; state.activity = null; screen('check'); }\nfunction startActivity(activity, options = {}) {\n  const selected = { ...activity }, duration = options.seconds || selected.seconds;\n  state.selection = selected;\n  state.activity = { ...selected, seconds: duration, elapsed: 0, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, ringX: 0, ringY: 0, flame: .6, score: 0, samples: 0, stumbles: 0, stun: 0, effort: 0, reps: 0, beatHits: 0, lastBeat: -1, lastJog: '', jogHits: 0, hoopHits: 0, good: 0, tray: 0, lastDirection: 0, motions: 0, rng: seeded(841 + selected.name.length) };\n  if (state.classMode && !state.hub.active) prepareClass();\n  mouseLean = null; keys.clear(); toggledBreath = false; screen('play');\n}\nfunction completeActivity() {\n  const activity = state.activity;\n  if (!activity) return;\n  const percent = Math.round(clamp(activity.score / Math.max(1, activity.samples) * 100, 0, 100));\n  const stars = percent >= 90 ? 3 : percent >= 65 ? 2 : percent >= 35 ? 1 : 0;\n  const minutes = Math.max(1, Math.round(activity.seconds / 60 * (1 + stars * .25)));\n  state.result = { percent, stars, minutes, stumbles: activity.stumbles, message: stars >= 2 ? 'You made the wobble look rather elegant.' : 'A little practice is still a lovely thing.' };\n  if (!state.hub.active && !state.classMode) { const member = state.member; member.sessions = (member.sessions || 0) + 1; member.minutes = (member.minutes || 0) + minutes; member.stars[activity.id] = Math.max(member.stars[activity.id] || 0, stars); save(); }\n  tone(523, .3); if (state.hub.active) { finishHubEvent(); screen('hub'); } else if (state.classMode) screen('class-result'); else screen('result');\n}\nfunction attemptInput(key) {\n  const activity = state.activity;\n  if (!activity || state.screen !== 'play') return;\n  if (activity.kind === 'step') {\n    const directions = ['arrowleft','arrowup','arrowright','arrowdown'];\n    const aliases = { a:'arrowleft', w:'arrowup', d:'arrowright', s:'arrowdown' };\n    const direction = aliases[key] || key, beat = Math.round(activity.elapsed * 100 / 60), phase = Math.abs(activity.elapsed * 100 / 60 - beat);\n    if (direction === directions[(beat + 4) % 4] && phase < .34 && beat !== activity.lastBeat) { activity.beatHits++; activity.lastBeat = beat; tone(520, .08, .35); }\n  }\n  if (activity.kind === 'jog' && (key === 'j' || key === 'k') && key !== activity.lastJog) { activity.lastJog = key; activity.jogHits++; }\n  if (activity.kind === 'hoop' && (key === 'q' || key === 'e')) { activity.hoopHits++; tone(660, .1, .3); }\n  if ((key === ' ' || key === 'enter') && state.settings.breathToggle) toggledBreath = !toggledBreath;\n}\nconst tuningDefaults = { spring: 11, damping: 6, instability: 1.3, noise: .19 };\nconst tuning = { ...tuningDefaults };\nfunction updateActivity(dt) {\n  const activity = state.activity; if (!activity) return;\n  activity.elapsed += dt;\n  const pad = Array.from(navigator.getGamepads?.() || []).find(candidate => candidate && !state.classActors?.some(actor => actor.player.padIndex === candidate.index)), axisX = pad && Math.abs(pad.axes[0]) > .12 ? pad.axes[0] : 0, axisY = pad && Math.abs(pad.axes[1]) > .12 ? pad.axes[1] : 0;\n  const dx = (keys.has('arrowright') || keys.has('d') ? 1 : 0) - (keys.has('arrowleft') || keys.has('a') ? 1 : 0);\n  const dy = (keys.has('arrowdown') || keys.has('s') ? 1 : 0) - (keys.has('arrowup') || keys.has('w') ? 1 : 0);\n  if (activity.stun <= 0) {\n    if (mouseLean) { activity.ux = mouseLean.x; activity.uy = mouseLean.y; }\n    else if (axisX || axisY) { activity.ux = axisX; activity.uy = axisY; }\n    else { activity.ux = clamp(activity.ux + dx * 2.2 * dt, -1, 1); activity.uy = clamp(activity.uy + dy * 2.2 * dt, -1, 1); if (!dx) activity.ux *= Math.max(0, 1 - .5 * dt); if (!dy) activity.uy *= Math.max(0, 1 - .5 * dt); }\n  } else activity.stun -= dt;\n  const gentle = state.settings.gentle ? .7 : 1, time = activity.elapsed, disturbance = tuning.noise * gentle;\n  const ax = tuning.spring * (activity.ux - activity.px) - tuning.damping * activity.vx + tuning.instability * gentle * activity.px + disturbance * (Math.sin(time * 1.7) + .5 * Math.sin(time * 3.23));\n  const ay = tuning.spring * (activity.uy - activity.py) - tuning.damping * activity.vy + tuning.instability * gentle * activity.py + disturbance * (Math.sin(time * 1.19 + 1) + .5 * Math.sin(time * 2.71));\n  activity.vx += ax * dt; activity.vy += ay * dt; activity.px += activity.vx * dt; activity.py += activity.vy * dt;\n  if (Math.hypot(activity.px, activity.py) >= 1 && activity.stun <= 0) { activity.stumbles++; activity.stun = 1; activity.px *= .5; activity.py *= .5; activity.vx *= -.2; activity.vy *= -.2; tone(196, .18); }\n  const phase = Math.floor(time / 12), rng = seeded(phase * 667 + 43);\n  activity.ringX = activity.id === 'stork' ? (rng() - .5) * .65 : activity.kind === 'slalom' ? Math.sin(time * .55) * .46 : 0;\n  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n  let quality = steadiness;\n  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n  activity.score += quality; activity.samples++;\n  if (state.classMode && !state.hub.active) updateClass(dt);\n  if (state.hub.active) {\n    const now = window.AIHub.time();\n    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n  }\n  if (!state.hub.active && activity.elapsed >= activity.seconds) completeActivity();\n}\nfunction updateHUD() {\n  const activity = state.activity; if (!activity) return;\n  const timer = document.getElementById('play-timer'), status = document.getElementById('play-status'), instruction = document.getElementById('play-instruction'), progress = document.getElementById('play-progress'), dot = document.getElementById('plate-dot'), ring = document.getElementById('plate-ring'), score = document.getElementById('play-score');\n  if (!timer) return;\n  timer.textContent = Math.max(0, Math.ceil(activity.seconds - activity.elapsed));\n  if (activity.kind === 'step') { const arrows = ['←','↑','→','↓']; const beat = Math.round(activity.elapsed * 100 / 60); status.textContent = `NEXT STEP  ${arrows[(beat + 4) % 4]}   ·   ${activity.beatHits} on beat`; instruction.textContent = `Press ${arrows[(beat + 4) % 4]} on the beat · ${activity.instruction}`; }\n  else if (activity.kind === 'rep') status.textContent = `Rep ${activity.reps + 1} · ${Math.sin(activity.elapsed * Math.PI / 2 - Math.PI / 2) > 0 ? 'Rise gently' : 'Lower gently'}`;\n  else if (activity.kind === 'breath') status.textContent = Math.sin(activity.elapsed * Math.PI / 4) > 0 ? 'Breathe in · hold' : 'Breathe out · release';\n  else if (activity.kind === 'candle') status.textContent = `Flame ${Math.round(activity.flame * 100)}% · ${activity.flame < .15 ? 'settle to relight' : 'let it glow'}`;\n  else if (activity.kind === 'jog') status.textContent = `${activity.jogHits} steps · alternate J and K`;\n  else if (activity.kind === 'hoop') status.textContent = `${activity.hoopHits} catches · circle your lean`;\n  else status.textContent = activity.stun > 0 ? 'A wobble! Take a moment.' : 'Find the ring. Breathe naturally.';\n  progress.style.width = `${clamp(activity.elapsed / activity.seconds * 100, 0, 100)}%`;\n  dot.style.transform = `translate(${activity.px * 70}px, ${activity.py * 70}px)`;\n  ring.style.transform = `translate(${activity.ringX * 70}px, ${activity.ringY * 70}px)`;\n  score.textContent = `${Math.round(activity.score / Math.max(1, activity.samples) * 100)}% STEADY`;\n}\nfunction updateCheckHUD() {\n  if (!state.check) return;\n  const timer = document.getElementById('check-timer'), text = document.getElementById('check-text'), progress = document.getElementById('check-progress');\n  if (!timer) return;\n  timer.textContent = state.check.phase === 'still' ? String(Math.max(0, Math.ceil(5 - state.check.elapsed))).padStart(2, '0') : `${state.check.directions.size}/4`;\n  text.textContent = state.check.phase === 'still' ? 'Find a comfortable center.' : 'Lean left, up, right and down.';\n  progress.style.width = `${state.check.phase === 'still' ? clamp(state.check.elapsed / 5 * 50, 0, 50) : 50 + state.check.directions.size * 12.5}%`;\n}\nfunction update(dt) {\n  state.clock += dt;\n  if (state.screen === 'title') { state.idle += dt; if (state.idle >= 10 && !state.hub.active) screen('attract'); }\n  if (state.screen === 'check') { state.check.elapsed += dt; if (state.check.phase === 'still' && state.check.elapsed >= 5) { state.check.phase = 'lean'; state.check.elapsed = 0; } if (state.check.phase === 'lean' && (state.check.directions.size === 4 || state.check.elapsed >= 14)) screen('question'); }\n  if (state.screen === 'play') updateActivity(dt);\n}\nfunction action(name, id) {\n  unlockAudio(); state.idle = 0; tone(440, .07, .2);\n  switch (name) {\n    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n    case 'slots': screen('slots'); break;\n    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n    case 'outfit': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.outfit = Number(id); render(); break;\n    case 'instructor': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.instructor = id; render(); break;\n    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n    case 'check': beginCheck(); break;\n    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n    case 'island': state.classMode = false; screen('island'); break;\n    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n    case 'locked': notify('A new mat opens on a later day.'); break;\n    case 'start-activity': startActivity(state.selection); break;\n    case 'retry': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n    case 'ending': screen('ending'); break;\n    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad', source: 'primary' }, { name: 'Gertrude', type: 'Bot', source: 'bot' }]; if (!CLASS_IDS.includes(state.selection?.id)) state.selection = ACTIVITIES[0]; screen('class'); break;\n    case 'class-toggle': { const index = Number(id); if (index === 0) break; const current = state.classPlayers[index]; state.classPlayers[index] = !current ? { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot', source: 'bot' } : index === 1 && current.source === 'bot' ? { name: 'Player 2', type: 'Keyboard 2', source: 'keyboard' } : null; render(); break; }\n    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection, { seconds: 35 }); break;\n    case 'hub-ready': window.AIHub.answer('ready'); notify('Ready to go!'); break;\n    case 'hub-more': window.AIHub.answer('more'); notify('Waiting for more players.'); break;\n    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n    case 'pause': pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); break;\n    case 'resume': screen(pausedFrom || 'play'); break;\n    case 'restart': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n    case 'dev': screen('dev'); break;\n    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n    case 'about-back': screen(state.aboutReturn || 'title'); break;\n  }\n}\napp.addEventListener('click', event => { const target = event.target.closest('[data-action]'); if (target) action(target.dataset.action, target.dataset.id); });\napp.addEventListener('mouseover', event => { const target = event.target.closest('button'); if (target && state.input !== 'gamepad') target.focus({ preventScroll: true }); });\napp.addEventListener('input', event => { const key = event.target.dataset.tuning; if (key) { tuning[key] = Number(event.target.value); document.getElementById(`out-${key}`).value = tuning[key]; } });\nwindow.addEventListener('keydown', event => {\n  if (event.repeat && event.key !== ' ') return;\n  state.input = 'keyboard'; state.idle = 0; const key = event.key.toLowerCase();\n  if (state.screen === 'attract') { event.preventDefault(); screen('title'); return; }\n  if (event.target instanceof HTMLInputElement && event.target.type === 'text') { if (key === 'enter') { event.preventDefault(); action('create-member'); } return; }\n  if (['arrowup','arrowdown','arrowleft','arrowright',' '].includes(key)) event.preventDefault();\n  keys.add(key); unlockAudio();\n  if (state.screen === 'check' && state.check.phase === 'lean') { const mapping = { a:'left', arrowleft:'left', w:'up', arrowup:'up', d:'right', arrowright:'right', s:'down', arrowdown:'down' }; if (mapping[key]) state.check.directions.add(mapping[key]); return; }\n  if (state.screen === 'play') { if (key === 'escape') action('pause'); else attemptInput(key); return; }\n  if (key === 'escape' || key === 'backspace') { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (state.screen === 'dev') screen('pause'); else if (state.screen === 'activity') action('island'); else if (state.screen === 'slots' || state.screen === 'class') action('home'); return; }\n  if (key === 'arrowdown' || key === 's') focusMove(1); else if (key === 'arrowup' || key === 'w') focusMove(-1); else if ((key === 'enter' || key === ' ') && document.activeElement?.tagName !== 'BUTTON') { const buttons = currentButtons(); if (buttons.length) buttons[0].focus(); }\n});\nwindow.addEventListener('keyup', event => keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur', () => { keys.clear(); if (state.screen === 'play' && !state.hub.active) action('pause'); });\nwindow.addEventListener('mousemove', event => { if (state.screen !== 'play' || event.buttons === 0) return; state.input = 'mouse'; mouseLean = { x: clamp((event.clientX - innerWidth / 2) / (innerHeight * .33), -1, 1), y: clamp((event.clientY - innerHeight / 2) / (innerHeight * .33), -1, 1) }; });\nwindow.addEventListener('mousedown', event => { if (state.screen === 'play' && event.button === 0) keys.add(' '); });\nwindow.addEventListener('mouseup', () => keys.delete(' '));\nfunction pollGamepad() {\n  const pads = Array.from(navigator.getGamepads?.() || []);\n  for (const pad of pads) {\n    if (!pad) continue;\n    const previous = gamepadPrevious[pad.index] || [];\n    pad.buttons.forEach((item, index) => {\n      if (item.pressed && !previous[index]) {\n        state.input = 'gamepad'; state.idle = 0; unlockAudio();\n        if (state.screen === 'attract') screen('title');\n        else if (state.screen === 'play') { if (index === 9) action('pause'); else if (index === 4 || index === 5) attemptInput(index === 4 ? 'q' : 'e'); else if (index === 6 || index === 7) attemptInput(index === 6 ? 'j' : 'k'); }\n        else if (state.screen === 'check' && state.check.phase === 'lean') { if (index === 12) state.check.directions.add('up'); if (index === 13) state.check.directions.add('down'); if (index === 14) state.check.directions.add('left'); if (index === 15) state.check.directions.add('right'); }\n        else if (index === 0) { const selected = document.activeElement; if (selected?.tagName === 'BUTTON') selected.click(); else currentButtons()[0]?.focus(); }\n        else if (index === 1) { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (!state.hub.active) action('home'); }\n        else if (index === 12) focusMove(-1); else if (index === 13) focusMove(1);\n      }\n    });\n    if (state.screen === 'check' && state.check.phase === 'lean') { if (pad.axes[0] < -.45) state.check.directions.add('left'); if (pad.axes[0] > .45) state.check.directions.add('right'); if (pad.axes[1] < -.45) state.check.directions.add('up'); if (pad.axes[1] > .45) state.check.directions.add('down'); }\n    gamepadPrevious[pad.index] = pad.buttons.map(item => item.pressed);\n  }\n}\nconst simulation = new My3D2dge.Game({ headless: true, step: 1 / 120 });\nsimulation.start({ update, draw() {} });\nfunction frame(now) {\n  const dt = lastFrame ? Math.min(.1, (now - lastFrame) / 1000) : 0; lastFrame = now;\n  pollGamepad(); simulation.advance(dt); music(); drawWorld({ ...state, shirt: OUTFITS[person().outfit || 0] });\n  if (now - lastHud > 100) { if (state.screen === 'play') updateHUD(); if (state.screen === 'check') updateCheckHUD(); lastHud = now; }\n  requestAnimationFrame(frame);\n}\nwindow.__ZEN = {\n  state, action, startActivity, tuning,\n  advance(seconds) { simulation.advance(seconds); render(); },\n  snapshot() { return JSON.parse(JSON.stringify({ screen: state.screen, member: state.member, activity: state.activity && { id: state.activity.id, elapsed: state.activity.elapsed, px: state.activity.px, py: state.activity.py, score: state.activity.score, stumbles: state.activity.stumbles }, result: state.result, hub: state.hub, settings: state.settings })); }\n};\nrender(); requestAnimationFrame(frame);\n\nif (state.hub.active) {\n  screen('hub');\n  window.AIHub.on('start', () => { state.hub.started = true; state.hub.startedAt = window.AIHub.time(); startActivity(ACTIVITIES.find(activity => activity.id === 'stork'), { seconds: 60 }); });\n  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n  window.AIHub.on('time-up', () => { if (!state.hub.finished) { state.hub.finished = true; if (state.activity && state.screen === 'play') state.hub.score += state.activity.score / Math.max(1, state.activity.samples) * 1000; window.AIHub.result({ score: Math.round(state.hub.score) }); screen('hub'); } });\n  window.AIHub.on('end', () => { state.hub.finished = true; screen('hub'); });\n  window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }).then(() => window.AIHub.ready()).catch(() => notify('Unable to connect to the Hub.'));\n}\n'use strict';\n\nconst canvas = document.getElementById('world');\nconst context = canvas.getContext('2d');\nlet artWidth = 0;\nlet artHeight = 0;\n\nfunction resizeArt() {\n  const ratio = Math.min(window.devicePixelRatio || 1, 2);\n  artWidth = window.innerWidth;\n  artHeight = window.innerHeight;\n  canvas.width = Math.round(artWidth * ratio);\n  canvas.height = Math.round(artHeight * ratio);\n  context.setTransform(ratio, 0, 0, ratio, 0, 0);\n}\nwindow.addEventListener('resize', resizeArt);\nresizeArt();\n\nfunction ellipse(x, y, rx, ry, color) {\n  context.fillStyle = color;\n  context.beginPath();\n  context.ellipse(x, y, Math.max(.1, rx), Math.max(.1, ry), 0, 0, Math.PI * 2);\n  context.fill();\n}\nfunction line(x1, y1, x2, y2, width, color) {\n  context.strokeStyle = color;\n  context.lineWidth = width;\n  context.lineCap = 'round';\n  context.beginPath();\n  context.moveTo(x1, y1);\n  context.lineTo(x2, y2);\n  context.stroke();\n}\nfunction rounded(x, y, width, height, radius, color) {\n  context.fillStyle = color;\n  context.beginPath();\n  context.roundRect(x, y, width, height, radius);\n  context.fill();\n}\nfunction drawCloud(x, y, size) {\n  ellipse(x, y, size * 1.4, size * .26, 'rgba(255,255,255,.48)');\n  ellipse(x - size * .45, y - size * .15, size * .55, size * .3, 'rgba(255,255,255,.48)');\n  ellipse(x + size * .25, y - size * .2, size * .65, size * .34, 'rgba(255,255,255,.48)');\n}\nfunction drawTree(x, y, size) {\n  line(x, y, x + size * .03, y - size * .8, size * .11, '#ac8066');\n  ellipse(x, y - size * .79, size * .37, size * .42, '#8ebaa1');\n  ellipse(x - size * .16, y - size * .87, size * .25, size * .3, '#a6ccae');\n}\nfunction drawTare(x, y, size, mood) {\n  ellipse(x, y + size * .12, size * .58, size * .13, 'rgba(50,90,80,.13)');\n  rounded(x - size * .47, y - size * .37, size * .94, size * .48, size * .13, '#e4ede8');\n  rounded(x - size * .47, y - size * .43, size * .94, size * .48, size * .13, '#fffefa');\n  rounded(x - size * .22, y - size * .31, size * .44, size * .2, size * .05, '#d9efdf');\n  ellipse(x - size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n  ellipse(x + size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n  context.strokeStyle = '#416b60'; context.lineWidth = Math.max(1, size * .015); context.beginPath();\n  context.arc(x, y - size * .2, size * .045, .2, Math.PI - .2); context.stroke();\n  if (mood) { context.fillStyle = '#e6ad65'; context.font = `bold ${size * .2}px sans-serif`; context.fillText('✦', x + size * .57, y - size * .46); }\n}\nfunction drawPerson(x, ground, size, options = {}) {\n  const sway = (options.lean || 0) * size * .13 + Math.sin((options.time || 0) * 1.3) * size * .008;\n  const movement = options.movement || 0;\n  const skin = options.skin || '#e8b69b';\n  const shirt = options.shirt || '#f1c86c';\n  const trousers = options.trousers || '#527d75';\n  ellipse(x, ground + size * .035, size * .39, size * .065, 'rgba(56,95,80,.13)');\n  line(x - size * .1, ground - size * .31, x - size * (.16 + movement * .08), ground - size * .03, size * .105, trousers);\n  line(x + size * .1, ground - size * .31, x + size * (.16 - movement * .08), ground - size * .03, size * .105, trousers);\n  line(x - size * (.16 + movement * .08), ground - size * .03, x - size * (.23 + movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n  line(x + size * (.16 - movement * .08), ground - size * .03, x + size * (.23 - movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n  line(x - size * .13 + sway, ground - size * .6, x - size * .35 + sway, ground - size * (.49 + Math.abs(movement) * .12), size * .08, skin);\n  line(x + size * .13 + sway, ground - size * .6, x + size * .35 + sway, ground - size * (.49 - Math.abs(movement) * .12), size * .08, skin);\n  rounded(x - size * .19 + sway, ground - size * .68, size * .38, size * .4, size * .12, shirt);\n  line(x + sway, ground - size * .71, x + sway, ground - size * .65, size * .105, skin);\n  ellipse(x + sway, ground - size * .85, size * .19, size * .22, skin);\n  ellipse(x + sway, ground - size * .99, size * .19, size * .105, '#52655a');\n  ellipse(x - size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n  ellipse(x + size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n  context.strokeStyle = '#a56d61'; context.lineWidth = Math.max(1, size * .012); context.beginPath();\n  context.arc(x + sway, ground - size * .81, size * .045, .1, Math.PI - .1); context.stroke();\n}\nfunction drawScenery(time) {\n  const width = artWidth, height = artHeight;\n  const sky = context.createLinearGradient(0, 0, 0, height);\n  sky.addColorStop(0, '#e3f4ef'); sky.addColorStop(.55, '#eff8e9'); sky.addColorStop(1, '#bfe3d3');\n  context.fillStyle = sky; context.fillRect(0, 0, width, height);\n  ellipse(width * .77, height * .19, Math.min(width, height) * .11, Math.min(width, height) * .11, '#fae9b5');\n  drawCloud(width * .67 + Math.sin(time * .08) * 9, height * .15, width * .08);\n  drawCloud(width * .92, height * .27, width * .05);\n  context.fillStyle = '#c9e7d7'; context.beginPath(); context.moveTo(0, height * .64); context.quadraticCurveTo(width * .24, height * .31, width * .45, height * .61); context.quadraticCurveTo(width * .67, height * .36, width, height * .63); context.lineTo(width, height); context.lineTo(0, height); context.fill();\n  context.fillStyle = '#aedbc9'; context.beginPath(); context.moveTo(0, height * .69); context.quadraticCurveTo(width * .21, height * .51, width * .44, height * .68); context.quadraticCurveTo(width * .72, height * .46, width, height * .65); context.lineTo(width, height); context.lineTo(0, height); context.fill();\n  context.fillStyle = '#cdebe0'; context.fillRect(0, height * .7, width, height * .3);\n  for (let index = 0; index < 11; index++) {\n    const rippleX = ((index * 191 + time * 5) % (width + 100)) - 50;\n    line(rippleX, height * (.74 + (index % 4) * .045), rippleX + 42 + index * 3, height * (.74 + (index % 4) * .045), 2, 'rgba(255,255,255,.35)');\n  }\n}\nfunction drawWorld(state) {\n  const width = artWidth, height = artHeight, time = state.clock || 0;\n  context.clearRect(0, 0, width, height);\n  drawScenery(time);\n  const compact = width < 700;\n  const active = state.screen === 'play' || state.screen === 'check';\n  const cx = compact ? width * .52 : active ? width * .5 : width * .73;\n  const cy = active ? height * .76 : compact ? height * .46 : height * .68;\n  const size = Math.min(width * (compact ? .63 : .30), height * .52);\n  ellipse(cx, cy + size * .19, size * 1.05, size * .28, '#a9cfb5');\n  ellipse(cx, cy + size * .13, size, size * .26, '#d5e7c4');\n  ellipse(cx, cy + size * .07, size * .91, size * .2, '#e9efd4');\n  drawTree(cx - size * .7, cy - size * .1, size * .42);\n  drawTree(cx + size * .72, cy - size * .08, size * .3);\n  if (!active) {\n    rounded(cx - size * .37, cy - size * .39, size * .53, size * .32, size * .025, '#fff9e9');\n    context.fillStyle = '#dfaa88'; context.beginPath(); context.moveTo(cx - size * .43, cy - size * .39); context.lineTo(cx - size * .11, cy - size * .58); context.lineTo(cx + size * .21, cy - size * .39); context.closePath(); context.fill();\n    rounded(cx - size * .12, cy - size * .29, size * .11, size * .2, size * .012, '#9ec6b2');\n    rounded(cx - size * .31, cy - size * .29, size * .12, size * .1, size * .01, '#b4ddd2');\n    ellipse(cx + size * .28, cy + size * .02, size * .31, size * .09, '#a4cfc1');\n    drawPerson(cx + size * .27, cy, size * .6, { time, movement: Math.sin(time * 1.2) * .2 });\n    drawTare(cx + size * .58, cy + size * .08, size * .24, true);\n    for (let index = 0; index < 5; index++) ellipse(cx - size * .6 + index * size * .07, cy + size * .12, 3, 3, index % 2 ? '#f6c888' : '#fff8e5');\n  } else {\n    const activity = state.activity;\n    const lean = activity ? activity.px : 0;\n    const movement = activity ? Math.sin(activity.elapsed * (activity.kind === 'jog' ? 5 : 2)) * .6 : 0;\n    ellipse(cx, cy + size * .05, size * .55, size * .12, '#a5d2bf');\n    drawPerson(cx, cy, size * .95, { time, lean, movement, shirt: state.shirt });\n    drawTare(cx + size * .55, cy + size * .06, size * .22, false);\n    if (activity && activity.kind === 'candle') {\n      rounded(cx - size * .65, cy - size * .14, size * .11, size * .16, 4, '#fffaf0');\n      ellipse(cx - size * .595, cy - size * .16, size * .035, size * (.055 + activity.flame * .06), '#f7c05b');\n    }\n    if (activity && activity.kind === 'hoop') {\n      context.strokeStyle = '#f5ae80'; context.lineWidth = size * .035; context.beginPath(); context.ellipse(cx, cy - size * .35, size * .36, size * .09, -.08, 0, Math.PI * 2); context.stroke();\n    }\n    if (activity && activity.kind === 'tray') {\n      line(cx - size * .38, cy - size * .49, cx + size * .38, cy - size * .49 + lean * size * .1, size * .045, '#bb8b6d');\n      ellipse(cx, cy - size * .52, size * .06, size * .035, '#849e67');\n    }\n  }\n}\n'use strict';\n\nconst GROUPS = {\n  stillness: { name: 'Stillness', color: '#8dc4ad', light: '#e2f2e9', icon: '✳', description: 'A little room to breathe.' },\n  strength: { name: 'Strength', color: '#e8ad8d', light: '#fceadf', icon: '✦', description: 'Find strength without the shouting.' },\n  cardio: { name: 'Cardio', color: '#efc76f', light: '#fff3d1', icon: '♪', description: 'Move to your own very good beat.' },\n  balance: { name: 'Balance', color: '#9fbde0', light: '#e9f1fc', icon: '◇', description: 'A gentle negotiation with gravity.' }\n};\n\nconst ACTIVITIES = [\n  { id: 'stork', name: 'Stork Stand', group: 'stillness', day: 1, seconds: 45, kind: 'hold', icon: '✳', tagline: 'One leg. Many feelings.', instruction: 'Guide your dot into the moving ring and hold it there. Watch out for the gull.', clip: 'standing' },\n  { id: 'sun', name: 'Sun Flow', group: 'stillness', day: 2, seconds: 80, kind: 'breath', icon: '☼', tagline: 'Five poses, one lovely breath.', instruction: 'Stay centered. Hold Space or a trigger as the circle grows; release as it shrinks.', clip: 'yoga' },\n  { id: 'candle', name: 'Quiet Candle', group: 'stillness', day: 3, seconds: 60, kind: 'candle', icon: '♨', tagline: 'Out-still a candle.', instruction: 'Keep your dot steady to help the flame grow. Settle back into the ring to relight it.', clip: 'standing' },\n  { id: 'squat', name: 'Squat Rail', group: 'strength', day: 1, seconds: 60, kind: 'rep', icon: '↕', tagline: 'Down to earth, back again.', instruction: 'Hold Space or a trigger to lower on the beat. Release to rise, and stay balanced.', clip: 'squat' },\n  { id: 'push', name: 'Push-Up', group: 'strength', day: 2, seconds: 60, kind: 'rep', icon: '≋', tagline: 'The floor is very supportive.', instruction: 'Hold Space or a trigger to lower on the beat. Release to press up.', clip: 'pushup' },\n  { id: 'lunge', name: 'Side Lunge', group: 'strength', day: 3, seconds: 60, kind: 'rep', icon: '↔', tagline: 'A step in the right direction. Or left.', instruction: 'Lean toward the highlighted side and hold Space on the beat, then release.', clip: 'lunge' },\n  { id: 'step', name: 'Step Class', group: 'cardio', day: 1, seconds: 60, kind: 'step', icon: '♪', tagline: 'Meet the beat where it is.', instruction: 'Press the arrow or WASD matching each arriving arrow. A good rhythm is better than a perfect one.', clip: 'walk' },\n  { id: 'hoop', name: 'Hoop Hips', group: 'cardio', day: 2, seconds: 60, kind: 'hoop', icon: '◎', tagline: 'A well-rounded workout.', instruction: 'Circle your lean to spin the hoop. Tap Q or E to catch a hoop tossed from that side.', clip: 'standing' },\n  { id: 'jog', name: 'Coastal Jog', group: 'cardio', day: 3, seconds: 70, kind: 'jog', icon: '➜', tagline: 'The scenic route is the point.', instruction: 'Alternate J and K, or the triggers, to jog. Lean to steer around the cups.', clip: 'run' },\n  { id: 'slalom', name: 'Slalom', group: 'balance', day: 3, seconds: 60, kind: 'slalom', icon: '⚑', tagline: 'A very polite downhill.', instruction: 'Lean left or right through the gates. Lean forward to speed up, back to slow down.', clip: 'standing' },\n  { id: 'tray', name: 'Tray Service', group: 'balance', day: 1, seconds: 60, kind: 'tray', icon: '◌', tagline: 'Keep your olives to yourself.', instruction: 'Keep the tray level as you walk. The olives would prefer not to become airborne.', clip: 'walk' },\n  { id: 'laundry', name: 'Laundry Line', group: 'balance', day: 2, seconds: 60, kind: 'rope', icon: '⌁', tagline: 'A fine line between socks.', instruction: 'Balance over the line, lean forward to walk, and collect the fluttering pegs.', clip: 'walk' }\n];\n\nconst DAY_INTROS = [\n  'Welcome to the Institute for Gentle Improvement. We have been expecting you, in a very relaxed way.',\n  'A new morning. The island has prepared absolutely no urgent emails.',\n  'The sea is calm. Dennis is less calm, but is working on it.',\n  'You have made space for yourself. The advanced mats have made space for you.',\n  'It is the Gentle Games! Participation is mandatory only for the gulls.'\n];\n\nconst CAST = [\n  ['Gertrude', 'I used to be competitive. Now I am competitively relaxed.'],\n  ['Dennis', 'I brought a towel in case of a personal breakthrough.'],\n  ['Marisol', 'A wobble is just your body writing in cursive.'],\n  ['Young Kevin', 'I am called Young Kevin because the other Kevin has tenure.']\n];\n\nconst COLORS = ['#d98a68', '#e8b28d', '#8c573f', '#f1ccad', '#b87956', '#704638'];\nconst OUTFITS = ['#e98d78', '#79b9ac', '#e7b961', '#9b9dd1', '#638ca5', '#d77f9c'];\nconst clamp = (number, min, max) => Math.max(min, Math.min(max, number));\nconst escapeHTML = value => String(value).replace(/[&<>\"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[character]);\n\nfunction seeded(seed) {\n  let state = seed >>> 0 || 1;\n  return () => { state ^= state << 13; state ^= state >>> 17; state ^= state << 5; return (state >>> 0) / 4294967296; };\n}\nSOURCE: Wii Fit\n\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\n\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\n\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\n\nResearch: Whether and how much to research is your choice.\n\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-221356].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\n\nTech Stack: Build on https://github.com/michaelcrosato/my-3d2dge/tree/main/dist/handoff. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\n\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\n\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\n\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\n\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\n\nWorking Environment and deliverable:\nCreate a subfolder called [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-221356] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-221356].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\n\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\n\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\n\nEffort: Spend effort however you see fit.\n\n## This computer\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\n\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software-rendered, when started with --enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader), Firefox 155.0 (WebGL 2, software-rendered), WebKit 26.6 (WebGL 2) already downloaded. Phone and tablet device profiles are built in.\n  WebGPU only works on a secure page: file:// or http://127.0.0.1. A WebGPU canvas can come out blank in a headless screenshot, so check the game's state instead.\n  For Node, `npm install playwright@1.63.0` in your folder uses the browsers already downloaded; another version downloads its own.\n  Playwright runs here with PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 (already set for runs): this OS isn't one it supports by name.\n- **Tools:** node 24.22.1, npm 11.19.1, python3 3.14.8, pip3 26.2.1, git 2.56.0, gh 2.46.0, curl 8.22.0, wget 1.25.0, jq 1.8.1, ffmpeg 9.0.2, ffprobe 9.0.2, sqlite3 3.53.4, zip 3.0, unzip 6.00, rustc 1.99.0, cargo 1.99.0, go 1.27.1, java 27, lighthouse 13.5.0, shot-scraper 1.12, xvfb-run, magick 7.1.2, esbuild 0.28.2, uv 0.12.23, tsc 7.0.2, wasm-bindgen 0.2.129.\n- **Rust:** rustup's toolchains 1.96.0, 1.98.1, stable; the wasm32-unknown-unknown target on 1.98.1.\n- **Not installed:** sox, bun, deno.\n- **Network:** internet works (github.com, registry.npmjs.org).\n- **Memory:** earlyoom is on: when memory runs out it ends the biggest browser, so \"Target closed\", \"page crashed\" or \"browser has been closed\" means memory ran out, not a bug in your game. Run fewer browsers at once rather than retrying.\n\n### What this computer doesn't have\n\nNo script can check these, so they're written by hand. Test with the stand-ins; anything that needs the real thing is checked as far as it can be here, never required.\n\n- **No physical controller.** Emulate one: replace navigator.getGamepads with a stub that returns a pad in the standard mapping (Playwright's add_init_script / addInitScript).\n- **No touch device.** Use Playwright's phone and tablet profiles, which have touch, and tap with page.touchscreen.\n- **Nobody to listen.** Check sound by what Web Audio produces: render it with an OfflineAudioContext, or read levels from an AnalyserNode.\n- **No second player.** Play multiplayer with two browser pages (or contexts) on this computer.\n- **No real iPhone or iPad.** WebKit with an iPhone profile is the closest; it isn't iOS Safari.\n- **No TV.** Judge the 10-foot view from screenshots at 1920×1080.\n\n### Sharing this computer\n\n- Other agents run here at the same time. Keep one or two browsers open at once, and close them when you're done.\n- Keep every file you make inside your own folder, not /tmp or a parent folder: /tmp is shared.\n- The browsers are already downloaded: don't run `playwright install` or `playwright install-deps`.\n- The system Python has Playwright and nothing else. For one (Pillow, numpy …), use uv: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` when the script drives a browser too (a newer Playwright can't find the browsers here).\n\n## Goal\n\nBuild an original game inspired by the source.\n\nScope\n\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\n\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\n\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game.\n\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\n\nNarrative tone: Use a writing style similar to the source’s.\n\n## UI & UX: 10-Foot Controller-First Philosophy\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\n\nDo not use overly dense, web-style data screens.\n\nTouch-only devices: no touch controls; show \"Controller or keyboard required\" and the settings button. Let the attract mode run.\n\n## Done\nNo TODOs, placeholders, or stubbed features. The demo is complete.\n\n## Source Information\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \"unknown\" for anything you can't confirm.\n- Date: 2026-11-04 22:13:56\n- Source: the work it's based on\n- Plan: the file name of the plan you were given to build from, or none\n- Genre and Perspective: genre and camera perspective used\n- Tech: stack, libraries/engines, with versions if applicable\n- Art Direction: style used\n- Animation: system used\n- Audio: music, sound effects and voice used\n- Online: network features used, or none\n- Testing: testing parameters allowed\n- Research: research done, or none\n- Environment: Codex CLI (headless); Linux\n- Model: OpenAI, gpt-6.1-terra, reasoning effort max\n- Usage: write \"added on import\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\n\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\"unknown\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\n{\n  \"sourceInformation\": {\"date\": \"\", \"source\": \"\", \"plan\": \"\", \"genre\": \"\", \"perspective\": \"\", \"tech\": \"\", \"artDirection\": \"\", \"animation\": \"\", \"audio\": \"\", \"online\": \"\", \"testing\": \"\", \"research\": \"\", \"environment\": \"\", \"model\": \"\", \"usage\": \"added on import\"},\n  \"testingFeedback\": [\"your answer to each Testing Feedback question, in order\"],\n  \"engineFeedback\": [\"your answer to each Engine Feedback question, in order\"],\n  \"promptFeedback\": [\"your answer to each Prompt Feedback question, in order\"],\n  \"aiHub\": {\n    \"name\": \"the game's title, as on its title screen\",\n    \"tagline\": \"a few words to go under the title\",\n    \"description\": \"one or two sentences for the catalogue\",\n    \"type\": \"Game, Tech demo or Tool\",\n    \"genre\": \"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\",\n    \"source\": \"the work it's based on, e.g. Moby-Dick\",\n    \"series\": \"its franchise, e.g. Star Fox, or empty\",\n    \"players\": \"how many can play: 1, 1–2 or 1–4\",\n    \"controls\": \"the controls, in one line\",\n    \"tags\": [\"3 to 6 lowercase tags, e.g. 2d, 3d, arcade, story, co-op, versus, first-person, third-person, top-down, side-scrolling, pixel art, low-poly, retro, sci-fi, fantasy, comedy, vehicles, boss fights, exploration\"]\n  }\n}\nThe catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\n\nTesting Feedback\n\n- How many issues did testing catch?\n- How many would be considered critical issues / game breaking?\n- What was the most helpful test you ran?\n- What was the least helpful test you ran?\n\nEngine Feedback\n\n- What did you like most about the engine?\n- Did you get stuck or guess wrong?\n- What was the most important thing you had to build yourself?\n- What was the hardest part about using the engine?\n- What did you change in the engine, and why? (none if nothing)\n- If you could change one thing about the engine, what would it be?\n\nPrompt Feedback\n\n- What did you like most about this prompt?\n- What was confusing?\n- What was the hardest thing to do?\n- What would you change in this prompt?\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_330","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; sed -n '65,145p' \\\"\"'$D/src/game.js\"; sed -n '\"'145,235p' \\\"\"'$D/src/game.js\"; sed -n '\"'255,380p' \\\"\"'$D/src/game.js\"; sed -n '\"'1,150p' \\\"\"'$D/src/art.js\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_330","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; sed -n '65,145p' \\\"\"'$D/src/game.js\"; sed -n '\"'145,235p' \\\"\"'$D/src/game.js\"; sed -n '\"'255,380p' \\\"\"'$D/src/game.js\"; sed -n '\"'1,150p' \\\"\"'$D/src/art.js\"'","aggregated_output":"  const info = window.BUILD_INFO || {}, sections = [ ['Source Information', info.sourceInformation], ['Testing Feedback', info.testingFeedback], ['Engine Feedback', info.engineFeedback], ['Prompt Feedback', info.promptFeedback] ];\n  return sections.map(([title, value]) => `<div class=\"about-group\"><h3>${title}</h3>${Array.isArray(value) ? value.map((item, index) => `<p><b>${index + 1}.</b> ${escapeHTML(item)}</p>`).join('') : Object.entries(value || {}).map(([key, item]) => `<p><b>${escapeHTML(key)}:</b> ${escapeHTML(item)}</p>`).join('')}</div>`).join('');\n}\nfunction render() {\n  const member = person();\n  let content = '', heading = '';\n  if (state.screen === 'title' || state.screen === 'attract') {\n    content = `<main class=\"hero\"><section class=\"hero-copy\"><div class=\"eyebrow\"><span class=\"sun-dot\">✳</span> A LITTLE ISLAND FOR YOURSELF</div><h1 class=\"logo\">wee bit<br><em>of zen</em><span class=\"logo-dot\">.</span></h1><p class=\"lede\">A pleasantly imperfect retreat for<br>your body, mind, and general wobble.</p><div class=\"menu-stack\">${button('Begin your stay', 'slots', true, '', 'A little time just for you')}${button('Local Class', 'class', false, '', 'Practice together, up to four')}${button('About & credits', 'about')}</div></section><div class=\"island-message\"><span>✦ &nbsp; TAKE IT AT YOUR OWN PACE</span><strong>Good things happen<br>one wobble at a time.</strong></div></main>`;\n    if (state.screen === 'attract') content += '<div class=\"center-copy\">DEMONSTRATION &nbsp; · &nbsp; PRESS ANY KEY</div>';\n  } else if (state.screen === 'slots') {\n    heading = 'YOUR STAY';\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; THE GUEST BOOK</div><h1>Make yourself at home.</h1><p>Choose a room for your island stay.</p></div></div><div class=\"card-grid\">${state.slots.map((slot, index) => `<button class=\"card slot-card\" data-action=\"slot\" data-id=\"${index}\"><span class=\"slot-num\">0${index + 1}</span><span class=\"slot-avatar\">${slot ? '☺' : '+'}</span><strong>${slot ? escapeHTML(slot.name) : 'New member'}</strong><small>${slot ? `${slot.finished ? 'Free practice' : `Day ${slot.day}`} · ${Math.floor(slot.minutes || 0)} fit minutes` : 'A fresh start awaits'}</small><span class=\"arrow\">↗</span></button>`).join('')}</div><div class=\"actions\">${button('Back', 'home')}</div></main>`;\n  } else if (state.screen === 'setup') {\n    heading = 'NEW MEMBER';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; NICE TO MEET YOU</div><h1>A little about you.</h1><p>There is no wrong way to arrive.</p></div></div><div class=\"card setup-card\"><label class=\"field\">WHAT SHOULD WE CALL YOU?<input id=\"nickname\" maxlength=\"16\" value=\"${escapeHTML(member.name === 'Guest' ? '' : member.name)}\" placeholder=\"Your name\" autocomplete=\"off\"></label><p class=\"field-label\">CHOOSE YOUR COLOUR</p><div class=\"options\">${OUTFITS.map((color, index) => `<button class=\"option swatch ${member.outfit === index ? 'selected' : ''}\" data-action=\"outfit\" data-id=\"${index}\" style=\"--swatch:${color}\" aria-label=\"Outfit ${index + 1}\">${member.outfit === index ? '✓' : ''}</button>`).join('')}</div><p class=\"field-label\">YOUR INSTRUCTOR</p><div class=\"options\">${['Birch', 'Alder'].map(name => `<button class=\"option ${member.instructor === name ? 'selected' : ''}\" data-action=\"instructor\" data-id=\"${name}\">${name === 'Birch' ? '✳' : '✦'} &nbsp; ${name}</button>`).join('')}</div><div class=\"actions\">${button('Back', 'slots')}${button('Arrive on the island', 'create-member', true)}</div></div></main>`;\n  } else if (state.screen === 'intro') {\n    heading = labelDay();\n    content = `<main class=\"main-wrap narrow\"><div class=\"dialogue card\"><div class=\"eyebrow\">✳ &nbsp; A NOTE FROM TARE</div><div class=\"speaker\">☺</div><h1>Welcome${member.day === 1 ? ', ' + escapeHTML(member.name) : ' back'}.</h1><p>“${DAY_INTROS[Math.min(4, member.day - 1)]}”</p><p class=\"note\">Your stay starts with a gentle body check. No weights, no judgement, and absolutely no pop quizzes. Well, one tiny quiz.</p><div class=\"actions\">${button('Begin body check', 'check', true)}</div></div></main>`;\n  } else if (state.screen === 'check') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">✳ &nbsp; BODY CHECK</div><h2>Just checking in.</h2><p id=\"check-text\">Find a comfortable center.</p></div><div class=\"hud-box timer\" id=\"check-timer\">05</div></div><div class=\"hud-bottom\"><div class=\"play-instruction\">${state.check?.phase === 'lean' ? 'Lean in each direction: ← ↑ → ↓' : 'Stay steady. Small wobbles are welcome.'}</div><div class=\"meter\"><span id=\"check-progress\"></span></div></div></main>`;\n  } else if (state.screen === 'question') {\n    heading = 'BODY CHECK';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ONE VERY SCIENTIFIC QUESTION</div><h1>How are you arriving today?</h1><p>Your answer helps us calibrate the island's extremely sophisticated vibes.</p><div class=\"menu-stack\">${button('Bright-eyed and bushy-tailed', 'question-answer', true, 'bright')}${button('A little wobbly, honestly', 'question-answer', false, 'wobbly')}${button('Mostly thinking about snacks', 'question-answer', false, 'snacks')}</div></div></main>`;\n  } else if (state.screen === 'check-result') {\n    heading = 'BODY CHECK COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ACCORDING TO TARE</div><div class=\"score-big\">${state.check.spine}</div><h1>Your Spine Age</h1><p>“A completely imaginary number. Your actual spine remains splendid.”</p><p class=\"note\">Today is a fine day to practice being here.</p><div class=\"actions\">${button('Explore the island', 'island', true)}</div></div></main>`;\n  } else if (state.screen === 'island') {\n    heading = labelDay();\n    const dialogue = CAST[(member.day + member.sessions) % CAST.length];\n    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of movement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished ? 'ending' : 'sleep', true)}</div></div></main>`;\n  } else if (state.screen === 'activity') {\n    const activity = state.selection, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>How to play</h3><p>${activity.instruction}</p><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle mode is on.' : 'Make small, comfortable movements.'}</p><div class=\"actions\">${button('Back to island', state.classMode ? 'class' : 'island')}${button('Begin practice', 'start-activity', true)}</div></div></main>`;\n  } else if (state.screen === 'play') {\n    const activity = state.activity, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your center.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"play-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span id=\"play-progress\"></span></div><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE START</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\n  } else if (state.screen === 'result') {\n    const result = state.result;\n    heading = 'SESSION COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue result-card\"><div class=\"eyebrow\">✳ &nbsp; PRACTICE COMPLETE</div><div class=\"stars-big\">${'★'.repeat(result.stars)}<span>${'☆'.repeat(3 - result.stars)}</span></div><h1>Lovely work${state.classMode ? ', everyone' : ''}.</h1><p>“${result.message}”</p><div class=\"result-stats\"><div><strong>${result.percent}%</strong><small>STEADINESS</small></div><div><strong>+${result.minutes}</strong><small>FIT MINUTES</small></div><div><strong>${result.stumbles}</strong><small>WOBBLES</small></div></div><div class=\"actions\">${button('Practice again', 'retry')}${button(state.festival ? 'Continue the Games' : state.classMode ? 'Class results' : 'Back to island', 'result-continue', true)}</div></div></main>`;\n  } else if (state.screen === 'recap') {\n    heading = 'DAY COMPLETE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ANOTHER DAY WELL SPENT</div><h1>Rest is part of it.</h1><p>“${member.sessions} sessions today. Gerald the ceramic hippo has made a careful note.”</p><div class=\"result-stats\"><div><strong>${Math.floor(member.minutes)}</strong><small>FIT MINUTES</small></div><div><strong>${Object.keys(member.stars || {}).length}</strong><small>MATS VISITED</small></div></div><div class=\"actions\">${button('Wake up to day ' + (member.day + 1), 'next-day', true)}</div></div></main>`;\n  } else if (state.screen === 'festival') {\n    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Three friendly challenges, ending in the Grand Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"actions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n  } else if (state.screen === 'ending') {\n    heading = 'THANK YOU FOR STAYING';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little steadier.<br><em>A lot more you.</em></h1><p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for five days of moving, breathing, and making room. The mats are yours whenever you wish.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits', 'about')}</div></div></main>`;\n  } else if (state.screen === 'class') {\n    heading = 'LOCAL CLASS';\n    const players = state.classPlayers;\n    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect controllers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHTML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ? 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selection?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.name === 'Guest' ? 'home' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n  } else if (state.screen === 'class-result') {\n    heading = 'LOCAL CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\n  } else if (state.screen === 'settings') {\n    heading = 'SETTINGS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card settings-card\">${settingRow('Music', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${settingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.tips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n  } else if (state.screen === 'pause') {\n    heading = 'PAUSED';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', true)}${button('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', 'leave-play')}</div></div></main>`;\n  } else if (state.screen === 'dev') {\n    heading = 'DEVELOPER MODE';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the wobble.</h1>${[['spring','Spring',4,20,.5],['damping','Damping',1,12,.5],['instability','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output id=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"actions\">${button('Reset tuning', 'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n  } else if (state.screen === 'about') {\n    heading = 'ABOUT & CREDITS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card scroll\"><div class=\"eyebrow\">✳ &nbsp; A LITTLE NOTE FROM THE MAKERS</div><h1>About & credits.</h1><p>Made with care for everyone who has ever wobbled.</p>${aboutContent()}<div class=\"actions\">${button('Back', 'about-back', true)}</div></div></main>`;\n  } else if (state.screen === 'hub') {\n    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A little steadiness, shared.'}</h1><p>${state.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; everyone gets a moment to breathe.'}</p><div class=\"result-stats\"><div><strong>${Math.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.started ? 'The class is underway.' : 'Waiting for the other guests…'}</p></div></main>`;\n  }\n  app.innerHTML = shell(content, heading, state.screen !== 'play' && state.screen !== 'check');\n  enhanceModes();\n  if (state.screen === 'play') updateHUD();\n  if (state.screen === 'check') updateCheckHUD();\n  const touchOnly = matchMedia('(pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n  if (touchOnly && !['settings','about'].includes(state.screen)) {\n    const notice = document.createElement('div'); notice.className = 'touch-notice'; notice.innerHTML = '<div><span>✳</span><h2>Controller or keyboard required</h2><p>Connect a controller or keyboard to enjoy the island.</p><button class=\"action primary\" data-action=\"settings\">Settings <span class=\"arrow\">↗</span></button></div>'; app.appendChild(notice);\n  }\n  }\n}\nfunction currentButtons() { return [...app.querySelectorAll('button:not([disabled])')].filter(node => node.offsetParent !== null && !node.closest('.touch-notice')); }\nfunction focusMove(direction) {\n  const buttons = currentButtons(); if (!buttons.length) return;\n  const index = buttons.indexOf(document.activeElement); buttons[(index + direction + buttons.length) % buttons.length].focus();\n}\nfunction memberDefault() { return { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\nfunction beginCheck() { state.check = { phase: 'still', elapsed: 0, directions: new Set(), spine: 25 + Math.floor(Math.random() * 25) }; state.activity = null; screen('check'); }\nfunction startActivity(activity, options = {}) {\n  const selected = { ...activity }, duration = options.seconds || selected.seconds;\n  state.selection = selected;\n  state.activity = { ...selected, seconds: duration, elapsed: 0, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, ringX: 0, ringY: 0, flame: .6, score: 0, samples: 0, stumbles: 0, stun: 0, effort: 0, reps: 0, beatHits: 0, lastBeat: -1, lastJog: '', jogHits: 0, hoopHits: 0, good: 0, tray: 0, lastDirection: 0, motions: 0, rng: seeded(841 + selected.name.length) };\n  if (state.classMode && !state.hub.active) prepareClass();\n  mouseLean = null; keys.clear(); toggledBreath = false; screen('play');\n}\nfunction completeActivity() {\n  const activity = state.activity;\n  if (!activity) return;\n  const percent = Math.round(clamp(activity.score / Math.max(1, activity.samples) * 100, 0, 100));\n  const stars = percent >= 90 ? 3 : percent >= 65 ? 2 : percent >= 35 ? 1 : 0;\n  const minutes = Math.max(1, Math.round(activity.seconds / 60 * (1 + stars * .25)));\n  state.result = { percent, stars, minutes, stumbles: activity.stumbles, message: stars >= 2 ? 'You made the wobble look rather elegant.' : 'A little practice is still a lovely thing.' };\n  if (!state.hub.active && !state.classMode) { const member = state.member; member.sessions = (member.sessions || 0) + 1; member.minutes = (member.minutes || 0) + minutes; member.stars[activity.id] = Math.max(member.stars[activity.id] || 0, stars); save(); }\n  tone(523, .3); if (state.hub.active) { finishHubEvent(); screen('hub'); } else if (state.classMode) screen('class-result'); else screen('result');\n}\nfunction attemptInput(key) {\n  const activity = state.activity;\n  if (!activity || state.screen !== 'play') return;\n  if (activity.kind === 'step') {\n    const directions = ['arrowleft','arrowup','arrowright','arrowdown'];\n    const aliases = { a:'arrowleft', w:'arrowup', d:'arrowright', s:'arrowdown' };\n    const direction = aliases[key] || key, beat = Math.round(activity.elapsed * 100 / 60), phase = Math.abs(activity.elapsed * 100 / 60 - beat);\n    if (direction === directions[(beat + 4) % 4] && phase < .34 && beat !== activity.lastBeat) { activity.beatHits++; activity.lastBeat = beat; tone(520, .08, .35); }\n  }\n  if (activity.kind === 'jog' && (key === 'j' || key === 'k') && key !== activity.lastJog) { activity.lastJog = key; activity.jogHits++; }\n  if (activity.kind === 'hoop' && (key === 'q' || key === 'e')) { activity.hoopHits++; tone(660, .1, .3); }\n  if ((key === ' ' || key === 'enter') && state.settings.breathToggle) toggledBreath = !toggledBreath;\n}\nconst tuningDefaults = { spring: 11, damping: 6, instability: 1.3, noise: .19 };\nconst tuning = { ...tuningDefaults };\nfunction updateActivity(dt) {\n  const activity = state.activity; if (!activity) return;\n  activity.elapsed += dt;\n  const pad = Array.from(navigator.getGamepads?.() || []).find(candidate => candidate && !state.classActors?.some(actor => actor.player.padIndex === candidate.index)), axisX = pad && Math.abs(pad.axes[0]) > .12 ? pad.axes[0] : 0, axisY = pad && Math.abs(pad.axes[1]) > .12 ? pad.axes[1] : 0;\n  const dx = (keys.has('arrowright') || keys.has('d') ? 1 : 0) - (keys.has('arrowleft') || keys.has('a') ? 1 : 0);\n  const dy = (keys.has('arrowdown') || keys.has('s') ? 1 : 0) - (keys.has('arrowup') || keys.has('w') ? 1 : 0);\n  if (activity.stun <= 0) {\n    if (mouseLean) { activity.ux = mouseLean.x; activity.uy = mouseLean.y; }\n    else if (axisX || axisY) { activity.ux = axisX; activity.uy = axisY; }\n    else { activity.ux = clamp(activity.ux + dx * 2.2 * dt, -1, 1); activity.uy = clamp(activity.uy + dy * 2.2 * dt, -1, 1); if (!dx) activity.ux *= Math.max(0, 1 - .5 * dt); if (!dy) activity.uy *= Math.max(0, 1 - .5 * dt); }\n  } else activity.stun -= dt;\n  const gentle = state.settings.gentle ? .7 : 1, time = activity.elapsed, disturbance = tuning.noise * gentle;\n  const ax = tuning.spring * (activity.ux - activity.px) - tuning.damping * activity.vx + tuning.instability * gentle * activity.px + disturbance * (Math.sin(time * 1.7) + .5 * Math.sin(time * 3.23));\n  const ay = tuning.spring * (activity.uy - activity.py) - tuning.damping * activity.vy + tuning.instability * gentle * activity.py + disturbance * (Math.sin(time * 1.19 + 1) + .5 * Math.sin(time * 2.71));\n  activity.vx += ax * dt; activity.vy += ay * dt; activity.px += activity.vx * dt; activity.py += activity.vy * dt;\n  if (Math.hypot(activity.px, activity.py) >= 1 && activity.stun <= 0) { activity.stumbles++; activity.stun = 1; activity.px *= .5; activity.py *= .5; activity.vx *= -.2; activity.vy *= -.2; tone(196, .18); }\n  const phase = Math.floor(time / 12), rng = seeded(phase * 667 + 43);\n  activity.ringX = activity.id === 'stork' ? (rng() - .5) * .65 : activity.kind === 'slalom' ? Math.sin(time * .55) * .46 : 0;\n  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n  let quality = steadiness;\n  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n  activity.score += quality; activity.samples++;\n  if (state.classMode && !state.hub.active) updateClass(dt);\n  if (state.hub.active) {\n    const now = window.AIHub.time();\n    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n  }\n  if (!state.hub.active && activity.elapsed >= activity.seconds) completeActivity();\n}\nfunction updateHUD() {\n  const activity = state.activity; if (!activity) return;\n  const timer = document.getElementById('play-timer'), status = document.getElementById('play-status'), instruction = document.getElementById('play-instruction'), progress = document.getElementById('play-progress'), dot = document.getElementById('plate-dot'), ring = document.getElementById('plate-ring'), score = document.getElementById('play-score');\n  if (!timer) return;\n  timer.textContent = Math.max(0, Math.ceil(activity.seconds - activity.elapsed));\n  if (activity.kind === 'step') { const arrows = ['←','↑','→','↓']; const beat = Math.round(activity.elapsed * 100 / 60); status.textContent = `NEXT STEP  ${arrows[(beat + 4) % 4]}   ·   ${activity.beatHits} on beat`; instruction.textContent = `Press ${arrows[(beat + 4) % 4]} on the beat · ${activity.instruction}`; }\n  else if (activity.kind === 'rep') status.textContent = `Rep ${activity.reps + 1} · ${Math.sin(activity.elapsed * Math.PI / 2 - Math.PI / 2) > 0 ? 'Rise gently' : 'Lower gently'}`;\n  else if (activity.kind === 'breath') status.textContent = Math.sin(activity.elapsed * Math.PI / 4) > 0 ? 'Breathe in · hold' : 'Breathe out · release';\n  if (state.screen === 'title') { state.idle += dt; if (state.idle >= 10 && !state.hub.active) screen('attract'); }\n  if (state.screen === 'check') { state.check.elapsed += dt; if (state.check.phase === 'still' && state.check.elapsed >= 5) { state.check.phase = 'lean'; state.check.elapsed = 0; } if (state.check.phase === 'lean' && (state.check.directions.size === 4 || state.check.elapsed >= 14)) screen('question'); }\n  if (state.screen === 'play') updateActivity(dt);\n}\nfunction action(name, id) {\n  unlockAudio(); state.idle = 0; tone(440, .07, .2);\n  switch (name) {\n    case 'home': if (!state.hub.active) { state.classMode = false; screen('title'); } break;\n    case 'slots': screen('slots'); break;\n    case 'slot': state.slot = Number(id); state.member = state.slots[state.slot] || memberDefault(); state.classMode = false; screen(state.slots[state.slot] ? 'island' : 'setup'); break;\n    case 'outfit': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.outfit = Number(id); render(); break;\n    case 'instructor': state.member.name = document.getElementById('nickname')?.value || state.member.name; state.member.instructor = id; render(); break;\n    case 'create-member': { const value = document.getElementById('nickname')?.value.trim(); state.member.name = (value || 'Guest').slice(0, 16); save(); screen('intro'); break; }\n    case 'check': beginCheck(); break;\n    case 'question-answer': state.check.answer = id; screen('check-result'); break;\n    case 'island': state.classMode = false; screen('island'); break;\n    case 'select-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); state.classMode = false; screen('activity'); break;\n    case 'locked': notify('A new mat opens on a later day.'); break;\n    case 'start-activity': startActivity(state.selection); break;\n    case 'retry': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n    case 'result-continue': if (state.festival) { state.festivalIndex++; if (state.festivalIndex >= 3) { state.festival = false; state.member.finished = true; save(); screen('ending'); } else screen('festival'); } else if (state.classMode) screen('class-result'); else screen('island'); break;\n    case 'sleep': if (memberDefault && state.member.sessions < 3) notify('Try three sessions before calling it a day.'); else if (state.member.day === 5) { state.festival = true; state.festivalIndex = 0; screen('festival'); } else screen('recap'); break;\n    case 'next-day': state.member.day = Math.min(5, state.member.day + 1); state.member.sessions = 0; save(); screen('intro'); break;\n    case 'festival-start': startActivity(ACTIVITIES.find(activity => activity.id === ['stork','slalom','candle'][state.festivalIndex]), { seconds: 30 }); break;\n    case 'ending': screen('ending'); break;\n    case 'free-play': state.member.finished = true; save(); screen('island'); break;\n    case 'class': state.classMode = true; if (!state.classPlayers.length) state.classPlayers = [{ name: state.member?.name || 'Player 1', type: 'Keyboard / pad', source: 'primary' }, { name: 'Gertrude', type: 'Bot', source: 'bot' }]; if (!CLASS_IDS.includes(state.selection?.id)) state.selection = ACTIVITIES[0]; screen('class'); break;\n    case 'class-toggle': { const index = Number(id); if (index === 0) break; const current = state.classPlayers[index]; state.classPlayers[index] = !current ? { name: ['Player 1','Gertrude','Dennis','Marisol'][index], type: 'Bot', source: 'bot' } : index === 1 && current.source === 'bot' ? { name: 'Player 2', type: 'Keyboard 2', source: 'keyboard' } : null; render(); break; }\n    case 'class-activity': state.selection = ACTIVITIES.find(activity => activity.id === id); render(); break;\n    case 'start-class': state.classPlayers = state.classPlayers.filter(Boolean); if (state.classPlayers.length < 2) { notify('Add at least one friend or bot.'); break; } startActivity(state.selection, { seconds: 35 }); break;\n    case 'hub-ready': window.AIHub.answer('ready'); notify('Ready to go!'); break;\n    case 'hub-more': window.AIHub.answer('more'); notify('Waiting for more players.'); break;\n    case 'settings': state.returnScreen = state.screen; screen('settings'); break;\n    case 'settings-back': save(); screen(state.returnScreen || 'title'); break;\n    case 'toggle': state.settings[id] = !state.settings[id]; save(); render(); break;\n    case 'volume': state.settings[id] = state.settings[id] >= 100 ? 0 : state.settings[id] + 10; save(); render(); break;\n    case 'glyphs': state.settings.glyphs = state.settings.glyphs === 'Xbox' ? 'PlayStation' : 'Xbox'; save(); render(); break;\n    case 'pause': pausedFrom = state.screen === 'play' ? 'play' : pausedFrom; screen('pause'); break;\n    case 'resume': screen(pausedFrom || 'play'); break;\n    case 'restart': startActivity(state.selection, { seconds: state.classMode ? 35 : state.festival ? 30 : undefined }); break;\n    case 'leave-play': state.festival = false; state.classMode ? screen('class') : screen('island'); break;\n    case 'dev': screen('dev'); break;\n    case 'reset-tuning': Object.assign(tuning, tuningDefaults); render(); break;\n    case 'about': state.aboutReturn = state.screen; screen('about'); break;\n    case 'about-back': screen(state.aboutReturn || 'title'); break;\n  }\n}\napp.addEventListener('click', event => { const target = event.target.closest('[data-action]'); if (target) action(target.dataset.action, target.dataset.id); });\napp.addEventListener('mouseover', event => { const target = event.target.closest('button'); if (target && state.input !== 'gamepad') target.focus({ preventScroll: true }); });\napp.addEventListener('input', event => { const key = event.target.dataset.tuning; if (key) { tuning[key] = Number(event.target.value); document.getElementById(`out-${key}`).value = tuning[key]; } });\nwindow.addEventListener('keydown', event => {\n  if (event.repeat && event.key !== ' ') return;\n  state.input = 'keyboard'; state.idle = 0; const key = event.key.toLowerCase();\n  if (state.screen === 'attract') { event.preventDefault(); screen('title'); return; }\n  if (event.target instanceof HTMLInputElement && event.target.type === 'text') { if (key === 'enter') { event.preventDefault(); action('create-member'); } return; }\n  if (['arrowup','arrowdown','arrowleft','arrowright',' '].includes(key)) event.preventDefault();\n  keys.add(key); unlockAudio();\n  if (state.screen === 'check' && state.check.phase === 'lean') { const mapping = { a:'left', arrowleft:'left', w:'up', arrowup:'up', d:'right', arrowright:'right', s:'down', arrowdown:'down' }; if (mapping[key]) state.check.directions.add(mapping[key]); return; }\n  if (state.screen === 'play') { if (key === 'escape') action('pause'); else attemptInput(key); return; }\n  if (key === 'escape' || key === 'backspace') { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (state.screen === 'dev') screen('pause'); else if (state.screen === 'activity') action('island'); else if (state.screen === 'slots' || state.screen === 'class') action('home'); return; }\n  if (key === 'arrowdown' || key === 's') focusMove(1); else if (key === 'arrowup' || key === 'w') focusMove(-1); else if ((key === 'enter' || key === ' ') && document.activeElement?.tagName !== 'BUTTON') { const buttons = currentButtons(); if (buttons.length) buttons[0].focus(); }\n});\nwindow.addEventListener('keyup', event => keys.delete(event.key.toLowerCase()));\nwindow.addEventListener('blur', () => { keys.clear(); if (state.screen === 'play' && !state.hub.active) action('pause'); });\nwindow.addEventListener('mousemove', event => { if (state.screen !== 'play' || event.buttons === 0) return; state.input = 'mouse'; mouseLean = { x: clamp((event.clientX - innerWidth / 2) / (innerHeight * .33), -1, 1), y: clamp((event.clientY - innerHeight / 2) / (innerHeight * .33), -1, 1) }; });\nwindow.addEventListener('mousedown', event => { if (state.screen === 'play' && event.button === 0) keys.add(' '); });\nwindow.addEventListener('mouseup', () => keys.delete(' '));\nfunction pollGamepad() {\n  const pads = Array.from(navigator.getGamepads?.() || []);\n  for (const pad of pads) {\n    if (!pad) continue;\n    const previous = gamepadPrevious[pad.index] || [];\n    pad.buttons.forEach((item, index) => {\n      if (item.pressed && !previous[index]) {\n        state.input = 'gamepad'; state.idle = 0; unlockAudio();\n        if (state.screen === 'attract') screen('title');\n        else if (state.screen === 'play') { if (index === 9) action('pause'); else if (index === 4 || index === 5) attemptInput(index === 4 ? 'q' : 'e'); else if (index === 6 || index === 7) attemptInput(index === 6 ? 'j' : 'k'); }\n        else if (state.screen === 'check' && state.check.phase === 'lean') { if (index === 12) state.check.directions.add('up'); if (index === 13) state.check.directions.add('down'); if (index === 14) state.check.directions.add('left'); if (index === 15) state.check.directions.add('right'); }\n        else if (index === 0) { const selected = document.activeElement; if (selected?.tagName === 'BUTTON') selected.click(); else currentButtons()[0]?.focus(); }\n        else if (index === 1) { if (state.screen === 'settings') action('settings-back'); else if (state.screen === 'pause') action('resume'); else if (state.screen === 'about') action('about-back'); else if (!state.hub.active) action('home'); }\n        else if (index === 12) focusMove(-1); else if (index === 13) focusMove(1);\n      }\n    });\n    if (state.screen === 'check' && state.check.phase === 'lean') { if (pad.axes[0] < -.45) state.check.directions.add('left'); if (pad.axes[0] > .45) state.check.directions.add('right'); if (pad.axes[1] < -.45) state.check.directions.add('up'); if (pad.axes[1] > .45) state.check.directions.add('down'); }\n    gamepadPrevious[pad.index] = pad.buttons.map(item => item.pressed);\n  }\n}\nconst simulation = new My3D2dge.Game({ headless: true, step: 1 / 120 });\nsimulation.start({ update, draw() {} });\nfunction frame(now) {\n  const dt = lastFrame ? Math.min(.1, (now - lastFrame) / 1000) : 0; lastFrame = now;\n  pollGamepad(); simulation.advance(dt); music(); drawWorld({ ...state, shirt: OUTFITS[person().outfit || 0] });\n  if (now - lastHud > 100) { if (state.screen === 'play') updateHUD(); if (state.screen === 'check') updateCheckHUD(); lastHud = now; }\n  requestAnimationFrame(frame);\n}\nwindow.__ZEN = {\n  state, action, startActivity, tuning,\n  advance(seconds) { simulation.advance(seconds); render(); },\n  snapshot() { return JSON.parse(JSON.stringify({ screen: state.screen, member: state.member, activity: state.activity && { id: state.activity.id, elapsed: state.activity.elapsed, px: state.activity.px, py: state.activity.py, score: state.activity.score, stumbles: state.activity.stumbles }, result: state.result, hub: state.hub, settings: state.settings })); }\n};\nrender(); requestAnimationFrame(frame);\n\nif (state.hub.active) {\n  screen('hub');\n  window.AIHub.on('start', () => { state.hub.started = true; state.hub.startedAt = window.AIHub.time(); startActivity(ACTIVITIES.find(activity => activity.id === 'stork'), { seconds: 60 }); });\n  window.AIHub.on('message', (data, from) => { state.hub.ghosts[from] = data; });\n  window.AIHub.on('time-up', () => { if (!state.hub.finished) { state.hub.finished = true; if (state.activity && state.screen === 'play') state.hub.score += state.activity.score / Math.max(1, state.activity.samples) * 1000; window.AIHub.result({ score: Math.round(state.hub.score) }); screen('hub'); } });\n  window.AIHub.on('end', () => { state.hub.finished = true; screen('hub'); });\n  window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true }).then(() => window.AIHub.ready()).catch(() => notify('Unable to connect to the Hub.'));\n}\n'use strict';\n\nconst canvas = document.getElementById('world');\nconst context = canvas.getContext('2d');\nlet artWidth = 0;\nlet artHeight = 0;\n\nfunction resizeArt() {\n  const ratio = Math.min(window.devicePixelRatio || 1, 2);\n  artWidth = window.innerWidth;\n  artHeight = window.innerHeight;\n  canvas.width = Math.round(artWidth * ratio);\n  canvas.height = Math.round(artHeight * ratio);\n  context.setTransform(ratio, 0, 0, ratio, 0, 0);\n}\nwindow.addEventListener('resize', resizeArt);\nresizeArt();\n\nfunction ellipse(x, y, rx, ry, color) {\n  context.fillStyle = color;\n  context.beginPath();\n  context.ellipse(x, y, Math.max(.1, rx), Math.max(.1, ry), 0, 0, Math.PI * 2);\n  context.fill();\n}\nfunction line(x1, y1, x2, y2, width, color) {\n  context.strokeStyle = color;\n  context.lineWidth = width;\n  context.lineCap = 'round';\n  context.beginPath();\n  context.moveTo(x1, y1);\n  context.lineTo(x2, y2);\n  context.stroke();\n}\nfunction rounded(x, y, width, height, radius, color) {\n  context.fillStyle = color;\n  context.beginPath();\n  context.roundRect(x, y, width, height, radius);\n  context.fill();\n}\nfunction drawCloud(x, y, size) {\n  ellipse(x, y, size * 1.4, size * .26, 'rgba(255,255,255,.48)');\n  ellipse(x - size * .45, y - size * .15, size * .55, size * .3, 'rgba(255,255,255,.48)');\n  ellipse(x + size * .25, y - size * .2, size * .65, size * .34, 'rgba(255,255,255,.48)');\n}\nfunction drawTree(x, y, size) {\n  line(x, y, x + size * .03, y - size * .8, size * .11, '#ac8066');\n  ellipse(x, y - size * .79, size * .37, size * .42, '#8ebaa1');\n  ellipse(x - size * .16, y - size * .87, size * .25, size * .3, '#a6ccae');\n}\nfunction drawTare(x, y, size, mood) {\n  ellipse(x, y + size * .12, size * .58, size * .13, 'rgba(50,90,80,.13)');\n  rounded(x - size * .47, y - size * .37, size * .94, size * .48, size * .13, '#e4ede8');\n  rounded(x - size * .47, y - size * .43, size * .94, size * .48, size * .13, '#fffefa');\n  rounded(x - size * .22, y - size * .31, size * .44, size * .2, size * .05, '#d9efdf');\n  ellipse(x - size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n  ellipse(x + size * .08, y - size * .23, size * .025, size * .027, '#416b60');\n  context.strokeStyle = '#416b60'; context.lineWidth = Math.max(1, size * .015); context.beginPath();\n  context.arc(x, y - size * .2, size * .045, .2, Math.PI - .2); context.stroke();\n  if (mood) { context.fillStyle = '#e6ad65'; context.font = `bold ${size * .2}px sans-serif`; context.fillText('✦', x + size * .57, y - size * .46); }\n}\nfunction drawPerson(x, ground, size, options = {}) {\n  const sway = (options.lean || 0) * size * .13 + Math.sin((options.time || 0) * 1.3) * size * .008;\n  const movement = options.movement || 0;\n  const skin = options.skin || '#e8b69b';\n  const shirt = options.shirt || '#f1c86c';\n  const trousers = options.trousers || '#527d75';\n  ellipse(x, ground + size * .035, size * .39, size * .065, 'rgba(56,95,80,.13)');\n  line(x - size * .1, ground - size * .31, x - size * (.16 + movement * .08), ground - size * .03, size * .105, trousers);\n  line(x + size * .1, ground - size * .31, x + size * (.16 - movement * .08), ground - size * .03, size * .105, trousers);\n  line(x - size * (.16 + movement * .08), ground - size * .03, x - size * (.23 + movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n  line(x + size * (.16 - movement * .08), ground - size * .03, x + size * (.23 - movement * .08), ground - size * .03, size * .07, '#f9f8e9');\n  line(x - size * .13 + sway, ground - size * .6, x - size * .35 + sway, ground - size * (.49 + Math.abs(movement) * .12), size * .08, skin);\n  line(x + size * .13 + sway, ground - size * .6, x + size * .35 + sway, ground - size * (.49 - Math.abs(movement) * .12), size * .08, skin);\n  rounded(x - size * .19 + sway, ground - size * .68, size * .38, size * .4, size * .12, shirt);\n  line(x + sway, ground - size * .71, x + sway, ground - size * .65, size * .105, skin);\n  ellipse(x + sway, ground - size * .85, size * .19, size * .22, skin);\n  ellipse(x + sway, ground - size * .99, size * .19, size * .105, '#52655a');\n  ellipse(x - size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n  ellipse(x + size * .065 + sway, ground - size * .85, size * .013, size * .016, '#496156');\n  context.strokeStyle = '#a56d61'; context.lineWidth = Math.max(1, size * .012); context.beginPath();\n  context.arc(x + sway, ground - size * .81, size * .045, .1, Math.PI - .1); context.stroke();\n}\nfunction drawScenery(time) {\n  const width = artWidth, height = artHeight;\n  const sky = context.createLinearGradient(0, 0, 0, height);\n  sky.addColorStop(0, '#e3f4ef'); sky.addColorStop(.55, '#eff8e9'); sky.addColorStop(1, '#bfe3d3');\n  context.fillStyle = sky; context.fillRect(0, 0, width, height);\n  ellipse(width * .77, height * .19, Math.min(width, height) * .11, Math.min(width, height) * .11, '#fae9b5');\n  drawCloud(width * .67 + Math.sin(time * .08) * 9, height * .15, width * .08);\n  drawCloud(width * .92, height * .27, width * .05);\n  context.fillStyle = '#c9e7d7'; context.beginPath(); context.moveTo(0, height * .64); context.quadraticCurveTo(width * .24, height * .31, width * .45, height * .61); context.quadraticCurveTo(width * .67, height * .36, width, height * .63); context.lineTo(width, height); context.lineTo(0, height); context.fill();\n  context.fillStyle = '#aedbc9'; context.beginPath(); context.moveTo(0, height * .69); context.quadraticCurveTo(width * .21, height * .51, width * .44, height * .68); context.quadraticCurveTo(width * .72, height * .46, width, height * .65); context.lineTo(width, height); context.lineTo(0, height); context.fill();\n  context.fillStyle = '#cdebe0'; context.fillRect(0, height * .7, width, height * .3);\n  for (let index = 0; index < 11; index++) {\n    const rippleX = ((index * 191 + time * 5) % (width + 100)) - 50;\n    line(rippleX, height * (.74 + (index % 4) * .045), rippleX + 42 + index * 3, height * (.74 + (index % 4) * .045), 2, 'rgba(255,255,255,.35)');\n  }\n}\nfunction drawWorld(state) {\n  const width = artWidth, height = artHeight, time = state.clock || 0;\n  context.clearRect(0, 0, width, height);\n  drawScenery(time);\n  const compact = width < 700;\n  const active = state.screen === 'play' || state.screen === 'check';\n  const cx = compact ? width * .52 : active ? width * .5 : width * .73;\n  const cy = active ? height * .76 : compact ? height * .46 : height * .68;\n  const size = Math.min(width * (compact ? .63 : .30), height * .52);\n  ellipse(cx, cy + size * .19, size * 1.05, size * .28, '#a9cfb5');\n  ellipse(cx, cy + size * .13, size, size * .26, '#d5e7c4');\n  ellipse(cx, cy + size * .07, size * .91, size * .2, '#e9efd4');\n  drawTree(cx - size * .7, cy - size * .1, size * .42);\n  drawTree(cx + size * .72, cy - size * .08, size * .3);\n  if (!active) {\n    rounded(cx - size * .37, cy - size * .39, size * .53, size * .32, size * .025, '#fff9e9');\n    context.fillStyle = '#dfaa88'; context.beginPath(); context.moveTo(cx - size * .43, cy - size * .39); context.lineTo(cx - size * .11, cy - size * .58); context.lineTo(cx + size * .21, cy - size * .39); context.closePath(); context.fill();\n    rounded(cx - size * .12, cy - size * .29, size * .11, size * .2, size * .012, '#9ec6b2');\n    rounded(cx - size * .31, cy - size * .29, size * .12, size * .1, size * .01, '#b4ddd2');\n    ellipse(cx + size * .28, cy + size * .02, size * .31, size * .09, '#a4cfc1');\n    drawPerson(cx + size * .27, cy, size * .6, { time, movement: Math.sin(time * 1.2) * .2 });\n    drawTare(cx + size * .58, cy + size * .08, size * .24, true);\n    for (let index = 0; index < 5; index++) ellipse(cx - size * .6 + index * size * .07, cy + size * .12, 3, 3, index % 2 ? '#f6c888' : '#fff8e5');\n  } else {\n    const activity = state.activity;\n    const lean = activity ? activity.px : 0;\n    const movement = activity ? Math.sin(activity.elapsed * (activity.kind === 'jog' ? 5 : 2)) * .6 : 0;\n    ellipse(cx, cy + size * .05, size * .55, size * .12, '#a5d2bf');\n    drawPerson(cx, cy, size * .95, { time, lean, movement, shirt: state.shirt });\n    drawTare(cx + size * .55, cy + size * .06, size * .22, false);\n    if (activity && activity.kind === 'candle') {\n      rounded(cx - size * .65, cy - size * .14, size * .11, size * .16, 4, '#fffaf0');\n      ellipse(cx - size * .595, cy - size * .16, size * .035, size * (.055 + activity.flame * .06), '#f7c05b');\n    }\n    if (activity && activity.kind === 'hoop') {\n      context.strokeStyle = '#f5ae80'; context.lineWidth = size * .035; context.beginPath(); context.ellipse(cx, cy - size * .35, size * .36, size * .09, -.08, 0, Math.PI * 2); context.stroke();\n    }\n    if (activity && activity.kind === 'tray') {\n      line(cx - size * .38, cy - size * .49, cx + size * .38, cy - size * .49 + lean * size * .1, size * .045, '#bb8b6d');\n      ellipse(cx, cy - size * .52, size * .06, size * .035, '#849e67');\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_331","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; nl -ba \\\"\"'$D/src/game.js\" | sed -n '\"'90,235p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_331","type":"command_execution","command":"/bin/bash -lc \"D='Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356'; nl -ba \\\"\"'$D/src/game.js\" | sed -n '\"'90,235p'\"","aggregated_output":"    90\t    heading = 'BODY CHECK COMPLETE';\n    91\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ACCORDING TO TARE</div><div class=\"score-big\">${state.check.spine}</div><h1>Your Spine Age</h1><p>“A completely imaginary number. Your actual spine remains splendid.”</p><p class=\"note\">Today is a fine day to practice being here.</p><div class=\"actions\">${button('Explore the island', 'island', true)}</div></div></main>`;\n    92\t  } else if (state.screen === 'island') {\n    93\t    heading = labelDay();\n    94\t    const dialogue = CAST[(member.day + member.sessions) % CAST.length];\n    95\t    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of movement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished ? 'ending' : 'sleep', true)}</div></div></main>`;\n    96\t  } else if (state.screen === 'activity') {\n    97\t    const activity = state.selection, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n    98\t    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>How to play</h3><p>${activity.instruction}</p><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle mode is on.' : 'Make small, comfortable movements.'}</p><div class=\"actions\">${button('Back to island', state.classMode ? 'class' : 'island')}${button('Begin practice', 'start-activity', true)}</div></div></main>`;\n    99\t  } else if (state.screen === 'play') {\n   100\t    const activity = state.activity, group = GROUPS[activity.group]; heading = group.name.toUpperCase();\n   101\t    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your center.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\"></span><span class=\"plate-dot\" id=\"plate-dot\"></span></div><div class=\"hud-bottom\"><div class=\"play-instruction\" id=\"play-instruction\">${activity.instruction}</div><div class=\"meter\"><span id=\"play-progress\"></span></div><div class=\"hud-caption\"><span id=\"play-score\">A GENTLE START</span><span>ESC / OPTIONS &nbsp; PAUSE</span></div></div></main>`;\n   102\t  } else if (state.screen === 'result') {\n   103\t    const result = state.result;\n   104\t    heading = 'SESSION COMPLETE';\n   105\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue result-card\"><div class=\"eyebrow\">✳ &nbsp; PRACTICE COMPLETE</div><div class=\"stars-big\">${'★'.repeat(result.stars)}<span>${'☆'.repeat(3 - result.stars)}</span></div><h1>Lovely work${state.classMode ? ', everyone' : ''}.</h1><p>“${result.message}”</p><div class=\"result-stats\"><div><strong>${result.percent}%</strong><small>STEADINESS</small></div><div><strong>+${result.minutes}</strong><small>FIT MINUTES</small></div><div><strong>${result.stumbles}</strong><small>WOBBLES</small></div></div><div class=\"actions\">${button('Practice again', 'retry')}${button(state.festival ? 'Continue the Games' : state.classMode ? 'Class results' : 'Back to island', 'result-continue', true)}</div></div></main>`;\n   106\t  } else if (state.screen === 'recap') {\n   107\t    heading = 'DAY COMPLETE';\n   108\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ANOTHER DAY WELL SPENT</div><h1>Rest is part of it.</h1><p>“${member.sessions} sessions today. Gerald the ceramic hippo has made a careful note.”</p><div class=\"result-stats\"><div><strong>${Math.floor(member.minutes)}</strong><small>FIT MINUTES</small></div><div><strong>${Object.keys(member.stars || {}).length}</strong><small>MATS VISITED</small></div></div><div class=\"actions\">${button('Wake up to day ' + (member.day + 1), 'next-day', true)}</div></div></main>`;\n   109\t  } else if (state.screen === 'festival') {\n   110\t    heading = 'DAY 5 &nbsp; / &nbsp; GENTLE GAMES';\n   111\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THE GENTLE GAMES</div><h1>Ready, steady,<br><em>be yourself.</em></h1><p>Three friendly challenges, ending in the Grand Stillness with Gertrude. The prize is a very nice feeling.</p><p class=\"note\">Challenge ${state.festivalIndex + 1} of 3 &nbsp; · &nbsp; ${['Stork Stand', 'Slalom', 'Quiet Candle'][state.festivalIndex]}</p><div class=\"actions\">${button('Begin challenge', 'festival-start', true)}</div></div></main>`;\n   112\t  } else if (state.screen === 'ending') {\n   113\t    heading = 'THANK YOU FOR STAYING';\n   114\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; YOUR ISLAND IS ALWAYS HERE</div><div class=\"stars-big\">✳</div><h1>A little steadier.<br><em>A lot more you.</em></h1><p>Gertrude awards you the Golden Composure. Dennis is emotional. Tare insists the award is calibrated.</p><p class=\"note\">Thank you for five days of moving, breathing, and making room. The mats are yours whenever you wish.</p><div class=\"actions\">${button('Explore freely', 'free-play', true)}${button('About & credits', 'about')}</div></div></main>`;\n   115\t  } else if (state.screen === 'class') {\n   116\t    heading = 'LOCAL CLASS';\n   117\t    const players = state.classPlayers;\n   118\t    content = `<main class=\"main-wrap\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; BETTER TOGETHER</div><h1>Make room for friends.</h1><p>Up to four share the same screen. One keyboard player; connect controllers for more.</p></div></div><div class=\"class-players\">${[0, 1, 2, 3].map((index) => `<div class=\"card player-tile\"><span class=\"slot-avatar\">${players[index] ? '☺' : '+'}</span><strong>${players[index] ? escapeHTML(players[index].name) : 'Open spot'}</strong><small>${players[index] ? escapeHTML(players[index].type) : 'Join or add a bot'}</small><button class=\"chip\" data-action=\"class-toggle\" data-id=\"${index}\">${players[index] ? 'REMOVE' : 'ADD BOT'}</button></div>`).join('')}</div><div class=\"card class-select\"><p>CHOOSE A CLASS</p><div class=\"options\">${['stork','candle','step','slalom','tray'].map(id => `<button class=\"option ${state.selection?.id === id ? 'selected' : ''}\" data-action=\"class-activity\" data-id=\"${id}\">${ACTIVITIES.find(a => a.id === id).name}</button>`).join('')}</div></div><div class=\"actions\">${button('Back', member.name === 'Guest' ? 'home' : 'island')}${button('Start class', 'start-class', true)}</div></main>`;\n   119\t  } else if (state.screen === 'class-result') {\n   120\t    heading = 'LOCAL CLASS';\n   121\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; EVERYONE SHOWED UP</div><h1>A class act.</h1><p>Everyone gets their own kind of gold star.</p>${state.classPlayers.map((player, index) => `<div class=\"row\"><span>${escapeHTML(player.name)} ${player.type === 'Bot' ? '· BOT' : ''}</span><b>${Math.max(30, state.result.percent - index * 5)} points &nbsp; ★</b></div>`).join('')}<div class=\"actions\">${button('Back to class', 'class', true)}</div></div></main>`;\n   122\t  } else if (state.screen === 'settings') {\n   123\t    heading = 'SETTINGS';\n   124\t    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; MAKE YOURSELF COMFORTABLE</div><h1>Your settings.</h1></div></div><div class=\"card settings-card\">${settingRow('Music', state.settings.music + '%', 'volume', 'music')}${settingRow('Sound effects', state.settings.sound + '%', 'volume', 'sound')}${settingRow('Voice sounds', state.settings.voice ? 'ON' : 'OFF', 'toggle', 'voice')}${settingRow('Gentle mode', state.settings.gentle ? 'ON' : 'OFF', 'toggle', 'gentle')}${settingRow('Breathing', state.settings.breathToggle ? 'TOGGLE' : 'HOLD', 'toggle', 'breathToggle')}${settingRow('Tips', state.settings.tips ? 'ON' : 'OFF', 'toggle', 'tips')}${settingRow('Controller symbols', state.settings.glyphs.toUpperCase(), 'glyphs')}<p class=\"note\">Select a volume to cycle from 0% to 100%. Gentle mode makes balancing more forgiving.</p><div class=\"actions\">${button('Done', 'settings-back', true)}</div></div></main>`;\n   125\t  } else if (state.screen === 'pause') {\n   126\t    heading = 'PAUSED';\n   127\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; TAKE YOUR TIME</div><h1>Pause is a practice, too.</h1><div class=\"menu-stack\">${button('Resume', 'resume', true)}${button('Restart session', 'restart')}${button('Settings', 'settings')}${state.hub.active ? '' : button('Developer mode', 'dev')}${state.hub.active ? '' : button('Leave session', 'leave-play')}</div></div></main>`;\n   128\t  } else if (state.screen === 'dev') {\n   129\t    heading = 'DEVELOPER MODE';\n   130\t    content = `<main class=\"main-wrap narrow\"><div class=\"card settings-card\"><div class=\"eyebrow\">✳ &nbsp; LIVE TUNING</div><h1>Behind the wobble.</h1>${[['spring','Spring',4,20,.5],['damping','Damping',1,12,.5],['instability','Instability',0,4,.1],['noise','Disturbance',0,.8,.05]].map(([key, name, min, max, step]) => `<label class=\"slider\">${name} <output id=\"out-${key}\">${tuning[key]}</output><input type=\"range\" data-tuning=\"${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${tuning[key]}\"></label>`).join('')}<div class=\"actions\">${button('Reset tuning', 'reset-tuning')}${button('Back to pause', 'pause', true)}</div></div></main>`;\n   131\t  } else if (state.screen === 'about') {\n   132\t    heading = 'ABOUT & CREDITS';\n   133\t    content = `<main class=\"main-wrap narrow\"><div class=\"card scroll\"><div class=\"eyebrow\">✳ &nbsp; A LITTLE NOTE FROM THE MAKERS</div><h1>About & credits.</h1><p>Made with care for everyone who has ever wobbled.</p>${aboutContent()}<div class=\"actions\">${button('Back', 'about-back', true)}</div></div></main>`;\n   134\t  } else if (state.screen === 'hub') {\n   135\t    heading = 'AI HUB &nbsp; / &nbsp; GHOST CLASS';\n   136\t    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; THREE MINUTES TOGETHER</div><h1>${state.hub.finished ? 'Class complete.' : 'A little steadiness, shared.'}</h1><p>${state.hub.finished ? 'Your result has been sent to the Hub.' : 'Stork Stand, Step Class, and Quiet Candle. The steadiest practice wins; everyone gets a moment to breathe.'}</p><div class=\"result-stats\"><div><strong>${Math.round(state.hub.score)}</strong><small>POINTS</small></div></div><p class=\"note\">${state.hub.started ? 'The class is underway.' : 'Waiting for the other guests…'}</p></div></main>`;\n   137\t  }\n   138\t  app.innerHTML = shell(content, heading, state.screen !== 'play' && state.screen !== 'check');\n   139\t  enhanceModes();\n   140\t  if (state.screen === 'play') updateHUD();\n   141\t  if (state.screen === 'check') updateCheckHUD();\n   142\t  const touchOnly = matchMedia('(pointer: coarse)').matches && !Array.from(navigator.getGamepads?.() || []).some(Boolean);\n   143\t  if (touchOnly && !['settings','about'].includes(state.screen)) {\n   144\t    const notice = document.createElement('div'); notice.className = 'touch-notice'; notice.innerHTML = '<div><span>✳</span><h2>Controller or keyboard required</h2><p>Connect a controller or keyboard to enjoy the island.</p><button class=\"action primary\" data-action=\"settings\">Settings <span class=\"arrow\">↗</span></button></div>'; app.appendChild(notice);\n   145\t  }\n   146\t}\n   147\tfunction currentButtons() { return [...app.querySelectorAll('button:not([disabled])')].filter(node => node.offsetParent !== null && !node.closest('.touch-notice')); }\n   148\tfunction focusMove(direction) {\n   149\t  const buttons = currentButtons(); if (!buttons.length) return;\n   150\t  const index = buttons.indexOf(document.activeElement); buttons[(index + direction + buttons.length) % buttons.length].focus();\n   151\t}\n   152\tfunction memberDefault() { return { name: 'Guest', day: 1, sessions: 0, minutes: 0, stars: {}, instructor: 'Birch', color: 1, outfit: 1, finished: false }; }\n   153\tfunction beginCheck() { state.check = { phase: 'still', elapsed: 0, directions: new Set(), spine: 25 + Math.floor(Math.random() * 25) }; state.activity = null; screen('check'); }\n   154\tfunction startActivity(activity, options = {}) {\n   155\t  const selected = { ...activity }, duration = options.seconds || selected.seconds;\n   156\t  state.selection = selected;\n   157\t  state.activity = { ...selected, seconds: duration, elapsed: 0, px: 0, py: 0, vx: 0, vy: 0, ux: 0, uy: 0, ringX: 0, ringY: 0, flame: .6, score: 0, samples: 0, stumbles: 0, stun: 0, effort: 0, reps: 0, beatHits: 0, lastBeat: -1, lastJog: '', jogHits: 0, hoopHits: 0, good: 0, tray: 0, lastDirection: 0, motions: 0, rng: seeded(841 + selected.name.length) };\n   158\t  if (state.classMode && !state.hub.active) prepareClass();\n   159\t  mouseLean = null; keys.clear(); toggledBreath = false; screen('play');\n   160\t}\n   161\tfunction completeActivity() {\n   162\t  const activity = state.activity;\n   163\t  if (!activity) return;\n   164\t  const percent = Math.round(clamp(activity.score / Math.max(1, activity.samples) * 100, 0, 100));\n   165\t  const stars = percent >= 90 ? 3 : percent >= 65 ? 2 : percent >= 35 ? 1 : 0;\n   166\t  const minutes = Math.max(1, Math.round(activity.seconds / 60 * (1 + stars * .25)));\n   167\t  state.result = { percent, stars, minutes, stumbles: activity.stumbles, message: stars >= 2 ? 'You made the wobble look rather elegant.' : 'A little practice is still a lovely thing.' };\n   168\t  if (!state.hub.active && !state.classMode) { const member = state.member; member.sessions = (member.sessions || 0) + 1; member.minutes = (member.minutes || 0) + minutes; member.stars[activity.id] = Math.max(member.stars[activity.id] || 0, stars); save(); }\n   169\t  tone(523, .3); if (state.hub.active) { finishHubEvent(); screen('hub'); } else if (state.classMode) screen('class-result'); else screen('result');\n   170\t}\n   171\tfunction attemptInput(key) {\n   172\t  const activity = state.activity;\n   173\t  if (!activity || state.screen !== 'play') return;\n   174\t  if (activity.kind === 'step') {\n   175\t    const directions = ['arrowleft','arrowup','arrowright','arrowdown'];\n   176\t    const aliases = { a:'arrowleft', w:'arrowup', d:'arrowright', s:'arrowdown' };\n   177\t    const direction = aliases[key] || key, beat = Math.round(activity.elapsed * 100 / 60), phase = Math.abs(activity.elapsed * 100 / 60 - beat);\n   178\t    if (direction === directions[(beat + 4) % 4] && phase < .34 && beat !== activity.lastBeat) { activity.beatHits++; activity.lastBeat = beat; tone(520, .08, .35); }\n   179\t  }\n   180\t  if (activity.kind === 'jog' && (key === 'j' || key === 'k') && key !== activity.lastJog) { activity.lastJog = key; activity.jogHits++; }\n   181\t  if (activity.kind === 'hoop' && (key === 'q' || key === 'e')) { activity.hoopHits++; tone(660, .1, .3); }\n   182\t  if ((key === ' ' || key === 'enter') && state.settings.breathToggle) toggledBreath = !toggledBreath;\n   183\t}\n   184\tconst tuningDefaults = { spring: 11, damping: 6, instability: 1.3, noise: .19 };\n   185\tconst tuning = { ...tuningDefaults };\n   186\tfunction updateActivity(dt) {\n   187\t  const activity = state.activity; if (!activity) return;\n   188\t  activity.elapsed += dt;\n   189\t  const pad = Array.from(navigator.getGamepads?.() || []).find(candidate => candidate && !state.classActors?.some(actor => actor.player.padIndex === candidate.index)), axisX = pad && Math.abs(pad.axes[0]) > .12 ? pad.axes[0] : 0, axisY = pad && Math.abs(pad.axes[1]) > .12 ? pad.axes[1] : 0;\n   190\t  const dx = (keys.has('arrowright') || keys.has('d') ? 1 : 0) - (keys.has('arrowleft') || keys.has('a') ? 1 : 0);\n   191\t  const dy = (keys.has('arrowdown') || keys.has('s') ? 1 : 0) - (keys.has('arrowup') || keys.has('w') ? 1 : 0);\n   192\t  if (activity.stun <= 0) {\n   193\t    if (mouseLean) { activity.ux = mouseLean.x; activity.uy = mouseLean.y; }\n   194\t    else if (axisX || axisY) { activity.ux = axisX; activity.uy = axisY; }\n   195\t    else { activity.ux = clamp(activity.ux + dx * 2.2 * dt, -1, 1); activity.uy = clamp(activity.uy + dy * 2.2 * dt, -1, 1); if (!dx) activity.ux *= Math.max(0, 1 - .5 * dt); if (!dy) activity.uy *= Math.max(0, 1 - .5 * dt); }\n   196\t  } else activity.stun -= dt;\n   197\t  const gentle = state.settings.gentle ? .7 : 1, time = activity.elapsed, disturbance = tuning.noise * gentle;\n   198\t  const ax = tuning.spring * (activity.ux - activity.px) - tuning.damping * activity.vx + tuning.instability * gentle * activity.px + disturbance * (Math.sin(time * 1.7) + .5 * Math.sin(time * 3.23));\n   199\t  const ay = tuning.spring * (activity.uy - activity.py) - tuning.damping * activity.vy + tuning.instability * gentle * activity.py + disturbance * (Math.sin(time * 1.19 + 1) + .5 * Math.sin(time * 2.71));\n   200\t  activity.vx += ax * dt; activity.vy += ay * dt; activity.px += activity.vx * dt; activity.py += activity.vy * dt;\n   201\t  if (Math.hypot(activity.px, activity.py) >= 1 && activity.stun <= 0) { activity.stumbles++; activity.stun = 1; activity.px *= .5; activity.py *= .5; activity.vx *= -.2; activity.vy *= -.2; tone(196, .18); }\n   202\t  const phase = Math.floor(time / 12), rng = seeded(phase * 667 + 43);\n   203\t  activity.ringX = activity.id === 'stork' ? (rng() - .5) * .65 : activity.kind === 'slalom' ? Math.sin(time * .55) * .46 : 0;\n   204\t  activity.ringY = activity.id === 'stork' ? (rng() - .5) * .35 : 0;\n   205\t  const distance = Math.hypot(activity.px - activity.ringX, activity.py - activity.ringY), ringSize = state.settings.gentle ? .48 : .38;\n   206\t  const steadiness = clamp(1 - distance * 1.4, 0, 1);\n   207\t  let quality = steadiness;\n   208\t  const held = state.settings.breathToggle ? toggledBreath : keys.has(' ') || !!pad?.buttons[7]?.pressed;\n   209\t  activity.effort = clamp(activity.effort + (held ? 1 : -1) * dt / 4, 0, 1);\n   210\t  if (activity.kind === 'rep') { const goal = (Math.sin(time * Math.PI / 2 - Math.PI / 2) + 1) / 2; quality = clamp(1 - Math.abs(activity.effort - goal), 0, 1) * steadiness; activity.reps = Math.floor(time / 4); }\n   211\t  if (activity.kind === 'breath') { const inhale = Math.sin(time * Math.PI / 4) > 0; quality = steadiness * (held === inhale ? 1 : .5); }\n   212\t  if (activity.kind === 'step') quality = clamp(activity.beatHits / Math.max(1, time * 100 / 60) * 1.5, 0, 1);\n   213\t  if (activity.kind === 'hoop') { activity.motions += (Math.abs(activity.vx) + Math.abs(activity.vy)) * dt; quality = clamp(activity.motions / Math.max(1, time) * 3 + activity.hoopHits / Math.max(1, time / 10), 0, 1); }\n   214\t  if (activity.kind === 'jog') quality = clamp(activity.jogHits / Math.max(1, time * 2) * 1.5, 0, 1) * steadiness;\n   215\t  if (activity.kind === 'slalom') quality = clamp(1 - Math.abs(activity.px - activity.ringX) * 1.5, 0, 1);\n   216\t  if (activity.kind === 'tray') { activity.tray += (activity.px - activity.tray) * dt * 1.5; quality = clamp(1 - Math.abs(activity.tray) * 2, 0, 1); }\n   217\t  if (activity.kind === 'rope') quality = clamp(1 - Math.abs(activity.px) * 2, 0, 1) * (activity.uy < -.1 ? 1 : .65);\n   218\t  if (activity.kind === 'candle') { activity.flame = clamp(activity.flame + (distance < ringSize ? .13 : -.3) * dt, 0, 1); quality = activity.flame; }\n   219\t  activity.score += quality; activity.samples++;\n   220\t  if (state.classMode && !state.hub.active) updateClass(dt);\n   221\t  if (state.hub.active) {\n   222\t    const now = window.AIHub.time();\n   223\t    if (now - state.hub.lastSend >= 100) { state.hub.lastSend = now; window.AIHub.send({ x: activity.px, y: activity.py, exercise: activity.id }); }\n   224\t    if (now - state.hub.lastProgress >= 1000) { state.hub.lastProgress = now; window.AIHub.progress({ score: Math.round(state.hub.score + activity.score / Math.max(1, activity.samples) * 1000), label: activity.name }); }\n   225\t  }\n   226\t  if (!state.hub.active && activity.elapsed >= activity.seconds) completeActivity();\n   227\t}\n   228\tfunction updateHUD() {\n   229\t  const activity = state.activity; if (!activity) return;\n   230\t  const timer = document.getElementById('play-timer'), status = document.getElementById('play-status'), instruction = document.getElementById('play-instruction'), progress = document.getElementById('play-progress'), dot = document.getElementById('plate-dot'), ring = document.getElementById('plate-ring'), score = document.getElementById('play-score');\n   231\t  if (!timer) return;\n   232\t  timer.textContent = Math.max(0, Math.ceil(activity.seconds - activity.elapsed));\n   233\t  if (activity.kind === 'step') { const arrows = ['←','↑','→','↓']; const beat = Math.round(activity.elapsed * 100 / 60); status.textContent = `NEXT STEP  ${arrows[(beat + 4) % 4]}   ·   ${activity.beatHits} on beat`; instruction.textContent = `Press ${arrows[(beat + 4) % 4]} on the beat · ${activity.instruction}`; }\n   234\t  else if (activity.kind === 'rep') status.textContent = `Rep ${activity.reps + 1} · ${Math.sin(activity.elapsed * Math.PI / 2 - Math.PI / 2) > 0 ? 'Rise gently' : 'Lower gently'}`;\n   235\t  else if (activity.kind === 'breath') status.textContent = Math.sin(activity.elapsed * Math.PI / 4) > 0 ? 'Breathe in · hold' : 'Breathe out · release';\n","exit_code":0,"status":"completed"}}
