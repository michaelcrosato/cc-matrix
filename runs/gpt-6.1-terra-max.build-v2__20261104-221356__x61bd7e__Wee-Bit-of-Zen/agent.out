i Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:79:    content = `<main class=\"main-wrap narrow\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; NICE TO MEET YOU</div><h1>A little about you.</h1><p>There is no wrong way to arrive.</p></div></div><div class=\"card setup-card\"><label class=\"field\">WHAT SHOULD WE CALL YOU?<input id=\"nickname\" maxlength=\"16\" value=\"${escapeHTML(member.name === 'Guest' ? '' : member.name)}\" placeholder=\"Your name\" autocomplete=\"off\"></label><p class=\"field-label\">CHOOSE YOUR COLOUR</p><div class=\"options\">${OUTFITS.map((color, index) => `<button class=\"option swatch ${member.outfit === index ? 'selected' : ''}\" data-action=\"outfit\" data-id=\"${index}\" style=\"--swatch:${color}\" aria-label=\"Outfit ${index + 1}\">${member.outfit === index ? '✓' : ''}</button>`).join('')}</div><p class=\"field-label\">YOUR INSTRUCTOR</p><div class=\"options\">${['Birch', 'Alder'].map(name => `<button class=\"option ${member.instructor === name ? 'selected' : ''}\" data-action=\"instructor\" data-id=\"${name}\">${name === 'Birch' ? '✳' : '✦'} &nbsp; ${name}</button>`).join('')}</div><div class=\"actions\">${button('Back', 'slots')}${button('Arrive on the island', 'create-member', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:82:    content = `<main class=\"main-wrap narrow\"><div class=\"dialogue card\"><div class=\"eyebrow\">✳ &nbsp; A NOTE FROM TARE</div><div class=\"speaker\">☺</div><h1>Welcome${member.day === 1 ? ', ' + escapeHTML(member.name) : ' back'}.</h1><p>“${DAY_INTROS[Math.min(4, member.day - 1)]}”</p><p class=\"note\">Your stay starts with a gentle body check. No weights, no judgement, and absolutely no pop quizzes. Well, one tiny quiz.</p><div class=\"actions\">${button('Begin body check', 'check', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:85:    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">✳ &nbsp; BODY CHECK</div><h2>Just checking in.</h2><p id=\"check-text\">Find a comfortable center.</p></div><div class=\"hud-box timer\" id=\"check-timer\">05</div></div><div class=\"hud-bottom\"><div class=\"play-instruction\">${state.check?.phase === 'lean' ? 'Lean in each direction: ← ↑ → ↓' : 'Stay steady. Small wobbles are welcome.'}</div><div class=\"meter\"><span id=\"check-progress\"></span></div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:88:    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ONE VERY SCIENTIFIC QUESTION</div><h1>How are you arriving today?</h1><p>Your answer helps us calibrate the island's extremely sophisticated vibes.</p><div class=\"menu-stack\">${button('Bright-eyed and bushy-tailed', 'question-answer', true, 'bright')}${button('A little wobbly, honestly', 'question-answer', false, 'wobbly')}${button('Mostly thinking about snacks', 'question-answer', false, 'snacks')}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:91:    content = `<main class=\"main-wrap narrow\"><div class=\"card dialogue\"><div class=\"eyebrow\">✳ &nbsp; ACCORDING TO TARE</div><div class=\"score-big\">${state.check.spine}</div><h1>Your Spine Age</h1><p>“A completely imaginary number. Your actual spine remains splendid.”</p><p class=\"note\">Today is a fine day to practice being here.</p><div class=\"actions\">${button('Explore the island', 'island', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:95:    content = `<main class=\"main-wrap island-main\"><div class=\"section-head\"><div><div class=\"eyebrow\">✳ &nbsp; ${labelDay()} &nbsp; / &nbsp; ${Math.floor(member.minutes || 0)} FIT MINUTES</div><h1>Find your kind of movement.</h1><p>${member.finished ? 'The island is yours. Stay as long as you like.' : `Hello, ${escapeHTML(member.name)}. Choose a mat and settle in.`}</p></div><div class=\"day-badge\"><strong>${member.sessions || 0}<small>/ 3</small></strong><span>TODAY'S<br>SESSIONS</span></div></div><div class=\"activity-grid\">${ACTIVITIES.map(activity => tile(activity, !member.finished && activity.day > member.day)).join('')}</div><div class=\"island-bar\"><p><b>${dialogue[0]} says:</b> “${dialogue[1]}”</p><div class=\"map-actions\">${button('Local Class', 'class')}${button(member.finished ? 'Your story' : member.day === 5 ? 'Gentle Games' : 'End the day', member.finished ? 'ending' : 'sleep', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:98:    content = `<main class=\"main-wrap narrow\"><div class=\"card activity-detail\" style=\"--group:${group.color};--group-light:${group.light}\"><div class=\"activity-large-icon\">${activity.icon}</div><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()} &nbsp; / &nbsp; ${activity.seconds} SECONDS</div><h1>${activity.name}</h1><p>${activity.tagline}</p><div class=\"divider\"></div><h3>How to play</h3><p>${activity.instruction}</p><p class=\"note\">Lean with WASD, arrow keys, left stick or mouse. ${state.settings.gentle ? 'Gentle mode is on.' : 'Make small, comfortable movements.'}</p><div class=\"actions\">${button('Back to island', state.classMode ? 'class' : 'island')}${button('Begin practice', 'start-activity', true)}</div></div></main>`;\nWee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/game.js:101:    content = `<main class=\"play-hud\"><div class=\"hud-top\"><div class=\"hud-box\"><div class=\"eyebrow\">${group.icon} &nbsp; ${group.name.toUpperCase()}</div><h2>${activity.name}</h2><p id=\"play-status\">Find your center.</p></div><div class=\"hud-box timer\"><span id=\"play-timer\">${Math.ceil(activity.seconds)}</span><small>SEC</small></div></div><div class=\"balance-plate\" aria-label=\"Balance indicator\"><span class=\"plate-ring\" id=\"plate-ring\