*/\n    this.fullscreen = new FullScreen(this);\n    /** why the game paused: 'player' | 'focus' (the page was hidden) | 'controller' (unplugged) | 'menu', or null */\n    this.pauseReason = null;\n    /** a promise of the game once its boot (start's boot option, section 10c) has run and it has started: await it in a\n     *  test whose boot steps return promises */\n    this.booted = Promise.resolve(this);\n    /** the error a boot step failed with (the game did not start), or null */\n    this.bootError = null;\n    if (!this.headless) this._standard(signal);\n    E.current = this;   // handy for tools and tests: My3D2dge.current is the latest game\n  }\n  static _makeCanvas() {\n    const c = document.createElement('canvas'); c.id = 'screen';\n    c.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;display:block;image-rendering:pixelated;background:#000;touch-action:none';   // fixed + inset 0 follows a phone's browser bars (100vh does not)\n    document.body.style.margin = '0'; document.body.appendChild(c); return c;\n  }\n  /** internal buffer size in pixels (HUD layout) */\n  get W() { return this.screen.W; }\n  /** the screen's height in game pixels (W is its width) */\n  get H() { return this.screen.H; }\n  /** turn on WebGPU lighting: where it can't draw (no WebGPU, a side view) the canvas lighting stands in, with its own\n   *  ambient (game.lights.ambient) and the same lights. opts: { map, bands, ambient, fallback, ... } */\n  enableGPU(o = {}) { if (this.headless) return null; this.gpu = new GPULighting(this, o); return this.gpu; }\n  _view(v) {\n    if (v instanceof View) return v;\n    const w = E.VIEWS[v];\n    if (!w) warn('view:' + v, 'unknown view \"' + v + '\". Use one of: ' + Object.keys(E.VIEWS).join(', ') + ', or a new E.View(...)');\n    return w || null;\n  }\n  /** switch the view: an id from E.VIEWS ('iso', 'side', ...) or a View; keeps zoom and turn */\n  setView(v) {\n    const w = this._view(v); if (!w) return;\n    this.baseView = w; this._applyView();\n  }\n  /**\n   * camera zoom on top of the view: game.setZoom(1.5) (.5 .. 3), the game's own; where the scene lets the player zoom\n   * (camera.zoom), theirs multiplies it (game.zoom is the two together). Characters, maps, props, particles and lights are\n   * drawn by code, so they re-rasterize crisply at the new size; HUD text and overlays stay the same.\n   */\n  setZoom(z) { this._zoomBase = clamp(+z || 1, .5, 3); this._zoomApply(true); }\n  /** turn the camera around the vertical axis in ground views: game.rotateView(45) (degrees). Side views never turn */\n  rotateView(deg) { this.yaw = (((this.yaw || 0) + deg) % 360 + 360) % 360; this._applyView(); }\n  /** undo setZoom and rotateView: the scene's own zoom again (camera.start, or camera.tall on a screen held upright; 1\n   *  without), no turn. The player's zoom stays (settings.zoom) */\n  resetCamera() { this.yaw = 0; this._zoomBase = this._zoomStart(); this._zoomApply(true); }\n  /**\n   * the player zooms the camera by a factor (1.1: 10% closer, .9: farther), as the wheel, - and = and a pinch do (a zoom\n   * button of the game's own can): within the scene's camera.zoom range, kept as their setting (settings.zoom, on top of\n   * the game's zoom), and noted at the top of the screen ('ZOOM 1.65x': the number a scene's camera.start takes). Does\n   * nothing where the scene doesn't let the player zoom. Returns the zoom\n   */\n  zoomBy(k) {\n    const R = this.zoomRange(), b = this._zoomBase; if (!R || !(k > 0) || !this._zoomStd()) return this.zoom;\n    const lo = Math.max(ZOOM_PLAYER[0], R[0] / b), hi = Math.min(ZOOM_PLAYER[1], R[1] / b); if (lo > hi) return this.zoom;\n    const f = clamp(clamp(+this.settings.zoom || 1, lo, hi) * k, lo, hi); this.settings.set('zoom', f);   // (one carried from a scene with more room starts at this one's end: every step moves it)\n    const z = this._zoomTo || this.zoom; this.note('ZOOM ' + z + 'x' + (f <= lo + 1e-9 && k < 1 ? ' MIN' : f >= hi - 1e-9 && k > 1 ? ' MAX' : ''), 1);\n    return z;\n  }\n  /** the zooms the player may take the camera to here, [min, max] (the scene's camera.zoom, or the game's; a function of\n   *  the game gives one per screen shape or level), or null where they can't (camera.zoom false or none) */\n  zoomRange() {\n    let z = (this._camera() || {}).zoom; if (typeof z === 'function') try { z = z(this); } catch (e) { this.fail('camera.zoom', e); z = null; }\n    return Array.isArray(z) && z.length === 2 && z[0] > 0 && z[1] >= z[0] ? [clamp(z[0], .5, 3), clamp(z[1], .5, 3)] : null;\n  }\n  /** true while the game's screen (r.W x r.H) is upright, taller than 1.3 times its width: a phone held upright, with\n   *  expand: true (a fixed res keeps its own shape on any phone, so it is never upright there). A scene's camera.tall zoom\n   *  applies then: it zooms a tall picture in to fill it */\n  get upright() { return this.H > this.W * 1.3; }\n  /** the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an\n   *  input with player (1..4), name ('P1'), color (E.PLAYER_COLORS) and device. A game of one: [game.input] */\n  get players() { if (!this._players) { const I = this.input; Object.assign(I, { player: 1, name: 'P1', color: E.PLAYER_COLORS[0] }); this._players = [I]; } return this._players; }\n  /** a split screen's viewports ({ i, x, y, w, h, cam, focus(x, y, z), follow(target, { z }): game.splitScreen), or []\n   *  on one screen */\n  get viewports() { return this._split ? this._split.vps : []; }\n  _camera() { const s = this.scene, c = s && s.camera; return (c && typeof c === 'object' ? c : null) || this.o.camera || null; }   // (a method named camera() is no camera: sceneField warns)\n  _zoomStart() { const c = this._camera(); if (!c) return 1; return clamp(+(this.upright && c.tall !== undefined ? c.tall : c.start) || 1, .5, 3); }\n  // the camera's zoom: the game's (_zoomBase), times the player's where the scene allows it, snapped to twentieths (each\n  // zoom is a view, its own baked floor, walls and props)\n  _zoomGoal() {\n    const R = this.zoomRange(), b = this._zoomBase, f = R && this._zoomStd() ? +this.settings.zoom || 1 : 1;\n    return f === 1 ? b : clamp(Math.round(b * f * 20) / 20, Math.min(R[0], b), Math.max(R[1], b));\n  }\n  // the zoom becomes the goal: the game's own at once; the player's (wait) drawn as a preview (_zoomTo: the world as it\n  // was drawn, scaled about the focus, Renderer._zoomPreview) while they pinch, turn the wheel or slide the setting, and\n  // re-rasterized at its new size a quarter second after they stop. A new size bakes the floor, walls and props again\n  // (a third of a second in the adventure): once, not at every step\n  _zoomApply(force, wait) {\n    const z = this._zoomGoal();\n    if (wait && z !== this.zoom) { this._zoomTo = z; this._zoomAt = this._wall; return; }\n    this._zoomTo = null; if (z === this.zoom && !force) return; this.zoom = z; this._applyView();\n  }\n  // a scene's camera.start and camera.tall: as it starts, and when the screen turns upright or back\n  _zoomFit(enter) {\n    const c = this._camera(), up = this.upright, turned = up !== this._up; enter = enter || this._up === undefined; this._up = up;   // (a game without scenes: its first step)\n    if (c && (enter || (turned && c.tall !== undefined))) { this._zoomBase = this._zoomStart(); this._zoomApply(true); }\n    else if (enter || turned) this._zoomApply();   // (a scene without a camera: the player's zoom no longer applies; turned: its range may have changed)\nclass Renderer {\n  /** the r handed to draw(r), made by the game */\n  constructor(game) {\n    /** game: its game; items: this frame's queue (sorted by depth when the frame ends) */\n    this.game = game; this._items = []; this._decals = []; this._overlays = [];\n    this._aCv = mkCanvas(AS, AS); this._aG = ctx2d(this._aCv);\n    // track what each actor actually draws, so outlines, tints and rim light only touch that rectangle\n    const aG = this._aG, bb = this._bb = [AS, AS, 0, 0], fr = aG.fillRect.bind(aG), di = aG.drawImage.bind(aG);\n    const grow = (x, y, w, h) => { if (x < bb[0]) bb[0] = x; if (y < bb[1]) bb[1] = y; if (x + w > bb[2]) bb[2] = x + w; if (y + h > bb[3]) bb[3] = y + h; };\n    aG.fillRect = (x, y, w, h) => { grow(x, y, w, h); fr(x, y, w, h); };\n    aG.drawImage = (img, ...a) => { if (a.length >= 8) grow(a[4], a[5], a[6], a[7]); else if (a.length >= 4) grow(a[0], a[1], a[2], a[3]); else grow(a[0], a[1], img.width, img.height); di(img, ...a); };\n    for (const m of ['fill', 'stroke', 'fillText', 'strokeText', 'putImageData']) { const f = aG[m].bind(aG); aG[m] = (...a) => { grow(0, 0, AS, AS); return f(...a); }; }\n    this._R = [0, 0, AS, AS];\n    this._mCv = mkCanvas(AS, AS); this._mG = ctx2d(this._mCv);\n    this._rCv = mkCanvas(AS, AS); this._rG = ctx2d(this._rCv);\n    this._xCv = mkCanvas(8, 8); this._xG = ctx2d(this._xCv); this._xoCv = mkCanvas(8, 8); this._xoG = ctx2d(this._xoCv);   // x-ray silhouettes (checkered fill) and their solid outlines\n    this._oCv = mkCanvas(8, 8); this._oG = ctx2d(this._oCv);\n    this._eCv = mkCanvas(8, 8); this._eG = ctx2d(this._eCv); this._sCv = mkCanvas(8, 8); this._sG = ctx2d(this._sCv);   // canvas lighting: the glow mask, a scratch layer\n    this._ghostPool = Array.from({ length: 10 }, () => { const c = mkCanvas(AS, AS); return { cv: c, g: ctx2d(c) }; });\n    /** ghosts: the afterimages fading out (actor option ghost) */\n    this._ghostIdx = 0; this._ghosts = [];\n    const ck = mkCanvas(2, 2), cg = ck.getContext('2d'); cg.fillStyle = '#000'; cg.fillRect(0, 0, 1, 1); cg.fillRect(1, 1, 1, 1);\n    /** checker: a 2 x 2 checkerboard canvas (a pattern for x-ray and dithered fills) */\n    this._checker = ck;\n    /** outline: the color of the 1-pixel outline round every actor; rim: the rim light's color on actors' lit edges;\n     *  rimAlpha: its strength 0..1; xrayColor: the default color of x-ray silhouettes; xrayOutline: the default 1-px\n     *  outline round a silhouette's hidden part (null for none); glowMask: false lets emissive\n     *  glows show over everything under canvas lighting (cheaper: the default keeps walls and bodies in front of a glow\n     *  dark) */\n    this.outline = '#140c1c'; this.rim = '#ffe2b8'; this.rimAlpha = .28; this.xrayColor = '#8fe3ff'; this.xrayOutline = '#e8fdff'; this.glowMask = true;\n    // GPU mode: a hidden \"info\" image (height, surface type, glow) and an unlit overlay image\n    this._iCv = mkCanvas(8, 8); this._iG = this._iCv.getContext('2d'); this._iG._info = true; this._iG._r = this; this._iG._mat = '#000';\n    /** gpu: true during a frame drawn with GPU lighting (draw code can check r.gpu) */\n    this._vCv = mkCanvas(8, 8); this._vG = ctx2d(this._vCv); this.gpu = false; this._tg = null;\n  }\n  /** current draw target for ground helpers (switches during GPU info and overlay passes) */\n  get tgt() { return this._tg || this.ctx; }\n  /** the low-resolution buffer's 2D context: draw on it with E.px */\n  get ctx() { return this.game.screen.ctx; }\n  /** the view this frame is drawn in (the game's, with zoom and turn) */\n  get view() { return this.game.view; }\n  /** pixels per world unit on the ground here: the view's scale times the zoom (iso 1.41, the others 1.5, overhead 1, at\n   *  zoom 1). Rigs, maps and props grow with it; a sprite's pixel is a screen pixel at zoom 1 unless drawn with world: true */\n  get ppu() { return (this.view.scale || 1) * (this.view.zoom || 1); }\n  /** the screen's width in game pixels */\n  get W() { return this.game.screen.W; }\n  /** the screen's height in game pixels */\n  get H() { return this.game.screen.H; }\n  /** the buffer's width (W + 2: a pixel of margin each side for the sub-pixel camera) */\n  get bw() { return this.game.screen.buf.width; }\n  /** the buffer's height (H + 2) */\n  get bh() { return this.game.screen.buf.height; }\n  /** start a frame with the camera at (cx, cy) projected pixels (the game calls it before your draw) */\n  _begin(cx, cy, vp) {\n    const sc = this.game.screen; this._frameNo = (this._frameNo || 0) + 1;   // (kept actor images count frames drawn)\n    sc._begin(cx, cy, this.game.o.bg, vp); this._vp = vp || null;\n    if (vp) { const g = this.ctx; g.save(); g.beginPath(); g.rect(vp.x, vp.y, vp.w, vp.h); g.clip(); }   // (a viewport: the scene drawn inside it, the floor too)\n    /** ix, iy: the camera's whole-pixel offset this frame (a world point is at r.w(x, y, z) on the buffer) */\n    this.ix = sc.ix; this.iy = sc.iy; this._items.length = 0; this._decals.length = 0; this._overlays.length = 0; this._map = null; (this._emis || (this._emis = [])).length = 0;\n    const st = this.game.stats; st.actors = 0; st.culled = 0;\n    if (this._xCv.width !== this.bw || this._xCv.height !== this.bh) { this._xCv.width = this._xoCv.width = this._oCv.width = this._eCv.width = this._sCv.width = this.bw; this._xCv.height = this._xoCv.height = this._oCv.height = this._eCv.height = this._sCv.height = this.bh; }\n    this._xrayUsed = false; this._xrayOl = false; this._emOn = false;\n    const gpu = this.game.gpu;\n    this.gpu = !!(gpu && gpu.active(this.view)) && !this.game._split;   // (no GPU lighting on a split screen)\n    if (gpu) gpu._show(this.gpu);\n    if (this.gpu) {\n      if (this._iCv.width !== this.bw || this._iCv.height !== this.bh) { this._iCv.width = this._vCv.width = this.bw; this._iCv.height = this._vCv.height = this.bh; }\n      const iG = this._iG; iG.globalCompositeOperation = 'source-over'; iG.globalAlpha = 1; iG.fillStyle = '#000'; iG.fillRect(0, 0, this.bw, this.bh); iG._c = null; iG._mat = '#000';\n      this._vG.clearRect(0, 0, this.bw, this.bh); this._vG._c = null;\n    }\n  }\n  }\n\n  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n  hub.result = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    var given = outcome || {};\n    delete fields.time;\n    delete fields.score;\n    if (finite(given.time)) fields.time = Number(given.time);\n    if (finite(given.score)) fields.score = Number(given.score);\n    if (!own(fields, 'time') && !own(fields, 'score')) return warn('result needs a finite time or score');\n    reported = true;\n    if (progressTimer) clearTimeout(progressTimer);\n    post('result', fields);\n  };\n\n  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n  hub.finish = function (outcome) {\n    if (!welcomed || ended || reported) return;\n    if (!hub.isHost) return warn('finish is for the host only');\n    var fields = outcomeOf(outcome);\n    if (!fields) return;\n    if (!Array.isArray(fields.standings)) return warn('finish needs standings');\n    reported = true;\n    post('finish', fields);\n  };\n\n  function sendProgress() {\n    progressTimer = null;\n    if (!nextProgress || ended || reported) return;\n    lastProgress = now();\n    post('progress', nextProgress);\n    nextProgress = null;\n  }\n\n  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n  hub.progress = function (p) {\n    if (!welcomed || ended || reported || !p || !finite(p.score)) return;\n    nextProgress = { score: Number(p.score) };\n    if (p.label != null) nextProgress.label = String(p.label).slice(0, 24);\n    var wait = lastProgress + PROGRESS_EVERY_MS - now();\n    if (wait <= 0) sendProgress();\n    else if (!progressTimer) progressTimer = setTimeout(sendProgress, wait);\n  };\n\n  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n  hub.probe = function (fn) {\n    probeFn = typeof fn === 'function' ? fn : null;\n  };\n\n  hub.inspect = function () {\n    if (!probeFn) return null;\n    try {\n      return JSON.parse(JSON.stringify(probeFn()));\n    } catch (e) {\n      return { error: String((e && e.message) || e) };\n    }\n  };\n\n  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n  hub.fail = function (message) {\n    if (!hub.active) return;\n    post('error', { message: String(message || 'error').slice(0, 500), fatal: true });\n  };\n/* =============================================================================\n * MOCAP  plays animation sets in the readable format (src/mocap/readable.js; written by tools/anim-import.mjs) on\n * my-3D2dge rigs.\n *   const lib = Mocap.load(window.MOCAP.QUATERNIUS);   // a set: its clips, and the bodies they were measured on\n *   const clip = lib.clip('Dance_Loop');               // { name, dur, loop, tags, desc, keys }\n *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n *   const man = new Mocap.Mannequin(lib, { height: 34 });  man.draw(g, ox, oy, view, pose, facing)\n *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n *     window.Mocap.)\n *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n *     only the chest, head and arms over the rig's own legs (an interaction while walking); humanoid.mocapBlade = true\n *     while the clip holds a sword (the blade follows the fist).\n * Points are in the rig's local frame: f = forward, r = right, z = up, centred on the root on the ground.\n * ============================================================================= */\nconst Mocap = (() => {\n'use strict';\nconst E = My3D2dge, { px } = E, MR = MocapReadable;\n\n/* ---- sets ---- */\n/**\n * Every clip is rebuilt on the first library's proportions (the format does not depend on size); each keeps how its own\n * library bends the spine, since the key poses were measured that way.\n */\nfunction load(set) {\n  const P = MR.P, idx = MR.IDX, ids = Object.keys(set.sources), base = set.sources[ids[0]].rest, rests = {};\n  for (const id of ids) rests[id] = Object.assign({}, base, { spineW: set.sources[id].rest.spineW, neckW: set.sources[id].rest.neckW });\n  const meta = c => ({ name: c.clip, fps: set.fps, n: Math.round(c.dur * set.fps) + 1 }), clips = {};\n  for (const [name, c] of Object.entries(set.clips)) clips[name] = Object.assign(meta(Object.assign({ clip: name }, c)), c);\n  const restOf = c => rests[c.src] || base;\n  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n  lib.clip = name => clips[name] || null;\n  /** the pose at time t (seconds): key poses in-betweened, loops wrap, one-shots hold their last pose */\n  lib.sample = (clip, t, out = new Float32Array(P * 3)) => { MR.pose(restOf(clip), clip, t, out); out.src = clip.src; return out; };   // (src: whose rest it is measured against)\n  /** a clip that travels: how far it has carried the body at time t ([forward, right] mm), or null */\n  lib.moveAt = (clip, t) => MR.moveAt(restOf(clip), clip, t);\n  /** swap in an edited clip (readable text a person or a model changed); the original is kept for restore() */\n  const originals = {};\n  lib.replace = (name, edited) => { if (!originals[name]) originals[name] = clips[name]; clips[name] = Object.assign({}, originals[name], edited, { name, keys: edited.keys }); return clips[name]; };\n  lib.restore = name => { if (originals[name]) { clips[name] = originals[name]; delete originals[name]; } return clips[name]; };\n  lib.edited = name => !!originals[name];\n  /** the clip as the text a model reads (its header and its key poses) */\n  lib.text = clip => { const o = { clip: clip.clip || clip.name }; for (const k of ['src', 'take', 'orig', 'dur', 'loop', 'tags', 'desc']) if (clip[k] !== undefined) o[k] = clip[k]; o.keys = clip.keys; return MR.text(o); };\n  /** where a clip came from: its library's label, origin and license (from the set's sources), the clip it was made from,\n   *  and (a capture database's) the take and the stretch of it: '13_29 2.30-3.42' */\n  lib.origin = clip => { const s = set.sources[clip.src] || {}; return { src: clip.src, label: s.label || clip.src, origin: s.origin || '', license: s.license || '', url: s.url || '', orig: clip.orig || null, take: clip.take || null }; };\n  /** a pose blended from a to b (crossfades between clips) */\n  lib.blend = (a, b, k, out = new Float32Array(P * 3)) => { for (let i = 0; i < P * 3; i++) out[i] = a[i] + (b[i] - a[i]) * k; out.src = (k < .5 ? a : b).src; return out; };\n  lib.pt = (pose, name) => { const i = idx[name] * 3; return [pose[i], pose[i + 1], pose[i + 2]]; };\n  lib.error = MR.error;\n  return lib;\n}\n\n/* ---- the look-alike mannequin: shaded capsules in the source model's proportions, with its joint bands ---- */\nconst lerp3 = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\nconst add3 = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];\nconst sub3 = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\nconst norm3 = a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\nclass Mannequin {\n  /** o: { height: world units tall (34), main: '#e8aa3a', joint: '#aa66db' } (the colors of the source model's two materials) */\n  constructor(lib, o = {}) {\n    this.lib = lib; this.o = Object.assign({ height: 34, main: '#e8aa3a', joint: '#aa66db' }, o);\n    this.k = this.o.height / ((lib.body && lib.body.height) || 1829);   // world units per mm\n    this._ops = [];\n  }\n  /**\n   * draw the pose into g with (ox, oy) = the projected root. Every part is a capsule between two body points,\n   * sorted by true camera depth, drawn dark-then-lit like the engine's HD rigs.\n   */\n  draw(g, ox, oy, view, pose, facing = 0) {\n    const L = this.lib, o = this.o, k = this.k, ca = Math.cos(facing), sa = Math.sin(facing), sc = view.scale;\n    const pt = name => L.pt(pose, name);\n    const S = p => { const wx = (p[0] * ca - p[1] * sa) * k, wy = (p[0] * sa + p[1] * ca) * k, wz = p[2] * k; return [ox + view.ax * wx + view.ay * wy, oy + view.bx * wx + view.by * wy + view.bz * wz, view.dx * wx + view.dy * wy + view.dz * wz]; };\n    const R = mm => mm * k * sc;   // a radius in mm -> screen pixels\n    const ops = this._ops; ops.length = 0;\n    const main = E.tones(o.main), joint = E.tones(o.joint);\n    // centre depth of the body: parts behind it are drawn a touch darker (the far arm and leg)\n    const mid = S(pt('spine1'))[2];\n    const capsule = (A, B, ra, rb, col, dx = 0, dy = 0) => {\n      const ax = A[0] + dx, ay = A[1] + dy, bx = B[0] + dx, by = B[1] + dy, vx = bx - ax, vy = by - ay, l = Math.hypot(vx, vy);\n      if (l > .01) { const nx = -vy / l, ny = vx / l; px.poly(g, [[ax + nx * ra, ay + ny * ra], [bx + nx * rb, by + ny * rb], [bx - nx * rb, by - ny * rb], [ax - nx * ra, ay - ny * ra]], col); }\n      px.disc(g, ax, ay, Math.max(.5, ra - .3), col); px.disc(g, bx, by, Math.max(.5, rb - .3), col);\n    };\n    // a shaded part: dark silhouette, the base color shifted toward the light (upper left), a soft highlight\n    const part = (a, b, ra, rb, T, bias = 0) => {\n      const A = S(a), B = S(b), pa = R(ra), pb = R(rb), far = (A[2] + B[2]) * .5 < mid - 2 * k * 60;\n      ops.push({ d: (A[2] + B[2]) * .5 + bias, f: () => {\n        capsule(A, B, pa, pb, far ? T.deep : T.sh);\n        capsule(A, B, Math.max(.5, pa - .9), Math.max(.5, pb - .9), far ? T.sh : T.base, -.5, -.6);\n        if (pa > 2.2 && !far) capsule(A, B, pa * .32, pb * .32, T.lt, -pa * .38, -pa * .42);\n      } });\n    };\n    // a ring painted round a limb (the second material): a straight-edged stripe across the capsule, no round ends,\n    // so a thin band reads as a band from every side. Seen end-on (the limb points at the camera) it is hidden.\n    const band = (a, b, t0, t1, ra, rb, T) => {\n      const A = S(lerp3(a, b, t0)), B = S(lerp3(a, b, t1)), axis = S(a), end = S(b), vx = end[0] - axis[0], vy = end[1] - axis[1], l = Math.hypot(vx, vy);\n      if (l < R(Math.max(ra, rb)) * .5) return;\n      const nx = -vy / l, ny = vx / l, wa = R(ra + (rb - ra) * t0) + .2, wb = R(ra + (rb - ra) * t1) + .2;\n      ops.push({ d: (axis[2] + end[2]) * .5 + .02, f: () => {\n        const q = (w0, w1, dx, dy) => [[A[0] + nx * w0 + dx, A[1] + ny * w0 + dy], [B[0] + nx * w1 + dx, B[1] + ny * w1 + dy], [B[0] - nx * w1 + dx, B[1] - ny * w1 + dy], [A[0] - nx * w0 + dx, A[1] - ny * w0 + dy]];\n        px.poly(g, q(wa, wb, 0, 0), T.sh); px.poly(g, q(Math.max(.5, wa - .9), Math.max(.5, wb - .9), -.5, -.6), T.base);\n      } });\n    };\n\n    const pelvis = pt('pelvis'), sp1 = pt('spine1'), sp2 = pt('spine2'), chest = pt('chest'), neck = pt('neck'), head = pt('head'), top = pt('headTop'), face = pt('faceF'), chestF = pt('chestF');\n    const fwdC = norm3(sub3(chestF, chest)), fwdH = norm3(sub3(face, head));\n229:- **Controls:** stick or WASD walks; ✕ / E / Enter interacts; the mouse hovers (the person or mat highlights, a prompt shows) and clicks (walk there by `E.FlowField`, then interact). Clicking ground walks. Use `{ pick: thing }` on `r.actor`/`r.shape` and `r.pick(sx, sy)` for hover.\n305:Rigs are `E.Humanoid` (`weapon: null`). Player and Regulars `chibi`; instructors `build: 'heroic', limbW: 1.5, torsoW: 2.5, hair: 'bald'` (Alder `'ponytail'`) with every colour key in wood tones. Their ball joints: after `rig.draw`, in the same `r.actor`, for `kneeL kneeR elbowL elbowR shL shR`: `const w = rig.worldOffset(rig.J[k]), p = (rig.lastView || r.view).p(w[0], w[1], w[2]);` then `px.disc` radius 3 and radius 2 in two wood tones at `(ox + p[0], oy + p[1])`.\n310:const lib = Mocap.load(window.MOCAP.FITCLIPS);\n311:function makeRig(opts) {\n312:  const rig = new E.Humanoid(Object.assign({ weapon: null }, opts));\n313:  Mocap.drive(rig, lib);              // first\n328:rig.wob = [p.x, p.y];  rig.mocap = lib.sample(clip, t);   // rig.mocap = null to stop\n482:- **Ghost data:** `AIHub.send({ t: 'g', a: eventIndex, l: [x, y], p: phase, w: [wx, wy], s: score }, { reliable: false })` about 10 times a second. Draw only if `a` matches your current event. `r.actor(..., { alpha: .5 })`, name tag in seat colour. Names come from `info.players`, drawn with `E.font` only (never HTML). Limit: 20 messages/s.\n544:  rigs.js      makeRig, setBody and moves, Tare, Gerald, joints, cast\n624:| M1 | Lean, intent, devices, bots, Plate; `makeRig`; Tare and voice; studio scene; **Stork Stand** with Card and Results | Feels good on stick, keys and mouse. Bands hold. **Stop and tune here: it is the whole game** |\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_55","type":"reasoning","text":"**Defining data.js content**"}}
{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"mkdir -p 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests'; apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: PROGRESS.md\n@@\n-- [ ] Inspect and integrate the required engine and AI Hub.\n-- [ ] Implement the island, activities, story, saves, settings, and accessibility.\n+- [x] Fetch the required engine, mocap clips, and AI Hub client and harness.\n+- [ ] Integrate the engine and AI Hub.\n+- [ ] Implement the island, activities, story, saves, settings, and accessibility.\n@@\n - Use Playwright's WebKit as the available approximation of iOS Safari.\n+- The original handoff, motion sources, and hub client are in the development folder; \"'`vendor/fitclips.js` is the generated local clip set.\n*** Add File: Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/data.js\n+'\"'use strict';\n+\n+const GROUPS = {\n+  stillness: { name: 'Stillness', color: '#8dc4ad', light: '#e2f2e9', icon: '✳', description: 'A little room to breathe.' },\n+  strength: { name: 'Strength', color: '#e8ad8d', light: '#fceadf', icon: '✦', description: 'Find strength without the shouting.' },\n+  cardio: { name: 'Cardio', color: '#efc76f', light: '#fff3d1', icon: '♪', description: 'Move to your own very good beat.' },\n+  balance: { name: 'Balance', color: '#9fbde0', light: '#e9f1fc', icon: '◇', description: 'A gentle negotiation with gravity.' }\n+};\n+\n+const ACTIVITIES = [\n+  { id: 'stork', name: 'Stork Stand', group: 'stillness', day: 1, seconds: 45, kind: 'hold', icon: '✳', tagline: 'One leg. Many feelings.', instruction: 'Guide your dot into the moving ring and hold it there. Watch out for the gull.', clip: 'standing' },\n+  { id: 'sun', name: 'Sun Flow', group: 'stillness', day: 2, seconds: 80, kind: 'breath', icon: '☼', tagline: 'Five poses, one lovely breath.', instruction: 'Stay centered. Hold Space or a trigger as the circle grows; release as it shrinks.', clip: 'yoga' },\n+  { id: 'candle', name: 'Quiet Candle', group: 'stillness', day: 3, seconds: 60, kind: 'candle', icon: '♨', tagline: 'Out-still a candle.', instruction: 'Keep your dot steady to help the flame grow. Settle back into the ring to relight it.', clip: 'standing' },\n+  { id: 'squat', name: 'Squat Rail', group: 'strength', day: 1, seconds: 60, kind: 'rep', icon: '↕', tagline: 'Down to earth, back again.', instruction: 'Hold Space or a trigger to lower on the beat. Release to rise, and stay balanced.', clip: 'squat' },\n+  { id: 'push', name: 'Push-Up', group: 'strength', day: 2, seconds: 60, kind: 'rep', icon: '≋', tagline: 'The floor is very supportive.', instruction: 'Hold Space or a trigger to lower on the beat. Release to press up.', clip: 'pushup' },\n+  { id: 'lunge', name: 'Side Lunge', group: 'strength', day: 3, seconds: 60, kind: 'rep', icon: '↔', tagline: 'A step in the right direction. Or left.', instruction: 'Lean toward the highlighted side and hold Space on the beat, then release.', clip: 'lunge' },\n+  { id: 'step', name: 'Step Class', group: 'cardio', day: 1, seconds: 60, kind: 'step', icon: '♪', tagline: 'Meet the beat where it is.', instruction: 'Press the arrow or WASD matching each arriving arrow. A good rhythm is better than a perfect one.', clip: 'walk' },\n+  { id: 'hoop', name: 'Hoop Hips', group: 'cardio', day: 2, seconds: 60, kind: 'hoop', icon: '◎', tagline: 'A well-rounded workout.', instruction: 'Circle your lean to spin the hoop. Tap Q or E to catch a hoop tossed from that side.', clip: 'standing' },\n+  { id: 'jog', name: 'Coastal Jog', group: 'cardio', day: 3, seconds: 70, kind: 'jog', icon: '➜', tagline: 'The scenic route is the point.', instruction: 'Alternate J and K, or the triggers, to jog. Lean to steer around the cups.', clip: 'run' },\n+  { id: 'slalom', name: 'Slalom', group: 'balance', day: 3, seconds: 60, kind: 'slalom', icon: '⚑', tagline: 'A very polite downhill.', instruction: 'Lean left or right through the gates. Lean forward to speed up, back to slow down.', clip: 'standing' },\n+  { id: 'tray', name: 'Tray Service', group: 'balance', day: 1, seconds: 60, kind: 'tray', icon: '◌', tagline: 'Keep your olives to yourself.', instruction: 'Keep the tray level as you walk. The olives would prefer not to become airborne.', clip: 'walk' },\n+  { id: 'laundry', name: 'Laundry Line', group: 'balance', day: 2, seconds: 60, kind: 'rope', icon: '⌁', tagline: 'A fine line between socks.', instruction: 'Balance over the line, lean forward to walk, and collect the fluttering pegs.', clip: 'walk' }\n+];\n+\n+const DAY_INTROS = [\n+  'Welcome to the Institute for Gentle Improvement. We have been expecting you, in a very relaxed way.',\n+  'A new morning. The island has prepared absolutely no urgent emails.',\n+  'The sea is calm. Dennis is less calm, but is working on it.',\n+  'You have made space for yourself. The advanced mats have made space for you.',\n+  'It is the Gentle Games\"'! Participation is mandatory only for the gulls.'\"'\n+];\n+\n+const CAST = [\n+  ['Gertrude', 'I used to be competitive. Now I am competitively relaxed.'],\n+  ['Dennis', 'I brought a towel in case of a personal breakthrough.'],\n+  ['Marisol', 'A wobble is just your body writing in cursive.'],\n+  ['Young Kevin', 'I am called Young Kevin because the other Kevin has tenure.']\n+];\n+\n+const COLORS = ['#d98a68', '#e8b28d', '#8c573f', '#f1ccad', '#b87956', '#704638'];\n+const OUTFITS = ['#e98d78', '#79b9ac', '#e7b961', '#9b9dd1', '#638ca5', '#d77f9c'];\n+const clamp = (number, min, max) => Math.max(min, Math.min(max, number));\n+const escapeHTML = value => String(value).replace(/[&<>\\\"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;', \\\"'\\\": '&#39;' })[character]);\n+\n+function seeded(seed) {\n+  let state = seed >>> 0 || 1;\n+  return () => { state \"'^= state << 13; state ''^= state >>> 17; state ''^= state << 5; return (state >>> 0) / 4294967296; };\n+}\n*** End Patch\nPATCH'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"mkdir -p 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/tests'; apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: PROGRESS.md\n@@\n-- [ ] Inspect and integrate the required engine and AI Hub.\n-- [ ] Implement the island, activities, story, saves, settings, and accessibility.\n+- [x] Fetch the required engine, mocap clips, and AI Hub client and harness.\n+- [ ] Integrate the engine and AI Hub.\n+- [ ] Implement the island, activities, story, saves, settings, and accessibility.\n@@\n - Use Playwright's WebKit as the available approximation of iOS Safari.\n+- The original handoff, motion sources, and hub client are in the development folder; \"'`vendor/fitclips.js` is the generated local clip set.\n*** Add File: Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/data.js\n+'\"'use strict';\n+\n+const GROUPS = {\n+  stillness: { name: 'Stillness', color: '#8dc4ad', light: '#e2f2e9', icon: '✳', description: 'A little room to breathe.' },\n+  strength: { name: 'Strength', color: '#e8ad8d', light: '#fceadf', icon: '✦', description: 'Find strength without the shouting.' },\n+  cardio: { name: 'Cardio', color: '#efc76f', light: '#fff3d1', icon: '♪', description: 'Move to your own very good beat.' },\n+  balance: { name: 'Balance', color: '#9fbde0', light: '#e9f1fc', icon: '◇', description: 'A gentle negotiation with gravity.' }\n+};\n+\n+const ACTIVITIES = [\n+  { id: 'stork', name: 'Stork Stand', group: 'stillness', day: 1, seconds: 45, kind: 'hold', icon: '✳', tagline: 'One leg. Many feelings.', instruction: 'Guide your dot into the moving ring and hold it there. Watch out for the gull.', clip: 'standing' },\n+  { id: 'sun', name: 'Sun Flow', group: 'stillness', day: 2, seconds: 80, kind: 'breath', icon: '☼', tagline: 'Five poses, one lovely breath.', instruction: 'Stay centered. Hold Space or a trigger as the circle grows; release as it shrinks.', clip: 'yoga' },\n+  { id: 'candle', name: 'Quiet Candle', group: 'stillness', day: 3, seconds: 60, kind: 'candle', icon: '♨', tagline: 'Out-still a candle.', instruction: 'Keep your dot steady to help the flame grow. Settle back into the ring to relight it.', clip: 'standing' },\n+  { id: 'squat', name: 'Squat Rail', group: 'strength', day: 1, seconds: 60, kind: 'rep', icon: '↕', tagline: 'Down to earth, back again.', instruction: 'Hold Space or a trigger to lower on the beat. Release to rise, and stay balanced.', clip: 'squat' },\n+  { id: 'push', name: 'Push-Up', group: 'strength', day: 2, seconds: 60, kind: 'rep', icon: '≋', tagline: 'The floor is very supportive.', instruction: 'Hold Space or a trigger to lower on the beat. Release to press up.', clip: 'pushup' },\n+  { id: 'lunge', name: 'Side Lunge', group: 'strength', day: 3, seconds: 60, kind: 'rep', icon: '↔', tagline: 'A step in the right direction. Or left.', instruction: 'Lean toward the highlighted side and hold Space on the beat, then release.', clip: 'lunge' },\n+  { id: 'step', name: 'Step Class', group: 'cardio', day: 1, seconds: 60, kind: 'step', icon: '♪', tagline: 'Meet the beat where it is.', instruction: 'Press the arrow or WASD matching each arriving arrow. A good rhythm is better than a perfect one.', clip: 'walk' },\n+  { id: 'hoop', name: 'Hoop Hips', group: 'cardio', day: 2, seconds: 60, kind: 'hoop', icon: '◎', tagline: 'A well-rounded workout.', instruction: 'Circle your lean to spin the hoop. Tap Q or E to catch a hoop tossed from that side.', clip: 'standing' },\n+  { id: 'jog', name: 'Coastal Jog', group: 'cardio', day: 3, seconds: 70, kind: 'jog', icon: '➜', tagline: 'The scenic route is the point.', instruction: 'Alternate J and K, or the triggers, to jog. Lean to steer around the cups.', clip: 'run' },\n+  { id: 'slalom', name: 'Slalom', group: 'balance', day: 3, seconds: 60, kind: 'slalom', icon: '⚑', tagline: 'A very polite downhill.', instruction: 'Lean left or right through the gates. Lean forward to speed up, back to slow down.', clip: 'standing' },\n+  { id: 'tray', name: 'Tray Service', group: 'balance', day: 1, seconds: 60, kind: 'tray', icon: '◌', tagline: 'Keep your olives to yourself.', instruction: 'Keep the tray level as you walk. The olives would prefer not to become airborne.', clip: 'walk' },\n+  { id: 'laundry', name: 'Laundry Line', group: 'balance', day: 2, seconds: 60, kind: 'rope', icon: '⌁', tagline: 'A fine line between socks.', instruction: 'Balance over the line, lean forward to walk, and collect the fluttering pegs.', clip: 'walk' }\n+];\n+\n+const DAY_INTROS = [\n+  'Welcome to the Institute for Gentle Improvement. We have been expecting you, in a very relaxed way.',\n+  'A new morning. The island has prepared absolutely no urgent emails.',\n+  'The sea is calm. Dennis is less calm, but is working on it.',\n+  'You have made space for yourself. The advanced mats have made space for you.',\n+  'It is the Gentle Games\"'! Participation is mandatory only for the gulls.'\"'\n+];\n+\n+const CAST = [\n+  ['Gertrude', 'I used to be competitive. Now I am competitively relaxed.'],\n+  ['Dennis', 'I brought a towel in case of a personal breakthrough.'],\n+  ['Marisol', 'A wobble is just your body writing in cursive.'],\n+  ['Young Kevin', 'I am called Young Kevin because the other Kevin has tenure.']\n+];\n+\n+const COLORS = ['#d98a68', '#e8b28d', '#8c573f', '#f1ccad', '#b87956', '#704638'];\n+const OUTFITS = ['#e98d78', '#79b9ac', '#e7b961', '#9b9dd1', '#638ca5', '#d77f9c'];\n+const clamp = (number, min, max) => Math.max(min, Math.min(max, number));\n+const escapeHTML = value => String(value).replace(/[&<>\\\"']/g, character => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;', \\\"'\\\": '&#39;' })[character]);\n+\n+function seeded(seed) {\n+  let state = seed >>> 0 || 1;\n+  return () => { state \"'^= state << 13; state ''^= state >>> 17; state ''^= state << 5; return (state >>> 0) / 4294967296; };\n+}\n*** End Patch\nPATCH'","aggregated_output":"Success. Updated the following files:\nA Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/src/data.js\nM PROGRESS.md\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"printf '%s\\\\n' '--- engine exports ---'; tail -c 300 engine/my-3d2dge.js; printf '\\\\n%s\\\\n' '--- clip exports ---'; head -c 500 vendor/fitclips.js; printf '\\\\n%s\\\\n' '--- hub API ---'; rg -n 'hub\\\\.(time|rng|progress|result|connect|on|ready|answer|send)' vendor/session.js; printf '\\\\n%s\\\\n' '--- game loop ---'; rg -n 'scenes:|new .*Game|\\\\.start\\\\(' engine/examples engine/game/game.js | head -50; printf '\\\\n%s\\\\n' '--- handoff requirements ---'; sed -n '1,170p' ../TASK.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"printf '%s\\\\n' '--- engine exports ---'; tail -c 300 engine/my-3d2dge.js; printf '\\\\n%s\\\\n' '--- clip exports ---'; head -c 500 vendor/fitclips.js; printf '\\\\n%s\\\\n' '--- hub API ---'; rg -n 'hub\\\\.(time|rng|progress|result|connect|on|ready|answer|send)' vendor/session.js; printf '\\\\n%s\\\\n' '--- game loop ---'; rg -n 'scenes:|new .*Game|\\\\.start\\\\(' engine/examples engine/game/game.js | head -50; printf '\\\\n%s\\\\n' '--- handoff requirements ---'; sed -n '1,170p' ../TASK.md\"","aggregated_output":"--- engine exports ---\nath.min(255, base[0] + n + l)); D[o + 1] = Math.max(0, Math.min(255, base[1] + n + l)); D[o + 2] = Math.max(0, Math.min(255, base[2] + n * .7 + l)); D[o + 3] = 255;\n    }\n    g.putImageData(img, 0, 0); return cv;\n  }\n}\nE.Terrain = Terrain;\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);\n\n--- clip exports ---\n/* FITCLIPS: an animation set in my-3D2dge's readable format (written by the tools in tools/; clips may be edited by hand).\n * Mesh2Motion (CC0), Quaternius (CC0), CMU Graphics Lab Motion Capture Database (free for all uses)\n * 23 clips, 560 key poses. Played by src/mocap/mocap.js with src/mocap/readable.js. \"sources\" holds the proportions\n * each library was measured with; \"fit\" each clip's average and worst body-point error against its capture (mm).\n * my-3D2dge readable clip. Times in seconds\n--- hub API ---\n291:  hub.connect = function (opts) {\n321:  hub.ready = function () {\n328:  hub.answer = function (what) {\n334:  hub.on = function (type, fn) {\n352:  hub.send = function (data, opts) {\n382:  hub.time = function () {\n387:  hub.rng = function (label) {\n423:  hub.result = function (outcome) {\n458:  hub.progress = function (p) {\n\n--- game loop ---\nrg: engine/examples: No such file or directory (os error 2)\nengine/game/game.js:16:const game = new E.Game({ canvas: 'screen', res: 'snes', expand: true, view: 'iso', views: ['iso', 'threequarter'],   // expand: full screen at any shape (the HUD anchors to r.W, r.H)\nengine/game/game.js:126:game.start({ scenes: { title, play, end }, scene: 'title' });\n\n--- handoff requirements ---\nSOURCE: Wii Fit\n\nGenre: Pick the game genre(s) that best fit the source and would make the best game.\n\nPerspective: Pick the camera perspective(s) that best fit the genre and source and would make the best game.\n\nGame Title: A playful riff on SOURCE's name. Silently brainstorm 50 titles, then pick one with a real random number generator (e.g., run code).\n\nResearch: Whether and how much to research is your choice.\n\nPackage: For ease of deployment and sharing provide a single html file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-221356].html. Dependencies that can be downloaded do not have to be included in the html file if that is easier.\n\nTech Stack: Build on https://github.com/michaelcrosato/my-3d2dge/tree/main/dist/handoff. You may change anything in it, the engine included, and add whatever systems, art assets and animations the game needs. The rest of the tech stack is your choice.\n\nArt Direction: Use the engine’s native style as the base. Make new art assets for whatever makes the game feel like the source; the engine’s asset library is fine for generic props.\n\nAnimation: Use the engine’s native animation system as the base. Make new animations for whatever makes the game feel like the source.\n\nAudio: All music, sound effects and voices are written in code, with no audio files. Voices are Animalese/Simlish-style gibberish. Music is to be set to 10% volume by default.\n\nOnline: https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub\n\nWorking Environment and deliverable:\nCreate a subfolder called [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-221356] to keep all your dev files in. You can develop separate modules, then bundle into a single file [GameTitle-SOURCE-gpt-6.1-terra-max-20261104-221356].html in root when you’re done. You may use external CDN dependencies. Do not read files outside what you need: other agents work in the folders beside this one. They share this machine’s ports and processes too. Prefer file:// and the engine’s headless tools. If you need a server (the AI Hub harness does), bind 127.0.0.1 on a port the OS picks (`python3 -m http.server 0 --bind 127.0.0.1` prints it) and confirm the page is your game before trusting a result. Stop only processes you started, by their PID: never pkill, killall, fuser -k, or kill whatever holds a port.\n\nPerformance: Treat the performance budget as unlimited. Add as much detail, enemies, effects, lights, and shadows as the scene needs. Out of scope (handled later): FPS targets, optimization.\n\nTesting: Test as much as you like with headless tools: scripts that play the game and check its state, including a scripted playthrough of the whole game. Keep them behind one command that prints only failures and a one-line count, and rerun it only after changing the code it covers. Use screenshots only for what a script can’t check. Don’t use subagents or workflows to debate, review, judge or audit.\n\nEffort: Spend effort however you see fit.\n\n## This computer\nChecked 2026-11-04 20:05 (America/Vancouver) by node check-environment.mjs.\n\n- **Computer:** Worki9: 13th Gen Intel(R) Core(TM) i9-13900K, 32 cores, 20 GB RAM, 8 GB swap. Ubuntu 26.04.1 LTS on WSL2 (Linux 6.18.33.1-microsoft-standard-WSL2).\n- **Space:** 850 GB free in the home folder. /tmp: 9.8 GB, in memory (tmpfs), 8.2 GB free when checked.\n- **Display:** none for runs (they run with DISPLAY unset), so a headed browser needs xvfb-run.\n- **Browsers:** Playwright 1.63.0 for Python (from playwright.sync_api import sync_playwright), with Chromium 153.0 (WebGL 2, software-rendered; WebGPU, software-rendered, when started with --enable-unsafe-webgpu --enable-features=Vulkan --use-webgpu-adapter=swiftshader), Firefox 155.0 (WebGL 2, software-rendered), WebKit 26.6 (WebGL 2) already downloaded. Phone and tablet device profiles are built in.\n  WebGPU only works on a secure page: file:// or http://127.0.0.1. A WebGPU canvas can come out blank in a headless screenshot, so check the game's state instead.\n  For Node, `npm install playwright@1.63.0` in your folder uses the browsers already downloaded; another version downloads its own.\n  Playwright runs here with PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 (already set for runs): this OS isn't one it supports by name.\n- **Tools:** node 24.22.1, npm 11.19.1, python3 3.14.8, pip3 26.2.1, git 2.56.0, gh 2.46.0, curl 8.22.0, wget 1.25.0, jq 1.8.1, ffmpeg 9.0.2, ffprobe 9.0.2, sqlite3 3.53.4, zip 3.0, unzip 6.00, rustc 1.99.0, cargo 1.99.0, go 1.27.1, java 27, lighthouse 13.5.0, shot-scraper 1.12, xvfb-run, magick 7.1.2, esbuild 0.28.2, uv 0.12.23, tsc 7.0.2, wasm-bindgen 0.2.129.\n- **Rust:** rustup's toolchains 1.96.0, 1.98.1, stable; the wasm32-unknown-unknown target on 1.98.1.\n- **Not installed:** sox, bun, deno.\n- **Network:** internet works (github.com, registry.npmjs.org).\n- **Memory:** earlyoom is on: when memory runs out it ends the biggest browser, so \"Target closed\", \"page crashed\" or \"browser has been closed\" means memory ran out, not a bug in your game. Run fewer browsers at once rather than retrying.\n\n### What this computer doesn't have\n\nNo script can check these, so they're written by hand. Test with the stand-ins; anything that needs the real thing is checked as far as it can be here, never required.\n\n- **No physical controller.** Emulate one: replace navigator.getGamepads with a stub that returns a pad in the standard mapping (Playwright's add_init_script / addInitScript).\n- **No touch device.** Use Playwright's phone and tablet profiles, which have touch, and tap with page.touchscreen.\n- **Nobody to listen.** Check sound by what Web Audio produces: render it with an OfflineAudioContext, or read levels from an AnalyserNode.\n- **No second player.** Play multiplayer with two browser pages (or contexts) on this computer.\n- **No real iPhone or iPad.** WebKit with an iPhone profile is the closest; it isn't iOS Safari.\n- **No TV.** Judge the 10-foot view from screenshots at 1920×1080.\n\n### Sharing this computer\n\n- Other agents run here at the same time. Keep one or two browsers open at once, and close them when you're done.\n- Keep every file you make inside your own folder, not /tmp or a parent folder: /tmp is shared.\n- The browsers are already downloaded: don't run `playwright install` or `playwright install-deps`.\n- The system Python has Playwright and nothing else. For one (Pillow, numpy …), use uv: `uv run --with pillow python script.py`, adding `--with playwright==1.63.0` when the script drives a browser too (a newer Playwright can't find the browsers here).\n\n## Goal\n\nBuild an original game inspired by the source.\n\nScope\n\nCreate a feature-complete demo. Capture what makes the source distinctive (its world, characters, themes and tone) and turn it into the mechanics, pacing and UX of a great game. The demo must be long enough to show ALL features and gameplay mechanics so a player can clearly understand how the game plays and feels, and what they can and cannot do. Treat the demo as a complete, polished vertical slice. It should contain all the infrastructure, systems, and polish needed so the remainder of the game could later be built out with normal designer tools.\n\nInclude a dev mode, reachable from the pause menu, with the standard tools for testing the game quickly. Balance is key, so expose the most important gameplay variables as live sliders, with a reset to defaults.\n\nAttract Mode: After 10 seconds without input on the title/menu screen, start a looping AI-played demo or scripted replay (arcade/kiosk style); any input exits it. The AI (or replay) can be simple and may cheat freely (infinite health, ammo, abilities, no clip, etc). Its only job is to show as much of the demo as possible, the attract mode is not meant to balance the game.\n\nMultiplayer: Follow https://github.com/michaelcrosato/ai-hub/tree/main/lib/hub for multiplayer integration into ai-hub as well as for the game on its own.\n\nNarrative tone: Use a writing style similar to the source’s.\n\n## UI & UX: 10-Foot Controller-First Philosophy\nDesign the game around a PS5 DualSense (or any pad the browser reports in its standard mapping) played on a TV at 10 feet. With keyboard and mouse it's the same game on the same screens, not a separate desktop layout, but they should feel native, not like stand-ins for controller buttons. The keyboard uses the keys PC players expect for the genre. The mouse aims, looks, and clicks menu items and things in the world (hover moves the focus) wherever the genre uses it. On-screen prompts follow the input used last: PlayStation glyphs for the controller (with a Settings option to show Xbox glyphs, A B X Y, instead), keys and mouse buttons for keyboard and mouse.\n\nDo not use overly dense, web-style data screens.\n\nTouch-only devices: no touch controls; show \"Controller or keyboard required\" and the settings button. Let the attract mode run.\n\n## Done\nNo TODOs, placeholders, or stubbed features. The demo is complete.\n\n## Source Information\nCRITICAL: Put Source Information, Testing Feedback, Engine Feedback and Prompt Feedback in your chat reply and an in-game About/Credits screen. Write \"unknown\" for anything you can't confirm.\n- Date: 2026-11-04 22:13:56\n- Source: the work it's based on\n- Plan: the file name of the plan you were given to build from, or none\n- Genre and Perspective: genre and camera perspective used\n- Tech: stack, libraries/engines, with versions if applicable\n- Art Direction: style used\n- Animation: system used\n- Audio: music, sound effects and voice used\n- Online: network features used, or none\n- Testing: testing parameters allowed\n- Research: research done, or none\n- Environment: Codex CLI (headless); Linux\n- Model: OpenAI, gpt-6.1-terra, reasoning effort max\n- Usage: write \"added on import\". You can't see your own cost, so don't estimate it: the runner records the real cost, tokens and time, and the agent that imports the game into AI Hub puts them on your About/Credits screen.\n\nExit interview: before you finish, also save these answers as exit-interview.json in this folder's root, beside the game's .html: one JSON object in exactly the shape below, every value filled in (\"unknown\" for anything you can't confirm). Tools read it (the game's run record and the AI Hub catalogue), so write plain text, and check that the file parses as JSON.\n{\n  \"sourceInformation\": {\"date\": \"\", \"source\": \"\", \"plan\": \"\", \"genre\": \"\", \"perspective\": \"\", \"tech\": \"\", \"artDirection\": \"\", \"animation\": \"\", \"audio\": \"\", \"online\": \"\", \"testing\": \"\", \"research\": \"\", \"environment\": \"\", \"model\": \"\", \"usage\": \"added on import\"},\n  \"testingFeedback\": [\"your answer to each Testing Feedback question, in order\"],\n  \"engineFeedback\": [\"your answer to each Engine Feedback question, in order\"],\n  \"promptFeedback\": [\"your answer to each Prompt Feedback question, in order\"],\n  \"aiHub\": {\n    \"name\": \"the game's title, as on its title screen\",\n    \"tagline\": \"a few words to go under the title\",\n    \"description\": \"one or two sentences for the catalogue\",\n    \"type\": \"Game, Tech demo or Tool\",\n    \"genre\": \"one of Action, Adventure, Fighting, Flight, Horror, Kids & Learning, Life Sim, Platformer, Puzzle, Racing, RPG, Shooter, Simulation, Sports, Stealth, Strategy\",\n    \"source\": \"the work it's based on, e.g. Moby-Dick\",\n    \"series\": \"its franchise, e.g. Star Fox, or empty\",\n    \"players\": \"how many can play: 1, 1–2 or 1–4\",\n    \"controls\": \"the controls, in one line\",\n    \"tags\": [\"3 to 6 lowercase tags, e.g. 2d, 3d, arcade, story, co-op, versus, first-person, third-person, top-down, side-scrolling, pixel art, low-poly, retro, sci-fi, fantasy, comedy, vehicles, boss fights, exploration\"]\n  }\n}\nThe catalogue's model, effort, CLI, date and usage come from the run's record after you finish, so they aren't asked here.\n\nTesting Feedback\n\n- How many issues did testing catch?\n- How many would be considered critical issues / game breaking?\n- What was the most helpful test you ran?\n- What was the least helpful test you ran?\n\nEngine Feedback\n\n- What did you like most about the engine?\n- Did you get stuck or guess wrong?\n- What was the most important thing you had to build yourself?\n- What was the hardest part about using the engine?\n- What did you change in the engine, and why? (none if nothing)\n- If you could change one thing about the engine, what would it be?\n\nPrompt Feedback\n\n- What did you like most about this prompt?\n- What was confusing?\n- What was the hardest thing to do?\n- What would you change in this prompt?\n","exit_code":0,"status":"completed"}}
