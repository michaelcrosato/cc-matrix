this.bw, this.bh);\n2213:      else { g.fillStyle = g === this.ctx ? this.game.o.bg : '#000'; g.fillRect(0, 0, this.bw, this.bh); }\n2220:    const game = this.game, g = this.ctx, gpu = this.gpu, iG = this._iG, vp = this._vp;\n2308:class Game {\n2430:    this.booted = Promise.resolve(this);\n2493:  /** the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an\n2794:    let res; this.booted = new Promise(r => { res = r; });\n3724: *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\n3755: *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\n3756:Game.prototype.allowJoin = function (o = {}) {\n3776:  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\n4052:class Humanoid {\n7744:    this._game = game; this._signal = signal; this.ctx = null; this.volume = .7; this.sfxVolume = 1; this.musicVolume = .5; this.voiceVolume = 1; this.muted = false;\n7758:    if (this.ctx || this.failed) return this.ctx;\n7761:      const c = this.ctx = new AC();\n7773:    return this.ctx;\n7776:  get ready() { return !!this.ctx && this.ctx.state === 'running'; }\n7778:  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || this.ducked ? .35 : 1); this._voiceBus.gain.value = this.voiceVolume; }\n7792:  _background(sleep) { const c = this.ctx; if (!c) return; try { if (sleep && c.state === 'running') { this._slept = true; c.suspend().catch(() => {}); } else if (!sleep && this._slept) { this._slept = false; c.resume().catch(() => {}); } } catch (e) { /* closed */ } }\n7800:    return (this._waves[duty] = this.ctx.createPeriodicWave(re, im));\n7804:    const c = this.ctx, wave = p.wave || 'square', dur = Math.max(.012, p.dur || .15), vol = p.vol === undefined ? .3 : p.vol, att = p.attack === undefined ? .004 : p.attack;\n7843:    if (this.ctx.state !== 'running') return H;\n7844:    const c = this.ctx, now = c.currentTime;\n7929:    if (t.gain && this.ctx) { const g = t.gain.gain, n = this.ctx.currentTime; g.cancelScheduledValues(n); g.setValueAtTime(g.value, n); g.linearRampToValueAtTime(C.vols[t.i], n + Math.max(.01, fade)); }\n7940:    if (C && C.bus && this.ctx && C.anchor) { const g = C.bus.gain, a = Math.max(this.ctx.currentTime, C.anchor.ctx + (t - C.anchor.clk)), b = a + S.len * S.spb; g.setValueAtTime(g.value, a); g.linearRampToValueAtTime(o.duck === undefined ? .4 : o.duck, a + .05); g.setValueAtTime(o.duck === undefined ? .4 : o.duck, b); g.linearRampToValueAtTime(1, b + .2); }\n7973:    const c = this.ctx, bus = c.createGain(); bus.connect(this._musBus); C.bus = bus;\n7980:    if (!S || !S.bus || !this.ctx) return;\n7981:    const c = this.ctx, n = c.currentTime, f = Math.max(.02, fade || .06), bus = S.bus, g = bus.gain;\n7987:    const c = this.ctx; if (!c || c.state !== 'running') return;\n7996:    const c = this.ctx, now = this._clockNow(C);\n8011:    const C = this.song, c = this.ctx; if (!C || !C.anchor || !c || c.state !== 'running' || (C.sync && (g.paused || g.hitstop > 0))) return;\n9109:class Dialog {\n9233:      if (this.name) { const nw = E.font.width(this.name) + 12, nx = d.x + (this.portrait ? d.tx - 6 : 4); ui.box(g, nx, d.y - 12, nw, 14, { bg: this.bg, border: this.border }); E.font.text(g, this.name, nx + 6, d.y - 9, this.nameColor, { outline: false, shadow: '#05040a' }); }\n9235:      const mk = this._fx && this._fx[this.i], o = { outline: false, shadow: '#05040a' };\n9256:        this.choices.forEach((c, k) => { E.font.text(g, c, cx + 13, cy + 4 + k * d.lh, k === this.choice ? this.nameColor : this.color, { outline: false, shadow: '#05040a' }); if (k === this.choice && blink) E.font.text(g, '▸', cx + 5, cy + 4 + k * d.lh, this.nameColor, false); });\n9320:      const { labels, w, h, x, y, top: yy, rowH, k: K, first, vis } = this._layout(), T = { outline: false, shadow: '#05040a', scale: K };\n9322:      if (this.title) E.font.text(g, this.title, x + w / 2, y + 5 * K, this.pick, { align: 'center', outline: false, shadow: '#05040a', scale: K });\ntests/hub/round.js:307:    // A player who sat out is still at the hub: tell their game it is over for them.\ntests/hub/bridge.js:4: * A game speaks the AI Hub Session Protocol over postMessage (lib/hub/README.md).\ntests/hub/bridge.js:82:  const toGame = (msg) => post({ aihub: 1, ...msg });\ntests/hub/bridge.js:276:export const postTo = (frame) => (msg) => frame.contentWindow?.postMessage(msg, '*');\ntests/hub/harness.html:102:      session: meta('hub:session'),\ntests/hub/harness.html:103:      players: meta('hub:session-players'),\ntests/hub/harness.html:104:      mode: meta('hub:session-mode'),\ntests/hub/harness.html:105:      minutes: meta('hub:session-minutes'),\ntests/hub/harness.html:204:    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\ntests/hub/harness.html:421:    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\ntests/hub/harness.html:424:    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\ntests/hub/harness.html:425:    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n229:- **Controls:** stick or WASD walks; ✕ / E / Enter interacts; the mouse hovers (the person or mat highlights, a prompt shows) and clicks (walk there by `E.FlowField`, then interact). Clicking ground walks. Use `{ pick: thing }` on `r.actor`/`r.shape` and `r.pick(sx, sy)` for hover.\n305:Rigs are `E.Humanoid` (`weapon: null`). Player and Regulars `chibi`; instructors `build: 'heroic', limbW: 1.5, torsoW: 2.5, hair: 'bald'` (Alder `'ponytail'`) with every colour key in wood tones. Their ball joints: after `rig.draw`, in the same `r.actor`, for `kneeL kneeR elbowL elbowR shL shR`: `const w = rig.worldOffset(rig.J[k]), p = (rig.lastView || r.view).p(w[0], w[1], w[2]);` then `px.disc` radius 3 and radius 2 in two wood tones at `(ox + p[0], oy + p[1])`.\n310:const lib = Mocap.load(window.MOCAP.FITCLIPS);\n313:  Mocap.drive(rig, lib);              // first\n419:**Touch-only devices.** ✔ `new E.Game({ touch: 'never' })` shows exactly \"Controller or keyboard required\" with a Settings button and no touch controls; the CSS above lets the attract mode show behind it. Attract runs after 10 s as usual (taps produce no actions, so it stays running).\n462:const game = new E.Game({ canvas: 'screen', id: 'GAMEID', res: 'ps1', expand: true, touch: 'never', input: INPUT,\n468:  if (!info) return game.go('title');\n482:- **Ghost data:** `AIHub.send({ t: 'g', a: eventIndex, l: [x, y], p: phase, w: [wx, wy], s: score }, { reliable: false })` about 10 times a second. Draw only if `a` matches your current event. `r.actor(..., { alpha: .5 })`, name tag in seat colour. Names come from `info.players`, drawn with `E.font` only (never HTML). Limit: 20 messages/s.\n580:8. In tests, `game.fadeTime = 0`; `game.go` otherwise delays the new scene .22 s.\n631:| M8 | Full attract, full Dev Mode with Pose Viewer, About screen, tier 2s, Comfort, polish pass (particles, stamps, rumble, transitions: `game.go` with `fade: 'iris'`) | All groups green |\n","exit_code":0,"status":"completed"}}
