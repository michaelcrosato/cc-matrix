{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"sed -n '2308,2348p;2708,2730p;2838,2870p;4052,4108p' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/engine/my-3d2dge.js'; sed -n '1,125p' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/vendor/mocap.js'; rg -n '\\\"(name|id)\\\"|111_39' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/vendor/fitclips.js' | head -4; sed -n '1,140p' PLAN.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"sed -n '2308,2348p;2708,2730p;2838,2870p;4052,4108p' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/engine/my-3d2dge.js'; sed -n '1,125p' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/vendor/mocap.js'; rg -n '\\\"(name|id)\\\"|111_39' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/vendor/fitclips.js' | head -4; sed -n '1,140p' PLAN.md\"","aggregated_output":"class Game {\n  /**\n   * new E.Game({ canvas, view, views, res, expand, input, bg, step: 1 / 120, loop: true, headless: false, menu,\n   * fullscreen: 'tap', corner: true, backGesture: true, autoPause: true, live: false, id, pace, camera }). The standard features\n   * (section 10b) every game gets: menu, fullscreen, corner, backGesture, autoPause.\n   * - res: a fixed resolution ('ps1' or [w, h]), whole pixels\n   * - expand: true makes res the least the screen shows and grows the picture to fill the window, any shape, no bars\n   *   (expand: { maxW, maxH } stops it growing there)\n   * - bg: the color behind everything, or null: the canvas is clear, and the game draws its HUD and menus over a picture\n   *   under it (a 3D world, engine/my-3d2dge-3d.js)\n   * - headless: no screen, renderer, sound or DOM input (tests, tools, a simulation in Node, where it is the default):\n   *   scenes update and draw is skipped; drive it with advance() and input.press / release / tap / hold\n   * - draw: true (headless): draw runs each advance on a stand-in renderer, its errors in game.errors\n   * - loop: false makes a game in a page that runs only by advance()\n   * - menu: the pause, settings and controls screens ({ items, settings, controls, quit } adjusts them, false leaves them out)\n   * - fullscreen: 'tap' (a phone goes full screen at its first tap and when a game starts, unless the player turned it\n   *   off), 'button' (only when asked) or false\n   * - corner, backGesture: corner: the menu and full-screen buttons (top right); backGesture: a\n   *   phone's back steps back in the game first (false: it leaves the page)\n   * - autoPause: a pausable scene pauses when the page is hidden or loses focus\n   * - live: true: a world that never stops for one player (online, a shared screen): a pause opens the menus over it,\n   *   the scene's update goes on (game.paused says a menu is up) and the menu holds that player's input back\n   * - id: the name the player's settings are saved under (the page's path)\n   * - pace: false draws every refresh of a fast display even when the frames can't keep up (by default it draws every\n   *   other one, evenly), unless the player picks Frame rate 60\n   * - camera: the camera of every scene without its own (a scene's camera option: the player's zoom, start)\n   */\n  constructor(o = {}) {\n    o = Object.assign({}, o);\n    /** true for a game with no display (o.headless, or no DOM: Node) */\n    this.headless = !!o.headless || typeof document === 'undefined';\n    if (this.headless) o.canvas = null;\n    else {\n      if (typeof o.canvas === 'string') o.canvas = document.getElementById(o.canvas.replace(/^#/, '')) || document.querySelector(o.canvas);\n      if (!o.canvas) o.canvas = document.getElementById('screen') || document.querySelector('canvas') || Game._makeCanvas();\n    }\n    if (typeof o.input === 'string') o.input = Input[o.input.toUpperCase()] || (warn('input:' + o.input, 'unknown input preset \"' + o.input + '\" (use DEFAULT, PLATFORMER or SHMUP)'), Input.DEFAULT);\n    /** o: the options the game was made with, the defaults filled in (view, res, expand, minW, minH, maxW, maxH, bg,\n     *  step, input, loop, headless) */\n    this.o = Object.assign({ view: 'iso', minH: 190, minW: 300, maxW: 560, maxH: 330, bg: '#07060d', step: 1 / 120, input: Input.DEFAULT, loop: !this.headless }, o);\n    // every listener the engine adds to the window, the document, the canvas and its buttons goes through this: dispose() removes them all\n  /**\n   * Start the loop. Either one scene:  game.start({ update(dt), draw(r) })\n   * or several:  game.start({ scenes: { title: {...}, play: {...} }, scene: 'title' })\n   * A scene is { enter(data), exit(), update(dt), draw(r), back(), pausable, view, views, input, res, expand, touch, camera }\n   * (all optional). start() with nothing resumes a stopped loop. A headless game, or one made with loop: false, runs only\n   * by advance().\n   * - view, views, input, res, expand, touch: a scene's, applied when it starts: input ('PLATFORMER'), res ('snes'),\n   *   expand (true), touch (['jump', 'attack']); res and expand stay until another scene sets them\n   * - back: a scene's back() takes a phone's back gesture (game.back()) first: return true when it went back somewhere (a\n   *   sub-menu closed)\n   * - camera: a scene's { zoom: [.75, 2], start: 1, tall: 1.5, wheel: true }: the player zooms the camera within zoom (the\n   *   wheel, - and =, a pinch, Settings, Camera zoom: theirs, kept, on top of the game's; false or none: they can't; a\n   *   function of the game: a range per screen shape, g => [g.upright ? 1 : .85, 2]), from start, the zoom it starts at\n   *   (tall: on a screen held upright, game.upright; 1 without); wheel: false leaves the mouse wheel to the game\n   * - boot: { title, version, steps: [[label, fn]], messages, min, checks, accent } runs the boot first (section 10c): the\n   *   steps one a frame behind the boot screen (all at once when headless or loop: false); boot: false hides a splash\n   */\n  start(hooks) {\n    if (hooks && hooks.boot !== undefined && !this._booting) return this._boot(hooks);\n    if (hooks !== undefined || !this._hooks) {\n      if (!hooks || typeof hooks !== 'object') throw new Error('game.start needs { update(dt), draw(r) } or { scenes: { name: { update, draw } }, scene: \"name\" }');\n      this._hooks = hooks;\n      if (hooks.scenes) {\n   * headless runs (advance(1) is 120 updates). o.draw: then draw one frame (not in a headless game). A headless game made\n   * with draw: true draws one frame each advance, on a stand-in renderer, so a draw error lands in game.errors (a test\n   * that catches what a player would see break). Returns the updates run\n   */\n  advance(seconds = this.o.step, o = {}) {\n    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n    this._acc += Math.max(0, seconds);\n    const n = this._steps(); this.stats.steps = n;\n    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n    return n;\n  }\n  /**\n   * the clock: an exact fixed step. Real time (at most 50 ms a frame, so a stall can't run away) fills an accumulator;\n   * each whole o.step of it (1/120 s) runs one update of o.step * timeScale game seconds (split in two or more when\n   * timeScale > 1, so no step is longer than o.step), and the remainder waits for the next frame (game.alpha = its\n   * fraction of a step). 60 Hz runs two steps a frame, 120 Hz one, 144 Hz one on most frames: the same steps at any rate.\n   * Slow motion makes steps shorter, never fewer. Paused or at timeScale 0 the steps still run (dt 0), so input ticks.\n   * The first frame always updates (with dt 0 when its time is short of a step), so draw never comes before update.\n   * Returns the updates run\n   */\n  _run(real) { this._acc += Math.min(.05, real); return this._steps(); }\n  /** run the whole steps the accumulator holds (see _run) */\n  _steps() {\n    const step = this.o.step; let n = 0;\n    try {\n      while (this._acc > step - 1e-9) {   // (the tolerance absorbs the rounding in frame times: 1/60 s is two steps)\n        this._acc -= step; this._wall += step;   // (_wall: seconds stepped through, unscaled: slow motion or a stop doesn't hold up the player's zoom)\n        const k = this.timeScale > 1 ? Math.ceil(this.timeScale - 1e-9) : 1, h = step * Math.max(0, this.timeScale) / k;\n        for (let i = 0; i < k; i++, n++) this._step(h);\n      }\n      if (!n && !this._stepped) { n++; this._step(0); }   // the first frame updates before it draws, even when its time is short\n    } catch (e) { this._acc %= step; this.fail('update', e); }   // an error drops the frame's other steps, as before\n    if (n) this._stepped = true;\nclass Humanoid {\n  /** new E.Humanoid({ size: 1.3, build, weapon, outfit, hair, hat, sleeves, armor, hood, cape, colors, ... }): a\n   *  character rig posed from math every step (API.md, \"Characters\", lists the options); update(dt, state) each\n   *  step, draw(g, ox, oy, view) inside r.actor. hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed' (or { style,\n   *  color }; E.Humanoid.hat adds one); weapon: 'sword' | 'gun' | 'staff' (E.Humanoid.weapon adds one); hood: true\n   *  (drawn in colors.hair); draw: { under(g, Q, rig), over(g, Q, rig) } the game's own drawing before and after the body\n   *  (Q: the joints on screen, [x, y, depth]: outfits, accessories); seed: its own random stream (blinks, its clock) */\n  constructor(o = {}) {\n    if (o.build && !BUILDS[o.build]) warn('build:' + o.build, 'Humanoid build \"' + o.build + '\" is unknown (chibi, heroic, bulky, skeleton)');\n    o = Object.assign({}, BUILDS[o.build] || {}, o);\n    /** o: its options, with the build's proportions and the defaults filled in (size, build, weapon, outfit, ...;\n     *  legUpper, torso, headR and the other lengths are at size 1) */\n    this.o = Object.assign({\n      legUpper: 6, legLower: 6, hipZ: 11.6, hipHalf: 1.9, footSpread: 1.9, torso: 8, shoulderHalf: 3.3, neck: 1.2, headR: 3.4,\n      armUpper: 4.6, armLower: 4.6, limbW: 2, torsoW: 3, lean: 0, hunch: 0, stride: 6.5, lift: 3.4, swing: 4, speedRef: 70,\n      weapon: 'sword', bladeLen: 11, cape: null, hood: false, eyeGlow: null, hat: null,\n      style: 'hd', size: 1, hair: 'short', outfit: 'shirt', sleeves: 'short', armor: false, cheat: .5\n    }, o);\n    /** trail: recent points of the blade (or fist) tip, for the swing's smear */\n    this._cheat = 0; this.trail = [];\n    if (typeof this.o.hair === 'string' || !this.o.hair) this.o.hair = { style: this.o.hair || 'short' };\n    /** hairPts: the long hair's simulated points (null until it has some) */\n    this._hairPts = null;\n    if (this.o.weapon && !HUMANOID_WEAPONS[this.o.weapon]) { warn('weapon:' + this.o.weapon, 'Humanoid weapon \"' + this.o.weapon + '\" is not on E.Humanoid.weapons (sword, gun, staff, a game\\'s own by E.Humanoid.weapon(id, spec), or null); drawing a sword'); this.o.weapon = 'sword'; }\n    if (typeof this.o.hat === 'string') this.o.hat = { style: this.o.hat };\n    /** C: its colors (skin, hair, cloth, pants, boot, belt, cape, capeIn, metal, hilt, eye, ...), the defaults with\n     *  o.colors over them; change one and it shows at the next draw */\n    this.C = Object.assign({}, HUMAN_COLORS, o.colors || {});\n    const C = this.C;\n    if (this.o.skeleton) C.skin = C.pants = C.boot = C.glove = C.bone || '#e6dfc8';\n    C.clothDk = C.clothDk || shade(C.cloth, -.3); C.clothLt = C.clothLt || shade(C.cloth, .25);\n    C.pantsDk = C.pantsDk || shade(C.pants, -.3); C.bootDk = C.bootDk || shade(C.boot, -.3); C.skinDk = C.skinDk || shade(C.skin, -.2);\n    this._rnd = rng(o.seed !== undefined ? o.seed : Math.floor(Math.random() * 2147483647) + 1);   // (its own stream: o.seed, else one draw of Math.random; its blinks never draw from Math.random)\n    /** t: seconds of its own clock (idle breathing, blinks); phase: the walk cycle's phase, radians; mv: the last\n     *  ground direction it moved, a unit vector; hurtW: 0..1, how far into the hurt flinch */\n    this.t = this._rnd() * 10; this.phase = 0; this._spW = 0; this._mv = [1, 0]; this._dashW = 0; this.hurtW = 0; this._atkW = 0;\n    /** atkZ: the height of the weapon hand during an attack; reach: how far it reaches forward; spin: the body's\n     *  extra turn during a spinning move, radians */\n    this._theta = 1.2; this.atkZ = 10; this.reach = 7; this._twist = 0; this.spin = 0; this._atkLean = 0;\n    /** sq: squash and stretch, -0.45..0.45 (kick adds to it); sqV: its speed; blink: seconds to the next blink;\n     *  facing: the angle it faces, radians; x, y, z: where its feet are (from the last update); J: its joints this\n     *  step in its own frame ({ hipL, kneeL, footL, shC, head, handR, ... }; rig.worldOffset(J.handR) gives one in\n     *  the world); smear: the swing's smear arc, or null */\n    this.sq = 0; this.sqV = 0; this.blink = 2; this.facing = 0; this.x = 0; this.y = 0; this.z = 0; this.J = {}; this._smear = null;\n    /** capeL: the cape's left edge points (null until it has a cape and has moved) */\n    this.capeL = null; this._airW = 0; this._pointW = 0; this._kicking = false;\n    this.solvePose();\n  }\n  /** a squash-and-stretch kick: + stretches (a jump), - squashes (a landing, a hit) */\n  kick(v) { this.sqV += v; }\n  /** a heavy landing: knees bend deep and spring back over a moment; strength 1 or more drops a hand to the ground\n   *  (a three-point landing), .3-.6 is a soft one. Call it on the step the body lands */\n  land(strength = 1) { this._landT = 0; this._landK = clamp(strength, 0, 1.5); this.kick(-1.5 * Math.min(1, strength)); }\n  /** how much a stride stretches: shorter while sneaking, longer while sprinting */\n  _strideK() { return 1 - .35 * (this._sneakW || 0) + .25 * (this._sprintW || 0); }\n  /** the roll (state flip: u 0..1, a forward somersault about the hips, tucked in the middle): turns every joint, and the\n   *  cape and hair for this step's drawing only (the next update puts them back before they simulate, so they never\n/* =============================================================================\n * MOCAP  plays animation sets in the readable format (src/mocap/readable.js; written by tools/anim-import.mjs) on\n * my-3D2dge rigs.\n *   const lib = Mocap.load(window.MOCAP.QUATERNIUS);   // a set: its clips, and the bodies they were measured on\n *   const clip = lib.clip('Dance_Loop');               // { name, dur, loop, tags, desc, keys }\n *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n *   const man = new Mocap.Mannequin(lib, { height: 34 });  man.draw(g, ox, oy, view, pose, facing)\n *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n *     window.Mocap.)\n *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n *     only the chest, head and arms over the rig's own legs (an interaction while walking); humanoid.mocapBlade = true\n *     while the clip holds a sword (the blade follows the fist).\n * Points are in the rig's local frame: f = forward, r = right, z = up, centred on the root on the ground.\n * ============================================================================= */\nconst Mocap = (() => {\n'use strict';\nconst E = My3D2dge, { px } = E, MR = MocapReadable;\n\n/* ---- sets ---- */\n/**\n * Every clip is rebuilt on the first library's proportions (the format does not depend on size); each keeps how its own\n * library bends the spine, since the key poses were measured that way.\n */\nfunction load(set) {\n  const P = MR.P, idx = MR.IDX, ids = Object.keys(set.sources), base = set.sources[ids[0]].rest, rests = {};\n  for (const id of ids) rests[id] = Object.assign({}, base, { spineW: set.sources[id].rest.spineW, neckW: set.sources[id].rest.neckW });\n  const meta = c => ({ name: c.clip, fps: set.fps, n: Math.round(c.dur * set.fps) + 1 }), clips = {};\n  for (const [name, c] of Object.entries(set.clips)) clips[name] = Object.assign(meta(Object.assign({ clip: name }, c)), c);\n  const restOf = c => rests[c.src] || base;\n  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n  lib.clip = name => clips[name] || null;\n  /** the pose at time t (seconds): key poses in-betweened, loops wrap, one-shots hold their last pose */\n  lib.sample = (clip, t, out = new Float32Array(P * 3)) => { MR.pose(restOf(clip), clip, t, out); out.src = clip.src; return out; };   // (src: whose rest it is measured against)\n  /** a clip that travels: how far it has carried the body at time t ([forward, right] mm), or null */\n  lib.moveAt = (clip, t) => MR.moveAt(restOf(clip), clip, t);\n  /** swap in an edited clip (readable text a person or a model changed); the original is kept for restore() */\n  const originals = {};\n  lib.replace = (name, edited) => { if (!originals[name]) originals[name] = clips[name]; clips[name] = Object.assign({}, originals[name], edited, { name, keys: edited.keys }); return clips[name]; };\n  lib.restore = name => { if (originals[name]) { clips[name] = originals[name]; delete originals[name]; } return clips[name]; };\n  lib.edited = name => !!originals[name];\n  /** the clip as the text a model reads (its header and its key poses) */\n  lib.text = clip => { const o = { clip: clip.clip || clip.name }; for (const k of ['src', 'take', 'orig', 'dur', 'loop', 'tags', 'desc']) if (clip[k] !== undefined) o[k] = clip[k]; o.keys = clip.keys; return MR.text(o); };\n  /** where a clip came from: its library's label, origin and license (from the set's sources), the clip it was made from,\n   *  and (a capture database's) the take and the stretch of it: '13_29 2.30-3.42' */\n  lib.origin = clip => { const s = set.sources[clip.src] || {}; return { src: clip.src, label: s.label || clip.src, origin: s.origin || '', license: s.license || '', url: s.url || '', orig: clip.orig || null, take: clip.take || null }; };\n  /** a pose blended from a to b (crossfades between clips) */\n  lib.blend = (a, b, k, out = new Float32Array(P * 3)) => { for (let i = 0; i < P * 3; i++) out[i] = a[i] + (b[i] - a[i]) * k; out.src = (k < .5 ? a : b).src; return out; };\n  lib.pt = (pose, name) => { const i = idx[name] * 3; return [pose[i], pose[i + 1], pose[i + 2]]; };\n  lib.error = MR.error;\n  return lib;\n}\n\n/* ---- the look-alike mannequin: shaded capsules in the source model's proportions, with its joint bands ---- */\nconst lerp3 = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\nconst add3 = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];\nconst sub3 = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\nconst norm3 = a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\nclass Mannequin {\n  /** o: { height: world units tall (34), main: '#e8aa3a', joint: '#aa66db' } (the colors of the source model's two materials) */\n  constructor(lib, o = {}) {\n    this.lib = lib; this.o = Object.assign({ height: 34, main: '#e8aa3a', joint: '#aa66db' }, o);\n    this.k = this.o.height / ((lib.body && lib.body.height) || 1829);   // world units per mm\n    this._ops = [];\n  }\n  /**\n   * draw the pose into g with (ox, oy) = the projected root. Every part is a capsule between two body points,\n   * sorted by true camera depth, drawn dark-then-lit like the engine's HD rigs.\n   */\n  draw(g, ox, oy, view, pose, facing = 0) {\n    const L = this.lib, o = this.o, k = this.k, ca = Math.cos(facing), sa = Math.sin(facing), sc = view.scale;\n    const pt = name => L.pt(pose, name);\n    const S = p => { const wx = (p[0] * ca - p[1] * sa) * k, wy = (p[0] * sa + p[1] * ca) * k, wz = p[2] * k; return [ox + view.ax * wx + view.ay * wy, oy + view.bx * wx + view.by * wy + view.bz * wz, view.dx * wx + view.dy * wy + view.dz * wz]; };\n    const R = mm => mm * k * sc;   // a radius in mm -> screen pixels\n    const ops = this._ops; ops.length = 0;\n    const main = E.tones(o.main), joint = E.tones(o.joint);\n    // centre depth of the body: parts behind it are drawn a touch darker (the far arm and leg)\n    const mid = S(pt('spine1'))[2];\n    const capsule = (A, B, ra, rb, col, dx = 0, dy = 0) => {\n      const ax = A[0] + dx, ay = A[1] + dy, bx = B[0] + dx, by = B[1] + dy, vx = bx - ax, vy = by - ay, l = Math.hypot(vx, vy);\n      if (l > .01) { const nx = -vy / l, ny = vx / l; px.poly(g, [[ax + nx * ra, ay + ny * ra], [bx + nx * rb, by + ny * rb], [bx - nx * rb, by - ny * rb], [ax - nx * ra, ay - ny * ra]], col); }\n      px.disc(g, ax, ay, Math.max(.5, ra - .3), col); px.disc(g, bx, by, Math.max(.5, rb - .3), col);\n    };\n    // a shaded part: dark silhouette, the base color shifted toward the light (upper left), a soft highlight\n    const part = (a, b, ra, rb, T, bias = 0) => {\n      const A = S(a), B = S(b), pa = R(ra), pb = R(rb), far = (A[2] + B[2]) * .5 < mid - 2 * k * 60;\n      ops.push({ d: (A[2] + B[2]) * .5 + bias, f: () => {\n        capsule(A, B, pa, pb, far ? T.deep : T.sh);\n        capsule(A, B, Math.max(.5, pa - .9), Math.max(.5, pb - .9), far ? T.sh : T.base, -.5, -.6);\n        if (pa > 2.2 && !far) capsule(A, B, pa * .32, pb * .32, T.lt, -pa * .38, -pa * .42);\n      } });\n    };\n    // a ring painted round a limb (the second material): a straight-edged stripe across the capsule, no round ends,\n    // so a thin band reads as a band from every side. Seen end-on (the limb points at the camera) it is hidden.\n    const band = (a, b, t0, t1, ra, rb, T) => {\n      const A = S(lerp3(a, b, t0)), B = S(lerp3(a, b, t1)), axis = S(a), end = S(b), vx = end[0] - axis[0], vy = end[1] - axis[1], l = Math.hypot(vx, vy);\n      if (l < R(Math.max(ra, rb)) * .5) return;\n      const nx = -vy / l, ny = vx / l, wa = R(ra + (rb - ra) * t0) + .2, wb = R(ra + (rb - ra) * t1) + .2;\n      ops.push({ d: (axis[2] + end[2]) * .5 + .02, f: () => {\n        const q = (w0, w1, dx, dy) => [[A[0] + nx * w0 + dx, A[1] + ny * w0 + dy], [B[0] + nx * w1 + dx, B[1] + ny * w1 + dy], [B[0] - nx * w1 + dx, B[1] - ny * w1 + dy], [A[0] - nx * w0 + dx, A[1] - ny * w0 + dy]];\n        px.poly(g, q(wa, wb, 0, 0), T.sh); px.poly(g, q(Math.max(.5, wa - .9), Math.max(.5, wb - .9), -.5, -.6), T.base);\n      } });\n    };\n\n    const pelvis = pt('pelvis'), sp1 = pt('spine1'), sp2 = pt('spine2'), chest = pt('chest'), neck = pt('neck'), head = pt('head'), top = pt('headTop'), face = pt('faceF'), chestF = pt('chestF');\n    const fwdC = norm3(sub3(chestF, chest)), fwdH = norm3(sub3(face, head));\n    // legs: thigh, shin, foot (heel to ball), toes; purple at the hip, knee and ankle\n    for (const s of ['L', 'R']) {\n      const hip = pt('hip' + s), knee = pt('knee' + s), ank = pt('ankle' + s), b = pt('ball' + s), toe = pt('toe' + s);\n      const heel = add3(lerp3(ank, b, -.28), [0, 0, -1], 45);\n      part(hip, knee, 80, 60, main); band(hip, knee, .02, .1, 80, 62, joint);\n      part(knee, ank, 56, 40, main); band(knee, ank, .86, 1, 56, 41, joint);\n      band(hip, knee, .9, 1, 80, 60, joint); band(knee, ank, 0, .1, 56, 40, joint);   // the knee ring\n      part(heel, b, 44, 40, main, .005); part(b, toe, 38, 28, main, .006);\n    }\n    // torso: pelvis, a waist band, belly, a broad chest that runs shoulder to shoulder\n    const shL = pt('shL'), shR = pt('shR'), clL = pt('clavL'), clR = pt('clavR');\n    part(pt('hipL'), pt('hipR'), 92, 92, main, -.01);\n    part(pelvis, sp1, 118, 112, main);\n    part(sp1, sp2, 104, 112, main);\n    band(sp1, sp2, .1, .26, 108, 112, joint);\n    const pecL = add3(lerp3(chest, shL, .38), fwdC, 22), pecR = add3(lerp3(chest, shR, .38), fwdC, 22), up = norm3(sub3(neck, sp2));\n    part(sp2, add3(chest, up, 40), 122, 132, main);\n    part(add3(pecL, up, -30), add3(pecR, up, -30), 112, 112, main, .01);\n    // neck (purple) and an egg-shaped head: a narrow jaw forward, a round crown\n    part(add3(neck, up, -20), lerp3(head, top, .25), 48, 46, joint);\n28:\"fit\": {\"Pushup\":[29,160],\"Meditate\":[15,54],\"Jumping Jacks\":[11,70],\"Sleeping\":[15,68],\"Victory\":[16,227],\"Cheering_Two_Hands\":[32,116],\"Dizzy\":[21,81],\"Idle_Subtle\":[15,61],\"Greeting\":[12,130],\"Run_Loop\":[16,57],\"Walk_Loop\":[10,100],\"Stretch_Yawn\":[12,53],\"Get_Up_From_Back\":[16,73],\"Waiting_Loop\":[33,105],\"Hop_One_Foot_Loop\":[19,100],\"Wave_Hello\":[13,55],\"111_38_part1\":[32,201],\"111_38_part2\":[39,281],\"111_39_part1\":[21,109],\"111_39_part2\":[19,109],\"111_39_part3\":[22,107],\"111_41_part3\":[27,154],\"22_14\":[21,86]},\n1564:\"111_39_part1\": {\"clip\": \"111_39_part1\", \"src\": \"CMU_111\", \"take\": \"111_39 0.00-10.00\", \"dur\": 10, \"loop\": false, \"tags\": [\"exercise\"], \"desc\": \"Yoga\", \"keys\": [\n1683:\"111_39_part2\": {\"clip\": \"111_39_part2\", \"src\": \"CMU_111\", \"take\": \"111_39 10.00-20.00\", \"dur\": 10, \"loop\": false, \"tags\": [\"exercise\"], \"desc\": \"Yoga\", \"keys\": [\n1838:\"111_39_part3\": {\"clip\": \"111_39_part3\", \"src\": \"CMU_111\", \"take\": \"111_39 20.00-30.00\", \"dur\": 10, \"loop\": false, \"tags\": [\"exercise\"], \"desc\": \"Yoga\", \"keys\": [\n# Build plan: a wellness-retreat balance game inspired by Wii Fit\n\nYou are building this game alone, from this plan and your brief. Nobody can answer questions, so decide and move on.\n\n- **Your brief wins** on anything it states: deliverable names, the title rule, what the About screen lists, the exit interview. Where it leaves a choice, this plan has made it.\n- **The title is yours.** Pick it the way your brief says. This plan says \"the title\" wherever it appears.\n- **Paths here are relative to your dev folder.** The final file's name and place are in your brief.\n- **✔ means tested.** It was run on this computer against engine v0.88.0 and hub client 1.4.0 while this plan was written. Trust those recipes. Numbers marked \"start\" are tuning defaults: change them with the dev sliders.\n- Read sections 1 to 4 and 15 to 17 first. Use the rest as reference while you build each part.\n\n---\n\n## 1. The game\n\n**In one line:** a gentle, deadpan comedy about a five-day stay at a wellness retreat, where one analog skill, your balance, drives twelve short sports and exercise activities, coached by a needy talking scale and two serene wooden instructors.\n\n- **Genre:** sports and fitness minigame collection inside a light life-sim routine. Catalogue genre: Sports.\n- **Perspective:** chosen per activity, always the clearest view of the body:\n\n| Where | View | Why |\n|---|---|---|\n| Studio activities | `brawler` (2.5D, fixed camera) | The whole body reads at 10 feet |\n| The island | `threequarter`, follow camera | A small walkable place |\n| Slalom | Mode 7, behind the skier | Speed |\n| Jog | Pseudo-3D road, behind the runner | The coast rolling by |\n| Tray | Custom steep view of the tray | You look down at what you tilt |\n| Laundry Line | `side` | A rope is a line |\n\n**What to take from the source, in spirit:** a talking scale that judges you very politely; the morning weigh-in ritual and a number that matters too much; a clean, bright, faintly unsettling studio; calm instructors who never stop being pleasant; stillness treated as a sport; minutes banked and activities unlocked; little people jogging around an island.\n\n**What must stay original (this is a new game, not a recreation):** no Wii, Mii or Balance Board names, no copied characters, music, menus, minigame presentations or look. Say \"Wii Fit\" only in the Source Information your brief requires, and let the title riff on it as the brief says. Our cast, island, activities and jokes are below.\n\n**Never make fun of bodies.** There is no real weight, no BMI and no body-size talk. Tare weighs you in ducks. Jokes land on posture, wobbling, the player's excuses, and Tare's own loneliness.\n\n**Pillars. Cut anything that serves none of them.**\n1. **One skill, many bodies.** Everything is the Lean (section 3). Learn it once, feel it everywhere.\n2. **Your thumb is the body.** Squat depth *is* the stick. No canned animation that ignores your input.\n3. **Polite, sincere, slightly hurt.** The game never winks and never sneers.\n4. **The daily ritual.** Weigh-in, sessions, recap, bed. Tiny numbers feel huge.\n5. **Ten-foot calm.** Bright, huge, one idea per screen.\n\n---\n\n## 2. What the player does\n\n```\nTitle ──(10 s idle)──> Attract Mode loop ──(any input)──> Title\n  ├ Continue / New Member ──> Member Card ──> Arrival (first time) ──> pick instructor\n  │     Day loop: Bungalow ─> Body Check ─> Island ─> 3 Sessions ─> Evening recap ─> bed\n  │     Day 5: The Gentle Games ─> Grand Stillness duel ─> Ending ─> Credits ─> Free Play\n  ├ Class (2 to 4 players on one screen)\n  ├ Free Play (after the ending, or from Dev Mode)\n  ├ Settings   └ About / Credits\nIn an AI Hub session: straight to the round, no title or menus (section 14).\n```\n\n**A session (every activity, every time):** Card (one sentence on what you can and can't do here, device-correct controls, star targets, your best) → instructor demonstrates for 3 s with one line → \"Breathe in\" 3-2-1 → play for 45 to 90 s → stars stamp down, minutes drop into Gerald, Tare comments → Again / Done. Again is free: a session ends only on Done, your best run counts, and every run pays minutes. Target: 2 to 3 minutes door to door. A story run takes 40 to 50 minutes and shows everything.\n\n---\n\n## 3. The core mechanic: the Lean\n\nEvery player has a **centre of balance** `p` (x right, y forward, both -1..1) with velocity `v`. Input sets a lean target `u`. The body chases it like a heavy person on an unstable board:\n\n```js\n// one fixed step (dt = 1/120). nx, ny: smooth noise. fx, fy: scripted pushes (a gull, a gust, a thought)\nax = k * (ux - px) - c * vx + s * px + A * nx(t) + fx;\nay = k * (uy - py) - c * vy + s * py + A * ny(t) + fy;\nvx += ax * dt; vy += ay * dt; px += vx * dt; py += vy * dt;\nif (Math.hypot(px, py) >= 1) stumble();   // 1 s: input ignored, p eases home, stumble animation, score penalty\n// noise: three sines with seeded phases\nconst noise = (rng, f) => { const ph = [rng()*6.28, rng()*6.28, rng()*6.28];\n  return t => (Math.sin(t*f+ph[0]) + .6*Math.sin(t*f*1.73+ph[1]) + .35*Math.sin(t*f*2.61+ph[2])) / 1.3; };\n```\n\n`k` is responsiveness, `c` damping, `s` instability (the further you lean, the further you fall), `A` tremble, `nf` tremble speed, `R` the target ring's radius. **Steadiness** is the share of time inside the ring.\n\n**Tested defaults (✔ simulated over 45 s runs with modelled players):**\n\n| Set | k | c | s | A | nf | R | Push (speed, every s) | Passive | Poor | Average | Good |\n|---|---|---|---|---|---|---|---|---|---|---|---|\n| Body Check | 14 | 7 | 4 | 3 | 1.1 | .20 | none | 50% | 76% | 99% | 100% |\n| Sun Flow | 12 | 6 | 6 | 3.2 | 1.3 | .28 | .5, 9 | 53% | 78% | 99% | 100% |\n| Stork Stand 1 | 12 | 5 | 13 | 3 | 1.5 | .24 | .6, 7 | 20% (5 falls) | 30% | 68% | 95% |\n| Stork Stand 2 | 11 | 4.5 | 15 | 3.6 | 1.7 | .22 | .7, 6 | 22% (15 falls) | 15% | 29% | 54% |\n| Quiet Candle | 10 | 5 | 11 | 1.4 | .8 | .20 | .55, 5 | 14% (4 falls) | 59% | 95% | 100% |\n| Laundry Line | 10 | 3.5 | 16 | 3.5 | 1.2 | .40 | .9, 5 | 35% (19 falls) | 31% | 39% | 79% |\n\n**Bots use this model** (tests, attract, Class fill-ins). It reacts to where `p` was `tau` seconds ago:\n`target = -gain * pSeen - damp * vSeen + noise * smoothNoise(t)`; `u += (target - u) * min(1, dt * 16)`; clamp length to 1.\n\n| Bot | tau | gain | damp | noise |\n|---|---|---|---|---|\n| poor | .34 | 1.1 | .22 | .16 |\n| average | .25 | 1.4 | .30 | .08 |\n| good | .18 | 1.8 | .36 | .04 |\n| expert | .14 | 2.2 | .42 | .02 |\n\n**Input (the same game on three devices, each native).** All of it fills one `intent` object, and activities read only `intent`, never a device. Bots and attract fill the same object.\n\n| | Controller | Keyboard | Mouse |\n|---|---|---|---|\n| Lean | Left stick: `u` = stick position | WASD or arrows: **nudge**. While held, `u` moves toward the direction at 2.2/s; released, it drifts home at .5/s. Tapping makes fine corrections (✔ simulated: at 2.2/s keys score the same as a stick; at 1.6/s the rope is unplayable) | Pointer: `u` = pointer offset from screen centre / (`r.H` × .33). It stays where you leave it |\n| Breath / Effort | L2 or R2, analog (`input.value`) | Space (level ramps over 4 s) | Left button (same ramp) |\n| Left/right catch | L1 / R1 | Q / E | Left / right button |\n| Confirm, Back, Pause | ✕, ○, Options | Enter or Space, Esc, Esc or P | Click, right click, the corner button |\n\n✔ Tell which device is leaning like this: `input.lastDevice` becomes `'gamepad'` for a pad, but **moving the mouse does not change it away from `'keyboard'`**, so compare `input.mouse.t` (when the mouse last moved) with the time of your last key press. Use `input.pointer()` for the position. With a mouse, also hide the OS cursor over the canvas during activities and draw a small soft hand instead.\n\n✔ The input map must keep the engine's menu actions. **A custom map replaces the whole preset**: without `confirm` and `start`, menus and the hub card's Enter silently stop working.\n\n```js\nconst D = E.Input.DEFAULT, INPUT = { up: D.up, down: D.down, left: D.left, right: D.right, start: D.start, pause: D.pause,\n  confirm: D.confirm, cancel: D.cancel,\n  breath: ['Space', 'Mouse0', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Mouse0', 'Pad4'], catchR: ['KeyE', 'Mouse2', 'Pad5'],\n  jump: ['Space', 'Pad0'], interact: ['KeyE', 'Enter', 'Pad0'], more: ['Tab', 'KeyM', 'Pad3'], retry: ['KeyR', 'Pad2'],\n  paceL: ['KeyJ', 'Mouse0', 'Pad6'], paceR: ['KeyK', 'Mouse2', 'Pad7'],\n  stepL: ['KeyA', 'ArrowLeft', 'Mouse0', 'Pad14', 'PadAxisLeft'], stepR: ['KeyD', 'ArrowRight', 'Mouse2', 'Pad15', 'PadAxisRight'],\n  stepU: ['KeyW', 'ArrowUp', 'WheelUp', 'Pad12', 'PadAxisUp'], stepD: ['KeyS', 'ArrowDown', 'WheelDown', 'Pad13', 'PadAxisDown'] };\n```\n\n**The Plate** is the game's signature HUD: a large white disc at bottom centre (✔ radius 26 at `r.H - 34` reads well) with the ring, the dot, and a fading trail of the last second. In-ring: the ring glows mint, a soft chime rises with the streak, small glints appear. Near the edge: the rig flails, a creak plays, the controller rumbles harder (`input.rumble`). **Gentle Mode** (a setting): ring ×1.25, `s` and `A` ×.7. Tare says: \"Gentle Mode is on. I won't tell anyone. I don't know anyone.\"\n\n---\n\n## 4. The activities\n\n**Stars from `pct` (0..1):** 1★ .35, 2★ .65, 3★ .90 unless stated. Every activity must satisfy, on tier 1: passive input earns under 1★, the average bot at least 1★, the good bot at least 2★. On tier 2: passive under 1★, the good bot at least 1★, the expert bot at least 2★. **Each activity is one registry entry** (section 15) with its numbers in `game/data/`. Tier 2 opens after 2★ on tier 1 and from Day 4.\n\n### Stillness\n\n**Stork Stand** (`hold`). Stand on one leg on the deck. Hold the dot in the ring, which moves to a new spot every 12 s. A gull lands on your outstretched arm: a constant push to that side (`fx` = ±2.5) until it leaves with a little kick. 45 s. `pct` = steadiness - .05 × falls. The rig tilts with `p` (section 9). Tier 2, **Eyes Closed**: the Plate disappears and the screen dims. You balance by the rig's tilt, a stereo tone (pan = x, pitch = y) and rumble. This is the tutorial, guided on Day 1: \"Lean\" (move into the ring), \"Hold\", \"Recover\" (gull).\n\n**Sun Flow** (`hold` + breath). Five poses, two breaths each: Low Lunge → Down Dog → Triangle → Warrior → Stork. A guide ring swells for 4 s (breathe in: hold L2/R2, Space or left button) and shrinks for 4 s (let go). Analog players match the level; on digital the level ramps ±1 over 4 s. Crossfade poses with `lib.blend` over .6 s. 80 s. `pct` = .6 steadiness + .4 breath match (level within .25 of the guide), stars at .5, .75, .92 (doing nothing scores about .4 here). The instructor mirrors you on the next mat. Setting: Breath Hold or Toggle.\n\n**Quiet Candle** (`candle`). Sit cross-legged (`Meditate`). A candle burns in front of you. Its flame reacts to the **speed** of the dot: `|v|` over .55 drains flame .4/s, in-ring refills .12/s. Thought bubbles drift in with captions and push you slowly their way (`f` 3 to 5 for 2.5 s), so you must correct gently; any jerk hurts the flame. One relight (-15%), then it ends. 60 s. `pct` = .6 steadiness + .4 mean flame. If the input is perfectly untouched for the first 20 s, the thoughts drift you out and Tare says: \"Did you put the controller down? I can tell. This is not that kind of stillness.\" Tier 2 adds Dennis's blender and a goose.\n\n### Strength (all three are `rep`: one code path, three data rows)\n\n**The Rail.** A vertical rail beside the rig; a bead rides it at the instructor's tempo. Your lean **is** the body: `depth = clamp(-py, 0, 1)` scrubs the exercise as you move, so holding the stick halfway holds you halfway. `k` 16, `c` 8, `s` 0 on the main axis; the other axis has `s` 8 and is **form**: drift there and the rig visibly twists. Each rep scores 1.0 if mean `|depth - bead|` ≤ .08, 0 at ≥ .35, and shows Perfect/Good/Late. Tempo: 2 s down, 2 s up (tier 2: 3 s down, a hold, 1 s up). **Fatigue:** after 60% of the reps, `A` rises, `k` falls and the rig shakes. **\"Two more\":** if you are scoring above .8, the instructor adds two bonus reps. (\"You're doing so well, so I've added some.\") `pct` = mean rep × (1 - form penalty, up to .3).\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_84","type":"reasoning","text":"**Writing art.js canvas**"}}
{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"tail -35 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/engine/my-3d2dge.js'; tail -20 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/vendor/fitclips.js'; sed -n '2842,2870p' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/engine/my-3d2dge.js'; sed -n '1,100p' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/vendor/mocap.js'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"tail -35 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/engine/my-3d2dge.js'; tail -20 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/vendor/fitclips.js'; sed -n '2842,2870p' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/engine/my-3d2dge.js'; sed -n '1,100p' 'Wee Bit of Zen-Wii Fit-gpt-6.1-terra-max-20261104-221356/vendor/mocap.js'\"","aggregated_output":"      if (b.vy <= 0) { const top = this.ground(b.x, b.y); if (top !== null && top >= ny) { landed = -b.vy; b.y = top; b.vy = 0; b.ground = true; } else b.y = ny; }\n      else if (this.solid(b.x, ny + h)) b.vy = 0; else b.y = ny;\n    } else if (!this.solid(b.x, b.y - .5)) { const top = this.ground(b.x, b.y); if (top === null || top < b.y - climb) b.ground = false; else b.y = top; }\n    return landed;\n  }\n  /** a field for the physics module: world.add(land.collider()) */\n  collider() { return { type: 'static', shape: 'field', test: (x, y, r) => this.hit(x, y, r) }; }\n  /** draw it as decals under the bodies, in the side view (its y is the engine's z); only changed chunks are redrawn */\n  draw(r) {\n    const k = this.chunk, v = r.game.view, s = v.scale, W = r.game.W, H = r.game.H; this.drawn = 0;\n    for (let cy = 0; cy * k < this.h; cy++) for (let cx = 0; cx * k < this.w; cx++) {\n      const wx = this.x + cx * k, wy = this.y + this.h - cy * k, [sx, sy] = r.w(wx, 0, wy);\n      if (sx > W || sy > H || sx + k * s < 0 || sy + k * s * v.zBoost < 0) continue;\n      const key = cx + ',' + cy; let cv = this._cv.get(key);\n      if (!cv || this._dirty.has(key)) { cv = this._paint(cx, cy, cv); this._cv.set(key, cv); this._dirty.delete(key); this.drawn++; }\n      r.decal(g => { const was = g.imageSmoothingEnabled; g.imageSmoothingEnabled = false; g.drawImage(cv, Math.round(sx), Math.round(sy), Math.round(k * s), Math.round(k * s * v.zBoost)); g.imageSmoothingEnabled = was; });\n    }\n  }\n  // one chunk's picture: each cell its material's color, varied a little; the lit top (air above), a dark rim elsewhere\n  _paint(cx, cy, cv) {\n    const k = this.chunk; cv = cv || E.mkCanvas(k, k); const g = E.ctx2d(cv), img = g.createImageData(k, k), D = img.data, W = this.w, C = this.cells;\n    for (let y = 0; y < k; y++) for (let x = 0; x < k; x++) {\n      const c = cx * k + x, row = cy * k + y, o = (y * k + x) * 4; if (c >= W || row >= this.h) continue;\n      const id = C[row * W + c]; if (!id) continue;\n      const M = this.materials[id - 1], P = this._rgb[id - 1], air = (cc, rr) => cc >= 0 && rr >= 0 && cc < W && rr < this.h && !C[rr * W + cc];\n      let up = 0; for (let d = 1; d <= M.depth; d++) if (air(c, row - d)) { up = d; break; }\n      const rim = air(c - 1, row) || air(c + 1, row) || air(c, row + 1), n = (hash(c, row) - .5) * 18 + (hash(c >> 2, row >> 2) - .5) * 14;\n      const base = up ? P.t : rim ? P.e : P.c, l = up === 1 ? 24 : 0;\n      D[o] = Math.max(0, Math.min(255, base[0] + n + l)); D[o + 1] = Math.max(0, Math.min(255, base[1] + n + l)); D[o + 2] = Math.max(0, Math.min(255, base[2] + n * .7 + l)); D[o + 3] = 255;\n    }\n    g.putImageData(img, 0, 0); return cv;\n  }\n}\nE.Terrain = Terrain;\n})(typeof My3D2dge !== 'undefined' ? My3D2dge : undefined);\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[41,26,-88,33,45], \"armR\":[38,38,-84,33,-76],\n   \"legL\":[12,13,-98,113,22], \"legR\":[11,2,-99,116,-28], \"footL\":[15,6,3], \"footR\":[29,7,23]},\n  {\"t\":4.733,\n   \"hips\":[0,0,95], \"body\":[8,8,1], \"chest\":[-8,12,7], \"head\":[-29,-8,-12], \"root\":[-6,-2],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[35,23,-91,27,44], \"armR\":[32,36,-88,31,-77],\n   \"legL\":[7,4,-100,55,8], \"legR\":[5,0,-100,63,-14], \"footL\":[1,9,14], \"footR\":[15,12,15]},\n  {\"t\":4.9,\n   \"hips\":[0,0,102], \"body\":[8,9,2], \"chest\":[-7,3,4], \"head\":[-25,-2,-8], \"root\":[-3,0],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[31,24,-92,30,42], \"armR\":[29,36,-89,34,-72],\n   \"legL\":[4,1,-100,14,2], \"legR\":[2,-1,-100,30,-5], \"footL\":[-4,8,11], \"footR\":[5,16,13]},\n  {\"t\":5.533,\n   \"hips\":[0,0,102], \"body\":[7,8,1], \"chest\":[-8,-2,3], \"head\":[-19,4,-4], \"root\":[0,1],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[17,21,-96,30,47], \"armR\":[19,31,-93,31,-75],\n   \"legL\":[-2,5,-100,11,-4], \"legR\":[-5,-5,-100,23,-2], \"footL\":[-3,7,15], \"footR\":[5,18,17]},\n  {\"t\":5.9,\n   \"hips\":[0,0,102], \"body\":[7,8,1], \"chest\":[-8,-4,2], \"head\":[-15,6,1], \"root\":[3,1],\n   \"shL\":[0,0], \"shR\":[0,0], \"armL\":[21,19,-96,37,38], \"armR\":[22,30,-93,33,-69],\n   \"legL\":[-5,4,-100,12,-1], \"legR\":[-8,-4,-100,22,0], \"footL\":[-2,8,21], \"footR\":[6,17,17]}\n]}\n}};\n  advance(seconds = this.o.step, o = {}) {\n    if (!this.scene && !this._next) throw new Error('game.advance() needs a started game: game.start({ update, draw }) first');\n    this._acc += Math.max(0, seconds);\n    const n = this._steps(); this.stats.steps = n;\n    if (this.r && (this.headless ? this.o.draw : o.draw)) try { this._frame(); } catch (e) { this.fail('draw', e); }\n    return n;\n  }\n  /**\n   * the clock: an exact fixed step. Real time (at most 50 ms a frame, so a stall can't run away) fills an accumulator;\n   * each whole o.step of it (1/120 s) runs one update of o.step * timeScale game seconds (split in two or more when\n   * timeScale > 1, so no step is longer than o.step), and the remainder waits for the next frame (game.alpha = its\n   * fraction of a step). 60 Hz runs two steps a frame, 120 Hz one, 144 Hz one on most frames: the same steps at any rate.\n   * Slow motion makes steps shorter, never fewer. Paused or at timeScale 0 the steps still run (dt 0), so input ticks.\n   * The first frame always updates (with dt 0 when its time is short of a step), so draw never comes before update.\n   * Returns the updates run\n   */\n  _run(real) { this._acc += Math.min(.05, real); return this._steps(); }\n  /** run the whole steps the accumulator holds (see _run) */\n  _steps() {\n    const step = this.o.step; let n = 0;\n    try {\n      while (this._acc > step - 1e-9) {   // (the tolerance absorbs the rounding in frame times: 1/60 s is two steps)\n        this._acc -= step; this._wall += step;   // (_wall: seconds stepped through, unscaled: slow motion or a stop doesn't hold up the player's zoom)\n        const k = this.timeScale > 1 ? Math.ceil(this.timeScale - 1e-9) : 1, h = step * Math.max(0, this.timeScale) / k;\n        for (let i = 0; i < k; i++, n++) this._step(h);\n      }\n      if (!n && !this._stepped) { n++; this._step(0); }   // the first frame updates before it draws, even when its time is short\n    } catch (e) { this._acc %= step; this.fail('update', e); }   // an error drops the frame's other steps, as before\n    if (n) this._stepped = true;\n/* =============================================================================\n * MOCAP  plays animation sets in the readable format (src/mocap/readable.js; written by tools/anim-import.mjs) on\n * my-3D2dge rigs.\n *   const lib = Mocap.load(window.MOCAP.QUATERNIUS);   // a set: its clips, and the bodies they were measured on\n *   const clip = lib.clip('Dance_Loop');               // { name, dur, loop, tags, desc, keys }\n *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n *   const man = new Mocap.Mannequin(lib, { height: 34 });  man.draw(g, ox, oy, view, pose, facing)\n *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n *     window.Mocap.)\n *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n *     only the chest, head and arms over the rig's own legs (an interaction while walking); humanoid.mocapBlade = true\n *     while the clip holds a sword (the blade follows the fist).\n * Points are in the rig's local frame: f = forward, r = right, z = up, centred on the root on the ground.\n * ============================================================================= */\nconst Mocap = (() => {\n'use strict';\nconst E = My3D2dge, { px } = E, MR = MocapReadable;\n\n/* ---- sets ---- */\n/**\n * Every clip is rebuilt on the first library's proportions (the format does not depend on size); each keeps how its own\n * library bends the spine, since the key poses were measured that way.\n */\nfunction load(set) {\n  const P = MR.P, idx = MR.IDX, ids = Object.keys(set.sources), base = set.sources[ids[0]].rest, rests = {};\n  for (const id of ids) rests[id] = Object.assign({}, base, { spineW: set.sources[id].rest.spineW, neckW: set.sources[id].rest.neckW });\n  const meta = c => ({ name: c.clip, fps: set.fps, n: Math.round(c.dur * set.fps) + 1 }), clips = {};\n  for (const [name, c] of Object.entries(set.clips)) clips[name] = Object.assign(meta(Object.assign({ clip: name }, c)), c);\n  const restOf = c => rests[c.src] || base;\n  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n  lib.clip = name => clips[name] || null;\n  /** the pose at time t (seconds): key poses in-betweened, loops wrap, one-shots hold their last pose */\n  lib.sample = (clip, t, out = new Float32Array(P * 3)) => { MR.pose(restOf(clip), clip, t, out); out.src = clip.src; return out; };   // (src: whose rest it is measured against)\n  /** a clip that travels: how far it has carried the body at time t ([forward, right] mm), or null */\n  lib.moveAt = (clip, t) => MR.moveAt(restOf(clip), clip, t);\n  /** swap in an edited clip (readable text a person or a model changed); the original is kept for restore() */\n  const originals = {};\n  lib.replace = (name, edited) => { if (!originals[name]) originals[name] = clips[name]; clips[name] = Object.assign({}, originals[name], edited, { name, keys: edited.keys }); return clips[name]; };\n  lib.restore = name => { if (originals[name]) { clips[name] = originals[name]; delete originals[name]; } return clips[name]; };\n  lib.edited = name => !!originals[name];\n  /** the clip as the text a model reads (its header and its key poses) */\n  lib.text = clip => { const o = { clip: clip.clip || clip.name }; for (const k of ['src', 'take', 'orig', 'dur', 'loop', 'tags', 'desc']) if (clip[k] !== undefined) o[k] = clip[k]; o.keys = clip.keys; return MR.text(o); };\n  /** where a clip came from: its library's label, origin and license (from the set's sources), the clip it was made from,\n   *  and (a capture database's) the take and the stretch of it: '13_29 2.30-3.42' */\n  lib.origin = clip => { const s = set.sources[clip.src] || {}; return { src: clip.src, label: s.label || clip.src, origin: s.origin || '', license: s.license || '', url: s.url || '', orig: clip.orig || null, take: clip.take || null }; };\n  /** a pose blended from a to b (crossfades between clips) */\n  lib.blend = (a, b, k, out = new Float32Array(P * 3)) => { for (let i = 0; i < P * 3; i++) out[i] = a[i] + (b[i] - a[i]) * k; out.src = (k < .5 ? a : b).src; return out; };\n  lib.pt = (pose, name) => { const i = idx[name] * 3; return [pose[i], pose[i + 1], pose[i + 2]]; };\n  lib.error = MR.error;\n  return lib;\n}\n\n/* ---- the look-alike mannequin: shaded capsules in the source model's proportions, with its joint bands ---- */\nconst lerp3 = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\nconst add3 = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];\nconst sub3 = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\nconst norm3 = a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\nclass Mannequin {\n  /** o: { height: world units tall (34), main: '#e8aa3a', joint: '#aa66db' } (the colors of the source model's two materials) */\n  constructor(lib, o = {}) {\n    this.lib = lib; this.o = Object.assign({ height: 34, main: '#e8aa3a', joint: '#aa66db' }, o);\n    this.k = this.o.height / ((lib.body && lib.body.height) || 1829);   // world units per mm\n    this._ops = [];\n  }\n  /**\n   * draw the pose into g with (ox, oy) = the projected root. Every part is a capsule between two body points,\n   * sorted by true camera depth, drawn dark-then-lit like the engine's HD rigs.\n   */\n  draw(g, ox, oy, view, pose, facing = 0) {\n    const L = this.lib, o = this.o, k = this.k, ca = Math.cos(facing), sa = Math.sin(facing), sc = view.scale;\n    const pt = name => L.pt(pose, name);\n    const S = p => { const wx = (p[0] * ca - p[1] * sa) * k, wy = (p[0] * sa + p[1] * ca) * k, wz = p[2] * k; return [ox + view.ax * wx + view.ay * wy, oy + view.bx * wx + view.by * wy + view.bz * wz, view.dx * wx + view.dy * wy + view.dz * wz]; };\n    const R = mm => mm * k * sc;   // a radius in mm -> screen pixels\n    const ops = this._ops; ops.length = 0;\n    const main = E.tones(o.main), joint = E.tones(o.joint);\n    // centre depth of the body: parts behind it are drawn a touch darker (the far arm and leg)\n    const mid = S(pt('spine1'))[2];\n    const capsule = (A, B, ra, rb, col, dx = 0, dy = 0) => {\n      const ax = A[0] + dx, ay = A[1] + dy, bx = B[0] + dx, by = B[1] + dy, vx = bx - ax, vy = by - ay, l = Math.hypot(vx, vy);\n      if (l > .01) { const nx = -vy / l, ny = vx / l; px.poly(g, [[ax + nx * ra, ay + ny * ra], [bx + nx * rb, by + ny * rb], [bx - nx * rb, by - ny * rb], [ax - nx * ra, ay - ny * ra]], col); }\n      px.disc(g, ax, ay, Math.max(.5, ra - .3), col); px.disc(g, bx, by, Math.max(.5, rb - .3), col);\n    };\n    // a shaded part: dark silhouette, the base color shifted toward the light (upper left), a soft highlight\n    const part = (a, b, ra, rb, T, bias = 0) => {\n      const A = S(a), B = S(b), pa = R(ra), pb = R(rb), far = (A[2] + B[2]) * .5 < mid - 2 * k * 60;\n      ops.push({ d: (A[2] + B[2]) * .5 + bias, f: () => {\n        capsule(A, B, pa, pb, far ? T.deep : T.sh);\n        capsule(A, B, Math.max(.5, pa - .9), Math.max(.5, pb - .9), far ? T.sh : T.base, -.5, -.6);\n        if (pa > 2.2 && !far) capsule(A, B, pa * .32, pb * .32, T.lt, -pa * .38, -pa * .42);\n      } });\n    };\n    // a ring painted round a limb (the second material): a straight-edged stripe across the capsule, no round ends,\n    // so a thin band reads as a band from every side. Seen end-on (the limb points at the camera) it is hidden.\n    const band = (a, b, t0, t1, ra, rb, T) => {\n      const A = S(lerp3(a, b, t0)), B = S(lerp3(a, b, t1)), axis = S(a), end = S(b), vx = end[0] - axis[0], vy = end[1] - axis[1], l = Math.hypot(vx, vy);\n      if (l < R(Math.max(ra, rb)) * .5) return;\n      const nx = -vy / l, ny = vx / l, wa = R(ra + (rb - ra) * t0) + .2, wb = R(ra + (rb - ra) * t1) + .2;\n      ops.push({ d: (axis[2] + end[2]) * .5 + .02, f: () => {\n        const q = (w0, w1, dx, dy) => [[A[0] + nx * w0 + dx, A[1] + ny * w0 + dy], [B[0] + nx * w1 + dx, B[1] + ny * w1 + dy], [B[0] - nx * w1 + dx, B[1] - ny * w1 + dy], [A[0] - nx * w0 + dx, A[1] - ny * w0 + dy]];\n        px.poly(g, q(wa, wb, 0, 0), T.sh); px.poly(g, q(Math.max(.5, wa - .9), Math.max(.5, wb - .9), -.5, -.6), T.base);\n","exit_code":0,"status":"completed"}}
