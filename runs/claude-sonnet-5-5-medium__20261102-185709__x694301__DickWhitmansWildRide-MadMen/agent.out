ad button by its symbol on the controller in use ('A', '✕', 'B'...; glyphs picks the family)\n297:- `input.padStyle()`: the controller family whose symbols label() shows: glyphs, or with glyphs 'auto' the one its name says\n326:- `input.glyphs = 'auto'`: the gamepad's button symbols for label(): 'auto' (from the controller's name) | 'xbox' | 'playstation' | 'nintendo' | 'generic' (positions)\n360:- `E.font.title(g, s, x, y, o = {})`: Big logo text for title screens: scaled glyphs with a vertical color gradient, an outline and an extruded 3D edge. title(g, 'CASTLE OF NIGHT', x, y, { scale: 3, colors: ['#fff6c8', '#ffd36a', '#e07a2a'], outline: '#1a0c10', depth: 3, depthColor: '#6a2a1a', align: 'center' })","is_error":false}]},"parent_tool_use_id":null,"session_id":"5b281c84-305d-4114-8ac5-d69722c0fb1c","uuid":"307c6aee-873c-4f2d-9446-81af5466e65a","timestamp":"2026-11-03T01:58:03.577Z","tool_use_result":{"stdout":" 114127 AI_GUIDE.md\n 192446 API-INDEX.md\n  67542 API.md\n  12509 bridge.js\n      0 game\nwc: game: Is a directory\n  24937 harness.html\n 293037 my-3d2dge-agent.js\n1234180 my-3d2dge.js\n  20223 round.js\n  16336 session.js\n   9122 game/game.js\n   1397 game/index.html\n1985856 total\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Rooftop · my-3D2dge template</title>\n<style>html, body { margin: 0; height: 100%; background: #000; overflow: hidden } #screen { width: 100%; height: 100%; display: block; image-rendering: pixelated; touch-action: none }</style>\n</head>\n<body>\n<div id=\"e3-boot\" role=\"status\" style=\"position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;justify-content:flex-end;gap:6px;padding:20px;background:#05040a;color:#a9a1c8;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace\"><style>@keyframes e3-run{from{transform:translateX(-100%)}to{transform:translateX(340%)}}@keyframes e3-late{to{opacit