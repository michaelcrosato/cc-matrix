      for dx, dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                        n = (cx+dx, cy+dy)\n                        if 0 <= n[0] < W and 0 <= n[1] < H and rows[n[1]][n[0]] == DOOR and n not in gid:\n                            gid[n] = len(groups); st.append(n)\n                groups.append(cells)\n    opened = set(); plates = set(); keys_used = 0\n    def passable(x, y):\n        c = rows[y][x]\n        if c in WALLS or c in BLOCKED or c in GENS: return False\n        if c == DOOR: return gid[(x, y)] in opened\n        if c in TRAPW: return TRAPW[c] in plates\n        return True   # floor, items, monsters, cracked (shot open), fake\n    while True:\n        seen = set(starts); st = list(starts)\n        while st:\n            cx, cy = st.pop()\n            for dx, dy in ((1,0),(-1,0),(0,1),(0,-1)):\n                nx, ny = cx+dx, cy+dy\n                if 0 <= nx < W and 0 <= ny < H and (nx, ny) not in seen and passable(nx, ny):\n                    seen.add((nx, ny)); st.append((nx, ny))\n        newp = {rows[y][x] for (x, y) in seen if rows[y][x] in '^v'} - plates\n        if newp: plates |= newp; continue\n        keys = sum(1 for (x, y) in seen if rows[y][x] == 'k') - keys_used\n        if any(e in seen for e in exits):\n            stats = {'size': f'{W}x{H}', 'starts': len(starts), 'doorGroups': len(groups), 'doorsOpened': len(opened),\n                     'keysOnFloor': sum(r.count('k') for r in rows), 'keysLeftAtExit': keys,\n                     'reachableCells': len(seen),\n                     'items': {c: sum(r.count(c) for r in rows) for c in sorted(ITEMS) if any(c in r for r in rows)},\n                     'monsters': {c: sum(r.count(c) for r in rows) for c in sorted(MONS) if any(c in r for r in rows)},\n                     'generators': {c: sum(r.count(c) for r in rows) for c in sorted(GENS) if any(c in r for r in rows)}}\n            unreach_items = [(x, y, rows[y][x]) for y in range(H) for x in range(W) if rows[y][x] in ITEMS and (x, y) not