{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017RoU2DhP1PBE8BRGfBYeWf","type":"tool_result","content":"9163:class Shell {\n2977:/** the standard settings by key: { group, label, type: 'toggle' | 'slider' | 'select', value (the default, or a\n2982:  zoom: { group: 'Display', label: 'Camera zoom', type: 'slider', value: 1, min: ZOOM_PLAYER[0], max: ZOOM_PLAYER[1], step: .05, unit: '×', help: 'Closer or farther than the game frames it. In play: the mouse wheel, - and =, or a pinch', apply: g => g._zoomApply(false, true) },\n2988:  volume: { group: 'Sound', label: 'Volume', type: 'slider', value: .7, apply: (g, v) => g.audio.setVolume(v) },\n2989:  music: { group: 'Sound', label: 'Music', type: 'slider', value: .5, apply: (g, v) => { g.audio.musicVolume = v; g.audio.applyVolume(); } },\n2990:  effects: { group: 'Sound', label: 'Effects', type: 'slider', value: 1, apply: (g, v) => { g.audio.sfxVolume = v; g.audio.applyVolume(); } },\n2992:  audioOffset: { group: 'Sound', label: 'Audio offset', type: 'slider', value: 0, min: -100, max: 300, step: 5, unit: ' ms', calibrate: true, help: 'The music this much earlier, for speakers or headphones that lag (wireless ones: 150 to 250). Calibrate: tap on the clicks you hear', apply: (g, v) => { g.audio.offset = v / 1000; } },\n2994:  shake: { group: 'Comfort', label: 'Screen shake', type: 'slider', value: 1 },\n2995:  flashes: { group: 'Comfort', label: 'Screen flashes', type: 'slider', value: 1 },\n2997:  deadzone: { group: 'Controller', label: 'Stick dead zone', type: 'slider', value: .18, min: .05, max: .5, step: .01, apply: (g, v) => { g.input.deadzone = v; } },\n3000:  rumble: { group: 'Controller', label: 'Vibration', type: 'slider', value: .6, apply: (g, v) => { g.input.rumbleScale = v; } },\n3003:  touchSize: { group: 'Touch', label: 'Button size', type: 'slider', value: 62, min: 44, max: 88, step: 2, unit: ' px', apply: g => g.input._touchSync() },\n3004:  touchOpacity: { group: 'Touch', label: