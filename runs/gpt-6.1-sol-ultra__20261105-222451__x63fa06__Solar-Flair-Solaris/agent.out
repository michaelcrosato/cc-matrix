 Event('input',{bubbles:true}))}else if(el?.type==='checkbox'){el.checked=\"'!el.checked;el.dispatchEvent(new Event('\"'input',{bubbles:true}))}else this.moveFocus(d)}\n activateFocus(){if(this.focused?.matches('button')){if(this.page==='map'&&this.focused.dataset.action==='select'){this.jump(this.selected);return}this.focused.click()}else if(this.focused?.type==='checkbox'){this.horizontal(1)}}\n refreshPrompts(){const stamp=this.input.last+this.settings.glyphs;if(this.promptStamp===stamp)return;this.promptStamp=stamp;document.querySelectorAll('[data-prompt]').forEach(el=>el.innerHTML=this.input.chip(el.dataset.prompt));if(this.page==='flight')this.hudTimer=0;}\n toast(text){this.toastTimer=3.5;\"'$('\"'#toast').textContent=text;\"'$('\"'#toast').classList.remove('hidden')}\n start(){this.attract=false;this.paused=false;this.autoPilot=false;this.remote=null;this.sim.start();if(this.net.connected)this.sim.setPeerInput({},true);this.messageTimer=0;this.selectBest();this.show('map');this.audio.unlock();}\n selectBest(){const s=this.snapshot();this.selected=\"'!s.completed.includes('\"'shard')?'shard':\"'!s.completed.includes('\"'echo')?'echo':s.player.fuel<35?'haven':\"'!s.completed.includes('\"'chorus')?'chorus':\"'!s.completed.includes('\"'rift')?'rift':'solaris'}\n select(id,rebuild=true){this.selected=id;if(this.page==='map'){this.ui.querySelectorAll('.sector').forEach(el=>el.classList.toggle('selected',el.dataset.value===id));const details=\"'$('\"'#sector-details');if(details)details.innerHTML=this.sectorDetails();if(rebuild)this.focus(this.ui.querySelector(\"'`.sector[data-value=\"${id}\"]`),false)}}\n jump(id){if(this.net.role==='\"'guest'){this.toast('Flight lead is plotting the route. You fly the wingmate.');return}if(this.sim.selectSector(id)){this.paused=false;this.show('flight')}else this.toast(this.sim.lastMessage)}\n pause(){if(this.net.ended||this.net.hub&&\"'!this.started)return;if(this.attract){this.endAttract();return}if(['\"'flight','map'].includes(this.page)){this.previous=this.page;this.paused=\"'!this.net.connected;this.show('\"'pause')}}\n back(){if(this.net?.ended)return;if(this.attract){this.endAttract();return}if(this.page==='flight'||this.page==='map')this.pause();else if(this.page==='pause'){this.paused=false;this.show(this.previous)}else if(['settings','dev','about'].includes(this.page)){const p=this.returnTo||'title';this.show(p)}else if(['controls','coop'].includes(this.page)){this.show('title')}else if(this.page==='end'&&\"'!this.net.hub)this.show('\"'title');}\n action(action,value){if(this.net.ended)return;switch(action){case'start':this.start();break;case'controls':this.show('controls');break;case'training':this.start();this.sim.tuning.god=true;this.training=true;this.jump('shard');this.toast('TRAINING · shields protected · follow the green pods');break;case'coop':this.show('coop');break;case'settings':this.returnTo=this.page;this.show('settings');break;case'about':this.returnTo=this.page;this.show('about');break;case'dev':this.returnTo='pause';this.show('dev');break;case'back':this.back();break;case'resume':this.paused=false;this.show(this.previous);break;case'title':if(\"'!this.net.hub){this.net.leave();this.started=false;this.training=false;this.sim.tuning={...this.sim.defaults};this.show('\"'title')}break;case'select':this.select(value);break;case'jump':this.jump(this.selected);break;case'tow':this.sim.emergencyTow();this.paused=false;this.selectBest();this.show('map');break;case'retreat':this.sim.finishSector(true);this.paused=false;this.show('map');break;case'glyphs':this.settings.glyphs=this.settings.glyphs==='xbox'?'playstation':'xbox';this.save();this.show('settings');break;case'fullscreen':document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen?.().catch(()=>this.toast('Fullscreen is unavailable in this browser'));break;case'defaults':this.settings={music:.1,sfx:.65,glyphs:'playstation',shake:true};this.audio.setMusic(.1);this.audio.setSfx(.65);this.save();this.show('settings');break;case'dev-reset':this.sim.tuning={...this.sim.defaults};this.autoPilot=false;this.show('dev');break;case'dev-refill':this.sim.refill();this.toast('Flight systems restored');break;case'dev-complete':this.sim.dev.complete();this.toast('Objective advanced');break;case'dev-spawn':this.sim.dev.spawn('jammer');this.toast('Jammer spawned');break;case'dev-warp':this.sim.dev.warp(value);this.paused=false;this.show('flight');break;case'dev-bot':this.autoPilot=\"'!this.autoPilot;this.show('\"'dev');break;case'dev-victory':this.sim.dev.victory();this.paused=false;this.show('end');break;case'host':this.host();break;case'join':this.join();break;case'accept':this.accept();break;case'copy':this.copy(value);break;case'leave':this.net.leave();this.show('coop');break;case'practice-again':this.start();break;case'watch':this.startAttract();break;}}\n btn(label,action,value='',cls=''){return \"'`<button class=\"btn ${cls}\" data-action=\"${action}\" data-value=\"${value}\">${label}</button>`}\n show(page,reason='\"''){this.page=page;this.ui.innerHTML=this.pageHTML(page,reason);this.ui.className='';\"'$('\"'#hud').classList.toggle('hidden',page\"'!=='\"'flight');\"'$('\"'#reticle').classList.toggle('hidden',page\"'!=='\"'flight');this.focused=null;this.promptStamp='';if(page==='title'){this.paused=false;this.lastActivity=performance.now()}if(page==='map'){this.select(this.selected||'shard',false);if(this.net.role==='guest')this.toast('Flight lead chooses the destination')}requestAnimationFrame(()=>{const el=this.ui.querySelector(page==='map'?\"'`.sector[data-value=\"${this.selected}\"]`:'\"'button:not(:disabled)');this.focus(el,false);this.refreshPrompts()});}\n pageHTML(page,reason){const b=(...a)=>this.btn(...a),chip=a=>\"'`<span data-prompt=\"${a}\">${this.input.chip(a)}</span>`,s=this.snapshot();switch(page){case'\"'title':return \"'`<section class=\"screen title-shade\"><div class=\"topline\"><div class=\"eyebrow\"><span class=\"brandmark\">✦</span>Frontier rescue division</div><div class=\"badge\"><i class=\"dot\"></i>Sector 07 / ${this.scene.engine}</div></div><div class=\"hero\"><div class=\"eyebrow\">A long way from home.</div><h1>SOLAR<br><em>FLAIR</em></h1><p class=\"tagline\">The stars went quiet.<br>Go make some noise.</p><div class=\"actions\">${b('\"'Launch mission <span>↗</span>','start','','primary')}\"'${b('\"'How to fly','controls')}</div><p class=\\\"small\\\">Rescue the lost. Outfly the Zylons.<br>Find the light at the edge of the map.</p></div><div class=\\\"annotation\\\"><div>F-86 / SUNSKIPPER<br><strong>YOUR RIDE HOME</strong><br>Twin ion / three pulse cells</div></div><div class=\\\"planet-label\\\">The Saffron Expanse<br>09h 41m / −26° 30′</div><div class=\\\"bottomline\\\"><div class=\\\"actions\\\">\"'${b('\"'Wingmate co-op','coop','','subtle')}\"'${b('\"'Settings','settings','','subtle')}\"'${b('\"'About','about','','subtle')}</div><span class=\\\"hint\\\">\"'${chip('\"'accept')} Select &nbsp; · &nbsp; Idle to watch</span></div></section>\"'`;\n case'\"'map':return \"'`<section class=\"screen chart-screen\"><div class=\"topline\"><div class=\"eyebrow\">Frontier navigation / 07 sectors</div>${b('\"'Pause ☰','back','','subtle')}</div><div class=\\\"chart-top\\\"><div><h2>Follow the last light.</h2><div class=\\\"small\\\">\"'${s.rescued>=5?'\"'✓':'◇'} 5 survivors &nbsp; · &nbsp; \"'${s.completed.includes('\"'echo')?'✓':'◇'} Red Echo signal &nbsp; · &nbsp; \"'${s.completed.includes('\"'rift')?'✓':'◇'} Rift Gate signal</div></div><div class=\\\"chart-info small\\\"><p>\"'${s.bossUnlocked?'\"'Solaris located. Break the siege and bring everyone home.':'Choose a signal. Rescue five survivors and recover both route signals to locate Solaris.'}</p></div></div><div class=\\\"chart-layout\\\"><div class=\\\"chart\\\"><svg viewBox=\\\"0 0 100 100\\\" preserveAspectRatio=\\\"none\\\"><g stroke=\\\"#8fe8d04a\\\" stroke-width=\\\".2\\\" fill=\\\"none\\\" stroke-dasharray=\\\"1 1\\\"><path d=\\\"M11 67L29 32L54 53L36 77L11 67 M54 53L67 21L91 40L76 73L54 53 M29 32L67 21 M36 77L76 73 M67 21L76 73\\\"/></g></svg>\"'${s.sectors.map((e,i)=>`<button class=\"sector ${e.locked?'\"'locked':''} \"'${e.complete?'\"'complete':''} \"'${e.current?'\"'current':''}\\\" data-action=\\\"select\\\" data-value=\\\"\"'${e.id}\" style=\"left:${e.x}%;top:${e.y}%\" aria-label=\"${e.name}${e.locked?'\"' locked':''}\\\"><span class=\\\"orb\\\"><span>\"'${e.complete?'\"'✓':e.type==='base'?'⊕':e.type==='rescue'?'◇':e.type==='boss'?'✦':'⌁'}</span></span><span class=\\\"name\\\">\"'${e.name}</span></button>`).join('\"'')}</div><aside id=\\\"sector-details\\\" class=\\\"sector-details\\\">\"'${this.sectorDetails()}</aside></div><div class=\"bottomline\"><div class=\"resource-strip\"><div><strong>${Math.round(s.player.hp)}<small>%</small></strong><span>Hull</span></div><div><strong>${Math.floor(s.player.fuel)}</strong><span>Jump fuel</span></div><div><strong>${s.rescued}<small> / 7</small></strong><span>Survivors</span></div><div><strong>${String(s.player.score).padStart(5,'\"'0')}</strong><span>Score</span></div></div><div class=\\\"hint\\\">\"'${chip('\"'accept')} Warp &nbsp;\"'${chip('\"'back')} Pause</div></div></section>\"'`;\n case'\"'flight':return '';\n case'pause':return \"'`<section class=\"screen overlay\"><div class=\"panel\"><div class=\"eyebrow\">${this.net.connected?'\"'Squadron still in flight':'Flight suspended'}</div><h2>A moment in the dark.</h2><div class=\\\"menu-stack\\\">\"'${b('\"'Resume flight <span>↗</span>','resume','','primary')}\"'${b('\"'Settings','settings')}\"'${b('\"'Developer flight deck','dev')}\"'${b('\"'About / credits','about')}\"'${this.net.role==='\"'guest'?'':this.sim.state==='flight'?b(this.sim.sectorDone?'Return to sector chart':'Retreat to sector chart','retreat'):''}\"'${this.net.role==='\"'guest'?'':b('Emergency tow · −1000 points','tow')}\"'${this.net.hub?'\"'':b('Return to title','title','','subtle')}</div><p class=\\\"small\\\">\"'${this.net.connected?'\"'Co-op continues while this menu is open.':'Your ship and sector are paused.'}</p></div></section>\"'`;\n case'\"'settings':return \"'`<section class=\"screen overlay\"><div class=\"panel\"><div class=\"eyebrow\">Ship preferences</div><h2>Set your frequency.</h2>${this.slider('\"'Music','music',this.settings.music,0,1,.01)}\"'${this.slider('\"'Effects & radio','sfx',this.settings.sfx,0,1,.01)}<div class=\\\"row\\\"><span>Controller prompts</span>\"'${b(this.settings.glyphs==='\"'xbox'?'Xbox · A B X Y':'PlayStation · × ○ □ △','glyphs')}</div><div class=\\\"row\\\"><label for=\\\"shake-toggle\\\">Camera shake</label><input id=\\\"shake-toggle\\\" type=\\\"checkbox\\\" data-setting=\\\"shake\\\" \"'${this.settings.shake?'\"'checked':''}></div><div class=\\\"rule\\\"></div><div class=\\\"actions\\\">\"'${b('\"'Back','back','','primary')}\"'${b('\"'Fullscreen','fullscreen')}\"'${b('\"'Reset settings','defaults','','subtle')}</div><p class=\\\"small\\\">Prompts follow your last input. Music starts at 10%.</p></div></section>\"'`;\n case'\"'controls':return \"'`<section class=\"screen overlay\"><div class=\"panel wide\"><div class=\"eyebrow\">Flight school / F-86 Sunskipper</div><h2>Small ship. Big sky.</h2><p class=\"small\">Your ship cruises forward. Move across the flight lane, aim your cannons, and keep an eye on the heat. Fly through green rings to rescue survivors. Shields regenerate; starbases repair and refuel.</p><div class=\"control-grid\"><div>Move <b>${chip('\"'move')}</b></div><div>Aim <b>\"'${chip('\"'aim')}</b></div><div>Twin cannons <b>\"'${chip('\"'fire')}</b></div><div>Afterburner <b>\"'${chip('\"'boost')}</b></div><div>Shield pulse <b>\"'${chip('\"'pulse')}</b></div><div>Tractor assist / return <b>\"'${chip('\"'map')}</b></div></div><p class=\\\"small\\\">Pulse clears enemy fire and damages every hostile. You carry three cells; one regenerates every 50 seconds. Release the trigger when your cannons overheat. Sector chart: select a beacon, then launch.</p><p class=\\\"small touch-hint\\\">Touch: drag anywhere on the left to fly. Cannons and aim are assisted. Drag far to boost. Tap PULSE when you need breathing room.</p><div class=\\\"actions\\\">\"'${b('\"'Launch mission ↗','start','','primary')}\"'${b('\"'Protected training','training')}\"'${b('\"'Back','back','','subtle')}</div></div></section>\"'`;\n case'\"'dev':return this.devHTML();\n case'about':return this.aboutHTML();\n case'coop':return \"'`<section class=\"screen overlay\"><div class=\"panel wide\"><div class=\"eyebrow\">Wingmate link / 2 pilots · 1 mission</div><h2>Bring a friend home.</h2><p class=\"small\">Flight lead chooses sectors. The wingmate flies a second ship and shares pulse cells, rescues, and score. In AI Hub, the squadron connects automatically.</p><div class=\"coop-grid\"><div><h3>1. Flight lead</h3><p class=\"small\">Create an invitation and send it to your wingmate. Paste their reply below to connect.</p>${b('\"'Create invitation','host','','primary')}<textarea id=\\\"offer-out\\\" aria-label=\\\"Invitation code\\\" readonly placeholder=\\\"Your invitation appears here\\\"></textarea>\"'${b('\"'Copy invitation','copy','offer-out','subtle')}<textarea id=\\\"answer-in\\\" aria-label=\\\"Wingmate reply\\\" placeholder=\\\"Paste wingmate reply here\\\"></textarea>\"'${b('\"'Connect reply','accept')}</div><div><h3>2. Wingmate</h3><p class=\\\"small\\\">Paste the invitation, generate a reply, then send the reply back to flight lead.</p><textarea id=\\\"offer-in\\\" aria-label=\\\"Flight lead invitation\\\" placeholder=\\\"Paste invitation here\\\"></textarea>\"'${b('\"'Generate reply','join','','primary')}<textarea id=\\\"answer-out\\\" aria-label=\\\"Reply code\\\" readonly placeholder=\\\"Your reply appears here\\\"></textarea>\"'${b('\"'Copy reply','copy','answer-out','subtle')}<p class=\\\"small\\\">No account or game server. Direct WebRTC connection; restrictive networks may need AI Hub.</p></div></div><p id=\\\"network-status\\\" class=\\\"stamp\\\">\"'${escapeHTML(this.networkStatus||'\"'Ready to link')}</p><div class=\\\"actions\\\">\"'${b('\"'Back','back')}\"'${b('\"'Disconnect','leave','','subtle')}</div></div></section>\"'`;\n case'\"'end':{const won=s.state==='victory';return \"'`<section class=\"screen overlay\"><div class=\"panel wide\"><div class=\"eyebrow\">${won?'\"'Transmission received / Solaris':'Transmission lost / frontier rescue'}</div><h2>\"'${won?'\"'The stars answer back.':'A light worth another try.'}</h2><p style=\\\"font-size:20px;color:var(--muted)\\\">\"'${won?'\"'A world below. Voices beside you.<br>You took the long way home. They all did.':'The signal fades, but Anchor is still listening.<br>Your survivors and route signals can still be saved.'}</p><div class=\\\"end-stats\\\"><div><strong>\"'${s.player.score.toLocaleString()}</strong><span>Score</span></div><div><strong>${s.rescued} / 7</strong><span>Survivors</span></div><div><strong>${s.kills}</strong><span>Zylons down</span></div><div><strong>${Math.floor(s.stats.elapsed/60)}:${String(Math.floor(s.stats.elapsed%60)).padStart(2,'\"'0')}</strong><span>Flight time</span></div></div><div class=\\\"actions\\\">\"'${this.net.hub?'\"'<span class=\\\"stamp\\\">Squadron result sent to AI Hub</span>':\"'!won?b('\"'Call Anchor tow','tow','','primary')+b('New mission','start'):b('Fly again ↗','start','','primary')}\"'${this.net.hub?'\"'':b('Return to title','title')}\"'${b('\"'Credits','about','','subtle')}</div><p class=\\\"small\\\">\"'${won?'\"'End of the demo. Seven sectors, one rescued frontier.':'Emergency tow costs 1000 points and keeps your campaign progress.'}</p></div></section>\"'`;}\n case'\"'hubwait':return \"'`<section class=\"screen overlay\"><div class=\"panel\"><div class=\"eyebrow\">AI Hub / squadron synchronized</div><h2>Solar Flair</h2><p class=\"small\">Rescue five survivors. Recover the Red Echo and Rift Gate route signals. Destroy the carrier at Solaris.</p><p class=\"stamp\">Flight computers ready · awaiting launch</p><p class=\"small\">WASD / left stick to fly · mouse / right stick to aim · Space / R2 to fire · Q / □ pulse · Shift / L2 boost</p></div></section>`;\n case'\"'hubend':return \"'`<section class=\"screen overlay\"><div class=\"panel\"><div class=\"eyebrow\">AI Hub / flight ended</div><h2>Signal closed.</h2><p class=\"small\">${escapeHTML(reason||'\"'The hub has ended this round.')}.</p></div></section>\"'`;\n default:return '\"'';}}\n sectorDetails(){const s=this.snapshot();const e=s.sectors.find(e=>e.id===this.selected)||s.sectors[1];return \"'`<div class=\"number\">0${s.sectors.indexOf(e)+1}</div><div class=\"stamp\">${e.complete?'\"'✓ SECTOR SECURE':e.locked?'SIGNAL ENCRYPTED':e.type==='rescue'?'RESCUE SIGNAL':e.type==='base'?'SERVICE BEACON':e.type==='boss'?'FINAL APPROACH':'HOSTILE CONTACTS'}</div><h3>\"'${e.name}</h3><p class=\"desc\">${e.locked?'\"'Rescue 5 survivors. Clear Red Echo and Rift Gate to decode this signal.':e.desc}</p><div class=\\\"actions\\\"><button class=\\\"btn primary\\\" data-action=\\\"jump\\\" \"'${e.locked||this.net.role==='\"'guest'?'disabled':''}>\"'${this.net.role==='\"'guest'?'Lead plotting':e.locked?'Locked':\"'`Warp · ${e.cost} fuel`} <span>↗</span></button></div><p class=\"small\">${e.type==='\"'base'?'Automatic docking · full service':e.complete?'You may revisit this sector.':'Choose your route. Keep enough fuel to return.'}</p>\"'`}\n slider(label,key,value,min,max,step,tuning=false){return `<div class=\"row\"><label for=\"slider-${key}\">${label}</label><input id=\"slider-${key}\" type=\"range\" ${tuning?'\"'data-tuning':'data-setting'}=\\\"\"'${key}\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\"><output>${tuning?value.toFixed(2)+'\"'×':Math.round(value*100)+'%'}</output></div>\"'`}\n devHTML(){const t=this.sim.tuning,b=(...args)=>this.btn(...args);return `<section class=\"screen overlay\"><div class=\"panel wide\"><div class=\"eyebrow\">Developer flight deck / live systems</div><h2>Tune the frontier.</h2><p class=\"dev-note\">Changes apply immediately. Developer settings reset on a new title-screen mission. ${this.net.role==='\"'guest'?'Flight lead owns simulation tuning.':''}</p>\"'${this.net.role==='\"'guest'?b('Back','back'): \"'`${this.slider('\"'Cannon damage','damage',t.damage,.25,4,.05,true)}\"'${this.slider('\"'Hostile speed','enemySpeed',t.enemySpeed,.25,2,.05,true)}\"'${this.slider('\"'Spawn pressure','spawnRate',t.spawnRate,.25,3,.05,true)}\"'${this.slider('\"'Ship response','shipSpeed',t.shipSpeed,.5,2,.05,true)}\"'${this.slider('\"'Aim assistance','assist',t.assist,0,3,.05,true)}<div class=\\\"row\\\"><label for=\\\"god-toggle\\\">Invincible hull</label><input id=\\\"god-toggle\\\" type=\\\"checkbox\\\" data-tuning=\\\"god\\\" \"'${t.god?'\"'checked':''}></div><div class=\\\"actions\\\" style=\\\"margin-top:20px\\\">\"'${b('\"'Refill ship','dev-refill')}\"'${b('\"'Complete objective','dev-complete')}\"'${b('\"'Spawn jammer','dev-spawn')}\"'${b(`Autopilot: ${this.autoPilot?'\"'ON':'OFF'}\"'`,'\"'dev-bot')}\"'${b('\"'Show ending','dev-victory')}</div><h3>Jump to sector</h3><div class=\\\"actions\\\">\"'${this.sim.sectors.map(e=>b(e.name,'\"'dev-warp',e.id)).join('')}</div><div class=\\\"rule\\\"></div><div class=\\\"actions\\\">\"'${b('\"'Back','back','','primary')}\"'${b('\"'Reset tuning','dev-reset')}</div>\"'`}<p class=\"dev-note\">Renderer: ${this.scene.engine} · Three.js r180 · Rapier ${RAPIER.version()} · ${this.sim.entities.size} entities · ${this.sim.bullets.size} shots · ${this.sim.stats.collisions} physics contacts<br>Network: ${this.net.transport} / ${this.net.role} · ${this.net.sent} sent / ${this.net.received} received</p></div></section>`}\n aboutHTML(){const c=CREDITS,labels={date:'\"'Date',source:'Source',plan:'Plan',genre:'Genre',perspective:'Perspective',tech:'Tech',artDirection:'Art direction',animation:'Animation',audio:'Audio',online:'Online',testing:'Testing',research:'Research',environment:'Environment',model:'Model',usage:'Usage'};return \"'`<section class=\"screen overlay\"><div class=\"panel wide\"><div class=\"eyebrow\">Solar Flair / field notes</div><h2>Signals & signatures.</h2><div class=\"credits-scroll\"><p class=\"small\">An original tribute to the galactic charts and frontier rescues of Solaris (Atari, 1986). Game design, procedural geometry, music, radio voices, and code generated for this demo. Three.js: MIT. Rapier: Apache-2.0. AI Hub session client: see its source attribution. Original source created by Doug Neubauer.</p><h3>Source Information</h3><div class=\"info-grid\">${Object.entries(c.sourceInformation).map(([k,v])=>`<div><strong>${labels[k]||k}</strong>${escapeHTML(v)}</div>`).join('\"'')}</div><div class=\\\"feedback\\\"><h3>Testing Feedback</h3>\"'${c.testingFeedback.map((v,i)=>`<p><b>${i+1}.</b> ${escapeHTML(v)}</p>`).join('\"'')}<h3>Engine Feedback</h3>\"'${c.engineFeedback.map((v,i)=>`<p><b>${i+1}.</b> ${escapeHTML(v)}</p>`).join('\"'')}<h3>Prompt Feedback</h3>\"'${c.promptFeedback.map((v,i)=>`<p><b>${i+1}.</b> ${escapeHTML(v)}</p>`).join('\"'')}</div></div><p class=\\\"scroll-hint\\\">Scroll to read all field notes</p>\"'${this.btn('\"'Back','back','','primary')}</div></section>\"'`}\n async host(){this.toast('\"'Generating invitation…');try{const code=await this.net.host();if(\"'$('\"'#offer-out'))\"'$('\"'#offer-out').value=code;this.toast('Invitation ready. Send it to your wingmate.')}catch(e){this.toast(e.message)}}\n async join(){try{const code=await this.net.join(\"'$('\"'#offer-in').value.trim());if(\"'$('\"'#answer-out'))\"'$('\"'#answer-out').value=code;this.toast('Reply ready. Send it back to flight lead.')}catch(e){this.toast(e.message)}}\n async accept(){try{await this.net.accept(\"'$('\"'#answer-in').value.trim());this.toast('Reply accepted. Linking ships…')}catch(e){this.toast(e.message)}}\n async copy(id){const el=\"'$('\"'#'+id);try{await navigator.clipboard.writeText(el.value);this.toast('Code copied')}catch{el.select();document.execCommand('copy');this.toast('Code selected for copying')}}\n startAttract(){if(this.net.hub||this.net.connected)return;this.attract=true;this.paused=false;this.autoPilot=true;this.sim.start();this.sim.tuning.god=true;this.attractIndex=0;this.attractTimer=0;this.jump('shard');\"'$('\"'#attract').classList.remove('hidden');this.messageTimer=0}\n endAttract(){this.attract=false;this.autoPilot=false;this.sim.tuning={...this.sim.defaults};this.sim.start();\"'$('\"'#attract').classList.add('hidden');this.input.keys.clear();this.input.mouse.fire=false;this.show('title')}\n syncPage(){if(this.net.ended||this.attract&&this.page==='title')return;const s=this.snapshot();if(this.net.hub&&\"'!this.started)return;if(['\"'pause','settings','dev','about','controls','coop','title','hubend'].includes(this.page))return;const expected=['map'].includes(s.state)?'map':['victory','defeat'].includes(s.state)?'end':'flight';if(expected\"'!==this.page){if(expected==='\"'map')this.selectBest();this.show(expected)}}\n hud(s){const sector=s.sectors.find(e=>e.id===(s.pendingSector||s.sector));\"'$('\"'#hud-sector').textContent=sector?.name||'FRONTIER';\"'$('\"'#hud-objective').textContent=s.sectorDone?'SECTOR SECURE · returning to chart':s.objective.label;\"'$('\"'#hud-progress').style.width=clamp(s.objective.current/s.objective.target*100,0,100)+'%';\"'$('\"'#hud-count').textContent=s.sectorDone?'✓':s.objective.target<100?\"'`${Math.floor(s.objective.current)} / ${s.objective.target}`:'\"'';\"'$('\"'#hud-score').textContent=String(s.player.score).padStart(6,'0');for(const key of ['shield','hp','fuel','heat']){\"'$('\"'#bar-'+key).style.width=clamp(s.player[key],0,100)+'%';\"'$('\"'#num-'+key).textContent=Math.round(s.player[key])+(key==='heat'&&s.player.overheated?' · COOLING':'')}\"'$('\"'#hud-pulse').innerHTML='◆'.repeat(s.player.pulses)+'<span style=\\\"opacity:.25\\\">'+'◇'.repeat(3-s.player.pulses)+'</span> &nbsp; PULSE';\"'$('\"'#hud-prompts').innerHTML=\"'`<span>${this.input.chip('\"'fire')} Cannons</span><span>\"'${this.input.chip('\"'boost')} Boost</span><span>\"'${this.input.chip('\"'pulse')} Pulse</span><span>\"'${this.input.chip('\"'map')} Tractor</span>\"'`;$('\"'#hud-radio').innerHTML=this.messageTimer>0?\"'`<span class=\"sender\">${this.training?'\"'FLIGHT SCHOOL':'ANCHOR / OPEN CHANNEL'}</span>\"'${escapeHTML(this.message)}`:'\"'';const warp=s.state==='warp';\"'$('\"'#warp-ui').classList.toggle('hidden',\"'!warp);if(warp){$('\"'#warp-name').textContent=sector?.name;\"'$('\"'#warp-progress').style.width=s.warpProgress*100+'%'}\"'$('\"'#reticle').classList.toggle('hidden',warp);const pos=this.input.aim;\"'$('\"'#reticle').style.left=(pos.x*.5+.5)*100+'%';\"'$('\"'#reticle').style.top=(-pos.y*.5+.5)*100+'%';\"'$('\"'#radar-dots').innerHTML=s.entities.map(e=>\"'`<i class=\"blip ${e.type}\" style=\"left:${clamp(e.x/50+.5,.05,.95)*100}%;top:${clamp(1+e.z/130,.05,.93)*100}%\"></i>`).join('\"'');let labels='';for(const e of s.entities.filter(e=>['pod','boss','base'].includes(e.type))){const p=this.scene.project(e.x,e.y,e.z);if(p.visible&&p.x>0&&p.x<innerWidth&&p.y>0&&p.y<innerHeight){labels+=\"'`<div class=\"target-label ${e.type}\" style=\"left:${p.x}px;top:${p.y-(e.type==='\"'boss'?85:40)}px\\\">\"'${e.type==='\"'pod'?'SURVIVOR · '+Math.round(-e.z)+'m':e.type==='base'?'DOCKING BEACON':'SIEGE CARRIER / PHASE '+e.phase}\"'${e.type==='\"'boss'?\"'`<div class=\"bossbar\"><i style=\"width:${Math.max(0,e.hp/e.maxHp*100)}%\"></i></div>`:'\"''}</div>\"'`}}$('\"'#target-labels').innerHTML=labels;\"'$('\"'#touch-context').classList.toggle('hidden',\"'!s.sectorDone);$('\"'#touch-pulse').classList.toggle('hidden',s.sectorDone);\"'$('\"'#touch-pulse').textContent='PULSE '+s.player.pulses;}\n loop(now){const dt=Math.min(.05,(now-this.last)/1000||.016);this.last=now;const input=this.input.poll(dt);if(this.net.ended){this.scene.update(this.snapshot(),dt,'hubend');requestAnimationFrame(this.loop);return}if(this.page==='title'&&\"'!this.net.hub&&now-this.lastActivity>=10000)this.startAttract();let actual=input;if(this.autoPilot&&this.net.role!=='\"'guest')actual=this.sim.botInput();if(this.net.info?.server)actual=this.sim.botInput();const active=\"'!this.paused&&((['\"'flight','map'].includes(this.page))||this.attract||this.net.connected&&this.started);if(active&&this.net.role\"'!=='\"'guest'){const p=this.sim.player,oldX=p.x,oldY=p.y;this.sim.update(dt,actual);p.vx=(p.x-oldX)/dt;p.vy=(p.y-oldY)/dt;if(this.autoPilot){const aim=this.scene.project(actual.aimX,actual.aimY,-65);this.input.aim.x=aim.x/innerWidth*2-1;this.input.aim.y=1-aim.y/innerHeight*2}if(this.net.hub&&this.sim.state==='map'&&this.autoPilot){this.selectBest();this.sim.selectSector(this.selected)}if(this.attract){this.attractTimer+=dt;const order=['shard','echo','haven','chorus','rift','solaris'];if(this.sim.state==='map'){this.attractIndex++;this.sim.selectSector(order[this.attractIndex%order.length],true)}if(this.sim.state==='victory'||this.attractTimer>200){this.startAttract()}}}\n const s=this.snapshot();this.net.update(dt,s,input);this.syncPage();this.audio.update(dt,s.state==='flight'?(s.sector==='solaris'?.9:.5):.1);if(\"'!this.settings.shake)this.scene.shake=0;this.scene.update(s,dt,this.page==='\"'title'||this.page==='about'&&this.returnTo==='title'?'title':this.page,actual.boost);this.messageTimer=Math.max(0,this.messageTimer-dt);this.toastTimer=Math.max(0,this.toastTimer-dt);if(\"'!this.toastTimer)$('\"'#toast').classList.add('hidden');this.hudTimer-=dt;if(this.page==='flight'&&this.hudTimer<=0){this.hud(s);this.hudTimer=.08}requestAnimationFrame(this.loop)}\n}\nasync function boot(){try{await RAPIER.init();const app=new SolarApp();window.solarApp=app;await app.init()}catch(e){console.error(e);\"'$('\"'#load').innerHTML=\"'`<div><div class=\"load-title\">Signal interrupted.</div><p class=\"small\">${escapeHTML(e.message)}</p><p class=\"small\">Use a current WebGPU browser and allow the pinned CDN libraries.<br>Reload to reconnect.</p><button class=\"btn primary\" onclick=\"location.reload()\">Reconnect ↗</button></div>`;window.__solarError=e.message}}\nboot();\nJS'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"agent_message","text":"The gameplay core now completes the full campaign, including rescues, refuelling, and the carrier’s three combat phases. Procedural audio and the standalone co-op link also pass their component checks. I’m integrating the flight presentation and menus before testing the finished HTML.\n"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('scene.js');s=p.read_text().replace('e.id.length','Number(e.id)').replace(\\\"this.gradient=new THREE.DataTexture(new Uint8Array([65,65,65,150,150,150,230,230,230]),3,1,THREE.RGBFormat);/* WebGPU uses RGBA textures. */\\\",'');p.write_text(s)\np=Path('main.js');s=p.read_text().replace('await Promise.all([RAPIER.init(),this.scene.init()]);','await this.scene.init();').replace('this.sim.start();if(this.net.connected)this.sim.setPeerInput({},true);','this.sim.tuning={...this.sim.defaults};this.sim.start();if(this.net.connected)this.sim.setPeerInput({},true);');p.write_text(s)\nPY\ncat > build.mjs <<'JS'\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {fileURLToPath} from 'node:url';\nimport {dirname,resolve} from 'node:path';\nconst dev=dirname(fileURLToPath(import.meta.url));\nconst read=p=>readFileSync(resolve(dev,p),'utf8');\nconst {title,slug}=JSON.parse(read('identity.json'));\nconst credits=read('../exit-interview.json');\nconst html=\"'`<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><script>${read('\"'hub-session.js')}</script>\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\\\">\n<meta name=\\\"theme-color\\\" content=\\\"#091120\\\"><meta name=\\\"description\\\" content=\\\"Solar Flair — a cel-shaded frontier rescue shooter inspired by Solaris (1986).\\\">\n<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-2\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\"><meta name=\\\"hub:session-goal\\\" content=\\\"Rescue 5 survivors, recover Red Echo and Rift Gate signals, then destroy the siege carrier at Solaris.\\\"><meta name=\\\"hub:session-howto\\\" content=\\\"WASD / left stick fly; mouse / right stick aim; Space / R2 fire; Shift / L2 boost; Q / Square pulse; E / Triangle tractor; Esc / Options menu. Wingmate shares the mission.\\\"><meta name=\\\"hub:session-minutes\\\" content=\\\"7\\\">\n<title>\"'${title} · Frontier Rescue</title>\n<style>${read('\"'style.css')}</style>\n<script type=\\\"importmap\\\">{\\\"imports\\\":{\\\"three\\\":\\\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\\\",\\\"three/webgpu\\\":\\\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\\\"}}</script>\n</head><body>\n<canvas id=\\\"world\\\" aria-label=\\\"Solar Flair space flight\\\"></canvas><div id=\\\"grain\\\"></div><div id=\\\"vignette\\\"></div>\n<div id=\\\"app\\\"><main id=\\\"screens\\\"></main>\n<div id=\\\"hud\\\" class=\\\"hidden\\\"><div class=\\\"hud-top\\\"><div class=\\\"sector-heading\\\"><div class=\\\"eyebrow\\\">F-86 Sunskipper / flight lead</div><h3 id=\\\"hud-sector\\\"></h3><div class=\\\"objective\\\"><span id=\\\"hud-objective\\\"></span> <span id=\\\"hud-count\\\"></span></div><div class=\\\"obj-line\\\"><div id=\\\"hud-progress\\\"></div></div></div><div class=\\\"hud-top-right\\\"><div class=\\\"score\\\"><small>SQUADRON SCORE</small><span id=\\\"hud-score\\\">000000</span></div><button id=\\\"pause-button\\\" aria-label=\\\"Pause menu\\\">Ⅱ</button></div></div>\n<div id=\\\"hud-radio\\\" class=\\\"hud-message\\\"></div><div id=\\\"target-labels\\\"></div><div class=\\\"hud-bottom\\\"><div class=\\\"ship-status\\\"><div class=\\\"row\\\"><span>Shield</span><span id=\\\"num-shield\\\"></span></div><div class=\\\"bar\\\"><div id=\\\"bar-shield\\\"></div></div><div class=\\\"row\\\"><span>Hull</span><span id=\\\"num-hp\\\"></span></div><div class=\\\"bar hull\\\"><div id=\\\"bar-hp\\\"></div></div><div class=\\\"row\\\"><span>Fuel</span><span id=\\\"num-fuel\\\"></span></div><div class=\\\"bar fuel\\\"><div id=\\\"bar-fuel\\\"></div></div><div class=\\\"row heat\\\"><span>Cannon heat</span><span id=\\\"num-heat\\\"></span></div><div class=\\\"bar heat\\\"><div id=\\\"bar-heat\\\"></div></div><div id=\\\"hud-pulse\\\" class=\\\"pulse-count\\\"></div></div><div id=\\\"hud-prompts\\\" class=\\\"hud-prompts\\\"></div><div class=\\\"radar-wrap\\\"><div class=\\\"radar\\\"><div id=\\\"radar-dots\\\"></div></div><div class=\\\"radar-label\\\">LOCAL SCANNER / 130m</div></div></div>\n<button id=\\\"touch-pulse\\\" class=\\\"touch-action\\\" aria-label=\\\"Use shield pulse\\\">PULSE</button><button id=\\\"touch-context\\\" class=\\\"touch-action hidden\\\" aria-label=\\\"Return to chart\\\">RETURN</button>\n</div><div id=\\\"reticle\\\" class=\\\"reticle hidden\\\"></div><div id=\\\"warp-ui\\\" class=\\\"warp-title hidden\\\"><div class=\\\"eyebrow\\\">Jump solution acquired</div><h2 id=\\\"warp-name\\\"></h2><div class=\\\"warp-bar\\\"><div id=\\\"warp-progress\\\"></div></div><div class=\\\"eyebrow\\\">Hold on to something.</div></div>\n<div id=\\\"toast\\\" class=\\\"toast hidden\\\"></div><div id=\\\"attract\\\" class=\\\"hidden\\\"><div class=\\\"label\\\"><strong>Solar Flair</strong>Live flight demonstration · any input to return</div></div></div><div id=\\\"flash\\\"></div>\n<div id=\\\"load\\\"><div><div class=\\\"eyebrow\\\">Frontier rescue division</div><div class=\\\"load-title\\\">Solar Flair</div><div class=\\\"loader\\\"></div><div class=\\\"loading-text\\\">CONNECTING TO THE LAST LIGHT</div></div></div>\n<script type=\\\"module\\\">\nimport * as THREE from 'three/webgpu';\nimport RAPIER from 'https://cdn.jsdelivr.net/npm/@dimforge/rapier3d-compat@0.19.3/rapier.mjs';\nconst CREDITS=\"'${credits};\n${['\"'audio.js','network.js','core.js','scene.js','main.js'].map(read).join('\\\\n')}\n</script></body></html>\"'`;\nwriteFileSync(resolve(dev,'\"'../'+slug+'.html'),html);console.log('Built '+slug+'.html ('+Math.round(html.length/1024)+' KB)');\nJS\nnode --check main.js && node --check scene.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
