{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('scene.js');s=p.read_text();anchor='  entity(e){let mesh;'\naddition=\\\"\\\"\\\"  createHomeworld(){\n    const cv=document.createElement('canvas');cv.width=1024;cv.height=512;const c=cv.getContext('2d');c.fillStyle='#317b8d';c.fillRect(0,0,1024,512);\n    let seed=161986;const random=()=>{seed=(seed*16807)%2147483647;return seed/2147483647};\n    for(let i=0;i<23;i++){const x=random()*1024,y=80+random()*350,r=18+random()*85;c.beginPath();for(let j=0;j<14;j++){const a=j/14*Math.PI*2,rr=r*(.5+random()*.5),px=x+Math.cos(a)*rr,py=y+Math.sin(a)*rr*.6;if(\"'!j)c.moveTo(px,py);else c.lineTo(px,py)}c.closePath();c.fillStyle=i%3?'\"'#b7ba86':'#688d74';c.fill();c.strokeStyle='#25495d';c.lineWidth=2;c.stroke()}\n    c.fillStyle='#dce5cb';c.beginPath();c.ellipse(512,0,620,40,0,0,Math.PI*2);c.fill();c.beginPath();c.ellipse(512,512,620,34,0,0,Math.PI*2);c.fill();\n    const tex=new THREE.CanvasTexture(cv);tex.colorSpace=THREE.SRGBColorSpace;const home=this.ink(new THREE.SphereGeometry(105,64,40),this.mat('#d0f0dd',{map:tex}),1.009);home.position.set(-110,-125,-310);home.rotation.z=.18;\n    const atmosphere=new THREE.Mesh(new THREE.SphereGeometry(107,48,32),new THREE.MeshBasicMaterial({color:'#8fe8d0',side:THREE.BackSide,transparent:true,opacity:.18}));home.add(atmosphere);this.sky.add(home);home.visible=false;this.homeworld=home;\n  }\n\\\"\\\"\\\"\ns=s.replace(anchor,addition+anchor)\ns=s.replace(\\\"this.rings=rings;const sunGroup=\\\", \\\"this.rings=rings;this.createHomeworld();const sunGroup=\\\")\ns=s.replace(\\\"this.planet.position.x=title?95:105;this.rings.position.copy(this.planet.position);\\\", \\\"const region=s?.pendingSector||s?.sector;const home=region==='solaris'&&\"'!title;this.homeworld.visible=home;if(home)this.homeworld.rotation.y+=dt*.012;this.planet.position.x=title?95:home?185:105;const tint={anchor:'\"'#d9c5a0',shard:'#efd0b3',echo:'#d9908e',haven:'#a0d3c5',chorus:'#a9b6b1',rift:'#ab859f',solaris:'#a3bdce'};this.planet.children[1].material.color.set(title?'#e0b185':tint[region]||'#e0b185');this.rings.position.copy(this.planet.position);\\\")\np.write_text(s)\np=Path('main.js');s=p.read_text().replace(\\\"this.activePad=pad||null;const result=\\\",\\\"this.activePad=pad||null;if(\"'!pad)this.prevButtons=[];const result=\");p.write_text(s)\nPY\nnode --check scene.js\ncat > verify.mjs <<'\"'JS'\nimport {spawn} from 'node:child_process';\nimport {readFileSync} from 'node:fs';\nimport {fileURLToPath} from 'node:url';\nimport {dirname,resolve} from 'node:path';\nconst dev=dirname(fileURLToPath(import.meta.url));\nconst {slug}=JSON.parse(readFileSync(resolve(dev,'identity.json'),'utf8'));\nlet checks=0,failures=[];\nconst check=(v,name)=>{checks++;if(\"'!v)failures.push(name)};\ntry{\n const c=JSON.parse(readFileSync(resolve(dev,'\"'../exit-interview.json'),'utf8'));\n check(Object.keys(c.sourceInformation).length===16,'Source Information field shape');\n check(c.testingFeedback.length===4&&c.engineFeedback.length===6&&c.promptFeedback.length===4,'All interview answers present');\n check(c.sourceInformation.usage==='added on import','Usage attribution literal preserved');\n check(c.aiHub.name==='Solar Flair'&&c.aiHub.players==='1–2','Catalogue title and supported seats');\n check(c.aiHub.tags.length>=3&&c.aiHub.tags.length<=6,'Catalogue tags count');\n const html=readFileSync(resolve(dev,'../'+slug+'.html'),'utf8');\n const session=readFileSync(resolve(dev,'hub-session.js'),'utf8');\n check(html.includes('<meta charset=\\\"utf-8\\\"><script>'+session+'</script>'),'Unmodified official session client first after charset');\n check(html.includes('three@0.180.0')&&html.includes('rapier3d-compat@0.19.3'),'Required dependencies pinned');\n check(\"'!/<script[''^>]+src=[\"'\"'](?\"'!https?:)/.test(html),'\"'Single HTML has no local script dependency');\n}catch(e){failures.push(e.message)}\nconst py='/home/micha/.local/share/pipx/venvs/playwright/bin/python';\nconst jobs=[['node',['test-core.mjs']], [py,['test-game.py']], [py,['test-network.py','--game',slug+'.html']], [py,['test-hub.py']]];\nfor(const [bin,args] of jobs){\n const out=await new Promise(resolveResult=>{const p=spawn(bin,args,{cwd:dev,stdio:['ignore','pipe','pipe'],env:{...process.env,TMPDIR:resolve(dev,'.browser-tmp')}});let output='';p.stdout.on('data',b=>output+=b);p.stderr.on('data',b=>output+=b);p.on('error',e=>resolveResult({code:1,output:e.message}));p.on('close',code=>resolveResult({code,output}));});\n const matches=[...out.output.matchAll(/(\\\\d+)\\\\s+(?:core checks passed|game checks|network checks|AI Hub checks)/g)];for(const m of matches)checks+=Number(m[1]);\n if(out.code\"'!==0)failures.push(args[0]+'\"': '+out.output.trim());\n}\nfor(const f of failures)console.log('FAIL: '+f);\nconsole.log(\"'`${checks} checks; ${failures.length} failures`);\nprocess.exitCode=failures.length?1:0;\nJS\nnode --check verify.mjs'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
