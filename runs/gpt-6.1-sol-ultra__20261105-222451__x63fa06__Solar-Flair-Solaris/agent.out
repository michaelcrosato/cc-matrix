{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' core.js\"","aggregated_output":"/* Solaris-inspired deterministic flight rules. Rapier owns sensor contacts. */\nclass SolarSim {\n  constructor(RAPIER, emit = () => {}) {\n    this.R = RAPIER;\n    this.emit = emit;\n    this.defaults = { damage: 1, enemySpeed: 1, spawnRate: 1, shipSpeed: 1, assist: 1, god: false };\n    this.tuning = { ...this.defaults };\n    this.sectorDefinitions = [\n      { id: 'anchor', name: 'ANCHOR STATION', x: 11, y: 67, type: 'base', cost: 0, desc: 'A light in the dark. Repair, refuel, and rearm.' },\n      { id: 'shard', name: 'SHARD BELT', x: 29, y: 32, type: 'rescue', cost: 10, desc: 'Three lifeboats among the wrecks. Fly into their green tractor rings.' },\n      { id: 'echo', name: 'RED ECHO', x: 36, y: 77, type: 'combat', cost: 12, desc: 'Seven Zylon raiders. Break their patrol and recover a route signal.' },\n      { id: 'haven', name: 'FAR HAVEN', x: 54, y: 53, type: 'base', cost: 8, desc: 'The last service beacon. Your hull, fuel, and pulse cells restored.' },\n      { id: 'chorus', name: 'LOST CHORUS', x: 67, y: 21, type: 'rescue', cost: 14, desc: 'Four survivor pods are broadcasting. Zylons are listening too.' },\n      { id: 'rift', name: 'RIFT GATE', x: 76, y: 73, type: 'combat', cost: 15, desc: 'Ten defenders and a signal jammer. Clear the gate for your final jump.' },\n      { id: 'solaris', name: 'SOLARIS', x: 91, y: 40, type: 'boss', cost: 18, desc: 'The lost world. Destroy the siege carrier and bring the survivors home.' }\n    ];\n    this.dev = {\n      refill: () => this.refill(),\n      complete: () => this.completeSector(true),\n      spawn: (kind = 'fighter') => this.spawnEnemy(kind),\n      warp: (id) => { if (this.state === 'flight') this.finishSector(true); this.selectSector(id, true); },\n      victory: () => this.win(),\n      tow: () => this.emergencyTow()\n    };\n    this.start();\n  }\n  start() {\n    if (this.queue) this.queue.free();\n    if (this.world) this.world.free();\n    this.world = new this.R.World({ x: 0, y: 0, z: 0 });\n    this.queue = new this.R.EventQueue(true);\n    this.entities = new Map(); this.bullets = new Map(); this.colliderIndex = new Map();\n    this.remove = new Set(); this.nextId = 1; this.seed = 86261986;\n    this.state = 'map'; this.sector = 'anchor'; this.pendingSector = null;\n    this.time = 0; this.stageTime = 0; this.warpTime = 0; this.returnTimer = 0;\n    this.player = { x: 0, y: 0, z: 0, hp: 100, shield: 100, fuel: 100, pulses: 3, pulse: 3, score: 0, heat: 0, overheated: false, invincible: 0, boost: false };\n    this.wingman = { x: 5, y: 1, z: -2, active: false, hp: 100, shield: 100, heat: 0 };\n    this.peerInput = {}; this.peerActive = false;\n    this.completed = new Set(); this.rescued = 0; this.kills = 0; this.deaths = 0;\n    this.objective = { label: 'RESCUE 5 SURVIVORS · RECOVER 2 ROUTE SIGNALS', current: 0, target: 5 };\n    this.sectorProgress = 0; this.sectorDone = false; this.lastMessage = 'The frontier is going dark. Bring them home.';\n    this.fireTimer = 0; this.wingFireTimer = 0; this.spawnTimer = 0; this.podTimer = 0; this.rockTimer = 0; this.pulseTimer = 0; this.pulseRefill = 0;\n    this.previousPulse = false; this.previousInteract = false; this.stats = { shots: 0, hits: 0, damageTaken: 0, pulsesUsed: 0, collisions: 0, sectorsVisited: [], elapsed: 0 };\n    this.playerBody = this._body('player', 0, 0, 0, 1.45, 'player');\n    this.wingBody = this._body('wing', 5, 1, -2, 1.3, 'wing');\n    this.emit({ type: 'reset' });\n  }\n  random() { let a = this.seed | 0; a ^= a << 13; a ^= a >>> 17; a ^= a << 5; this.seed = a >>> 0; return this.seed / 4294967296; }\n  range(a, b) { return a + this.random() * (b - a); }\n  _body(id, x, y, z, radius, cat, dynamic = false) {\n    const d = dynamic ? this.R.RigidBodyDesc.dynamic().setCcdEnabled(true) : this.R.RigidBodyDesc.kinematicPositionBased();\n    d.setTranslation(x, y, z);\n    const b = this.world.createRigidBody(d);\n    const c = this.world.createCollider(this.R.ColliderDesc.ball(radius).setSensor(true).setActiveEvents(this.R.ActiveEvents.COLLISION_EVENTS).setActiveCollisionTypes(this.R.ActiveCollisionTypes.ALL), b);\n    this.colliderIndex.set(c.handle, { id, cat });\n    b.userData = { collider: c.handle };\n    return b;\n  }\n  _dropBody(body) {\n    if (!body) return;\n    try { this.colliderIndex.delete(body.userData.collider); this.world.removeRigidBody(body); } catch (_) { /* Reset may already have released its world. */ }\n  }\n  _clearSpace() {\n    for (const e of this.entities.values()) this._dropBody(e.body);\n    for (const b of this.bullets.values()) this._dropBody(b.body);\n    this.entities.clear(); this.bullets.clear(); this.remove.clear();\n  }\n  get sectors() {\n    return this.sectorDefinitions.map(s => ({ ...s, complete: this.completed.has(s.id), locked: s.id === 'solaris' && !this.bossUnlocked(), current: s.id === this.sector }));\n  }\n  bossUnlocked() { return this.rescued >= 5 && this.completed.has('echo') && this.completed.has('rift'); }\n  message(text, kind = 'radio') { this.lastMessage = text; this.emit({ type: 'message', text, kind }); }\n  selectSector(id, force = false) {\n    if (this.state !== 'map' && !force) return false;\n    const s = this.sectorDefinitions.find(s => s.id === id);\n    if (!s || (s.id === 'solaris' && !this.bossUnlocked() && !force)) { this.message('Solaris is hidden. Rescue five survivors and recover both route signals.'); return false; }\n    if (this.player.fuel < s.cost && !force) { this.message('Not enough fuel. Anchor Station can tow you home.'); return false; }\n    this._clearSpace(); this.player.fuel = Math.max(0, this.player.fuel - s.cost);\n    this.pendingSector = id; this.state = 'warp'; this.warpTime = 0; this.stageTime = 0;\n    this.player.x = 0; this.player.y = 0;\n    this.emit({ type: 'warp', sector: id });\n    return true;\n  }\n  _enterSector(id) {\n    this.sector = id; this.pendingSector = null; this.state = 'flight'; this.stageTime = 0; this.sectorProgress = 0; this.sectorDone = false; this.returnTimer = 0;\n    this.spawnTimer = 1.2; this.podTimer = 2; this.rockTimer = .4; this.fireTimer = 0;\n    this.player.invincible = 2; this.stats.sectorsVisited.push(id);\n    const s = this.sectorDefinitions.find(s => s.id === id);\n    if (s.type === 'base') {\n      this.objective = { label: 'HOLD COURSE · AUTOMATIC DOCKING', current: 0, target: 6 };\n      this._spawn('base', { x: 0, y: 0, z: -42, hp: 100, radius: 8, scale: 1, kind: 'station' });\n      this.message('Service beacon acquired. Hold course for docking.');\n    } else if (s.type === 'rescue') {\n      this.objective = { label: 'TRACTOR THE SURVIVOR PODS', current: 0, target: id === 'shard' ? 3 : 4 };\n      this.message(id === 'shard' ? 'Life signs in the belt. Fly through the green tractor rings.' : 'Their voices are faint. Follow the green beacons.');\n      this.spawnPod();\n      if (id === 'chorus') this.spawnEnemy();\n    } else if (s.type === 'combat') {\n      this.objective = { label: id === 'rift' ? 'BREAK THE GATE DEFENSE' : 'CLEAR THE ZYLON PATROL', current: 0, target: id === 'rift' ? 10 : 7 };\n      this.message(id === 'rift' ? 'Jammer online. Take out the gate defenders.' : 'Zylon patrol ahead. Give them a reason to turn back.');\n      this.spawnEnemy(); this.spawnEnemy();\n      if (id === 'rift') this.spawnEnemy('jammer');\n    } else {\n      this.objective = { label: 'DESTROY THE SIEGE CARRIER', current: 0, target: 1800 };\n      this._spawn('boss', { x: 0, y: 1, z: -88, hp: 1800, maxHp: 1800, radius: 8.3, scale: 1, kind: 'carrier', phase: 1, fireTimer: 3 });\n      this.message('Solaris. Still burning. One carrier between us and home.');\n    }\n    this.emit({ type: 'sector', sector: id, kind: s.type });\n  }\n  _spawn(type, values = {}) {\n    const id = this.nextId++;\n    const e = { id, type, kind: type, x: 0, y: 0, z: -80, hp: 32, maxHp: 32, rot: this.range(0, 6.28), scale: 1, age: 0, radius: 1.5, seed: this.range(0, 6.28), ...values };\n    e.homeX = e.x; e.homeY = e.y;\n    e.body = this._body(id, e.x, e.y, e.z, e.radius, type);\n    this.entities.set(id, e); return e;\n  }\n  spawnEnemy(kind = 'fighter') {\n    if (this.entities.size > 40) return null;\n    const hp = kind === 'jammer' ? 125 : kind === 'interceptor' ? 30 : 44;\n    return this._spawn('enemy', { kind, x: this.range(-17, 17), y: this.range(-7, 8), z: this.range(-100, -82), hp, maxHp: hp, radius: kind === 'jammer' ? 3.1 : 2.1, scale: kind === 'jammer' ? 1.7 : 1, fireTimer: this.range(2, 4), speed: kind === 'interceptor' ? 17 : this.range(9, 13) });\n  }\n  spawnPod() { return this._spawn('pod', { x: this.range(-11, 11), y: this.range(-5.5, 5.5), z: -80, hp: 1, maxHp: 1, radius: 1.8, scale: 1, kind: 'survivor' }); }\n  spawnRock() {\n    const radius = this.range(1.4, 3.8);\n    return this._spawn('asteroid', { x: this.range(-24, 24), y: this.range(-14, 14), z: -110, hp: 25 + radius * 10, maxHp: 25 + radius * 10, radius, scale: radius, kind: 'rock', speed: this.range(11, 23) });\n  }\n  _fire(owner, actor, input) {\n    let ax = Number.isFinite(input.aimX) ? input.aimX : actor.x;\n    let ay = Number.isFinite(input.aimY) ? input.aimY : actor.y;\n    const assist = Math.max(0, Number(this.tuning.assist) || 0);\n    let target = null, best = 7.5 * assist;\n    for (const e of this.entities.values()) if ((e.type === 'enemy' || e.type === 'boss') && e.z < -8) {\n      // Aim is expressed on a plane 65 units ahead; project target onto it.\n      const factor = 65 / Math.max(15, -e.z);\n      const tx = actor.x + (e.x - actor.x) * factor, ty = actor.y + (e.y - actor.y) * factor;\n      const d = Math.hypot(tx - ax, ty - ay);\n      if (d < best + (e.type === 'boss' ? 5 : 0)) { best = d; target = e; }\n    }\n    let tx = ax, ty = ay, tz = -65;\n    if (target) { tx = target.x; ty = target.y; tz = target.z; }\n    const dx = tx - actor.x, dy = ty - actor.y, dz = tz - (actor.z || 0), norm = Math.hypot(dx, dy, dz);\n    const speed = 145;\n    for (const side of [-1, 1]) {\n      const id = this.nextId++, x = actor.x + side * .7, y = actor.y - .1, z = (actor.z || 0) - 2;\n      const b = { id, owner, x, y, z, vx: dx / norm * speed, vy: dy / norm * speed, vz: dz / norm * speed, age: 0, damage: 12 * this.tuning.damage };\n      b.body = this._body(id, x, y, z, .55, 'bullet', true); b.body.setLinvel({ x: b.vx, y: b.vy, z: b.vz }, true); this.bullets.set(id, b);\n    }\n    this.stats.shots += 2; this.emit({ type: 'fire', owner, x: actor.x, y: actor.y, z: actor.z || 0 });\n  }\n  _enemyFire(e, count = 1, spread = .7) {\n    const dx = this.player.x - e.x, dy = this.player.y - e.y, dz = -e.z, norm = Math.hypot(dx, dy, dz), speed = e.type === 'boss' ? 36 : 29;\n    for (let i = 0; i < count; i++) {\n      const id = this.nextId++;\n      const b = { id, owner: 'enemy', x: e.x, y: e.y, z: e.z + 2, vx: dx / norm * speed + (i - (count - 1) / 2) * spread, vy: dy / norm * speed, vz: dz / norm * speed, age: 0, damage: e.type === 'boss' ? 15 : 10 };\n      b.body = this._body(id, b.x, b.y, b.z, .65, 'bullet', true); b.body.setLinvel({ x: b.vx, y: b.vy, z: b.vz }, true); this.bullets.set(id, b);\n    }\n  }\n  _hitPlayer(damage, source = 'enemy') {\n    if (this.tuning.god || this.player.invincible > 0 || this.state !== 'flight' || this.sectorDone) return;\n    const blocked = Math.min(this.player.shield, damage);\n    this.player.shield -= blocked; this.player.hp = Math.max(0, this.player.hp - damage + blocked); this.player.invincible = .65;\n    this.stats.damageTaken += damage;\n    this.emit({ type: 'hit', owner: 'player', damage, source, x: this.player.x, y: this.player.y, z: 0 });\n    if (this.player.hp <= 0) { this.state = 'defeat'; this.deaths++; this.emit({ type: 'defeat', score: this.player.score }); this.message('Signal lost. The frontier still needs you.'); }\n  }\n  _damageEntity(e, damage) {\n    if (!e || this.remove.has(e.id) || e.type === 'pod' || e.type === 'base') return;\n    e.hp -= damage; this.stats.hits++;\n    this.emit({ type: 'hit', owner: e.type, id: e.id, x: e.x, y: e.y, z: e.z, damage });\n    if (e.type === 'boss') this.objective.current = Math.min(this.objective.target, this.objective.target - Math.max(0, e.hp));\n    if (e.hp > 0) return;\n    this.remove.add(e.id);\n    const points = e.type === 'boss' ? 10000 : e.kind === 'jammer' ? 1200 : e.type === 'asteroid' ? 60 : 350;\n    this.player.score += points;\n    this.emit({ type: 'explode', id: e.id, kind: e.type, x: e.x, y: e.y, z: e.z, scale: e.type === 'boss' ? 9 : e.scale, points });\n    if (e.type === 'enemy') {\n      this.kills++; if (this.sector === 'echo' || this.sector === 'rift') { this.sectorProgress++; this.objective.current = this.sectorProgress; }\n      if (e.kind === 'jammer') this.message('Jammer destroyed. The gate is clear on sensors.');\n    }\n    if (e.type === 'boss') this.win();\n  }\n  pulse() {\n    if (this.state !== 'flight' || this.player.pulses <= 0 || this.pulseTimer > 0 || this.sectorDone) return false;\n    this.player.pulses--; this.player.pulse = this.player.pulses; this.pulseTimer = 1.1; this.stats.pulsesUsed++;\n    this.player.shield = Math.min(100, this.player.shield + 15);\n    for (const b of this.bullets.values()) if (b.owner === 'enemy') this.remove.add(b.id);\n    for (const e of this.entities.values()) if (e.type === 'enemy' || e.type === 'asteroid' || e.type === 'boss') this._damageEntity(e, e.type === 'boss' ? 135 : 100);\n    this.emit({ type: 'pulse', x: this.player.x, y: this.player.y, z: 0 });\n    return true;\n  }\n  refill() {\n    Object.assign(this.player, { hp: 100, shield: 100, fuel: 100, pulses: 3, pulse: 3, heat: 0, overheated: false });\n    this.message('Hull sealed. Tanks full. Three pulse cells. Bring them home.'); this.emit({ type: 'shield' });\n  }\n  setPeerInput(input = {}, active = true) { this.peerInput = input; this.peerActive = active; this.wingman.active = active; }\n  completeSector(force = false) {\n    if (this.state !== 'flight' || this.sectorDone) return false;\n    if (force && this.sector === 'solaris') { this.win(); return true; }\n    if (!force && this.objective.current < this.objective.target) return false;\n    if (force && (this.sector === 'shard' || this.sector === 'chorus')) {\n      const missing = Math.max(0, this.objective.target - this.sectorProgress); this.rescued += missing;\n    }\n    this.sectorProgress = this.objective.target; this.objective.current = this.objective.target;\n    this.sectorDone = true; this.returnTimer = 5; this.completed.add(this.sector);\n    if (this.sector === 'anchor' || this.sector === 'haven') this.refill();\n    else { this.player.score += 1000; this.player.shield = Math.min(100, this.player.shield + 25); this.player.pulses = Math.min(3, this.player.pulses + 1); this.player.pulse = this.player.pulses; }\n    for (const e of this.entities.values()) if (e.type !== 'base') this.remove.add(e.id);\n    for (const b of this.bullets.values()) this.remove.add(b.id);\n    this.message(this.sector === 'echo' || this.sector === 'rift' ? 'Route signal recovered. Sector secure. Returning to chart.' : this.sector === 'anchor' || this.sector === 'haven' ? 'Service complete. Clear skies, pilot.' : 'Survivors aboard. You brought them back. Returning to chart.', 'success');\n    this.emit({ type: 'complete', sector: this.sector, rescued: this.rescued });\n    return true;\n  }\n  finishSector(force = false) {\n    if (!this.sectorDone && !force) return false;\n    this._clearSpace(); this.state = 'map'; this.returnTimer = 0;\n    this.objective = { label: 'RESCUE 5 SURVIVORS · RECOVER 2 ROUTE SIGNALS', current: Math.min(5, this.rescued), target: 5 };\n    this.emit({ type: 'map' }); return true;\n  }\n  emergencyTow() {\n    this._clearSpace(); this.state = 'map'; this.sector = 'anchor'; this.player.hp = Math.max(55, this.player.hp); this.player.shield = Math.max(45, this.player.shield); this.player.fuel = 70;\n    this.player.pulses = Math.max(1, this.player.pulses); this.player.pulse = this.player.pulses; this.player.score = Math.max(0, this.player.score - 1000);\n    this.objective = { label: 'RESCUE 5 SURVIVORS · RECOVER 2 ROUTE SIGNALS', current: Math.min(5, this.rescued), target: 5 };\n    this.message('Anchor tow complete. Your score covered the bill.'); this.emit({ type: 'map' });\n  }\n  win() {\n    if (this.state === 'victory') return;\n    this.state = 'victory'; this.completed.add('solaris'); this.player.score += this.rescued * 500;\n    this.message('Solaris answers. Seven small voices, and a whole world of light. Welcome home.');\n    this.emit({ type: 'victory', score: this.player.score, rescued: this.rescued, time: this.stats.elapsed });\n  }\n  _contact(a, b) {\n    if (!a || !b) return;\n    if (a.cat !== 'bullet' && b.cat === 'bullet') [a, b] = [b, a];\n    if (a.cat === 'bullet') {\n      const shot = this.bullets.get(a.id); if (!shot || this.remove.has(a.id)) return;\n      if (shot.owner === 'enemy') {\n        if (b.cat === 'player') { this._hitPlayer(shot.damage); this.remove.add(a.id); this.stats.collisions++; }\n      } else if (b.cat === 'enemy' || b.cat === 'boss' || b.cat === 'asteroid') {\n        this._damageEntity(this.entities.get(b.id), shot.damage); this.remove.add(a.id); this.stats.collisions++;\n      }\n","exit_code":0,"status":"completed"}}
