complete')this.audio.sfx('rescue');if(e.type==='message'){this.message=e.text;this.messageTimer=5.5;this.audio.voice(e.kind)}if(e.type==='victory'){this.audio.sfx('win');this.scene.burst(0,3,-40,'#ffb85f',70);if(this.net?.role==='host'&&\"'!this.attract)this.net.finish(true,e.score)}if(e.type==='\"'defeat'){this.audio.sfx('lose');if(this.net?.role==='host'&&\"'!this.attract)this.net.finish(false,e.score)} }\n onRemote(s){if(this.remoteState!==s.state){this.remoteState=s.state;if(s.state==='\"'map')this.show('map');else if(['victory','defeat'].includes(s.state))this.show('end');else if(this.page\"'!=='\"'pause'&&this.page\"'!=='\"'settings')this.show('flight')}if(s.lastMessage\"'!==this.remoteMessage){this.remoteMessage=s.lastMessage;this.message=s.lastMessage;this.messageTimer=5;this.audio.voice('\"'radio')}const ids=new Set(s.entities.map(e=>e.id));if(this.remoteEntityIds)for(const id of this.remoteEntityIds)if(\"'!ids.has(id)){const e=this.remoteEntityCache?.get(id);if(e&&['\"'enemy','asteroid'].includes(e.type))this.scene.burst(e.x,e.y,e.z,'#ffb85f',15)}this.remoteEntityIds=ids;this.remoteEntityCache=new Map(s.entities.map(e=>[e.id,e]));}\n bindUI(){this.ui.addEventListener('click',e=>{const btn=e.target.closest('button');if(\"'!btn||btn.disabled)return;this.input.activity(this.input.touch&&e.pointerType==='\"'touch'?'touch':this.input.last);this.audio.unlock();this.audio.sfx('ui');this.action(btn.dataset.action,btn.dataset.value)});this.ui.addEventListener('pointerover',e=>{const btn=e.target.closest('button');if(btn&&\"'!btn.disabled){this.focus(btn,false);if(btn.dataset.action==='\"'select')this.select(btn.dataset.value,false)}});this.ui.addEventListener('input',e=>{const setting=e.target.dataset.setting,tuning=e.target.dataset.tuning;if(setting){const value=e.target.type==='checkbox'?e.target.checked:Number(e.target.value);this.settings[setting]=value;if(setting==='music')this.audio.setMusic(value);if(setting==='sfx')this.audio.setSfx(value);this.save();const