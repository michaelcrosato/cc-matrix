nt-weight:400}.resource-strip span{display:block;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-top:5px}#hud{position:absolute;inset:0;pointer-events:none;padding:3.5vh 4vw}#hud>*{pointer-events:none}.hud-top{display:flex;justify-content:space-between;align-items:start}.sector-heading .eyebrow{font-size:11px}.sector-heading h3{font-size:23px;margin:5px 0 12px;text-transform:uppercase;letter-spacing:.06em}.objective{font-size:16px;color:var(--mint)}.obj-line{height:3px;width:230px;background:#ffffff22;margin-top:10px}.obj-line div{height:100%;background:var(--mint);transition:width .3s}.hud-top-right{text-align:right;display:flex;gap:25px;align-items:start}.score{font-size:25px;color:var(--amber);font-variant-numeric:tabular-nums}.score small{display:block;color:var(--muted);font-size:10px;letter-spacing:.2em;margin-bottom:6px}.hud-bottom{position:absolute;bottom:4vh;left:4vw;right:4vw;display:flex;justify-content:space-between;align-items:end;gap:30px}.ship-status{width:235px}.ship-status .row{font-size:11px;padding:5px 0;border:none;text-transform:uppercase;letter-spacing:.12em}.bar{height:5px;background:#abbfd525;margin:0 0 10px;border-radius:3px;overflow:hidden}.bar>div{height:100%;background:var(--mint);transition:width .15s}.bar.hull>div{background:var(--paper)}.bar.fuel>div{background:var(--amber)}.bar.heat>div{background:var(--red)}.hud-prompts{font-size:12px;display:flex;gap:22px;color:#bdcad7;align-items:center;flex-wrap:wrap;max-width:540px;justify-content:center}.hud-prompts>span{white-space:nowrap}.pulse-count{color:var(--amber);font-size:13px;letter-spacing:.12em}.radar{width:135px;height:135px;border:1px solid #8fe8d044;border-radius:50%;position:relative;background:radial-gradient(transparent 48%,#8fe8d022 49%,transparent 50%),linear-gradient(90deg,transparent 49.5%,#8fe8d022 50%,transparent 50.5%),linear-gradient(transparent 49.5%,#8fe8d022 50%,transparent 50.5%),#0715229c;overflow:hidden}.radar::after{position:absolute;content:'▲';left:calc(50% - 5px);bottom:8px;font-size:10px;color:var(--paper)}.blip{position:absolute;width:4px;height:4px;background:var(--red);border-radius:50%}.blip.pod{background:var(--mint)}.blip.base{background:var(--amber);width:7px;height:7px}.radar-label{font-size:9px;color:var(--muted);text-align:center;letter-spacing:.16em;margin-top:7px}.reticle{position:absolute;left:50%;top:50%;width:40px;height:40px;transform:translate(-50%,-50%);border:1px solid #f4eddb80;border-radius:50%;pointer-events:none}.reticle:before,.reticle:after{position:absolute;content:'';background:var(--amber)}.reticle:before{width:4px;height:4px;left:17px;top:17px;border-radius:100%}.reticle:after{width:60px;height:1px;left:-11px;top:19px;background:linear-gradient(90deg,var(--amber) 0 12%,transparent 12% 88%,var(--amber) 88%)}.reticle.lock{border-color:var(--red);box-shadow:0 0 20px #ff6d6922}.hud-message{position:absolute;left:50%;top:24%;transform:translateX(-50%);text-align:center;width:min(600px,80vw);text-shadow:0 2px 6px #000;font-size:18px;color:var(--paper);line-height:1.6}.hud-message .sender{font-size:10px;display:block;color:var(--mint);letter-spacing:.22em;margin-bottom:6px}.target-label{position:absolute;transform:translate(-50%,-50%);font-size:10px;color:var(--mint);letter-spacing:.16em;white-space:nowrap;text-shadow:0 2px 4px #000}.target-label::before{content:'◇';display:block;text-align:center;font-size:32px;margin-bottom:8px}.target-label.boss{color:var(--red)}.target-label .bossbar{height:4px;width:180px;background:#ffffff22;margin-top:8px}.target-label .bossbar i{height:100%;display:block;background:var(--red)}#pause-button{pointer-events:auto;background:#071522aa;border:1px solid var(--line);border-radius:50%;width:42px;height:42px;display:grid;place-content:center}.warp-title{position:absolute;left:50%;top:40%;transform:translate(-50%,-50%);text-align:center;pointer-events:none}.warp-title h2{font-size:58px;text-transform:uppercase;letter-spacing:.15em;margin:15px 0}.warp-bar{width:280px;height:2px;background:#fff3;margin:25px auto}.warp-bar div{height:100%;background:var(--amber);transition:width .1s}#flash{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse,transparent 30%,#ff6655aa);opacity:0;transition:opacity .1s}#attract{position:absolute;inset:0;border:7px solid #ffb85f80;pointer-events:none;display:flex;align-items:end;justify-content:center;padding:5vh;background:linear-gradient(transparent 70%,#081120d9)}#attract .label{text-align:center;font-size:13px;letter-spacing:.2em;text-transform:uppercase}#attract strong{display:block;font-family:Georgia,serif;font-style:italic;font-size:45px;letter-spacing:0;color:var(--amber);margin-bottom:10px}.toast{position:absolute;bottom:17vh;left:50%;transform:translateX(-50%);border:1px solid var(--line);background:#0c192ce8;padding:13px 25px;font-size:14px;color:var(--mint);max-width:80vw;text-align:center;pointer-events:none}#load{position:absolute;inset:0;background:#091120;display:grid;place-content:center;text-align:center;z-index:50}.loader{width:70px;height:70px;border:1px solid #8fe8d033;border-top-color:var(--mint);transform:rotate(45deg);animation:spin 2s linear infinite;margin:25px auto}.loading-text{font-size:13px;color:var(--muted);letter-spacing:.14em}.load-title{font:italic 50px Georgia,serif;color:var(--amber)}@keyframes spin{to{transform:rotate(405deg)}}textarea{width:100%;resize:vertical;min-height:95px;max-height:200px;background:#07101e;border:1px solid var(--line);color:var(--mint);padding:12px;user-select:text;font-family:monospace;font-size:12px}.coop-grid{display:grid;grid-template-columns:1fr 1fr;gap:25px}.stamp{font-size:12px;color:var(--mint);letter-spacing:.17em;text-transform:uppercase}.end-stats{display:flex;gap:45px;margin:25px 0 35px}.end-stats strong{font-size:36px;display:block;color:var(--amber);font-weight:400}.end-stats span{font-size:11px;letter-spacing:.15em;text-transform:uppercase;color:var(--muted)}.touch-action{display:none;position:absolute;right:7vw;bottom:28vh;pointer-events:auto;border:1px solid #8fe8d055;color:var(--mint);background:#10233488;width:65px;height:65px;border-radius:50%;font-size:11px;letter-spacing:.1em}.touch-hint{display:none}.dev-note{font-size:12px;color:var(--muted);line-height:1.7}.version{font-size:10px;letter-spacing:.15em;color:#a8b4c780}.scroll-hint{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin:12px 0}body.touch #hud .hud-prompts,body.touch #hud .ship-status .heat,body.touch #hud .radar-wrap{display:none}body.touch .touch-action{display:block}body.touch .touch-hint{display:block}body.touch .ship-status{width:120px}body.touch .ship-status .row{font-size:9px}body.touch .bar{height:3px;margin-bottom:5px}body.touch .hud-top-right .score{display:none}body.touch .sector-heading h3{font-size:16px}body.touch .objective{font-size:12px}body.touch .obj-line{width:150px}body.touch #hud .hud-bottom{bottom:3vh}body.touch .hud-message{font-size:14px;top:20%}body.touch .hud-message .sender{font-size:8px}body.touch #hud{padding:3vh 4vw}\n@media(max-width:800px){.screen{padding:4vh 5vw}.hero{max-width:75%;padding-top:0}.hero h1{font-size:clamp(65px,14vw,110px);margin:20px 0}.hero .tagline{font-size:18px;margin:0 0 22px}.hero .small{font-size:12px}.title-shade{background:linear-gradient(90deg,#081120ee,#08112080 65%,transparent)}.annotation{display:none}.badge{font-size:9px}.eyebrow{font-size:10px}.btn{font-size:11px;min-height:44px;padding:12px 16px;gap:12px}.btn.primary{min-width:190px}.bottomline .hint{font-size:9px}.planet-label{right:8%;bottom:20%;font-size:8px}.chart-layout{grid-template-columns:minmax(0,1fr) 210px;gap:20px}.chart-info{font-size:12px;max-width:300px}.chart-top h2{font-size:32px}.sector-details h3{font-size:23px}.sector-details .desc{font-size:13px;min-height:65px}.sector-details .number{font-size:40px}.resource-strip{gap:18px}.sector .name{font-size:8px;letter-spacing:.02em}.sector .orb{