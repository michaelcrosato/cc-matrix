nst mesh=new THREE.Mesh(new THREE.OctahedronGeometry(.12+Math.random()*.4),new THREE.MeshBasicMaterial({color,transparent:true,opacity:1}));mesh.position.set(x,y,z);this.scene.add(mesh);this.fx.push({mesh,v:new THREE.Vector3((Math.random()-.5)*17,(Math.random()-.5)*17,(Math.random()-.5)*17),life:.7+Math.random()*.7,max:1.4})}const ring=new THREE.Mesh(new THREE.RingGeometry(.8,1,32),new THREE.MeshBasicMaterial({color,side:THREE.DoubleSide,transparent:true,opacity:.8}));ring.position.set(x,y,z);this.scene.add(ring);this.fx.push({mesh:ring,v:new THREE.Vector3(),life:.5,max:.5,ring:true})}\n  resize(){if(\"'!this.renderer)return;this.camera.aspect=innerWidth/innerHeight;this.camera.updateProjectionMatrix();this.renderer.setSize(innerWidth,innerHeight)}\n  aim(x,y){this.ray.setFromCamera(new THREE.Vector2(x,y),this.camera);const t=(-65-this.ray.ray.origin.z)/this.ray.ray.direction.z;this.tmp.copy(this.ray.ray.direction).multiplyScalar(t).add(this.ray.ray.origin);return {aimX:THREE.MathUtils.clamp(this.tmp.x,-55,55),aimY:THREE.MathUtils.clamp(this.tmp.y,-35,35)}}\n  project(x,y,z){this.tmp.set(x,y,z).project(this.camera);return{x:(this.tmp.x*.5+.5)*innerWidth,y:(-.5*this.tmp.y+.5)*innerHeight,visible:this.tmp.z<1&&this.tmp.z>0}}\n  update(s,dt,menu,boost=false){this.t+=dt;const title=menu==='\"'title'||menu==='about-title'||\"'!s;const flight=s&&(s.state==='\"'flight'||s.state==='warp')&&\"'!title;this.planet.rotation.y+=dt*.008;this.planet.position.x=title?95:105;this.rings.position.copy(this.planet.position);this.titleFormation.forEach((m,i)=>{m.visible=title;m.position.y=7+i*2+Math.sin(this.t*.3+i)*2});const p=s?.player||{x:0,y:0};if(title){this.player.position.set(10+Math.sin(this.t*.3),-2+Math.sin(this.t*.5)*.4,-15);this.player.rotation.set(-.05,-.25,Math.sin(this.t*.4)*.055-.12);this.player.scale.setScalar(2.1);this.camera.position.lerp(new THREE.Vector3(0,6,30),.04);this.camera.lookAt(0,0,-50)}else{this.player.scale.setScalar(1);this.player.position.set(p.x,p.y,0);