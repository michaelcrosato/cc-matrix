{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"cat >> style.css <<'CSS'\n@media(max-height:550px) and (orientation:landscape){.chart-screen{padding:2.5vh 4vw}.chart-screen .topline{height:24px;min-height:24px}.chart-screen .topline .btn{min-height:24px;padding:2px 8px}.chart-screen .chart-top{align-items:center}.chart-screen .chart-top h2{font-size:27px;margin:4px 0}.chart-screen .chart-info{display:none}.chart-screen .chart-top .small{font-size:10px}.chart-screen .chart-layout{grid-template-columns:minmax(0,1fr) 230px;min-height:0;margin:8px 0;gap:20px}.chart-screen .chart{min-height:0}.chart-screen .sector-details .number,.chart-screen .sector-details .small{display:none}.chart-screen .sector-details .stamp{font-size:9px}.chart-screen .sector-details h3{font-size:22px;margin:5px 0}.chart-screen .sector-details .desc{min-height:0;font-size:12px;line-height:1.5;margin:6px 0 12px}.chart-screen .sector-details .btn{min-width:180px;min-height:40px;padding:10px 16px;font-size:12px}.chart-screen .resource-strip{gap:20px;padding-top:8px}.chart-screen .resource-strip strong{font-size:17px}.chart-screen .resource-strip span{font-size:8px}.chart-screen .bottomline .hint{font-size:8px}.chart-screen .sector .orb{width:25px;height:25px;margin-bottom:10px}.chart-screen .sector .name{font-size:8px}.chart-screen .sector{padding:5px}}\nCSS\nnode build.mjs\n/home/micha/.local/share/pipx/venvs/playwright/bin/python test-game.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
