{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,190p' network.js && sed -n '1,50p' hub-session.js\"","aggregated_output":"/* Solar Flair: authoritative shared-world co-op. AI Hub Session Protocol v1. */\nclass SolarNetwork {\n  constructor(callbacks = {}) {\n    this.cb = callbacks;\n    this.role = 'solo';\n    this.transport = 'none';\n    this.connected = false;\n    this.hub = Boolean(globalThis.AIHub?.active);\n    this.info = null;\n    this.started = false;\n    this.ended = false;\n    this.finished = false;\n    this.readyRequested = false;\n    this.tick = 0;\n    this.seq = 0;\n    this.lastSeq = -1;\n    this.sent = 0;\n    this.received = 0;\n    this.peerInput = { x: 0, y: 0, fire: false, boost: false, pulse: false };\n    this.peerIds = new Set();\n    this.latestSnapshot = null;\n    this.pc = null;\n    this.channel = null;\n    this.listeners = [];\n  }\n  async init() {\n    if (!this.hub) return null;\n    const h = globalThis.AIHub;\n    this.transport = 'hub';\n    this.cb.onStatus?.('AI Hub · linking flight computers');\n    this.listeners.push(h.on('start', () => { this.startPending = true; }));\n    this.listeners.push(h.on('message', (data, from) => this.receive(data, from)));\n    this.listeners.push(h.on('leave', ({ id, reason }) => {\n      this.peerIds.delete(id);\n      this.cb.onInput?.({ x: 0, y: 0, fire: false, boost: false, pulse: false }, id);\n      this.cb.onPeer?.(this.peerIds.size > 0);\n      this.cb.onStatus?.(`Wingmate left: ${reason}`);\n    }));\n    this.listeners.push(h.on('time-up', () => {\n      this.cb.onTimeUp?.();\n      if (this.role === 'host' && !this.finished) this.finish(false, this.latestSnapshot?.score || this.latestSnapshot?.s?.score || 0);\n    }));\n    this.listeners.push(h.on('end', ({ reason }) => {\n      this.ended = true;\n      this.started = false;\n      this.cb.onEnd?.(reason);\n      this.cb.onStatus?.('AI Hub · round ended');\n    }));\n    this.info = await h.connect({ mode: 'shared-world', seats: [1, 2] });\n    if (!this.info) {\n      this.hub = false;\n      this.transport = 'none';\n      for (const off of this.listeners) off();\n      this.listeners = [];\n      return null;\n    }\n    this.role = this.info.isHost ? 'host' : 'guest';\n    this.connected = true;\n    for (const p of this.info.players) if (p.id !== this.info.me) this.peerIds.add(p.id);\n    this.cb.onRole?.(this.role, this.info);\n    this.cb.onPeer?.(this.info.players.length > 1 || this.info.server);\n    this.cb.onStatus?.(this.info.server ? 'AI Hub · flight server' : `AI Hub · ${this.role === 'host' ? 'flight lead' : 'wingmate'}`);\n    if (this.readyRequested) h.ready();\n    return this.info;\n  }\n  ready() {\n    if (this.readyRequested) return;\n    this.readyRequested = true;\n    if (this.hub && this.info) globalThis.AIHub.ready();\n  }\n  update(dt, snapshot, input) {\n    if (this.ended) return;\n    if (this.hub && this.startPending && !this.started && globalThis.AIHub.time() >= 0) {\n      this.started = true;\n      this.cb.onStart?.();\n    }\n    if (snapshot) this.latestSnapshot = snapshot;\n    if (!this.connected || !this.started) return;\n    this.tick += dt;\n    if (this.tick < 1 / 12) return;\n    this.tick %= 1 / 12;\n    if (this.role === 'host' && snapshot) this.send({ kind: 'state', seq: this.seq++, state: snapshot });\n    else if (this.role === 'guest') this.send({ kind: 'input', input: this.sanitizeInput(input) });\n  }\n  sanitizeInput(input = {}) {\n    return {\n      x: Math.max(-1, Math.min(1, Number(input.x) || 0)),\n      y: Math.max(-1, Math.min(1, Number(input.y) || 0)),\n      fire: Boolean(input.fire), boost: Boolean(input.boost), pulse: Boolean(input.pulse),\n      aimX: Math.max(-1, Math.min(1, Number(input.aimX) || 0)),\n      aimY: Math.max(-1, Math.min(1, Number(input.aimY) || 0)),\n    };\n  }\n  send(payload) {\n    if (this.ended || !this.connected) return false;\n    const data = { solarFlair: 1, ...payload };\n    if (this.transport === 'hub') {\n      const options = this.role === 'guest' ? { to: this.info.host, reliable: false } : { reliable: false };\n      const ok = globalThis.AIHub.send(data, options);\n      if (ok !== false) this.sent++;\n      return ok;\n    }\n    if (this.channel?.readyState === 'open') {\n      if (this.channel.bufferedAmount > 262144) return false;\n      this.channel.send(JSON.stringify(data));\n      this.sent++;\n      return true;\n    }\n    return false;\n  }\n  receive(data, from = 'wingmate') {\n    if (!data || data.solarFlair !== 1 || this.ended) return;\n    this.received++;\n    if (data.kind === 'input' && this.role === 'host') {\n      this.peerInput = this.sanitizeInput(data.input);\n      this.cb.onInput?.(this.peerInput, from);\n    } else if (data.kind === 'state' && this.role === 'guest') {\n      if (this.transport === 'hub' && from !== this.info.host) return;\n      if (Number(data.seq) <= this.lastSeq) return;\n      this.lastSeq = Number(data.seq);\n      this.cb.onState?.(data.state);\n    } else if (data.kind === 'start' && this.role === 'guest') {\n      this.started = true;\n      this.cb.onStart?.();\n    } else if (data.kind === 'finish') {\n      this.cb.onFinish?.(Boolean(data.won), Number(data.score) || 0);\n    }\n  }\n  finish(won, score = 0) {\n    if (this.finished || this.role !== 'host' || this.ended) return;\n    this.finished = true;\n    if (this.hub) {\n      const ids = this.info.players.filter(p => p.id === this.info.me || this.peerIds.has(p.id)).map(p => p.id);\n      const scores = Object.fromEntries(ids.map(id => [id, Number(score) || 0]));\n      globalThis.AIHub.finish({ standings: [ids], scores, won: Boolean(won) });\n    } else this.send({ kind: 'finish', won: Boolean(won), score: Number(score) || 0 });\n  }\n  async createPeer(role) {\n    if (this.hub) throw new Error('AI Hub manages the squadron connection.');\n    this.closePeer();\n    if (!globalThis.RTCPeerConnection) throw new Error('This browser does not support direct co-op connections.');\n    this.role = role;\n    this.transport = 'webrtc';\n    this.ended = false;\n    this.finished = false;\n    this.started = false;\n    this.seq = 0;\n    this.lastSeq = -1;\n    this.tick = 0;\n    this.pc = new RTCPeerConnection({ iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] });\n    this.pc.ondatachannel = event => this.attachChannel(event.channel);\n    this.pc.onconnectionstatechange = () => {\n      const state = this.pc?.connectionState;\n      if (state === 'failed' || state === 'disconnected' || state === 'closed') {\n        this.connected = false;\n        this.peerInput = this.sanitizeInput();\n        this.cb.onInput?.(this.peerInput, 'wingmate');\n        this.cb.onPeer?.(false);\n        this.cb.onStatus?.(state === 'disconnected' ? 'Wingmate signal lost · reconnecting' : 'Wingmate disconnected');\n      }\n    };\n    this.cb.onRole?.(role, { server: false });\n  }\n  attachChannel(channel) {\n    this.channel = channel;\n    channel.onmessage = event => {\n      try { this.receive(JSON.parse(event.data)); } catch (_) { /* Ignore malformed remote packets. */ }\n    };\n    channel.onopen = () => {\n      this.connected = true;\n      this.cb.onPeer?.(true);\n      this.cb.onStatus?.('Squadron linked · two pilots, one mission');\n      if (this.role === 'host') {\n        this.started = true;\n        this.send({ kind: 'start' });\n        this.cb.onStart?.();\n      }\n    };\n    channel.onclose = () => {\n      this.connected = false;\n      this.cb.onPeer?.(false);\n    };\n  }\n  waitForIce() {\n    const pc = this.pc;\n    if (pc.iceGatheringState === 'complete') return Promise.resolve();\n    return new Promise(resolve => {\n      const timer = setTimeout(done, 7000);\n      function check() { if (pc.iceGatheringState === 'complete') done(); }\n      function done() { clearTimeout(timer); pc.removeEventListener('icegatheringstatechange', check); resolve(); }\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n    var api = {\n      getItem: function (k) {\n        k = String(k);\n        return k in data ? data[k] : null;\n      },\n      setItem: function (k, v) {\n","exit_code":0,"status":"completed"}}
