p(12px,.95vw,18px)}.ship-status .row{font-size:clamp(11px,.8vw,15px)}@media(max-width:800px){.btn{font-size:11px}.sector .name{font-size:9px}.objective{font-size:14px}.hud-prompts{font-size:10px}.ship-status .row{font-size:10px}}\\\\n\\\";p.write_text(s)\np=Path('inspect-game.py');s=p.read_text().replace(\\\".as_uri())\\\",\\\".as_uri()+'?webgl=1')\\\").replace(\\\"page.get_by_role('button',name='Warp · 10 fuel').click()\\\",\\\"page.locator('[data-action=select][data-value=shard]').click()\\\\n  page.locator('[data-action=jump]').click()\\\")\np.write_text(s)\nPY\nnode build.mjs\n/home/micha/.local/share/pipx/venvs/playwright/bin/python inspect-game.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' test-hub.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' test-hub.py\"","aggregated_output":"\"\"\"Protocol conformance against the official AI Hub harness, served on an OS-picked port.\"\"\"\nfrom pathlib import Path\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom threading import Thread\nfrom urllib.parse import urlencode\nfrom playwright.sync_api import sync_playwright\nimport argparse\nimport os\n\nfolder = Path(__file__).resolve().parent\nworkspace = folder.parent\nparser = argparse.ArgumentParser()\nparser.add_argument('--game', default=folder.name + '.html')\nparser.add_argument('--players', type=int, default=2)\nargs = parser.parse_args()\n(folder / '.browser-tmp').mkdir(exist_ok=True)\nos.environ['TMPDIR'] = str(folder / '.browser-tmp')\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def __init__(self, *a, **kw): super().__init__(*a, directory=str(workspace), **kw)\n    def log_message(self, *a): pass\nserver = ThreadingHTTPServer(('127.0.0.1', 0), QuietHandler)\nThread(target=server.serve_forever, daemon=True).start()\nbase = f'http://127.0.0.1:{server.server_address[1]}'\nfailures = []\nchecks = 0\ntry:\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader'])\n        for scenario, players, latency, jitter, loss in [('standard', 2, 0, 0, 0), ('standard', args.players, 150, 50, 5), ('host-leave', args.players, 150, 50, 5), ('server', 2, 0, 0, 0)]:\n            context = browser.new_context(viewport={'width': 1280, 'height': 900})\n            page = context.new_page()\n            params = urlencode({'game': '/' + args.game.lstrip('/'), 'players': players, 'latency': latency, 'jitter': jitter, 'loss': loss, 'auto': 1, 'scenario': scenario, 'play': 6000, 'limit': 45})\n            page.goto(f'{base}/{folder.name}/harness.html?{params}')\n            page.wait_for_function('document.body.dataset.complete === \"true\"', timeout=110000)\n            report = page.evaluate('window.__hubCheck')\n            for result in report.get('checks', []):\n                checks += 1\n                if not result.get('pass'): failures.append(f'{scenario}/{players}: {result[\"name\"]}: {result.get(\"detail\", \"\")}')\n            if not report.get('pass') and not report.get('checks'): failures.append(f'{scenario}/{players}: no harness checks returned')\n            context.close()\n        browser.close()\nexcept Exception as exc:\n    failures.append(str(exc))\nfinally:\n    server.shutdown()\nfor failure in failures: print('FAIL:', failure)\nprint(f'{checks} AI Hub checks; {len(failures)} failures')\nraise SystemExit(bool(failures))\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.js');s=p.read_text().replace(\\\"if(info.server)this.autoPilot=true\\\",\\\"if(info?.server)this.autoPilot=true\\\").replace(\\\"if(pressed(9))this.app.back();\\\",\\\"if(pressed(9)&&\"'!b[8])this.app.back();\").replace(\"this.activity('\"'keyboard');this.mouse.x=\\\",\\\"this.lastPointerMove=performance.now();this.activity('keyboard');this.mouse.x=\\\")\ns=s.replace(\\\"if(btn&&\"'!btn.disabled){this.focus(btn,false);if(btn.dataset.action==='\"'select')this.select(btn.dataset.value,false)}\\\",\\\"if(btn&&\"'!btn.disabled&&performance.now()-(this.input.lastPointerMove||0)<150){this.focus(btn,false);if(btn.dataset.action==='\"'select')this.select(btn.dataset.value,false)}\\\")\ns=s.replace(\\\"\"'$('\"'#reticle').classList.toggle('hidden',page\"'!=='\"'flight');this.focused=null;\\\",\\\"\"'$('\"'#reticle').classList.toggle('hidden',page\"'!=='\"'flight');if(page\"'!=='\"'flight')\"'$('\"'#warp-ui').classList.add('hidden');this.focused=null;\\\")\ns=s.replace(\\\"const sector=s.sectors.find(e=>e.id===(s.pendingSector||s.sector));\"'$('\"'#hud-sector')\\\",\\\"const sector=s.sectors.find(e=>e.id===(s.pendingSector||s.sector));document.querySelector('.sector-heading .eyebrow').textContent=this.net.role==='guest'?'F-86 Sunskipper / wingmate':'F-86 Sunskipper / flight lead';\"'$('\"'#hud-sector')\\\")\np.write_text(s)\np=Path('scene.js');s=p.read_text().replace(\\\"{canvas:this.canvas,antialias:true,alpha:false}\\\",\\\"{canvas:this.canvas,antialias:true,alpha:false,forceWebGL:new URLSearchParams(location.search).has('webgl')}\\\");p.write_text(s)\np=Path('style.css');s=p.read_text()+\\\"\\\\n.row:has(input.focused){border-color:var(--amber);color:var(--amber)}.btn{font-size:clamp(14px,1.05vw,18px)}.sector .name{font-size:clamp(11px,.85vw,16px)}.objective{font-size:clamp(16px,1.15vw,22px)}.hud-prompts{font-size:clamp(12px,.95vw,18px)}.ship-status .row{font-size:clamp(11px,.8vw,15px)}@media(max-width:800px){.btn{font-size:11px}.sector .name{font-size:9px}.objective{font-size:14px}.hud-prompts{font-size:10px}.ship-status .row{font-size:10px}}\\\\n\\\";p.write_text(s)\np=Path('inspect-game.py');s=p.read_text().replace(\\\".as_uri())\\\",\\\".as_uri()+'?webgl=1')\\\").replace(\\\"page.get_by_role('button',name='Warp · 10 fuel').click()\\\",\\\"page.locator('[data-action=select][data-value=shard]').click()\\\\n  page.locator('[data-action=jump]').click()\\\")\np.write_text(s)\nPY\nnode build.mjs\n/home/micha/.local/share/pipx/venvs/playwright/bin/python inspect-game.py\"","aggregated_output":"Built Solar-Flair-Solaris-gpt-6.1-sol-ultra-20261105-222451.html (151 KB)\n{\"status\": {\"ready\": true, \"error\": null, \"engine\": \"WebGL2 compatibility\", \"page\": \"title\"}, \"errors\": []}\n{\"page\": \"map\", \"state\": \"map\", \"buttons\": 12}\n{\"snapshot\": {\"state\": \"warp\", \"entities\": 0, \"player\": {\"x\": 0, \"y\": 0, \"z\": 0, \"hp\": 100, \"shield\": 100, \"fuel\": 90, \"pulses\": 3, \"pulse\": 3, \"score\": 0, \"heat\": 0, \"overheated\": false, \"invincible\": 0, \"boost\": false, \"vx\": 0, \"vy\": 0}}, \"errors\": []}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '205,285p' audio.js && sed -n '1,55p' test-core.mjs && sed -n '1,80p' test-network.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '205,285p' audio.js && sed -n '1,55p' test-core.mjs && sed -n '1,80p' test-network.py\"","aggregated_output":"\n  inspect() {\n    let rms = 0, peak = 0;\n    if (this.analyser) {\n      const samples = new Float32Array(this.analyser.fftSize);\n      this.analyser.getFloatTimeDomainData(samples);\n      for (const n of samples) { rms += n * n; peak = Math.max(peak, Math.abs(n)); }\n      rms = Math.sqrt(rms / samples.length);\n    }\n    return { unlocked: !!this.ctx, state: this.ctx?.state || 'locked', musicVolume: this.musicVolume, sfxVolume: this.sfxVolume, noteCount: this.noteCount, effectCount: this.effectCount, voiceCount: this.voiceCount, rms, peak };\n  }\n\n  async selfTest() {\n    const Offline = globalThis.OfflineAudioContext || globalThis.webkitOfflineAudioContext;\n    if (!Offline) return { supported: false, audible: false, reason: 'OfflineAudioContext unavailable' };\n    const names = ['laser', 'hit', 'explode', 'warp', 'rescue', 'shield', 'ui', 'win', 'lose', 'boost'];\n    const c = new Offline(1, 44100 * 18, 44100);\n    const gain = c.createGain(); gain.gain.value = 0.5; gain.connect(c.destination);\n    names.forEach((name, i) => this._fx(name, c, gain, 0.1 + i * 1.5));\n    this._phrase(c, gain, 15.4, 'rescue');\n    const rendered = await c.startRendering();\n    const samples = rendered.getChannelData(0);\n    const segments = {};\n    let total = 0, peak = 0, nonFinite = 0;\n    for (let i = 0; i < samples.length; i++) {\n      const v = samples[i]; if (!Number.isFinite(v)) nonFinite++;\n      total += v * v; peak = Math.max(peak, Math.abs(v));\n    }\n    for (let i = 0; i <= names.length; i++) {\n      const start = Math.floor((i < names.length ? 0.1 + i * 1.5 : 15.4) * 44100);\n      let energy = 0;\n      for (let j = start; j < start + 44100; j++) energy += samples[j] * samples[j];\n      segments[i < names.length ? names[i] : 'voice'] = Math.sqrt(energy / 44100);\n    }\n    return { supported: true, audible: Object.values(segments).every(n => n > 0.0001), rms: Math.sqrt(total / samples.length), peak, nonFinite, clipped: peak >= 1, segments };\n  }\n}\nimport assert from 'node:assert/strict';\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport RAPIER from '@dimforge/rapier3d-compat';\n\nconst oldWarn = console.warn;\nconsole.warn = (...args) => { if (!String(args[0]).includes('deprecated parameters')) oldWarn(...args); };\nawait RAPIER.init();\nconsole.warn = oldWarn;\nvm.runInThisContext(fs.readFileSync(new URL('./core.js', import.meta.url), 'utf8') + '\\nglobalThis.SolarSim = SolarSim;');\nlet passed = 0, failed = 0;\nconst live = new Set();\nfunction make(events = []) { const sim = new SolarSim(RAPIER, e => events.push(e)); live.add(sim); return sim; }\nfunction tick(sim, seconds, input = {}) { for (let n = 0; n < Math.ceil(seconds * 60); n++) sim.update(1 / 60, typeof input === 'function' ? input() : input); }\nfunction enter(sim, sector) { assert(sim.selectSector(sector, true)); tick(sim, 2.5); assert.equal(sim.state, 'flight'); }\nfunction isolate(sim, sector = 'echo') { enter(sim, sector); sim._clearSpace(); sim.spawnTimer = 999; sim.rockTimer = 999; sim.podTimer = 999; }\nfunction enemyShot(sim, x, y, z, vx = 0, vy = 0, vz = 30) {\n  const id = sim.nextId++, shot = { id, owner: 'enemy', x, y, z, vx, vy, vz, age: 0, damage: 15 };\n  shot.body = sim._body(id, x, y, z, .65, 'bullet', true); shot.body.setLinvel({ x: vx, y: vy, z: vz }, true); sim.bullets.set(id, shot); return shot;\n}\nfunction test(name, fn) {\n  try { fn(); passed++; } catch (error) { failed++; console.error(`FAIL ${name}: ${error.message}`); }\n  finally { for (const sim of live) sim.dispose(); live.clear(); }\n}\n\ntest('new campaign has seven sectors and complete initial resources', () => {\n  const s = make(); assert.equal(s.state, 'map'); assert.equal(s.sectors.length, 7);\n  assert.deepEqual([s.player.hp, s.player.shield, s.player.fuel, s.player.pulses], [100, 100, 100, 3]);\n});\ntest('Solaris requires survivors and both route signals', () => {\n  const s = make(); assert.equal(s.selectSector('solaris'), false);\n  s.rescued = 5; s.completed.add('echo'); assert.equal(s.bossUnlocked(), false);\n  s.completed.add('rift'); assert.equal(s.bossUnlocked(), true); assert(s.selectSector('solaris'));\n});\ntest('invalid chart selection does not spend fuel or leave the chart', () => {\n  const s = make(); assert.equal(s.selectSector('missing'), false); assert.equal(s.state, 'map'); assert.equal(s.player.fuel, 100);\n});\ntest('warp consumes one jump cost and resolves to the selected sector', () => {\n  const s = make(); assert(s.selectSector('shard')); assert.equal(s.player.fuel, 90); tick(s, 1); assert.equal(s.state, 'warp');\n  tick(s, 1.5); assert.equal(s.state, 'flight'); assert.equal(s.sector, 'shard'); assert(s.player.fuel <= 90 && s.player.fuel > 89);\n});\ntest('flight movement respects the navigable corridor', () => {\n  const s = make(); enter(s, 'shard'); tick(s, 3, { x: 1, y: 1 }); assert.equal(s.player.x, 17); assert.equal(s.player.y, 9);\n  tick(s, 5, { x: -1, y: -1 }); assert.equal(s.player.x, -17); assert.equal(s.player.y, -9);\n});\ntest('ship response tuning changes live movement speed', () => {\n  const a = make(), b = make(); isolate(a); isolate(b); b.tuning.shipSpeed = 2;\n  tick(a, .25, { x: 1 }); tick(b, .25, { x: 1 }); assert(b.player.x > a.player.x * 1.9);\n});\ntest('boost uses shared fuel and increases ship speed', () => {\n  const a = make(), b = make(); isolate(a); isolate(b); tick(a, .3, { x: 1 }); tick(b, .3, { x: 1, boost: true });\n  assert(b.player.x > a.player.x * 1.5); assert(b.player.fuel < a.player.fuel); assert(b.player.boost);\n});\ntest('player cannon damage comes from actual Rapier contacts', () => {\n  const s = make(); isolate(s); const e = s._spawn('enemy', { x: 0, y: 0, z: -40, hp: 300, maxHp: 300, speed: 0, fireTimer: 999 });\nfrom pathlib import Path\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nfrom threading import Thread\nfrom playwright.sync_api import sync_playwright\nimport json\nimport os\nimport argparse\n\nparser = argparse.ArgumentParser()\nparser.add_argument('--game')\nargs = parser.parse_args()\nroot = Path(__file__).resolve().parent\nserved = root.parent if args.game else root\n(root / '.browser-tmp').mkdir(exist_ok=True)\nos.environ['TMPDIR'] = str(root / '.browser-tmp')\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, directory=str(served), **kwargs)\n    def log_message(self, *args): pass\n\nfailures = []\nchecks = 0\ndef check(condition, message):\n    global checks\n    checks += 1\n    if not condition: failures.append(message)\n\nserver = ThreadingHTTPServer(('127.0.0.1', 0), QuietHandler)\nThread(target=server.serve_forever, daemon=True).start()\nurl = f'http://127.0.0.1:{server.server_address[1]}/' + (args.game.lstrip('/') if args.game else 'network-test.html')\ntry:\n    with sync_playwright() as p:\n        browser = p.chromium.launch(headless=True, args=['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-webgpu-adapter=swiftshader'] if args.game else [])\n        a = browser.new_page()\n        b = browser.new_page()\n        for page in [a, b]:\n            page.goto(url)\n            if args.game:\n                page.wait_for_function('window.__solar?.ready || window.__solarError', timeout=60000)\n                if page.evaluate('!!window.__solarError'): raise RuntimeError(page.evaluate('window.__solarError'))\n                page.evaluate('''()=>{window.events={starts:0,states:[],inputs:[],finishes:[],peers:[]};window.net=__solar.network;const hooks={onStart:()=>events.starts++,onState:s=>events.states.push(s),onInput:i=>events.inputs.push(i),onFinish:(w,s)=>events.finishes.push({won:w,score:s}),onPeer:c=>events.peers.push(c)};for(const[name,hook]of Object.entries(hooks)){const old=net.cb[name];net.cb[name]=(...args)=>{hook(...args);return old?.(...args);};}solarApp.show('coop');}''')\n            else:\n                page.evaluate('''() => {window.events={starts:0,states:[],inputs:[],finishes:[],peers:[]};window.net=new SolarNetwork({onStart:()=>events.starts++,onState:s=>events.states.push(s),onInput:i=>events.inputs.push(i),onFinish:(w,s)=>events.finishes.push({won:w,score:s}),onPeer:c=>events.peers.push(c)});window.timer=setInterval(()=>net.update(.09,{score:99,scene:'frontier'},{x:1,y:-.5,fire:true,pulse:false,boost:false}),90);}''')\n        check(a.evaluate('net.inspect().role') == 'solo', 'Network should begin as solo.')\n        check(a.evaluate('net.sanitizeInput({x:8,y:-8,fire:1}).x===1 && net.sanitizeInput({x:8,y:-8}).y===-1'), 'Input must clamp remote axes.')\n        bad=b.evaluate('''async()=>{try{await net.join('bad');return false;}catch(e){return /complete Solar Flair offer/.test(e.message);}}''')\n        check(bad, 'Malformed invitation must return a useful error.')\n        check(a.evaluate('net.sanitizeInput({aimX:48,aimY:-22}).aimX===48 && net.sanitizeInput({aimX:48,aimY:-22}).aimY===-22'), 'World-space aim must preserve its full range.')\n        check(a.evaluate('net.sanitizeInput({aimX:500,aimY:-500}).aimX===55 && net.sanitizeInput({aimX:500,aimY:-500}).aimY===-35'), 'World-space aim must clamp to flight bounds.')\n        packed=a.evaluate('''()=>{const original={score:25,entities:Array.from({length:20},(_,id)=>({id,type:'enemy',kind:'fighter',x:1.23456789,y:-.998877,z:-66.998878,hp:22,maxHp:40,age:12.445567,phase:0,scale:1})),bullets:Array.from({length:100},(_,id)=>({id,owner:'enemy',x:1.1244467,y:-.2457766,z:-78.337299,vx:1.772923,vy:-4.568922,vz:50.9838263}))};const encoded=net.packState(original);const size=JSON.stringify({solarFlair:1,kind:'state',seq:1,packed:1,state:encoded}).length;const decoded=net.unpackState(encoded);return {size,originalSize:JSON.stringify(original).length,entities:decoded.entities.length,bullets:decoded.bullets.length,first:decoded.entities[0]};}''')\n        check(packed['size']<16000 and packed['size']<packed['originalSize']*.6, 'Dense snapshots must fit Hub packet cap after packing.')\n        check(packed['entities']==20 and packed['bullets']==100 and abs(packed['first']['x']-1.23456789)<.001, 'Packed snapshots must restore complete entity tables and positions.')\n        offer = a.evaluate('net.host()')\n        answer = b.evaluate('(offer)=>net.join(offer)', offer)\n        a.evaluate('(answer)=>net.accept(answer)', answer)\n        a.wait_for_function('net.inspect().connected && events.starts===1', timeout=15000)\n        b.wait_for_function('net.inspect().connected && events.starts===1 && events.states.length>0', timeout=15000)\n        a.wait_for_function('events.inputs.length>0', timeout=15000)\n        check(a.evaluate('net.inspect().role') == 'host', 'Invite creator must be host.')\n        check(b.evaluate('net.inspect().role') == 'guest', 'Invite joiner must be guest.')\n        if args.game:\n            check(b.evaluate('!!solarApp.remote && Array.isArray(solarApp.remote.entities)'), 'Authoritative game state must reach the guest renderer.')\n            a.evaluate(\"solarApp.sim.dev.warp('echo')\")\n            b.wait_for_function(\"solarApp.remote?.sector==='echo' && solarApp.remote?.state==='flight'\", timeout=60000)\n            check(b.evaluate(\"solarApp.page==='flight' && solarApp.remote.sector==='echo'\"), 'Host warp must change guest gameplay and camera state.')\n            b.keyboard.down('d')\n            b.keyboard.down('Space')\n            a.wait_for_function('events.inputs.some(i=>i.fire && i.x===1)', timeout=15000)\n            check(a.evaluate('events.inputs.some(i=>i.fire && i.x===1)'), 'Real guest keyboard flight input must reach lead simulation.')\n            a.wait_for_function(\"[...solarApp.sim.bullets.values()].some(b=>b.owner==='wing')\", timeout=15000)\n            check(a.evaluate(\"[...solarApp.sim.bullets.values()].some(b=>b.owner==='wing')\"), 'Guest trigger must spawn authoritative wingmate projectiles.')\n            b.keyboard.up('d')\n            b.keyboard.up('Space')\n        else:\n            check(b.evaluate(\"events.states.at(-1).scene==='frontier'\"), 'Authoritative state must reach guest.')\n            check(a.evaluate('events.inputs.at(-1).fire && events.inputs.at(-1).x===1'), 'Guest input must reach flight lead.')\n        a.evaluate('net.finish(true,1200)')\n        b.wait_for_function('events.finishes.length===1')\n        check(b.evaluate('events.finishes[0].won && events.finishes[0].score===1200'), 'Mission outcome must reach guest.')\n        b.evaluate('net.leave()')\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"agent_message","text":"The assembled HTML passes the AI Hub harness, including delayed/lossy networking and host departure. Two full game pages also connected through the standalone WebRTC flow, with the wingmate’s controls producing shots in the host’s simulation.\n\nThe first end-to-end pass exposed a few focus and co-op edge cases; I’ve fixed those and am checking controller, touch, recovery, and the complete campaign.\n"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.js');s=p.read_text().replace(\\\"start(){this.attract=false;this.paused=false;this.autoPilot=false;\\\",\\\"start(){this.attract=false;this.training=false;this.paused=false;this.autoPilot=false;\\\")\ns=s.replace(\\\"Sector 07 / \"'${this.scene.engine}\",\"Last beacon / online\")\ns=s.replace(\"if(this.remoteEntityIds)for(const id of this.remoteEntityIds)\",\"const newWingShots=s.bullets.filter(b=>b.owner==='\"'wing'&&\"'!this.remoteBulletIds?.has(b.id));if(newWingShots.length)this.audio.sfx('\"'laser');this.remoteBulletIds=new Set(s.bullets.map(b=>b.id));if(this.remoteEntityIds)for(const id of this.remoteEntityIds)\\\")\ns=s.replace(\\\"if(e&&['enemy','asteroid'].includes(e.type))this.scene.burst(e.x,e.y,e.z,'#ffb85f',15)\\\",\\\"if(e&&['enemy','asteroid'].includes(e.type)){this.scene.burst(e.x,e.y,e.z,'#ffb85f',15);this.audio.sfx('explode')}\\\")\ns=s.replace(\\\"if(this.app.page\"'!=='\"'flight'){if(pressed(0))\\\", \\\"if(this.app.page\"'!=='\"'flight'){if(Math.abs(ry)>.2){const scroll=document.querySelector('.credits-scroll')||document.querySelector('.panel');if(scroll)scroll.scrollTop+=ry*dt*600}if(pressed(0))\\\")\ns=s.replace(\\\"else if(e.code==='KeyM'&&this.app.page==='flight')\\\", \\\"else if(e.code==='PageDown'||e.code==='PageUp'){const scroll=document.querySelector('.credits-scroll')||document.querySelector('.panel');if(scroll)scroll.scrollTop+=(e.code==='PageDown'?1:-1)*scroll.clientHeight*.8}else if(e.code==='KeyM'&&this.app.page==='flight')\\\")\ns=s.replace(\\\"shares pulse cells, rescues, and score.\\\",\\\"shares shields, pulse cells, rescues, and score.\\\")\ns=s.replace(\\\"this.page='';if(this.net.role==='guest')\\\", \\\"this.page='';if(this.net.role==='guest')\\\")\n# Explicit question labels in field notes.\ns=s.replace(\\\"c.testingFeedback.map((v,i)=>\"'`<p><b>${i+1}.</b> ${escapeHTML(v)}</p>`)\",\"c.testingFeedback.map((v,i)=>`<p><b>${['\"'Issues caught','Critical / game breaking','Most helpful test','Least helpful test'][i]}.</b> \"'${escapeHTML(v)}</p>`)\")\ns=s.replace(\"c.engineFeedback.map((v,i)=>`<p><b>${i+1}.</b> ${escapeHTML(v)}</p>`)\",\"c.engineFeedback.map((v,i)=>`<p><b>${['\"'Liked most','Got stuck or guessed wrong','Built myself','Hardest part','Engine changes','One desired change'][i]}.</b> \"'${escapeHTML(v)}</p>`)\")\ns=s.replace(\"c.promptFeedback.map((v,i)=>`<p><b>${i+1}.</b> ${escapeHTML(v)}</p>`)\",\"c.promptFeedback.map((v,i)=>`<p><b>${['\"'Liked most','Confusing','Hardest task','Suggested change'][i]}.</b> \"'${escapeHTML(v)}</p>`)\")\np.write_text(s)\nPY\ncat > test-game.py <<'\"'PY'\n\\\"\\\"\\\"Final single-file checks. Run through node verify.mjs.\\\"\\\"\\\"\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nimport json, os\nroot=Path(__file__).resolve().parent\nos.environ['TMPDIR']=str(root/'.browser-tmp')\n(root/'.browser-tmp').mkdir(exist_ok=True)\nurl=(root.parent/(root.name+'.html')).as_uri()\nchecks=0;failures=[];errors=[]\ndef check(value,name):\n global checks\n checks+=1\n if not value: failures.append(name)\ndef boot(browser,**kwargs):\n page=browser.new_page(**kwargs)\n page.on('pageerror',lambda e:errors.append(str(e)))\n page.add_init_script('''window.__pad=null;Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pad?[window.__pad]:[]});''')\n page.goto(url)\n page.wait_for_function('window.__solar?.ready || window.__solarError',timeout=60000)\n if page.evaluate('\"'!!window.__solarError'\"'):raise RuntimeError(page.evaluate('window.__solarError'))\n page.evaluate('solarApp.lastActivity=performance.now()')\n return page\ntry:\n with sync_playwright() as p:\n  browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--no-sandbox'])\n  page=boot(browser,viewport={'width':1920,'height':1080})\n  check(page.title()=='Solar Flair · Frontier Rescue','Correct single-file game loaded')\n  check(page.evaluate(\\\"__solar.scene.engine==='WebGPU'\\\"),'Native WebGPU backend initialized')\n  check(page.evaluate(\\\"__solar.scene.renderer.info.render.frameCalls>0 || __solar.scene.renderer.info.render.calls>0 || __solar.scene.renderer.info.render.frame>0\\\"),'Renderer has drawn scene frames')\n  check(page.evaluate(\\\"__solar.scene.mixers.length>=5\\\"),'Native AnimationMixer clips are running')\n  check(page.evaluate(\\\"solarApp.page==='title'\\\"),'Title begins before campaign')\n  check(page.evaluate('__solar.audio.inspect().musicVolume')==.1,'Music defaults to 10 percent')\n  page.keyboard.press('Enter')\n  page.wait_for_function(\\\"solarApp.page==='map'\\\")\n  check(page.locator('.sector').count()==7,'All seven chart sectors shown')\n  check(page.evaluate(\\\"__solar.sim.sectors.find(s=>s.id==='solaris').locked\\\"),'Final world locked until campaign objectives')\n  page.locator('.sector[data-value=shard]').hover()\n  check(page.evaluate(\\\"solarApp.selected==='shard'\\\"),'Mouse hover selects a sector')\n  page.locator('[data-action=jump]').click()\n  check(page.evaluate(\\\"__solar.sim.state==='warp'&&__solar.sim.player.fuel===90\\\"),'Warp spends jump fuel exactly once')\n  page.keyboard.press('Escape')\n  page.wait_for_function(\\\"solarApp.page==='pause'\\\")\n  before=page.evaluate('__solar.sim.warpTime')\n  page.wait_for_timeout(300)\n  check(page.evaluate('__solar.sim.warpTime')==before,'Solo pause freezes simulation')\n  page.locator('[data-action=settings]').click()\n  page.locator('[data-setting=music]').fill('.23')\n  check(abs(page.evaluate('__solar.audio.musicVolume')-.23)<.001,'Music slider applies live')\n  page.locator('[data-action=glyphs]').click()\n  check(page.evaluate(\\\"solarApp.settings.glyphs==='xbox'\\\"),'Xbox glyph option available')\n  page.locator('[data-action=defaults]').click()\n  check(page.evaluate(\\\"solarApp.settings.music===.1&&solarApp.settings.glyphs==='playstation'\\\"),'Settings reset restores defaults')\n  page.locator('[data-action=back]').click()\n  page.locator('[data-action=dev]').click()\n  page.locator('[data-tuning=damage]').fill('1.75')\n  check(page.evaluate('__solar.sim.tuning.damage')==1.75,'Developer tuning applies live')\n  page.locator('[data-action=dev-reset]').click()\n  check(page.evaluate('__solar.sim.tuning.damage')==1,'Developer defaults reset')\n  page.locator('[data-action=dev-refill]').click()\n  check(page.evaluate('__solar.sim.player.fuel')==100,'Developer refill works')\n  page.locator('[data-action=back]').click()\n  page.locator('[data-action=resume]').click()\n  page.evaluate(\\\"()=>{for(let i=0;i<60;i++)__solar.sim.update(.05,{});solarApp.syncPage();}\\\")\n  check(page.evaluate(\\\"__solar.sim.state==='flight'&&__solar.sim.sector==='shard'\\\"),'Warp resolves into correct flight sector')\n  old=page.evaluate('({x:__solar.sim.player.x,y:__solar.sim.player.y})')\n  page.keyboard.down('d');page.keyboard.down('w');page.keyboard.down('Space')\n  page.wait_for_function('__solar.sim.player.x>1 && __solar.sim.player.y>1 && __solar.sim.stats.shots>0',timeout=20000)\n  page.keyboard.up('d');page.keyboard.up('w');page.keyboard.up('Space')\n  check(page.evaluate('__solar.sim.player.x>0&&__solar.sim.player.y>0'),'Keyboard movement changes flight position')\n  check(page.evaluate('__solar.sim.stats.shots>0'),'Keyboard trigger fires real projectiles')\n  page.keyboard.press('q')\n  page.wait_for_function('__solar.sim.stats.pulsesUsed>0',timeout=15000)\n  check(page.evaluate('__solar.sim.player.pulses<3'),'Pulse consumes a cell')\n  page.evaluate(\\\"window.__pad={id:'Emulated standard DualSense',mapping:'standard',connected:true,axes:[.7,0,.2,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))}\\\")\n  page.wait_for_function(\\\"solarApp.input.last==='pad'\\\",timeout=10000)\n  check(page.evaluate(\\\"solarApp.input.glyph('pulse')==='□'\\\"),'Controller activates PlayStation prompts')\n  page.evaluate('__pad.axes=[0,0,0,0];__pad.buttons[8]={pressed:true,value:1};__pad.buttons[9]={pressed:true,value:1}')\n  page.wait_for_timeout(500)\n  check(page.evaluate(\\\"solarApp.page==='flight'\\\"),'Create plus Options is reserved for host UI')\n  page.evaluate('__pad.buttons[9]={pressed:false,value:0};__pad.buttons[8]={pressed:false,value:0}')\n  page.wait_for_timeout(250)\n  page.evaluate('__pad.buttons[9]={pressed:true,value:1}')\n  page.wait_for_function(\\\"solarApp.page==='pause'\\\",timeout=10000)\n  check(True,'Standard pad Options opens pause')\n  page.evaluate('__pad=null')\n  page.locator('[data-action=about]').click()\n  check(page.locator('.credits-scroll').inner_text().find('Source Information')>=0,'About includes Source Information')\n  for text in ['Testing Feedback','Engine Feedback','Prompt Feedback','added on import']:\n   check(text in page.locator('.credits-scroll').inner_text(),'About includes '+text)\n  page.keyboard.press('PageDown')\n  check(page.locator('.credits-scroll').evaluate('(el)=>el.scrollTop>0'),'Credits scroll from keyboard')\n  page.locator('[data-action=back]').click()\n  page.locator('[data-action=resume]').click()\n  # Complete a real route through the campaign using the same flight input API.\n  campaign=page.evaluate('''()=>{solarApp.paused=true;solarApp.audio.suspend();const sim=solarApp.sim;const emit=sim.emit;const events=[];sim.emit=e=>events.push(e);sim.start();for(const sector of ['anchor','shard','echo','haven','chorus','rift','solaris']){if(\"'!sim.selectSector(sector))break;for(let t=0;t<16000&&sim.state!=='\"'map'&&sim.state\"'!=='\"'victory'&&sim.state\"'!=='\"'defeat';t++)sim.update(.05,sim.botInput());if(sim.state==='defeat')break;}const out={state:sim.state,rescued:sim.rescued,visited:sim.stats.sectorsVisited,collisions:sim.stats.collisions,phases:events.filter(e=>e.type==='bossPhase').map(e=>e.phase),score:sim.player.score};sim.emit=emit;solarApp.paused=false;solarApp.show('end');return out;}''')\n  check(campaign['state']=='victory','Whole campaign reaches victory through gameplay')\n  check(campaign['rescued']==7,'Whole campaign rescues all seven survivors')\n  check(len(set(campaign['visited']))==7,'Whole campaign visits all seven sectors')\n  check(campaign['collisions']>50,'Campaign uses actual Rapier collision events')\n  check(campaign['phases']==[2,3],'Carrier runs all three combat phases')\n  check('The stars answer back.' in page.locator('#screens').inner_text(),'Victory ending presented')\n  page.locator('[data-action=start]').click()\n  check(not page.evaluate('__solar.sim.tuning.god'),'New mission restores fair flight tuning')\n  page.evaluate(\\\"()=>{__solar.sim.dev.warp('echo');for(let i=0;i<60;i++)__solar.sim.update(.05,{});__solar.sim.player.shield=0;__solar.sim.player.invincible=0;__solar.sim._hitPlayer(200);solarApp.page='flight';solarApp.syncPage()}\\\")\n  check(page.evaluate(\\\"solarApp.page==='end'&&__solar.sim.state==='defeat'\\\"),'Hull loss produces defeat and recovery menu')\n  page.locator('[data-action=tow]').click()\n  check(page.evaluate(\\\"__solar.sim.state==='map'&&__solar.sim.player.hp>=55&&__solar.sim.player.fuel>0\\\"),'Tow restores a playable campaign')\n  page.evaluate(\\\"solarApp.show('title');solarApp.lastActivity=performance.now()-11000\\\")\n  page.wait_for_function('solarApp.attract',timeout=10000)\n  check(page.evaluate(\\\"__solar.sim.tuning.god&&solarApp.autoPilot&&__solar.sim.state==='warp'\\\"),'Ten-second idle launches AI attract mode')\n  page.keyboard.press('x')\n  check(page.evaluate(\\\"\"'!solarApp.attract&&solarApp.page==='\"'title'\\\"),'Any input returns attract mode to title')\n  report=page.evaluate('__solar.audio.selfTest()')\n  for name,level in report.get('segments',{}).items():check(level>.0001,'Synthesized '+name+' is audible')\n  check(not report['clipped'] and report['nonFinite']==0,'Synthesized audio is finite and unclipped')\n  page.close()\n  # Touch landscape: invisible stick, auto-fire, accessible contextual action.\n  touch=boot(browser,viewport={'width':844,'height':390},device_scale_factor=1,is_mobile=True,has_touch=True)\n  check(touch.evaluate(\\\"document.body.classList.contains('touch')\\\"),'Touch presentation enabled')\n  touch.locator('[data-action=start]').tap()\n  touch.locator('.sector[data-value=shard]').tap()\n  touch.locator('[data-action=jump]').tap()\n  touch.evaluate(\\\"()=>{for(let i=0;i<60;i++)__solar.sim.update(.05,{});solarApp.syncPage()}\\\")\n  session=touch.context.new_cdp_session(touch)\n  session.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':150,'y':210,'id':1}]})\n  session.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':220,'y':175,'id':1}]})\n  touch.wait_for_function('__solar.sim.player.x>1 && __solar.sim.stats.shots>0',timeout=15000)\n  check(touch.evaluate('__solar.sim.player.x>1'),'Invisible touch stick moves ship')\n  check(touch.evaluate('__solar.sim.stats.shots>0'),'Touch flight assists firing')\n  session.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n  touch.locator('#touch-pulse').tap()\n  touch.wait_for_function('__solar.sim.stats.pulsesUsed>0',timeout=15000)\n  check(True,'Touch pulse action is functional')\n  touch.locator('#pause-button').tap()\n  check(touch.evaluate(\\\"solarApp.page==='pause'\\\"),'Touch menu opens pause')\n  check(touch.evaluate('document.documentElement.scrollWidth<=innerWidth'),'Touch viewport has no horizontal overflow')\n  touch.close();browser.close()\nexcept Exception as e:failures.append(str(e))\nfor e in errors:failures.append('Browser runtime error: '+e)\nfor e in failures:print('FAIL:',e)\nprint(f'{checks} game checks; {len(failures)} failures')\nraise SystemExit(bool(failures))\nPY\nnode --check main.js\nnode build.mjs\n/home/micha/.local/share/pipx/venvs/playwright/bin/python test-game.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
