s.toast('You are the wingmate. Flight lead chooses the route.')}else{this.selectBest();this.show('map')}},onStatus:text=>{this.networkStatus=text;const el=\"'$('\"'#network-status');if(el)el.textContent=text},onFinish:(won,score)=>{if(this.net.role==='guest'&&this.remote){this.remote.state=won?'victory':'defeat';this.remote.player.score=score;this.show('end')}},onTimeUp:()=>{this.net.finish(false,this.snapshot()?.player.score||0)},onEnd:reason=>{this.paused=true;this.audio.suspend();this.show('hubend',reason)}});this.bindUI()}\n async init(){await Promise.all([RAPIER.init(),this.scene.init()]);await this.net.init();this.net.ready();\"'$('\"'#load').classList.add('hidden');this.ready=true;if(this.net.hub){this.show('hubwait')}else this.show('title');this.lastActivity=performance.now();this.last=performance.now();this.loop=this.loop.bind(this);requestAnimationFrame(this.loop);window.__solar={ready:true,app:this,sim:this.sim,scene:this.scene,audio:this.audio,network:this.net,input:this.input,snapshot:()=>this.snapshot(),step:(dt,input)=>{this.sim.update(dt,input);return this.sim.snapshot()},command:(name,value)=>this.command(name,value),events:this.eventLog};}\n snapshot(){return this.net?.role==='guest'&&this.remote?this.remote:this.sim.snapshot()}\n save(){try{localStorage.setItem('solar-flair-settings',JSON.stringify(this.settings))}catch{}}\n onEvent(e){this.eventLog?.push({...e,t:this.sim?.time||0});if(this.eventLog?.length>400)this.eventLog.shift();if(\"'!this.scene||!this.audio)return;this.scene.event(e);if(e.type==='\"'fire'&&e.owner==='player')this.audio.sfx('laser');if(e.type==='hit'){this.audio.sfx('hit');if(e.owner==='player')this.scene.shield.material.opacity=.3}if(e.type==='explode')this.audio.sfx('explode');if(e.type==='rescue'){this.audio.sfx('rescue');this.toast(\"'`SURVIVOR ABOARD · ${e.rescued} SAFE`)}if(e.type==='\"'warp')this.audio.sfx('warp');if(e.type==='pulse')this.audio.sfx('shield');if(e.type==='shield')this.audio.sfx('shield');if(e.type==='co