{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nimport re\nfrom pathlib import Path\nplan = Path('PLAN.md').read_text()\nexpected = [\n    'What did you like most about this prompt?',\n    'What was confusing?',\n    'What was the hardest thing to do?',\n    'What would you change in this prompt?',\n]\nitems = json.loads(Path('planner-exit-interview.json').read_text())\nchecks = {\n    'plan exists and is nonempty': bool(plan.strip()),\n    'builder title left open': 'The title is yours.' in plan,\n    'builder output names omitted': not re.search(r'20261106-021146|xd6cada|gpt-6\\\\.1-sol-ultra-', plan),\n    'no absolute local development paths': not re.search(r'(?:/home/|file:///|/tmp/)', plan),\n    'four exact interview questions in order': isinstance(items, list) and [x.get('question') for x in items] == expected,\n    'interview shape and filled answers': all(set(x) == {'question', 'answer'} and isinstance(x['answer'], str) and x['answer'].strip() for x in items),\n    'hub round pacing addressed': '15-minute ceiling' in plan and 'info.limitMs' in plan,\n    'authority clock addressed': 'Own the authoritative clock explicitly.' in plan,\n}\nfailed = [name for name, okay in checks.items() if not okay]\nfor failure in failed:\n    print('FAIL:', failure)\nprint(f'{len(checks) - len(failed)}/{len(checks)} document checks passed.')\nraise SystemExit(bool(failed))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nimport re\nfrom pathlib import Path\nplan = Path('PLAN.md').read_text()\nexpected = [\n    'What did you like most about this prompt?',\n    'What was confusing?',\n    'What was the hardest thing to do?',\n    'What would you change in this prompt?',\n]\nitems = json.loads(Path('planner-exit-interview.json').read_text())\nchecks = {\n    'plan exists and is nonempty': bool(plan.strip()),\n    'builder title left open': 'The title is yours.' in plan,\n    'builder output names omitted': not re.search(r'20261106-021146|xd6cada|gpt-6\\\\.1-sol-ultra-', plan),\n    'no absolute local development paths': not re.search(r'(?:/home/|file:///|/tmp/)', plan),\n    'four exact interview questions in order': isinstance(items, list) and [x.get('question') for x in items] == expected,\n    'interview shape and filled answers': all(set(x) == {'question', 'answer'} and isinstance(x['answer'], str) and x['answer'].strip() for x in items),\n    'hub round pacing addressed': '15-minute ceiling' in plan and 'info.limitMs' in plan,\n    'authority clock addressed': 'Own the authoritative clock explicitly.' in plan,\n}\nfailed = [name for name, okay in checks.items() if not okay]\nfor failure in failed:\n    print('FAIL:', failure)\nprint(f'{len(checks) - len(failed)}/{len(checks)} document checks passed.')\nraise SystemExit(bool(failed))\nPY\"","aggregated_output":"8/8 document checks passed.\n","exit_code":0,"status":"completed"}}
