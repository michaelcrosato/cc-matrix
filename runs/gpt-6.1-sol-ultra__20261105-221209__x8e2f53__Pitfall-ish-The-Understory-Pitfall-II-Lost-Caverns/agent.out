{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game.js');s=p.read_text().replace(\\\"let renderer,world,controller\\\", \\\"let recoveringRenderer=false;\\\\nlet renderer,world,controller\\\")\ns=s.replace(\\\"if(\"'!status.server)renderer.render(scene,camera);\", \"if(!status.server&&!recoveringRenderer)renderer.render(scene,camera);\")\ns=s.replace(\"renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});\", \"renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.onDeviceLost=info=>{renderer._isDeviceLost=true;recoverGraphics(info);};\")\ns=s.replace(\"async function init(){\", \"\"\"async function recoverGraphics(info){if(recoveringRenderer||renderer.backend.isWebGLBackend)return;recoveringRenderer=true;const old=renderer;try{const next=new THREE.WebGPURenderer({antialias:true,alpha:false,forceWebGL:true});next.setPixelRatio(Math.min(devicePixelRatio,2));next.setSize(innerWidth,innerHeight);next.outputColorSpace=THREE.SRGBColorSpace;next.toneMapping=THREE.ACESFilmicToneMapping;next.toneMappingExposure=1.2;await next.init();old.domElement.remove();old.dispose();renderer=next;renderer.domElement.id='\"'game';document.body.prepend(renderer.domElement);installTouch();recoveringRenderer=false;}catch(e){window.__bootError=String(e);ui.show('error',{message:'The graphics device could not recover. Reload the expedition.'});}}\nasync function init(){\\\"\\\"\\\")\ns=s.replace(\\\"net.onLeave(()=>{if(\"'!net.status().active)ui.toast('\"'A companion heads home.','Your expedition can continue.');});\\\", \\\"net.onLeave(()=>{if(\"'!net.status().active){const p=localPlayer(),at=p?{x:p.x,y:p.y}:null;net.solo();if(at)teleport(localPlayer(),at.x,at.y);ui.toast('\"'A companion heads home.','Your expedition continues solo.');}});\\\")\ns=s.replace(\\\"addEventListener('keydown',e=>{if(e.defaultPrevented)return;setInputMode('keyboard');userActivity();\\\", \\\"addEventListener('keydown',e=>{setInputMode('keyboard');userActivity();if(e.defaultPrevented)return;\\\")\np.write_text(s)\np=Path('build.mjs');s=p.read_text().replace('<meta name=\\\"hub:webgpu\\\" content=\\\"required\\\">','');p.write_text(s)\np=Path('metadata.json');import json;d=json.loads(p.read_text());d['sourceInformation']['tech']='Three.js r180 WebGPURenderer with automatic WebGL2 recovery; Rapier 0.19.3; Gamepad API; Web Audio; native JavaScript; AI Hub Session Protocol v1. Three.js MIT; Rapier Apache-2.0.';p.write_text(json.dumps(d,indent=2))\nPY\nnpm run build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
