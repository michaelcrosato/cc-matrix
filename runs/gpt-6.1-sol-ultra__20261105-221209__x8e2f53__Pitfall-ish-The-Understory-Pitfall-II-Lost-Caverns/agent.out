{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"head -90 test_ui.py && head -70 hub-rtc-test.py && du -h '../Pitfall-ish - The Understory-Pitfall II Lost Caverns-gpt-6.1-sol-ultra-20261105-221209.html'\"","aggregated_output":"from pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nroot=Path(__file__).resolve().parent\nhtml=root/'ui-test.html'\nhtml.write_text('<!doctype html><meta charset=\"utf-8\"><style>'+root.joinpath('style.css').read_text()+'</style><script type=\"module\">'+root.joinpath('ui.js').read_text()+'''\\nwindow.actions=[];window.ui=new GameUI({onAction:(a,v)=>actions.push([a,v])},{sourceInformation:{source:'Pitfall II: Lost Caverns (1984)',usage:'added on import'},testingFeedback:['Testing complete','0','Playthrough','none'],engineFeedback:['Three.js animation','no','World','WebGPU','none','Diagnostics'],promptFeedback:['Clear source','none','Testing','none']});ui.setLoading(1);ui.show('title');window.ready=true;</script>''')\nfailures=[]\nchecks=0\nwith sync_playwright() as p:\n    browser=p.chromium.launch(headless=True)\n    page=browser.new_page(viewport={'width':1920,'height':1080})\n    page.goto(html.as_uri())\n    page.wait_for_function('window.ready')\n    def check(name,expression):\n        global checks\n        checks+=1\n        try:\n            assert page.evaluate(expression),name\n        except Exception as error:\n            failures.append(name+': '+str(error))\n    check('Title has four actions',\"document.querySelectorAll('.title-actions button').length===4\")\n    page.locator('[data-action=start]').click()\n    check('Start callback',\"actions.at(-1)[0]==='start'\")\n    page.evaluate(\"ui.show('settings')\")\n    page.locator('[data-setting=music]').evaluate(\"e=>{e.value=.35;e.dispatchEvent(new Event('input',{bubbles:true}))}\")\n    check('Music slider callback',\"actions.at(-1)[0]==='music'&&actions.at(-1)[1]===.35&&ui.settings.music===.35\")\n    page.locator('[data-setting=assist]').check()\n    check('Assist toggle callback',\"actions.at(-1)[0]==='assist'&&actions.at(-1)[1]===true\")\n    page.locator('[data-setting=glyphs]').select_option('xbox')\n    check('Glyph setting callback',\"actions.at(-1)[0]==='glyphs'&&actions.at(-1)[1]==='xbox'\")\n    page.evaluate(\"ui.show('game');ui.updateHUD({area:'Fern Gallery',hearts:2,gold:24,rescued:1,oxygen:.5,objective:'Find friends',prompt:'E • Light lantern'})\")\n    check('HUD hearts, rescue, area and oxygen',\"document.querySelectorAll('.courage .filled').length===2&&document.querySelector('.hud-identity').textContent.includes('Fern Gallery')&&document.querySelector('.oxygen-meter i').style.width==='50%'&&document.querySelector('.hud-goals').textContent.includes('1 / 3')\")\n    page.evaluate(\"ui.setInput('touch');ui.updateHUD({touchAction:'Ride balloon'})\")\n    page.locator('[data-touch-action]').click()\n    check('Contextual touch action callback',\"actions.at(-1)[0]==='interact'\")\n    page.evaluate(\"ui.setInput('keyboard');ui.show('about');ui.aboutPage='credits';ui.render()\")\n    check('Credits metadata displayed',\"document.querySelector('.credits-grid').textContent.includes('Pitfall II: Lost Caverns (1984)')&&document.querySelector('.credits-grid').textContent.includes('added on import')\")\n    page.evaluate(\"ui.aboutPage='feedback';ui.render()\")\n    check('All interview questions displayed',\"document.querySelectorAll('.feedback-block article').length===14\")\n    page.evaluate(\"ui.handlePad({axes:[0,0,0,1],buttons:Array.from({length:17},()=>({pressed:false,value:0}))},1)\")\n    check('Controller scrolls interview notes',\"document.querySelector('.about-content').scrollTop>0\")\n    page.evaluate(\"ui.show('dev',{teleports:[{id:'fern',label:'Fern Gallery'}]})\")\n    page.locator('[data-action=\"dev:teleport\"]').click()\n    check('Developer destination callback',\"actions.at(-1)[0]==='dev:teleport'&&actions.at(-1)[1]==='fern'\")\n    page.locator('[data-setting=speed]').evaluate(\"e=>{e.value=8;e.dispatchEvent(new Event('input',{bubbles:true}))}\")\n    check('Developer live slider callback',\"actions.at(-1)[0]==='dev:speed'&&actions.at(-1)[1]===8\")\n    page.evaluate(\"ui.show('coop')\")\n    page.locator('#networkCode').fill('actual connection code')\n    page.locator('[data-action=\"coop:connect\"]').click()\n    check('Connection code callback',\"actions.at(-1)[0]==='coop:connect'&&actions.at(-1)[1]==='actual connection code'\")\n    page.evaluate(\"ui.setNetwork({code:'answer code',status:'Connected'})\")\n    check('Network response displayed',\"document.querySelector('#networkCode').value==='answer code'&&document.querySelector('.coop-status').textContent==='Connected'\")\n    page.evaluate(\"ui.show('title')\")\n    page.wait_for_timeout(40)\n    page.keyboard.press('ArrowDown')\n    check('Keyboard moves focus',\"document.activeElement.dataset.action==='coop'\")\n    page.keyboard.press('Escape')\n    check('Escape emits back',\"actions.at(-1)[0]==='back'\")\n    page.evaluate(\"ui.show('settings');ui.focus(0);window.pad={axes:[0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))};pad.axes[0]=1;ui.padCooldown=0;ui.handlePad(pad,.2)\")\n    check('Gamepad changes range',\"ui.settings.music>.35\")\n    browser.close()\nhtml.unlink()\nfor failure in failures:\n    print('FAIL '+failure)\nprint(f'{checks} UI checks, {len(failures)} failures')\nraise SystemExit(bool(failures))\n\"\"\"Standalone WebRTC integration test. Run with the installed Playwright Python.\"\"\"\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\n\ndef main():\n    checks = []\n    source = (Path(__file__).parent / \"hub.js\").read_text()\n    with sync_playwright() as playwright:\n        browser = playwright.chromium.launch(headless=True)\n        try:\n            context = browser.new_context()\n            host = context.new_page()\n            guest = context.new_page()\n            for page in (host, guest):\n                page.set_content(\"<!doctype html><title>Understory networking test</title>\")\n                page.add_script_tag(content=source)\n            offer = host.evaluate(\"CavernNet.makeOffer()\")\n            answer = guest.evaluate(\"code => CavernNet.answerOffer(code)\", offer)\n            host.evaluate(\"code => CavernNet.acceptAnswer(code)\", answer)\n            host.wait_for_function(\"CavernNet.status().connected\", timeout=15000)\n            guest.wait_for_function(\"CavernNet.status().connected\", timeout=15000)\n            checks.append((\"WebRTC manual offer and answer connects both peers\", True))\n            host.evaluate(\"() => { CavernNet.onInput((v,id)=>window.receivedInput={v,id}); }\")\n            guest.evaluate(\"() => { CavernNet.onState(v=>window.receivedState=v); }\")\n            guest.evaluate(\"CavernNet.sendInput({move:1,jump:true})\")\n            host.evaluate(\"CavernNet.sendState({player:{x:21,y:-8},score:100})\")\n            host.wait_for_function(\"window.receivedInput?.v.jump===true\")\n            guest.wait_for_function(\"window.receivedState?.score===100\")\n            checks.append((\"WebRTC guest input reaches host\", host.evaluate(\"receivedInput.id===1\")))\n            checks.append((\"WebRTC authoritative snapshot reaches guest\", guest.evaluate(\"receivedState.player.x===21\")))\n            checks.append((\"WebRTC guest cannot send authoritative state\", guest.evaluate(\"CavernNet.sendState({score:900})===false\")))\n            guest.evaluate(\"() => { CavernNet.onFinish(v=>window.receivedFinish=v); }\")\n            host.evaluate(\"CavernNet.finish({won:true,score:200})\")\n            guest.wait_for_function(\"window.receivedFinish?.won===true\")\n            checks.append((\"WebRTC team result reaches companion\", True))\n            for page in (host, guest):\n                page.evaluate(\"CavernNet.destroy()\")\n        except Exception as error:\n            checks.append((\"WebRTC integration\", False))\n            print(f\"FAIL WebRTC integration: {error}\")\n        finally:\n            browser.close()\n    for name, passed in checks:\n        if not passed:\n            print(f\"FAIL {name}\")\n    print(f\"{sum(passed for _, passed in checks)}/{len(checks)} WebRTC checks passed\")\n    return 0 if all(passed for _, passed in checks) else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n3.0M\t../Pitfall-ish - The Understory-Pitfall II Lost Caverns-gpt-6.1-sol-ultra-20261105-221209.html\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game.js');s=p.read_text().replace(\\\"import { AudioDirector }\\\", \\\"import { AudioDirector, renderAudioProbe }\\\")\ns=s.replace(\\\"for(let x=x0+.7;x<x1;x+=1.7+rnd()*1.7){\\\", \\\"\\\"\\\"// Hand-cut front facets and strata keep the terrain looking like illustrated rock.\n for(let x=x0+.25;x<x1-.4;x+=2.8){const w=Math.min(2.6,x1-x),h=Math.min(top-bottom-.4,1+rnd()*2.6);const shape=new THREE.Shape();shape.moveTo(-w/2,0);shape.lineTo(w/2,-.2);shape.lineTo(w*.3,-h);shape.lineTo(-w*.25,-h*.7);shape.closePath();mesh(new THREE.ShapeGeometry(shape),rnd()>.5?0xc28155:0xad6c4d,x+w/2,top-.35,1.13);if(top-bottom>3)line([[x,top-2.8,1.16],[Math.min(x+2.5,x1),top-2.6-rnd()*.3,1.16]],0xd29b6a);}\n for(let x=x0+.7;x<x1;x+=1.7+rnd()*1.7){\\\"\\\"\\\")\ns=s.replace(\\\"if(rnd()>.35)fern(x,top+.08,1.05,.4+rnd()*.4);\\\", \\\"\\\"\\\"if(rnd()>.35)fern(x,top+.08,1.05,.4+rnd()*.4);if(rnd()>.55){const vineLength=.8+rnd()*2.1;line([[x,top+.1,1.25],[x+.16,top-vineLength*.5,1.3],[x-.15,top-vineLength,1.3]],0x427a62);for(let j=0;j<3;j++){const leaf=mesh(new THREE.SphereGeometry(.13,5,3),0x4f9372,x+(j%2?.16:-.05),top-.3-j*vineLength/3,1.32);leaf.scale.set(1.8,.7,.3);}}\\\"\\\"\\\")\ns=s.replace(\\\"box(7,h,2,layer===0?0x174850:layer===1?0x20555a:0x315d59,x,-18+rnd()*15,-12-layer*9);\\\", \\\"sphere(1,layer===0?0x174850:layer===1?0x20555a:0x315d59,x,-18+rnd()*15,-12-layer*9,worldRoot,4,h*.65,3);\\\")\ns=s.replace(\\\"// Camp: striped canvas tent\\\", \\\"\\\"\\\"// Mineral clusters, ancient masonry and soft shafts of daylight.\n for(const [x,y]of [[13,-12],[35,-12],[46,-27],[81,-27],[92,-5],[38,3]]){for(let j=0;j<4;j++)crystal(x+j*.33,y+.4,-1,.2+rnd()*.25,j%2?0x82bdb2:0xebcb8b);}\n for(const [x,y]of [[36,-12],[80,-27],[69,-5]]){for(let j=0;j<3;j++){box(.55,1+j*.18,.65,0x73928a,x+j*.62,y+.5+j*.09,-1.5,true);box(.7,.15,.8,0xb1b99b,x+j*.62,y+1+j*.18,-1.5,true);}line([[x-.5,y+2.5,-1.6],[x+.8,y+3.2,-1.6],[x+2,y+2.5,-1.6]],0x709a8c);}\n const beamMat=new THREE.MeshBasicNodeMaterial({color:0xffe2a0,transparent:true,opacity:.055,depthWrite:false,side:THREE.DoubleSide});for(const [x,y]of [[12,11],[40,-3],[85,7]]){const beam=new THREE.Mesh(new THREE.ConeGeometry(2.5,17,4,1,true),beamMat);beam.position.set(x,y-6,-2);beam.rotation.z=-.17;worldRoot.add(beam);}\n // Camp: striped canvas tent\\\"\\\"\\\")\ns=s.replace(\\\"getTime:()=>time};\\\", \\\"getTime:()=>time,renderAudioProbe,renderInfo:()=>({drawCalls:renderer.info.render.drawCalls,triangles:renderer.info.render.triangles})};\\\")\np.write_text(s)\nPY\nnpm run build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
