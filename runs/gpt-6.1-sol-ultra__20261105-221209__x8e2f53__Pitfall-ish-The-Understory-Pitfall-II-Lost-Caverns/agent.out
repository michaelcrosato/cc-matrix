{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('test_game.py');s=p.read_text().replace('networking checks passed|WebRTC checks passed|UI checks','networking checks passed|WebRTC checks passed|UI checks|file camp checks').replace(\\\"['hub-test.mjs','hub-rtc-test.py','test_ui.py']\\\", \\\"['hub-test.mjs','hub-rtc-test.py','hub-file-test.py','test_ui.py']\\\");p.write_text(s)\np=Path('../build-info.json');p.unlink(missing_ok=True)\nPY\ncat > visual_check.py <<'EOF'\nfrom pathlib import Path\nimport json,urllib.parse\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parent\ninfo=json.loads((root/'build-info.json').read_text())\nwith sync_playwright() as p:\n    b=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--use-angle=swiftshader','--enable-unsafe-swiftshader','--use-webgpu-adapter=swiftshader'])\n    page=b.new_page(viewport={'width':1920,'height':1080})\n    page.goto('http://127.0.0.1:40835/'+urllib.parse.quote(info['stem']+'.html'))\n    page.wait_for_function('window.__game?.getState().ready',timeout=90000)\n    page.evaluate(\\\"__game.action('title');__game.setIdle(-100)\\\")\n    n=page.evaluate('__game.getState().stats.frames')\n    page.wait_for_function(f'__game.getState().stats.frames>{n+6}',timeout=60000)\n    page.screenshot(path=str(root/'final-title-1920.png'))\n    page.evaluate(\\\"__game.action('start');__game.action('dev:god',true);__game.teleport(64,-32)\\\")\n    n=page.evaluate('__game.getState().stats.frames')\n    page.wait_for_function(f'__game.getState().stats.frames>{n+35}',timeout=60000)\n    page.screenshot(path=str(root/'final-river-1920.png'))\n    print('Title and river composition captures saved.')\n    b.close()\nEOF\n/home/micha/.local/share/pipx/venvs/playwright/bin/python visual_check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\nr=Path('test-results.json');v=json.loads(r.read_text());extra=json.loads(Path('hub-file-results.json').read_text())['checks'];names={a['name'] for a in v['results']}\nfor c in extra:\n if c['name'] not in names:v['results'].append({'name':c['name'],'pass':c['pass'],'detail':'Additional file:// two-tab compatibility probe'})\nv['checks']=len(v['results']);v['failures']=sum(not c['pass'] for c in v['results']);r.write_text(json.dumps(v,indent=2));print(str(v['checks'])+' total verified checks; '+str(v['failures'])+' failures')\nassert json.loads(Path('../exit-interview.json').read_text())==json.loads(Path('metadata.json').read_text())\nassert Path('../'+json.loads(Path('build-info.json').read_text())['stem']+'.html').is_file()\nprint('Deliverable and About/interview metadata match.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
