{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game.js');s=p.read_text();s=s.replace(\\\"for(const r of rescues){r.collected=false;r.g.visible=r.badge.visible=r.label.visible=true;}\\\", \\\"for(const r of rescues){r.collected=false;rescueVisual(r);}\\\")\ns=s.replace(\\\"r.collected=true;r.g.visible=r.badge.visible=r.label.visible=false;score+=1000;\\\", \\\"r.collected=true;rescueVisual(r);score+=1000;\\\")\ns=s.replace(\\\"function getArea(p)\\\", \\\"function rescueVisual(r){const i=rescues.indexOf(r);r.g.visible=true;r.badge.visible=r.label.visible=\"'!r.collected;r.g.position.set(r.collected?10+i*1.7:r.x,r.collected?4.02:r.y,0);}'\"\\\\nfunction getArea(p)\\\")\ns=s.replace(\\\"rescues[i].g.visible=rescues[i].badge.visible=rescues[i].label.visible=\"'!v;\", \"rescueVisual(rescues[i]);\")\ns=s.replace(\"r.collected=true;r.g.visible=r.badge.visible=r.label.visible=false;\", \"r.collected=true;rescueVisual(r);\")\ns=s.replace(\"rescues[j].g.visible=rescues[j].badge.visible=rescues[j].label.visible=!found;\", \"rescueVisual(rescues[j]);\")\ns=s.replace(\"score=s.score;elapsed=s.elapsed;\", \"score=s.score;elapsed=s.elapsed;time=s.time??time;\")\nstart=s.index('\"'function contextual(p)');end=s.index('\\\\nfunction updateHUD',start)\ns=s[:start]+'''function contextual(p){if(\"'!p)return'\"'';const pad=lastInput==='gamepad',touching=lastInput==='touch';const j=pad?(settings.glyphs==='xbox'?'A':'✕'):touching?'Tap right':'SPACE';const a=pad?(settings.glyphs==='xbox'?'X':'□'):touching?'Tap Catch':'E';if(p.balloon)return j+' · Let go · Move sideways to dismount';if(p.swimming)return(pad?'LEFT STICK':touching?'Drag':'↑ / ↓')+' · Swim · '+j+' to surface';if(ladders.some(l=>Math.abs(p.x-l.x)<1.2&&p.y<l.top+2&&p.y>l.bottom-1))return(pad?'LEFT STICK':touching?'Drag up / down':'↑ / ↓')+' · Climb the ladder';if(balloons.some(b=>Math.hypot(p.x-b.x,p.y-b.y)<3))return a+' · Catch a balloon';if(p.x<21&&p.y>1&&rescues.some(r=>\"'!r.collected))return'\"'Head right. The first ladder leads down.';return'';}''' +s[end:]\np.write_text(s)\np=Path('style.css');s=p.read_text()+\\\"\\\\n#game-ui[data-input=touch] .hud-top,#game-ui[data-input=touch] .courage,#game-ui[data-input=touch] .hud-objective,#game-ui[data-input=touch] .context-prompt,#game-ui[data-input=touch] #network-status{display:none}\\\\n\\\";p.write_text(s)\nPY\nnpm run build\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
