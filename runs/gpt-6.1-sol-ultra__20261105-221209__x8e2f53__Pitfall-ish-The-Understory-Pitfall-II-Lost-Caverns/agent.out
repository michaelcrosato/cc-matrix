{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,88p' hub.js && head -60 hub-test.mjs && head -60 test_hub.py && rg -n 'renderAudioProbe|inspect\\\\(' audio.js\"","aggregated_output":"/* CavernNet: authoritative two-player co-op over AI Hub, local tabs or WebRTC. */\n(() => {\n  'use strict';\n  const events = new Map(), lastEvents = new Map();\n  const colors = ['#edbd67', '#68ddd3'];\n  let data = {active:false,transport:'solo',role:'host',isHost:true,me:0,host:0,players:[{id:0,name:'You',color:colors[0]}],connected:false,waiting:false,room:'',started:true,ended:false,server:false};\n  let hub = null, channel = null, connection = null, rtc = null, remoteToken = null, token = '', initPromise;\n  let lastStateAt = -Infinity, lastInputAt = -Infinity, lastHeardAt = 0, lastPingAt = 0, sequence = 0, receivedSequence = -1;\n  let finished = false, lastScore = 0, closed = false;\n  const now = () => performance.now();\n  const emit = (kind, ...args) => {\n    if (['start','end','timeup'].includes(kind)) lastEvents.set(kind,args);\n    for (const fn of events.get(kind)||[]) fn(...args);\n  };\n  const listen = (kind, fn) => {\n    if (!events.has(kind)) events.set(kind,new Set());\n    events.get(kind).add(fn);\n    if (lastEvents.has(kind)) queueMicrotask(()=>fn(...lastEvents.get(kind)));\n    return ()=>events.get(kind)?.delete(fn);\n  };\n  const status = () => ({...data,players:data.players.map(p=>({...p}))});\n  const changed = () => emit('change',status());\n  const newToken = () => globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random()}`;\n  const jsonCopy = value => {\n    try { const text=JSON.stringify(value); return text.length<=15000?JSON.parse(text):null; } catch { return null; }\n  };\n  const send = envelope => {\n    if (closed || data.ended) return false;\n    if (data.transport==='hub') return hub.send(envelope,{to:data.isHost?undefined:data.host,reliable:true});\n    if (data.transport==='local' && channel) { channel.postMessage({...envelope,token,to:remoteToken}); return true; }\n    if (data.transport==='webrtc' && rtc?.readyState==='open') { rtc.send(JSON.stringify(envelope)); return true; }\n    return false;\n  };\n  function receive(envelope,from) {\n    if (closed || data.ended || !envelope || envelope.game!=='understory-v1') return;\n    lastHeardAt=now();\n    if (envelope.type==='input' && data.isHost && data.players.some(p=>p.id===from)) emit('input',envelope.value,from);\n    if (envelope.type==='state' && !data.isHost && from===data.host && envelope.sequence>receivedSequence) {\n      receivedSequence=envelope.sequence;\n      emit('state',envelope.value,from);\n    }\n    if (envelope.type==='finish' && !data.isHost) emit('finish',envelope.value);\n  }\n  function closeTransport() {\n    if(channel && remoteToken)channel.postMessage({type:'bye',token,to:remoteToken});\n    channel?.close(); channel=null;\n    rtc?.close(); rtc=null;\n    connection?.close(); connection=null;\n    remoteToken=null; receivedSequence=-1; sequence=0;\n    lastInputAt=-Infinity; lastStateAt=-Infinity;\n  }\n  function standalone(kind,isHost,room='') {\n    if (data.active) throw new Error('AI Hub owns the current session.');\n    closeTransport(); closed=false; finished=false;\n    data={active:false,transport:kind,role:isHost?'host':'guest',isHost,me:isHost?0:1,host:0,players:[{id:0,name:isHost?'You':'Expedition leader',color:colors[0]}],connected:false,waiting:kind!=='solo',room,started:true,ended:false,server:false};\n    if(!isHost) data.players.push({id:1,name:'You',color:colors[1]});\n    token=newToken(); lastHeardAt=now(); changed();\n  }\n  function linked() {\n    data.connected=true;data.waiting=false;\n    data.players=[{id:0,name:data.isHost?'You':'Expedition leader',color:colors[0]},{id:1,name:data.isHost?'Cavern companion':'You',color:colors[1]}];\n    lastHeardAt=now(); changed(); emit('start',{in:0,standalone:true});\n  }\n  function localMessage(event) {\n    const m=event.data;\n    if(!m || m.token===token || (m.to && m.to!==token)) return;\n    if(m.type==='hello' && data.isHost) {\n      if(remoteToken && remoteToken!==m.token) { channel.postMessage({type:'full',token,to:m.token});return; }\n      remoteToken=m.token; channel.postMessage({type:'welcome',token,to:remoteToken});\n      if(!data.connected) linked();\n    } else if(m.type==='welcome' && !data.isHost) {\n      remoteToken=m.token;if(!data.connected) linked();\n    } else if(m.type==='full' && !data.isHost) {\n      data.waiting=false;data.error='This expedition already has a companion.';changed();emit('error',data.error);\n    } else if(m.type==='bye' && m.token===remoteToken) {\n      data.connected=false;data.waiting=true;remoteToken=null;\n      if(data.isHost)data.players=data.players.filter(p=>p.id!==1);\n      changed();emit('leave',{id:data.isHost?1:0,reason:'disconnected'});\n    } else if(m.token===remoteToken) receive(m,data.isHost?1:0);\n  }\n  async function init() {\n    if(initPromise)return initPromise;\n    initPromise=(async()=>{\n      if (!globalThis.AIHub?.active) return null;\n      hub=globalThis.AIHub;\n      const info=await hub.connect({mode:'shared-world',seats:[1,2]});\n      if(!info)return null;\n      data={active:true,transport:'hub',role:info.isHost?'host':'guest',isHost:info.isHost,me:info.me,host:info.host,players:info.players,connected:true,waiting:false,room:'AI Hub',started:false,ended:false,server:!!info.server};\nimport fs from 'node:fs';\nimport vm from 'node:vm';\nimport { webcrypto } from 'node:crypto';\nimport { pathToFileURL } from 'node:url';\n\nconst code = fs.readFileSync(new URL('./hub.js', import.meta.url),'utf8');\nconst wait=ms=>new Promise(resolve=>setTimeout(resolve,ms));\nexport async function runHubTests(){\n  const results=[];\n  const check=(name,pass)=>results.push({name,pass:!!pass});\n  const instances=[];\n  function instance(hub){\n    const win={AIHub:hub,addEventListener(){}};\n    Object.assign(win,{window:win,performance,crypto:webcrypto,BroadcastChannel,RTCPeerConnection:undefined,queueMicrotask,setInterval,clearInterval,setTimeout,clearTimeout,Math,Date,JSON,btoa,atob,escape,unescape,encodeURIComponent,decodeURIComponent});\n    vm.createContext(win);vm.runInContext(code,win);instances.push(win.CavernNet);return win.CavernNet;\n  }\n  try{\n    const host=instance(),guest=instance();\n    check('standalone default is solo authoritative host',host.status().isHost&&host.status().transport==='solo'&&!host.status().active);\n    const room='TEST'+Date.now();host.hostLocal(room);guest.joinLocal(room);\n    await wait(100);\n    check('local room handshake links both players',host.status().connected&&guest.status().connected&&host.status().players.length===2&&!guest.status().isHost);\n    let input=null,state=null;host.onInput((value,id)=>input={value,id});guest.onState(value=>state=value);\n    guest.sendInput({x:1,jump:true});host.sendState({x:5,score:50});await wait(50);\n    check('guest input is delivered to authoritative host',input?.id===1&&input?.value.jump===true);\n    check('host world snapshot is delivered to guest',state?.x===5&&state?.score===50);\n    check('guest cannot publish authoritative snapshots',guest.sendState({x:200})===false);\n    check('host cannot publish guest input',host.sendInput({x:200})===false);\n    guest.solo();check('leaving local room restores solo mode',guest.status().transport==='solo'&&guest.status().isHost);\n    const handlers={},sent=[],reports=[];\n    const hub={active:true,connect:async()=>({isHost:true,host:9,me:9,players:[{id:0,name:'One'},{id:1,name:'Two'}],server:true}),on:(name,fn)=>handlers[name]=fn,ready:()=>sent.push('ready'),send:value=>{sent.push(value);return true;},finish:result=>reports.push(result),time:()=>25};\n    const server=instance(hub);await server.init();server.ready();\n    check('dedicated Hub server has no local player',server.status().server&&server.status().isHost&&!server.status().players.some(p=>p.id===server.status().me));\n    check('Hub ready runs without a gesture',sent.includes('ready'));\n    let serverInput=null;server.onInput((value,id)=>serverInput={value,id});\n    handlers.message({game:'understory-v1',type:'input',value:{move:1}},1);\n    check('Hub remote input reaches dedicated server',serverInput?.id===1);\n    server.sendState({score:123});check('Hub sends an authoritative world packet',sent.some(x=>x.type==='state'));\n    handlers['time-up']({graceMs:500});await wait(200);\n    check('time-up produces complete team standings',reports.length===1&&reports[0].standings[0].length===2&&reports[0].scores[0]===123&&reports[0].won===false);\n    handlers.end({reason:'finished'});await wait(70);\n    check('round end blocks further network traffic',server.sendState({score:999})===false&&server.status().ended);\n    let lateEnd=null;server.onEnd(value=>lateEnd=value);await wait(0);\n    check('late end handler receives already-ended round',lateEnd?.reason==='finished');\n  }finally{for(const item of instances)item.destroy();}\n  return results;\n}\nif(process.argv[1]&&import.meta.url===pathToFileURL(process.argv[1]).href){\n  const results=await runHubTests();for(const result of results)if(!result.pass)console.log('FAIL '+result.name);\n  console.log(`${results.filter(x=>x.pass).length}/${results.length} networking checks passed`);\n  if(results.some(x=>!x.pass))process.exitCode=1;\n}\n\"\"\"Official Hub conformance; pass an existing localhost server URL.\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\nfrom urllib.parse import quote, urlencode\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent\n\n\ndef run_hub_harness(base_url, scenarios=(\"standard\", \"server\")):\n    info = json.loads((ROOT / \"build-info.json\").read_text())\n    stem = info[\"stem\"]\n    reports = []\n    with sync_playwright() as playwright:\n        browser = playwright.chromium.launch(\n            headless=True,\n            args=[\n                \"--enable-unsafe-webgpu\",\n                \"--enable-features=Vulkan\",\n                \"--use-webgpu-adapter=swiftshader\",\n                \"--disable-background-timer-throttling\",\n                \"--disable-backgrounding-occluded-windows\",\n                \"--disable-renderer-backgrounding\",\n            ],\n        )\n        try:\n            for scenario in scenarios:\n                page = browser.new_page(viewport={\"width\": 1280, \"height\": 720})\n                runtime_errors = []\n                page.on(\"pageerror\", lambda error: runtime_errors.append(str(error)))\n                page.on(\"console\", lambda message: runtime_errors.append(message.text) if message.type == \"error\" else None)\n                query = urlencode(\n                    {\n                        \"game\": \"../\" + stem + \".html\",\n                        \"players\": \"2\",\n                        \"auto\": \"1\",\n                        \"scenario\": scenario,\n                        \"latency\": \"150\",\n                        \"jitter\": \"50\",\n                        \"loss\": \"5\",\n                    }\n                )\n                url = base_url.rstrip(\"/\") + \"/\" + quote(stem) + \"/hub-harness.html?\" + query\n                try:\n                    page.goto(url, wait_until=\"domcontentloaded\", timeout=30000)\n                    assert page.title() == \"AI Hub Session Harness\", \"Wrong page served\"\n                    page.wait_for_function(\"window.__hubCheck?.done\", timeout=100000)\n                    report = page.evaluate(\"window.__hubCheck\")\n                    report[\"runtimeErrors\"] = runtime_errors\n                    report[\"frames\"] = []\n                    for frame in page.frames[1:]:\n                        try:\n                            report[\"frames\"].append(frame.evaluate(\"({hub:window.AIHub?.inspect?.(),net:window.CavernNet?.status?.(),game:window.__game?.getState?.(),bootError:window.__bootError||null})\"))\n                        except Exception as error:\n                            report[\"frames\"].append({\"inspectionError\": str(error)})\n                    reports.append(report)\n                except Exception as error:\n                    reports.append({\"scenario\": scenario, \"pass\": False, \"checks\": [{\"name\": \"harness completed\", \"pass\": False, \"detail\": str(error)}]})\n311:  inspect() {\n332:export async function renderAudioProbe() {\n","exit_code":0,"status":"completed"}}
