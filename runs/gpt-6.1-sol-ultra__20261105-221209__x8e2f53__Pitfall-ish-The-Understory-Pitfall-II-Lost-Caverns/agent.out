\"https://github.com/dimforge/rapier.js\"\n  },\n  \"files\": [\n    \"*\"\n  ],\n  \"main\": \"rapier.cjs\",\n  \"homepage\": \"https://rapier.rs\",\n  \"types\": \"rapier.d.ts\",\n  \"sideEffects\": [\n    \"./snippets/*\"\n  ],\n  \"keywords\": [\n    \"physics\",\n    \"dynamics\",\n    \"rigid\",\n    \"real-time\",\n    \"joints\"\n  ],\n  \"module\": \"rapier.mjs\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./rapier.d.ts\",\n      \"require\": \"./rapier.cjs\",\n      \"import\": \"./rapier.mjs\"\n    }\n  }\n}three.cjs\nthree.core.js\nthree.core.min.js\nthree.module.js\nthree.module.min.js\nthree.tsl.js\nthree.tsl.min.js\nthree.webgpu.js\nthree.webgpu.min.js\nthree.webgpu.nodes.js\nthree.webgpu.nodes.min.js\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > DESIGN.md <<'EOF'\n# Pitfall-ish — The Understory\n\nA side-view, 2.5D exploration platform adventure inspired by Pitfall II: Lost Caverns (1984). Rescue three companions in a connected cavern and return to camp. Optional gold, ladders, swimming, frogs, bats, eels, balloons, checkpoints, and an unlocked return bridge support an uninterrupted expedition. No combat or lives: a mishap returns the explorer to the latest lantern and costs loose gold points.\n\nThe route descends through the Fern Gallery to the underground river, crosses to the balloon chimney, climbs to the mentor's gallery, then returns over a lowered rope bridge. Swimming has unlimited breath; touch assist automatically rises and grabs nearby balloons. All pickups and rescues persist across mishaps. The map records visited regions; lanterns are restart points. An AI attract tour demonstrates the complete route.\n\nThree.js r180 WebGPURenderer with MeshToonNodeMaterial, geometric ink outlines, native AnimationMixer clips; Rapier 0.19.3 kinematic character collision; Web Audio music/effects/gibberish; Gamepad API. Entire runtime and embedded WASM are bundled into a single HTML, with no runtime downloads. Two explorers share rescues and score in authoritative-host co-op, via AI Hub, same-browser tabs, or manual WebRTC pairing. Controller, keyboard and touch use the same screens.\n\n## Verification\n\n\"'`npm test` runs the browser/state/audio/controller/touch/online checks and reports only failures and a final count. Includes a complete scripted expedition through physics, restart, checkpoints, hazards, rescue, swimming, ballooning and win. Screenshot inspection is used for composition only. `npm run build` creates the root deliverable.\nEOF\ncat > game.js <<'\"'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport { AudioDirector } from './audio.js';\nimport { GameUI } from './ui.js';\nimport './hub.js';\nimport metadata from './metadata.json';\n\nconst \"'$=s=>document.querySelector(s);\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst palette={ink:0x092d33,rock:0xb56d4b,ochre:0xe5a969,top:0xefd49b,fern:0x41877d,mint:0x79ddbc,gold:0xffd174,water:0x267f93};\nconst defaults={speed:6.2,gravity:22,jump:10.5,swim:4.5,hazard:1,camera:22};\nconst cfg={...defaults};\nconst settings={music:.1,sfx:.6,glyphs:'\"'playstation',assist:false,reducedMotion:false};\ntry{Object.assign(settings,JSON.parse(localStorage.getItem('understory-settings')||'{}'));}catch{}\nconst stats={steps:0,jumps:0,swims:0,balloons:0,ladders:0,hits:0,checkpoints:0,rescues:0,coins:0,frames:0};\nlet mode='loading',lastInput='keyboard',time=0,elapsed=0,titleIdle=0,attractTime=0,invincible=false,ready=false,won=false,networkTick=0;\nlet accumulator=0,lastFrame=0,mapVisited=new Set(['camp']),checkpointIndex=0,score=0,bridgeOpen=false;\nlet cachedRemoteInput={},lastState=null;\nconst input={left:false,right:false,up:false,down:false,jump:false,action:false};\nconst keys=new Set();let jumpQueue=false,actionQueue=false,lastPadButtons=[];\nconst audio=new AudioDirector();\nconst ui=new GameUI({onAction:handleAction},metadata);\nconst scene=new THREE.Scene();scene.background=new THREE.Color(0x0b3036);scene.fog=new THREE.Fog(0x0b3036,35,78);\nconst camera=new THREE.OrthographicCamera(-20,20,11,-11,.1,110);\nlet renderer,world,controller,localId='solo',players=[];\nconst worldRoot=new THREE.Group();scene.add(worldRoot);\nconst coins=[],rescues=[],checkpoints=[],hazards=[],balloons=[],motes=[],animated=[],lamps=[];\nconst platforms=[];\nconst ladders=[{x:17,top:3,bottom:-12},{x:47,top:-12,bottom:-27}];\nconst waters=[{x0:48,x1:78,top:-27,bottom:-38}];\nconst route=[{x:8,y:4.1},{x:17,y:4.1},{x:17,y:-10.9},{x:24,y:-10.9},{x:29,y:-9.2},{x:35,y:-10.9},{x:44,y:-10.9},{x:47,y:-10.9},{x:47,y:-25.8},{x:57,y:-28.5},{x:73,y:-35.2},{x:79,y:-28},{x:84,y:-25.9},{x:86,y:-22},{x:86,y:5.5},{x:76,y:-3.9},{x:65,y:-3.9},{x:61,y:.2},{x:56,y:4.2},{x:35,y:4.2},{x:22,y:4.2},{x:8,y:4.2}];\nconst matCache=new Map();\nfunction mat(c){if(\"'!matCache.has(c))matCache.set(c,new THREE.MeshToonNodeMaterial({color:c}));return matCache.get(c);}\nconst inkMat=new THREE.MeshBasicNodeMaterial({color:palette.ink,side:THREE.BackSide});\nfunction mesh(geo,c,x=0,y=0,z=0,outline=false,parent=worldRoot){const m=new THREE.Mesh(geo,mat(c));m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;parent.add(m);if(outline){const o=new THREE.Mesh(geo,inkMat);o.scale.setScalar(1.04);m.add(o);}return m;}\nfunction box(w,h,d,c,x,y,z=0,o=false,p=worldRoot){return mesh(new THREE.BoxGeometry(w,h,d),c,x,y,z,o,p);}\nfunction sphere(r,c,x,y,z=0,p=worldRoot,sx=1,sy=1,sz=1){const m=mesh(new THREE.SphereGeometry(r,12,8),c,x,y,z,true,p);m.scale.set(sx,sy,sz);return m;}\nfunction line(points,c=palette.ink,parent=worldRoot){const g=new THREE.BufferGeometry().setFromPoints(points.map(p=>new THREE.Vector3(...p)));const l=new THREE.Line(g,new THREE.LineBasicNodeMaterial({color:c}));parent.add(l);return l;}\nfunction textSprite(text,x,y,z,size=1.1,color='\"'#f5e6c1',parent=worldRoot){const canvas=document.createElement('canvas');canvas.width=512;canvas.height=96;const cx=canvas.getContext('2d');cx.font='bold 38px Georgia';cx.fillStyle=color;cx.textAlign='center';cx.fillText(text,256,57);const tex=new THREE.CanvasTexture(canvas);const s=new THREE.Sprite(new THREE.SpriteNodeMaterial({map:tex,transparent:true}));s.scale.set(size*5.34,size,1);s.position.set(x,y,z);parent.add(s);return s;}\nfunction seeded(n){let s=n;return()=>{s=(s*1664525+1013904223)>>>0;return s/4294967296;};}const rnd=seeded(1984);\nfunction ground(x0,x1,top,bottom,color=palette.rock,collider=true){const w=x1-x0;box(w,top-bottom,3.6,color,(x0+x1)/2,(top+bottom)/2,-.7,true);box(w,.22,3.85,palette.top,(x0+x1)/2,top-.02,-.7,true);platforms.push({x0,x1,top,bottom});if(collider)world.createCollider(RAPIER.ColliderDesc.cuboid(w/2,(top-bottom)/2,2).setTranslation((x0+x1)/2,(top+bottom)/2,0));\n for(let x=x0+.7;x<x1;x+=1.7+rnd()*1.7){line([[x,top-.5,1.14],[x-.4,top-1.3,1.15],[x+.1,top-2.2,1.15]],0x713f39);if(rnd()>.35)fern(x,top+.08,1.05,.4+rnd()*.4);}\n}\nfunction fern(x,y,z,s=1){const g=new THREE.Group();g.position.set(x,y,z);g.scale.setScalar(s);worldRoot.add(g);for(let i=0;i<5;i++){const a=(i-2)*.42;const stem=mesh(new THREE.ConeGeometry(.18,.95,3),i%2?0x509c87:0x2c766e,Math.sin(a)*.32,.3+Math.cos(a)*.15,0,false,g);stem.rotation.z=-a;for(let j=0;j<3;j++){const leaf=mesh(new THREE.ConeGeometry(.16,.48,3),0x5db19a,Math.sin(a)*(.3+j*.11),.25+j*.15,.05,false,g);leaf.rotation.z=-a+(i%2?1:-1)*.8;}}return g;}\nfunction crystal(x,y,z,s=.6,c=palette.mint){const m=mesh(new THREE.OctahedronGeometry(s),c,x,y,z,true);m.scale.y=1.8;return m;}\nfunction makeExplorer(color=0xe88652){const g=new THREE.Group();const torso=box(.66,.78,.44,color,0,.06,0,true,g);torso.name='torso';const head=sphere(.29,0xf2c68b,0,.73,0,g,1,.95,.9);sphere(.15,0xf2c68b,.27,.68,.1,g);box(.9,.11,.7,0xe7c575,0,1.01,0,true,g);box(.58,.3,.5,0xe7c575,0,1.17,0,true,g);box(.63,.07,.53,0x7d493b,0,1.08,0,false,g);box(.08,.11,.03,palette.ink,.15,.8,.265,false,g);box(.08,.11,.03,palette.ink,-.12,.8,.265,false,g);box(.1,.52,.08,0xf0d899,.06,.06,.245,false,g);box(.45,.65,.28,0x6f7963,-.15,.07,-.36,true,g);\n const limbs={};for(const [name,x,y,w,h,col] of [['armL',-.47,.23,.2,.65,0xe88652],['armR',.47,.23,.2,.65,0xe88652],['legL',-.19,-.53,.23,.65,0x334e50],['legR',.19,-.53,.23,.65,0x334e50]]){const pivot=new THREE.Group();pivot.name=name;pivot.position.set(x,y,0);g.add(pivot);box(w,h,.27,col,0,-h*.37,0,true,pivot);if(name.startsWith('leg'))box(.3,.18,.45,0x4d3830,.035,-h*.8,.05,true,pivot);else sphere(.12,0xf2c68b,0,-h*.8,0,pivot);limbs[name]=pivot;}\n const mixer=new THREE.AnimationMixer(g);const T=THREE.NumberKeyframeTrack;const tracks=[];for(const [name,sign] of [['armL',1],['armR',-1],['legL',-1],['legR',1]])tracks.push(new T(name+'.rotation[z]',[0,.2,.4,.6,.8],[0,.65*sign,0,-.65*sign,0]));const walk=mixer.clipAction(new THREE.AnimationClip('expedition-stride',.8,tracks));walk.play();const float=mixer.clipAction(new THREE.AnimationClip('river-kick',1,[new T('armL.rotation[z]',[0,.5,1],[1.4,-.3,1.4]),new T('armR.rotation[z]',[0,.5,1],[-1.4,.3,-1.4])]));float.play();float.setEffectiveWeight(0);return{g,mixer,walk,float,limbs};}\nfunction createPlayer(id,color){const visual=makeExplorer(color);scene.add(visual.g);const body=world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(8,4.02,0));const col=world.createCollider(RAPIER.ColliderDesc.capsule(.42,.32),body);const cc=world.createCharacterController(.025);cc.enableAutostep(.25,.25,true);cc.enableSnapToGround(.25);const p={id,...visual,body,col,cc,x:8,y:4.02,vx:0,vy:0,grounded:false,facing:1,health:3,invuln:0,ladder:false,swimming:false,balloon:false,balloonId:-1,checkpoint:{x:8,y:4.02},coyote:0,jumpHeld:false,actionHeld:false,remote:false};players.push(p);return p;}\nfunction createWorld(){scene.add(new THREE.HemisphereLight(0xf7e6bf,0x26575b,2.7));const sun=new THREE.DirectionalLight(0xffdaa0,3.3);sun.position.set(-8,28,23);scene.add(sun);const fill=new THREE.DirectionalLight(0x7bc4c0,1);fill.position.set(30,-20,10);scene.add(fill);\n ground(-10,21,3,-2);ground(10,25,-12,-17);ground(30,49,-12,-17);ground(27,28.8,-10.5,-11.2);ground(34,48,-27,-40);ground(48,78,-38,-43,0x356b6c);ground(78,97,-27,-40);ground(64,97,-5,-9);ground(60,63,-1,-2);ground(34,59,3,-1);\n // Layered distant cliff silhouettes, lit mineral strata and old arches.\n for(let layer=0;layer<3;layer++){for(let x=-25;x<120;x+=6){const h=10+rnd()*30;box(7,h,2,layer===0?0x174850:layer===1?0x20555a:0x315d59,x,-18+rnd()*15,-12-layer*9);for(let j=0;j<3;j++)mesh(new THREE.ConeGeometry(2+rnd()*3,5+rnd()*8,5),0x1a444c,x+rnd()*4,-35+j*16,-10-layer*8);}}\n for(let i=0;i<80;i++){const x=-8+rnd()*110,y=8-rnd()*52;const p=sphere(.025+rnd()*.04,i%3?0x97dbac:0xf3c780,x,y,2+rnd()*6,worldRoot);motes.push({m:p,x,y,seed:rnd()*10});}\n for(const l of ladders){for(const dx of [-.48,.48])box(.12,l.top-l.bottom+.8,.18,0x8f6542,l.x+dx,(l.top+l.bottom)/2,.2,true);for(let y=l.bottom;y<l.top+.4;y+=.6)box(1.1,.13,.22,0xe1b87d,l.x,y,.35,true);}\n for(let x=-5;x<19;x+=2.5){const h=6+rnd()*4;box(.55,h,.8,0x214a44,x,3+h/2,-5);for(let j=0;j<4;j++){const a=j*1.6+rnd();const leaf=mesh(new THREE.SphereGeometry(1.7,7,5),j%2?0x347c60:0x28674f,x+Math.cos(a)*2,3+h+Math.sin(a),-5);leaf.scale.set(2,.5,1);}}\n for(let i=0;i<33;i++){const x=11+rnd()*85,y=-7-rnd()*26;const m=mesh(new THREE.ConeGeometry(.18+rnd()*.5,1+rnd()*2,5),i%2?0x30676a:0x2b585b,x,y,-3-rnd()*4);if(i%2)m.rotation.z=Math.PI;}\n // Cascading underground spring, deliberately behind the traversable river.\n const waterMat=new THREE.MeshBasicNodeMaterial({color:0x64cabc,transparent:true,opacity:.26,depthWrite:false});const river=new THREE.Mesh(new THREE.BoxGeometry(30,11,2.5),waterMat);river.position.set(63,-32.5,-.25);worldRoot.add(river);line([[48,-27,1.2],[78,-27,1.2]],0x95e8d2);for(let i=0;i<11;i++){const m=new THREE.Mesh(new THREE.PlaneGeometry(.08+rnd()*.12,12),waterMat);m.position.set(52+rnd()*4,-20,-2.8);worldRoot.add(m);animated.push({type:'waterfall',m,seed:rnd()*8});}\n for(let i=0;i<18;i++){const x=49+rnd()*28;fern(x,-37.8,.6,.6);crystal(x,-37.5,-1,.25,0x72d0cb);}\n // Camp: striped canvas tent, rope lines, kettle, crates and a real lantern.\n const tent=new THREE.Group();tent.position.set(4,3,-1.2);worldRoot.add(tent);const tgeo=new THREE.ConeGeometry(2.1,2.8,4,1,true);const t=mesh(tgeo,0xe5b968,0,1.4,0,true,tent);t.rotation.y=Math.PI/4;box(1.1,1.3,.08,palette.ink,0,.65,1.45,false,tent);line([[-2.7,0,1],[0,2.8,0],[2.7,0,1]],0xead29b,tent);box(1,.9,.8,0x9c6844,7,3.45,-1.1,true);box(.9,.8,.85,0xbd8753,8,3.4,-1.4,true);textSprite('CAMP DAYLIGHT',5,6.9,-.5,1.1);textSprite('THE UNDERSTORY',30,-4,-5,1.5,'#78a998');\n for(const [x,y,name] of [[8,3,'DAYLIGHT CAMP'],[34,-12,'FERN GALLERY'],[45,-27,'RIVER LANTERN'],[81,-27,'BALLOON DOCK'],[88,-5,'SUNLIT LEDGE']]){const g=new THREE.Group();g.position.set(x,y,0);worldRoot.add(g);box(.15,2,.15,0x674c3c,0,1,-.6,true,g);box(.55,.65,.4,0xf4cc6a,0,1.8,-.6,true,g);box(.7,.12,.55,0x244d4b,0,2.18,-.6,true,g);const halo=sphere(.5,0xffd480,0,1.8,-.6,g);halo.material=new THREE.MeshBasicNodeMaterial({color:0xffd88e,transparent:true,opacity:.12,depthWrite:false});checkpoints.push({x,y:y+1.02,name,g,active:false});}\n const companions=[['PIP',44,-10.99,0x78bd9d,'That frog has my lunch. You may keep the frog.'],['NIBS',73,-35,0xc5a27b,'Blub-biddle\"'! My whiskers are absolutely waterlogged.'\"'],['PROFESSOR FERN',65,-3.99,0xc8a2c8,'A magnificent discovery\"'! Now let us discover the way home.'\"']];\n for(const [name,x,y,col,speech]of companions){const g=new THREE.Group();g.position.set(x,y,0);worldRoot.add(g);if(name==='NIBS'){sphere(.38,col,0,-.22,0,g,1.5,.8,1);sphere(.27,col,.36,.04,0,g);sphere(.06,palette.ink,.49,.09,.21,g);const tail=box(.6,.12,.18,col,-.65,-.22,0,true,g);tail.rotation.z=.35;}else{const v=makeExplorer(col);g.add(v.g);v.g.scale.setScalar(name==='PIP'?.72:.85);animated.push({type:'companion',v});}const badge=crystal(x,y+2,0,.28,palette.gold);const label=textSprite(name,x,y+2.7,0,.65);rescues.push({name,x,y,speech,g,badge,label,collected:false});}\n const goldPositions=[[12,4.2],[17,-3],[17,-8],[22,-10.8],[27.9,-8.6],[32,-10.7],[39,-10.8],[46,-17],[47,-22],[52,-28.5],[58,-32],[65,-35],[70,-36],[76,-33],[80,-25.8],[86,-21],[86,-15],[86,-9],[90,-3.8],[76,-3.8],[65,-2],[61,.5],[55,4.3],[44,4.3],[36,4.3]];\n goldPositions.forEach(([x,y],i)=>{const m=mesh(new THREE.CylinderGeometry(.27,.27,.1,10),palette.gold,x,y,.1,true);m.rotation.x=Math.PI/2;const rim=mesh(new THREE.TorusGeometry(.18,.035,4,12),0xe49a43,0,0,.07,false,m);coins.push({x,y,m,collected:false,id:i});});\n for(const [type,x,y,r]of [['frog',23,-11.5,2],['frog',39,-11.5,2.7],['bat',33,-8,4],['bat',43,-19,4],['eel',59,-31,4],['eel',70,-34,4],['bat',76,-2,3],['frog',51,3.5,3]]){const g=new THREE.Group();worldRoot.add(g);if(type==='frog'){sphere(.32,0x9eb855,0,0,0,g,1.4,.8,1);for(const dx of [-.22,.22]){sphere(.15,0xc9d977,dx,.23,.05,g);sphere(.055,palette.ink,dx,.26,.18,g);}box(.6,.08,.1,0x536447,0,-.03,.3,false,g);}else if(type==='bat'){sphere(.25,0x9b7291,0,0,0,g);for(const sign of [-1,1]){const wing=mesh(new THREE.ConeGeometry(.4,.9,3),0xa582a2,sign*.45,.05,0,true,g);wing.rotation.z=sign*Math.PI/2;wing.name='wing'+sign;}sphere(.06,palette.gold,.1,.08,.2,g);}else{sphere(.3,0xdd9a68,0,0,0,g,2.5,.7,.7);sphere(.06,palette.ink,.57,.1,.18,g);mesh(new THREE.ConeGeometry(.3,.5,3),0xdbbb82,-.75,0,0,true,g).rotation.z=Math.PI/2;}hazards.push({type,x,y,r,g,px:x,py:y,phase:rnd()*6});}\n for(let i=0;i<3;i++){const g=new THREE.Group();worldRoot.add(g);sphere(1.05,i%2?0xdd855e:0xeeb65e,0,2.3,0,g,1,1.25,.75);for(let j=0;j<5;j++){const a=j*Math.PI*2/5;line([[Math.cos(a)*.7,1.5,.3],[Math.cos(a)*.35,0,.3]],0xecd39e,g);}box(.85,.6,.7,0x9b6b42,0,-.1,0,true,g);box(1,.1,.8,0xd9ad6a,0,.2,0,true,g);balloons.push({g,x:86,y:-26+i*11,phase:i*11});}\n textSprite('↓  FERN GALLERY',17,.4,1,.65);textSprite('THE LONG WAY DOWN',37,-7,-3,.9,'#88a8a0');textSprite('UNDERGROUND RIVER',63,-23,-3,1,'#9ed7c5');textSprite('↑  BALLOON CHIMNEY',88,-12,-3,.85,'#e7bd82');textSprite('HOMEWARD BOUND',47,8,-4,1,'#b2bd91');\n // Repeating rope supports for the bridge that becomes available after all rescues.\n createBridge(false);\n}\nlet bridgeMeshes=[];let bridgeCollider=null;\nfunction createBridge(open){for(const m of bridgeMeshes)worldRoot.remove(m);bridgeMeshes=[];if(bridgeCollider){world.removeCollider(bridgeCollider,true);bridgeCollider=null;}if(\"'!open){const sign=textSprite('\"'BRIDGE RAISED',21,5.8,0,.65);bridgeMeshes.push(sign);return;}\n for(let x=21;x<34;x+=.65){const b=box(.56,.18,2,palette.ochre,x,3,-.2,true);bridgeMeshes.push(b);}for(const z of [-1,1]){bridgeMeshes.push(line([[20,4.5,z],[27,3.8,z],[34,4.5,z]],0xe3cb91));for(let x=21;x<34;x+=1.4)bridgeMeshes.push(line([[x,3,z],[x,4.1,z]],0xc19862));}bridgeCollider=world.createCollider(RAPIER.ColliderDesc.cuboid(7,.15,1.8).setTranslation(27,2.93,0));}\nfunction getArea(p){if(p.y>-2&&p.x<23)return'Daylight camp';if(p.y<-26)return p.x>78?'Balloon dock':'Underground river';if(p.x>78)return'Balloon chimney';if(p.y>-9&&p.x>54)return'Sunlit ledge';if(p.y>-2)return'Homeward ridge';return'Fern gallery';}\nfunction localPlayer(){return players.find(p=>p.id===localId)||players[0];}\nfunction setInputMode(v){if(lastInput\"'!==v){lastInput=v;ui.setInput(v,settings.glyphs);}}\nfunction userActivity(){titleIdle=0;if(mode==='\"'attract'){mode='title';ui.show('title');resetGame(false);audio.setMode('title');}}\nfunction jumpPressed(){jumpQueue=true;userActivity();}\nfunction interactPressed(){actionQueue=true;userActivity();}\nfunction saveSettings(){try{localStorage.setItem('understory-settings',JSON.stringify(settings));}catch{}}\nfunction begin(){resetGame(true);mode='playing';ui.show('playing');audio.unlock();audio.setMode('playing');ui.toast('A good hat. A long way down.','Find Pip, Nibs and Professor Fern. Then return to camp.');}\nfunction resetGame(full=true){won=false;score=0;elapsed=0;checkpointIndex=0;bridgeOpen=false;createBridge(false);mapVisited=new Set(['Daylight camp']);for(const c of coins){c.collected=false;c.m.visible=true;}for(const r of rescues){r.collected=false;r.g.visible=r.badge.visible=r.label.visible=true;}checkpoints.forEach(c=>c.active=false);for(const p of players){p.x=8;p.y=4.02;p.vy=p.vx=0;p.health=3;p.invuln=0;p.balloon=false;p.checkpoint={x:8,y:4.02};p.body.setTranslation({x:p.x,y:p.y,z:0},true);}if(full)for(const k in stats)stats[k]=0;}\nfunction teleport(p,x,y){p.x=x;p.y=y;p.vx=p.vy=0;p.balloon=false;p.body.setTranslation({x,y,z:0},true);p.body.setNextKinematicTranslation({x,y,z:0});p.g.position.set(x,y,0);}\nfunction hurt(p){if(p.invuln>0||invincible||settings.assist||mode==='attract')return;p.health--;p.invuln=2;stats.hits++;score=Math.max(0,score-100);audio.sfx('hurt');burst(p.x,p.y,0xeb8058,14);if(p.health<=0){p.health=3;teleport(p,p.checkpoint.x,p.checkpoint.y);ui.toast('A small setback. A splendid hat.','Back to the last lantern. Your friends and finds are safe.');}else{p.vy=6;p.vx=-p.facing*3;} }\nconst particles=[];function burst(x,y,c,count=12){for(let i=0;i<count;i++){const m=sphere(.05+rnd()*.05,c,x,y,1);particles.push({m,vx:(rnd()-.5)*5,vy:rnd()*6,life:.6+rnd()*.7});}}\nfunction updatePlayer(p,inp,dt){const wasWater=p.swimming;const water=waters.find(w=>p.x>w.x0+.1&&p.x<w.x1-.1&&p.y<w.top-.15&&p.y>w.bottom-.5);p.swimming=\"'!!water;p.invuln=Math.max(0,p.invuln-dt);const jumped=inp.jump&&!p.jumpHeld,acted=inp.action&&!p.actionHeld;p.jumpHeld=inp.jump;p.actionHeld=inp.action;\n const ladder=ladders.find(l=>Math.abs(p.x-l.x)<.82&&p.y<l.top+1.6&&p.y>l.bottom-.4);p.ladder=!!ladder&&(inp.up||inp.down||p.ladder&&Math.abs(p.x-ladder.x)<.65&&!inp.left&&!inp.right);if(p.ladder&&jumped)p.ladder=false;\n if(!wasWater&&water){audio.sfx('\"'splash');burst(p.x,-27,0x9fe4d3,12);stats.swims++;}if(p.swimming)stats.swims+=dt;\n if(p.balloon){const b=balloons[p.balloonId];if(\"'!b){p.balloon=false;}else{teleportInBalloon(p,b.x,b.y+.65);if(jumped||inp.down||acted||Math.abs(inp.left?1:inp.right?1:0)>0&&p.y>1){p.balloon=false;p.vy=jumped?7:2;p.x+=(inp.left?-1:inp.right?1:0)*.75;audio.sfx('\"'jump');}else{p.g.position.set(p.x,p.y,0);return;}}}\n if((acted||inp.up||settings.assist&&p.x>82)&&\"'!p.balloon){let nearest=balloons.findIndex(b=>Math.hypot(p.x-b.x,p.y-(b.y+.65))<2.1);if(nearest>=0){p.balloon=true;p.balloonId=nearest;p.ladder=false;stats.balloons++;audio.sfx('\"'balloon');ui.toast('Up, up, and mind the stalactites.','Move sideways or jump near the top to dismount.');}}\n let vx=((inp.right?1:0)-(inp.left?1:0))*(p.swimming?cfg.swim:cfg.speed);if(vx){p.facing=Math.sign(vx);stats.steps+=dt;}p.vx=lerp(p.vx,vx,Math.min(1,dt*(p.swimming?6:16)));\n if(p.swimming){p.vy=lerp(p.vy,((inp.up||inp.jump?1:0)-(inp.down?1:0))*cfg.swim+(settings.assist?.6:0),dt*6);p.ladder=false;}else if(p.ladder){p.x=lerp(p.x,ladder.x,dt*13);p.vx=0;p.vy=((inp.up?1:0)-(inp.down?1:0))*3.8;stats.ladders+=dt;}else{p.vy-=cfg.gravity*dt;p.coyote=p.grounded?.12:Math.max(0,p.coyote-dt);if(jumped&&p.coyote>0){p.vy=cfg.jump;p.coyote=0;stats.jumps++;audio.sfx('jump');}if(\"'!inp.jump&&p.vy>4)p.vy-=cfg.gravity*.8*dt;}\n // Water surface boost lets the explorer climb both riverbanks without a separate action.\n if(p.swimming&&p.y>-28&&(inp.up||inp.jump)){p.vy=7.5;if(p.x>76.8&&inp.right)p.vy=10;if(p.x<49.1&&inp.left)p.vy=10;}\n const movement={x:p.vx*dt,y:p.vy*dt,z:0};p.cc.computeColliderMovement(p.col,movement,RAPIER.QueryFilterFlags.EXCLUDE_DYNAMIC,undefined,c=>c.parent()!==p.body&&!players.some(q=>q!==p&&q.col.handle===c.handle));const corrected=p.cc.computedMovement();const pos=p.body.translation();p.x=clamp(pos.x+corrected.x,-8,96);p.y=pos.y+corrected.y;p.grounded=p.cc.computedGrounded();if(p.grounded&&p.vy<0)p.vy=0;p.body.setNextKinematicTranslation({x:p.x,y:p.y,z:0});\n if(p.y<-44){p.health=3;teleport(p,p.checkpoint.x,p.checkpoint.y);audio.sfx('\"'hurt');stats.hits++;}\n p.g.position.set(p.x,p.y,0);p.g.rotation.y=lerp(p.g.rotation.y,p.facing===1?.3:-.3,dt*10);p.g.rotation.z=lerp(p.g.rotation.z,p.swimming?-p.facing*.6:0,dt*8);p.g.visible=p.invuln<=0||Math.floor(p.invuln*12)%2===0;p.mixer.update(dt*Math.max(.2,Math.abs(p.vx)/4));p.walk.setEffectiveWeight(p.swimming?0:Math.min(1,Math.abs(p.vx)/2));p.float.setEffectiveWeight(p.swimming?1:p.ladder?.7:0);\n for(let i=0;i<checkpoints.length;i++){const c=checkpoints[i];if(Math.abs(p.x-c.x)<1.2&&Math.abs(p.y-c.y)<1.8&&\"'!c.active){c.active=true;checkpointIndex=i;p.checkpoint={x:c.x,y:c.y};p.health=3;stats.checkpoints++;audio.sfx('\"'checkpoint');burst(c.x,c.y+1,palette.gold);ui.toast(c.name,'Lantern lit · progress kept · hearts restored');}}\n for(const c of coins){if(\"'!c.collected&&Math.hypot(p.x-c.x,p.y-c.y)<1.05){c.collected=true;c.m.visible=false;score+=100;stats.coins++;audio.sfx('\"'coin');burst(c.x,c.y,palette.gold,7);}}\n for(const r of rescues){if(\"'!r.collected&&Math.hypot(p.x-r.x,p.y-r.y)<1.4){r.collected=true;r.g.visible=r.badge.visible=r.label.visible=false;score+=1000;stats.rescues++;audio.sfx('\"'rescue');audio.voice(r.name.length*23);burst(r.x,r.y,palette.mint,22);ui.toast(r.name+' FOUND\"'!'\"',r.speech);if(rescues.every(q=>q.collected)){bridgeOpen=true;createBridge(true);ui.toast('All together now.','The homeward bridge is down. Meet everyone at Daylight Camp.');}}}\n for(const h of hazards)if(Math.hypot(p.x-h.px,p.y-h.py)<(h.type==='eel'?.8:.65)+.25)hurt(p);\n const area=getArea(p);mapVisited.add(area);\n if(rescues.every(r=>r.collected)&&p.x<11&&p.y>3&&\"'!won)victory();}\nfunction teleportInBalloon(p,x,y){p.x=x;p.y=y;p.vx=p.vy=0;p.body.setTranslation({x,y,z:0},true);p.body.setNextKinematicTranslation({x,y,z:0});p.g.position.set(x,y,0);p.mixer.update(1/60);}\nfunction victory(){won=true;mode='\"'victory';audio.sfx('win');audio.setMode('victory');const net=window.CavernNet;net?.finish({won:true,score});ui.show('victory',{score,gold:coins.filter(c=>c.collected).length,totalGold:coins.length,time:Math.floor(elapsed),rescued:3});}\nfunction updateWorld(dt){time+=dt;for(const c of coins)if(\"'!c.collected){c.m.rotation.y+=dt*1.8;c.m.position.y=c.y+Math.sin(time*2+c.x)*.08;}for(const r of rescues)if(!r.collected){r.badge.rotation.y+=dt;r.badge.position.y=r.y+2+Math.sin(time*2)*.16;}\n for(const b of balloons){b.y=-27+((time*2.5+b.phase)%35);b.g.position.set(b.x+Math.sin(time*.5+b.phase)*.16,b.y,0);b.x=b.g.position.x;}\n for(const h of hazards){h.px=h.x+Math.sin(time*cfg.hazard*(h.type==='\"'bat'?1.2:.7)+h.phase)*h.r;h.py=h.y+(h.type==='bat'?Math.sin(time*1.5+h.phase)*1.2:h.type==='frog'?Math.max(0,Math.sin(time*2+h.phase))*.6:Math.sin(time+h.phase)*.3);h.g.position.set(h.px,h.py,0);h.g.rotation.y=Math.cos(time+h.phase)>0?.2:Math.PI-.2;if(h.type==='bat')for(const s of [-1,1])h.g.getObjectByName('wing'+s).rotation.y=Math.sin(time*12)*.55;}\n for(const m of motes){m.m.position.x=m.x+Math.sin(time*.25+m.seed)*.8;m.m.position.y=m.y+Math.sin(time*.5+m.seed)*.5;}\n for(const a of animated)if(a.type==='companion'){a.v.mixer.update(dt*.25);}else if(a.type==='waterfall')a.m.material.opacity=.16+Math.sin(time+a.seed)*.07;\n for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.life-=dt;p.vy-=7*dt;p.m.position.x+=p.vx*dt;p.m.position.y+=p.vy*dt;p.m.scale.setScalar(Math.max(.01,p.life));if(p.life<=0){worldRoot.remove(p.m);p.m.geometry.dispose();particles.splice(i,1);}}\n}\nfunction pollPad(dt){const pads=navigator.getGamepads?.()||[];const pad=Array.from(pads).find(p=>p&&p.connected);if(\"'!pad)return null;const active=pad.axes.some(a=>Math.abs(a)>.2)||pad.buttons.some(b=>b.pressed);if(active){setInputMode('\"'gamepad');userActivity();}const bs=pad.buttons.map(b=>b.pressed);if(bs[9]&&\"'!lastPadButtons[9])handleAction(mode==='\"'playing'?'pause':'back');if(bs[8]&&\"'!lastPadButtons[8]&&mode==='\"'playing')handleAction('map');if(ui.screen\"'!=='\"'playing'&&mode\"'!=='\"'attract'&&mode\"'!=='\"'loading')ui.handlePad(pad,dt);lastPadButtons=bs;return{left:pad.axes[0]<-.2||bs[14],right:pad.axes[0]>.2||bs[15],up:pad.axes[1]<-.3||bs[12],down:pad.axes[1]>.3||bs[13],jump:bs[0]||bs[1],action:bs[2]||bs[3]};}\nconst touch={active:new Map(),left:false,right:false,up:false,down:false,jump:false};\nfunction getInput(pad){return{left:keys.has('ArrowLeft')||keys.has('KeyA')||touch.left||pad?.left||false,right:keys.has('ArrowRight')||keys.has('KeyD')||touch.right||pad?.right||false,up:keys.has('ArrowUp')||keys.has('KeyW')||touch.up||pad?.up||false,down:keys.has('ArrowDown')||keys.has('KeyS')||touch.down||pad?.down||false,jump:keys.has('Space')||jumpQueue||touch.jump||pad?.jump||false,action:keys.has('KeyE')||actionQueue||pad?.action||false};}\nfunction frame(t){requestAnimationFrame(frame);if(\"'!ready)return;const dt=Math.min(.05,(t-lastFrame)/1000||.016);lastFrame=t;stats.frames++;const pad=pollPad(dt);const inp=getInput(pad);audio.tick(dt);const net=window.CavernNet;const status=net?.status()||{isHost:true,active:false};\n if(mode==='\"'title'){titleIdle+=dt;if(titleIdle>=10){resetGame(false);mode='attract';attractTime=0;ui.show('attract');audio.setMode('attract');}}\n if(mode==='attract'){attractTime+=dt;const duration=70;const total=(attractTime%duration)/duration*(route.length-1);const i=Math.floor(total),f=total-i;const a=route[i],b=route[Math.min(i+1,route.length-1)];const p=localPlayer();if(p){teleport(p,lerp(a.x,b.x,f),lerp(a.y,b.y,f)+Math.sin(f*Math.PI)*((i===3||i===16)?1.2:0));p.mixer.update(dt);p.facing=b.x>=a.x?1:-1;p.g.rotation.y=p.facing*.3;p.walk.setEffectiveWeight(.8);}if(i>6)rescues[0].g.visible=false;if(i>10)rescues[1].g.visible=false;if(i>16)rescues[2].g.visible=false;}\n const running=mode==='playing'&&(\"'!status.active||status.started)&&(!status.active||net.time?.()>=0||!net.time);if(running){elapsed+=dt;if(status.isHost){accumulator+=dt;let n=0;while(accumulator>=1/60&&n++<4){updateWorld(1/60);for(const p of players){const pi=p.id===localId?inp:(cachedRemoteInput[p.id]||{});updatePlayer(p,pi,1/60);}world.timestep=1/60;world.step();accumulator-=1/60;}networkTick+=dt;if(networkTick>.05){networkTick=0;if(status.connected)net.sendState(snapshot());}}else net.sendInput(inp);jumpQueue=actionQueue=false;}\n if(!running)updateWorld(dt*(mode==='\"'paused'?0:1));\n updateCamera(dt);updateHUD();renderer.render(scene,camera);}\nconst camTarget=new THREE.Vector3(10,1,0);function updateCamera(dt){const p=localPlayer();let x=p?.x||8,y=p?.y||4;if(mode==='title'||mode==='loading'){x=11;y=-1.3;}if(mode==='victory'){x=7;y=4;}const k=settings.reducedMotion?1:1-Math.exp(-dt*4);camTarget.x=lerp(camTarget.x,x+(mode==='title'?3:p?.facing*2||0),k);camTarget.y=lerp(camTarget.y,y+1.5,k);const h=cfg.camera,aspect=innerWidth/innerHeight;camera.left=-h*aspect/2;camera.right=h*aspect/2;camera.top=h/2;camera.bottom=-h/2;camera.position.set(camTarget.x,camTarget.y+2.7,36);camera.lookAt(camTarget.x,camTarget.y,0);camera.updateProjectionMatrix();}\nfunction contextual(p){if(\"'!p)return'\"'';if(p.balloon)return'Jump or move sideways to dismount';if(p.swimming)return'↑ / ↓ Swim · Jump to surface';if(ladders.some(l=>Math.abs(p.x-l.x)<1.2&&p.y<l.top+2&&p.y>l.bottom-1))return'↑ / ↓ Climb the ladder';if(balloons.some(b=>Math.hypot(p.x-b.x,p.y-b.y)<3))return'E · Catch a balloon';if(p.x<21&&p.y>1&&rescues.some(r=>\"'!r.collected))return'\"'Head right. The first ladder leads down.';return'';}\nfunction updateHUD(){const p=localPlayer();if(\"'!p)return;const count=rescues.filter(r=>r.collected).length;const area=getArea(p);audio.setZone(p.swimming?'\"'water':p.balloon?'balloon':p.y<-15?'deep':'gallery');ui.updateHUD({score,gold:coins.filter(c=>c.collected).length,totalGold:coins.length,rescued:count,hearts:p.health,area,objective:count<3?'Find your three lost companions':'Bring everyone back to camp',prompt:contextual(p),mode,coop:players.length>1?'CO-OP EXPEDITION':'',checkpoint:checkpoints[checkpointIndex]?.name,oxygen:1});}\nfunction snapshot(){return{players:players.map(p=>({id:p.id,x:p.x,y:p.y,vx:p.vx,vy:p.vy,health:p.health,swimming:p.swimming,balloon:p.balloon,facing:p.facing})),coins:coins.map(c=>c.collected),rescues:rescues.map(r=>r.collected),score,bridgeOpen,elapsed,won,mode,checkpoints:checkpoints.map(c=>c.active),time};}\nfunction applySnapshot(s){lastState=s;if(\"'!s||!s.players)return;for(const d of s.players){let p=players.find(p=>p.id===d.id)||createPlayer(d.id,d.id===localId?0xe88652:0x71bbb1);Object.assign(p,d);p.g.position.set(p.x,p.y,0);p.g.rotation.y=p.facing*.3;p.mixer.update(.06);p.walk.setEffectiveWeight(Math.abs(p.vx)/6);p.float.setEffectiveWeight(p.swimming?1:0);}s.coins.forEach((v,i)=>{coins[i].collected=v;coins[i].m.visible=!v;});s.rescues.forEach((v,i)=>{rescues[i].collected=v;rescues[i].g.visible=rescues[i].badge.visible=rescues[i].label.visible=!v;});score=s.score;elapsed=s.elapsed;if(s.bridgeOpen&&!bridgeOpen){bridgeOpen=true;createBridge(true);}if(s.won&&!won){won=true;mode='\"'victory';ui.show('victory',{score,gold:s.coins.filter(Boolean).length,totalGold:coins.length,time:Math.floor(elapsed),rescued:3});}}\nfunction configureNet(){const net=window.CavernNet;if(\"'!net)return;const sync=()=>{const s=net.status();if(s.active||s.connected){localId=s.me;const ids=s.players.map(p=>p.id);for(const id of ids)if(!players.some(p=>p.id===id))createPlayer(id,id===localId?0xe88652:0x71bbb1);for(const p of [...players])if(!ids.includes(p.id)){scene.remove(p.g);world.removeRigidBody(p.body);players.splice(players.indexOf(p),1);}if(!players.length&&!s.server)createPlayer(localId,0xe88652);}ui.setStatus(`${s.transport.toUpperCase()} · ${s.players.length} EXPLORER${s.players.length===1?'\"'':'S'} · \"'${s.role}`);};net.onChange(sync);net.onStart(()=>{sync();begin();});net.onState(applySnapshot);net.onInput((inp,id)=>{cachedRemoteInput[id]=inp;});net.onTimeUp(()=>{if(!won){mode='\"'victory';ui.show('victory',{score,gold:coins.filter(c=>c.collected).length,totalGold:coins.length,time:Math.floor(elapsed),rescued:rescues.filter(r=>r.collected).length});net.finish({won:false,score});}});net.onLeave(()=>{mode='title';ui.show('title');});sync();}\nfunction mapSVG(){const paths=platforms.map(p=>\"'`<rect x=\"${(p.x0+12)*5}\" y=\"${(6-p.top)*4}\" width=\"${(p.x1-p.x0)*5}\" height=\"5\" fill=\"#c9a879\"/>`).join('\"'');const ls=ladders.map(l=>\"'`<path d=\"M${(l.x+12)*5},${(6-l.top)*4}V${(6-l.bottom)*4}\" stroke=\"#ffd174\" stroke-width=\"4\" stroke-dasharray=\"2 3\"/>`).join('\"'');const rs=rescues.map(r=>\"'`<circle cx=\"${(r.x+12)*5}\" cy=\"${(6-r.y)*4}\" r=\"6\" fill=\"${r.collected?'\"'#79ddbc':'#ee7444'}\\\"/><text x=\\\"\"'${(r.x+12)*5}\" y=\"${(6-r.y)*4-12}\" text-anchor=\"middle\" fill=\"#f4e6bf\" font-size=\"11\">${r.name}</text>`).join('\"'');const p=localPlayer();return\"'`<svg viewBox=\"0 0 570 225\" role=\"img\" aria-label=\"Cavern field map\"><rect width=\"570\" height=\"225\" rx=\"12\" fill=\"#103a40\"/><rect x=\"300\" y=\"132\" width=\"150\" height=\"44\" fill=\"#267f93\"/>${paths}${ls}${rs}<path d=\"M490 128 V6\" stroke=\"#eeb65e\" stroke-width=\"3\" stroke-dasharray=\"7 5\"/><circle cx=\"${(p.x+12)*5}\" cy=\"${(6-p.y)*4}\" r=\"6\" fill=\"#fff3c9\" stroke=\"#ee7444\" stroke-width=\"3\"/><text x=\"80\" y=\"10\" fill=\"#f4e6bf\" font-size=\"11\">DAYLIGHT CAMP</text><text x=\"310\" y=\"205\" fill=\"#79ddbc\" font-size=\"11\">RIVER · no breath limit</text></svg>`;}\nasync function handleAction(action,value){userActivity();audio.sfx('\"'ui');if(action==='start'||action==='restart'||action==='playAgain'){begin();return;}if(action==='pause'){if(mode==='playing'){mode='paused';ui.show('pause');}return;}if(action==='resume'){mode='playing';ui.show('playing');return;}if(action==='back'){if(mode==='playing'){mode='paused';ui.show('pause');}else if(ui.screen==='pause'){mode='playing';ui.show('playing');}else{ui.show(mode==='title'?'title':'pause');}return;}if(action==='title'||action==='quit'){mode='title';ui.show('title');titleIdle=0;return;}if(action==='map'){if(mode==='playing')mode='paused';ui.show('map',{svg:mapSVG()});return;}if(action==='settings'||action==='about'||action==='dev'||action==='developer'||action==='coop'){if(mode==='playing')mode='paused';ui.show(action==='developer'?'dev':action,{settings,config:cfg,defaults,invincible});return;}\n if(action in settings){settings[action]=value;if(action==='music')audio.setMusicVolume(+value);if(action==='sfx')audio.setSfxVolume(+value);if(action==='glyphs')ui.setInput(lastInput,value);saveSettings();return;}\n if(action.startsWith('dev:')){const key=action.slice(4);if(key in cfg)cfg[key]=+value;else if(key==='reset'){Object.assign(cfg,defaults);invincible=false;ui.show('dev',{config:cfg,defaults,invincible});}else if(key==='god'||key==='invincible')invincible=\"'!!value;else if(key==='\"'heal'){localPlayer().health=3;}else if(key==='checkpoint')teleport(localPlayer(),localPlayer().checkpoint.x,localPlayer().checkpoint.y);else if(key==='teleport'){const pts={camp:[8,4.02],gallery:[34,-10.98],river:[60,-29],balloon:[85,-25.98],ledge:[88,-3.98]};const q=pts[value]||[8,4.02];teleport(localPlayer(),...q);}else if(key==='rescue'){rescues.forEach(r=>{r.collected=true;r.g.visible=r.badge.visible=r.label.visible=false;});bridgeOpen=true;createBridge(true);}return;}\n const net=window.CavernNet;if(action.startsWith('coop:'))try{if(action==='coop:host'){net.hostLocal('UNDERSTORY');ui.setStatus('Camp open. In another tab, select Join camp.');}if(action==='coop:join'){net.joinLocal('UNDERSTORY');ui.setStatus('Joining camp…');}if(action==='coop:solo'){net.solo();}if(action==='coop:offer'){const code=await net.makeOffer();const el=\"'$('\"'#networkCode');if(el)el.value=code;ui.setStatus('Send this offer to your companion.');}if(action==='coop:answer'){const code=await net.answerOffer(value||\"'$('\"'#networkCode')?.value);\"'$('\"'#networkCode').value=code;ui.setStatus('Send this answer back to the host.');}if(action==='coop:connect'){await net.acceptAnswer(value||\"'$('\"'#networkCode')?.value);ui.setStatus('Companion connected. Begin the expedition.');}if(action==='coop:copy'){await navigator.clipboard.writeText(\"'$('\"'#networkCode')?.value||'');ui.setStatus('Connection code copied.');}}catch(e){ui.setStatus(e.message);}}\naddEventListener('keydown',e=>{setInputMode('keyboard');userActivity();if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code)&&\"'!['\"'INPUT','SELECT','TEXTAREA'].includes(e.target.tagName))e.preventDefault();keys.add(e.code);if(e.repeat)return;if(e.code==='Escape'||e.code==='KeyP')handleAction('back');if(e.code==='KeyM'&&mode==='playing')handleAction('map');if(e.code==='Space'&&mode==='playing')jumpPressed();if(e.code==='KeyE')interactPressed();if(e.code==='KeyF2')handleAction('dev');});addEventListener('keyup',e=>keys.delete(e.code));addEventListener('blur',()=>{keys.clear();if(mode==='playing'&&\"'!window.CavernNet?.status().connected)handleAction('\"'pause');});addEventListener('pointermove',e=>{if(e.pointerType==='mouse')setInputMode('keyboard');});addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'){setInputMode('keyboard');userActivity();if(mode==='playing'&&e.target===renderer?.domElement){const p=localPlayer();if(balloons.some(b=>Math.hypot(p.x-b.x,p.y-b.y)<3))interactPressed();}}});\nfunction installTouch(){const surface=renderer.domElement;surface.style.touchAction='none';surface.addEventListener('pointerdown',e=>{if(e.pointerType\"'!=='\"'touch')return;setInputMode('touch');userActivity();if(mode\"'!=='\"'playing')return;e.preventDefault();surface.setPointerCapture(e.pointerId);touch.active.set(e.pointerId,{x:e.clientX,y:e.clientY,side:e.clientX<innerWidth*.58?'move':'jump'});if(e.clientX>=innerWidth*.58)touch.jump=true;});surface.addEventListener('pointermove',e=>{const t=touch.active.get(e.pointerId);if(\"'!t||t.side!=='\"'move')return;const dx=e.clientX-t.x,dy=e.clientY-t.y;touch.left=dx< -12;touch.right=dx>12;touch.up=dy< -15;touch.down=dy>15;});const end=e=>{const t=touch.active.get(e.pointerId);if(\"'!t)return;if(t.side==='\"'move')touch.left=touch.right=touch.up=touch.down=false;else touch.jump=false;touch.active.delete(e.pointerId);};surface.addEventListener('pointerup',end);surface.addEventListener('pointercancel',end);}\nasync function init(){try{ui.setLoading(.1,'Lighting the lanterns');await RAPIER.init();world=new RAPIER.World({x:0,y:0,z:0});renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.2;document.body.prepend(renderer.domElement);renderer.domElement.id='game';await renderer.init();ui.setLoading(.45,'Finding the way down');createWorld();createPlayer('solo',0xe88652);await window.CavernNet?.init();configureNet();audio.setMusicVolume(settings.music);audio.setSfxVolume(settings.sfx);ui.setInput('keyboard',settings.glyphs);installTouch();const hub=window.CavernNet?.status();mode=hub?.active?'playing':'title';ui.show(mode==='playing'?'playing':'title');ready=true;ui.setLoading(1,'Ready');await renderer.compileAsync(scene,camera);window.CavernNet?.ready();requestAnimationFrame(frame);}catch(e){console.error(e);document.body.innerHTML=\"'`<div style=\"padding:8vw;color:#f4e6bf;background:#103a40;font:24px Georgia\"><h1>A lantern needs relighting.</h1><p>${String(e.message).replace(/</g,'\"'&lt;')}</p><p>This expedition requires a browser with WebGPU. Open this file in current Chrome or Edge.</p><button onclick=\\\"location.reload()\\\" style=\\\"font-size:24px;padding:16px\\\">Try again</button></div>\"'`;window.__bootError=String(e.stack||e);}}\naddEventListener('\"'resize',()=>{renderer?.setSize(innerWidth,innerHeight);});\nwindow.__game={getState:()=>({ready,mode,score,elapsed,bridgeOpen,players:players.map(p=>({id:p.id,x:p.x,y:p.y,vx:p.vx,vy:p.vy,health:p.health,grounded:p.grounded,swimming:p.swimming,balloon:p.balloon,checkpoint:p.checkpoint})),rescued:rescues.map(r=>r.collected),gold:coins.filter(c=>c.collected).length,checkpoints:checkpoints.map(c=>c.active),stats:{...stats},config:{...cfg},settings:{...settings},input:{...getInput(null)},lastInput,net:window.CavernNet?.status(),renderer:renderer?.backend?.isWebGPUBackend?'WebGPU':'unknown',rapier:RAPIER.version(),three:THREE.REVISION}),action:handleAction,step:(n=1,inp={})=>{for(let i=0;i<n;i++){updateWorld(1/60);for(const p of players)updatePlayer(p,inp,1/60);world.timestep=1/60;world.step();}},teleport:(x,y)=>teleport(localPlayer(),x,y),setHealth:n=>{localPlayer().health=n;localPlayer().invuln=0;},setInput:(k,v)=>{v?keys.add(k):keys.delete(k);},hurt:()=>hurt(localPlayer()),audio:()=>audio.inspect(),audioUnlock:()=>audio.unlock(),setIdle:n=>titleIdle=n,snapshot,applySnapshot,mapSVG,getTime:()=>time};\ninit();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > DESIGN.md <<'EOF'\n# Pitfall-ish — The Understory\n\nA side-view, 2.5D exploration platform adventure inspired by Pitfall II: Lost Caverns (1984). Rescue three companions in a connected cavern and return to camp. Optional gold, ladders, swimming, frogs, bats, eels, balloons, checkpoints, and an unlocked return bridge support an uninterrupted expedition. No combat or lives: a mishap returns the explorer to the latest lantern and costs loose gold points.\n\nThe route descends through the Fern Gallery to the underground river, crosses to the balloon chimney, climbs to the mentor's gallery, then returns over a lowered rope bridge. Swimming has unlimited breath; touch assist automatically rises and grabs nearby balloons. All pickups and rescues persist across mishaps. The map records visited regions; lanterns are restart points. An AI attract tour demonstrates the complete route.\n\nThree.js r180 WebGPURenderer with MeshToonNodeMaterial, geometric ink outlines, native AnimationMixer clips; Rapier 0.19.3 kinematic character collision; Web Audio music/effects/gibberish; Gamepad API. Entire runtime and embedded WASM are bundled into a single HTML, with no runtime downloads. Two explorers share rescues and score in authoritative-host co-op, via AI Hub, same-browser tabs, or manual WebRTC pairing. Controller, keyboard and touch use the same screens.\n\n## Verification\n\n\"'`npm test` runs the browser/state/audio/controller/touch/online checks and reports only failures and a final count. Includes a complete scripted expedition through physics, restart, checkpoints, hazards, rescue, swimming, ballooning and win. Screenshot inspection is used for composition only. `npm run build` creates the root deliverable.\nEOF\ncat > game.js <<'\"'EOF'\nimport * as THREE from 'three/webgpu';\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport { AudioDirector } from './audio.js';\nimport { GameUI } from './ui.js';\nimport './hub.js';\nimport metadata from './metadata.json';\n\nconst \"'$=s=>document.querySelector(s);\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst palette={ink:0x092d33,rock:0xb56d4b,ochre:0xe5a969,top:0xefd49b,fern:0x41877d,mint:0x79ddbc,gold:0xffd174,water:0x267f93};\nconst defaults={speed:6.2,gravity:22,jump:10.5,swim:4.5,hazard:1,camera:22};\nconst cfg={...defaults};\nconst settings={music:.1,sfx:.6,glyphs:'\"'playstation',assist:false,reducedMotion:false};\ntry{Object.assign(settings,JSON.parse(localStorage.getItem('understory-settings')||'{}'));}catch{}\nconst stats={steps:0,jumps:0,swims:0,balloons:0,ladders:0,hits:0,checkpoints:0,rescues:0,coins:0,frames:0};\nlet mode='loading',lastInput='keyboard',time=0,elapsed=0,titleIdle=0,attractTime=0,invincible=false,ready=false,won=false,networkTick=0;\nlet accumulator=0,lastFrame=0,mapVisited=new Set(['camp']),checkpointIndex=0,score=0,bridgeOpen=false;\nlet cachedRemoteInput={},lastState=null;\nconst input={left:false,right:false,up:false,down:false,jump:false,action:false};\nconst keys=new Set();let jumpQueue=false,actionQueue=false,lastPadButtons=[];\nconst audio=new AudioDirector();\nconst ui=new GameUI({onAction:handleAction},metadata);\nconst scene=new THREE.Scene();scene.background=new THREE.Color(0x0b3036);scene.fog=new THREE.Fog(0x0b3036,35,78);\nconst camera=new THREE.OrthographicCamera(-20,20,11,-11,.1,110);\nlet renderer,world,controller,localId='solo',players=[];\nconst worldRoot=new THREE.Group();scene.add(worldRoot);\nconst coins=[],rescues=[],checkpoints=[],hazards=[],balloons=[],motes=[],animated=[],lamps=[];\nconst platforms=[];\nconst ladders=[{x:17,top:3,bottom:-12},{x:47,top:-12,bottom:-27}];\nconst waters=[{x0:48,x1:78,top:-27,bottom:-38}];\nconst route=[{x:8,y:4.1},{x:17,y:4.1},{x:17,y:-10.9},{x:24,y:-10.9},{x:29,y:-9.2},{x:35,y:-10.9},{x:44,y:-10.9},{x:47,y:-10.9},{x:47,y:-25.8},{x:57,y:-28.5},{x:73,y:-35.2},{x:79,y:-28},{x:84,y:-25.9},{x:86,y:-22},{x:86,y:5.5},{x:76,y:-3.9},{x:65,y:-3.9},{x:61,y:.2},{x:56,y:4.2},{x:35,y:4.2},{x:22,y:4.2},{x:8,y:4.2}];\nconst matCache=new Map();\nfunction mat(c){if(\"'!matCache.has(c))matCache.set(c,new THREE.MeshToonNodeMaterial({color:c}));return matCache.get(c);}\nconst inkMat=new THREE.MeshBasicNodeMaterial({color:palette.ink,side:THREE.BackSide});\nfunction mesh(geo,c,x=0,y=0,z=0,outline=false,parent=worldRoot){const m=new THREE.Mesh(geo,mat(c));m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;parent.add(m);if(outline){const o=new THREE.Mesh(geo,inkMat);o.scale.setScalar(1.04);m.add(o);}return m;}\nfunction box(w,h,d,c,x,y,z=0,o=false,p=worldRoot){return mesh(new THREE.BoxGeometry(w,h,d),c,x,y,z,o,p);}\nfunction sphere(r,c,x,y,z=0,p=worldRoot,sx=1,sy=1,sz=1){const m=mesh(new THREE.SphereGeometry(r,12,8),c,x,y,z,true,p);m.scale.set(sx,sy,sz);return m;}\nfunction line(points,c=palette.ink,parent=worldRoot){const g=new THREE.BufferGeometry().setFromPoints(points.map(p=>new THREE.Vector3(...p)));const l=new THREE.Line(g,new THREE.LineBasicNodeMaterial({color:c}));parent.add(l);return l;}\nfunction textSprite(text,x,y,z,size=1.1,color='\"'#f5e6c1',parent=worldRoot){const canvas=document.createElement('canvas');canvas.width=512;canvas.height=96;const cx=canvas.getContext('2d');cx.font='bold 38px Georgia';cx.fillStyle=color;cx.textAlign='center';cx.fillText(text,256,57);const tex=new THREE.CanvasTexture(canvas);const s=new THREE.Sprite(new THREE.SpriteNodeMaterial({map:tex,transparent:true}));s.scale.set(size*5.34,size,1);s.position.set(x,y,z);parent.add(s);return s;}\nfunction seeded(n){let s=n;return()=>{s=(s*1664525+1013904223)>>>0;return s/4294967296;};}const rnd=seeded(1984);\nfunction ground(x0,x1,top,bottom,color=palette.rock,collider=true){const w=x1-x0;box(w,top-bottom,3.6,color,(x0+x1)/2,(top+bottom)/2,-.7,true);box(w,.22,3.85,palette.top,(x0+x1)/2,top-.02,-.7,true);platforms.push({x0,x1,top,bottom});if(collider)world.createCollider(RAPIER.ColliderDesc.cuboid(w/2,(top-bottom)/2,2).setTranslation((x0+x1)/2,(top+bottom)/2,0));\n for(let x=x0+.7;x<x1;x+=1.7+rnd()*1.7){line([[x,top-.5,1.14],[x-.4,top-1.3,1.15],[x+.1,top-2.2,1.15]],0x713f39);if(rnd()>.35)fern(x,top+.08,1.05,.4+rnd()*.4);}\n}\nfunction fern(x,y,z,s=1){const g=new THREE.Group();g.position.set(x,y,z);g.scale.setScalar(s);worldRoot.add(g);for(let i=0;i<5;i++){const a=(i-2)*.42;const stem=mesh(new THREE.ConeGeometry(.18,.95,3),i%2?0x509c87:0x2c766e,Math.sin(a)*.32,.3+Math.cos(a)*.15,0,false,g);stem.rotation.z=-a;for(let j=0;j<3;j++){const leaf=mesh(new THREE.ConeGeometry(.16,.48,3),0x5db19a,Math.sin(a)*(.3+j*.11),.25+j*.15,.05,false,g);leaf.rotation.z=-a+(i%2?1:-1)*.8;}}return g;}\nfunction crystal(x,y,z,s=.6,c=palette.mint){const m=mesh(new THREE.OctahedronGeometry(s),c,x,y,z,true);m.scale.y=1.8;return m;}\nfunction makeExplorer(color=0xe88652){const g=new THREE.Group();const torso=box(.66,.78,.44,color,0,.06,0,true,g);torso.name='torso';const head=sphere(.29,0xf2c68b,0,.73,0,g,1,.95,.9);sphere(.15,0xf2c68b,.27,.68,.1,g);box(.9,.11,.7,0xe7c575,0,1.01,0,true,g);box(.58,.3,.5,0xe7c575,0,1.17,0,true,g);box(.63,.07,.53,0x7d493b,0,1.08,0,false,g);box(.08,.11,.03,palette.ink,.15,.8,.265,false,g);box(.08,.11,.03,palette.ink,-.12,.8,.265,false,g);box(.1,.52,.08,0xf0d899,.06,.06,.245,false,g);box(.45,.65,.28,0x6f7963,-.15,.07,-.36,true,g);\n const limbs={};for(const [name,x,y,w,h,col] of [['armL',-.47,.23,.2,.65,0xe88652],['armR',.47,.23,.2,.65,0xe88652],['legL',-.19,-.53,.23,.65,0x334e50],['legR',.19,-.53,.23,.65,0x334e50]]){const pivot=new THREE.Group();pivot.name=name;pivot.position.set(x,y,0);g.add(pivot);box(w,h,.27,col,0,-h*.37,0,true,pivot);if(name.startsWith('leg'))box(.3,.18,.45,0x4d3830,.035,-h*.8,.05,true,pivot);else sphere(.12,0xf2c68b,0,-h*.8,0,pivot);limbs[name]=pivot;}\n const mixer=new THREE.AnimationMixer(g);const T=THREE.NumberKeyframeTrack;const tracks=[];for(const [name,sign] of [['armL',1],['armR',-1],['legL',-1],['legR',1]])tracks.push(new T(name+'.rotation[z]',[0,.2,.4,.6,.8],[0,.65*sign,0,-.65*sign,0]));const walk=mixer.clipAction(new THREE.AnimationClip('expedition-stride',.8,tracks));walk.play();const float=mixer.clipAction(new THREE.AnimationClip('river-kick',1,[new T('armL.rotation[z]',[0,.5,1],[1.4,-.3,1.4]),new T('armR.rotation[z]',[0,.5,1],[-1.4,.3,-1.4])]));float.play();float.setEffectiveWeight(0);return{g,mixer,walk,float,limbs};}\nfunction createPlayer(id,color){const visual=makeExplorer(color);scene.add(visual.g);const body=world.createRigidBody(RAPIER.RigidBodyDesc.kinematicPositionBased().setTranslation(8,4.02,0));const col=world.createCollider(RAPIER.ColliderDesc.capsule(.42,.32),body);const cc=world.createCharacterController(.025);cc.enableAutostep(.25,.25,true);cc.enableSnapToGround(.25);const p={id,...visual,body,col,cc,x:8,y:4.02,vx:0,vy:0,grounded:false,facing:1,health:3,invuln:0,ladder:false,swimming:false,balloon:false,balloonId:-1,checkpoint:{x:8,y:4.02},coyote:0,jumpHeld:false,actionHeld:false,remote:false};players.push(p);return p;}\nfunction createWorld(){scene.add(new THREE.HemisphereLight(0xf7e6bf,0x26575b,2.7));const sun=new THREE.DirectionalLight(0xffdaa0,3.3);sun.position.set(-8,28,23);scene.add(sun);const fill=new THREE.DirectionalLight(0x7bc4c0,1);fill.position.set(30,-20,10);scene.add(fill);\n ground(-10,21,3,-2);ground(10,25,-12,-17);ground(30,49,-12,-17);ground(27,28.8,-10.5,-11.2);ground(34,48,-27,-40);ground(48,78,-38,-43,0x356b6c);ground(78,97,-27,-40);ground(64,97,-5,-9);ground(60,63,-1,-2);ground(34,59,3,-1);\n // Layered distant cliff silhouettes, lit mineral strata and old arches.\n for(let layer=0;layer<3;layer++){for(let x=-25;x<120;x+=6){const h=10+rnd()*30;box(7,h,2,layer===0?0x174850:layer===1?0x20555a:0x315d59,x,-18+rnd()*15,-12-layer*9);for(let j=0;j<3;j++)mesh(new THREE.ConeGeometry(2+rnd()*3,5+rnd()*8,5),0x1a444c,x+rnd()*4,-35+j*16,-10-layer*8);}}\n for(let i=0;i<80;i++){const x=-8+rnd()*110,y=8-rnd()*52;const p=sphere(.025+rnd()*.04,i%3?0x97dbac:0xf3c780,x,y,2+rnd()*6,worldRoot);motes.push({m:p,x,y,seed:rnd()*10});}\n for(const l of ladders){for(const dx of [-.48,.48])box(.12,l.top-l.bottom+.8,.18,0x8f6542,l.x+dx,(l.top+l.bottom)/2,.2,true);for(let y=l.bottom;y<l.top+.4;y+=.6)box(1.1,.13,.22,0xe1b87d,l.x,y,.35,true);}\n for(let x=-5;x<19;x+=2.5){const h=6+rnd()*4;box(.55,h,.8,0x214a44,x,3+h/2,-5);for(let j=0;j<4;j++){const a=j*1.6+rnd();const leaf=mesh(new THREE.SphereGeometry(1.7,7,5),j%2?0x347c60:0x28674f,x+Math.cos(a)*2,3+h+Math.sin(a),-5);leaf.scale.set(2,.5,1);}}\n for(let i=0;i<33;i++){const x=11+rnd()*85,y=-7-rnd()*26;const m=mesh(new THREE.ConeGeometry(.18+rnd()*.5,1+rnd()*2,5),i%2?0x30676a:0x2b585b,x,y,-3-rnd()*4);if(i%2)m.rotation.z=Math.PI;}\n // Cascading underground spring, deliberately behind the traversable river.\n const waterMat=new THREE.MeshBasicNodeMaterial({color:0x64cabc,transparent:true,opacity:.26,depthWrite:false});const river=new THREE.Mesh(new THREE.BoxGeometry(30,11,2.5),waterMat);river.position.set(63,-32.5,-.25);worldRoot.add(river);line([[48,-27,1.2],[78,-27,1.2]],0x95e8d2);for(let i=0;i<11;i++){const m=new THREE.Mesh(new THREE.PlaneGeometry(.08+rnd()*.12,12),waterMat);m.position.set(52+rnd()*4,-20,-2.8);worldRoot.add(m);animated.push({type:'waterfall',m,seed:rnd()*8});}\n for(let i=0;i<18;i++){const x=49+rnd()*28;fern(x,-37.8,.6,.6);crystal(x,-37.5,-1,.25,0x72d0cb);}\n // Camp: striped canvas tent, rope lines, kettle, crates and a real lantern.\n const tent=new THREE.Group();tent.position.set(4,3,-1.2);worldRoot.add(tent);const tgeo=new THREE.ConeGeometry(2.1,2.8,4,1,true);const t=mesh(tgeo,0xe5b968,0,1.4,0,true,tent);t.rotation.y=Math.PI/4;box(1.1,1.3,.08,palette.ink,0,.65,1.45,false,tent);line([[-2.7,0,1],[0,2.8,0],[2.7,0,1]],0xead29b,tent);box(1,.9,.8,0x9c6844,7,3.45,-1.1,true);box(.9,.8,.85,0xbd8753,8,3.4,-1.4,true);textSprite('CAMP DAYLIGHT',5,6.9,-.5,1.1);textSprite('THE UNDERSTORY',30,-4,-5,1.5,'#78a998');\n for(const [x,y,name] of [[8,3,'DAYLIGHT CAMP'],[34,-12,'FERN GALLERY'],[45,-27,'RIVER LANTERN'],[81,-27,'BALLOON DOCK'],[88,-5,'SUNLIT LEDGE']]){const g=new THREE.Group();g.position.set(x,y,0);worldRoot.add(g);box(.15,2,.15,0x674c3c,0,1,-.6,true,g);box(.55,.65,.4,0xf4cc6a,0,1.8,-.6,true,g);box(.7,.12,.55,0x244d4b,0,2.18,-.6,true,g);const halo=sphere(.5,0xffd480,0,1.8,-.6,g);halo.material=new THREE.MeshBasicNodeMaterial({color:0xffd88e,transparent:true,opacity:.12,depthWrite:false});checkpoints.push({x,y:y+1.02,name,g,active:false});}\n const companions=[['PIP',44,-10.99,0x78bd9d,'That frog has my lunch. You may keep the frog.'],['NIBS',73,-35,0xc5a27b,'Blub-biddle\"'! My whiskers are absolutely waterlogged.'\"'],['PROFESSOR FERN',65,-3.99,0xc8a2c8,'A magnificent discovery\"'! Now let us discover the way home.'\"']];\n for(const [name,x,y,col,speech]of companions){const g=new THREE.Group();g.position.set(x,y,0);worldRoot.add(g);if(name==='NIBS'){sphere(.38,col,0,-.22,0,g,1.5,.8,1);sphere(.27,col,.36,.04,0,g);sphere(.06,palette.ink,.49,.09,.21,g);const tail=box(.6,.12,.18,col,-.65,-.22,0,true,g);tail.rotation.z=.35;}else{const v=makeExplorer(col);g.add(v.g);v.g.scale.setScalar(name==='PIP'?.72:.85);animated.push({type:'companion',v});}const badge=crystal(x,y+2,0,.28,palette.gold);const label=textSprite(name,x,y+2.7,0,.65);rescues.push({name,x,y,speech,g,badge,label,collected:false});}\n const goldPositions=[[12,4.2],[17,-3],[17,-8],[22,-10.8],[27.9,-8.6],[32,-10.7],[39,-10.8],[46,-17],[47,-22],[52,-28.5],[58,-32],[65,-35],[70,-36],[76,-33],[80,-25.8],[86,-21],[86,-15],[86,-9],[90,-3.8],[76,-3.8],[65,-2],[61,.5],[55,4.3],[44,4.3],[36,4.3]];\n goldPositions.forEach(([x,y],i)=>{const m=mesh(new THREE.CylinderGeometry(.27,.27,.1,10),palette.gold,x,y,.1,true);m.rotation.x=Math.PI/2;const rim=mesh(new THREE.TorusGeometry(.18,.035,4,12),0xe49a43,0,0,.07,false,m);coins.push({x,y,m,collected:false,id:i});});\n for(const [type,x,y,r]of [['frog',23,-11.5,2],['frog',39,-11.5,2.7],['bat',33,-8,4],['bat',43,-19,4],['eel',59,-31,4],['eel',70,-34,4],['bat',76,-2,3],['frog',51,3.5,3]]){const g=new THREE.Group();worldRoot.add(g);if(type==='frog'){sphere(.32,0x9eb855,0,0,0,g,1.4,.8,1);for(const dx of [-.22,.22]){sphere(.15,0xc9d977,dx,.23,.05,g);sphere(.055,palette.ink,dx,.26,.18,g);}box(.6,.08,.1,0x536447,0,-.03,.3,false,g);}else if(type==='bat'){sphere(.25,0x9b7291,0,0,0,g);for(const sign of [-1,1]){const wing=mesh(new THREE.ConeGeometry(.4,.9,3),0xa582a2,sign*.45,.05,0,true,g);wing.rotation.z=sign*Math.PI/2;wing.name='wing'+sign;}sphere(.06,palette.gold,.1,.08,.2,g);}else{sphere(.3,0xdd9a68,0,0,0,g,2.5,.7,.7);sphere(.06,palette.ink,.57,.1,.18,g);mesh(new THREE.ConeGeometry(.3,.5,3),0xdbbb82,-.75,0,0,true,g).rotation.z=Math.PI/2;}hazards.push({type,x,y,r,g,px:x,py:y,phase:rnd()*6});}\n for(let i=0;i<3;i++){const g=new THREE.Group();worldRoot.add(g);sphere(1.05,i%2?0xdd855e:0xeeb65e,0,2.3,0,g,1,1.25,.75);for(let j=0;j<5;j++){const a=j*Math.PI*2/5;line([[Math.cos(a)*.7,1.5,.3],[Math.cos(a)*.35,0,.3]],0xecd39e,g);}box(.85,.6,.7,0x9b6b42,0,-.1,0,true,g);box(1,.1,.8,0xd9ad6a,0,.2,0,true,g);balloons.push({g,x:86,y:-26+i*11,phase:i*11});}\n textSprite('↓  FERN GALLERY',17,.4,1,.65);textSprite('THE LONG WAY DOWN',37,-7,-3,.9,'#88a8a0');textSprite('UNDERGROUND RIVER',63,-23,-3,1,'#9ed7c5');textSprite('↑  BALLOON CHIMNEY',88,-12,-3,.85,'#e7bd82');textSprite('HOMEWARD BOUND',47,8,-4,1,'#b2bd91');\n // Repeating rope supports for the bridge that becomes available after all rescues.\n createBridge(false);\n}\nlet bridgeMeshes=[];let bridgeCollider=null;\nfunction createBridge(open){for(const m of bridgeMeshes)worldRoot.remove(m);bridgeMeshes=[];if(bridgeCollider){world.removeCollider(bridgeCollider,true);bridgeCollider=null;}if(\"'!open){const sign=textSprite('\"'BRIDGE RAISED',21,5.8,0,.65);bridgeMeshes.push(sign);return;}\n for(let x=21;x<34;x+=.65){const b=box(.56,.18,2,palette.ochre,x,3,-.2,true);bridgeMeshes.push(b);}for(const z of [-1,1]){bridgeMeshes.push(line([[20,4.5,z],[27,3.8,z],[34,4.5,z]],0xe3cb91));for(let x=21;x<34;x+=1.4)bridgeMeshes.push(line([[x,3,z],[x,4.1,z]],0xc19862));}bridgeCollider=world.createCollider(RAPIER.ColliderDesc.cuboid(7,.15,1.8).setTranslation(27,2.93,0));}\nfunction getArea(p){if(p.y>-2&&p.x<23)return'Daylight camp';if(p.y<-26)return p.x>78?'Balloon dock':'Underground river';if(p.x>78)return'Balloon chimney';if(p.y>-9&&p.x>54)return'Sunlit ledge';if(p.y>-2)return'Homeward ridge';return'Fern gallery';}\nfunction localPlayer(){return players.find(p=>p.id===localId)||players[0];}\nfunction setInputMode(v){if(lastInput\"'!==v){lastInput=v;ui.setInput(v,settings.glyphs);}}\nfunction userActivity(){titleIdle=0;if(mode==='\"'attract'){mode='title';ui.show('title');resetGame(false);audio.setMode('title');}}\nfunction jumpPressed(){jumpQueue=true;userActivity();}\nfunction interactPressed(){actionQueue=true;userActivity();}\nfunction saveSettings(){try{localStorage.setItem('understory-settings',JSON.stringify(settings));}catch{}}\nfunction begin(){resetGame(true);mode='playing';ui.show('playing');audio.unlock();audio.setMode('playing');ui.toast('A good hat. A long way down.','Find Pip, Nibs and Professor Fern. Then return to camp.');}\nfunction resetGame(full=true){won=false;score=0;elapsed=0;checkpointIndex=0;bridgeOpen=false;createBridge(false);mapVisited=new Set(['Daylight camp']);for(const c of coins){c.collected=false;c.m.visible=true;}for(const r of rescues){r.collected=false;r.g.visible=r.badge.visible=r.label.visible=true;}checkpoints.forEach(c=>c.active=false);for(const p of players){p.x=8;p.y=4.02;p.vy=p.vx=0;p.health=3;p.invuln=0;p.balloon=false;p.checkpoint={x:8,y:4.02};p.body.setTranslation({x:p.x,y:p.y,z:0},true);}if(full)for(const k in stats)stats[k]=0;}\nfunction teleport(p,x,y){p.x=x;p.y=y;p.vx=p.vy=0;p.balloon=false;p.body.setTranslation({x,y,z:0},true);p.body.setNextKinematicTranslation({x,y,z:0});p.g.position.set(x,y,0);}\nfunction hurt(p){if(p.invuln>0||invincible||settings.assist||mode==='attract')return;p.health--;p.invuln=2;stats.hits++;score=Math.max(0,score-100);audio.sfx('hurt');burst(p.x,p.y,0xeb8058,14);if(p.health<=0){p.health=3;teleport(p,p.checkpoint.x,p.checkpoint.y);ui.toast('A small setback. A splendid hat.','Back to the last lantern. Your friends and finds are safe.');}else{p.vy=6;p.vx=-p.facing*3;} }\nconst particles=[];function burst(x,y,c,count=12){for(let i=0;i<count;i++){const m=sphere(.05+rnd()*.05,c,x,y,1);particles.push({m,vx:(rnd()-.5)*5,vy:rnd()*6,life:.6+rnd()*.7});}}\nfunction updatePlayer(p,inp,dt){const wasWater=p.swimming;const water=waters.find(w=>p.x>w.x0+.1&&p.x<w.x1-.1&&p.y<w.top-.15&&p.y>w.bottom-.5);p.swimming=\"'!!water;p.invuln=Math.max(0,p.invuln-dt);const jumped=inp.jump&&!p.jumpHeld,acted=inp.action&&!p.actionHeld;p.jumpHeld=inp.jump;p.actionHeld=inp.action;\n const ladder=ladders.find(l=>Math.abs(p.x-l.x)<.82&&p.y<l.top+1.6&&p.y>l.bottom-.4);p.ladder=!!ladder&&(inp.up||inp.down||p.ladder&&Math.abs(p.x-ladder.x)<.65&&!inp.left&&!inp.right);if(p.ladder&&jumped)p.ladder=false;\n if(!wasWater&&water){audio.sfx('\"'splash');burst(p.x,-27,0x9fe4d3,12);stats.swims++;}if(p.swimming)stats.swims+=dt;\n if(p.balloon){const b=balloons[p.balloonId];if(\"'!b){p.balloon=false;}else{teleportInBalloon(p,b.x,b.y+.65);if(jumped||inp.down||acted||Math.abs(inp.left?1:inp.right?1:0)>0&&p.y>1){p.balloon=false;p.vy=jumped?7:2;p.x+=(inp.left?-1:inp.right?1:0)*.75;audio.sfx('\"'jump');}else{p.g.position.set(p.x,p.y,0);return;}}}\n if((acted||inp.up||settings.assist&&p.x>82)&&\"'!p.balloon){let nearest=balloons.findIndex(b=>Math.hypot(p.x-b.x,p.y-(b.y+.65))<2.1);if(nearest>=0){p.balloon=true;p.balloonId=nearest;p.ladder=false;stats.balloons++;audio.sfx('\"'balloon');ui.toast('Up, up, and mind the stalactites.','Move sideways or jump near the top to dismount.');}}\n let vx=((inp.right?1:0)-(inp.left?1:0))*(p.swimming?cfg.swim:cfg.speed);if(vx){p.facing=Math.sign(vx);stats.steps+=dt;}p.vx=lerp(p.vx,vx,Math.min(1,dt*(p.swimming?6:16)));\n if(p.swimming){p.vy=lerp(p.vy,((inp.up||inp.jump?1:0)-(inp.down?1:0))*cfg.swim+(settings.assist?.6:0),dt*6);p.ladder=false;}else if(p.ladder){p.x=lerp(p.x,ladder.x,dt*13);p.vx=0;p.vy=((inp.up?1:0)-(inp.down?1:0))*3.8;stats.ladders+=dt;}else{p.vy-=cfg.gravity*dt;p.coyote=p.grounded?.12:Math.max(0,p.coyote-dt);if(jumped&&p.coyote>0){p.vy=cfg.jump;p.coyote=0;stats.jumps++;audio.sfx('jump');}if(\"'!inp.jump&&p.vy>4)p.vy-=cfg.gravity*.8*dt;}\n // Water surface boost lets the explorer climb both riverbanks without a separate action.\n if(p.swimming&&p.y>-28&&(inp.up||inp.jump)){p.vy=7.5;if(p.x>76.8&&inp.right)p.vy=10;if(p.x<49.1&&inp.left)p.vy=10;}\n const movement={x:p.vx*dt,y:p.vy*dt,z:0};p.cc.computeColliderMovement(p.col,movement,RAPIER.QueryFilterFlags.EXCLUDE_DYNAMIC,undefined,c=>c.parent()!==p.body&&!players.some(q=>q!==p&&q.col.handle===c.handle));const corrected=p.cc.computedMovement();const pos=p.body.translation();p.x=clamp(pos.x+corrected.x,-8,96);p.y=pos.y+corrected.y;p.grounded=p.cc.computedGrounded();if(p.grounded&&p.vy<0)p.vy=0;p.body.setNextKinematicTranslation({x:p.x,y:p.y,z:0});\n if(p.y<-44){p.health=3;teleport(p,p.checkpoint.x,p.checkpoint.y);audio.sfx('\"'hurt');stats.hits++;}\n p.g.position.set(p.x,p.y,0);p.g.rotation.y=lerp(p.g.rotation.y,p.facing===1?.3:-.3,dt*10);p.g.rotation.z=lerp(p.g.rotation.z,p.swimming?-p.facing*.6:0,dt*8);p.g.visible=p.invuln<=0||Math.floor(p.invuln*12)%2===0;p.mixer.update(dt*Math.max(.2,Math.abs(p.vx)/4));p.walk.setEffectiveWeight(p.swimming?0:Math.min(1,Math.abs(p.vx)/2));p.float.setEffectiveWeight(p.swimming?1:p.ladder?.7:0);\n for(let i=0;i<checkpoints.length;i++){const c=checkpoints[i];if(Math.abs(p.x-c.x)<1.2&&Math.abs(p.y-c.y)<1.8&&\"'!c.active){c.active=true;checkpointIndex=i;p.checkpoint={x:c.x,y:c.y};p.health=3;stats.checkpoints++;audio.sfx('\"'checkpoint');burst(c.x,c.y+1,palette.gold);ui.toast(c.name,'Lantern lit · progress kept · hearts restored');}}\n for(const c of coins){if(\"'!c.collected&&Math.hypot(p.x-c.x,p.y-c.y)<1.05){c.collected=true;c.m.visible=false;score+=100;stats.coins++;audio.sfx('\"'coin');burst(c.x,c.y,palette.gold,7);}}\n for(const r of rescues){if(\"'!r.collected&&Math.hypot(p.x-r.x,p.y-r.y)<1.4){r.collected=true;r.g.visible=r.badge.visible=r.label.visible=false;score+=1000;stats.rescues++;audio.sfx('\"'rescue');audio.voice(r.name.length*23);burst(r.x,r.y,palette.mint,22);ui.toast(r.name+' FOUND\"'!'\"',r.speech);if(rescues.every(q=>q.collected)){bridgeOpen=true;createBridge(true);ui.toast('All together now.','The homeward bridge is down. Meet everyone at Daylight Camp.');}}}\n for(const h of hazards)if(Math.hypot(p.x-h.px,p.y-h.py)<(h.type==='eel'?.8:.65)+.25)hurt(p);\n const area=getArea(p);mapVisited.add(area);\n if(rescues.every(r=>r.collected)&&p.x<11&&p.y>3&&\"'!won)victory();}\nfunction teleportInBalloon(p,x,y){p.x=x;p.y=y;p.vx=p.vy=0;p.body.setTranslation({x,y,z:0},true);p.body.setNextKinematicTranslation({x,y,z:0});p.g.position.set(x,y,0);p.mixer.update(1/60);}\nfunction victory(){won=true;mode='\"'victory';audio.sfx('win');audio.setMode('victory');const net=window.CavernNet;net?.finish({won:true,score});ui.show('victory',{score,gold:coins.filter(c=>c.collected).length,totalGold:coins.length,time:Math.floor(elapsed),rescued:3});}\nfunction updateWorld(dt){time+=dt;for(const c of coins)if(\"'!c.collected){c.m.rotation.y+=dt*1.8;c.m.position.y=c.y+Math.sin(time*2+c.x)*.08;}for(const r of rescues)if(!r.collected){r.badge.rotation.y+=dt;r.badge.position.y=r.y+2+Math.sin(time*2)*.16;}\n for(const b of balloons){b.y=-27+((time*2.5+b.phase)%35);b.g.position.set(b.x+Math.sin(time*.5+b.phase)*.16,b.y,0);b.x=b.g.position.x;}\n for(const h of hazards){h.px=h.x+Math.sin(time*cfg.hazard*(h.type==='\"'bat'?1.2:.7)+h.phase)*h.r;h.py=h.y+(h.type==='bat'?Math.sin(time*1.5+h.phase)*1.2:h.type==='frog'?Math.max(0,Math.sin(time*2+h.phase))*.6:Math.sin(time+h.phase)*.3);h.g.position.set(h.px,h.py,0);h.g.rotation.y=Math.cos(time+h.phase)>0?.2:Math.PI-.2;if(h.type==='bat')for(const s of [-1,1])h.g.getObjectByName('wing'+s).rotation.y=Math.sin(time*12)*.55;}\n for(const m of motes){m.m.position.x=m.x+Math.sin(time*.25+m.seed)*.8;m.m.position.y=m.y+Math.sin(time*.5+m.seed)*.5;}\n for(const a of animated)if(a.type==='companion'){a.v.mixer.update(dt*.25);}else if(a.type==='waterfall')a.m.material.opacity=.16+Math.sin(time+a.seed)*.07;\n for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.life-=dt;p.vy-=7*dt;p.m.position.x+=p.vx*dt;p.m.position.y+=p.vy*dt;p.m.scale.setScalar(Math.max(.01,p.life));if(p.life<=0){worldRoot.remove(p.m);p.m.geometry.dispose();particles.splice(i,1);}}\n}\nfunction pollPad(dt){const pads=navigator.getGamepads?.()||[];const pad=Array.from(pads).find(p=>p&&p.connected);if(\"'!pad)return null;const active=pad.axes.some(a=>Math.abs(a)>.2)||pad.buttons.some(b=>b.pressed);if(active){setInputMode('\"'gamepad');userActivity();}const bs=pad.buttons.map(b=>b.pressed);if(bs[9]&&\"'!lastPadButtons[9])handleAction(mode==='\"'playing'?'pause':'back');if(bs[8]&&\"'!lastPadButtons[8]&&mode==='\"'playing')handleAction('map');if(ui.screen\"'!=='\"'playing'&&mode\"'!=='\"'attract'&&mode\"'!=='\"'loading')ui.handlePad(pad,dt);lastPadButtons=bs;return{left:pad.axes[0]<-.2||bs[14],right:pad.axes[0]>.2||bs[15],up:pad.axes[1]<-.3||bs[12],down:pad.axes[1]>.3||bs[13],jump:bs[0]||bs[1],action:bs[2]||bs[3]};}\nconst touch={active:new Map(),left:false,right:false,up:false,down:false,jump:false};\nfunction getInput(pad){return{left:keys.has('ArrowLeft')||keys.has('KeyA')||touch.left||pad?.left||false,right:keys.has('ArrowRight')||keys.has('KeyD')||touch.right||pad?.right||false,up:keys.has('ArrowUp')||keys.has('KeyW')||touch.up||pad?.up||false,down:keys.has('ArrowDown')||keys.has('KeyS')||touch.down||pad?.down||false,jump:keys.has('Space')||jumpQueue||touch.jump||pad?.jump||false,action:keys.has('KeyE')||actionQueue||pad?.action||false};}\nfunction frame(t){requestAnimationFrame(frame);if(\"'!ready)return;const dt=Math.min(.05,(t-lastFrame)/1000||.016);lastFrame=t;stats.frames++;const pad=pollPad(dt);const inp=getInput(pad);audio.tick(dt);const net=window.CavernNet;const status=net?.status()||{isHost:true,active:false};\n if(mode==='\"'title'){titleIdle+=dt;if(titleIdle>=10){resetGame(false);mode='attract';attractTime=0;ui.show('attract');audio.setMode('attract');}}\n if(mode==='attract'){attractTime+=dt;const duration=70;const total=(attractTime%duration)/duration*(route.length-1);const i=Math.floor(total),f=total-i;const a=route[i],b=route[Math.min(i+1,route.length-1)];const p=localPlayer();if(p){teleport(p,lerp(a.x,b.x,f),lerp(a.y,b.y,f)+Math.sin(f*Math.PI)*((i===3||i===16)?1.2:0));p.mixer.update(dt);p.facing=b.x>=a.x?1:-1;p.g.rotation.y=p.facing*.3;p.walk.setEffectiveWeight(.8);}if(i>6)rescues[0].g.visible=false;if(i>10)rescues[1].g.visible=false;if(i>16)rescues[2].g.visible=false;}\n const running=mode==='playing'&&(\"'!status.active||status.started)&&(!status.active||net.time?.()>=0||!net.time);if(running){elapsed+=dt;if(status.isHost){accumulator+=dt;let n=0;while(accumulator>=1/60&&n++<4){updateWorld(1/60);for(const p of players){const pi=p.id===localId?inp:(cachedRemoteInput[p.id]||{});updatePlayer(p,pi,1/60);}world.timestep=1/60;world.step();accumulator-=1/60;}networkTick+=dt;if(networkTick>.05){networkTick=0;if(status.connected)net.sendState(snapshot());}}else net.sendInput(inp);jumpQueue=actionQueue=false;}\n if(!running)updateWorld(dt*(mode==='\"'paused'?0:1));\n updateCamera(dt);updateHUD();renderer.render(scene,camera);}\nconst camTarget=new THREE.Vector3(10,1,0);function updateCamera(dt){const p=localPlayer();let x=p?.x||8,y=p?.y||4;if(mode==='title'||mode==='loading'){x=11;y=-1.3;}if(mode==='victory'){x=7;y=4;}const k=settings.reducedMotion?1:1-Math.exp(-dt*4);camTarget.x=lerp(camTarget.x,x+(mode==='title'?3:p?.facing*2||0),k);camTarget.y=lerp(camTarget.y,y+1.5,k);const h=cfg.camera,aspect=innerWidth/innerHeight;camera.left=-h*aspect/2;camera.right=h*aspect/2;camera.top=h/2;camera.bottom=-h/2;camera.position.set(camTarget.x,camTarget.y+2.7,36);camera.lookAt(camTarget.x,camTarget.y,0);camera.updateProjectionMatrix();}\nfunction contextual(p){if(\"'!p)return'\"'';if(p.balloon)return'Jump or move sideways to dismount';if(p.swimming)return'↑ / ↓ Swim · Jump to surface';if(ladders.some(l=>Math.abs(p.x-l.x)<1.2&&p.y<l.top+2&&p.y>l.bottom-1))return'↑ / ↓ Climb the ladder';if(balloons.some(b=>Math.hypot(p.x-b.x,p.y-b.y)<3))return'E · Catch a balloon';if(p.x<21&&p.y>1&&rescues.some(r=>\"'!r.collected))return'\"'Head right. The first ladder leads down.';return'';}\nfunction updateHUD(){const p=localPlayer();if(\"'!p)return;const count=rescues.filter(r=>r.collected).length;const area=getArea(p);audio.setZone(p.swimming?'\"'water':p.balloon?'balloon':p.y<-15?'deep':'gallery');ui.updateHUD({score,gold:coins.filter(c=>c.collected).length,totalGold:coins.length,rescued:count,hearts:p.health,area,objective:count<3?'Find your three lost companions':'Bring everyone back to camp',prompt:contextual(p),mode,coop:players.length>1?'CO-OP EXPEDITION':'',checkpoint:checkpoints[checkpointIndex]?.name,oxygen:1});}\nfunction snapshot(){return{players:players.map(p=>({id:p.id,x:p.x,y:p.y,vx:p.vx,vy:p.vy,health:p.health,swimming:p.swimming,balloon:p.balloon,facing:p.facing})),coins:coins.map(c=>c.collected),rescues:rescues.map(r=>r.collected),score,bridgeOpen,elapsed,won,mode,checkpoints:checkpoints.map(c=>c.active),time};}\nfunction applySnapshot(s){lastState=s;if(\"'!s||!s.players)return;for(const d of s.players){let p=players.find(p=>p.id===d.id)||createPlayer(d.id,d.id===localId?0xe88652:0x71bbb1);Object.assign(p,d);p.g.position.set(p.x,p.y,0);p.g.rotation.y=p.facing*.3;p.mixer.update(.06);p.walk.setEffectiveWeight(Math.abs(p.vx)/6);p.float.setEffectiveWeight(p.swimming?1:0);}s.coins.forEach((v,i)=>{coins[i].collected=v;coins[i].m.visible=!v;});s.rescues.forEach((v,i)=>{rescues[i].collected=v;rescues[i].g.visible=rescues[i].badge.visible=rescues[i].label.visible=!v;});score=s.score;elapsed=s.elapsed;if(s.bridgeOpen&&!bridgeOpen){bridgeOpen=true;createBridge(true);}if(s.won&&!won){won=true;mode='\"'victory';ui.show('victory',{score,gold:s.coins.filter(Boolean).length,totalGold:coins.length,time:Math.floor(elapsed),rescued:3});}}\nfunction configureNet(){const net=window.CavernNet;if(\"'!net)return;const sync=()=>{const s=net.status();if(s.active||s.connected){localId=s.me;const ids=s.players.map(p=>p.id);for(const id of ids)if(!players.some(p=>p.id===id))createPlayer(id,id===localId?0xe88652:0x71bbb1);for(const p of [...players])if(!ids.includes(p.id)){scene.remove(p.g);world.removeRigidBody(p.body);players.splice(players.indexOf(p),1);}if(!players.length&&!s.server)createPlayer(localId,0xe88652);}ui.setStatus(`${s.transport.toUpperCase()} · ${s.players.length} EXPLORER${s.players.length===1?'\"'':'S'} · \"'${s.role}`);};net.onChange(sync);net.onStart(()=>{sync();begin();});net.onState(applySnapshot);net.onInput((inp,id)=>{cachedRemoteInput[id]=inp;});net.onTimeUp(()=>{if(!won){mode='\"'victory';ui.show('victory',{score,gold:coins.filter(c=>c.collected).length,totalGold:coins.length,time:Math.floor(elapsed),rescued:rescues.filter(r=>r.collected).length});net.finish({won:false,score});}});net.onLeave(()=>{mode='title';ui.show('title');});sync();}\nfunction mapSVG(){const paths=platforms.map(p=>\"'`<rect x=\"${(p.x0+12)*5}\" y=\"${(6-p.top)*4}\" width=\"${(p.x1-p.x0)*5}\" height=\"5\" fill=\"#c9a879\"/>`).join('\"'');const ls=ladders.map(l=>\"'`<path d=\"M${(l.x+12)*5},${(6-l.top)*4}V${(6-l.bottom)*4}\" stroke=\"#ffd174\" stroke-width=\"4\" stroke-dasharray=\"2 3\"/>`).join('\"'');const rs=rescues.map(r=>\"'`<circle cx=\"${(r.x+12)*5}\" cy=\"${(6-r.y)*4}\" r=\"6\" fill=\"${r.collected?'\"'#79ddbc':'#ee7444'}\\\"/><text x=\\\"\"'${(r.x+12)*5}\" y=\"${(6-r.y)*4-12}\" text-anchor=\"middle\" fill=\"#f4e6bf\" font-size=\"11\">${r.name}</text>`).join('\"'');const p=localPlayer();return\"'`<svg viewBox=\"0 0 570 225\" role=\"img\" aria-label=\"Cavern field map\"><rect width=\"570\" height=\"225\" rx=\"12\" fill=\"#103a40\"/><rect x=\"300\" y=\"132\" width=\"150\" height=\"44\" fill=\"#267f93\"/>${paths}${ls}${rs}<path d=\"M490 128 V6\" stroke=\"#eeb65e\" stroke-width=\"3\" stroke-dasharray=\"7 5\"/><circle cx=\"${(p.x+12)*5}\" cy=\"${(6-p.y)*4}\" r=\"6\" fill=\"#fff3c9\" stroke=\"#ee7444\" stroke-width=\"3\"/><text x=\"80\" y=\"10\" fill=\"#f4e6bf\" font-size=\"11\">DAYLIGHT CAMP</text><text x=\"310\" y=\"205\" fill=\"#79ddbc\" font-size=\"11\">RIVER · no breath limit</text></svg>`;}\nasync function handleAction(action,value){userActivity();audio.sfx('\"'ui');if(action==='start'||action==='restart'||action==='playAgain'){begin();return;}if(action==='pause'){if(mode==='playing'){mode='paused';ui.show('pause');}return;}if(action==='resume'){mode='playing';ui.show('playing');return;}if(action==='back'){if(mode==='playing'){mode='paused';ui.show('pause');}else if(ui.screen==='pause'){mode='playing';ui.show('playing');}else{ui.show(mode==='title'?'title':'pause');}return;}if(action==='title'||action==='quit'){mode='title';ui.show('title');titleIdle=0;return;}if(action==='map'){if(mode==='playing')mode='paused';ui.show('map',{svg:mapSVG()});return;}if(action==='settings'||action==='about'||action==='dev'||action==='developer'||action==='coop'){if(mode==='playing')mode='paused';ui.show(action==='developer'?'dev':action,{settings,config:cfg,defaults,invincible});return;}\n if(action in settings){settings[action]=value;if(action==='music')audio.setMusicVolume(+value);if(action==='sfx')audio.setSfxVolume(+value);if(action==='glyphs')ui.setInput(lastInput,value);saveSettings();return;}\n if(action.startsWith('dev:')){const key=action.slice(4);if(key in cfg)cfg[key]=+value;else if(key==='reset'){Object.assign(cfg,defaults);invincible=false;ui.show('dev',{config:cfg,defaults,invincible});}else if(key==='god'||key==='invincible')invincible=\"'!!value;else if(key==='\"'heal'){localPlayer().health=3;}else if(key==='checkpoint')teleport(localPlayer(),localPlayer().checkpoint.x,localPlayer().checkpoint.y);else if(key==='teleport'){const pts={camp:[8,4.02],gallery:[34,-10.98],river:[60,-29],balloon:[85,-25.98],ledge:[88,-3.98]};const q=pts[value]||[8,4.02];teleport(localPlayer(),...q);}else if(key==='rescue'){rescues.forEach(r=>{r.collected=true;r.g.visible=r.badge.visible=r.label.visible=false;});bridgeOpen=true;createBridge(true);}return;}\n const net=window.CavernNet;if(action.startsWith('coop:'))try{if(action==='coop:host'){net.hostLocal('UNDERSTORY');ui.setStatus('Camp open. In another tab, select Join camp.');}if(action==='coop:join'){net.joinLocal('UNDERSTORY');ui.setStatus('Joining camp…');}if(action==='coop:solo'){net.solo();}if(action==='coop:offer'){const code=await net.makeOffer();const el=\"'$('\"'#networkCode');if(el)el.value=code;ui.setStatus('Send this offer to your companion.');}if(action==='coop:answer'){const code=await net.answerOffer(value||\"'$('\"'#networkCode')?.value);\"'$('\"'#networkCode').value=code;ui.setStatus('Send this answer back to the host.');}if(action==='coop:connect'){await net.acceptAnswer(value||\"'$('\"'#networkCode')?.value);ui.setStatus('Companion connected. Begin the expedition.');}if(action==='coop:copy'){await navigator.clipboard.writeText(\"'$('\"'#networkCode')?.value||'');ui.setStatus('Connection code copied.');}}catch(e){ui.setStatus(e.message);}}\naddEventListener('keydown',e=>{setInputMode('keyboard');userActivity();if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight'].includes(e.code)&&\"'!['\"'INPUT','SELECT','TEXTAREA'].includes(e.target.tagName))e.preventDefault();keys.add(e.code);if(e.repeat)return;if(e.code==='Escape'||e.code==='KeyP')handleAction('back');if(e.code==='KeyM'&&mode==='playing')handleAction('map');if(e.code==='Space'&&mode==='playing')jumpPressed();if(e.code==='KeyE')interactPressed();if(e.code==='KeyF2')handleAction('dev');});addEventListener('keyup',e=>keys.delete(e.code));addEventListener('blur',()=>{keys.clear();if(mode==='playing'&&\"'!window.CavernNet?.status().connected)handleAction('\"'pause');});addEventListener('pointermove',e=>{if(e.pointerType==='mouse')setInputMode('keyboard');});addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'){setInputMode('keyboard');userActivity();if(mode==='playing'&&e.target===renderer?.domElement){const p=localPlayer();if(balloons.some(b=>Math.hypot(p.x-b.x,p.y-b.y)<3))interactPressed();}}});\nfunction installTouch(){const surface=renderer.domElement;surface.style.touchAction='none';surface.addEventListener('pointerdown',e=>{if(e.pointerType\"'!=='\"'touch')return;setInputMode('touch');userActivity();if(mode\"'!=='\"'playing')return;e.preventDefault();surface.setPointerCapture(e.pointerId);touch.active.set(e.pointerId,{x:e.clientX,y:e.clientY,side:e.clientX<innerWidth*.58?'move':'jump'});if(e.clientX>=innerWidth*.58)touch.jump=true;});surface.addEventListener('pointermove',e=>{const t=touch.active.get(e.pointerId);if(\"'!t||t.side!=='\"'move')return;const dx=e.clientX-t.x,dy=e.clientY-t.y;touch.left=dx< -12;touch.right=dx>12;touch.up=dy< -15;touch.down=dy>15;});const end=e=>{const t=touch.active.get(e.pointerId);if(\"'!t)return;if(t.side==='\"'move')touch.left=touch.right=touch.up=touch.down=false;else touch.jump=false;touch.active.delete(e.pointerId);};surface.addEventListener('pointerup',end);surface.addEventListener('pointercancel',end);}\nasync function init(){try{ui.setLoading(.1,'Lighting the lanterns');await RAPIER.init();world=new RAPIER.World({x:0,y:0,z:0});renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.2;document.body.prepend(renderer.domElement);renderer.domElement.id='game';await renderer.init();ui.setLoading(.45,'Finding the way down');createWorld();createPlayer('solo',0xe88652);await window.CavernNet?.init();configureNet();audio.setMusicVolume(settings.music);audio.setSfxVolume(settings.sfx);ui.setInput('keyboard',settings.glyphs);installTouch();const hub=window.CavernNet?.status();mode=hub?.active?'playing':'title';ui.show(mode==='playing'?'playing':'title');ready=true;ui.setLoading(1,'Ready');await renderer.compileAsync(scene,camera);window.CavernNet?.ready();requestAnimationFrame(frame);}catch(e){console.error(e);document.body.innerHTML=\"'`<div style=\"padding:8vw;color:#f4e6bf;background:#103a40;font:24px Georgia\"><h1>A lantern needs relighting.</h1><p>${String(e.message).replace(/</g,'\"'&lt;')}</p><p>This expedition requires a browser with WebGPU. Open this file in current Chrome or Edge.</p><button onclick=\\\"location.reload()\\\" style=\\\"font-size:24px;padding:16px\\\">Try again</button></div>\"'`;window.__bootError=String(e.stack||e);}}\naddEventListener('\"'resize',()=>{renderer?.setSize(innerWidth,innerHeight);});\nwindow.__game={getState:()=>({ready,mode,score,elapsed,bridgeOpen,players:players.map(p=>({id:p.id,x:p.x,y:p.y,vx:p.vx,vy:p.vy,health:p.health,grounded:p.grounded,swimming:p.swimming,balloon:p.balloon,checkpoint:p.checkpoint})),rescued:rescues.map(r=>r.collected),gold:coins.filter(c=>c.collected).length,checkpoints:checkpoints.map(c=>c.active),stats:{...stats},config:{...cfg},settings:{...settings},input:{...getInput(null)},lastInput,net:window.CavernNet?.status(),renderer:renderer?.backend?.isWebGPUBackend?'WebGPU':'unknown',rapier:RAPIER.version(),three:THREE.REVISION}),action:handleAction,step:(n=1,inp={})=>{for(let i=0;i<n;i++){updateWorld(1/60);for(const p of players)updatePlayer(p,inp,1/60);world.timestep=1/60;world.step();}},teleport:(x,y)=>teleport(localPlayer(),x,y),setHealth:n=>{localPlayer().health=n;localPlayer().invuln=0;},setInput:(k,v)=>{v?keys.add(k):keys.delete(k);},hurt:()=>hurt(localPlayer()),audio:()=>audio.inspect(),audioUnlock:()=>audio.unlock(),setIdle:n=>titleIdle=n,snapshot,applySnapshot,mapSVG,getTime:()=>time};\ninit();\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"The cavern, character animation, audio, menus, and co-op layer are implemented. I’m now checking the expedition as a connected route—especially ladder exits, riverbanks, and balloon dismounts—before packaging it into the HTML.\n"}}
{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' ui.js && sed -n '1,140p' style.css && sed -n '1,100p' hub.js && cat hub-protocol.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' ui.js && sed -n '1,140p' style.css && sed -n '1,100p' hub.js && cat hub-protocol.md\"","aggregated_output":"const esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst QUESTIONS = {\n  testingFeedback: ['How many issues did testing catch?','How many were critical or game breaking?','What was the most helpful test?','What was the least helpful test?'],\n  engineFeedback: ['What did you like most about the engine?','Did you get stuck or guess wrong?','What was the most important thing you built yourself?','What was the hardest part about the engine?','What did you change in the engine, and why?','If you could change one thing about the engine?'],\n  promptFeedback: ['What did you like most about this prompt?','What was confusing?','What was the hardest thing to do?','What would you change in this prompt?']\n};\nconst DEFAULTS = { music: .1, sfx: .6, glyphs: 'playstation', assist: false, reducedMotion: false, speed: 6.2, gravity: 22, jump: 10.5, swim: 4.5, hazard: 1, camera: 22, god: false };\n\nexport class GameUI {\n  constructor(callbacks = {}, metadata = {}) {\n    this.callbacks = typeof callbacks === 'function' ? {onAction:callbacks} : callbacks;\n    this.metadata = metadata; this.settings = {...DEFAULTS}; this._screen = 'loading'; this.input = 'keyboard'; this.focusIndex = 0; this.padCooldown = 0; this.padButtons = []; this.aboutPage = 'guide'; this.payload = {}; this.hud = {};\n    this.root = document.createElement('div'); this.root.id = 'game-ui'; this.root.innerHTML = `<div class=\"ui-vignette\" aria-hidden=\"true\"></div><div id=\"hud\" hidden></div><button class=\"corner-menu\" aria-label=\"Pause game\" hidden>Ⅱ</button><main id=\"menu-screen\"></main><div id=\"toast\" role=\"status\" aria-live=\"polite\"></div><div id=\"network-status\" role=\"status\"></div><div id=\"input-hint\"></div><div id=\"loader\"><div class=\"loader-mark\">P<span>↓</span></div><p>UNFOLDING THE UNDERSTORY</p><div class=\"loader-track\"><i></i></div><small>Lighting the lanterns…</small></div>`; document.body.appendChild(this.root);\n    this.menu = this.root.querySelector('#menu-screen'); this.hudElement = this.root.querySelector('#hud'); this.pauseButton = this.root.querySelector('.corner-menu'); this.pauseButton.onclick = () => this.action('pause');\n    this.menu.addEventListener('click', e => { const button = e.target.closest('[data-action]'); if (button && !button.disabled) this.activate(button); });\n    this.menu.addEventListener('input', e => { const el = e.target; if (!el.dataset.setting) return; const value = el.type === 'checkbox' ? el.checked : el.type === 'range' ? Number(el.value) : el.value; this.settings[el.dataset.setting] = value; const out = el.closest('.setting-row')?.querySelector('output'); if(out) out.textContent = this.formatValue(el.dataset.setting,value); this.action(el.dataset.callback || el.dataset.setting,value); });\n    this.menu.addEventListener('change', e => { if (e.target.tagName === 'SELECT') e.target.dispatchEvent(new Event('input',{bubbles:true})); });\n    this.menu.addEventListener('pointermove', e => { const el = e.target.closest('button,input,select,textarea'); if (el && document.activeElement !== el) { el.focus({preventScroll:true}); this.focusIndex = this.focusables().indexOf(el); } });\n    document.addEventListener('keydown', e => this.key(e));\n    this.show('loading');\n  }\n  get screen(){ return this._screen; }\n  action(name,value) { this.callbacks.onAction?.(name,value); }\n  activate(el) { const a = el.dataset.action; if(a?.startsWith('about:')) {this.aboutPage=a.slice(6);this.render();return;} if(a==='coop:connect') this.action(a,this.menu.querySelector('#networkCode')?.value || ''); else if(a==='coop:join') this.action(a,this.menu.querySelector('#roomCode')?.value || ''); else this.action(a,el.dataset.value); }\n  show(screen,payload={}) { if(screen==='game'||screen==='playing'||screen==='play'||screen==='none') screen='game'; this._screen=screen; this.payload=payload; if(payload.settings) Object.assign(this.settings,payload.settings); if(payload.dev) Object.assign(this.settings,payload.dev); this.root.dataset.screen=screen; this.root.classList.toggle('in-game',screen==='game'||screen==='attract'); this.render(); }\n  setMetadata(metadata){this.metadata=metadata;if(this._screen==='about')this.render();}\n  setInput(mode,glyphStyle) { this.input=mode; if(glyphStyle)this.settings.glyphs=glyphStyle; this.root.dataset.input=mode; this.updateHints(); }\n  setStatus(text) { this.root.querySelector('#network-status').textContent=text || ''; }\n  setNetwork(data={}) { Object.assign(this.payload,data); const code=this.menu.querySelector('#networkCode'); if(code&&data.code!==undefined)code.value=data.code; const stat=this.menu.querySelector('.coop-status');if(stat&&data.status)stat.textContent=data.status;this.setStatus(data.status||''); }\n  setLoading(progress,message) { const loader=this.root.querySelector('#loader'); loader.hidden=progress>=1; loader.querySelector('i').style.width=`${Math.max(2,progress*100)}%`; if(message)loader.querySelector('small').textContent=message; }\n  focusables(){return [...this.menu.querySelectorAll('button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea:not([disabled]),[tabindex=\"0\"]')].filter(el=>el.offsetParent!==null);}\n  focus(index){const f=this.focusables();if(!f.length)return;this.focusIndex=(index+f.length)%f.length;f[this.focusIndex].focus({preventScroll:true});f[this.focusIndex].scrollIntoView({block:'nearest',behavior:'instant'});}\n  key(e){ if(this._screen==='game'||this._screen==='attract'||this._screen==='loading')return;const typing=['TEXTAREA','INPUT'].includes(e.target?.tagName)&&e.target.type!=='range'&&e.target.type!=='checkbox';if(typing&&e.key!=='Escape')return;\n    if(e.key==='Escape'||e.key==='Backspace'){e.preventDefault();this.action('back');return;}\n    if((e.key==='PageDown'||e.key==='PageUp')&&this.menu.querySelector('.about-content')){e.preventDefault();this.menu.querySelector('.about-content').scrollBy(0,(e.key==='PageDown'?1:-1)*250);return;}if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();this.focus(this.focusIndex+(e.key==='ArrowDown'?1:-1));}\n    else if((e.key==='ArrowLeft'||e.key==='ArrowRight')&&e.target?.type!=='range'&&e.target?.tagName!=='SELECT'){e.preventDefault();this.focus(this.focusIndex+(e.key==='ArrowRight'?1:-1));}\n    else if(e.key==='Enter'&&e.target?.tagName==='MAIN'){e.preventDefault();this.focus(0);}\n  }\n  handlePad(pad,dt=.016){if(!pad)return;this.padCooldown=Math.max(0,this.padCooldown-dt);const b=i=>!!pad.buttons?.[i]?.pressed;const pressed=i=>b(i)&&!this.padButtons[i];const menu=this._screen!=='game'&&this._screen!=='attract'&&this._screen!=='loading';if(menu){const scroll=this.menu.querySelector('.about-content');if(scroll){const scrollAxis=pad.axes?.[3]||0;const trigger=(pad.buttons?.[7]?.value||0)-(pad.buttons?.[6]?.value||0);if(Math.abs(scrollAxis)>.2||Math.abs(trigger)>.15)scroll.scrollTop+=(Math.abs(scrollAxis)>.2?scrollAxis:trigger)*dt*650;}let v=(b(13)?1:0)-(b(12)?1:0);if(Math.abs(pad.axes?.[1]||0)>.55)v=Math.sign(pad.axes[1]);let h=(b(15)?1:0)-(b(14)?1:0);if(Math.abs(pad.axes?.[0]||0)>.55)h=Math.sign(pad.axes[0]);if((v||h)&&!this.padCooldown){const el=document.activeElement;if(h&&el?.type==='range'){el.value=Number(el.value)+h*Number(el.step||1);el.dispatchEvent(new Event('input',{bubbles:true}));}else if(h&&el?.tagName==='SELECT'){el.selectedIndex=Math.max(0,Math.min(el.options.length-1,el.selectedIndex+h));el.dispatchEvent(new Event('input',{bubbles:true}));}else this.focus(this.focusIndex+(v||h));this.padCooldown=.18;}if(pressed(0)){const el=document.activeElement;if(el?.type==='checkbox'){el.checked=!el.checked;el.dispatchEvent(new Event('input',{bubbles:true}));}else if(el?.dataset.action)this.activate(el);else if(!el||!this.menu.contains(el))this.focus(0);}if(pressed(1))this.action('back');}this.padButtons=Array.from({length:17},(_,i)=>b(i));}\n  button(label,action,extra='',primary=false){return `<button class=\"menu-button ${primary?'primary':''}\" data-action=\"${action}\" ${extra}><span>${label}</span><i aria-hidden=\"true\">↗</i></button>`;}\n  header(kicker,title,description=''){return `<header class=\"panel-header\"><span class=\"eyebrow\">${kicker}</span><h1>${title}</h1>${description?`<p>${description}</p>`:''}</header>`;}\n  shell(body,cls=''){return `<section class=\"menu-panel ${cls}\">${body}</section>`;}\n  render(){\n    const s=this._screen;this.menu.hidden=['game','attract','loading'].includes(s);this.hudElement.hidden=!['game','attract'].includes(s);this.pauseButton.hidden=s!=='game';this.root.querySelector('#loader').hidden=s!=='loading';this.menu.className=s==='title'?'title-menu':'overlay-menu';\n    if(s==='title')this.menu.innerHTML=`<section class=\"title-content\"><div class=\"expedition-seal\"><span>↓</span><div>THE LOST CAVERNS SOCIETY<small>EXPEDITION NO. 02 &nbsp; / &nbsp; 1984 → NOW</small></div></div><div class=\"title-lockup\"><span class=\"title-riff\">Pitfall<span class=\"title-hyphen\">-ish</span></span><h1>THE<br><em>UNDERSTORY</em></h1></div><p class=\"title-tagline\">Some treasures have legs.<br>Best bring them home.</p><nav class=\"title-actions\">${this.button('Begin expedition','start','',true)}${this.button('Co-op camp','coop')}${this.button('Settings','settings')}${this.button('Field guide & credits','about')}</nav><div class=\"title-bottom\"><span class=\"small-diamond\">◆</span> A CAVERN ADVENTURE FOR 1–2 EXPLORERS</div></section><aside class=\"title-side-note\"><span>FIELD NOTE 01</span><p>Mind the frogs.<br>Trust the balloons.</p><i>↘</i></aside>`;\n    else if(s==='pause')this.menu.innerHTML=this.shell(this.header('TAKE A BREATHER','Lantern still lit.','The caverns can wait a moment.')+`<nav>${this.button('Keep exploring','resume','',true)}${this.button('Field map','map')}${this.button('Settings','settings')}${this.button('Developer tools','dev')}${this.button('Field guide & credits','about')}${this.button('Return to title','title')}</nav>`,'compact-panel');\n    else if(s==='settings')this.menu.innerHTML=this.settingsScreen();\n    else if(s==='dev')this.menu.innerHTML=this.devScreen();\n    else if(s==='about')this.menu.innerHTML=this.aboutScreen();\n    else if(s==='map')this.menu.innerHTML=this.mapScreen();\n    else if(s==='coop')this.menu.innerHTML=this.coopScreen();\n    else if(s==='victory')this.menu.innerHTML=this.victoryScreen();\n    else if(s==='error')this.menu.innerHTML=this.shell(this.header('A SNAG IN THE ROPE','Couldn’t light the lantern.',esc(this.payload.message||'The graphics engine could not start.'))+`<p class=\"muted\">Use a browser with WebGPU or WebGL 2 support. Check your connection so the engine libraries can load.</p>${this.button('Try again','reload','',true)}`);\n    else this.menu.innerHTML='';\n    this.focusIndex=0; if(!this.menu.hidden)requestAnimationFrame(()=>this.focus(0));this.updateHints();\n  }\n  formatValue(key,value){return key==='music'||key==='sfx'?`${Math.round(value*100)}%`:key==='hazard'?`${Number(value).toFixed(1)}×`:Number(value).toFixed(key==='gravity'||key==='camera'?0:1);}\n  range(label,key,min,max,step,detail='',dev=false){const v=this.settings[key];return `<label class=\"setting-row\"><span class=\"setting-copy\"><strong>${label}</strong>${detail?`<small>${detail}</small>`:''}</span><span class=\"range-control\"><input aria-label=\"${label}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${v}\" data-setting=\"${key}\" data-callback=\"${dev?'dev:':''}${key}\"><output>${this.formatValue(key,v)}</output></span></label>`;}\n  toggle(label,key,detail='',dev=false){return `<label class=\"setting-row\"><span class=\"setting-copy\"><strong>${label}</strong><small>${detail}</small></span><input aria-label=\"${label}\" type=\"checkbox\" ${this.settings[key]?'checked':''} data-setting=\"${key}\" data-callback=\"${dev?'dev:':''}${key}\"></label>`;}\n  settingsScreen(){return this.shell(this.header('MAKE YOURSELF AT HOME','Camp settings.')+`<div class=\"settings-list\">${this.range('Music','music',0,1,.01,'A little expedition accompaniment.')}${this.range('Sound & voices','sfx',0,1,.01)}<label class=\"setting-row\"><span class=\"setting-copy\"><strong>Controller prompts</strong><small>Standard mapping works with any pad.</small></span><select aria-label=\"Controller prompts\" data-setting=\"glyphs\"><option value=\"playstation\" ${this.settings.glyphs==='playstation'?'selected':''}>PlayStation · ✕ ○ □ △</option><option value=\"xbox\" ${this.settings.glyphs==='xbox'?'selected':''}>Xbox · A B X Y</option></select></label>${this.toggle('Explorer assist','assist','Gentler hazards and automatic swimming help.')}${this.toggle('Reduced motion','reducedMotion','Calmer camera and celebratory effects.')}</div><div class=\"panel-footer\">${this.button('Back to camp','back','',true)}</div>`,'wide-panel');}\n  devScreen(){const teleports=this.payload.teleports||[{id:'camp',label:'Camp'},{id:'water',label:'Flooded gallery'},{id:'balloon',label:'Balloon shaft'},{id:'deep',label:'Deep vault'}];return this.shell(this.header('THE WORKING NOTEBOOK','Developer tools.','Changes apply live. Expedition progress stays intact.')+`<div class=\"dev-columns\"><div class=\"settings-list\">${this.range('Run speed','speed',2,14,.2,'',true)}${this.range('Gravity','gravity',5,45,1,'',true)}${this.range('Jump impulse','jump',5,18,.5,'',true)}${this.range('Swim speed','swim',2,12,.2,'',true)}${this.range('Hazard pace','hazard',0,2,.1,'',true)}${this.range('Camera span','camera',16,42,1,'',true)}${this.toggle('Invincible explorer','god','Walk through trouble without a setback.',true)}</div><div class=\"dev-actions\"><span class=\"eyebrow\">QUICK TRAVEL</span>${teleports.map(t=>this.button(esc(t.label||t.id),'dev:teleport',`data-value=\"${esc(t.id)}\"`)).join('')}${this.button('Return to checkpoint','dev:checkpoint')}${this.button('Refill courage','dev:heal')}${this.button('Reset tuning defaults','dev:reset')}</div></div><div class=\"panel-footer\">${this.button('Back to the expedition','back','',true)}</div>`,'wide-panel dev-panel');}\n  aboutScreen(){const tabs=`<nav class=\"about-tabs\">${[['guide','Field guide'],['credits','Source information'],['feedback','Development notes']].map(([id,label])=>`<button class=\"tab ${this.aboutPage===id?'selected':''}\" data-action=\"about:${id}\">${label}</button>`).join('')}</nav>`;let content='';if(this.aboutPage==='guide')content=`<div class=\"guide-grid\"><article><span class=\"guide-number\">01</span><h2>Leave no friend below.</h2><p>Find the three lost members of your expedition. Bring them safely back to the camp lantern. Gold is a lovely bonus.</p></article><article><span class=\"guide-number\">02</span><h2>A cavern has its ways.</h2><p>Jump the gaps. Climb ladders. Swim through the flooded galleries. Catch a balloon to ride the great shaft, then let go when the landing looks good.</p></article><article><span class=\"guide-number\">03</span><h2>A little courage goes far.</h2><p>Frogs, bats and river creatures guard these quiet halls. A knock sends you back to your latest lantern. Treasures and rescued friends stay found.</p></article><article><span class=\"guide-number\">04</span><h2>Better with company.</h2><p>Two explorers share a rescue list, treasure and checkpoints. Join through AI Hub, open a second camp tab, or exchange a direct connection code.</p></article></div><div class=\"control-guide\">${this.controlsText()}</div>`;\n    else if(this.aboutPage==='credits'){const info=this.metadata.sourceInformation||{};const keys=['date','source','plan','genre','perspective','tech','artDirection','animation','audio','online','testing','research','environment','model','usage'];const labels={artDirection:'Art Direction'};content=`<div class=\"credits-intro\"><h2>Pitfall-ish — The Understory</h2><p>An original affectionate cavern caper, inspired by Pitfall II: Lost Caverns (1984). All geometry, animation, music and voices are made in code.</p></div><dl class=\"credits-grid\">${keys.map(k=>`<div><dt>${labels[k]||k[0].toUpperCase()+k.slice(1)}</dt><dd>${esc(info[k]??(k==='usage'?'added on import':'unknown'))}</dd></div>`).join('')}</dl>`;}\n    else content=Object.entries(QUESTIONS).map(([key,questions])=>`<section class=\"feedback-block\"><h2>${key.replace(/([A-Z])/g,' $1').replace(/^./,s=>s.toUpperCase())}</h2>${questions.map((q,i)=>`<article><h3>${q}</h3><p>${esc(this.metadata[key]?.[i]||'unknown')}</p></article>`).join('')}</section>`).join('');\n    return this.shell(this.header('THE LOST CAVERNS SOCIETY','Notes from below.')+tabs+`<div class=\"about-content\">${content}</div><div class=\"panel-footer\">${this.button('Close notebook','back','',true)}</div>`,'wide-panel about-panel');\n  }\n  controlsText(){const p=this.input==='gamepad';const xbox=this.settings.glyphs==='xbox';return p?`<b>LEFT STICK</b> move / swim &nbsp; <b>${xbox?'A':'✕'}</b> jump / let go &nbsp; <b>${xbox?'X':'□'}</b> interact &nbsp; <b>${xbox?'Y':'△'}</b> map &nbsp; <b>OPTIONS</b> pause`:`<b>A D / ← →</b> move &nbsp; <b>W S / ↑ ↓</b> climb / swim &nbsp; <b>SPACE</b> jump / let go &nbsp; <b>E</b> interact &nbsp; <b>M</b> map &nbsp; <b>ESC</b> pause`;}\n  mapScreen(){return this.shell(this.header('A VERY RESPECTABLE SCRIBBLE','The field map.','Follow the lanterns. There is always another way up.')+`<div class=\"field-map\">${this.payload.svg||this.defaultMap()}</div><div class=\"map-legend\"><span><i class=\"legend-dot gold\"></i> Lost expedition</span><span><i class=\"legend-dot mint\"></i> Lantern checkpoint</span><span>≈ Flooded gallery</span><span>↑ Balloon current</span></div><div class=\"panel-footer\">${this.button('Fold the map','back','',true)}</div>`,'wide-panel');}\n  defaultMap(){return `<svg viewBox=\"0 0 760 320\" role=\"img\" aria-label=\"Cavern map showing camp, flooded gallery, balloon shaft and deep vault\"><g fill=\"none\" stroke=\"#67d7bf\" stroke-width=\"24\" stroke-linejoin=\"round\" opacity=\".22\"><path d=\"M60 65H680V260H80V160H570V65\"/><path d=\"M230 65V160M430 160V260\"/></g><g fill=\"none\" stroke=\"#f4e6bf\" stroke-width=\"2\" stroke-dasharray=\"6 6\"><path d=\"M60 65H680V260H80V160H570V65\"/><path d=\"M230 65V160M430 160V260\"/></g><g fill=\"#f6cc68\"><circle cx=\"100\" cy=\"65\" r=\"8\"/><circle cx=\"570\" cy=\"160\" r=\"8\"/><circle cx=\"100\" cy=\"260\" r=\"8\"/></g><g fill=\"#f4e6bf\" font-family=\"sans-serif\" font-size=\"15\"><text x=\"55\" y=\"36\">CAMP</text><text x=\"280\" y=\"135\">FLOODED GALLERY ≈</text><text x=\"580\" y=\"230\">↑ BALLOON SHAFT</text><text x=\"280\" y=\"296\">DEEP VAULT</text></g><circle cx=\"62\" cy=\"65\" r=\"10\" fill=\"#ee7444\" stroke=\"#f4e6bf\" stroke-width=\"3\"/></svg>`;}\n  coopScreen(){return this.shell(this.header('THERE’S ROOM BY THE LANTERN','Co-op camp.','Two explorers. One shared expedition.')+`<p class=\"coop-status\">${esc(this.payload.status||'Play through AI Hub, a second browser tab, or a direct peer connection.')}</p><div class=\"coop-grid\"><div><span class=\"eyebrow\">THIS BROWSER / AI HUB</span>${this.button('Host a camp','coop:host','',true)}<label class=\"code-label\">Camp code<input id=\"roomCode\" aria-label=\"Camp code\" value=\"${esc(this.payload.room||'')}\" placeholder=\"Enter the host’s camp code\" autocomplete=\"off\"></label>${this.button('Join a camp','coop:join')}<p class=\"muted small\">In AI Hub, the lobby links your expedition automatically. A local camp works between tabs of the same address.</p></div><div><span class=\"eyebrow\">DIRECT CONNECTION</span><p class=\"muted small\">Host creates an invitation. A friend pastes it and creates an answer. Host pastes the answer to connect.</p><textarea id=\"networkCode\" aria-label=\"Direct connection code\" rows=\"3\" placeholder=\"Paste invitation or answer here\">${esc(this.payload.code||'')}</textarea><div class=\"compact-buttons\">${this.button('Create invitation','coop:offer')}${this.button('Use connection code','coop:connect')}${this.button('Copy code','coop:copy')}</div></div></div><div class=\"panel-footer\">${this.button('Back to camp','back')}</div>`,'wide-panel coop-panel');}\n  victoryScreen(){const p=this.payload;return this.shell(`<div class=\"victory-stamp\">EXPEDITION COMPLETE <span>◆</span></div><span class=\"eyebrow\">EVERYBODY ACCOUNTED FOR</span><h1 class=\"victory-title\">Home.<br><em>With stories.</em></h1><p class=\"victory-copy\">Three friends, a hatful of gold, and only a few<br>entirely reasonable screams.</p><div class=\"victory-stats\"><div><strong>${esc(p.rescued??3)} / 3</strong><span>FRIENDS FOUND</span></div><div><strong>${esc(p.score??p.gold??0)}</strong><span>EXPEDITION SCORE</span></div><div><strong>${esc(p.time??'—')}</strong><span>TIME BELOW</span></div></div><nav>${this.button('Another expedition','restart','',true)}${this.button('Back to the title','title')}</nav>`,'victory-panel');}\n  updateHUD(data={}){this.hud={...this.hud,...data};const d=this.hud;const rescued=typeof d.rescued==='number'?d.rescued:Array.isArray(d.rescued)?d.rescued.length:d.friends??0;const hearts=Math.max(0,Math.min(5,Math.ceil(d.health??d.hearts??3)));const max=d.maxHealth??3;this.hudElement.innerHTML=`<div class=\"hud-top\"><div class=\"hud-identity\"><span class=\"tiny-label\">THE UNDERSTORY</span><strong>${esc(d.area||d.zone||'Lantern Camp')}</strong></div><div class=\"hud-goals\"><span class=\"rescue-icon\">♟</span><strong>${rescued}<small> / 3</small></strong><span class=\"hud-divider\"></span><span class=\"gold-glyph\">◆</span><strong>${esc(d.gold??d.score??0)}</strong></div></div><div class=\"courage\" aria-label=\"${hearts} of ${max} courage\">${Array.from({length:max},(_,i)=>`<span class=\"${i<hearts?'filled':''}\">♥</span>`).join('')}<small>COURAGE</small></div>${typeof d.oxygen==='number'&&d.oxygen<1?`<div class=\"oxygen-meter\"><span>AIR</span><i style=\"width:${Math.max(0,Math.min(100,d.oxygen*100))}%\"></i></div>`:''}${d.objective?`<div class=\"hud-objective\"><span class=\"small-diamond\">◆</span> ${esc(d.objective)}</div>`:''}${d.prompt?`<div class=\"context-prompt\">${esc(d.prompt)}</div>`:''}${d.attract?'<div class=\"attract-banner\"><strong>EXPEDITION IN PROGRESS</strong><span>Press anything to take the lantern.</span></div>':''}`;}\n  updateHints(){const hint=this.root.querySelector('#input-hint');if(this._screen==='title')hint.innerHTML=this.input==='gamepad'?`${this.settings.glyphs==='xbox'?'A':'✕'} SELECT &nbsp; · &nbsp; LEFT STICK NAVIGATE`:'↑ ↓ SELECT &nbsp; · &nbsp; ENTER BEGIN';else if(['game','loading'].includes(this._screen))hint.innerHTML='';else if(this._screen==='attract')hint.innerHTML='PRESS ANYTHING TO EXPLORE';else hint.innerHTML=this.input==='gamepad'?`${this.settings.glyphs==='xbox'?'A':'✕'} SELECT &nbsp; ${this.settings.glyphs==='xbox'?'B':'○'} BACK${this._screen==='about'?' &nbsp; · &nbsp; R STICK SCROLL':''}`:`↑ ↓ NAVIGATE &nbsp; · &nbsp; ENTER SELECT &nbsp; · &nbsp; ESC BACK${this._screen==='about'?' &nbsp; · &nbsp; PGDN SCROLL':''}`;const guide=this.menu.querySelector('.control-guide');if(guide)guide.innerHTML=this.controlsText();}\n  toast(title,detail=''){const el=this.root.querySelector('#toast');el.innerHTML=`<span class=\"toast-mark\">◆</span><div><strong>${esc(title)}</strong>${detail?`<p>${esc(detail)}</p>`:''}</div>`;el.classList.add('visible');clearTimeout(this.toastTimer);this.toastTimer=setTimeout(()=>el.classList.remove('visible'),4000);}\n}\n:root{--ink:#092d33;--ink-deep:#061e25;--paper:#f4e6bf;--paper-dim:#b6c7b2;--mint:#67d7bf;--gold:#f6cc68;--orange:#ee7444;--line:rgba(244,230,191,.21);color-scheme:dark;font-family:Arial,Helvetica,sans-serif}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--ink-deep);color:var(--paper)}body{touch-action:none}canvas{display:block;position:fixed;inset:0;width:100%;height:100%}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--gold);outline-offset:5px}button{touch-action:manipulation}button:disabled{opacity:.35;cursor:default}[hidden]{display:none!important}#game-ui{position:fixed;inset:0;pointer-events:none;user-select:none;z-index:5}.ui-vignette{position:absolute;inset:0;box-shadow:inset 0 0 140px rgba(0,12,19,.45);transition:background .5s}#game-ui[data-screen=title] .ui-vignette{background:linear-gradient(90deg,rgba(4,25,31,.97) 0%,rgba(5,30,34,.94) 22%,rgba(5,30,34,.64) 44%,transparent 72%)}#menu-screen{position:absolute;inset:0;pointer-events:auto}.title-menu{display:flex;align-items:center}.title-content{margin-left:6.1vw;max-width:48vw;width:680px;padding-top:1.5vh}.expedition-seal{display:flex;align-items:center;gap:14px;font-size:clamp(10px,.82vw,15px);font-weight:700;letter-spacing:.2em;color:var(--mint);margin-bottom:4vh}.expedition-seal>span{display:grid;place-items:center;border:1px solid var(--mint);border-radius:50%;height:43px;width:43px;font-family:Georgia,serif;font-size:30px}.expedition-seal small{display:block;font-size:.65em;letter-spacing:.14em;color:var(--paper-dim);padding-top:7px}.title-lockup{position:relative}.title-riff{font-family:Georgia,'Times New Roman',serif;font-size:clamp(38px,4vw,78px);letter-spacing:-.055em;font-style:italic;line-height:.8;color:var(--gold)}.title-hyphen{color:var(--orange);font-size:.63em;letter-spacing:-.05em}.title-lockup h1{font-family:Georgia,'Times New Roman',serif;font-weight:400;font-size:clamp(57px,6.4vw,125px);line-height:.92;letter-spacing:-.065em;margin:18px 0 24px}.title-lockup h1 em{font-size:.78em;font-style:normal;letter-spacing:-.055em}.title-tagline{font-family:Georgia,'Times New Roman',serif;font-size:clamp(17px,1.4vw,27px);line-height:1.35;margin:0 0 3vh;color:var(--paper-dim);font-style:italic}.title-actions{width:min(350px,85%);display:flex;flex-direction:column;gap:4px}.menu-button{position:relative;display:flex;justify-content:space-between;align-items:center;width:100%;min-height:48px;background:transparent;border:1px solid transparent;border-bottom-color:var(--line);color:var(--paper);padding:12px 16px;text-align:left;font-size:clamp(17px,1.25vw,24px);font-weight:600;transition:background .12s,color .12s,border-color .12s;letter-spacing:-.02em}.menu-button i{font-style:normal;font-size:1.3em;color:var(--mint);opacity:.5;transform:translateX(-4px);transition:transform .15s,opacity .15s}.menu-button:hover,.menu-button:focus{background:rgba(103,215,191,.1);border-color:var(--mint);outline:none}.menu-button:hover i,.menu-button:focus i{opacity:1;transform:translateX(0)}.menu-button.primary{background:var(--gold);color:var(--ink);border-color:var(--gold);margin-bottom:6px;box-shadow:5px 5px 0 rgba(0,0,0,.2)}.menu-button.primary i{color:var(--ink);opacity:1}.menu-button.primary:hover,.menu-button.primary:focus{background:var(--paper);border-color:var(--paper);box-shadow:0 0 0 3px var(--ink),0 0 0 5px var(--gold)}.title-bottom{font-size:clamp(10px,.7vw,13px);font-weight:700;letter-spacing:.14em;margin-top:3vh;color:var(--paper-dim);display:flex;gap:12px;align-items:center}.small-diamond{color:var(--orange);font-size:.9em}.title-side-note{position:absolute;right:6vw;bottom:9vh;transform:rotate(-4deg);color:var(--paper);text-shadow:0 2px 10px var(--ink-deep)}.title-side-note>span{font-size:10px;letter-spacing:.2em;color:var(--gold)}.title-side-note p{font-family:Georgia,serif;font-style:italic;font-size:clamp(21px,1.8vw,32px);line-height:1.2;margin:12px 0}.title-side-note>i{font-size:60px;font-family:Georgia,serif;color:var(--orange);position:absolute;right:-45px;bottom:-30px}#input-hint{position:absolute;bottom:2.2vh;right:3vw;font-size:clamp(10px,.78vw,15px);font-weight:700;letter-spacing:.12em;color:var(--paper-dim);text-shadow:0 2px 5px var(--ink);pointer-events:none}.overlay-menu{display:flex;justify-content:center;align-items:center;background:rgba(2,19,25,.72);backdrop-filter:blur(5px);padding:4vh 5vw}.menu-panel{background:linear-gradient(140deg,rgba(13,51,56,.99),rgba(5,30,37,.99));border:1px solid rgba(103,215,191,.45);box-shadow:14px 14px 0 rgba(0,0,0,.2);padding:clamp(24px,3vw,52px);width:min(700px,95vw);max-height:89vh;overflow-y:auto;scrollbar-color:var(--mint) var(--ink);scrollbar-width:thin}.compact-panel{width:min(530px,90vw)}.wide-panel{width:min(1130px,94vw)}.panel-header{margin-bottom:24px}.eyebrow{display:block;font-size:clamp(10px,.8vw,14px);letter-spacing:.18em;font-weight:700;color:var(--mint)}.panel-header h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(36px,3.4vw,62px);font-weight:400;line-height:1.03;letter-spacing:-.045em;margin:12px 0}.panel-header p{font-size:clamp(16px,1.15vw,21px);line-height:1.5;color:var(--paper-dim);margin:10px 0}.compact-panel nav{display:grid;gap:5px}.panel-footer{border-top:1px solid var(--line);margin-top:24px;padding-top:18px;display:flex;justify-content:flex-end}.panel-footer .menu-button{max-width:360px}.settings-list{width:100%}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:25px;min-height:79px;border-bottom:1px solid var(--line);padding:14px 0}.setting-copy{flex:1;min-width:0}.setting-copy strong{display:block;font-size:clamp(17px,1.35vw,24px);font-weight:500}.setting-copy small{display:block;font-size:clamp(12px,.9vw,16px);margin-top:5px;color:var(--paper-dim);line-height:1.4}.range-control{display:flex;align-items:center;gap:16px;width:38%}.range-control output{min-width:48px;text-align:right;color:var(--gold);font-variant-numeric:tabular-nums;font-size:20px}input[type=range]{width:100%;accent-color:var(--gold);height:22px;cursor:pointer}input[type=checkbox]{appearance:none;width:53px;height:30px;border:1px solid var(--paper-dim);border-radius:4px;position:relative;b