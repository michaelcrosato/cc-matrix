{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"sed -n '311,385p' audio.js && sed -n '55,110p' test_hub.py && /home/micha/.local/share/pipx/venvs/playwright/bin/python probe.py\"","aggregated_output":"  inspect() {\n    let rms = 0;\n    if (this.ready && this.analyser) {\n      this.analyser.getFloatTimeDomainData(this._analysis);\n      rms = Math.sqrt(this._analysis.reduce((s, v) => s + v * v, 0) / this._analysis.length);\n    }\n    return { ready: this.ready, state: this.ctx?.state || 'locked', musicVolume: this.musicVolume, sfxVolume: this.sfxVolume, muted: this.muted, mode: this.mode, zone: this.zone, musicEvents: this.musicEvents, effectEvents: this.effectEvents, voiceEvents: this.voiceEvents, activeNodes: this.nodes.size, rms, error: this.error || null };\n  }\n\n  dispose() {\n    if (this.disposed) return;\n    this.disposed = true;\n    for (const node of this.nodes) { try { node.stop(); node.disconnect(); } catch {} }\n    this.nodes.clear();\n    for (const node of [this.music, this.fx, this.filter, this.master, this.compressor, this.analyser]) { try { node?.disconnect(); } catch {} }\n    if (!this._offline && this.ctx?.close) this.ctx.close().catch(() => {});\n    this.ready = false;\n  }\n}\n\n/** Deterministic, audible-output verification without requiring speakers. */\nexport async function renderAudioProbe() {\n  const Context = globalThis.OfflineAudioContext || globalThis.webkitOfflineAudioContext;\n  if (!Context) return { supported: false, reason: 'OfflineAudioContext unavailable' };\n  const sampleRate = 22050;\n  const ctx = new Context(1, sampleRate * 5, sampleRate);\n  const director = new AudioDirector({ context: ctx, offline: true });\n  director._graph();\n  for (let i = 0; i < 20; i++) director._scheduleBeat(i, .05 + i * .235);\n  [...effects].forEach((name, i) => director.sfx(name, .1 + i * .35));\n  director.voice('cavern-friend', 3.7);\n  const rendered = await ctx.startRendering();\n  const data = rendered.getChannelData(0);\n  let peak = 0;\n  let sum = 0;\n  let finite = true;\n  let nonzero = 0;\n  for (const v of data) {\n    finite = finite && Number.isFinite(v);\n    peak = Math.max(peak, Math.abs(v));\n    sum += v * v;\n    if (Math.abs(v) > .00001) nonzero++;\n  }\n  const result = { supported: true, finite, peak, rms: Math.sqrt(sum / data.length), nonzeroSamples: nonzero, samples: data.length, musicVolume: director.musicVolume, musicEvents: director.musicEvents, effectEvents: director.effectEvents, voiceEvents: director.voiceEvents };\n  director.dispose();\n  return result;\n}\n                            report[\"frames\"].append(frame.evaluate(\"({hub:window.AIHub?.inspect?.(),net:window.CavernNet?.status?.(),game:window.__game?.getState?.(),bootError:window.__bootError||null})\"))\n                        except Exception as error:\n                            report[\"frames\"].append({\"inspectionError\": str(error)})\n                    reports.append(report)\n                except Exception as error:\n                    reports.append({\"scenario\": scenario, \"pass\": False, \"checks\": [{\"name\": \"harness completed\", \"pass\": False, \"detail\": str(error)}]})\n                finally:\n                    page.close()\n        finally:\n            browser.close()\n    (ROOT / \"hub-conformance-results.json\").write_text(json.dumps(reports, indent=2))\n    return reports\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"base_url\")\n    parser.add_argument(\"--scenarios\", nargs=\"+\", default=[\"standard\", \"server\"])\n    args = parser.parse_args()\n    reports = run_hub_harness(args.base_url, args.scenarios)\n    checks = [(report[\"scenario\"], check) for report in reports for check in report[\"checks\"]]\n    for scenario, check in checks:\n        if not check[\"pass\"]:\n            print(f\"FAIL Hub {scenario}: {check['name']}: {check.get('detail', '')}\")\n    failures = sum(not check[\"pass\"] for _, check in checks)\n    print(f\"{len(checks)} Hub checks, {failures} failures\")\n    return int(bool(failures))\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\nCONSOLE warning using deprecated parameters for the initialization function; pass a single object instead\nTypeError: Cannot read properties of null (reading 'getSupportedExtensions')\n{'ready': True, 'mode': 'playing', 'score': 0, 'elapsed': 1.0167000000000008, 'bridgeOpen': False, 'players': [{'id': 0, 'x': 7.999991298033166, 'y': 3.76500950584159, 'vx': 0, 'vy': 0, 'health': 3, 'grounded': True, 'swimming': False, 'balloon': False, 'checkpoint': {'x': 8, 'y': 4.02}}], 'rescued': [False, False, False], 'gold': 0, 'checkpoints': [True, False, False, False, False], 'stats': {'steps': 0, 'jumps': 0, 'swims': 0, 'balloons': 0, 'ladders': 0, 'hits': 0, 'checkpoints': 1, 'rescues': 0, 'coins': 0, 'frames': 60}, 'config': {'speed': 6.2, 'gravity': 22, 'jump': 10.5, 'swim': 4.5, 'hazard': 1, 'camera': 22}, 'settings': {'music': 0.1, 'sfx': 0.6, 'glyphs': 'playstation', 'assist': False, 'reducedMotion': False}, 'input': {'left': False, 'right': False, 'up': False, 'down': False, 'jump': False, 'action': False}, 'lastInput': 'keyboard', 'net': {'active': False, 'transport': 'solo', 'role': 'host', 'isHost': True, 'me': 0, 'host': 0, 'players': [{'id': 0, 'name': 'You', 'color': '#edbd67'}], 'connected': False, 'waiting': False, 'room': '', 'started': True, 'ended': False, 'server': False}, 'renderer': 'WebGPU', 'rapier': '0.19.3', 'three': '180'}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"cat > test_game.py <<'EOF'\n\\\"\\\"\\\"One-command acceptance checks. Prints only failures and one final count.\\\"\\\"\\\"\nfrom pathlib import Path\nimport json\nimport re\nimport subprocess\nimport sys\nimport urllib.parse\nfrom playwright.sync_api import sync_playwright\nfrom route_test import run_route\nfrom test_hub import run_hub_harness\n\nROOT=Path(__file__).resolve().parent\nINFO=json.loads((ROOT/'build-info.json').read_text())\nRESULTS=[]\ndef check(name,passed,detail=''):\n    RESULTS.append((name,bool(passed),str(detail)))\ndef run_child(filename):\n    command=['node',filename] if filename.endswith('.mjs') else [sys.executable,filename]\n    result=subprocess.run(command,cwd=ROOT,text=True,capture_output=True)\n    output=result.stdout+result.stderr\n    for line in output.splitlines():\n        if line.startswith('FAIL '): check(line[5:],False)\n    count=re.search(r'(\\\\d+)(?:/(\\\\d+))? (?:networking checks passed|WebRTC checks passed|UI checks)',output)\n    if count:\n        total=int(count.group(2) or count.group(1))\n        failures=sum(1 for line in output.splitlines() if line.startswith('FAIL '))\n        for n in range(max(0,total-failures)):check(f'{filename} check {n+1}',True)\n    else:check(filename+' completed',result.returncode==0,output[-1000:])\n    if result.returncode and not any(line.startswith('FAIL ') for line in output.splitlines()):check(filename+' exited cleanly',False,output[-1000:])\n\nserver=subprocess.Popen([sys.executable,'-u','-m','http.server','0','--bind','127.0.0.1'],cwd=ROOT.parent,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)\ntry:\n    line=server.stdout.readline();port=re.search(r'port (\\\\d+)',line)\n    if not port:raise RuntimeError('Could not identify own HTTP server')\n    base='http://127.0.0.1:'+port.group(1)\n    url=base+'/'+urllib.parse.quote(INFO['stem']+'.html')\n    meta=json.loads((ROOT/'metadata.json').read_text())\n    check('Exit interview schema has required fields',set(meta)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'} and len(meta['testingFeedback'])==4 and len(meta['engineFeedback'])==6 and len(meta['promptFeedback'])==4)\n    check('Title selected using a real 50-candidate random draw',INFO['candidates']==50 and 1<=INFO['selection']<=50)\n    with sync_playwright() as p:\n        browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-background-timer-throttling','--disable-renderer-backgrounding'])\n        context=browser.new_context(viewport={'width':1600,'height':900})\n        context.add_init_script(\\\"window.testPad={id:'Injected standard DualSense',index:0,connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};navigator.getGamepads=()=>[window.testPad];\\\")\n        page=context.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n        page.goto(url);page.wait_for_function('window.__game?.getState().ready||window.__bootError',timeout=90000)\n        check('Server serves the intended game',page.title()==INFO['title'])\n        check('Game starts without a click',page.evaluate(\\\"__game.getState().ready&&__game.getState().mode==='title'\\\"))\n        check('Exact engine versions',page.evaluate(\\\"__game.getState().three==='180'&&__game.getState().rapier==='0.19.3'\\\"))\n        check('Music defaults to ten percent and remains gesture locked',page.evaluate(\\\"__game.audio().musicVolume===.1&&\"'!__game.audio().ready\"))\n        page.wait_for_function(\"__game.renderInfo().drawCalls>0\",timeout=30000)\n        check('\"'Renderer submits scene geometry after device recovery if needed',page.evaluate(\\\"__game.renderInfo().triangles>1000\\\"))\n        page.keyboard.press('ArrowDown');check('Keyboard menus navigate',page.evaluate(\\\"document.activeElement.dataset.action==='coop'\\\"))\n        page.keyboard.press('ArrowUp');page.keyboard.press('Enter');page.wait_for_function(\\\"__game.getState().mode==='playing'\\\")\n        start=page.evaluate('__game.getState().players[0].x');page.keyboard.down('KeyD');page.wait_for_timeout(250);page.keyboard.up('KeyD')\n        check('Keyboard movement changes physical position',page.evaluate('__game.getState().players[0].x')>start+.3)\n        page.keyboard.press('Escape');check('Escape pauses',page.evaluate(\\\"__game.getState().mode==='paused'&&document.querySelector('[data-action=resume]')\"'!==null\"))\n        page.keyboard.press('\"'Escape');check('Escape resumes exactly once',page.evaluate(\\\"__game.getState().mode==='playing'\\\"))\n        page.keyboard.press('KeyM');check('Field map shows actual cave geometry',page.locator('.field-map svg rect').count()>10)\n        page.keyboard.press('Escape');page.keyboard.press('Escape')\n        page.evaluate(\\\"__game.action('pause');__game.action('dev')\\\")\n        page.locator('[data-setting=speed]').evaluate(\\\"e=>{e.value=9;e.dispatchEvent(new Event('input',{bubbles:true}))}\\\")\n        check('Developer tuning applies live',page.evaluate('__game.getState().config.speed===9'))\n        page.locator('[data-action=\\\"dev:reset\\\"]').click();check('Developer reset restores defaults',page.evaluate('__game.getState().config.speed===6.2'))\n        page.locator('[data-action=\\\"dev:teleport\\\"][data-value=river]').click();check('Developer quick travel works',page.evaluate('__game.getState().players[0].x===60'))\n        page.evaluate(\\\"__game.action('settings')\\\");page.locator('[data-setting=music]').evaluate(\\\"e=>{e.value=.2;e.dispatchEvent(new Event('input',{bubbles:true}))}\\\")\n        check('Settings update live audio graph',page.evaluate('__game.audio().musicVolume===.2'))\n        page.locator('[data-setting=glyphs]').select_option('xbox');page.evaluate(\\\"__game.action('title');window.testPad.buttons[0]={pressed:true,value:1}\\\");page.wait_for_timeout(60);page.evaluate('testPad.buttons[0]={pressed:false,value:0}')\n        check('Gamepad Cross starts expedition',page.evaluate(\\\"__game.getState().mode==='playing'&&__game.getState().lastInput==='gamepad'\\\"))\n        page.evaluate('testPad.axes[0]=1');page.wait_for_timeout(150);page.evaluate('testPad.axes[0]=0')\n        check('Gamepad stick drives the same controller',page.evaluate('__game.getState().players[0].x>8.2'))\n        page.evaluate('testPad.buttons[9]={pressed:true,value:1}');page.wait_for_timeout(50);page.evaluate('testPad.buttons[9]={pressed:false,value:0}')\n        check('Gamepad Options pauses',page.evaluate(\\\"__game.getState().mode==='paused'\\\"))\n        check('Xbox prompt preference is reflected',page.locator('#input-hint').inner_text().startswith('A SELECT'))\n        page.evaluate(\\\"__game.action('start');__game.action('pause');__game.step(30,{});__game.teleport(12,4.2);__game.step(1,{});window.beforeMishap=__game.getState();__game.setHealth(1);__game.hurt()\\\")\n        check('Fatal mishap restores checkpoint and hearts',page.evaluate('__game.getState().players[0].health===3&&Math.abs(__game.getState().players[0].x-8)<.1'))\n        check('Mishap preserves collected treasure',page.evaluate('__game.getState().gold===beforeMishap.gold&&beforeMishap.gold>0'))\n        check('Damage is counted and score cannot become negative',page.evaluate('__game.getState().stats.hits===1&&__game.getState().score>=0'))\n        probe=page.evaluate('__game.renderAudioProbe()');check('All synthesized audio renders finite audible samples',probe['finite'] and probe['rms']>.001 and 0<probe['peak']<1 and probe['effectEvents']>=10 and probe['voiceEvents']>0,str(probe))\n        for name,passed,detail in run_route(page):check(name,passed,detail)\n        (ROOT/'route-trace.json').write_text(json.dumps(page.evaluate('window.__routeTrace'),indent=2))\n        page.evaluate(\\\"__game.action('title');__game.setIdle(9.99)\\\");page.wait_for_timeout(150)\n        check('Attract replay starts after ten seconds idle',page.evaluate(\\\"__game.getState().mode==='attract'\\\"))\n        page.keyboard.press('KeyQ');check('Any input exits attract mode',page.evaluate(\\\"__game.getState().mode==='title'\\\"))\n        page.evaluate(\\\"__game.action('about')\\\");page.locator('[data-action=\\\"about:credits\\\"]').click();check('About contains complete source metadata',all(x in page.locator('.credits-grid').inner_text() for x in ['added on import','0.19.3','2026-11-05','gpt-6.1-sol']))\n        page.locator('[data-action=\\\"about:feedback\\\"]').click();check('About contains all interview answers',page.locator('.feedback-block article').count()==14)\n        # Two real game copies share a world over the standalone local transport.\n        guest=context.new_page();guest.goto(url);guest.wait_for_function('window.__game?.getState().ready',timeout=90000)\n        page.evaluate(\\\"CavernNet.hostLocal('ACCEPTANCE')\\\");guest.evaluate(\\\"CavernNet.joinLocal('ACCEPTANCE')\\\");guest.wait_for_function('CavernNet.status().connected');page.wait_for_function('__game.getState().players.length===2')\n        guest.keyboard.down('KeyD');guest.wait_for_timeout(350);guest.keyboard.up('KeyD')\n        hostX=page.evaluate('__game.getState().players.find(p=>p.id===1).x');guestX=guest.evaluate('__game.getState().players.find(p=>p.id===1).x')\n        check('Standalone guest input moves authoritative actor',hostX>8.4,str(hostX));check('Standalone guest receives matching world snapshots',abs(hostX-guestX)<1,f'{hostX} / {guestX}')\n        guest.evaluate('CavernNet.solo()');page.wait_for_timeout(100);check('Disconnected co-op returns to a live solo expedition',page.evaluate(\\\"CavernNet.status().transport==='solo'&&__game.getState().players.length===1\\\"))\n        guest.close();context.close()\n        # Touch input uses the same screens with invisible sticks and contextual actions.\n        mobile=browser.new_context(viewport={'width':844,'height':390},has_touch=True,is_mobile=True,device_scale_factor=1)\n        touch=mobile.new_page();touch.goto(url);touch.wait_for_function('window.__game?.getState().ready',timeout=90000);touch.locator('[data-action=start]').tap();touch.evaluate(\\\"__game.action('pause')\\\")\n        touch.evaluate(\\\"()=>{const c=document.querySelector('#game');__game.action('resume');c.dispatchEvent(new PointerEvent('pointerdown',{pointerId:99,pointerType:'touch',clientX:130,clientY:220,bubbles:true}));c.dispatchEvent(new PointerEvent('pointermove',{pointerId:99,pointerType:'touch',clientX:210,clientY:220,bubbles:true}));}\\\")\n        touch.wait_for_timeout(100);check('Touch drag controls movement',touch.evaluate(\\\"__game.getState().lastInput==='touch'&&__game.getState().input.right\\\"))\n        check('Touch HUD remains minimal',touch.locator('.hud-top').evaluate(\\\"e=>getComputedStyle(e).display==='none'\\\"))\n        touch.locator('.corner-menu').tap();check('Touch menu button pauses',touch.evaluate(\\\"__game.getState().mode==='paused'\\\"));mobile.close()\n        # Offline file:// operation is part of the deliverable contract.\n        offline=browser.new_context(offline=True);fp=offline.new_page();fp.goto((ROOT.parent/(INFO['stem']+'.html')).as_uri());fp.wait_for_function('window.__game?.getState().ready',timeout=90000)\n        check('Single HTML boots offline over file protocol',fp.title()==INFO['title'] and fp.evaluate('__game.getState().ready'));offline.close()\n        check('No uncaught runtime errors during mechanics and UI checks',not errors,'; '.join(errors));browser.close()\n    for filename in ['hub-test.mjs','hub-rtc-test.py','test_ui.py']:run_child(filename)\n    for report in run_hub_harness(base):\n        for item in report['checks']:check('AI Hub '+report.get('scenario','standard')+': '+item['name'],item['pass'],item.get('detail',''))\nexcept Exception as e:\n    check('Acceptance suite completed',False,str(e))\nfinally:\n    server.terminate();server.wait(timeout=10)\nfailed=[r for r in RESULTS if not r[1]]\n(ROOT/'test-results.json').write_text(json.dumps({'checks':len(RESULTS),'failures':len(failed),'results':[{'name':n,'pass':p,'detail':d} for n,p,d in RESULTS]},indent=2))\nfor name,passed,detail in failed:print('FAIL '+name+(': '+detail if detail else ''))\nprint(f'{len(RESULTS)} checks, {len(failed)} failures')\nraise SystemExit(bool(failed))\nEOF\nnpm run build\nnpm test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' webgpu-probe.py && sed -n '115,180p' node_modules/three/src/renderers/webgl-fallback/WebGLBackend.js && cat test-results.json 2>/dev/null | head -20\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' webgpu-probe.py && sed -n '115,180p' node_modules/three/src/renderers/webgl-fallback/WebGLBackend.js && cat test-results.json 2>/dev/null | head -20\"","aggregated_output":"from pathlib import Path\nfrom playwright.sync_api import sync_playwright\nfrom urllib.parse import quote\nimport argparse,json,time\n\nfolder=Path(__file__).resolve().parent\ninfo=json.loads((folder/'build-info.json').read_text())\nparser=argparse.ArgumentParser();parser.add_argument('variant',choices=['baseline','angle','vulkan','xvfb','webgl','dawn','full','bare','mesa','retain']);args=parser.parse_args()\nflags={\n 'baseline':['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'],\n 'angle':['--enable-unsafe-webgpu','--use-angle=swiftshader','--use-webgpu-adapter=swiftshader'],\n 'vulkan':['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-vulkan-surface','--disable-gpu-sandbox'],\n 'xvfb':['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'],\n 'webgl':['--enable-webgl','--use-angle=swiftshader','--enable-unsafe-swiftshader'],\n 'retain':['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'],\n 'full':['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'],\n 'bare':['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'],\n 'mesa':['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-angle=vulkan','--ignore-gpu-blocklist'],\n 'dawn':['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--enable-dawn-features=allow_unsafe_apis','--disable-gpu-sandbox'],\n}[args.variant]\nurl='http://127.0.0.1:40835/'+quote(info['stem']+'.html')\nlogs=[];result={'variant':args.variant}\nwith sync_playwright() as p:\n browser=p.chromium.launch(headless=args.variant!='xvfb',args=flags,channel='chromium' if args.variant=='full' else None)\n page=browser.new_page(viewport={'width':1280,'height':720})\n page.on('console',lambda m: logs.append(m.type+': '+m.text[:700]) if m.type in ['error','warning'] else None)\n page.on('pageerror',lambda e: logs.append('pageerror: '+str(e)[:700]))\n page.add_init_script('''(() => {\n window.__gpuDiag={supported:!!navigator.gpu,errors:[],lost:null};\n if(navigator.gpu){const request=navigator.gpu.requestAdapter.bind(navigator.gpu);navigator.gpu.requestAdapter=async(...a)=>{const ad=await request(...a);if(!ad)return ad;window.__gpuDiag.adapter={vendor:ad.info?.vendor,device:ad.info?.device,description:ad.info?.description};const rd=ad.requestDevice.bind(ad);ad.requestDevice=async(...a)=>{const d=await rd(...a);window.__gpuDevice=d;d.addEventListener('uncapturederror',e=>window.__gpuDiag.errors.push(e.error.message));d.lost.then(i=>window.__gpuDiag.lost={reason:i.reason,message:i.message});return d;};return ad;};}\n})()''')\n if args.variant=='retain':\n  page.add_init_script('''(()=>{window.__retainedGPU=navigator.gpu;const r=navigator.gpu.requestAdapter.bind(navigator.gpu);navigator.gpu.requestAdapter=async(...a)=>{const ad=await r(...a);window.__retainedAdapter=ad;return ad;};})()''')\n if args.variant=='bare':\n  page.add_init_script('''(()=>{const r=navigator.gpu.requestAdapter.bind(navigator.gpu);navigator.gpu.requestAdapter=async(...a)=>{const ad=await r(...a);if(!ad)return ad;const rd=ad.requestDevice.bind(ad);ad.requestDevice=async(...a)=>rd({...a[0],requiredFeatures:[]});return ad;};})()''')\n if args.variant=='webgl':\n  html=(folder.parent/(info['stem']+'.html')).read_text().replace('antialias:!0,alpha:!1','antialias:!0,alpha:!1,forceWebGL:!0')\n  page.route('**/*.html',lambda route:route.fulfill(status=200,content_type='text/html',body=html))\n try:\n  page.goto(url,wait_until='domcontentloaded',timeout=30000)\n  assert page.title()==info['title'],page.title()\n  page.wait_for_function('window.__bootError||window.__game?.getState().ready',timeout=90000)\n  result['state']=page.evaluate('window.__game?.getState()')\n  result['bootError']=page.evaluate('window.__bootError||null')\n  if result['state'] and result['state']['ready']:\n   page.evaluate('window.__game.action(\"start\")')\n   page.wait_for_timeout(3000)\n   result['state']=page.evaluate('window.__game?.getState()')\n   result['gpu']=page.evaluate('window.__gpuDiag')\n   page.screenshot(path=str(folder/('probe-'+args.variant+'.png')))\n   result['pngBytes']=(folder/('probe-'+args.variant+'.png')).stat().st_size\n  result['logs']=logs\n except Exception as e:\n  result['exception']=str(e)\n  result['logs']=logs\n  result['gpu']=page.evaluate('window.__gpuDiag').copy() if not page.is_closed() else None\n browser.close()\nprint(json.dumps(result))\n\t\t * @type {?WebGLState}\n\t\t * @default null\n\t\t */\n\t\tthis.state = null;\n\n\t\t/**\n\t\t * A reference to a backend module holding common\n\t\t * utility functions.\n\t\t *\n\t\t * @type {?WebGLUtils}\n\t\t * @default null\n\t\t */\n\t\tthis.utils = null;\n\n\t\t/**\n\t\t * Dictionary for caching VAOs.\n\t\t *\n\t\t * @type {Object<string,WebGLVertexArrayObject>}\n\t\t */\n\t\tthis.vaoCache = {};\n\n\t\t/**\n\t\t * Dictionary for caching transform feedback objects.\n\t\t *\n\t\t * @type {Object<string,WebGLTransformFeedback>}\n\t\t */\n\t\tthis.transformFeedbackCache = {};\n\n\t\t/**\n\t\t * Controls if `gl.RASTERIZER_DISCARD` should be enabled or not.\n\t\t * Only relevant when using compute shaders.\n\t\t *\n\t\t * @type {boolean}\n\t\t * @default false\n\t\t */\n\t\tthis.discard = false;\n\n\t\t/**\n\t\t * A reference to the `EXT_disjoint_timer_query_webgl2` extension. `null` if the\n\t\t * device does not support the extension.\n\t\t *\n\t\t * @type {?EXTDisjointTimerQueryWebGL2}\n\t\t * @default null\n\t\t */\n\t\tthis.disjoint = null;\n\n\t\t/**\n\t\t* A reference to the `KHR_parallel_shader_compile` extensio