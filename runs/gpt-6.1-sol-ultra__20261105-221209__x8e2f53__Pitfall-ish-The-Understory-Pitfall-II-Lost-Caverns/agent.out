{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('game.js');s=p.read_text().replace('b.x+Math.sin(time*.5+b.phase)*.16','86+Math.sin(time*.5+b.phase)*.16');s=s.replace(\\\"[45,-27,'RIVER LANTERN']\\\",\\\"[46.5,-27,'RIVER LANTERN']\\\")\ns=s.replace(\\\"net.onLeave(()=>{mode='title';ui.show('title');});\\\", \\\"net.onLeave(()=>{if(\"'!net.status().active)ui.toast('\"'A companion heads home.','Your expedition can continue.');});\\\")\ns=s.replace(\\\"if(action==='coop:host'){net.hostLocal(value||'UNDERSTORY');ui.setStatus('Camp open. In another tab, select Join camp.');}\\\", \\\"if(action==='coop:host'){const room=value||\"'$('\"'#roomCode')?.value||'UNDERSTORY';net.hostLocal(room);ui.setStatus('Camp '+net.status().room+' open. In another tab, select Join camp.');}\\\")\ns=s.replace(\\\"if(action==='coop:connect'){await net.acceptAnswer(value||\"'$('\"'#networkCode')?.value);ui.setStatus('Companion connected. Begin the expedition.');}\\\", \\\"if(action==='coop:connect'){const code=value||\"'$('\"'#networkCode')?.value;let offer=false;try{offer=JSON.parse(atob(code)).type==='offer';}catch{}if(offer){const answer=await net.answerOffer(code);\"'$('\"'#networkCode').value=answer;ui.setStatus('Answer created. Copy it and send it back to the host.');}else{await net.acceptAnswer(code);ui.setStatus('Companion connected. Begin the expedition.');}}\\\")\ns=s.replace(\\\"if(e.pointerType==='mouse')setInputMode('keyboard');\\\", \\\"if(e.pointerType==='mouse'){setInputMode('keyboard');userActivity();}\\\")\ns=s.replace(\\\"mode,coop:players.length\\\", \\\"mode,attract:mode==='attract',coop:players.length\\\")\ns=s.replace(\\\"if(i>6)rescues[0].g.visible=false;if(i>10)rescues[1].g.visible=false;if(i>16)rescues[2].g.visible=false;\\\", \\\"for(let j=0;j<3;j++){const found=i>[6,10,16][j];rescues[j].collected=found;rescues[j].g.visible=rescues[j].badge.visible=rescues[j].label.visible=\"'!found;}if(i>16&&!bridgeOpen){bridgeOpen=true;createBridge(true);}if(i<2&&bridgeOpen){bridgeOpen=false;createBridge(false);}\")\np.write_text(s)\nPY\nnpm run build'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
