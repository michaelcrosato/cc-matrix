ument.body && document.body.dataset.complete === 'true'\"):\n                complete = True; break\n        except Exception as e:\n            pass\n    res = pg.evaluate(\"JSON.stringify(window.__hubCheck || null)\")\n    print('complete', complete, 'after', round(time.time() - t0), 's')\n    print(res[:3000] if res else res)\n    pg.screenshot(path=f'/tmp/wire-shots/hub-{players}.png')\n    b.close()\nEOF\ncd /tmp/wire-shots && timeout 480 python3 hub_check.py 2 2>&1 | tail -40","description":"Serve game with hub harness and run the 2-player check"}}}
