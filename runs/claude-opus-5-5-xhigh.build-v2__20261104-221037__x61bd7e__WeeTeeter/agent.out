 * .25) }, o.fade === undefined ? .25 : o.fade); return this; }\")\n# 3 tare, towel, headband\nsub('game/rigs.js',\"r.shadow(this.x, this.y, 10 * s, .3, '#20404c');\",\"r.shadow(this.x, this.y + 1, 8.5 * s, .16, '#20404c');\")\nsub('game/rigs.js',\"const u = Math.max(1, Math.round(s * .55)), sh = Math.max(4, Math.round(thick * .78));\",\"const u = Math.max(1, Math.round(s * .85)), sh = Math.max(4, Math.round(thick * .82));\")\nsub('game/rigs.js',\"\"\"if (w.towel) opts.draw = { over: (g, Q) => { const a = Q.shL, b = Q.shR; if (!a || !b) return; const n = Q.head || a; const mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2; px.line(g, a[0], a[1] - 1, n[0], n[1] + 5, '#fbfdfd', 3); px.line(g, b[0], b[1] - 1, n[0], n[1] + 5, '#fbfdfd', 3); px.rect(g, mx - 3, my, 2, 7, '#e2eef0'); px.rect(g, mx + 2, my, 2, 6, '#fbfdfd'); } };\"\"\",\n\"\"\"if (w.towel) opts.draw = { over: (g, Q, rig) => { const a = Q.shL, b = Q.shR; if (!a || !b) return; const k = rig.o.size || 1, mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2, dx = (b[0] - a[0]) * .42, dy = (b[1] - a[1]) * .42; px.line(g, mx - dx, my - dy, mx, my + 2 * k, '#fbfdfd', Math.max(2, 2 * k)); px.line(g, mx + dx, my + dy, mx, my + 2 * k, '#fbfdfd', Math.max(2, 2 * k)); px.rect(g, mx - 2 * k, my + k, 1.6 * k, 5 * k, '#e2eef0'); px.rect(g, mx + .6 * k, my + k, 1.6 * k, 4 * k, '#fbfdfd'); } };\"\"\")\nsub('game/rigs.js',\"w.headband ? { style: 'band', color: '#2cc6e6' } : null;\",\"w.headband ? { style: 'wtband', color: '#2cc6e6' } : null;\")\nsub('game/rigs.js',\"E.Humanoid.hat('sparehat', brimHat(1.2, 1.45));\",\"\"\"E.Humanoid.hat('sparehat', brimHat(1.2, 1.45));\nE.Humanoid.hat('wtband', h => { const { g, Sp, J, R, c } = h; let last = null; for (let i = -6; i <= 6; i++) { const a = i / 6 * 1.9, p = Sp(J.head, Math.cos(a) * R * .98, Math.sin(a) * R * .98, R * .42); if (last) px.line(g, last[0], last[1], p[0], p[1], c, 2); last = p; } });\"\"\")\n# 4 reception sign\nsub('game/art.js',\"sign(g, Math.round(W * .13), 12, G.DATA.line