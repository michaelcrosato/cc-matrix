{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjEMPvyDSxuLvmAD19Vz","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12714,"cache_read_input_tokens":303829,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12714},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e35d4c2a-4185-48d4-8818-8a6b8bcd7047","uuid":"1e43a2ad-36eb-496c-8356-d71f114f59a0","timestamp":"2026-11-05T05:29:57.481Z","request_id":"req_011CgjEMPadkzDP2gtEN3tB5","thinking_duration_ms":1012,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjEMPvyDSxuLvmAD19Vz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014oY1nHF7nK6XQ3pTb5qwbf","name":"Bash","input":{"command":"cat > game/scenes/session.js <<'EOF'\n/* scenes/session.js: a session, every activity, every time: Card → the instructor shows it → Breathe in 3-2-1 → play →\n * stars, minutes, a comment → Again or Done. Each registry entry becomes its own pausable scene here. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nG.registerActivities();\n\n/** record one finished run: best stars, best pct, minutes. Returns what it earned */\nG.recordRun = (def, tierIdx, pct, stars, minutes) => {\n  const s = G.S, id = def.id; s.best[id] = s.best[id] || []; s.bestPct[id] = s.bestPct[id] || [];\n  s.best[id][tierIdx] = Math.max(s.best[id][tierIdx] || 0, stars); s.bestPct[id][tierIdx] = Math.max(s.bestPct[id][tierIdx] || 0, pct);\n  s.runs++;\n  return G.earnMinutes(minutes, stars, id);\n};\nlet leaveTo = null;\nfunction makeScene(def) {\n  let d = null, ctx = null, phase = 'card', t = 0, pills = null, results = null, tierIdx = 0, countdown = 0, comment = null, runs = 0, unlocks = [], said = false;\n  const scene = {\n    view: def.view, camera: { zoom: false }, pausable: true,\n    enter(data) {\n      d = data || {}; tierIdx = d.tier || 0; runs = 0; said = false;\n      G.dbg.activity = def.id; G.dbg.tier = tierIdx; G.dbg.pct = null; G.dbg.stars = null;\n      G.talk.close(); G.setDayLight(G.dayPhase());\n      if (def.music) G.music(def.music); else G.music(null);\n      begin(d.skipCard || d.again ? 'demo' : 'card');\n      G.current = { def, restart() { G.go(sceneName(def), Object.assign({}, d, { tier: tierIdx, skipCard: true }), { fade: 0 }); }, quitTo: d.from };\n    },\n    exit() { if (ctx && ctx.def.stop) ctx.def.stop(ctx); game.input.zones = null; G.activeReader = null; G.talk.close(); },\n    update(dt) {\n      t += dt;\n      if (G.talk.update(dt)) return;\n      if (phase === 'card') { G.previewRun(ctx, dt); pills.update(dt); return; }\n      if (phase === 'demo') {\n        G.previewRun(ctx, dt);\n        if (t > 3 || game.input.pressed('confirm')) { game.input.consumeAll(); go('breathe'); }\n        return;\n      }\n      if (phase === 'breathe') {\n        G.previewRun(ctx, dt);\n        const k = Math.ceil(3 - t); if (k !== countdown && k > 0) { countdown = k; G.A.sfx('click'); }\n        if (t >= 3) { G.A.sfx('clickUp'); G.say1('member', 'hup'); go('play'); }\n        return;\n      }\n      if (phase === 'play') { G.stepRun(ctx, dt); if (ctx.done) finish(); return; }\n      if (phase === 'results') { G.previewRun(ctx, dt); results.update(dt); }\n    },\n    draw(r) {\n      G.drawRun(r, ctx);\n      r.overlay(g => {\n        const W = game.W, H = game.H;\n        if (phase === 'card') { G.drawCard(g, def, tierIdx); pills.draw(g); G.prompts(g, [['confirm', 'Pick'], ['cancel', 'Back']]); }\n        if (phase === 'demo') { const nm = G.DATA.lines[G.S.instructor || 'birch'].name; G.prompts(g, [['confirm', 'Skip']]); }\n        if (phase === 'breathe') {\n          const k = Math.max(1, Math.ceil(3 - t)), f = t % 1;\n          G.panel(g, W / 2 - 70, H * .24, 140, 54, { r: 10 });\n          txt(g, 'Breathe in', W / 2, H * .24 + 6, '#14a8c8', { align: 'center' });\n          txt(g, k, W / 2, H * .24 + 19, '#20404c', { align: 'center', scale: f < .2 ? 4 : 3 });\n        }\n        if (phase === 'results') results.draw(g);\n      });\n      G.talk.draw(r);\n    }\n  };\n  function fresh() {\n    const guided = !!d.guided && runs === 0;\n    ctx = G.makeRun(def.id, { tier: tierIdx, mode: 'solo', seed: 1000 + (G.S.runs * 13) + tierIdx, guided, cheat: false });\n  }\n  function begin(p) { fresh(); go(p); }\n  function go(p) {\n    phase = p; t = 0; countdown = 0;\n    if (p === 'card') {\n      const items = [{ label: 'Begin', id: 'begin' }];\n      if (def.tiers.length > 1 && !d.guided) { const open = G.tier2Open(def.id); items.push({ label: def.tiers[tierIdx === 0 ? 1 : 0].name, id: 'tier', disabled: !open && tierIdx === 0, sub: !open && tierIdx === 0 ? 'Opens on Day 4' : undefined }); }\n      if (!d.guided) items.push({ label: 'Back', id: 'back' });\n      pills = new G.Pills(items, { y: () => Math.min(game.H - 62, 192) - (items.length > 2 ? 0 : 0), w: 118, layout: 'h', h: items.some(i => i.sub) ? 26 : 20, onPick: (i, it) => {\n        if (it.id === 'begin') go('demo');\n        else if (it.id === 'tier') { tierIdx = tierIdx === 0 ? 1 : 0; G.dbg.tier = tierIdx; d.tier = tierIdx; begin('card'); }\n        else leave(false);\n      }, onBack: () => { if (!d.guided) leave(false); } });\n    }\n    if (p === 'demo') {\n      const who = G.S.instructor || 'birch';\n      G.mutter(who, def.demoLine || G.line(who + '.demo'), { auto: 2.8 });\n      if (G.gentle() && !said) { said = true; }\n    }\n    if (p === 'breathe') { G.talk.close(); G.mutter(G.S.instructor || 'birch', G.DATA.lines[G.S.instructor || 'birch'].breathe, { auto: 2.6 }); }\n    if (p === 'play') { game.input.consumeAll(); if (def.begin) def.begin(ctx); G.talk.close(); }\n  }\n  function finish() {\n    const c = ctx.local, pct = c.pct, stars = c.stars; runs++;\n    G.dbg.pct = +pct.toFixed(3); G.dbg.stars = stars;\n    const earned = G.recordRun(def, tierIdx, pct, stars, Math.max(.25, ctx.time / 60));\n    G.lastRun = { id: def.id, tier: tierIdx, pct, stars };\n    G.Save.save();\n    const inStory = !G.S.freePlay && d.from !== 'dev';\n    pills = new G.Pills([{ label: 'Again', id: 'again' }, { label: 'Done', id: 'done' }], { y: () => game.H - 40, x: () => game.W / 2 - 40, w: 90, layout: 'h', onPick: (i, it) => { if (it.id === 'again') { d.guided = false; begin('demo'); } else done(); }, onBack: () => done() });\n    results = new G.Results(def, tierIdx, pct, stars, c.detail, earned, { pills });\n    phase = 'results'; t = 0;\n    let line = G.line('tare.star' + stars);\n    if (stars >= 2 && G.S.day === 2 && !G.S.nod && inStory) { G.S.nod = true; line = G.DATA.lines.tare.nod; }\n    game.after(.9 + stars * .35, () => { if (phase === 'results') G.mutter('tare', line, { face: stars === 0 ? 'worried' : stars === 3 ? 'shocked' : 'happy', auto: 4 }); });\n    unlocks = earned.got;\n    if (unlocks.length) game.after(2.4 + stars * .35, () => { if (phase !== 'results') return; const u = unlocks[0]; G.sting('unlock'); G.mutter('tare', u.say, { face: 'happy', auto: 4 }); if (u.wear) G.S.wear[u.id] = true; if (u.wear) G.Save.save(); });\n    for (const u of unlocks) if (u.wear) G.S.wear[u.id] = true;\n  }\n  function leave(early) {\n    if (early) G.pendingLine = G.line('tare.quit');\n    G.go(d.from === 'free' ? 'freeplay' : d.from === 'dev' ? (d.back || 'island') : 'island', { spot: def.id });\n  }\n  function done() {\n    const s = G.S;\n    if (!s.freePlay && d.from !== 'dev' && d.from !== 'free') { s.session++; G.Save.save(); if (s.session >= 3) { G.go('evening'); return; } }\n    leave(false);\n  }\n  scene.run = () => ctx; scene.phase = () => phase; scene.results = () => results;\n  return scene;\n}\nconst sceneName = G.actScene = def => 'act_' + (def.id || def);\nfor (const id of G.order) G.scenes[sceneName(id)] = makeScene(G.activities[id]);\n/** open a session */\nG.playActivity = (id, o = {}) => G.go(sceneName(id), Object.assign({ from: 'island' }, o), { fade: 'iris', seconds: .4 });\nG.restartSession = () => { if (G.current) G.current.restart(); };\nG.roomDusk = () => G.dayPhase() === 'dusk';\n})();\nEOF\ncat > game/scenes/title.js <<'EOF'\n/* scenes/title.js: the studio, the sea, Tare hopping on a mat, the logo. Attract starts after 10 s without input. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet pills, tare, idle = 0, sub = null, t = 0;\nconst buildMenu = () => {\n  const items = []; const latest = !G.inSession && game.saves.latest();\n  if (latest) items.push({ label: 'Continue', id: 'continue' });\n  items.push({ label: latest ? 'Members' : 'New Member', id: 'member' });\n  items.push({ label: 'Class', id: 'class', sub: undefined });\n  if (G.anyFreePlay()) items.push({ label: 'Free Play', id: 'free' });\n  items.push({ label: 'Settings', id: 'settings' }, { label: 'About', id: 'about' });\n  pills = new G.Pills(items, { x: () => game.W / 2, y: () => Math.round(game.H * .36), w: 150, h: 18, gap: 4, onPick(i, it) {\n    if (it.id === 'continue') { const s = game.saves.latest(); if (s && game.saves.load(s.slot)) G.startDay(); else G.go('member'); }\n    else if (it.id === 'member') G.go('member');\n    else if (it.id === 'class') G.go('class');\n    else if (it.id === 'free') { const s = game.saves.latest(); if (s) game.saves.load(s.slot); G.go('freeplay'); }\n    else if (it.id === 'settings') game.menu('settings');\n    else if (it.id === 'about') G.go('about');\n  } });\n};\n/** has any member reached the ending? Free Play opens then */\nG.anyFreePlay = () => { for (let i = 0; i < 3; i++) { const m = G.Save.member(i); if (m && m.data && m.data.freePlay) return true; } return false; };\nG.scenes.title = {\n  view: 'brawler', camera: { zoom: false },\n  enter(d) { t = 0; idle = 0; tare = new G.TareBody(0, 2); tare.scale = 2; buildMenu(); G.L.enabled = false; G.music('studio'); game.timeScale = G.DEV.timeScale; G.talk.close(); G.dbg.activity = null; G.attractOn = false; if (d && d.fromAttract) { tare.say('shocked', 3); G.mutter('tare', G.DATA.lines.tare.attractBack, { attract: true, auto: 3 }); } G.Save.save(); },\n  update(dt) {\n    t += dt; G.stageCam(34, 8); G.talk.update(dt);\n    if (Math.floor(t / 1.7) !== Math.floor((t - dt) / 1.7)) tare.hop(42);\n    tare.update(dt);\n    if (game.shell && game.shell.screen) { idle = 0; return; }\n    pills.update(dt);\n  },\n  draw(r) {\n    G.ROOMS.studio(r);\n    G.drawMat(r, 0, 2, 44, 12, '#bfeee0');\n    tare.draw(r, { scale: 2 });\n    r.overlay(g => {\n      const W = game.W, H = game.H;\n      G.title(g, G.TITLE, W / 2, Math.max(12, H * .06), W < 360 ? 3 : 4);\n      txt(g, G.DATA.lines.motto, W / 2, Math.max(12, H * .06) + 38, '#14a8c8', { align: 'center', shadow: '#ffffff' });\n      pills.draw(g);\n      G.prompts(g, [['confirm', 'Pick']]);\n    });\n    G.talk.draw(r);\n  }\n};\n})();\nEOF\ncat > game/main.js <<'EOF'\n/* main.js: all scenes are in; start the game. In an AI Hub session it opens straight into the round. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, game = G.game;\nconst FLEX = name => G.scenes[name] ? name : 'title';\nconst link = G.inSession ? null : G.deepLink();\ngame.start({ scenes: G.scenes, scene: G.inSession ? 'round' : 'title',\n  boot: { title: 'WEE TEETER', version: G.version, messages: G.DATA.lines.boot, steps: [\n    ['Zeroing the scale', () => {}], ['Sanding the instructors', () => {}], ['Counting the ducks', () => {}], ['Telling the hippo', () => {}]] } });\nif (G.Hub) G.Hub.connect();\nif (link) {\n  if (link.act) { G.devMember(5); G.S.freePlay = true; game.after(.05, () => G.go(G.actScene(link.act), { tier: link.tier, from: 'dev' }, { fade: 0 })); }\n  else { if (link.day) G.devMember(link.day); else if (link.dev) G.devMember(5); if (link.day) G.S.day = link.day; game.after(.05, () => G.go(FLEX(link.scene), { day: link.day }, { fade: 0 })); }\n}\n})();\nEOF\npython3 - <<'EOF'\nimport json\nfs=json.load(open('game/files.json'))\nprint(len(fs))\nEOF\nfor f in candle rep step hoop jog slalom tray laundry; do [ -f game/activities/$f.js ] || echo \"G.family('$f', {setup(){},update(){},draw(){},result(){return {pct:0}}});\" > game/activities/$f.js; done\nnode build.mjs 2>&1 | tail -3\ncat > /tmp/wt_smoke_$$.mjs <<'EOF'\nEOF\nrm -f /tmp/wt_smoke_$$.mjs\ncat > tests/tools/smoke.mjs <<'EOF'\nimport { load } from '../lib.mjs';\nconst { G, E, game, logs } = load({ draw: true });\ngame.fadeTime = 0;\ngame.advance(.5);\nconsole.log('scene', game.sceneName, 'errors', game.errors.map(e => e.where + ': ' + e.message));\nG.devMember(1);\nG.go('act_stork', { tier: 0, from: 'dev' }, { fade: 0 }); game.advance(.2);\nconsole.log('scene', game.sceneName, G.scenes.act_stork.phase());\ngame.input.tap('confirm'); game.advance(4);\nconsole.log(G.scenes.act_stork.phase());\ngame.advance(3.2);\nconsole.log(G.scenes.act_stork.phase());\ngame.advance(46);\nconsole.log(G.scenes.act_stork.phase(), G.dbg);\ngame.advance(4);\nconsole.log('errors', game.errors.map(e => e.where + ': ' + e.message), logs.slice(0, 5));\nEOF\nnode tests/tools/smoke.mjs 2>&1 | tail -14","description":"Write session, title and main scenes, build and smoke-test"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12714,"cache_read_input_tokens":303829,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12714},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e35d4c2a-4185-48d4-8818-8a6b8bcd7047","uuid":"177270d1-f837-4cb9-a96e-1c065a2e7ab6","timestamp":"2026-11-05T05:30:42.396Z","request_id":"req_011CgjEMPadkzDP2gtEN3tB5","wire_tool_inputs":{"toolu_014oY1nHF7nK6XQ3pTb5qwbf":{"command":"cat > game/scenes/session.js <<'EOF'\n/* scenes/session.js: a session, every activity, every time: Card → the instructor shows it → Breathe in 3-2-1 → play →\n * stars, minutes, a comment → Again or Done. Each registry entry becomes its own pausable scene here. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nG.registerActivities();\n\n/** record one finished run: best stars, best pct, minutes. Returns what it earned */\nG.recordRun = (def, tierIdx, pct, stars, minutes) => {\n  const s = G.S, id = def.id; s.best[id] = s.best[id] || []; s.bestPct[id] = s.bestPct[id] || [];\n  s.best[id][tierIdx] = Math.max(s.best[id][tierIdx] || 0, stars); s.bestPct[id][tierIdx] = Math.max(s.bestPct[id][tierIdx] || 0, pct);\n  s.runs++;\n  return G.earnMinutes(minutes, stars, id);\n};\nlet leaveTo = null;\nfunction makeScene(def) {\n  let d = null, ctx = null, phase = 'card', t = 0, pills = null, results = null, tierIdx = 0, countdown = 0, comment = null, runs = 0, unlocks = [], said = false;\n  const scene = {\n    view: def.view, camera: { zoom: false }, pausable: true,\n    enter(data) {\n      d = data || {}; tierIdx = d.tier || 0; runs = 0; said = false;\n      G.dbg.activity = def.id; G.dbg.tier = tierIdx; G.dbg.pct = null; G.dbg.stars = null;\n      G.talk.close(); G.setDayLight(G.dayPhase());\n      if (def.music) G.music(def.music); else G.music(null);\n      begin(d.skipCard || d.again ? 'demo' : 'card');\n      G.current = { def, restart() { G.go(sceneName(def), Object.assign({}, d, { tier: tierIdx, skipCard: true }), { fade: 0 }); }, quitTo: d.from };\n    },\n    exit() { if (ctx && ctx.def.stop) ctx.def.stop(ctx); game.input.zones = null; G.activeReader = null; G.talk.close(); },\n    update(dt) {\n      t += dt;\n      if (G.talk.update(dt)) return;\n      if (phase === 'card') { G.previewRun(ctx, dt); pills.update(dt); return; }\n      if (phase === 'demo') {\n        G.previewRun(ctx, dt);\n        if (t > 3 || game.input.pressed('confirm')) { game.input.consumeAll(); go('breathe'); }\n        return;\n      }\n      if (phase === 'breathe') {\n        G.previewRun(ctx, dt);\n        const k = Math.ceil(3 - t); if (k !== countdown && k > 0) { countdown = k; G.A.sfx('click'); }\n        if (t >= 3) { G.A.sfx('clickUp'); G.say1('member', 'hup'); go('play'); }\n        return;\n      }\n      if (phase === 'play') { G.stepRun(ctx, dt); if (ctx.done) finish(); return; }\n      if (phase === 'results') { G.previewRun(ctx, dt); results.update(dt); }\n    },\n    draw(r) {\n      G.drawRun(r, ctx);\n      r.overlay(g => {\n        const W = game.W, H = game.H;\n        if (phase === 'card') { G.drawCard(g, def, tierIdx); pills.draw(g); G.prompts(g, [['confirm', 'Pick'], ['cancel', 'Back']]); }\n        if (phase === 'demo') { const nm = G.DATA.lines[G.S.instructor || 'birch'].name; G.prompts(g, [['confirm', 'Skip']]); }\n        if (phase === 'breathe') {\n          const k = Math.max(1, Math.ceil(3 - t)), f = t % 1;\n          G.panel(g, W / 2 - 70, H * .24, 140, 54, { r: 10 });\n          txt(g, 'Breathe in', W / 2, H * .24 + 6, '#14a8c8', { align: 'center' });\n          txt(g, k, W / 2, H * .24 + 19, '#20404c', { align: 'center', scale: f < .2 ? 4 : 3 });\n        }\n        if (phase === 'results') results.draw(g);\n      });\n      G.talk.draw(r);\n    }\n  };\n  function fresh() {\n    const guided = !!d.guided && runs === 0;\n    ctx = G.makeRun(def.id, { tier: tierIdx, mode: 'solo', seed: 1000 + (G.S.runs * 13) + tierIdx, guided, cheat: false });\n  }\n  function begin(p) { fresh(); go(p); }\n  function go(p) {\n    phase = p; t = 0; countdown = 0;\n    if (p === 'card') {\n      const items = [{ label: 'Begin', id: 'begin' }];\n      if (def.tiers.length > 1 && !d.guided) { const open = G.tier2Open(def.id); items.push({ label: def.tiers[tierIdx === 0 ? 1 : 0].name, id: 'tier', disabled: !open && tierIdx === 0, sub: !open && tierIdx === 0 ? 'Opens on Day 4' : undefined }); }\n      if (!d.guided) items.push({ label: 'Back', id: 'back' });\n      pills = new G.Pills(items, { y: () => Math.min(game.H - 62, 192) - (items.length > 2 ? 0 : 0), w: 118, layout: 'h', h: items.some(i => i.sub) ? 26 : 20, onPick: (i, it) => {\n        if (it.id === 'begin') go('demo');\n        else if (it.id === 'tier') { tierIdx = tierIdx === 0 ? 1 : 0; G.dbg.tier = tierIdx; d.tier = tierIdx; begin('card'); }\n        else leave(false);\n      }, onBack: () => { if (!d.guided) leave(false); } });\n    }\n    if (p === 'demo') {\n      const who = G.S.instructor || 'birch';\n      G.mutter(who, def.demoLine || G.line(who + '.demo'), { auto: 2.8 });\n      if (G.gentle() && !said) { said = true; }\n    }\n    if (p === 'breathe') { G.talk.close(); G.mutter(G.S.instructor || 'birch', G.DATA.lines[G.S.instructor || 'birch'].breathe, { auto: 2.6 }); }\n    if (p === 'play') { game.input.consumeAll(); if (def.begin) def.begin(ctx); G.talk.close(); }\n  }\n  function finish() {\n    const c = ctx.local, pct = c.pct, stars = c.stars; runs++;\n    G.dbg.pct = +pct.toFixed(3); G.dbg.stars = stars;\n    const earned = G.recordRun(def, tierIdx, pct, stars, Math.max(.25, ctx.time / 60));\n    G.lastRun = { id: def.id, tier: tierIdx, pct, stars };\n    G.Save.save();\n    const inStory = !G.S.freePlay && d.from !== 'dev';\n    pills = new G.Pills([{ label: 'Again', id: 'again' }, { label: 'Done', id: 'done' }], { y: () => game.H - 40, x: () => game.W / 2 - 40, w: 90, layout: 'h', onPick: (i, it) => { if (it.id === 'again') { d.guided = false; begin('demo'); } else done(); }, onBack: () => done() });\n    results = new G.Results(def, tierIdx, pct, stars, c.detail, earned, { pills });\n    phase = 'results'; t = 0;\n    let line = G.line('tare.star' + stars);\n    if (stars >= 2 && G.S.day === 2 && !G.S.nod && inStory) { G.S.nod = true; line = G.DATA.lines.tare.nod; }\n    game.after(.9 + stars * .35, () => { if (phase === 'results') G.mutter('tare', line, { face: stars === 0 ? 'worried' : stars === 3 ? 'shocked' : 'happy', auto: 4 }); });\n    unlocks = earned.got;\n    if (unlocks.length) game.after(2.4 + stars * .35, () => { if (phase !== 'results') return; const u = unlocks[0]; G.sting('unlock'); G.mutter('tare', u.say, { face: 'happy', auto: 4 }); if (u.wear) G.S.wear[u.id] = true; if (u.wear) G.Save.save(); });\n    for (const u of unlocks) if (u.wear) G.S.wear[u.id] = true;\n  }\n  function leave(early) {\n    if (early) G.pendingLine = G.line('tare.quit');\n    G.go(d.from === 'free' ? 'freeplay' : d.from === 'dev' ? (d.back || 'island') : 'island', { spot: def.id });\n  }\n  function done() {\n    const s = G.S;\n    if (!s.freePlay && d.from !== 'dev' && d.from !== 'free') { s.session++; G.Save.save(); if (s.session >= 3) { G.go('evening'); return; } }\n    leave(false);\n  }\n  scene.run = () => ctx; scene.phase = () => phase; scene.results = () => results;\n  return scene;\n}\nconst sceneName = G.actScene = def => 'act_' + (def.id || def);\nfor (const id of G.order) G.scenes[sceneName(id)] = makeScene(G.activities[id]);\n/** open a session */\nG.playActivity = (id, o = {}) => G.go(sceneName(id), Object.assign({ from: 'island' }, o), { fade: 'iris', seconds: .4 });\nG.restartSession = () => { if (G.current) G.current.restart(); };\nG.roomDusk = () => G.dayPhase() === 'dusk';\n})();\nEOF\ncat > game/scenes/title.js <<'EOF'\n/* scenes/title.js: the studio, the sea, Tare hopping on a mat, the logo. Attract starts after 10 s without input. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet pills, tare, idle = 0, sub = null, t = 0;\nconst buildMenu = () => {\n  const items = []; const latest = !G.inSession && game.saves.latest();\n  if (latest) items.push({ label: 'Continue', id: 'continue' });\n  items.push({ label: latest ? 'Members' : 'New Member', id: 'member' });\n  items.push({ label: 'Class', id: 'class', sub: undefined });\n  if (G.anyFreePlay()) items.push({ label: 'Free Play', id: 'free' });\n  items.push({ label: 'Settings', id: 'settings' }, { label: 'About', id: 'about' });\n  pills = new G.Pills(items, { x: () => game.W / 2, y: () => Math.round(game.H * .36), w: 150, h: 18, gap: 4, onPick(i, it) {\n    if (it.id === 'continue') { const s = game.saves.latest(); if (s && game.saves.load(s.slot)) G.startDay(); else G.go('member'); }\n    else if (it.id === 'member') G.go('member');\n    else if (it.id === 'class') G.go('class');\n    else if (it.id === 'free') { const s = game.saves.latest(); if (s) game.saves.load(s.slot); G.go('freeplay'); }\n    else if (it.id === 'settings') game.menu('settings');\n    else if (it.id === 'about') G.go('about');\n  } });\n};\n/** has any member reached the ending? Free Play opens then */\nG.anyFreePlay = () => { for (let i = 0; i < 3; i++) { const m = G.Save.member(i); if (m && m.data && m.data.freePlay) return true; } return false; };\nG.scenes.title = {\n  view: 'brawler', camera: { zoom: false },\n  enter(d) { t = 0; idle = 0; tare = new G.TareBody(0, 2); tare.scale = 2; buildMenu(); G.L.enabled = false; G.music('studio'); game.timeScale = G.DEV.timeScale; G.talk.close(); G.dbg.activity = null; G.attractOn = false; if (d && d.fromAttract) { tare.say('shocked', 3); G.mutter('tare', G.DATA.lines.tare.attractBack, { attract: true, auto: 3 }); } G.Save.save(); },\n  update(dt) {\n    t += dt; G.stageCam(34, 8); G.talk.update(dt);\n    if (Math.floor(t / 1.7) !== Math.floor((t - dt) / 1.7)) tare.hop(42);\n    tare.update(dt);\n    if (game.shell && game.shell.screen) { idle = 0; return; }\n    pills.update(dt);\n  },\n  draw(r) {\n    G.ROOMS.studio(r);\n    G.drawMat(r, 0, 2, 44, 12, '#bfeee0');\n    tare.draw(r, { scale: 2 });\n    r.overlay(g => {\n      const W = game.W, H = game.H;\n      G.title(g, G.TITLE, W / 2, Math.max(12, H * .06), W < 360 ? 3 : 4);\n      txt(g, G.DATA.lines.motto, W / 2, Math.max(12, H * .06) + 38, '#14a8c8', { align: 'center', shadow: '#ffffff' });\n      pills.draw(g);\n      G.prompts(g, [['confirm', 'Pick']]);\n    });\n    G.talk.draw(r);\n  }\n};\n})();\nEOF\ncat > game/main.js <<'EOF'\n/* main.js: all scenes are in; start the game. In an AI Hub session it opens straight into the round. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, game = G.game;\nconst FLEX = name => G.scenes[name] ? name : 'title';\nconst link = G.inSession ? null : G.deepLink();\ngame.start({ scenes: G.scenes, scene: G.inSession ? 'round' : 'title',\n  boot: { title: 'WEE TEETER', version: G.version, messages: G.DATA.lines.boot, steps: [\n    ['Zeroing the scale', () => {}], ['Sanding the instructors', () => {}], ['Counting the ducks', () => {}], ['Telling the hippo', () => {}]] } });\nif (G.Hub) G.Hub.connect();\nif (link) {\n  if (link.act) { G.devMember(5); G.S.freePlay = true; game.after(.05, () => G.go(G.actScene(link.act), { tier: link.tier, from: 'dev' }, { fade: 0 })); }\n  else { if (link.day) G.devMember(link.day); else if (link.dev) G.devMember(5); if (link.day) G.S.day = link.day; game.after(.05, () => G.go(FLEX(link.scene), { day: link.day }, { fade: 0 })); }\n}\n})();\nEOF\npython3 - <<'EOF'\nimport json\nfs=json.load(open('game/files.json'))\nprint(len(fs))\nEOF\nfor f in candle rep step hoop jog slalom tray laundry; do [ -f game/activities/$f.js ] || echo \"G.family('$f', {setup(){},update(){},draw(){},result(){return {pct:0}}});\" > game/activities/$f.js; done\nnode build.mjs 2>&1 | tail -3\ncat > /tmp/wt_smoke_$$.mjs <<'EOF'\nEOF\nrm -f /tmp/wt_smoke_$$.mjs\ncat > tests/tools/smoke.mjs <<'EOF'\nimport { load } from '../lib.mjs';\nconst { G, E, game, logs } = load({ draw: true });\ngame.fadeTime = 0;\ngame.advance(.5);\nconsole.log('scene', game.sceneName, 'errors', game.errors.map(e => e.where + ': ' + e.message));\nG.devMember(1);\nG.go('act_stork', { tier: 0, from: 'dev' }, { fade: 0 }); game.advance(.2);\nconsole.log('scene', game.sceneName, G.scenes.act_stork.phase());\ngame.input.tap('confirm'); game.advance(4);\nconsole.log(G.scenes.act_stork.phase());\ngame.advance(3.2);\nconsole.log(G.scenes.act_stork.phase());\ngame.advance(46);\nconsole.log(G.scenes.act_stork.phase(), G.dbg);\ngame.advance(4);\nconsole.log('errors', game.errors.map(e => e.where + ': ' + e.message), logs.slice(0, 5));\nEOF\nnode tests/tools/smoke.mjs 2>&1 | tail -14","description":"Write session, title and main scenes, build and smoke-test"}}}
