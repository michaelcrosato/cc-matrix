ber.js',\"\"\"const build = () => [{ label: 'Hair: ' + L().hair[draft.hair], id: 'hair' }, { label: 'Skin ' + (draft.skin + 1), id: 'skin' }, { label: 'Top ' + (draft.top + 1), id: 'top' }, { label: 'Bottom ' + (draft.bottom + 1), id: 'bottom' }, { label: draft.name + '  (Reroll)', id: 'name' }, { label: 'Sign the card', id: 'ok' }];\"\"\",\n\"\"\"const dot = col => (g, r) => { px.disc(g, r.x + 16, r.y + r.h / 2, 6, '#20404c'); px.disc(g, r.x + 16, r.y + r.h / 2, 5, col); };\n  const build = () => [{ label: 'Hair: ' + L().hair[draft.hair], id: 'hair', icon: dot(L().hairCols[draft.skin]) }, { label: 'Skin ' + (draft.skin + 1), id: 'skin', icon: dot(L().skins[draft.skin]) }, { label: 'Top ' + (draft.top + 1), id: 'top', icon: dot(L().tops[draft.top]) }, { label: 'Bottom ' + (draft.bottom + 1), id: 'bottom', icon: dot(L().bottoms[draft.bottom]) }, { label: draft.name + '  (Reroll)', id: 'name' }, { label: 'Sign the card', id: 'ok' }];\"\"\")\nsub('game/scenes/member.js',\"G.prompts(g, mode === 'new' ? [['confirm', 'Next'], ['cancel', 'Back']]\",\"G.prompts(g, mode === 'new' ? [['confirm', 'Next'], ['left', 'Change'], ['cancel', 'Back']]\")\n# 8 sun\nsub('game/art.js',\"const sx = x + w * (o.sunX || .72), sy = horizon - h * (dusk ? .07 : .3);\",\"const sx = x + w * (o.sunX || .9), sy = horizon - h * (dusk ? .07 : .22);\")\n# 9 about & attract logo\nsub('game/scenes/about.js',\"txt(g, (page + 1) + ' / ' + pages.length, W - 20, 16, '#5f7f8a', { align: 'right' });\",\"txt(g, (page + 1) + ' / ' + pages.length, W - 72, 16, '#5f7f8a', { align: 'right' });\")\nsub('game/scenes/attract.js',\"E.font.title(g, G.TITLE, W - 8, 4, { scale: 1, colors: ['#7fe6f8', '#14a8c8'], align: 'right', depth: 1, depthColor: '#0d7f97', outline: false });\",\"E.font.title(g, G.TITLE, 56, H - 24, { scale: 1, colors: ['#7fe6f8', '#14a8c8'], align: 'left', depth: 1, depthColor: '#0d7f97', outline: false });\")\n# tier 2 rule\nsub('game/core.js',\"G.tier2Open = id => { const s = S(); return s.freePlay || s.day >= 4 && G.bestStars(id) >= 2 || s.day >= 4; };\",\"G.tier2Open = id => { const s = S(), b = s.best[id]; return s.freePlay || s.day >= 4 || !!(b && b[0] >= 2); };\")\nsub('game/scenes/session.js',\"sub: !open && tierIdx === 0 ? 'Opens on Day 4' : undefined\",\"sub: !open && tierIdx === 0 ? '2 stars, or Day 4' : undefined\")\n# forced guided stork on Day 1\nsub('game/scenes/member.js',\"if (s.session >= 3 && !s.freePlay) return G.go('evening');\\n  G.go('island');\",\"if (s.session >= 3 && !s.freePlay) return G.go('evening');\\n  if (s.day === 1 && s.session === 0 && !s.best.stork && D.guided) return G.playActivity(D.guided, { guided: true, from: 'island' });\\n  G.go('island');\")\n# celebrate after a run\nsub('game/activities/runtime.js',\"/** a bird: gulls and pigeons */\",\"\"\"/** after a run, the bodies react: bow, cheer, or carry on */\nG.celebrate = (ctx, dt) => {\n  for (const c of ctx.contestants) { c.rig.body = null; c.rig.wob = [0, 0]; const P = c.poser; P.clip(c.stars >= 3 ? 'Cheering_Two_Hands' : c.stars >= 1 ? 'Victory' : c.stars === 0 && c.local ? 'Get_Up_From_Back' : 'Idle_Subtle', { loop: c.stars < 1 || true, tgt: 1.45, fade: .3 }); P.update(dt); c.rig.update(dt, { x: c.x, y: c.benchY || 0, z: 0, vx: 0, vy: 0, facing: P.facing, expr: c.stars >= 1 ? 'smile' : undefined }); }\n  if (ctx.teacher && (ctx.teacherPoser || (ctx.teacherPoser = new G.Poser(ctx.teacher)))) { ctx.teacher.body = null; ctx.teacherPoser.clip('Greeting', { loop: true, tgt: 1.6, fade: .3, speed: .8 }); ctx.teacherPoser.update(dt); ctx.teacher.update(dt, { x: ctx.teacherX, y: -6, z: 0, vx: 0, vy: 0, facing: ctx.teacherPoser.facing }); }\n};\n/** with a mouse, the OS cursor hides during activities and a small soft hand stands in */\nG.handCursor = (r, ctx) => {\n  const c = ctx.local, I = game.input, on = ctx.live && !ctx.done && c && c.intent.source === 'mouse' && !game.paused; const cv = game.screen && game.screen.canvas; if (cv && cv.style) cv.style.cursor = on ? 'none' : '';\n  if (!on) return; const p = I.pointer(); if (!p) return;\n  r.overlay(g => { const x = Math.round(p[0]), y = Math.round(p[1]), { px } = E; px.disc(g, x, y + 1, 5, '#20404c55'); px.disc(g, x, y, 4, '#ffe0cf'); px.disc(g, x - 1, y - 1, 2, '#fff3ea'); for (const k of [-3, -1, 1, 3]) px.rect(g, x + k - .5, y - 7, 1.5, 4, '#ffe0cf'); });\n};\n/** a bird: gulls and pigeons */\"\"\")\nsub('game/activities/runtime.js',\"  if (ctx.def.hud) r.overlay(g => ctx.def.hud(g, ctx));\\n\",\"  if (ctx.def.hud) r.overlay(g => ctx.def.hud(g, ctx));\\n  G.handCursor(r, ctx);\\n\")\nsub('game/activities/hold.js',\"  preview(dt, ctx) {\\n    for (const c of ctx.contestants) { c.poser.clip('Idle_Subtle'\",\"  preview(dt, ctx) {\\n    G.stageCam(); if (ctx.done) return G.celebrate(ctx, dt);\\n    for (const c of ctx.contestants) { c.poser.clip('Idle_Subtle'\")\nsub('game/activities/rep.js',\"  preview(dt, ctx) {\\n    G.stageCam();\",\"  preview(dt, ctx) {\\n    G.stageCam(); if (ctx.done) return G.celebrate(ctx, dt);\")\nsub('game/activities/hoop.js',\"  preview(dt, ctx) {\\n    G.stageCam(32, 8);\",\"  preview(dt, ctx) {\\n    G.stageCam(32, 8); if (ctx.done) { G.celebrate(ctx, dt); for (const q of ctx.throwers) { q.poser.update(dt); q.rig.update(dt, { x: q.x, y: -14, z: 0, vx: 0, vy: 0, facing: q.poser.facing, expr: 'smile' }); } return; }\")\nsub('game/activities/step.js',\"  preview(dt, ctx) {\\n    G.stageCam(32, 10);\",\"  preview(dt, ctx) {\\n    G.stageCam(32, 10); if (ctx.done) { for (const c of ctx.contestants) c.benchY = 4; const t0 = ctx.teacher; ctx.teacher = null; G.celebrate(ctx, dt); ctx.teacher = t0; }\\n    if (!ctx.done)\")\nsub('game/activities/candle.js',\"  draw(r, ctx) {\\n    (G.ROOMS[ctx.duel ? 'raft' : ctx.def.room]\",\"  draw(r, ctx) {\\n    (G.ROOMS[ctx.duel ? 'raft' : ctx.def.room]\")\n# juice bar backdrop on the tray\nsub('game/activities/tray.js',\"    G.fern(g0, W * .93, H * .3, 1.4); \",\"\"\"    { const top = 22; G.bands(g0, 0, 0, W, top, '#fbf6ec', '#ecdfc4', 3); px.rect(g0, 0, top, W, 3, '#a57f54');\n      for (let i = 0; i < 9; i++) { const x = W * .5 + (i - 4) * 16; px.rect(g0, x - 3, top - 13, 6, 13, ['#ffb27a', '#bfeee0', '#ffe07a', '#f08fb0'][i % 4]); px.rect(g0, x - 2, top - 17, 4, 4, '#ffffff'); }\n      const bx = W * .17; px.rect(g0, bx - 5, top - 4, 10, 4, '#7a8a94'); px.poly(g0, [[bx - 6, top - 19], [bx + 6, top - 19], [bx + 4, top - 4], [bx - 4, top - 4]], '#bfeee0'); const jx = W * .82; px.rect(g0, jx - 6, top - 16, 12, 16, '#dff4f0'); px.rect(g0, jx - 7, top - 18, 14, 2, '#c49c6c'); for (let i = 0; i < 5; i++) px.disc(g0, jx - 3 + (i % 3) * 3, top - 3 - (i >> 1) * 4, 2, '#7b9a3a'); }\n    G.fern(g0, W * .93, H * .3, 1.4); \"\"\")\n# confetti in results\nsub('game/ui.js',\"    this.coins.draw(g);\\n    if (this.pills) this.pills.draw(g);\",\"\"\"    this.coins.draw(g);\n    if (this.stars >= 3 && this.shown >= 3) { if (!this.conf) { this.conf = []; for (let i = 0; i < 46; i++) this.conf.push({ x: G.cosmetic() * W, y: -G.cosmetic() * 60, v: 30 + G.cosmetic() * 40, c: ['#ff7a59', '#2cc6e6', '#f5c84b', '#6fcf8e', '#f08fb0'][i % 5], k: G.cosmetic() * 6 }); } for (const q of this.conf) { q.y += q.v / 60; px.rect(g, q.x + Math.sin(game.real * 4 + q.k) * 4, q.y, 2, 3, q.c); } }\n    if (this.pills) this.pills.draw(g);\"\"\")\nEOF\ncat > game/data/README.md <<'EOF'\n# Building the game out by data\n\nEverything here is plain text and needs no code change.\n\n- **A new line:** add it to any list in `lines.js`. Tone rules are at the top of that file. Keep a box to 2 lines of about 60 characters.\n- **A new tier:** add an object to the activity's `tiers` in `activities.js`. Its numbers are read by the activity's family: `set` is the Lean (k, c, s, A, nf, R, pushV, pushEvery), and `say` replaces the Card's sentence.\n- **A new activity from an existing family:** add a row to `activities.js` with `family`, `discipline`, `name`, `room`, `music`, `stars`, `controls`, `say`, `tiers`. Then open it on a day in `days.js` and place its mat in `island.js`.\n- **A new pose:** add a row to `poses.js`: a clip, a window in seconds and a facing. Dev Mode's Pose Viewer prints rows.\n- **A new step chart:** add it to `charts.js`: four lane strings of 16 steps in `parts`, and an `order`. A tier's `chart` names it.\n- **A new slalom course, road or line:** `courses.js`. Gates are x offsets, obstacles are `[x, gate number, kind]`.\n- **A new tray:** add rows to `trays.js`: o olive, G glass, B bumper, # block, ~ gap, K gecko. 12 columns.\n- **A new day:** add a row to `days.js`: `opens` lists activities; `hold`, `catchUp`, `games`, `scene` are the day's beats.\n- **A new unlock:** add a row to `unlocks.js`. Items with `wear` appear on the Bungalow rail.\n- **The island:** `island.js` is 44 x 26 characters. Move a letter and the thing moves.\nEOF\npython3 - <<'EOF'\ns=open('tests/run.mjs').read()\ns=s.replace(\"\"\"bodyCheck(); check(label + ' after check, the island', sc() === 'island', sc());\"\"\",\"\"\"bodyCheck(); check(label + ' Day 1 opens with the guided Stork', sc() === 'act_stork' && G.scenes.act_stork.run().guided, sc());\n  { const S = G.scenes.act_stork; G.DEV.bot = skill; tap(); adv(() => S.phase() === 'play', 15); check(label + ' the lesson holds the clock', S.run().holdClock === true); adv(() => S.phase() === 'results', 200); G.DEV.bot = null; check(label + ' guided Stork finishes', S.phase() === 'results', S.phase()); played.add('stork'); game.advance(1.5); for (let i = 0; i < 6 && sc() === 'act_stork'; i++) { I.tap('confirm'); game.advance(.4); } check(label + ' it counts as session 1', G.S.session === 1, G.S.session); }\"\"\")\ns=s.replace(\"const DAYS = { 1: ['stork', 'squat', 'step'],\",\"const DAYS = { 1: ['squat', 'step'],\")\nopen('tests/run.mjs','w').write(s)\nEOF\nnode build.mjs | tail -1 | cut -c150-; timeout 590 node tests/run.mjs rules 2>&1 | tail -14 | cut -c1-240","description":"Apply polish, the forced guided Stork and Tier 2 rule, retest","timeout":600000}}}
