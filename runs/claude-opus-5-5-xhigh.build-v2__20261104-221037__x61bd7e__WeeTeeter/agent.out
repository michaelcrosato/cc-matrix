ject.assign({}, o), s * 13); p += r.pct; f += r.falls; fin += r.fin ? 1 : 0; t += r.t; }\n  console.log(JSON.stringify(o).padEnd(62), 'pct', (p / N).toFixed(2), 'falls', (f / N).toFixed(1), 'fin', fin + '/' + N, 't', (t / N).toFixed(0));\n}\nEOF\ntimeout 200 node tests/tools/rope.mjs 2>&1 | cut -c1-140","description":"Read Saves.latest and measure the rope on keys versus mouse","timeout":220000}}}
