) => { const n = Math.sin(x * .071) * Math.sin(y * .053) + .6 * Math.sin((x + y) * .019) + .3 * Math.sin(x * .3 + y * .17); const v = 240 + n * 4; return [v - 7, v - 1, Math.min(255, v + 8)]; };\"\"\",\n\"\"\"const SNOW = (x, y) => { const n = Math.sin(x * .071) * Math.sin(y * .053) + .6 * Math.sin((x + y) * .019) + .3 * Math.sin(x * .3 + y * .17), band = Math.sin(y * .05) * 5 + Math.sin(y * .013) * 4, cord = Math.sin(x * .9) > .7 ? -3 : 0, sp = ((Math.floor(x / 9) * 73 + Math.floor(y / 13) * 37) % 41 === 0) ? -14 : 0; const v = 238 + n * 3 + band + cord + sp; return [v - 8, v - 2, Math.min(255, v + 8)]; };\"\"\")\nsub('game/activities/slalom.js',\"new E.Mode7({ floor: SNOW, size: [1024, 1024], wrap: true, far: 1500,\",\"new E.Mode7({ floor: SNOW, size: [1024, 1024], wrap: true, far: 1700, outside: '#eaf4f8', fog: { color: '#eaf4f8', near: 800, far: 1700 },\")\nsub('game/activities/slalom.js',\"ctx.side = []; for (let i = -2; i < use + 4; i++) for (const s of [-1, 1]) ctx.side.push({ x: s * (240 + ((i * 53 + (s + 1) * 37) % 70)), y: -i * co.spacing * .34 * 3 });\",\n\"ctx.side = []; for (let i = -6; i < (use + 4) * 7; i++) for (const s of [-1, 1]) ctx.side.push({ x: s * (232 + ((i * 53 + (s + 1) * 37) % 80)), y: -i * co.spacing / 7, sc: 1.4 + ((i * 31 + s * 7) % 5 + 5) % 5 * .18 });\")\nsub('game/activities/slalom.js',\"if (vis(s)) m7.sprite(PINE, s.x, s.y, 0, { scale: 1.7 });\",\"if (vis(s)) m7.sprite(PINE, s.x, s.y, 0, { scale: s.sc });\")\nsub('game/activities/slalom.js',\"const h = 34 * k; px.rect(g, sx - Math.max(.5, k * .6), sy - h, Math.max(1, k * 1.2), h, '#5a6a74'); const fw = 13 * k, fh = 9 * k;\",\"const h = 46 * k; px.rect(g, sx - Math.max(.5, k * .9), sy - h, Math.max(1, k * 1.8), h, '#5a6a74'); const fw = 19 * k, fh = 14 * k;\")\nsub('game/activities/slalom.js',\"if (ctx.course.fog) m7.o.fog = ctx.course.fog; else delete m7.o.fog;\",\"m7.o.fog = ctx.course.fog || { color: '#eaf4f8', near: 800, far: 1700 };\")\nsub('game/activities/slalom.js',\"G.prompt