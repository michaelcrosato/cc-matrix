{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjEUgDwqGtgFgGEoCLj9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01VaWJUrigaMbmYVwFX89M9y","name":"Bash","input":{"command":"cat > game/activities/candle.js <<'EOF'\n/* activities/candle.js: Quiet Candle, and its duel. The flame reacts to the speed of the dot: be still, gently. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\n/** a candle and its flame on the floor. flame 0..1 */\nG.drawCandle = (g, x, y, flame, s = 1, t = game.real) => {\n  x = Math.round(x); y = Math.round(y);\n  px.ell(g, x, y, 7 * s, 2 * s, '#c8b89a'); px.rect(g, x - 3 * s, y - 13 * s, 6 * s, 13 * s, '#fff8e8'); px.rect(g, x - 3 * s, y - 13 * s, 2 * s, 13 * s, '#ffffff'); px.rect(g, x + 1 * s, y - 13 * s, 2 * s, 13 * s, '#ecdfc4');\n  px.line(g, x, y - 13 * s, x, y - 15 * s, '#5a4a3a');\n  if (flame <= 0) return;\n  const h = (5 + 9 * flame) * s, w = (1.6 + 2.2 * flame) * s, sw = Math.sin(t * 9) * .9 * s + Math.sin(t * 23) * .4 * s, by = y - 15 * s;\n  px.blend(g, .28, 'add', () => px.disc(g, x, by - h * .4, (8 + 9 * flame) * s, '#ffb860'));\n  px.poly(g, [[x - w, by], [x - w * .8, by - h * .45], [x + sw, by - h], [x + w * .8, by - h * .45], [x + w, by]], '#ff9a3a');\n  px.poly(g, [[x - w * .55, by], [x - w * .45, by - h * .35], [x + sw * .6, by - h * .68], [x + w * .45, by - h * .35], [x + w * .55, by]], '#ffe27a');\n};\nconst THOUGHTS = () => G.DATA.lines.thoughts;\nconst bubble = (g, x, y, s, alpha) => { const w = E.font.width(s) + 12; G.panel(g, x - w / 2, y, w, 15, { r: 7, bg: '#ffffff', border: '#c8dde2' }); px.disc(g, x - 6, y + 18, 2, '#ffffff'); px.disc(g, x - 10, y + 22, 1, '#ffffff'); txt(g, s, x, y + 4, '#5f7f8a', { align: 'center' }); };\nconst DUEL = [\n  { at: 10, kind: 'gull', f: 3.2, dur: 5, line: 0 }, { at: 24, kind: 'blender', f: 3.6, dur: 6, line: 1 }, { at: 38, kind: 'conga', f: 4, dur: 7, line: 2 },\n  { at: 52, kind: 'fireworks', f: 4.2, dur: 6, line: 3 }, { at: 65, kind: 'sing', f: 4.2, dur: 6, line: 4 }, { at: 76, kind: 'goose', f: 5, dur: 6, line: 5 }\n];\nG.family('candle', {\n  camera: { zoom: false },\n  setup(ctx) {\n    ctx.thought = null; ctx.nextThought = 4; ctx.tSeq = 0; ctx.distract = null; ctx.dIdx = 0; ctx.duel = ctx.mode === 'duel'; ctx.herFlame = 1; ctx.fw = [];\n    if (ctx.duel) { ctx.her = G.regularRig('gertrude', ctx.size); ctx.herPoser = new G.Poser(ctx.her); ctx.herPoser.pose('sit', 0); }\n    ctx.contestants.forEach(c => {\n      c.bal = new G.Balance(ctx.tier.set, c.rng); c.bal.cheat = ctx.cheat; c.flame = 1; c.relit = false; c.out = false; c.flameSum = 0; c.poser.pose('sit', 0); c.flickT = 0;\n      if (ctx.contestants.length === 1) c.x = ctx.duel ? -70 : 0;\n      c.bal.onStumble = () => { c.fellT = 1; c.flame = Math.max(0, c.flame - .25); if (G.cue(ctx, c)) { G.A.sfx('stumble'); if (c.input) c.input.rumble(.6, .25); } };\n    });\n    ctx.extraT = 8; ctx.goose = null; ctx.blender = 0;\n  },\n  preview(dt, ctx) { for (const c of ctx.contestants) { c.poser.pose('sit'); c.poser.update(dt); c.rig.update(dt, { x: c.x, y: 0, z: 0, vx: 0, vy: 0, facing: c.poser.facing, expr: 'smile' }); } if (ctx.her) { ctx.herPoser.update(dt); ctx.her.update(dt, { x: 70, y: 0, z: 0, vx: 0, vy: 0, facing: ctx.herPoser.facing, expr: 'smile' }); } G.stageCam(26, 10); },\n  update(dt, ctx) {\n    const t = ctx.time, tier = ctx.tier; G.stageCam(26, 10);\n    /* thoughts drift in and push you slowly their way */\n    if (!ctx.thought && t >= ctx.nextThought && !ctx.duel) {\n      const a = ctx.rng() * 6.283, f = tier.thoughtForce[0] + ctx.rng() * (tier.thoughtForce[1] - tier.thoughtForce[0]), list = THOUGHTS(), s = list[ctx.tSeq++ % list.length];\n      ctx.thought = { a, f, t: 0, dur: 2.5, s }; ctx.nextThought = t + tier.thoughtEvery * (.8 + ctx.rng() * .4); if (ctx.local && !ctx.quiet) G.A.sfx('tick');\n    }\n    if (ctx.thought) { ctx.thought.t += dt; if (ctx.thought.t >= ctx.thought.dur) ctx.thought = null; }\n    /* Noisy Candle: Dennis's blender and a goose */\n    if (tier.extras && !ctx.duel) { ctx.extraT -= dt; if (ctx.extraT <= 0) { ctx.extraT = 11; const kind = ctx.rng() < .5 ? 'blender' : 'goose'; ctx.distract = { kind, t: 0, dur: 4, f: 3.5, a: ctx.rng() * 6.283 }; if (ctx.local && !ctx.quiet) G.A.sfx(kind); } }\n    /* the duel's distractions escalate */\n    if (ctx.duel && ctx.dIdx < DUEL.length && t >= DUEL[ctx.dIdx].at * ctx.dur / 90) {\n      const D = DUEL[ctx.dIdx++]; ctx.distract = { kind: D.kind, t: 0, dur: D.dur, f: D.f, a: ctx.rng() * 6.283 };\n      if (ctx.local && !ctx.quiet) { G.mutter('tare', G.DATA.lines.duel[D.line], { attract: true, auto: 3, face: 'worried' }); G.A.sfx({ gull: 'gull', blender: 'blender', conga: 'conga', fireworks: 'firework', goose: 'goose', sing: 'tareBoop' }[D.kind]); }\n    }\n    const dd = ctx.distract;\n    if (dd) { dd.t += dt; if (dd.kind === 'fireworks' && Math.floor(dd.t * 2) !== Math.floor((dd.t - dt) * 2)) { ctx.fw.push({ x: G.cosmetic(), y: .1 + G.cosmetic() * .25, t: 0, c: ['#ffd166', '#ff7a59', '#2cc6e6', '#f08fb0'][Math.floor(G.cosmetic() * 4)] }); if (!ctx.quiet) { G.A.sfx('firework'); game.flash('#ffe8c8', .08, .25); } }\n      if (dd.kind === 'sing' && Math.floor(dd.t * 2) !== Math.floor((dd.t - dt) * 2) && !ctx.quiet) G.say1('tare', 'la');\n      if (dd.kind === 'conga' && Math.floor(dd.t * 3) !== Math.floor((dd.t - dt) * 3) && !ctx.quiet) G.A.sfx('conga');\n      if (dd.t >= dd.dur) ctx.distract = null; }\n    for (const f of ctx.fw) f.t += dt; ctx.fw = ctx.fw.filter(f => f.t < 1);\n    for (const c of ctx.contestants) {\n      const b = c.bal, I = c.intent;\n      if (c.out) { b.fx = b.fy = 0; b.step(dt, 0, 0); b.totalT -= dt * 0; } else {\n        const th = ctx.thought, dk = dd && dd.t < dd.dur ? dd : null;\n        if (th) { b.fx += Math.cos(th.a) * th.f * G.DEV.push; b.fy += Math.sin(th.a) * th.f * G.DEV.push; }\n        if (dk) { b.fx += Math.cos(dk.a + dk.t) * dk.f * G.DEV.push; b.fy += Math.sin(dk.a + dk.t) * dk.f * G.DEV.push; }\n        // the input left perfectly alone: the thoughts drift you out, and Tare can tell\n        if (!I.touched && t > 20 && !ctx.duel && !c.skill) { b.fx += 4; if (!c.toldOff && G.cue(ctx, c)) { c.toldOff = true; G.mutter('tare', G.DATA.lines.tare.candleCheat, { face: 'judging', auto: 4 }); } }\n        b.step(dt, I.x, I.y);\n        const sp = Math.hypot(b.vx, b.vy);\n        if (sp > .55) { c.flame -= .4 * dt; c.flickT -= dt; if (c.flickT <= 0 && G.cue(ctx, c)) { G.A.sfx('flick', { vol: .5 + sp * .4 }); c.flickT = .25; if (c.input) c.input.rumble(.18, .08); } }\n        if (b.inRing) c.flame += .12 * dt;\n        c.flame = clamp(c.flame, 0, 1);\n        if (c.flame <= 0) {\n          if (ctx.cheat) c.flame = .4;\n          else if (!c.relit) { c.relit = true; c.flame = .55; if (G.cue(ctx, c)) { G.A.sfx('flick'); G.mutter('tare', 'It went out. I have relit it. I do not have hands. You owe me fifteen percent.', { face: 'worried', auto: 3 }); } }\n          else { c.out = true; if (ctx.contestants.filter(q => !q.life).every(q => q.out || q.life)) ctx.finished = true; if (G.cue(ctx, c)) G.A.sfx('tareSad'); }\n        }\n        c.flameSum += c.flame * dt;\n      }\n      c.poser.pose('sit'); c.poser.update(dt); c.rig.wob = [b.x * .8, b.y * .6];\n      c.rig.update(dt, { x: c.x, y: 0, z: 0, vx: 0, vy: 0, facing: c.poser.facing, expr: b.edge > .7 ? 'wince' : 'smile' });\n      G.feelBalance(ctx, c, dt);\n    }\n    if (ctx.duel) {\n      const me = ctx.contestants[0];\n      if (t > ctx.dur * 75 / 90 && me.flame > .5) ctx.herFlame = Math.max(0, ctx.herFlame - dt / (ctx.dur * 14 / 90));\n      if (ctx.herFlame <= 0) { ctx.won = true; ctx.finished = true; }\n      if (me.out) { ctx.won = false; ctx.finished = true; }\n      ctx.herPoser.update(dt); ctx.her.wob = [Math.sin(t * .4) * .015, 0]; ctx.her.update(dt, { x: 70, y: 0, z: 0, vx: 0, vy: 0, facing: ctx.herPoser.facing, expr: 'smile' });\n    }\n  },\n  result(ctx, c) {\n    const T = Math.max(ctx.time, 1), full = Math.max(ctx.dur, T), st = clamp(c.bal.inRingT / full, 0, 1), m = clamp(c.flameSum / full, 0, 1), pct = .6 * st + .4 * m - (c.relit ? .15 : 0);\n    return { pct, detail: 'Steadiness ' + Math.round(st * 100) + '%. Flame ' + Math.round(m * 100) + '%.' + (c.relit ? ' One relight.' : '') };\n  },\n  bot(ctx, c, dt) { const u = c.brain.hold(dt, c.bal, 0, 0); c.intent.x = u[0]; c.intent.y = u[1]; c.intent.touched = true; },\n  draw(r, ctx) {\n    (G.ROOMS[ctx.duel ? 'raft' : ctx.def.room] || G.ROOMS.deck)(r, { dusk: ctx.duel || (G.roomDusk && G.roomDusk()) });\n    for (const c of ctx.contestants) { G.drawMat(r, c.x, 0, 30 * (ctx.size / 2.1), 9, c.local ? '#bfeee0' : '#e8f0f2'); G.drawRig(r, c.rig, c.x, 0, 0); r.queue(c.x, 20, 0, g => { const p = r.w(c.x, 20, 0); G.drawCandle(g, p[0], p[1], c.out ? 0 : c.flame, ctx.size > 1.8 ? 1.2 : 1); }); }\n    if (ctx.duel) { G.drawMat(r, 70, 0, 30 * (ctx.size / 2.1), 9, '#d7c7ee'); G.drawRig(r, ctx.her, 70, 0, 0); r.queue(70, 20, 0, g => { const p = r.w(70, 20, 0); G.drawCandle(g, p[0], p[1], ctx.herFlame, 1.2); }); }\n    G.drawGhosts && G.drawGhosts(r, ctx);\n    const dd = ctx.distract;\n    if (dd) r.overlay(g => {\n      const W = game.W, H = game.H, k = dd.t / dd.dur;\n      if (dd.kind === 'gull') { for (let i = 0; i < 3; i++) { const x = W * k * 1.3 - 30 + i * 18, y = 40 + Math.sin(k * 20 + i) * 8 + i * 6, f = Math.sin(game.real * 14 + i) * 3; px.line(g, x - 6, y - f, x, y, '#ffffff', 2); px.line(g, x + 6, y - f, x, y, '#ffffff', 2); } }\n      if (dd.kind === 'blender') { const x = W * .84 + Math.sin(game.real * 60) * 1.5, y = H * .62; px.rect(g, x - 7, y, 14, 8, '#7a8a94'); px.poly(g, [[x - 8, y - 24], [x + 8, y - 24], [x + 6, y], [x - 6, y]], '#bfeee0'); px.rect(g, x - 8, y - 26, 16, 2, '#7a8a94'); txt(g, 'VRRRRR', x, y - 40, '#7a8a94', { align: 'center' }); }\n      if (dd.kind === 'conga') { for (let i = 0; i < 7; i++) { const x = (k * (W + 120)) - 90 + i * 16, y = H * .47 + Math.sin(game.real * 7 + i) * 2; px.rect(g, x - 3, y, 6, 12, ['#ff7a59', '#2cc6e6', '#f5c84b', '#6fcf8e'][i % 4]); px.disc(g, x, y - 3, 3, '#f2d3b8'); px.rect(g, x - 3, y + 12, 2, 6, '#3b5568'); px.rect(g, x + 1, y + 12, 2, 6, '#3b5568'); } }\n      if (dd.kind === 'sing') { const x = W * .5, y = H * .58 + Math.abs(Math.sin(game.real * 6)) * -6; G.drawTare(g, x, y, 1.4, { face: 'happy', squash: Math.sin(game.real * 12) * .1, bow: G.S.minutes >= 20 }); txt(g, '♪', x + 26, y - 26 - k * 10, '#14a8c8', { scale: 2 }); }\n      if (dd.kind === 'goose') { const x = W * (1.05 - k * 1.1), y = H * .72, b = Math.sin(game.real * 8) * 2; px.ell(g, x, y, 11, 7, '#fbfdfd'); px.ell(g, x + 1, y + 1, 10, 6, '#e3edef'); px.line(g, x - 8, y - 3, x - 12, y - 16 + b, '#fbfdfd', 3); px.disc(g, x - 12, y - 18 + b, 3, '#fbfdfd'); px.rect(g, x - 18, y - 18 + b, 4, 2, '#ff9a3a'); px.dot(g, x - 13, y - 19 + b, '#20404c'); px.rect(g, x - 2, y + 6, 1, 6, '#ff9a3a'); px.rect(g, x + 3, y + 6, 1, 6, '#ff9a3a'); }\n    });\n    if (ctx.fw.length) r.overlay(g => { for (const f of ctx.fw) { const x = f.x * game.W, y = f.y * game.H, R = 4 + f.t * 22; for (let i = 0; i < 10; i++) { const a = i / 10 * 6.283; px.rect(g, x + Math.cos(a) * R, y + Math.sin(a) * R + f.t * f.t * 8, 2, 2, f.c); } } });\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, many = ctx.contestants.length > 1;\n    if (ctx.live) G.drawTimer(g, G.left(ctx));\n    for (const c of ctx.contestants) { if (c.life) continue; if (many) G.manyPlate(g, ctx, c); else G.drawPlate(g, c.bal, { x: W / 2, y: H - 34, r: 26, ring: [0, 0, c.bal.R], color: c.color }); }\n    const m = ctx.local; if (m && !many) {\n      // the flame's level, in a shape and a number\n      const x = W / 2 - 70, y = H - 50; G.panel(g, x - 34, y - 4, 58, 32, { r: 7 }); txt(g, 'Flame', x - 5, y - 1, '#5f7f8a', { align: 'center' }); E.ui.bar(g, x - 30, y + 10, 50, 7, m.flame, m.flame > .5 ? '#ffb020' : '#ff7a59', { bg: '#e8f0f2' });\n      if (ctx.duel) { const hx = W / 2 + 70; G.panel(g, hx - 24, y - 4, 58, 32, { r: 7 }); txt(g, 'Gertrude', hx + 5, y - 1, '#5f7f8a', { align: 'center' }); E.ui.bar(g, hx - 20, y + 10, 50, 7, ctx.herFlame, '#b08be0', { bg: '#e8f0f2' }); }\n    }\n    const th = ctx.thought; if (th) { const k = th.t / th.dur, ox = Math.cos(th.a) * (40 + k * 26), oy = -Math.sin(th.a) * 16; const base = many ? game.r.w(0, 0, 58) : game.r.w(ctx.contestants[0].x, 0, 62); bubble(g, base[0] + ox, base[1] + oy - 12, th.s); }\n    if (ctx.live) G.prompts(g, [['lean', 'Gently']]);\n  }\n});\n})();\nEOF\ncat > game/activities/rep.js <<'EOF'\n/* activities/rep.js: the Rail. Squat, Push-Up and Side Lunge are one code path and three data rows. The lean IS the body:\n * holding the stick halfway holds you halfway. A bead rides the rail at the instructor's tempo. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game, lib = G.lib;\nconst txt = (...a) => G.txt(...a);\nconst smooth = u => u * u * (3 - 2 * u);\nconst bead = (tier, u) => { /* u in seconds inside one rep: down, a hold, up */ const { down, hold, up } = tier; if (u < down) return smooth(u / down); if (u < down + hold) return 1; return 1 - smooth(Math.min(1, (u - down - hold) / up)); };\nconst BOTS = { poor: { lead: .28, noise: .12, form: .4 }, average: { lead: .4, noise: .05, form: 1 }, good: { lead: .46, noise: .02, form: 1.4 }, expert: { lead: .5, noise: .008, form: 2 } };\nG.family('rep', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const { tier, def } = ctx, cyc = tier.down + tier.hold + tier.up;\n    ctx.cycle = cyc;\n    ctx.fixed = ctx.durGiven || ctx.short;\n    ctx.reps = ctx.fixed ? Math.max(3, Math.floor(ctx.dur / cyc)) : tier.reps;\n    ctx.dur = ctx.reps * cyc + .2;\n    ctx.fatigueFrom = Math.floor(ctx.reps * .6); ctx.extra = false; ctx.bead = 0; ctx.repI = 0; ctx.flash = null;\n    ctx.instructor = (ctx.mode === 'solo' || ctx.mode === 'games') ? (G.S.instructor || 'birch') : null;\n    if (ctx.instructor) { ctx.teacher = G.instructorRig(ctx.instructor, ctx.size); ctx.teacherPoser = new G.Poser(ctx.teacher); ctx.teacherX = 74; }\n    ctx.side = 1;\n    const axisX = def.axis === 'x', set = { k: 16, c: 8, s: 0, sx: axisX ? 0 : 8, sy: axisX ? 8 : 0, A: 1.1, nf: 1.1, R: .24 };\n    for (const c of ctx.contestants) {\n      c.bal = new G.Balance(set, c.rng); c.bal.cheat = ctx.cheat; c.repSum = 0; c.repN = 0; c.err = 0; c.errT = 0; c.total = 0; c.formSum = 0; c.formT = 0; c.grade = null; c.gradeT = 0; c.done = 0;\n      if (ctx.contestants.length === 1) c.x = ctx.instructor ? -34 : 0;\n      c.bal.onStumble = () => {};\n    }\n  },\n  preview(dt, ctx) {\n    G.stageCam();\n    const u = (game.real % ctx.cycle), b = bead(ctx.tier, u);\n    for (const c of ctx.contestants) G.repBody(ctx, c, c.poser, c.rig, 0, 0, c.x, 0, dt, 'smile');\n    if (ctx.teacher) G.repBody(ctx, null, ctx.teacherPoser, ctx.teacher, b * (ctx.def.axis === 'x' ? Math.sin(game.real * 3.14159 / ctx.cycle) >= 0 ? 1 : -1 : 1), 0, ctx.teacherX, -6, dt);\n  },\n  update(dt, ctx) {\n    const { tier, def } = ctx, t = ctx.time; G.stageCam();\n    const k = Math.floor(t / ctx.cycle), u = t - k * ctx.cycle;\n    /* a rep ends: score it */\n    if (k > ctx.repI) {\n      ctx.repI = k;\n      for (const c of ctx.contestants) {\n        const mean = c.errT > 0 ? c.err / c.errT : 1, tol = G.DEV.repTol, score = clamp((.35 * tol - mean) / ((.35 - .08) * tol), 0, 1);\n        c.repSum += score; c.repN++; c.err = 0; c.errT = 0; c.grade = score >= .85 ? 'Perfect' : score >= .5 ? 'Good' : 'Late'; c.gradeT = 1;\n        if (G.cue(ctx, c)) { if (score >= .85) G.A.sfx('hit'); else if (score >= .5) G.A.sfx('click'); else G.A.sfx('miss'); if (score > .5) G.grunt('member'); }\n      }\n      if (def.axis === 'x') ctx.side = -ctx.side;\n      /* \"Two more\": if you are scoring above .8, the instructor adds two bonus reps */\n      const lead = ctx.local || ctx.contestants[0];\n      if (!ctx.fixed && !ctx.extra && k === ctx.reps - 1 && lead.repN && lead.repSum / lead.repN > .8) { ctx.extra = true; ctx.reps += 2; ctx.dur = ctx.reps * ctx.cycle + .2; if (ctx.instructor) G.mutter(ctx.instructor, G.DATA.lines[ctx.instructor].moreFirst, { auto: 3 }); }\n    }\n    const raw = bead(tier, u), signed = def.axis === 'x' ? raw * ctx.side : raw; ctx.bead = signed;\n    /* fatigue: after 60% of the reps, the tremble rises and the response falls */\n    const fat = clamp((ctx.repI - ctx.fatigueFrom + u / ctx.cycle) / Math.max(1, ctx.reps - ctx.fatigueFrom), 0, 1) * G.DEV.fatigue;\n    for (const c of ctx.contestants) {\n      const b = c.bal, I = c.intent;\n      b.set.A = 1.1 * (1 + fat * 1.6); b.set.k = 16 * (1 - fat * .22);\n      b.ringX = def.axis === 'x' ? signed : 0; b.ringY = def.axis === 'x' ? 0 : -raw;\n      b.step(dt, I.x, I.y);\n      const val = def.axis === 'x' ? b.x : clamp(-b.y, 0, 1), form = def.axis === 'x' ? b.y : b.x;\n      c.err += Math.abs(val - signed) * dt; c.errT += dt; c.formSum += Math.abs(form) * dt; c.formT += dt; c.gradeT = Math.max(0, c.gradeT - dt); c.val = val; c.form = form;\n      G.repBody(ctx, c, c.poser, c.rig, val, form, c.x, 0, dt, Math.abs(form) > .35 || fat > .7 ? 'wince' : 'smile', fat);\n      if (G.cue(ctx, c) && Math.abs(form) > .45) { c.creakT = (c.creakT || 0) - dt; if (c.creakT <= 0) { G.A.sfx('creak'); c.creakT = .5; if (c.input) c.input.rumble(.3, .1); } }\n    }\n    if (ctx.teacher) G.repBody(ctx, null, ctx.teacherPoser, ctx.teacher, signed, 0, ctx.teacherX, -6, dt);\n  },\n  result(ctx, c) {\n    const mean = c.repN ? c.repSum / c.repN : 0, f = c.formT > 0 ? c.formSum / c.formT : 0, pen = clamp(Math.max(0, f - .06) * 1.2, 0, .3);\n    return { pct: mean * (1 - pen), detail: 'Reps ' + c.repN + '. Timing ' + Math.round(mean * 100) + '%. Form ' + Math.round((1 - pen / .3) * 100) + '%.' };\n  },\n  bot(ctx, c, dt) {\n    const B = BOTS[c.brain.skill], t = ctx.time + B.lead, k = Math.floor(t / ctx.cycle), raw = bead(ctx.tier, t - k * ctx.cycle), s = ctx.def.axis === 'x' ? (ctx.side * (k > ctx.repI ? -1 : 1)) : 1;\n    c.nz = c.nz || G.noise(c.rng, 2); const n = B.noise * c.nz(ctx.time), want = raw * s + n;\n    const b = c.bal, I = c.intent;\n    if (ctx.def.axis === 'x') { I.x = clamp(want, -1, 1); I.y = clamp(-b.y * B.form - b.vy * .3 + n, -1, 1); }\n    else { I.y = clamp(-want, -1, 1); I.x = clamp(-b.x * B.form - b.vx * .3 + n, -1, 1); }\n  },\n  ghost(ctx, c) { return { v: c.val || 0 }; },\n  draw(r, ctx) {\n    (G.ROOMS[ctx.def.room] || G.ROOMS.iron)(r, { dusk: G.roomDusk && G.roomDusk() });\n    for (const c of ctx.contestants) G.drawMat(r, c.x, 0, ctx.def.facing < .5 ? 42 : 30 * (ctx.size / 2.1), 9, c.local ? '#ffd8cc' : '#e8f0f2');\n    if (ctx.teacher) G.drawMat(r, ctx.teacherX, -6, ctx.def.facing < .5 ? 40 : 30 * (ctx.size / 2.1), 9, '#f4e6cf');\n    for (const c of ctx.contestants) G.drawRig(r, c.rig, c.x, 0, 0);\n    if (ctx.teacher) G.drawRig(r, ctx.teacher, ctx.teacherX, -6);\n    G.drawGhosts && G.drawGhosts(r, ctx);\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, many = ctx.contestants.length > 1, horiz = ctx.def.axis === 'x';\n    if (!ctx.live && !ctx.showHud) return;\n    if (ctx.live) { G.panel(g, 8, 6, 74, 20, { r: 8 }); txt(g, 'Rep ' + Math.min(ctx.repI + 1, ctx.reps) + ' / ' + ctx.reps, 45, 12, '#20404c', { align: 'center' }); }\n    for (const c of ctx.contestants) {\n      if (c.life) continue; const b = c.bal;\n      const base = game.r.w(c.x, 0, 0);\n      if (horiz) {   // a horizontal rail above the Plate's place\n        const y = many ? H - 30 : H - 26, w = many ? 34 : 86, x = base[0];\n        px.rect(g, x - w - 4, y - 2, 2 * w + 8, 5, '#c8dde2'); px.rect(g, x - w - 4, y - 1, 2 * w + 8, 2, '#ffffff'); px.rect(g, x, y - 4, 1, 9, '#7a8a94');\n        const bx = x + ctx.bead * w, mx = x + clamp(c.val || 0, -1, 1) * w; px.disc(g, bx, y, many ? 5 : 7, '#14a8c8'); px.disc(g, bx, y, many ? 3 : 5, '#7fe6f8'); px.disc(g, mx, y, many ? 3 : 4, '#20404c'); px.disc(g, mx, y, many ? 2 : 3, c.color);\n        if (c.gradeT > 0) txt(g, c.grade, x, y - (many ? 20 : 30), c.grade === 'Late' ? '#e0553a' : '#14a8c8', { align: 'center', scale: many ? 1 : 2, shadow: '#ffffff' });\n        if (many) txt(g, c.name, x, y + 8, c.color, { align: 'center', shadow: '#ffffff' });\n      } else {       // a vertical rail beside the rig\n        const x = base[0] + (many ? 26 : 46), top = base[1] - (many ? 52 : 74), h = many ? 54 : 78;\n        px.rect(g, x - 3, top - 4, 7, h + 8, '#c8dde2'); px.rect(g, x - 1, top - 4, 3, h + 8, '#ffffff');\n        const by = top + ctx.bead * h, my = top + (c.val || 0) * h; px.disc(g, x, by, many ? 5 : 7, '#14a8c8'); px.disc(g, x, by, many ? 3 : 5, '#7fe6f8'); px.disc(g, x, my, many ? 3 : 4, '#20404c'); px.disc(g, x, my, many ? 2 : 3, c.color);\n        if (c.gradeT > 0) txt(g, c.grade, x, top - 14, c.grade === 'Late' ? '#e0553a' : '#14a8c8', { align: 'center', scale: many ? 1 : 2, shadow: '#ffffff' });\n        if (many) txt(g, c.name, base[0], H - 12, c.color, { align: 'center', shadow: '#ffffff' });\n      }\n      if (!many && !horiz) G.drawPlate(g, b, { x: W / 2, y: H - 34, r: 26, ring: [b.ringX, b.ringY, b.R], color: c.color });\n    }\n    if (ctx.live) G.prompts(g, [['lean', ctx.def.axis === 'x' ? 'Lean with the bead' : 'Down with the bead']]);\n    if (G.DEV.trace && ctx.local) txt(g, 'err ' + (ctx.local.errT ? (ctx.local.err / ctx.local.errT).toFixed(3) : '-') + ' form ' + (ctx.local.form || 0).toFixed(2), W / 2, 40, '#20404c', { align: 'center', shadow: '#ffffff' });\n  }\n});\n/** one body at a depth: clip scrubbed, or a hand-posed lunge. The lean is the pose */\nG.repBody = (ctx, c, poser, rig, val, form, x, y, dt, expr, fat = 0) => {\n  const def = ctx.def;\n  if (def.bodyMove) { poser.off(); rig.body = G.moves[def.bodyMove](clamp(val, -1, 1)); rig.mocap = null; rig.update(dt, { x, y, z: 0, vx: 0, vy: 0, facing: def.facing, expr }); }\n  else { const cl = lib.clip(def.clip), bot = def.bottomShare !== undefined ? cl.dur * def.bottomShare : def.bottom, tt = def.top + (bot - def.top) * clamp(val, 0, 1); poser.scrub(def.clip, tt, def.facing); poser.update(dt); rig.update(dt, { x, y, z: 0, vx: 0, vy: 0, facing: poser.facing, expr }); }\n  const shake = fat > 0 ? Math.sin(game.real * 42) * .05 * fat : 0;\n  rig.wob = [clamp(form, -1, 1) * .55 + shake, 0];\n};\n})();\nEOF\ncat > game/data/charts.js <<'EOF'\n/* data/charts.js: step charts, a string a lane (left, down, up, right), 16 steps a bar. '.' alone is an empty lane.\n * order: the bars in turn. A chart's song and its bars give its length. */\n(() => {\nconst G = window.G, E16 = '................';\nG.DATA.charts = {\n  stepA: { song: 'stepA', bars: 25, parts: {\n    I: [E16, E16, E16, E16],\n    A: ['x.......x.......', '.', '.', '....x.......x...'],\n    B: ['x...x...x.......', '.', '.', '..........x...x.'],\n    C: ['x.......x...x...', '.', '.', '....x...........'],\n    D: ['x...............', '.', '.', '....x...x...x...'] },\n    order: 'I A A B A A C B A D A B C A A B D A C B A A D A B' },\n  stepB: { song: 'stepB', bars: 30, parts: {\n    I: [E16, E16, E16, E16],\n    A: ['x.......x.......', '....x...........', '............x...', '.'],\n    B: ['x...........x...', '........x.......', '....x...........', '.'],\n    C: ['x...............', '....x...x.......', '............x...', '..............x.'],\n    D: ['x.......x.......', '..............x.', '......x.........', '....x.......x...'],\n    E: ['x...x...........', '........x.......', '..........x.....', '............x...'] },\n    order: 'I A B A C B D A E C D B E A D C E D A B C A E D B C A D E A' },\n  // the Class's and a hub round's chart: left and right only\n  stepClass: { song: 'stepA', bars: 18, parts: {\n    I: [E16, E16, E16, E16],\n    A: ['x.......x.......', '.', '.', '....x.......x...'],\n    B: ['x...x...x.......', '.', '.', '............x...'] },\n    order: 'I A A B A B A A B A B A B A B A B A' }\n};\n})();\nEOF\ncat > game/activities/step.js <<'EOF'\n/* activities/step.js: Step Class. Four lanes on the music clock. Music is 10% by default, so the beat never depends on it:\n * a soft click on the sfx bus, and the instructor counts in gibberish. The rig steps when you press, not when the chart does. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst TIMING = { poor: { sd: 95, miss: .25 }, average: { sd: 62, miss: .08 }, good: { sd: 34, miss: .02 }, expert: { sd: 14, miss: 0 } };\nconst COUNT = ['one', 'two', 'tree', 'for'];\nconst NOINPUT = { pressed() { return false; }, released() { return false; }, down() { return false; } };\nlet beatHost = null; G.A.onBeat(b => { if (beatHost) beatHost(b); });\nconst stepSide = (k, side) => rig => { const b = G.moves.stepUp(k)(rig); if (side < 0) { const fl = b.footL, fr = b.footR; b.footL = [fr[0], -fr[1], fr[2]]; b.footR = [fl[0], -fl[1], fl[2]]; b.hip = [b.hip[0], -b.hip[1], b.hip[2]]; } return b; };\nG.family('step', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const { tier } = ctx, ch = G.DATA.charts[ctx.chartName || (ctx.mode === 'class' || ctx.mode === 'round' || ctx.short ? (ctx.tierIdx ? 'stepB' : 'stepClass') : tier.chart)], base = G.SONGS[ch.song];\n    const barSec = 60 / base.bpm * 4; const bars = Math.min(ch.bars, Math.ceil((ctx.durGiven || ch.bars * barSec) / barSec));\n    ctx.song = Object.assign({}, base, { len: bars * 16 });\n    ctx.dur = bars * barSec + .4; ctx.chart = ch; ctx.barSec = barSec; ctx.beat = 0; ctx.kick = 0; ctx.flash = 0;\n    const w = { perfect: 45 * G.DEV.window, great: 90 * G.DEV.window, good: 135 * G.DEV.window };\n    ctx.instructor = (ctx.mode === 'solo' || ctx.mode === 'games' || ctx.mode === 'attract') ? (G.S.instructor || 'birch') : null;\n    if (ctx.instructor) { ctx.teacher = G.instructorRig(ctx.instructor, ctx.size * .9); ctx.teacherX = 96; ctx.teacherK = 0; ctx.teacherSide = 1; }\n    if (ctx.mode !== 'class' && ctx.mode !== 'round') ctx.back = [['gertrude', -36, -30], ['marisol', 34, -32], ['kevin', 118, -30]].map(([id, x, y]) => ({ rig: G.regularRig(id, 1.4), x, y, k: 0, side: 1, poser: null }));\n    const lanes = ctx.laneActions || ['stepL', 'stepD', 'stepU', 'stepR'];\n    ctx.contestants.forEach((c, i) => {\n      const proxy = Object.create(game); Object.defineProperty(proxy, 'input', { value: c.input || NOINPUT });\n      c.rh = new E.Rhythm(proxy, { song: ctx.song, chart: ch, lanes: c.input ? (c.input.half || ctx.mode === 'class' ? ['left', 'down', 'up', 'right'] : lanes) : ['x', 'x', 'x', 'x'], windows: w, life: 1, lead: 1.5,\n        on: { judge: (j, n) => { c.lastJ = j; c.jT = .5; if (j !== 'miss' && G.cue(ctx, c)) G.A.sfx('hit', { vol: j === 'perfect' ? 1 : .6 }); if (j === 'miss' && G.cue(ctx, c)) { G.A.sfx('miss'); if (c.input) c.input.rumble(.2, .08); } } } });\n      if (ctx.contestants.length === 1) c.x = -96;\n      c.k = 0; c.side = 1; c.botI = 0; c.lastJ = null; c.jT = 0; c.steps = 0;\n      if (c.skill) { const T = TIMING[c.skill]; c.plan = c.rh.notes.map(() => ({ off: (c.rng() + c.rng() + c.rng() - 1.5) * T.sd * 1.15, skip: c.rng() < T.miss })); c.brain = c.brain || new G.BotBrain(c.skill, c.rng); }\n    });\n  },\n  begin(ctx) { /* the music starts on the first step of play */\n    const first = ctx.contestants[0]; first.rh.start(); for (const c of ctx.contestants.slice(1)) { c.rh.reset(); c.rh.started = true; }\n    G.musicClaim('step'); beatHost = b => {\n      ctx.beat = b; if (ctx.done) return; ctx.flash = 1;\n      if (!ctx.quiet) { G.A.sfx(b % 4 === 0 ? 'clickUp' : 'click'); if (ctx.instructor && b % 2 === 0) G.say1(ctx.instructor, COUNT[(b >> 1) % 4]); }\n      if (ctx.back) for (const q of ctx.back) { q.side = -q.side; q.k = 1; }\n      if (ctx.teacher) { ctx.teacherSide = -ctx.teacherSide; ctx.teacherK = 1; }\n    };\n    ctx.begun = true;\n  },\n  stop(ctx) { beatHost = null; for (const c of ctx.contestants) if (c.rh) c.rh.done = true; },\n  preview(dt, ctx) {\n    G.stageCam(32, 10);\n    for (const c of ctx.contestants) { c.rig.body = stepSide(0, 1); c.rig.update(dt, { x: c.x, y: 4, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n    if (ctx.teacher) { ctx.teacherK = Math.max(0, ctx.teacherK - dt * 3); if (Math.floor(game.real * 2) !== Math.floor((game.real - dt) * 2)) { ctx.teacherK = 1; ctx.teacherSide = -ctx.teacherSide; } ctx.teacher.body = stepSide(Math.sin(ctx.teacherK * Math.PI), ctx.teacherSide); ctx.teacher.update(dt, { x: ctx.teacherX, y: -8, z: 0, vx: 0, vy: 0, facing: 1.57 }); }\n    if (ctx.back) for (const q of ctx.back) { q.rig.body = stepSide(0, 1); q.rig.update(dt, { x: q.x, y: q.y, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n  },\n  update(dt, ctx) {\n    G.stageCam(32, 10);\n    if (!ctx.begun) G.families.step.begin(ctx);\n    ctx.flash = Math.max(0, ctx.flash - dt * 3);\n    const A = G.A;\n    for (const c of ctx.contestants) {\n      const rh = c.rh;\n      if (c.skill || (G.DEV.bot && c.local)) {   // a bot: each note a little off, by its skill\n        if (!c.plan) { const T = TIMING[G.DEV.bot]; c.plan = rh.notes.map(() => ({ off: (c.rng() + c.rng() + c.rng() - 1.5) * T.sd, skip: c.rng() < T.miss })); }\n        const s = A.pos.step, spb = 60 / ctx.song.bpm / ctx.song.steps;\n        while (c.botI < rh.notes.length) { const n = rh.notes[c.botI], pl = c.plan[c.botI], when = n.step + pl.off / 1000 / spb; if (s < when) break; c.botI++; if (!pl.skip && !n.call && !n.j) { rh.hit(n.lane); rh.release(n.lane); c.k = 1; c.side = n.lane === 0 || n.lane === 2 ? -1 : 1; c.steps++; } }\n      }\n      const before = rh.counts.perfect + rh.counts.great + rh.counts.good, I = c.input;\n      if (I && !(G.DEV.bot && c.local)) { const L = rh.lanes; let hit = false; for (let k = 0; k < 4; k++) if (L[k] !== 'x' && I.map[L[k]] && I.pressed(L[k])) { hit = true; c.k = 1; c.side = k === 0 || k === 2 ? -1 : 1; c.steps++; } }\n      rh.life = 1; rh.update(); rh.life = 1;\n      c.jT = Math.max(0, c.jT - dt);\n      c.k = Math.max(0, c.k - dt * 3.2);\n      c.rig.body = stepSide(Math.sin(c.k * Math.PI), c.side);\n      c.rig.update(dt, { x: c.x, y: 4, z: 0, vx: 0, vy: 0, facing: 1.57, expr: c.jT > 0 && c.lastJ === 'miss' ? 'wince' : 'smile' });\n    }\n    if (ctx.teacher) { ctx.teacherK = Math.max(0, ctx.teacherK - dt * 3); ctx.teacher.body = stepSide(Math.sin(ctx.teacherK * Math.PI), ctx.teacherSide); ctx.teacher.update(dt, { x: ctx.teacherX, y: -8, z: 0, vx: 0, vy: 0, facing: 1.57 }); }\n    if (ctx.back) for (const q of ctx.back) { q.k = Math.max(0, q.k - dt * 3); q.rig.body = stepSide(Math.sin(q.k * Math.PI), q.side); q.rig.update(dt, { x: q.x, y: q.y, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n    if (ctx.contestants[0].rh.done && ctx.time > 2) ctx.finished = true;\n  },\n  result(ctx, c) { const rh = c.rh, a = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss ? rh.accuracy : 0; return { pct: a, detail: 'Perfect ' + rh.counts.perfect + '. Great ' + rh.counts.great + '. Good ' + rh.counts.good + '. Missed ' + rh.counts.miss + '.' }; },\n  bot() { /* notes are hit in update, on the music clock */ },\n  ghost(ctx, c) { return { k: +c.k.toFixed(2), d: c.side }; },\n  draw(r, ctx) {\n    (G.ROOMS[ctx.def.room] || G.ROOMS.pier)(r, { dusk: G.roomDusk && G.roomDusk(), festive: ctx.mode === 'games' });\n    const bench = (x, y) => { const p = r.w(x - 22, y + 8, 0), q = r.w(x + 22, y + 8, 0), a = r.w(x - 22, y - 8, 6), b = r.w(x + 22, y - 8, 6); r.queue(x, y - 6, 0, g => { px.poly(g, [[a[0], a[1]], [b[0], b[1]], [q[0], q[1] - 9], [p[0], p[1] - 9]], '#f5f7f7'); px.rect(g, p[0], p[1] - 9, q[0] - p[0], 9, '#2cc6e6'); px.rect(g, p[0] + 3, p[1] - 2, 5, 2, '#20404c'); px.rect(g, q[0] - 8, q[1] - 2, 5, 2, '#20404c'); }); };\n    if (ctx.back) for (const q of ctx.back) { bench(q.x, q.y); G.drawRig(r, q.rig, q.x, q.y); }\n    if (ctx.teacher) { bench(ctx.teacherX, -8); G.drawRig(r, ctx.teacher, ctx.teacherX, -8); }\n    for (const c of ctx.contestants) { bench(c.x, 4); G.drawRig(r, c.rig, c.x, 4); }\n    G.drawGhosts && G.drawGhosts(r, ctx);\n    if (ctx.live || ctx.begun) {\n      const many = ctx.contestants.length > 1;\n      r.overlay(g => { if (!many) { G.panel(g, game.W / 2 - 62, 26, 124, game.H - 36, { r: 8, bg: '#fbfdfdcc', shadow: false }); } });\n      for (const c of ctx.contestants) { if (c.life) continue; const p = r.w(c.x, 0, 0); c.rh.draw(r, many ? { x: p[0], y: r.H - 26, dir: 'down', len: 118, gap: 15, size: 6, arrows: true, colors: ['#ff7a59', '#2cc6e6', '#6fcf8e', '#b08be0'] } : { x: r.W / 2, y: r.H - 26, dir: 'down', len: r.H - 66, gap: 28, size: 11, arrows: true, colors: ['#ff7a59', '#2cc6e6', '#6fcf8e', '#b08be0'] }); }\n    }\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, many = ctx.contestants.length > 1;\n    if (ctx.live) G.drawTimer(g, G.left(ctx), { x: W - 34 });\n    for (const c of ctx.contestants) { const x = many ? game.r.w(c.x, 0, 0)[0] : W / 2;\n      if (c.jT > 0 && c.lastJ) txt(g, c.lastJ[0].toUpperCase() + c.lastJ.slice(1), x, many ? H - 62 : H / 2 - 30, c.lastJ === 'miss' ? '#e0553a' : '#14a8c8', { align: 'center', scale: many ? 1 : 2, shadow: '#ffffff' });\n      if (!many && c.rh.combo > 3) txt(g, c.rh.combo + ' in a row', W / 2, H / 2 - 12, '#5f7f8a', { align: 'center', shadow: '#ffffff' });\n      if (many) txt(g, c.name, x, H - 12, c.color, { align: 'center', shadow: '#ffffff' });\n    }\n    if (ctx.live && !many) G.prompts(g, [[game.input.lastDevice === 'gamepad' ? '=D-pad' : game.input.lastDevice === 'mouse' ? '=Buttons, wheel' : '=WASD / arrows', 'Step']], { x: W - 8, y: H - 18 });\n    if (ctx.flash > 0 && !many) { const k = Math.round(ctx.flash * 5); px.rect(g, W / 2 - 60, H - 8, 120, 1 + k > 1 ? 2 : 1, '#2cc6e6'); }\n  }\n});\n})();\nEOF\ngrep -n \"G.musicNow\\|let current\" game/audio.js | head; sed -i \"s#^G.musicNow = () => current;#G.musicNow = () => current;\\nG.musicClaim = name => { current = name; };#\" game/audio.js; grep -n \"o.dur ||\" game/activities/runtime.js | cut -c1-120; sed -i \"s/quiet: !!o.quiet, ghosts: new Map(), holdClock: false, short: !!o.short };/quiet: !!o.quiet, ghosts: new Map(), holdClock: false, short: !!o.short, durGiven: o.dur || 0, chartName: o.chart, laneActions: o.lanes };/\" game/activities/runtime.js; grep -c durGiven game/activities/runtime.js","description":"Write the candle, rep and step activity families"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6905,"cache_read_input_tokens":332777,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6905},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e35d4c2a-4185-48d4-8818-8a6b8bcd7047","uuid":"6f3e0d1d-c5ba-403c-8165-868b45ed5ba3","timestamp":"2026-11-05T05:36:09.301Z","request_id":"req_011CgjEUfsMWWQ37txvDp5qh","wire_tool_inputs":{"toolu_01VaWJUrigaMbmYVwFX89M9y":{"command":"cat > game/activities/candle.js <<'EOF'\n/* activities/candle.js: Quiet Candle, and its duel. The flame reacts to the speed of the dot: be still, gently. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\n/** a candle and its flame on the floor. flame 0..1 */\nG.drawCandle = (g, x, y, flame, s = 1, t = game.real) => {\n  x = Math.round(x); y = Math.round(y);\n  px.ell(g, x, y, 7 * s, 2 * s, '#c8b89a'); px.rect(g, x - 3 * s, y - 13 * s, 6 * s, 13 * s, '#fff8e8'); px.rect(g, x - 3 * s, y - 13 * s, 2 * s, 13 * s, '#ffffff'); px.rect(g, x + 1 * s, y - 13 * s, 2 * s, 13 * s, '#ecdfc4');\n  px.line(g, x, y - 13 * s, x, y - 15 * s, '#5a4a3a');\n  if (flame <= 0) return;\n  const h = (5 + 9 * flame) * s, w = (1.6 + 2.2 * flame) * s, sw = Math.sin(t * 9) * .9 * s + Math.sin(t * 23) * .4 * s, by = y - 15 * s;\n  px.blend(g, .28, 'add', () => px.disc(g, x, by - h * .4, (8 + 9 * flame) * s, '#ffb860'));\n  px.poly(g, [[x - w, by], [x - w * .8, by - h * .45], [x + sw, by - h], [x + w * .8, by - h * .45], [x + w, by]], '#ff9a3a');\n  px.poly(g, [[x - w * .55, by], [x - w * .45, by - h * .35], [x + sw * .6, by - h * .68], [x + w * .45, by - h * .35], [x + w * .55, by]], '#ffe27a');\n};\nconst THOUGHTS = () => G.DATA.lines.thoughts;\nconst bubble = (g, x, y, s, alpha) => { const w = E.font.width(s) + 12; G.panel(g, x - w / 2, y, w, 15, { r: 7, bg: '#ffffff', border: '#c8dde2' }); px.disc(g, x - 6, y + 18, 2, '#ffffff'); px.disc(g, x - 10, y + 22, 1, '#ffffff'); txt(g, s, x, y + 4, '#5f7f8a', { align: 'center' }); };\nconst DUEL = [\n  { at: 10, kind: 'gull', f: 3.2, dur: 5, line: 0 }, { at: 24, kind: 'blender', f: 3.6, dur: 6, line: 1 }, { at: 38, kind: 'conga', f: 4, dur: 7, line: 2 },\n  { at: 52, kind: 'fireworks', f: 4.2, dur: 6, line: 3 }, { at: 65, kind: 'sing', f: 4.2, dur: 6, line: 4 }, { at: 76, kind: 'goose', f: 5, dur: 6, line: 5 }\n];\nG.family('candle', {\n  camera: { zoom: false },\n  setup(ctx) {\n    ctx.thought = null; ctx.nextThought = 4; ctx.tSeq = 0; ctx.distract = null; ctx.dIdx = 0; ctx.duel = ctx.mode === 'duel'; ctx.herFlame = 1; ctx.fw = [];\n    if (ctx.duel) { ctx.her = G.regularRig('gertrude', ctx.size); ctx.herPoser = new G.Poser(ctx.her); ctx.herPoser.pose('sit', 0); }\n    ctx.contestants.forEach(c => {\n      c.bal = new G.Balance(ctx.tier.set, c.rng); c.bal.cheat = ctx.cheat; c.flame = 1; c.relit = false; c.out = false; c.flameSum = 0; c.poser.pose('sit', 0); c.flickT = 0;\n      if (ctx.contestants.length === 1) c.x = ctx.duel ? -70 : 0;\n      c.bal.onStumble = () => { c.fellT = 1; c.flame = Math.max(0, c.flame - .25); if (G.cue(ctx, c)) { G.A.sfx('stumble'); if (c.input) c.input.rumble(.6, .25); } };\n    });\n    ctx.extraT = 8; ctx.goose = null; ctx.blender = 0;\n  },\n  preview(dt, ctx) { for (const c of ctx.contestants) { c.poser.pose('sit'); c.poser.update(dt); c.rig.update(dt, { x: c.x, y: 0, z: 0, vx: 0, vy: 0, facing: c.poser.facing, expr: 'smile' }); } if (ctx.her) { ctx.herPoser.update(dt); ctx.her.update(dt, { x: 70, y: 0, z: 0, vx: 0, vy: 0, facing: ctx.herPoser.facing, expr: 'smile' }); } G.stageCam(26, 10); },\n  update(dt, ctx) {\n    const t = ctx.time, tier = ctx.tier; G.stageCam(26, 10);\n    /* thoughts drift in and push you slowly their way */\n    if (!ctx.thought && t >= ctx.nextThought && !ctx.duel) {\n      const a = ctx.rng() * 6.283, f = tier.thoughtForce[0] + ctx.rng() * (tier.thoughtForce[1] - tier.thoughtForce[0]), list = THOUGHTS(), s = list[ctx.tSeq++ % list.length];\n      ctx.thought = { a, f, t: 0, dur: 2.5, s }; ctx.nextThought = t + tier.thoughtEvery * (.8 + ctx.rng() * .4); if (ctx.local && !ctx.quiet) G.A.sfx('tick');\n    }\n    if (ctx.thought) { ctx.thought.t += dt; if (ctx.thought.t >= ctx.thought.dur) ctx.thought = null; }\n    /* Noisy Candle: Dennis's blender and a goose */\n    if (tier.extras && !ctx.duel) { ctx.extraT -= dt; if (ctx.extraT <= 0) { ctx.extraT = 11; const kind = ctx.rng() < .5 ? 'blender' : 'goose'; ctx.distract = { kind, t: 0, dur: 4, f: 3.5, a: ctx.rng() * 6.283 }; if (ctx.local && !ctx.quiet) G.A.sfx(kind); } }\n    /* the duel's distractions escalate */\n    if (ctx.duel && ctx.dIdx < DUEL.length && t >= DUEL[ctx.dIdx].at * ctx.dur / 90) {\n      const D = DUEL[ctx.dIdx++]; ctx.distract = { kind: D.kind, t: 0, dur: D.dur, f: D.f, a: ctx.rng() * 6.283 };\n      if (ctx.local && !ctx.quiet) { G.mutter('tare', G.DATA.lines.duel[D.line], { attract: true, auto: 3, face: 'worried' }); G.A.sfx({ gull: 'gull', blender: 'blender', conga: 'conga', fireworks: 'firework', goose: 'goose', sing: 'tareBoop' }[D.kind]); }\n    }\n    const dd = ctx.distract;\n    if (dd) { dd.t += dt; if (dd.kind === 'fireworks' && Math.floor(dd.t * 2) !== Math.floor((dd.t - dt) * 2)) { ctx.fw.push({ x: G.cosmetic(), y: .1 + G.cosmetic() * .25, t: 0, c: ['#ffd166', '#ff7a59', '#2cc6e6', '#f08fb0'][Math.floor(G.cosmetic() * 4)] }); if (!ctx.quiet) { G.A.sfx('firework'); game.flash('#ffe8c8', .08, .25); } }\n      if (dd.kind === 'sing' && Math.floor(dd.t * 2) !== Math.floor((dd.t - dt) * 2) && !ctx.quiet) G.say1('tare', 'la');\n      if (dd.kind === 'conga' && Math.floor(dd.t * 3) !== Math.floor((dd.t - dt) * 3) && !ctx.quiet) G.A.sfx('conga');\n      if (dd.t >= dd.dur) ctx.distract = null; }\n    for (const f of ctx.fw) f.t += dt; ctx.fw = ctx.fw.filter(f => f.t < 1);\n    for (const c of ctx.contestants) {\n      const b = c.bal, I = c.intent;\n      if (c.out) { b.fx = b.fy = 0; b.step(dt, 0, 0); b.totalT -= dt * 0; } else {\n        const th = ctx.thought, dk = dd && dd.t < dd.dur ? dd : null;\n        if (th) { b.fx += Math.cos(th.a) * th.f * G.DEV.push; b.fy += Math.sin(th.a) * th.f * G.DEV.push; }\n        if (dk) { b.fx += Math.cos(dk.a + dk.t) * dk.f * G.DEV.push; b.fy += Math.sin(dk.a + dk.t) * dk.f * G.DEV.push; }\n        // the input left perfectly alone: the thoughts drift you out, and Tare can tell\n        if (!I.touched && t > 20 && !ctx.duel && !c.skill) { b.fx += 4; if (!c.toldOff && G.cue(ctx, c)) { c.toldOff = true; G.mutter('tare', G.DATA.lines.tare.candleCheat, { face: 'judging', auto: 4 }); } }\n        b.step(dt, I.x, I.y);\n        const sp = Math.hypot(b.vx, b.vy);\n        if (sp > .55) { c.flame -= .4 * dt; c.flickT -= dt; if (c.flickT <= 0 && G.cue(ctx, c)) { G.A.sfx('flick', { vol: .5 + sp * .4 }); c.flickT = .25; if (c.input) c.input.rumble(.18, .08); } }\n        if (b.inRing) c.flame += .12 * dt;\n        c.flame = clamp(c.flame, 0, 1);\n        if (c.flame <= 0) {\n          if (ctx.cheat) c.flame = .4;\n          else if (!c.relit) { c.relit = true; c.flame = .55; if (G.cue(ctx, c)) { G.A.sfx('flick'); G.mutter('tare', 'It went out. I have relit it. I do not have hands. You owe me fifteen percent.', { face: 'worried', auto: 3 }); } }\n          else { c.out = true; if (ctx.contestants.filter(q => !q.life).every(q => q.out || q.life)) ctx.finished = true; if (G.cue(ctx, c)) G.A.sfx('tareSad'); }\n        }\n        c.flameSum += c.flame * dt;\n      }\n      c.poser.pose('sit'); c.poser.update(dt); c.rig.wob = [b.x * .8, b.y * .6];\n      c.rig.update(dt, { x: c.x, y: 0, z: 0, vx: 0, vy: 0, facing: c.poser.facing, expr: b.edge > .7 ? 'wince' : 'smile' });\n      G.feelBalance(ctx, c, dt);\n    }\n    if (ctx.duel) {\n      const me = ctx.contestants[0];\n      if (t > ctx.dur * 75 / 90 && me.flame > .5) ctx.herFlame = Math.max(0, ctx.herFlame - dt / (ctx.dur * 14 / 90));\n      if (ctx.herFlame <= 0) { ctx.won = true; ctx.finished = true; }\n      if (me.out) { ctx.won = false; ctx.finished = true; }\n      ctx.herPoser.update(dt); ctx.her.wob = [Math.sin(t * .4) * .015, 0]; ctx.her.update(dt, { x: 70, y: 0, z: 0, vx: 0, vy: 0, facing: ctx.herPoser.facing, expr: 'smile' });\n    }\n  },\n  result(ctx, c) {\n    const T = Math.max(ctx.time, 1), full = Math.max(ctx.dur, T), st = clamp(c.bal.inRingT / full, 0, 1), m = clamp(c.flameSum / full, 0, 1), pct = .6 * st + .4 * m - (c.relit ? .15 : 0);\n    return { pct, detail: 'Steadiness ' + Math.round(st * 100) + '%. Flame ' + Math.round(m * 100) + '%.' + (c.relit ? ' One relight.' : '') };\n  },\n  bot(ctx, c, dt) { const u = c.brain.hold(dt, c.bal, 0, 0); c.intent.x = u[0]; c.intent.y = u[1]; c.intent.touched = true; },\n  draw(r, ctx) {\n    (G.ROOMS[ctx.duel ? 'raft' : ctx.def.room] || G.ROOMS.deck)(r, { dusk: ctx.duel || (G.roomDusk && G.roomDusk()) });\n    for (const c of ctx.contestants) { G.drawMat(r, c.x, 0, 30 * (ctx.size / 2.1), 9, c.local ? '#bfeee0' : '#e8f0f2'); G.drawRig(r, c.rig, c.x, 0, 0); r.queue(c.x, 20, 0, g => { const p = r.w(c.x, 20, 0); G.drawCandle(g, p[0], p[1], c.out ? 0 : c.flame, ctx.size > 1.8 ? 1.2 : 1); }); }\n    if (ctx.duel) { G.drawMat(r, 70, 0, 30 * (ctx.size / 2.1), 9, '#d7c7ee'); G.drawRig(r, ctx.her, 70, 0, 0); r.queue(70, 20, 0, g => { const p = r.w(70, 20, 0); G.drawCandle(g, p[0], p[1], ctx.herFlame, 1.2); }); }\n    G.drawGhosts && G.drawGhosts(r, ctx);\n    const dd = ctx.distract;\n    if (dd) r.overlay(g => {\n      const W = game.W, H = game.H, k = dd.t / dd.dur;\n      if (dd.kind === 'gull') { for (let i = 0; i < 3; i++) { const x = W * k * 1.3 - 30 + i * 18, y = 40 + Math.sin(k * 20 + i) * 8 + i * 6, f = Math.sin(game.real * 14 + i) * 3; px.line(g, x - 6, y - f, x, y, '#ffffff', 2); px.line(g, x + 6, y - f, x, y, '#ffffff', 2); } }\n      if (dd.kind === 'blender') { const x = W * .84 + Math.sin(game.real * 60) * 1.5, y = H * .62; px.rect(g, x - 7, y, 14, 8, '#7a8a94'); px.poly(g, [[x - 8, y - 24], [x + 8, y - 24], [x + 6, y], [x - 6, y]], '#bfeee0'); px.rect(g, x - 8, y - 26, 16, 2, '#7a8a94'); txt(g, 'VRRRRR', x, y - 40, '#7a8a94', { align: 'center' }); }\n      if (dd.kind === 'conga') { for (let i = 0; i < 7; i++) { const x = (k * (W + 120)) - 90 + i * 16, y = H * .47 + Math.sin(game.real * 7 + i) * 2; px.rect(g, x - 3, y, 6, 12, ['#ff7a59', '#2cc6e6', '#f5c84b', '#6fcf8e'][i % 4]); px.disc(g, x, y - 3, 3, '#f2d3b8'); px.rect(g, x - 3, y + 12, 2, 6, '#3b5568'); px.rect(g, x + 1, y + 12, 2, 6, '#3b5568'); } }\n      if (dd.kind === 'sing') { const x = W * .5, y = H * .58 + Math.abs(Math.sin(game.real * 6)) * -6; G.drawTare(g, x, y, 1.4, { face: 'happy', squash: Math.sin(game.real * 12) * .1, bow: G.S.minutes >= 20 }); txt(g, '♪', x + 26, y - 26 - k * 10, '#14a8c8', { scale: 2 }); }\n      if (dd.kind === 'goose') { const x = W * (1.05 - k * 1.1), y = H * .72, b = Math.sin(game.real * 8) * 2; px.ell(g, x, y, 11, 7, '#fbfdfd'); px.ell(g, x + 1, y + 1, 10, 6, '#e3edef'); px.line(g, x - 8, y - 3, x - 12, y - 16 + b, '#fbfdfd', 3); px.disc(g, x - 12, y - 18 + b, 3, '#fbfdfd'); px.rect(g, x - 18, y - 18 + b, 4, 2, '#ff9a3a'); px.dot(g, x - 13, y - 19 + b, '#20404c'); px.rect(g, x - 2, y + 6, 1, 6, '#ff9a3a'); px.rect(g, x + 3, y + 6, 1, 6, '#ff9a3a'); }\n    });\n    if (ctx.fw.length) r.overlay(g => { for (const f of ctx.fw) { const x = f.x * game.W, y = f.y * game.H, R = 4 + f.t * 22; for (let i = 0; i < 10; i++) { const a = i / 10 * 6.283; px.rect(g, x + Math.cos(a) * R, y + Math.sin(a) * R + f.t * f.t * 8, 2, 2, f.c); } } });\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, many = ctx.contestants.length > 1;\n    if (ctx.live) G.drawTimer(g, G.left(ctx));\n    for (const c of ctx.contestants) { if (c.life) continue; if (many) G.manyPlate(g, ctx, c); else G.drawPlate(g, c.bal, { x: W / 2, y: H - 34, r: 26, ring: [0, 0, c.bal.R], color: c.color }); }\n    const m = ctx.local; if (m && !many) {\n      // the flame's level, in a shape and a number\n      const x = W / 2 - 70, y = H - 50; G.panel(g, x - 34, y - 4, 58, 32, { r: 7 }); txt(g, 'Flame', x - 5, y - 1, '#5f7f8a', { align: 'center' }); E.ui.bar(g, x - 30, y + 10, 50, 7, m.flame, m.flame > .5 ? '#ffb020' : '#ff7a59', { bg: '#e8f0f2' });\n      if (ctx.duel) { const hx = W / 2 + 70; G.panel(g, hx - 24, y - 4, 58, 32, { r: 7 }); txt(g, 'Gertrude', hx + 5, y - 1, '#5f7f8a', { align: 'center' }); E.ui.bar(g, hx - 20, y + 10, 50, 7, ctx.herFlame, '#b08be0', { bg: '#e8f0f2' }); }\n    }\n    const th = ctx.thought; if (th) { const k = th.t / th.dur, ox = Math.cos(th.a) * (40 + k * 26), oy = -Math.sin(th.a) * 16; const base = many ? game.r.w(0, 0, 58) : game.r.w(ctx.contestants[0].x, 0, 62); bubble(g, base[0] + ox, base[1] + oy - 12, th.s); }\n    if (ctx.live) G.prompts(g, [['lean', 'Gently']]);\n  }\n});\n})();\nEOF\ncat > game/activities/rep.js <<'EOF'\n/* activities/rep.js: the Rail. Squat, Push-Up and Side Lunge are one code path and three data rows. The lean IS the body:\n * holding the stick halfway holds you halfway. A bead rides the rail at the instructor's tempo. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game, lib = G.lib;\nconst txt = (...a) => G.txt(...a);\nconst smooth = u => u * u * (3 - 2 * u);\nconst bead = (tier, u) => { /* u in seconds inside one rep: down, a hold, up */ const { down, hold, up } = tier; if (u < down) return smooth(u / down); if (u < down + hold) return 1; return 1 - smooth(Math.min(1, (u - down - hold) / up)); };\nconst BOTS = { poor: { lead: .28, noise: .12, form: .4 }, average: { lead: .4, noise: .05, form: 1 }, good: { lead: .46, noise: .02, form: 1.4 }, expert: { lead: .5, noise: .008, form: 2 } };\nG.family('rep', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const { tier, def } = ctx, cyc = tier.down + tier.hold + tier.up;\n    ctx.cycle = cyc;\n    ctx.fixed = ctx.durGiven || ctx.short;\n    ctx.reps = ctx.fixed ? Math.max(3, Math.floor(ctx.dur / cyc)) : tier.reps;\n    ctx.dur = ctx.reps * cyc + .2;\n    ctx.fatigueFrom = Math.floor(ctx.reps * .6); ctx.extra = false; ctx.bead = 0; ctx.repI = 0; ctx.flash = null;\n    ctx.instructor = (ctx.mode === 'solo' || ctx.mode === 'games') ? (G.S.instructor || 'birch') : null;\n    if (ctx.instructor) { ctx.teacher = G.instructorRig(ctx.instructor, ctx.size); ctx.teacherPoser = new G.Poser(ctx.teacher); ctx.teacherX = 74; }\n    ctx.side = 1;\n    const axisX = def.axis === 'x', set = { k: 16, c: 8, s: 0, sx: axisX ? 0 : 8, sy: axisX ? 8 : 0, A: 1.1, nf: 1.1, R: .24 };\n    for (const c of ctx.contestants) {\n      c.bal = new G.Balance(set, c.rng); c.bal.cheat = ctx.cheat; c.repSum = 0; c.repN = 0; c.err = 0; c.errT = 0; c.total = 0; c.formSum = 0; c.formT = 0; c.grade = null; c.gradeT = 0; c.done = 0;\n      if (ctx.contestants.length === 1) c.x = ctx.instructor ? -34 : 0;\n      c.bal.onStumble = () => {};\n    }\n  },\n  preview(dt, ctx) {\n    G.stageCam();\n    const u = (game.real % ctx.cycle), b = bead(ctx.tier, u);\n    for (const c of ctx.contestants) G.repBody(ctx, c, c.poser, c.rig, 0, 0, c.x, 0, dt, 'smile');\n    if (ctx.teacher) G.repBody(ctx, null, ctx.teacherPoser, ctx.teacher, b * (ctx.def.axis === 'x' ? Math.sin(game.real * 3.14159 / ctx.cycle) >= 0 ? 1 : -1 : 1), 0, ctx.teacherX, -6, dt);\n  },\n  update(dt, ctx) {\n    const { tier, def } = ctx, t = ctx.time; G.stageCam();\n    const k = Math.floor(t / ctx.cycle), u = t - k * ctx.cycle;\n    /* a rep ends: score it */\n    if (k > ctx.repI) {\n      ctx.repI = k;\n      for (const c of ctx.contestants) {\n        const mean = c.errT > 0 ? c.err / c.errT : 1, tol = G.DEV.repTol, score = clamp((.35 * tol - mean) / ((.35 - .08) * tol), 0, 1);\n        c.repSum += score; c.repN++; c.err = 0; c.errT = 0; c.grade = score >= .85 ? 'Perfect' : score >= .5 ? 'Good' : 'Late'; c.gradeT = 1;\n        if (G.cue(ctx, c)) { if (score >= .85) G.A.sfx('hit'); else if (score >= .5) G.A.sfx('click'); else G.A.sfx('miss'); if (score > .5) G.grunt('member'); }\n      }\n      if (def.axis === 'x') ctx.side = -ctx.side;\n      /* \"Two more\": if you are scoring above .8, the instructor adds two bonus reps */\n      const lead = ctx.local || ctx.contestants[0];\n      if (!ctx.fixed && !ctx.extra && k === ctx.reps - 1 && lead.repN && lead.repSum / lead.repN > .8) { ctx.extra = true; ctx.reps += 2; ctx.dur = ctx.reps * ctx.cycle + .2; if (ctx.instructor) G.mutter(ctx.instructor, G.DATA.lines[ctx.instructor].moreFirst, { auto: 3 }); }\n    }\n    const raw = bead(tier, u), signed = def.axis === 'x' ? raw * ctx.side : raw; ctx.bead = signed;\n    /* fatigue: after 60% of the reps, the tremble rises and the response falls */\n    const fat = clamp((ctx.repI - ctx.fatigueFrom + u / ctx.cycle) / Math.max(1, ctx.reps - ctx.fatigueFrom), 0, 1) * G.DEV.fatigue;\n    for (const c of ctx.contestants) {\n      const b = c.bal, I = c.intent;\n      b.set.A = 1.1 * (1 + fat * 1.6); b.set.k = 16 * (1 - fat * .22);\n      b.ringX = def.axis === 'x' ? signed : 0; b.ringY = def.axis === 'x' ? 0 : -raw;\n      b.step(dt, I.x, I.y);\n      const val = def.axis === 'x' ? b.x : clamp(-b.y, 0, 1), form = def.axis === 'x' ? b.y : b.x;\n      c.err += Math.abs(val - signed) * dt; c.errT += dt; c.formSum += Math.abs(form) * dt; c.formT += dt; c.gradeT = Math.max(0, c.gradeT - dt); c.val = val; c.form = form;\n      G.repBody(ctx, c, c.poser, c.rig, val, form, c.x, 0, dt, Math.abs(form) > .35 || fat > .7 ? 'wince' : 'smile', fat);\n      if (G.cue(ctx, c) && Math.abs(form) > .45) { c.creakT = (c.creakT || 0) - dt; if (c.creakT <= 0) { G.A.sfx('creak'); c.creakT = .5; if (c.input) c.input.rumble(.3, .1); } }\n    }\n    if (ctx.teacher) G.repBody(ctx, null, ctx.teacherPoser, ctx.teacher, signed, 0, ctx.teacherX, -6, dt);\n  },\n  result(ctx, c) {\n    const mean = c.repN ? c.repSum / c.repN : 0, f = c.formT > 0 ? c.formSum / c.formT : 0, pen = clamp(Math.max(0, f - .06) * 1.2, 0, .3);\n    return { pct: mean * (1 - pen), detail: 'Reps ' + c.repN + '. Timing ' + Math.round(mean * 100) + '%. Form ' + Math.round((1 - pen / .3) * 100) + '%.' };\n  },\n  bot(ctx, c, dt) {\n    const B = BOTS[c.brain.skill], t = ctx.time + B.lead, k = Math.floor(t / ctx.cycle), raw = bead(ctx.tier, t - k * ctx.cycle), s = ctx.def.axis === 'x' ? (ctx.side * (k > ctx.repI ? -1 : 1)) : 1;\n    c.nz = c.nz || G.noise(c.rng, 2); const n = B.noise * c.nz(ctx.time), want = raw * s + n;\n    const b = c.bal, I = c.intent;\n    if (ctx.def.axis === 'x') { I.x = clamp(want, -1, 1); I.y = clamp(-b.y * B.form - b.vy * .3 + n, -1, 1); }\n    else { I.y = clamp(-want, -1, 1); I.x = clamp(-b.x * B.form - b.vx * .3 + n, -1, 1); }\n  },\n  ghost(ctx, c) { return { v: c.val || 0 }; },\n  draw(r, ctx) {\n    (G.ROOMS[ctx.def.room] || G.ROOMS.iron)(r, { dusk: G.roomDusk && G.roomDusk() });\n    for (const c of ctx.contestants) G.drawMat(r, c.x, 0, ctx.def.facing < .5 ? 42 : 30 * (ctx.size / 2.1), 9, c.local ? '#ffd8cc' : '#e8f0f2');\n    if (ctx.teacher) G.drawMat(r, ctx.teacherX, -6, ctx.def.facing < .5 ? 40 : 30 * (ctx.size / 2.1), 9, '#f4e6cf');\n    for (const c of ctx.contestants) G.drawRig(r, c.rig, c.x, 0, 0);\n    if (ctx.teacher) G.drawRig(r, ctx.teacher, ctx.teacherX, -6);\n    G.drawGhosts && G.drawGhosts(r, ctx);\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, many = ctx.contestants.length > 1, horiz = ctx.def.axis === 'x';\n    if (!ctx.live && !ctx.showHud) return;\n    if (ctx.live) { G.panel(g, 8, 6, 74, 20, { r: 8 }); txt(g, 'Rep ' + Math.min(ctx.repI + 1, ctx.reps) + ' / ' + ctx.reps, 45, 12, '#20404c', { align: 'center' }); }\n    for (const c of ctx.contestants) {\n      if (c.life) continue; const b = c.bal;\n      const base = game.r.w(c.x, 0, 0);\n      if (horiz) {   // a horizontal rail above the Plate's place\n        const y = many ? H - 30 : H - 26, w = many ? 34 : 86, x = base[0];\n        px.rect(g, x - w - 4, y - 2, 2 * w + 8, 5, '#c8dde2'); px.rect(g, x - w - 4, y - 1, 2 * w + 8, 2, '#ffffff'); px.rect(g, x, y - 4, 1, 9, '#7a8a94');\n        const bx = x + ctx.bead * w, mx = x + clamp(c.val || 0, -1, 1) * w; px.disc(g, bx, y, many ? 5 : 7, '#14a8c8'); px.disc(g, bx, y, many ? 3 : 5, '#7fe6f8'); px.disc(g, mx, y, many ? 3 : 4, '#20404c'); px.disc(g, mx, y, many ? 2 : 3, c.color);\n        if (c.gradeT > 0) txt(g, c.grade, x, y - (many ? 20 : 30), c.grade === 'Late' ? '#e0553a' : '#14a8c8', { align: 'center', scale: many ? 1 : 2, shadow: '#ffffff' });\n        if (many) txt(g, c.name, x, y + 8, c.color, { align: 'center', shadow: '#ffffff' });\n      } else {       // a vertical rail beside the rig\n        const x = base[0] + (many ? 26 : 46), top = base[1] - (many ? 52 : 74), h = many ? 54 : 78;\n        px.rect(g, x - 3, top - 4, 7, h + 8, '#c8dde2'); px.rect(g, x - 1, top - 4, 3, h + 8, '#ffffff');\n        const by = top + ctx.bead * h, my = top + (c.val || 0) * h; px.disc(g, x, by, many ? 5 : 7, '#14a8c8'); px.disc(g, x, by, many ? 3 : 5, '#7fe6f8'); px.disc(g, x, my, many ? 3 : 4, '#20404c'); px.disc(g, x, my, many ? 2 : 3, c.color);\n        if (c.gradeT > 0) txt(g, c.grade, x, top - 14, c.grade === 'Late' ? '#e0553a' : '#14a8c8', { align: 'center', scale: many ? 1 : 2, shadow: '#ffffff' });\n        if (many) txt(g, c.name, base[0], H - 12, c.color, { align: 'center', shadow: '#ffffff' });\n      }\n      if (!many && !horiz) G.drawPlate(g, b, { x: W / 2, y: H - 34, r: 26, ring: [b.ringX, b.ringY, b.R], color: c.color });\n    }\n    if (ctx.live) G.prompts(g, [['lean', ctx.def.axis === 'x' ? 'Lean with the bead' : 'Down with the bead']]);\n    if (G.DEV.trace && ctx.local) txt(g, 'err ' + (ctx.local.errT ? (ctx.local.err / ctx.local.errT).toFixed(3) : '-') + ' form ' + (ctx.local.form || 0).toFixed(2), W / 2, 40, '#20404c', { align: 'center', shadow: '#ffffff' });\n  }\n});\n/** one body at a depth: clip scrubbed, or a hand-posed lunge. The lean is the pose */\nG.repBody = (ctx, c, poser, rig, val, form, x, y, dt, expr, fat = 0) => {\n  const def = ctx.def;\n  if (def.bodyMove) { poser.off(); rig.body = G.moves[def.bodyMove](clamp(val, -1, 1)); rig.mocap = null; rig.update(dt, { x, y, z: 0, vx: 0, vy: 0, facing: def.facing, expr }); }\n  else { const cl = lib.clip(def.clip), bot = def.bottomShare !== undefined ? cl.dur * def.bottomShare : def.bottom, tt = def.top + (bot - def.top) * clamp(val, 0, 1); poser.scrub(def.clip, tt, def.facing); poser.update(dt); rig.update(dt, { x, y, z: 0, vx: 0, vy: 0, facing: poser.facing, expr }); }\n  const shake = fat > 0 ? Math.sin(game.real * 42) * .05 * fat : 0;\n  rig.wob = [clamp(form, -1, 1) * .55 + shake, 0];\n};\n})();\nEOF\ncat > game/data/charts.js <<'EOF'\n/* data/charts.js: step charts, a string a lane (left, down, up, right), 16 steps a bar. '.' alone is an empty lane.\n * order: the bars in turn. A chart's song and its bars give its length. */\n(() => {\nconst G = window.G, E16 = '................';\nG.DATA.charts = {\n  stepA: { song: 'stepA', bars: 25, parts: {\n    I: [E16, E16, E16, E16],\n    A: ['x.......x.......', '.', '.', '....x.......x...'],\n    B: ['x...x...x.......', '.', '.', '..........x...x.'],\n    C: ['x.......x...x...', '.', '.', '....x...........'],\n    D: ['x...............', '.', '.', '....x...x...x...'] },\n    order: 'I A A B A A C B A D A B C A A B D A C B A A D A B' },\n  stepB: { song: 'stepB', bars: 30, parts: {\n    I: [E16, E16, E16, E16],\n    A: ['x.......x.......', '....x...........', '............x...', '.'],\n    B: ['x...........x...', '........x.......', '....x...........', '.'],\n    C: ['x...............', '....x...x.......', '............x...', '..............x.'],\n    D: ['x.......x.......', '..............x.', '......x.........', '....x.......x...'],\n    E: ['x...x...........', '........x.......', '..........x.....', '............x...'] },\n    order: 'I A B A C B D A E C D B E A D C E D A B C A E D B C A D E A' },\n  // the Class's and a hub round's chart: left and right only\n  stepClass: { song: 'stepA', bars: 18, parts: {\n    I: [E16, E16, E16, E16],\n    A: ['x.......x.......', '.', '.', '....x.......x...'],\n    B: ['x...x...x.......', '.', '.', '............x...'] },\n    order: 'I A A B A B A A B A B A B A B A B A' }\n};\n})();\nEOF\ncat > game/activities/step.js <<'EOF'\n/* activities/step.js: Step Class. Four lanes on the music clock. Music is 10% by default, so the beat never depends on it:\n * a soft click on the sfx bus, and the instructor counts in gibberish. The rig steps when you press, not when the chart does. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst TIMING = { poor: { sd: 95, miss: .25 }, average: { sd: 62, miss: .08 }, good: { sd: 34, miss: .02 }, expert: { sd: 14, miss: 0 } };\nconst COUNT = ['one', 'two', 'tree', 'for'];\nconst NOINPUT = { pressed() { return false; }, released() { return false; }, down() { return false; } };\nlet beatHost = null; G.A.onBeat(b => { if (beatHost) beatHost(b); });\nconst stepSide = (k, side) => rig => { const b = G.moves.stepUp(k)(rig); if (side < 0) { const fl = b.footL, fr = b.footR; b.footL = [fr[0], -fr[1], fr[2]]; b.footR = [fl[0], -fl[1], fl[2]]; b.hip = [b.hip[0], -b.hip[1], b.hip[2]]; } return b; };\nG.family('step', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const { tier } = ctx, ch = G.DATA.charts[ctx.chartName || (ctx.mode === 'class' || ctx.mode === 'round' || ctx.short ? (ctx.tierIdx ? 'stepB' : 'stepClass') : tier.chart)], base = G.SONGS[ch.song];\n    const barSec = 60 / base.bpm * 4; const bars = Math.min(ch.bars, Math.ceil((ctx.durGiven || ch.bars * barSec) / barSec));\n    ctx.song = Object.assign({}, base, { len: bars * 16 });\n    ctx.dur = bars * barSec + .4; ctx.chart = ch; ctx.barSec = barSec; ctx.beat = 0; ctx.kick = 0; ctx.flash = 0;\n    const w = { perfect: 45 * G.DEV.window, great: 90 * G.DEV.window, good: 135 * G.DEV.window };\n    ctx.instructor = (ctx.mode === 'solo' || ctx.mode === 'games' || ctx.mode === 'attract') ? (G.S.instructor || 'birch') : null;\n    if (ctx.instructor) { ctx.teacher = G.instructorRig(ctx.instructor, ctx.size * .9); ctx.teacherX = 96; ctx.teacherK = 0; ctx.teacherSide = 1; }\n    if (ctx.mode !== 'class' && ctx.mode !== 'round') ctx.back = [['gertrude', -36, -30], ['marisol', 34, -32], ['kevin', 118, -30]].map(([id, x, y]) => ({ rig: G.regularRig(id, 1.4), x, y, k: 0, side: 1, poser: null }));\n    const lanes = ctx.laneActions || ['stepL', 'stepD', 'stepU', 'stepR'];\n    ctx.contestants.forEach((c, i) => {\n      const proxy = Object.create(game); Object.defineProperty(proxy, 'input', { value: c.input || NOINPUT });\n      c.rh = new E.Rhythm(proxy, { song: ctx.song, chart: ch, lanes: c.input ? (c.input.half || ctx.mode === 'class' ? ['left', 'down', 'up', 'right'] : lanes) : ['x', 'x', 'x', 'x'], windows: w, life: 1, lead: 1.5,\n        on: { judge: (j, n) => { c.lastJ = j; c.jT = .5; if (j !== 'miss' && G.cue(ctx, c)) G.A.sfx('hit', { vol: j === 'perfect' ? 1 : .6 }); if (j === 'miss' && G.cue(ctx, c)) { G.A.sfx('miss'); if (c.input) c.input.rumble(.2, .08); } } } });\n      if (ctx.contestants.length === 1) c.x = -96;\n      c.k = 0; c.side = 1; c.botI = 0; c.lastJ = null; c.jT = 0; c.steps = 0;\n      if (c.skill) { const T = TIMING[c.skill]; c.plan = c.rh.notes.map(() => ({ off: (c.rng() + c.rng() + c.rng() - 1.5) * T.sd * 1.15, skip: c.rng() < T.miss })); c.brain = c.brain || new G.BotBrain(c.skill, c.rng); }\n    });\n  },\n  begin(ctx) { /* the music starts on the first step of play */\n    const first = ctx.contestants[0]; first.rh.start(); for (const c of ctx.contestants.slice(1)) { c.rh.reset(); c.rh.started = true; }\n    G.musicClaim('step'); beatHost = b => {\n      ctx.beat = b; if (ctx.done) return; ctx.flash = 1;\n      if (!ctx.quiet) { G.A.sfx(b % 4 === 0 ? 'clickUp' : 'click'); if (ctx.instructor && b % 2 === 0) G.say1(ctx.instructor, COUNT[(b >> 1) % 4]); }\n      if (ctx.back) for (const q of ctx.back) { q.side = -q.side; q.k = 1; }\n      if (ctx.teacher) { ctx.teacherSide = -ctx.teacherSide; ctx.teacherK = 1; }\n    };\n    ctx.begun = true;\n  },\n  stop(ctx) { beatHost = null; for (const c of ctx.contestants) if (c.rh) c.rh.done = true; },\n  preview(dt, ctx) {\n    G.stageCam(32, 10);\n    for (const c of ctx.contestants) { c.rig.body = stepSide(0, 1); c.rig.update(dt, { x: c.x, y: 4, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n    if (ctx.teacher) { ctx.teacherK = Math.max(0, ctx.teacherK - dt * 3); if (Math.floor(game.real * 2) !== Math.floor((game.real - dt) * 2)) { ctx.teacherK = 1; ctx.teacherSide = -ctx.teacherSide; } ctx.teacher.body = stepSide(Math.sin(ctx.teacherK * Math.PI), ctx.teacherSide); ctx.teacher.update(dt, { x: ctx.teacherX, y: -8, z: 0, vx: 0, vy: 0, facing: 1.57 }); }\n    if (ctx.back) for (const q of ctx.back) { q.rig.body = stepSide(0, 1); q.rig.update(dt, { x: q.x, y: q.y, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n  },\n  update(dt, ctx) {\n    G.stageCam(32, 10);\n    if (!ctx.begun) G.families.step.begin(ctx);\n    ctx.flash = Math.max(0, ctx.flash - dt * 3);\n    const A = G.A;\n    for (const c of ctx.contestants) {\n      const rh = c.rh;\n      if (c.skill || (G.DEV.bot && c.local)) {   // a bot: each note a little off, by its skill\n        if (!c.plan) { const T = TIMING[G.DEV.bot]; c.plan = rh.notes.map(() => ({ off: (c.rng() + c.rng() + c.rng() - 1.5) * T.sd, skip: c.rng() < T.miss })); }\n        const s = A.pos.step, spb = 60 / ctx.song.bpm / ctx.song.steps;\n        while (c.botI < rh.notes.length) { const n = rh.notes[c.botI], pl = c.plan[c.botI], when = n.step + pl.off / 1000 / spb; if (s < when) break; c.botI++; if (!pl.skip && !n.call && !n.j) { rh.hit(n.lane); rh.release(n.lane); c.k = 1; c.side = n.lane === 0 || n.lane === 2 ? -1 : 1; c.steps++; } }\n      }\n      const before = rh.counts.perfect + rh.counts.great + rh.counts.good, I = c.input;\n      if (I && !(G.DEV.bot && c.local)) { const L = rh.lanes; let hit = false; for (let k = 0; k < 4; k++) if (L[k] !== 'x' && I.map[L[k]] && I.pressed(L[k])) { hit = true; c.k = 1; c.side = k === 0 || k === 2 ? -1 : 1; c.steps++; } }\n      rh.life = 1; rh.update(); rh.life = 1;\n      c.jT = Math.max(0, c.jT - dt);\n      c.k = Math.max(0, c.k - dt * 3.2);\n      c.rig.body = stepSide(Math.sin(c.k * Math.PI), c.side);\n      c.rig.update(dt, { x: c.x, y: 4, z: 0, vx: 0, vy: 0, facing: 1.57, expr: c.jT > 0 && c.lastJ === 'miss' ? 'wince' : 'smile' });\n    }\n    if (ctx.teacher) { ctx.teacherK = Math.max(0, ctx.teacherK - dt * 3); ctx.teacher.body = stepSide(Math.sin(ctx.teacherK * Math.PI), ctx.teacherSide); ctx.teacher.update(dt, { x: ctx.teacherX, y: -8, z: 0, vx: 0, vy: 0, facing: 1.57 }); }\n    if (ctx.back) for (const q of ctx.back) { q.k = Math.max(0, q.k - dt * 3); q.rig.body = stepSide(Math.sin(q.k * Math.PI), q.side); q.rig.update(dt, { x: q.x, y: q.y, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n    if (ctx.contestants[0].rh.done && ctx.time > 2) ctx.finished = true;\n  },\n  result(ctx, c) { const rh = c.rh, a = rh.counts.perfect + rh.counts.great + rh.counts.good + rh.counts.miss ? rh.accuracy : 0; return { pct: a, detail: 'Perfect ' + rh.counts.perfect + '. Great ' + rh.counts.great + '. Good ' + rh.counts.good + '. Missed ' + rh.counts.miss + '.' }; },\n  bot() { /* notes are hit in update, on the music clock */ },\n  ghost(ctx, c) { return { k: +c.k.toFixed(2), d: c.side }; },\n  draw(r, ctx) {\n    (G.ROOMS[ctx.def.room] || G.ROOMS.pier)(r, { dusk: G.roomDusk && G.roomDusk(), festive: ctx.mode === 'games' });\n    const bench = (x, y) => { const p = r.w(x - 22, y + 8, 0), q = r.w(x + 22, y + 8, 0), a = r.w(x - 22, y - 8, 6), b = r.w(x + 22, y - 8, 6); r.queue(x, y - 6, 0, g => { px.poly(g, [[a[0], a[1]], [b[0], b[1]], [q[0], q[1] - 9], [p[0], p[1] - 9]], '#f5f7f7'); px.rect(g, p[0], p[1] - 9, q[0] - p[0], 9, '#2cc6e6'); px.rect(g, p[0] + 3, p[1] - 2, 5, 2, '#20404c'); px.rect(g, q[0] - 8, q[1] - 2, 5, 2, '#20404c'); }); };\n    if (ctx.back) for (const q of ctx.back) { bench(q.x, q.y); G.drawRig(r, q.rig, q.x, q.y); }\n    if (ctx.teacher) { bench(ctx.teacherX, -8); G.drawRig(r, ctx.teacher, ctx.teacherX, -8); }\n    for (const c of ctx.contestants) { bench(c.x, 4); G.drawRig(r, c.rig, c.x, 4); }\n    G.drawGhosts && G.drawGhosts(r, ctx);\n    if (ctx.live || ctx.begun) {\n      const many = ctx.contestants.length > 1;\n      r.overlay(g => { if (!many) { G.panel(g, game.W / 2 - 62, 26, 124, game.H - 36, { r: 8, bg: '#fbfdfdcc', shadow: false }); } });\n      for (const c of ctx.contestants) { if (c.life) continue; const p = r.w(c.x, 0, 0); c.rh.draw(r, many ? { x: p[0], y: r.H - 26, dir: 'down', len: 118, gap: 15, size: 6, arrows: true, colors: ['#ff7a59', '#2cc6e6', '#6fcf8e', '#b08be0'] } : { x: r.W / 2, y: r.H - 26, dir: 'down', len: r.H - 66, gap: 28, size: 11, arrows: true, colors: ['#ff7a59', '#2cc6e6', '#6fcf8e', '#b08be0'] }); }\n    }\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, many = ctx.contestants.length > 1;\n    if (ctx.live) G.drawTimer(g, G.left(ctx), { x: W - 34 });\n    for (const c of ctx.contestants) { const x = many ? game.r.w(c.x, 0, 0)[0] : W / 2;\n      if (c.jT > 0 && c.lastJ) txt(g, c.lastJ[0].toUpperCase() + c.lastJ.slice(1), x, many ? H - 62 : H / 2 - 30, c.lastJ === 'miss' ? '#e0553a' : '#14a8c8', { align: 'center', scale: many ? 1 : 2, shadow: '#ffffff' });\n      if (!many && c.rh.combo > 3) txt(g, c.rh.combo + ' in a row', W / 2, H / 2 - 12, '#5f7f8a', { align: 'center', shadow: '#ffffff' });\n      if (many) txt(g, c.name, x, H - 12, c.color, { align: 'center', shadow: '#ffffff' });\n    }\n    if (ctx.live && !many) G.prompts(g, [[game.input.lastDevice === 'gamepad' ? '=D-pad' : game.input.lastDevice === 'mouse' ? '=Buttons, wheel' : '=WASD / arrows', 'Step']], { x: W - 8, y: H - 18 });\n    if (ctx.flash > 0 && !many) { const k = Math.round(ctx.flash * 5); px.rect(g, W / 2 - 60, H - 8, 120, 1 + k > 1 ? 2 : 1, '#2cc6e6'); }\n  }\n});\n})();\nEOF\ngrep -n \"G.musicNow\\|let current\" game/audio.js | head; sed -i \"s#^G.musicNow = () => current;#G.musicNow = () => current;\\nG.musicClaim = name => { current = name; };#\" game/audio.js; grep -n \"o.dur ||\" game/activities/runtime.js | cut -c1-120; sed -i \"s/quiet: !!o.quiet, ghosts: new Map(), holdClock: false, short: !!o.short };/quiet: !!o.quiet, ghosts: new Map(), holdClock: false, short: !!o.short, durGiven: o.dur || 0, chartName: o.chart, laneActions: o.lanes };/\" game/activities/runtime.js; grep -c durGiven game/activities/runtime.js","description":"Write the candle, rep and step activity families"}}}
