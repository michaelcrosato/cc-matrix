{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGkCeRqPAgc3vGGNcbZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NgAw9DR2RR1Mg4H8bHQXTN","name":"Bash","input":{"command":"cat > game/scenes/attract.js <<'EOF'\n/* scenes/attract.js: nobody's here, so Tare shows the empty room around. 10 s without input on the title or a top-level menu\n * starts it; any input returns and swallows the press. It cheats freely and never touches saves or unlocks. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst SLICE = 15;\nconst star = () => ({ name: 'Marisol', regular: 'marisol', skill: 'expert', local: true, color: '#ff7a59' });\nconst run = (id, o = {}) => ({ id, start() { game.setView(G.activities[id].view); this.ctx = G.makeRun(id, Object.assign({ tier: 0, mode: 'attract', dur: SLICE, short: true, cheat: true, seed: 55, contestants: [star()] }, o)); G.music(G.activities[id].music); },\n  update(dt) { G.stepRun(this.ctx, dt); if (this.ctx.done) { G.previewRun(this.ctx, dt); this.over = true; } }, draw(r) { G.drawRun(r, this.ctx); }, stop() { if (this.ctx.def.stop) this.ctx.def.stop(this.ctx); } });\nconst ITEMS = [\n  { id: 'island', start() { G.Island.build(); game.setView('threequarter'); this.b = new E.Body({ x: G.Island.door.x, y: G.Island.door.y + 8, r: 5 }); this.rig = G.regularRig('marisol', 1.05); this.tare = new G.TareBody(this.b.x, this.b.y + 16); this.tare.scale = .9; this.goalI = 0; this.goals = ['stork', 'squat', 'step', 'tray'].map(id => G.Island.mats.find(m => m.id === id)); G.Island.flow.update(this.goals[0].x, this.goals[0].y); game.cam.smooth = .15; game.cam.bounds = v => G.Island.map.bounds(v); G.music('islandAM'); G.setDayLight('morning'); },\n    update(dt) { const g0 = this.goals[this.goalI % 4], d = Math.hypot(g0.x - this.b.x, g0.y - this.b.y); if (d < 14) { this.goalI++; const n = this.goals[this.goalI % 4]; G.Island.flow.update(n.x, n.y); } const dd = G.Island.flow.dir(this.b.x, this.b.y, g0.x, g0.y) || [0, 0]; this.b.vx = dd[0] * 170; this.b.vy = dd[1] * 170; this.b.update(dt, G.Island.map); G.Island.updatePeople(dt); this.tare.update(dt, [this.b.x - 14, this.b.y + 12]); this.rig.update(dt, { x: this.b.x, y: this.b.y, z: 0, vx: this.b.vx * .6, vy: this.b.vy * .6, facing: Math.atan2(this.b.vy, this.b.vx), expr: 'smile' }); game.focus(this.b.x, this.b.y, 10); },\n    draw(r) { G.Island.drawWorld(r, { demo: true, allOpen: true }); G.drawRig(r, this.rig, this.b.x, this.b.y); this.tare.draw(r, { scale: .9 }); }, stop() { game.cam.bounds = null; game.cam.smooth = 0; G.L.enabled = false; } },\n  { id: 'bodycheck', start() { game.setView('brawler'); this.c = G.BodyCheck.make({ bot: 'expert', demo: true, rig: G.regularRig('marisol', 2) }); this.c.step = 'still'; G.music('studio'); },\n    update(dt) { G.stageCam(30, 8); const c = this.c; c.tare.update(dt); G.BodyCheck.stepRig(c, dt, true); if (c.step === 'still' || c.step === 'lean') { if (G.BodyCheck.tests(c, dt)) { c.step = 'reading'; c.t = 0; } } else { c.t += dt; } },\n    draw(r) { const c = this.c; G.BodyCheck.drawStage(r, c); r.overlay(g => { if (c.step === 'reading') { const W = game.W; G.panel(g, W / 2 - 120, 30, 240, 36, { r: 8 }); txt(g, 'Today you weigh ' + c.ducks.toFixed(1) + ' ducks.', W / 2, 36, '#20404c', { align: 'center' }); txt(g, 'That is a normal number of ducks.', W / 2, 48, '#5f7f8a', { align: 'center' }); } else G.BodyCheck.hudTests(g, c); }); }, stop() {} },\n  run('stork'), run('flow'), run('candle'), run('squat'), run('pushup'), run('lunge'), run('step'), run('hoop'), run('jog'), run('slalom'), run('tray'), run('laundry'),\n  { id: 'class4', start() { game.setView('brawler'); const who = ['gertrude', 'kevin', 'okafor', 'twin1']; this.ctx = G.makeRun('stork', { mode: 'class', dur: SLICE, short: true, cheat: true, seed: 77, contestants: who.map((id, i) => ({ name: 'P' + (i + 1), color: E.PLAYER_COLORS[i], regular: id, skill: ['good', 'expert', 'average', 'good'][i], local: i === 0 })) }); G.music('festival'); },\n    update(dt) { G.stepRun(this.ctx, dt); if (this.ctx.done) G.previewRun(this.ctx, dt); }, draw(r) { G.drawRun(r, this.ctx); }, stop() {} },\n  { id: 'results', start() { game.setView('brawler'); this.tare = new G.TareBody(-90, 10); this.tare.scale = 2; const def = G.activities.stork; this.res = new G.Results(def, 0, .97, 3, 'Steadiness 97%. Falls: 0.', { add: 2.5, got: [] }, {}); G.music('festival'); },\n    update(dt) { G.stageCam(30, 8); this.res.update(dt); this.tare.update(dt); }, draw(r) { G.ROOMS.studio(r); G.drawMat(r, -90, 10, 40, 10, '#bfeee0'); this.tare.draw(r, { scale: 2 }); r.overlay(g => this.res.draw(g)); }, stop() {} },\n  run('candle', { mode: 'duel', dur: SLICE })\n];\nITEMS[ITEMS.length - 1].id = 'duel';\nG.ATTRACT_ITEMS = ITEMS.map(i => i.id);\nlet saved = null, idx = 0, it = null, t = 0, lineT = 0, lineI = 0;\nconst open = i => { if (it && it.stop) it.stop(); idx = i % ITEMS.length; it = ITEMS[idx]; it.over = false; t = 0; G.talk.close(); G.L.enabled = false; it.start(); G.attractSeen = G.attractSeen || {}; G.attractSeen[it.id] = true; lineT = 1; };\nG.scenes.attract = {\n  view: 'brawler', camera: { zoom: false }, pausable: false,\n  enter() { saved = { s: G.S, slot: G.Save.slot, dev: Object.assign({}, G.DEV) }; G.attractOn = true; G.Save.slot = null; G.S = G.freshMember('Marisol'); G.S.instructor = 'alder'; G.S.arrived = true; G.S.checked = true; G.S.freePlay = true; G.dbg.activity = 'attract'; open(0); },\n  exit() { if (it && it.stop) it.stop(); it = null; G.talk.close(); G.S = saved.s; G.Save.slot = saved.slot; Object.assign(G.DEV, saved.dev); G.attractOn = false; game.cam.bounds = null; game.cam.smooth = 0; G.L.enabled = false; game.setView('brawler'); },\n  update(dt) {\n    t += dt; G.talk.update(dt); it.update(dt);\n    lineT -= dt; if (lineT <= 0) { lineT = 9; const L = G.DATA.lines.tare.attract; G.mutter('tare', L[lineI++ % L.length], { attract: true, auto: 3.4, face: 'happy' }); }\n    if (t >= SLICE) open(idx + 1);\n  },\n  draw(r) {\n    it.draw(r);\n    r.overlay(g => {\n      const W = game.W, H = game.H; G.panel(g, 8, H - 26, 44, 17, { r: 6, bg: '#ff7a59', border: '#e0553a' }); txt(g, 'DEMO', 30, H - 21, '#ffffff', { align: 'center' });\n      E.font.title(g, G.TITLE, W - 8, 4, { scale: 1, colors: ['#7fe6f8', '#14a8c8'], align: 'right', depth: 1, depthColor: '#0d7f97', outline: false });\n      if (Math.floor(game.real * 1.4) % 2 === 0) { const s = game.input.lastDevice === 'gamepad' ? 'Press any button' : 'Press any key'; G.panel(g, W / 2 - 58, H - 21, 116, 15, { r: 6 }); txt(g, s, W / 2, H - 17, '#20404c', { align: 'center' }); }\n    });\n    G.talk.draw(r);\n  },\n  now: () => idx\n};\n\n/* ---- the idle watch: 10 s without input on the title or a top-level menu starts it; any input ends it ---- */\nconst MENUS = new Set(['title', 'about', 'member']);\nlet idleT = 0, mt = -1, wasPad = 0;\ngame.hook('input', (g, dt) => {\n  if (G.inSession) return; const I = game.input, name = game.sceneName;\n  const stick = I.padMove ? Math.hypot(I.padMove[0], I.padMove[1]) : 0, moved = I.mouse && I.mouse.t !== mt; if (moved) mt = I.mouse.t;\n  const active = I.anyPressed() || stick > .25 || moved || !!I.clicked() || (I.held && I.held.size > 0);\n  if (name === 'attract') { if (active) { I.consumeAll(); G.go('title', { fromAttract: true }, { fade: 0 }); } idleT = 0; return; }\n  if (!MENUS.has(name) || G.talk.open || (game.shell && game.shell.screen) || game._fade) { idleT = 0; return; }\n  if (active) { idleT = 0; return; }\n  idleT += g.dt === undefined ? dt : dt; G.idleT = idleT;\n  if (idleT >= 10) { idleT = 0; G.go('attract', null, { fade: 0 }); }\n});\n})();\nEOF\ncat > game/dev.js <<'EOF'\n/* dev.js: Dev Mode, from the pause menu. A canvas panel on the left third; the game keeps running behind it, so balance\n * changes are felt live. Up/down moves, left/right adjusts (held accelerates, L1/R1 coarse), ✕ activates, ○ closes. Arrow\n * keys on a keyboard: WASD keeps leaning. Mouse: drag sliders; the pointer over the panel does not lean. Hidden in a session. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst JUMPS = () => [...G.order.map(id => ({ label: G.activities[id].short || G.activities[id].name, go() { G.devEnsure(); G.go(G.actScene(id), { tier: G.Dev.tier, from: 'dev', back: 'island' }, { fade: 0 }); } })),\n  ...[1, 2, 3, 4, 5, 6].map(d => ({ label: 'Day ' + d, go() { G.devEnsure(); G.S.day = d; G.S.session = 0; G.S.checked = false; G.S.tareDay = d > 4; G.go('bodycheck', { day: d }, { fade: 0 }); } })),\n  ...['title', 'island', 'member', 'arrival', 'evening', 'tareday', 'games', 'duel', 'ending', 'about', 'class', 'freeplay', 'attract'].map(n => ({ label: n, go() { G.devEnsure(); G.go(n, null, { fade: 0 }); } }))];\nG.devEnsure = () => { if (!G.S.instructor) G.S.instructor = 'birch'; G.S.arrived = true; };\nconst D = G.Dev = {\n  on: false, i: 0, top: 0, tier: 0, jump: 0, stars: 3, age: 40, botI: 0, viewer: null, step: false, log: '',\n  W() { return Math.floor(game.W * .36); },\n  overPanel() { if (!D.on) return false; const p = game.input.pointer(); return !!p && p[0] < D.W(); },\n  open() { if (G.inSession) return; D.on = true; D.i = 0; D.top = 0; game.resume(); game.input.consumeAll(); D.rows = D.build(); D.keys = {}; },\n  close() { D.on = false; D.viewer = null; game.input.consumeAll(); },\n  build() {\n    const rows = []; let grp = null;\n    for (const s of G.DEV_SPEC) { if (s.group !== grp) { grp = s.group; rows.push({ head: grp }); } rows.push({ spec: s }); }\n    rows.push({ head: 'Tools' });\n    const B = ['off', 'poor', 'average', 'good', 'expert'];\n    rows.push({ btn: () => 'Reset to defaults', act() { G.devReset(); D.note('Everything is back. It missed you.'); } });\n    rows.push({ pick: () => 'Jump: ' + JUMPS()[D.jump % JUMPS().length].label, adj(d) { const n = JUMPS().length; D.jump = (D.jump + d + n) % n; }, act() { JUMPS()[D.jump % JUMPS().length].go(); } });\n    rows.push({ pick: () => 'Tier: ' + (D.tier + 1), adj() { D.tier = 1 - D.tier; }, act() { D.tier = 1 - D.tier; } });\n    rows.push({ pick: () => 'Finish now: ' + D.stars + ' stars', adj(d) { D.stars = (D.stars + d + 4) % 4; }, act() { D.finish(); } });\n    rows.push({ btn: () => 'Unlock all', act() { G.S.freePlay = true; G.S.minutes = Math.max(G.S.minutes, 30); for (const u of G.DATA.unlocks) if (u.wear) G.S.wear[u.id] = true; D.note('All open. Gerald is very full.'); } });\n    rows.push({ btn: () => '+10 minutes', act() { const r = G.earnMinutes(0, 0, ''); G.S.minutes += 10; for (const u of G.DATA.unlocks) if (u.wear && G.S.minutes >= u.minutes) G.S.wear[u.id] = true; D.note('Minutes: ' + G.S.minutes.toFixed(1)); } });\n    rows.push({ pick: () => 'Set Spine Age: ' + D.age, adj(d) { D.age = clamp(D.age + d, 1, 71); }, act() { G.S.devAge = D.age; D.note('Spine Age is now ' + D.age); } });\n    rows.push({ btn: () => 'Reset this member', act() { const n = G.S.name, l = G.S.look; G.S = G.freshMember(n, l); G.S.instructor = 'birch'; G.S.arrived = true; G.S.checked = true; G.Save.save(); D.note('A fresh start. Tare remembers.'); } });\n    rows.push({ pick: () => 'No stumbles: ' + (G.DEV.noStumble ? 'on' : 'off'), adj() { G.DEV.noStumble = !G.DEV.noStumble; }, act() { G.DEV.noStumble = !G.DEV.noStumble; } });\n    rows.push({ pick: () => 'Bot plays: ' + (G.DEV.bot || 'off'), adj(d) { D.botI = (D.botI + d + 5) % 5; G.DEV.bot = D.botI ? B[D.botI] : null; }, act() { D.botI = (D.botI + 1) % 5; G.DEV.bot = D.botI ? B[D.botI] : null; } });\n    rows.push({ pick: () => 'Plate trace: ' + (G.DEV.trace ? 'on' : 'off'), adj() { G.DEV.trace = !G.DEV.trace; }, act() { G.DEV.trace = !G.DEV.trace; } });\n    rows.push({ btn: () => D.step ? 'Frame step: one more' : 'Frame step', act() { D.step = true; G.DEV.timeScale = 0; game.timeScale = 0; D.stepN = 1; } });\n    rows.push({ btn: () => 'Force attract', act() { D.close(); G.go('attract', null, { fade: 0 }); } });\n    rows.push({ btn: () => 'Pose Viewer', act() { D.openViewer(); } });\n    rows.push({ btn: () => 'Log snapshot', act() { console.log('Wee Teeter snapshot', JSON.stringify(game.debug.snapshot())); D.note('Logged to the console.'); } });\n    rows.push({ btn: () => 'Close', act() { D.close(); } });\n    return rows;\n  },\n  note(s) { D.log = s; D.logT = 3; G.A.sfx('ok'); },\n  finish() {\n    const sc = game.scene, r = sc && sc.run && sc.run(); if (!r || r.done) { D.note('No session is running.'); return; }\n    const def = r.def, c = r.local, t = G.starTargets(def), pct = D.stars === 0 ? 0 : D.stars === 3 ? Math.max(t[2], .95) : t[D.stars - 1] + .01; r.finished = true; const orig = def.result; G.endRun(r); for (const q of r.contestants) if (q.local) { q.pct = pct; q.stars = G.starsFor(def, pct); q.score = Math.round(pct * 1000); q.detail = 'Dev Mode finished this for you. Tare is not fooled.'; } D.note('Finished with ' + D.stars + ' stars.');\n  },\n  adjust(row, dir, big) {\n    if (row.adj) { row.adj(dir); G.A.sfx('tick'); return; }\n    const s = row.spec; if (!s) return;\n    if (s.options) { const k = s.options.indexOf(G.DEV[s.key]), n = s.options.length; G.DEV[s.key] = s.options[clamp((k < 0 ? 0 : k) + dir, 0, n - 1)]; }\n    else { const st = s.step * (big ? 5 : 1); G.DEV[s.key] = +clamp(Math.round((G.DEV[s.key] + dir * st) / s.step) * s.step, s.min, s.max).toFixed(3); }\n    G.A.sfx('tick', { vol: .5 });\n  },\n  openViewer() { const name = G.lib.names[0]; D.viewer = { i: 0, t: 0, rig: G.makeRig({ size: 2.1, colors: { cloth: '#ff7a59', pants: '#3b5568' } }) }; D.viewer.poser = new G.Poser(D.viewer.rig); },\n  edge(codes) { const I = game.input; let now = false; for (const c of codes) if (I.held.has(c)) now = true; return now; },\n  /** the input step: runs paused too */\n  input(dt) {\n    if (!D.on) return; const I = game.input;\n    const OWN = ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Pad12', 'Pad13', 'Pad14', 'Pad15', 'Pad0', 'Pad1', 'Pad4', 'Pad5', 'Enter', 'Backspace'];\n    const held = c => I.held.has(c);\n    const edges = {}; for (const c of OWN.concat(['Escape', 'Mouse0'])) { edges[c] = held(c) && !D.keys[c]; D.keys[c] = held(c); }\n    for (const c of OWN) I.suppressCode(c);\n    D.hold = D.hold || {}; const rep = (name, code, code2) => { const on = held(code) || held(code2); if (!on) { D.hold[name] = 0; return 0; } D.hold[name] = (D.hold[name] || 0) + dt; if (D.hold[name] === dt) return 1; const k = D.hold[name]; if (k > .35) { D.acc = D.acc || 0; D.acc += dt; const rate = k > 1.4 ? .025 : .07; if (D.acc >= rate) { D.acc = 0; return 1; } } return 0; };\n    const coarse = held('Pad4') || held('Pad5') || held('ShiftLeft');\n    if (D.viewer) { const v = D.viewer, n = G.lib.names.length, cl = G.lib.clip(G.lib.names[v.i]);\n      if (edges.ArrowUp || edges.Pad12) { v.i = (v.i + n - 1) % n; v.t = 0; } if (edges.ArrowDown || edges.Pad13) { v.i = (v.i + 1) % n; v.t = 0; }\n      if (rep('l', 'ArrowLeft', 'Pad14')) v.t = Math.max(0, v.t - (coarse ? .1 : .02)); if (rep('r', 'ArrowRight', 'Pad15')) v.t = Math.min(cl.dur, v.t + (coarse ? .1 : .02));\n      if (edges.Enter || edges.Pad0) { const row = \"  mypose: { clip: '\" + cl.name + \"', a: \" + v.t.toFixed(2) + \", b: \" + Math.min(cl.dur, v.t + 1).toFixed(2) + \", tgt: 1.57, name: 'My Pose' },\"; console.log(row); D.note('Pose row printed to the console.'); v.printed = row; }\n      if (edges.Escape || edges.Backspace || edges.Pad1) D.viewer = null;\n      I.suppress('pause'); I.suppress('cancel'); I.suppress('confirm');\n      v.poser.scrub(cl.name, v.t, 1.45); v.poser.update(dt || 1 / 120); v.rig.update(dt || 1 / 120, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: v.poser.facing });\n      return; }\n    if (edges.Escape || edges.Backspace || edges.Pad1) { D.close(); I.suppress('pause'); I.suppress('cancel'); return; }\n    if (rep('u', 'ArrowUp', 'Pad12')) D.moveFocus(-1); if (rep('d', 'ArrowDown', 'Pad13')) D.moveFocus(1);\n    const row = D.rows[D.i]; const l = rep('l', 'ArrowLeft', 'Pad14'), r = rep('r', 'ArrowRight', 'Pad15');\n    if (l && row) D.adjust(row, -1, coarse || (D.hold.l > 1)); if (r && row) D.adjust(row, 1, coarse || (D.hold.r > 1));\n    if ((edges.Enter || edges.Pad0) && row && row.act) { row.act(); G.A.sfx('ok'); }\n    if (G.game.timeScale !== G.DEV.timeScale) game.timeScale = G.DEV.timeScale;\n    if (D.stepN) { D.stepN--; game.timeScale = 1 / 8; G.DEV.timeScale = 0; D.stepping = true; } else if (D.stepping) { game.timeScale = 0; D.stepping = false; }\n    if (D.logT > 0) D.logT -= dt || 1 / 120;\n    /* the mouse: hover moves focus, drag sets a slider, a click activates */\n    const P = I.pointer(); if (P && P[0] < D.W()) { I.suppressCode('Mouse0'); I.suppress('breath'); const rows = D.visibleRows(); const hit = rows.find(q => P[1] >= q.y && P[1] < q.y + D.RH); if (I.mouse.t !== D.mt) { D.mt = I.mouse.t; if (hit) D.i = hit.i; }\n      if (held('Mouse0') && hit) { D.i = hit.i; const rw = D.rows[hit.i], x0 = 6, x1 = D.W() - 8; if (rw.spec && !rw.spec.options) { const s = rw.spec, k = clamp((P[0] - x0) / (x1 - x0), 0, 1); G.DEV[s.key] = +clamp(Math.round((s.min + (s.max - s.min) * k) / s.step) * s.step, s.min, s.max).toFixed(3); } }\n      if (edges.Mouse0 && hit) { const rw = D.rows[hit.i]; if (rw.act) { rw.act(); G.A.sfx('ok'); } else if (rw.spec && rw.spec.options) D.adjust(rw, 1); } }\n    I.clickedAtDev = false;\n  },\n  moveFocus(d) { const n = D.rows.length; let k = D.i; for (let t = 0; t < n; t++) { k = (k + d + n) % n; if (!D.rows[k].head) break; } D.i = k; G.A.sfx('tick', { vol: .5 }); },\n  RH: 13,\n  visibleRows() { const H = game.H, rows = D.rows, n = Math.floor((H - 26) / D.RH); if (D.i < D.top + 1) D.top = Math.max(0, D.i - 1); if (D.i >= D.top + n - 1) D.top = Math.min(rows.length - n, D.i - n + 2); D.top = Math.max(0, D.top); const out = []; for (let k = 0; k < n && D.top + k < rows.length; k++) out.push({ i: D.top + k, y: 20 + k * D.RH }); return out; },\n  draw(r) {\n    if (!D.on) return;\n    r.overlay(g => {\n      const W = D.W(), H = game.H;\n      px.blend(g, .92, 'normal', () => px.rect(g, 0, 0, W, H, '#f7fbfb')); px.rect(g, W, 0, 2, H, '#14a8c8');\n      txt(g, 'Dev Mode', 6, 5, '#14a8c8'); txt(g, game.sceneName, W - 6, 5, '#5f7f8a', { align: 'right' });\n      if (D.viewer) {\n        const v = D.viewer, cl = G.lib.clip(G.lib.names[v.i]);\n        txt(g, 'Pose Viewer', 6, 20, '#20404c'); txt(g, cl.name, 6, 32, '#14a8c8'); txt(g, 't ' + v.t.toFixed(2) + ' of ' + cl.dur.toFixed(2), 6, 42, '#5f7f8a');\n        E.ui.bar(g, 6, 54, W - 12, 6, v.t / cl.dur, '#2cc6e6', { bg: '#e8f0f2' }); G.wrapText(g, 'Up/down clip. Left/right scrub. Confirm prints a row for data/poses.js. Back closes.', 6, 66, W - 12, '#5f7f8a', {});\n        v.rig.draw(g, Math.round(W * .5), H - 18, E.VIEWS.brawler);\n        return;\n      }\n      for (const q of D.visibleRows()) {\n        const row = D.rows[q.i], foc = q.i === D.i, y = q.y;\n        if (row.head) { txt(g, row.head, 6, y + 3, '#14a8c8'); px.rect(g, 6, y + 11, W - 12, 1, '#c8dde2'); continue; }\n        if (foc) px.rect(g, 2, y, W - 4, D.RH - 1, '#d6f4fa');\n        if (row.spec) {\n          const s = row.spec, v = G.DEV[s.key], cur = s.options ? String(v) : (+v).toFixed(s.step < .1 ? 2 : s.step < 1 ? 2 : 0), changed = v !== s.def;\n          txt(g, s.label, 6, y + 1, '#20404c'); txt(g, cur, W - 6, y + 1, changed ? '#e0553a' : '#20404c', { align: 'right' });\n          if (!s.options) { const k = (v - s.min) / (s.max - s.min), k0 = (s.def - s.min) / (s.max - s.min), x0 = 6, x1 = W - 8; px.rect(g, x0, y + 9, x1 - x0, 2, '#c8dde2'); px.rect(g, x0, y + 9, (x1 - x0) * k, 2, '#14a8c8'); px.rect(g, x0 + (x1 - x0) * k0, y + 8, 1, 4, '#5f7f8a'); }\n        } else txt(g, (row.btn || row.pick)(), 6, y + 3, row.pick ? '#14a8c8' : '#20404c');\n      }\n      if (D.logT > 0) { G.panel(g, W + 8, 8, Math.min(game.W - W - 16, E.font.width(D.log) + 14), 15, { r: 6 }); txt(g, D.log, W + 15, 12, '#20404c'); }\n    });\n  }\n};\nif (!G.inSession) game.hook('input', (g, dt) => D.input(dt));\n/* every scene draws the panel last */\nfor (const name in G.scenes) { const s = G.scenes[name], d = s.draw; if (d) s.draw = function (r) { d.call(this, r); D.draw(r); }; }\n/* Tare counts your pauses, out loud */\nlet was = false;\ngame.hook('step', () => {\n  if (G.inSession) return;\n  const p = game.paused && !!game.scene && !!game.scene.pausable;\n  if (p && !was) { G.S.pauses = (G.S.pauses || 0) + 1; }\n  if (!p && was && !D.on && G.S && game.sceneName !== 'title') { const n = G.S.pauses; if (n === 3) G.pendingPauseLine = G.line('tare.paused', { n }); }\n  was = p;\n  if (G.pendingPauseLine && !game.paused && !G.talk.open) { G.mutter('tare', G.pendingPauseLine, { face: 'judging' }); G.pendingPauseLine = null; }\n});\n})();\nEOF\npython3 - <<'EOF'\np='game/core.js'; s=open(p).read()\ns=s.replace(\"G.spineAge = () => Math.max(1, Math.min(71, Math.round(78 - .58 * G.overall())) - (S().duelWon ? 1 : 0));\",\"G.spineAge = () => S().devAge || Math.max(1, Math.min(71, Math.round(78 - .58 * G.overall())) - (S().duelWon ? 1 : 0));\")\ns=s.replace(\"if (G.hub && G.hub.live && window.AIHub && AIHub.rng) return AIHub.rng(String(label));\",\"if (G.Hub && G.Hub.live && window.AIHub && AIHub.rng) return AIHub.rng(String(label));\")\nopen(p,'w').write(s)\nEOF\nnode build.mjs | tail -1; cat > tests/tools/smoke2.mjs <<'EOF'\nimport { load } from '../lib.mjs';\nconst { G, E, game, logs } = load({ draw: true });\ngame.fadeTime = 0; game.advance(.5);\nconst show = t => console.log(t, game.sceneName, game.errors.map(e => e.where + ': ' + e.message).slice(0, 3));\nshow('title');\nfor (const n of ['member', 'about', 'class', 'attract', 'title']) { G.devMember(2); G.go(n, null, { fade: 0 }); game.advance(.6); show(n); }\nG.devMember(2); G.go('island', null, { fade: 0 }); game.advance(.6); show('island');\ngame.input.hold('right'); game.advance(1); game.input.hold('right', false); show('walk');\nG.S.checked = false; G.go('bodycheck', { day: 2 }, { fade: 0 }); game.advance(1); show('bodycheck');\nG.go('evening', null, { fade: 0 }); game.advance(1); show('evening');\nG.go('tareday', null, { fade: 0 }); game.advance(1); show('tareday');\nG.go('games', null, { fade: 0 }); game.advance(1); show('games');\nG.go('ending', null, { fade: 0 }); game.advance(1); show('ending');\nG.go('freeplay', null, { fade: 0 }); game.advance(1); show('freeplay');\nfor (const id of G.order) { G.go(G.actScene(id), { tier: 0, from: 'dev' }, { fade: 0 }); game.advance(.2); game.input.tap('confirm'); game.advance(7.5); G.DEV.bot = 'good'; game.advance(5); G.DEV.bot = null; show(id + ':' + G.scenes[G.actScene(id)].phase()); }\nconsole.log(logs.slice(0, 6));\nEOF\nnode tests/tools/smoke2.mjs 2>&1 | tail -32 | cut -c1-220","description":"Write attract and Dev Mode, build, and smoke-test all scenes","timeout":180000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":24973,"cache_read_input_tokens":474131,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":24973},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e35d4c2a-4185-48d4-8818-8a6b8bcd7047","uuid":"95d2c9cd-6ff2-4d23-b136-8cefa82c0b3e","timestamp":"2026-11-05T06:02:50.364Z","request_id":"req_011CgjGkCL5UrKfgSEwv9m73","wire_tool_inputs":{"toolu_01NgAw9DR2RR1Mg4H8bHQXTN":{"command":"cat > game/scenes/attract.js <<'EOF'\n/* scenes/attract.js: nobody's here, so Tare shows the empty room around. 10 s without input on the title or a top-level menu\n * starts it; any input returns and swallows the press. It cheats freely and never touches saves or unlocks. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst SLICE = 15;\nconst star = () => ({ name: 'Marisol', regular: 'marisol', skill: 'expert', local: true, color: '#ff7a59' });\nconst run = (id, o = {}) => ({ id, start() { game.setView(G.activities[id].view); this.ctx = G.makeRun(id, Object.assign({ tier: 0, mode: 'attract', dur: SLICE, short: true, cheat: true, seed: 55, contestants: [star()] }, o)); G.music(G.activities[id].music); },\n  update(dt) { G.stepRun(this.ctx, dt); if (this.ctx.done) { G.previewRun(this.ctx, dt); this.over = true; } }, draw(r) { G.drawRun(r, this.ctx); }, stop() { if (this.ctx.def.stop) this.ctx.def.stop(this.ctx); } });\nconst ITEMS = [\n  { id: 'island', start() { G.Island.build(); game.setView('threequarter'); this.b = new E.Body({ x: G.Island.door.x, y: G.Island.door.y + 8, r: 5 }); this.rig = G.regularRig('marisol', 1.05); this.tare = new G.TareBody(this.b.x, this.b.y + 16); this.tare.scale = .9; this.goalI = 0; this.goals = ['stork', 'squat', 'step', 'tray'].map(id => G.Island.mats.find(m => m.id === id)); G.Island.flow.update(this.goals[0].x, this.goals[0].y); game.cam.smooth = .15; game.cam.bounds = v => G.Island.map.bounds(v); G.music('islandAM'); G.setDayLight('morning'); },\n    update(dt) { const g0 = this.goals[this.goalI % 4], d = Math.hypot(g0.x - this.b.x, g0.y - this.b.y); if (d < 14) { this.goalI++; const n = this.goals[this.goalI % 4]; G.Island.flow.update(n.x, n.y); } const dd = G.Island.flow.dir(this.b.x, this.b.y, g0.x, g0.y) || [0, 0]; this.b.vx = dd[0] * 170; this.b.vy = dd[1] * 170; this.b.update(dt, G.Island.map); G.Island.updatePeople(dt); this.tare.update(dt, [this.b.x - 14, this.b.y + 12]); this.rig.update(dt, { x: this.b.x, y: this.b.y, z: 0, vx: this.b.vx * .6, vy: this.b.vy * .6, facing: Math.atan2(this.b.vy, this.b.vx), expr: 'smile' }); game.focus(this.b.x, this.b.y, 10); },\n    draw(r) { G.Island.drawWorld(r, { demo: true, allOpen: true }); G.drawRig(r, this.rig, this.b.x, this.b.y); this.tare.draw(r, { scale: .9 }); }, stop() { game.cam.bounds = null; game.cam.smooth = 0; G.L.enabled = false; } },\n  { id: 'bodycheck', start() { game.setView('brawler'); this.c = G.BodyCheck.make({ bot: 'expert', demo: true, rig: G.regularRig('marisol', 2) }); this.c.step = 'still'; G.music('studio'); },\n    update(dt) { G.stageCam(30, 8); const c = this.c; c.tare.update(dt); G.BodyCheck.stepRig(c, dt, true); if (c.step === 'still' || c.step === 'lean') { if (G.BodyCheck.tests(c, dt)) { c.step = 'reading'; c.t = 0; } } else { c.t += dt; } },\n    draw(r) { const c = this.c; G.BodyCheck.drawStage(r, c); r.overlay(g => { if (c.step === 'reading') { const W = game.W; G.panel(g, W / 2 - 120, 30, 240, 36, { r: 8 }); txt(g, 'Today you weigh ' + c.ducks.toFixed(1) + ' ducks.', W / 2, 36, '#20404c', { align: 'center' }); txt(g, 'That is a normal number of ducks.', W / 2, 48, '#5f7f8a', { align: 'center' }); } else G.BodyCheck.hudTests(g, c); }); }, stop() {} },\n  run('stork'), run('flow'), run('candle'), run('squat'), run('pushup'), run('lunge'), run('step'), run('hoop'), run('jog'), run('slalom'), run('tray'), run('laundry'),\n  { id: 'class4', start() { game.setView('brawler'); const who = ['gertrude', 'kevin', 'okafor', 'twin1']; this.ctx = G.makeRun('stork', { mode: 'class', dur: SLICE, short: true, cheat: true, seed: 77, contestants: who.map((id, i) => ({ name: 'P' + (i + 1), color: E.PLAYER_COLORS[i], regular: id, skill: ['good', 'expert', 'average', 'good'][i], local: i === 0 })) }); G.music('festival'); },\n    update(dt) { G.stepRun(this.ctx, dt); if (this.ctx.done) G.previewRun(this.ctx, dt); }, draw(r) { G.drawRun(r, this.ctx); }, stop() {} },\n  { id: 'results', start() { game.setView('brawler'); this.tare = new G.TareBody(-90, 10); this.tare.scale = 2; const def = G.activities.stork; this.res = new G.Results(def, 0, .97, 3, 'Steadiness 97%. Falls: 0.', { add: 2.5, got: [] }, {}); G.music('festival'); },\n    update(dt) { G.stageCam(30, 8); this.res.update(dt); this.tare.update(dt); }, draw(r) { G.ROOMS.studio(r); G.drawMat(r, -90, 10, 40, 10, '#bfeee0'); this.tare.draw(r, { scale: 2 }); r.overlay(g => this.res.draw(g)); }, stop() {} },\n  run('candle', { mode: 'duel', dur: SLICE })\n];\nITEMS[ITEMS.length - 1].id = 'duel';\nG.ATTRACT_ITEMS = ITEMS.map(i => i.id);\nlet saved = null, idx = 0, it = null, t = 0, lineT = 0, lineI = 0;\nconst open = i => { if (it && it.stop) it.stop(); idx = i % ITEMS.length; it = ITEMS[idx]; it.over = false; t = 0; G.talk.close(); G.L.enabled = false; it.start(); G.attractSeen = G.attractSeen || {}; G.attractSeen[it.id] = true; lineT = 1; };\nG.scenes.attract = {\n  view: 'brawler', camera: { zoom: false }, pausable: false,\n  enter() { saved = { s: G.S, slot: G.Save.slot, dev: Object.assign({}, G.DEV) }; G.attractOn = true; G.Save.slot = null; G.S = G.freshMember('Marisol'); G.S.instructor = 'alder'; G.S.arrived = true; G.S.checked = true; G.S.freePlay = true; G.dbg.activity = 'attract'; open(0); },\n  exit() { if (it && it.stop) it.stop(); it = null; G.talk.close(); G.S = saved.s; G.Save.slot = saved.slot; Object.assign(G.DEV, saved.dev); G.attractOn = false; game.cam.bounds = null; game.cam.smooth = 0; G.L.enabled = false; game.setView('brawler'); },\n  update(dt) {\n    t += dt; G.talk.update(dt); it.update(dt);\n    lineT -= dt; if (lineT <= 0) { lineT = 9; const L = G.DATA.lines.tare.attract; G.mutter('tare', L[lineI++ % L.length], { attract: true, auto: 3.4, face: 'happy' }); }\n    if (t >= SLICE) open(idx + 1);\n  },\n  draw(r) {\n    it.draw(r);\n    r.overlay(g => {\n      const W = game.W, H = game.H; G.panel(g, 8, H - 26, 44, 17, { r: 6, bg: '#ff7a59', border: '#e0553a' }); txt(g, 'DEMO', 30, H - 21, '#ffffff', { align: 'center' });\n      E.font.title(g, G.TITLE, W - 8, 4, { scale: 1, colors: ['#7fe6f8', '#14a8c8'], align: 'right', depth: 1, depthColor: '#0d7f97', outline: false });\n      if (Math.floor(game.real * 1.4) % 2 === 0) { const s = game.input.lastDevice === 'gamepad' ? 'Press any button' : 'Press any key'; G.panel(g, W / 2 - 58, H - 21, 116, 15, { r: 6 }); txt(g, s, W / 2, H - 17, '#20404c', { align: 'center' }); }\n    });\n    G.talk.draw(r);\n  },\n  now: () => idx\n};\n\n/* ---- the idle watch: 10 s without input on the title or a top-level menu starts it; any input ends it ---- */\nconst MENUS = new Set(['title', 'about', 'member']);\nlet idleT = 0, mt = -1, wasPad = 0;\ngame.hook('input', (g, dt) => {\n  if (G.inSession) return; const I = game.input, name = game.sceneName;\n  const stick = I.padMove ? Math.hypot(I.padMove[0], I.padMove[1]) : 0, moved = I.mouse && I.mouse.t !== mt; if (moved) mt = I.mouse.t;\n  const active = I.anyPressed() || stick > .25 || moved || !!I.clicked() || (I.held && I.held.size > 0);\n  if (name === 'attract') { if (active) { I.consumeAll(); G.go('title', { fromAttract: true }, { fade: 0 }); } idleT = 0; return; }\n  if (!MENUS.has(name) || G.talk.open || (game.shell && game.shell.screen) || game._fade) { idleT = 0; return; }\n  if (active) { idleT = 0; return; }\n  idleT += g.dt === undefined ? dt : dt; G.idleT = idleT;\n  if (idleT >= 10) { idleT = 0; G.go('attract', null, { fade: 0 }); }\n});\n})();\nEOF\ncat > game/dev.js <<'EOF'\n/* dev.js: Dev Mode, from the pause menu. A canvas panel on the left third; the game keeps running behind it, so balance\n * changes are felt live. Up/down moves, left/right adjusts (held accelerates, L1/R1 coarse), ✕ activates, ○ closes. Arrow\n * keys on a keyboard: WASD keeps leaning. Mouse: drag sliders; the pointer over the panel does not lean. Hidden in a session. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst JUMPS = () => [...G.order.map(id => ({ label: G.activities[id].short || G.activities[id].name, go() { G.devEnsure(); G.go(G.actScene(id), { tier: G.Dev.tier, from: 'dev', back: 'island' }, { fade: 0 }); } })),\n  ...[1, 2, 3, 4, 5, 6].map(d => ({ label: 'Day ' + d, go() { G.devEnsure(); G.S.day = d; G.S.session = 0; G.S.checked = false; G.S.tareDay = d > 4; G.go('bodycheck', { day: d }, { fade: 0 }); } })),\n  ...['title', 'island', 'member', 'arrival', 'evening', 'tareday', 'games', 'duel', 'ending', 'about', 'class', 'freeplay', 'attract'].map(n => ({ label: n, go() { G.devEnsure(); G.go(n, null, { fade: 0 }); } }))];\nG.devEnsure = () => { if (!G.S.instructor) G.S.instructor = 'birch'; G.S.arrived = true; };\nconst D = G.Dev = {\n  on: false, i: 0, top: 0, tier: 0, jump: 0, stars: 3, age: 40, botI: 0, viewer: null, step: false, log: '',\n  W() { return Math.floor(game.W * .36); },\n  overPanel() { if (!D.on) return false; const p = game.input.pointer(); return !!p && p[0] < D.W(); },\n  open() { if (G.inSession) return; D.on = true; D.i = 0; D.top = 0; game.resume(); game.input.consumeAll(); D.rows = D.build(); D.keys = {}; },\n  close() { D.on = false; D.viewer = null; game.input.consumeAll(); },\n  build() {\n    const rows = []; let grp = null;\n    for (const s of G.DEV_SPEC) { if (s.group !== grp) { grp = s.group; rows.push({ head: grp }); } rows.push({ spec: s }); }\n    rows.push({ head: 'Tools' });\n    const B = ['off', 'poor', 'average', 'good', 'expert'];\n    rows.push({ btn: () => 'Reset to defaults', act() { G.devReset(); D.note('Everything is back. It missed you.'); } });\n    rows.push({ pick: () => 'Jump: ' + JUMPS()[D.jump % JUMPS().length].label, adj(d) { const n = JUMPS().length; D.jump = (D.jump + d + n) % n; }, act() { JUMPS()[D.jump % JUMPS().length].go(); } });\n    rows.push({ pick: () => 'Tier: ' + (D.tier + 1), adj() { D.tier = 1 - D.tier; }, act() { D.tier = 1 - D.tier; } });\n    rows.push({ pick: () => 'Finish now: ' + D.stars + ' stars', adj(d) { D.stars = (D.stars + d + 4) % 4; }, act() { D.finish(); } });\n    rows.push({ btn: () => 'Unlock all', act() { G.S.freePlay = true; G.S.minutes = Math.max(G.S.minutes, 30); for (const u of G.DATA.unlocks) if (u.wear) G.S.wear[u.id] = true; D.note('All open. Gerald is very full.'); } });\n    rows.push({ btn: () => '+10 minutes', act() { const r = G.earnMinutes(0, 0, ''); G.S.minutes += 10; for (const u of G.DATA.unlocks) if (u.wear && G.S.minutes >= u.minutes) G.S.wear[u.id] = true; D.note('Minutes: ' + G.S.minutes.toFixed(1)); } });\n    rows.push({ pick: () => 'Set Spine Age: ' + D.age, adj(d) { D.age = clamp(D.age + d, 1, 71); }, act() { G.S.devAge = D.age; D.note('Spine Age is now ' + D.age); } });\n    rows.push({ btn: () => 'Reset this member', act() { const n = G.S.name, l = G.S.look; G.S = G.freshMember(n, l); G.S.instructor = 'birch'; G.S.arrived = true; G.S.checked = true; G.Save.save(); D.note('A fresh start. Tare remembers.'); } });\n    rows.push({ pick: () => 'No stumbles: ' + (G.DEV.noStumble ? 'on' : 'off'), adj() { G.DEV.noStumble = !G.DEV.noStumble; }, act() { G.DEV.noStumble = !G.DEV.noStumble; } });\n    rows.push({ pick: () => 'Bot plays: ' + (G.DEV.bot || 'off'), adj(d) { D.botI = (D.botI + d + 5) % 5; G.DEV.bot = D.botI ? B[D.botI] : null; }, act() { D.botI = (D.botI + 1) % 5; G.DEV.bot = D.botI ? B[D.botI] : null; } });\n    rows.push({ pick: () => 'Plate trace: ' + (G.DEV.trace ? 'on' : 'off'), adj() { G.DEV.trace = !G.DEV.trace; }, act() { G.DEV.trace = !G.DEV.trace; } });\n    rows.push({ btn: () => D.step ? 'Frame step: one more' : 'Frame step', act() { D.step = true; G.DEV.timeScale = 0; game.timeScale = 0; D.stepN = 1; } });\n    rows.push({ btn: () => 'Force attract', act() { D.close(); G.go('attract', null, { fade: 0 }); } });\n    rows.push({ btn: () => 'Pose Viewer', act() { D.openViewer(); } });\n    rows.push({ btn: () => 'Log snapshot', act() { console.log('Wee Teeter snapshot', JSON.stringify(game.debug.snapshot())); D.note('Logged to the console.'); } });\n    rows.push({ btn: () => 'Close', act() { D.close(); } });\n    return rows;\n  },\n  note(s) { D.log = s; D.logT = 3; G.A.sfx('ok'); },\n  finish() {\n    const sc = game.scene, r = sc && sc.run && sc.run(); if (!r || r.done) { D.note('No session is running.'); return; }\n    const def = r.def, c = r.local, t = G.starTargets(def), pct = D.stars === 0 ? 0 : D.stars === 3 ? Math.max(t[2], .95) : t[D.stars - 1] + .01; r.finished = true; const orig = def.result; G.endRun(r); for (const q of r.contestants) if (q.local) { q.pct = pct; q.stars = G.starsFor(def, pct); q.score = Math.round(pct * 1000); q.detail = 'Dev Mode finished this for you. Tare is not fooled.'; } D.note('Finished with ' + D.stars + ' stars.');\n  },\n  adjust(row, dir, big) {\n    if (row.adj) { row.adj(dir); G.A.sfx('tick'); return; }\n    const s = row.spec; if (!s) return;\n    if (s.options) { const k = s.options.indexOf(G.DEV[s.key]), n = s.options.length; G.DEV[s.key] = s.options[clamp((k < 0 ? 0 : k) + dir, 0, n - 1)]; }\n    else { const st = s.step * (big ? 5 : 1); G.DEV[s.key] = +clamp(Math.round((G.DEV[s.key] + dir * st) / s.step) * s.step, s.min, s.max).toFixed(3); }\n    G.A.sfx('tick', { vol: .5 });\n  },\n  openViewer() { const name = G.lib.names[0]; D.viewer = { i: 0, t: 0, rig: G.makeRig({ size: 2.1, colors: { cloth: '#ff7a59', pants: '#3b5568' } }) }; D.viewer.poser = new G.Poser(D.viewer.rig); },\n  edge(codes) { const I = game.input; let now = false; for (const c of codes) if (I.held.has(c)) now = true; return now; },\n  /** the input step: runs paused too */\n  input(dt) {\n    if (!D.on) return; const I = game.input;\n    const OWN = ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Pad12', 'Pad13', 'Pad14', 'Pad15', 'Pad0', 'Pad1', 'Pad4', 'Pad5', 'Enter', 'Backspace'];\n    const held = c => I.held.has(c);\n    const edges = {}; for (const c of OWN.concat(['Escape', 'Mouse0'])) { edges[c] = held(c) && !D.keys[c]; D.keys[c] = held(c); }\n    for (const c of OWN) I.suppressCode(c);\n    D.hold = D.hold || {}; const rep = (name, code, code2) => { const on = held(code) || held(code2); if (!on) { D.hold[name] = 0; return 0; } D.hold[name] = (D.hold[name] || 0) + dt; if (D.hold[name] === dt) return 1; const k = D.hold[name]; if (k > .35) { D.acc = D.acc || 0; D.acc += dt; const rate = k > 1.4 ? .025 : .07; if (D.acc >= rate) { D.acc = 0; return 1; } } return 0; };\n    const coarse = held('Pad4') || held('Pad5') || held('ShiftLeft');\n    if (D.viewer) { const v = D.viewer, n = G.lib.names.length, cl = G.lib.clip(G.lib.names[v.i]);\n      if (edges.ArrowUp || edges.Pad12) { v.i = (v.i + n - 1) % n; v.t = 0; } if (edges.ArrowDown || edges.Pad13) { v.i = (v.i + 1) % n; v.t = 0; }\n      if (rep('l', 'ArrowLeft', 'Pad14')) v.t = Math.max(0, v.t - (coarse ? .1 : .02)); if (rep('r', 'ArrowRight', 'Pad15')) v.t = Math.min(cl.dur, v.t + (coarse ? .1 : .02));\n      if (edges.Enter || edges.Pad0) { const row = \"  mypose: { clip: '\" + cl.name + \"', a: \" + v.t.toFixed(2) + \", b: \" + Math.min(cl.dur, v.t + 1).toFixed(2) + \", tgt: 1.57, name: 'My Pose' },\"; console.log(row); D.note('Pose row printed to the console.'); v.printed = row; }\n      if (edges.Escape || edges.Backspace || edges.Pad1) D.viewer = null;\n      I.suppress('pause'); I.suppress('cancel'); I.suppress('confirm');\n      v.poser.scrub(cl.name, v.t, 1.45); v.poser.update(dt || 1 / 120); v.rig.update(dt || 1 / 120, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: v.poser.facing });\n      return; }\n    if (edges.Escape || edges.Backspace || edges.Pad1) { D.close(); I.suppress('pause'); I.suppress('cancel'); return; }\n    if (rep('u', 'ArrowUp', 'Pad12')) D.moveFocus(-1); if (rep('d', 'ArrowDown', 'Pad13')) D.moveFocus(1);\n    const row = D.rows[D.i]; const l = rep('l', 'ArrowLeft', 'Pad14'), r = rep('r', 'ArrowRight', 'Pad15');\n    if (l && row) D.adjust(row, -1, coarse || (D.hold.l > 1)); if (r && row) D.adjust(row, 1, coarse || (D.hold.r > 1));\n    if ((edges.Enter || edges.Pad0) && row && row.act) { row.act(); G.A.sfx('ok'); }\n    if (G.game.timeScale !== G.DEV.timeScale) game.timeScale = G.DEV.timeScale;\n    if (D.stepN) { D.stepN--; game.timeScale = 1 / 8; G.DEV.timeScale = 0; D.stepping = true; } else if (D.stepping) { game.timeScale = 0; D.stepping = false; }\n    if (D.logT > 0) D.logT -= dt || 1 / 120;\n    /* the mouse: hover moves focus, drag sets a slider, a click activates */\n    const P = I.pointer(); if (P && P[0] < D.W()) { I.suppressCode('Mouse0'); I.suppress('breath'); const rows = D.visibleRows(); const hit = rows.find(q => P[1] >= q.y && P[1] < q.y + D.RH); if (I.mouse.t !== D.mt) { D.mt = I.mouse.t; if (hit) D.i = hit.i; }\n      if (held('Mouse0') && hit) { D.i = hit.i; const rw = D.rows[hit.i], x0 = 6, x1 = D.W() - 8; if (rw.spec && !rw.spec.options) { const s = rw.spec, k = clamp((P[0] - x0) / (x1 - x0), 0, 1); G.DEV[s.key] = +clamp(Math.round((s.min + (s.max - s.min) * k) / s.step) * s.step, s.min, s.max).toFixed(3); } }\n      if (edges.Mouse0 && hit) { const rw = D.rows[hit.i]; if (rw.act) { rw.act(); G.A.sfx('ok'); } else if (rw.spec && rw.spec.options) D.adjust(rw, 1); } }\n    I.clickedAtDev = false;\n  },\n  moveFocus(d) { const n = D.rows.length; let k = D.i; for (let t = 0; t < n; t++) { k = (k + d + n) % n; if (!D.rows[k].head) break; } D.i = k; G.A.sfx('tick', { vol: .5 }); },\n  RH: 13,\n  visibleRows() { const H = game.H, rows = D.rows, n = Math.floor((H - 26) / D.RH); if (D.i < D.top + 1) D.top = Math.max(0, D.i - 1); if (D.i >= D.top + n - 1) D.top = Math.min(rows.length - n, D.i - n + 2); D.top = Math.max(0, D.top); const out = []; for (let k = 0; k < n && D.top + k < rows.length; k++) out.push({ i: D.top + k, y: 20 + k * D.RH }); return out; },\n  draw(r) {\n    if (!D.on) return;\n    r.overlay(g => {\n      const W = D.W(), H = game.H;\n      px.blend(g, .92, 'normal', () => px.rect(g, 0, 0, W, H, '#f7fbfb')); px.rect(g, W, 0, 2, H, '#14a8c8');\n      txt(g, 'Dev Mode', 6, 5, '#14a8c8'); txt(g, game.sceneName, W - 6, 5, '#5f7f8a', { align: 'right' });\n      if (D.viewer) {\n        const v = D.viewer, cl = G.lib.clip(G.lib.names[v.i]);\n        txt(g, 'Pose Viewer', 6, 20, '#20404c'); txt(g, cl.name, 6, 32, '#14a8c8'); txt(g, 't ' + v.t.toFixed(2) + ' of ' + cl.dur.toFixed(2), 6, 42, '#5f7f8a');\n        E.ui.bar(g, 6, 54, W - 12, 6, v.t / cl.dur, '#2cc6e6', { bg: '#e8f0f2' }); G.wrapText(g, 'Up/down clip. Left/right scrub. Confirm prints a row for data/poses.js. Back closes.', 6, 66, W - 12, '#5f7f8a', {});\n        v.rig.draw(g, Math.round(W * .5), H - 18, E.VIEWS.brawler);\n        return;\n      }\n      for (const q of D.visibleRows()) {\n        const row = D.rows[q.i], foc = q.i === D.i, y = q.y;\n        if (row.head) { txt(g, row.head, 6, y + 3, '#14a8c8'); px.rect(g, 6, y + 11, W - 12, 1, '#c8dde2'); continue; }\n        if (foc) px.rect(g, 2, y, W - 4, D.RH - 1, '#d6f4fa');\n        if (row.spec) {\n          const s = row.spec, v = G.DEV[s.key], cur = s.options ? String(v) : (+v).toFixed(s.step < .1 ? 2 : s.step < 1 ? 2 : 0), changed = v !== s.def;\n          txt(g, s.label, 6, y + 1, '#20404c'); txt(g, cur, W - 6, y + 1, changed ? '#e0553a' : '#20404c', { align: 'right' });\n          if (!s.options) { const k = (v - s.min) / (s.max - s.min), k0 = (s.def - s.min) / (s.max - s.min), x0 = 6, x1 = W - 8; px.rect(g, x0, y + 9, x1 - x0, 2, '#c8dde2'); px.rect(g, x0, y + 9, (x1 - x0) * k, 2, '#14a8c8'); px.rect(g, x0 + (x1 - x0) * k0, y + 8, 1, 4, '#5f7f8a'); }\n        } else txt(g, (row.btn || row.pick)(), 6, y + 3, row.pick ? '#14a8c8' : '#20404c');\n      }\n      if (D.logT > 0) { G.panel(g, W + 8, 8, Math.min(game.W - W - 16, E.font.width(D.log) + 14), 15, { r: 6 }); txt(g, D.log, W + 15, 12, '#20404c'); }\n    });\n  }\n};\nif (!G.inSession) game.hook('input', (g, dt) => D.input(dt));\n/* every scene draws the panel last */\nfor (const name in G.scenes) { const s = G.scenes[name], d = s.draw; if (d) s.draw = function (r) { d.call(this, r); D.draw(r); }; }\n/* Tare counts your pauses, out loud */\nlet was = false;\ngame.hook('step', () => {\n  if (G.inSession) return;\n  const p = game.paused && !!game.scene && !!game.scene.pausable;\n  if (p && !was) { G.S.pauses = (G.S.pauses || 0) + 1; }\n  if (!p && was && !D.on && G.S && game.sceneName !== 'title') { const n = G.S.pauses; if (n === 3) G.pendingPauseLine = G.line('tare.paused', { n }); }\n  was = p;\n  if (G.pendingPauseLine && !game.paused && !G.talk.open) { G.mutter('tare', G.pendingPauseLine, { face: 'judging' }); G.pendingPauseLine = null; }\n});\n})();\nEOF\npython3 - <<'EOF'\np='game/core.js'; s=open(p).read()\ns=s.replace(\"G.spineAge = () => Math.max(1, Math.min(71, Math.round(78 - .58 * G.overall())) - (S().duelWon ? 1 : 0));\",\"G.spineAge = () => S().devAge || Math.max(1, Math.min(71, Math.round(78 - .58 * G.overall())) - (S().duelWon ? 1 : 0));\")\ns=s.replace(\"if (G.hub && G.hub.live && window.AIHub && AIHub.rng) return AIHub.rng(String(label));\",\"if (G.Hub && G.Hub.live && window.AIHub && AIHub.rng) return AIHub.rng(String(label));\")\nopen(p,'w').write(s)\nEOF\nnode build.mjs | tail -1; cat > tests/tools/smoke2.mjs <<'EOF'\nimport { load } from '../lib.mjs';\nconst { G, E, game, logs } = load({ draw: true });\ngame.fadeTime = 0; game.advance(.5);\nconst show = t => console.log(t, game.sceneName, game.errors.map(e => e.where + ': ' + e.message).slice(0, 3));\nshow('title');\nfor (const n of ['member', 'about', 'class', 'attract', 'title']) { G.devMember(2); G.go(n, null, { fade: 0 }); game.advance(.6); show(n); }\nG.devMember(2); G.go('island', null, { fade: 0 }); game.advance(.6); show('island');\ngame.input.hold('right'); game.advance(1); game.input.hold('right', false); show('walk');\nG.S.checked = false; G.go('bodycheck', { day: 2 }, { fade: 0 }); game.advance(1); show('bodycheck');\nG.go('evening', null, { fade: 0 }); game.advance(1); show('evening');\nG.go('tareday', null, { fade: 0 }); game.advance(1); show('tareday');\nG.go('games', null, { fade: 0 }); game.advance(1); show('games');\nG.go('ending', null, { fade: 0 }); game.advance(1); show('ending');\nG.go('freeplay', null, { fade: 0 }); game.advance(1); show('freeplay');\nfor (const id of G.order) { G.go(G.actScene(id), { tier: 0, from: 'dev' }, { fade: 0 }); game.advance(.2); game.input.tap('confirm'); game.advance(7.5); G.DEV.bot = 'good'; game.advance(5); G.DEV.bot = null; show(id + ':' + G.scenes[G.actScene(id)].phase()); }\nconsole.log(logs.slice(0, 6));\nEOF\nnode tests/tools/smoke2.mjs 2>&1 | tail -32 | cut -c1-220","description":"Write attract and Dev Mode, build, and smoke-test all scenes","timeout":180000}}}
