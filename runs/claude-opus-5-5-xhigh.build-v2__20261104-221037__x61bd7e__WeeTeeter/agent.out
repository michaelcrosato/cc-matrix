.size || m.size;\",\"ctx.size = o.size || def.rigSize || m.size;\")\n# I slalom\nsub('game/activities/slalom.js',\"\"\"const SNOW = (x, y) => { const n = Math.sin(x * .071) * Math.sin(y * .053) + .6 * Math.sin((x + y) * .019) + .3 * Math.sin(x * .3 + y * .17); const v = 240 + n * 4; return [v - 7, v - 1, Math.min(255, v + 8)]; };\"\"\",\n\"\"\"const SNOW = (x, y) => { const n = Math.sin(x * .071) * Math.sin(y * .053) + .6 * Math.sin((x + y) * .019) + .3 * Math.sin(x * .3 + y * .17), band = Math.sin(y * .05) * 5 + Math.sin(y * .013) * 4, cord = Math.sin(x * .9) > .7 ? -3 : 0, sp = ((Math.floor(x / 9) * 73 + Math.floor(y / 13) * 37) % 41 === 0) ? -14 : 0; const v = 238 + n * 3 + band + cord + sp; return [v - 8, v - 2, Math.min(255, v + 8)]; };\"\"\")\nsub('game/activities/slalom.js',\"new E.Mode7({ floor: SNOW, size: [1024, 1024], wrap: true, far: 1500,\",\"new E.Mode7({ floor: SNOW, size: [1024, 1024], wrap: true, far: 1700, outside: '#eaf4f8', fog: { color: '#eaf4f8', near: 800, far: 1700 },\")\nsub('game/activities/slalom.js',\"ctx.side = []; for (let i = -2; i < use + 4; i++) for (const s of [-1, 1]) ctx.side.push({ x: s * (240 + ((i * 53 + (s + 1) * 37) % 70)), y: -i * co.spacing * .34 * 3 });\",\n\"ctx.side = []; for (let i = -6; i < (use + 4) * 7; i++) for (const s of [-1, 1]) ctx.side.push({ x: s * (232 + ((i * 53 + (s + 1) * 37) % 80)), y: -i * co.spacing / 7, sc: 1.4 + ((i * 31 + s * 7) % 5 + 5) % 5 * .18 });\")\nsub('game/activities/slalom.js',\"if (vis(s)) m7.sprite(PINE, s.x, s.y, 0, { scale: 1.7 });\",\"if (vis(s)) m7.sprite(PINE, s.x, s.y, 0, { scale: s.sc });\")\nsub('game/activities/slalom.js',\"const h = 34 * k; px.rect(g, sx - Math.max(.5, k * .6), sy - h, Math.max(1, k * 1.2), h, '#5a6a74'); const fw = 13 * k, fh = 9 * k;\",\"const h = 46 * k; px.rect(g, sx - Math.max(.5, k * .9), sy - h, Math.max(1, k * 1.8), h, '#5a6a74'); const fw = 19 * k, fh = 14 * k;\")\nsub('game/activities/slalom.js',\"if (ctx.course.fog) m7.o.fog = ctx.course.fog; else delete m7.o.fog;\",\"m7.o.fog = ctx.course.fog || { color: '#eaf4f8', near: 800, far: 1700 };\")\nsub('game/activities/slalom.js',\"G.prompts(g, [['lean', 'Lean. Forward tucks. Back brakes.']]);\",\"G.prompts(g, [['lean', 'Lean']]);\")\nsub('game/activities/slalom.js',\"back: 72, h: 42, angle\",\"back: 64, h: 40, angle\")\n# K title layout\nsub('game/scenes/title.js',\"pills = new G.Pills(items, { x: () => game.W / 2, y: () => Math.round(game.H * .36), w: 150, h: 18, gap: 4, onPick(i, it) {\",\"pills = new G.Pills(items, { x: () => Math.round(game.W * .69), y: () => Math.round(game.H * .3), w: 150, h: 19, gap: 5, onPick(i, it) {\")\nsub('game/scenes/title.js',\"tare = new G.TareBody(0, 2); tare.scale = 2;\",\"tare = new G.TareBody(-74, 8); tare.scale = 3;\")\nsub('game/scenes/title.js',\"G.drawMat(r, 0, 2, 44, 12, '#bfeee0');\\n    tare.draw(r, { scale: 2 });\",\"G.drawMat(r, -74, 8, 54, 15, '#bfeee0');\\n    tare.draw(r, { scale: 3 });\")\n# L mutter\nsub('game/audio.js',\"G.say(who, t, Object.assign({ modal: false, auto: Math.max(2, t.length / 22), place: 'top', alpha: .94 }, o));\",\"G.say(who, t, Object.assign({ modal: false, auto: Math.max(2, t.length / 22), place: 'top', y: 32, alpha: .94, portraitSize: 24 }, o));\")\n# M session showHud\nsub('game/scenes/session.js',\"function go(p) {\\n    phase = p; t = 0; countdown = 0;\",\"function go(p) {\\n    phase = p; t = 0; countdown = 0; ctx.showHud = p === 'demo' || p === 'breathe';\")\n# N dialog box shadow\nsub('engine/my-3d2dge.js',\"ui.box(g, d.x, d.y, d.w, d.h, { bg: this.bg, border: this.border, alpha: this._alpha });\",\"ui.box(g, d.x, d.y, d.w, d.h, { bg: this.bg, border: this.border, alpha: this._alpha, shadow: this.shadow === undefined ? undefined : '#20404c30' });\")\nsub('engine/my-3d2dge.js',\"ui.box(g, nx, d.y - 12, nw, 14, { bg: this.bg, border: this.border }); E.font.text(g, this.name, nx + 6, d.y - 9,\",\"ui.box(g, nx, d.y - 12, nw, 14, { bg: this.bg, border: this.border, shadow: this.shadow === undefined ? undefined : '#20404c30' }); E.font.text(g, this.name, nx + 6, d.y - 9,\")\nEOF\ngrep -n \"portraitSize\\|_pSize\" engine/my-3d2dge.js | head -5 | cut -c1-200; node build.mjs | tail -1 | cut -c150-; cat > tests/tools/poses.py <<'EOF'\n# contact sheet of the pose table on the player's rig and the mannequin\nimport sys, os\nfrom playwright.sync_api import sync_playwright\nstem = 'WeeTeeter-WiiFit-claude-opus-5-5-xhigh-20261104-221037.html'\npath = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', '..', stem))\nwith sync_playwright() as p:\n    b = p.chromium.launch(); pg = b.new_page(viewport={'width': 1280, 'height': 720})\n    pg.goto('file://' + path)\n    pg.wait_for_function('window.G && G.game && G.game.sceneName === \"title\"', timeout=30000)\n    pg.evaluate('''() => { const game = G.game, E = My3D2dge; game.fadeTime = 0; G.devMember(1);\n      const names = Object.keys(G.DATA.poses), rigs = names.map((n, i) => { const r = G.memberRig({hair:'short',skin:1,top:0,bottom:0},{}, {size:1.3}), P = new G.Poser(r); P.pose(n,0); return {n, r, P}; });\n      G.scenes.poses = game.scenes.poses = { view:'brawler', camera:{zoom:false}, update(dt){ G.stageCam(30,8); rigs.forEach((q,i)=>{ q.P.update(dt); q.r.update(dt,{x:0,y:0,z:0,vx:0,vy:0,facing:q.P.facing}); }); }, draw(r){ G.ROOMS.studio(r); rigs.forEach((q,i)=>{ const cols=5, x=-120+(i%cols)*62, y=-30+Math.floor(i/cols)*70; r.actor(x,y,0,(g,ox,oy)=>q.r.draw(g,ox,oy,r.view)); r.textAt(x,y,-6,q.n,'#20404c'); }); } };\n      game.go('poses',null,{fade:0}); }''')\n    pg.wait_for_timeout(2500)\n    pg.screenshot(path=sys.argv[1])\n    b.close()\nEOF\npython3 tests/tools/poses.py shots/poses.png","description":"Apply the layout fixes, rebuild and shoot a pose contact sheet","timeout":90000}}}
