{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjGEw3kufDByabRbyBQJ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QzTuFbPGJoyqZy7ZdeNgEu","name":"Bash","input":{"command":"cat > game/data/island.js <<'EOF'\n/* data/island.js: Lumbar Island as text, 44 x 26. ~ sea, , grass, . sand, = pier, ^ snow, p path, d deck, i iron room\n * floor, k park. R B J are buildings. 1-9 a b c are mats. E Tare's scale, @ the door, Z the bed, W the rail, G D M K O L T\n * the Regulars. Move a letter and the thing moves: nothing else to change. */\n(() => {\nconst G = window.G;\nG.DATA.island = { rows: [\n    '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~,,,,,,,,,,~~~~~~~~~~~~~~~~~',\n    '~~~~~~~~~~~~~^^^,,,,,,,,,,,,,,,~~~~~~~~~~~~~',\n    '~~~~~~~~~~^^^^^^,RRRRRRR,,,,dddddddddd~~~~~~',\n    '~~~~~~~~^^^^^^^^^RRRRRRR,,,,d1dd2dd3dd~~~~~~',\n    '~~~~~~^^^^^^^^^^^RRRRRRR,,,,dddddddddd~~~~~~',\n    '~~~~~^^^^^^^^^^^^,,,pp,,T,,,dddddddddd,~~~~~',\n    '~~~~^^^^^^^^^^^^,,,,Ep,,,,,,ddddpddddd,,~~~~',\n    '~~~^^^^^^^^^^^^^K,,,,p,,,,G,,,,,p,,,,,,,,~~~',\n    '~~,^^^^^^^^^^^,,,,,,,p,,,,,,,,,,p,,,,,,,,,~~',\n    '~~,,,^^^pppppppppppppp,,,,,,,,,,piiiiiiii,~~',\n    '~~,BBBBBB,,,,,,,,,,,,p,,,,,,,,,,pii4ii5ii,~~',\n    '~~,BBBBBB,pppppppppppppppppppppppiiiiiiii,~~',\n    '~~.BBBBBB,p,,,,,,,,,,p,,,,,,,,M,,iiiiiiii.~~',\n    '~~.BBBBBB,p,,,,,,,,,,p,,,,,,,,,,,ii6iiiii.~~',\n    '~~,,Z,@,,,p,,,,,,,,JJJJJJ,,,,,,,,iiiiiiii.~~',\n    '~~,,,,ppWpp,,,,,,,,JJJJJJ,,,,,,,,,,,,,,...~~',\n    '~~,,,,,,,,,,,L,,,,,,,D,,,,,,,,,,,,,,,,...~~~',\n    '~~~~...,,,,,,,pppppppp,,pppbpppO,,,,,...~~~~',\n    '~~~~~...,kkkkkkkkkkkkp,,,,,,,p,,,,,,...~~~~~',\n    '~~~~~~...kkakkkkkkckk,,,,,==7====8====~~~~~~',\n    '~~~~~~~~.kkkkkkkkkkkk,,,,,============~~~~~~',\n    '~~~~~~~~~~......,,,,,,,,,,,,...=======~~~~~~',\n    '~~~~~~~~~~~~~..................====9==~~~~~~',\n    '~~~~~~~~~~~~~~~~~..........~~~~~~~~~~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~' ],\n  mats: { 1: 'stork', 2: 'flow', 3: 'candle', 4: 'squat', 5: 'pushup', 6: 'lunge', 7: 'step', 8: 'hoop', 9: 'jog', a: 'tray', b: 'laundry', c: 'slalom' },\n  floors: { 1: 'deck', 2: 'deck', 3: 'deck', 4: 'iron', 5: 'iron', 6: 'iron', 7: 'pier', 8: 'pier', 9: 'pier', a: 'park', b: 'path', c: 'park' },\n  people: { G: 'gertrude', D: 'dennis', M: 'marisol', K: 'kevin', O: 'okafor', L: 'lou', T: 'twins' }\n};\n})();\nEOF\npython3 - <<'EOF'\nimport json\nf=json.load(open('game/files.json'))\nif 'game/data/island.js' not in f:\n    f.insert(f.index('game/data/unlocks.js')+1,'game/data/island.js')\njson.dump(f,open('game/files.json','w'),indent=0)\nEOF\ncat > game/scenes/island.js <<'EOF'\n/* scenes/island.js: The Institute for Gentle Improvement, on Lumbar Island. Walk, talk, stand on a mat. Motto on every sign. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst CELL = 16, SPEED = 132;\nconst COL = { sea: [73, 182, 201], grass: [150, 214, 139], sand: [244, 231, 196], pier: [201, 174, 136], snow: [240, 248, 252], path: [236, 222, 192], deck: [224, 196, 158], iron: [238, 244, 244], park: [176, 224, 160] };\nconst floorTex = (x, y, tag) => {\n  const c = COL[tag] || COL.grass, n = E.hash2 ? E.hash2(Math.floor(x / 2), Math.floor(y / 2)) : 0;\n  if (tag === 'pier' || tag === 'deck') { const line = (Math.floor(y) % 8 === 0) ? -26 : 0, jit = (n - .5) * 8; return [c[0] + line + jit, c[1] + line + jit, c[2] + line + jit]; }\n  if (tag === 'iron') { const line = (Math.floor(x) % 16 === 0 || Math.floor(y) % 16 === 0) ? -14 : 0; return [c[0] + line, c[1] + line, c[2] + line]; }\n  if (tag === 'sea') { const w = Math.sin(x * .12 + Math.sin(y * .08) * 2) * 8 + (n - .5) * 4; return [c[0] - 12 + w, c[1] - 8 + w, c[2] - 2 + w]; }\n  const jit = (n - .5) * (tag === 'grass' || tag === 'park' ? 16 : 7); return [c[0] + jit, c[1] + jit, c[2] + jit];\n};\n/** builds the map and the places on it, once */\nconst Isl = G.Island = {\n  built: false,\n  build() {\n    if (Isl.built) return; Isl.built = true;\n    const D = G.DATA.island, legend = { '~': { floor: 'sea', block: true }, ',': { floor: 'grass' }, '.': { floor: 'sand' }, '=': { floor: 'pier' }, '^': { floor: 'snow' }, 'p': { floor: 'path' }, 'd': { floor: 'deck' }, 'i': { floor: 'iron' }, 'k': { floor: 'park' }, 'R': { tile: 1, floor: 'grass' }, 'B': { tile: 2, floor: 'grass' }, 'J': { tile: 3, floor: 'grass' }, 'E': { floor: 'path', spawn: 'scale' }, '@': { floor: 'path', spawn: 'door' }, 'Z': { floor: 'grass', spawn: 'bed' }, 'W': { floor: 'path', spawn: 'rail' } };\n    for (const k in D.mats) legend[k] = { floor: D.floors[k], spawn: 'mat_' + D.mats[k] };\n    for (const k in D.people) legend[k] = { floor: 'grass', spawn: 'p_' + D.people[k] };\n    Isl.map = new E.TileMap({ rows: D.rows, legend, ao: 4, outside: '#2f97ad', floorTex,\n      types: { 1: { h: 32, top: '#ff9a7a', side: '#fbf6ec', face: 'plaster', roof: 'tiles', windows: { w: 6, h: 8, step: 22, from: 10 } }, 2: { h: 28, top: '#7fd8ea', side: '#fbf6ec', face: 'plaster', roof: 'tiles', windows: { w: 6, h: 8, step: 20, from: 9 }, door: { chance: .3, color: '#c49c6c' } }, 3: { h: 12, top: '#f5c84b', side: '#e8a07a', face: 'plank', roof: 'plain' } } });\n    const map = Isl.map; Isl.flow = new E.FlowField(map);\n    Isl.mats = []; for (const k in D.mats) { const id = D.mats[k], s = map.find('mat_' + id); Isl.mats.push({ kind: 'mat', id, x: s.x, y: s.y, r: 18, label: G.activities[id].short || G.activities[id].name }); }\n    Isl.people = [];\n    for (const k in D.people) { const id = D.people[k], s = map.find('p_' + id), rig = G.regularRig(id === 'twins' ? 'twin1' : id, 1.05), pe = { kind: 'person', id, x: s.x, y: s.y, r: 15, label: G.DATA.lines.regulars[id].name, rig, hx: s.x, hy: s.y, ph: E.hash2 ? E.hash2(s.x, s.y) * 6 : 0 }; pe.poser = new G.Poser(rig); if (id === 'twins') { pe.rig2 = G.regularRig('twin2', 1.05); } Isl.people.push(pe); }\n    Isl.scale = Object.assign(map.find('scale'), { kind: 'tare', id: 'tare', r: 15, label: 'Tare' });\n    Isl.bed = Object.assign(map.find('bed'), { kind: 'bed', id: 'bed', r: 16, label: 'Bed' });\n    Isl.rail = Object.assign(map.find('rail'), { kind: 'rail', id: 'rail', r: 13, label: 'The rail' });\n    Isl.door = map.find('door');\n    /* the scatter: a little of everything */\n    const rng = E.rng(4242); Isl.scatter = [];\n    const R = D.rows;\n    for (let i = 0; i < 260; i++) { const cx = Math.floor(rng() * 44), cy = Math.floor(rng() * 26), ch = R[cy][cx], x = cx * CELL + 8 + (rng() - .5) * 10, y = cy * CELL + 8 + (rng() - .5) * 10, v = rng();\n      if (ch === ',') { if (v < .22) Isl.scatter.push({ p: 'palm', x, y, s: 1.3, solid: true }); else if (v < .42) Isl.scatter.push({ p: 'bush', x, y, s: .9 }); else if (v < .78) Isl.scatter.push({ p: 'flowers', x, y, s: 1 }); else Isl.scatter.push({ p: 'grass', x, y, s: 1 }); }\n      else if (ch === '^') { if (v < .55) Isl.scatter.push({ p: 'pine', x, y, s: 1.2 + v }); else Isl.scatter.push({ p: 'rock', x, y, s: .8, color: '#dbe7ea' }); }\n      else if (ch === '.') { if (v < .22) Isl.scatter.push({ p: 'palm', x, y, s: 1.2 }); else if (v < .4) Isl.scatter.push({ p: 'rock', x, y, s: .6, color: '#c8b89a' }); } }\n    Isl.scatter = Isl.scatter.filter(s => !Isl.mats.concat(Isl.people, [Isl.scale, Isl.bed, Isl.rail]).some(q => Math.hypot(q.x - s.x, q.y - s.y) < 22));\n    Isl.lamps = [[20, 9], [26, 12], [14, 12], [32, 9], [24, 18], [11, 15], [33, 22]].map(([cx, cy]) => ({ x: cx * CELL + 8, y: cy * CELL + 8 }));\n    Isl.glints = []; for (let i = 0; i < 120; i++) { const cx = Math.floor(rng() * 44), cy = Math.floor(rng() * 26); if (R[cy][cx] === '~') Isl.glints.push({ x: cx * CELL + rng() * 16, y: cy * CELL + rng() * 16, k: rng() * 6 }); }\n    Isl.signs = [{ x: 21 * CELL, y: 8 * CELL + 4, t: G.DATA.lines.motto }, { x: 28 * CELL, y: 2.7 * CELL, t: 'Stillness Deck' }, { x: 36 * CELL, y: 9.6 * CELL, t: 'Iron Room' }, { x: 33 * CELL, y: 19.5 * CELL, t: 'Aerobics Pier' }, { x: 15 * CELL, y: 18.7 * CELL, t: 'Balance Park' }, { x: 6 * CELL, y: 10.5 * CELL, t: 'Bungalow' }, { x: 21 * CELL, y: 14.5 * CELL, t: 'Juice Bar' }, { x: 20 * CELL, y: 2.6 * CELL, t: 'Reception' }];\n  },\n  /** the regulars walk small loops */\n  updatePeople(dt) {\n    for (const p of Isl.people) {\n      p.ph += dt * .35;\n      if (p.id === 'lou') { p.poser.clip('Sleeping', { loop: true, tgt: 1.57 }); p.poser.update(dt); p.rig.update(dt, { x: p.x, y: p.y, z: 0, vx: 0, vy: 0, facing: p.poser.facing }); continue; }\n      const k = p.id === 'marisol' ? 28 : p.id === 'gertrude' ? 0 : 6, nx = p.hx + Math.cos(p.ph) * k, ny = p.hy + Math.sin(p.ph * (p.id === 'marisol' ? 2 : 1)) * k * .5, vx = (nx - p.x) / Math.max(dt, .001), vy = (ny - p.y) / Math.max(dt, .001); p.x = nx; p.y = ny;\n      p.rig.update(dt, { x: p.x, y: p.y, z: 0, vx: k ? vx : 0, vy: k ? vy : 0, facing: k ? Math.atan2(vy, vx) : 1.57, expr: 'smile' });\n      if (p.rig2) { p.rig2.update(dt, { x: p.x + 14, y: p.y, z: 0, vx, vy, facing: Math.atan2(vy, vx), expr: 'smile' }); }\n    }\n  },\n  drawWorld(r, o = {}) {\n    const map = Isl.map, t = game.real;\n    map.drawFloor(r);\n    /* the sea glints */\n    r.decal(g => { for (const q of Isl.glints) if (Math.sin(t * 1.2 + q.k) > .45) { const p = r.w(q.x, q.y, 0); px.rect(g, p[0], p[1], 5, 1, '#b8ecf2'); } });\n    map.queueWalls(r);\n    for (const s of Isl.scatter) r.prop(s.p, s.x, s.y, 0, { size: s.s, color: s.color });\n    /* mats */\n    r.decal(g => {\n      for (const m of Isl.mats) {\n        const open = o.allOpen || G.activityOpen(m.id), a = r.w(m.x - 16, m.y - 9, 0), b = r.w(m.x + 16, m.y + 9, 0), dcol = { Stillness: '#b08be0', Strength: '#ff7a59', Cardio: '#2cc6e6', Balance: '#6fcf8e' }[G.activities[m.id].discipline], glow = .5 + .5 * Math.sin(t * 2.4 + m.x), hov = o.focus === m;\n        px.rect(g, a[0] - 3, a[1] - 3, b[0] - a[0] + 6, b[1] - a[1] + 6, hov ? '#ffffff' : open ? E.mix(dcol, '#ffffff', glow * .6) : '#c8d0d4');\n        px.rect(g, a[0], a[1], b[0] - a[0], b[1] - a[1], open ? dcol : '#a8b4ba');\n        px.rect(g, a[0] + 3, a[1] + 3, b[0] - a[0] - 6, 1, '#ffffff'); px.rect(g, a[0] + 3, b[1] - 4, b[0] - a[0] - 6, 1, '#ffffff');\n      }\n    });\n    for (const m of Isl.mats) { const st = G.S.best[m.id] ? G.bestStars(m.id) : 0; if (st && !o.demo) r.textAt(m.x, m.y, 2, '★'.repeat(st), '#ffb020'); if (G.S.suggestion === m.id && !G.S.freePlay && !o.demo) r.queue(m.x, m.y - 1, 22, g => { const p = r.w(m.x, m.y, 20 + Math.sin(t * 3) * 3); E.font.text(g, '★', p[0], p[1], '#ffb020', { align: 'center', scale: 2, outline: false, shadow: '#a06a10' }); }); }\n    /* the scale's mat, the bed, the rail */\n    if (Isl.scale) { r.decal(g => { const a = r.w(Isl.scale.x - 13, Isl.scale.y - 7, 0), b = r.w(Isl.scale.x + 13, Isl.scale.y + 7, 0); px.rect(g, a[0], a[1], b[0] - a[0], b[1] - a[1], '#bfeee0'); }); }\n    r.shape('bed', Isl.bed.x, Isl.bed.y, 0, { facing: Math.PI / 2 });\n    r.queue(Isl.rail.x, Isl.rail.y, 0, g => { const p = r.w(Isl.rail.x, Isl.rail.y, 0); px.rect(g, p[0] - 16, p[1] - 28, 2, 28, '#7a8a94'); px.rect(g, p[0] + 14, p[1] - 28, 2, 28, '#7a8a94'); px.rect(g, p[0] - 16, p[1] - 28, 32, 2, '#7a8a94'); for (const [k, u] of [['towel', '#ffffff'], ['headband', '#2cc6e6'], ['sunhat', '#f6e7b8'], ['hat', '#c9b8e8']].map((v, i) => [v[0], v[1], i]).map(a => [a[0], a[1]])) { const i = ['towel', 'headband', 'sunhat', 'hat'].indexOf(k), on = o.demo || G.unlocked(k); px.rect(g, p[0] - 13 + i * 7, p[1] - 26, 5, on ? 11 : 3, on ? u : '#c8d0d4'); } });\n    /* a few benches, lamps and signs */\n    r.shape('bench', Isl.people.find(q => q.id === 'lou').x, Isl.people.find(q => q.id === 'lou').y - 2, 0, { facing: Math.PI / 2 });\n    for (const l of Isl.lamps) r.prop('streetlamp', l.x, l.y, 0, { size: .9, light: G.L.enabled && G.L.ambient < .8 });\n    for (const s of Isl.signs) r.queue(s.x, s.y, 0, g => { const p = r.w(s.x, s.y, 0); px.rect(g, p[0] - 1, p[1] - 11, 2, 11, '#a57f54'); G.signBoard(g, p[0], p[1] - 24, s.t); });\n    /* the juice bar's blender and olives */\n    /* the Regulars */\n    for (const p of Isl.people) { G.drawRig(r, p.rig, p.x, p.y, 0, { pick: p }); if (p.rig2) G.drawRig(r, p.rig2, p.x + 14, p.y, 0); }\n  }\n};\n\nlet body, rig, tare, wx, wy, goal, focus = null, idle = 0, mode = 'walk', pills = null, said = false, mouseT = -1, hint = null, hintT = 0, walkT = 0;\nconst spots = () => Isl.mats.concat(Isl.people, [Isl.scale, Isl.bed, Isl.rail]);\nfunction nearestSpot(x, y, reach) { let best = null, bd = 1e9; for (const q of spots()) { const d = Math.hypot(q.x - x, q.y - y); if (d < (reach === undefined ? q.r : reach) && d < bd) { bd = d; best = q; } } return best; }\nfunction interact(q) {\n  goal = null; body.vx = body.vy = 0;\n  if (q.kind === 'mat') {\n    if (!G.activityOpen(q.id)) { hint = G.activities[q.id].name + ' opens on Day ' + G.DATA.openOn(q.id) + '. Please wait to be improved.'; hintT = 3.5; G.A.sfx('back'); return; }\n    G.Save.save(); G.playActivity(q.id, { from: G.S.freePlay ? 'island' : 'island' });\n  } else if (q.kind === 'person') {\n    const L = G.DATA.lines.regulars[q.id], line = L.lines[(G.S.day + (q.chat = (q.chat || 0) + 1)) % L.lines.length];\n    if (q.id === 'twins') G.say('twins', [L.lines[0], L.lines[1], L.lines[2 + (G.S.day % 2)]]); else G.say(q.id, line);\n  } else if (q.kind === 'tare') {\n    G.say('tare', G.S.minutes >= 20 && !G.S.seen.bow ? (G.S.seen.bow = 1, G.DATA.lines.tare.bowTie) : G.S.day >= 2 && G.S.day % 2 ? G.line('tare.gertrude') : game.settings.tips ? G.line('tare.tips') : G.line('tare.favorite'), { face: 'happy' }); tare.boop();\n  } else if (q.kind === 'bed') {\n    const left = 3 - G.S.session;\n    if (G.S.freePlay) { G.S.session = 3; G.go('evening'); }\n    else if (left > 0) { G.say('tare', G.line('tare.earlyBed'), { face: 'worried', choices: ['Go to bed', 'Stay up'], onChoice(i) { if (i === 0) { G.S.session = 3; G.go('evening'); } } }); }\n    else G.go('evening');\n  } else if (q.kind === 'rail') openRail();\n}\nfunction openRail() {\n  const un = G.DATA.unlocks.filter(u => u.wear && G.unlocked(u.id));\n  if (!un.length) { G.say('tare', 'The rail is empty. Gerald will provide. Gerald needs five minutes.', { face: 'neutral' }); return; }\n  mode = 'rail';\n  const build = () => [...un.map(u => ({ label: u.name, sub: G.S.wear[u.id] ? 'Wearing it' : 'On the rail', id: u.id })), { label: 'Done', id: 'done' }];\n  pills = new G.Pills(build(), { y: () => 20, x: () => game.W / 2 + 90, w: 160, h: 28, gap: 4, onPick(i, it) { if (it.id === 'done') { mode = 'walk'; return; } G.S.wear[it.id] = !G.S.wear[it.id]; rig = G.playerRig({ size: 1.05 }); pills.set(build()); G.Save.save(); }, onBack() { mode = 'walk'; } });\n}\nG.scenes.island = {\n  view: 'threequarter', camera: { zoom: false }, pausable: true,\n  enter(d) {\n    Isl.build(); const s = G.S; G.dbg.activity = null; mode = 'walk';\n    const at = d && d.spot ? Isl.mats.find(m => m.id === d.spot) : null, st = at || Isl.door;\n    body = new E.Body({ x: st.x, y: st.y + (at ? 16 : 6), r: 5 }); rig = G.playerRig({ size: 1.05 });\n    tare = new G.TareBody(body.x - 18, body.y + 10); tare.scale = .9; goal = null; focus = null; idle = 0; hint = null;\n    const phase = G.dayPhase(); G.setDayLight(phase); G.music(phase === 'dusk' ? 'islandDusk' : 'islandAM'); G.talk.close();\n    game.cam.smooth = .15; game.cam.bounds = v => Isl.map.bounds(v); game.follow(null); game.focus(body.x, body.y, 10); game.cam.snap = true;\n    if (G.pendingLine) { G.mutter('tare', G.pendingLine); G.pendingLine = null; }\n    else if (s.nod && !s.seen.nod) { s.seen.nod = 1; G.say('gertrude', 'Mm.', { onDone() { G.mutter('tare', G.DATA.lines.tare.nod); } }); }\n    else if (s.freePlay && !s.seen.after) { s.seen.after = 1; G.mutter('tare', G.line('tare.afterDays')); }\n  },\n  exit() { game.cam.bounds = null; game.cam.smooth = 0; G.L.enabled = false; },\n  update(dt) {\n    if (G.talk.update(dt)) { rig.update(dt, { x: body.x, y: body.y, z: 0, vx: 0, vy: 0, facing: rig.lastFacing || 1.57 }); tare.update(dt); return; }\n    const I = game.input; Isl.updatePeople(dt); tare.update(dt, [body.x - 14, body.y + 12]);\n    if (mode === 'rail') { pills.update(dt); rig.update(dt, { x: body.x, y: body.y, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); return; }\n    const m = I.move(); let dir = game.view.screenDirToGround(m[0], m[1]);\n    const moved = Math.hypot(dir[0], dir[1]) > .1;\n    if (moved) { goal = null; idle = 0; }\n    /* the mouse: hover highlights, a click walks there and interacts */\n    let hover = null;\n    if (I.mouse && I.mouse.active && I.lastDevice !== 'gamepad') {\n      const P = I.pointer(); if (P && game.r) { const picked = game.r.pick ? game.r.pick(P[0], P[1]) : null, hit = picked && picked.find && picked.find(q => q && q.kind); hover = hit || null; if (!hover) { const mg = game.mouseGround(); if (mg) hover = nearestSpot(mg[0], mg[1], 16); } }\n      if (I.mouse.t !== mouseT) { mouseT = I.mouse.t; idle = 0; }\n    }\n    const ck = I.clicked();\n    if (ck) { idle = 0; if (hover) goal = { x: hover.x, y: hover.y, thing: hover }; else { const mg = game.mouseGround(); if (mg) goal = { x: mg[0], y: mg[1] }; } if (goal) { Isl.flow.update(goal.x, goal.y); walkT = 0; } }\n    if (goal && !moved) {\n      const dg = Math.hypot(goal.x - body.x, goal.y - body.y); walkT += dt;\n      if (goal.thing && dg < goal.thing.r) { const q = goal.thing; goal = null; interact(q); }\n      else if (dg < 6 || walkT > 7) goal = null;\n      else { const dd = Isl.flow.dir(body.x, body.y, goal.x, goal.y); dir = dd && (dd[0] || dd[1]) ? dd : [(goal.x - body.x) / dg, (goal.y - body.y) / dg]; }\n    }\n    body.vx = dir[0] * SPEED; body.vy = dir[1] * SPEED; body.update(dt, Isl.map);\n    const moving = Math.hypot(body.vx, body.vy) > 2 && (moved || goal);\n    if (moving) rig.lastFacing = Math.atan2(body.vy, body.vx);\n    rig.update(dt, { x: body.x, y: body.y, z: 0, vx: moving ? body.vx * .6 : 0, vy: moving ? body.vy * .6 : 0, facing: rig.lastFacing === undefined ? 1.57 : rig.lastFacing, expr: 'smile' });\n    game.focus(body.x, body.y, 10);\n    focus = hover && Math.hypot(hover.x - body.x, hover.y - body.y) < 500 ? hover : nearestSpot(body.x, body.y);\n    const near = nearestSpot(body.x, body.y);\n    if (near && I.pressed('interact')) { I.consumeAll(); interact(near); }\n    hintT = Math.max(0, hintT - dt);\n    idle += dt; if (idle > 30 && !G.S.freePlay) { idle = 0; G.mutter('tare', G.line('tare.idle')); }\n  },\n  draw(r) {\n    const near = focus;\n    Isl.drawWorld(r, { focus: near });\n    if (G.L.enabled && G.L.ambient < .8) for (const l of Isl.lamps) G.L.add(l.x, l.y, 40, 90, .9, { color: '#ffb860' });\n    G.drawRig(r, rig, body.x, body.y, 0);\n    tare.draw(r, { scale: .9 });\n    r.overlay(g => {\n      G.drawDayHud(g);\n      if (mode === 'rail') { G.panel(g, game.W / 2 - 150, 20, 150, 124, { r: 8 }); txt(g, 'The rail', game.W / 2 - 75, 26, '#14a8c8', { align: 'center' }); const c = game.W / 2 - 75; G.drawGerald(g, c, 134, 1.6, { friend: G.S.minutes >= 30 }); txt(g, Math.floor(G.S.minutes) + ' minutes', c, 42, '#20404c', { align: 'center' }); const nx = G.DATA.unlocks.find(u => u.minutes > G.S.minutes); if (nx) G.wrapText(g, 'At ' + nx.minutes + ': ' + nx.name, c, 54, 136, '#5f7f8a', { align: 'center' }); pills.draw(g); G.prompts(g, [['confirm', 'Wear it'], ['cancel', 'Back']]); return; }\n      if (near && !G.talk.open) {\n        const open = near.kind !== 'mat' || G.activityOpen(near.id), verb = near.kind === 'mat' ? (open ? 'Stand on the mat' : 'Not yet') : near.kind === 'person' || near.kind === 'tare' ? 'Talk' : near.kind === 'bed' ? 'Go to bed' : 'Look';\n        G.panel(g, game.W / 2 - E.font.width(near.label) / 2 - 8, 42, E.font.width(near.label) + 16, 15, { r: 7 });\n        txt(g, near.label, game.W / 2, 46, '#20404c', { align: 'center' });\n        G.prompts(g, [['interact', verb]]);\n      } else if (!G.talk.open) G.prompts(g, [[game.input.lastDevice === 'gamepad' ? '=Left stick' : game.input.lastDevice === 'mouse' ? '=Click' : '=WASD', 'Walk']]);\n      if (hintT > 0) { const w = Math.min(game.W - 40, 300); G.panel(g, (game.W - w) / 2, 62, w, 30, { r: 8 }); G.wrapText(g, hint, game.W / 2, 66, w - 16, '#20404c', { align: 'center' }); }\n    });\n    G.talk.draw(r);\n  }\n};\n})();\nEOF\ncat > game/scenes/member.js <<'EOF'\n/* scenes/member.js: three big Member Cards, and a new member made by pills. No text entry. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet mode = 'cards', pills = null, slot = 0, draft = null, rigs = [], cursor = 0, confirmErase = false, idle = 0;\nconst L = () => G.LOOK;\nconst rowName = ['Hair', 'Skin', 'Top', 'Bottom', 'Name'];\nfunction cards() {\n  mode = 'cards'; rigs = [];\n  const items = [];\n  for (let i = 0; i < 3; i++) {\n    const m = G.Save.member(i), look = m && m.data && m.data.look;\n    rigs[i] = look && !m.damaged ? G.memberRig(look, m.data.wear, { size: 1.3 }) : null;\n    items.push({ label: m ? (m.damaged ? 'Damaged card' : m.data.name) : 'New Member', id: i, member: m });\n  }\n  items.push({ label: 'Back', id: 'back' });\n  pills = new G.Pills(items, { layout: 'h', y: () => game.H - 38, h: 22, w: Math.min(92, (game.W - 40) / 4 - 6), onPick(i, it) {\n    if (it.id === 'back') return G.go('title');\n    slot = it.id;\n    if (it.member && !it.member.damaged) { if (game.saves.load(slot)) { G.Save.slot = slot; G.startDay(); } }\n    else newMember();\n  }, onBack() { G.go('title'); } });\n}\nfunction newMember() {\n  mode = 'new'; cursor = 0;\n  const pick = l => l[Math.floor(G.cosmetic() * l.length) % l.length];\n  draft = { hair: 0, skin: 1, top: 0, bottom: 0, name: pick(G.DATA.lines.nicknames) };\n  refresh();\n  const build = () => [{ label: 'Hair: ' + L().hair[draft.hair], id: 'hair' }, { label: 'Skin ' + (draft.skin + 1), id: 'skin' }, { label: 'Top ' + (draft.top + 1), id: 'top' }, { label: 'Bottom ' + (draft.bottom + 1), id: 'bottom' }, { label: draft.name + '  (Reroll)', id: 'name' }, { label: 'Sign the card', id: 'ok' }];\n  pills = new G.Pills(build(), { x: () => game.W * .67, y: () => 22, w: Math.min(170, game.W * .44), h: 22, gap: 5, onPick(i, it) {\n    if (it.id === 'ok') { G.Save.create(slot, draft.name, { hair: L().hair[draft.hair], skin: draft.skin, top: draft.top, bottom: draft.bottom }); G.startDay(); return; }\n    bump(it.id, 1); pills.set(build()); refresh();\n  }, onBack() { cards(); } });\n  pills._build = build;\n}\nfunction bump(id, d) {\n  const n = { hair: L().hair.length, skin: L().skins.length, top: L().tops.length, bottom: L().bottoms.length };\n  if (id === 'name') { const list = G.DATA.lines.nicknames; let k = list.indexOf(draft.name); draft.name = list[(k + d + list.length) % list.length]; G.A.sfx('tick'); return; }\n  if (n[id]) draft[id] = (draft[id] + d + n[id]) % n[id];\n}\nfunction refresh() { rigs[3] = G.memberRig({ hair: L().hair[draft.hair], skin: draft.skin, top: draft.top, bottom: draft.bottom }, {}, { size: 2 }); }\nG.scenes.member = {\n  view: 'brawler', camera: { zoom: false },\n  enter() { cards(); G.L.enabled = false; G.music('studio'); G.talk.close(); },\n  update(dt) {\n    G.stageCam(30, 8); const I = game.input;\n    if (mode === 'new' && pills) {\n      const it = pills.items[pills.i];\n      if (it.id !== 'ok') { if (I.repeat('left', .35, .14)) { bump(it.id, -1); pills.set(pills._build()); refresh(); } if (I.repeat('right', .35, .14)) { bump(it.id, 1); pills.set(pills._build()); refresh(); } }\n    }\n    pills.update(dt);\n    for (const r of rigs) if (r) { r.update(dt, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n  },\n  draw(r) {\n    G.ROOMS.reception(r);\n    r.overlay(g => {\n      const W = game.W, H = game.H;\n      if (mode === 'cards') {\n        txt(g, 'Whose card is this?', W / 2, 10, '#14a8c8', { align: 'center', scale: 2, shadow: '#ffffff' });\n        const cw = Math.min(124, (W - 32) / 3), gap = 6, x0 = (W - (cw * 3 + gap * 2)) / 2, y = 34, ch = H - 34 - 48;\n        for (let i = 0; i < 3; i++) {\n          const x = x0 + i * (cw + gap), foc = pills.i === i, it = pills.items[i], m = it.member;\n          G.panel(g, x, y - (foc ? 2 : 0), cw, ch + (foc ? 4 : 0), { r: 8, border: foc ? '#2cc6e6' : '#c8dde2', bg: foc ? '#ffffff' : '#f6fbfb' });\n          px.rect(g, x + 6, y + 5, cw - 12, 12, foc ? '#2cc6e6' : '#dfe9ea'); txt(g, 'Member ' + (i + 1), x + cw / 2, y + 7, foc ? '#ffffff' : '#5f7f8a', { align: 'center' });\n          if (m && !m.damaged) {\n            const d = m.data; if (rigs[i]) rigs[i].draw(g, Math.round(x + cw / 2), y + ch - 44, E.VIEWS.brawler);\n            txt(g, d.name, x + cw / 2, y + ch - 40, '#20404c', { align: 'center' });\n            txt(g, 'Spine Age ' + (m.level === undefined ? '?' : m.level), x + cw / 2, y + ch - 28, '#ff7a59', { align: 'center' });\n            txt(g, m.place || ('Day ' + d.day), x + cw / 2, y + ch - 16, '#5f7f8a', { align: 'center' });\n          } else if (m && m.damaged) { G.wrapText(g, \"This card has been through something. I can't read it.\", x + cw / 2, y + 40, cw - 12, '#e0553a', { align: 'center' }); }\n          else { G.drawTare(g, x + cw / 2, y + ch * .6, 1.6, { face: 'worried' }); txt(g, 'Nobody yet.', x + cw / 2, y + ch - 28, '#5f7f8a', { align: 'center' }); }\n        }\n      } else {\n        G.panel(g, 16, 20, W * .36, H - 60, { r: 8 });\n        px.rect(g, 22, 25, W * .36 - 12, 13, '#2cc6e6'); txt(g, 'New Member', 16 + W * .18, 28, '#ffffff', { align: 'center' });\n        const lk = L(), x = 16 + W * .18;\n        rigs[3].draw(g, Math.round(x), H - 66, E.VIEWS.brawler);\n        txt(g, draft.name, x, H - 58, '#20404c', { align: 'center' });\n      }\n      pills.draw(g);\n      G.prompts(g, mode === 'new' ? [['confirm', 'Next'], ['cancel', 'Back']] : [['confirm', 'Pick'], ['cancel', 'Back']], { y: game.H - 15 });\n    });\n  }\n};\n\n/* ---- the day's route: everything that begins a day comes through here ---- */\nG.startDay = () => {\n  const s = G.S;\n  if (!s.arrived) return G.go('arrival');\n  if (!s.checked) return G.go('bodycheck');\n  const D = G.DATA.dayOf(s.day);\n  if (D.scene && !s.tareDay && D.scene === 'tareday') return G.go('tareday');\n  if (D.games && !s.ended) return G.go('games');\n  if (s.session >= 3 && !s.freePlay) return G.go('evening');\n  G.go('island');\n};\nG.nextDay = () => {\n  const s = G.S; s.history.push(G.DATA.dayOf(s.day).hold ? s.shown : G.spineAge()); if (s.history.length > 8) s.history.shift();\n  s.shown = G.spineShownFor(s.day); s.day++; s.session = 0; s.checked = false; s.pauses = 0; s.suggestion = null; G.Save.save();\n};\nG.spineShownFor = d => { const row = G.DATA.dayOf(d); return row.hold ? G.S.shown : G.spineAge(); };\n})();\nEOF\ncat > game/scenes/arrival.js <<'EOF'\n/* scenes/arrival.js: the arrival card, then pick an instructor. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet t = 0, phase = 'card', pills = null, birch, alder, pb, pa, tare;\nG.scenes.arrival = {\n  view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() {\n    t = 0; phase = 'card'; G.music('islandAM'); G.L.enabled = false; G.talk.close();\n    birch = G.instructorRig('birch', 2.1); alder = G.instructorRig('alder', 2.1); pb = new G.Poser(birch); pa = new G.Poser(alder); pb.clip('Idle_Subtle', { loop: true, tgt: 1.4 }); pa.clip('Idle_Subtle', { loop: true, tgt: 1.7 }); tare = new G.TareBody(0, 18); tare.scale = 1.4;\n    pills = new G.Pills(['Open the card'], { y: () => game.H - 40, w: 130, h: 22, onPick() { phase = 'pick'; pills = choose(); G.say('tare', G.DATA.lines.tare.first, { face: 'happy' }); } });\n  },\n  update(dt) {\n    t += dt; G.stageCam(30, 8);\n    pb.update(dt); pa.update(dt); birch.update(dt, { x: -62, y: 0, z: 0, vx: 0, vy: 0, facing: pb.facing }); alder.update(dt, { x: 62, y: 0, z: 0, vx: 0, vy: 0, facing: pa.facing });\n    tare.update(dt); if (Math.floor(t / 1.5) !== Math.floor((t - dt) / 1.5)) tare.hop(30);\n    if (G.talk.update(dt)) return;\n    pills.update(dt);\n  },\n  draw(r) {\n    G.ROOMS.reception(r);\n    if (phase !== 'card') { G.drawMat(r, -62, 0, 30, 9, '#f4e6cf'); G.drawMat(r, 62, 0, 30, 9, '#fbf0dc'); G.drawRig(r, birch, -62, 0); G.drawRig(r, alder, 62, 0); }\n    tare.draw(r, { scale: 1.4 });\n    r.overlay(g => {\n      const W = game.W, H = game.H;\n      if (phase === 'card') { const cw = Math.min(330, W - 24); G.panel(g, (W - cw) / 2, 22, cw, 120, { r: 8 }); txt(g, 'The Institute for Gentle Improvement', W / 2, 30, '#14a8c8', { align: 'center' }); G.wrapText(g, G.DATA.lines.arrival[0], W / 2, 50, cw - 30, '#20404c', { align: 'center' }); txt(g, G.DATA.lines.motto, W / 2, 124, '#5f7f8a', { align: 'center' }); }\n      else { txt(g, 'Pick your instructor', W / 2, 14, '#14a8c8', { align: 'center', scale: 2, shadow: '#ffffff' }); }\n      pills.draw(g);\n      G.prompts(g, [['confirm', phase === 'card' ? 'Open' : 'Pick']]);\n    });\n    G.talk.draw(r);\n  }\n};\nfunction choose() {\n  return new G.Pills([{ label: 'Birch', sub: 'Patient. Slightly warped.', id: 'birch' }, { label: 'Alder', sub: 'A lot of small decisions.', id: 'alder' }], { layout: 'h', y: () => game.H - 40, h: 26, w: 150, onPick(i, it) {\n    G.S.instructor = it.id; G.S.arrived = true; G.Save.save();\n    G.say(it.id, G.DATA.lines[it.id].hello, { onDone() { G.startDay(); } });\n    pills.enabled = false;\n  } });\n}\n})();\nEOF\ncat > game/scenes/bodycheck.js <<'EOF'\n/* scenes/bodycheck.js: the morning ritual, about 50 s. Step onto Tare, Stillness Test, Lean Test, one Silly Question, the\n * Reading in ducks, Spine Age, today's Suggestion. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game, lib = G.lib;\nconst txt = (...a) => G.txt(...a);\nconst BC = G.BodyCheck = {\n  LEAN: [[0, .6, 'Forward'], [.6, 0, 'Right'], [0, -.6, 'Back'], [-.6, 0, 'Left']],\n  make(o = {}) {\n    const c = { step: 'on', t: 0, bal: new G.Balance(G.DATA.bodyCheck.set, E.rng(777 + (G.S.day || 1))), tare: new G.TareBody(0, 4), rig: o.rig || G.playerRig({ size: 2 }), intent: G.newIntent(), reader: o.bot ? null : new G.DeviceReader(game.input), brain: o.bot ? new G.BotBrain(o.bot, E.rng(5)) : null, leanI: 0, held: 0, still: 0, ducks: 8 + E.rng(G.S.day * 91 + 7)() * 6, question: null, short: !!o.short, demo: !!o.demo, age: G.spineShownFor ? G.spineShown() : 71 };\n    c.poser = new G.Poser(c.rig); c.tare.scale = 2.2; c.rig.hop = 0; c.bal.cheat = !!o.bot;\n    return c;\n  },\n  stepRig(c, dt, tilt) { const k = c.rig; c.poser.clip('Idle_Subtle', { loop: true, tgt: 1.4 }); c.poser.update(dt); k.wob = tilt ? [c.bal.x, c.bal.y] : [0, 0]; const z = c.onZ === undefined ? 12 : c.onZ; k.update(dt, { x: c.rigX || 0, y: 4, z, vx: 0, vy: 0, facing: c.poser.facing, expr: c.bal.inRing ? 'smile' : undefined }); },\n  /** one run of the stillness and lean tests; returns true when both are done */\n  tests(c, dt) {\n    const b = c.bal;\n    if (c.brain) { const u = c.brain.hold(dt, b, b.ringX, b.ringY); c.intent.x = u[0]; c.intent.y = u[1]; } else c.reader.read(dt, c.intent);\n    b.step(dt, c.intent.x, c.intent.y); G.dbg.lean = [+b.x.toFixed(3), +b.y.toFixed(3)]; G.dbg.source = c.intent.source;\n    if (b.inRing && b.streak > .4 && !c.demo) { c.chime = (c.chime || 0) - dt; if (c.chime <= 0) { c.ch = (c.ch || 0) + 1; G.chime(Math.min(10, c.ch)); c.chime = .8; } }\n    if (c.step === 'still') { c.t += dt; if (b.inRing) c.still += dt; if (c.t >= 5) { c.step = 'lean'; c.t = 0; c.leanI = 0; c.held = 0; b.set.R = .22; G.A.sfx('ok'); const q = BC.LEAN[0]; b.ringX = q[0]; b.ringY = q[1]; G.mutter('tare', G.line('tare.leanTest'), { auto: 2.2, attract: true }); } return false; }\n    if (c.step === 'lean') { c.t += dt; if (b.inRing) c.held += dt; if (c.held >= 1 || c.t > 5) { c.leanI++; c.held = 0; c.t = 0; G.chime(c.leanI * 2); if (c.leanI >= BC.LEAN.length) { b.ringX = b.ringY = 0; return true; } const q = BC.LEAN[c.leanI]; b.ringX = q[0]; b.ringY = q[1]; } return false; }\n    return false;\n  },\n  hudTests(g, c) {\n    const W = game.W, H = game.H, b = c.bal;\n    G.drawPlate(g, b, { x: W / 2, y: H - 40, r: 34, ring: [b.ringX, b.ringY, b.R], color: '#ff7a59' });\n    if (c.step === 'still') { G.panel(g, W / 2 - 80, 8, 160, 34, { r: 8 }); txt(g, 'Stillness Test', W / 2, 12, '#14a8c8', { align: 'center' }); E.ui.bar(g, W / 2 - 66, 26, 132, 8, c.t / 5, '#2cc6e6', { bg: '#e8f0f2' }); }\n    if (c.step === 'lean') { const q = BC.LEAN[c.leanI] || BC.LEAN[3]; G.panel(g, W / 2 - 80, 8, 160, 34, { r: 8 }); txt(g, 'Lean: ' + q[2], W / 2, 12, '#14a8c8', { align: 'center' }); E.ui.bar(g, W / 2 - 66, 26, 132, 8, c.held, '#7fe0c3', { bg: '#e8f0f2' }); }\n    G.prompts(g, [['lean', 'Lean']]);\n  },\n  drawStage(r, c) {\n    G.ROOMS.reception(r, { dusk: false });\n    G.drawMat(r, 0, 4, 46, 12, '#bfeee0');\n    c.tare.draw(r, { scale: 2.2 });\n    r.queue(0, 5, 0, g => {}, {});\n    G.drawRig(r, c.rig, c.rigX || 0, 4, c.onZ === undefined ? 12 : c.onZ, { noShadow: true });\n  }\n};\nlet c = null, pills = null, stage = 0, big = 0, t = 0;\nfunction next(step) { c.step = step; c.t = 0; t = 0;\n  if (step === 'still') { c.bal.set.R = .2; c.bal.inRingT = 0; c.bal.totalT = 0; G.mutter('tare', G.line('tare.still'), { auto: 2.5 }); }\n  if (step === 'question') { const qs = G.DATA.lines.questions, q = qs[(G.S.day + (G.S.lineSeed | 0)) % qs.length]; c.question = q; G.say('tare', q.q, { face: 'neutral', choices: q.a, onChoice(i) { G.say('tare', q.r[i], { face: 'smug', onDone() { next('reading'); } }); } }); }\n  if (step === 'reading') { const d = c.ducks.toFixed(1); G.A.sfx('tareBoop'); G.say('tare', G.line('reading', { d }), { face: 'judging', onDone() { next('spine'); } }); }\n  if (step === 'spine') { const s = G.S, row = G.DATA.dayOf(s.day), prev = s.history[s.history.length - 1], now = G.spineShown(); c.prev = prev; c.now = now; big = prev;\n    let line;\n    if (row.hold) line = G.line('tare.plateau');\n    else if (row.catchUp && now < prev) line = G.line('tare.catchup');\n    else if (now < prev) line = 'Your Spine Age is ' + now + '. ' + G.line('tare.spineDown');\n    else if (now >= 71) line = \"Let's call it 71. It doesn't go higher. It's not allowed.\";\n    else line = 'Your Spine Age is ' + now + '. ' + G.line('tare.spineSame');\n    if (s.day === 1) line = 'Your Spine Age is ' + now + \". \" + G.line('tare.number');\n    c.line = line; game.after(1.3, () => { if (c.step === 'spine') { if (now !== prev) G.A.sfx('stamp'); G.say('tare', line, { face: row.hold ? 'sad' : now < prev ? 'happy' : 'neutral', onDone() { c.lineDone = true; } }); } });\n    pills = new G.Pills(['Continue'], { y: () => game.H - 34, w: 120, h: 20, onPick() { next('suggest'); } }); pills.enabled = false; }\n  if (step === 'suggest') {\n    const s = G.S, open = G.order.filter(id => G.activityOpen(id)), pool = open.filter(id => (s.best[id] ? G.bestStars(id) : 0) < 3), list = pool.length ? pool : open, pick = list[(s.day * 7 + (s.runs | 0)) % list.length]; s.suggestion = pick; s.checked = true;\n    const nm = G.activities[pick].name; const tip = game.settings.tips && s.day > 1 ? G.line('tare.tips') : null; const lines = [G.line('tare.suggest', { a: nm })]; if (tip) lines.push(tip);\n    G.say('tare', lines, { face: 'happy', onDone() { G.Save.save(); G.startDay(); } });\n  }\n}\nG.scenes.bodycheck = {\n  view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter(d) {\n    const s = G.S; if (d && d.day) { s.day = d.day; s.checked = false; } G.dbg.activity = null;\n    G.talk.close(); G.setDayLight('morning'); G.music('studio'); c = BC.make({ short: !!G.DATA.dayOf(s.day).shortCheck }); c.step = 'on'; c.onZ = 0; c.rigX = -56; t = 0; c.lineDone = false; pills = null;\n    const last = s.lastSeen ? Math.floor((Date.now() - s.lastSeen) / 86400000) : 0;\n    const hello = s.day === 1 && !s.seen.first ? (s.seen.first = 1, G.DATA.lines.tare.first[1]) : last >= 2 ? G.line('tare.absent', { n: last }) : G.line('tare.hello');\n    c.hello = hello; G.say('tare', hello, { face: 'happy', onDone() { c.greeted = true; } });\n  },\n  update(dt) {\n    G.stageCam(30, 8); c.tare.update(dt); t += dt;\n    const talk = G.talk.update(dt);\n    if (c.step === 'on') { BC.stepRig(c, dt); if (c.greeted) { c.t += dt; const k = clamp(c.t / .7, 0, 1); c.rigX = -56 * (1 - k); c.onZ = Math.sin(k * Math.PI) * 26 + k * 12; if (k >= 1) { c.tare.boop(); G.grunt('member'); if (c.short) next('reading'); else next('still'); } } return; }\n    if (talk) { BC.stepRig(c, dt); return; }\n    if (c.step === 'still' || c.step === 'lean') { BC.stepRig(c, dt, true); if (BC.tests(c, dt)) next('question'); return; }\n    if (c.step === 'spine') { BC.stepRig(c, dt); if (t > .4) big += (c.now - big) * Math.min(1, dt * 2.5); if (c.lineDone) { pills.enabled = true; pills.update(dt); } return; }\n    BC.stepRig(c, dt);\n  },\n  draw(r) {\n    BC.drawStage(r, c);\n    r.overlay(g => {\n      if (c.step === 'still' || c.step === 'lean') BC.hudTests(g, c);\n      if (c.step === 'reading' || c.step === 'question') { }\n      if (c.step === 'reading') { const n = Math.round(c.ducks), W = game.W; for (let i = 0; i < n; i++) { const x = W / 2 - (n - 1) * 9 + i * 18, y = 58 + Math.sin(game.real * 3 + i) * 2; px.ell(g, x, y, 7, 5, '#ffd166'); px.disc(g, x + 5, y - 6, 4, '#ffd166'); px.rect(g, x + 8, y - 6, 4, 2, '#ff9a3a'); px.dot(g, x + 6, y - 7, '#20404c'); } }\n      if (c.step === 'spine' || c.step === 'suggest') {\n        const W = game.W, H = game.H, cw = Math.min(330, W - 24), s = G.S, x0 = (W - cw) / 2, y0 = 12;\n        G.panel(g, x0, y0, cw, 118, { r: 8 });\n        txt(g, 'Spine Age', x0 + 62, y0 + 8, '#5f7f8a', { align: 'center' });\n        txt(g, Math.round(big), x0 + 62, y0 + 26, '#ff7a59', { align: 'center', scale: 5, shadow: '#ffd8cc' });\n        txt(g, 'Gertrude: 19', x0 + 62, y0 + 90, '#b08be0', { align: 'center' });\n        G.drawAgeGraph(g, x0 + 122, y0 + 16, cw - 200, 78, s.history.concat(c.step === 'spine' ? [c.now] : [G.spineShown()]));\n        const scores = G.DISCIPLINES.map(G.disciplineScore); G.drawFlower(g, x0 + cw - 38, y0 + 54, 32, scores);\n        if (pills && pills.enabled && c.step === 'spine' && !G.talk.open) pills.draw(g);\n      }\n      if (!G.talk.open) G.drawDayHudMini(g);\n    });\n    G.talk.draw(r);\n  }\n};\nG.drawDayHudMini = g => { const s = G.S, day = G.DATA.dayOf(s.day); G.panel(g, 8, 8, 72, 28, { r: 7 }); txt(g, 'Day ' + s.day, 14, 12, '#14a8c8'); txt(g, day.name.length > 11 ? day.name.slice(0, 11) : day.name, 14, 22, '#5f7f8a'); };\n})();\nEOF\ncat > game/scenes/evening.js <<'EOF'\n/* scenes/evening.js: the recap, Gerald's count, and bed. One idea: the day is over. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet t = 0, pills = null, rig, poser, tare, coins, phase = 'recap', ageBefore, gShown;\nG.scenes.evening = {\n  view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() {\n    const s = G.S; t = 0; phase = 'recap'; G.dbg.activity = null; G.talk.close(); G.setDayLight('dusk'); G.music('islandDusk'); G.sting('daydone');\n    rig = G.playerRig({ size: 2 }); poser = new G.Poser(rig); poser.clip('Stretch_Yawn', { loop: true, tgt: 1.4, speed: .7 }); tare = new G.TareBody(120, 16); tare.scale = 1.4; coins = new G.Coins(); gShown = s.minutes;\n    pills = new G.Pills(['Go to bed'], { x: () => game.W / 2, y: () => game.H - 36, w: 130, h: 22, onPick() {\n      phase = 'night'; t = 0; poser.clip('Sleeping', { loop: true, tgt: 1.57, fade: .6 }); G.say('tare', G.line('tare.night'), { face: 'asleep', onDone() { G.nextDay(); G.go('bodycheck', null, { fade: 'iris', seconds: .6 }); } });\n    } });\n    if (s.day === 2 && !s.nod) game.after(.5, () => G.mutter('tare', 'Gertrude did not nod today. She will be here tomorrow. She is always here.', { auto: 4 }));\n    G.Save.save();\n  },\n  update(dt) {\n    t += dt; G.stageCam(30, 8); tare.update(dt); if (Math.floor(t / 2.3) !== Math.floor((t - dt) / 2.3)) tare.hop(22);\n    poser.update(dt); rig.update(dt, { x: -60, y: 0, z: phase === 'night' ? 12 : 0, vx: 0, vy: 0, facing: poser.facing, expr: 'smile' });\n    if (G.talk.update(dt)) return;\n    if (phase === 'recap') pills.update(dt);\n  },\n  draw(r) {\n    G.ROOMS.bungalow(r, { dusk: true }); const l = r.w(0, -20, 40); G.L.add(-40, -20, 40, 170, 1, { color: '#ffb860' });\n    G.drawRig(r, rig, -60, 0, phase === 'night' ? 12 : 0, { noShadow: phase === 'night' }); tare.draw(r, { scale: 1.4 });\n    r.overlay(g => {\n      const s = G.S, W = game.W, H = game.H, cw = Math.min(230, W * .56), x0 = W - cw - 14, y0 = 14;\n      G.panel(g, x0, y0, cw, 130, { r: 8 });\n      txt(g, 'Day ' + s.day + ' is over', x0 + cw / 2, y0 + 7, '#14a8c8', { align: 'center' });\n      const best = G.lastRun; txt(g, 'Spine Age', x0 + 40, y0 + 24, '#5f7f8a', { align: 'center' }); txt(g, G.spineShown(), x0 + 40, y0 + 36, '#ff7a59', { align: 'center', scale: 3 });\n      G.drawGerald(g, x0 + cw - 44, y0 + 66, 1.5, { friend: s.minutes >= 30 }); txt(g, Math.floor(s.minutes) + ' min', x0 + cw - 40, y0 + 70, '#20404c', { align: 'center' });\n      G.drawAgeGraph(g, x0 + 14, y0 + 76, cw - 28, 42, s.history.concat([G.spineShown()]));\n      const nx = G.DATA.unlocks.find(u => u.minutes > s.minutes); if (nx) txt(g, 'Gerald is saving for: ' + nx.name, x0 + cw / 2, y0 + 118, '#5f7f8a', { align: 'center' });\n      if (phase === 'recap') pills.draw(g);\n      if (phase === 'recap') G.prompts(g, [['confirm', 'Bed']]);\n    });\n    G.talk.draw(r);\n  }\n};\n})();\nEOF\ncat > game/scenes/tareday.js <<'EOF'\n/* scenes/tareday.js: Day 4. Tare is recalibrated on a huge old scale. You press the button to read it. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet t = 0, step = 'talk', tare, needle = 0, target = 0, shake = 0;\nconst hugeScale = (r, x, y) => {\n  const g = r.ctx, p = r.w(x, y, 0), W = 110, H = 110;\n  px.rect(g, p[0] - W / 2 + 6, p[1] - 8, W - 12, 8, '#7a5a3a');\n  px.rect(g, p[0] - W * .2, p[1] - H, W * .4, H - 6, '#a57f54'); px.rect(g, p[0] - W * .2, p[1] - H, 5, H - 6, '#c49c6c');\n  px.rect(g, p[0] - W / 2, p[1] - 16, W, 8, '#c49c6c'); px.rect(g, p[0] - W / 2, p[1] - 16, W, 2, '#e0c094');\n  const cy = p[1] - H - 20; px.disc(g, p[0], cy, 36, '#7a5a3a'); px.disc(g, p[0], cy, 32, '#f7f0dc'); for (let i = 0; i < 20; i++) { const a = -Math.PI * 1.25 + i / 19 * Math.PI * 1.5; px.rect(g, p[0] + Math.cos(a) * 27, cy + Math.sin(a) * 27, 2, 2, '#7a5a3a'); }\n  const a = -Math.PI * 1.25 + needle * Math.PI * 1.5; px.line(g, p[0], cy, p[0] + Math.cos(a) * 24, cy + Math.sin(a) * 24, '#e0553a', 2); px.disc(g, p[0], cy, 3, '#20404c');\n  E.font.text(g, 'grams', p[0], cy + 12, '#7a5a3a', { align: 'center', outline: false });\n};\nG.scenes.tareday = {\n  view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() {\n    t = 0; step = 'talk'; needle = 0; target = 0; shake = 0; G.dbg.activity = null; G.talk.close(); G.setDayLight('morning'); G.music('islandDusk');\n    tare = new G.TareBody(-110, 10); tare.scale = 1.8; tare.say('worried', 30);\n    G.say('tare', G.DATA.lines.tareDay, { face: 'worried', onDone() { step = 'hop'; t = 0; } });\n  },\n  update(dt) {\n    t += dt; G.stageCam(40, 8); tare.update(dt, step === 'hop' ? [60, 10, 3] : null); if (G.talk.update(dt)) return;\n    if (step === 'hop') { if (Math.hypot(tare.x - 60, tare.y - 10) < 8) { tare.x = 60; tare.z = 0; tare.vz = 0; step = 'press'; t = 0; target = 0; G.A.sfx('stamp'); needle = .02; } return; }\n    if (step === 'press') { needle = .02 + Math.sin(t * 2) * .004; if (game.input.pressed('confirm') || game.input.clicked()) { game.input.consumeAll(); step = 'read'; t = 0; G.A.sfx('creak'); G.A.sfx('tareBoop'); } return; }\n    if (step === 'read') { const k = clamp(t / 2.2, 0, 1); needle = .02 + Math.sin(k * Math.PI * 4) * (1 - k) * .4 + k * .03; shake = (1 - k) * .4; if (k >= 1) { step = 'after'; tare.say('sad', 30); G.say('tare', G.DATA.lines.tareRead, { face: 'sad', onDone() { G.S.tareDay = true; G.Save.save(); G.startDay(); } }); } }\n  },\n  draw(r) {\n    G.ROOMS.reception(r); hugeScale(r, 60, -6); \n    const z = step === 'press' || step === 'read' || step === 'after' ? 18 : 0;\n    tare.z = Math.max(tare.z, step === 'press' || step === 'read' || step === 'after' ? 18 : 0);\n    tare.draw(r, { scale: 1.8, shake });\n    r.overlay(g => { if (step === 'press') { G.panel(g, game.W / 2 - 100, game.H - 60, 200, 24, { r: 9 }); txt(g, \"Read Tare's weight\", game.W / 2, game.H - 53, '#20404c', { align: 'center' }); G.prompts(g, [['confirm', 'Read it']]); } });\n    G.talk.draw(r);\n  }\n};\n})();\nEOF\necho done","description":"Write the island, member, arrival, Body Check, evening and Tare's Day scenes"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8667,"cache_read_input_tokens":439171,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8667},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e35d4c2a-4185-48d4-8818-8a6b8bcd7047","uuid":"841605ad-644c-4a40-803c-f44596ef9b7e","timestamp":"2026-11-05T05:58:05.526Z","request_id":"req_011CgjGEvZk9mun4xgzbjipJ","wire_tool_inputs":{"toolu_01QzTuFbPGJoyqZy7ZdeNgEu":{"command":"cat > game/data/island.js <<'EOF'\n/* data/island.js: Lumbar Island as text, 44 x 26. ~ sea, , grass, . sand, = pier, ^ snow, p path, d deck, i iron room\n * floor, k park. R B J are buildings. 1-9 a b c are mats. E Tare's scale, @ the door, Z the bed, W the rail, G D M K O L T\n * the Regulars. Move a letter and the thing moves: nothing else to change. */\n(() => {\nconst G = window.G;\nG.DATA.island = { rows: [\n    '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~,,,,,,,,,,~~~~~~~~~~~~~~~~~',\n    '~~~~~~~~~~~~~^^^,,,,,,,,,,,,,,,~~~~~~~~~~~~~',\n    '~~~~~~~~~~^^^^^^,RRRRRRR,,,,dddddddddd~~~~~~',\n    '~~~~~~~~^^^^^^^^^RRRRRRR,,,,d1dd2dd3dd~~~~~~',\n    '~~~~~~^^^^^^^^^^^RRRRRRR,,,,dddddddddd~~~~~~',\n    '~~~~~^^^^^^^^^^^^,,,pp,,T,,,dddddddddd,~~~~~',\n    '~~~~^^^^^^^^^^^^,,,,Ep,,,,,,ddddpddddd,,~~~~',\n    '~~~^^^^^^^^^^^^^K,,,,p,,,,G,,,,,p,,,,,,,,~~~',\n    '~~,^^^^^^^^^^^,,,,,,,p,,,,,,,,,,p,,,,,,,,,~~',\n    '~~,,,^^^pppppppppppppp,,,,,,,,,,piiiiiiii,~~',\n    '~~,BBBBBB,,,,,,,,,,,,p,,,,,,,,,,pii4ii5ii,~~',\n    '~~,BBBBBB,pppppppppppppppppppppppiiiiiiii,~~',\n    '~~.BBBBBB,p,,,,,,,,,,p,,,,,,,,M,,iiiiiiii.~~',\n    '~~.BBBBBB,p,,,,,,,,,,p,,,,,,,,,,,ii6iiiii.~~',\n    '~~,,Z,@,,,p,,,,,,,,JJJJJJ,,,,,,,,iiiiiiii.~~',\n    '~~,,,,ppWpp,,,,,,,,JJJJJJ,,,,,,,,,,,,,,...~~',\n    '~~,,,,,,,,,,,L,,,,,,,D,,,,,,,,,,,,,,,,...~~~',\n    '~~~~...,,,,,,,pppppppp,,pppbpppO,,,,,...~~~~',\n    '~~~~~...,kkkkkkkkkkkkp,,,,,,,p,,,,,,...~~~~~',\n    '~~~~~~...kkakkkkkkckk,,,,,==7====8====~~~~~~',\n    '~~~~~~~~.kkkkkkkkkkkk,,,,,============~~~~~~',\n    '~~~~~~~~~~......,,,,,,,,,,,,...=======~~~~~~',\n    '~~~~~~~~~~~~~..................====9==~~~~~~',\n    '~~~~~~~~~~~~~~~~~..........~~~~~~~~~~~~~~~~~',\n    '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~' ],\n  mats: { 1: 'stork', 2: 'flow', 3: 'candle', 4: 'squat', 5: 'pushup', 6: 'lunge', 7: 'step', 8: 'hoop', 9: 'jog', a: 'tray', b: 'laundry', c: 'slalom' },\n  floors: { 1: 'deck', 2: 'deck', 3: 'deck', 4: 'iron', 5: 'iron', 6: 'iron', 7: 'pier', 8: 'pier', 9: 'pier', a: 'park', b: 'path', c: 'park' },\n  people: { G: 'gertrude', D: 'dennis', M: 'marisol', K: 'kevin', O: 'okafor', L: 'lou', T: 'twins' }\n};\n})();\nEOF\npython3 - <<'EOF'\nimport json\nf=json.load(open('game/files.json'))\nif 'game/data/island.js' not in f:\n    f.insert(f.index('game/data/unlocks.js')+1,'game/data/island.js')\njson.dump(f,open('game/files.json','w'),indent=0)\nEOF\ncat > game/scenes/island.js <<'EOF'\n/* scenes/island.js: The Institute for Gentle Improvement, on Lumbar Island. Walk, talk, stand on a mat. Motto on every sign. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst CELL = 16, SPEED = 132;\nconst COL = { sea: [73, 182, 201], grass: [150, 214, 139], sand: [244, 231, 196], pier: [201, 174, 136], snow: [240, 248, 252], path: [236, 222, 192], deck: [224, 196, 158], iron: [238, 244, 244], park: [176, 224, 160] };\nconst floorTex = (x, y, tag) => {\n  const c = COL[tag] || COL.grass, n = E.hash2 ? E.hash2(Math.floor(x / 2), Math.floor(y / 2)) : 0;\n  if (tag === 'pier' || tag === 'deck') { const line = (Math.floor(y) % 8 === 0) ? -26 : 0, jit = (n - .5) * 8; return [c[0] + line + jit, c[1] + line + jit, c[2] + line + jit]; }\n  if (tag === 'iron') { const line = (Math.floor(x) % 16 === 0 || Math.floor(y) % 16 === 0) ? -14 : 0; return [c[0] + line, c[1] + line, c[2] + line]; }\n  if (tag === 'sea') { const w = Math.sin(x * .12 + Math.sin(y * .08) * 2) * 8 + (n - .5) * 4; return [c[0] - 12 + w, c[1] - 8 + w, c[2] - 2 + w]; }\n  const jit = (n - .5) * (tag === 'grass' || tag === 'park' ? 16 : 7); return [c[0] + jit, c[1] + jit, c[2] + jit];\n};\n/** builds the map and the places on it, once */\nconst Isl = G.Island = {\n  built: false,\n  build() {\n    if (Isl.built) return; Isl.built = true;\n    const D = G.DATA.island, legend = { '~': { floor: 'sea', block: true }, ',': { floor: 'grass' }, '.': { floor: 'sand' }, '=': { floor: 'pier' }, '^': { floor: 'snow' }, 'p': { floor: 'path' }, 'd': { floor: 'deck' }, 'i': { floor: 'iron' }, 'k': { floor: 'park' }, 'R': { tile: 1, floor: 'grass' }, 'B': { tile: 2, floor: 'grass' }, 'J': { tile: 3, floor: 'grass' }, 'E': { floor: 'path', spawn: 'scale' }, '@': { floor: 'path', spawn: 'door' }, 'Z': { floor: 'grass', spawn: 'bed' }, 'W': { floor: 'path', spawn: 'rail' } };\n    for (const k in D.mats) legend[k] = { floor: D.floors[k], spawn: 'mat_' + D.mats[k] };\n    for (const k in D.people) legend[k] = { floor: 'grass', spawn: 'p_' + D.people[k] };\n    Isl.map = new E.TileMap({ rows: D.rows, legend, ao: 4, outside: '#2f97ad', floorTex,\n      types: { 1: { h: 32, top: '#ff9a7a', side: '#fbf6ec', face: 'plaster', roof: 'tiles', windows: { w: 6, h: 8, step: 22, from: 10 } }, 2: { h: 28, top: '#7fd8ea', side: '#fbf6ec', face: 'plaster', roof: 'tiles', windows: { w: 6, h: 8, step: 20, from: 9 }, door: { chance: .3, color: '#c49c6c' } }, 3: { h: 12, top: '#f5c84b', side: '#e8a07a', face: 'plank', roof: 'plain' } } });\n    const map = Isl.map; Isl.flow = new E.FlowField(map);\n    Isl.mats = []; for (const k in D.mats) { const id = D.mats[k], s = map.find('mat_' + id); Isl.mats.push({ kind: 'mat', id, x: s.x, y: s.y, r: 18, label: G.activities[id].short || G.activities[id].name }); }\n    Isl.people = [];\n    for (const k in D.people) { const id = D.people[k], s = map.find('p_' + id), rig = G.regularRig(id === 'twins' ? 'twin1' : id, 1.05), pe = { kind: 'person', id, x: s.x, y: s.y, r: 15, label: G.DATA.lines.regulars[id].name, rig, hx: s.x, hy: s.y, ph: E.hash2 ? E.hash2(s.x, s.y) * 6 : 0 }; pe.poser = new G.Poser(rig); if (id === 'twins') { pe.rig2 = G.regularRig('twin2', 1.05); } Isl.people.push(pe); }\n    Isl.scale = Object.assign(map.find('scale'), { kind: 'tare', id: 'tare', r: 15, label: 'Tare' });\n    Isl.bed = Object.assign(map.find('bed'), { kind: 'bed', id: 'bed', r: 16, label: 'Bed' });\n    Isl.rail = Object.assign(map.find('rail'), { kind: 'rail', id: 'rail', r: 13, label: 'The rail' });\n    Isl.door = map.find('door');\n    /* the scatter: a little of everything */\n    const rng = E.rng(4242); Isl.scatter = [];\n    const R = D.rows;\n    for (let i = 0; i < 260; i++) { const cx = Math.floor(rng() * 44), cy = Math.floor(rng() * 26), ch = R[cy][cx], x = cx * CELL + 8 + (rng() - .5) * 10, y = cy * CELL + 8 + (rng() - .5) * 10, v = rng();\n      if (ch === ',') { if (v < .22) Isl.scatter.push({ p: 'palm', x, y, s: 1.3, solid: true }); else if (v < .42) Isl.scatter.push({ p: 'bush', x, y, s: .9 }); else if (v < .78) Isl.scatter.push({ p: 'flowers', x, y, s: 1 }); else Isl.scatter.push({ p: 'grass', x, y, s: 1 }); }\n      else if (ch === '^') { if (v < .55) Isl.scatter.push({ p: 'pine', x, y, s: 1.2 + v }); else Isl.scatter.push({ p: 'rock', x, y, s: .8, color: '#dbe7ea' }); }\n      else if (ch === '.') { if (v < .22) Isl.scatter.push({ p: 'palm', x, y, s: 1.2 }); else if (v < .4) Isl.scatter.push({ p: 'rock', x, y, s: .6, color: '#c8b89a' }); } }\n    Isl.scatter = Isl.scatter.filter(s => !Isl.mats.concat(Isl.people, [Isl.scale, Isl.bed, Isl.rail]).some(q => Math.hypot(q.x - s.x, q.y - s.y) < 22));\n    Isl.lamps = [[20, 9], [26, 12], [14, 12], [32, 9], [24, 18], [11, 15], [33, 22]].map(([cx, cy]) => ({ x: cx * CELL + 8, y: cy * CELL + 8 }));\n    Isl.glints = []; for (let i = 0; i < 120; i++) { const cx = Math.floor(rng() * 44), cy = Math.floor(rng() * 26); if (R[cy][cx] === '~') Isl.glints.push({ x: cx * CELL + rng() * 16, y: cy * CELL + rng() * 16, k: rng() * 6 }); }\n    Isl.signs = [{ x: 21 * CELL, y: 8 * CELL + 4, t: G.DATA.lines.motto }, { x: 28 * CELL, y: 2.7 * CELL, t: 'Stillness Deck' }, { x: 36 * CELL, y: 9.6 * CELL, t: 'Iron Room' }, { x: 33 * CELL, y: 19.5 * CELL, t: 'Aerobics Pier' }, { x: 15 * CELL, y: 18.7 * CELL, t: 'Balance Park' }, { x: 6 * CELL, y: 10.5 * CELL, t: 'Bungalow' }, { x: 21 * CELL, y: 14.5 * CELL, t: 'Juice Bar' }, { x: 20 * CELL, y: 2.6 * CELL, t: 'Reception' }];\n  },\n  /** the regulars walk small loops */\n  updatePeople(dt) {\n    for (const p of Isl.people) {\n      p.ph += dt * .35;\n      if (p.id === 'lou') { p.poser.clip('Sleeping', { loop: true, tgt: 1.57 }); p.poser.update(dt); p.rig.update(dt, { x: p.x, y: p.y, z: 0, vx: 0, vy: 0, facing: p.poser.facing }); continue; }\n      const k = p.id === 'marisol' ? 28 : p.id === 'gertrude' ? 0 : 6, nx = p.hx + Math.cos(p.ph) * k, ny = p.hy + Math.sin(p.ph * (p.id === 'marisol' ? 2 : 1)) * k * .5, vx = (nx - p.x) / Math.max(dt, .001), vy = (ny - p.y) / Math.max(dt, .001); p.x = nx; p.y = ny;\n      p.rig.update(dt, { x: p.x, y: p.y, z: 0, vx: k ? vx : 0, vy: k ? vy : 0, facing: k ? Math.atan2(vy, vx) : 1.57, expr: 'smile' });\n      if (p.rig2) { p.rig2.update(dt, { x: p.x + 14, y: p.y, z: 0, vx, vy, facing: Math.atan2(vy, vx), expr: 'smile' }); }\n    }\n  },\n  drawWorld(r, o = {}) {\n    const map = Isl.map, t = game.real;\n    map.drawFloor(r);\n    /* the sea glints */\n    r.decal(g => { for (const q of Isl.glints) if (Math.sin(t * 1.2 + q.k) > .45) { const p = r.w(q.x, q.y, 0); px.rect(g, p[0], p[1], 5, 1, '#b8ecf2'); } });\n    map.queueWalls(r);\n    for (const s of Isl.scatter) r.prop(s.p, s.x, s.y, 0, { size: s.s, color: s.color });\n    /* mats */\n    r.decal(g => {\n      for (const m of Isl.mats) {\n        const open = o.allOpen || G.activityOpen(m.id), a = r.w(m.x - 16, m.y - 9, 0), b = r.w(m.x + 16, m.y + 9, 0), dcol = { Stillness: '#b08be0', Strength: '#ff7a59', Cardio: '#2cc6e6', Balance: '#6fcf8e' }[G.activities[m.id].discipline], glow = .5 + .5 * Math.sin(t * 2.4 + m.x), hov = o.focus === m;\n        px.rect(g, a[0] - 3, a[1] - 3, b[0] - a[0] + 6, b[1] - a[1] + 6, hov ? '#ffffff' : open ? E.mix(dcol, '#ffffff', glow * .6) : '#c8d0d4');\n        px.rect(g, a[0], a[1], b[0] - a[0], b[1] - a[1], open ? dcol : '#a8b4ba');\n        px.rect(g, a[0] + 3, a[1] + 3, b[0] - a[0] - 6, 1, '#ffffff'); px.rect(g, a[0] + 3, b[1] - 4, b[0] - a[0] - 6, 1, '#ffffff');\n      }\n    });\n    for (const m of Isl.mats) { const st = G.S.best[m.id] ? G.bestStars(m.id) : 0; if (st && !o.demo) r.textAt(m.x, m.y, 2, '★'.repeat(st), '#ffb020'); if (G.S.suggestion === m.id && !G.S.freePlay && !o.demo) r.queue(m.x, m.y - 1, 22, g => { const p = r.w(m.x, m.y, 20 + Math.sin(t * 3) * 3); E.font.text(g, '★', p[0], p[1], '#ffb020', { align: 'center', scale: 2, outline: false, shadow: '#a06a10' }); }); }\n    /* the scale's mat, the bed, the rail */\n    if (Isl.scale) { r.decal(g => { const a = r.w(Isl.scale.x - 13, Isl.scale.y - 7, 0), b = r.w(Isl.scale.x + 13, Isl.scale.y + 7, 0); px.rect(g, a[0], a[1], b[0] - a[0], b[1] - a[1], '#bfeee0'); }); }\n    r.shape('bed', Isl.bed.x, Isl.bed.y, 0, { facing: Math.PI / 2 });\n    r.queue(Isl.rail.x, Isl.rail.y, 0, g => { const p = r.w(Isl.rail.x, Isl.rail.y, 0); px.rect(g, p[0] - 16, p[1] - 28, 2, 28, '#7a8a94'); px.rect(g, p[0] + 14, p[1] - 28, 2, 28, '#7a8a94'); px.rect(g, p[0] - 16, p[1] - 28, 32, 2, '#7a8a94'); for (const [k, u] of [['towel', '#ffffff'], ['headband', '#2cc6e6'], ['sunhat', '#f6e7b8'], ['hat', '#c9b8e8']].map((v, i) => [v[0], v[1], i]).map(a => [a[0], a[1]])) { const i = ['towel', 'headband', 'sunhat', 'hat'].indexOf(k), on = o.demo || G.unlocked(k); px.rect(g, p[0] - 13 + i * 7, p[1] - 26, 5, on ? 11 : 3, on ? u : '#c8d0d4'); } });\n    /* a few benches, lamps and signs */\n    r.shape('bench', Isl.people.find(q => q.id === 'lou').x, Isl.people.find(q => q.id === 'lou').y - 2, 0, { facing: Math.PI / 2 });\n    for (const l of Isl.lamps) r.prop('streetlamp', l.x, l.y, 0, { size: .9, light: G.L.enabled && G.L.ambient < .8 });\n    for (const s of Isl.signs) r.queue(s.x, s.y, 0, g => { const p = r.w(s.x, s.y, 0); px.rect(g, p[0] - 1, p[1] - 11, 2, 11, '#a57f54'); G.signBoard(g, p[0], p[1] - 24, s.t); });\n    /* the juice bar's blender and olives */\n    /* the Regulars */\n    for (const p of Isl.people) { G.drawRig(r, p.rig, p.x, p.y, 0, { pick: p }); if (p.rig2) G.drawRig(r, p.rig2, p.x + 14, p.y, 0); }\n  }\n};\n\nlet body, rig, tare, wx, wy, goal, focus = null, idle = 0, mode = 'walk', pills = null, said = false, mouseT = -1, hint = null, hintT = 0, walkT = 0;\nconst spots = () => Isl.mats.concat(Isl.people, [Isl.scale, Isl.bed, Isl.rail]);\nfunction nearestSpot(x, y, reach) { let best = null, bd = 1e9; for (const q of spots()) { const d = Math.hypot(q.x - x, q.y - y); if (d < (reach === undefined ? q.r : reach) && d < bd) { bd = d; best = q; } } return best; }\nfunction interact(q) {\n  goal = null; body.vx = body.vy = 0;\n  if (q.kind === 'mat') {\n    if (!G.activityOpen(q.id)) { hint = G.activities[q.id].name + ' opens on Day ' + G.DATA.openOn(q.id) + '. Please wait to be improved.'; hintT = 3.5; G.A.sfx('back'); return; }\n    G.Save.save(); G.playActivity(q.id, { from: G.S.freePlay ? 'island' : 'island' });\n  } else if (q.kind === 'person') {\n    const L = G.DATA.lines.regulars[q.id], line = L.lines[(G.S.day + (q.chat = (q.chat || 0) + 1)) % L.lines.length];\n    if (q.id === 'twins') G.say('twins', [L.lines[0], L.lines[1], L.lines[2 + (G.S.day % 2)]]); else G.say(q.id, line);\n  } else if (q.kind === 'tare') {\n    G.say('tare', G.S.minutes >= 20 && !G.S.seen.bow ? (G.S.seen.bow = 1, G.DATA.lines.tare.bowTie) : G.S.day >= 2 && G.S.day % 2 ? G.line('tare.gertrude') : game.settings.tips ? G.line('tare.tips') : G.line('tare.favorite'), { face: 'happy' }); tare.boop();\n  } else if (q.kind === 'bed') {\n    const left = 3 - G.S.session;\n    if (G.S.freePlay) { G.S.session = 3; G.go('evening'); }\n    else if (left > 0) { G.say('tare', G.line('tare.earlyBed'), { face: 'worried', choices: ['Go to bed', 'Stay up'], onChoice(i) { if (i === 0) { G.S.session = 3; G.go('evening'); } } }); }\n    else G.go('evening');\n  } else if (q.kind === 'rail') openRail();\n}\nfunction openRail() {\n  const un = G.DATA.unlocks.filter(u => u.wear && G.unlocked(u.id));\n  if (!un.length) { G.say('tare', 'The rail is empty. Gerald will provide. Gerald needs five minutes.', { face: 'neutral' }); return; }\n  mode = 'rail';\n  const build = () => [...un.map(u => ({ label: u.name, sub: G.S.wear[u.id] ? 'Wearing it' : 'On the rail', id: u.id })), { label: 'Done', id: 'done' }];\n  pills = new G.Pills(build(), { y: () => 20, x: () => game.W / 2 + 90, w: 160, h: 28, gap: 4, onPick(i, it) { if (it.id === 'done') { mode = 'walk'; return; } G.S.wear[it.id] = !G.S.wear[it.id]; rig = G.playerRig({ size: 1.05 }); pills.set(build()); G.Save.save(); }, onBack() { mode = 'walk'; } });\n}\nG.scenes.island = {\n  view: 'threequarter', camera: { zoom: false }, pausable: true,\n  enter(d) {\n    Isl.build(); const s = G.S; G.dbg.activity = null; mode = 'walk';\n    const at = d && d.spot ? Isl.mats.find(m => m.id === d.spot) : null, st = at || Isl.door;\n    body = new E.Body({ x: st.x, y: st.y + (at ? 16 : 6), r: 5 }); rig = G.playerRig({ size: 1.05 });\n    tare = new G.TareBody(body.x - 18, body.y + 10); tare.scale = .9; goal = null; focus = null; idle = 0; hint = null;\n    const phase = G.dayPhase(); G.setDayLight(phase); G.music(phase === 'dusk' ? 'islandDusk' : 'islandAM'); G.talk.close();\n    game.cam.smooth = .15; game.cam.bounds = v => Isl.map.bounds(v); game.follow(null); game.focus(body.x, body.y, 10); game.cam.snap = true;\n    if (G.pendingLine) { G.mutter('tare', G.pendingLine); G.pendingLine = null; }\n    else if (s.nod && !s.seen.nod) { s.seen.nod = 1; G.say('gertrude', 'Mm.', { onDone() { G.mutter('tare', G.DATA.lines.tare.nod); } }); }\n    else if (s.freePlay && !s.seen.after) { s.seen.after = 1; G.mutter('tare', G.line('tare.afterDays')); }\n  },\n  exit() { game.cam.bounds = null; game.cam.smooth = 0; G.L.enabled = false; },\n  update(dt) {\n    if (G.talk.update(dt)) { rig.update(dt, { x: body.x, y: body.y, z: 0, vx: 0, vy: 0, facing: rig.lastFacing || 1.57 }); tare.update(dt); return; }\n    const I = game.input; Isl.updatePeople(dt); tare.update(dt, [body.x - 14, body.y + 12]);\n    if (mode === 'rail') { pills.update(dt); rig.update(dt, { x: body.x, y: body.y, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); return; }\n    const m = I.move(); let dir = game.view.screenDirToGround(m[0], m[1]);\n    const moved = Math.hypot(dir[0], dir[1]) > .1;\n    if (moved) { goal = null; idle = 0; }\n    /* the mouse: hover highlights, a click walks there and interacts */\n    let hover = null;\n    if (I.mouse && I.mouse.active && I.lastDevice !== 'gamepad') {\n      const P = I.pointer(); if (P && game.r) { const picked = game.r.pick ? game.r.pick(P[0], P[1]) : null, hit = picked && picked.find && picked.find(q => q && q.kind); hover = hit || null; if (!hover) { const mg = game.mouseGround(); if (mg) hover = nearestSpot(mg[0], mg[1], 16); } }\n      if (I.mouse.t !== mouseT) { mouseT = I.mouse.t; idle = 0; }\n    }\n    const ck = I.clicked();\n    if (ck) { idle = 0; if (hover) goal = { x: hover.x, y: hover.y, thing: hover }; else { const mg = game.mouseGround(); if (mg) goal = { x: mg[0], y: mg[1] }; } if (goal) { Isl.flow.update(goal.x, goal.y); walkT = 0; } }\n    if (goal && !moved) {\n      const dg = Math.hypot(goal.x - body.x, goal.y - body.y); walkT += dt;\n      if (goal.thing && dg < goal.thing.r) { const q = goal.thing; goal = null; interact(q); }\n      else if (dg < 6 || walkT > 7) goal = null;\n      else { const dd = Isl.flow.dir(body.x, body.y, goal.x, goal.y); dir = dd && (dd[0] || dd[1]) ? dd : [(goal.x - body.x) / dg, (goal.y - body.y) / dg]; }\n    }\n    body.vx = dir[0] * SPEED; body.vy = dir[1] * SPEED; body.update(dt, Isl.map);\n    const moving = Math.hypot(body.vx, body.vy) > 2 && (moved || goal);\n    if (moving) rig.lastFacing = Math.atan2(body.vy, body.vx);\n    rig.update(dt, { x: body.x, y: body.y, z: 0, vx: moving ? body.vx * .6 : 0, vy: moving ? body.vy * .6 : 0, facing: rig.lastFacing === undefined ? 1.57 : rig.lastFacing, expr: 'smile' });\n    game.focus(body.x, body.y, 10);\n    focus = hover && Math.hypot(hover.x - body.x, hover.y - body.y) < 500 ? hover : nearestSpot(body.x, body.y);\n    const near = nearestSpot(body.x, body.y);\n    if (near && I.pressed('interact')) { I.consumeAll(); interact(near); }\n    hintT = Math.max(0, hintT - dt);\n    idle += dt; if (idle > 30 && !G.S.freePlay) { idle = 0; G.mutter('tare', G.line('tare.idle')); }\n  },\n  draw(r) {\n    const near = focus;\n    Isl.drawWorld(r, { focus: near });\n    if (G.L.enabled && G.L.ambient < .8) for (const l of Isl.lamps) G.L.add(l.x, l.y, 40, 90, .9, { color: '#ffb860' });\n    G.drawRig(r, rig, body.x, body.y, 0);\n    tare.draw(r, { scale: .9 });\n    r.overlay(g => {\n      G.drawDayHud(g);\n      if (mode === 'rail') { G.panel(g, game.W / 2 - 150, 20, 150, 124, { r: 8 }); txt(g, 'The rail', game.W / 2 - 75, 26, '#14a8c8', { align: 'center' }); const c = game.W / 2 - 75; G.drawGerald(g, c, 134, 1.6, { friend: G.S.minutes >= 30 }); txt(g, Math.floor(G.S.minutes) + ' minutes', c, 42, '#20404c', { align: 'center' }); const nx = G.DATA.unlocks.find(u => u.minutes > G.S.minutes); if (nx) G.wrapText(g, 'At ' + nx.minutes + ': ' + nx.name, c, 54, 136, '#5f7f8a', { align: 'center' }); pills.draw(g); G.prompts(g, [['confirm', 'Wear it'], ['cancel', 'Back']]); return; }\n      if (near && !G.talk.open) {\n        const open = near.kind !== 'mat' || G.activityOpen(near.id), verb = near.kind === 'mat' ? (open ? 'Stand on the mat' : 'Not yet') : near.kind === 'person' || near.kind === 'tare' ? 'Talk' : near.kind === 'bed' ? 'Go to bed' : 'Look';\n        G.panel(g, game.W / 2 - E.font.width(near.label) / 2 - 8, 42, E.font.width(near.label) + 16, 15, { r: 7 });\n        txt(g, near.label, game.W / 2, 46, '#20404c', { align: 'center' });\n        G.prompts(g, [['interact', verb]]);\n      } else if (!G.talk.open) G.prompts(g, [[game.input.lastDevice === 'gamepad' ? '=Left stick' : game.input.lastDevice === 'mouse' ? '=Click' : '=WASD', 'Walk']]);\n      if (hintT > 0) { const w = Math.min(game.W - 40, 300); G.panel(g, (game.W - w) / 2, 62, w, 30, { r: 8 }); G.wrapText(g, hint, game.W / 2, 66, w - 16, '#20404c', { align: 'center' }); }\n    });\n    G.talk.draw(r);\n  }\n};\n})();\nEOF\ncat > game/scenes/member.js <<'EOF'\n/* scenes/member.js: three big Member Cards, and a new member made by pills. No text entry. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet mode = 'cards', pills = null, slot = 0, draft = null, rigs = [], cursor = 0, confirmErase = false, idle = 0;\nconst L = () => G.LOOK;\nconst rowName = ['Hair', 'Skin', 'Top', 'Bottom', 'Name'];\nfunction cards() {\n  mode = 'cards'; rigs = [];\n  const items = [];\n  for (let i = 0; i < 3; i++) {\n    const m = G.Save.member(i), look = m && m.data && m.data.look;\n    rigs[i] = look && !m.damaged ? G.memberRig(look, m.data.wear, { size: 1.3 }) : null;\n    items.push({ label: m ? (m.damaged ? 'Damaged card' : m.data.name) : 'New Member', id: i, member: m });\n  }\n  items.push({ label: 'Back', id: 'back' });\n  pills = new G.Pills(items, { layout: 'h', y: () => game.H - 38, h: 22, w: Math.min(92, (game.W - 40) / 4 - 6), onPick(i, it) {\n    if (it.id === 'back') return G.go('title');\n    slot = it.id;\n    if (it.member && !it.member.damaged) { if (game.saves.load(slot)) { G.Save.slot = slot; G.startDay(); } }\n    else newMember();\n  }, onBack() { G.go('title'); } });\n}\nfunction newMember() {\n  mode = 'new'; cursor = 0;\n  const pick = l => l[Math.floor(G.cosmetic() * l.length) % l.length];\n  draft = { hair: 0, skin: 1, top: 0, bottom: 0, name: pick(G.DATA.lines.nicknames) };\n  refresh();\n  const build = () => [{ label: 'Hair: ' + L().hair[draft.hair], id: 'hair' }, { label: 'Skin ' + (draft.skin + 1), id: 'skin' }, { label: 'Top ' + (draft.top + 1), id: 'top' }, { label: 'Bottom ' + (draft.bottom + 1), id: 'bottom' }, { label: draft.name + '  (Reroll)', id: 'name' }, { label: 'Sign the card', id: 'ok' }];\n  pills = new G.Pills(build(), { x: () => game.W * .67, y: () => 22, w: Math.min(170, game.W * .44), h: 22, gap: 5, onPick(i, it) {\n    if (it.id === 'ok') { G.Save.create(slot, draft.name, { hair: L().hair[draft.hair], skin: draft.skin, top: draft.top, bottom: draft.bottom }); G.startDay(); return; }\n    bump(it.id, 1); pills.set(build()); refresh();\n  }, onBack() { cards(); } });\n  pills._build = build;\n}\nfunction bump(id, d) {\n  const n = { hair: L().hair.length, skin: L().skins.length, top: L().tops.length, bottom: L().bottoms.length };\n  if (id === 'name') { const list = G.DATA.lines.nicknames; let k = list.indexOf(draft.name); draft.name = list[(k + d + list.length) % list.length]; G.A.sfx('tick'); return; }\n  if (n[id]) draft[id] = (draft[id] + d + n[id]) % n[id];\n}\nfunction refresh() { rigs[3] = G.memberRig({ hair: L().hair[draft.hair], skin: draft.skin, top: draft.top, bottom: draft.bottom }, {}, { size: 2 }); }\nG.scenes.member = {\n  view: 'brawler', camera: { zoom: false },\n  enter() { cards(); G.L.enabled = false; G.music('studio'); G.talk.close(); },\n  update(dt) {\n    G.stageCam(30, 8); const I = game.input;\n    if (mode === 'new' && pills) {\n      const it = pills.items[pills.i];\n      if (it.id !== 'ok') { if (I.repeat('left', .35, .14)) { bump(it.id, -1); pills.set(pills._build()); refresh(); } if (I.repeat('right', .35, .14)) { bump(it.id, 1); pills.set(pills._build()); refresh(); } }\n    }\n    pills.update(dt);\n    for (const r of rigs) if (r) { r.update(dt, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n  },\n  draw(r) {\n    G.ROOMS.reception(r);\n    r.overlay(g => {\n      const W = game.W, H = game.H;\n      if (mode === 'cards') {\n        txt(g, 'Whose card is this?', W / 2, 10, '#14a8c8', { align: 'center', scale: 2, shadow: '#ffffff' });\n        const cw = Math.min(124, (W - 32) / 3), gap = 6, x0 = (W - (cw * 3 + gap * 2)) / 2, y = 34, ch = H - 34 - 48;\n        for (let i = 0; i < 3; i++) {\n          const x = x0 + i * (cw + gap), foc = pills.i === i, it = pills.items[i], m = it.member;\n          G.panel(g, x, y - (foc ? 2 : 0), cw, ch + (foc ? 4 : 0), { r: 8, border: foc ? '#2cc6e6' : '#c8dde2', bg: foc ? '#ffffff' : '#f6fbfb' });\n          px.rect(g, x + 6, y + 5, cw - 12, 12, foc ? '#2cc6e6' : '#dfe9ea'); txt(g, 'Member ' + (i + 1), x + cw / 2, y + 7, foc ? '#ffffff' : '#5f7f8a', { align: 'center' });\n          if (m && !m.damaged) {\n            const d = m.data; if (rigs[i]) rigs[i].draw(g, Math.round(x + cw / 2), y + ch - 44, E.VIEWS.brawler);\n            txt(g, d.name, x + cw / 2, y + ch - 40, '#20404c', { align: 'center' });\n            txt(g, 'Spine Age ' + (m.level === undefined ? '?' : m.level), x + cw / 2, y + ch - 28, '#ff7a59', { align: 'center' });\n            txt(g, m.place || ('Day ' + d.day), x + cw / 2, y + ch - 16, '#5f7f8a', { align: 'center' });\n          } else if (m && m.damaged) { G.wrapText(g, \"This card has been through something. I can't read it.\", x + cw / 2, y + 40, cw - 12, '#e0553a', { align: 'center' }); }\n          else { G.drawTare(g, x + cw / 2, y + ch * .6, 1.6, { face: 'worried' }); txt(g, 'Nobody yet.', x + cw / 2, y + ch - 28, '#5f7f8a', { align: 'center' }); }\n        }\n      } else {\n        G.panel(g, 16, 20, W * .36, H - 60, { r: 8 });\n        px.rect(g, 22, 25, W * .36 - 12, 13, '#2cc6e6'); txt(g, 'New Member', 16 + W * .18, 28, '#ffffff', { align: 'center' });\n        const lk = L(), x = 16 + W * .18;\n        rigs[3].draw(g, Math.round(x), H - 66, E.VIEWS.brawler);\n        txt(g, draft.name, x, H - 58, '#20404c', { align: 'center' });\n      }\n      pills.draw(g);\n      G.prompts(g, mode === 'new' ? [['confirm', 'Next'], ['cancel', 'Back']] : [['confirm', 'Pick'], ['cancel', 'Back']], { y: game.H - 15 });\n    });\n  }\n};\n\n/* ---- the day's route: everything that begins a day comes through here ---- */\nG.startDay = () => {\n  const s = G.S;\n  if (!s.arrived) return G.go('arrival');\n  if (!s.checked) return G.go('bodycheck');\n  const D = G.DATA.dayOf(s.day);\n  if (D.scene && !s.tareDay && D.scene === 'tareday') return G.go('tareday');\n  if (D.games && !s.ended) return G.go('games');\n  if (s.session >= 3 && !s.freePlay) return G.go('evening');\n  G.go('island');\n};\nG.nextDay = () => {\n  const s = G.S; s.history.push(G.DATA.dayOf(s.day).hold ? s.shown : G.spineAge()); if (s.history.length > 8) s.history.shift();\n  s.shown = G.spineShownFor(s.day); s.day++; s.session = 0; s.checked = false; s.pauses = 0; s.suggestion = null; G.Save.save();\n};\nG.spineShownFor = d => { const row = G.DATA.dayOf(d); return row.hold ? G.S.shown : G.spineAge(); };\n})();\nEOF\ncat > game/scenes/arrival.js <<'EOF'\n/* scenes/arrival.js: the arrival card, then pick an instructor. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet t = 0, phase = 'card', pills = null, birch, alder, pb, pa, tare;\nG.scenes.arrival = {\n  view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() {\n    t = 0; phase = 'card'; G.music('islandAM'); G.L.enabled = false; G.talk.close();\n    birch = G.instructorRig('birch', 2.1); alder = G.instructorRig('alder', 2.1); pb = new G.Poser(birch); pa = new G.Poser(alder); pb.clip('Idle_Subtle', { loop: true, tgt: 1.4 }); pa.clip('Idle_Subtle', { loop: true, tgt: 1.7 }); tare = new G.TareBody(0, 18); tare.scale = 1.4;\n    pills = new G.Pills(['Open the card'], { y: () => game.H - 40, w: 130, h: 22, onPick() { phase = 'pick'; pills = choose(); G.say('tare', G.DATA.lines.tare.first, { face: 'happy' }); } });\n  },\n  update(dt) {\n    t += dt; G.stageCam(30, 8);\n    pb.update(dt); pa.update(dt); birch.update(dt, { x: -62, y: 0, z: 0, vx: 0, vy: 0, facing: pb.facing }); alder.update(dt, { x: 62, y: 0, z: 0, vx: 0, vy: 0, facing: pa.facing });\n    tare.update(dt); if (Math.floor(t / 1.5) !== Math.floor((t - dt) / 1.5)) tare.hop(30);\n    if (G.talk.update(dt)) return;\n    pills.update(dt);\n  },\n  draw(r) {\n    G.ROOMS.reception(r);\n    if (phase !== 'card') { G.drawMat(r, -62, 0, 30, 9, '#f4e6cf'); G.drawMat(r, 62, 0, 30, 9, '#fbf0dc'); G.drawRig(r, birch, -62, 0); G.drawRig(r, alder, 62, 0); }\n    tare.draw(r, { scale: 1.4 });\n    r.overlay(g => {\n      const W = game.W, H = game.H;\n      if (phase === 'card') { const cw = Math.min(330, W - 24); G.panel(g, (W - cw) / 2, 22, cw, 120, { r: 8 }); txt(g, 'The Institute for Gentle Improvement', W / 2, 30, '#14a8c8', { align: 'center' }); G.wrapText(g, G.DATA.lines.arrival[0], W / 2, 50, cw - 30, '#20404c', { align: 'center' }); txt(g, G.DATA.lines.motto, W / 2, 124, '#5f7f8a', { align: 'center' }); }\n      else { txt(g, 'Pick your instructor', W / 2, 14, '#14a8c8', { align: 'center', scale: 2, shadow: '#ffffff' }); }\n      pills.draw(g);\n      G.prompts(g, [['confirm', phase === 'card' ? 'Open' : 'Pick']]);\n    });\n    G.talk.draw(r);\n  }\n};\nfunction choose() {\n  return new G.Pills([{ label: 'Birch', sub: 'Patient. Slightly warped.', id: 'birch' }, { label: 'Alder', sub: 'A lot of small decisions.', id: 'alder' }], { layout: 'h', y: () => game.H - 40, h: 26, w: 150, onPick(i, it) {\n    G.S.instructor = it.id; G.S.arrived = true; G.Save.save();\n    G.say(it.id, G.DATA.lines[it.id].hello, { onDone() { G.startDay(); } });\n    pills.enabled = false;\n  } });\n}\n})();\nEOF\ncat > game/scenes/bodycheck.js <<'EOF'\n/* scenes/bodycheck.js: the morning ritual, about 50 s. Step onto Tare, Stillness Test, Lean Test, one Silly Question, the\n * Reading in ducks, Spine Age, today's Suggestion. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game, lib = G.lib;\nconst txt = (...a) => G.txt(...a);\nconst BC = G.BodyCheck = {\n  LEAN: [[0, .6, 'Forward'], [.6, 0, 'Right'], [0, -.6, 'Back'], [-.6, 0, 'Left']],\n  make(o = {}) {\n    const c = { step: 'on', t: 0, bal: new G.Balance(G.DATA.bodyCheck.set, E.rng(777 + (G.S.day || 1))), tare: new G.TareBody(0, 4), rig: o.rig || G.playerRig({ size: 2 }), intent: G.newIntent(), reader: o.bot ? null : new G.DeviceReader(game.input), brain: o.bot ? new G.BotBrain(o.bot, E.rng(5)) : null, leanI: 0, held: 0, still: 0, ducks: 8 + E.rng(G.S.day * 91 + 7)() * 6, question: null, short: !!o.short, demo: !!o.demo, age: G.spineShownFor ? G.spineShown() : 71 };\n    c.poser = new G.Poser(c.rig); c.tare.scale = 2.2; c.rig.hop = 0; c.bal.cheat = !!o.bot;\n    return c;\n  },\n  stepRig(c, dt, tilt) { const k = c.rig; c.poser.clip('Idle_Subtle', { loop: true, tgt: 1.4 }); c.poser.update(dt); k.wob = tilt ? [c.bal.x, c.bal.y] : [0, 0]; const z = c.onZ === undefined ? 12 : c.onZ; k.update(dt, { x: c.rigX || 0, y: 4, z, vx: 0, vy: 0, facing: c.poser.facing, expr: c.bal.inRing ? 'smile' : undefined }); },\n  /** one run of the stillness and lean tests; returns true when both are done */\n  tests(c, dt) {\n    const b = c.bal;\n    if (c.brain) { const u = c.brain.hold(dt, b, b.ringX, b.ringY); c.intent.x = u[0]; c.intent.y = u[1]; } else c.reader.read(dt, c.intent);\n    b.step(dt, c.intent.x, c.intent.y); G.dbg.lean = [+b.x.toFixed(3), +b.y.toFixed(3)]; G.dbg.source = c.intent.source;\n    if (b.inRing && b.streak > .4 && !c.demo) { c.chime = (c.chime || 0) - dt; if (c.chime <= 0) { c.ch = (c.ch || 0) + 1; G.chime(Math.min(10, c.ch)); c.chime = .8; } }\n    if (c.step === 'still') { c.t += dt; if (b.inRing) c.still += dt; if (c.t >= 5) { c.step = 'lean'; c.t = 0; c.leanI = 0; c.held = 0; b.set.R = .22; G.A.sfx('ok'); const q = BC.LEAN[0]; b.ringX = q[0]; b.ringY = q[1]; G.mutter('tare', G.line('tare.leanTest'), { auto: 2.2, attract: true }); } return false; }\n    if (c.step === 'lean') { c.t += dt; if (b.inRing) c.held += dt; if (c.held >= 1 || c.t > 5) { c.leanI++; c.held = 0; c.t = 0; G.chime(c.leanI * 2); if (c.leanI >= BC.LEAN.length) { b.ringX = b.ringY = 0; return true; } const q = BC.LEAN[c.leanI]; b.ringX = q[0]; b.ringY = q[1]; } return false; }\n    return false;\n  },\n  hudTests(g, c) {\n    const W = game.W, H = game.H, b = c.bal;\n    G.drawPlate(g, b, { x: W / 2, y: H - 40, r: 34, ring: [b.ringX, b.ringY, b.R], color: '#ff7a59' });\n    if (c.step === 'still') { G.panel(g, W / 2 - 80, 8, 160, 34, { r: 8 }); txt(g, 'Stillness Test', W / 2, 12, '#14a8c8', { align: 'center' }); E.ui.bar(g, W / 2 - 66, 26, 132, 8, c.t / 5, '#2cc6e6', { bg: '#e8f0f2' }); }\n    if (c.step === 'lean') { const q = BC.LEAN[c.leanI] || BC.LEAN[3]; G.panel(g, W / 2 - 80, 8, 160, 34, { r: 8 }); txt(g, 'Lean: ' + q[2], W / 2, 12, '#14a8c8', { align: 'center' }); E.ui.bar(g, W / 2 - 66, 26, 132, 8, c.held, '#7fe0c3', { bg: '#e8f0f2' }); }\n    G.prompts(g, [['lean', 'Lean']]);\n  },\n  drawStage(r, c) {\n    G.ROOMS.reception(r, { dusk: false });\n    G.drawMat(r, 0, 4, 46, 12, '#bfeee0');\n    c.tare.draw(r, { scale: 2.2 });\n    r.queue(0, 5, 0, g => {}, {});\n    G.drawRig(r, c.rig, c.rigX || 0, 4, c.onZ === undefined ? 12 : c.onZ, { noShadow: true });\n  }\n};\nlet c = null, pills = null, stage = 0, big = 0, t = 0;\nfunction next(step) { c.step = step; c.t = 0; t = 0;\n  if (step === 'still') { c.bal.set.R = .2; c.bal.inRingT = 0; c.bal.totalT = 0; G.mutter('tare', G.line('tare.still'), { auto: 2.5 }); }\n  if (step === 'question') { const qs = G.DATA.lines.questions, q = qs[(G.S.day + (G.S.lineSeed | 0)) % qs.length]; c.question = q; G.say('tare', q.q, { face: 'neutral', choices: q.a, onChoice(i) { G.say('tare', q.r[i], { face: 'smug', onDone() { next('reading'); } }); } }); }\n  if (step === 'reading') { const d = c.ducks.toFixed(1); G.A.sfx('tareBoop'); G.say('tare', G.line('reading', { d }), { face: 'judging', onDone() { next('spine'); } }); }\n  if (step === 'spine') { const s = G.S, row = G.DATA.dayOf(s.day), prev = s.history[s.history.length - 1], now = G.spineShown(); c.prev = prev; c.now = now; big = prev;\n    let line;\n    if (row.hold) line = G.line('tare.plateau');\n    else if (row.catchUp && now < prev) line = G.line('tare.catchup');\n    else if (now < prev) line = 'Your Spine Age is ' + now + '. ' + G.line('tare.spineDown');\n    else if (now >= 71) line = \"Let's call it 71. It doesn't go higher. It's not allowed.\";\n    else line = 'Your Spine Age is ' + now + '. ' + G.line('tare.spineSame');\n    if (s.day === 1) line = 'Your Spine Age is ' + now + \". \" + G.line('tare.number');\n    c.line = line; game.after(1.3, () => { if (c.step === 'spine') { if (now !== prev) G.A.sfx('stamp'); G.say('tare', line, { face: row.hold ? 'sad' : now < prev ? 'happy' : 'neutral', onDone() { c.lineDone = true; } }); } });\n    pills = new G.Pills(['Continue'], { y: () => game.H - 34, w: 120, h: 20, onPick() { next('suggest'); } }); pills.enabled = false; }\n  if (step === 'suggest') {\n    const s = G.S, open = G.order.filter(id => G.activityOpen(id)), pool = open.filter(id => (s.best[id] ? G.bestStars(id) : 0) < 3), list = pool.length ? pool : open, pick = list[(s.day * 7 + (s.runs | 0)) % list.length]; s.suggestion = pick; s.checked = true;\n    const nm = G.activities[pick].name; const tip = game.settings.tips && s.day > 1 ? G.line('tare.tips') : null; const lines = [G.line('tare.suggest', { a: nm })]; if (tip) lines.push(tip);\n    G.say('tare', lines, { face: 'happy', onDone() { G.Save.save(); G.startDay(); } });\n  }\n}\nG.scenes.bodycheck = {\n  view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter(d) {\n    const s = G.S; if (d && d.day) { s.day = d.day; s.checked = false; } G.dbg.activity = null;\n    G.talk.close(); G.setDayLight('morning'); G.music('studio'); c = BC.make({ short: !!G.DATA.dayOf(s.day).shortCheck }); c.step = 'on'; c.onZ = 0; c.rigX = -56; t = 0; c.lineDone = false; pills = null;\n    const last = s.lastSeen ? Math.floor((Date.now() - s.lastSeen) / 86400000) : 0;\n    const hello = s.day === 1 && !s.seen.first ? (s.seen.first = 1, G.DATA.lines.tare.first[1]) : last >= 2 ? G.line('tare.absent', { n: last }) : G.line('tare.hello');\n    c.hello = hello; G.say('tare', hello, { face: 'happy', onDone() { c.greeted = true; } });\n  },\n  update(dt) {\n    G.stageCam(30, 8); c.tare.update(dt); t += dt;\n    const talk = G.talk.update(dt);\n    if (c.step === 'on') { BC.stepRig(c, dt); if (c.greeted) { c.t += dt; const k = clamp(c.t / .7, 0, 1); c.rigX = -56 * (1 - k); c.onZ = Math.sin(k * Math.PI) * 26 + k * 12; if (k >= 1) { c.tare.boop(); G.grunt('member'); if (c.short) next('reading'); else next('still'); } } return; }\n    if (talk) { BC.stepRig(c, dt); return; }\n    if (c.step === 'still' || c.step === 'lean') { BC.stepRig(c, dt, true); if (BC.tests(c, dt)) next('question'); return; }\n    if (c.step === 'spine') { BC.stepRig(c, dt); if (t > .4) big += (c.now - big) * Math.min(1, dt * 2.5); if (c.lineDone) { pills.enabled = true; pills.update(dt); } return; }\n    BC.stepRig(c, dt);\n  },\n  draw(r) {\n    BC.drawStage(r, c);\n    r.overlay(g => {\n      if (c.step === 'still' || c.step === 'lean') BC.hudTests(g, c);\n      if (c.step === 'reading' || c.step === 'question') { }\n      if (c.step === 'reading') { const n = Math.round(c.ducks), W = game.W; for (let i = 0; i < n; i++) { const x = W / 2 - (n - 1) * 9 + i * 18, y = 58 + Math.sin(game.real * 3 + i) * 2; px.ell(g, x, y, 7, 5, '#ffd166'); px.disc(g, x + 5, y - 6, 4, '#ffd166'); px.rect(g, x + 8, y - 6, 4, 2, '#ff9a3a'); px.dot(g, x + 6, y - 7, '#20404c'); } }\n      if (c.step === 'spine' || c.step === 'suggest') {\n        const W = game.W, H = game.H, cw = Math.min(330, W - 24), s = G.S, x0 = (W - cw) / 2, y0 = 12;\n        G.panel(g, x0, y0, cw, 118, { r: 8 });\n        txt(g, 'Spine Age', x0 + 62, y0 + 8, '#5f7f8a', { align: 'center' });\n        txt(g, Math.round(big), x0 + 62, y0 + 26, '#ff7a59', { align: 'center', scale: 5, shadow: '#ffd8cc' });\n        txt(g, 'Gertrude: 19', x0 + 62, y0 + 90, '#b08be0', { align: 'center' });\n        G.drawAgeGraph(g, x0 + 122, y0 + 16, cw - 200, 78, s.history.concat(c.step === 'spine' ? [c.now] : [G.spineShown()]));\n        const scores = G.DISCIPLINES.map(G.disciplineScore); G.drawFlower(g, x0 + cw - 38, y0 + 54, 32, scores);\n        if (pills && pills.enabled && c.step === 'spine' && !G.talk.open) pills.draw(g);\n      }\n      if (!G.talk.open) G.drawDayHudMini(g);\n    });\n    G.talk.draw(r);\n  }\n};\nG.drawDayHudMini = g => { const s = G.S, day = G.DATA.dayOf(s.day); G.panel(g, 8, 8, 72, 28, { r: 7 }); txt(g, 'Day ' + s.day, 14, 12, '#14a8c8'); txt(g, day.name.length > 11 ? day.name.slice(0, 11) : day.name, 14, 22, '#5f7f8a'); };\n})();\nEOF\ncat > game/scenes/evening.js <<'EOF'\n/* scenes/evening.js: the recap, Gerald's count, and bed. One idea: the day is over. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet t = 0, pills = null, rig, poser, tare, coins, phase = 'recap', ageBefore, gShown;\nG.scenes.evening = {\n  view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() {\n    const s = G.S; t = 0; phase = 'recap'; G.dbg.activity = null; G.talk.close(); G.setDayLight('dusk'); G.music('islandDusk'); G.sting('daydone');\n    rig = G.playerRig({ size: 2 }); poser = new G.Poser(rig); poser.clip('Stretch_Yawn', { loop: true, tgt: 1.4, speed: .7 }); tare = new G.TareBody(120, 16); tare.scale = 1.4; coins = new G.Coins(); gShown = s.minutes;\n    pills = new G.Pills(['Go to bed'], { x: () => game.W / 2, y: () => game.H - 36, w: 130, h: 22, onPick() {\n      phase = 'night'; t = 0; poser.clip('Sleeping', { loop: true, tgt: 1.57, fade: .6 }); G.say('tare', G.line('tare.night'), { face: 'asleep', onDone() { G.nextDay(); G.go('bodycheck', null, { fade: 'iris', seconds: .6 }); } });\n    } });\n    if (s.day === 2 && !s.nod) game.after(.5, () => G.mutter('tare', 'Gertrude did not nod today. She will be here tomorrow. She is always here.', { auto: 4 }));\n    G.Save.save();\n  },\n  update(dt) {\n    t += dt; G.stageCam(30, 8); tare.update(dt); if (Math.floor(t / 2.3) !== Math.floor((t - dt) / 2.3)) tare.hop(22);\n    poser.update(dt); rig.update(dt, { x: -60, y: 0, z: phase === 'night' ? 12 : 0, vx: 0, vy: 0, facing: poser.facing, expr: 'smile' });\n    if (G.talk.update(dt)) return;\n    if (phase === 'recap') pills.update(dt);\n  },\n  draw(r) {\n    G.ROOMS.bungalow(r, { dusk: true }); const l = r.w(0, -20, 40); G.L.add(-40, -20, 40, 170, 1, { color: '#ffb860' });\n    G.drawRig(r, rig, -60, 0, phase === 'night' ? 12 : 0, { noShadow: phase === 'night' }); tare.draw(r, { scale: 1.4 });\n    r.overlay(g => {\n      const s = G.S, W = game.W, H = game.H, cw = Math.min(230, W * .56), x0 = W - cw - 14, y0 = 14;\n      G.panel(g, x0, y0, cw, 130, { r: 8 });\n      txt(g, 'Day ' + s.day + ' is over', x0 + cw / 2, y0 + 7, '#14a8c8', { align: 'center' });\n      const best = G.lastRun; txt(g, 'Spine Age', x0 + 40, y0 + 24, '#5f7f8a', { align: 'center' }); txt(g, G.spineShown(), x0 + 40, y0 + 36, '#ff7a59', { align: 'center', scale: 3 });\n      G.drawGerald(g, x0 + cw - 44, y0 + 66, 1.5, { friend: s.minutes >= 30 }); txt(g, Math.floor(s.minutes) + ' min', x0 + cw - 40, y0 + 70, '#20404c', { align: 'center' });\n      G.drawAgeGraph(g, x0 + 14, y0 + 76, cw - 28, 42, s.history.concat([G.spineShown()]));\n      const nx = G.DATA.unlocks.find(u => u.minutes > s.minutes); if (nx) txt(g, 'Gerald is saving for: ' + nx.name, x0 + cw / 2, y0 + 118, '#5f7f8a', { align: 'center' });\n      if (phase === 'recap') pills.draw(g);\n      if (phase === 'recap') G.prompts(g, [['confirm', 'Bed']]);\n    });\n    G.talk.draw(r);\n  }\n};\n})();\nEOF\ncat > game/scenes/tareday.js <<'EOF'\n/* scenes/tareday.js: Day 4. Tare is recalibrated on a huge old scale. You press the button to read it. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nlet t = 0, step = 'talk', tare, needle = 0, target = 0, shake = 0;\nconst hugeScale = (r, x, y) => {\n  const g = r.ctx, p = r.w(x, y, 0), W = 110, H = 110;\n  px.rect(g, p[0] - W / 2 + 6, p[1] - 8, W - 12, 8, '#7a5a3a');\n  px.rect(g, p[0] - W * .2, p[1] - H, W * .4, H - 6, '#a57f54'); px.rect(g, p[0] - W * .2, p[1] - H, 5, H - 6, '#c49c6c');\n  px.rect(g, p[0] - W / 2, p[1] - 16, W, 8, '#c49c6c'); px.rect(g, p[0] - W / 2, p[1] - 16, W, 2, '#e0c094');\n  const cy = p[1] - H - 20; px.disc(g, p[0], cy, 36, '#7a5a3a'); px.disc(g, p[0], cy, 32, '#f7f0dc'); for (let i = 0; i < 20; i++) { const a = -Math.PI * 1.25 + i / 19 * Math.PI * 1.5; px.rect(g, p[0] + Math.cos(a) * 27, cy + Math.sin(a) * 27, 2, 2, '#7a5a3a'); }\n  const a = -Math.PI * 1.25 + needle * Math.PI * 1.5; px.line(g, p[0], cy, p[0] + Math.cos(a) * 24, cy + Math.sin(a) * 24, '#e0553a', 2); px.disc(g, p[0], cy, 3, '#20404c');\n  E.font.text(g, 'grams', p[0], cy + 12, '#7a5a3a', { align: 'center', outline: false });\n};\nG.scenes.tareday = {\n  view: 'brawler', camera: { zoom: false }, pausable: true,\n  enter() {\n    t = 0; step = 'talk'; needle = 0; target = 0; shake = 0; G.dbg.activity = null; G.talk.close(); G.setDayLight('morning'); G.music('islandDusk');\n    tare = new G.TareBody(-110, 10); tare.scale = 1.8; tare.say('worried', 30);\n    G.say('tare', G.DATA.lines.tareDay, { face: 'worried', onDone() { step = 'hop'; t = 0; } });\n  },\n  update(dt) {\n    t += dt; G.stageCam(40, 8); tare.update(dt, step === 'hop' ? [60, 10, 3] : null); if (G.talk.update(dt)) return;\n    if (step === 'hop') { if (Math.hypot(tare.x - 60, tare.y - 10) < 8) { tare.x = 60; tare.z = 0; tare.vz = 0; step = 'press'; t = 0; target = 0; G.A.sfx('stamp'); needle = .02; } return; }\n    if (step === 'press') { needle = .02 + Math.sin(t * 2) * .004; if (game.input.pressed('confirm') || game.input.clicked()) { game.input.consumeAll(); step = 'read'; t = 0; G.A.sfx('creak'); G.A.sfx('tareBoop'); } return; }\n    if (step === 'read') { const k = clamp(t / 2.2, 0, 1); needle = .02 + Math.sin(k * Math.PI * 4) * (1 - k) * .4 + k * .03; shake = (1 - k) * .4; if (k >= 1) { step = 'after'; tare.say('sad', 30); G.say('tare', G.DATA.lines.tareRead, { face: 'sad', onDone() { G.S.tareDay = true; G.Save.save(); G.startDay(); } }); } }\n  },\n  draw(r) {\n    G.ROOMS.reception(r); hugeScale(r, 60, -6); \n    const z = step === 'press' || step === 'read' || step === 'after' ? 18 : 0;\n    tare.z = Math.max(tare.z, step === 'press' || step === 'read' || step === 'after' ? 18 : 0);\n    tare.draw(r, { scale: 1.8, shake });\n    r.overlay(g => { if (step === 'press') { G.panel(g, game.W / 2 - 100, game.H - 60, 200, 24, { r: 9 }); txt(g, \"Read Tare's weight\", game.W / 2, game.H - 53, '#20404c', { align: 'center' }); G.prompts(g, [['confirm', 'Read it']]); } });\n    G.talk.draw(r);\n  }\n};\n})();\nEOF\necho done","description":"Write the island, member, arrival, Body Check, evening and Tare's Day scenes"}}}
