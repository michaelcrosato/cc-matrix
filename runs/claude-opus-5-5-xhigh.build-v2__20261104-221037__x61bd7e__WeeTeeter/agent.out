 { auto: 3 }); }\")\ns=s.replace(\"    for (const c of ctx.contestants) {\\n      const b = c.bal, I = c.intent;\\n      b.set.A = 1.1\",\"    if (fat > .35 && !ctx.saidTired && ctx.instructor && ctx.local && !ctx.quiet) { ctx.saidTired = true; G.mutter(ctx.instructor, G.DATA.lines[ctx.instructor].tired, { auto: 3 }); }\\n    for (const c of ctx.contestants) {\\n      const b = c.bal, I = c.intent;\\n      b.set.A = 1.1\")\nopen('game/activities/rep.js','w').write(s)\nsub('game/activities/hold.js',\"      G.feelBalance(ctx, c, dt);\\n\",\"      G.feelBalance(ctx, c, dt);\\n      if (c.local && !ctx.quiet && !ctx.saidGood && b.streak > 8 && ctx.instructor) { ctx.saidGood = true; G.mutter(ctx.instructor, G.DATA.lines[ctx.instructor].good, { auto: 3 }); }\\n\")\nsub('game/activities/hoop.js',\"const who = G.S.instructor || 'birch'; G.mutter('okafor', 'Other way!', { auto: 2 }); }\",\"const who = G.S.instructor || 'birch'; G.mutter(who, G.DATA.lines[who].other, { auto: 2.6 }); }\")\n# Body Check words\nsub('game/scenes/bodycheck.js',\"G.say('tare', q.q, { face: 'neutral', choices: q.a,\",\"G.say('tare', [G.line('tare.leanPraise'), q.q], { face: 'neutral', choices: q.a,\")\nsub('game/scenes/bodycheck.js',\"const hello = s.day === 1 && !s.seen.first ? (s.seen.first = 1, G.DATA.lines.tare.first[1]) : last >= 2 ? G.line('tare.absent', { n: last }) : G.line('tare.hello');\",\"const hello = s.day === 1 && !s.seen.first ? (s.seen.first = 1, G.DATA.lines.tare.first[1]) : last >= 2 ? G.line('tare.absent', { n: last }) : G.DATA.dayOf(s.day).games ? G.line('tare.day5') : G.line('tare.hello');\")\nEOF\nnode -e \"\nconst s=require('fs').readFileSync('game/scenes/member.js','utf8');console.log(s.includes('const I = game.input'), s.indexOf('G.scenes.member'));\"; sed -n '/G.scenes.member = {/,/^  draw(r)/p' game/scenes/member.js | cut -c1-140 | head -16","description":"Add Blob pigeons, card erase, and instructor lines at their moments"}}}
