ve: slalom turn', Math.abs(q.sx - x1) > Math.abs(dx1) * 1.4, [dx1, q.sx - x1]); reset(); }\n    { const c = playRun(g, 'tray', { seconds: .1 }), q = c.contestants[0]; d.trayG = 800; q.bal.x = .5; G.stepRun(c, 1 / 120); check('§13 live: tray gravity', Math.abs(q.world.gravity[0]) > 300, q.world.gravity); reset(); d.trayF = 1.5; G.stepRun(c, 1 / 120); check('§13 live: tray friction', q.olives[0].damping === 1.5, q.olives[0].damping); reset(); }\n    { const c = playRun(g, 'laundry', { seconds: 1 }), q = c.contestants[0], s0 = q.bal.set.s; d.rope = .5; G.stepRun(c, 1 / 120); check('§13 live: rope instability', q.bal.set.s === s0 * .5, q.bal.set.s); reset(); const gustRun = v => { d.gust = v; const r = playRun(g, 'laundry', { skill: 'expert', seconds: 22 }); reset(); return r.contestants[0].bal.vx + r.contestants[0].bal.x; }; check('§13 live: gust strength', gustRun(2.5) !== gustRun(0)); }\n  }\n  /* §14 multiplayer */\n  check('§14 session tags in order', /<meta charset=\"utf-8\">\\s*<script>\\/\\*! aihub-session[\\s\\S]*?<\\/script>\\s*<meta name=\"viewport\"[^>]*>\\s*<title>[^<]*<\\/title>\\s*<meta name=\"description\"[^>]*>\\s*<meta name=\"theme-color\" content=\"#2cc6e6\">\\s*<meta name=\"hub:type\" content=\"Game\"><meta name=\"hub:players\" content=\"1–4\"><meta name=\"hub:source\" content=\"Wii Fit\">\\s*<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\">\\s*<meta name=\"hub:session-minutes\" content=\"3\">\\s*<meta name=\"hub:session-goal\"[^>]*>\\s*<meta name=\"hub:session-howto\"[^>]*>/.test(html)); for (const id of ['stork', 'candle', 'squat', 'step', 'hoop']) check('§14 Class activity: ' + id, A(id).class === true); check('§14 scores 0 to 1000', (() => { const c = playRun(g, 'stork', { seconds: 50 }); return c.contestants[0].score === Math.round(c.contestants[0].pct * 1000); })()); check('§14 podium titles', ['Most Still', 'Best Wobble', 'Participated'].every(t => L.class.titles.includes(t))); check('§14 the join line', /Start on a pad, or 2 on the keyboard/.test(L.class.join)); check('§14 Morning Class: three groups, 5 + 40 + 5 s', /GROUPS = \\[\\['stork', 'candle', 'squat', 'pushup'\\], \\['step', 'hoop'\\], \\['slalom', 'jog'\\]\\], INTRO = 5, PLAY = 40, SCORE = 5/.test(source));\n  /* §15 tech and setup */\n  for (const f of ['game/core.js', 'game/balance.js', 'game/rigs.js', 'game/ui.js', 'game/audio.js', 'game/index.html', 'game/data/lines.js', 'game/data/poses.js', 'game/data/activities.js', 'game/data/charts.js', 'game/data/courses.js', 'game/data/trays.js', 'game/data/days.js', 'game/data/unlocks.js', 'game/data/README.md', 'tests/run.mjs', 'build.mjs', 'vendor/session.js', 'vendor/readable.js', 'vendor/mocap.js', 'vendor/fitclips.js', 'engine/my-3d2dge.js', 'engine/API.md', ...['hold', 'candle', 'rep', 'step', 'hoop', 'jog', 'slalom', 'tray', 'laundry'].map(a => `game/activities/${a}.js`), ...['title', 'attract', 'member', 'arrival', 'island', 'bodycheck', 'session', 'evening', 'games', 'ending', 'about', 'class', 'round'].map(a => `game/scenes/${a}.js`)]) check('§15 layout: ' + f, existsSync(join(root, f)));\n  for (const k of ['scene', 'activity', 'tier', 'day', 'session', 'pct', 'stars', 'minutes', 'spineAge', 'lean', 'source']) check('§15 snapshot has ' + k, k in game.debug.snapshot()); for (const id of G.order) { const a = A(id); check('§15 registry entry is complete: ' + id, ['setup', 'update', 'draw', 'hud', 'result', 'bot'].every(k => typeof a[k] === 'function') && !!a.family && !!a.discipline && !!a.tiers); check('§15 its own pausable scene: ' + id, G.scenes[G.actScene(id)].pausable === true && G.scenes[G.actScene(id)].camera.zoom === false); }\n  check('§15 G.ABOUT is the exit interview', !!G.ABOUT); check('§15 every </script is escaped in what is inlined', (html.match(/<\\/script/gi) || []).length === (html.match(/<script/gi) || []).length);\n  for (const [hash, want] of [['#hub', 'island'], ['#act/stork/1', 'act_stork'], ['#day/3', 'bodycheck'], ['#ending', 'ending']]) { const h = load({ hash }); h.game.advance(.5); check('§15 deep link ' + hash, h.game.sceneName === want, h.game.sceneName); if (hash === '#act/stork/1') check('§15 deep link picks the tier', h.G.scenes.act_stork.run().tierIdx === 0); if (hash === '#day/3') check('§15 deep link picks the day', h.G.S.day === 3, h.G.S.day); }\n  check('§15 no ES modules: the page runs from file://', !/<script[^>]*type=\"module\"/.test(html)); check('§15 no other libraries', !/https?:\\/\\/[^\"' ]+\\.js/.test(html.replace(/https?:\\/\\/[^\"'\\s]*github[^\"'\\s]*/g, '').slice(0, 2000)));\n  check('§15 no errors through the whole audit', !game.errors.length, game.errors.slice(0, 3).map(e => e.where + ': ' + e.message));\n}\nEOF\npython3 - <<'EOF'\ndef sub(p, a, b):\n    s=open(p).read()\n    if a not in s: print('MISSING',p,a[:80]); return\n    open(p,'w').write(s.replace(a,b,1))\n# sliders that were only read at setup are now live; G.ABOUT as the plan names it\nsub('game/activities/step.js',\"      const rh = c.rh;\\n      if (c.skill || (G.DEV.bot && c.local)) {\",\"      const rh = c.rh; rh.windows.perfect = 45 * G.DEV.window; rh.windows.great = 90 * G.DEV.window; rh.windows.good = 135 * G.DEV.window;\\n      if (c.skill || (G.DEV.bot && c.local)) {\")\nsub('game/activities/tray.js',\"      c.world.wake(); c.world.step(dt);\",\"      for (const o of c.olives) o.damping = (ctx.tier.friction || 0) + G.DEV.trayF;\\n      c.world.wake(); c.world.step(dt);\")\nsub('game/core.js',\"G.TITLE = 'Wee Teeter';\",\"G.TITLE = 'Wee Teeter';\\nG.ABOUT = window.WEE_ABOUT || {};\")\nsub('game/scenes/about.js',\"const A = window.WEE_ABOUT || {}, si\",\"const A = G.ABOUT, si\")\ns=open('tests/run.mjs').read()\ns=s.replace(\"import { load, root, files } from './lib.mjs';\",\"import { load, root, files } from './lib.mjs';\\nimport { planAudit } from './plan.mjs';\")\ns=s.replace(\"if (group === 'audit') { lint(); devices(); screens(); dataOnly(); }\",\"if (group === 'audit') { lint(); devices(); screens(); dataOnly(); }\\n  if (group === 'plan' || group === 'rules' || group === 'all') planAudit(process.argv.includes('--list') ? (n, ok, d) => { console.log((ok ? 'ok   ' : 'FAIL ') + n); check(n, ok, d); } : check);\")\ns=s.replace(\"{ const A = g.ctx.WEE_ABOUT = JSON.parse(readFileSync(join(root, '..', 'exit-interview.json'), 'utf8')); G.go('about', null, { fade: 0 });\",\"{ const A = g.ctx.WEE_ABOUT = g.G.ABOUT = JSON.parse(readFileSync(join(root, '..', 'exit-interview.json'), 'utf8')); G.go('about', null, { fade: 0 });\")\nopen('tests/run.mjs','w').write(s)\nEOF\nnpm install playwright@1.63.0 2>&1 | tail -1; node build.mjs | tail -1 | cut -c150-; timeout 500 node tests/run.mjs plan 2>&1 | tail -30 | cut -c1-260","description":"Write the section-by-section plan audit, make two sliders live, run it","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":4,"cache_creation_input_tokens":3640,"cache_read_input_tokens":906222,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3640},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e35d4c2a-4185-48d4-8818-8a6b8bcd7047","uuid":"6f8048f6-67d3-4e1f-affb-9906bcf632b3","timestamp":"2026-11-05T09:22:27.175Z","request_id":"req_011CgjXqLTd6KhAqHMPo6pAz","wire_tool_inputs":{"toolu_01L59Anb5gPUMXGBGSRntehC":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-221037__x61bd7e/work/WeeTeeter-WiiFit-claude-opus-5-5-xhigh-20261104-221037 && pwd; grep -n \"Songbook = \\|E.Songbook\\b\" engine/modules/songs.js | head -5 | cut -c1-200; grep -n \"songs\\b.*=\\|list()\\|get(id\\|find(mood\" engine/modules/songs.js | head -8 | cut -c1-180\ncat > tests/plan.mjs <<'EOF'\n// PLAN.md, section by section: every number, table and list a script can read, checked against the running game.\n// node tests/run.mjs plan prints failures and a count; node tests/run.mjs plan --list prints every line it checked.\nimport { readFileSync, existsSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { load, root, files } from './lib.mjs';\nconst near = (a, b, e = 1e-6) => Math.abs(a - b) <= e;\nconst IDLE = g => { g.G.scenes.__idle = g.game.scenes.__idle = { update() {}, draw() {} }; g.game.go('__idle', null, { fade: 0 }); g.game.advance(.05); };\nconst playRun = (g, id, o = {}) => { const { G, game } = g; const ctx = G.makeRun(id, Object.assign({ tier: 0, seed: 7, contestants: [{ name: 'B', skill: o.skill === undefined ? 'good' : o.skill, local: true, look: G.S.look }], quiet: true }, o.run)); if (ctx.def.begin) ctx.def.begin(ctx); let n = 0; const max = (o.seconds || 240) * 120; while (!ctx.done && n < max) { game.advance(1 / 120); G.stepRun(ctx, 1 / 120); n++; } return ctx; };\nexport function planAudit(check) {\n  const plan = readFileSync(join(root, '..', 'PLAN.md'), 'utf8');\n  const g = load({ draw: false }), { G, E, game } = g, A = id => G.activities[id], S = () => G.S; game.fadeTime = 0; game.advance(.05); G.devMember(5); G.S.freePlay = true; IDLE(g);\n  const L = G.DATA.lines, html = readFileSync(join(root, '..', 'WeeTeeter-WiiFit-claude-opus-5-5-xhigh-20261104-221037.html'), 'utf8');\n  /* §1 the views the plan names */\n  for (const [id, v] of [['stork', 'brawler'], ['flow', 'brawler'], ['candle', 'brawler'], ['squat', 'brawler'], ['pushup', 'brawler'], ['lunge', 'brawler'], ['step', 'brawler'], ['hoop', 'brawler'], ['tray', 'tray'], ['laundry', 'side']]) check(`§1 ${id} uses the ${v} view`, A(id).view === v, A(id).view);\n  check('§1 island is threequarter', G.scenes.island.view === 'threequarter'); check('§1 slalom is Mode 7', G.m7 instanceof E.Mode7); { const c = playRun(g, 'jog', { seconds: .1 }); check('§1 jog is the pseudo-3D road', c.road instanceof E.Road); }\n  check('§1 catalogue genre is Sports', JSON.parse(readFileSync(join(root, '..', 'exit-interview.json'), 'utf8')).aiHub.genre === 'Sports');\n  /* §3 the Lean */\n  const T = { body: [G.DATA.bodyCheck.set, 14, 7, 4, 3, 1.1, .20], flow: [A('flow').tiers[0].set, 12, 6, 6, 3.2, 1.3, .28, .5, 9], stork1: [A('stork').tiers[0].set, 12, 5, 13, 3, 1.5, .24, .6, 7], stork2: [A('stork').tiers[1].set, 11, 4.5, 15, 3.6, 1.7, .22, .7, 6], candle: [A('candle').tiers[0].set, 10, 5, 11, 1.4, .8, .20, .55, 5], rope: [A('laundry').tiers[0].set, 10, 3.5, 16, 3.5, 1.2, .40, .9, 5] };\n  for (const k in T) { const [s, ...v] = T[k], names = ['k', 'c', 's', 'A', 'nf', 'R', 'pushV', 'pushEvery']; v.forEach((x, i) => check(`§3 table: ${k}.${names[i]} = ${x}`, s[names[i]] === x, s[names[i]])); }\n  for (const [n, tau, gain, damp, noise] of [['poor', .34, 1.1, .22, .16], ['average', .25, 1.4, .30, .08], ['good', .18, 1.8, .36, .04], ['expert', .14, 2.2, .42, .02]]) check(`§3 bot ${n}`, G.BOTS[n].tau === tau && G.BOTS[n].gain === gain && G.BOTS[n].damp === damp && G.BOTS[n].noise === noise);\n  { const b = new G.Balance({ k: 12, c: 5, s: 13, A: 0, nf: 1, R: .2 }, E.rng(1)); b.x = .99; b.vx = 3; b.step(1 / 120, 0, 0); check('§3 past the edge is a stumble', b.falls === 1 && b.stumbling > 0, b.falls); const x0 = b.x; for (let i = 0; i < 60; i++) b.step(1 / 120, 1, 0); check('§3 a stumble ignores input and eases home', b.x < x0 && b.x >= 0, [x0, b.x]); for (let i = 0; i < 70; i++) b.step(1 / 120, 0, 0); check('§3 a stumble lasts 1 s', b.stumbling <= 0, b.stumbling); }\n  { game.settings.set('gentle', true); const b = new G.Balance({ k: 12, c: 5, s: 13, A: 3, nf: 1, R: .2 }, E.rng(2)); check('§3 Gentle Mode: ring x1.25', near(b.R, .25)); game.settings.set('gentle', false); check('§3 Gentle Mode line', L.tare.gentle === \"Gentle Mode is on. I won't tell anyone. I don't know anyone.\"); }\n  for (const [a, codes] of Object.entries({ breath: ['Space', 'Mouse0', 'Pad6', 'Pad7'], catchL: ['KeyQ', 'Mouse0', 'Pad4'], catchR: ['KeyE', 'Mouse2', 'Pad5'], interact: ['KeyE', 'Enter', 'Pad0'], more: ['Tab', 'KeyM', 'Pad3'], retry: ['KeyR', 'Pad2'], paceL: ['KeyJ', 'Mouse0', 'Pad6'], paceR: ['KeyK', 'Mouse2', 'Pad7'], stepL: ['KeyA', 'ArrowLeft', 'Mouse0', 'Pad14', 'PadAxisLeft'], stepR: ['KeyD', 'ArrowRight', 'Mouse2', 'Pad15', 'PadAxisRight'], stepU: ['KeyW', 'ArrowUp', 'WheelUp', 'Pad12', 'PadAxisUp'], stepD: ['KeyS', 'ArrowDown', 'WheelDown', 'Pad13', 'PadAxisDown'] })) check('§3 input map: ' + a, codes.every(c => G.INPUT[a].includes(c)), G.INPUT[a]);\n  for (const a of ['up', 'down', 'left', 'right', 'start', 'pause', 'confirm', 'cancel']) check('§3 the map keeps the engine action ' + a, !!G.INPUT[a]);\n  /* §4 the activities */\n  const STARS = { stork: [.35, .65, .90], flow: [.5, .75, .92], candle: [.35, .65, .90], squat: [.35, .65, .90], pushup: [.35, .65, .90], lunge: [.35, .65, .90], step: [.5, .75, .92], hoop: [.35, .65, .90], jog: [.35, .65, .90], slalom: [.35, .65, .90], tray: [.35, .65, .90], laundry: [.35, .65, .90] };\n  for (const id in STARS) { check(`§4 ${id} star thresholds`, JSON.stringify(A(id).stars) === JSON.stringify(STARS[id]), A(id).stars); check(`§4 ${id} has a tier 2`, A(id).tiers.length >= 2); check(`§4 ${id} says what you can and cannot do`, !!A(id).say); }\n  check('§4 twelve activities in four disciplines', G.order.length === 12 && G.DISCIPLINES.every(d => G.order.filter(i => A(i).discipline === d).length === 3));\n  check('§4 Stork 45 s, Flow 80 s, Candle 60 s, Step 60 s, Hoop 60 s', A('stork').dur === 45 && A('flow').dur === 80 && A('candle').dur === 60 && A('step').dur === 60 && A('hoop').dur === 60);\n  check('§4 Stork moves its ring every 12 s, gull push 2.5', A('stork').tiers[0].ringEvery === 12 && A('stork').tiers[0].gull.force === 2.5); check('§4 Eyes Closed hides the Plate', A('stork').tiers[1].blind === true && A('stork').tiers[1].name === 'Eyes Closed');\n  check('§4 Sun Flow: five poses, breaths of 4 s and 4 s', JSON.stringify(A('flow').tiers[0].poses) === JSON.stringify(['lunge', 'dog', 'triangle', 'warrior', 'stork']) && JSON.stringify(A('flow').tiers[0].breaths) === '[4,4]');\n  check('§4 Candle lines and tier 2 extras', L.tare.candleCheat.startsWith('Did you put the controller down?') && JSON.stringify(A('candle').tiers[1].extras) === JSON.stringify(['blender', 'goose']));\n  { const c = playRun(g, 'candle', { skill: null, run: { contestants: [{ name: 'P', input: game.input, local: true, look: S().look }] } }); check('§4 Candle: one relight, then it ends', c.contestants[0].relit && c.contestants[0].out && c.time < c.dur, c.time); const r = A('candle').result(c, c.contestants[0]); check('§4 Candle: pct is .6 steadiness + .4 flame, -15% relit', r.pct < .35, r.pct); }\n  for (const [id, a, b] of [['squat', 8, 12], ['pushup', 6, 10], ['lunge', 8, 12]]) { check(`§4 ${id} reps ${a} / ${b}`, A(id).tiers[0].reps === a && A(id).tiers[1].reps === b); check(`§4 ${id} tempo 2 s down, 2 s up`, A(id).tiers[0].down === 2 && A(id).tiers[0].up === 2); }\n  check('§4 Squat clip 22_14 from 1.1 to 1.72', A('squat').clip === '22_14' && A('squat').top === 1.1 && A('squat').bottom === 1.72); check('§4 Push-Up clip to half its length', A('pushup').clip === 'Pushup' && A('pushup').bottomShare === .5); check('§4 Side Lunge poses the body by hand', A('lunge').bodyMove === 'sideLunge' && A('lunge').axis === 'x'); check('§4 Facing 1.2, .1, pi/2', A('squat').facing === 1.2 && A('pushup').facing === .1 && near(A('lunge').facing, 1.57, .01));\n  { const c = playRun(g, 'squat', { skill: 'expert' }); check('§4 Two more: a high scorer gets two bonus reps', c.extra === true && c.reps === 10, c.reps); check('§4 Rep grades exist', ['Perfect', 'Good', 'Late'].includes(c.contestants[0].grade), c.contestants[0].grade); }\n  check('§4 Step: 100 bpm and 120 bpm, four lanes in order', G.SONGS.stepA.bpm === 100 && G.SONGS.stepB.bpm === 120 && JSON.stringify(['stepL', 'stepD', 'stepU', 'stepR'].map(a => !!G.INPUT[a])) === '[true,true,true,true]');\n  { const notes = (n, ch) => n.flatMap(k => ch.parts[k]); const c = G.DATA.charts.stepA, used = new Set(); for (const k in c.parts) c.parts[k].forEach((s, i) => { if (/[xh]/.test(s)) used.add(i); }); check('§4 tier 1 charts use only left and right', [...used].every(i => i === 0 || i === 3), [...used]); const c2 = G.DATA.charts.stepB, u2 = new Set(); for (const k in c2.parts) c2.parts[k].forEach((s, i) => { if (/[xh]/.test(s)) u2.add(i); }); check('§4 tier 2 charts use all four', u2.size === 4, [...u2]); const ctx = playRun(g, 'step', { seconds: .1 }); check('§4 Step windows 45 / 90 / 135 and a song with no loop', ctx.contestants[0].rh.windows.perfect === 45 && ctx.contestants[0].rh.windows.great === 90 && ctx.contestants[0].rh.windows.good === 135 && ctx.song.loop === false && ctx.song.len > 0); if (ctx.def.stop) ctx.def.stop(ctx); check('§4 Step lasts about 60 s', Math.abs(ctx.dur - 60) < 1.5, ctx.dur); }\n  check('§4 Hoop band 7 to 11', G.DEV.hoopLo === 7 && G.DEV.hoopHi === 11); { const c = playRun(g, 'hoop', { skill: 'expert' }); check('§4 Hoop: stacks hoops, up to 6', c.contestants[0].hoops >= 2 && c.contestants[0].hoops <= 6, c.contestants[0].hoops); check('§4 Hoop: Other way at halfway', c.swapI === 1, c.swapI); }\n  check('§4 Jog band 2.6 to 3.4', G.DEV.jogLo === 2.6 && G.DEV.jogHi === 3.4); { const c = playRun(g, 'jog', { skill: 'good' }); check('§4 a jog lap takes about 70 s', Math.abs(c.time - 70) < 12, c.time); check('§4 Jog has pigeons, joggers and cups', ['pigeons', 'jogger', 'cup'].every(k => c.things.some(q => q.kind === k))); }\n  { const r = playRun(g, 'jog', { skill: null, seconds: .1, run: { contestants: [{ name: 'P', input: game.input, local: true, look: S().look }] } }), q = r.contestants[0]; q.cad = 4.5; q.lastStep = r.time; for (let i = 0; i < 2.2 * 120; i++) { q.cad = 4.5; q.lastStep = r.time; game.advance(1 / 120); G.stepRun(r, 1 / 120); } check('§4 Sprinting over 4.2 for 2 s is a Stitch', q.stitch > 0, q.stitch); }\n  { const co = G.DATA.courses.slalom[0]; check('§4 Slalom 18 gates at 220', co.gates.length === 18 && G.DEV.skiSpeed === 220); const c = playRun(g, 'slalom', { skill: 'good' }), p = c.contestants[0]; check('§4 Slalom takes about 60 s', c.time > 40 && c.time < 75, c.time); check('§4 Regulars\\' times at the finish', /Gertrude 0:58\\. She walked\\./.test(p.detail), p.detail); check('§4 Tier 2: narrower gates and fog', G.DATA.courses.slalom[1].gateWidth < co.gateWidth && !!G.DATA.courses.slalom[1].fog); }\n  { check('§4 Tray gravity 420', G.DEV.trayG === 420); const n = G.DATA.trays.map(t => t.rows.join('').split('o').length - 1); check('§4 Trays of 3, 5, 7 olives', JSON.stringify(n) === '[3,5,7]', n); check('§4 The second has bumpers and a gap', /B/.test(G.DATA.trays[1].rows.join('')) && /~/.test(G.DATA.trays[1].rows.join(''))); check('§4 The third has a gecko', /K/.test(G.DATA.trays[2].rows.join(''))); }\n  { const co = G.DATA.courses.laundry; check('§4 Laundry: three spans', co.spans.length === 3); check('§4 Laundry gust 9', A('laundry').tiers[0].gust === 9); check('§4 The sign', L.sign.laundry === 'Please do not walk on the laundry line. Walking on the laundry line: 10:30 daily.'); const c = playRun(g, 'laundry', { skill: 'good' }); check('§4 Laundry takes about 70 s', c.time > 45 && c.time < 100, c.time); check('§4 Each fall costs .06', c.contestants[0].pct <= 1 - .06 * c.contestants[0].falls + 1e-9, [c.contestants[0].pct, c.contestants[0].falls]); }\n  { check('§4 Games: Stork, Step, Slalom, then a 90 s duel', JSON.stringify(G.DATA.games.list) === JSON.stringify(['stork', 'step', 'slalom']) && G.DATA.games.duel === 90); check('§4 Six escalating distractions', L.duel.length === 6); const w = playRun(g, 'candle', { skill: 'expert', run: { mode: 'duel', dur: 90 } }); check('§4 Her flame weakens only after 75 s, then a win', w.won === true && w.time > 75, [w.won, w.time]); check('§4 Her line', L.gertrudeWin === \"Well done, dear. I've been waiting since Thursday.\"); const l = playRun(g, 'candle', { skill: null, run: { mode: 'duel', dur: 90, contestants: [{ name: 'P', input: game.input, local: true, look: S().look }] } }); check('§4 A lost duel still ends, and her flame held', !l.won && l.herFlame === 1, [l.won, l.herFlame]); }\n  /* §5 progress */\n  { G.S = G.freshMember(); check('§5 Spine Age starts at 71', G.spineAge() === 71); for (const id of G.order) G.S.best[id] = [3]; check('§5 3 stars everywhere is 20', G.spineAge() === 20, G.spineAge()); G.S.duelWon = true; check('§5 and the duel makes 19', G.spineAge() === 19, G.spineAge()); G.S = G.freshMember(); G.S.suggestion = 'tray'; const a = G.earnMinutes(1, 2, 'stork').add, b = G.earnMinutes(1, 2, 'tray').add; check('§5 minutes x (1 + .25 stars)', near(a, 1.5), a); check(\"§5 x 1.5 on Tare's Suggestion\", near(b, 2.25), b); G.devMember(5); G.S.freePlay = true; }\n  check('§5 unlocks at 5 to 30 minutes', JSON.stringify(G.DATA.unlocks.map(u => [u.minutes, u.id])) === JSON.stringify([[5, 'towel'], [10, 'headband'], [15, 'sunhat'], [20, 'bowtie'], [25, 'hat'], [30, 'friend']]));\n  const D = G.DATA.days; check('§5 Day 1 opens Stork, Squat, Step, Tray', JSON.stringify(D[0].opens) === JSON.stringify(['stork', 'squat', 'step', 'tray'])); check('§5 Day 2 opens Flow, Push-Up, Hoop, Laundry', JSON.stringify(D[1].opens) === JSON.stringify(['flow', 'pushup', 'hoop', 'laundry'])); check('§5 Day 3 opens Candle, Lunge, Jog, Slalom', JSON.stringify(D[2].opens) === JSON.stringify(['candle', 'lunge', 'jog', 'slalom'])); check(\"§5 Day 3 holds, Day 4 catches up and is Tare's, Day 5 is the Games\", D[2].hold === true && D[3].catchUp === true && D[3].scene === 'tareday' && D[4].games === true); check('§5 Day names', ['Orientation', 'Improvement', 'The Plateau', \"Tare's Day\", 'The Gentle Games'].every((n, i) => D[i].name === n));\n  check('§5 Arrival card', L.arrival[0] === \"You have been gifted a five-day stay at the Institute for Gentle Improvement. The card isn't signed. It only says: 'You know why.'\");\n  for (const [q, a, b] of [['Have you recently sat?', 'Yes', 'Define recently'], ['Do stairs ever surprise you?', 'Often', 'Only the last one'], ['Do you make a small noise when you stand up?', 'Yes', 'No (this is a lie)'], ['On a scale of one to me, how do you feel?', 'One', 'Me'], ['When did you last look at your feet?', 'Just now', \"I'd rather not\"]]) check('§5 question: ' + q, L.questions.some(x => x.q === q && x.a[0] === a && x.a[1] === b));\n  check('§5 the Reading is in ducks', L.reading.some(r => r === 'Today you weigh {d} ducks. That is a normal number of ducks.')); check('§5 hair, 6 skins, 8 tops, 4 bottoms', JSON.stringify(G.LOOK.hair) === JSON.stringify(['short', 'spiky', 'long', 'ponytail', 'bald']) && G.LOOK.skins.length === 6 && G.LOOK.tops.length === 8 && G.LOOK.bottoms.length === 4); for (const n of ['Gentle Doug', 'Sir Slouch', 'Ms. Almost', 'The Other Pat']) check('§5 nickname ' + n, L.nicknames.includes(n));\n  check('§5 ending lines by final age', L.ending.mid === 'Your spine has stopped asking questions.' && L.ending.high === 'Come back. Please. I mean that in a wellness way.' && /hat/.test(L.ending.low));\n  /* §6 the island */\n  G.Island.build(); { const I = G.Island, R = G.DATA.island.rows; check('§6 about 44 x 26 cells', R.length === 26 && R[0].length === 44); check('§6 crossing takes about 5 s', Math.abs(44 * 16 / 132 - 5) < .5); for (const [area, ids] of [['deck', ['stork', 'flow', 'candle']], ['iron', ['squat', 'pushup', 'lunge']], ['pier', ['step', 'hoop', 'jog']]]) for (const id of ids) check(`§6 ${id} mat is on the ${area}`, G.DATA.island.floors[Object.keys(G.DATA.island.mats).find(k => G.DATA.island.mats[k] === id)] === area); for (const id of ['tray', 'slalom', 'laundry']) check(`§6 ${id} mat is in the park or at its posts`, ['park', 'path'].includes(G.DATA.island.floors[Object.keys(G.DATA.island.mats).find(k => G.DATA.island.mats[k] === id)])); check('§6 twelve mats, seven groups of people', I.mats.length === 12 && I.people.length === 7); check('§6 Bed, rail, scale', !!I.bed && !!I.rail && !!I.scale); check('§6 the motto is on a sign', I.signs.some(s => s.t === 'Gently, Or Not At All.')); for (const n of ['Stillness Deck', 'Iron Room', 'Aerobics Pier', 'Balance Park', 'Bungalow', 'Juice Bar', 'Reception']) check('§6 place: ' + n, I.signs.some(s => s.t === n)); }\n  /* §7 cast and voice */\n  check('§7 8 faces', JSON.stringify(G.TARE_FACES.slice().sort()) === JSON.stringify(['neutral', 'happy', 'worried', 'smug', 'shocked', 'sad', 'asleep', 'judging'].sort())); for (const m of ['Zeroing the scale', 'Sanding the instructors', 'Counting the ducks', 'Telling the hippo']) check('§7 boot message: ' + m, L.boot.includes(m)); for (const k of ['gertrude', 'dennis', 'marisol', 'kevin', 'okafor', 'lou', 'twins']) check('§7 the Regular ' + k, !!L.regulars[k] && !!G.SPEAKERS[k]); check('§7 the instructors differ', L.birch.hello !== L.alder.hello && G.WOOD.birch.a === '#d9b68a' && G.WOOD.alder.a === '#ecd3ac');\n  /* §7 the tone rules, by machine: short sentences, no game talk, no body talk, no pop culture, no profanity */\n  { const strings = []; const walk = o => { if (typeof o === 'string') strings.push(o); else if (Array.isArray(o)) o.forEach(walk); else if (o && typeof o === 'object') for (const k in o) walk(o[k]); }; const copy = Object.assign({}, L); delete copy.nicknames; delete copy.boot; walk(copy);\n    check('§7 150 lines or more', strings.length >= 150, strings.length); let longest = 0, worst = ''; for (const s of strings) for (const t of s.split(/(?<=[.?!])\\s+/)) { const n = t.split(/\\s+/).length; if (n > longest) { longest = n; worst = t; } } check('§7 short sentences: none over 16 words', longest <= 16, longest + ': ' + worst);\n    const bad = { games: /\\b(player|video ?game|gamer|level up|high score|achievement|tutorial|save file|respawn|npc|checkpoint|controller'?s? button)\\b/i, body: /\\b(fat|thin|skinny|chubby|overweight|obese|bmi|calorie|diet|belly|tummy|flabby|lose weight|weight loss)\\b/i, mean: /\\b(stupid|idiot|loser|dumb|lazy|pathetic|ugly|useless|worthless|shut up)\\b/i, swear: /\\b(damn|hell|crap|shit|ass|bloody)\\b/i, pop: /\\b(netflix|instagram|tiktok|facebook|google|twitter|star wars|marvel|taylor swift|mario|zelda|yoda|fitbit|peloton|internet|meme)\\b/i };\n    for (const k in bad) { const hits = strings.filter(s => bad[k].test(s)); check('§7 tone: no ' + k + ' words', !hits.length, hits.slice(0, 3)); } }\n  /* §8 art */\n  for (const r of ['deck', 'iron', 'pier', 'reception', 'juice', 'bungalow', 'raft', 'studio']) check('§8 room: ' + r, typeof G.ROOMS[r] === 'function'); check('§8 sizes 2.1, 1.9, 1.5', G.mats(1).size === 2.1 && G.mats(2).size === 1.9 && G.mats(4).size === 1.5); const source = files().filter(f => f.startsWith('game/')).map(f => readFileSync(join(root, f), 'utf8')).join('\\n'); for (const c of ['#f6fafa', '#dfe9ea', '#8fd3f4', '#d8f3fb', '#49b6c9', '#2f97ad', '#ecd9bd', '#d9bd96', '#2cc6e6', '#20404c', '#ff7a59', '#bfeee0', '#d9b68a', '#ecd3ac']) check('§8 palette ' + c, source.includes(c)); check('§8 canvas lighting only', !/enableGPU/.test(source)); check('§8 Tare-title logo in cyan at scale 3 or 4', /G\\.title\\(g, G\\.TITLE/.test(source));\n  /* §9 poses and clips */\n  for (const [n, clip, a, b, tgt] of [['stork', '111_39_part1', 3.6, 7.0, 1.57], ['knee', '111_39_part2', .5, 2.4, 1.57], ['triangle', '111_39_part3', 2.2, 5.2, 1.2], ['warrior', '111_39_part3', 6.6, 7.6, 1.57], ['lunge', '111_38_part1', 2.9, 5.0, .25], ['dog', '111_38_part2', 2.8, 5.2, .25], ['fold', '111_38_part2', 8.0, 8.8, .25], ['plank', '111_41_part3', 3.4, 6.4, .25]]) { const p = G.DATA.poses[n]; check('§9 pose ' + n, p.clip === clip && p.a === a && p.b === b && p.tgt === tgt, p); }\n  for (const c of ['Pushup', 'Meditate', 'Jumping Jacks', 'Sleeping', 'Victory', 'Cheering_Two_Hands', 'Dizzy', 'Idle_Subtle', 'Greeting', 'Run_Loop', 'Walk_Loop', 'Stretch_Yawn', 'Get_Up_From_Back', 'Waiting_Loop', 'Hop_One_Foot_Loop', 'Wave_Hello', '111_38_part1', '111_38_part2', '111_39_part1', '111_39_part2', '111_39_part3', '111_41_part3', '22_14']) check('§9 clip in the set: ' + c, !!G.lib.clip(c)); check('§9 moves', ['sideLunge', 'hula', 'stepUp'].every(m => typeof G.moves[m] === 'function')); check('§9 mannequins have no blink and ball joints', typeof G.drawJoints === 'function' && !!G.instructorRig('birch').isWood);\n  /* §10 audio */\n  check('§10 about 12 songs', Object.keys(G.SONGS).length >= 12); for (const n of ['studio', 'islandAM', 'islandDusk', 'yoga', 'iron', 'stepA', 'stepB', 'jog', 'ski', 'tray', 'laundry', 'festival', 'ending']) check('§10 song: ' + n, !!G.SONGS[n]); for (const n of ['star1', 'star2', 'star3', 'unlock', 'daydone']) check('§10 jingle: ' + n, !!G.JINGLES[n]); check('§10 music 10% with no compensation', game.settings.music === .1 && Object.values(G.SONGS).every(s => s.tracks.every(t => (t.vol || 0) <= .32)));\n  { const notes = t => String(t.notes).replace(/\\|/g, ' ').trim().split(/\\s+/).filter(n => /^[A-G]/.test(n)).map(n => E.note(n)).filter(f => f > 0), iv = p => p.slice(1).map((f, i) => Math.round(12 * Math.log2(f / p[i]))), grams = (a, n) => { const s = new Set(); for (let i = 0; i + n <= a.length; i++) s.add(a.slice(i, i + n).join()); return s; }, book = E.Songbook && (E.Songbook.all ? E.Songbook.all() : Object.values(E.Songbook.songs || E.Songbook)); let shared = 0, tot = 0, sample = ''; const bookGrams = new Set(); for (const b of Array.isArray(book) ? book : []) for (const t of (b.tracks || [])) if (t.wave !== 'drums') for (const x of grams(iv(notes(t)), 8)) bookGrams.add(x); check('§10 the engine songbook was readable for the comparison', bookGrams.size > 100, bookGrams.size); const mine = {}; for (const [n, s] of Object.entries(G.SONGS)) for (const t of s.tracks) if (t.wave !== 'drums' && ['lead', 'bells', 'brass', 'pizz'].includes(t.name)) { const gs = grams(iv(notes(t)), 8); for (const x of gs) { tot++; if (bookGrams.has(x)) { shared++; sample = n; } } } check(\"§10 no melody shares a run of 8 intervals with the engine's songbook\", shared === 0, [shared, tot, sample]); }\n  for (const s of ['tare', 'birch', 'alder', 'gertrude']) check('§10 voice: ' + s, !!G.SPEAKERS[s]); check('§10 Tare high and quick, Birch low and slow, Gertrude quavery', G.SPEAKERS.tare.base > G.SPEAKERS.alder.base && G.SPEAKERS.birch.base < 150 && G.SPEAKERS.birch.speed < 1 && G.SPEAKERS.gertrude.vib > 0); check('§10 babble is guarded without audio', G.babble('Tare', 'a') === false);\n  /* §11 UI */\n  for (const k of ['music', 'glyphs', 'voice', 'gentle', 'breathMode', 'tips']) check('§11 setting: ' + k, game.settings[k] !== undefined); check('§11 glyphs default PlayStation', game.settings.glyphs === 'playstation'); check('§11 readable-at-10-feet CSS and the notice fix', html.includes('.esh-mod{zoom:1.5}') && html.includes('.esh-mod{zoom:2}') && html.includes('[data-sys=need]{background:rgba(5,3,12,.35)!important')); check('§11 hover focus for the HTML menus', source.includes(\".esh-sh button:not(:disabled), .esh-sh input:not(:disabled)\")); check('§11 Dialog shadow patch used', G.talk.shadow === null); check('§11 touch never', game.o.touch === 'never');\n  /* §12 attract */\n  check('§12 the playlist, in order', JSON.stringify(G.ATTRACT_ITEMS) === JSON.stringify(['island', 'bodycheck', 'stork', 'flow', 'candle', 'squat', 'pushup', 'lunge', 'step', 'hoop', 'jog', 'slalom', 'tray', 'laundry', 'class4', 'results', 'duel']), G.ATTRACT_ITEMS); check('§12 its lines', L.tare.attract[0] === \"Nobody's here. I'll just show the room what we do.\" && L.tare.attractBack === \"Oh! You're back. I wasn't doing anything.\");\n  /* §13 every slider is a real, live control: change it and the game changes */\n  { const d = G.DEV, reset = () => G.devReset(), spec = new Map(G.DEV_SPEC.map(s => [s.key, s])); for (const k of ['k', 'c', 's', 'A', 'nf', 'ring', 'push', 'stumble', 'reach', 'nudge', 'stars', 'repTol', 'window', 'fatigue', 'hoopLo', 'hoopHi', 'jogLo', 'jogHi', 'jogSpeed', 'skiSpeed', 'skiTurn', 'trayG', 'trayF', 'rope', 'gust', 'timeScale', 'minutes']) check('§13 slider exists: ' + k, spec.has(k));\n    const lean = () => { const b = new G.Balance({ k: 12, c: 5, s: 13, A: 3, nf: 1.5, R: .24, pushV: .6, pushEvery: .5 }, E.rng(9)); for (let i = 0; i < 90; i++) b.step(1 / 120, .2, 0); return b.x; }; const base = lean(); for (const [k, v] of [['k', 2], ['c', 2], ['s', .5], ['A', 2], ['nf', 2], ['push', 2]]) { d[k] = v; check('§13 live: ' + k, lean() !== base); reset(); }\n    { const b = new G.Balance({ k: 1, c: 1, s: 1, A: 0, nf: 1, R: .2 }, E.rng(1)); const r0 = b.R; d.ring = 2; check('§13 live: ring', near(b.R, r0 * 2)); reset(); d.stumble = 1.5; b.x = 1.1; b.step(1 / 120, 0, 0); check('§13 live: stumble threshold', b.falls === 0); reset(); }\n    { const I = game.input, r = new G.DeviceReader(I), it = G.newIntent(); I.hold('right'); game.advance(.01); r.read(.1, it); const a = it.x; r.ux = 0; d.nudge = 4.4; r.read(.1, it); check('§13 live: nudge rate', near(it.x, a * 2, .01), [a, it.x]); I.hold('right', false); reset(); const m = new G.DeviceReader(I); m.mouseStart = -1000; I.feed('move', game.W / 2 + 20, game.H / 2); game.advance(.01); m.keyT = -1000; m.read(.01, it); const u1 = it.x; d.reach = .66; m.read(.01, it); check('§13 live: mouse reach', near(it.x, u1 / 2, .01), [u1, it.x]); reset(); }\n    { const t0 = G.starTargets(A('stork'))[0]; d.stars = .5; check('§13 live: star thresholds', near(G.starTargets(A('stork'))[0], t0 * .5)); reset(); const a0 = G.earnMinutes(1, 0, 'x').add; d.minutes = 3; check('§13 live: minutes multiplier', near(G.earnMinutes(1, 0, 'x').add, a0 * 3)); reset(); }\n    { const run1 = () => { const c = playRun(g, 'squat', { skill: 'poor', seconds: 8 }); G.endRun(c); return c.contestants[0].repSum; }; const a = run1(); d.repTol = 2.5; check('§13 live: rep tolerance', run1() > a, a); reset(); const f = () => { const c = playRun(g, 'squat', { skill: 'good', seconds: 26 }); return c.contestants[0].bal.set.A; }; const b = f(); d.fatigue = 3; check('§13 live: fatigue', f() > b, b); reset(); }\n    { const c = playRun(g, 'step', { seconds: .05 }); d.window = 2; game.advance(1 / 120); G.stepRun(c, 1 / 120); check('§13 live: rhythm windows', c.contestants[0].rh.windows.good === 270, c.contestants[0].rh.windows); reset(); if (c.def.stop) c.def.stop(c); }\n    { const c = playRun(g, 'hoop', { seconds: .1 }); const lo = c.contestants[0].bandLo; d.hoopLo = 5; d.hoopHi = 14; G.stepRun(c, 1 / 120); check('§13 live: hoop band', c.contestants[0].bandLo === lo - 2 && c.contestants[0].bandHi === 14, [c.contestants[0].bandLo, c.contestants[0].bandHi]); reset(); if (c.def.stop) c.def.stop(c); }\n    { const c = playRun(g, 'jog', { seconds: 4 }); const v0 = c.lo, z0 = c.contestants[0].z; d.jogLo = 2; d.jogHi = 4; G.stepRun(c, 1 / 120); check('§13 live: jog band', c.lo !== v0, c.lo); reset(); d.jogSpeed = 2; const q = c.contestants[0], z1 = q.z; G.stepRun(c, 1 / 120); const dz2 = q.z - z1; reset(); const z2 = q.z; G.stepRun(c, 1 / 120); check('§13 live: jog speed', dz2 > (q.z - z2) * 1.5, [dz2, q.z - z2]); }\n    { const c = playRun(g, 'slalom', { seconds: 3, skill: 'good' }), q = c.contestants[0]; d.skiSpeed = 400; for (let i = 0; i < 240; i++) G.stepRun(c, 1 / 120); check('§13 live: slalom speed', q.v > 260, q.v); reset(); q.bal.x = .5; const x0 = q.sx; G.stepRun(c, 1 / 120); const dx1 = q.sx - x0; d.skiTurn = 2; q.bal.x = .5; const x1 = q.sx; G.stepRun(c, 1 / 120); check('§13 live: slalom turn', Math.abs(q.sx - x1) > Math.abs(dx1) * 1.4, [dx1, q.sx - x1]); reset(); }\n    { const c = playRun(g, 'tray', { seconds: .1 }), q = c.contestants[0]; d.trayG = 800; q.bal.x = .5; G.stepRun(c, 1 / 120); check('§13 live: tray gravity', Math.abs(q.world.gravity[0]) > 300, q.world.gravity); reset(); d.trayF = 1.5; G.stepRun(c, 1 / 120); check('§13 live: tray friction', q.olives[0].damping === 1.5, q.olives[0].damping); reset(); }\n    { const c = playRun(g, 'laundry', { seconds: 1 }), q = c.contestants[0], s0 = q.bal.set.s; d.rope = .5; G.stepRun(c, 1 / 120); check('§13 live: rope instability', q.bal.set.s === s0 * .5, q.bal.set.s); reset(); const gustRun = v => { d.gust = v; const r = playRun(g, 'laundry', { skill: 'expert', seconds: 22 }); reset(); return r.contestants[0].bal.vx + r.contestants[0].bal.x; }; check('§13 live: gust strength', gustRun(2.5) !== gustRun(0)); }\n  }\n  /* §14 multiplayer */\n  check('§14 session tags in order', /<meta charset=\"utf-8\">\\s*<script>\\/\\*! aihub-session[\\s\\S]*?<\\/script>\\s*<meta name=\"viewport\"[^>]*>\\s*<title>[^<]*<\\/title>\\s*<meta name=\"description\"[^>]*>\\s*<meta name=\"theme-color\" content=\"#2cc6e6\">\\s*<meta name=\"hub:type\" content=\"Game\"><meta name=\"hub:players\" content=\"1–4\"><meta name=\"hub:source\" content=\"Wii Fit\">\\s*<meta name=\"hub:session\" content=\"1\"><meta name=\"hub:session-players\" content=\"1-4\"><meta name=\"hub:session-mode\" content=\"ghost\">\\s*<meta name=\"hub:session-minutes\" content=\"3\">\\s*<meta name=\"hub:session-goal\"[^>]*>\\s*<meta name=\"hub:session-howto\"[^>]*>/.test(html)); for (const id of ['stork', 'candle', 'squat', 'step', 'hoop']) check('§14 Class activity: ' + id, A(id).class === true); check('§14 scores 0 to 1000', (() => { const c = playRun(g, 'stork', { seconds: 50 }); return c.contestants[0].score === Math.round(c.contestants[0].pct * 1000); })()); check('§14 podium titles', ['Most Still', 'Best Wobble', 'Participated'].every(t => L.class.titles.includes(t))); check('§14 the join line', /Start on a pad, or 2 on the keyboard/.test(L.class.join)); check('§14 Morning Class: three groups, 5 + 40 + 5 s', /GROUPS = \\[\\['stork', 'candle', 'squat', 'pushup'\\], \\['step', 'hoop'\\], \\['slalom', 'jog'\\]\\], INTRO = 5, PLAY = 40, SCORE = 5/.test(source));\n  /* §15 tech and setup */\n  for (const f of ['game/core.js', 'game/balance.js', 'game/rigs.js', 'game/ui.js', 'game/audio.js', 'game/index.html', 'game/data/lines.js', 'game/data/poses.js', 'game/data/activities.js', 'game/data/charts.js', 'game/data/courses.js', 'game/data/trays.js', 'game/data/days.js', 'game/data/unlocks.js', 'game/data/README.md', 'tests/run.mjs', 'build.mjs', 'vendor/session.js', 'vendor/readable.js', 'vendor/mocap.js', 'vendor/fitclips.js', 'engine/my-3d2dge.js', 'engine/API.md', ...['hold', 'candle', 'rep', 'step', 'hoop', 'jog', 'slalom', 'tray', 'laundry'].map(a => `game/activities/${a}.js`), ...['title', 'attract', 'member', 'arrival', 'island', 'bodycheck', 'session', 'evening', 'games', 'ending', 'about', 'class', 'round'].map(a => `game/scenes/${a}.js`)]) check('§15 layout: ' + f, existsSync(join(root, f)));\n  for (const k of ['scene', 'activity', 'tier', 'day', 'session', 'pct', 'stars', 'minutes', 'spineAge', 'lean', 'source']) check('§15 snapshot has ' + k, k in game.debug.snapshot()); for (const id of G.order) { const a = A(id); check('§15 registry entry is complete: ' + id, ['setup', 'update', 'draw', 'hud', 'result', 'bot'].every(k => typeof a[k] === 'function') && !!a.family && !!a.discipline && !!a.tiers); check('§15 its own pausable scene: ' + id, G.scenes[G.actScene(id)].pausable === true && G.scenes[G.actScene(id)].camera.zoom === false); }\n  check('§15 G.ABOUT is the exit interview', !!G.ABOUT); check('§15 every </script is escaped in what is inlined', (html.match(/<\\/script/gi) || []).length === (html.match(/<script/gi) || []).length);\n  for (const [hash, want] of [['#hub', 'island'], ['#act/stork/1', 'act_stork'], ['#day/3', 'bodycheck'], ['#ending', 'ending']]) { const h = load({ hash }); h.game.advance(.5); check('§15 deep link ' + hash, h.game.sceneName === want, h.game.sceneName); if (hash === '#act/stork/1') check('§15 deep link picks the tier', h.G.scenes.act_stork.run().tierIdx === 0); if (hash === '#day/3') check('§15 deep link picks the day', h.G.S.day === 3, h.G.S.day); }\n  check('§15 no ES modules: the page runs from file://', !/<script[^>]*type=\"