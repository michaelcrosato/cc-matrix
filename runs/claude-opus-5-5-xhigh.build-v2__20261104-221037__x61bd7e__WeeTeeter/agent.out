.38, noise: .008, form: 2 } };\")\ns=s.replace(\"set = { k: 16, c: 8, s: 0, sx: axisX ? 0 : 8, sy: axisX ? 8 : 0, A: 1.1, nf: 1.1, R: .24 };\",\"set = { k: 26, c: 10, s: 0, sx: axisX ? 0 : 8, sy: axisX ? 8 : 0, A: 1.1, nf: 1.1, R: .24 };\")\ns=s.replace(\"b.set.A = 1.1 * (1 + fat * 1.6); b.set.k = 16 * (1 - fat * .22);\",\"b.set.A = 1.1 * (1 + fat * 1.6); b.set.k = 26 * (1 - fat * .22);\")\nopen(p,'w').write(s)\n\np='game/activities/hoop.js'; s=open(p).read()\ns=s.replace(\"c.botTh = (c.botTh || 0) + dt * (B.om + B.jit * Math.sin(ctx.time * 1.7 + c.i * 2)) * (c.botDir || 1);\",\"const midOm = c.bandLo && c.bandHi ? (c.bandLo + c.bandHi) / 2 : 9, wantOm = c.brain.skill === 'poor' ? Math.min(B.om, midOm) : midOm + (B.om - 9);\\n    c.botTh = (c.botTh || 0) + dt * (wantOm + B.jit * Math.sin(ctx.time * 1.7 + c.i * 2)) * (c.botDir || 1);\")\nopen(p,'w').write(s)\n\np='game/activities/slalom.js'; s=open(p).read()\na=s.index(\"  bot(ctx, c, dt) {\"); b=s.index(\"  ghost(ctx, c)\")\ns=s[:a]+\"\"\"  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent, G0 = ctx.gates[c.nextGate || 0] || { x: 0, y: c.sy - 500 };\n    c.nz = c.nz || G.noise(c.rng, 1.3);\n    let tx = G0.x;\n    for (const o of ctx.obstacles) { const dy = c.sy - o.y; if (dy > 0 && dy < 170 && Math.abs(o.x - c.sx) < 30 * B.avoid) tx = c.sx + (c.sx >= o.x ? 1 : -1) * 70; }\n    /* the lean this gate needs: its distance across over the time left to reach it */\n    const v = Math.max(60, c.v), tTo = Math.max(.35, Math.min(3, (c.sy - G0.y) / v)), need = (tx - c.sx) / tTo / (210 * G.DEV.skiTurn);\n    I.x = clamp(need * B.gain + B.noise * c.nz(ctx.time), -1, 1);\n    I.y = Math.abs(need) < .25 && tTo > .8 ? B.tuck : Math.abs(need) > .8 ? -.5 : 0;\n  },\n\"\"\"+s[b:]\ns=s.replace(\"const BOT = { poor: { look: 240, gain: 1.1, noise: .34, tuck: .1, avoid: .4 }, average: { look: 300, gain: 1.5, noise: .16, tuck: .35, avoid: .8 }, good: { look: 340, gain: 1.9, noise: .07, tuck: .7, avoid: 1 }, expert: { look: 380, gain: 2.3, noise: .02, tuck: 1, avoid: 1.2 } };\",\"const BOT = { poor: { gain: .75, noise: .4, tuck: 0, avoid: .4 }, average: { gain: 1, noise: .2, tuck: .2, avoid: .8 }, good: { gain: 1.15, noise: .08, tuck: .6, avoid: 1 }, expert: { gain: 1.25, noise: .02, tuck: .9, avoid: 1.2 } };\")\nopen(p,'w').write(s)\n\np='game/activities/tray.js'; s=open(p).read()\na=s.index(\"  bot(ctx, c, dt) {\"); b=s.index(\"  draw(r, ctx) {\")\ns=s[:a]+\"\"\"  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent; c.nz = c.nz || G.noise(c.rng, 1.7);\n    /* the olive nearest a glass, along the cells that are clear of gaps, blocks and bumpers */\n    c.pathT = (c.pathT || 0) - dt;\n    if (c.pathT <= 0 || !c.way) { c.pathT = .2; c.way = G.trayPath(ctx, c); }\n    if (!c.way) { I.x = 0; I.y = 0; return; }\n    const o = c.way.o, dx = c.way.x - o.x, dy = c.way.y - o.y, D = Math.max(10, Math.hypot(dx, dy)), ux = dx / D * B.gain - o.vx * B.damp * .012 + B.noise * c.nz(ctx.time), uy = dy / D * B.gain - o.vy * B.damp * .012 + B.noise * c.nz(ctx.time + 3);\n    I.x = clamp(ux, -1, 1); I.y = clamp(-uy, -1, 1);\n  },\n\"\"\"+s[b:]\ns=s.replace(\"G.family('tray', {\",\"\"\"/** a bot's next waypoint: breadth first over the tray's cells from the leading olive to the nearest glass */\nG.trayPath = (ctx, c) => {\n  const rows = G.DATA[ctx.tier.trays][c.trayI].rows, H = rows.length, W = rows[0].length, x0 = -c.W / 2, y0 = -c.H / 2, cell = (x, y) => [Math.floor((x - x0) / CELL), Math.floor((y - y0) / CELL)];\n  const blocked = (i, j) => { const ch = rows[j] && rows[j][i]; return ch === undefined || ch === '~' || ch === '#' || ch === 'B'; };\n  let best = null;\n  for (const o of c.olives) {\n    if (o.data.fall > 0) continue;\n    const [si, sj] = cell(o.x, o.y), seen = new Map(), q = [[si, sj]]; seen.set(si + ',' + sj, null);\n    let goal = null;\n    const glass = new Set(c.glasses.map(s => cell(s.x, s.y).join(',')));\n    while (q.length && !goal) { const [i, j] = q.shift(); if (glass.has(i + ',' + j)) { goal = [i, j]; break; } for (const [a, b] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) { const n = (i + a) + ',' + (j + b); if (seen.has(n) || blocked(i + a, j + b)) continue; seen.set(n, [i, j]); q.push([i + a, j + b]); } }\n    if (!goal) continue;\n    let len = 0, cur = goal, step = goal; while (cur) { const prev = seen.get(cur.join(',')); if (prev && (prev[0] !== si || prev[1] !== sj)) step = prev; if (prev && prev[0] === si && prev[1] === sj) step = cur; cur = prev; len++; }\n    if (!best || len < best.len) best = { len, o, x: x0 + (step[0] + .5) * CELL, y: y0 + (step[1] + .5) * CELL };\n  }\n  return best;\n};\nG.family('tray', {\"\"\")\nopen(p,'w').write(s)\n\np='game/activities/laundry.js'; s=open(p).read()\ns=s.replace(\"const ROPE_Z = 58, WALK = 40;\",\"const ROPE_Z = 58, WALK = 52;\")\na=s.index(\"  bot(ctx, c, dt) {\"); b=s.index(\"  ghost(ctx, c)\")\ns=s[:a]+\"\"\"  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent, bal = c.bal; c.tried = c.tried || {};\n    /* into the wind before it arrives: what a player learns from the warning */\n    let ff = 0; for (const gu of ctx.gusts) if ((gu.state === 1 && gu.t > .45) || gu.state === 2) ff = -gu.dir * B.brace;\n    const u = c.brain.hold(dt, { x: bal.x, y: 0, vx: bal.vx, vy: 0 }, 0, 0, ff, 0); I.x = u[0]; I.y = 0; I.walk = B.effort; I.jump = false;\n    if (c.fallT > 0) c.tried = {};\n    ctx.pegs.forEach((p, i) => { const dx = p.x - c.wx; if (dx > 0 && dx < B.jumpAt && c.jz <= 0 && c.tried[i] === undefined) { c.tried[i] = c.rng() < B.hit; if (c.tried[i]) I.jump = true; } });\n  },\n\"\"\"+s[b:]\ns=s.replace(\"const BOT = { poor: { effort: .45, jumpAt: 8, hit: .75 }, average: { effort: .6, jumpAt: 10, hit: .92 }, good: { effort: .78, jumpAt: 12, hit: 1 }, expert: { effort: .95, jumpAt: 14, hit: 1 } };\",\"const BOT = { poor: { effort: .45, jumpAt: 10, hit: .75, brace: 0 }, average: { effort: .55, jumpAt: 12, hit: .94, brace: .35 }, good: { effort: .72, jumpAt: 14, hit: 1