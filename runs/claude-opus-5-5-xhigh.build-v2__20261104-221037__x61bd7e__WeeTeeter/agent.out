 > 2 else 280000)\n        except Exception as e:\n            print('TIMEOUT', e)\n        r = pg.evaluate(\"JSON.stringify(window.__hubCheck || null)\")\n        d = json.loads(r) if r else None\n        if d:\n            print('pass', d.get('pass'))\n            for c in d.get('checks', []):\n                if not c.get('ok', c.get('pass')): print(' FAIL', json.dumps(c)[:300])\n        print('errors', errs[:5])\n        if len(sys.argv) > 3: pg.screenshot(path=sys.argv[3])\n        b.close()\nfinally:\n    srv.terminate(); srv.wait()\nEOF\nsed -n 1,30p tests/hub/harness.html | cut -c1-140 | head -12; grep -n \"limit\\|__hubCheck = \\|complete\" tests/hub/harness.html | head -14 | cut -c1-180; timeout 300 python3 tests/tools/hubcheck.py \"players=2&auto=1&limit=60\" 280000 shots/hub2.png","description":"Save progress and run the hub harness with two players","timeout":320000}}}
