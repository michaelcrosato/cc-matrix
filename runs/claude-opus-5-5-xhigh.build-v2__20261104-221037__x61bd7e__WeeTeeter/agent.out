{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjEqajP1jtrsq2KyfSUL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01T21Td6nr8Ffz1XpuPT24Yi","name":"Bash","input":{"command":"cat > game/activities/hoop.js <<'EOF'\n/* activities/hoop.js: Hoop Hips. Circle the lean to spin a hoop. A stick and a mouse circle; keys step W D S A. Too slow,\n * just right, too eager. Regulars toss more hoops from the sides: catch them left and right. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp, TAU } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst PI2 = Math.PI * 2;\nconst wrap = a => { while (a > Math.PI) a -= PI2; while (a < -Math.PI) a += PI2; return a; };\nconst BOT = { poor: { om: 7.8, jit: 1.8, react: .9, cat: .55, sd: .16 }, average: { om: 8.8, jit: 1.1, react: .6, cat: .78, sd: .1 }, good: { om: 9, jit: .55, react: .4, cat: .92, sd: .06 }, expert: { om: 9.2, jit: .2, react: .25, cat: 1, sd: .02 } };\nconst HOOP_COLS = ['#ff7a59', '#2cc6e6', '#f5c84b', '#6fcf8e', '#b08be0', '#f08fb0'];\nfunction drawHoopHalf(r, c, i, front, ctx) {\n  const n = 24, rx = (12 + (i % 2)) * ctx.size * .95, ry = rx * .36, wob = c.phase * (i % 2 ? 1 : -1), oz = (10.2 - i * .75) * ctx.size + Math.sin(c.phase + i) * 1.2;\n  const col = HOOP_COLS[i % HOOP_COLS.length], cx = Math.cos(c.phase + i * .7) * 2.4 * ctx.size;\n  r.queue(c.x, 0.1, 0, g => {\n    const p = r.w(c.x, 0, oz);\n    for (let k = 0; k < n; k++) { const a = k / n * PI2, f = Math.sin(a) > 0; if (f !== front) continue; const a2 = (k + 1) / n * PI2; px.line(g, p[0] + cx + Math.cos(a) * rx, p[1] + Math.sin(a) * ry, p[0] + cx + Math.cos(a2) * rx, p[1] + Math.sin(a2) * ry, front ? col : E.shade(col, -.25), 2); }\n  }, { bias: front ? 6 : -6 });\n}\nG.family('hoop', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const { tier } = ctx;\n    ctx.dirSign = 1; ctx.swap = tier.swap || 1; ctx.nextSwap = ctx.dur / (ctx.swap + 1); ctx.swapI = 0; ctx.tossT = tier.tossEvery; ctx.tosses = []; ctx.bestHoops = 1; ctx.bestSum = 0; ctx.other = 0;\n    ctx.throwers = ['okafor', 'marisol'].map((id, i) => ({ rig: G.regularRig(id, 1.5), x: i ? 150 : -150, id, poser: null }));\n    for (const q of ctx.throwers) q.poser = new G.Poser(q.rig);\n    for (const c of ctx.contestants) {\n      c.bal = new G.Balance({ k: 30, c: 9, s: 0, A: .4, nf: 1, R: .25 }, c.rng); c.bal.cheat = true;\n      c.hoops = 1; c.phase = 0; c.om = 0; c.th = 0; c.cum = 0; c.score = 0; c.hist = []; c.outT = 0; c.thSet = false; c.state = 'slow'; c.caught = 0; c.dropped = 0; c.inBand = 0; c.playT = 0;\n      if (ctx.contestants.length === 1) c.x = 0;\n    }\n    ctx.whirr = null;\n  },\n  preview(dt, ctx) {\n    G.stageCam(32, 8);\n    for (const c of ctx.contestants) { c.phase += dt * 3; c.rig.body = G.moves.hula(c.phase); c.rig.update(dt, { x: c.x, y: 0, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n    for (const q of ctx.throwers) { q.poser.clip('Idle_Subtle', { tgt: q.x < 0 ? .6 : 2.5, loop: true }); q.poser.update(dt); q.rig.update(dt, { x: q.x, y: -14, z: 0, vx: 0, vy: 0, facing: q.poser.facing, expr: 'smile' }); }\n  },\n  update(dt, ctx) {\n    const t = ctx.time, { tier } = ctx, d = G.DEV; G.stageCam(32, 8);\n    /* \"Other way!\" */\n    if (t >= ctx.nextSwap && ctx.swapI < ctx.swap) { ctx.swapI++; ctx.nextSwap += ctx.dur / (ctx.swap + 1); ctx.dirSign = -ctx.dirSign; ctx.other = 2.2; if (ctx.local && !ctx.quiet) { G.A.sfx('ok'); const who = G.S.instructor || 'birch'; G.mutter('okafor', 'Other way!', { auto: 2 }); } }\n    ctx.other = Math.max(0, ctx.other - dt);\n    /* a Regular tosses a hoop: catch it inside .25 s of arrival */\n    ctx.tossT -= dt;\n    if (ctx.tossT <= 0) { ctx.tossT = tier.tossEvery * (.85 + .3 * ctx.rng()); const side = ctx.rng() < .5 ? -1 : 1; ctx.tosses.push({ side, t: 0, fly: 1.1, res: {} }); if (ctx.local && !ctx.quiet) G.A.sfx('whoosh2', { vol: .6 }); }\n    for (const h of ctx.tosses) h.t += dt;\n    ctx.bestSum += dt * ctx.bestHoops;\n    /* keep the best-possible stack in step with what has been thrown */\n    const arrived = ctx.tosses.filter(h => h.t >= h.fly && !h.counted); for (const h of arrived) { h.counted = true; ctx.bestHoops = Math.min(6, ctx.bestHoops + 1); }\n    for (const c of ctx.contestants) {\n      const I = c.intent; c.playT += dt;\n      /* angular speed from the raw direction: a stick or mouse circles, keys step by quadrants */\n      const key = I.source === 'keyboard', rx = I.rawX, ry = I.rawY, mag = Math.hypot(rx, ry);\n      if (mag > .55) { const a = Math.atan2(rx, ry); if (c.thSet) { const da = wrap(a - c.th); c.cum += da; } c.th = a; c.thSet = true; }\n      const win = key ? 1.2 : .35; c.hist.push(t, c.cum); while (c.hist.length > 2 && t - c.hist[0] > win) c.hist.splice(0, 2);\n      const span = Math.max(.1, t - c.hist[0]); c.om = (c.cum - c.hist[1]) / span;\n      const scale = key ? .6 : 1, lo = (d.hoopLo + (c.hoops - 1) * tier.needMore) * scale, hi = (d.hoopHi + (c.hoops - 1) * tier.needMore) * scale, om = c.om * ctx.dirSign;\n      c.state = om < lo ? 'slow' : om > hi ? 'eager' : 'right';\n      const inBand = c.state === 'right' || ctx.other > 1.2;\n      c.bandLo = lo; c.bandHi = hi; c.omDisp = om;\n      if (inBand) { c.score += dt * c.hoops; c.inBand += dt; c.outT = 0; }\n      else if (c.playT > 2) { c.outT += dt; if (c.outT >= 1.5 && c.hoops > 1) { c.hoops--; c.dropped++; c.outT = 0; if (G.cue(ctx, c)) { G.A.sfx('drop'); if (c.input) c.input.rumble(.3, .15); } } }\n      /* catches */\n      for (const h of ctx.tosses) {\n        if (h.res[c.i]) continue;\n        const dtA = h.t - h.fly;\n        if ((h.side < 0 ? I.catchL : I.catchR) && Math.abs(dtA) <= .25) { h.res[c.i] = 'got'; if (c.hoops < 6) c.hoops++; c.caught++; if (G.cue(ctx, c)) { G.A.sfx('catch'); if (c.input) c.input.rumble(.25, .1); G.P.glints(c.x, 0, 22 * ctx.size / 2, 5, '#ffd166'); } }\n        else if (dtA > .25) { h.res[c.i] = 'miss'; }\n      }\n      c.bal.step(dt, I.x, I.y);\n      c.phase += dt * clamp(Math.abs(c.om), 2, 14) * (c.om < 0 ? -1 : 1);\n      c.rig.body = G.moves.hula(c.phase * .5);\n      c.rig.update(dt, { x: c.x, y: 0, z: 0, vx: 0, vy: 0, facing: 1.57, expr: c.state === 'right' ? 'smile' : 'wince' });\n      if (G.cue(ctx, c)) { ctx.whirr = ctx.whirr || new G.Tone({ wave: 'triangle' }); ctx.whirr.set({ freq: 180 + Math.abs(c.om) * 42, vol: Math.min(.05, Math.abs(c.om) * .006) }); }\n    }\n    ctx.tosses = ctx.tosses.filter(h => h.t < h.fly + .8);\n    for (const q of ctx.throwers) { q.poser.clip('Cheering_Two_Hands', { tgt: q.x < 0 ? .6 : 2.5, loop: true, speed: .6 }); q.poser.update(dt); q.rig.update(dt, { x: q.x, y: -14, z: 0, vx: 0, vy: 0, facing: q.poser.facing, expr: 'smile' }); }\n  },\n  stop(ctx) { if (ctx.whirr) ctx.whirr.stop(); },\n  result(ctx, c) { const pct = ctx.bestSum > 0 ? clamp(c.score / ctx.bestSum, 0, 1) : 0; return { pct, detail: 'Just right for ' + Math.round(c.inBand) + ' s. Caught ' + c.caught + '. Most hoops: ' + (c.maxH || c.hoops) + '.' }; },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent;\n    c.botTh = (c.botTh || 0) + dt * (B.om + B.jit * Math.sin(ctx.time * 1.7 + c.i * 2)) * (c.botDir || 1);\n    if (!c.botDir) c.botDir = 1; if (c.botDir !== ctx.dirSign && (c.flipIn === undefined || c.flipIn === null)) c.flipIn = B.react; if (c.flipIn != null) { c.flipIn -= dt; if (c.flipIn <= 0) { c.botDir = ctx.dirSign; c.flipIn = null; } }\n    const m = .9; I.rawX = Math.sin(c.botTh) * m; I.rawY = Math.cos(c.botTh) * m; I.x = I.rawX; I.y = I.rawY; I.source = 'bot';\n    /* catches: reach out near the arrival, a little off */\n    I.catchL = I.catchR = false;\n    for (const h of ctx.tosses) { if (h.res[c.i] || h.plan && h.plan[c.i] === 'skip') continue; h.plan = h.plan || {}; if (h.plan[c.i] === undefined) h.plan[c.i] = c.rng() < B.cat ? (c.rng() - .5) * B.sd * 2 : 'skip'; if (h.plan[c.i] === 'skip') continue; if (h.t >= h.fly + h.plan[c.i]) { if (h.side < 0) I.catchL = true; else I.catchR = true; } }\n  },\n  ghost(ctx, c) { return { ph: +c.phase.toFixed(2), h: c.hoops }; },\n  draw(r, ctx) {\n    (G.ROOMS[ctx.def.room] || G.ROOMS.pier)(r, { dusk: G.roomDusk && G.roomDusk(), festive: ctx.mode === 'games' });\n    for (const q of ctx.throwers) G.drawRig(r, q.rig, q.x, -14);\n    for (const c of ctx.contestants) {\n      G.drawMat(r, c.x, 0, 30 * (ctx.size / 2.1), 9, c.local ? '#bfeee0' : '#e8f0f2');\n      G.drawRig(r, c.rig, c.x, 0);\n      for (let i = 0; i < c.hoops; i++) { drawHoopHalf(r, c, i, false, ctx); drawHoopHalf(r, c, i, true, ctx); }\n    }\n    G.drawGhosts && G.drawGhosts(r, ctx);\n    for (const h of ctx.tosses) {\n      const k = clamp(h.t / h.fly, 0, 1.2), tgt = ctx.contestants.length === 1 ? ctx.contestants[0].x : h.side * 40, sx = h.side * 170, x = sx + (tgt - sx) * k, z = 34 + Math.sin(Math.min(k, 1) * Math.PI) * 42 - Math.max(0, k - 1) * 200;\n      r.queue(x, 2, Math.max(0, z), g => { const p = r.w(x, 2, Math.max(0, z)); const rx = 14; for (let i = 0; i < 18; i++) { const a = i / 18 * PI2 + game.real * 6; px.rect(g, p[0] + Math.cos(a) * rx, p[1] + Math.sin(a) * rx * .5, 2, 2, HOOP_COLS[(ctx.tosses.indexOf(h) + 2) % 6]); } });\n    }\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, many = ctx.contestants.length > 1;\n    if (ctx.live) G.drawTimer(g, G.left(ctx));\n    for (const c of ctx.contestants) {\n      if (c.life) continue;\n      const cx = many ? game.r.w(c.x, 0, 0)[0] : W / 2, cy = H - (many ? 12 : 16), R = many ? 22 : 40;\n      /* the big dial: too slow, just right, too eager */\n      const maxOm = c.bandHi * 1.5 || 16, ang = o => Math.PI + clamp(o / maxOm, 0, 1) * Math.PI;\n      for (let i = 0; i <= 40; i++) { const o = i / 40 * maxOm, a = ang(o), col = o < (c.bandLo || 7) ? '#ffe0b8' : o > (c.bandHi || 11) ? '#ffc0ac' : '#7fe0c3'; for (let rr = R - (many ? 5 : 8); rr <= R; rr += 2) px.rect(g, cx + Math.cos(a) * rr, cy + Math.sin(a) * rr, 2, 2, col); }\n      const a = ang(c.omDisp || 0); px.line(g, cx, cy, cx + Math.cos(a) * (R - 2), cy + Math.sin(a) * (R - 2), '#20404c', 2); px.disc(g, cx, cy, many ? 2 : 4, '#20404c');\n      const word = c.state === 'right' ? 'Just right' : c.state === 'eager' ? 'Too eager' : 'Too slow';\n      txt(g, many ? c.name : word, cx, cy - R - 12, many ? c.color : c.state === 'right' ? '#14a8c8' : '#e0553a', { align: 'center', shadow: '#ffffff', scale: 1 });\n      const hx = cx - 22; for (let i = 0; i < 6; i++) { const on = i < c.hoops; px.disc(g, hx + i * 9, cy - R - (many ? 22 : 22), 3, on ? HOOP_COLS[i] : '#d6e2e5'); }\n    }\n    if (ctx.other > 0) { const k = Math.floor(game.real * 8) % 2; G.panel(g, W / 2 - 62, 34, 124, 26, { r: 9, bg: k ? '#ffd166' : '#fbfdfd' }); txt(g, 'Other way!', W / 2, 38, '#20404c', { align: 'center', scale: 2 }); }\n    for (const h of ctx.tosses) { const dtA = h.t - h.fly, loc = ctx.local && !h.res[ctx.local.i]; if (loc && Math.abs(dtA) < .5) { const x = h.side < 0 ? W * .2 : W * .8, near = Math.abs(dtA) <= .25; G.panel(g, x - 34, H * .34, 68, 22, { r: 8, bg: near ? '#2cc6e6' : '#fbfdfd' }); txt(g, 'Catch!', x, H * .34 + 3, near ? '#ffffff' : '#20404c', { align: 'center' }); txt(g, G.keyLabel(h.side < 0 ? 'catchL' : 'catchR'), x, H * .34 + 12, near ? '#ffffff' : '#14a8c8', { align: 'center' }); } }\n    if (ctx.live && !many) G.prompts(g, [[game.input.lastDevice === 'gamepad' ? '=Left stick' : G.leanSource() === 'mouse' ? '=Circle the mouse' : '=W D S A', 'Circle']]);\n  }\n});\n})();\nEOF\ncat > game/activities/jog.js <<'EOF'\n/* activities/jog.js: Coastal Jog. Alternate left and right to set a cadence, lean to steer, stay in Marisol's zone. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game, lib = G.lib;\nconst txt = (...a) => G.txt(...a);\nconst SEG = 200, CAM_H = 900;\nlet ROAD = {};\nconst viewCache = new Map();\nconst scaleView = k => { const key = Math.max(1, Math.round(k * 8)); if (!viewCache.has(key)) viewCache.set(key, new E.View('wt' + key, 'wt', 0, 18, key / 8)); return viewCache.get(key); };\nG.scaleView = scaleView;\nfunction buildRoad(tierIdx, len) {\n  const key = tierIdx + ':' + len; if (ROAD[key]) return ROAD[key];\n  const J = G.DATA.courses.jog, road = new E.Road({ segment: SEG, lanes: 2, draw: 150, fog: null, height: CAM_H, sky: new E.Backdrop('ocean'),\n    colors: { road: ['#e6d3af', '#dcc8a2'], grass: ['#f2e6c4', '#ead9b2'], rumble: ['#fbfdfd', '#7fd8ea'], lane: '#fbfdfd' } });\n  for (const [n, o] of J.stretches) road.add(Math.round(n * len), Object.assign({}, o));\n  const PALM = E.prop('palm').frames[0], BUSH = E.prop('bush').frames[0], ROCK = E.prop('rock', { size: 2 }).frames[0];\n  const bungalow = { w: 1300, draw(g, x, y, s) { const W = 1300 * s, H = 800 * s; if (W < 3) return; px.rect(g, x - W / 2, y - H, W, H, '#fbf6ec'); px.poly(g, [[x - W * .6, y - H], [x + W * .6, y - H], [x, y - H * 1.7]], '#ff9a7a'); px.rect(g, x - W * .14, y - H * .7, W * .28, H * .7, '#c49c6c'); if (W > 10) px.rect(g, x + W * .22, y - H * .75, W * .18, H * .3, '#a8e4f2'); } };\n  const louBench = { w: 900, draw(g, x, y, s) { const W = 900 * s; if (W < 4) return; px.rect(g, x - W / 2, y - W * .34, W, W * .08, '#c49c6c'); px.rect(g, x - W * .45, y - W * .26, W * .05, W * .26, '#7a8a94'); px.rect(g, x + W * .4, y - W * .26, W * .05, W * .26, '#7a8a94'); px.ell(g, x - W * .08, y - W * .42, W * .3, W * .1, '#9aa8b0'); px.disc(g, x + W * .28, y - W * .46, W * .09, '#e8bd96'); if (W > 40) txt(g, 'z', x + W * .36, y - W * .7 - Math.sin(game.real * 2) * 4, '#5f7f8a'); } };\n  const pier = { w: 1400, draw(g, x, y, s) { const W = 1400 * s; if (W < 4) return; px.rect(g, x - W / 2, y - W * .25, W, W * .05, '#b89a72'); for (let i = 0; i < 5; i++) px.rect(g, x - W / 2 + i * W / 4 - W * .015, y - W * .25, W * .03, W * .25, '#8a6a4a'); px.rect(g, x - W * .3, y - W * .55, W * .02, W * .3, '#6a7a84'); px.rect(g, x - W * .34, y - W * .58, W * .1, W * .04, '#ffe7a8'); } };\n  const signOf = text => ({ w: 700, draw(g, x, y, s) { const W = 700 * s, H = 340 * s; if (W < 3) return; px.rect(g, x - W * .03, y - H * 2, W * .06, H * 2, '#7a8a94'); px.rect(g, x - W / 2, y - H * 2.2, W, H, '#fbfdfd'); if (W > 44) txt(g, text, x, y - H * 1.9, '#14a8c8', { align: 'center' }); } });\n  const total = road.length;\n  for (let z = 600; z < total; z += SEG * 3) { const i = z / (SEG * 3) | 0, side = i % 2 ? 1 : -1, v = (i * 7919) % 100;\n    if (i % 17 === 5) road.place(z, side * 1.9, bungalow, 1);\n    else if (i % 23 === 9) road.place(z, side * 1.6, louBench, 1);\n    else if (i % 29 === 13) road.place(z, side * 2.1, pier, 1);\n    else if (i % 31 === 21) road.place(z, side * 1.5, signOf('Gently'), 1);\n    else if (v < 45) road.place(z, side * (1.5 + v / 100), PALM, 60);\n    else if (v < 70) road.place(z, side * (1.5 + v / 150), BUSH, 40);\n    else if (v < 80) road.place(z, side * (1.7 + v / 150), ROCK, 40);\n  }\n  return (ROAD[key] = { road, ahead: road.ahead(CAM_H) });\n}\nconst BOT = { poor: { cad: 2.45, jit: .5, steer: .6, seen: 1800 }, average: { cad: 3, jit: .28, steer: 1, seen: 2600 }, good: { cad: 3, jit: .14, steer: 1.4, seen: 3400 }, expert: { cad: 3, jit: .05, steer: 2, seen: 4000 } };\nG.family('jog', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const { tier } = ctx, J = G.DATA.courses.jog, B = buildRoad(ctx.tierIdx, tier.length);\n    ctx.road = B.road; ctx.ahead = B.ahead; ctx.turn = 0; ctx.things = []; ctx.finishZ = ctx.road.length - 40 * SEG; ctx.sTotal = 0;\n    /* pigeons, joggers, cups: from the seeded stream */\n    let z = 1800; const rng = ctx.rng, cups = [];\n    while (z < ctx.finishZ - 400) { const pick = rng(), x = (rng() - .5) * 1.5;\n      if (pick < .52) cups.push({ z, x: (rng() - .5) * 1.5, kind: 'cup' });\n      else if (pick < .52 + .4 * tier.pigeons) ctx.things.push({ z, x, kind: 'pigeons', flock: 3 + Math.floor(rng() * 3), t: 0 });\n      else ctx.things.push({ z, x, kind: 'jogger', v: 0.45 + rng() * .25, col: ['#f08fb0', '#6fcf8e', '#f5c84b', '#b08be0'][Math.floor(rng() * 4)], rigK: rng() });\n      z += 1100 + rng() * 800; }\n    ctx.things.push(...cups); ctx.things.sort((a, b) => a.z - b.z); ctx.cupsTotal = cups.length;\n    ctx.rigs = {};\n    for (const c of ctx.contestants) { c.z = 0; c.xr = 0; c.cad = 0; c.lastFoot = 0; c.lastStep = -9; c.zone = 0; c.cups = 0; c.stitch = 0; c.over = 0; c.bump = 0; c.fly = []; c.bal = new G.Balance({ k: 20, c: 8, s: 0, A: .2, nf: 1, R: .3 }, c.rng); c.bal.cheat = true; c.nextFoot = -1; c.botT = 0; c.runT = 0; c.poser.clip('Run_Loop', { loop: true, fade: 0, tgt: -1.57 }); }\n  },\n  preview(dt, ctx) { const c = ctx.contestants[0]; c.poser.clip('Waiting_Loop', { loop: true, tgt: -1.57 }); c.poser.update(dt); c.rig.update(dt, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: c.poser.facing }); game.focus(0, 0, 0); ctx.pv = (ctx.pv || 0) + dt * 200; },\n  update(dt, ctx) {\n    const d = G.DEV, band = ctx.tier.band || 1, mid = (d.jogLo + d.jogHi) / 2, half = (d.jogHi - d.jogLo) / 2 * band, lo = mid - half, hi = mid + half; ctx.lo = lo; ctx.hi = hi; game.focus(0, 0, 0);\n    for (const c of ctx.contestants) {\n      const I = c.intent;\n      /* a step counts only when feet alternate */\n      if (I.paceL && c.lastFoot !== -1) { c.lastFoot = -1; G.jogStep(ctx, c); }\n      if (I.paceR && c.lastFoot !== 1) { c.lastFoot = 1; G.jogStep(ctx, c); }\n      const since = ctx.time - c.lastStep; if (since > .55) c.cad = Math.max(0, c.cad - dt * 3.2);\n      if (c.cad > 4.2) { c.over += dt; if (c.over >= 2 && c.stitch <= 0) { c.stitch = 3; c.over = 0; if (G.cue(ctx, c)) { G.A.sfx('stumble'); G.mutter('marisol', 'A stitch! That is your body saying a word. Walk it off.', { auto: 2.6 }); if (c.input) c.input.rumble(.6, .3); } } } else c.over = 0;\n      if (c.stitch > 0) c.stitch -= dt;\n      const hobble = c.stitch > 0, v = (hobble ? .35 : 1) * (c.bump > 0 ? .5 : 1) * Math.min(c.cad, 4.6) * 390 * d.jogSpeed;\n      if (!hobble && c.cad >= lo && c.cad <= hi) c.zone += dt;\n      c.runT += dt; c.z += v * dt; c.bump = Math.max(0, c.bump - dt);\n      /* steer: the road bends gently against you */\n      c.bal.step(dt, I.x, 0);\n      const pct = Math.min(1, v / 1200); c.xr += c.bal.x * dt * 1.5 * Math.min(1, pct * 2 + .1); c.xr -= ctx.road.curveAt(c.z + ctx.ahead) * pct * pct * dt * .22; c.xr = clamp(c.xr, -1.05, 1.05);\n      ctx.turn += ctx.road.curveAt(c.z) * v * dt * .004 / ctx.contestants.length;\n      /* what you meet */\n      for (const q of ctx.things) {\n        if (q.done) continue; const dz = q.z - (c.z + ctx.ahead);\n        if (dz < -400) { if (q.kind === 'jogger' && !q.passed) q.passed = true; continue; }\n        if (dz > 300) break;\n        if (q.kind === 'cup' && Math.abs(q.x - c.xr) < .24 && Math.abs(dz) < 240) { q.done = true; c.cups++; if (G.cue(ctx, c)) { G.A.sfx('cup'); } }\n        if (q.kind === 'pigeons' && !q.t && Math.abs(q.x - c.xr) < .26 && Math.abs(dz) < 240) { q.t = .01; c.bump = .7; if (G.cue(ctx, c)) { G.A.sfx('pigeon'); if (c.input) c.input.rumble(.3, .15); } }\n        if (q.kind === 'jogger' && Math.abs(q.x - c.xr) < .22 && Math.abs(dz) < 200 && c.bump <= 0) { c.bump = .8; c.xr += c.xr < q.x ? -.2 : .2; if (G.cue(ctx, c)) { G.A.sfx('thud'); } }\n      }\n      const P = c.poser, k = c.cad / 3;\n      if (hobble) P.clip('Dizzy', { loop: true, tgt: -1.57, fade: .2 }); else if (c.cad < .6) P.clip('Waiting_Loop', { loop: true, tgt: -1.57, fade: .2 }); else P.clip('Run_Loop', { loop: true, tgt: -1.57, fade: .2 });\n      if (P.cur) P.cur.speed = clamp(k, .3, 1.8);\n      P.update(dt); c.rig.wob = [c.bal.x * .35, 0]; c.rig.update(dt, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: P.facing, expr: hobble ? 'wince' : 'smile' });\n      if (c.z >= ctx.finishZ - ctx.ahead) { c.fin = true; }\n    }\n    for (const q of ctx.things) { if (q.kind === 'jogger') q.z += 1170 * q.v * dt; if (q.kind === 'pigeons' && q.t) q.t += dt; }\n    if (ctx.contestants.every(c => c.fin)) ctx.finished = true;\n    if (ctx.local) { const me = ctx.local; ctx.pz = me.z; ctx.px = me.xr; } else { ctx.pz = ctx.contestants[0].z; ctx.px = ctx.contestants[0].xr; }\n  },\n  result(ctx, c) { const zone = c.runT > 0 ? c.zone / c.runT : 0, cup = ctx.cupsTotal ? c.cups / ctx.cupsTotal : 0, progress = clamp((c.z + ctx.ahead) / ctx.finishZ, 0, 1); return { pct: (.7 * zone + .3 * cup) * (ctx.durGiven ? 1 : Math.min(1, progress * 1.1)), detail: 'In the zone ' + Math.round(zone * 100) + '%. Water ' + c.cups + ' of ' + ctx.cupsTotal + '.' }; },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent; c.botT -= dt; I.paceL = I.paceR = false;\n    if (c.botT <= 0) { const cad = B.cad + B.jit * Math.sin(ctx.time * .6 + c.i); c.botT = 1 / cad; c.nextFoot = -c.nextFoot; if (c.nextFoot < 0) I.paceL = true; else I.paceR = true; }\n    /* look ahead: go for the next cup, away from the next thing in the way */\n    let want = 0, avoid = 0; const zz = c.z + ctx.ahead;\n    for (const q of ctx.things) { if (q.done || q.t) continue; const dz = q.z - zz; if (dz < 100) continue; if (dz > B.seen) break; if (q.kind === 'cup') { if (!want) want = q.x; } else if (Math.abs(q.x - c.xr) < .34) avoid = (c.xr >= q.x ? 1 : -1) * .8; }\n    const tx = avoid ? c.xr + avoid : (want || 0); I.x = clamp((tx - c.xr) * 1.6 * B.steer, -1, 1); I.y = 0;\n  },\n  ghost(ctx, c) { return { z: Math.round(c.z), x: +c.xr.toFixed(2), c: +c.cad.toFixed(1) }; },\n  draw(r, ctx) {\n    const pz = ctx.live || ctx.pz ? (ctx.pz || 0) : (ctx.pv || 0), px0 = ctx.px || 0, W = r.W, H = r.H;\n    const cars = [];\n    for (const q of ctx.things) { if (q.done) continue; const dz = q.z - pz; if (dz < 0 || dz > 26000) continue; cars.push(Object.assign(q, { w: q.kind === 'cup' ? 200 : q.kind === 'jogger' ? 300 : 500, draw: q.drawFn || (q.drawFn = G.jogThing(q)) })); }\n    const ghosts = G.jogGhosts ? G.jogGhosts(ctx) : []; for (const gh of ghosts) cars.push(gh);\n    ctx.road.draw(r, { z: pz, x: px0, h: CAM_H, turn: ctx.turn, cars });\n    r.overlay(g => {\n      for (const c of ctx.contestants) {\n        if (!c.local && ctx.local) continue;\n        const p = ctx.road.project(c.z + ctx.ahead, c.xr, 0); if (!p) continue; const sx = p[0], sy = p[1], k = Math.max(1, H / 150) * .8, v = scaleView(k * 1.4);\n        px.ell(g, sx, sy, 14 * k, 4 * k, '#20404c44');\n        c.rig.draw(g, Math.round(sx), Math.round(sy), v);\n      }\n    });\n  },\n  hud(g, ctx) {\n    if (!ctx.live) return;\n    const W = game.W, H = game.H, c = ctx.local || ctx.contestants[0];\n    G.drawTimer(g, G.left(ctx), { x: 36 });\n    /* the calm gauge: Marisol's pacing zone */\n    const gx = W / 2 - 80, gy = H - 34, gw = 160, mx = 5.2, xOf = v => gx + clamp(v / mx, 0, 1) * gw;\n    G.panel(g, gx - 8, gy - 16, gw + 16, 36, { r: 8 });\n    px.rect(g, gx, gy, gw, 8, '#e8f0f2'); px.rect(g, xOf(ctx.lo), gy, xOf(ctx.hi) - xOf(ctx.lo), 8, '#7fe0c3'); px.rect(g, xOf(4.2), gy, gx + gw - xOf(4.2), 8, '#ffc0ac');\n    const n = xOf(c.cad); px.rect(g, n - 1, gy - 3, 3, 14, '#20404c'); px.disc(g, n, gy - 4, 3, c.color || '#ff7a59');\n    const word = c.stitch > 0 ? 'A stitch' : c.cad < ctx.lo ? (c.cad < .6 ? 'Standing' : 'A little faster') : c.cad > 4.2 ? 'Far too fast' : c.cad > ctx.hi ? 'Slow down' : \"Marisol's pace\";\n    txt(g, word, W / 2, gy - 13, c.cad >= ctx.lo && c.cad <= ctx.hi ? '#14a8c8' : '#e0553a', { align: 'center' });\n    txt(g, c.cad.toFixed(1) + ' steps a second', W / 2, gy + 10, '#5f7f8a', { align: 'center' });\n    /* progress and water */\n    G.panel(g, W - 92, 8, 84, 28, { r: 7 }); txt(g, 'Water ' + c.cups + ' / ' + ctx.cupsTotal, W - 50, 11, '#14a8c8', { align: 'center' });\n    const pr = clamp((c.z + ctx.ahead) / ctx.finishZ, 0, 1); E.ui.bar(g, W - 86, 23, 72, 6, pr, '#2cc6e6', { bg: '#e8f0f2' });\n    G.prompts(g, [['paceL', 'Left'], ['paceR', 'Right']]);\n  }\n});\nG.jogStep = (ctx, c) => {\n  const now = ctx.time, iv = now - c.lastStep; c.lastStep = now;\n  if (iv > 0 && iv < 2) { const inst = 1 / iv; c.cad = c.cad <= 0 ? inst * .7 : c.cad + (inst - c.cad) * .32; } else c.cad = Math.max(c.cad, 1);\n  if (G.cue(ctx, c)) G.A.sfx('click', { vol: .4 });\n};\nG.jogThing = q => {\n  if (q.kind === 'cup') return (g, x, y, s) => { const W = 200 * s; if (W < 2) return; const h = W * 1.3; px.rect(g, x - W * .8, y - W * 2.4, W * 1.6, W * .2, '#c49c6c'); px.rect(g, x - W * .08, y - W * 2.4, W * .16, W * 2.4, '#a57f54'); px.poly(g, [[x - W * .34, y - W * 2.4 - h * .8], [x + W * .34, y - W * 2.4 - h * .8], [x + W * .24, y - W * 2.4], [x - W * .24, y - W * 2.4]], '#a8e4f2'); px.rect(g, x - W * .34, y - W * 2.4 - h * .8, W * .68, Math.max(1, W * .1), '#ffffff'); };\n  if (q.kind === 'pigeons') { const birds = []; for (let i = 0; i < q.flock; i++) birds.push({ a: i * 2.4, r: (i % 3) * 90 + 50 }); return (g, x, y, s) => { const W = 120 * s; if (W < 1) return; const up = q.t ? q.t * 1800 * s : 0; for (const b of birds) { const bx = x + Math.cos(b.a) * b.r * s + (q.t ? Math.cos(b.a) * q.t * 900 * s : 0), by = y - up - (q.t ? Math.sin(b.a) * 300 * s * q.t : 0) - W * .3; px.ell(g, bx, by, W * .6, W * .42, '#9aa8b0'); px.disc(g, bx + W * .5, by - W * .4, Math.max(1, W * .22), '#6a7a84'); if (q.t) { const f = Math.sin(game.real * 30 + b.a) * W; px.line(g, bx - W, by - f, bx, by, '#c6d0d6'); px.line(g, bx + W, by - f, bx, by, '#c6d0d6'); } else px.rect(g, bx - W * .1, by + W * .35, Math.max(1, W * .1), W * .4, '#ff9a7a'); } }; }\n  return (g, x, y, s) => { const W = 300 * s; if (W < 2) return; const b = Math.abs(Math.sin(game.real * 9 + q.rigK * 6)) * W * .2, h = W * 3; px.ell(g, x, y, W * .8, W * .22, '#20404c33'); px.rect(g, x - W * .28, y - h * .42 - b, W * .2, h * .42, '#3b5568'); px.rect(g, x + W * .08, y - h * .42 + b * .4, W * .2, h * .42, '#3b5568'); px.rect(g, x - W * .42, y - h * .82 - b * .5, W * .84, h * .42, q.col); px.disc(g, x, y - h * .94 - b * .5, W * .32, '#e8bd96'); px.rect(g, x - W * .32, y - h - b * .5, W * .64, W * .18, '#5a3a24'); };\n};\n})();\nEOF\ncat > game/activities/slalom.js <<'EOF'\n/* activities/slalom.js: Mount Posture Slalom, on Mode 7. Lean steers, forward tucks, back brakes. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst SNOW = (x, y) => { const n = Math.sin(x * .071) * Math.sin(y * .053) + .6 * Math.sin((x + y) * .019) + .3 * Math.sin(x * .3 + y * .17); const v = 240 + n * 4; return [v - 7, v - 1, Math.min(255, v + 8)]; };\nconst m7 = new E.Mode7({ floor: SNOW, size: [1024, 1024], wrap: true, far: 1500, sky: new E.Backdrop({ sky: ['#8fd3f4', '#d8f3fb', '#f4fbfd'], sun: { x: .75, y: .22, r: 12, color: '#fff6d8' }, layers: [{ kind: 'mountains', color: '#c6dcea', y: .78, height: .3, parallax: .02 }, { kind: 'mountains', color: '#e6f1f7', y: .86, height: .2, parallax: .05 }, { kind: 'hills', color: '#a8c8c0', y: .96, height: .08, parallax: .09 }] }) });\nG.m7 = m7;\nconst PINE = E.prop('pine').frames[0];\nconst HEADING = -Math.PI / 2;\nconst BOT = { poor: { look: 240, gain: 1.1, noise: .34, tuck: .1, avoid: .4 }, average: { look: 300, gain: 1.5, noise: .16, tuck: .35, avoid: .8 }, good: { look: 340, gain: 1.9, noise: .07, tuck: .7, avoid: 1 }, expert: { look: 380, gain: 2.3, noise: .02, tuck: 1, avoid: 1.2 } };\nconst drawGatePole = (g, sx, sy, k, col, side, next) => { const h = 34 * k; px.rect(g, sx - Math.max(.5, k * .6), sy - h, Math.max(1, k * 1.2), h, '#5a6a74'); const fw = 13 * k, fh = 9 * k; px.poly(g, [[sx, sy - h], [sx + side * fw, sy - h + fh * .5], [sx, sy - h + fh]], col); if (next) px.disc(g, sx, sy - h - 2 * k, Math.max(1, k * 1.6), '#ffd166'); };\nconst drawSnowman = (g, sx, sy, k) => { px.ell(g, sx, sy - 7 * k, 8 * k, 7 * k, '#ffffff'); px.ell(g, sx + k, sy - 6 * k, 7 * k, 6 * k, '#e3edf2'); px.disc(g, sx, sy - 18 * k, 5.5 * k, '#ffffff'); px.disc(g, sx, sy - 27 * k, 4 * k, '#ffffff'); if (k > .5) { px.rect(g, sx - 3 * k, sy - 35 * k, 6 * k, 4 * k, '#20404c'); px.rect(g, sx - 4.5 * k, sy - 31.5 * k, 9 * k, k, '#20404c'); px.dot(g, sx - 1.4 * k, sy - 28 * k, '#20404c'); px.dot(g, sx + 1.4 * k, sy - 28 * k, '#20404c'); px.poly(g, [[sx, sy - 27 * k], [sx + 4 * k, sy - 26 * k], [sx, sy - 25.5 * k]], '#ff9a3a'); px.rect(g, sx - 5 * k, sy - 23.5 * k, 10 * k, 1.4 * k, '#ff7a59'); } };\nG.family('slalom', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const co = G.DATA.courses.slalom[ctx.tier.course], n = co.gates.length;\n    const base = G.DEV.skiSpeed;\n    let use = n; if (ctx.durGiven) use = Math.max(4, Math.min(n, Math.floor(ctx.durGiven * base / co.spacing) - 1));\n    ctx.course = co; ctx.gates = co.gates.slice(0, use).map((x, i) => ({ x, y: -(i + 1) * co.spacing, state: null, col: i % 2 ? '#2c7fe6' : '#e0553a', i }));\n    ctx.obstacles = co.obstacles.filter(o => o[1] < use).map(o => ({ x: o[0], y: -(o[1] + 1) * co.spacing - co.spacing * .5, kind: o[2] }));\n    ctx.side = []; for (let i = -2; i < use + 4; i++) for (const s of [-1, 1]) ctx.side.push({ x: s * (240 + ((i * 53 + (s + 1) * 37) % 70)), y: -i * co.spacing * .34 * 3 });\n    ctx.finishY = -(use + 1) * co.spacing; ctx.nextGate = 0; ctx.scale = use / n; ctx.par = co.par * ctx.scale; ctx.worst = co.worst * ctx.scale; ctx.snow = [];\n    for (let i = 0; i < 90; i++) ctx.snow.push({ x: G.cosmetic(), y: G.cosmetic(), s: .3 + G.cosmetic() * .9 });\n    for (const c of ctx.contestants) { c.sx = 0; c.sy = 0; c.v = 0; c.bal = new G.Balance({ k: 14, c: 7, s: 0, A: .9, nf: 1, R: .3 }, c.rng); c.bal.cheat = true; c.tumble = 0; c.miss = 0; c.passed = 0; c.hits = 0; c.pen = 0; c.fin = 0; c.state = ''; c.stateT = 0; c.yaw = 0; c.trail = []; c.carve = null; }\n    ctx.camY = 0; ctx.camX = 0;\n  },\n  preview(dt, ctx) { const c = ctx.contestants[0]; c.rig.update(dt, { x: c.sx, y: c.sy, z: 0, vx: 0, vy: 0, facing: HEADING, pose: 'crouch', expr: 'smile' }); game.focus(0, 0, 0); ctx.camY = 0; ctx.camX = 0; },\n  update(dt, ctx) {\n    const d = G.DEV; game.focus(0, 0, 0);\n    for (const c of ctx.contestants) {\n      const I = c.intent, b = c.bal; b.step(dt, I.x, I.y);\n      if (c.fin) { c.v = Math.max(0, c.v - 300 * dt); c.sy -= c.v * dt; continue; }\n      if (c.tumble > 0) {\n        c.tumble -= dt; c.v = Math.max(0, c.v - 400 * dt); c.sy -= c.v * dt;\n      } else {\n        const want = d.skiSpeed * (b.y > .3 ? 1.35 : b.y < -.3 ? .6 : 1);\n        c.v += (want - c.v) * Math.min(1, dt * 1.6);\n        c.sx += b.x * 210 * d.skiTurn * dt; c.sx = clamp(c.sx, -220, 220); c.sy -= c.v * dt;\n      }\n      c.stateT = Math.max(0, c.stateT - dt);\n      /* gates: cross the line between the poles */\n      const G0 = ctx.gates[c.nextGate === undefined ? (c.nextGate = 0) : c.nextGate];\n      if (G0 && c.sy <= G0.y) {\n        const hw = ctx.course.gateWidth / 2 * (G.gentle() ? 1.25 : 1);\n        if (Math.abs(c.sx - G0.x) <= hw) { c.passed++; c.state = 'Gate'; c.stateT = .7; if (G.cue(ctx, c)) { G.A.sfx('hit'); } }\n        else { c.miss++; c.pen += 3; c.state = 'Missed. +3 s'; c.stateT = 1.1; if (G.cue(ctx, c)) { G.A.sfx('miss'); if (c.input) c.input.rumble(.25, .12); } }\n        c.nextGate++;\n      }\n      /* snowmen and pines: a tumble */\n      if (c.tumble <= 0 && !ctx.cheat) for (const o of ctx.obstacles) { if (Math.abs(c.sy - o.y) < 12 && Math.abs(c.sx - o.x) < (o.kind === 'pine' ? 13 : 11)) { c.tumble = 1.2; c.hits++; c.v *= .35; if (G.cue(ctx, c)) { G.A.sfx('stumble'); game.shake(.2); if (c.input) c.input.rumble(.8, .3); G.mutter('tare', G.line('tare.fall')); } break; } }\n      if (c.sy <= ctx.finishY) { c.fin = ctx.time; if (ctx.contestants.every(q => q.fin)) ctx.finishT = ctx.finishT || ctx.time; }\n      /* the body */\n      c.yaw += (b.x * .3 - c.yaw) * Math.min(1, dt * 6);\n      const pose = c.tumble > 0 ? 'down' : 'crouch';\n      c.rig.wob = [b.x * .6, b.y * .3]; c.rig.update(dt, { x: c.sx, y: c.sy, z: 0, vx: 0, vy: 0, facing: HEADING + c.yaw, pose: c.tumble > 0 ? undefined : 'crouch', down: c.tumble > 0 ? .8 : 0, expr: c.tumble > 0 ? 'wince' : 'smile' });\n      if (G.cue(ctx, c)) { c.carve = c.carve || new G.Tone({ wave: 'triangle' }); c.carve.set({ freq: 110 + Math.abs(b.x) * 240 + c.v * .15, vol: .012 + Math.abs(b.x) * .035, pan: b.x }); }\n      if (Math.floor(ctx.time * 16) !== Math.floor((ctx.time - dt) * 16)) { c.trail.push(c.sx, c.sy); if (c.trail.length > 140) c.trail.splice(0, 2); }\n    }\n    if (ctx.finishT && ctx.time > ctx.finishT + .9) ctx.finished = true;\n    const me = ctx.local || ctx.contestants[0];\n    ctx.camX += (me.sx - ctx.camX) * Math.min(1, dt * 6); ctx.camY = me.sy;\n    for (const s of ctx.snow) { s.y = (s.y + dt * (.18 + s.s * .2)) % 1; s.x = (s.x + dt * (-.02 + me.bal.x * -.08)) % 1; if (s.x < 0) s.x += 1; }\n  },\n  stop(ctx) { for (const c of ctx.contestants) if (c.carve) c.carve.stop(); },\n  result(ctx, c) {\n    const t = (c.fin || ctx.time) + c.pen + (c.fin ? 0 : 30), pct = clamp((ctx.worst - t) / (ctx.worst - ctx.par), 0, 1), L = G.DATA.lines.slalomTimes, peer = L[Math.floor(G.cosmetic() * L.length) % L.length];\n    return { pct, detail: 'Your time ' + G.fmtTime(t) + '. Gates ' + c.passed + ' of ' + ctx.gates.length + '. ' + peer[0] + ' ' + G.fmtTime(peer[1]) + '. ' + peer[2], time: t };\n  },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent, G0 = ctx.gates[c.nextGate || 0] || { x: 0, y: c.sy - 500 };\n    c.nz = c.nz || G.noise(c.rng, 1.3);\n    let tx = G0.x, ok = Math.abs(c.sy - G0.y) < B.look * 2.2;\n    for (const o of ctx.obstacles) { const dy = c.sy - o.y; if (dy > 0 && dy < 180 && Math.abs(o.x - c.sx) < 34 * B.avoid) tx = c.sx + (c.sx >= o.x ? 1 : -1) * 60; }\n    const need = (tx - c.sx) / 90; I.x = clamp(need * B.gain + B.noise * c.nz(ctx.time), -1, 1);\n    I.y = Math.abs(tx - c.sx) < 26 ? B.tuck : 0;\n  },\n  ghost(ctx, c) { return { x: Math.round(c.sx), y: Math.round(c.sy), w: [+c.bal.x.toFixed(2), +c.bal.y.toFixed(2)] }; },\n  draw(r, ctx) {\n    const me = ctx.local || ctx.contestants[0], cam = m7.chase({ x: ctx.camX + (me.sx - ctx.camX) * .5, y: ctx.camY }, { back: 72, h: 42, angle: HEADING + me.yaw * .25 }); cam.pitch = 15; cam.fov = 70;\n    if (ctx.course.fog) m7.o.fog = ctx.course.fog; else delete m7.o.fog;\n    const vis = o => o.y < cam.y && o.y > cam.y - 1500;\n    for (let i = 0; i < me.trail.length; i += 2) { const x = me.trail[i], y = me.trail[i + 1]; if (y > cam.y) continue; m7.add(x, y, 0, (g, sx, sy, k) => { px.rect(g, sx - 3 * k, sy, Math.max(1, k), 1, '#c9dce8'); px.rect(g, sx + 2 * k, sy, Math.max(1, k), 1, '#c9dce8'); }); }\n    for (const s of ctx.side) if (vis(s)) m7.sprite(PINE, s.x, s.y, 0, { scale: 1.7 });\n    for (const o of ctx.obstacles) if (vis(o)) { if (o.kind === 'pine') m7.sprite(PINE, o.x, o.y, 0, { scale: 1.5 }); else m7.add(o.x, o.y, 0, (g, sx, sy, k) => drawSnowman(g, sx, sy, k * .85)); }\n    const hw = ctx.course.gateWidth / 2;\n    ctx.gates.forEach(G0 => { if (!vis(G0)) return; const next = G0.i === (me.nextGate || 0); m7.add(G0.x - hw, G0.y, 0, (g, sx, sy, k) => drawGatePole(g, sx, sy, k * .85, G0.col, -1, next)); m7.add(G0.x + hw, G0.y, 0, (g, sx, sy, k) => drawGatePole(g, sx, sy, k * .85, G0.col, 1, next)); });\n    if (vis({ y: ctx.finishY })) m7.add(0, ctx.finishY, 0, (g, sx, sy, k) => { const w = 90 * k, h = 44 * k; for (const q of [-1, 1]) px.rect(g, sx + q * w - k, sy - h, 2 * k, h, '#5a6a74'); px.rect(g, sx - w, sy - h, 2 * w, 11 * k, '#fbfdfd'); for (let i = 0; i < 12; i++) if (i % 2) px.rect(g, sx - w + i * w / 6, sy - h, w / 6, 5.5 * k, '#20404c'); else px.rect(g, sx - w + i * w / 6, sy - h + 5.5 * k, w / 6, 5.5 * k, '#20404c'); });\n    G.drawSkiGhosts && G.drawSkiGhosts(ctx);\n    for (const c of ctx.contestants) { if (!c.local && ctx.local) continue; m7.add(c.sx, c.sy, 0, (g, sx, sy, k) => { px.ell(g, sx, sy + k, 11 * k, 3 * k, '#a8c0d0'); px.rect(g, sx - 6 * k, sy - 1, 2 * k, 2, '#ff7a59'); px.rect(g, sx + 4 * k, sy - 1, 2 * k, 2, '#ff7a59'); const v = m7.view(k * .92); c.rig.draw(g, Math.round(sx), Math.round(sy), v); }); }\n    m7.draw(r, cam);\n    r.overlay(g => { for (const s of ctx.snow) px.rect(g, s.x * game.W, s.y * game.H, s.s > .8 ? 2 : 1, s.s > .8 ? 2 : 1, '#ffffff'); });\n  },\n  hud(g, ctx) {\n    if (!ctx.live) return;\n    const W = game.W, H = game.H, c = ctx.local || ctx.contestants[0];\n    G.panel(g, 8, 6, 74, 20, { r: 8 }); txt(g, G.fmtTime((c.fin || ctx.time) + c.pen), 45, 9, '#20404c', { align: 'center', scale: 2 });\n    G.panel(g, W - 92, 8, 84, 16, { r: 7 }); txt(g, 'Gate ' + Math.min((c.nextGate || 0) + 1, ctx.gates.length) + ' / ' + ctx.gates.length, W - 50, 12, '#14a8c8', { align: 'center' });\n    G.drawPlate(g, c.bal, { x: W / 2, y: H - 28, r: 22, ring: null, color: c.color });\n    if (c.bal.y > .3) txt(g, 'Tuck', W / 2, H - 62, '#14a8c8', { align: 'center', shadow: '#ffffff' }); else if (c.bal.y < -.3) txt(g, 'Braking', W / 2, H - 62, '#e0553a', { align: 'center', shadow: '#ffffff' });\n    if (c.stateT > 0) txt(g, c.state, W / 2, 34, c.state === 'Gate' ? '#14a8c8' : '#e0553a', { align: 'center', scale: 2, shadow: '#ffffff' });\n    if (c.tumble > 0) txt(g, 'Tumble', W / 2, 52, '#e0553a', { align: 'center', scale: 2, shadow: '#ffffff' });\n    G.prompts(g, [['lean', 'Lean. Forward tucks. Back brakes.']]);\n  }\n});\n})();\nEOF\ncat > game/activities/tray.js <<'EOF'\n/* activities/tray.js: Tray Service. Lean tilts a tea tray; olives roll; glasses are sensors. Layouts are text in data/trays.js. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nE.VIEWS.tray = E.VIEWS.tray || new E.View('tray', 'Tray', 0, 55, 1.25, 1);\nconst CELL = 16;\nconst BOT = { poor: { gain: .55, damp: .3, noise: .3 }, average: { gain: .85, damp: .45, noise: .12 }, good: { gain: 1.1, damp: .6, noise: .05 }, expert: { gain: 1.4, damp: .7, noise: .01 } };\nfunction load(ctx, c, i) {\n  const list = G.DATA[ctx.tier.trays], layout = list[i], rows = layout.rows, H = rows.length * CELL, W = rows[0].length * CELL, x0 = -W / 2, y0 = -H / 2;\n  const fr = (ctx.tier.friction || 0) + G.DEV.trayF;\n  const world = new E.Physics({ gravity: [0, 0], sleep: false, substeps: 4, on: {\n    enter(sensor, body) {\n      if (!body.data || body.data.kind !== 'olive' || body.off) return;\n      if (sensor.data && sensor.data.kind === 'glass') { body.off = true; c.world.remove(body); sensor.data.n++; c.inGlass++; c.olives = c.olives.filter(o => o !== body); if (G.cue(ctx, c)) { G.A.sfx('plop'); G.P.glints(sensor.x, sensor.y, 8, 4, '#bff3e2'); if (c.input) c.input.rumble(.25, .1); } }\n      if (sensor.data && sensor.data.kind === 'gap') { body.data.fall = .7; body.vx = body.vy = 0; if (G.cue(ctx, c)) G.A.sfx('drop'); }\n    },\n    hit(a, b, info) { if (G.cue(ctx, c)) { const ol = (a.data && a.data.kind === 'olive') || (b.data && b.data.kind === 'olive'); if (ol && Math.hypot(a.vx - b.vx, a.vy - b.vy) > 40) { c.clinkT = c.clinkT || 0; if (c.clinkT <= 0) { G.A.sfx('trayClink', { vol: .6 }); c.clinkT = .1; } } } }\n  } });\n  world.chain([[x0, y0], [x0 + W, y0], [x0 + W, y0 + H], [x0, y0 + H]], { closed: true, r: 1, bounce: .35, friction: .1 });\n  c.world = world; c.olives = []; c.glasses = []; c.bumpers = []; c.blocks = []; c.gaps = []; c.gecko = null; c.W = W; c.H = H; c.inGlass = c.inGlass || 0;\n  rows.forEach((row, ry) => { [...row].forEach((ch, rx) => {\n    const x = x0 + (rx + .5) * CELL, y = y0 + (ry + .5) * CELL;\n    if (ch === 'o') { const b = world.circle(x, y, 5, { bounce: .35, friction: .1, damping: fr, data: { kind: 'olive', sx: x, sy: y, fall: 0 } }); c.olives.push(b); }\n    else if (ch === 'G') { const s = world.add({ shape: 'circle', type: 'static', x, y, r: 6.5, sensor: true, data: { kind: 'glass', n: 0 } }); c.glasses.push(s); }\n    else if (ch === 'B') { c.bumpers.push(world.bumper(x, y, 7, { kick: 110 })); }\n    else if (ch === '#') { c.blocks.push(world.box(x, y, CELL, CELL, { type: 'static', bounce: .3 })); }\n    else if (ch === '~') { const s = world.add({ shape: 'circle', type: 'static', x, y, r: 6, sensor: true, data: { kind: 'gap' } }); c.gaps.push(s); }\n    else if (ch === 'K') { c.gecko = world.circle(x, y, 7, { type: 'kinematic', data: { kind: 'gecko' }, bounce: .5 }); c.geckoT = 0; c.geckoP = [[x, y], [x + 70, y - 8], [x + 30, y - 40], [x - 10, y - 16]]; c.geckoI = 0; }\n  }); });\n  c.trayI = i; c.nextT = 0; c.total = c.total || list.reduce((n, L) => n + L.rows.join('').split('o').length - 1, 0);\n}\nG.family('tray', {\n  camera: { zoom: false },\n  setup(ctx) {\n    ctx.dur = ctx.durGiven || ctx.tier.dur || 60;\n    for (const c of ctx.contestants) { c.bal = new G.Balance(ctx.tier.set, c.rng); c.bal.cheat = true; c.inGlass = 0; c.finT = 0; load(ctx, c, 0); }\n    ctx.dennis = G.regularRig('dennis', 1.7); ctx.dennisPoser = new G.Poser(ctx.dennis);\n  },\n  preview(dt, ctx) { game.focus(0, 8, 0); ctx.dennisPoser.clip('Idle_Subtle', { loop: true, tgt: 1 }); ctx.dennisPoser.update(dt); ctx.dennis.update(dt, { x: -180, y: -40, z: 0, vx: 0, vy: 0, facing: ctx.dennisPoser.facing }); for (const c of ctx.contestants) c.world.step(dt); },\n  update(dt, ctx) {\n    game.focus(0, 8, 0);\n    for (const c of ctx.contestants) {\n      if (c.finT) continue;\n      const b = c.bal, I = c.intent; b.step(dt, I.x, I.y);\n      c.world.gravity = [b.x * G.DEV.trayG, -b.y * G.DEV.trayG];\n      /* the gecko walks, slowly, for reasons of its own */\n      if (c.gecko) { const P = c.geckoP[c.geckoI]; if (Math.hypot(c.gecko.x - P[0], c.gecko.y - P[1]) < 3) c.geckoI = (c.geckoI + 1) % c.geckoP.length; c.gecko.moveTo(P[0], P[1], 0, 22, 0); }\n      c.world.wake(); c.world.step(dt); c.clinkT = Math.max(0, (c.clinkT || 0) - dt);\n      for (const o of c.olives) { const D = o.data; if (D.fall > 0) { D.fall -= dt; o.vx = o.vy = 0; if (D.fall <= 0) { o.x = D.sx; o.y = D.sy; o.vx = o.vy = 0; } } }\n      if (!c.olives.length) {\n        c.nextT += dt;\n        if (c.nextT > .8) { const list = G.DATA[ctx.tier.trays]; if (c.trayI + 1 < list.length) { load(ctx, c, c.trayI + 1); if (G.cue(ctx, c)) G.A.sfx('ok'); } else { c.finT = ctx.time; if (ctx.contestants.every(q => q.finT)) ctx.finished = true; } }\n      }\n    }\n    ctx.dennisPoser.clip('Waiting_Loop', { loop: true, tgt: 1 }); ctx.dennisPoser.update(dt); ctx.dennis.update(dt, { x: -180, y: -40, z: 0, vx: 0, vy: 0, facing: ctx.dennisPoser.facing });\n  },\n  result(ctx, c) { const t = c.finT || ctx.dur, left = clamp(1 - t / ctx.dur, 0, 1), pct = c.inGlass / c.total * (.8 + .2 * left); return { pct, detail: 'Olives in glasses: ' + c.inGlass + ' of ' + c.total + '. Dennis nods slowly.' }; },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent; c.nz = c.nz || G.noise(c.rng, 1.7);\n    /* the olive nearest a glass, toward that glass; round a gap or a block by leaning past it */\n    let best = null, bd = 1e9, bg = null;\n    for (const o of c.olives) { if (o.data.fall > 0) continue; for (const s of c.glasses) { const d = Math.hypot(o.x - s.x, o.y - s.y); if (d < bd) { bd = d; best = o; bg = s; } } }\n    if (!best) { I.x = 0; I.y = 0; return; }\n    let dx = bg.x - best.x, dy = bg.y - best.y;\n    for (const h of c.gaps.concat(c.blocks)) { const ax = h.x - best.x, ay = h.y - best.y, along = (ax * dx + ay * dy) / Math.max(1, dx * dx + dy * dy); if (along > 0 && along < 1) { const px0 = best.x + dx * along, py0 = best.y + dy * along, off = Math.hypot(px0 - h.x, py0 - h.y); if (off < 22) { const nx = (py0 - h.y) || .01, sgn = py0 >= h.y ? 1 : -1; dy += sgn * 40; } } }\n    const D = Math.max(20, Math.hypot(dx, dy)), ux = dx / D * B.gain - best.vx * B.damp * .012 + B.noise * c.nz(ctx.time), uy = dy / D * B.gain - best.vy * B.damp * .012 + B.noise * c.nz(ctx.time + 3);\n    I.x = clamp(ux, -1, 1); I.y = clamp(-uy, -1, 1);\n  },\n  draw(r, ctx) {\n    const g0 = r.ctx, W = r.W + 2, H = r.H + 2;\n    /* the bar's counter */\n    G.bands(g0, 0, 0, W, H, '#e8cfa8', '#c9a97c', 10);\n    for (let i = 0; i < 7; i++) px.rect(g0, 0, Math.floor(i * H / 7), W, 1, '#b8976a');\n    G.fern(g0, W * .93, H * .3, 1.4); \n    const c = ctx.local || ctx.contestants[0], b = c.bal, T = 9;\n    const tz = (x, y) => -(x / (c.W / 2)) * b.x * T + (y / (c.H / 2)) * b.y * T + 8;\n    const corners = [[-c.W / 2 - 7, -c.H / 2 - 7], [c.W / 2 + 7, -c.H / 2 - 7], [c.W / 2 + 7, c.H / 2 + 7], [-c.W / 2 - 7, c.H / 2 + 7]].map(p => r.w(p[0], p[1], tz(p[0], p[1])));\n    const low = [[-c.W / 2 - 7, c.H / 2 + 7], [c.W / 2 + 7, c.H / 2 + 7]].map(p => r.w(p[0], p[1], tz(p[0], p[1]) - 5));\n    // the tray: its shadow, rim and face\n    px.polyDither(g0, corners.map(p => [p[0] + 3, p[1] + 9]), '#7a5a3a', .35, r.ix, r.iy);\n    px.poly(g0, [corners[3], corners[2], low[1], low[0]].map(p => [p[0], p[1]]), '#9fb5bc');\n    px.poly(g0, corners.map(p => [p[0], p[1]]), '#dfe9ea');\n    const face = [[-c.W / 2, -c.H / 2], [c.W / 2, -c.H / 2], [c.W / 2, c.H / 2], [-c.W / 2, c.H / 2]].map(p => r.w(p[0], p[1], tz(p[0], p[1])));\n    px.poly(g0, face.map(p => [p[0], p[1]]), '#f6fafa');\n    for (let i = 1; i < 6; i++) { const y = -c.H / 2 + i * c.H / 6, a = r.w(-c.W / 2, y, tz(-c.W / 2, y)), d = r.w(c.W / 2, y, tz(c.W / 2, y)); px.line(g0, a[0], a[1], d[0], d[1], '#eaf1f2'); }\n    const ground = (x, y, z = 0) => r.w(x, y, tz(x, y) + z);\n    for (const s of c.gaps) { const p = ground(s.x, s.y); px.ell(g0, p[0], p[1], 8, 6, '#20404c'); px.ell(g0, p[0], p[1] + 1, 7, 4, '#0f2a35'); }\n    for (const s of c.glasses) { const p = ground(s.x, s.y); r.queue(s.x, s.y - 1, tz(s.x, s.y), g => { px.ell(g, p[0], p[1] + 2, 8, 5, '#c8dde2'); px.rect(g, p[0] - 1, p[1] - 10, 2, 12, '#dfeef2'); px.poly(g, [[p[0] - 11, p[1] - 19], [p[0] + 11, p[1] - 19], [p[0], p[1] - 8]], '#d6f2f7'); px.line(g, p[0] - 11, p[1] - 19, p[0] + 11, p[1] - 19, '#ffffff'); px.line(g, p[0] - 11, p[1] - 19, p[0], p[1] - 8, '#a8d4de'); px.line(g, p[0] + 11, p[1] - 19, p[0], p[1] - 8, '#a8d4de'); for (let i = 0; i < Math.min(3, s.data.n); i++) { px.disc(g, p[0] - 3 + i * 3, p[1] - 13 - (i % 2), 2, '#7b9a3a'); px.dot(g, p[0] - 3 + i * 3, p[1] - 14 - (i % 2), '#e0553a'); } }); }\n    for (const s of c.bumpers) { const p = ground(s.x, s.y); r.queue(s.x, s.y, tz(s.x, s.y), g => { px.ell(g, p[0], p[1] + 1, 10, 7, '#c49c6c'); px.ell(g, p[0], p[1] - 2, 9, 6, '#ffd166'); px.ell(g, p[0] - 2, p[1] - 4, 3, 2, '#fff3c8'); }); }\n    for (const s of c.blocks) { const p = ground(s.x, s.y); r.queue(s.x, s.y, tz(s.x, s.y), g => { px.rect(g, p[0] - 10, p[1] - 14, 20, 20, '#fbfdfd'); px.rect(g, p[0] - 10, p[1] - 14, 20, 6, '#ffffff'); px.rect(g, p[0] - 10, p[1] + 5, 20, 1, '#c8dde2'); px.rect(g, p[0] + 7, p[1] - 8, 3, 13, '#dfe9ea'); }); }\n    if (c.gecko) { const q = c.gecko, p = ground(q.x, q.y), wig = Math.sin(game.real * 9) * 2; r.queue(q.x, q.y, tz(q.x, q.y), g => { px.line(g, p[0] - 9, p[1] + wig, p[0] - 4, p[1], '#6fbf5a', 2); px.ell(g, p[0], p[1], 6, 3, '#7fd17a'); px.disc(g, p[0] + 6, p[1] - 1, 3, '#8fe08a'); px.dot(g, p[0] + 7, p[1] - 2, '#20404c'); for (const k of [-3, 3]) { px.dot(g, p[0] + k, p[1] - 3 - wig * .3, '#6fbf5a'); px.dot(g, p[0] + k, p[1] + 3 + wig * .3, '#6fbf5a'); } }); }\n    for (const o of c.olives) { const fall = o.data.fall > 0 ? (1 - o.data.fall / .7) : 0; if (fall > .5) continue; const p = ground(o.x, o.y, 2 - fall * 6); r.queue(o.x, o.y, tz(o.x, o.y), g => { px.ell(g, p[0] + 1, p[1] + 4, 6, 3, '#20404c40'); px.disc(g, p[0], p[1] - 1, 6, '#5f7f2a'); px.disc(g, p[0] - 1, p[1] - 2, 5, '#7b9a3a'); px.disc(g, p[0] - 2, p[1] - 3, 2, '#a8c060'); px.disc(g, p[0] + 2, p[1] - 3, 1.6, '#e0553a'); }); }\n    G.drawRig(r, ctx.dennis, -180, -40);\n    if (Math.floor(game.real / 5) % 2 === 0) r.queue(-180, -40, 80, g => {}, {});\n    G.drawGhosts && G.drawGhosts(r, ctx);\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, c = ctx.local || ctx.contestants[0];\n    if (ctx.live) G.drawTimer(g, G.left(ctx), { x: 36 });\n    if (ctx.live) { G.panel(g, W - 100, 8, 92, 16, { r: 7 }); txt(g, 'Olives ' + c.inGlass + ' / ' + c.total, W - 54, 12, '#14a8c8', { align: 'center' }); }\n    if (ctx.live) { G.drawPlate(g, c.bal, { x: 34, y: H - 34, r: 26, ring: null, color: c.color }); G.prompts(g, [['lean', 'Tilt']]); }\n    if (ctx.live && Math.floor(ctx.time / 5) % 2 === 0) { const p = game.r.w(-180, -40, 62); G.panel(g, p[0] - 16, p[1] - 12, 40, 15, { r: 7 }); txt(g, 'Olive?', p[0] + 4, p[1] - 8, '#5f7f8a', { align: 'center' }); }\n  }\n});\n})();\nEOF\ncat > game/activities/laundry.js <<'EOF'\n/* activities/laundry.js: Laundry Line. Walk a clothesline between bungalows, on the x axis only. Effort sets the pace and\n * the wobble; jump over pegs; the wind warns you first. Fall: you dangle, drop into a hamper, go back to the last post. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst ROPE_Z = 58, WALK = 40;\nconst BOT = { poor: { effort: .45, jumpAt: 8, hit: .75 }, average: { effort: .6, jumpAt: 10, hit: .92 }, good: { effort: .78, jumpAt: 12, hit: 1 }, expert: { effort: .95, jumpAt: 14, hit: 1 } };\nconst CLOTHES = ['#ff7a59', '#2cc6e6', '#f5c84b', '#6fcf8e', '#f08fb0', '#ffffff', '#b08be0'];\nG.family('laundry', {\n  camera: { zoom: false }, view: 'side',\n  setup(ctx) {\n    const co = G.DATA.courses.laundry; ctx.spans = co.spans; ctx.posts = [0]; ctx.pegs = []; ctx.gusts = []; let at = 0;\n    const sc = ctx.durGiven ? clamp(ctx.durGiven / 70, .4, 1) : 1;\n    co.spans.forEach((s, i) => { const len = s.len * sc; for (const p of s.pegs) if (p * sc < len - 14) ctx.pegs.push({ x: at + p * sc, hit: {} }); for (const g of s.gusts) ctx.gusts.push({ x: at + g * len, dir: ctx.rng() < .5 ? -1 : 1, state: 0, t: 0 }); at += len; ctx.posts.push(at); });\n    ctx.end = at; ctx.clothes = []; for (let x = 18; x < at - 12; x += 27) { const pegHere = ctx.pegs.some(p => Math.abs(p.x - x) < 16); if (pegHere) continue; ctx.clothes.push({ x, kind: Math.floor(ctx.rng() * 4), col: CLOTHES[Math.floor(ctx.rng() * CLOTHES.length)], k: ctx.rng() * 6 }); }\n    ctx.wind = 0; ctx.windDir = 1; ctx.par = co.par * sc; ctx.worst = co.worst * sc; ctx.dur = ctx.durGiven || ctx.def.dur; ctx.sock = null;\n    for (const c of ctx.contestants) { c.bal = new G.Balance(ctx.tier.set, c.rng); c.bal.axis = 'x'; c.bal.cheat = ctx.cheat; c.wx = 6; c.vz = 0; c.jz = 0; c.fallT = 0; c.falls = 0; c.pen = 0; c.lastPost = 0; c.effort = 0; c.ph = 0; c.fin = 0; c.state = 'walk'; c.gustI = 0; c.creakT = 0;\n      c.bal.onStumble = () => {}; }\n    if (ctx.contestants.length === 1) ctx.contestants[0].y = 0;\n  },\n  preview(dt, ctx) { const c = ctx.contestants[0]; c.rig.body = G.moves.rope(0, 0); c.rig.update(dt, { x: c.wx, y: 0, z: ROPE_Z, vx: 0, vy: 0, facing: 0, expr: 'smile' }); game.cam.smooth = 0; game.focus(c.wx + 40, 0, ROPE_Z - 4); },\n  update(dt, ctx) {\n    const d = G.DEV, t = ctx.time, set = ctx.tier.set;\n    for (const c of ctx.contestants) {\n      const I = c.intent, b = c.bal;\n      if (c.fin) { c.ph += dt * 2; c.rig.body = null; c.rig.wob = [0, 0]; c.poser.clip('Victory', { tgt: 1.2, loop: false }); c.poser.update(dt); c.rig.update(dt, { x: c.wx, y: 0, z: ROPE_Z, vx: 0, vy: 0, facing: c.poser.facing, expr: 'smile' }); continue; }\n      if (c.fallT > 0) {   // dangle, drop, hamper, back to the last post\n        c.fallT -= dt; const k = 1 - c.fallT / 1.6, drop = k < .3 ? 0 : (k - .3) / .7 * ROPE_Z; c.dropZ = ROPE_Z - drop * Math.min(1, drop / 20 + .4);\n        c.rig.body = null; c.poser.clip('Dizzy', { fade: .1, loop: true, tgt: .2 }); c.poser.update(dt); c.rig.wob = [Math.sin(t * 9) * .2, 0]; c.rig.update(dt, { x: c.wx, y: 0, z: Math.max(4, c.dropZ), vx: 0, vy: 0, facing: c.poser.facing, expr: 'wince' });\n        if (c.fallT <= .6 && !c.boomp && G.cue(ctx, c)) { c.boomp = true; G.A.sfx('thud'); }\n        if (c.fallT <= 0) { c.wx = c.lastPost + 6; b.x = b.y = b.vx = b.vy = 0; b.stumbling = 0; c.pen += 3; c.boomp = false; c.poser.off(); }\n        continue;\n      }\n      /* effort: walk speed, and instability */\n      const eff = clamp(c.skill || (G.DEV.bot && c.local) ? I.walk : I.walk, 0, 1); c.effort = eff;\n      b.extraS = 4 * eff * d.rope; b.set.s = set.s * d.rope;\n      /* gusts: telegraphed .8 s early by wind lines and a flying sock */\n      for (const gu of ctx.gusts) {\n        if (gu.state === 0 && c.wx > gu.x - 16 && c === (ctx.local || ctx.contestants[0])) { gu.state = 1; gu.t = 0; ctx.windDir = gu.dir; if (G.cue(ctx, c)) G.A.sfx('wind'); ctx.sock = { x: c.wx - gu.dir * 150, z: ROPE_Z + 40, t: 0, dir: gu.dir }; }\n        if (gu.state === 1) { gu.t += dt / ctx.contestants.length; if (gu.t >= .8) { gu.state = 2; gu.t = 0; } }\n        if (gu.state === 2) { gu.t += dt / ctx.contestants.length; b.fx += gu.dir * ctx.tier.gust * d.gust; if (gu.t >= .6) gu.state = 3; }\n      }\n      ctx.wind = ctx.gusts.some(g => g.state === 1 || g.state === 2) ? 1 : Math.max(0, ctx.wind - dt);\n      /* a jump: in the air, p freezes */\n      if (I.jump && c.jz <= 0) { c.vz = 118; c.jz = .01; if (G.cue(ctx, c)) G.A.sfx('tareHop', { vol: .6 }); b.frozen = true; }\n      if (c.jz > 0) { c.vz -= 340 * dt; c.jz += c.vz * dt; if (c.jz <= 0) { c.jz = 0; c.vz = 0; b.frozen = false; if (G.cue(ctx, c)) { G.A.sfx('rope'); } b.kick((c.rng() - .5) * .35, 0); } }\n      b.step(dt, I.x, 0);\n      const inRing = Math.abs(b.x) <= b.R, speed = WALK * eff * (inRing ? 1 : .55);\n      c.wx += speed * dt; c.ph += speed * dt * .32;\n      if (G.cue(ctx, c) && speed > 4) { c.creakT -= dt; if (c.creakT <= 0) { G.A.sfx('rope', { vol: .4 + b.edge * .6 }); c.creakT = .55 - b.edge * .2; if (b.edge > .7 && c.input) c.input.rumble(.3, .1); } }\n      for (const pz of ctx.posts) if (c.wx >= pz && pz > c.lastPost) { c.lastPost = pz; if (G.cue(ctx, c)) G.A.sfx('ok'); }\n      /* pegs trip you; the rope throws you */\n      let tripped = false;\n      if (c.jz < 6) for (const p of ctx.pegs) if (!p.hit[c.i] && Math.abs(c.wx - p.x) < 4) { p.hit[c.i] = true; if (!ctx.cheat) tripped = true; else c.jz = .01, c.vz = 118; }\n      if (b.stumbling > 0 || tripped) { b.stumbling = 0; c.falls++; c.fallT = 1.6; c.dropZ = ROPE_Z; if (G.cue(ctx, c)) { G.A.sfx('stumble'); game.shake(.08); if (c.input) c.input.rumble(.8, .3); if (c.falls === 1) G.mutter('tare', G.line('tare.fall')); } for (const p of ctx.pegs) if (p.x > c.lastPost) delete p.hit[c.i]; continue; }\n      if (c.wx >= ctx.end) { c.fin = t + c.pen; c.wx = ctx.end; if (ctx.contestants.every(q => q.fin)) ctx.finished = true; if (G.cue(ctx, c)) G.sting('star1'); }\n      const arms = clamp(b.x, -1, 1) * 2.4;\n      c.rig.body = G.moves.rope(c.ph, arms); c.rig.mocap = null; c.rig.wob = [0, clamp(b.x, -1, 1) * .9];\n      c.rig.update(dt, { x: c.wx, y: 0, z: ROPE_Z + c.jz, vx: 0, vy: 0, facing: 0, expr: b.edge > .6 ? 'wince' : 'smile' });\n    }\n    if (ctx.sock) { ctx.sock.t += dt; ctx.sock.x += ctx.sock.dir * 170 * dt; if (ctx.sock.t > 2) ctx.sock = null; }\n    const me = ctx.local || ctx.contestants[0]; game.cam.smooth = 0; game.focus(me.wx + 40, 0, ROPE_Z - 4);\n  },\n  result(ctx, c) { const t = (c.fin || (ctx.time + 40)) + 0, pct = clamp((ctx.worst - t) / (ctx.worst - ctx.par), 0, 1) - .06 * c.falls; return { pct, detail: 'Your time ' + G.fmtTime(t) + '. Falls: ' + c.falls + '.' + (c.fin ? '' : ' You did not reach the end. The laundry understands.') }; },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent, bal = c.bal; const u = c.brain.hold(dt, { x: bal.x, y: 0, vx: bal.vx, vy: 0 }, 0, 0); I.x = u[0]; I.y = 0; I.walk = B.effort; I.jump = false;\n    for (const p of ctx.pegs) { const dx = p.x - c.wx; if (dx > 0 && dx < B.jumpAt && c.jz <= 0 && !p.hit[c.i] && !p.tried) { p.tried = c.rng() < B.hit ? 'go' : 'no'; } if (dx > 0 && dx < B.jumpAt && p.tried === 'go' && c.jz <= 0) { I.jump = true; p.tried = 'done'; } }\n    if (ctx.tried === undefined) ctx.tried = 0;\n  },\n  ghost(ctx, c) { return { x: Math.round(c.wx), z: Math.round(c.jz), w: +c.bal.x.toFixed(2), f: c.fallT > 0 ? 1 : 0 }; },\n  draw(r, ctx) {\n    const g0 = r.ctx, W = r.W + 2, H = r.H + 2, ground = r.w(0, 0, 0)[1];\n    G.bands(g0, 0, 0, W, ground, '#8fd3f4', '#d8f3fb', 12);\n    const seaY = ground - 30; G.bands(g0, 0, seaY, W, 30, '#49b6c9', '#2f97ad', 5);\n    const cam = r.w(0, 0, 0)[0];\n    for (let i = 0; i < 5; i++) { const x = ((i * 137 - cam * -.1 + game.real * 4) % (W + 60)) - 30, y = 16 + i * 12; px.ell(g0, x, y, 18, 3, '#ffffff'); px.ell(g0, x + 7, y - 2, 9, 3, '#ffffff'); }\n    G.bands(g0, 0, ground, W, H - ground, '#7fc87a', '#5fa864', 6);\n    for (let i = -2; i < 28; i++) { const q = r.w(i * 60, 0, 0); if (q[0] < -30 || q[0] > W + 30) continue; px.rect(g0, q[0], q[1] + 4, 2, 2, '#4f9a58'); px.rect(g0, q[0] + 22, q[1] + 11, 2, 2, '#a8dc9a'); px.rect(g0, q[0] + 41, q[1] + 18, 2, 2, '#4f9a58'); }\n    /* bungalows at the posts */\n    ctx.posts.forEach((x, i) => { const p = r.w(x, 0, 0), Wb = 92, Hb = 58; if (p[0] < -120 || p[0] > W + 120) return; px.rect(g0, p[0] - Wb / 2, p[1] - Hb, Wb, Hb, '#fbf6ec'); px.rect(g0, p[0] - Wb / 2, p[1] - Hb, 5, Hb, '#ffffff'); px.poly(g0, [[p[0] - Wb * .62, p[1] - Hb], [p[0] + Wb * .62, p[1] - Hb], [p[0], p[1] - Hb - 30]], ['#ff9a7a', '#7fd8ea', '#f5c84b', '#6fcf8e'][i % 4]); px.rect(g0, p[0] - 9, p[1] - 28, 18, 28, '#c49c6c'); px.rect(g0, p[0] + 18, p[1] - 40, 16, 14, '#a8e4f2'); px.rect(g0, p[0] - 34, p[1] - 40, 16, 14, '#a8e4f2'); });\n    if (ctx.posts[0] !== undefined) { const p = r.w(ctx.posts[0] + 50, 0, 0); if (p[0] > -120 && p[0] < W + 120) { px.rect(g0, p[0] - 1, p[1] - 36, 2, 36, '#7a8a94'); G.panel(g0, p[0] - 110, p[1] - 62, 220, 28, { r: 5 }); G.wrapText(g0, G.DATA.lines.sign.laundry, p[0], p[1] - 59, 208, '#20404c', { align: 'center', gap: 1 }); } }\n    /* the posts and the rope */\n    for (const x of ctx.posts) { const a = r.w(x, 0, 0), b = r.w(x, 0, ROPE_Z + 8); px.rect(g0, a[0] - 2, b[1], 4, a[1] - b[1], '#a57f54'); px.rect(g0, a[0] - 2, b[1], 1, a[1] - b[1], '#c49c6c'); px.rect(g0, a[0] - 7, b[1] + 3, 14, 3, '#8a6a4a'); }\n    const me = ctx.local || ctx.contestants[0], segs = 90, sag = t => 0;\n    const ropeAt = x => { let s = 3 * Math.sin(Math.min(1, Math.abs(x - me.wx) / 110) * 1.57 + 1.57); return ROPE_Z - (s < 0 ? 0 : s) * .7 * (me.jz > 0 ? .3 : 1); };\n    for (let i = 0; i < segs; i++) { const x0 = ctx.posts[0] + i * ctx.end / segs, x1 = x0 + ctx.end / segs, a = r.w(x0, 0, ropeAt(x0)), b = r.w(x1, 0, ropeAt(x1)); if (b[0] < -8 || a[0] > W + 8) continue; px.line(g0, a[0], a[1], b[0], b[1], '#f4f8f8', 2); px.line(g0, a[0], a[1] + 1, b[0], b[1] + 1, '#9fb5bc'); }\n    /* laundry on the line */\n    for (const q of ctx.clothes) { const p = r.w(q.x, 0, ropeAt(q.x)); if (p[0] < -24 || p[0] > W + 24) continue; const sw = Math.sin(game.real * 2.4 + q.k) * 2 * (1 + ctx.wind * 2) * (ctx.wind ? ctx.windDir : 1);\n      if (q.kind === 0) { px.poly(g0, [[p[0] - 8, p[1] + 1], [p[0] + 8, p[1] + 1], [p[0] + 7 + sw, p[1] + 20], [p[0] - 7 + sw, p[1] + 20]], q.col); px.rect(g0, p[0] - 13, p[1] + 1, 5, 6, q.col); px.rect(g0, p[0] + 8, p[1] + 1, 5, 6, q.col); px.rect(g0, p[0] - 3, p[1] + 1, 6, 2, E.shade(q.col, -.2)); }\n      else if (q.kind === 1) { px.poly(g0, [[p[0] - 5, p[1] + 1], [p[0] + 5, p[1] + 1], [p[0] + 3 + sw, p[1] + 16], [p[0] - 3 + sw, p[1] + 16]], q.col); px.rect(g0, p[0] - 3 + sw, p[1] + 14, 8, 4, q.col); }\n      else if (q.kind === 2) { for (const k of [-3, 3]) px.poly(g0, [[p[0] + k - 3, p[1] + 1], [p[0] + k + 3, p[1] + 1], [p[0] + k + 3 + sw, p[1] + 19], [p[0] + k - 3 + sw, p[1] + 19]], q.col); px.rect(g0, p[0] - 6, p[1] + 1, 12, 2, E.shade(q.col, -.2)); }\n      else { px.poly(g0, [[p[0] - 11, p[1] + 1], [p[0] + 11, p[1] + 1], [p[0] + 10 + sw * 1.4, p[1] + 26], [p[0] - 10 + sw * 1.4, p[1] + 26]], '#ffffff'); px.rect(g0, p[0] + 7, p[1] + 1, 2, 24, '#e3edef'); }\n      px.rect(g0, p[0] - 1, p[1] - 3, 2, 5, '#c49c6c'); }\n    /* pegs to jump */\n    for (const p of ctx.pegs) { const q = r.w(p.x, 0, ROPE_Z); if (q[0] < -8 || q[0] > W + 8) continue; px.rect(g0, q[0] - 2, q[1] - 12, 4, 13, '#c49c6c'); px.rect(g0, q[0] - 2, q[1] - 12, 1, 13, '#e0c094'); px.rect(g0, q[0] - 3, q[1] - 6, 6, 2, '#7a8a94'); }\n    /* the hamper, where you are about to land */\n    for (const c of ctx.contestants) if (c.fallT > 0) { const q = r.w(c.wx, 0, 0); px.poly(g0, [[q[0] - 16, q[1] - 22], [q[0] + 16, q[1] - 22], [q[0] + 12, q[1]], [q[0] - 12, q[1]]], '#d9b68a'); for (let i = 0; i < 4; i++) px.rect(g0, q[0] - 14 + i * 2, q[1] - 18 + i * 5, 28 - i * 4, 1, '#a57f54'); px.rect(g0, q[0] - 17, q[1] - 24, 34, 3, '#c49c6c'); }\n    for (const c of ctx.contestants) { if (!c.local && ctx.local) continue; G.drawRig(r, c.rig, c.wx, 0, c.fallT > 0 ? Math.max(4, c.dropZ) : ROPE_Z + c.jz, { noShadow: true }); }\n    G.drawRopeGhosts && G.drawRopeGhosts(r, ctx);\n    if (ctx.sock) { const p = r.w(ctx.sock.x, 0, ctx.sock.z + Math.sin(ctx.sock.t * 9) * 5); r.overlay(g => { const a = ctx.sock.t * 7; px.rect(g, p[0] - 3, p[1] - 3, 7, 7, '#f08fb0'); px.rect(g, p[0] + Math.cos(a) * 4, p[1] + Math.sin(a) * 4, 4, 4, '#ffffff'); }); }\n    if (ctx.wind > 0) r.overlay(g => { for (let i = 0; i < 12; i++) { const y = (i * 37) % (game.H - 40) + 12, x = ((i * 91 + game.real * 300 * ctx.windDir) % (game.W + 60) + game.W + 60) % (game.W + 60) - 30, L = 14 + (i % 3) * 8; px.rect(g, x, y, L, 1, '#ffffff'); } });\n  },\n  hud(g, ctx) {\n    if (!ctx.live) return;\n    const W = game.W, H = game.H, c = ctx.local || ctx.contestants[0];\n    G.panel(g, 8, 6, 74, 20, { r: 8 }); txt(g, G.fmtTime(ctx.time + c.pen), 45, 9, '#20404c', { align: 'center', scale: 2 });\n    const pr = clamp(c.wx / ctx.end, 0, 1); G.panel(g, W - 112, 8, 104, 16, { r: 7 }); E.ui.bar(g, W - 106, 13, 92, 6, pr, '#2cc6e6', { bg: '#e8f0f2' }); for (const x of ctx.posts) px.rect(g, W - 106 + 92 * x / ctx.end, 11, 1, 10, '#5f7f8a');\n    G.drawPlate(g, c.bal, { x: W / 2, y: H - 34, r: 26, ring: [0, 0, c.bal.R], color: c.color });\n    txt(g, 'Pace', W / 2 + 40, H - 46, '#5f7f8a'); E.ui.bar(g, W / 2 + 40, H - 36, 50, 7, c.effort, c.effort > .8 ? '#ff7a59' : '#7fe0c3', { bg: '#e8f0f2' });\n    if (c.fallT > 0) txt(g, 'Please hold.', W / 2, 40, '#e0553a', { align: 'center', scale: 2, shadow: '#ffffff' });\n    if (ctx.wind > 0) { const k = Math.floor(game.real * 6) % 2; txt(g, ctx.windDir > 0 ? 'Wind →' : '← Wind', W / 2, 30, k ? '#e0553a' : '#20404c', { align: 'center', scale: 2, shadow: '#ffffff' }); }\n    G.prompts(g, [['walk', 'Walk'], ['leanx', 'Lean'], ['jump', 'Jump']]);\n  }\n});\n})();\nEOF\ngrep -n \"road.ahead\\|  ahead(\" engine/modules/road.js | head -3 | cut -c1-200; grep -n \"gamma\\|sky:\\|sun:\" engine/my-3d2dge.js | grep -i \"backdrop\" | head -3 | cut -c1-200; node tests/tools/smoke.mjs 2>&1 | tail -12 | cut -c1-200","description":"Write the hoop, jog, slalom, tray and laundry activity families","timeout":120000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2909,"cache_read_input_tokens":371073,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2909},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e35d4c2a-4185-48d4-8818-8a6b8bcd7047","uuid":"d7e861d8-89e8-446f-aa98-a24730cf34df","timestamp":"2026-11-05T05:41:24.222Z","request_id":"req_011CgjEqaRHLX3jbKxTS8q8F","wire_tool_inputs":{"toolu_01T21Td6nr8Ffz1XpuPT24Yi":{"command":"cat > game/activities/hoop.js <<'EOF'\n/* activities/hoop.js: Hoop Hips. Circle the lean to spin a hoop. A stick and a mouse circle; keys step W D S A. Too slow,\n * just right, too eager. Regulars toss more hoops from the sides: catch them left and right. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp, TAU } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst PI2 = Math.PI * 2;\nconst wrap = a => { while (a > Math.PI) a -= PI2; while (a < -Math.PI) a += PI2; return a; };\nconst BOT = { poor: { om: 7.8, jit: 1.8, react: .9, cat: .55, sd: .16 }, average: { om: 8.8, jit: 1.1, react: .6, cat: .78, sd: .1 }, good: { om: 9, jit: .55, react: .4, cat: .92, sd: .06 }, expert: { om: 9.2, jit: .2, react: .25, cat: 1, sd: .02 } };\nconst HOOP_COLS = ['#ff7a59', '#2cc6e6', '#f5c84b', '#6fcf8e', '#b08be0', '#f08fb0'];\nfunction drawHoopHalf(r, c, i, front, ctx) {\n  const n = 24, rx = (12 + (i % 2)) * ctx.size * .95, ry = rx * .36, wob = c.phase * (i % 2 ? 1 : -1), oz = (10.2 - i * .75) * ctx.size + Math.sin(c.phase + i) * 1.2;\n  const col = HOOP_COLS[i % HOOP_COLS.length], cx = Math.cos(c.phase + i * .7) * 2.4 * ctx.size;\n  r.queue(c.x, 0.1, 0, g => {\n    const p = r.w(c.x, 0, oz);\n    for (let k = 0; k < n; k++) { const a = k / n * PI2, f = Math.sin(a) > 0; if (f !== front) continue; const a2 = (k + 1) / n * PI2; px.line(g, p[0] + cx + Math.cos(a) * rx, p[1] + Math.sin(a) * ry, p[0] + cx + Math.cos(a2) * rx, p[1] + Math.sin(a2) * ry, front ? col : E.shade(col, -.25), 2); }\n  }, { bias: front ? 6 : -6 });\n}\nG.family('hoop', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const { tier } = ctx;\n    ctx.dirSign = 1; ctx.swap = tier.swap || 1; ctx.nextSwap = ctx.dur / (ctx.swap + 1); ctx.swapI = 0; ctx.tossT = tier.tossEvery; ctx.tosses = []; ctx.bestHoops = 1; ctx.bestSum = 0; ctx.other = 0;\n    ctx.throwers = ['okafor', 'marisol'].map((id, i) => ({ rig: G.regularRig(id, 1.5), x: i ? 150 : -150, id, poser: null }));\n    for (const q of ctx.throwers) q.poser = new G.Poser(q.rig);\n    for (const c of ctx.contestants) {\n      c.bal = new G.Balance({ k: 30, c: 9, s: 0, A: .4, nf: 1, R: .25 }, c.rng); c.bal.cheat = true;\n      c.hoops = 1; c.phase = 0; c.om = 0; c.th = 0; c.cum = 0; c.score = 0; c.hist = []; c.outT = 0; c.thSet = false; c.state = 'slow'; c.caught = 0; c.dropped = 0; c.inBand = 0; c.playT = 0;\n      if (ctx.contestants.length === 1) c.x = 0;\n    }\n    ctx.whirr = null;\n  },\n  preview(dt, ctx) {\n    G.stageCam(32, 8);\n    for (const c of ctx.contestants) { c.phase += dt * 3; c.rig.body = G.moves.hula(c.phase); c.rig.update(dt, { x: c.x, y: 0, z: 0, vx: 0, vy: 0, facing: 1.57, expr: 'smile' }); }\n    for (const q of ctx.throwers) { q.poser.clip('Idle_Subtle', { tgt: q.x < 0 ? .6 : 2.5, loop: true }); q.poser.update(dt); q.rig.update(dt, { x: q.x, y: -14, z: 0, vx: 0, vy: 0, facing: q.poser.facing, expr: 'smile' }); }\n  },\n  update(dt, ctx) {\n    const t = ctx.time, { tier } = ctx, d = G.DEV; G.stageCam(32, 8);\n    /* \"Other way!\" */\n    if (t >= ctx.nextSwap && ctx.swapI < ctx.swap) { ctx.swapI++; ctx.nextSwap += ctx.dur / (ctx.swap + 1); ctx.dirSign = -ctx.dirSign; ctx.other = 2.2; if (ctx.local && !ctx.quiet) { G.A.sfx('ok'); const who = G.S.instructor || 'birch'; G.mutter('okafor', 'Other way!', { auto: 2 }); } }\n    ctx.other = Math.max(0, ctx.other - dt);\n    /* a Regular tosses a hoop: catch it inside .25 s of arrival */\n    ctx.tossT -= dt;\n    if (ctx.tossT <= 0) { ctx.tossT = tier.tossEvery * (.85 + .3 * ctx.rng()); const side = ctx.rng() < .5 ? -1 : 1; ctx.tosses.push({ side, t: 0, fly: 1.1, res: {} }); if (ctx.local && !ctx.quiet) G.A.sfx('whoosh2', { vol: .6 }); }\n    for (const h of ctx.tosses) h.t += dt;\n    ctx.bestSum += dt * ctx.bestHoops;\n    /* keep the best-possible stack in step with what has been thrown */\n    const arrived = ctx.tosses.filter(h => h.t >= h.fly && !h.counted); for (const h of arrived) { h.counted = true; ctx.bestHoops = Math.min(6, ctx.bestHoops + 1); }\n    for (const c of ctx.contestants) {\n      const I = c.intent; c.playT += dt;\n      /* angular speed from the raw direction: a stick or mouse circles, keys step by quadrants */\n      const key = I.source === 'keyboard', rx = I.rawX, ry = I.rawY, mag = Math.hypot(rx, ry);\n      if (mag > .55) { const a = Math.atan2(rx, ry); if (c.thSet) { const da = wrap(a - c.th); c.cum += da; } c.th = a; c.thSet = true; }\n      const win = key ? 1.2 : .35; c.hist.push(t, c.cum); while (c.hist.length > 2 && t - c.hist[0] > win) c.hist.splice(0, 2);\n      const span = Math.max(.1, t - c.hist[0]); c.om = (c.cum - c.hist[1]) / span;\n      const scale = key ? .6 : 1, lo = (d.hoopLo + (c.hoops - 1) * tier.needMore) * scale, hi = (d.hoopHi + (c.hoops - 1) * tier.needMore) * scale, om = c.om * ctx.dirSign;\n      c.state = om < lo ? 'slow' : om > hi ? 'eager' : 'right';\n      const inBand = c.state === 'right' || ctx.other > 1.2;\n      c.bandLo = lo; c.bandHi = hi; c.omDisp = om;\n      if (inBand) { c.score += dt * c.hoops; c.inBand += dt; c.outT = 0; }\n      else if (c.playT > 2) { c.outT += dt; if (c.outT >= 1.5 && c.hoops > 1) { c.hoops--; c.dropped++; c.outT = 0; if (G.cue(ctx, c)) { G.A.sfx('drop'); if (c.input) c.input.rumble(.3, .15); } } }\n      /* catches */\n      for (const h of ctx.tosses) {\n        if (h.res[c.i]) continue;\n        const dtA = h.t - h.fly;\n        if ((h.side < 0 ? I.catchL : I.catchR) && Math.abs(dtA) <= .25) { h.res[c.i] = 'got'; if (c.hoops < 6) c.hoops++; c.caught++; if (G.cue(ctx, c)) { G.A.sfx('catch'); if (c.input) c.input.rumble(.25, .1); G.P.glints(c.x, 0, 22 * ctx.size / 2, 5, '#ffd166'); } }\n        else if (dtA > .25) { h.res[c.i] = 'miss'; }\n      }\n      c.bal.step(dt, I.x, I.y);\n      c.phase += dt * clamp(Math.abs(c.om), 2, 14) * (c.om < 0 ? -1 : 1);\n      c.rig.body = G.moves.hula(c.phase * .5);\n      c.rig.update(dt, { x: c.x, y: 0, z: 0, vx: 0, vy: 0, facing: 1.57, expr: c.state === 'right' ? 'smile' : 'wince' });\n      if (G.cue(ctx, c)) { ctx.whirr = ctx.whirr || new G.Tone({ wave: 'triangle' }); ctx.whirr.set({ freq: 180 + Math.abs(c.om) * 42, vol: Math.min(.05, Math.abs(c.om) * .006) }); }\n    }\n    ctx.tosses = ctx.tosses.filter(h => h.t < h.fly + .8);\n    for (const q of ctx.throwers) { q.poser.clip('Cheering_Two_Hands', { tgt: q.x < 0 ? .6 : 2.5, loop: true, speed: .6 }); q.poser.update(dt); q.rig.update(dt, { x: q.x, y: -14, z: 0, vx: 0, vy: 0, facing: q.poser.facing, expr: 'smile' }); }\n  },\n  stop(ctx) { if (ctx.whirr) ctx.whirr.stop(); },\n  result(ctx, c) { const pct = ctx.bestSum > 0 ? clamp(c.score / ctx.bestSum, 0, 1) : 0; return { pct, detail: 'Just right for ' + Math.round(c.inBand) + ' s. Caught ' + c.caught + '. Most hoops: ' + (c.maxH || c.hoops) + '.' }; },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent;\n    c.botTh = (c.botTh || 0) + dt * (B.om + B.jit * Math.sin(ctx.time * 1.7 + c.i * 2)) * (c.botDir || 1);\n    if (!c.botDir) c.botDir = 1; if (c.botDir !== ctx.dirSign && (c.flipIn === undefined || c.flipIn === null)) c.flipIn = B.react; if (c.flipIn != null) { c.flipIn -= dt; if (c.flipIn <= 0) { c.botDir = ctx.dirSign; c.flipIn = null; } }\n    const m = .9; I.rawX = Math.sin(c.botTh) * m; I.rawY = Math.cos(c.botTh) * m; I.x = I.rawX; I.y = I.rawY; I.source = 'bot';\n    /* catches: reach out near the arrival, a little off */\n    I.catchL = I.catchR = false;\n    for (const h of ctx.tosses) { if (h.res[c.i] || h.plan && h.plan[c.i] === 'skip') continue; h.plan = h.plan || {}; if (h.plan[c.i] === undefined) h.plan[c.i] = c.rng() < B.cat ? (c.rng() - .5) * B.sd * 2 : 'skip'; if (h.plan[c.i] === 'skip') continue; if (h.t >= h.fly + h.plan[c.i]) { if (h.side < 0) I.catchL = true; else I.catchR = true; } }\n  },\n  ghost(ctx, c) { return { ph: +c.phase.toFixed(2), h: c.hoops }; },\n  draw(r, ctx) {\n    (G.ROOMS[ctx.def.room] || G.ROOMS.pier)(r, { dusk: G.roomDusk && G.roomDusk(), festive: ctx.mode === 'games' });\n    for (const q of ctx.throwers) G.drawRig(r, q.rig, q.x, -14);\n    for (const c of ctx.contestants) {\n      G.drawMat(r, c.x, 0, 30 * (ctx.size / 2.1), 9, c.local ? '#bfeee0' : '#e8f0f2');\n      G.drawRig(r, c.rig, c.x, 0);\n      for (let i = 0; i < c.hoops; i++) { drawHoopHalf(r, c, i, false, ctx); drawHoopHalf(r, c, i, true, ctx); }\n    }\n    G.drawGhosts && G.drawGhosts(r, ctx);\n    for (const h of ctx.tosses) {\n      const k = clamp(h.t / h.fly, 0, 1.2), tgt = ctx.contestants.length === 1 ? ctx.contestants[0].x : h.side * 40, sx = h.side * 170, x = sx + (tgt - sx) * k, z = 34 + Math.sin(Math.min(k, 1) * Math.PI) * 42 - Math.max(0, k - 1) * 200;\n      r.queue(x, 2, Math.max(0, z), g => { const p = r.w(x, 2, Math.max(0, z)); const rx = 14; for (let i = 0; i < 18; i++) { const a = i / 18 * PI2 + game.real * 6; px.rect(g, p[0] + Math.cos(a) * rx, p[1] + Math.sin(a) * rx * .5, 2, 2, HOOP_COLS[(ctx.tosses.indexOf(h) + 2) % 6]); } });\n    }\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, many = ctx.contestants.length > 1;\n    if (ctx.live) G.drawTimer(g, G.left(ctx));\n    for (const c of ctx.contestants) {\n      if (c.life) continue;\n      const cx = many ? game.r.w(c.x, 0, 0)[0] : W / 2, cy = H - (many ? 12 : 16), R = many ? 22 : 40;\n      /* the big dial: too slow, just right, too eager */\n      const maxOm = c.bandHi * 1.5 || 16, ang = o => Math.PI + clamp(o / maxOm, 0, 1) * Math.PI;\n      for (let i = 0; i <= 40; i++) { const o = i / 40 * maxOm, a = ang(o), col = o < (c.bandLo || 7) ? '#ffe0b8' : o > (c.bandHi || 11) ? '#ffc0ac' : '#7fe0c3'; for (let rr = R - (many ? 5 : 8); rr <= R; rr += 2) px.rect(g, cx + Math.cos(a) * rr, cy + Math.sin(a) * rr, 2, 2, col); }\n      const a = ang(c.omDisp || 0); px.line(g, cx, cy, cx + Math.cos(a) * (R - 2), cy + Math.sin(a) * (R - 2), '#20404c', 2); px.disc(g, cx, cy, many ? 2 : 4, '#20404c');\n      const word = c.state === 'right' ? 'Just right' : c.state === 'eager' ? 'Too eager' : 'Too slow';\n      txt(g, many ? c.name : word, cx, cy - R - 12, many ? c.color : c.state === 'right' ? '#14a8c8' : '#e0553a', { align: 'center', shadow: '#ffffff', scale: 1 });\n      const hx = cx - 22; for (let i = 0; i < 6; i++) { const on = i < c.hoops; px.disc(g, hx + i * 9, cy - R - (many ? 22 : 22), 3, on ? HOOP_COLS[i] : '#d6e2e5'); }\n    }\n    if (ctx.other > 0) { const k = Math.floor(game.real * 8) % 2; G.panel(g, W / 2 - 62, 34, 124, 26, { r: 9, bg: k ? '#ffd166' : '#fbfdfd' }); txt(g, 'Other way!', W / 2, 38, '#20404c', { align: 'center', scale: 2 }); }\n    for (const h of ctx.tosses) { const dtA = h.t - h.fly, loc = ctx.local && !h.res[ctx.local.i]; if (loc && Math.abs(dtA) < .5) { const x = h.side < 0 ? W * .2 : W * .8, near = Math.abs(dtA) <= .25; G.panel(g, x - 34, H * .34, 68, 22, { r: 8, bg: near ? '#2cc6e6' : '#fbfdfd' }); txt(g, 'Catch!', x, H * .34 + 3, near ? '#ffffff' : '#20404c', { align: 'center' }); txt(g, G.keyLabel(h.side < 0 ? 'catchL' : 'catchR'), x, H * .34 + 12, near ? '#ffffff' : '#14a8c8', { align: 'center' }); } }\n    if (ctx.live && !many) G.prompts(g, [[game.input.lastDevice === 'gamepad' ? '=Left stick' : G.leanSource() === 'mouse' ? '=Circle the mouse' : '=W D S A', 'Circle']]);\n  }\n});\n})();\nEOF\ncat > game/activities/jog.js <<'EOF'\n/* activities/jog.js: Coastal Jog. Alternate left and right to set a cadence, lean to steer, stay in Marisol's zone. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game, lib = G.lib;\nconst txt = (...a) => G.txt(...a);\nconst SEG = 200, CAM_H = 900;\nlet ROAD = {};\nconst viewCache = new Map();\nconst scaleView = k => { const key = Math.max(1, Math.round(k * 8)); if (!viewCache.has(key)) viewCache.set(key, new E.View('wt' + key, 'wt', 0, 18, key / 8)); return viewCache.get(key); };\nG.scaleView = scaleView;\nfunction buildRoad(tierIdx, len) {\n  const key = tierIdx + ':' + len; if (ROAD[key]) return ROAD[key];\n  const J = G.DATA.courses.jog, road = new E.Road({ segment: SEG, lanes: 2, draw: 150, fog: null, height: CAM_H, sky: new E.Backdrop('ocean'),\n    colors: { road: ['#e6d3af', '#dcc8a2'], grass: ['#f2e6c4', '#ead9b2'], rumble: ['#fbfdfd', '#7fd8ea'], lane: '#fbfdfd' } });\n  for (const [n, o] of J.stretches) road.add(Math.round(n * len), Object.assign({}, o));\n  const PALM = E.prop('palm').frames[0], BUSH = E.prop('bush').frames[0], ROCK = E.prop('rock', { size: 2 }).frames[0];\n  const bungalow = { w: 1300, draw(g, x, y, s) { const W = 1300 * s, H = 800 * s; if (W < 3) return; px.rect(g, x - W / 2, y - H, W, H, '#fbf6ec'); px.poly(g, [[x - W * .6, y - H], [x + W * .6, y - H], [x, y - H * 1.7]], '#ff9a7a'); px.rect(g, x - W * .14, y - H * .7, W * .28, H * .7, '#c49c6c'); if (W > 10) px.rect(g, x + W * .22, y - H * .75, W * .18, H * .3, '#a8e4f2'); } };\n  const louBench = { w: 900, draw(g, x, y, s) { const W = 900 * s; if (W < 4) return; px.rect(g, x - W / 2, y - W * .34, W, W * .08, '#c49c6c'); px.rect(g, x - W * .45, y - W * .26, W * .05, W * .26, '#7a8a94'); px.rect(g, x + W * .4, y - W * .26, W * .05, W * .26, '#7a8a94'); px.ell(g, x - W * .08, y - W * .42, W * .3, W * .1, '#9aa8b0'); px.disc(g, x + W * .28, y - W * .46, W * .09, '#e8bd96'); if (W > 40) txt(g, 'z', x + W * .36, y - W * .7 - Math.sin(game.real * 2) * 4, '#5f7f8a'); } };\n  const pier = { w: 1400, draw(g, x, y, s) { const W = 1400 * s; if (W < 4) return; px.rect(g, x - W / 2, y - W * .25, W, W * .05, '#b89a72'); for (let i = 0; i < 5; i++) px.rect(g, x - W / 2 + i * W / 4 - W * .015, y - W * .25, W * .03, W * .25, '#8a6a4a'); px.rect(g, x - W * .3, y - W * .55, W * .02, W * .3, '#6a7a84'); px.rect(g, x - W * .34, y - W * .58, W * .1, W * .04, '#ffe7a8'); } };\n  const signOf = text => ({ w: 700, draw(g, x, y, s) { const W = 700 * s, H = 340 * s; if (W < 3) return; px.rect(g, x - W * .03, y - H * 2, W * .06, H * 2, '#7a8a94'); px.rect(g, x - W / 2, y - H * 2.2, W, H, '#fbfdfd'); if (W > 44) txt(g, text, x, y - H * 1.9, '#14a8c8', { align: 'center' }); } });\n  const total = road.length;\n  for (let z = 600; z < total; z += SEG * 3) { const i = z / (SEG * 3) | 0, side = i % 2 ? 1 : -1, v = (i * 7919) % 100;\n    if (i % 17 === 5) road.place(z, side * 1.9, bungalow, 1);\n    else if (i % 23 === 9) road.place(z, side * 1.6, louBench, 1);\n    else if (i % 29 === 13) road.place(z, side * 2.1, pier, 1);\n    else if (i % 31 === 21) road.place(z, side * 1.5, signOf('Gently'), 1);\n    else if (v < 45) road.place(z, side * (1.5 + v / 100), PALM, 60);\n    else if (v < 70) road.place(z, side * (1.5 + v / 150), BUSH, 40);\n    else if (v < 80) road.place(z, side * (1.7 + v / 150), ROCK, 40);\n  }\n  return (ROAD[key] = { road, ahead: road.ahead(CAM_H) });\n}\nconst BOT = { poor: { cad: 2.45, jit: .5, steer: .6, seen: 1800 }, average: { cad: 3, jit: .28, steer: 1, seen: 2600 }, good: { cad: 3, jit: .14, steer: 1.4, seen: 3400 }, expert: { cad: 3, jit: .05, steer: 2, seen: 4000 } };\nG.family('jog', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const { tier } = ctx, J = G.DATA.courses.jog, B = buildRoad(ctx.tierIdx, tier.length);\n    ctx.road = B.road; ctx.ahead = B.ahead; ctx.turn = 0; ctx.things = []; ctx.finishZ = ctx.road.length - 40 * SEG; ctx.sTotal = 0;\n    /* pigeons, joggers, cups: from the seeded stream */\n    let z = 1800; const rng = ctx.rng, cups = [];\n    while (z < ctx.finishZ - 400) { const pick = rng(), x = (rng() - .5) * 1.5;\n      if (pick < .52) cups.push({ z, x: (rng() - .5) * 1.5, kind: 'cup' });\n      else if (pick < .52 + .4 * tier.pigeons) ctx.things.push({ z, x, kind: 'pigeons', flock: 3 + Math.floor(rng() * 3), t: 0 });\n      else ctx.things.push({ z, x, kind: 'jogger', v: 0.45 + rng() * .25, col: ['#f08fb0', '#6fcf8e', '#f5c84b', '#b08be0'][Math.floor(rng() * 4)], rigK: rng() });\n      z += 1100 + rng() * 800; }\n    ctx.things.push(...cups); ctx.things.sort((a, b) => a.z - b.z); ctx.cupsTotal = cups.length;\n    ctx.rigs = {};\n    for (const c of ctx.contestants) { c.z = 0; c.xr = 0; c.cad = 0; c.lastFoot = 0; c.lastStep = -9; c.zone = 0; c.cups = 0; c.stitch = 0; c.over = 0; c.bump = 0; c.fly = []; c.bal = new G.Balance({ k: 20, c: 8, s: 0, A: .2, nf: 1, R: .3 }, c.rng); c.bal.cheat = true; c.nextFoot = -1; c.botT = 0; c.runT = 0; c.poser.clip('Run_Loop', { loop: true, fade: 0, tgt: -1.57 }); }\n  },\n  preview(dt, ctx) { const c = ctx.contestants[0]; c.poser.clip('Waiting_Loop', { loop: true, tgt: -1.57 }); c.poser.update(dt); c.rig.update(dt, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: c.poser.facing }); game.focus(0, 0, 0); ctx.pv = (ctx.pv || 0) + dt * 200; },\n  update(dt, ctx) {\n    const d = G.DEV, band = ctx.tier.band || 1, mid = (d.jogLo + d.jogHi) / 2, half = (d.jogHi - d.jogLo) / 2 * band, lo = mid - half, hi = mid + half; ctx.lo = lo; ctx.hi = hi; game.focus(0, 0, 0);\n    for (const c of ctx.contestants) {\n      const I = c.intent;\n      /* a step counts only when feet alternate */\n      if (I.paceL && c.lastFoot !== -1) { c.lastFoot = -1; G.jogStep(ctx, c); }\n      if (I.paceR && c.lastFoot !== 1) { c.lastFoot = 1; G.jogStep(ctx, c); }\n      const since = ctx.time - c.lastStep; if (since > .55) c.cad = Math.max(0, c.cad - dt * 3.2);\n      if (c.cad > 4.2) { c.over += dt; if (c.over >= 2 && c.stitch <= 0) { c.stitch = 3; c.over = 0; if (G.cue(ctx, c)) { G.A.sfx('stumble'); G.mutter('marisol', 'A stitch! That is your body saying a word. Walk it off.', { auto: 2.6 }); if (c.input) c.input.rumble(.6, .3); } } } else c.over = 0;\n      if (c.stitch > 0) c.stitch -= dt;\n      const hobble = c.stitch > 0, v = (hobble ? .35 : 1) * (c.bump > 0 ? .5 : 1) * Math.min(c.cad, 4.6) * 390 * d.jogSpeed;\n      if (!hobble && c.cad >= lo && c.cad <= hi) c.zone += dt;\n      c.runT += dt; c.z += v * dt; c.bump = Math.max(0, c.bump - dt);\n      /* steer: the road bends gently against you */\n      c.bal.step(dt, I.x, 0);\n      const pct = Math.min(1, v / 1200); c.xr += c.bal.x * dt * 1.5 * Math.min(1, pct * 2 + .1); c.xr -= ctx.road.curveAt(c.z + ctx.ahead) * pct * pct * dt * .22; c.xr = clamp(c.xr, -1.05, 1.05);\n      ctx.turn += ctx.road.curveAt(c.z) * v * dt * .004 / ctx.contestants.length;\n      /* what you meet */\n      for (const q of ctx.things) {\n        if (q.done) continue; const dz = q.z - (c.z + ctx.ahead);\n        if (dz < -400) { if (q.kind === 'jogger' && !q.passed) q.passed = true; continue; }\n        if (dz > 300) break;\n        if (q.kind === 'cup' && Math.abs(q.x - c.xr) < .24 && Math.abs(dz) < 240) { q.done = true; c.cups++; if (G.cue(ctx, c)) { G.A.sfx('cup'); } }\n        if (q.kind === 'pigeons' && !q.t && Math.abs(q.x - c.xr) < .26 && Math.abs(dz) < 240) { q.t = .01; c.bump = .7; if (G.cue(ctx, c)) { G.A.sfx('pigeon'); if (c.input) c.input.rumble(.3, .15); } }\n        if (q.kind === 'jogger' && Math.abs(q.x - c.xr) < .22 && Math.abs(dz) < 200 && c.bump <= 0) { c.bump = .8; c.xr += c.xr < q.x ? -.2 : .2; if (G.cue(ctx, c)) { G.A.sfx('thud'); } }\n      }\n      const P = c.poser, k = c.cad / 3;\n      if (hobble) P.clip('Dizzy', { loop: true, tgt: -1.57, fade: .2 }); else if (c.cad < .6) P.clip('Waiting_Loop', { loop: true, tgt: -1.57, fade: .2 }); else P.clip('Run_Loop', { loop: true, tgt: -1.57, fade: .2 });\n      if (P.cur) P.cur.speed = clamp(k, .3, 1.8);\n      P.update(dt); c.rig.wob = [c.bal.x * .35, 0]; c.rig.update(dt, { x: 0, y: 0, z: 0, vx: 0, vy: 0, facing: P.facing, expr: hobble ? 'wince' : 'smile' });\n      if (c.z >= ctx.finishZ - ctx.ahead) { c.fin = true; }\n    }\n    for (const q of ctx.things) { if (q.kind === 'jogger') q.z += 1170 * q.v * dt; if (q.kind === 'pigeons' && q.t) q.t += dt; }\n    if (ctx.contestants.every(c => c.fin)) ctx.finished = true;\n    if (ctx.local) { const me = ctx.local; ctx.pz = me.z; ctx.px = me.xr; } else { ctx.pz = ctx.contestants[0].z; ctx.px = ctx.contestants[0].xr; }\n  },\n  result(ctx, c) { const zone = c.runT > 0 ? c.zone / c.runT : 0, cup = ctx.cupsTotal ? c.cups / ctx.cupsTotal : 0, progress = clamp((c.z + ctx.ahead) / ctx.finishZ, 0, 1); return { pct: (.7 * zone + .3 * cup) * (ctx.durGiven ? 1 : Math.min(1, progress * 1.1)), detail: 'In the zone ' + Math.round(zone * 100) + '%. Water ' + c.cups + ' of ' + ctx.cupsTotal + '.' }; },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent; c.botT -= dt; I.paceL = I.paceR = false;\n    if (c.botT <= 0) { const cad = B.cad + B.jit * Math.sin(ctx.time * .6 + c.i); c.botT = 1 / cad; c.nextFoot = -c.nextFoot; if (c.nextFoot < 0) I.paceL = true; else I.paceR = true; }\n    /* look ahead: go for the next cup, away from the next thing in the way */\n    let want = 0, avoid = 0; const zz = c.z + ctx.ahead;\n    for (const q of ctx.things) { if (q.done || q.t) continue; const dz = q.z - zz; if (dz < 100) continue; if (dz > B.seen) break; if (q.kind === 'cup') { if (!want) want = q.x; } else if (Math.abs(q.x - c.xr) < .34) avoid = (c.xr >= q.x ? 1 : -1) * .8; }\n    const tx = avoid ? c.xr + avoid : (want || 0); I.x = clamp((tx - c.xr) * 1.6 * B.steer, -1, 1); I.y = 0;\n  },\n  ghost(ctx, c) { return { z: Math.round(c.z), x: +c.xr.toFixed(2), c: +c.cad.toFixed(1) }; },\n  draw(r, ctx) {\n    const pz = ctx.live || ctx.pz ? (ctx.pz || 0) : (ctx.pv || 0), px0 = ctx.px || 0, W = r.W, H = r.H;\n    const cars = [];\n    for (const q of ctx.things) { if (q.done) continue; const dz = q.z - pz; if (dz < 0 || dz > 26000) continue; cars.push(Object.assign(q, { w: q.kind === 'cup' ? 200 : q.kind === 'jogger' ? 300 : 500, draw: q.drawFn || (q.drawFn = G.jogThing(q)) })); }\n    const ghosts = G.jogGhosts ? G.jogGhosts(ctx) : []; for (const gh of ghosts) cars.push(gh);\n    ctx.road.draw(r, { z: pz, x: px0, h: CAM_H, turn: ctx.turn, cars });\n    r.overlay(g => {\n      for (const c of ctx.contestants) {\n        if (!c.local && ctx.local) continue;\n        const p = ctx.road.project(c.z + ctx.ahead, c.xr, 0); if (!p) continue; const sx = p[0], sy = p[1], k = Math.max(1, H / 150) * .8, v = scaleView(k * 1.4);\n        px.ell(g, sx, sy, 14 * k, 4 * k, '#20404c44');\n        c.rig.draw(g, Math.round(sx), Math.round(sy), v);\n      }\n    });\n  },\n  hud(g, ctx) {\n    if (!ctx.live) return;\n    const W = game.W, H = game.H, c = ctx.local || ctx.contestants[0];\n    G.drawTimer(g, G.left(ctx), { x: 36 });\n    /* the calm gauge: Marisol's pacing zone */\n    const gx = W / 2 - 80, gy = H - 34, gw = 160, mx = 5.2, xOf = v => gx + clamp(v / mx, 0, 1) * gw;\n    G.panel(g, gx - 8, gy - 16, gw + 16, 36, { r: 8 });\n    px.rect(g, gx, gy, gw, 8, '#e8f0f2'); px.rect(g, xOf(ctx.lo), gy, xOf(ctx.hi) - xOf(ctx.lo), 8, '#7fe0c3'); px.rect(g, xOf(4.2), gy, gx + gw - xOf(4.2), 8, '#ffc0ac');\n    const n = xOf(c.cad); px.rect(g, n - 1, gy - 3, 3, 14, '#20404c'); px.disc(g, n, gy - 4, 3, c.color || '#ff7a59');\n    const word = c.stitch > 0 ? 'A stitch' : c.cad < ctx.lo ? (c.cad < .6 ? 'Standing' : 'A little faster') : c.cad > 4.2 ? 'Far too fast' : c.cad > ctx.hi ? 'Slow down' : \"Marisol's pace\";\n    txt(g, word, W / 2, gy - 13, c.cad >= ctx.lo && c.cad <= ctx.hi ? '#14a8c8' : '#e0553a', { align: 'center' });\n    txt(g, c.cad.toFixed(1) + ' steps a second', W / 2, gy + 10, '#5f7f8a', { align: 'center' });\n    /* progress and water */\n    G.panel(g, W - 92, 8, 84, 28, { r: 7 }); txt(g, 'Water ' + c.cups + ' / ' + ctx.cupsTotal, W - 50, 11, '#14a8c8', { align: 'center' });\n    const pr = clamp((c.z + ctx.ahead) / ctx.finishZ, 0, 1); E.ui.bar(g, W - 86, 23, 72, 6, pr, '#2cc6e6', { bg: '#e8f0f2' });\n    G.prompts(g, [['paceL', 'Left'], ['paceR', 'Right']]);\n  }\n});\nG.jogStep = (ctx, c) => {\n  const now = ctx.time, iv = now - c.lastStep; c.lastStep = now;\n  if (iv > 0 && iv < 2) { const inst = 1 / iv; c.cad = c.cad <= 0 ? inst * .7 : c.cad + (inst - c.cad) * .32; } else c.cad = Math.max(c.cad, 1);\n  if (G.cue(ctx, c)) G.A.sfx('click', { vol: .4 });\n};\nG.jogThing = q => {\n  if (q.kind === 'cup') return (g, x, y, s) => { const W = 200 * s; if (W < 2) return; const h = W * 1.3; px.rect(g, x - W * .8, y - W * 2.4, W * 1.6, W * .2, '#c49c6c'); px.rect(g, x - W * .08, y - W * 2.4, W * .16, W * 2.4, '#a57f54'); px.poly(g, [[x - W * .34, y - W * 2.4 - h * .8], [x + W * .34, y - W * 2.4 - h * .8], [x + W * .24, y - W * 2.4], [x - W * .24, y - W * 2.4]], '#a8e4f2'); px.rect(g, x - W * .34, y - W * 2.4 - h * .8, W * .68, Math.max(1, W * .1), '#ffffff'); };\n  if (q.kind === 'pigeons') { const birds = []; for (let i = 0; i < q.flock; i++) birds.push({ a: i * 2.4, r: (i % 3) * 90 + 50 }); return (g, x, y, s) => { const W = 120 * s; if (W < 1) return; const up = q.t ? q.t * 1800 * s : 0; for (const b of birds) { const bx = x + Math.cos(b.a) * b.r * s + (q.t ? Math.cos(b.a) * q.t * 900 * s : 0), by = y - up - (q.t ? Math.sin(b.a) * 300 * s * q.t : 0) - W * .3; px.ell(g, bx, by, W * .6, W * .42, '#9aa8b0'); px.disc(g, bx + W * .5, by - W * .4, Math.max(1, W * .22), '#6a7a84'); if (q.t) { const f = Math.sin(game.real * 30 + b.a) * W; px.line(g, bx - W, by - f, bx, by, '#c6d0d6'); px.line(g, bx + W, by - f, bx, by, '#c6d0d6'); } else px.rect(g, bx - W * .1, by + W * .35, Math.max(1, W * .1), W * .4, '#ff9a7a'); } }; }\n  return (g, x, y, s) => { const W = 300 * s; if (W < 2) return; const b = Math.abs(Math.sin(game.real * 9 + q.rigK * 6)) * W * .2, h = W * 3; px.ell(g, x, y, W * .8, W * .22, '#20404c33'); px.rect(g, x - W * .28, y - h * .42 - b, W * .2, h * .42, '#3b5568'); px.rect(g, x + W * .08, y - h * .42 + b * .4, W * .2, h * .42, '#3b5568'); px.rect(g, x - W * .42, y - h * .82 - b * .5, W * .84, h * .42, q.col); px.disc(g, x, y - h * .94 - b * .5, W * .32, '#e8bd96'); px.rect(g, x - W * .32, y - h - b * .5, W * .64, W * .18, '#5a3a24'); };\n};\n})();\nEOF\ncat > game/activities/slalom.js <<'EOF'\n/* activities/slalom.js: Mount Posture Slalom, on Mode 7. Lean steers, forward tucks, back brakes. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst SNOW = (x, y) => { const n = Math.sin(x * .071) * Math.sin(y * .053) + .6 * Math.sin((x + y) * .019) + .3 * Math.sin(x * .3 + y * .17); const v = 240 + n * 4; return [v - 7, v - 1, Math.min(255, v + 8)]; };\nconst m7 = new E.Mode7({ floor: SNOW, size: [1024, 1024], wrap: true, far: 1500, sky: new E.Backdrop({ sky: ['#8fd3f4', '#d8f3fb', '#f4fbfd'], sun: { x: .75, y: .22, r: 12, color: '#fff6d8' }, layers: [{ kind: 'mountains', color: '#c6dcea', y: .78, height: .3, parallax: .02 }, { kind: 'mountains', color: '#e6f1f7', y: .86, height: .2, parallax: .05 }, { kind: 'hills', color: '#a8c8c0', y: .96, height: .08, parallax: .09 }] }) });\nG.m7 = m7;\nconst PINE = E.prop('pine').frames[0];\nconst HEADING = -Math.PI / 2;\nconst BOT = { poor: { look: 240, gain: 1.1, noise: .34, tuck: .1, avoid: .4 }, average: { look: 300, gain: 1.5, noise: .16, tuck: .35, avoid: .8 }, good: { look: 340, gain: 1.9, noise: .07, tuck: .7, avoid: 1 }, expert: { look: 380, gain: 2.3, noise: .02, tuck: 1, avoid: 1.2 } };\nconst drawGatePole = (g, sx, sy, k, col, side, next) => { const h = 34 * k; px.rect(g, sx - Math.max(.5, k * .6), sy - h, Math.max(1, k * 1.2), h, '#5a6a74'); const fw = 13 * k, fh = 9 * k; px.poly(g, [[sx, sy - h], [sx + side * fw, sy - h + fh * .5], [sx, sy - h + fh]], col); if (next) px.disc(g, sx, sy - h - 2 * k, Math.max(1, k * 1.6), '#ffd166'); };\nconst drawSnowman = (g, sx, sy, k) => { px.ell(g, sx, sy - 7 * k, 8 * k, 7 * k, '#ffffff'); px.ell(g, sx + k, sy - 6 * k, 7 * k, 6 * k, '#e3edf2'); px.disc(g, sx, sy - 18 * k, 5.5 * k, '#ffffff'); px.disc(g, sx, sy - 27 * k, 4 * k, '#ffffff'); if (k > .5) { px.rect(g, sx - 3 * k, sy - 35 * k, 6 * k, 4 * k, '#20404c'); px.rect(g, sx - 4.5 * k, sy - 31.5 * k, 9 * k, k, '#20404c'); px.dot(g, sx - 1.4 * k, sy - 28 * k, '#20404c'); px.dot(g, sx + 1.4 * k, sy - 28 * k, '#20404c'); px.poly(g, [[sx, sy - 27 * k], [sx + 4 * k, sy - 26 * k], [sx, sy - 25.5 * k]], '#ff9a3a'); px.rect(g, sx - 5 * k, sy - 23.5 * k, 10 * k, 1.4 * k, '#ff7a59'); } };\nG.family('slalom', {\n  camera: { zoom: false },\n  setup(ctx) {\n    const co = G.DATA.courses.slalom[ctx.tier.course], n = co.gates.length;\n    const base = G.DEV.skiSpeed;\n    let use = n; if (ctx.durGiven) use = Math.max(4, Math.min(n, Math.floor(ctx.durGiven * base / co.spacing) - 1));\n    ctx.course = co; ctx.gates = co.gates.slice(0, use).map((x, i) => ({ x, y: -(i + 1) * co.spacing, state: null, col: i % 2 ? '#2c7fe6' : '#e0553a', i }));\n    ctx.obstacles = co.obstacles.filter(o => o[1] < use).map(o => ({ x: o[0], y: -(o[1] + 1) * co.spacing - co.spacing * .5, kind: o[2] }));\n    ctx.side = []; for (let i = -2; i < use + 4; i++) for (const s of [-1, 1]) ctx.side.push({ x: s * (240 + ((i * 53 + (s + 1) * 37) % 70)), y: -i * co.spacing * .34 * 3 });\n    ctx.finishY = -(use + 1) * co.spacing; ctx.nextGate = 0; ctx.scale = use / n; ctx.par = co.par * ctx.scale; ctx.worst = co.worst * ctx.scale; ctx.snow = [];\n    for (let i = 0; i < 90; i++) ctx.snow.push({ x: G.cosmetic(), y: G.cosmetic(), s: .3 + G.cosmetic() * .9 });\n    for (const c of ctx.contestants) { c.sx = 0; c.sy = 0; c.v = 0; c.bal = new G.Balance({ k: 14, c: 7, s: 0, A: .9, nf: 1, R: .3 }, c.rng); c.bal.cheat = true; c.tumble = 0; c.miss = 0; c.passed = 0; c.hits = 0; c.pen = 0; c.fin = 0; c.state = ''; c.stateT = 0; c.yaw = 0; c.trail = []; c.carve = null; }\n    ctx.camY = 0; ctx.camX = 0;\n  },\n  preview(dt, ctx) { const c = ctx.contestants[0]; c.rig.update(dt, { x: c.sx, y: c.sy, z: 0, vx: 0, vy: 0, facing: HEADING, pose: 'crouch', expr: 'smile' }); game.focus(0, 0, 0); ctx.camY = 0; ctx.camX = 0; },\n  update(dt, ctx) {\n    const d = G.DEV; game.focus(0, 0, 0);\n    for (const c of ctx.contestants) {\n      const I = c.intent, b = c.bal; b.step(dt, I.x, I.y);\n      if (c.fin) { c.v = Math.max(0, c.v - 300 * dt); c.sy -= c.v * dt; continue; }\n      if (c.tumble > 0) {\n        c.tumble -= dt; c.v = Math.max(0, c.v - 400 * dt); c.sy -= c.v * dt;\n      } else {\n        const want = d.skiSpeed * (b.y > .3 ? 1.35 : b.y < -.3 ? .6 : 1);\n        c.v += (want - c.v) * Math.min(1, dt * 1.6);\n        c.sx += b.x * 210 * d.skiTurn * dt; c.sx = clamp(c.sx, -220, 220); c.sy -= c.v * dt;\n      }\n      c.stateT = Math.max(0, c.stateT - dt);\n      /* gates: cross the line between the poles */\n      const G0 = ctx.gates[c.nextGate === undefined ? (c.nextGate = 0) : c.nextGate];\n      if (G0 && c.sy <= G0.y) {\n        const hw = ctx.course.gateWidth / 2 * (G.gentle() ? 1.25 : 1);\n        if (Math.abs(c.sx - G0.x) <= hw) { c.passed++; c.state = 'Gate'; c.stateT = .7; if (G.cue(ctx, c)) { G.A.sfx('hit'); } }\n        else { c.miss++; c.pen += 3; c.state = 'Missed. +3 s'; c.stateT = 1.1; if (G.cue(ctx, c)) { G.A.sfx('miss'); if (c.input) c.input.rumble(.25, .12); } }\n        c.nextGate++;\n      }\n      /* snowmen and pines: a tumble */\n      if (c.tumble <= 0 && !ctx.cheat) for (const o of ctx.obstacles) { if (Math.abs(c.sy - o.y) < 12 && Math.abs(c.sx - o.x) < (o.kind === 'pine' ? 13 : 11)) { c.tumble = 1.2; c.hits++; c.v *= .35; if (G.cue(ctx, c)) { G.A.sfx('stumble'); game.shake(.2); if (c.input) c.input.rumble(.8, .3); G.mutter('tare', G.line('tare.fall')); } break; } }\n      if (c.sy <= ctx.finishY) { c.fin = ctx.time; if (ctx.contestants.every(q => q.fin)) ctx.finishT = ctx.finishT || ctx.time; }\n      /* the body */\n      c.yaw += (b.x * .3 - c.yaw) * Math.min(1, dt * 6);\n      const pose = c.tumble > 0 ? 'down' : 'crouch';\n      c.rig.wob = [b.x * .6, b.y * .3]; c.rig.update(dt, { x: c.sx, y: c.sy, z: 0, vx: 0, vy: 0, facing: HEADING + c.yaw, pose: c.tumble > 0 ? undefined : 'crouch', down: c.tumble > 0 ? .8 : 0, expr: c.tumble > 0 ? 'wince' : 'smile' });\n      if (G.cue(ctx, c)) { c.carve = c.carve || new G.Tone({ wave: 'triangle' }); c.carve.set({ freq: 110 + Math.abs(b.x) * 240 + c.v * .15, vol: .012 + Math.abs(b.x) * .035, pan: b.x }); }\n      if (Math.floor(ctx.time * 16) !== Math.floor((ctx.time - dt) * 16)) { c.trail.push(c.sx, c.sy); if (c.trail.length > 140) c.trail.splice(0, 2); }\n    }\n    if (ctx.finishT && ctx.time > ctx.finishT + .9) ctx.finished = true;\n    const me = ctx.local || ctx.contestants[0];\n    ctx.camX += (me.sx - ctx.camX) * Math.min(1, dt * 6); ctx.camY = me.sy;\n    for (const s of ctx.snow) { s.y = (s.y + dt * (.18 + s.s * .2)) % 1; s.x = (s.x + dt * (-.02 + me.bal.x * -.08)) % 1; if (s.x < 0) s.x += 1; }\n  },\n  stop(ctx) { for (const c of ctx.contestants) if (c.carve) c.carve.stop(); },\n  result(ctx, c) {\n    const t = (c.fin || ctx.time) + c.pen + (c.fin ? 0 : 30), pct = clamp((ctx.worst - t) / (ctx.worst - ctx.par), 0, 1), L = G.DATA.lines.slalomTimes, peer = L[Math.floor(G.cosmetic() * L.length) % L.length];\n    return { pct, detail: 'Your time ' + G.fmtTime(t) + '. Gates ' + c.passed + ' of ' + ctx.gates.length + '. ' + peer[0] + ' ' + G.fmtTime(peer[1]) + '. ' + peer[2], time: t };\n  },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent, G0 = ctx.gates[c.nextGate || 0] || { x: 0, y: c.sy - 500 };\n    c.nz = c.nz || G.noise(c.rng, 1.3);\n    let tx = G0.x, ok = Math.abs(c.sy - G0.y) < B.look * 2.2;\n    for (const o of ctx.obstacles) { const dy = c.sy - o.y; if (dy > 0 && dy < 180 && Math.abs(o.x - c.sx) < 34 * B.avoid) tx = c.sx + (c.sx >= o.x ? 1 : -1) * 60; }\n    const need = (tx - c.sx) / 90; I.x = clamp(need * B.gain + B.noise * c.nz(ctx.time), -1, 1);\n    I.y = Math.abs(tx - c.sx) < 26 ? B.tuck : 0;\n  },\n  ghost(ctx, c) { return { x: Math.round(c.sx), y: Math.round(c.sy), w: [+c.bal.x.toFixed(2), +c.bal.y.toFixed(2)] }; },\n  draw(r, ctx) {\n    const me = ctx.local || ctx.contestants[0], cam = m7.chase({ x: ctx.camX + (me.sx - ctx.camX) * .5, y: ctx.camY }, { back: 72, h: 42, angle: HEADING + me.yaw * .25 }); cam.pitch = 15; cam.fov = 70;\n    if (ctx.course.fog) m7.o.fog = ctx.course.fog; else delete m7.o.fog;\n    const vis = o => o.y < cam.y && o.y > cam.y - 1500;\n    for (let i = 0; i < me.trail.length; i += 2) { const x = me.trail[i], y = me.trail[i + 1]; if (y > cam.y) continue; m7.add(x, y, 0, (g, sx, sy, k) => { px.rect(g, sx - 3 * k, sy, Math.max(1, k), 1, '#c9dce8'); px.rect(g, sx + 2 * k, sy, Math.max(1, k), 1, '#c9dce8'); }); }\n    for (const s of ctx.side) if (vis(s)) m7.sprite(PINE, s.x, s.y, 0, { scale: 1.7 });\n    for (const o of ctx.obstacles) if (vis(o)) { if (o.kind === 'pine') m7.sprite(PINE, o.x, o.y, 0, { scale: 1.5 }); else m7.add(o.x, o.y, 0, (g, sx, sy, k) => drawSnowman(g, sx, sy, k * .85)); }\n    const hw = ctx.course.gateWidth / 2;\n    ctx.gates.forEach(G0 => { if (!vis(G0)) return; const next = G0.i === (me.nextGate || 0); m7.add(G0.x - hw, G0.y, 0, (g, sx, sy, k) => drawGatePole(g, sx, sy, k * .85, G0.col, -1, next)); m7.add(G0.x + hw, G0.y, 0, (g, sx, sy, k) => drawGatePole(g, sx, sy, k * .85, G0.col, 1, next)); });\n    if (vis({ y: ctx.finishY })) m7.add(0, ctx.finishY, 0, (g, sx, sy, k) => { const w = 90 * k, h = 44 * k; for (const q of [-1, 1]) px.rect(g, sx + q * w - k, sy - h, 2 * k, h, '#5a6a74'); px.rect(g, sx - w, sy - h, 2 * w, 11 * k, '#fbfdfd'); for (let i = 0; i < 12; i++) if (i % 2) px.rect(g, sx - w + i * w / 6, sy - h, w / 6, 5.5 * k, '#20404c'); else px.rect(g, sx - w + i * w / 6, sy - h + 5.5 * k, w / 6, 5.5 * k, '#20404c'); });\n    G.drawSkiGhosts && G.drawSkiGhosts(ctx);\n    for (const c of ctx.contestants) { if (!c.local && ctx.local) continue; m7.add(c.sx, c.sy, 0, (g, sx, sy, k) => { px.ell(g, sx, sy + k, 11 * k, 3 * k, '#a8c0d0'); px.rect(g, sx - 6 * k, sy - 1, 2 * k, 2, '#ff7a59'); px.rect(g, sx + 4 * k, sy - 1, 2 * k, 2, '#ff7a59'); const v = m7.view(k * .92); c.rig.draw(g, Math.round(sx), Math.round(sy), v); }); }\n    m7.draw(r, cam);\n    r.overlay(g => { for (const s of ctx.snow) px.rect(g, s.x * game.W, s.y * game.H, s.s > .8 ? 2 : 1, s.s > .8 ? 2 : 1, '#ffffff'); });\n  },\n  hud(g, ctx) {\n    if (!ctx.live) return;\n    const W = game.W, H = game.H, c = ctx.local || ctx.contestants[0];\n    G.panel(g, 8, 6, 74, 20, { r: 8 }); txt(g, G.fmtTime((c.fin || ctx.time) + c.pen), 45, 9, '#20404c', { align: 'center', scale: 2 });\n    G.panel(g, W - 92, 8, 84, 16, { r: 7 }); txt(g, 'Gate ' + Math.min((c.nextGate || 0) + 1, ctx.gates.length) + ' / ' + ctx.gates.length, W - 50, 12, '#14a8c8', { align: 'center' });\n    G.drawPlate(g, c.bal, { x: W / 2, y: H - 28, r: 22, ring: null, color: c.color });\n    if (c.bal.y > .3) txt(g, 'Tuck', W / 2, H - 62, '#14a8c8', { align: 'center', shadow: '#ffffff' }); else if (c.bal.y < -.3) txt(g, 'Braking', W / 2, H - 62, '#e0553a', { align: 'center', shadow: '#ffffff' });\n    if (c.stateT > 0) txt(g, c.state, W / 2, 34, c.state === 'Gate' ? '#14a8c8' : '#e0553a', { align: 'center', scale: 2, shadow: '#ffffff' });\n    if (c.tumble > 0) txt(g, 'Tumble', W / 2, 52, '#e0553a', { align: 'center', scale: 2, shadow: '#ffffff' });\n    G.prompts(g, [['lean', 'Lean. Forward tucks. Back brakes.']]);\n  }\n});\n})();\nEOF\ncat > game/activities/tray.js <<'EOF'\n/* activities/tray.js: Tray Service. Lean tilts a tea tray; olives roll; glasses are sensors. Layouts are text in data/trays.js. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nE.VIEWS.tray = E.VIEWS.tray || new E.View('tray', 'Tray', 0, 55, 1.25, 1);\nconst CELL = 16;\nconst BOT = { poor: { gain: .55, damp: .3, noise: .3 }, average: { gain: .85, damp: .45, noise: .12 }, good: { gain: 1.1, damp: .6, noise: .05 }, expert: { gain: 1.4, damp: .7, noise: .01 } };\nfunction load(ctx, c, i) {\n  const list = G.DATA[ctx.tier.trays], layout = list[i], rows = layout.rows, H = rows.length * CELL, W = rows[0].length * CELL, x0 = -W / 2, y0 = -H / 2;\n  const fr = (ctx.tier.friction || 0) + G.DEV.trayF;\n  const world = new E.Physics({ gravity: [0, 0], sleep: false, substeps: 4, on: {\n    enter(sensor, body) {\n      if (!body.data || body.data.kind !== 'olive' || body.off) return;\n      if (sensor.data && sensor.data.kind === 'glass') { body.off = true; c.world.remove(body); sensor.data.n++; c.inGlass++; c.olives = c.olives.filter(o => o !== body); if (G.cue(ctx, c)) { G.A.sfx('plop'); G.P.glints(sensor.x, sensor.y, 8, 4, '#bff3e2'); if (c.input) c.input.rumble(.25, .1); } }\n      if (sensor.data && sensor.data.kind === 'gap') { body.data.fall = .7; body.vx = body.vy = 0; if (G.cue(ctx, c)) G.A.sfx('drop'); }\n    },\n    hit(a, b, info) { if (G.cue(ctx, c)) { const ol = (a.data && a.data.kind === 'olive') || (b.data && b.data.kind === 'olive'); if (ol && Math.hypot(a.vx - b.vx, a.vy - b.vy) > 40) { c.clinkT = c.clinkT || 0; if (c.clinkT <= 0) { G.A.sfx('trayClink', { vol: .6 }); c.clinkT = .1; } } } }\n  } });\n  world.chain([[x0, y0], [x0 + W, y0], [x0 + W, y0 + H], [x0, y0 + H]], { closed: true, r: 1, bounce: .35, friction: .1 });\n  c.world = world; c.olives = []; c.glasses = []; c.bumpers = []; c.blocks = []; c.gaps = []; c.gecko = null; c.W = W; c.H = H; c.inGlass = c.inGlass || 0;\n  rows.forEach((row, ry) => { [...row].forEach((ch, rx) => {\n    const x = x0 + (rx + .5) * CELL, y = y0 + (ry + .5) * CELL;\n    if (ch === 'o') { const b = world.circle(x, y, 5, { bounce: .35, friction: .1, damping: fr, data: { kind: 'olive', sx: x, sy: y, fall: 0 } }); c.olives.push(b); }\n    else if (ch === 'G') { const s = world.add({ shape: 'circle', type: 'static', x, y, r: 6.5, sensor: true, data: { kind: 'glass', n: 0 } }); c.glasses.push(s); }\n    else if (ch === 'B') { c.bumpers.push(world.bumper(x, y, 7, { kick: 110 })); }\n    else if (ch === '#') { c.blocks.push(world.box(x, y, CELL, CELL, { type: 'static', bounce: .3 })); }\n    else if (ch === '~') { const s = world.add({ shape: 'circle', type: 'static', x, y, r: 6, sensor: true, data: { kind: 'gap' } }); c.gaps.push(s); }\n    else if (ch === 'K') { c.gecko = world.circle(x, y, 7, { type: 'kinematic', data: { kind: 'gecko' }, bounce: .5 }); c.geckoT = 0; c.geckoP = [[x, y], [x + 70, y - 8], [x + 30, y - 40], [x - 10, y - 16]]; c.geckoI = 0; }\n  }); });\n  c.trayI = i; c.nextT = 0; c.total = c.total || list.reduce((n, L) => n + L.rows.join('').split('o').length - 1, 0);\n}\nG.family('tray', {\n  camera: { zoom: false },\n  setup(ctx) {\n    ctx.dur = ctx.durGiven || ctx.tier.dur || 60;\n    for (const c of ctx.contestants) { c.bal = new G.Balance(ctx.tier.set, c.rng); c.bal.cheat = true; c.inGlass = 0; c.finT = 0; load(ctx, c, 0); }\n    ctx.dennis = G.regularRig('dennis', 1.7); ctx.dennisPoser = new G.Poser(ctx.dennis);\n  },\n  preview(dt, ctx) { game.focus(0, 8, 0); ctx.dennisPoser.clip('Idle_Subtle', { loop: true, tgt: 1 }); ctx.dennisPoser.update(dt); ctx.dennis.update(dt, { x: -180, y: -40, z: 0, vx: 0, vy: 0, facing: ctx.dennisPoser.facing }); for (const c of ctx.contestants) c.world.step(dt); },\n  update(dt, ctx) {\n    game.focus(0, 8, 0);\n    for (const c of ctx.contestants) {\n      if (c.finT) continue;\n      const b = c.bal, I = c.intent; b.step(dt, I.x, I.y);\n      c.world.gravity = [b.x * G.DEV.trayG, -b.y * G.DEV.trayG];\n      /* the gecko walks, slowly, for reasons of its own */\n      if (c.gecko) { const P = c.geckoP[c.geckoI]; if (Math.hypot(c.gecko.x - P[0], c.gecko.y - P[1]) < 3) c.geckoI = (c.geckoI + 1) % c.geckoP.length; c.gecko.moveTo(P[0], P[1], 0, 22, 0); }\n      c.world.wake(); c.world.step(dt); c.clinkT = Math.max(0, (c.clinkT || 0) - dt);\n      for (const o of c.olives) { const D = o.data; if (D.fall > 0) { D.fall -= dt; o.vx = o.vy = 0; if (D.fall <= 0) { o.x = D.sx; o.y = D.sy; o.vx = o.vy = 0; } } }\n      if (!c.olives.length) {\n        c.nextT += dt;\n        if (c.nextT > .8) { const list = G.DATA[ctx.tier.trays]; if (c.trayI + 1 < list.length) { load(ctx, c, c.trayI + 1); if (G.cue(ctx, c)) G.A.sfx('ok'); } else { c.finT = ctx.time; if (ctx.contestants.every(q => q.finT)) ctx.finished = true; } }\n      }\n    }\n    ctx.dennisPoser.clip('Waiting_Loop', { loop: true, tgt: 1 }); ctx.dennisPoser.update(dt); ctx.dennis.update(dt, { x: -180, y: -40, z: 0, vx: 0, vy: 0, facing: ctx.dennisPoser.facing });\n  },\n  result(ctx, c) { const t = c.finT || ctx.dur, left = clamp(1 - t / ctx.dur, 0, 1), pct = c.inGlass / c.total * (.8 + .2 * left); return { pct, detail: 'Olives in glasses: ' + c.inGlass + ' of ' + c.total + '. Dennis nods slowly.' }; },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent; c.nz = c.nz || G.noise(c.rng, 1.7);\n    /* the olive nearest a glass, toward that glass; round a gap or a block by leaning past it */\n    let best = null, bd = 1e9, bg = null;\n    for (const o of c.olives) { if (o.data.fall > 0) continue; for (const s of c.glasses) { const d = Math.hypot(o.x - s.x, o.y - s.y); if (d < bd) { bd = d; best = o; bg = s; } } }\n    if (!best) { I.x = 0; I.y = 0; return; }\n    let dx = bg.x - best.x, dy = bg.y - best.y;\n    for (const h of c.gaps.concat(c.blocks)) { const ax = h.x - best.x, ay = h.y - best.y, along = (ax * dx + ay * dy) / Math.max(1, dx * dx + dy * dy); if (along > 0 && along < 1) { const px0 = best.x + dx * along, py0 = best.y + dy * along, off = Math.hypot(px0 - h.x, py0 - h.y); if (off < 22) { const nx = (py0 - h.y) || .01, sgn = py0 >= h.y ? 1 : -1; dy += sgn * 40; } } }\n    const D = Math.max(20, Math.hypot(dx, dy)), ux = dx / D * B.gain - best.vx * B.damp * .012 + B.noise * c.nz(ctx.time), uy = dy / D * B.gain - best.vy * B.damp * .012 + B.noise * c.nz(ctx.time + 3);\n    I.x = clamp(ux, -1, 1); I.y = clamp(-uy, -1, 1);\n  },\n  draw(r, ctx) {\n    const g0 = r.ctx, W = r.W + 2, H = r.H + 2;\n    /* the bar's counter */\n    G.bands(g0, 0, 0, W, H, '#e8cfa8', '#c9a97c', 10);\n    for (let i = 0; i < 7; i++) px.rect(g0, 0, Math.floor(i * H / 7), W, 1, '#b8976a');\n    G.fern(g0, W * .93, H * .3, 1.4); \n    const c = ctx.local || ctx.contestants[0], b = c.bal, T = 9;\n    const tz = (x, y) => -(x / (c.W / 2)) * b.x * T + (y / (c.H / 2)) * b.y * T + 8;\n    const corners = [[-c.W / 2 - 7, -c.H / 2 - 7], [c.W / 2 + 7, -c.H / 2 - 7], [c.W / 2 + 7, c.H / 2 + 7], [-c.W / 2 - 7, c.H / 2 + 7]].map(p => r.w(p[0], p[1], tz(p[0], p[1])));\n    const low = [[-c.W / 2 - 7, c.H / 2 + 7], [c.W / 2 + 7, c.H / 2 + 7]].map(p => r.w(p[0], p[1], tz(p[0], p[1]) - 5));\n    // the tray: its shadow, rim and face\n    px.polyDither(g0, corners.map(p => [p[0] + 3, p[1] + 9]), '#7a5a3a', .35, r.ix, r.iy);\n    px.poly(g0, [corners[3], corners[2], low[1], low[0]].map(p => [p[0], p[1]]), '#9fb5bc');\n    px.poly(g0, corners.map(p => [p[0], p[1]]), '#dfe9ea');\n    const face = [[-c.W / 2, -c.H / 2], [c.W / 2, -c.H / 2], [c.W / 2, c.H / 2], [-c.W / 2, c.H / 2]].map(p => r.w(p[0], p[1], tz(p[0], p[1])));\n    px.poly(g0, face.map(p => [p[0], p[1]]), '#f6fafa');\n    for (let i = 1; i < 6; i++) { const y = -c.H / 2 + i * c.H / 6, a = r.w(-c.W / 2, y, tz(-c.W / 2, y)), d = r.w(c.W / 2, y, tz(c.W / 2, y)); px.line(g0, a[0], a[1], d[0], d[1], '#eaf1f2'); }\n    const ground = (x, y, z = 0) => r.w(x, y, tz(x, y) + z);\n    for (const s of c.gaps) { const p = ground(s.x, s.y); px.ell(g0, p[0], p[1], 8, 6, '#20404c'); px.ell(g0, p[0], p[1] + 1, 7, 4, '#0f2a35'); }\n    for (const s of c.glasses) { const p = ground(s.x, s.y); r.queue(s.x, s.y - 1, tz(s.x, s.y), g => { px.ell(g, p[0], p[1] + 2, 8, 5, '#c8dde2'); px.rect(g, p[0] - 1, p[1] - 10, 2, 12, '#dfeef2'); px.poly(g, [[p[0] - 11, p[1] - 19], [p[0] + 11, p[1] - 19], [p[0], p[1] - 8]], '#d6f2f7'); px.line(g, p[0] - 11, p[1] - 19, p[0] + 11, p[1] - 19, '#ffffff'); px.line(g, p[0] - 11, p[1] - 19, p[0], p[1] - 8, '#a8d4de'); px.line(g, p[0] + 11, p[1] - 19, p[0], p[1] - 8, '#a8d4de'); for (let i = 0; i < Math.min(3, s.data.n); i++) { px.disc(g, p[0] - 3 + i * 3, p[1] - 13 - (i % 2), 2, '#7b9a3a'); px.dot(g, p[0] - 3 + i * 3, p[1] - 14 - (i % 2), '#e0553a'); } }); }\n    for (const s of c.bumpers) { const p = ground(s.x, s.y); r.queue(s.x, s.y, tz(s.x, s.y), g => { px.ell(g, p[0], p[1] + 1, 10, 7, '#c49c6c'); px.ell(g, p[0], p[1] - 2, 9, 6, '#ffd166'); px.ell(g, p[0] - 2, p[1] - 4, 3, 2, '#fff3c8'); }); }\n    for (const s of c.blocks) { const p = ground(s.x, s.y); r.queue(s.x, s.y, tz(s.x, s.y), g => { px.rect(g, p[0] - 10, p[1] - 14, 20, 20, '#fbfdfd'); px.rect(g, p[0] - 10, p[1] - 14, 20, 6, '#ffffff'); px.rect(g, p[0] - 10, p[1] + 5, 20, 1, '#c8dde2'); px.rect(g, p[0] + 7, p[1] - 8, 3, 13, '#dfe9ea'); }); }\n    if (c.gecko) { const q = c.gecko, p = ground(q.x, q.y), wig = Math.sin(game.real * 9) * 2; r.queue(q.x, q.y, tz(q.x, q.y), g => { px.line(g, p[0] - 9, p[1] + wig, p[0] - 4, p[1], '#6fbf5a', 2); px.ell(g, p[0], p[1], 6, 3, '#7fd17a'); px.disc(g, p[0] + 6, p[1] - 1, 3, '#8fe08a'); px.dot(g, p[0] + 7, p[1] - 2, '#20404c'); for (const k of [-3, 3]) { px.dot(g, p[0] + k, p[1] - 3 - wig * .3, '#6fbf5a'); px.dot(g, p[0] + k, p[1] + 3 + wig * .3, '#6fbf5a'); } }); }\n    for (const o of c.olives) { const fall = o.data.fall > 0 ? (1 - o.data.fall / .7) : 0; if (fall > .5) continue; const p = ground(o.x, o.y, 2 - fall * 6); r.queue(o.x, o.y, tz(o.x, o.y), g => { px.ell(g, p[0] + 1, p[1] + 4, 6, 3, '#20404c40'); px.disc(g, p[0], p[1] - 1, 6, '#5f7f2a'); px.disc(g, p[0] - 1, p[1] - 2, 5, '#7b9a3a'); px.disc(g, p[0] - 2, p[1] - 3, 2, '#a8c060'); px.disc(g, p[0] + 2, p[1] - 3, 1.6, '#e0553a'); }); }\n    G.drawRig(r, ctx.dennis, -180, -40);\n    if (Math.floor(game.real / 5) % 2 === 0) r.queue(-180, -40, 80, g => {}, {});\n    G.drawGhosts && G.drawGhosts(r, ctx);\n  },\n  hud(g, ctx) {\n    const W = game.W, H = game.H, c = ctx.local || ctx.contestants[0];\n    if (ctx.live) G.drawTimer(g, G.left(ctx), { x: 36 });\n    if (ctx.live) { G.panel(g, W - 100, 8, 92, 16, { r: 7 }); txt(g, 'Olives ' + c.inGlass + ' / ' + c.total, W - 54, 12, '#14a8c8', { align: 'center' }); }\n    if (ctx.live) { G.drawPlate(g, c.bal, { x: 34, y: H - 34, r: 26, ring: null, color: c.color }); G.prompts(g, [['lean', 'Tilt']]); }\n    if (ctx.live && Math.floor(ctx.time / 5) % 2 === 0) { const p = game.r.w(-180, -40, 62); G.panel(g, p[0] - 16, p[1] - 12, 40, 15, { r: 7 }); txt(g, 'Olive?', p[0] + 4, p[1] - 8, '#5f7f8a', { align: 'center' }); }\n  }\n});\n})();\nEOF\ncat > game/activities/laundry.js <<'EOF'\n/* activities/laundry.js: Laundry Line. Walk a clothesline between bungalows, on the x axis only. Effort sets the pace and\n * the wobble; jump over pegs; the wind warns you first. Fall: you dangle, drop into a hamper, go back to the last post. */\n(() => {\n'use strict';\nconst E = My3D2dge, G = window.G, { px, clamp } = E, game = G.game;\nconst txt = (...a) => G.txt(...a);\nconst ROPE_Z = 58, WALK = 40;\nconst BOT = { poor: { effort: .45, jumpAt: 8, hit: .75 }, average: { effort: .6, jumpAt: 10, hit: .92 }, good: { effort: .78, jumpAt: 12, hit: 1 }, expert: { effort: .95, jumpAt: 14, hit: 1 } };\nconst CLOTHES = ['#ff7a59', '#2cc6e6', '#f5c84b', '#6fcf8e', '#f08fb0', '#ffffff', '#b08be0'];\nG.family('laundry', {\n  camera: { zoom: false }, view: 'side',\n  setup(ctx) {\n    const co = G.DATA.courses.laundry; ctx.spans = co.spans; ctx.posts = [0]; ctx.pegs = []; ctx.gusts = []; let at = 0;\n    const sc = ctx.durGiven ? clamp(ctx.durGiven / 70, .4, 1) : 1;\n    co.spans.forEach((s, i) => { const len = s.len * sc; for (const p of s.pegs) if (p * sc < len - 14) ctx.pegs.push({ x: at + p * sc, hit: {} }); for (const g of s.gusts) ctx.gusts.push({ x: at + g * len, dir: ctx.rng() < .5 ? -1 : 1, state: 0, t: 0 }); at += len; ctx.posts.push(at); });\n    ctx.end = at; ctx.clothes = []; for (let x = 18; x < at - 12; x += 27) { const pegHere = ctx.pegs.some(p => Math.abs(p.x - x) < 16); if (pegHere) continue; ctx.clothes.push({ x, kind: Math.floor(ctx.rng() * 4), col: CLOTHES[Math.floor(ctx.rng() * CLOTHES.length)], k: ctx.rng() * 6 }); }\n    ctx.wind = 0; ctx.windDir = 1; ctx.par = co.par * sc; ctx.worst = co.worst * sc; ctx.dur = ctx.durGiven || ctx.def.dur; ctx.sock = null;\n    for (const c of ctx.contestants) { c.bal = new G.Balance(ctx.tier.set, c.rng); c.bal.axis = 'x'; c.bal.cheat = ctx.cheat; c.wx = 6; c.vz = 0; c.jz = 0; c.fallT = 0; c.falls = 0; c.pen = 0; c.lastPost = 0; c.effort = 0; c.ph = 0; c.fin = 0; c.state = 'walk'; c.gustI = 0; c.creakT = 0;\n      c.bal.onStumble = () => {}; }\n    if (ctx.contestants.length === 1) ctx.contestants[0].y = 0;\n  },\n  preview(dt, ctx) { const c = ctx.contestants[0]; c.rig.body = G.moves.rope(0, 0); c.rig.update(dt, { x: c.wx, y: 0, z: ROPE_Z, vx: 0, vy: 0, facing: 0, expr: 'smile' }); game.cam.smooth = 0; game.focus(c.wx + 40, 0, ROPE_Z - 4); },\n  update(dt, ctx) {\n    const d = G.DEV, t = ctx.time, set = ctx.tier.set;\n    for (const c of ctx.contestants) {\n      const I = c.intent, b = c.bal;\n      if (c.fin) { c.ph += dt * 2; c.rig.body = null; c.rig.wob = [0, 0]; c.poser.clip('Victory', { tgt: 1.2, loop: false }); c.poser.update(dt); c.rig.update(dt, { x: c.wx, y: 0, z: ROPE_Z, vx: 0, vy: 0, facing: c.poser.facing, expr: 'smile' }); continue; }\n      if (c.fallT > 0) {   // dangle, drop, hamper, back to the last post\n        c.fallT -= dt; const k = 1 - c.fallT / 1.6, drop = k < .3 ? 0 : (k - .3) / .7 * ROPE_Z; c.dropZ = ROPE_Z - drop * Math.min(1, drop / 20 + .4);\n        c.rig.body = null; c.poser.clip('Dizzy', { fade: .1, loop: true, tgt: .2 }); c.poser.update(dt); c.rig.wob = [Math.sin(t * 9) * .2, 0]; c.rig.update(dt, { x: c.wx, y: 0, z: Math.max(4, c.dropZ), vx: 0, vy: 0, facing: c.poser.facing, expr: 'wince' });\n        if (c.fallT <= .6 && !c.boomp && G.cue(ctx, c)) { c.boomp = true; G.A.sfx('thud'); }\n        if (c.fallT <= 0) { c.wx = c.lastPost + 6; b.x = b.y = b.vx = b.vy = 0; b.stumbling = 0; c.pen += 3; c.boomp = false; c.poser.off(); }\n        continue;\n      }\n      /* effort: walk speed, and instability */\n      const eff = clamp(c.skill || (G.DEV.bot && c.local) ? I.walk : I.walk, 0, 1); c.effort = eff;\n      b.extraS = 4 * eff * d.rope; b.set.s = set.s * d.rope;\n      /* gusts: telegraphed .8 s early by wind lines and a flying sock */\n      for (const gu of ctx.gusts) {\n        if (gu.state === 0 && c.wx > gu.x - 16 && c === (ctx.local || ctx.contestants[0])) { gu.state = 1; gu.t = 0; ctx.windDir = gu.dir; if (G.cue(ctx, c)) G.A.sfx('wind'); ctx.sock = { x: c.wx - gu.dir * 150, z: ROPE_Z + 40, t: 0, dir: gu.dir }; }\n        if (gu.state === 1) { gu.t += dt / ctx.contestants.length; if (gu.t >= .8) { gu.state = 2; gu.t = 0; } }\n        if (gu.state === 2) { gu.t += dt / ctx.contestants.length; b.fx += gu.dir * ctx.tier.gust * d.gust; if (gu.t >= .6) gu.state = 3; }\n      }\n      ctx.wind = ctx.gusts.some(g => g.state === 1 || g.state === 2) ? 1 : Math.max(0, ctx.wind - dt);\n      /* a jump: in the air, p freezes */\n      if (I.jump && c.jz <= 0) { c.vz = 118; c.jz = .01; if (G.cue(ctx, c)) G.A.sfx('tareHop', { vol: .6 }); b.frozen = true; }\n      if (c.jz > 0) { c.vz -= 340 * dt; c.jz += c.vz * dt; if (c.jz <= 0) { c.jz = 0; c.vz = 0; b.frozen = false; if (G.cue(ctx, c)) { G.A.sfx('rope'); } b.kick((c.rng() - .5) * .35, 0); } }\n      b.step(dt, I.x, 0);\n      const inRing = Math.abs(b.x) <= b.R, speed = WALK * eff * (inRing ? 1 : .55);\n      c.wx += speed * dt; c.ph += speed * dt * .32;\n      if (G.cue(ctx, c) && speed > 4) { c.creakT -= dt; if (c.creakT <= 0) { G.A.sfx('rope', { vol: .4 + b.edge * .6 }); c.creakT = .55 - b.edge * .2; if (b.edge > .7 && c.input) c.input.rumble(.3, .1); } }\n      for (const pz of ctx.posts) if (c.wx >= pz && pz > c.lastPost) { c.lastPost = pz; if (G.cue(ctx, c)) G.A.sfx('ok'); }\n      /* pegs trip you; the rope throws you */\n      let tripped = false;\n      if (c.jz < 6) for (const p of ctx.pegs) if (!p.hit[c.i] && Math.abs(c.wx - p.x) < 4) { p.hit[c.i] = true; if (!ctx.cheat) tripped = true; else c.jz = .01, c.vz = 118; }\n      if (b.stumbling > 0 || tripped) { b.stumbling = 0; c.falls++; c.fallT = 1.6; c.dropZ = ROPE_Z; if (G.cue(ctx, c)) { G.A.sfx('stumble'); game.shake(.08); if (c.input) c.input.rumble(.8, .3); if (c.falls === 1) G.mutter('tare', G.line('tare.fall')); } for (const p of ctx.pegs) if (p.x > c.lastPost) delete p.hit[c.i]; continue; }\n      if (c.wx >= ctx.end) { c.fin = t + c.pen; c.wx = ctx.end; if (ctx.contestants.every(q => q.fin)) ctx.finished = true; if (G.cue(ctx, c)) G.sting('star1'); }\n      const arms = clamp(b.x, -1, 1) * 2.4;\n      c.rig.body = G.moves.rope(c.ph, arms); c.rig.mocap = null; c.rig.wob = [0, clamp(b.x, -1, 1) * .9];\n      c.rig.update(dt, { x: c.wx, y: 0, z: ROPE_Z + c.jz, vx: 0, vy: 0, facing: 0, expr: b.edge > .6 ? 'wince' : 'smile' });\n    }\n    if (ctx.sock) { ctx.sock.t += dt; ctx.sock.x += ctx.sock.dir * 170 * dt; if (ctx.sock.t > 2) ctx.sock = null; }\n    const me = ctx.local || ctx.contestants[0]; game.cam.smooth = 0; game.focus(me.wx + 40, 0, ROPE_Z - 4);\n  },\n  result(ctx, c) { const t = (c.fin || (ctx.time + 40)) + 0, pct = clamp((ctx.worst - t) / (ctx.worst - ctx.par), 0, 1) - .06 * c.falls; return { pct, detail: 'Your time ' + G.fmtTime(t) + '. Falls: ' + c.falls + '.' + (c.fin ? '' : ' You did not reach the end. The laundry understands.') }; },\n  bot(ctx, c, dt) {\n    const B = BOT[c.brain.skill], I = c.intent, bal = c.bal; const u = c.brain.hold(dt, { x: bal.x, y: 0, vx: bal.vx, vy: 0 }, 0, 0); I.x = u[0]; I.y = 0; I.walk = B.effort; I.jump = false;\n    for (const p of ctx.pegs) { const dx = p.x - c.wx; if (dx > 0 && dx < B.jumpAt && c.jz <= 0 && !p.hit[c.i] && !p.tried) { p.tried = c.rng() < B.hit ? 'go' : 'no'; } if (dx > 0 && dx < B.jumpAt && p.tried === 'go' && c.jz <= 0) { I.jump = true; p.tried = 'done'; } }\n    if (ctx.tried === undefined) ctx.tried = 0;\n  },\n  ghost(ctx, c) { return { x: Math.round(c.wx), z: Math.round(c.jz), w: +c.bal.x.toFixed(2), f: c.fallT > 0 ? 1 : 0 }; },\n  draw(r, ctx) {\n    const g0 = r.ctx, W = r.W + 2, H = r.H + 2, ground = r.w(0, 0, 0)[1];\n    G.bands(g0, 0, 0, W, ground, '#8fd3f4', '#d8f3fb', 12);\n    const seaY = ground - 30; G.bands(g0, 0, seaY, W, 30, '#49b6c9', '#2f97ad', 5);\n    const cam = r.w(0, 0, 0)[0];\n    for (let i = 0; i < 5; i++) { const x = ((i * 137 - cam * -.1 + game.real * 4) % (W + 60)) - 30, y = 16 + i * 12; px.ell(g0, x, y, 18, 3, '#ffffff'); px.ell(g0, x + 7, y - 2, 9, 3, '#ffffff'); }\n    G.bands(g0, 0, ground, W, H - ground, '#7fc87a', '#5fa864', 6);\n    for (let i = -2; i < 28; i++) { const q = r.w(i * 60, 0, 0); if (q[0] < -30 || q[0] > W + 30) continue; px.rect(g0, q[0], q[1] + 4, 2, 2, '#4f9a58'); px.rect(g0, q[0] + 22, q[1] + 11, 2, 2, '#a8dc9a'); px.rect(g0, q[0] + 41, q[1] + 18, 2, 2, '#4f9a58'); }\n    /* bungalows at the posts */\n    ctx.posts.forEach((x, i) => { const p = r.w(x, 0, 0), Wb = 92, Hb = 58; if (p[0] < -120 || p[0] > W + 120) return; px.rect(g0, p[0] - Wb / 2, p[1] - Hb, Wb, Hb, '#fbf6ec'); px.rect(g0, p[0] - Wb / 2, p[1] - Hb, 5, Hb, '#ffffff'); px.poly(g0, [[p[0] - Wb * .62, p[1] - Hb], [p[0] + Wb * .62, p[1] - Hb], [p[0], p[1] - Hb - 30]], ['#ff9a7a', '#7fd8ea', '#f5c84b', '#6fcf8e'][i % 4]); px.rect(g0, p[0] - 9, p[1] - 28, 18, 28, '#c49c6c'); px.rect(g0, p[0] + 18, p[1] - 40, 16, 14, '#a8e4f2'); px.rect(g0, p[0] - 34, p[1] - 40, 16, 14, '#a8e4f2'); });\n    if (ctx.posts[0] !== undefined) { const p = r.w(ctx.posts[0] + 50, 0, 0); if (p[0] > -120 && p[0] < W + 120) { px.rect(g0, p[0] - 1, p[1] - 36, 2, 36, '#7a8a94'); G.panel(g0, p[0] - 110, p[1] - 62, 220, 28, { r: 5 }); G.wrapText(g0, G.DATA.lines.sign.laundry, p[0], p[1] - 59, 208, '#20404c', { align: 'center', gap: 1 }); } }\n    /* the posts and the rope */\n    for (const x of ctx.posts) { const a = r.w(x, 0, 0), b = r.w(x, 0, ROPE_Z + 8); px.rect(g0, a[0] - 2, b[1], 4, a[1] - b[1], '#a57f54'); px.rect(g0, a[0] - 2, b[1], 1, a[1] - b[1], '#c49c6c'); px.rect(g0, a[0] - 7, b[1] + 3, 14, 3, '#8a6a4a'); }\n    const me = ctx.local || ctx.contestants[0], segs = 90, sag = t => 0;\n    const ropeAt = x => { let s = 3 * Math.sin(Math.min(1, Math.abs(x - me.wx) / 110) * 1.57 + 1.57); return ROPE_Z - (s < 0 ? 0 : s) * .7 * (me.jz > 0 ? .3 : 1); };\n    for (let i = 0; i < segs; i++) { const x0 = ctx.posts[0] + i * ctx.end / segs, x1 = x0 + ctx.end / segs, a = r.w(x0, 0, ropeAt(x0)), b = r.w(x1, 0, ropeAt(x1)); if (b[0] < -8 || a[0] > W + 8) continue; px.line(g0, a[0], a[1], b[0], b[1], '#f4f8f8', 2); px.line(g0, a[0], a[1] + 1, b[0], b[1] + 1, '#9fb5bc'); }\n    /* laundry on the line */\n    for (const q of ctx.clothes) { const p = r.w(q.x, 0, ropeAt(q.x)); if (p[0] < -24 || p[0] > W + 24) continue; const sw = Math.sin(game.real * 2.4 + q.k) * 2 * (1 + ctx.wind * 2) * (ctx.wind ? ctx.windDir : 1);\n      if (q.kind === 0) { px.poly(g0, [[p[0] - 8, p[1] + 1], [p[0] + 8, p[1] + 1], [p[0] + 7 + sw, p[1] + 20], [p[0] - 7 + sw, p[1] + 20]], q.col); px.rect(g0, p[0] - 13, p[1] + 1, 5, 6, q.col); px.rect(g0, p[0] + 8, p[1] + 1, 5, 6, q.col); px.rect(g0, p[0] - 3, p[1] + 1, 6, 2, E.shade(q.col, -.2)); }\n      else if (q.kind === 1) { px.poly(g0, [[p[0] - 5, p[1] + 1], [p[0] + 5, p[1] + 1], [p[0] + 3 + sw, p[1] + 16], [p[0] - 3 + sw, p[1] + 16]], q.col); px.rect(g0, p[0] - 3 + sw, p[1] + 14, 8, 4, q.col); }\n      else if (q.kind === 2) { for (const k of [-3, 3]) px.poly(g0, [[p[0] + k - 3, p[1] + 1], [p[0] + k + 3, p[1] + 1], [p[0] + k + 3 + sw, p[1] + 19], [p[0] + k - 3 + sw, p[1] + 19]], q.col); px.rect(g0, p[0] - 6, p[1] + 1, 12, 2, E.shade(q.col, -.2)); }\n      else { px.poly(g0, [[p[0] - 11, p[1] + 1], [p[0] + 11, p[1] + 1], [p[0] + 10 + sw * 1.4, p[1] + 26], [p[0] - 10 + sw * 1.4, p[1] + 26]], '#ffffff'); px.rect(g0, p[0] + 7, p[1] + 1, 2, 24, '#e3edef'); }\n      px.rect(g0, p[0] - 1, p[1] - 3, 2, 5, '#c49c6c'); }\n    /* pegs to jump */\n    for (const p of ctx.pegs) { const q = r.w(p.x, 0, ROPE_Z); if (q[0] < -8 || q[0] > W + 8) continue; px.rect(g0, q[0] - 2, q[1] - 12, 4, 13, '#c49c6c'); px.rect(g0, q[0] - 2, q[1] - 12, 1, 13, '#e0c094'); px.rect(g0, q[0] - 3, q[1] - 6, 6, 2, '#7a8a94'); }\n    /* the hamper, where you are about to land */\n    for (const c of ctx.contestants) if (c.fallT > 0) { const q = r.w(c.wx, 0, 0); px.poly(g0, [[q[0] - 16, q[1] - 22], [q[0] + 16, q[1] - 22], [q[0] + 12, q[1]], [q[0] - 12, q[1]]], '#d9b68a'); for (let i = 0; i < 4; i++) px.rect(g0, q[0] - 14 + i * 2, q[1] - 18 + i * 5, 28 - i * 4, 1, '#a57f54'); px.rect(g0, q[0] - 17, q[1] - 24, 34, 3, '#c49c6c'); }\n    for (const c of ctx.contestants) { if (!c.local && ctx.local) continue; G.drawRig(r, c.rig, c.wx, 0, c.fallT > 0 ? Math.max(4, c.dropZ) : ROPE_Z + c.jz, { noShadow: true }); }\n    G.drawRopeGhosts && G.drawRopeGhosts(r, ctx);\n    if (ctx.sock) { const p = r.w(ctx.sock.x, 0, ctx.sock.z + Math.sin(ctx.sock.t * 9) * 5); r.overlay(g => { const a = ctx.sock.t * 7; px.rect(g, p[0] - 3, p[1] - 3, 7, 7, '#f08fb0'); px.rect(g, p[0] + Math.cos(a) * 4, p[1] + Math.sin(a) * 4, 4, 4, '#ffffff'); }); }\n    if (ctx.wind > 0) r.overlay(g => { for (let i = 0; i < 12; i++) { const y = (i * 37) % (game.H - 40) + 12, x = ((i * 91 + game.real * 300 * ctx.windDir) % (game.W + 60) + game.W + 60) % (game.W + 60) - 30, L = 14 + (i % 3) * 8; px.rect(g, x, y, L, 1, '#ffffff'); } });\n  },\n  hud(g, ctx) {\n    if (!ctx.live) return;\n    const W = game.W, H = game.H, c = ctx.local || ctx.contestants[0];\n    G.panel(g, 8, 6, 74, 20, { r: 8 }); txt(g, G.fmtTime(ctx.time + c.pen), 45, 9, '#20404c', { align: 'center', scale: 2 });\n    const pr = clamp(c.wx / ctx.end, 0, 1); G.panel(g, W - 112, 8, 104, 16, { r: 7 }); E.ui.bar(g, W - 106, 13, 92, 6, pr, '#2cc6e6', { bg: '#e8f0f2' }); for (const x of ctx.posts) px.rect(g, W - 106 + 92 * x / ctx.end, 11, 1, 10, '#5f7f8a');\n    G.drawPlate(g, c.bal, { x: W / 2, y: H - 34, r: 26, ring: [0, 0, c.bal.R], color: c.color });\n    txt(g, 'Pace', W / 2 + 40, H - 46, '#5f7f8a'); E.ui.bar(g, W / 2 + 40, H - 36, 50, 7, c.effort, c.effort > .8 ? '#ff7a59' : '#7fe0c3', { bg: '#e8f0f2' });\n    if (c.fallT > 0) txt(g, 'Please hold.', W / 2, 40, '#e0553a', { align: 'center', scale: 2, shadow: '#ffffff' });\n    if (ctx.wind > 0) { const k = Math.floor(game.real * 6) % 2; txt(g, ctx.windDir > 0 ? 'Wind →' : '← Wind', W / 2, 30, k ? '#e0553a' : '#20404c', { align: 'center', scale: 2, shadow: '#ffffff' }); }\n    G.prompts(g, [['walk', 'Walk'], ['leanx', 'Lean'], ['jump', 'Jump']]);\n  }\n});\n})();\nEOF\ngrep -n \"road.ahead\\|  ahead(\" engine/modules/road.js | head -3 | cut -c1-200; grep -n \"gamma\\|sky:\\|sun:\" engine/my-3d2dge.js | grep -i \"backdrop\" | head -3 | cut -c1-200; node tests/tools/smoke.mjs 2>&1 | tail -12 | cut -c1-200","description":"Write the hoop, jog, slalom, tray and laundry activity families","timeout":120000}}}
