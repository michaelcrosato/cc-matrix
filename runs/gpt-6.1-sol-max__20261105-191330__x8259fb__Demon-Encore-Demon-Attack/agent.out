th a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n511:    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n513:    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n521:    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n523:    check('harness ran', false, String(error?.stack || error));\n525:    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n532:function renderChecks(checks) {\n533:  $('checklist').replaceChildren(\n534:    ...checks.map((c) => {\n544:if (auto) conformance();\n","exit_code":0,"status":"completed"}}
