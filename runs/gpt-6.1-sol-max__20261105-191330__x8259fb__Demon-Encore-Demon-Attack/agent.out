{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"cat > tests/check.py <<'PY'\nimport functools\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nimport json\nfrom pathlib import Path\nimport re\nimport subprocess\nimport sys\nimport threading\nfrom urllib.parse import urlencode\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parent.parent\nART = ROOT / \\\"artifacts\\\"\nART.mkdir(exist_ok=True)\ncount = 0\nfailures = []\nmetrics = {}\nerrors = []\n\n\ndef check(name, fn):\n    global count\n    try:\n        fn()\n        count += 1\n    except Exception as exc:\n        failures.append(name + \\\": \\\" + str(exc).splitlines()[0])\n\n\ndef require(value, message):\n    if not value:\n        raise AssertionError(message)\n\n\ndef tap(page, partial_name):\n    box = page.get_by_role(\\\"button\\\", name=partial_name).bounding_box()\n    page.touchscreen.tap(box[\\\"x\\\"] + box[\\\"width\\\"] / 2, box[\\\"y\\\"] + box[\\\"height\\\"] / 2)\n\n\ndef ready(page):\n    page.wait_for_function(\\\"window.__DE?.ready || window.__DE?.error\\\", timeout=45000)\n    require(page.evaluate(\\\"__DE.ready\\\"), str(page.evaluate(\\\"__DE.error || 'renderer did not initialize'\\\")))\n\n\ndef padpress(page, button):\n    page.evaluate(\\\"(b)=>{__pad.buttons[b].pressed=true;__pad.buttons[b].value=1}\\\", button)\n    page.wait_for_timeout(180)\n    page.evaluate(\\\"(b)=>{__pad.buttons[b].pressed=false;__pad.buttons[b].value=0}\\\", button)\n    page.wait_for_timeout(180)\n\n\nclass QuietHandler(SimpleHTTPRequestHandler):\n    def log_message(self, *_):\n        pass\n\n\nsubprocess.run([\\\"node\\\", \\\"build.mjs\\\", \\\"--quiet\\\"], cwd=ROOT, check=True, capture_output=True)\nphysics = subprocess.run([\\\"node\\\", \\\"tests/physics.mjs\\\"], cwd=ROOT, capture_output=True, text=True)\ntry:\n    data = json.loads(physics.stdout)\n    count += data[\\\"count\\\"]\n    failures.extend(data[\\\"failures\\\"])\n    metrics.update(data[\\\"metrics\\\"])\nexcept Exception as exc:\n    failures.append(\\\"physics runner: \\\" + (physics.stderr or str(exc))[:300])\n\n\ndef metadata():\n    report = json.loads((ROOT.parent / \\\"exit-interview.json\\\").read_text())\n    require(set(report) == {\\\"sourceInformation\\\", \\\"testingFeedback\\\", \\\"engineFeedback\\\", \\\"promptFeedback\\\", \\\"aiHub\\\"}, \\\"wrong report shape\\\")\n    require(len(report[\\\"testingFeedback\\\"]) == 4 and len(report[\\\"engineFeedback\\\"]) == 6 and len(report[\\\"promptFeedback\\\"]) == 4, \\\"missing interview answers\\\")\n    require(report[\\\"sourceInformation\\\"][\\\"usage\\\"] == \\\"added on import\\\", \\\"wrong usage text\\\")\n    require(all(v for v in report[\\\"sourceInformation\\\"].values()), \\\"empty source information\\\")\n    html = (ROOT / \\\"index.html\\\").read_text()\n    first_script = re.search(r\\\"<script>(.*?)</script>\\\", html, re.S).group(1)\n    require(first_script == (ROOT / \\\"vendor/hub/session.js\\\").read_text(), \\\"Hub client modified\\\")\n    require(not re.search(r'<script[\"'^>]+src=|<link[''^>]+href='\"', html), \\\"external runtime dependency\\\")\ncheck(\\\"single-file package and exit interview contract\\\", metadata)\n\nhandler = functools.partial(QuietHandler, directory=str(ROOT))\nserver = ThreadingHTTPServer((\\\"127.0.0.1\\\", 0), handler)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\norigin = \\\"http://127.0.0.1:\\\" + str(server.server_port)\nmetrics[\\\"testOrigin\\\"] = origin\n\ntry:\n    with sync_playwright() as pw:\n        browser = pw.chromium.launch(\n            headless=True,\n            args=[\\\"--no-sandbox\\\", \\\"--disable-dev-shm-usage\\\", \\\"--enable-unsafe-webgpu\\\",\n                  \\\"--enable-features=Vulkan\\\", \\\"--use-webgpu-adapter=swiftshader\\\",\n                  \\\"--enable-unsafe-swiftshader\\\"],\n        )\n        context = browser.new_context(viewport={\\\"width\\\": 1600, \\\"height\\\": 1000}, offline=True)\n        page = context.new_page()\n        page.on(\\\"pageerror\\\", lambda e: errors.append(str(e)))\n        console_errors = []\n        page.on(\\\"console\\\", lambda m: console_errors.append(m.text) if m.type == \\\"error\\\" else None)\n        page.goto((ROOT / \\\"index.html\\\").as_uri(), wait_until=\\\"load\\\", timeout=60000)\n\n        def initialized():\n            ready(page)\n            require(page.evaluate(\\\"__DE.state.backend\\\") == \\\"WebGPU\\\", \\\"WebGPU was not used\\\")\n        check(\\\"offline HTML boots with WebGPU\\\", initialized)\n\n        if page.evaluate(\\\"\"'!!window.__DE?.ready\"):\n            page.screenshot(path=str(ART / \"title-webgpu.png\"))\n            metrics[\"initialState\"] = page.evaluate(\"__DE.state\")\n            check(\"title exposes five TV-sized actions\",\n                  lambda: require(page.locator(\".title-layout .menu-button\").count() == 5, \"wrong action count\"))\n            page.get_by_role(\"button\", name=\"SOLO SORTIE\").click()\n            page.get_by_role(\"button\", name=\"LAUNCH SORTIE\").click()\n            page.wait_for_timeout(250)\n            check(\"solo sortie creates Rapier world\", lambda: require(page.evaluate(\"__DE.state.physics\") > 0, \"no bodies\"))\n            page.evaluate(\"__DE.app.manual=true;__DE.simulate(4, {0:{fire:true}})\")\n            check(\"simulation spawns the first encounter\", lambda: require(page.evaluate(\"__DE.game.wave\") == 0, \"wrong encounter\"))\n            check(\"renderer produces frames\", lambda: require(page.evaluate(\"__DE.state.frames\") > 2, \"no rendered frames\"))\n\n            def pause_lab():\n                page.keyboard.press(\"Escape\")\n                require(page.evaluate(\"__DE.app.menu\") == \"pause\", \"Escape did not pause\")\n                before = page.evaluate(\"__DE.game.time\")\n                page.evaluate(\"__DE.app.manual=false\")\n                page.wait_for_timeout(250)\n                require(page.evaluate(\"__DE.game.time\") == before, \"paused simulation advanced\")\n                page.get_by_role(\"button\", name=\"FLIGHT LAB\").click()\n                page.get_by_label(\"Demon speed\", exact=True).evaluate(\"(e)=>{e.value='\"'1.7';e.dispatchEvent(new Event('input',{bubbles:true}))}\\\")\n                require(abs(page.evaluate(\\\"__DE.game.tuning.enemySpeed\\\") - 1.7) < .01, \\\"live slider did not change world\\\")\n                page.get_by_label(\\\"Invulnerable pilots\\\", exact=True).check()\n                page.get_by_role(\\\"button\\\", name=\\\"CHARGE ENCORE\\\", exact=True).click()\n                require(page.evaluate(\\\"__DE.game.players[0].charge\\\") == 100, \\\"charge tool failed\\\")\n                page.get_by_role(\\\"button\\\", name=\\\"DROP PICKUPS\\\", exact=True).click()\n                require(page.evaluate(\\\"[...__DE.game.entities.values()].filter(e=>e.type==='pickup').length\\\") == 3, \\\"drop tool failed\\\")\n                page.get_by_role(\\\"button\\\", name=\\\"NEXT ENCOUNTER\\\", exact=True).click()\n                require(page.evaluate(\\\"__DE.game.wave\\\") == 1, \\\"next encounter failed\\\")\n                page.get_by_role(\\\"button\\\", name=\\\"RESET ALL TUNING\\\").click()\n                require(page.evaluate(\\\"JSON.stringify(__DE.game.tuning)===JSON.stringify(__DE.DEFAULTS)\\\"), \\\"tuning reset failed\\\")\n                page.keyboard.press(\\\"Escape\\\")\n                page.keyboard.press(\\\"Escape\\\")\n                require(page.evaluate(\\\"__DE.app.menu\\\") is None, \\\"resume path failed\\\")\n            check(\\\"pause menu, live tuning and all lab tools\\\", pause_lab)\n\n            def keyboard_mouse():\n                page.evaluate(\\\"__DE.app.manual=false;__DE.game.tuning.god=true\\\")\n                x = page.evaluate(\\\"__DE.game.players[0].x\\\")\n                page.keyboard.down(\\\"ArrowRight\\\")\n                page.wait_for_timeout(300)\n                page.keyboard.up(\\\"ArrowRight\\\")\n                require(page.evaluate(\\\"__DE.game.players[0].x\\\") > x, \\\"arrow movement failed\\\")\n                page.keyboard.down(\\\"Space\\\")\n                page.wait_for_timeout(300)\n                page.keyboard.up(\\\"Space\\\")\n                require(page.evaluate(\\\"__DE.game.stats.shots\\\") > 0, \\\"Space fire failed\\\")\n                page.mouse.move(300, 650)\n                page.mouse.down()\n                page.wait_for_timeout(300)\n                page.mouse.up()\n                require(page.evaluate(\\\"__DE.game.players[0].x\\\") < x + .2, \\\"mouse positioning failed\\\")\n                page.keyboard.press(\\\"Shift\\\")\n                page.wait_for_timeout(50)\n                require(page.evaluate(\\\"__DE.game.stats.dashes\\\") > 0, \\\"keyboard dash failed\\\")\n                page.evaluate(\\\"__DE.game.players[0].charge=100\\\")\n                page.keyboard.press(\\\"e\\\")\n                page.wait_for_timeout(50)\n                require(page.evaluate(\\\"__DE.game.stats.encores\\\") > 0, \\\"keyboard Encore failed\\\")\n            check(\\\"native keyboard and mouse gameplay\\\", keyboard_mouse)\n\n            def audio():\n                result = page.evaluate(\\\"\\\"\\\"async()=>{\n                    const ctx=new OfflineAudioContext(1,44100,44100);\n                    const engine=new __DE.app.audio.constructor(__DE.app.settings);\n                    engine.ctx=ctx;engine.build(ctx);\n                    engine.tone(220,.3,'triangle',.3,engine.music,.01);\n                    engine.play('encore');engine.gibberish('victory');\n                    const buffer=await ctx.startRendering(),data=buffer.getChannelData(0);\n                    let sum=0,peak=0,bad=0;for(const v of data){sum+=v*v;peak=Math.max(peak,Math.abs(v));if(\"'!Number.isFinite(v))bad++;}\n                    return {rms:Math.sqrt(sum/data.length),peak,bad,voices:engine.voices,music:engine.settings.music};\n                }\"\"\")\n                metrics[\"offlineAudio\"] = result\n                require(result[\"rms\"] > .005 and result[\"peak\"] < 1 and result[\"bad\"] == 0, \"generated audio silent, clipped or invalid\")\n                require(result[\"voices\"] == 1 and result[\"music\"] == 10, \"voice or default music volume wrong\")\n            check(\"offline-rendered music, SFX and gibberish voice\", audio)\n\n            def couch():\n                page.evaluate(\"__DE.app.hangar();__DE.app.action('\"'couch');__DE.app.manual=false;__DE.game.tuning.god=true\\\")\n                x = page.evaluate(\\\"__DE.game.players[1].x\\\")\n                page.keyboard.down(\\\"l\\\")\n                page.wait_for_timeout(220)\n                page.keyboard.up(\\\"l\\\")\n                require(page.evaluate(\\\"__DE.game.players.length\\\") == 2, \\\"missing co-op pilot\\\")\n                require(page.evaluate(\\\"__DE.game.players[1].x\\\") > x, \\\"second keyboard pilot cannot move\\\")\n                page.evaluate(\\\"__DE.game.players[1].inv=0;__DE.game.players[1].hp=1;__DE.game.tuning.god=false;__DE.game.damage(__DE.game.players[1]);__DE.game.startWave(1)\\\")\n                require(page.evaluate(\\\"__DE.game.players[1].alive\\\"), \\\"co-op revival failed\\\")\n            check(\\\"couch co-op second keyboard pilot and revival\\\", couch)\n\n            def settings_credits():\n                page.evaluate(\\\"__DE.app.hangar();__DE.app.action('settings')\\\")\n                page.get_by_label(\\\"Music\\\", exact=True).evaluate(\\\"(e)=>{e.value='27';e.dispatchEvent(new Event('input',{bubbles:true}))}\\\")\n                page.get_by_label(\\\"Controller glyphs\\\", exact=True).select_option(\\\"xbox\\\")\n                page.reload()\n                ready(page)\n                require(page.evaluate(\\\"__DE.app.settings.music\\\") == 27, \\\"settings did not persist\\\")\n                require(page.evaluate(\\\"__DE.app.settings.glyphs\\\") == \\\"xbox\\\", \\\"glyph choice did not persist\\\")\n                page.evaluate(\\\"__DE.app.action('settings');__DE.app.action('resetSettings');__DE.app.action('title');__DE.app.action('about')\\\")\n                require(page.get_by_text(\\\"added on import\\\", exact=True).count() == 1, \\\"credits missing usage\\\")\n                for tab in [\\\"testingFeedback\\\", \\\"engineFeedback\\\", \\\"promptFeedback\\\"]:\n                    page.evaluate(\\\"(t)=>__DE.app.action('tab:'+t)\\\", tab)\n                    require(page.locator(\\\".feedback-item\\\").count() == (6 if tab == \\\"engineFeedback\\\" else 4), \\\"missing feedback answers\\\")\n            check(\\\"persistent settings and all four credits sections\\\", settings_credits)\n\n            def attract():\n                page.evaluate(\\\"__DE.app.hangar()\\\")\n                page.wait_for_timeout(10400)\n                require(page.evaluate(\\\"__DE.app.attract\\\"), \\\"did not enter attract after ten seconds\\\")\n                page.evaluate(\\\"__DE.app.attractClock=13.5\\\")\n                page.wait_for_timeout(250)\n                require(page.evaluate(\\\"__DE.game.wave\\\") >= 1, \\\"attract does not demonstrate later encounters\\\")\n                page.evaluate(\\\"__DE.game.startWave(6);__DE.app.attractClock=13.5\\\")\n                page.wait_for_timeout(250)\n                require(page.evaluate(\\\"__DE.game.wave\\\") == 0, \\\"attract did not loop\\\")\n                page.keyboard.press(\\\"ArrowLeft\\\")\n                require(page.evaluate(\\\"__DE.app.menu\\\") == \\\"title\\\" and not page.evaluate(\\\"__DE.app.attract\\\"), \\\"input did not exit attract\\\")\n            check(\\\"ten-second attract entry, progression, loop and input exit\\\", attract)\n            metrics[\\\"desktopState\\\"] = page.evaluate(\\\"__DE.state\\\")\n        check(\\\"no WebGPU runtime errors\\\", lambda: require(not errors, \\\"; \\\".join(errors)))\n        metrics[\\\"consoleErrors\\\"] = [e for e in console_errors if \\\"Device was destroyed\\\" not in e]\n        context.close()\n\n        context = browser.new_context(viewport={\\\"width\\\": 1920, \\\"height\\\": 1080})\n        page = context.new_page()\n        page.on(\\\"pageerror\\\", lambda e: errors.append(str(e)))\n        page.goto(origin + \\\"/index.html?renderer=webgl\\\")\n        def fallback():\n            ready(page)\n            require(page.title() == \\\"Demon Encore\\\", \\\"server reached a different page\\\")\n            require(page.evaluate(\\\"__DE.state.backend\\\") == \\\"WebGL 2\\\", \\\"fallback backend missing\\\")\n            page.wait_for_timeout(350)\n            page.screenshot(path=str(ART / \\\"title.png\\\"))\n        check(\\\"owned ephemeral server and rendered WebGL fallback\\\", fallback)\n        if page.evaluate(\\\"\"'!!window.__DE?.ready\"):\n            def screenshot_game():\n                page.evaluate(\"__DE.app.begin();__DE.app.manual=true;__DE.game.startWave(4);__DE.simulate(2,{0:{fire:true}});__DE.app.ui.bannerUntil=0\")\n                page.wait_for_timeout(250)\n                page.screenshot(path=str(ART / \"game.png\"))\n                page.evaluate(\"__DE.game.startWave(6);__DE.simulate(3,{0:{fire:true}});__DE.app.ui.bannerUntil=0\")\n                page.wait_for_timeout(250)\n                page.screenshot(path=str(ART / \"boss.png\"))\n            check(\"rendered swarm and boss composition\", screenshot_game)\n        context.close()\n\n        pad_context = browser.new_context(viewport={\"width\": 1280, \"height\": 800})\n        pad_context.add_init_script(\"\"\"window.__pad={index:0,id:'\"'Emulated DualSense',connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,touched:false,value:0}))};Object.defineProperty(navigator,'getGamepads',{value:()=>[window.__pad]});\\\"\\\"\\\")\n        pad_page = pad_context.new_page()\n        pad_page.on(\\\"pageerror\\\", lambda e: errors.append(str(e)))\n        pad_page.goto(origin + \\\"/index.html?renderer=webgl\\\")\n        def controller():\n            ready(pad_page)\n            padpress(pad_page, 0)\n            require(pad_page.evaluate(\\\"__DE.app.menu\\\") == \\\"difficulty\\\", \\\"Cross did not select\\\")\n            pad_page.evaluate(\\\"__DE.app.action('launch');__DE.game.startWave(0);__DE.game.tuning.god=true;__pad.axes[0]=.8;__pad.buttons[7].pressed=true;__pad.buttons[7].value=1\\\")\n            pad_page.wait_for_timeout(450)\n            require(pad_page.evaluate(\\\"__DE.game.players[0].x\\\") > 0, \\\"left stick did not move\\\")\n            require(pad_page.evaluate(\\\"__DE.game.stats.shots\\\") > 0, \\\"R2 did not fire\\\")\n            pad_page.evaluate(\\\"__pad.axes[0]=0;__pad.buttons[7].pressed=false;__pad.buttons[7].value=0\\\")\n            padpress(pad_page, 1)\n            require(pad_page.evaluate(\\\"__DE.game.stats.dashes\\\") > 0, \\\"Circle did not dash\\\")\n            pad_page.evaluate(\\\"__DE.game.players[0].charge=100\\\")\n            padpress(pad_page, 2)\n            require(pad_page.evaluate(\\\"__DE.game.stats.encores\\\") > 0, \\\"Square did not Encore\\\")\n            padpress(pad_page, 9)\n            require(pad_page.evaluate(\\\"__DE.app.menu\\\") == \\\"pause\\\", \\\"Options did not pause\\\")\n            pad_page.evaluate(\\\"__DE.app.settings.glyphs='xbox';__DE.app.ui.prompts()\\\")\n            require(\\\"A\\\" in pad_page.locator(\\\"#footer-controls\\\").inner_text(), \\\"Xbox glyphs missing\\\")\n            pad_page.evaluate(\\\"__pad.buttons[8].pressed=true\\\")\n            padpress(pad_page, 9)\n            require(pad_page.evaluate(\\\"__DE.app.menu\\\") == \\\"pause\\\", \\\"Create+Options was consumed\\\")\n            pad_page.evaluate(\\\"__pad.buttons[8].pressed=false\\\")\n            padpress(pad_page, 1)\n            require(pad_page.evaluate(\\\"__DE.app.menu\\\") is None, \\\"Circle did not back out\\\")\n        check(\\\"standard Gamepad API gameplay, menus and glyph switching\\\", controller)\n        pad_context.close()\n\n        phone_context = browser.new_context(**pw.devices[\\\"iPhone 13\\\"])\n        phone = phone_context.new_page()\n        phone.on(\\\"pageerror\\\", lambda e: errors.append(str(e)))\n        phone.goto(origin + \\\"/index.html?renderer=webgl\\\")\n        def touch():\n            ready(phone)\n            phone.screenshot(path=str(ART / \\\"phone-title.png\\\"))\n            tap(phone, \\\"SOLO SORTIE\\\")\n            tap(phone, \\\"LAUNCH SORTIE\\\")\n            phone.evaluate(\\\"__DE.game.startWave(0);__DE.game.tuning.god=true\\\")\n            phone.wait_for_timeout(350)\n            require(phone.evaluate(\\\"__DE.app.input.mode\\\") == \\\"touch\\\", \\\"touch mode not selected\\\")\n            require(phone.evaluate(\\\"__DE.game.stats.shots\\\") > 0, \\\"touch auto-fire failed\\\")\n            x = phone.evaluate(\\\"__DE.game.players[0].x\\\")\n            phone.dispatch_event(\\\"#stage\\\", \\\"pointerdown\\\", {\\\"pointerType\\\":\\\"touch\\\",\\\"pointerId\\\":11,\\\"clientX\\\":100,\\\"clientY\\\":650})\n            phone.dispatch_event(\\\"#stage\\\", \\\"pointermove\\\", {\\\"pointerType\\\":\\\"touch\\\",\\\"pointerId\\\":11,\\\"clientX\\\":210,\\\"clientY\\\":650})\n            phone.wait_for_timeout(250)\n            require(phone.evaluate(\\\"__DE.game.players[0].x\\\") > x, \\\"invisible touch steering failed\\\")\n            phone.dispatch_event(\\\"#stage\\\", \\\"pointerdown\\\", {\\\"pointerType\\\":\\\"touch\\\",\\\"pointerId\\\":12,\\\"clientX\\\":270,\\\"clientY\\\":650})\n            phone.wait_for_timeout(100)\n            require(phone.evaluate(\\\"__DE.game.stats.dashes\\\") > 0, \\\"two-finger dash failed\\\")\n            phone.dispatch_event(\\\"#stage\\\", \\\"pointerup\\\", {\\\"pointerType\\\":\\\"touch\\\",\\\"pointerId\\\":11})\n            phone.dispatch_event(\\\"#stage\\\", \\\"pointerup\\\", {\\\"pointerType\\\":\\\"touch\\\",\\\"pointerId\\\":12})\n            phone.evaluate(\\\"__DE.game.players[0].charge=100\\\")\n            phone.wait_for_timeout(200)\n            tap(phone, \\\"✦\\\")\n            require(phone.evaluate(\\\"__DE.game.stats.encores\\\") > 0, \\\"touch Encore pop-up failed\\\")\n            phone.screenshot(path=str(ART / \\\"phone-game.png\\\"))\n        check(\\\"phone touch, invisible steering, auto-fire and contextual Encore\\\", touch)\n        phone_context.close()\n\n        host_context = browser.new_context(viewport={\\\"width\\\": 960, \\\"height\\\": 720})\n        guest_context = browser.new_context(viewport={\\\"width\\\": 960, \\\"height\\\": 720})\n        host = host_context.new_page()\n        guest = guest_context.new_page()\n        host.on(\\\"pageerror\\\", lambda e: errors.append(str(e)))\n        guest.on(\\\"pageerror\\\", lambda e: errors.append(str(e)))\n        host.goto(origin + \\\"/index.html?renderer=webgl\\\")\n        guest.goto(origin + \\\"/index.html?renderer=webgl\\\")\n        def peer():\n            ready(host)\n            ready(guest)\n            offer = host.evaluate(\\\"async()=>await __DE.net.offer()\\\")\n            answer = guest.evaluate(\\\"async(code)=>await __DE.net.answer(code)\\\", offer)\n            host.evaluate(\\\"async(code)=>await __DE.net.accept(code)\\\", answer)\n            host.wait_for_function(\\\"__DE.net.active&&__DE.app.started\\\", timeout=15000)\n            guest.wait_for_function(\\\"__DE.app.started&&__DE.game?.players.length===2\\\", timeout=15000)\n            guest.evaluate(\\\"__DE.app.input.target=3;__DE.app.input.mouseFire=true\\\")\n            guest.wait_for_timeout(500)\n            host.wait_for_timeout(250)\n            require(host.evaluate(\\\"__DE.net.received\\\") > 0 and guest.evaluate(\\\"__DE.net.received\\\") > 0, \\\"traffic not bidirectional\\\")\n            require(host.evaluate(\\\"__DE.game.players[1].x\\\") > 1, \\\"guest input not authoritative on host\\\")\n            hx = host.evaluate(\\\"__DE.game.players[1].x\\\")\n            gx = guest.evaluate(\\\"__DE.game.players[1].x\\\")\n            require(abs(hx - gx) < 1, \\\"remote world diverged\\\")\n            metrics[\\\"directLink\\\"] = {\\\"hostReceived\\\":host.evaluate(\\\"__DE.net.received\\\"),\\\"guestReceived\\\":guest.evaluate(\\\"__DE.net.received\\\")}\n            guest.evaluate(\\\"__DE.app.hangar();__DE.app.action('launch')\\\")\n            require(guest.evaluate(\\\"__DE.net.host\\\") and not guest.evaluate(\\\"__DE.net.active\\\"), \\\"guest could not return to solo\\\")\n        check(\\\"real two-page WebRTC co-op and return to solo\\\", peer)\n        host_context.close()\n        guest_context.close()\n\n        metrics[\\\"hub\\\"] = []\n        for players, scenario, latency, jitter, loss in [\n            (2, \\\"standard\\\", 0, 0, 0),\n            (4, \\\"standard\\\", 150, 50, 5),\n            (4, \\\"host-leave\\\", 150, 50, 5),\n            (2, \\\"server\\\", 0, 0, 0),\n        ]:\n            hub_context = browser.new_context(viewport={\\\"width\\\": 1600, \\\"height\\\": 1000})\n            hub_page = hub_context.new_page()\n            params = urlencode({\\\"game\\\":\\\"../../index.html\\\",\\\"players\\\":players,\\\"scenario\\\":scenario,\n                                \\\"latency\\\":latency,\\\"jitter\\\":jitter,\\\"loss\\\":loss,\\\"auto\\\":1,\\\"limit\\\":30,\\\"play\\\":3500})\n            hub_page.goto(origin + \\\"/vendor/hub/harness.html?\\\" + params)\n            def hub_run():\n                hub_page.wait_for_function(\\\"document.body.dataset.complete==='true'\\\", timeout=65000)\n                result = hub_page.evaluate(\\\"__hubCheck\\\")\n                metrics[\\\"hub\\\"].append(result)\n                bad = [c[\\\"name\\\"] + \\\" \\\" + c[\\\"detail\\\"] for c in result[\\\"checks\\\"] if not c[\\\"pass\\\"]]\n                require(result[\\\"pass\\\"], \\\"; \\\".join(bad))\n                frames = [f for f in hub_page.frames if \\\"index.html\\\" in f.url]\n                require(all(f.evaluate(\\\"__DE.net.ended\\\") for f in frames), \\\"end did not freeze every copy\\\")\n            check(\\\"AI Hub \\\" + scenario + \\\" / \\\" + str(players) + \\\" players / loss \\\" + str(loss), hub_run)\n            hub_context.close()\n\n        check(\\\"no runtime errors across controller, touch and multiplayer\\\", lambda: require(not errors, \\\"; \\\".join(errors)))\n        browser.close()\n\n        safari = pw.webkit.launch(headless=True)\n        safari_context = safari.new_context(viewport={\\\"width\\\": 1280,\\\"height\\\":800})\n        safari_page = safari_context.new_page()\n        safari_errors = []\n        safari_page.on(\\\"pageerror\\\", lambda e: safari_errors.append(str(e)))\n        safari_page.goto(origin + \\\"/index.html\\\")\n        def webkit():\n            ready(safari_page)\n            require(safari_page.evaluate(\\\"__DE.state.backend\\\") == \\\"WebGL 2\\\", \\\"automatic WebGL fallback failed\\\")\n            safari_page.evaluate(\\\"__DE.app.begin();__DE.app.manual=true;__DE.simulate(5,{0:{fire:true}})\\\")\n            require(safari_page.evaluate(\\\"__DE.game.stats.shots\\\") > 0, \\\"WebKit cannot play\\\")\n            require(not safari_errors, \\\"; \\\".join(safari_errors))\n        check(\\\"WebKit automatic fallback and gameplay\\\", webkit)\n        safari_context.close()\n        safari.close()\nfinally:\n    server.shutdown()\n    server.server_close()\n    thread.join(timeout=2)\n\n(ART / \\\"test-results.json\\\").write_text(json.dumps({\\\"passed\\\": count, \\\"failures\\\": failures, \\\"metrics\\\": metrics}, indent=2))\nfor failure in failures:\n    print(\\\"FAIL \\\" + failure)\nprint(str(count) + \\\" passed; \\\" + str(len(failures)) + \\\" failed\\\")\nsys.exit(1 if failures else 0)\nPY\nnpm test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_55","type":"agent_message","text":"The expanded test command now covers controller and keyboard input, mouse positioning, touch controls, settings persistence, generated audio levels, and two-device WebRTC co-op. It also runs the supplied Hub harness for four-player packet loss, host departure, and a host with no player seat.\n"}}
