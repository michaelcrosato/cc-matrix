{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"rg -n 'standings|not-in|finish|scores' vendor/hub/round.js | tail -n 38\"","aggregated_output":"68: * Parallel and ghost order: finishers by time, then the rest by score,\n69: * then anyone who reported nothing, tied last. Equal times or scores share a\n134: * Check a host's standings: groups of ids, best first, every present player\n138:export function checkStandings(standings, presentIds, allIds) {\n139:  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\n143:  for (const group of standings) {\n155:  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\n158:  return { ok: true, standings: groups };\n314:    if (!left.length) return finishVoid('no-players');\n316:      return finishVoid(host.out === 'not-ready' ? 'host-not-ready' : 'host-left', phase === 'loading' ? 'void' : 'host-left');\n322:    if (selfReported() && left.every((s) => s.result)) finishResults();\n345:      if (selfReported()) finishResults();\n346:      else finishVoid('no-result');\n351:  function finishResults() {\n359:    const scores = {};\n360:    for (const [id, r] of results) scores[id] = Number.isFinite(r.time) ? r.time : r.score;\n363:    finishPlayed(gone.length ? [...ranked, gone] : ranked, { scores, results: Object.fromEntries(results), stats, awards });\n366:  function finishPlayed(standings, extra = {}) {\n367:    end({ status: 'played', reason: 'finished', endReason: 'finished', standings, ...extra });\n370:  function finishVoid(reason, endReason = 'void') {\n371:    end({ status: 'void', reason, endReason, standings: null });\n380:    if (outcome.standings) msg.standings = outcome.standings;\n429:      case 'finish': {\n430:        if (selfReported()) return issue(seat, `finish is for a shared world; ${mode} games report result`);\n431:        if (seat !== host) return issue(seat, 'finish from a player who is not the host');\n432:        if (phase === 'loading') return issue(seat, 'finish before start');\n433:        const checked = checkStandings(msg.standings, present().map((s) => s.id), ids);\n434:        if (!checked.ok) return issue(seat, `finish ignored: ${checked.problem}`);\n435:        const scores = msg.scores && typeof msg.scores === 'object' ? msg.scores : undefined;\n441:        return finishPlayed(checked.standings, { scores, won, stats, awards });\n446:          if (needsHost() && seat === host) return finishVoid('host-error');\n455:          seat.hidden = later(t.hiddenMs, () => finishVoid('host-hidden'));\n517:      finishVoid(reason, reason === 'session-ended' ? 'session-ended' : 'void');\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"sed -n '134,159p' vendor/hub/round.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"sed -n '134,159p' vendor/hub/round.js\"","aggregated_output":" * Check a host's standings: groups of ids, best first, every present player\n * exactly once. Players already gone may be placed or left out; whoever is\n * left out lands in a last group of their own.\n */\nexport function checkStandings(standings, presentIds, allIds) {\n  if (!Array.isArray(standings)) return { ok: false, problem: 'standings is not an array' };\n  const all = new Set(allIds);\n  const seen = new Set();\n  const groups = [];\n  for (const group of standings) {\n    const ids = Array.isArray(group) ? group : [group];\n    const kept = [];\n    for (const id of ids) {\n      if (!Number.isInteger(id) || !all.has(id)) return { ok: false, problem: `unknown player id ${JSON.stringify(id)}` };\n      if (seen.has(id)) return { ok: false, problem: `player ${id} is placed twice` };\n      seen.add(id);\n      kept.push(id);\n    }\n    if (kept.length) groups.push(kept);\n  }\n  const missing = presentIds.filter((id) => !seen.has(id));\n  if (missing.length) return { ok: false, problem: `standings leave out player${missing.length > 1 ? 's' : ''} ${missing.join(', ')}` };\n  const absent = allIds.filter((id) => !seen.has(id));\n  if (absent.length) groups.push(absent);\n  return { ok: true, standings: groups };\n}\n","exit_code":0,"status":"completed"}}
