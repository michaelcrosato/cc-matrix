width:640px){.esh .esh-mod{padding:18px}.esh .esh-mod h2{font-size:25px}.esh .esh-m{font-size:14px}.esh button{font-size:14px}.esh .esh-hb{width:max-content;max-width:94vw;flex-wrap:wrap}.esh .esh-hb button{min-width:80px;padding:9px}.esh .esh-sh{padding-top:55px}}@media(prefers-reduced-motion:reduce){.esh *{animation:none\"'!important;transition:none!important}}\nEOF\ncat > tools/build.mjs <<'\"'EOF'\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {resolve,dirname} from 'node:path';\nimport {fileURLToPath} from 'node:url';\nconst root=resolve(dirname(fileURLToPath(import.meta.url)),'..');\nconst read=p=>readFileSync(resolve(root,p),'utf8');\nconst release=JSON.parse(read('release.json'));\nconst modules=['tuning','content','simulation','pilot','rigs','audio','presentation','input','screens','network','main'];\nconst escaped=s=>s.replace(/<\\\\/script/gi,'<\\\\\\\\/script');\nlet report={};try{report=JSON.parse(read('../exit-interview.json'));}catch{}\nconst html=\"'`<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><script>${read('\"'vendor/hub/session.js')}</script>\n<meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1,viewport-fit=cover\\\">\n<meta name=\\\"hub:session\\\" content=\\\"1\\\"><meta name=\\\"hub:session-players\\\" content=\\\"1-2\\\"><meta name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\">\n<meta name=\\\"hub:session-goal\\\" content=\\\"Save six gardens. Spray bees, feed combs to Pip and open the pageant shields with red harvests.\\\">\n<meta name=\\\"hub:session-howto\\\" content=\\\"Move: stick or A/D. Spray: Cross/R2 or Space. Call Pip: Square or E. Touch: drag below, tap combs. Shared score and cans.\\\">\n<meta name=\\\"hub:session-minutes\\\" content=\\\"15\\\"><meta name=\\\"description\\\" content=\\\"A tactical garden arcade: spritz responsibly, feed extravagantly.\\\">\n<title>\"'${release.title}</title><style>${read('\"'src/style.css')}</style></head><body><canvas id=\\\"screen\\\" aria-label=\\\"Buzz Comb Party garden arcade\\\"></canvas>\n<script>\"'${escaped(read('\"'vendor/engine/my-3d2dge.js'))}</script>\n<script>globalThis.BCP={REPORT:\"'${JSON.stringify(report).replaceAll('\"'<','\\\\\\\\u003c')}};</script>\n<script>\"'${escaped(modules.map(f=>read('\"'src/'+f+'.js')).join('\\\\n'))}</script></body></html>\"'`;\nwriteFileSync(resolve(root,'\"'../'+release.basename+'.html'),html);\nwriteFileSync(resolve(root,'evidence/build.json'),JSON.stringify({title:release.title,bytes:Buffer.byteLength(html),engineRevision:release.engineRevision,hubRevision:release.hubRevision,modules},null,2));\nif(\"'!process.argv.includes('\"'--quiet'))console.log(release.basename+'.html ('+Buffer.byteLength(html)+' bytes)');\nEOF\nnpm run build\"","aggregated_output":"npm notice run buzz-comb-party@1.0.0 build\nnpm notice run node tools/build.mjs\nBuzz-Comb-Party-Buzz-Bombers-1983-gpt-6.1-sol-max-20261106-045748.html (1376505 bytes)\n","exit_code":0,"status":"completed"}}
