seconds\n2375:     *  hit-stop left (freeze: a scene's entry ends it); timeScale: game speed, 1 normal, .25 slow motion, 0 stopped (it outlives a scene change: a game's speed setting; restore a slow motion with a k [... omitted end of long line]\n2377:    this.time = 0; this.real = 0; this.hitstop = 0; this.timeScale = 1; this._shakeAmt = 0; this.reduceMotion = !this.headless && !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)') [... omitted end of long line]\n2405:     *  errors caught in update and draw, each { where, scene, message, stack }, once per kind; live: true (o.live): a pause\n2408:    this.paused = false; this.pauseOverlay = true; this._timers = []; this.errors = []; this._errKeys = new Set(); this.live = !!o.live; this._goOn = false;\n2544:  resume() { this.paused = false; this.pauseReason = null; this._goOn = false; }\n2552:   * o: { pause: false } opens it over a world that keeps stepping, as game.live does for every pause. Returns true when\n2557:    if (o && o.pause === false && !this.paused) this._goOn = true;   // (until it resumes)\n2690:   *  watcher of the whole game: it outlives scenes, as a kept tween does). Returns { cancel() } */\n2800:    const live = !this.headless && this.o.loop !== false && hooks.boot !== false && typeof document !== 'undefined';\n2804:    if (live) { BOOT._open(this, o); BOOT._checks(this); }\n2812:        if (live) BOOT._step(i, n, label);\n2814:        const ok = () => { if (live) BOOT._line('  ' + (i + '. ').padEnd(4), label + ' · ' + Math.round(now() - s0) + ' ms'); };\n2815:        if (r && typeof r.then === 'function') { r.then(() => { ok(); live ? requestAnimationFrame(next) : next(); }, e => fail(label, e)); return; }\n2816:        ok(); if (live) { requestAnimationFrame(next); return; }   // one step a frame: the screen shows each\n2818:      if (live && o.min && now() - t0 < o.min * 1000) { requestAnimationFrame(next); return; }\n2819:      if (live) BOOT._step(n + 1, n + 1, 'Warming up');\n2860:   * each whole o.step of it (1/120 s) runs one update of o.step * timeScale game seconds (split in two or more when\n  /** browser client coords -> projected screen pixels (same space as view.p) */\n  clientToScreen(cx, cy) {\n    if (!this.canvas) return null;\n    const rc = this.canvas.getBoundingClientRect(), dx = (cx - rc.left) * this.dpr, dy = (cy - rc.top) * this.dpr;\n    return [(dx - this.OX + Math.round(this.fx * this.S)) / this.S + this.ix, (dy - this.OY + Math.round(this.fy * this.S)) / this.S + this.iy];\n  }\n}\n\n/* =============================================================================\n * 5. INPUT  keyboard, mouse, gamepad, touch stick, on-screen buttons\n *    Actions are names you choose. Codes: KeyboardEvent.code, 'Mouse0'/'Mouse2',\n *    'Pad0'..'Pad15' (standard gamepad buttons). Every action also accepts\n *    'Act:<name>' so DOM buttons with data-act=\"<name>\" work automatically.\n","exit_code":0,"status":"completed"}}
