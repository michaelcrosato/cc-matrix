{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"cat > tests/touch-focus.py <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json\nbase=Path.cwd();r=json.loads((base/'release.json').read_text());url=(base.parent/(r['basename']+'.html')).as_uri()\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True);c=b.new_context(**p.devices['iPhone 13']);page=c.new_page();page.on('pageerror',lambda e:print('ERROR',e,flush=True));page.goto(url);page.wait_for_function('window.__BUZZ?.ready');page.evaluate('__BUZZ.start();__game.advance(3);__game.stop();null')\n def state(label): print(label,page.evaluate('({paused:__game.paused,screen:__game.shell.screen,ctx:__BUZZ.adapter.context,dev:__game.input.lastDevice,can:__BUZZ.world.players[0].x,combs:__BUZZ.world.obstacles.map(o=>[o.id,o.x,o.y]),pulses:__BUZZ.world.pulses.map(o=>[o.x,o.y]),drag:__game.input.drag(),dims:[__game.W,__game.H],scale:__game.screen.S,events:window.__taps})'),flush=True)\n def point(y):return page.evaluate(\\\"y=>{const s=__game.screen,rc=s.canvas.getBoundingClientRect(),x=(__game.W-640)/2+320,yy=(__game.H-360)/2+y;return {x:rc.left+(x*s.S+s.OX)/s.dpr,y:rc.top+(yy*s.S+s.OY)/s.dpr};}\\\",y)\n lower=point(300);cdp=c.new_cdp_session(page)\n cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':lower['x'],'y':lower['y'],'id':1}]});cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':lower['x']+45,'y':lower['y'],'id':1}]});page.evaluate('__game.advance(.1)');cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n page.evaluate(\\\"const w=__BUZZ.world;w.bird.state='retreat';w.bird.timer=99;BCP.spawnBee(w,{x:w.players[0].x,tier:6,kind:'worker',dir:1,reward:'touch-proof'});__game.input.lastDevice='touch';__game.advance(.2)\\\")\n page.evaluate(\\\"__game.input.lastDevice='touch';__BUZZ.world.bird.state='idle';__BUZZ.world.bird.timer=20;__BUZZ.world.obstacles=[];BCP.placeComb(__BUZZ.world,320,3,true,'touch-context');__game.advance(.02)\\\")\n page.evaluate(\\\"window.__taps=[];window.addEventListener('pointerdown',e=>{const p=__game.input.screenPoint(e.clientX,e.clientY);__taps.push({p,x:p[0]-(__game.W-640)/2,y:p[1]-(__game.H-360)/2,target:e.target.tagName,ctx:__BUZZ.adapter.context});},true)\\\")\n state('before');pt=point(173);print('tap',pt,flush=True);page.touchscreen.tap(pt['x'],pt['y']);state('raw after');page.evaluate('__game.advance(.05,{draw:true})');state('after ticks');print('buttons',page.locator('button').all_text_contents(),flush=True);page.screenshot(path=str(base/'evidence/touch-focus.png'));c.close();b.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python -u tests/touch-focus.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"cat > tests/touch-focus.py <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json\nbase=Path.cwd();r=json.loads((base/'release.json').read_text());url=(base.parent/(r['basename']+'.html')).as_uri()\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True);c=b.new_context(**p.devices['iPhone 13']);page=c.new_page();page.on('pageerror',lambda e:print('ERROR',e,flush=True));page.goto(url);page.wait_for_function('window.__BUZZ?.ready');page.evaluate('__BUZZ.start();__game.advance(3);__game.stop();null')\n def state(label): print(label,page.evaluate('({paused:__game.paused,screen:__game.shell.screen,ctx:__BUZZ.adapter.context,dev:__game.input.lastDevice,can:__BUZZ.world.players[0].x,combs:__BUZZ.world.obstacles.map(o=>[o.id,o.x,o.y]),pulses:__BUZZ.world.pulses.map(o=>[o.x,o.y]),drag:__game.input.drag(),dims:[__game.W,__game.H],scale:__game.screen.S,events:window.__taps})'),flush=True)\n def point(y):return page.evaluate(\\\"y=>{const s=__game.screen,rc=s.canvas.getBoundingClientRect(),x=(__game.W-640)/2+320,yy=(__game.H-360)/2+y;return {x:rc.left+(x*s.S+s.OX)/s.dpr,y:rc.top+(yy*s.S+s.OY)/s.dpr};}\\\",y)\n lower=point(300);cdp=c.new_cdp_session(page)\n cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':lower['x'],'y':lower['y'],'id':1}]});cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':lower['x']+45,'y':lower['y'],'id':1}]});page.evaluate('__game.advance(.1)');cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n page.evaluate(\\\"const w=__BUZZ.world;w.bird.state='retreat';w.bird.timer=99;BCP.spawnBee(w,{x:w.players[0].x,tier:6,kind:'worker',dir:1,reward:'touch-proof'});__game.input.lastDevice='touch';__game.advance(.2)\\\")\n page.evaluate(\\\"__game.input.lastDevice='touch';__BUZZ.world.bird.state='idle';__BUZZ.world.bird.timer=20;__BUZZ.world.obstacles=[];BCP.placeComb(__BUZZ.world,320,3,true,'touch-context');__game.advance(.02)\\\")\n page.evaluate(\\\"window.__taps=[];window.addEventListener('pointerdown',e=>{const p=__game.input.screenPoint(e.clientX,e.clientY);__taps.push({p,x:p[0]-(__game.W-640)/2,y:p[1]-(__game.H-360)/2,target:e.target.tagName,ctx:__BUZZ.adapter.context});},true)\\\")\n state('before');pt=point(173);print('tap',pt,flush=True);page.touchscreen.tap(pt['x'],pt['y']);state('raw after');page.evaluate('__game.advance(.05,{draw:true})');state('after ticks');print('buttons',page.locator('button').all_text_contents(),flush=True);page.screenshot(path=str(base/'evidence/touch-focus.png'));c.close();b.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python -u tests/touch-focus.py\"","aggregated_output":"before {'paused': False, 'screen': None, 'ctx': 0, 'dev': 'touch', 'can': 320.13194444444446, 'combs': [], 'pulses': [], 'drag': None, 'dims': [640, 1090], 'scale': 1.828125, 'events': []}\ntap {'x': 195, 'y': 327.5104166666667}\nraw after {'paused': False, 'screen': None, 'ctx': 0, 'dev': 'touch', 'can': 320.13194444444446, 'combs': [], 'pulses': [], 'drag': None, 'dims': [640, 1090], 'scale': 1.828125, 'events': [{'p': [320, 537.9999833066239], 'x': 320, 'y': 172.9999833066239, 'target': 'CANVAS', 'ctx': 0}]}\nafter ticks {'paused': False, 'screen': None, 'ctx': 0, 'dev': 'touch', 'can': 320.13194444444446, 'combs': [], 'pulses': [], 'drag': None, 'dims': [640, 1090], 'scale': 1.828125, 'events': [{'p': [320, 537.9999833066239], 'x': 320, 'y': 172.9999833066239, 'target': 'CANVAS', 'ctx': 0}]}\nbuttons ['', '']\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/input.js';s=open(p).read().replace('callCounter=0,callAim=null,activityAt=0','callCounter=0,callAim=null,touchAim=null,activityAt=0').replace(\\\"else{context=0;clearId=0;}\\\\n      },\\\",\\\"else{context=0;clearId=0;const seat=B.app?.localSeat||1;touchAim=w.players.find(p=>p.seat===seat)?.x??w.players[0]?.x??320;}\\\\n      },\\\")\ns=s.replace('callCounter=0;callAim=null;for(const q','callCounter=0;callAim=null;touchAim=null;for(const q')\nold=\\\"const drag=input.drag();if(drag&&Math.abs(drag[0])>.12){aim=p.x+drag[0]*1.55;clearId=0;context=0;}else move=0;\\\"\nnew=\\\"const drag=input.drag();if(drag&&Math.abs(drag[0])>.12){touchAim=Math.max(28,Math.min(612,(touchAim??p.x)+drag[0]*1.55));clearId=0;context=0;}move=0;if(touchAim\"'!==null)aim=touchAim;\"\nassert old in s;s=s.replace(old,new)\ns=s.replace(\"clearId=o.id;context=0;\",\"clearId=o.id;touchAim=null;context=0;\")\nopen(p,'\"'w').write(s)\np='tests/browser.py';s=open(p).read().replace(\\\"phone.evaluate('__game.advance(.1)')\\\",\\\"phone.evaluate('__game.advance(.3)')\\\").replace(\\\"phone.evaluate('__BUZZ.world.players[0].x')\"'!=before\",\"phone.evaluate('\"'__BUZZ.world.players[0].x')>before+12\\\")\ns=s.replace(\\\"__BUZZ.world.bird.timer=20; __BUZZ.world.obstacles=[];\\\",\\\"__BUZZ.world.bird.timer=20;__BUZZ.world.pulses=[]; __BUZZ.world.obstacles=[];\\\")\nopen(p,'w').write(s)\nimport json\np='docs/issues.json';items=json.load(open(p));items.append({'id':'I008','critical':True,'foundBy':'Focused phone steering/parcel diagnostic after a weak movement assertion','issue':'Touch drag intent lasted only one fixed tick, so acceleration moved a can just a fraction of a pixel per swipe.','fix':'Retain the requested touch column across ticks and drive it through normal can motion; deliberate steering cancels clearing. Strengthen the browser distance assertion.','verified':False});json.dump(items,open(p,'w'),indent=2)\np='tools/write-interview.mjs';s=open(p).read().replace(\\\"\"'${issues.filter(i=>i.critical).length} critical issue: translated custom actors were invisible because the native crop tracker ignored their Canvas transforms.\",\"${issues.filter(i=>i.critical).length} critical issues: transformed actors were invisible, and one-tick touch drag intent barely moved the can. Both are fixed and covered.\")\nopen(p,'\"'w').write(s)\nPY\nnode tools/write-interview.mjs\nnode tools/build.mjs --quiet\n/home/micha/.local/share/pipx/venvs/playwright/bin/python -u tests/browser.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
