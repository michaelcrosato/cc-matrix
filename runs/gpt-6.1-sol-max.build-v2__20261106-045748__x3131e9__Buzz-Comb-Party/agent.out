nd spray use bounded can travel\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"parked pointer does not fight keyboard movement\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"controller disconnect pauses standalone and explains recovery\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"attract waits until ten seconds of real idle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"ten-second idle starts real simulation demonstration\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"keyboard attract wake is consumed at title\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"pointer movement interrupts attract and is consumed\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"analog movement below gameplay dead zone wakes attract\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"controller button wake cannot also start a run\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"attract and assisted play do not write normal records\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"assembled game ordinary-input whole campaign reaches real win card\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"unassisted full campaign updates local records once\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"win card can start a clean fresh run\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"keyboard plus pad assigns exclusive devices\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"one pad cannot control both co-op cans\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"shared keyboard controls simultaneous independent cans\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"code audio produces finite non-silent non-clipped output\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"music bus ten-percent gain and mute are correct\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"audio teardown stops generated voice nodes\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Chromium session has no page or native game errors\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"touch drag steers the can with invisible controls\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"safe touch assistance fires useful ordinary spray\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"touch parcel tap exposes contextual actions\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"touch harvest uses the ordinary shared call\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"touch menu opens native pause\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"orientation change preserves canonical arena geometry\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"touch rotation draws without native or page errors\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"WebKit boots, takes input and draws native game without errors\", \"pass\": true, \"detail\": \"\"}]}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_88","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='tests/browser.py';s=open(p).read();marker=\\\"  shot(phone,'touch-landscape.png')\\\\n\\\"\nextra=\\\"\\\"\\\"  # Real multi-touch steering plus a second touch, then cancellation releases both.\n  lower=phone.evaluate(\\\"(()=>{const s=__game.screen,rc=s.canvas.getBoundingClientRect();return {x:rc.left+((__game.W-640)/2+320)*s.S/s.dpr+s.OX/s.dpr,y:rc.top+((__game.H-360)/2+300)*s.S/s.dpr+s.OY/s.dpr};})()\\\")\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':lower['x'],'y':lower['y'],'id':1},{'x':lower['x']+70,'y':lower['y']-65,'id':2}]})\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':lower['x']+35,'y':lower['y'],'id':1},{'x':lower['x']+70,'y':lower['y']-65,'id':2}]})\n  phone.evaluate('__game.advance(.1)')\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchCancel','touchPoints':[]})\n  phone.evaluate('__game.advance(.1)')\n  check('multi-touch cancellation releases invisible steering',phone.evaluate('\"'!__game.input.stickOn && __game.input._fingers.size===0'\"'))\n  phone.evaluate('__BUZZ.title();__game.advance(.3);__BUZZ.adapter.activityAt=__game.real;__game.advance(10.02)')\n  phone.touchscreen.tap(300,150);phone.evaluate('__game.advance(.05)')\n  check('touch wakes attract and consumes its opening tap',phone.evaluate(\\\"\"'!__BUZZ.attract && __game.sceneName==='\"'title' && \"'!__BUZZ.world\"))\n\"\"\"\nassert marker in s;s=s.replace(marker,marker+extra)\n# About screens all required groups, final release outside its source tree.\nneedle=\"  check('\"'Chromium session has no page or native game errors',\\\"\nidx=s.index(needle)\ns=s[:idx]+\\\"\\\"\\\"  for idx,label in enumerate(['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback']):\n   page.evaluate('i=>__BUZZ.screens.about(i)',idx)\n   check('About includes '+label,page.get_by_role('heading',name=label,exact=True).count()==1)\n   if idx==0:shot(page,'about.png')\n  page.evaluate('__game.shell.hide();__game.advance(.05);null')\n\\\"\\\"\\\"+s[idx:]\n# Storage denied and copied-away release smoke within same browser process.\nneedle='  touch.close();browser.close()'\nreplace=\\\"\\\"\\\"  touch.close()\n  denied=browser.new_context(viewport={'width':960,'height':540})\n  denied.add_init_script(\\\"Object.defineProperty(window,'localStorage',{get(){throw new DOMException('Denied','SecurityError')}})\\\")\n  dp=denied.new_page();dp.goto(url);dp.wait_for_function('window.__BUZZ?.ready');dp.keyboard.press('Enter');dp.wait_for_function(\\\"__game.sceneName==='play'\\\")\n  check('denied local storage falls back to a playable visit',dp.evaluate('__BUZZ.world\"'!==null && __game.errors.length===0'\"'))\n  denied.close()\n  isolated=base/'evidence/isolated-release.html';isolated.write_bytes((base.parent/(release['basename']+'.html')).read_bytes())\n  moved=browser.new_context(viewport={'width':960,'height':540});mp=moved.new_page();mp.goto(isolated.as_uri());mp.wait_for_function('window.__BUZZ?.ready')\n  check('HTML copied away from sources boots without dependencies',marker(mp) and mp.evaluate('__game.errors.length===0'))\n  moved.close();browser.close()\\\"\\\"\\\"\nassert needle in s;s=s.replace(needle,replace)\nopen(p,'w').write(s)\np='tests/hub.py';s=open(p).read();old=\\\"check('Hub '+name+' build identity and lifecycle',state.get('marker')=='buzz-comb-party-20261106' and state.get('ready')==1 and state.get('ended') and state.get('finish',0)<=1 and state.get('bytes',99999)<16384,state)\\\"\nnew=old+\\\"\\\\n     if name=='server' and f.evaluate('AIHub.server'):\\\\n      check('server host owns no controllable seat or audio',f.evaluate('__BUZZ.localSeat===0 && \"'!__BUZZ.world.players.some(p=>p.seat===AIHub.me) && !__game.audio.ctx && __game.input.pad===null'\"'))\\\"\nassert old in s;s=s.replace(old,new)\n# SDK server me is often -1. More direct seat count assertion covers it regardless of ID numbering.\ns=s.replace(\\\"\"'!__BUZZ.world.players.some(p=>p.seat===AIHub.me)\",\"__BUZZ.world.players.length===2\")\n# Avoid any unintentional huge object serialization in page evaluate.\ns=s.replace(\"host.evaluate('\"'__game.shell.hide()')\\\",\\\"host.evaluate('__game.shell.hide();null')\\\")\nopen(p,'w').write(s)\np='tools/test.mjs';s=open(p).read().replace(\\\"import {spawnSync}\\\",\\\"import {writeFileSync} from 'node:fs';\\\\nimport {spawnSync}\\\")\ns=s.replace(\\\"let passed=0,failed=0;\\\",\\\"let passed=0,failed=0;const cases=[];\\\").replace(\\\"const check=(name,pass,detail='')=>{\\\",\\\"const check=(name,pass,detail='')=>{cases.push({name,pass:\"'!!pass,...(!pass?{detail}:{})});\")\ns=s.replace(\"console.log(`Checks:\",\"writeFileSync('\"'evidence/test-summary.json',JSON.stringify({passed,failed,groups:groups.length?groups:['all'],checks:cases},null,2));\\\\nconsole.log(\"'`Checks:\")\nopen(p,'\"'w').write(s)\nPY\ncat > .npmrc <<'EOF'\nloglevel=silent\nEOF\nnode --check tools/test.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
