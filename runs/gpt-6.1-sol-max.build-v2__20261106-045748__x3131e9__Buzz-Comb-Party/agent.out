{"type":"item.completed","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc 'cat evidence/browser-live.json'","aggregated_output":"[{\"name\": \"single-file Chromium boot and build marker\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"default music and PlayStation glyphs\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"standard controller starts the game without a mouse\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"stick movement plus Cross sprays\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"R2 also sprays\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Square calls Pip through shared ability\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Options pauses all standalone simulation timers\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"live tuning changes real simulation and clamps fill\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"tuning reset restores widgets and simulation\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"developer single tick works while overlay is frozen\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"invalid JSON profile keeps known-good tuning\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"ordinary settings persist across reload\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"settings defaults restore ten-percent music and PS symbols\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"rebindings and device labels come from native input\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"mouse aim and spray use bounded can travel\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"parked pointer does not fight keyboard movement\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"controller disconnect pauses standalone and explains recovery\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"attract waits until ten seconds of real idle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"ten-second idle starts real simulation demonstration\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"keyboard attract wake is consumed at title\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"pointer movement interrupts attract and is consumed\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"analog movement below gameplay dead zone wakes attract\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"controller button wake cannot also start a run\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"attract and assisted play do not write normal records\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"assembled game ordinary-input whole campaign reaches real win card\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"unassisted full campaign updates local records once\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"win card can start a clean fresh run\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"keyboard plus pad assigns exclusive devices\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"one pad cannot control both co-op cans\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"shared keyboard controls simultaneous independent cans\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"code audio produces finite non-silent non-clipped output\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"music bus ten-percent gain and mute are correct\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"audio teardown stops generated voice nodes\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Chromium session has no page or native game errors\", \"pass\": true, \"detail\": \"\"}]","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"cat > tests/build.mjs <<'EOF'\nimport{readFileSync,writeFileSync,existsSync,copyFileSync}from'node:fs';\nimport{createHash}from'node:crypto';\nimport vm from'node:vm';\nconst root=new URL('../',import.meta.url),read=p=>readFileSync(new URL(p,root),'utf8');\nexport async function run(check){\n const rel=JSON.parse(read('release.json')),html=read('../'+rel.basename+'.html'),session=read('vendor/hub/session.js');\n check('release uses exact task filename and one self-contained HTML',html.startsWith('<\"'!doctype html>'\"')&&existsSync(new URL('../'+rel.basename+'.html',root)));\n const scripts=[...html.matchAll(/<script(?:\\\\s[\"'^>]*)?>(['\"\\\\s\\\\S]*?)<\\\\/script>/gi)].map(m=>m[1]);\n check('pristine released session is the first head script after charset',html.includes('<meta charset=\\\"utf-8\\\"><script>'+session+'</script>')&&scripts[0]===session);\n check('Hub metadata advertises tested shared-world 1–2 player game and 15 minute budget',html.includes('name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\"')&&html.includes('name=\\\"hub:session-players\\\" content=\\\"1-2\\\"')&&html.includes('name=\\\"hub:session-minutes\\\" content=\\\"15\\\"'));\n let parseOK=true,reason='';for(let i=1;i<scripts.length;i++){try{new vm.Script(scripts[i]);}catch(e){parseOK=false;reason=e.message;}}check('all assembled JavaScript blocks parse after closing-script escaping',parseOK,reason);\n check('release makes no external module asset or audio requests',\"'!/<(?:script|img|audio|link)[''^>]+(?:src|href)=/i.test(html)&&!/<script[''^>]*type=[\"'\"']module/i.test(html));\n const source=['tuning','content','simulation','pilot','rigs','audio','presentation','input','screens','network','main'].map(f=>read('src/'+f+'.js')).join('\\\\n');\n check('game-owned source has no unfinished placeholders',\"'!/'\"\\\\b(?:TODO|FIXME|placeholder|stubbed)\\\\b/.test(source));\n check('no accidental machine-specific runtime paths in release',\"'!html.includes('\"'/home/micha/dev/')&&\"'!html.includes('\"'/tmp/'));\n const data=JSON.parse(read('../exit-interview.json')),expected=['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'];\n check('exit interview uses exact top-level schema',Object.keys(data).sort().join(',')===expected.sort().join(','));\n const fields=['date','source','plan','genre','perspective','tech','artDirection','animation','audio','online','testing','research','environment','model','usage'];\n check('source information has every filled-in field with exact assigned metadata',fields.every(k=>typeof data.sourceInformation[k]==='string'&&data.sourceInformation[k].length>0)&&data.sourceInformation.plan==='PLAN.md'&&data.sourceInformation.usage==='added on import'&&data.sourceInformation.model==='OpenAI, gpt-6.1-sol, reasoning effort max');\n check('ordered feedback arrays answer all required questions',data.testingFeedback.length===4&&data.engineFeedback.length===6&&data.promptFeedback.length===4&&[...data.testingFeedback,...data.engineFeedback,...data.promptFeedback].every(x=>typeof x==='string'&&x.length>0));\n check('catalogue metadata names the real game and tested scope',data.aiHub.name===rel.title&&data.aiHub.genre==='Shooter'&&data.aiHub.type==='Game'&&data.aiHub.players==='1–2'&&data.aiHub.tags.length>=3&&data.aiHub.tags.length<=6);\n check('all four feedback groups are embedded in About',scripts.some(s=>s.includes('sourceInformation')&&s.includes(data.testingFeedback[0]))&&source.includes('Source Information')&&source.includes('Testing Feedback')&&source.includes('Engine Feedback')&&source.includes('Prompt Feedback'));\n const fixtures=['harness.html','bridge.js','round.js'];const known={};for(const f of fixtures)known[f]=createHash('sha256').update(read('tests/hub/'+f)).digest('hex');\n const manifest=JSON.parse(read('vendor/manifest.json'));check('official Hub fixtures and released client retain pinned hashes',fixtures.every(f=>manifest['tests/hub/'+f]===known[f])&&manifest['vendor/hub/session.js']===createHash('sha256').update(session).digest('hex'));\n check('engine changes are marked and documented',html.includes('BCP fix: actor pixel bounds')&&read('docs/engine-changes.md').includes('Canvas transform'));\n const isolated=new URL('evidence/isolated-release.html',root);copyFileSync(new URL('../'+rel.basename+'.html',root),isolated);check('isolated release copy is byte-identical',readFileSync(isolated,'utf8')===html);\n const summary={sha256:createHash('sha256').update(html).digest('hex'),bytes:Buffer.byteLength(html),scripts:scripts.length,sessionHash:createHash('sha256').update(session).digest('hex')};writeFileSync(new URL('evidence/package-report.json',root),JSON.stringify(summary,null,2));\n}\nEOF\ncat > tools/vendor-manifest.mjs <<'EOF'\nimport{readFileSync,writeFileSync}from'node:fs';import{createHash}from'node:crypto';\nconst files=['vendor/hub/session.js','tests/hub/harness.html','tests/hub/bridge.js','tests/hub/round.js'];\nconst manifest=Object.fromEntries(files.map(f=>[f,createHash('sha256').update(readFileSync(new URL('../'+f,import.meta.url))).digest('hex')]));\nwriteFileSync(new URL('../vendor/manifest.json',import.meta.url),JSON.stringify(manifest,null,2));\nEOF\nnode tools/vendor-manifest.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"cat > tests/build.mjs <<'EOF'\nimport{readFileSync,writeFileSync,existsSync,copyFileSync}from'node:fs';\nimport{createHash}from'node:crypto';\nimport vm from'node:vm';\nconst root=new URL('../',import.meta.url),read=p=>readFileSync(new URL(p,root),'utf8');\nexport async function run(check){\n const rel=JSON.parse(read('release.json')),html=read('../'+rel.basename+'.html'),session=read('vendor/hub/session.js');\n check('release uses exact task filename and one self-contained HTML',html.startsWith('<\"'!doctype html>'\"')&&existsSync(new URL('../'+rel.basename+'.html',root)));\n const scripts=[...html.matchAll(/<script(?:\\\\s[\"'^>]*)?>(['\"\\\\s\\\\S]*?)<\\\\/script>/gi)].map(m=>m[1]);\n check('pristine released session is the first head script after charset',html.includes('<meta charset=\\\"utf-8\\\"><script>'+session+'</script>')&&scripts[0]===session);\n check('Hub metadata advertises tested shared-world 1–2 player game and 15 minute budget',html.includes('name=\\\"hub:session-mode\\\" content=\\\"shared-world\\\"')&&html.includes('name=\\\"hub:session-players\\\" content=\\\"1-2\\\"')&&html.includes('name=\\\"hub:session-minutes\\\" content=\\\"15\\\"'));\n let parseOK=true,reason='';for(let i=1;i<scripts.length;i++){try{new vm.Script(scripts[i]);}catch(e){parseOK=false;reason=e.message;}}check('all assembled JavaScript blocks parse after closing-script escaping',parseOK,reason);\n check('release makes no external module asset or audio requests',\"'!/<(?:script|img|audio|link)[''^>]+(?:src|href)=/i.test(html)&&!/<script[''^>]*type=[\"'\"']module/i.test(html));\n const source=['tuning','content','simulation','pilot','rigs','audio','presentation','input','screens','network','main'].map(f=>read('src/'+f+'.js')).join('\\\\n');\n check('game-owned source has no unfinished placeholders',\"'!/'\"\\\\b(?:TODO|FIXME|placeholder|stubbed)\\\\b/.test(source));\n check('no accidental machine-specific runtime paths in release',\"'!html.includes('\"'/home/micha/dev/')&&\"'!html.includes('\"'/tmp/'));\n const data=JSON.parse(read('../exit-interview.json')),expected=['sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'];\n check('exit interview uses exact top-level schema',Object.keys(data).sort().join(',')===expected.sort().join(','));\n const fields=['date','source','plan','genre','perspective','tech','artDirection','animation','audio','online','testing','research','environment','model','usage'];\n check('source information has every filled-in field with exact assigned metadata',fields.every(k=>typeof data.sourceInformation[k]==='string'&&data.sourceInformation[k].length>0)&&data.sourceInformation.plan==='PLAN.md'&&data.sourceInformation.usage==='added on import'&&data.sourceInformation.model==='OpenAI, gpt-6.1-sol, reasoning effort max');\n check('ordered feedback arrays answer all required questions',data.testingFeedback.length===4&&data.engineFeedback.length===6&&data.promptFeedback.length===4&&[...data.testingFeedback,...data.engineFeedback,...data.promptFeedback].every(x=>typeof x==='string'&&x.length>0));\n check('catalogue metadata names the real game and tested scope',data.aiHub.name===rel.title&&data.aiHub.genre==='Shooter'&&data.aiHub.type==='Game'&&data.aiHub.players==='1–2'&&data.aiHub.tags.length>=3&&data.aiHub.tags.length<=6);\n check('all four feedback groups are embedded in About',scripts.some(s=>s.includes('sourceInformation')&&s.includes(data.testingFeedback[0]))&&source.includes('Source Information')&&source.includes('Testing Feedback')&&source.includes('Engine Feedback')&&source.includes('Prompt Feedback'));\n const fixtures=['harness.html','bridge.js','round.js'];const known={};for(const f of fixtures)known[f]=createHash('sha256').update(read('tests/hub/'+f)).digest('hex');\n const manifest=JSON.parse(read('vendor/manifest.json'));check('official Hub fixtures and released client retain pinned hashes',fixtures.every(f=>manifest['tests/hub/'+f]===known[f])&&manifest['vendor/hub/session.js']===createHash('sha256').update(session).digest('hex'));\n check('engine changes are marked and documented',html.includes('BCP fix: actor pixel bounds')&&read('docs/engine-changes.md').includes('Canvas transform'));\n const isolated=new URL('evidence/isolated-release.html',root);copyFileSync(new URL('../'+rel.basename+'.html',root),isolated);check('isolated release copy is byte-identical',readFileSync(isolated,'utf8')===html);\n const summary={sha256:createHash('sha256').update(html).digest('hex'),bytes:Buffer.byteLength(html),scripts:scripts.length,sessionHash:createHash('sha256').update(session).digest('hex')};writeFileSync(new URL('evidence/package-report.json',root),JSON.stringify(summary,null,2));\n}\nEOF\ncat > tools/vendor-manifest.mjs <<'EOF'\nimport{readFileSync,writeFileSync}from'node:fs';import{createHash}from'node:crypto';\nconst files=['vendor/hub/session.js','tests/hub/harness.html','tests/hub/bridge.js','tests/hub/round.js'];\nconst manifest=Object.fromEntries(files.map(f=>[f,createHash('sha256').update(readFileSync(new URL('../'+f,import.meta.url))).digest('hex')]));\nwriteFileSync(new URL('../vendor/manifest.json',import.meta.url),JSON.stringify(manifest,null,2));\nEOF\nnode tools/vendor-manifest.mjs\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"sed -n '635,727p' vendor/engine/my-3d2dge.js && cat evidence/browser-live.json | tail -c 3000\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"sed -n '635,727p' vendor/engine/my-3d2dge.js && cat evidence/browser-live.json | tail -c 3000\"","aggregated_output":"\n/* =============================================================================\n * 4. SCREEN  low-res buffer, whole-number upscale, sub-pixel camera on present\n * ============================================================================= */\n/** classic console resolutions for new Game({ res: 'snes' }) (width x height in pixels) */\nE.RES = { nes: [256, 240], snes: [256, 224], gb: [160, 144], gbc: [160, 144], gba: [240, 160], genesis: [320, 224], md: [320, 224], pce: [256, 224], n64: [320, 240], ps1: [320, 240], wide: [400, 225] };\nclass Screen {\n  /** the game's low-resolution screen (game.screen: the game makes it): its buffer, scale and letterbox. canvas null: a\n   *  headless game's, sized as a 1280 x 720 window would size it, with nothing to draw on */\n  constructor(canvas, o, signal) {\n    /** canvas: the page's canvas (null in a headless game); o: the sizing options (the game's o) */\n    this.canvas = canvas; this._sctx = canvas ? canvas.getContext('2d') : null; this._o = o;\n    /** buf: the low-resolution buffer the game draws into (W + 2 by H + 2 pixels; null when headless, a stand-in when a\n     *  headless game draws: o.draw); ctx: its 2D context (r.ctx is the same) */\n    this.buf = canvas || (o && o.draw) ? mkCanvas(8, 8) : null; this.ctx = this.buf ? ctx2d(this.buf) : null;\n    /** W, H: the buffer's size in game pixels; S: the whole-number scale up to the canvas; OX, OY: the letterbox\n     *  margins on the canvas, in canvas pixels; dpr: the device pixel ratio used (at most 3) */\n    this.W = 320; this.H = 200; this.S = 3; this.OX = 0; this.OY = 0; this.dpr = 1;\n    /** ix, iy: the camera's whole-pixel offset this frame; fx, fy: its sub-pixel part (0..1, applied when\n     *  presenting); listeners: functions called after every resize */\n    this.ix = 0; this.iy = 0; this.fx = 0; this.fy = 0; this.listeners = [];\n    /** scale: how a fixed resolution fills the screen: 'sharp' (whole-number scale, every pixel the same size, black\n     *  bars unless o.expand grows the picture into them), 'fill' (the largest fit, pixels a device pixel apart in size)\n     *  or 'auto' (fill on high-density screens, phones and tablets, where that difference can't be seen; sharp\n     *  elsewhere). game.settings.scale sets it; filter: 'clean' | 'scanlines' | 'crt', drawn over the picture as it is\n     *  presented, never on the buffer, and not under a test harness (navigator.webdriver). game.settings.filter sets it */\n    this.scale = 'auto'; this.filter = 'clean';\n    this.resize();\n    if (canvas) addEventListener('resize', () => this.resize(), { signal });\n  }\n  /**\n   * the sizing options in force: the game's, with o.portrait's over them while the screen is taller than wide (a phone\n   * held upright). new Game({ maxH: 330, portrait: { maxH: 1000 } }) lets the picture grow to fill a 9:16 screen\n   */\n  _options(pw, ph) { const o = this._o; return o.portrait && ph > pw ? Object.assign({}, o, o.portrait) : o; }\n  /** fixed internal size from o.res ('snes', [256, 224], ...) or null for the adaptive size */\n  _fixedRes(o = this._o) {\n    const r = o.res; if (!r) return null;\n    const v = Array.isArray(r) ? r : E.RES[String(r).toLowerCase()];\n    if (!v) { warn('res:' + r, 'unknown res \"' + r + '\". Use one of ' + Object.keys(E.RES).join(', ') + ' or [width, height]'); return null; }\n    return [Math.max(16, v[0] | 0), Math.max(16, v[1] | 0)];\n  }\n  /** fit the buffer to the canvas again (on window resize; after changing sizing options, setOptions does it) */\n  resize() {\n    const c = this.canvas, dpr = c ? Math.min(window.devicePixelRatio || 1, 3) : 1, rc = c ? c.getBoundingClientRect() : { width: 1280, height: 720 };\n    const pw = Math.max(1, Math.round(rc.width * dpr)), ph = Math.max(1, Math.round(rc.height * dpr)), o = this._options(pw, ph);\n    /** portrait: true while the screen is taller than wide (a phone held upright) */\n    if (c) { c.width = pw; c.height = ph; } this.dpr = dpr; this.portrait = ph > pw;\n    const fix = this._fixedRes(o);\n    if (fix) {\n      // fixed resolution: whole-number scale, letterboxed (or the largest fit: scale). HUD pixel positions stay the same on every screen.\n      // o.expand: the resolution is the least the screen shows, and the picture grows on both sides to fill the window\n      // (no bars at any shape, up to expand.maxW x maxH): a HUD anchors to W and H\n      const fit = Math.min(pw / fix[0], ph / fix[1]), fill = this.scale === 'fill' || (this.scale === 'auto' && dpr >= 2 && fit >= 2), x = o.expand;\n      this.S = fill ? Math.max(1, fit) : Math.max(1, Math.min(Math.floor(pw / fix[0]), Math.floor(ph / fix[1])));\n      this.W = x ? clamp(Math.ceil(pw / this.S - 1e-6), fix[0], Math.max(fix[0], x.maxW || 1e4)) : fix[0]; this.H = x ? clamp(Math.ceil(ph / this.S - 1e-6), fix[1], Math.max(fix[1], x.maxH || 1e4)) : fix[1];   // (a cap never cuts below res)\n    } else {\n      const S = Math.max(1, Math.min(Math.floor(ph / o.minH), Math.floor(pw / o.minW)));\n      this.S = S; this.W = Math.min(o.maxW, Math.ceil(pw / S)); this.H = Math.min(o.maxH, Math.ceil(ph / S));\n    }\n    this.OX = Math.floor((pw - this.W * this.S) / 2); this.OY = Math.floor((ph - this.H * this.S) / 2);\n    if (this.buf) { this.buf.width = this.W + 2; this.buf.height = this.H + 2; this.ctx = ctx2d(this.buf); this.ctx._c = null; }\n    for (const f of this.listeners) f();\n  }\n  /** change sizing at runtime, e.g. { minH: 400, maxW: 1080, maxH: 660 } to pull the camera back */\n  setOptions(o) { Object.assign(this._o, o); this.resize(); }\n  /** how a fixed resolution fills the screen: 'sharp' | 'fill' | 'auto' (see scale) */\n  setScale(v) { this.scale = v === 'sharp' || v === 'fill' ? v : 'auto'; this.resize(); }\n  /** clear: true when the game's bg is null (or 'transparent'): the buffer and the canvas are cleared instead of filled,\n   *  so a picture under the canvas shows through the game's (a 3D world drawn by engine/my-3d2dge-3d.js) */\n  get clear() { return this._o.bg == null || this._o.bg === 'transparent'; }\n  /** start a frame: clear the buffer to bg with the camera at (cx, cy) projected pixels (the renderer calls it) */\n  _begin(cx, cy, bg, vp) {\n    this.ix = Math.floor(cx); this.iy = Math.floor(cy); this.fx = vp ? 0 : cx - this.ix; this.fy = vp ? 0 : cy - this.iy;   // (a split screen's viewports: whole pixels)\n    const g = this.ctx, [x, y, w, h] = vp ? [vp.x, vp.y, vp.w, vp.h] : [0, 0, this.buf.width, this.buf.height]; g.globalAlpha = 1; g.globalCompositeOperation = 'source-over'; g._c = null;\n    if (bg == null || bg === 'transparent') g.clearRect(x, y, w, h);\n    else { g.fillStyle = bg; g.fillRect(x, y, w, h); }\n  }\n  /** copy the buffer to the canvas, scaled up with whole pixels and the camera's sub-pixel offset (the renderer\n   *  calls it) */\n  _present() {\n    const s = this._sctx, S = this.S; if (!s) return;\n    s.imageSmoothingEnabled = false;\n    if (this.clear) s.clearRect(0, 0, this.canvas.width, this.canvas.height);\n    else { s.fillStyle = '#000'; s.fillRect(0, 0, this.canvas.width, this.canvas.height); }\n    s.save(); s.beginPath(); s.rect(this.OX, this.OY, this.W * S, this.H * S); s.clip();\n    s.drawImage(this.buf, 0, 0, this.W + 1, this.H + 1, this.OX - Math.round(this.fx * S), this.OY - Math.round(this.fy * S), (this.W + 1) * S, (this.H + 1) * S);\n    if (this.filter !== 'clean' && S >= 2 && !(typeof navigator !== 'undefined' && navigator.webdriver)) this._filter(s, S);\n    s.restore();\n  }\n  // the screen filter over the canvas: a dark line under each of the game's rows (a third of it), and for 'crt' each\n  // column's red, green and blue stripes and the corners' falloff, from images made once per size\n  _filter(s, S) {\n, \"pass\": true, \"detail\": \"\"}, {\"name\": \"Options pauses all standalone simulation timers\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"live tuning changes real simulation and clamps fill\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"tuning reset restores widgets and simulation\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"developer single tick works while overlay is frozen\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"invalid JSON profile keeps known-good tuning\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"ordinary settings persist across reload\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"settings defaults restore ten-percent music and PS symbols\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"rebindings and device labels come from native input\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"mouse aim and spray use bounded can travel\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"parked pointer does not fight keyboard movement\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"controller disconnect pauses standalone and explains recovery\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"attract waits until ten seconds of real idle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"ten-second idle starts real simulation demonstration\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"keyboard attract wake is consumed at title\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"pointer movement interrupts attract and is consumed\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"analog movement below gameplay dead zone wakes attract\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"controller button wake cannot also start a run\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"attract and assisted play do not write normal records\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"assembled game ordinary-input whole campaign reaches real win card\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"unassisted full campaign updates local records once\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"win card can start a clean fresh run\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"keyboard plus pad assigns exclusive devices\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"one pad cannot control both co-op cans\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"shared keyboard controls simultaneous independent cans\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"code audio produces finite non-silent non-clipped output\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"music bus ten-percent gain and mute are correct\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"audio teardown stops generated voice nodes\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Chromium session has no page or native game errors\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"touch drag steers the can with invisible controls\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"safe touch assistance fires useful ordinary spray\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"touch parcel tap exposes contextual actions\", \"pass\": false, \"detail\": \"\"}, {\"name\": \"touch menu opens native pause\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"orientation change preserves canonical arena geometry\", \"pass\": true, \"detail\": \"\"}]","exit_code":0,"status":"completed"}}
