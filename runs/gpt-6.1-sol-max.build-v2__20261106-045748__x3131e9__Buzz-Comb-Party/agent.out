o-CSS round trip, not projected world coordinates.\nold=\\\"point=phone.evaluate(\\\\\\\"(()=>{const rc=__game.screen.canvas.getBoundingClientRect(),S=__game.screen;const a=S.clientToScreen(rc.left,rc.top),b=S.clientToScreen(rc.right,rc.bottom);const x=(__game.W-640)/2+320,y=(__game.H-360)/2+173;return {x:rc.left+(x-a[0])/(b[0]-a[0])*rc.width,y:rc.top+(y-a[1])/(b[1]-a[1])*rc.height};})()\\\\\\\")\\\"\nnew=\\\"point=phone.evaluate(\\\\\\\"(()=>{const s=__game.screen,rc=s.canvas.getBoundingClientRect(),x=(__game.W-640)/2+320,y=(__game.H-360)/2+173;return {x:rc.left+(x*s.S+s.OX)/s.dpr,y:rc.top+(y*s.S+s.OY)/s.dpr};})()\\\\\\\")\\\"\nassert old in s;s=s.replace(old,new)\ns=s.replace(\\\"phone.evaluate(\\\\\\\"__game.input.lastDevice='touch'; __BUZZ.world.obstacles=[];\\\",\\\"phone.evaluate(\\\\\\\"__game.input.lastDevice='touch';__BUZZ.world.bird.state='idle';__BUZZ.world.bird.timer=20; __BUZZ.world.obstacles=[];\\\")\n# live checkpoint to make a slow failure diagnosable without extra console noise.\ns=s.replace(\\\"checks.append({'name':name,'pass':bool(ok),'detail':str(detail) if not ok else ''})\\\", \\\"checks.append({'name':name,'pass':bool(ok),'detail':str(detail) if not ok else ''})\\\\n (base/'evidence/browser-live.json').write_text(json.dumps(checks))\\\")\nopen(p,'w').write(s)\nimport json\np='docs/issues.json';items=json.load(open(p));items += [{'id':'I005','critical':False,'foundBy':'Controller/mouse browser checks and focused diagnostic','issue':'Generic input activity treated Mouse0 as pad activity and disabled mouse column aiming on spray.','fix':'Only new gamepad buttons or meaningful analog changes take ownership from the pointer.','verified':False},{'id':'I006','critical':False,'foundBy':'Controller-to-local-co-op browser check and native input inspection','issue':'Explicitly reassigning a pad to player 2 could be mistaken for a disconnected player 1 pad.','fix':'Reset device discovery state when committing an explicit seat configuration.','verified':F