{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='src/input.js';s=open(p).read().replace('callCounter=0,activityAt=0','callCounter=0,callAim=null,activityAt=0').replace('callCounter=0;for(const q','callCounter=0;callAim=null;for(const q').replace('Math.abs(v)>.035&&Math.abs(v-(old[i]||0))>.025','Math.abs(v)>.065&&Math.abs(v-(old[i]||0))>.045').replace('if(callCounter>0){call++;callCounter=0;}','if(callCounter>0){call++;aim=callAim;callCounter=0;callAim=null;}').replace(\\\"callCounter++;const p=w.players[0];if(p){B.applyAction(w,p.seat,{aim:o.x,call:p.callSeen+1});}context=0;\\\",\\\"callCounter++;callAim=o.x;context=0;\\\")\nopen(p,'w').write(s)\np='src/main.js';s=open(p).read().replace(\\\"    app.adapter.padActivity();\\\",\\\"    app.adapter.padActivity();\\\\n    if(\"'!app.online&&game.sceneName==='\"'title'&&game.real-app.adapter.activityAt>=10&&\"'!app.adapter.consumed){startDemo();return;}\")\n# Use text scale 2 for encounter names: important HUD labels readable across a room.\nopen(p,'\"'w').write(s)\np='src/presentation.js';s=open(p).read().replace(\\\"text(g,e.name,ox+24,oy+30,C.cream,1)\\\",\\\"text(g,e.name,ox+24,oy+29,C.cream,2)\\\")\nopen(p,'w').write(s)\nPY\ncat > tests/browser.py <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json, traceback, math\nbase=Path(__file__).resolve().parents[1]\nrelease=json.loads((base/'release.json').read_text())\nurl=(base.parent/(release['basename']+'.html')).as_uri()\nchecks=[]\ndef check(name,ok,detail=''):\n checks.append({'name':name,'pass':bool(ok),'detail':str(detail) if not ok else ''})\ndef marker(page):return page.evaluate(\\\"window.__game?.debug.snapshot().fingerprint==='buzz-comb-party-20261106'\\\")\ndef reset(page):\n page.evaluate('__BUZZ.title(); __game.input.clear()')\n page.wait_for_function(\\\"__game.sceneName==='title'\\\")\ndef shot(page,name):page.screenshot(path=str(base/'evidence'/name))\nPAD=\\\"\\\"\\\"window.__pads=[];window.__setPad=(i,buttons=[],axis=0)=>{__pads[i]={id:'Wireless Controller',index:i,connected:true,mapping:'standard',axes:[axis,0,0,0],buttons:Array.from({length:18},(_,k)=>({pressed:buttons.includes(k),value:buttons.includes(k)?1:0,touched:buttons.includes(k)}))};};Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pads});\\\"\\\"\\\"\ntry:\n with sync_playwright() as p:\n  browser=p.chromium.launch(headless=True)\n  context=browser.new_context(viewport={'width':1920,'height':1080})\n  context.add_init_script(PAD)\n  page=context.new_page();errors=[]\n  page.on('pageerror',lambda e:errors.append(str(e)))\n  page.goto(url);page.wait_for_function('window.__BUZZ?.ready')\n  check('single-file Chromium boot and build marker',marker(page) and page.evaluate('__game.sceneName')=='title')\n  check('default music and PlayStation glyphs',page.evaluate('__game.settings.music===.1 && __game.settings.glyphs===\\\\'playstation\\\\''))\n  shot(page,'title.png')\n  # Native menu navigation from standard pad.\n  page.evaluate('__setPad(0,[0])');page.wait_for_timeout(150);page.evaluate('__setPad(0,[])')\n  page.wait_for_function(\\\"__game.sceneName==='play'\\\")\n  check('standard controller starts the game without a mouse',page.evaluate('__game.sceneName')=='play')\n  page.evaluate('__game.advance(3.1)')\n  x=page.evaluate('__BUZZ.world.players[0].x');ammo=page.evaluate('__BUZZ.world.players[0].ammo')\n  page.evaluate('__setPad(0,[0],.8)');page.wait_for_timeout(500);page.evaluate('__setPad(0,[])')\n  check('stick movement plus Cross sprays',page.evaluate('__BUZZ.world.players[0].x')>x+5 and page.evaluate('__BUZZ.world.players[0].ammo')<ammo)\n  ammo=page.evaluate('__BUZZ.world.players[0].ammo');page.evaluate('__setPad(0,[7])');page.wait_for_timeout(300);page.evaluate('__setPad(0,[])')\n  check('R2 also sprays',page.evaluate('__BUZZ.world.players[0].ammo')<ammo)\n  page.evaluate('__setPad(0,[2])');page.wait_for_timeout(150);page.evaluate('__setPad(0,[])')\n  check('Square calls Pip through shared ability',page.evaluate('__BUZZ.world.coverage.call===true'))\n  page.evaluate('__setPad(0,[9])');page.wait_for_timeout(200);page.evaluate('__setPad(0,[])')\n  page.wait_for_function('__game.paused')\n  before=page.evaluate('JSON.stringify(BCP.snapshot(__BUZZ.world))');page.wait_for_timeout(200)\n  check('Options pauses all standalone simulation timers',before==page.evaluate('JSON.stringify(BCP.snapshot(__BUZZ.world))'))\n  shot(page,'pause.png')\n  page.get_by_role('button',name='Developer Tools',exact=True).click();page.get_by_role('button',name='Live tuning: combat',exact=True).click()\n  page.evaluate(\\\"__game.settings.set('lab_capacity',24); __game.settings.set('lab_beeSpeed',82)\\\")\n  check('live tuning changes real simulation and clamps fill',page.evaluate('__BUZZ.world.tuning.beeSpeed===82 && __BUZZ.world.players[0].ammo<=24 && __BUZZ.world.assisted'))\n  page.get_by_role('button',name='Reset all tuning to defaults',exact=True).click()\n  check('tuning reset restores widgets and simulation',page.evaluate('__game.settings.lab_beeSpeed===48 && __BUZZ.world.tuning.beeSpeed===48 && __BUZZ.world.tuning.capacity===56'))\n  page.get_by_role('button',name='Back',exact=True).last.click();page.get_by_role('button',name='Timing & protection',exact=True).click()\n  tick=page.evaluate('__BUZZ.world.tick');page.get_by_role('button',name='Advance one tick',exact=True).click()\n  check('developer single tick works while overlay is frozen',page.evaluate('__BUZZ.world.tick')==tick+1)\n  shot(page,'dev-tools.png')\n  imported=page.evaluate(\\\"__game.debug.import('{\\\\\\\"tuning\\\\\\\":{\\\\\\\"capacity\\\\\\\":-4}}')\\\")\n  check('invalid JSON profile keeps known-good tuning',not imported['ok'] and page.evaluate('__BUZZ.world.tuning.capacity')==56)\n  page.evaluate('__game.shell.hide()')\n  page.keyboard.press('Escape');page.wait_for_timeout(150)\n  page.get_by_role('button',name='Settings',exact=True).click()\n  page.evaluate(\\\"__game.settings.set('music',.25);__game.settings.set('glyphs','xbox')\\\")\n  page.reload();page.wait_for_function('window.__BUZZ?.ready')\n  check('ordinary settings persist across reload',page.evaluate(\\\"__game.settings.music===.25 && __game.settings.glyphs==='xbox'\\\"))\n  page.evaluate(\\\"__game.settings.reset('Sound');__game.settings.reset('Controller')\\\")\n  check('settings defaults restore ten-percent music and PS symbols',page.evaluate(\\\"__game.settings.music===.1 && __game.settings.glyphs==='playstation'\\\"))\n  # Native controls rebinding and PS/Xbox label selection.\n  page.evaluate(\\\"__game.input.rebind('call','keys','KeyQ');__game.settings.set('glyphs','xbox');__game.input.lastDevice='gamepad'\\\")\n  check('rebindings and device labels come from native input',page.evaluate(\\\"__game.input.label('call','keys')==='Q' && __game.input.label('fire','gamepad')==='A'\\\"))\n  page.evaluate(\\\"__game.input.resetBindings();__game.settings.set('glyphs','playstation')\\\")\n  reset(page);page.keyboard.press('Enter');page.evaluate('__game.advance(3)')\n  # Pointer aim is actual horizontal travel; parked pointer relinquishes to keys.\n  page.mouse.move(1500,850);page.mouse.down();page.wait_for_timeout(400);page.mouse.up()\n  check('mouse aim and spray use bounded can travel',page.evaluate('__BUZZ.world.players[0].x>320 && __BUZZ.world.players[0].x<550 && __BUZZ.world.stats.shots>0'))\n  x=page.evaluate('__BUZZ.world.players[0].x');page.keyboard.down('a');page.wait_for_timeout(300);page.keyboard.up('a')\n  check('parked pointer does not fight keyboard movement',page.evaluate('__BUZZ.world.players[0].x')<x)\n  # Pad disconnect pauses safely and consumes held fire.\n  page.evaluate('__setPad(0,[],.8)');page.wait_for_timeout(100);page.evaluate('__pads=[]');page.wait_for_timeout(200)\n  check('controller disconnect pauses standalone and explains recovery',page.evaluate(\\\"__game.paused && __game.pauseReason==='controller'