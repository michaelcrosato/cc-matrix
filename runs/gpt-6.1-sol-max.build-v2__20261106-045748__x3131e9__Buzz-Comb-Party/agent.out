e'/name))\nPAD=\\\"\\\"\\\"window.__pads=[];window.__setPad=(i,buttons=[],axis=0)=>{__pads[i]={id:'Wireless Controller',index:i,connected:true,mapping:'standard',axes:[axis,0,0,0],buttons:Array.from({length:18},(_,k)=>({pressed:buttons.includes(k),value:buttons.includes(k)?1:0,touched:buttons.includes(k)}))};};Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pads});\\\"\\\"\\\"\ntry:\n with sync_playwright() as p:\n  browser=p.chromium.launch(headless=True)\n  context=browser.new_context(viewport={'width':1920,'height':1080})\n  context.add_init_script(PAD)\n  page=context.new_page();errors=[]\n  page.on('pageerror',lambda e:errors.append(str(e)))\n  page.goto(url);page.wait_for_function('window.__BUZZ?.ready')\n  check('single-file Chromium boot and build marker',marker(page) and page.evaluate('__game.sceneName')=='title')\n  check('default music and PlayStation glyphs',page.evaluate('__game.settings.music===.1 && __game.settings.glyphs===\\\\'playstation\\\\''))\n  shot(page,'title.png')\n  # Native menu navigation from standard pad.\n  page.evaluate('__setPad(0,[0])');page.wait_for_timeout(150);page.evaluate('__setPad(0,[])')\n  page.wait_for_function(\\\"__game.sceneName==='play'\\\")\n  check('standard controller starts the game without a mouse',page.evaluate('__game.sceneName')=='play')\n  page.evaluate('__game.advance(3.1)')\n  x=page.evaluate('__BUZZ.world.players[0].x');ammo=page.evaluate('__BUZZ.world.players[0].ammo')\n  page.evaluate('__setPad(0,[0],.8)');page.wait_for_timeout(500);page.evaluate('__setPad(0,[])')\n  check('stick movement plus Cross sprays',page.evaluate('__BUZZ.world.players[0].x')>x+5 and page.evaluate('__BUZZ.world.players[0].ammo')<ammo)\n  ammo=page.evaluate('__BUZZ.world.players[0].ammo');page.evaluate('__setPad(0,[7])');page.wait_for_timeout(300);page.evaluate('__setPad(0,[])')\n  check('R2 also sprays',page.evaluate('__BUZZ.world.players[0].ammo')<ammo)\n  page.evaluate('__setPad(0,[2])');page.wait_for_timeout(150