orld.score===f[1].contentWindow.__BUZZ.world.score&&f[0].contentWindow.__BUZZ.world.stats.hits>0})()\\\",timeout=10000)\n  check('two copies share actual bee conversion and score',host.evaluate('__BUZZ.world.stats.hits')==client.evaluate('__BUZZ.world.stats.hits') and host.evaluate('__BUZZ.world.score')==client.evaluate('__BUZZ.world.score'))\n  check('remote call is authoritative and shared',host.evaluate('__BUZZ.world.coverage.call===true') and client.evaluate('__BUZZ.world.coverage.call===true'))\n  before=host.evaluate('__BUZZ.world.tick')\n  host.evaluate(\\\"__game.menu('pause',{pause:false})\\\")\n  page.wait_for_timeout(500)\n  check('online local options keep the host world moving',host.evaluate('__BUZZ.world.tick')>before and host.evaluate('__game.shell.screen')=='pause')\n  host.evaluate('__game.shell.hide()')\n  # Malformed and stale inputs travel through the real SDK; sender cannot claim P1.\n  client.evaluate(\\\"AIHub.send({v:1,k:'input',seq:-1,move:Infinity,aim:null,fire:true,call:0,seat:1},{to:AIHub.host})\\\")\n  page.wait_for_timeout(200)\n  check('host rejects malformed remote action',host.evaluate('__BUZZ.network.metrics.rejected')>0)\n  stock=host.evaluate('__BUZZ.world.reserves')\n  host.evaluate('BCP.queueGrowth(__BUZZ.world,0,640,.01)')\n  page.wait_for_function(\\\"(()=>{const f=Array.from(document.querySelectorAll('iframe'));return f.every(x=>x.contentWindow.__BUZZ.world.stats.retries===1)})()\\\",timeout=15000)\n  check('enclosure reset and shared stock agree in both copies',host.evaluate('__BUZZ.world.reserves')==stock-1 and client.evaluate('__BUZZ.world.reserves')==stock-1)\n  page.select_option('#who','p1');page.locator('#remove').click()\n  page.wait_for_function(\\\"document.querySelector('iframe').contentWindow.__BUZZ.world.players.length===1\\\",timeout=10000)\n  check('departing client removes its can without a stock charge',host.evaluate('__BUZZ.world.reserves')==stock-1 and host.evaluate('__BUZZ.world.players.length')==1)\n  page.locator('#timeup').click();page.wait_for_timeout(1000)\n  check('one terminal team result and end stop sends',host.evaluate('__BUZZ.network.metrics.finishCalls')==1 and host.evaluate('__BUZZ.ended'))\n  sent=host.evaluate('__BUZZ.network.metrics.sent');tick=host.evaluate('__BUZZ.world.tick');page.wait_for_timeout(350)\n  check('end freezes world and outbound traffic',host.evaluate('__BUZZ.network.metrics.sent')==sent and host.evaluate('__BUZZ.world.tick')==tick)\n  reports.append({'scenario':'gameplay','host':host.evaluate('__game.debug.snapshot()')})\n  context.close();browser.close()\nexcept Exception as e:\n check('Hub automation completed',False,traceback.format_exc())\nfinally:\n server.shutdown();server.server_close()\n(base/'evidence/hub-report.json').write_text(json.dumps({'checks':checks,'reports':reports},indent=2))\nprint(json.dumps({'checks':checks}))\nPY\nnode tools/build.mjs --quiet\n/home/micha/.local/share/pipx/venvs/playwright/bin/python tests/hub.py\"","aggregated_output":"{\"checks\": [{\"name\": \"official Hub two-player\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Hub two-player build identity and lifecycle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Hub two-player build identity and lifecycle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"official Hub impaired\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Hub impaired build identity and lifecycle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Hub impaired build identity and lifecycle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"official Hub host-leave\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Hub host-leave build identity and lifecycle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"official Hub server\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Hub server build identity and lifecycle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Hub server build identity and lifecycle\", \"pass\": true, \"detail\": \"\"}, {\"name\": \"Hub server build i