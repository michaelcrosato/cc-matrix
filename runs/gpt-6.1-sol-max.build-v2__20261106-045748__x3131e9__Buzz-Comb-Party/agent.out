 aG[m].bind(aG); aG[m] = (...a) => { grow(0, 0, AS, AS); return f(...a); }; }\n    this._R = [0, 0, AS, AS];\n    this._mCv = mkCanvas(AS, AS); this._mG = ctx2d(this._mCv);\n    this._rCv = mkCanvas(AS, AS); this._rG = ctx2d(this._rCv);\n    this._xCv = mkCanvas(8, 8); this._xG = ctx2d(this._xCv); this._xoCv = mkCanvas(8, 8); this._xoG = ctx2d(this._xoCv);   // x-ray silhouettes (checkered fill) and their solid outlines\n    this._oCv = mkCanvas(8, 8); this._oG = ctx2d(this._oCv);\n    this._eCv = mkCanvas(8, 8); this._eG = ctx2d(this._eCv); this._sCv = mkCanvas(8, 8); this._sG = ctx2d(this._sCv);   // canvas lighting: the glow mask, a scratch layer\n    this._ghostPool = Array.from({ length: 10 }, () => { const c = mkCanvas(AS, AS); return { cv: c, g: ctx2d(c) }; });\n    /** ghosts: the afterimages fading out (actor option ghost) */\n    this._ghostIdx = 0; this._ghosts = [];\n    const ck = mkCanvas(2, 2), cg = ck.getContext('2d'); cg.fillStyle = '#000'; cg.fillRect(0, 0, 1, 1); cg.fillRect(1, 1, 1, 1);\n    /** checker: a 2 x 2 checkerboard canvas (a pattern for x-ray and dithered fills) */\n    this._checker = ck;\n    /** outline: the color of the 1-pixel outline round every actor; rim: the rim light's color on actors' lit edges;\n     *  rimAlpha: its strength 0..1; xrayColor: the default color of x-ray silhouettes; xrayOutline: the default 1-px\n     *  outline round a silhouette's hidden part (null for none); glowMask: false lets emissive\n     *  glows show over everything under canvas lighting (cheaper: the default keeps walls and bodies in front of a glow\n     *  dark) */\n    this.outline = '#140c1c'; this.rim = '#ffe2b8'; this.rimAlpha = .28; this.xrayColor = '#8fe3ff'; this.xrayOutline = '#e8fdff'; this.glowMask = true;\n    // GPU mode: a hidden \"info\" image (height, surface type, glow) and an unlit overlay image\n    this._iCv = mkCanvas(8, 8); this._iG = this._iCv.getContext('2d'); this._iG._info = true; this._iG._r = this; this._iG._mat = '#000';\n    /** gpu: true during a frame drawn with GPU lighting (draw code can check r.gpu) */\n    this._vCv = mkCanvas(8, 8); this._vG = ctx2d(this._vCv); this.gpu = false; this._tg = null;\n  }\n  /** current draw target for ground helpers (switches during GPU info and overlay passes) */\n  get tgt() { return this._tg || this.ctx; }\n  /** the low-resolution buffer's 2D context: draw on it with E.px */\n  get ctx() { return this.game.screen.ctx; }\n  /** the view this frame is drawn in (the game's, with zoom and turn) */\n  get view() { return this.game.view; }\n  /** pixels per world unit on the ground here: the view's scale times the zoom (iso 1.41, the others 1.5, overhead 1, at\n   *  zoom 1). Rigs, maps and props grow with it; a sprite's pixel is a screen pixel at zoom 1 unless drawn with world: true */\n  get ppu() { return (this.view.scale || 1) * (this.view.zoom || 1); }\n  /** the screen's width in game pixels */\n  get W() { return this.game.screen.W; }\n  /** the screen's height in game pixels */\n  get H() { return this.game.screen.H; }\n  /** the buffer's width (W + 2: a pixel of margin each side for the sub-pixel camera) */\n  get bw() { return this.game.screen.buf.width; }\n  /** the buffer's height (H + 2) */\n  get bh() { return this.game.screen.buf.height; }\n  /** start a frame with the camera at (cx, cy) projected pixels (the game calls it before your draw) */\n  _begin(cx, cy, vp) {\n    const sc = this.game.screen; this._frameNo = (this._frameNo || 0) + 1;   // (kept actor images count frames drawn)\n    sc._begin(cx, cy, this.game.o.bg, vp); this._vp = vp || null;\n    if (vp) { const g = this.ctx; g.save(); g.beginPath(); g.rect(vp.x, vp.y, vp.w, vp.h); g.clip(); }   // (a viewport: the scene drawn inside it, the floor too)\n    /** ix, iy: the camera's whole-pixel offset this frame (a world point is at r.w(x, y, z) on the buffer) */\n    this.ix = sc.ix; this.iy = sc.iy; this._items.length = 0; this._decals.length = 0; this._overlays.length = 0; this._map = null; (this._emis || (this._emis = [])).length = 0;\n    const st = this.game.stats; st.actors = 0; st.culled = 0;\n    if (this._xCv.width !== this.bw || this._xCv.height !== this.bh) { this._xCv.width = this._xoCv.width = this._oCv.width = this._eCv.width = this._sCv.width = this.bw; this._xCv.height = this._xoCv.height = this._oCv.height = this._eCv.height = this._sCv.height = this.bh; }\n    this._xrayUsed = false; this._xrayOl = false; this._emOn = false;\n    const gpu = this.game.gpu;\n    this.gpu = !!(gpu && gpu.active(this.view)) && !this.game._split;   // (no GPU lighting on a split screen)\n    if (gpu) gpu._show(this.gpu);\n    if (this.gpu) {\n      if (this._iCv.width !== this.bw || this._iCv.height !== this.bh) { this._iCv.width = this._vCv.width = this.bw; this._iCv.height = this._vCv.height = this.bh; }\n      const iG = this._iG; iG.globalCompositeOperation = 'source-over'; iG.globalAlpha = 1; iG.fillStyle = '#000'; iG.fillRect(0, 0, this.bw, this.bh); iG._c = null; iG._mat = '#000';\n      this._vG.clearRect(0, 0, this.bw, this.bh); this._vG._c = null;\n    }\n  }\n  /** world -> buffer pixel coords */\n  w(x, y, z = 0) { const v = this.game.view; return [v.ax * x + v.ay * y - this.ix, v.bx * x + v.by * y + v.bz * z - this.iy]; }\n  /** queue a depth-sorted draw. fn(g) draws into g. opts: {bias, occluder, hides, xray, emissive, solid (hides a glow behind it), footprint,\n   *  box, top} occluder: a wall (x-ray silhouettes show through it, it sorts as a block). hides: only lets x-ray silhouettes show\n   *  through it (props, sprites, bodies), nothing else changes. box: [x0, y0, x1, y1], what it covers in buffer pixels:\n   *  an occluder joins the x-ray only where its box meets a silhouette (without one, a 48 x 140 box round its foot: give\n   *  a long wall its box, or queue it with queueSpan); top: its top's height (one under the knees hides nothing). It\n   *  sorts by its one point (x, y, z): a long thing that other things stand along sorts wrong somewhere: queueSpan */\n  queue(x, y, z, fn, o) {\n    let k = this.game.view.order(x, y, z) + (o && o.bias || 0);\n    // things standing on top of a TileMap wall block must sort after that block; a footprint ([x0, y0, x1, y1], world units)\n    // lifts a big thing over every block under its base (a canopy over a tower's top, a cart across two cells)\n    if (z > .5 && this._map && !(o && o.occluder)) {\n      const f = o && o.footprint, M = this._map, T = M.T;\n      if (f) { for (let cy = Math.floor(f[1] / T); cy <= Math.floor((f[3] - .01) / T); cy++) for (let cx = Math.floor(f[0] / T); cx <= Math.floor((f[2] - .01) / T); cx++) k = M._liftOrder(this.game.view, (cx + .5) * T, (cy + .5) * T, z, k); }\n      else k = M._liftOrder(this.game.view, x, y, z, k);\n      if (M.solids && M.solids.length) k = M._liftSolids(this.game.view, x, y, z, k);\n    }\n    const it = { k, fn, occ: o && o.occluder, hides: o && o.hides, top: o && o.top, box: o && o.box, actor: o && o.actor, xray: o && o.xray, x, y, z, info: o && o.info, noInfo: o && o.noInfo, em: !!(o && o.emissive), solid: !!(o && (o.solid || o.occluder)), pick: o ? o.pick : undefined, pb: o && o._pb };\n    this._items.push(it);\n    if (it.em) this._emis.push(it);   // glowing things: canvas lighting leaves them out of the darkness (see flush)\n  }\n  /** draw on the floor before the queue. opts.emissive (0..1) makes it glow under GPU lighting */\n  decal(fn, o) { this._decals.push({ fn, e: o && o.emissive || 0 }); }\n  /** draw fn(g) on top of everything, in screen pixels (HUD, dialog, menus) */\n  overlay(fn) { this._overlays.push(fn); }\n  /** what was drawn under a screen point (the HUD's pixels: input.clicked(), input.pointer()) in the last frame, front to\n   *  back: the pick values of the actors, sprites, props and queued draws given one (r.actor(x, y, z, fn, { pick: unit })),\n   *  each where its pixels went (an actor's drawn bounds; others' box, or a body's size round its point). [] for none */\n  pick(sx, sy) { const P = this._picked || [], out = []; for (let i = P.length - 1; i >= 0; i--) { const [v, b] = P[i]; if (sx >= b[0] && sx < b[2] && sy >= b[1] && sy < b[3] && !out.includes(v)) out.push(v); } return out; }\n  // ground helpers (all dithered, correct in every view)\n  /** n screen points round a circle of radius rad on the ground at (x, y), height z: the outline of a ring or a fan */\n  groundPts(x, y, rad, n = 18, z = 0) { const pts = []; for (let i = 0; i < n; i++) { const a = i / n * TAU; pts.push(this.w(x + Math.cos(a) * rad, y + Math.sin(a) * rad, z)); } return pts; }\n  /** a dithered disc lying on the ground (radius in world units, z its height): shadows, auras, area attacks */\n  groundDisc(x, y, rad, color, alpha = 1, z = 0) { px.polyDither(this.tgt, this.groundPts(x, y, rad, 18, z), color, alpha, this.ix, this.iy); }\n1622:        case 'text': r.overlay(g => { const [x, y] = r.w(p.x, p.y, p.z), sc2 = p.scale || 1; if (u < .75 || Math.floor(p.life * 20) % 2) E.font.text(g, p.text, x, y, p.color, { align: 'center', scale: [... omitted end of long line]\n1781:  overlay(fn) { this._overlays.push(fn); }\n1823:    this.overlay(g => {\n1946:  text(str, x, y, color = '#ffffff', o) { this.overlay(g => E.font.text(g, str, x, y, color, o)); }\n1948:  textAt(x, y, z, str, color = '#ffffff', o = {}) { this.overlay(g => { const [sx, sy] = this.w(x, y, z); E.font.text(g, str, sx, sy, color, Object.assign({ align: 'center' }, o)); }); }\n2132:  _flush() {\n2228:    this._flush();\n2999:    if (this.shownNote && this.real < this.shownNote.end) { const n = this.shownNote; this.r.overlay(g => E.font.text(g, n.text, this.r.W / 2, 3, '#ffffff', { align: 'center', shadow: '#000', outline: [... omitted end of long line]\n3001:      this.r.overlay(g => { const w = E.font.width(t, { font: 'tiny' }) + 6; g.fillStyle = '#000000b0'; g.fillRect(Math.round(this.r.W / 2 - w / 2), 0, w, 9); g._c = null; E.font.text(g, t, this.r.W / [... omitted end of long line]\n3003:    if (this.paused && this.pauseOverlay && !(this.shell && this.shell._sys && this.shell.screen)) this.r.overlay(g => {\n3009:    if (fx) { const a = (1 - fx.t / fx.dur) * (fx.k === undefined ? 1 : fx.k); if (a <= 0) this._flash = null; else this.r.overlay(g => { const r = this.r; g.save(); if (E.style.trans === 'dither') {  [... omitted end of long line]\n3011:    if (T) this.r.overlay(g => { T(g, fl, this.r, F); g._c = null; });\n3012:    else if (fl > 0) this.r.overlay(g => { const r = this.r, c = F.kind === 'white' ? '#ffffff' : '#000000'; g.save(); if (E.style.trans === 'dither') g.fillStyle = g.createPattern(r._fadePattern(fl,  [... omitted end of long line]\n3511:    r.overlay(g => { const S = this._pts; for (let i = 0; i + 1 < S.length; i++) px.line(g, ...r.w(...S[i]), ...r.w(...S[i + 1]), color); for (const p of this.points) px.rect(g, r.w(...p)[0] - 1, r.w( [... omitted end of long line]\n3859:  r.overlay(g => { for (const v of S.vps) { if (v.x > 0) px.rect(g, v.x - S.gap, v.y, S.gap, v.h, '#05040a'); if (v.y > 0) px.rect(g, v.x, v.y - S.gap, v.w, S.gap, '#05040a'); } });\n4372:   *   rig.drawPortrait(g, x, y, 40, { zoom: 3, turn: .6, bg: '#1a2050', frame: true })   // inside r.overlay(g => ...)\n6505:    r.overlay(g => {\n9225:    r.overlay(g => {\n9319:    r.overlay(g => {\n10778:    r.overlay(g => {\n10813:    r.overlay(g => {\n11113:    r.overlay(g => {\n11391:    r.overlay(g => {\n11732:    r.overlay(g => {\n11881:    r.overlay(g => this._hud(g, r.W, r.H));\n * for several frames side by side in one sprite's rows. Draw it with r.sprite(x, y, z, a, { t }) (t: its clock, seconds;\n * the game's time by default); a.frame(t) is the sprite at time t, a.index(t) its number, a.duration one play (seconds)\n */\nfunction anim(frames, fps = 8, o = {}) {\n  if (frames && frames.isSprite) { const n = Math.max(1, o.frames | 0), w = Math.floor(frames.w / n), at = _sprPx(frames); frames = Array.from({ length: n }, (_, i) => _sprOf(w, frames.h, (x, y) => at(i * w + x, y))); }\n  const n = frames.length, loop = o.loop !== false, pp = !!o.pingpong && n > 1, period = pp ? 2 * n - 2 : n;\n  const index = t => { let k = Math.floor(Math.max(0, t) * fps + 1e-6); if (!loop) k = Math.min(k, period - (pp ? 0 : 1)); k %= period; return pp && k >= n ? period - k : k; };\n  return { frames, fps, loop, pingpong: pp, isAnim: true, duration: period / fps, index, frame: t => frames[index(t)] };\n}\nHOOKS.rot = rotSprite;\nObject.assign(E, { rotSprite, recolor, anim });\n\n/* =============================================================================\n * 3. VIEWS (projections)\n *    A view is an orthographic camera: yaw spins around the up axis, pitch tilts\n *    from horizontal (0 = side view) to straight down (90). scale = pixels per world\n *    unit. zBoost exaggerates height (a classic pixel-art cheat for readability).\n *      screen x = ax*x + ay*y\n *      screen y = bx*x + by*y + bz*z\n * ============================================================================= */\nclass View {\n  /** new E.View(id, label, yaw, pitch, scale, zBoost): an orthographic camera (degrees; scale = screen pixels per\n   *  world unit; zBoost stretches heights). id: its name ('iso', or yours); label: its name for people ('Isometric') */\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='vendor/engine/my-3d2dge.js';s=open(p).read();old='    const grow = (x, y, w, h) => { if (x < bb[0]) bb[0] = x; if (y < bb[1]) bb[1] = y; if (x + w > bb[2]) bb[2] = x + w; if (y + h > bb[3]) bb[3] = y + h; };'\nnew='''    // BCP fix: actor pixel bounds must include the current Canvas transform, as drawing does.\n    // Native custom rigs may translate/scale their local pixel coordinates.\n    const grow = (x, y, w, h) => {\n      const m = aG.getTransform && aG.getTransform();\n      if (m) {\n        const q = [[x,y],[x+w,y],[x,y+h],[x+w,y+h]].map(([u,v]) => [m.a*u+m.c*v+m.e,m.b*u+m.d*v+m.f]);\n        const xs=q.map(p=>p[0]), ys=q.map(p=>p[1]); x=Math.min(...xs); y=Math.min(...ys); w=Math.max(...xs)-x; h=Math.max(...ys)-y;\n      }\n      if (x < bb[0]) bb[0] = x; if (y < bb[1]) bb[1] = y; if (x + w > bb[2]) bb[2] = x + w; if (y + h > bb[3]) bb[3] = y + h;\n    };'''\nassert old in s;s=s.replace(old,new);open(p,'w').write(s)\np='src/rigs.js';s=open(p).read().replace('g.restore();','g.restore();px.reset(g);');open(p,'w').write(s)\np='docs/engine-changes.md';s=open(p).read().replace('is kept verbatim','is vendored').replace('Engine modifications: none.','Engine modification: the actor scratch-buffer bounds tracker now applies the current Canvas transform when tracking fillRect/drawImage rectangles. Translated/scaled custom native pixel rigs otherwise drew outside the tracked raw-coordinate crop and vanished without errors. Supports translation, scale, rotation and mirrored transforms; headless fallback keeps raw bounds. Original revision is recorded above; the small marked patch is in Renderer constructor.');open(p,'w').write(s)\np='docs/issues.json';import json;issues=json.load(open(p));issues.append({'id':'I001','critical':True,'foundBy':'Visual title inspection after headless/browser boot checks passed','issue':'Native actor crop bounds ignored local Canvas transforms; all custom translated creatures were invisible.','fix':'Track transformed actor drawing bounds in Renderer. Reset pixel color cache after rig restore.','verified':False});json.dump(issues,open(p,'w'),indent=2)\nPY\nnpm run build && /home/micha/.local/share/pipx/venvs/playwright/bin/python tests/browser-first.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
