rt, then the game's own (standard: false, the game's items only) */\nvendor/engine/my-3d2dge.js:9732:    if (name === 'settings' && this._std) acts.push(['Controls', () => this.show('controls')], ['Restore defaults', () => { for (const g of SHELL_GROUPS.concat('Game')) this._game.settings.reset(g); t [... omitted end of long line]\nvendor/engine/my-3d2dge.js:9733:    if (name === 'controls') acts.push(['Restore defaults', () => { this._ctlI().resetBindings(); this._game.settings.reset('Controller'); this._game.settings.reset('Touch'); this._status = 'Every con [... omitted end of long line]\nvendor/engine/my-3d2dge.js:9846:E.Shell = Shell;\nvendor/engine/my-3d2dge.js:11153:    // the inventory: icons in a row (two in the verbs' panel; a thumb's size on a touch screen), arrows when it is longer\nvendor/engine/my-3d2dge.js:13508:  screens wide and tall as its rows; rooms meet where they touch on the grid, and an open edge is a door between them.\nvendor/engine/my-3d2dge.js:13657:  /** the explored map for E.Shell's minimap: game.shell.hud({ minimap: world.shellMap() }) (a cell a square, the save\nvendor/engine/my-3d2dge.js:14394:- rts.fog (E.Fog: the player's sight; walls block it), rts.visible(u); rts.minimap() is E.Shell's hud({ minimap }) (the\nvendor/engine/my-3d2dge.js:14667:  /** E.Shell's minimap spec: the map, the fog, the camera's view, the units seen as dots by side, a click moving the camera */\n// A headless test of the template game: the engine and game.js run in Node with no screen (new E.Game is headless where\n// there is no DOM), driven by fixed steps (game.advance) and scripted input (input.tap, input.hold), and read through\n// game.debug.snapshot(). Run it: node game/test.mjs (exit code 1 on a failure). Write one like it for your game.\nimport vm from 'node:vm';\nimport { readFileSync } from 'node:fs';\n\nconst ctx = { console };\nvm.createContext(ctx);\nfor (const f of ['../my-3d2dge.js', './game.js']) vm.runInContext(readFileSync(new URL(f, import.meta.url), 'utf8'), ctx, { filename: f });\nconst E = ctx.My3D2dge, game = E.current, I = game.input, snap = () => game.debug.snapshot();\nlet failed = 0;\nconst check = (what, ok, detail = '') => { console.log((ok ? 'ok   ' : 'FAIL ') + what + (ok ? '' : ': ' + detail)); if (!ok) failed++; };\n\ngame.advance(.5);\ncheck('the title waits for start', snap().scene === 'title', JSON.stringify(snap()));\nI.tap('start'); game.advance(.5);\ncheck('start begins play', snap().scene === 'play', JSON.stringify(snap()));\n\n// climb: stand facing the roof's west wall (cells 7-9 of rows 4-6: x 112-160, y 64-112), press jump to take hold, then\n// climb with up (up the screen is up the wall) until it pulls up onto the top\ngame.debug.teleport(100, 88, 0, 0);\nI.tap('jump'); game.advance(.1);\ncheck('jump next to a wall takes hold of it', snap().climbing, JSON.stringify(snap()));\nI.hold('up'); game.advance(.6); I.hold('up', false); game.advance(1);\ncheck('climbing up pulls up onto the roof', !snap().climbing && snap().hero[2] === 32, JSON.stringify(snap()));\n\n// take the gem (on the roof's middle cell), then hop down into the street with it\ngame.debug.teleport(136, 88, 32, 0); game.advance(.1);\ncheck('walking onto the gem takes it', snap().got, JSON.stringify(snap()));\ngame.debug.teleport(156, 120, 32, Math.PI / 2); I.hold('down'); game.advance(1.5); I.hold('down', false); game.advance(.5);\ncheck('back in the street with the gem wins', snap().scene === 'end' && snap().won, JSON.stringify(snap()));\n\n// get seen: stand in front of the guard, in the open, until its alert fills\nI.tap('start'); game.advance(.5);\nconst [gx, gy, gf] = snap().guard;\ngame.debug.teleport(gx + Math.cos(gf) * 40, gy + Math.sin(gf) * 40, 0, gf + Math.PI);\ngame.advance(2.5);\ncheck('the guard catches a hero it sees', snap().scene === 'end' && !snap().won, JSON.stringify(snap()));\ncheck('no errors', !game.errors.length, game.errors.map(e => e.message).join(' | '));\n\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\nprocess.exit(failed ? 1 : 0);\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    limitMs: 0,\n    round: 0,\n    /** True when the hub shows the round's splash and collects every player's ready: call ready() once loaded, with no prompt. */\n    splash: false,\n    /** True when the hub seeded Math.random for this round (side by side): every copy draws the same numbers. */\n    seeded: false,\n  };\n\n  /** A storage that lives and dies with the page: the Storage methods, and items as properties too. */\n  function memoryStorage() {\n    var data = Object.create(null);\n    var api = {\n      getItem: function (k) {\n        k = String(k);\n        return k in data ? data[k] : null;\n      },\n      setItem: function (k, v) {\n        data[String(k)] = String(v);\n      },\n      removeItem: function (k) {\n        delete data[String(k)];\n      },\n      clear: function () {\n        for (var k in data) delete data[k];\n      },\n      key: function (i) {\n        var keys = Object.keys(data);\n        return i >= 0 && i < keys.length ? keys[i] : null;\n      },\n    };\n    if (typeof Proxy !== 'function') return api;\n    return new Proxy(api, {\n      get: function (t, k) {\n        if (k === 'length') return Object.keys(data).length;\n        if (typeof k === 'symbol' || k in t) return t[k];\n        return k in data ? data[k] : undefined;\n      },\n      set: function (t, k, v) {\n        if (typeof k !== 'symbol') data[k] = String(v);\n        return true;\n      },\n      has: function (t, k) {\n        return k in data || k in t;\n      },\n      deleteProperty: function (t, k) {\n        delete data[k];\n        return true;\n      },\n      ownKeys: function () {\n        return Object.keys(data);\n      },\n      getOwnPropertyDescriptor: function (t, k) {\n        return k in data ? { value: data[k], writable: true, enumerable: true, configurable: true } : undefined;\n      },\n    });\n  }\n\n  /** mulberry32: numbers in [0, 1), the same sequence everywhere for the same 32-bit start. */\n  function generator(a) {\n    return function () {\n      a = (a + 0x6d2b79f5) >>> 0;\n      var t = a;\n      t = Math.imul(t ^ (t >>> 15), t | 1);\n      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);\n      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    };\n  }\n\n  // A fair start: in a session the game gets an empty storage of its own, so\n  // every round starts as a first launch (no saved unlocks, upgrades or runs),\n  // and nothing the round saves touches the player's own saves.\n  if (hub.active) {\n    for (var s = 0, stores = ['localStorage', 'sessionStorage']; s < stores.length; s++) {\n      try {\n        Object.defineProperty(root, stores[s], { configurable: true, value: memoryStorage() });\n      } catch (e) {\n        warn('could not give the game a fresh ' + stores[s]);\n      }\n    }\n  }\n\n  // Side by side: before any of the game's own scripts run, Math.random becomes\n  // a generator seeded by the hub, so every copy builds the same start.\n  var realRandom = Math.random;\n  var seededRandom = null;\n  if (hub.active && seedArg) {\n    Math.random = seededRandom = generator(Number(seedArg[1]) >>> 0);\n    hub.seeded = true;\n  }\n\n  // In a session the hub owns fullscreen: a game that asks for it gets the\n  // hub's whole page, so the scoreboard and the hub's cards stay on top. The\n  // hub says when its page goes in and out, so the game's own toggle and its\n  // fullscreenchange listeners work as they always did.\n  var fullscreenOn = false;\n  if (hub.active && root.Element && root.document) {\n    var asks = function (on) {\n      return function () {\n        post('fullscreen', { on: on });\n        return Promise.resolve();\n      };\n    };\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"magick 'docs/source-screen.gif[0]' docs/source-screen.png && sed -n '1180,1230p' vendor/engine/API-INDEX.md && sed -n '9340,9395p' vendor/engine/my-3d2dge.js && sed -n '9670,9760p' vendor/engine/my-3d2dge.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"magick 'docs/source-screen.gif[0]' docs/source-screen.png && sed -n '1180,1230p' vendor/engine/API-INDEX.md && sed -n '9340,9395p' vendor/engine/my-3d2dge.js && sed -n '9670,9760p' vendor/engine/my-3d2dge.js\"","aggregated_output":"- `E.ui.box(g, x, y, w, h, o = {})`: window frame: ui.box(g, x, y, w, h, { bg, border, shadow, gradient }) bg: one color (drawn as a soft top-to-bottom gradient, like Final Fantasy windows) or [top, bottom] colors. gradient: false for a flat fill.\n- `E.ui.counter(g, x, y, label, value, color = '#ffffff', o = {})`: label + value, e.g. ui.counter(g, 4, 4, 'RUPEES', 12)\n- `E.ui.hearts(g, x, y, hp, max, o = {})`: row of hearts: hp and max in hearts (halves allowed, e.g. 2.5 of 3)\n\n## 21d. Shell\n\n- `new E.Shell(game, o = {}) → shell`: new E.Shell(game, { theme, screens: { name: spec }, settings: { items, onChange(settings, key) }, store: 'shell-settings', meters: .125, standard: true }): an HTML interface over the game (see the section's header)\n- `new E.Shell({ theme })`: CSS variables (ink, paper, accent, muted, danger, line, font: a family, titleFont), and scale: the whole interface that many times (a number, or a function of the window) for a TV across a room; tv: true picks one by the window's width (14 px text at 875 px, up to 30 at 1,875)\n- `new E.Shell({ screens })`: specs ui.show(name) starts from (the pause screen follows game.paused; screens: { pause: false } leaves it out)\n- `new E.Shell({ settings })`: settings.items: the game's own settings, { key, label, type: 'toggle' | 'slider' | 'select', min, max, step, options, value } (kept in game.settings, beside the standard ones)\n- `new E.Shell({ store, meters })`: store: where an older version saved them; meters: meters per world unit for distances\n- `new E.Shell({ standard })`: false leaves out the standard menu (the pause screen's Settings, Controls, Full screen and Quit, and the settings' groups)\n- `shell.back()` †: what cancel does: the screen's own back(), or close it (back to the screen under it; closing the pause screen resumes)\n- `shell.dispose()` †: take its elements away and let go of the game (game.dispose() does it)\n- `shell.hide()` †: close every screen (and resume, when the menu paused the game)\n- `shell.hud(st = {})` †: the HUD, from this step's state (call it every step; a piece left out is hidden, and only what changed is redrawn)\n- `shell.hud({ objective })` †: { step: '01 / 04', title, text, at: { x, y, z }, from: hero } (the distance in meters, and above or below)\n- `shell.hud({ status, place, tip })` †: status: 'UNSEEN' or { text, color }; place: 'The Old Harbour'; tip: 'text' or { title, text }\n- `shell.hud({ bars, counts })` †: bars: [{ label, value, max, kind: 'bar' | 'pips', color }] (health, stamina, a meter); counts: [[label, value]]\n- `shell.hud({ prompt })` †: { key: 'E' (or act: 'interact': its key on the player's device), label, hint, progress: 0..1 }\n- `shell.hud({ keys, buttons })` †: keys: [['WASD', 'Move'], ...] (hidden on touch screens); buttons: [[label, fn or action]] (top right: pause and map where there is no Escape key)\n- `shell.hud({ minimap })` †: { map, at (with facing), markers: [{ x, y, kind: 'dot' | 'diamond' | 'ring' | 'cross', color }], onClick(x, y) (the world point clicked), fog (an E.Fog: unseen cells black, seen ones dim), camera: true (the ground the screen shows) }\n- `shell.screen` †: the name of the open screen ('pause', 'settings', 'controls', ...), or null while the game plays\n- `shell.settings` †: the player's settings: game.settings (the standard ones and the game's own, by key)\n- `shell.show(name, spec = {})` †: open a screen: 'title' | 'pause' | 'settings' | 'help' | 'results' | 'map' or a name of your own, from spec over o.screens[name]. A spec: { kicker, title, text (strings or functions), actions: [[label, fn] or { label, fn, act, primary, disabled }], back (fn for cancel), rows: ['glyphs', 'invertY', '#A heading'] (settings' rows, changed as on the settings screen) }. From another screen it stacks (back() returns); shown again, it updates (the new spec over the old). 'settings' takes its items\n- `shell.show('title')` †: { name, subtitle, meta: [...], footer }\n- `shell.show('help')` †: { keys: [[key, what]], sections: [[heading, text]] }\n- `shell.show('results')` †: { emblem, stats: [[value, label]], medals: [[label, earned]] }\n- `shell.show('map')` †: { map, at, markers (a list or a function), labels: [[text, x, y]], onPick(x, y) }\n- `shell.toast(title, text = '', seconds = 4)` †: a message that slides in at the top for a few seconds\n- `shell.tutorial(title, text = '', seconds = 15)` †: a tutorial card (bottom left, dismissable) for some seconds; tutorial(null) takes it away\n- `shell.root = null` †: game: the game it is over; o: its options; root: its DOM element (null in a headless game)\n\n## 22. Gpu lighting (webgpu)\n\n- `game.gpu.active(view)` †: true when it lights frames in this view (ready, enabled and a ground view)\n- `game.gpu.snapshot()` †: offscreen mode only: read the last frame back as a PNG data URL\n- `game.gpu.status()` †: 'loading' | 'on' | 'off' | 'unavailable'\n- `game.gpu.adapterInfo` †: the GPU's description from the browser (vendor, architecture), or null\n- `game.gpu.ambient` †: the unlit color, [r, g, b] 0..1\n- `game.gpu.bands = 6` †: how many light bands (fewer is more retro)\n- `game.gpu.enabled = true` †: false switches it off for now (and the canvas lighting with it, unless game.lights.enabled)\n- `game.gpu.failed = null` †: why it couldn't start, or null\n- `game.gpu.fallback = true` †: false keeps a frame it can't draw unlit (by default the canvas lighting stands in, game.lights.on)\n- `game.gpu.glow = .22` †: the strength of px.glow surfaces\n- `game.gpu.map = null` †: the TileMap it measures walls on\n- `game.gpu.offscreen = false` †: render into a texture instead of the page (automated tests; read it with snapshot())\n- `game.gpu.onStatus = null` †: called (gpu) when its status changes\n- `game.gpu.ready = false` †: true once the GPU is set up\n- `game.gpu.shadows = true` †: casters block light\n- `game.gpu.skipped` †: never queue more than two frames: a slow GPU drops frames instead of building up lag\n *    minimap) a modern adaptation would otherwise write by hand in HTML and CSS. It shows game state and holds none:\n *    the game passes values in every step and callbacks for the buttons, and it reaches the game only through those and\n *    input actions (a button's act is tapped, as input.bindButtons presses one).\n *      const ui = new E.Shell(game, { theme: { accent: '#d9b77c' }, settings: { items: ['sound', 'volume', 'motion'] },\n *        screens: { pause: { text: () => objective.title }, help: { keys: [['WASD', 'Move'], ['SPACE', 'Climb']] } } });\n *      ui.show('title', { name: 'VESPER', subtitle: 'The Ninth Bell', actions: [['Enter the district', start]] });\n *      every step: ui.hud({ objective: { title, text, at: ledger, from: hero }, status: 'UNSEEN',\n *        bars: [{ value: hp, max: 5, kind: 'pips' }], prompt: near && { key: 'E', label: 'Take the ledger', progress },\n *        minimap: { map, at: hero, markers: [{ x, y, kind: 'diamond' }] } });\n *      ui.toast('Checkpoint', 'The ledger is yours'); ui.show('results', { title: 'The names are safe', stats, medals })\n *    With a pause screen, it opens while game.paused and Resume unpauses. Keys, d-pad, stick and touch move the focus\n *    (up / down / left / right turn a slider or a choice, confirm presses, cancel goes back, pause or Start closes the\n *    menu); while a screen is open the game's input is held back. It honors reduced motion and the safe-area insets, CSS\n *    variables theme it (ink, paper, accent, muted, danger, line, font, titleFont), and a headless game keeps its screens'\n *    names and draws nothing.\n *    THE STANDARD MENU: every game gets one (new E.Game makes this shell for itself, and a game's own E.Shell takes over\n *    from it): the pause screen (Resume, the game's items, Settings, Controls, Full screen, Help, Save session while the\n *    page is recorded, Quit to title with a confirmation), the settings screen (Display, Sound, Comfort and the game's own settings, from game.settings) and the\n *    controls screen (every action's keys and buttons, rebound by pressing the new one, conflicts said before anything\n *    changes; the controller's dead zone, aim, symbols and vibration; the touch buttons' side, size and opacity; restore\n *    defaults). new E.Game({ menu: { items: [['Restart', fn]], settings: [...], controls: { attack: 'Sword', skill:\n *    false }, quit: 'title' } }) adjusts it; menu: false, or new E.Shell(game, { standard: false }), leaves it out.\n * ============================================================================= */\nconst SHELL_CSS = `.esh{position:fixed;inset:0;pointer-events:none;z-index:20;font:14px/1.45 var(--font);color:var(--ink);--sat:env(safe-area-inset-top,0px);\n--pt:calc(14px + env(safe-area-inset-top,0px));--pr:calc(14px + env(safe-area-inset-right,0px));--pb:calc(14px + env(safe-area-inset-bottom,0px));--pl:calc(14px + env(safe-area-inset-left,0px))}\n.esh *{box-sizing:border-box}.esh [hidden]{display:none!important}.esh p{margin:4px 0 0;white-space:pre-line}\n.esh h1,.esh h2{font-family:var(--title);font-weight:600;margin:2px 0 0;line-height:1.05}.esh h2{font-size:26px}\n.esh-pan{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:10px 13px;box-shadow:0 8px 28px #0009}\n.esh-k{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--accent)}.esh-m{color:var(--muted);font-size:12px}\n.esh-obj{position:absolute;left:var(--pl);top:var(--pt);max-width:min(330px,58vw)}.esh-obj b{font:600 17px var(--title);display:block}\n.esh-dist{color:var(--accent);font-size:12px;margin-top:4px;letter-spacing:.06em}\n.esh-vit{text-align:right;min-width:120px}.esh-hb{display:flex;gap:6px;pointer-events:auto}.esh-hb button{padding:6px 10px;font-size:11px;background:var(--paper)}\n.esh-st{font-size:11px;letter-spacing:.16em}.esh-st i{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:var(--c)}\n.esh-pips{margin-top:5px}.esh-pips i{display:inline-block;width:9px;height:9px;margin-left:4px;transform:rotate(45deg);background:var(--c,var(--danger))}.esh-pips i.off{opacity:.22}\n.esh-bar{height:4px;background:#ffffff1c;border-radius:2px;overflow:hidden;margin-top:6px}.esh-bar i{display:block;height:100%;background:var(--c,var(--accent));transition:width .2s}\n.esh-cnt{margin-top:6px;font-size:12px;color:var(--muted)}.esh-cnt b{color:var(--ink);margin-left:5px}\n.esh-toast{position:absolute;left:50%;top:var(--pt);transform:translate(-50%,calc(-100% - 30px));transition:transform .35s;max-width:min(420px,80vw);text-align:center}.esh-toast.on{transform:translate(-50%,0)}\n.esh-tut{position:absolute;left:var(--pl);bottom:var(--pb);max-width:min(330px,62vw);pointer-events:auto;padding-right:30px}\n.esh-x{position:absolute;right:6px;top:4px;background:none!important;border:0!important;color:var(--muted)!important;padding:2px 6px!important;font-size:16px!important}\n.esh-pr{position:absolute;left:50%;bottom:calc(var(--pb) + 44px);transform:translateX(-50%);display:flex;gap:10px;align-items:center;min-width:200px}\n.esh kbd{font:700 12px var(--font);border:1px solid var(--accent);border-bottom-width:2px;border-radius:4px;padding:2px 7px;color:var(--accent)}\n.esh-tip{position:absolute;left:50%;bottom:calc(var(--pb) + 100px);transform:translateX(-50%);text-align:center;border-color:var(--danger)}\n.esh-col{position:absolute;right:var(--pr);top:var(--pt);display:flex;flex-direction:column;align-items:flex-end;gap:8px}.esh-place{text-align:right;font:italic 13px var(--title);color:var(--muted)}\n.esh-mini{position:absolute;right:var(--pr);bottom:var(--pb);width:min(176px,28vw);border-radius:6px;border:1px solid var(--line);pointer-events:auto;cursor:pointer}\n.esh-keys{position:absolute;left:50%;bottom:var(--pb);transform:translateX(-50%);display:flex;gap:14px;font-size:12px;color:var(--muted);white-space:nowrap;background:rgba(8,6,14,.62);padding:5px 12px;border-radius:8px}.esh-keys kbd{margin-right:4px}\n@media (pointer:coarse){.esh-keys{display:none}}@media (max-width:640px){.esh-obj{max-width:calc(100vw - 214px)}.esh-toast{left:var(--pl);right:var(--pr);top:auto;bottom:calc(var(--pb) + 124px);max-width:none;transform:translateY(calc(100% + 160px))}.esh-toast.on{transform:none}\n.esh-pr{bottom:calc(var(--pb) + 196px)}.esh-tip{bottom:calc(var(--pb) + 262px)}}\n.esh-sh{position:absolute;inset:0;display:grid;place-items:center;background:#04060acc;pointer-events:auto;padding:calc(var(--pt) + 46px) var(--pr) var(--pb) var(--pl);animation:esh-in .25s;touch-action:pan-y}.esh-ttl{padding-top:var(--pt)}\n.esh-sh *{touch-action:pan-y}.esh-sh input{touch-action:auto}\n.esh .esh-nav{position:fixed;top:calc(8px + env(safe-area-inset-top,0px));z-index:2;width:44px;height:44px;min-height:44px;display:grid;place-items:center;padding:0;border-radius:10px;background:rgba(8,8,18,.6);border-color:rgba(255,255,255,.3);pointer-events:auto}\n.esh-nav.x{right:calc(8px + env(safe-area-inset-right,0px))}.esh-nav.bk{left:calc(8px + env(safe-area-inset-left,0px))}.esh-sw{transition:transform .2s,opacity .2s}\n.esh-mod{width:min(460px,100%);max-height:100%;overflow:auto;padding:22px 24px}.esh-wide{width:min(760px,100%)}\n.esh-ttl{place-items:center start;background:linear-gradient(90deg,#04060aee,#04060a99 50%,#04060a00 85%)}.esh-ttl>div{max-width:min(520px,92vw);padding-left:4vw}\n.esh-ttl h1{font-size:clamp(44px,10vw,92px);letter-spacing:.07em}.esh-sub{font:italic 20px var(--title);color:var(--accent);margin-top:6px}\n.esh-btns{display:flex;flex-direction:column;gap:8px;margin-top:18px}.esh-tags{display:flex;gap:10px;margin-top:18px;font-size:11px;letter-spacing:.16em;color:var(--muted)}\n.esh button{font:600 13px var(--font);letter-spacing:.08em;text-transform:uppercase;color:var(--ink);background:#ffffff0f;border:1px solid #ffffff2c;border-radius:4px;padding:10px 14px;text-align:left;cursor:pointer}\n    for (const k of S.keys('Controller')) add(this._row(k));\n    if (touch && !first) touchRows();\n  }\n  _capStart(a, device, name) {\n    const CI = this._ctlI(); this._cap = { a, device, name, prev: CI.padPrev.slice(), prevR: RSTICK.filter(k => CI.held.has(k)) };\n    this._status = device === 'pad' ? 'Press a controller button for ' + name + ' (Start cancels).' : 'Press a key or mouse button for ' + name + ' (Escape cancels).';\n    this._render();\n  }\n  _capBind(code) {\n    const c = this._cap; if (!c) return;\n    const I = this._ctlI(), r = I.rebind(c.a, c.device, code), names = I.names || {}, nm = a => typeof names[a] === 'string' ? names[a] : actionName(a);\n    if (r === 'reserved') { this._status = I.codeLabel(code) + ' is kept for the menus. Choose another, or press Escape.'; this._render(); return; }\n    if (r) { this._status = I.codeLabel(code) + ' is already ' + nm(r) + '. Rebind ' + nm(r) + ' first, or choose another.'; this._render(); return; }\n    this._capEnd(nm(c.a) + ': ' + I.codeLabel(code) + '. Saved.');\n  }\n  /** stop listening for a new binding (msg: what the status line says) */\n  _capEnd(msg) { if (!this._cap) { if (msg !== undefined) this._status = msg; return; } this._cap = null; this._status = msg || ''; this._ctlI().clear(); this._render(); }\n  /** a button: [label, fn] or { label, fn, act, primary, disabled } */\n  _btn(a, i, pri = true) {\n    const b = Array.isArray(a) ? { label: a[0], fn: a[1] } : a, e = this._el('button', b.primary || (b.primary === undefined && i === 0 && pri) ? 'pri' : '', b.label);\n    e.disabled = !!b.disabled;\n    if (b.down) {   // (a press, timed: the event's own time, not the click's after the finger lifts)\n      e.onpointerdown = ev => { ev.preventDefault(); b.down(ev.timeStamp); };\n      e.onkeydown = ev => { if ((ev.key === ' ' || ev.key === 'Enter') && !ev.repeat) { ev.preventDefault(); b.down(ev.timeStamp); } };\n    } else e.onclick = () => { if (b.fn) b.fn(); else if (b.act) { this._game.input.tap(b.act); this._held.add(b.act); } };\n    return e;\n  }\n  /** the audio offset's calibration screen: clicks on the beat, a Tap button (or Space) on each one heard; after eight\n   *  the offset found, kept with Keep it */\n  _calibrate(key) {\n    const K = this._game.audio.calibrate(), close = () => { K.stop(); this.back(); };\n    this.show('calibrate', { kicker: 'Sound', title: 'Audio offset', back: close,\n      text: () => K.done ? 'Your sound comes ' + K.result + ' ms after the beat. Keep it, or tap on to measure again.' : 'Tap on each click you hear, in time with it, not before (' + K.taps + ' of 8). The higher click starts each bar.',\n      actions: () => [{ label: 'Tap', primary: true, down: t => { K.tap(t); this.show('calibrate', {}); } }, { label: 'Keep it', disabled: !K.done, fn: () => { this._game.settings.set(key, K.result); close(); } }, ['Cancel', close]] });\n  }\n  /** build the open screen */\n  _render() {\n    if (!this.root) return;\n    const scr = this._els.scr, top = this._stack[this._stack.length - 1];\n    if (!top) { scr.replaceChildren(); return; }\n    for (const k of ['hb', 'obj', 'vit', 'place', 'tip', 'pr', 'keys', 'mini']) { this._els[k].hidden = true; this._last[k] = null; }   // the HUD hides under a screen (a paused game calls no hud())\n    const { name, s } = top, v = x => typeof x === 'function' ? x() : x, title = name === 'title';\n    const sh = this._el('div', 'esh-sh' + (title ? ' esh-ttl' : '')), box = this._el('div', title ? '' : 'esh-pan esh-mod' + (name === 'map' ? ' esh-wide' : ''));\n    sh.appendChild(box); sh.setAttribute('role', 'dialog'); sh.setAttribute('aria-label', v(s.title || s.name) || name);\n    const add = (...c) => box.append(...c.filter(Boolean));\n    add(s.emblem && this._el('div', 'esh-emb', s.emblem), s.kicker && this._el('div', 'esh-k', v(s.kicker)));\n    if (title) add(this._el('h1', '', v(s.name || s.title)), s.subtitle && this._el('div', 'esh-sub', v(s.subtitle)));\n    else add(this._el('h2', '', v(s.title) || { pause: this._game._players && this._game._players.length > 1 && this._game.pausedBy ? 'Paused by P' + this._game.pausedBy : 'Paused', settings: 'Settings', controls: 'Controls', help: 'Help', map: 'Map' }[name] || ''));   // (several players: who paused)\n    add(v(s.text) && this._el('p', title ? '' : 'esh-m', v(s.text)));\n    for (const key of v(s.rows) || []) add(key[0] === '#' ? this._el('div', 'esh-k esh-sec', key.slice(1)) : this._row(key));   // (setting rows on a screen of the game's own: '#' a heading)\n    if (name === 'settings') this._settingsRows(add);\n    if (name === 'controls') this._controls(add);\n    if (s.keys) { const g = this._el('div', 'esh-grid'); for (const [k, w] of v(s.keys)) g.append(this._el('kbd', '', k), this._el('span', '', w)); add(g); }\n    for (const [h, t] of v(s.sections) || []) add(this._el('div', 'esh-k esh-sec', h), this._el('p', 'esh-m', t));\n    if (s.stats) { const g = this._el('div', 'esh-stats'); for (const [val, lab] of v(s.stats)) { const c = this._el('div'); c.append(this._el('b', '', val), this._el('small', '', lab)); g.appendChild(c); } add(g); }\n    if (s.medals) { const g = this._el('div'); for (const [lab, got] of v(s.medals)) g.appendChild(this._el('span', 'esh-med' + (got ? '' : ' off'), (got ? '✓ ' : '') + lab)); add(g); }\n    if (name === 'map' && s.map) {\n      const cv = this._el('canvas', 'esh-map'); cv.width = 720; cv.height = Math.round(720 * s.map.h / s.map.w); this._map(cv, s, true); add(cv);\n      if (s.onPick) cv.onclick = e => { const b = cv.getBoundingClientRect(), t = cv._xf, x = ((e.clientX - b.left) * cv.width / b.width - t.ox) / t.k, y = ((e.clientY - b.top) * cv.height / b.height - t.oy) / t.k; s.onPick(x, y); this._map(cv, s, true); };\n    }\n    const acts = (name === 'pause' ? [['Resume', () => this.hide()]] : []).concat(v(s.actions) || [], name === 'pause' && this._std && v(this._game.o.menu && this._game.o.menu.items) || []).filter(Boolean);\n    if (name === 'pause') this._pauseActs(acts);\n    if (name === 'settings' && this._std) acts.push(['Controls', () => this.show('controls')], ['Restore defaults', () => { for (const g of SHELL_GROUPS.concat('Game')) this._game.settings.reset(g); this.show('settings'); }]);\n    if (name === 'controls') acts.push(['Restore defaults', () => { this._ctlI().resetBindings(); this._game.settings.reset('Controller'); this._game.settings.reset('Touch'); this._status = 'Every control is back to its default.'; this.show('controls'); }]);\n    if (!acts.length && !title || name === 'settings' || name === 'controls') acts.push(['Back', () => this.back()]);\n    const btns = this._el('div', 'esh-btns'), lists = name === 'settings' || name === 'controls'; acts.forEach((a, i) => btns.appendChild(this._btn(a, i, !lists))); add(btns);\n    if (s.meta) { const g = this._el('div', 'esh-tags'); for (const t of v(s.meta)) g.appendChild(this._el('span', '', t)); add(g); }\n    add(s.footer && this._el('div', 'esh-m', v(s.footer)));\n    const keep = top.focus !== undefined ? top.focus : this._shown === top ? this._focusAt() : -1; this._shown = top;   // (redrawn in place: the focus stays where it was)\n    // the way out, always in sight: close at the top right (where the menu button was), back at the top left over another\n    // screen, and a sideways swipe goes back (a phone's edge swipe would leave the page)\n    const nav = [];\n    if (!title) nav.push(this._navBtn('x', 'Close', 'M6 6l12 12M18 6L6 18', () => this._close()));\n    if (this._stack.length > 1) nav.push(this._navBtn('bk', 'Back', 'M15 5l-7 7 7 7', () => this.back()));\n    this._swipe(sh, box, title);\n    this._els.scr.replaceChildren(sh, ...nav);\n    const all = this._focusables(), f = all[keep] || (name === 'settings' || name === 'controls' ? null : sh.querySelector('button.pri:not(:disabled)')) || all[0];\n    top.focus = undefined; if (f) { f.focus({ preventScroll: true }); if (f.scrollIntoView) f.scrollIntoView({ block: 'nearest' }); }\n  }\n  /** the standard pause screen's buttons after Resume and the game's own: Settings, Controls, Full screen, Help, Save\n   *  session (while the page is recorded: E.session), Quit */\n  _pauseActs(acts) {\n    const g = this._game, fs = g.fullscreen, M = g.o.menu || {}, quit = M.quit === false ? null : M.quit || 'title', help = this._o.screens && this._o.screens.help;\n    if (this._std && HOOKS.pause) HOOKS.pause(this, acts);\n    if (this._std || this._items().length) acts.push(['Settings', () => this.show('settings')]);\n    if (!this._std) { if (help) acts.push(['Help', () => this.show('help')]); return; }\n    acts.push(['Controls', () => this.show('controls')]);\n    if (g.o.fullscreen !== false && fs.supported && !fs.standalone) acts.push([fs.on ? 'Leave full screen' : 'Full screen', () => { fs.toggle(); }]);\n    if (help) acts.push(['Help', () => this.show('help')]);\n    // a recorded page (?record=1) saves its session from the menu: a phone has no console (the share sheet, or a download).\n    // Its replay has the button too (doing nothing): the recorded tap on it lands on it, not on the next one (Quit)\n","exit_code":0,"status":"completed"}}
