in(n, this.rows) : n;\n    let first = clamp(this._first || 0, 0, Math.max(0, n - vis)); if (this.i < first) first = this.i; else if (this.i >= first + vis) first = this.i - vis + 1; this._first = first;   // (the cursor's row in view)\n    const h = vis * rowH + (this.title ? rowH + 3 * k : 0) + 8 * k, x = this.x === 'center' ? Math.round((S.W - w) / 2) : this.x, y = this.y === 'center' ? Math.round((S.H - h) / 2) : this.y;\n    const top = y + 5 * k + (this.title ? rowH + 3 * k : 0); this._box = { x: x + 3 * k, y: top - 2 * k, w: w - 6 * k, rowH, first, vis };   // (where the entries are, for a click or tap)\n    return { labels, w, h, x, y, top, rowH, k, fo, first, vis };\n  }\n  /** entry i's box on the screen, [x, y, w, h] in screen pixels: where a click or tap picks it (a test's feed('down') and\n   *  feed('up') there); null while it is scrolled out of view */\n  rowAt(i) { this._layout(); const b = this._box; return i < b.first || i >= b.first + b.vis ? null : [b.x, b.y + (i - b.first) * b.rowH, b.w, b.rowH]; }\n  /** move the cursor (up, down; held keys repeat; the mouse over an entry) and pick (confirm, or a click or tap on an\n   *  entry) or cancel; returns true when it picked or cancelled */\n  update() {\n    if (!this.active || !this.items.length) return false;\n    this._layout();\n    const P = this.input ? [this.input] : this.game._players || [this.game.input], inp = P[0], any = f => P.some(f), n = this.items.length, old = this.i, b = this._box;\n    const row = p => { if (!b || !p || p[0] < b.x || p[0] >= b.x + b.w) return -1; const r = Math.floor((p[1] - b.y) / b.rowH), k = b.first + r; return r >= 0 && r < b.vis && k < n && !this._off(this.items[k]) ? k : -1; };\n    if (any(I => I.repeat('up'))) { this.i = (this.i + n - 1) % n; this._skip(-1); }\n    if (any(I => I.repeat('down'))) { this.i = (this.i + 1) % n; this._skip(1); }\n    if (inp.mouse.t !== this._mt) { this._mt = inp.mouse.t; const k = row(inp.pointer()); if (k >= 0) this.i = k; }   // the mouse moved over an entry\n    const tap = row(inp.clicked());   // a click or tap on an entry picks it\n    if (tap >= 0) this.i = tap;\n    if (this.i !== old) { if (this.sound) this.game.audio.sfx('select'); if (this.onMove) this.onMove(this.i, this.items[this.i]); }\n    if ((any(I => I.pressed('confirm')) || tap >= 0) && !this._off(this.items[this.i])) { if (this.sound) this.game.audio.sfx('confirm'); P.forEach(I => I.consumeAll()); if (this.onPick) this.onPick(this.i, this.items[this.i]); return true; }\n    if (any(I => I.pressed('cancel')) && this.onCancel) { if (this.sound) this.game.audio.sfx('cancel'); P.forEach(I => I.consumeAll()); this.onCancel(); return true; }\n    return false;\n  }\n  /** draw it to the overlay */\n  draw(r) {\n    r.overlay(g => {\n      const { labels, w, h, x, y, top: yy, rowH, k: K, first, vis } = this._layout(), T = { outline: false, shadow: '#05040a', scale: K };\n      if (this.box) E.ui.box(g, x, y, w, h, { bg: this.bg, border: this.border });\n      if (this.title) E.font.text(g, this.title, x + w / 2, y + 5 * K, this.pick, { align: 'center', outline: false, shadow: '#05040a', scale: K });\n      const blink = Math.floor(this.game.real * 3) % 2 === 0;\n      labels.slice(first, first + vis).forEach((l, r) => {\n        const k = first + r, sel = k === this.i && this.active, off = this._off(this.items[k]);\n        if (sel) px.rect(g, x + 3 * K, yy + r * rowH - 2 * K, w - 6 * K, rowH, shade(Array.isArray(this.bg) ? this.bg[0] : this.bg, .22));\n        E.font.text(g, l, x + 14 * K, yy + r * rowH, off ? this.dim : sel ? this.pick : this.color, T);\n        if (sel && blink) E.font.text(g, '▸', x + 6 * K, yy + r * rowH, this.pick, { scale: K, outline: false });\n      });\n      if (first > 0) E.font.text(g, '▲', x + w - 9 * K, yy, this.dim, T);   // (more above and below)\n      if (first + vis < labels.length) E.font.text(g, '▼', x + w - 9 * K, yy + (vis - 1) * rowH, this.dim, T);\n    });\n  }\n}\nE.Menu = Menu;\n\n/* =============================================================================\n * 21d. SHELL  an HTML interface over the game, built from data: the screens (title, pause, settings, help, results, map)\nGame.prototype._camAim = function (tx, ty) {\n  const c = this.cam, W = this.screen.W, H = this.screen.H, fr = this._framed;\n  if (fr) {\n    let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;\n    for (const t of fr.list) { if (!t) continue; const [px2, py2] = this.view.p(t.x || 0, t.y || 0, t.z || 0); x0 = Math.min(x0, px2); x1 = Math.max(x1, px2); y0 = Math.min(y0, py2 - 16); y1 = Math.max(y1, py2); }\n    if (x1 >= x0) {\n      tx = (x0 + x1 - W) / 2; ty = (y0 + y1 - H) / 2;\n      const Z = fr.zoom; if (Z) {   // out at once when they don't fit, back in once they would fit well\n        const k = Math.min((W - 2 * fr.margin) / Math.max(1, x1 - x0), (H - 2 * fr.margin) / Math.max(1, y1 - y0)), z = this._zoomBase;\n        const want = clamp(Math.floor(z * Math.min(k, 1.25) * 20) / 20, Z[0], Z[1]);\n        if (want < z - 1e-9 || (k > 1.2 && want > z + 1e-9)) this.setZoom(want);\n      }\n    }\n  }\n  const f = this._follow;\n  if (c.snapY) { const t = f && f.target, lim = H * .3; if (c.snap || c._ly === undefined || !t || t.onGround !== false) c._ly = ty; else c._ly = clamp(c._ly, ty - lim, ty + lim); ty = c._ly; }\n  if (c.window) { const [ww, wh] = c.window; if (c.snap || c._wx === undefined) { c._wx = tx; c._wy = ty; } c._wx = clamp(c._wx, tx - ww / 2, tx + ww / 2); c._wy = clamp(c._wy, ty - (wh || 0) / 2, ty + (wh || 0) / 2); tx = c._wx; ty = c._wy; }\n  return [tx, ty];\n};\n\n/* =============================================================================\n * 10j. PLAYERS AND SPLIT SCREEN  two to four on one machine. game.players: game.input is player 1 (a game of one is\n *    unchanged), each other an input of its own, with game.input's API, its device and its bindings: a gamepad each, or\n *    half a keyboard each for two (Input.halfKeys: WASD with F G H R T Y on the left, the arrows with . / , L ; ' and the\n *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\n *    right half's start) on the keyboard, player 1 then playing on its left half; game.removePlayer(p). Each has player (its\n *    number), name ('P2') and color. A pause says who paused, a lost controller names its player, the Controls screen\n *    has a page each. game.splitScreen(n, { layout, follow }): two to four viewports, each its own camera (viewport.follow,\n *    viewport.focus), the scene drawn once in each (r.viewport says which: { i, x, y, w, h }) and scene.hud(r) once over\n *    the whole screen; GPU lighting off while split. A scene's start ends a split.\n * ============================================================================= */\nconst KEY_HALVES = {   // each half's moves, its buttons in order (the preset's other actions take them in turn) and its menu keys\n  left: { up: ['KeyW'], down: ['KeyS'], left: ['KeyA'], right: ['KeyD'], buttons: [['KeyF'], ['KeyG'], ['KeyH'], ['KeyR'], ['KeyT'], ['KeyY'], ['KeyV'], ['KeyB']], start: ['Digit1'], pause: ['Escape', 'Digit1'], confirm: ['KeyF'], cancel: ['KeyG'] },\n  right: { up: ['ArrowUp'], down: ['ArrowDown'], left: ['ArrowLeft'], right: ['ArrowRight'], buttons: [['Period', 'Numpad1'], ['Slash', 'Numpad2'], ['Comma', 'Numpad3'], ['KeyL', 'Numpad4'], ['Semicolon', 'Numpad5'], ['Quote', 'Numpad6'], ['KeyK', 'Numpad7'], ['KeyM', 'Numpad8']],\n    start: ['Digit2', 'Enter', 'NumpadEnter'], pause: ['Digit2', 'Backspace'], confirm: ['Period', 'Enter', 'NumpadEnter'], cancel: ['Slash', 'Backspace'] }\n};\n/** a preset for half a keyboard ('left' or 'right'): its moves and menu keys, the preset's other actions on its buttons\n *  in order, and the preset's gamepad codes (Input.halfKeys(Input.SHMUP, 'right') -> fire on . and Numpad 1, bomb on /).\n *  A preset's own halves come first: preset.halves = { left: { pass: ['KeyR'] }, right: { pass: ['KeyL'] } } (an action\n *  a menu reads beside confirm would take confirm's F otherwise) */\nInput.halfKeys = (preset, side) => {\n  const P = typeof preset === 'string' ? Input[preset.toUpperCase()] || Input.DEFAULT : preset || Input.DEFAULT, H = KEY_HALVES[side] || KEY_HALVES.left, own = (P.halves && P.halves[side]) || {}, out = {};\n  let k = 0;\n  for (const a in P) if (Array.isArray(P[a])) out[a] = (own[a] || H[a] || H.buttons[k++] || []).concat(P[a].filter(c => padCode(c)));\n  return out;\n};\nconst _pStub = game => Object.create(game.screen, { canvas: { value: null } });   // (another player's input: the screen's sizes, no listeners of its own)\nconst _pPreset = (game, q) => q.half ? Input.halfKeys(game.input._full || game.input.preset, q.half) : (game.input._full || game.input.preset);\nfunction _pClaim(game) {   // player 1 reads no pad another player holds; the keyboard's codes go to the players sharing it\n  const P = game.players, I = P[0];\n  I._claimed = new Set(P.slice(1).filter(q => typeof q.pad === 'number').map(q => q.pad));\n  I.keysTo = P.slice(1).filter(q => q.half).concat(game._lobby ? [game._lobby] : []);\n  if (!I.keysTo.length) I.keysTo = null;\n}\n/** let players join, up to max (2..4): Start on a gamepad no one holds, or 2 on the keyboard (o.keys: false not); onJoin\n *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\nGame.prototype.allowJoin = function (o = {}) {\n  if (o === false) { this._join = null; this._lobby = null; _pClaim(this); return this; }\n  this._join = { max: clamp(o.max || 2, 2, 4), onJoin: o.onJoin || null, keys: o.keys !== false };\n| Beat-'em-up (Final Fight, Streets of Rage, TMNT) | `brawler` | TileMap street strip, Body, Humanoid (`weapon: null`) + `E.Combo` punches and `kick: true` kicks, `E.knockback`, waves that lock the screen; a second player drops in (`game.allowJoin`, `cam.frame` on both) | BRAWLER |\n| Fighting (Street Fighter II, Darkstalkers) | `side` | two `E.Fighter`s in an `E.Match` (the fight module): moves with frame data, guards, throws, specials by motion (`'236'`) or charge, a meter, projectiles; `E.FightAI`, `E.FightSelect`, training | FIGHTING |\n| Shoot-'em-up (1942, Gradius, R-Type) | `overhead` (vertical, and horizontal: world x scrolls) | sprites, Bullets, `E.pattern`, a timeline of waves; horizontal: rock edges as functions of x, a power bar, options on the ship's past path, `E.Path` loops; `E.Arcade` for the continue and the table | SHOOTER (both stages) |\n| Pinball (Pinball Fantasies, Space Cadet, Devil's Crush) | a steep table view of its own (`new E.View('pinball', 'Table', 0, 62, 1, 1)`) | `E.Physics`: chains for the walls, `flipper`, `bumper`, `slingshot`, `kicker`, a ramp on a layer of its own, the ball a `bullet`; `input.zones` flip on a phone; `E.Arcade` for the score and table. Breakout and Asteroids with real collisions are its recipes | PINBALL |\n| Artillery (Worms, Scorched Earth) | `side` at a whole scale (`new E.View(id, label, 0, 0, 1, 1)`) | `E.Terrain` (`carve` the blasts, `walk` the soldiers, `ray` the shots), grenades as `E.Physics` bodies on `land.collider()`, `E.Turns`; a drag aims (`steer = 'drag'`, `drag()`, `stickOn`); a CPU tries its shots in simulation | ARTILLERY |\n| Golden-age arcade (Pac-Man, Galaga, Asteroids) | `overhead` (one fixed screen, cabinet art on the sides) | `E.Arcade` (score, lives, extra lives, turns, initials, tables, attract mode); a maze of `E.GridMover`s; moths on `E.Path`s turned by `rot`; `E.wrap` and `wrap: [w, h]` | ARCADE |\n| Twin-stick / run-and-gun (Smash TV, Contra) | `topdown` / `side` | Body or Platformer, Bullets, `weapon: 'gun'`, `point: true` | SHOOTER + ADVENTURE |\n| JRPG (Dragon Quest, Final Fantasy, EarthBound) | `threequarter` town, `brawler` battles | TileMap towns and a big world map, the story and rpg modules, Dialog with markup, `game.saves` slots | RPG |\n| Puzzle (Tetris, Dr. Mario, Puyo, Columns) | `side` (a field in screen pixels) | a cell array, a bag from `E.rng`, `input.repeat` (auto-shift), `grid.groups` (chains), `input.drag()` and `clicked()` for touch; versus: two fields, rows sent across (`game.players`) | PUZZLE |\n| Roguelike (Rogue, Mystery Dungeon, Shiren) | `threequarter` / `iso` | `E.gen` floors, a TileMap of its rows, `E.Grid.from(map)` paths and `fov`, `E.Fog`, `E.Turns` by speed, `game.tween` steps | ROGUELIKE |\n| Tactics (Final Fantasy Tactics, Tactics Ogre, Fire Emblem) | `iso`, turned a quarter | TileMap of block heights, `map.pick` under the cursor, `E.Grid.from(map, { tops: true })` reach over heights, `grid.shape`, `grid.side`, `grid.threat`, `E.Turns` charge time, `E.Story` | TACTICS |\n| Real-time strategy (Warcraft II, StarCraft, Dune II) | `iso` | `E.Strategy` (the strategy module): kinds as data, selection by click, box and group, orders, gold, building, training, fog, an AI's build order and waves; `cam.free`, `{ pick: unit }` and `r.pick`, buildings as `E.SHAPES`, E.Shell's minimap; bodies drawn `every: 3` | RTS |\n| Theme park or city sim (Theme Park, RollerCoaster Tycoon, SimCity) | `iso` | paths as floor tags walked on an `E.Grid`, agents with `E.needs` picking by `E.choose`, `E.Clock` days and light, `game.timeScale` 0 to 4, `E.overlay`, `E.tooltip`; rides as shapes stepped through angles (`params`, `facing`) | SIM |\n| 3D platformer or adventure remake (Mario 64, Ocarina, Crash) | `iso` / `threequarter` / `brawler` | TileMap blocks of different heights + Body `jump()` (z is real height); in real 3D: `E.World3D` (the 3D engine's manual), `camera.lock` | ADVENTURE; 3D ACTION, 3D PLATFORMER |\n| Survival horror (Resident Evil, Alone in the Dark) | the 3D engine's `'zones'` camera | `camera.zones` (fixed cameras by room), `camera.steer` (tank controls), `camera.lock` to aim, `world.through` doors, `world.flashlight`, fog; `E.RPG` inventory, `game.saves` | 3D HORROR |\n| First-person dungeon (Wizardry, Dungeon Master, Eye of the Beholder) | the 3D engine's `'fixed'` camera at the party's eyes | cells of 2 x 2 tiles stepped and turned a quarter at a time (tweened), `E.Grid` paths for the monsters, `E.Turns` `'atb'` (real time) or `'speed'` (turns), `E.Fog` for the automap, `world.thing('door')` gates and `world.unlock`, `rig.drawPortrait` for the party | 3D CRAWLER |\n| Rhythm (Dance Dance Revolution, PaRappa, Beatmania, Space Channel 5) | any (a highway on the overlay) | `E.Rhythm` (the rhythm module): a chart of lane strings in parts on a song's steps, judged in ms of the music clock, combo, life, grade, holds, calls a teacher plays and you answer, `rh.draw` (`arrows: true`); the songbook's songs (`E.Songbook`); lanes as `input.zones` on a phone; `audio.onBeat` moves the dancer | RHYTHM |\n| Sports (Sensible Soccer, NBA Jam) | `threequarter` / `topdown` | the ball an `E.Body` (`bounce`; curl: turn its velocity across its path), passes led to the teammate, `E.arc` for a lob, a shot's meter, formations by where the ball is, `game.allowJoin({ max: 4 })` | SPORTS |\n| Third-person stealth (Assassin's Creed, Metal Gear, Tenchu) | `iso` / `threequarter` | TileMap roofs, Mover, `E.sees`, `E.Suspicion`, FlowField `jump` | STEALTH |\n| Kart racing (Super Mario Kart, F-Zero) | Mode 7 (the mode7 module, over any view) | `E.Mode7` over a TileMap track (floor tags: grass, sand, boost), `E.Car` karts (`kart: true`: hop, drift, boost) in an `E.Race` round an `E.Path` (laps, checkpoints, drivers, items), rigs in karts as billboards, `game.splitScreen(2)` for two | KART |\n| 3D kart racing (Mario Kart 64, Crash Team Racing) | the 3D engine's `'behind'` camera | `world.track` (banked, walls, pads, `gaps` for a shortcut), `world.vehicle` karts raced by `E.Race`, split screen through `world.cameras` | 3D RACING |\n| Rail shooters (Star Fox 64, Panzer Dragoon) | the 3D engine's `'behind'` camera | `world.flyer` on rails or free in bounds, rolls (`f.rolling`) turn shots aside, `f.seek` for a charged lock, `Dialog`'s radio | 3D FLIGHT |\n| Road racing (OutRun, Pole Position, Road Rash) | the pseudo-3D road (the road module) | `E.Road` segments (curves, hills, tunnels), scenery and traffic placed on it, `curveAt` throwing the car outward, a clock and checkpoints | ROAD |\n| Top-down racing and driving (Micro Machines, RC Pro-Am, GTA) | `topdown` / `iso` | `E.Car` on a TileMap (its floor tags slow it, its walls bounce it), `E.Race` for laps and drivers, cars drawn with `px.poly` on `r.w()` corner points | KART |\n| First-person shooter (Doom, GoldenEye 007, Apex Legends) | the 3D engine's first person (or third) | a level of text rows or a terrain, `world.ray` hitscan, recoil and reloads, doors (`world.thing('door')`), raiders on `world.flow()` | 3D SHOOTER |\n| Bomberman, Frogger, Sokoban, Gauntlet, Robotron; Sonic, Prince of Persia; light guns | as the recipe says | `AI_GUIDE.md`'s Genre recipes: each on the kit closest to it | (a recipe) |\n\n**Sizes:** heroes 40-60 px tall at 320x240 (`size: 1.2-1.4`), bosses 1.8-2.4. Small things (coins, bullets, ships, pickups) are string sprites designed at 8-16 px, drawn at scale 2 if they are the player's ship. Keep hitboxes smaller than the art.\n\n**Feel numbers** (world units per second, tile = 16): walk 70-90, run 95-140, jump 250-320 with gravity 800, fall cap 330, dash 200-260, bullets 250-320 (player) and 70-120 (enemy), enemy walk 25-45. Hit feedback: `game.hitFx` (Effects).\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '5038,5118p' vendor/engine/my-3d2dge.js && sed -n '7760,7795p' vendor/engine/my-3d2dge.js && sed -n '9765,9838p' vendor/engine/my-3d2dge.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '5038,5118p' vendor/engine/my-3d2dge.js && sed -n '7760,7795p' vendor/engine/my-3d2dge.js && sed -n '9765,9838p' vendor/engine/my-3d2dge.js\"","aggregated_output":"class Blob {\n  /** new E.Blob({ R: 6.5, colors, ears, horns, wings, feet, tail, mouth, face }): a squash-and-stretch rig for slimes and\n   *  jellies; blob.update(dt, state) each step, blob.draw(g, ox, oy, view) in an r.actor */\n  constructor(o = {}) {\n    /** o: its options (R: the radius, 6.5; ears, horns, wings, feet, tail, mouth, face, colors) */\n    this.o = Object.assign({ R: 6.5 }, o);\n    /** C: its colors: dk, base, lt, spec, eye, pupil */\n    this.C = Object.assign({ dk: '#6d2658', base: '#c95f9a', lt: '#f5a3cc', spec: '#fff2f8', eye: '#ffffff', pupil: '#2a0f24' }, o.colors || {});\n    /** sq: squash -0.45..0.45 (- flat, + tall); sqV: its speed; target: the squash it springs toward; look: where\n     *  its eyes look, a ground direction; t: its clock, seconds; squint: eyes narrowed; scale: drawing scale (1) */\n    this.sq = 0; this.sqV = 0; this.target = 0; this.look = [1, 0]; this.t = 0; this.squint = false; this.scale = 1;\n  }\n  /** a squash kick: + stretches (a hop), - squashes (a landing, a hit) */\n  kick(v) { this.sqV += v; }\n  /** s: {squash target -0.4..0.4, look:[dx,dy] ground dir, squint} */\n  update(dt, s = {}) {\n    this.t += dt;\n    const target = s.squash || 0;\n    this.sqV += (-(this.sq - target) * 320 - 14 * this.sqV) * dt; this.sq = clamp(this.sq + this.sqV * dt, -.45, .45);\n    if (s.look) { const l = Math.hypot(s.look[0], s.look[1]); if (l > .01) { this.look[0] = lerp(this.look[0], s.look[0] / l, Math.min(1, dt * 8)); this.look[1] = lerp(this.look[1], s.look[1] / l, Math.min(1, dt * 8)); } }\n    /** walk: 0..1, how fast it is walking (its feet patter) */\n    this.squint = !!s.squint; this.walk = s.walk || 0;\n    /** flap: the wings' speed now, 0 (folded) .. 1; flapP: the wing beat's phase; hang: roosting upside down */\n    this.flap = approach(this.flap === undefined ? 1 : this.flap, s.flap === undefined ? 1 : s.flap, dt * 6); this.flapP = (this.flapP || 0) + dt * 14 * this.flap; this.hang = !!s.hang;   // wings: flap speed 0..1 (0 folds them); hang: roost upside down\n  }\n  /**\n   * draw(g, ox, oy, view). Creature features from the constructor options:\n   *   ears: 'rabbit' | 'cat', horns: true, wings: true (flapping bat wings), feet: true, tail: true,\n   *   mouth: true | 'fangs', face: 'front' (eyes always on the camera side, for Mana-style monsters)\n   * update(dt, { flap: 0..1, hang: true }) slows or folds the wings and hangs a bat upside down from its anchor.\n   */\n  draw(g, ox, oy, view) {\n    if (!this.hang) return this._drawBody(g, ox, oy, view);\n    const pv = Math.round(oy - this.o.R * this.scale * view.scale);   // flip around the body's middle\n    g.save(); g.translate(0, pv * 2); g.scale(1, -1);\n    try { this._drawBody(g, ox, oy, view); } finally { g.restore(); }\n  }\n  _drawBody(g, ox, oy, view) {\n    if (this.o.charView !== false) view = charView(view);\n    const o = this.o, R = o.R * this.scale, a = 1 - this.sq * .55, b = 1 + this.sq, C = this.C, sc = view.scale, t = this.t;\n    const sp = Math.sin(view.pitch), cp = Math.cos(view.pitch) * view.zBoost;\n    const rx = R * a * sc, ry = R * sc * Math.sqrt((a * sp) ** 2 + (b * cp) ** 2);\n    const [cx0, cy0] = view.p(0, 0, R * b);\n    const cx = ox + cx0, cy = oy + cy0, tb = tones(C.base), ext = C.ext || C.dk;\n    // behind the body: wings, ears, tail\n    if (o.wings) {\n      const fold = Math.min(1, (this.flap === undefined ? 1 : this.flap) * 2), f = Math.sin(this.flapP === undefined ? t * 14 : this.flapP) * .5 + .5, wt = tones(C.wing || C.dk);\n      for (const sd of [-1, 1]) {\n        const x0 = cx + sd * rx * .6, y0 = cy - ry * .2, span = rx * (.7 + (.9 + f * .5) * fold), up = ry * ((1.2 - f * 1.3) * fold - .3 * (1 - fold));\n        const pts = [[x0, y0], [x0 + sd * span * .55, y0 - up], [x0 + sd * span, y0 - up * .6 + ry * .2], [x0 + sd * span * .8, y0 + ry * .35], [x0 + sd * span * .5, y0 + ry * .15], [x0 + sd * span * .3, y0 + ry * .4]];\n        px.poly(g, pts, wt.sh); px.line(g, x0, y0, x0 + sd * span * .55, y0 - up, wt.lt);\n      }\n    }\n    if (o.ears === 'rabbit') for (const sd of [-1, 1]) {\n      const ex = cx + sd * rx * .42, ey = cy - ry * .7, h = R * sc * (1.25 + .1 * Math.sin(t * 3 + sd)), w = Math.max(1.2, rx * .22);\n      px.ell(g, ex + sd * h * .15, ey - h * .5, w + .8, h * .55, C.dk); px.ell(g, ex + sd * h * .15, ey - h * .5, w, h * .5 - .6, C.base); px.ell(g, ex + sd * h * .15, ey - h * .45, Math.max(.6, w * .45), h * .32, C.inner || '#f5a3b8');\n    } else if (o.ears === 'cat') for (const sd of [-1, 1]) {\n      const ex = cx + sd * rx * .55, ey = cy - ry * .55;\n      px.poly(g, [[ex - rx * .3, ey + 1], [ex + sd * rx * .15, ey - ry * .75], [ex + rx * .3, ey + 1]], C.dk); px.poly(g, [[ex - rx * .15, ey], [ex + sd * rx * .1, ey - ry * .5], [ex + rx * .15, ey]], C.inner || '#f5a3b8');\n    }\n    if (o.tail) { const w = Math.sin(t * 5) * rx * .3; px.line(g, cx - rx * .8, cy + ry * .3, cx - rx * 1.35, cy - ry * .2 + w, C.dk, Math.max(1, Math.round(sc))); px.disc(g, cx - rx * 1.38, cy - ry * .25 + w, Math.max(1, rx * .16), C.base); }\n    // body with shading\n    px.ell(g, cx, cy, rx, ry, C.dk);\n    px.ell(g, cx + .5, cy - .8, Math.max(1, rx - 1.2), Math.max(1, ry - 1.3), C.base);\n    px.ell(g, cx - rx * .15, cy + ry * .35, Math.max(1, rx * .7), Math.max(.6, ry * .3), tb.sh);\n    px.ell(g, cx + rx * .3, cy - ry * .42, Math.max(1, rx * .38), Math.max(.6, ry * .28), C.lt);\n    px.rect(g, cx + rx * .45, cy - ry * .6, 2, 1, C.spec);\n    if (o.feet) for (const sd of [-1, 1]) { const st = Math.sin(t * 9 + sd) * (this.walk || 0); px.ell(g, cx + sd * rx * .45 + st, cy + ry * .9, Math.max(1.2, rx * .28), Math.max(.8, ry * .16), ext); }\n    if (o.horns) for (const sd of [-1, 1]) { const hx = cx + sd * rx * .45, hy = cy - ry * .72; px.poly(g, [[hx - sd * rx * .15, hy + 1], [hx + sd * rx * .3, hy - ry * .7], [hx + sd * rx * .2, hy + 1]], C.horn || '#e8dcc0'); px.dot(g, hx + sd * rx * .26, hy - ry * .6, '#ffffff'); }\n    // face\n    const la = Math.atan2(this.look[1], this.look[0]), dc = view.depth(0, 0, R * b), front = o.face === 'front';\n    const [lx, ly] = view.p(this.look[0], this.look[1], 0), lxs = clamp(lx, -1, 1);\n    let shown = 0, eyeY = cy;\n    for (const s of [-1, 1]) {\n      let X, Y;\n      if (front) { X = Math.round(cx + lxs * rx * .25 + s * rx * .36); Y = Math.round(cy - ry * .12); }\n      else {\n        const ea = la + s * .42, e = [Math.cos(ea) * R * a * .82, Math.sin(ea) * R * a * .82, R * b * 1.25];\n        if (view.depth(e[0], e[1], e[2]) < dc && !view.isTop && view.pitchDeg < 70) continue;\n        const [ex, ey] = view.p(e[0], e[1], e[2]); X = Math.round(clamp(ox + ex, cx - rx + 2, cx + rx - 3)); Y = Math.round(clamp(oy + ey, cy - ry + 2, cy + ry - 3));\n      }\n      const AC = window.AudioContext || window.webkitAudioContext; if (!AC) throw new Error('Web Audio is not available');\n      const c = this.ctx = new AC();\n      this._master = c.createGain(); this._master.connect(c.destination);\n      this._sfxBus = c.createGain(); this._sfxBus.connect(this._master);\n      this._musBus = c.createGain(); this._musBus.connect(this._master);\n      this._voiceBus = c.createGain(); this._voiceBus.connect(this._master);   // (bus('voice'): a game's babble or speech)\n      this.applyVolume();\n      const nb = c.createBuffer(1, c.sampleRate, c.sampleRate), d = nb.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = this._rnd() * 2 - 1;\n      this._noise = nb;\n      const resume = () => { if (c.state !== 'running') c.resume().catch(() => {}); };\n      for (const ev of ['pointerdown', 'keydown', 'touchstart']) addEventListener(ev, resume, { capture: true, signal: this._signal });\n      resume();\n    } catch (e) { this.failed = e.message || String(e); warn('audio', 'sound is off: ' + this.failed); }\n    return this.ctx;\n  }\n  /** true once the browser lets the game make sound */\n  get ready() { return !!this.ctx && this.ctx.state === 'running'; }\n  /** apply volume, musicVolume, sfxVolume and mute after setting them directly (setVolume and mute call it) */\n  applyVolume() { if (!this.ctx) return; this._master.gain.value = this.muted ? 0 : this.volume; this._sfxBus.gain.value = this.sfxVolume; this._musBus.gain.value = this.musicVolume * (this._ducked || this.ducked ? .35 : 1); this._voiceBus.gain.value = this.voiceVolume; }\n  /** a bus for a sound of the game's own (Web Audio nodes it makes on audio.ctx: a babble voice, a loop, an instrument)\n   *  to connect to, so it follows the volume, the mute and the player's settings: 'sfx', 'music', 'voice' (its level is\n   *  voiceVolume) or 'master'. Returns a GainNode, or null where there is no sound (headless, no Web Audio) */\n  bus(name = 'sfx') {\n    if (!['sfx', 'music', 'voice', 'master'].includes(name)) warn('bus:' + name, 'audio.bus(\"' + name + '\"): no such bus (sfx, music, voice, master): the sfx bus');\n    if (this._game.headless || !this._init()) return null;\n    return name === 'master' ? this._master : name === 'music' ? this._musBus : name === 'voice' ? this._voiceBus : this._sfxBus;\n  }\n  /** set the master volume, 0..1 */\n  setVolume(v) { this.volume = clamp(v, 0, 1); this.applyVolume(); }\n  /** toggle (or set) mute; returns the new state */\n  mute(on = !this.muted) { this.muted = on; this.applyVolume(); return on; }\n  /** the page is hidden (sleep true) or back: the sound sleeps with it unless the player keeps it on (settings.background) */\n  _background(sleep) { const c = this.ctx; if (!c) return; try { if (sleep && c.state === 'running') { this._slept = true; c.suspend().catch(() => {}); } else if (!sleep && this._slept) { this._slept = false; c.resume().catch(() => {}); } } catch (e) { /* closed */ } }\n  /** quiet the music (to 35%) while on: under a game's own pause, map or dialog screen. The engine also ducks it while game.paused */\n  duck(on = true) { on = !!on; if (this.ducked === on) return; this.ducked = on; this.applyVolume(); }\n  _duck(on) { if (this._ducked === on) return; this._ducked = on; this.applyVolume(); }   // (the engine's own: game.paused)\n  /** draw a TileMap from above: floor, roofs by height, water and grass, then markers and the body at (an arrow) */\n  _map(cv, s, large) {\n    const m = s.map, g = cv.getContext('2d'), W = cv.width, H = cv.height, T = m.T, ww = m.w * T, hh = m.h * T, pad = large ? 22 : 8;\n    const k = Math.min((W - pad * 2) / ww, (H - pad * 2) / hh), ox = (W - ww * k) / 2, oy = (H - hh * k) / 2, P = (x, y) => [ox + x * k, oy + y * k];\n    cv._xf = { k, ox, oy };\n    if (!m._shellBase || m._shellBase.v !== m.version || m._shellBase.w !== W) {   // the cells, cached until the map changes\n      const b = mkCanvas(W, H), bg = ctx2d(b); bg.fillStyle = '#121b1d'; bg.fillRect(0, 0, W, H);\n      let top = 1; for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) top = Math.max(top, m.height(cx, cy));\n      for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) {\n        const c = m.cell(cx, cy), tag = m.floorAt((cx + .5) * T, (cy + .5) * T);\n        bg.fillStyle = c > 0 ? mix('#4a5650', '#d2c296', m.height(cx, cy) / top) : tag === 'water' || tag === 'lava' ? (tag === 'water' ? '#1d3e56' : '#6a2a1a') : tag === 'grass' ? '#29452f' : '#1f2b2c';\n        bg.fillRect(Math.floor(ox + cx * T * k), Math.floor(oy + cy * T * k), Math.ceil(T * k), Math.ceil(T * k));\n      }\n      m._shellBase = { v: m.version, w: W, cv: b };\n    }\n    g.drawImage(m._shellBase.cv, 0, 0);\n    g.textAlign = 'center'; g.font = (large ? 12 : 7) + 'px ' + (this._o.theme && this._o.theme.font || 'sans-serif');\n    if (large) for (const [t, x, y] of s.labels || []) { g.fillStyle = '#cbbf9e'; g.fillText(t, ...P(x, y)); }\n    for (const q of (typeof s.markers === 'function' ? s.markers() : s.markers) || []) {\n      const [x, y] = P(q.x, q.y), r = (q.size || (large ? 6 : 3)); g.strokeStyle = g.fillStyle = q.color || '#ffe0a0'; g.lineWidth = large ? 2 : 1; g.beginPath();\n      if (q.kind === 'diamond') { g.moveTo(x, y - r); g.lineTo(x + r, y); g.lineTo(x, y + r); g.lineTo(x - r, y); g.closePath(); g.stroke(); }\n      else if (q.kind === 'cross') { g.moveTo(x - r, y); g.lineTo(x + r, y); g.moveTo(x, y - r); g.lineTo(x, y + r); g.stroke(); }\n      else if (q.kind === 'ring') { g.arc(x, y, r, 0, TAU); g.stroke(); }\n      else { g.arc(x, y, r * .7, 0, TAU); g.fill(); }\n      if (large && q.label) { g.fillStyle = '#ebd3a0'; g.fillText(q.label, x, y + r + 13); }\n    }\n    const F = s.fog;   // fog of war: what was never seen is black, what isn't in sight now dimmed\n    if (F) for (let cy = 0; cy < m.h; cy++) for (let cx = 0; cx < m.w; cx++) { const c = [cx, cy]; if (F.visible(c)) continue; g.fillStyle = F.seen(c) ? 'rgba(6,8,10,.5)' : '#06080a'; g.fillRect(Math.floor(ox + cx * T * k), Math.floor(oy + cy * T * k), Math.ceil(T * k), Math.ceil(T * k)); }\n    if (s.camera) {   // the screen's corners on the ground: what the camera shows\n      const G = this._game, v = G.view, c = G.cam, S = G.screen, q = [[0, 0], [S.W, 0], [S.W, S.H], [0, S.H]].map(([a, b]) => v.toGround(c.x + a, c.y + b));\n      if (q.every(Boolean)) { g.strokeStyle = '#f8efd0'; g.lineWidth = 1; g.beginPath(); q.forEach(([a, b], i) => i ? g.lineTo(...P(a, b)) : g.moveTo(...P(a, b))); g.closePath(); g.stroke(); }\n    }\n    if (s.at) {\n      const [x, y] = P(s.at.x, s.at.y), a = s.at.facing || 0, r = large ? 9 : 5; g.fillStyle = '#f8efd0'; g.strokeStyle = '#10181a'; g.lineWidth = 1.5; g.beginPath();\n      g.moveTo(x + Math.cos(a) * r, y + Math.sin(a) * r); g.lineTo(x + Math.cos(a + 2.45) * r * .8, y + Math.sin(a + 2.45) * r * .8); g.lineTo(x + Math.cos(a - 2.45) * r * .8, y + Math.sin(a - 2.45) * r * .8); g.closePath(); g.fill(); g.stroke();\n    }\n    g.fillStyle = '#b6c5b5'; g.textAlign = 'right'; g.fillText('N', W - (large ? 12 : 5), large ? 18 : 10);\n  }\n  /** each step (the game calls it after reading input): follow game.paused, time out the toast and the card, and while a\n   *  screen is open, move the focus with the game's input and hold the rest of it back from the game */\n  _step() {\n    const g = this._game, I = g.input, now = g.real, sc = g.scene, play = !!sc && (!!sc.pausable || g.sceneName === 'main');\n    const pause = this._pauseSpec() && (!this._sys || (g.pauseOverlay !== false && play));   // (the engine's own menu stays out of a game that draws its own pause)\n    if (pause && g.paused && !this._stack.length) this.show('pause');\n    if (!g.paused && this._stack.length && (this._ownPause || (pause && this._stack.some(t => t.name === 'pause')))) { this._stack.length = 0; this._ownPause = false; this._capEnd(); this._render(); }   // resumed from code\n    if (this.root) {\n      if (this._toastEnd && now > this._toastEnd) { this._els.toast.classList.remove('on'); this._toastEnd = 0; }\n      if (this._tutEnd && now > this._tutEnd) this.tutorial(null);\n      this.root.classList.toggle('esh-still', !!g.reduceMotion);\n    }\n    if (!this._stack.length) return;\n    const keep = this._held; this._held = new Set();\n    const has = a => !!I.map[a], confirm = has('confirm') && I.pressed('confirm'), cancel = has('cancel') && I.pressed('cancel'), closeAll = has('pause') && I.pressed('pause'), mv = I.move();\n    const hit = ['up', 'down', 'left', 'right'].find(a => has(a) && I.pressed(a)), dir = Math.abs(mv[1]) > .5 ? (mv[1] < 0 ? 'up' : 'down') : Math.abs(mv[0]) > .5 ? (mv[0] < 0 ? 'left' : 'right') : null;\n    for (const a in I.map) if (!keep.has(a)) I.suppress(a);   // the game doesn't see what the menu used\n    if (this._cap) { this._capPad(); return; }   // binding: the next button is the answer, not a move in the menu\n    if (!this.root) { if (cancel) this.back(); else if (closeAll) this.hide(); return; }\n    if (hit) { this._dir = hit; this._dirT = now + .35; this._nav(hit); }   // a press (however short), then the held direction repeats\n    else if (dir !== this._dir) { this._dir = dir; this._dirT = now + .35; if (dir) this._nav(dir); }\n    else if (dir && now > this._dirT) { this._dirT = now + .09; this._nav(dir); }\n    const f = document.activeElement, mine = f && this._els.scr.contains(f);\n    if (confirm && mine && f.tagName === 'BUTTON') f.click();\n    else if (cancel) this.back();\n    else if (closeAll) this.hide();   // Start (or P) closes the whole menu; Escape and B go back one screen\n  }\n  /** binding a controller button: the first one pressed since binding began (Start cancels) */\n  _capPad() {\n    const c = this._cap, I = this._ctlI(); if (!c || c.device !== 'pad') return;\n    const i = I.padPrev.findIndex((on, k) => on && !c.prev[k]); c.prev = I.padPrev.slice();\n    const ra = RSTICK.find(k => I.held.has(k) && !c.prevR.includes(k)); c.prevR = RSTICK.filter(k => I.held.has(k));   // (the right stick pushed: its direction)\n    if (i === 9) this._capEnd('Not changed.'); else if (i >= 0) this._capBind('Pad' + i); else if (ra) this._capBind(ra);\n  }\n  /** move the focus (or turn a focused slider or choice), keeping it in view */\n  _nav(dir) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat > src/rigs.js <<'EOF'\n(function(B){\n  'use strict';\n  const E=My3D2dge,{px}=E,C={ink:'#101e29',cream:'#fff1c3',gold:'#f6bd57',amber:'#d98239',teal:'#4bd5bc',pale:'#e8ecdf',rose:'#ef787c'};\n  B.COLORS=C;\n  const dot=(g,x,y,c)=>px.rect(g,x,y,1,1,c);\n  B.hex=function(g,x,y,r,c){px.poly(g,[[x-r,y],[x-r*.5,y-r*.86],[x+r*.5,y-r*.86],[x+r,y],[x+r*.5,y+r*.86],[x-r*.5,y+r*.86]],c);};\n  B.flowerDraw=function(g,x,y,size,t,color=C.rose,warn=false){\n    const sway=Math.sin(t*2+x)*1.2;\n    px.line(g,x,y,x+sway,y-size*1.1,'#2d624d',Math.max(1,size*.13));\n    px.ell(g,x-size*.28,y-size*.35,size*.34,size*.13,'#4c8861');px.ell(g,x+size*.25,y-size*.61,size*.3,size*.12,'#568b67');\n    const cy=y-size*1.2,rr=size*.27,tt=E.tones(color);\n    for(let i=0;i<5;i++){const a=i*Math.PI*2/5-Math.PI/2;px.disc(g,x+sway+Math.cos(a)*rr,cy+Math.sin(a)*rr,rr,tt.sh);px.disc(g,x+sway+Math.cos(a)*rr-.6,cy+Math.sin(a)*rr-1,rr*.78,tt.lt);}\n    px.disc(g,x+sway,cy,size*.17,C.ink);px.disc(g,x+sway,cy-1,size*.12,warn?'#fff4d7':C.gold);\n  };\n  class BeeRig extends E.Blob {\n    constructor(kind='worker'){super({R:8,face:'front',colors:{dk:C.ink,base:kind==='fast'?'#e5e8d7':'#edb84f',lt:kind==='fast'?'#ffffff':'#ffe48b',spec:'#fff8d8'}});this.kind=kind;this.state={};this.visualY=null;}\n    update(dt,s={}){super.update(dt,{look:[s.dir||1,0],squash:s.state==='build'?Math.sin(this.t*22)*.13:-(s.bank||0)*.3,flap:1});this.state=s;this.visualY=this.visualY===null?s.y:this.visualY+(s.y-this.visualY)*Math.min(1,dt*16);}\n    draw(g,x,y,view,scale=1){\n      const fast=this.kind==='fast',s=this.state,flap=Math.sin(this.t*(fast?56:39)),bob=Math.sin(this.t*8)*1.1,dir=s.dir||1;\n      g.save();g.translate(x,y+bob);g.scale(scale,scale);\n      const wing='#aecfd3';\n      if(fast){px.poly(g,[[-3,-4],[-12,-20],[-1,-15],[5,-4]],C.ink);px.poly(g,[[-2,-5],[-10,-18],[0,-13],[4,-5]],'#e8f8ef');px.poly(g,[[3,-4],[12,-17],[13,-8],[7,0]],wing);}\n      else{px.ell(g,-5,-8-Math.abs(flap)*3,5,3+Math.abs(flap)*4,C.ink);px.ell(g,-5,-9-Math.abs(flap)*3,4,2+Math.abs(flap)*4,'#d9ebe0');px.ell(g,5,-8+flap*2,5,4,wing);}\n      px.ell(g,0,0,11-(this.sq*6),8+this.sq*5,C.ink);\n      const tt=E.tones(fast?'#dce5d7':'#edb74e');px.ell(g,0,-1,9,6,tt.base);px.ell(g,-2,-3,6,3,tt.lt);px.ell(g,1,4,7,2,tt.sh);\n      for(const xx of [-4,2])px.rect(g,xx,-5,3,10,C.ink);\n      px.ell(g,dir*8,-1,4,5,fast?'#f8f8e6':'#f9d47d');\n      const ey=fast?-3:-2;px.rect(g,dir*9-1,ey,2,3,C.ink);dot(g,dir*9-1,ey,'#fff');\n      px.line(g,dir*7,-6,dir*10,-10,C.ink);px.disc(g,dir*10,-10,1,C.gold);\n      px.poly(g,[[-dir*10,0],[-dir*15,2],[-dir*10,4]],C.ink);\n      if(fast){px.line(g,-dir*17,2,-dir*24,2,'#9ac2c2');dot(g,-dir*29,2,'#547b81');}\n      if(s.state==='build'){B.hex(g,-2,9,5,C.gold);px.rect(g,-7,9,10,2,'#9d562d');}\n      g.restore();\n    }\n  }\n  class CanRig {\n    constructor(seat=1){this.seat=seat;this.t=0;this.s={};}\n    update(dt,state){this.t+=dt;this.s=state;}\n    draw(g,x,y,view,scale=1){\n      const s=this.s,tt=E.tones(this.seat===1?'#5fcdc1':'#ee916f'),rec=(s.recoil||0)*2,hop=(s.hop||0)>0?Math.sin((1-s.hop/.75)*Math.PI)*21:0;\n      const lean=(s.vx||0)/140+(s.ammo<9?Math.sin(this.t*18)*.7:0),bob=Math.sin(this.t*3)*.35;\n      g.save();g.translate(x+lean,y-hop+bob+rec);g.scale(scale,scale);\n      // Shoes, rounded pressure vessel, raised crimp and top-mounted nozzle.\n      px.ell(g,-7,0,6,2,C.ink);px.ell(g,7,0,6,2,C.ink);\n      px.rect(g,-10,-28,20,26,C.ink);px.ell(g,0,-26,10,4,C.ink);px.ell(g,0,-3,10,4,C.ink);\n      px.rect(g,-8,-26,16,23,tt.sh);px.rect(g,-7,-26,11,23,tt.base);px.rect(g,-5,-25,3,21,tt.lt);px.rect(g,6,-24,1,18,tt.deep);\n      px.ell(g,0,-26,8,3,'#b7ccbc');px.ell(g,0,-28,7,2,'#e9e6d4');\n      px.rect(g,-3,-34,8,5,C.ink);px.rect(g,-2,-34,5,3,this.seat===1?'#f6d17d':'#f7f1d2');px.rect(g,0,-37,this.seat===1?3:5,4,C.ink);dot(g,1,-37,C.cream);\n      px.rect(g,-8,-18,16,12,C.cream);px.rect(g,-8,-18,16,2,tt.lt);\n      if(this.seat===1){px.rect(g,-7,-15,3,7,tt.deep);}else{for(let yy=-17;yy<-6;yy+=4)px.line(g,-8,yy,7,yy+4,tt.deep);}\n      px.rect(g,-2,-15,3,3,C.ink);px.rect(g,4,-15,3,3,C.ink);dot(g,-1,-15,'#fff');dot(g,5,-15,'#fff');\n      px.line(g,0,-9,3,-8,C.ink);px.line(g,3,-8,5,-10,C.ink);\n      px.rect(g,-8,-4,16,2,tt.lt);\n      if(s.swap>0){for(let i=0;i<3;i++)px.line(g,-14+i*10,-38,-11+i*10,-43,C.gold);}\n      E.font.text(g,String(this.seat),-2,-23,C.ink,{outline:false});\n      g.restore();\n    }\n  }\n  class BirdRig extends E.Blob {\n    constructor(){super({R:7,face:'front',colors:{dk:C.ink,base:'#36b9b2',lt:'#8fe8c4',spec:'#ffffff'}});this.s={};}\n    update(dt,state){super.update(dt,{squash:state.state==='feed'?-.1:0,look:[-1,0],flap:1});this.s=state;}\n    draw(g,x,y,view,scale=1){\n      const feed=this.s.state==='feed',ang=Math.sin(this.t*53),ir=this.s.irritation||0;\n      g.save();g.translate(x,y+Math.sin(this.t*9)*1.3);g.scale(scale,scale);\n      px.poly(g,[[5,1],[15,6],[11,9],[2,7]],C.ink);px.poly(g,[[5,2],[13,6],[6,7]],'#308a9b');\n      px.poly(g,[[-1,0],[2,-18],[8,-22],[8,-5],[5,4]],C.ink);px.poly(g,[[0,0],[3,-15],[6,-17],[5,-4]],ang>0?'#c7efdd':'#7ec9cc');\n      px.ell(g,1,2,10,7,C.ink);px.ell(g,1,1,8,5,ir>1?'#94ba63':'#38bcb1');px.ell(g,-1,4,5,2,'#a4e3b6');px.disc(g,-6,-4,6,C.ink);px.disc(g,-6,-5,5,ir>1?'#b9d473':'#6ae2bd');px.rect(g,-10,-5,2,2,C.ink);dot(g,-10,-5,'#fff');\n      px.line(g,-11,-3,-25,-2+(feed?3:0),C.ink,2);px.line(g,-11,-3,-23,-2+(feed?3:0),'#d6ac77');\n      if(ir>0){px.line(g,-9,-10,-5,-8,C.ink);}\n      g.restore();\n    }\n  }\n  B.BeeRig=BeeRig;B.CanRig=CanRig;B.BirdRig=BirdRig;\n  B.combDraw=function(g,x,y,o,t,scale=1){\n    const red=o.red,tt=E.tones(red?'#e77b66':'#efa846');g.save();g.translate(x,y);g.scale(scale,scale);\n    if(o.kind==='hive'){\n      for(let k=0;k<5;k++){const yy=7-k*4,rr=14-k*2;px.ell(g,0,yy,rr,4,C.ink);px.ell(g,-.5,yy-1,rr-1,2,k%2?tt.base:tt.lt);}px.ell(g,0,8,4,4,C.ink);dot(g,-1,7,tt.sh);\n    }else{\n      B.hex(g,0,0,12,C.ink);B.hex(g,0,-1,10,tt.sh);B.hex(g,-1,-2,8,tt.base);\n      const cells=red?[[-3,-4],[3,-1],[-2,4]]:[[-4,-3],[3,-3],[-1,3]];\n      for(const [xx,yy] of cells){B.hex(g,xx,yy,3.4,C.ink);B.hex(g,xx,yy,2,tt.sh);px.line(g,xx-1,yy-2,xx+1,yy-2,tt.lt);}\n      if(red){px.rect(g,7,-8,3,4,'#fff0ba');px.rect(g,6,-7,5,2,'#fff0ba');}\n      if(Math.sin(t*3+o.x)>.94)dot(g,-5,-8,'#fff4cf');\n    }\n    g.restore();\n  };\n  B.bossDraw=function(g,x,y,b,t,view){\n    const open=b.open>0,phase=b.phase||0,tt=E.tones(['#dca754','#e28a77','#bca0db'][Math.min(phase,2)]),f=Math.sin(t*2);\n    // Pageant float: wings, crown, ceremonial ruff and one enormous shield bud.\n    px.poly(g,[[x-25,y],[x-58,y-18+f*3],[x-67,y-5],[x-48,y+15],[x-24,y+14]],'#1a2832');\n    px.poly(g,[[x+25,y],[x+58,y-18-f*3],[x+67,y-5],[x+48,y+15],[x+24,y+14]],'#1a2832');\n    for(const sd of [-1,1]){px.poly(g,[[x+sd*25,y+1],[x+sd*57,y-14+sd*f*3],[x+sd*61,y-5],[x+sd*45,y+11]],'#c5c7bb');px.line(g,x+sd*30,y+3,x+sd*55,y-5,'#e5e4c9');}\n    px.ell(g,x,y+2,30,23,C.ink);px.ell(g,x,y,27,20,tt.sh);px.ell(g,x-4,y-5,21,14,tt.base);px.ell(g,x-6,y-10,13,6,tt.lt);\n    px.poly(g,[[x-18,y-18],[x-23,y-32],[x-10,y-25],[x,y-38],[x+10,y-25],[x+23,y-32],[x+18,y-18]],C.ink);\n    px.poly(g,[[x-16,y-21],[x-19,y-29],[x-9,y-23],[x,y-34],[x+9,y-23],[x+19,y-29],[x+16,y-21]],'#f3ce78');\n    px.disc(g,x,y-28,2,'#f58e82');\n    px.rect(g,x-15,y-11,6,5,C.ink);px.rect(g,x+9,y-11,6,5,C.ink);px.rect(g,x-14,y-11,2,2,'#fff8df');px.rect(g,x+10,y-11,2,2,'#fff8df');\n    px.line(g,x-5,y-1,x,y+2,C.ink,2);px.line(g,x,y+2,x+5,y-1,C.ink,2);\n    const sy=y+19;\n    for(let i=0;i<5;i++){const a=i*Math.PI*2/5+t*.15;px.ell(g,x+Math.cos(a)*15,sy+Math.sin(a)*7,8,5,open?'#e9c79d':'#a37589');}\n    B.hex(g,x,sy,13,C.ink);B.hex(g,x,sy,11,open?'#ffe1a0':'#644a73');B.hex(g,x,sy,7,open?'#f49f66':'#af8b9b');\n    if(\"'!open){px.rect(g,x-4,sy-2,8,6,C.ink);px.line(g,x-3,sy-2,x-3,sy-6,C.ink,2);px.line(g,x-3,sy-6,x+3,sy-6,C.ink,2);px.line(g,x+3,sy-6,x+3,sy-2,C.ink,2);}\n    else {px.line(g,x-5,sy,x+4,sy,C.ink);px.line(g,x,sy-5,x,sy+5,C.ink);}\n    for(let i=0;i<b.phases;i++){B.hex(g,x-12+i*12,y+40,4,i<phase?'\"'#67dbb3':C.ink);if(i>=phase)B.hex(g,x-12+i*12,y+40,2,tt.base);}\n    px.line(g,x+31,y+8,x+48,y-6+f*5,C.ink,3);px.line(g,x+48,y-6+f*5,x+59,y-23+f*5,C.gold,2);\n  };\n  B.pressureAnim=E.anim([\n    E.sprite(['...w...','..www..','.w.w.w.','w..w..w'],{w:'#c6f1db'}),\n    E.sprite(['.w...w.','..w.w..','...w...','..w.w..'],{w:'#f0ffe8'})\n  ],14,{pingpong:true});\n})(globalThis.BCP=globalThis.BCP||{});\nEOF\ncat > src/audio.js <<'EOF'\n(function(B){\n  'use strict';\n  B.synthTone=function(ctx,bus,t,freq,dur=.12,vol=.15,wave='triangle'){\n    const o=ctx.createOscillator(),g=ctx.createGain();o.type=wave;o.frequency.setValueAtTime(freq,t);o.frequency.exponentialRampToValueAtTime(Math.max(40,freq*.94),t+dur);\n    g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vol,t+.008);g.gain.exponentialRampToValueAtTime(.00001,t+dur);o.connect(g);g.connect(bus);o.start(t);o.stop(t+dur+.01);return o;\n  };\n  B.Audio=function(game){\n    const A=game.audio;let mode='',paused=false,last=0;const nodes=new Set();\n    const melodies={\n      title:'D5 F5 E5 D#5 E5 A5 G5 F5 | E5 . D5 . A4 . C5 .',\n      live:'D5 Eb5 E5 F5 E5 Eb5 D5 C#5 | D5 A5 F5 E5 G5 F5 E5 C#5 | D5 F5 A5 C6 Bb5 A5 G5 E5 | F5 E5 Eb5 D5 C#5 E5 A4 .',\n      boss:'D5 Eb5 E5 F5 Ab5 G5 F#5 F5 | E5 G5 Bb5 A5 F5 E5 C#5 A4',\n      win:'D5 . F5 A5 . C6 . A5 | D6 . . . A5 . F5 .',\n      loss:'F5 . E5 . Eb5 . D5 . | C#5 . A4 . D4 - - .'\n    };\n    function song(name){return {bpm:name==='boss'?158:144,steps:4,tracks:[{wave:'pulse12',vol:.13,notes:melodies[name]||melodies.live},{wave:'triangle',vol:.19,notes:'D3 . A3 . D3 . F3 . | Bb2 . F3 . A2 . C#3 . | D3 . A3 . D3 . F3 . | G2 . D3 . A2 . C#3 .'},{wave:'noise',vol:.025,notes:'C5 . . . . . C6 . | C5 . . . . . C6 .'}]};}\n    function babble(pitch=500){if(game.headless||globalThis.AIHub?.server)return;const bus=A.bus('voice'),ctx=A.ctx;if(\"'!ctx||!bus||paused)return;for(let i=0;i<5;i++){const n=B.synthTone(ctx,bus,ctx.currentTime+i*.055,pitch*[1,1.37,.89,1.62,1.18][i],.05,.07,'\"'square');nodes.add(n);n.onended=()=>nodes.delete(n);}}\n    const defs={\n      spray:{wave:'noise',freq:1600,to:400,dur:.075,vol:.14},convert:{wave:'triangle',freq:270,to:730,dur:.12,vol:.25},shatter:{wave:'noise',freq:900,to:200,dur:.1,vol:.15},feed:{wave:'sine',freq:690,arp:[0,4,7,12],step:.045,dur:.24,vol:.26},call:{wave:'sine',freq:980,to:1400,dur:.13,vol:.21},hive:{wave:'pulse12',freq:180,arp:[0,3,7],step:.07,dur:.22,vol:.18},warning:{wave:'saw',freq:100,to:240,dur:.28,vol:.16},grow:{wave:'triangle',freq:130,to:440,dur:.14,vol:.15},swap:{wave:'triangle',freq:160,to:660,dur:.27,vol:.24},hop:{wave:'sine',freq:230,to:680,dur:.16,vol:.2},stock:{wave:'pulse12',freq:520,arp:[0,4,7,12],step:.08,dur:.36,vol:.23},shieldOpen:{wave:'triangle',freq:340,arp:[0,7,12],step:.08,dur:.3,vol:.23},shieldBreak:{wave:'saw',freq:250,arp:[0,4,7,12],step:.06,dur:.32,vol:.2},bossHit:{wave:'triangle',freq:180,to:370,dur:.1,vol:.22},birdHit:{wave:'sine',freq:700,to:160,dur:.2,vol:.18},retreat:{wave:'sine',freq:470,to:130,dur:.4,vol:.16},clear:{wave:'pulse12',freq:440,arp:[0,4,7,12],step:.1,dur:.5,vol:.19}\n    };\n    return {\n      set(name){if(mode===name)return;mode=name;if(\"'!paused&&!globalThis.AIHub?.server)A.music(song(name),{sync:true});if(name==='\"'win'||name==='loss')babble(name==='win'?620:330);},\n      update(w){if(\"'!w)return;for(const e of w.events){if(e.id<=last)continue;if(defs[e.kind]&&!paused&&!globalThis.AIHub?.server)A.sfx(defs[e.kind]);if(['\"'encounter','birdReturn','retreat'].includes(e.kind))babble(e.kind==='encounter'?360:850);}last=w.eventId;},\n      resetEvents(id=0){last=id;},\n      pause(on){if(paused===on)return;paused=on;if(on){A.music(null);for(const n of nodes){try{n.stop();}catch{}}nodes.clear();}else if(mode&&\"'!globalThis.AIHub?.server)A.music(song(mode),{sync:true});},\n      stop(){paused=true;A.music(null);for(const n of nodes){try{n.stop();}catch{}}nodes.clear();if(A.ctx&&A.ctx.state==='\"'running')A.ctx.suspend().catch(()=>{});},\n      get mode(){return mode;},get paused(){return paused;},get activeNodes(){return nodes.size;},song\n    };\n  };\n})(globalThis.BCP=globalThis.BCP||{});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat > src/rigs.js <<'EOF'\n(function(B){\n  'use strict';\n  const E=My3D2dge,{px}=E,C={ink:'#101e29',cream:'#fff1c3',gold:'#f6bd57',amber:'#d98239',teal:'#4bd5bc',pale:'#e8ecdf',rose:'#ef787c'};\n  B.COLORS=C;\n  const dot=(g,x,y,c)=>px.rect(g,x,y,1,1,c);\n  B.hex=function(g,x,y,r,c){px.poly(g,[[x-r,y],[x-r*.5,y-r*.86],[x+r*.5,y-r*.86],[x+r,y],[x+r*.5,y+r*.86],[x-r*.5,y+r*.86]],c);};\n  B.flowerDraw=function(g,x,y,size,t,color=C.rose,warn=false){\n    const sway=Math.sin(t*2+x)*1.2;\n    px.line(g,x,y,x+sway,y-size*1.1,'#2d624d',Math.max(1,size*.13));\n    px.ell(g,x-size*.28,y-size*.35,size*.34,size*.13,'#4c8861');px.ell(g,x+size*.25,y-size*.61,size*.3,size*.12,'#568b67');\n    const cy=y-size*1.2,rr=size*.27,tt=E.tones(color);\n    for(let i=0;i<5;i++){const a=i*Math.PI*2/5-Math.PI/2;px.disc(g,x+sway+Math.cos(a)*rr,cy+Math.sin(a)*rr,rr,tt.sh);px.disc(g,x+sway+Math.cos(a)*rr-.6,cy+Math.sin(a)*rr-1,rr*.78,tt.lt);}\n    px.disc(g,x+sway,cy,size*.17,C.ink);px.disc(g,x+sway,cy-1,size*.12,warn?'#fff4d7':C.gold);\n  };\n  class BeeRig extends E.Blob {\n    constructor(kind='worker'){super({R:8,face:'front',colors:{dk:C.ink,base:kind==='fast'?'#e5e8d7':'#edb84f',lt:kind==='fast'?'#ffffff':'#ffe48b',spec:'#fff8d8'}});this.kind=kind;this.state={};this.visualY=null;}\n    update(dt,s={}){super.update(dt,{look:[s.dir||1,0],squash:s.state==='build'?Math.sin(this.t*22)*.13:-(s.bank||0)*.3,flap:1});this.state=s;this.visualY=this.visualY===null?s.y:this.visualY+(s.y-this.visualY)*Math.min(1,dt*16);}\n    draw(g,x,y,view,scale=1){\n      const fast=this.kind==='fast',s=this.state,flap=Math.sin(this.t*(fast?56:39)),bob=Math.sin(this.t*8)*1.1,dir=s.dir||1;\n      g.save();g.translate(x,y+bob);g.scale(scale,scale);\n      const wing='#aecfd3';\n      if(fast){px.poly(g,[[-3,-4],[-12,-20],[-1,-15],[5,-4]],C.ink);px.poly(g,[[-2,-5],[-10,-18],[0,-13],[4,-5]],'#e8f8ef');px.poly(g,[[3,-4],[12,-17],[13,-8],[7,0]],wing);}\n      else{px.ell(g,-5,-8-Math.abs(flap)*3,5,3+Math.abs(flap)*4,C.ink);px.ell(g,-5,-9-Math.abs(flap)*3,4,2+Math.abs(flap)*4,'#d9ebe0');px.ell(g,5,-8+flap*2,5,4,wing);}\n      px.ell(g,0,0,11-(this.sq*6),8+this.sq*5,C.ink);\n      const tt=E.tones(fast?'#dce5d7':'#edb74e');px.ell(g,0,-1,9,6,tt.base);px.ell(g,-2,-3,6,3,tt.lt);px.ell(g,1,4,7,2,tt.sh);\n      for(const xx of [-4,2])px.rect(g,xx,-5,3,10,C.ink);\n      px.ell(g,dir*8,-1,4,5,fast?'#f8f8e6':'#f9d47d');\n      const ey=fast?-3:-2;px.rect(g,dir*9-1,ey,2,3,C.ink);dot(g,dir*9-1,ey,'#fff');\n      px.line(g,dir*7,-6,dir*10,-10,C.ink);px.disc(g,dir*10,-10,1,C.gold);\n      px.poly(g,[[-dir*10,0],[-dir*15,2],[-dir*10,4]],C.ink);\n      if(fast){px.line(g,-dir*17,2,-dir*24,2,'#9ac2c2');dot(g,-dir*29,2,'#547b81');}\n      if(s.state==='build'){B.hex(g,-2,9,5,C.gold);px.rect(g,-7,9,10,2,'#9d562d');}\n      g.restore();\n    }\n  }\n  class CanRig {\n    constructor(seat=1){this.seat=seat;this.t=0;this.s={};}\n    update(dt,state){this.t+=dt;this.s=state;}\n    draw(g,x,y,view,scale=1){\n      const s=this.s,tt=E.tones(this.seat===1?'#5fcdc1':'#ee916f'),rec=(s.recoil||0)*2,hop=(s.hop||0)>0?Math.sin((1-s.hop/.75)*Math.PI)*21:0;\n      const lean=(s.vx||0)/140+(s.ammo<9?Math.sin(this.t*18)*.7:0),bob=Math.sin(this.t*3)*.35;\n      g.save();g.translate(x+lean,y-hop+bob+rec);g.scale(scale,scale);\n      // Shoes, rounded pressure vessel, raised crimp and top-mounted nozzle.\n      px.ell(g,-7,0,6,2,C.ink);px.ell(g,7,0,6,2,C.ink);\n      px.rect(g,-10,-28,20,26,C.ink);px.ell(g,0,-26,10,4,C.ink);px.ell(g,0,-3,10,4,C.ink);\n      px.rect(g,-8,-26,16,23,tt.sh);px.rect(g,-7,-26,11,23,tt.base);px.rect(g,-5,-25,3,21,tt.lt);px.rect(g,6,-24,1,18,tt.deep);\n      px.ell(g,0,-26,8,3,'#b7ccbc');px.ell(g,0,-28,7,2,'#e9e6d4');\n      px.rect(g,-3,-34,8,5,C.ink);px.rect(g,-2,-34,5,3,this.seat===1?'#f6d17d':'#f7f1d2');px.rect(g,0,-37,this.seat===1?3:5,4,C.ink);dot(g,1,-37,C.cream);\n      px.rect(g,-8,-18,16,12,C.cream);px.rect(g,-8,-18,16,2,tt.lt);\n      if(this.seat===1){px.rect(g,-7,-15,3,7,tt.deep);}else{for(let yy=-17;yy<-6;yy+=4)px.line(g,-8,yy,7,yy+4,tt.deep);}\n      px.rect(g,-2,-15,3,3,C.ink);px.rect(g,4,-15,3,3,C.ink);dot(g,-1,-15,'#fff');dot(g,5,-15,'#fff');\n      px.line(g,0,-9,3,-8,C.ink);px.line(g,3,-8,5,-10,C.ink);\n      px.rect(g,-8,-4,16,2,tt.lt);\n      if(s.swap>0){for(let i=0;i<3;i++)px.line(g,-14+i*10,-38,-11+i*10,-43,C.gold);}\n      E.font.text(g,String(this.seat),-2,-23,C.ink,{outline:false});\n      g.restore();\n    }\n  }\n  class BirdRig extends E.Blob {\n    constructor(){super({R:7,face:'front',colors:{dk:C.ink,base:'#36b9b2',lt:'#8fe8c4',spec:'#ffffff'}});this.s={};}\n    update(dt,state){super.update(dt,{squash:state.state==='feed'?-.1:0,look:[-1,0],flap:1});this.s=state;}\n    draw(g,x,y,view,scale=1){\n      const feed=this.s.state==='feed',ang=Math.sin(this.t*53),ir=this.s.irritation||0;\n      g.save();g.translate(x,y+Math.sin(this.t*9)*1.3);g.scale(scale,scale);\n      px.poly(g,[[5,1],[15,6],[11,9],[2,7]],C.ink);px.poly(g,[[5,2],[13,6],[6,7]],'#308a9b');\n      px.poly(g,[[-1,0],[2,-18],[8,-22],[8,-5],[5,4]],C.ink);px.poly(g,[[0,0],[3,-15],[6,-17],[5,-4]],ang>0?'#c7efdd':'#7ec9cc');\n      px.ell(g,1,2,10,7,C.ink);px.ell(g,1,1,8,5,ir>1?'#94ba63':'#38bcb1');px.ell(g,-1,4,5,2,'#a4e3b6');px.disc(g,-6,-4,6,C.ink);px.disc(g,-6,-5,5,ir>1?'#b9d473':'#6ae2bd');px.rect(g,-10,-5,2,2,C.ink);dot(g,-10,-5,'#fff');\n      px.line(g,-11,-3,-25,-2+(feed?3:0),C.ink,2);px.line(g,-11,-3,-23,-2+(feed?3:0),'#d6ac77');\n      if(ir>0){px.line(g,-9,-10,-5,-8,C.ink);}\n      g.restore();\n    }\n  }\n  B.BeeRig=BeeRig;B.CanRig=CanRig;B.BirdRig=BirdRig;\n  B.combDraw=function(g,x,y,o,t,scale=1){\n    const red=o.red,tt=E.tones(red?'#e77b66':'#efa846');g.save();g.translate(x,y);g.scale(scale,scale);\n    if(o.kind==='hive'){\n      for(let k=0;k<5;k++){const yy=7-k*4,rr=14-k*2;px.ell(g,0,yy,rr,4,C.ink);px.ell(g,-.5,yy-1,rr-1,2,k%2?tt.base:tt.lt);}px.ell(g,0,8,4,4,C.ink);dot(g,-1,7,tt.sh);\n    }else{\n      B.hex(g,0,0,12,C.ink);B.hex(g,0,-1,10,tt.sh);B.hex(g,-1,-2,8,tt.base);\n      const cells=red?[[-3,-4],[3,-1],[-2,4]]:[[-4,-3],[3,-3],[-1,3]];\n      for(const [xx,yy] of cells){B.hex(g,xx,yy,3.4,C.ink);B.hex(g,xx,yy,2,tt.sh);px.line(g,xx-1,yy-2,xx+1,yy-2,tt.lt);}\n      if(red){px.rect(g,7,-8,3,4,'#fff0ba');px.rect(g,6,-7,5,2,'#fff0ba');}\n      if(Math.sin(t*3+o.x)>.94)dot(g,-5,-8,'#fff4cf');\n    }\n    g.restore();\n  };\n  B.bossDraw=function(g,x,y,b,t,view){\n    const open=b.open>0,phase=b.phase||0,tt=E.tones(['#dca754','#e28a77','#bca0db'][Math.min(phase,2)]),f=Math.sin(t*2);\n    // Pageant float: wings, crown, ceremonial ruff and one enormous shield bud.\n    px.poly(g,[[x-25,y],[x-58,y-18+f*3],[x-67,y-5],[x-48,y+15],[x-24,y+14]],'#1a2832');\n    px.poly(g,[[x+25,y],[x+58,y-18-f*3],[x+67,y-5],[x+48,y+15],[x+24,y+14]],'#1a2832');\n    for(const sd of [-1,1]){px.poly(g,[[x+sd*25,y+1],[x+sd*57,y-14+sd*f*3],[x+sd*61,y-5],[x+sd*45,y+11]],'#c5c7bb');px.line(g,x+sd*30,y+3,x+sd*55,y-5,'#e5e4c9');}\n    px.ell(g,x,y+2,30,23,C.ink);px.ell(g,x,y,27,20,tt.sh);px.ell(g,x-4,y-5,21,14,tt.base);px.ell(g,x-6,y-10,13,6,tt.lt);\n    px.poly(g,[[x-18,y-18],[x-23,y-32],[x-10,y-25],[x,y-38],[x+10,y-25],[x+23,y-32],[x+18,y-18]],C.ink);\n    px.poly(g,[[x-16,y-21],[x-19,y-29],[x-9,y-23],[x,y-34],[x+9,y-23],[x+19,y-29],[x+16,y-21]],'#f3ce78');\n    px.disc(g,x,y-28,2,'#f58e82');\n    px.rect(g,x-15,y-11,6,5,C.ink);px.rect(g,x+9,y-11,6,5,C.ink);px.rect(g,x-14,y-11,2,2,'#fff8df');px.rect(g,x+10,y-11,2,2,'#fff8df');\n    px.line(g,x-5,y-1,x,y+2,C.ink,2);px.line(g,x,y+2,x+5,y-1,C.ink,2);\n    const sy=y+19;\n    for(let i=0;i<5;i++){const a=i*Math.PI*2/5+t*.15;px.ell(g,x+Math.cos(a)*15,sy+Math.sin(a)*7,8,5,open?'#e9c79d':'#a37589');}\n    B.hex(g,x,sy,13,C.ink);B.hex(g,x,sy,11,open?'#ffe1a0':'#644a73');B.hex(g,x,sy,7,open?'#f49f66':'#af8b9b');\n    if(\"'!open){px.rect(g,x-4,sy-2,8,6,C.ink);px.line(g,x-3,sy-2,x-3,sy-6,C.ink,2);px.line(g,x-3,sy-6,x+3,sy-6,C.ink,2);px.line(g,x+3,sy-6,x+3,sy-2,C.ink,2);}\n    else {px.line(g,x-5,sy,x+4,sy,C.ink);px.line(g,x,sy-5,x,sy+5,C.ink);}\n    for(let i=0;i<b.phases;i++){B.hex(g,x-12+i*12,y+40,4,i<phase?'\"'#67dbb3':C.ink);if(i>=phase)B.hex(g,x-12+i*12,y+40,2,tt.base);}\n    px.line(g,x+31,y+8,x+48,y-6+f*5,C.ink,3);px.line(g,x+48,y-6+f*5,x+59,y-23+f*5,C.gold,2);\n  };\n  B.pressureAnim=E.anim([\n    E.sprite(['...w...','..www..','.w.w.w.','w..w..w'],{w:'#c6f1db'}),\n    E.sprite(['.w...w.','..w.w..','...w...','..w.w..'],{w:'#f0ffe8'})\n  ],14,{pingpong:true});\n})(globalThis.BCP=globalThis.BCP||{});\nEOF\ncat > src/audio.js <<'EOF'\n(function(B){\n  'use strict';\n  B.synthTone=function(ctx,bus,t,freq,dur=.12,vol=.15,wave='triangle'){\n    const o=ctx.createOscillator(),g=ctx.createGain();o.type=wave;o.frequency.setValueAtTime(freq,t);o.frequency.exponentialRampToValueAtTime(Math.max(40,freq*.94),t+dur);\n    g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(vol,t+.008);g.gain.exponentialRampToValueAtTime(.00001,t+dur);o.connect(g);g.connect(bus);o.start(t);o.stop(t+dur+.01);return o;\n  };\n  B.Audio=function(game){\n    const A=game.audio;let mode='',paused=false,last=0;const nodes=new Set();\n    const melodies={\n      title:'D5 F5 E5 D#5 E5 A5 G5 F5 | E5 . D5 . A4 . C5 .',\n      live:'D5 Eb5 E5 F5 E5 Eb5 D5 C#5 | D5 A5 F5 E5 G5 F5 E5 C#5 | D5 F5 A5 C6 Bb5 A5 G5 E5 | F5 E5 Eb5 D5 C#5 E5 A4 .',\n      boss:'D5 Eb5 E5 F5 Ab5 G5 F#5 F5 | E5 G5 Bb5 A5 F5 E5 C#5 A4',\n      win:'D5 . F5 A5 . C6 . A5 | D6 . . . A5 . F5 .',\n      loss:'F5 . E5 . Eb5 . D5 . | C#5 . A4 . D4 - - .'\n    };\n    function song(name){return {bpm:name==='boss'?158:144,steps:4,tracks:[{wave:'pulse12',vol:.13,notes:melodies[name]||melodies.live},{wave:'triangle',vol:.19,notes:'D3 . A3 . D3 . F3 . | Bb2 . F3 . A2 . C#3 . | D3 . A3 . D3 . F3 . | G2 . D3 . A2 . C#3 .'},{wave:'noise',vol:.025,notes:'C5 . . . . . C6 . | C5 . . . . . C6 .'}]};}\n    function babble(pitch=500){if(game.headless||globalThis.AIHub?.server)return;const bus=A.bus('voice'),ctx=A.ctx;if(\"'!ctx||!bus||paused)return;for(let i=0;i<5;i++){const n=B.synthTone(ctx,bus,ctx.currentTime+i*.055,pitch*[1,1.37,.89,1.62,1.18][i],.05,.07,'\"'square');nodes.add(n);n.onended=()=>nodes.delete(n);}}\n    const defs={\n      spray:{wave:'noise',freq:1600,to:400,dur:.075,vol:.14},convert:{wave:'triangle',freq:270,to:730,dur:.12,vol:.25},shatter:{wave:'noise',freq:900,to:200,dur:.1,vol:.15},feed:{wave:'sine',freq:690,arp:[0,4,7,12],step:.045,dur:.24,vol:.26},call:{wave:'sine',freq:980,to:1400,dur:.13,vol:.21},hive:{wave:'pulse12',freq:180,arp:[0,3,7],step:.07,dur:.22,vol:.18},warning:{wave:'saw',freq:100,to:240,dur:.28,vol:.16},grow:{wave:'triangle',freq:130,to:440,dur:.14,vol:.15},swap:{wave:'triangle',freq:160,to:660,dur:.27,vol:.24},hop:{wave:'sine',freq:230,to:680,dur:.16,vol:.2},stock:{wave:'pulse12',freq:520,arp:[0,4,7,12],step:.08,dur:.36,vol:.23},shieldOpen:{wave:'triangle',freq:340,arp:[0,7,12],step:.08,dur:.3,vol:.23},shieldBreak:{wave:'saw',freq:250,arp:[0,4,7,12],step:.06,dur:.32,vol:.2},bossHit:{wave:'triangle',freq:180,to:370,dur:.1,vol:.22},birdHit:{wave:'sine',freq:700,to:160,dur:.2,vol:.18},retreat:{wave:'sine',freq:470,to:130,dur:.4,vol:.16},clear:{wave:'pulse12',freq:440,arp:[0,4,7,12],step:.1,dur:.5,vol:.19}\n    };\n    return {\n      set(name){if(mode===name)return;mode=name;if(\"'!paused&&!globalThis.AIHub?.server)A.music(song(name),{sync:true});if(name==='\"'win'||name==='loss')babble(name==='win'?620:330);},\n      update(w){if(\"'!w)return;for(const e of w.events){if(e.id<=last)continue;if(defs[e.kind]&&!paused&&!globalThis.AIHub?.server)A.sfx(defs[e.kind]);if(['\"'encounter','birdReturn','retreat'].includes(e.kind))babble(e.kind==='encounter'?360:850);}last=w.eventId;},\n      resetEvents(id=0){last=id;},\n      pause(on){if(paused===on)return;paused=on;if(on){A.music(null);for(const n of nodes){try{n.stop();}catch{}}nodes.clear();}else if(mode&&\"'!globalThis.AIHub?.server)A.music(song(mode),{sync:true});},\n      stop(){paused=true;A.music(null);for(const n of nodes){try{n.stop();}catch{}}nodes.clear();if(A.ctx&&A.ctx.state==='\"'running')A.ctx.suspend().catch(()=>{});},\n      get mode(){return mode;},get paused(){return paused;},get activeNodes(){return nodes.size;},song\n    };\n  };\n})(globalThis.BCP=globalThis.BCP||{});\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"agent_message","text":"The first deterministic playthrough finished all six encounters in **10 minutes 21 seconds** using ordinary movement, spray, ammo, and cooldowns. It exercised harvesting, comb clearing, hives, flower pressure, can swaps, and all four shield breaks. I’m now connecting that tested loop to the garden artwork, animation, controls, and menus.\n"}}
{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation.js <<'EOF'\n(function(B){\n  'use strict';\n  const E=My3D2dge,{px}=E,C=B.COLORS,A=B.ARENA;\n  const text=(g,str,x,y,c=C.cream,scale=1,align='left')=>E.font.text(g,str,x,y,c,{scale,align,outline:false,shadow:'#102029'});\n  B.Presentation=function(game){\n    const rigs=new Map(),bird=new B.BirdRig(),cans=new Map(),fx=[];let last=0,clock=0;\n    const bloom=(g,x,y,t,n=1)=>{for(let k=0;k<n;k++)B.flowerDraw(g,x+k*9,y,9+(k%3)*3,t,['#e8837f','#dcb95e','#d6a3c0'][k%3]);};\n    function backdrop(r,stage=0,title=false){\n      const pal=B.CONTENT[stage]?.palette||B.CONTENT[0].palette,[ox,oy]=r.w(0,0);\n      r.sky([pal[0],pal[1],'#728768']);\n      r.decal(g=>{\n        // Fine stippled dusk, broad greenhouse arches and distant foliage.\n        for(let i=0;i<80;i++){const x=(i*137+17)%640,y=(i*59+9)%290;px.dot(g,ox+x,oy+y,i%4?'#5e827e':'#9fa68b');}\n        for(let i=0;i<6;i++){\n          const x=ox+40+i*112;px.line(g,x,oy+64,x,oy+280,'#355e61',2);px.line(g,x,oy+64,x+54,oy+29,'#456e70',2);px.line(g,x+54,oy+29,x+109,oy+64,'#456e70',2);\n          px.line(g,x,oy+145,x+109,oy+145,'#355c60');px.line(g,x,oy+222,x+109,oy+222,'#355c60');\n        }\n        // A warm setting sun kept away from the combat silhouettes.\n        px.blend(g,.16,'add',()=>px.disc(g,ox+528,oy+120,52,'#ffd0a0'));px.disc(g,ox+528,oy+120,25,'#a2a384');px.disc(g,ox+523,oy+114,20,'#babc92');\n        for(let band=0;band<3;band++)for(let i=-2;i<26;i++){\n          const x=ox+i*31+(band%2)*15,y=oy+266+band*11,rad=19+(i*13%9);\n          px.disc(g,x,y,rad,['#244e4d','#305b51','#396a55'][band]);px.disc(g,x-5,y-6,rad*.5,['#315a53','#3d6a59','#47755f'][band]);\n        }\n        // Hanging bunting. Its triangles sit above the active tier paths.\n        px.line(g,ox+15,oy+55,ox+321,oy+66,'#d0bd8b');px.line(g,ox+321,oy+66,ox+625,oy+55,'#d0bd8b');\n        for(let i=0;i<18;i++){const x=ox+32+i*34,y=oy+56+Math.sin(i/17*Math.PI)*9;px.poly(g,[[x,y],[x+12,y],[x+6,y+9]],['#bd7b69','#d9bc78','#77a79a'][i%3]);}\n        // Soil, cut stone rail and a dotted legal-movement guide.\n        px.rect(g,ox-800,oy+310,2240,350,'#152c32');px.rect(g,ox-800,oy+310,2240,7,'#6d8270');px.rect(g,ox-800,oy+311,2240,2,'#b6b28a');px.rect(g,ox-800,oy+317,2240,5,'#294840');\n        for(let x=-50;x<700;x+=35){px.line(g,ox+x,oy+310,ox+x-2,oy+317,'#374d4b');px.line(g,ox+x+4,oy+318,ox+x+32,oy+318,'#496455');}\n        for(let i=0;i<100;i++)px.rect(g,ox+(i*71)%640,oy+323+(i*43)%220,2,1,['#223d37','#29453c','#33513e'][i%3]);\n        for(const side of [0,625]){px.rect(g,ox+side+4,oy+89,6,221,'#293e3c');px.rect(g,ox+side+5,oy+89,2,221,'#78816b');}\n        for(let i=0;i<14;i++){const y=92+i*15;px.ell(g,ox+5,oy+y,4,2,'#52745b');px.ell(g,ox+635,oy+y,4,2,'#52745b');}\n        // Frame decorations fill expanded viewports without changing the playfield.\n        for(let i=-5;i<=5;i++){const x=ox+320+i*103; if(i<-3||i>3)bloom(g,x,oy+315,clock,4);}\n        if(title){px.blend(g,.2,'normal',()=>px.rect(g,ox+14,oy+24,325,285,'#10282c'));}\n      });\n      // Generic engine props are distant garden set dressing, kept outside the action lane.\n      r.prop('bush',-16,290,0,{size:2,color:'#3c6c55'});r.prop('bush',657,291,0,{size:2,color:'#3c6c55'});\n      r.prop('pot',18,329,0,{size:1.2,color:'#bd7e5d'});r.prop('pot',623,329,0,{size:1.2,color:'#bd7e5d'});\n    }\n    function update(w,dt){\n      clock+=dt;\n      for(const f of fx){f.t-=dt;f.x+=f.vx*dt;f.y+=f.vy*dt;f.vy+=f.gravity*dt;}\n      for(let i=fx.length-1;i>=0;i--)if(fx[i].t<=0)fx.splice(i,1);\n      if(\"'!w)return;\n      const active=new Set();\n      for(const b of w.bees){active.add(b.id);let rig=rigs.get(b.id);if(!rig){rig=new B.BeeRig(b.kind);rigs.set(b.id,rig);}rig.update(dt,b);}\n      for(const id of rigs.keys())if(!active.has(id))rigs.delete(id);\n      for(const p of w.players){if(!cans.has(p.seat))cans.set(p.seat,new B.CanRig(p.seat));cans.get(p.seat).update(dt,p);}\n      bird.update(dt,w.bird);\n      for(const e of w.events){\n        if(e.id<=last)continue;\n        if(['\"'convert','feed','hive','shatter','shieldBreak','stock','win'].includes(e.kind)){\n          const colors=e.kind==='shatter'?['#f4bd69','#ac7655']:e.red?['#ff9e86','#ffe0ac']:['#ffe0a0','#7edbc0'];\n          const n=e.kind==='shieldBreak'||e.kind==='win'?28:9;\n          for(let i=0;i<n;i++){const angle=(i*2.39996+e.id),speed=15+(i%5)*11;fx.push({kind:'bit',x:e.x,y:e.y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed-20,gravity:60,t:.5+(i%4)*.13,color:colors[i%2],size:i%3===0?3:1});}\n        }\n        if(e.kind==='score')fx.push({kind:'text',text:'+'+e.points,x:e.x,y:e.y-12,vx:0,vy:-15,gravity:0,t:1.25,color:C.cream});\n        if(['birdHit','invalidCall','retreat','stock','hop','shieldOpen','retry'].includes(e.kind)){\n          const messages={birdHit:'Easy on Pip\"'!'\"',invalidCall:'No parcels yet',retreat:'Pip needs fresh air',stock:'+1 RESERVE CAN',hop:'SPRING-HOP\"'!'\"',shieldOpen:'RED HARVEST: SHIELD OPEN\"'!'\"',retry:'Fresh can. Same guest list.'};\n          fx.push({kind:'notice',text:messages[e.kind],x:320,y:259,vx:0,vy:0,gravity:0,t:2.4,color:e.kind==='birdHit'?C.rose:C.cream});\n        }\n      }\n      last=w.eventId;\n    }\n    function drawWorld(r,w,{attract=false}={}){\n      backdrop(r,w.stage);const [ox,oy]=r.w(0,0),e=w.content?w.content[w.stage]:B.CONTENT[w.stage];\n      // Local honey lights augment the native cool ambient/shadow pass.\n      for(const o of w.obstacles){r.shadow(o.x,o.y+7,10,.24);if(o.red||o.id===w.bird.target)game.lights.add(o.x,o.y,0,26,.4,{color:o.red?'#ff947c':'#f6c67c'});r.actor(o.x,o.y,0,(g,x,y)=>B.combDraw(g,x,y,o,clock),{key:'comb'+o.id});}\n      for(const b of w.bees){const rig=rigs.get(b.id);if(\"'!rig)continue;r.shadow(b.x,b.y+7,9,.18);r.actor(b.x,rig.visualY??b.y,0,(g,x,y)=>rig.draw(g,x,y,r.view),{key:b.id});}\n      if(w.boss&&!w.boss.done)r.actor(w.boss.x,w.boss.y,0,(g,x,y)=>B.bossDraw(g,x,y,w.boss,clock,r.view),{flash:w.boss.hit>0?'\"'#fff2cc':undefined,key:'queen'});\n      if(w.bird.state\"'!=='\"'retreat'||w.bird.x<640){r.shadow(w.bird.x,w.bird.y+11,9,.16);r.actor(w.bird.x,w.bird.y,0,(g,x,y)=>bird.draw(g,x,y,r.view),{key:'pip'});}\n      for(const p of w.players){const cr=cans.get(p.seat);r.shadow(p.x,p.y+1,13,.35);if(p.hop>0)r.decal(g=>{const q=r.w(p.x,306);px.ell(g,q[0],q[1],17,3,'#88dcc2');});r.actor(p.x,p.y,0,(g,x,y)=>cr?.draw(g,x,y,r.view),{key:'can'+p.seat});}\n      r.overlay(g=>{\n        // Pulses are a shaped puff with a tiny animated cap, not an opaque beam.\n        for(const p of w.pulses){const x=ox+p.x,y=oy+p.y;px.blend(g,.24,'add',()=>px.rect(g,x-3,y,7,12,'#b7f3d3'));px.rect(g,x-1,y,3,9,'#e9ffe2');px.rect(g,x,y-2,1,3,'#fffce0');px.sprite(g,B.pressureAnim.at?B.pressureAnim.at(clock):B.pressureAnim.frames?.[0]||B.pressureAnim,x-3,y-2);}\n        for(const [a,b] of B.groundIntervals(w)){px.line(g,ox+a,oy+307,ox+b,oy+307,'#6fc8a5');for(let x=a+2;x<b;x+=9)px.dot(g,ox+x,oy+305,'#90d1ac');}\n        for(const [a,b] of w.flowers){for(let x=a+4;x<b;x+=9)bloom(g,ox+x,oy+311,clock,1);px.rect(g,ox+a,oy+311,b-a,3,'#284b3c');}\n        for(const q of w.growth){const a=ox+q.x0,b=ox+q.x1,blink=Math.floor(clock*4)%2;px.blend(g,.18,'normal',()=>px.rect(g,a,oy+270,b-a,41,C.rose));for(let x=a;x<b;x+=8)px.line(g,x,oy+310,x+5,oy+305,blink?'#efad84':'#8e705f',2);text(g,'\"'!'\"',(a+b)/2,oy+282,C.cream,2,'center');}\n        const target=w.obstacles.find(o=>o.id===w.bird.target);\n        if(target){const x=ox+target.x,y=oy+target.y;for(const sd of [-1,1]){px.line(g,x+sd*16,y-10,x+sd*16,y+6,C.teal);px.line(g,x+sd*16,y-10,x+sd*12,y-10,C.teal);}if(w.bird.state==='feed'){E.ui.bar(g,x-12,y+15,24,3,1-w.bird.timer/w.tuning.birdFeed,C.teal);}}\n        for(const f of fx){const x=ox+f.x,y=oy+f.y;if(f.kind==='bit')px.rect(g,x,y,f.size,f.size,f.color);else if(f.kind==='text')text(g,f.text,x,y,f.color,1,'center');}\n        const notice=fx.filter(f=>f.kind==='notice').at(-1);if(notice){const ww=E.font.width(notice.text)+18;E.ui.box(g,ox+320-ww/2,oy+252,ww,19,{bg:'#132d32',border:'#68ad9a'});text(g,notice.text,ox+320,oy+258,notice.color,1,'center');}\n        if(w.dev.overlay)drawDebug(g,ox,oy,w);\n      });\n      hud(r,w,e,attract);\n    }\n    function drawDebug(g,ox,oy,w){\n      for(let i=0;i<A.tiers.length;i++){const y=oy+A.tiers[i];px.line(g,ox+28,y,ox+612,y,'#b887c5');text(g,'T'+i,ox+15,y-3,'#eac2ed');}\n      for(const b of w.bees){px.rect(g,ox+b.x-12,oy+b.y-9,24,1,C.rose);text(g,String(b.id),ox+b.x,oy+b.y+10,C.cream);if(b.trap>0)text(g,b.trapReason,ox+b.x+15,oy+b.y,C.gold);}\n      const lines=['tick '+w.tick+' seed '+w.seed,'pending '+w.pending.length+' next '+(w.pending[0]?.at.toFixed(1)||'none'),'stock '+w.reserves+' spent '+w.stats.spent+' earned '+w.stats.earned,'bird '+w.bird.state+' target '+w.bird.target,'reward claims '+Object.keys(w.claimed).length];\n      E.ui.box(g,ox+15,oy+88,225,66,{bg:'#14252f',border:'#b887c5'});lines.forEach((s,i)=>text(g,s,ox+21,oy+94+i*11,'#f3d8ee'));\n    }\n    function hud(r,w,e,attract){r.overlay(g=>{\n      const [ox,oy]=r.w(0,0);\n      E.ui.box(g,ox+14,oy+9,612,41,{bg:['#1c3a3b','#142a30'],border:'#6d8270'});\n      text(g,'GARDEN '+(w.stage+1)+' / '+B.CONTENT.length,ox+24,oy+16,'#91bba9');text(g,e.name,ox+24,oy+30,C.cream,1);\n      text(g,String(w.score).padStart(6,'0'),ox+397,oy+22,C.cream,2,'center');text(g,'TEAM SCORE',ox+397,oy+11,'#91bba9',1,'center');\n      text(g,'RESERVES',ox+508,oy+16,'#91bba9');for(let i=0;i<Math.min(w.reserves,7);i++){px.rect(g,ox+511+i*12,oy+31,7,11,C.gold);px.rect(g,ox+513+i*12,oy+28,3,3,'#c7d0b9');px.rect(g,ox+512+i*12,oy+34,5,3,C.cream);}if(w.reserves>7)text(g,'+'+(w.reserves-7),ox+595,oy+32,C.gold);\n      E.ui.box(g,ox+14,oy+327,612,24,{bg:'#132b31',border:'#536f60'});\n      for(let i=0;i<w.players.length;i++){const p=w.players[i],x=ox+24+i*170;const color=p.seat===1?C.teal:'#f09a79';text(g,'P'+p.seat,x,oy+336,color);E.ui.bar(g,x+21,oy+337,94,5,p.ammo/w.tuning.capacity,p.ammo<9?C.rose:color);text(g,p.swap>0?'SWAP':String(p.ammo),x+123,oy+335,p.ammo<9?C.rose:C.cream);}\n      const b=w.bird,ready=b.call<=0&&b.state\"'!=='\"'retreat',label=b.state==='retreat'?'PIP: FRESH AIR':ready?'CALL PIP':Math.ceil(b.call)+'s TO CALL';\n      text(g,(game.input.lastDevice==='touch'?'TAP COMB':game.input.label('call'))+'  '+label,ox+610,oy+335,ready?C.teal:'#b5b596',1,'right');\n      if(w.assisted)text(g,'ASSISTED',ox+610,oy+316,C.gold,1,'right');\n      if(w.status==='intro'||w.status==='intermission'){\n        const clear=w.status==='intermission';E.ui.box(g,ox+91,oy+128,458,102,{bg:['#254a46','#173139'],border:C.gold});\n        text(g,clear?'GARDEN CLEAR\"'!'\"':'GARDEN '+(w.stage+1),ox+320,oy+140,C.gold,2,'center');text(g,clear?e.gag:e.name,ox+320,oy+168,C.cream,1,'center');\n        const desc=clear?'Cans refilled. Reserves stay earned.':e.lesson;const lines=E.font.wrap(desc,420);lines.forEach((s,i)=>text(g,s,ox+320,oy+187+i*12,'#c2d6bb',1,'center'));\n        if(clear)text(g,'Next garden in '+Math.ceil(w.phaseTime),ox+320,oy+214,'#91baa8',1,'center');\n      }else if(w.status==='harvest'){text(g,'LAST ORDERS FOR PIP\"'!  '\"'+Math.ceil(w.phaseTime),ox+320,oy+59,C.gold,1,'center');}\n      if(w.stage===0&&w.status==='live'&&w.stageTime<22&&\"'!w.demo){\n        const next=!w.coverage.moveFire?game.input.label('\"'left')+' / '+game.input.label('right')+' move  +  '+game.input.label('fire')+' spray':\"'!w.coverage.call?'\"'Leave a comb. '+game.input.label('call')+' calls Pip to your column.':'Good work\"'! Combs steer workers. Flowers take your parking.'\"';\n        E.ui.box(g,ox+75,oy+244,490,22,{bg:'#163438',border:'#5a8b78'});text(g,next,ox+320,oy+252,C.cream,1,'center');\n      }\n      if(w.boss&&\"'!w.boss.done){const b=w.boss;const s=b.open>0?'\"'SHIELD OPEN '+Math.ceil(b.open)+'s   SPRAY\"'!'\"':'FEED A RED COMB TO OPEN THE BUD';text(g,s,ox+320,oy+115,b.open>0?C.gold:'#d9afbd',1,'center');E.ui.bar(g,ox+273,oy+125,94,3,b.hp/b.maxHp,b.open>0?C.gold:'#ad7e97');}\n      if(attract){E.ui.box(g,ox+125,oy+9,390,39,{bg:'#172e34',border:C.gold});text(g,'DEMONSTRATION',ox+320,oy+16,C.gold,2,'center');text(g,'Any input returns to the party',ox+320,oy+36,C.cream,1,'center');}\n    });}\n    function titleDraw(r,menu,best=0){\n      backdrop(r,0,true);const [ox,oy]=r.w(0,0),t=clock;\n      const mascot=new B.CanRig(1);mascot.update(t,{vx:Math.sin(t*.6)*80,ammo:56});const pip=new B.BirdRig();pip.update(t,{state:'idle'});\n      r.shadow(470,302,44,.38);r.actor(470,303,0,(g,x,y)=>mascot.draw(g,x,y,r.view,3.1));\n      r.actor(503+Math.sin(t*.7)*24,153,0,(g,x,y)=>pip.draw(g,x,y,r.view,1.65));\n      for(let i=0;i<3;i++){const o={kind:'comb',red:i===2};r.actor(391+i*71,223+Math.sin(t*2+i)*5,0,(g,x,y)=>B.combDraw(g,x,y,o,t,1.2));}\n      const bee=new B.BeeRig('worker');bee.update(t,{dir:-1,y:94,state:'sweep'});r.actor(570,93,0,(g,x,y)=>bee.draw(g,x,y,r.view,1.8));\n      r.overlay(g=>{\n        text(g,'A GARDEN ARCADE IN SIX ACTS',ox+40,oy+37,'#9fceba');\n        E.font.title(g,'BUZZ',ox+38,oy+59,{scale:6,colors:['#fff1bd','#f5c16f','#d9904e'],depth:3,depthColor:'#31433d'});\n        E.font.title(g,'COMB PARTY',ox+38,oy+112,{scale:3,colors:['#fff1bd','#e9be7e'],depth:2,depthColor:'#31433d'});\n        text(g,'Spritz responsibly. Feed extravagantly.',ox+40,oy+149,'#a8cbb4');\n        text(g,'BEST '+String(best).padStart(6,'0'),ox+585,oy+278,C.gold,1,'right');\n        text(g,'PIP, CHIEF NIBBLING OFFICER',ox+478,oy+187,'#8fbdac',1,'center');\n        text(g,game.input.label('left')+' / '+game.input.label('right')+' MOVE     '+game.input.label('fire')+' SPRAY     '+game.input.label('call')+' CALL PIP',ox+320,oy+336,C.cream,1,'center');\n      });\n      menu.draw(r);\n    }\n    return {update,draw:drawWorld,title: titleDraw,backdrop,reset(){last=0;rigs.clear();fx.length=0;},get clock(){return clock;}};\n  };\n})(globalThis.BCP=globalThis.BCP||{});\nEOF\nnode --check src/presentation.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > src/presentation.js <<'EOF'\n(function(B){\n  'use strict';\n  const E=My3D2dge,{px}=E,C=B.COLORS,A=B.ARENA;\n  const text=(g,str,x,y,c=C.cream,scale=1,align='left')=>E.font.text(g,str,x,y,c,{scale,align,outline:false,shadow:'#102029'});\n  B.Presentation=function(game){\n    const rigs=new Map(),bird=new B.BirdRig(),cans=new Map(),fx=[];let last=0,clock=0;\n    const bloom=(g,x,y,t,n=1)=>{for(let k=0;k<n;k++)B.flowerDraw(g,x+k*9,y,9+(k%3)*3,t,['#e8837f','#dcb95e','#d6a3c0'][k%3]);};\n    function backdrop(r,stage=0,title=false){\n      const pal=B.CONTENT[stage]?.palette||B.CONTENT[0].palette,[ox,oy]=r.w(0,0);\n      r.sky([pal[0],pal[1],'#728768']);\n      r.decal(g=>{\n        // Fine stippled dusk, broad greenhouse arches and distant foliage.\n        for(let i=0;i<80;i++){const x=(i*137+17)%640,y=(i*59+9)%290;px.dot(g,ox+x,oy+y,i%4?'#5e827e':'#9fa68b');}\n        for(let i=0;i<6;i++){\n          const x=ox+40+i*112;px.line(g,x,oy+64,x,oy+280,'#355e61',2);px.line(g,x,oy+64,x+54,oy+29,'#456e70',2);px.line(g,x+54,oy+29,x+109,oy+64,'#456e70',2);\n          px.line(g,x,oy+145,x+109,oy+145,'#355c60');px.line(g,x,oy+222,x+109,oy+222,'#355c60');\n        }\n        // A warm setting sun kept away from the combat silhouettes.\n        px.blend(g,.16,'add',()=>px.disc(g,ox+528,oy+120,52,'#ffd0a0'));px.disc(g,ox+528,oy+120,25,'#a2a384');px.disc(g,ox+523,oy+114,20,'#babc92');\n        for(let band=0;band<3;band++)for(let i=-2;i<26;i++){\n          const x=ox+i*31+(band%2)*15,y=oy+266+band*11,rad=19+(i*13%9);\n          px.disc(g,x,y,rad,['#244e4d','#305b51','#396a55'][band]);px.disc(g,x-5,y-6,rad*.5,['#315a53','#3d6a59','#47755f'][band]);\n        }\n        // Hanging bunting. Its triangles sit above the active tier paths.\n        px.line(g,ox+15,oy+55,ox+321,oy+66,'#d0bd8b');px.line(g,ox+321,oy+66,ox+625,oy+55,'#d0bd8b');\n        for(let i=0;i<18;i++){const x=ox+32+i*34,y=oy+56+Math.sin(i/17*Math.PI)*9;px.poly(g,[[x,y],[x+12,y],[x+6,y+9]],['#bd7b69','#d9bc78','#77a79a'][i%3]);}\n        // Soil, cut stone rail and a dotted legal-movement guide.\n        px.rect(g,ox-800,oy+310,2240,350,'#152c32');px.rect(g,ox-800,oy+310,2240,7,'#6d8270');px.rect(g,ox-800,oy+311,2240,2,'#b6b28a');px.rect(g,ox-800,oy+317,2240,5,'#294840');\n        for(let x=-50;x<700;x+=35){px.line(g,ox+x,oy+310,ox+x-2,oy+317,'#374d4b');px.line(g,ox+x+4,oy+318,ox+x+32,oy+318,'#496455');}\n        for(let i=0;i<100;i++)px.rect(g,ox+(i*71)%640,oy+323+(i*43)%220,2,1,['#223d37','#29453c','#33513e'][i%3]);\n        for(const side of [0,625]){px.rect(g,ox+side+4,oy+89,6,221,'#293e3c');px.rect(g,ox+side+5,oy+89,2,221,'#78816b');}\n        for(let i=0;i<14;i++){const y=92+i*15;px.ell(g,ox+5,oy+y,4,2,'#52745b');px.ell(g,ox+635,oy+y,4,2,'#52745b');}\n        // Frame decorations fill expanded viewports without changing the playfield.\n        for(let i=-5;i<=5;i++){const x=ox+320+i*103; if(i<-3||i>3)bloom(g,x,oy+315,clock,4);}\n        if(title){px.blend(g,.2,'normal',()=>px.rect(g,ox+14,oy+24,325,285,'#10282c'));}\n      });\n      // Generic engine props are distant garden set dressing, kept outside the action lane.\n      r.prop('bush',-16,290,0,{size:2,color:'#3c6c55'});r.prop('bush',657,291,0,{size:2,color:'#3c6c55'});\n      r.prop('pot',18,329,0,{size:1.2,color:'#bd7e5d'});r.prop('pot',623,329,0,{size:1.2,color:'#bd7e5d'});\n    }\n    function update(w,dt){\n      clock+=dt;\n      for(const f of fx){f.t-=dt;f.x+=f.vx*dt;f.y+=f.vy*dt;f.vy+=f.gravity*dt;}\n      for(let i=fx.length-1;i>=0;i--)if(fx[i].t<=0)fx.splice(i,1);\n      if(\"'!w)return;\n      const active=new Set();\n      for(const b of w.bees){active.add(b.id);let rig=rigs.get(b.id);if(!rig){rig=new B.BeeRig(b.kind);rigs.set(b.id,rig);}rig.update(dt,b);}\n      for(const id of rigs.keys())if(!active.has(id))rigs.delete(id);\n      for(const p of w.players){if(!cans.has(p.seat))cans.set(p.seat,new B.CanRig(p.seat));cans.get(p.seat).update(dt,p);}\n      bird.update(dt,w.bird);\n      for(const e of w.events){\n        if(e.id<=last)continue;\n        if(['\"'convert','feed','hive','shatter','shieldBreak','stock','win'].includes(e.kind)){\n          const colors=e.kind==='shatter'?['#f4bd69','#ac7655']:e.red?['#ff9e86','#ffe0ac']:['#ffe0a0','#7edbc0'];\n          const n=e.kind==='shieldBreak'||e.kind==='win'?28:9;\n          for(let i=0;i<n;i++){const angle=(i*2.39996+e.id),speed=15+(i%5)*11;fx.push({kind:'bit',x:e.x,y:e.y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed-20,gravity:60,t:.5+(i%4)*.13,color:colors[i%2],size:i%3===0?3:1});}\n        }\n        if(e.kind==='score')fx.push({kind:'text',text:'+'+e.points,x:e.x,y:e.y-12,vx:0,vy:-15,gravity:0,t:1.25,color:C.cream});\n        if(['birdHit','invalidCall','retreat','stock','hop','shieldOpen','retry'].includes(e.kind)){\n          const messages={birdHit:'Easy on Pip\"'!'\"',invalidCall:'No parcels yet',retreat:'Pip needs fresh air',stock:'+1 RESERVE CAN',hop:'SPRING-HOP\"'!'\"',shieldOpen:'RED HARVEST: SHIELD OPEN\"'!'\"',retry:'Fresh can. Same guest list.'};\n          fx.push({kind:'notice',text:messages[e.kind],x:320,y:259,vx:0,vy:0,gravity:0,t:2.4,color:e.kind==='birdHit'?C.rose:C.cream});\n        }\n      }\n      last=w.eventId;\n    }\n    function drawWorld(r,w,{attract=false}={}){\n      backdrop(r,w.stage);const [ox,oy]=r.w(0,0),e=w.content?w.content[w.stage]:B.CONTENT[w.stage];\n      // Local honey lights augment the native cool ambient/shadow pass.\n      for(const o of w.obstacles){r.shadow(o.x,o.y+7,10,.24);if(o.red||o.id===w.bird.target)game.lights.add(o.x,o.y,0,26,.4,{color:o.red?'#ff947c':'#f6c67c'});r.actor(o.x,o.y,0,(g,x,y)=>B.combDraw(g,x,y,o,clock),{key:'comb'+o.id});}\n      for(const b of w.bees){const rig=rigs.get(b.id);if(\"'!rig)continue;r.shadow(b.x,b.y+7,9,.18);r.actor(b.x,rig.visualY??b.y,0,(g,x,y)=>rig.draw(g,x,y,r.view),{key:b.id});}\n      if(w.boss&&!w.boss.done)r.actor(w.boss.x,w.boss.y,0,(g,x,y)=>B.bossDraw(g,x,y,w.boss,clock,r.view),{flash:w.boss.hit>0?'\"'#fff2cc':undefined,key:'queen'});\n      if(w.bird.state\"'!=='\"'retreat'||w.bird.x<640){r.shadow(w.bird.x,w.bird.y+11,9,.16);r.actor(w.bird.x,w.bird.y,0,(g,x,y)=>bird.draw(g,x,y,r.view),{key:'pip'});}\n      for(const p of w.players){const cr=cans.get(p.seat);r.shadow(p.x,p.y+1,13,.35);if(p.hop>0)r.decal(g=>{const q=r.w(p.x,306);px.ell(g,q[0],q[1],17,3,'#88dcc2');});r.actor(p.x,p.y,0,(g,x,y)=>cr?.draw(g,x,y,r.view),{key:'can'+p.seat});}\n      r.overlay(g=>{\n        // Pulses are a shaped puff with a tiny animated cap, not an opaque beam.\n        for(const p of w.pulses){const x=ox+p.x,y=oy+p.y;px.blend(g,.24,'add',()=>px.rect(g,x-3,y,7,12,'#b7f3d3'));px.rect(g,x-1,y,3,9,'#e9ffe2');px.rect(g,x,y-2,1,3,'#fffce0');px.sprite(g,B.pressureAnim.at?B.pressureAnim.at(clock):B.pressureAnim.frames?.[0]||B.pressureAnim,x-3,y-2);}\n        for(const [a,b] of B.groundIntervals(w)){px.line(g,ox+a,oy+307,ox+b,oy+307,'#6fc8a5');for(let x=a+2;x<b;x+=9)px.dot(g,ox+x,oy+305,'#90d1ac');}\n        for(const [a,b] of w.flowers){for(let x=a+4;x<b;x+=9)bloom(g,ox+x,oy+311,clock,1);px.rect(g,ox+a,oy+311,b-a,3,'#284b3c');}\n        for(const q of w.growth){const a=ox+q.x0,b=ox+q.x1,blink=Math.floor(clock*4)%2;px.blend(g,.18,'normal',()=>px.rect(g,a,oy+270,b-a,41,C.rose));for(let x=a;x<b;x+=8)px.line(g,x,oy+310,x+5,oy+305,blink?'#efad84':'#8e705f',2);text(g,'\"'!'\"',(a+b)/2,oy+282,C.cream,2,'center');}\n        const target=w.obstacles.find(o=>o.id===w.bird.target);\n        if(target){const x=ox+target.x,y=oy+target.y;for(const sd of [-1,1]){px.line(g,x+sd*16,y-10,x+sd*16,y+6,C.teal);px.line(g,x+sd*16,y-10,x+sd*12,y-10,C.teal);}if(w.bird.state==='feed'){E.ui.bar(g,x-12,y+15,24,3,1-w.bird.timer/w.tuning.birdFeed,C.teal);}}\n        for(const f of fx){const x=ox+f.x,y=oy+f.y;if(f.kind==='bit')px.rect(g,x,y,f.size,f.size,f.color);else if(f.kind==='text')text(g,f.text,x,y,f.color,1,'center');}\n        const notice=fx.filter(f=>f.kind==='notice').at(-1);if(notice){const ww=E.font.width(notice.text)+18;E.ui.box(g,ox+320-ww/2,oy+252,ww,19,{bg:'#132d32',border:'#68ad9a'});text(g,notice.text,ox+320,oy+258,notice.color,1,'center');}\n        if(w.dev.overlay)drawDebug(g,ox,oy,w);\n      });\n      hud(r,w,e,attract);\n    }\n    function drawDebug(g,ox,oy,w){\n      for(let i=0;i<A.tiers.length;i++){const y=oy+A.tiers[i];px.line(g,ox+28,y,ox+612,y,'#b887c5');text(g,'T'+i,ox+15,y-3,'#eac2ed');}\n      for(const b of w.bees){px.rect(g,ox+b.x-12,oy+b.y-9,24,1,C.rose);text(g,String(b.id),ox+b.x,oy+b.y+10,C.cream);if(b.trap>0)text(g,b.trapReason,ox+b.x+15,oy+b.y,C.gold);}\n      const lines=['tick '+w.tick+' seed '+w.seed,'pending '+w.pending.length+' next '+(w.pending[0]?.at.toFixed(1)||'none'),'stock '+w.reserves+' spent '+w.stats.spent+' earned '+w.stats.earned,'bird '+w.bird.state+' target '+w.bird.target,'reward claims '+Object.keys(w.claimed).length];\n      E.ui.box(g,ox+15,oy+88,225,66,{bg:'#14252f',border:'#b887c5'});lines.forEach((s,i)=>text(g,s,ox+21,oy+94+i*11,'#f3d8ee'));\n    }\n    function hud(r,w,e,attract){r.overlay(g=>{\n      const [ox,oy]=r.w(0,0);\n      E.ui.box(g,ox+14,oy+9,612,41,{bg:['#1c3a3b','#142a30'],border:'#6d8270'});\n      text(g,'GARDEN '+(w.stage+1)+' / '+B.CONTENT.length,ox+24,oy+16,'#91bba9');text(g,e.name,ox+24,oy+30,C.cream,1);\n      text(g,String(w.score).padStart(6,'0'),ox+397,oy+22,C.cream,2,'center');text(g,'TEAM SCORE',ox+397,oy+11,'#91bba9',1,'center');\n      text(g,'RESERVES',ox+508,oy+16,'#91bba9');for(let i=0;i<Math.min(w.reserves,7);i++){px.rect(g,ox+511+i*12,oy+31,7,11,C.gold);px.rect(g,ox+513+i*12,oy+28,3,3,'#c7d0b9');px.rect(g,ox+512+i*12,oy+34,5,3,C.cream);}if(w.reserves>7)text(g,'+'+(w.reserves-7),ox+595,oy+32,C.gold);\n      E.ui.box(g,ox+14,oy+327,612,24,{bg:'#132b31',border:'#536f60'});\n      for(let i=0;i<w.players.length;i++){const p=w.players[i],x=ox+24+i*170;const color=p.seat===1?C.teal:'#f09a79';text(g,'P'+p.seat,x,oy+336,color);E.ui.bar(g,x+21,oy+337,94,5,p.ammo/w.tuning.capacity,p.ammo<9?C.rose:color);text(g,p.swap>0?'SWAP':String(p.ammo),x+123,oy+335,p.ammo<9?C.rose:C.cream);}\n      const b=w.bird,ready=b.call<=0&&b.state\"'!=='\"'retreat',label=b.state==='retreat'?'PIP: FRESH AIR':ready?'CALL PIP':Math.ceil(b.call)+'s TO CALL';\n      text(g,(game.input.lastDevice==='touch'?'TAP COMB':game.input.label('call'))+'  '+label,ox+610,oy+335,ready?C.teal:'#b5b596',1,'right');\n      if(w.assisted)text(g,'ASSISTED',ox+610,oy+316,C.gold,1,'right');\n      if(w.status==='intro'||w.status==='intermission'){\n        const clear=w.status==='intermission';E.ui.box(g,ox+91,oy+128,458,102,{bg:['#254a46','#173139'],border:C.gold});\n        text(g,clear?'GARDEN CLEAR\"'!'\"':'GARDEN '+(w.stage+1),ox+320,oy+140,C.gold,2,'center');text(g,clear?e.gag:e.name,ox+320,oy+168,C.cream,1,'center');\n        const desc=clear?'Cans refilled. Reserves stay earned.':e.lesson;const lines=E.font.wrap(desc,420);lines.forEach((s,i)=>text(g,s,ox+320,oy+187+i*12,'#c2d6bb',1,'center'));\n        if(clear)text(g,'Next garden in '+Math.ceil(w.phaseTime),ox+320,oy+214,'#91baa8',1,'center');\n      }else if(w.status==='harvest'){text(g,'LAST ORDERS FOR PIP\"'!  '\"'+Math.ceil(w.phaseTime),ox+320,oy+59,C.gold,1,'center');}\n      if(w.stage===0&&w.status==='live'&&w.stageTime<22&&\"'!w.demo){\n        const next=!w.coverage.moveFire?game.input.label('\"'left')+' / '+game.input.label('right')+' move  +  '+game.input.label('fire')+' spray':\"'!w.coverage.call?'\"'Leave a comb. '+game.input.label('call')+' calls Pip to your column.':'Good work\"'! Combs steer workers. Flowers take your parking.'\"';\n        E.ui.box(g,ox+75,oy+244,490,22,{bg:'#163438',border:'#5a8b78'});text(g,next,ox+320,oy+252,C.cream,1,'center');\n      }\n      if(w.boss&&\"'!w.boss.done){const b=w.boss;const s=b.open>0?'\"'SHIELD OPEN '+Math.ceil(b.open)+'s   SPRAY\"'!'\"':'FEED A RED COMB TO OPEN THE BUD';text(g,s,ox+320,oy+115,b.open>0?C.gold:'#d9afbd',1,'center');E.ui.bar(g,ox+273,oy+125,94,3,b.hp/b.maxHp,b.open>0?C.gold:'#ad7e97');}\n      if(attract){E.ui.box(g,ox+125,oy+9,390,39,{bg:'#172e34',border:C.gold});text(g,'DEMONSTRATION',ox+320,oy+16,C.gold,2,'center');text(g,'Any input returns to the party',ox+320,oy+36,C.cream,1,'center');}\n    });}\n    function titleDraw(r,menu,best=0){\n      backdrop(r,0,true);const [ox,oy]=r.w(0,0),t=clock;\n      const mascot=new B.CanRig(1);mascot.update(t,{vx:Math.sin(t*.6)*80,ammo:56});const pip=new B.BirdRig();pip.update(t,{state:'idle'});\n      r.shadow(470,302,44,.38);r.actor(470,303,0,(g,x,y)=>mascot.draw(g,x,y,r.view,3.1));\n      r.actor(503+Math.sin(t*.7)*24,153,0,(g,x,y)=>pip.draw(g,x,y,r.view,1.65));\n      for(let i=0;i<3;i++){const o={kind:'comb',red:i===2};r.actor(391+i*71,223+Math.sin(t*2+i)*5,0,(g,x,y)=>B.combDraw(g,x,y,o,t,1.2));}\n      const bee=new B.BeeRig('worker');bee.update(t,{dir:-1,y:94,state:'sweep'});r.actor(570,93,0,(g,x,y)=>bee.draw(g,x,y,r.view,1.8));\n      r.overlay(g=>{\n        text(g,'A GARDEN ARCADE IN SIX ACTS',ox+40,oy+37,'#9fceba');\n        E.font.title(g,'BUZZ',ox+38,oy+59,{scale:6,colors:['#fff1bd','#f5c16f','#d9904e'],depth:3,depthColor:'#31433d'});\n        E.font.title(g,'COMB PARTY',ox+38,oy+112,{scale:3,colors:['#fff1bd','#e9be7e'],depth:2,depthColor:'#31433d'});\n        text(g,'Spritz responsibly. Feed extravagantly.',ox+40,oy+149,'#a8cbb4');\n        text(g,'BEST '+String(best).padStart(6,'0'),ox+585,oy+278,C.gold,1,'right');\n        text(g,'PIP, CHIEF NIBBLING OFFICER',ox+478,oy+187,'#8fbdac',1,'center');\n        text(g,game.input.label('left')+' / '+game.input.label('right')+' MOVE     '+game.input.label('fire')+' SPRAY     '+game.input.label('call')+' CALL PIP',ox+320,oy+336,C.cream,1,'center');\n      });\n      menu.draw(r);\n    }\n    return {update,draw:drawWorld,title: titleDraw,backdrop,reset(){last=0;rigs.clear();fx.length=0;},get clock(){return clock;}};\n  };\n})(globalThis.BCP=globalThis.BCP||{});\nEOF\nnode --check src/presentation.js\"","aggregated_output":"","exit_code":0,"status":"completed"}}
