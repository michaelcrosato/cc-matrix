{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'curl -fLsS https://raw.githubusercontent.com/michaelcrosato/my-3d2dge/8ecc2f62353761187bdfe226f327b7ea5d2eb691/dist/handoff/README.md -o vendor/engine/README.md && curl -fLsS https://raw.githubusercontent.com/michaelcrosato/ai-hub/35a1047f2067b2af3de3943f0fe452f39105d869/lib/hub/README.md -o vendor/hub/README.md && cat vendor/engine/README.md'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
