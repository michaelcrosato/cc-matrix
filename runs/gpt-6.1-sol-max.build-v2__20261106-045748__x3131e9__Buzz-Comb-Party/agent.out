{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom urllib.request import urlopen\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nengine='https://raw.githubusercontent.com/michaelcrosato/my-3d2dge/8ecc2f62353761187bdfe226f327b7ea5d2eb691/'\nhub='https://raw.githubusercontent.com/michaelcrosato/ai-hub/35a1047f2067b2af3de3943f0fe452f39105d869/'\nfiles=[(engine+'dist/handoff/'+f,'vendor/engine/'+f) for f in ['my-3d2dge.js','API.md','API-INDEX.md','AI_GUIDE.md','kits/arcade.js','game/test.mjs','docs/ASSETS.md']]\nfiles += [(hub+'lib/hub/'+f,'vendor/hub/'+f) for f in ['session.js','examples/arena.html']]\nfiles += [(hub+'lib/hub/'+f,'tests/hub/'+f) for f in ['harness.html','bridge.js','round.js']]\nfiles += [(engine+'LICENSE','vendor/engine/LICENSE'),(hub+'LICENSE','vendor/hub/LICENSE')]\nfiles += [('https://history.blueskyrangers.com/mattelelectronics/games/images/buzzbombers/BuzzBomberScreen.gif','docs/source-screen.gif')]\ndef get(pair):\n u,p=pair\n try:\n  d=urlopen(u).read(); Path(p).parent.mkdir(parents=True,exist_ok=True);Path(p).write_bytes(d);return p,len(d)\n except Exception as e:return p,str(e)\nfor r in ThreadPoolExecutor(max_workers=6).map(get,files):print(*r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom urllib.request import urlopen\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nengine='https://raw.githubusercontent.com/michaelcrosato/my-3d2dge/8ecc2f62353761187bdfe226f327b7ea5d2eb691/'\nhub='https://raw.githubusercontent.com/michaelcrosato/ai-hub/35a1047f2067b2af3de3943f0fe452f39105d869/'\nfiles=[(engine+'dist/handoff/'+f,'vendor/engine/'+f) for f in ['my-3d2dge.js','API.md','API-INDEX.md','AI_GUIDE.md','kits/arcade.js','game/test.mjs','docs/ASSETS.md']]\nfiles += [(hub+'lib/hub/'+f,'vendor/hub/'+f) for f in ['session.js','examples/arena.html']]\nfiles += [(hub+'lib/hub/'+f,'tests/hub/'+f) for f in ['harness.html','bridge.js','round.js']]\nfiles += [(engine+'LICENSE','vendor/engine/LICENSE'),(hub+'LICENSE','vendor/hub/LICENSE')]\nfiles += [('https://history.blueskyrangers.com/mattelelectronics/games/images/buzzbombers/BuzzBomberScreen.gif','docs/source-screen.gif')]\ndef get(pair):\n u,p=pair\n try:\n  d=urlopen(u).read(); Path(p).parent.mkdir(parents=True,exist_ok=True);Path(p).write_bytes(d);return p,len(d)\n except Exception as e:return p,str(e)\nfor r in ThreadPoolExecutor(max_workers=6).map(get,files):print(*r)\nPY\"","aggregated_output":"vendor/engine/my-3d2dge.js 1266871\nvendor/engine/API.md 68162\nvendor/engine/API-INDEX.md 200618\nvendor/engine/AI_GUIDE.md 114712\nvendor/engine/kits/arcade.js 74410\nvendor/engine/game/test.mjs 2609\nvendor/engine/docs/ASSETS.md 11643\nvendor/hub/session.js 16707\nvendor/hub/examples/arena.html 33330\ntests/hub/harness.html 27469\ntests/hub/bridge.js 13624\ntests/hub/round.js 20268\nvendor/engine/LICENSE 1072\nvendor/hub/LICENSE HTTP Error 404: Not Found\ndocs/source-screen.gif 45596\n","exit_code":0,"status":"completed"}}
