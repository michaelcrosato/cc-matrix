ate:titleUpdate,draw(r){app.visual.title(r,titleMenu,recordData().best);}},\n    play:{pausable:true,view:'overhead',camera:{zoom:false},touch:[],enter(){game.lights.enabled=true;game.lights.ambient=.87;game.lights.dark=[8,27,35];game.lights.refresh();game.input.steer='drag';game.input.touchButtons([]);},update:playUpdate,draw(r){if(app.world)app.visual.draw(r,app.world,{attract:app.attract});}},\n    results:{pausable:false,camera:{zoom:false},enter(){resultMenu=new E.Menu(game,['Play again','Title','About / Credits'],{scale:2,box:false,bg:'#203d3b',x:(game.W-640)/2+192,y:(game.H-360)/2+232,onPick:i=>{if(i===0)app.start(app.world.players.length,game.players.length>1?'mixed':'solo');else if(i===1)app.title();else app.screens.about();}});},update(dt){app.visual.update(null,dt);game.focus(320,180,0);resultMenu.x=(game.W-640)/2+192;resultMenu.y=(game.H-360)/2+232;if(\"'!shell.screen)resultMenu.update(dt);},draw:resultDraw}\n  };\n  game.cam.smooth=0;game.fadeTime=0;\n  game.hook('\"'input',()=>{\n    if(app.online&&globalThis.AIHub?.server)return;\n    app.adapter.padActivity();\n    if(app.attract&&game.input.anyPressed()){app.wake();game.input.clear();return;}\n    if(\"'!app.online&&game.paused!==wasPaused){wasPaused=game.paused;app.sound.pause(game.paused);if(app.world)B.clearActions(app.world);for(const q of game.players)q.clear();}\n    if(app.online&&game.paused&&game.pauseReason!=='\"'menu'&&game.pauseReason\"'!=='\"'player')game.resume();\n    if(app.adapter.woke&&game.real-app.adapter.activityAt<.25)for(const q of game.players)q.consumeAll();\n  });\n  game.debug={snapshot:()=>({fingerprint:'buzz-comb-party-20261106',scene:game.sceneName,paused:game.paused,screen:shell.screen,attract:app.attract,online:app.online,ended:app.ended,device:game.input.lastDevice,glyphs:game.settings.glyphs,music:game.settings.music,world:app.world?B.snapshot(app.world):null,network:app.network.metrics}),start:app.start,title:app.title,dev:app.screens.dev,about:app.screens.about,st