te(\\\"BCP.enterEncounter(__BUZZ.world,5);__BUZZ.world.status='live';BCP.placeComb(__BUZZ.world,288,2,true,'visual-red');__BUZZ.visual.update(__BUZZ.world,.02);__game.advance(.02)\\\")\n  shot(page,'finale.png')\n  # Complete ordinary-input run inside the final assembled artifact, then real result/restart flow.\n  report=page.evaluate(\\\"\\\"\\\"(()=>{__BUZZ.start();const w=__BUZZ.world;for(let i=0;i<120*1000&&\"'!w.result;i++){if(i%12===0)BCP.applyAction(w,1,BCP.pilot(w));BCP.step(w);}__game.advance(.02);return {won:w.result?.won,time:w.time,scene:__game.sceneName,score:w.score,records:__BUZZ.records()};})()\"\"\")\n  check('\"'assembled game ordinary-input whole campaign reaches real win card',report.get('won') and report.get('scene')=='results' and 500<report.get('time',0)<900,report)\n  check('unassisted full campaign updates local records once',report['records']['runs']==1 and report['records']['wins']==1)\n  shot(page,'results.png')\n  page.keyboard.press('Enter');page.evaluate('__game.advance(.2)')\n  check('win card can start a clean fresh run',page.evaluate(\\\"__game.sceneName==='play' && __BUZZ.world.score===0 && \"'!__BUZZ.world.result\"))\n  # Explicit local device ownership, including independent two-keyboard halves.\n  page.evaluate(\"__BUZZ.start(2,'\"'mixed');__game.advance(3)\\\")\n  check('keyboard plus pad assigns exclusive devices',page.evaluate('__game.players.length===2 && __game.players[0].pad===null && __game.players[1].pad===0'))\n  page.evaluate('__setPad(0,[0],.7);__game.advance(.4);__setPad(0,[])')\n  check('one pad cannot control both co-op cans',page.evaluate('__BUZZ.world.stats.seats[1].hits===0 && __BUZZ.world.players[0].ammo===56 && __BUZZ.world.players[1].ammo<56'))\n  page.evaluate(\\\"__BUZZ.start(2,'keys');__game.advance(3)\\\")\n  x1=page.evaluate('__BUZZ.world.players[0].x');x2=page.evaluate('__BUZZ.world.players[1].x')\n  page.keyboard.down('d');page.keyboard.down('ArrowLeft');page.evaluate('__game.advance(.3)');page.keyboard.up('d');page.keyboard.up('ArrowLeft')\n  check('shared keyboard controls simultaneous independent cans',page.evaluate('__BUZZ.world.players[0].x')>x1 and page.evaluate('__BUZZ.world.players[1].x')<x2)\n  # Objective code-audio evidence using the same oscillator envelope implementation.\n  audio=page.evaluate(\\\"\\\"\\\"async()=>{async function render(gain){const c=new OfflineAudioContext(1,22050,22050),bus=c.createGain();bus.gain.value=gain;bus.connect(c.destination);BCP.synthTone(c,bus,.01,440,.2,.2);BCP.synthTone(c,bus,.12,660,.3,.15,'square');const b=await c.startRendering(),d=b.getChannelData(0);return {peak:Math.max(...d.map(Math.abs)),rms:Math.sqrt(d.reduce((a,x)=>a+x*x,0)/d.length),finite:d.every(Number.isFinite)};}const loud=await render(1),music=await render(.1),mute=await render(0);return {loud,music,mute};}\\\"\\\"\\\")\n  check('code audio produces finite non-silent non-clipped output',audio['loud']['finite'] and .001<audio['loud']['peak']<1)\n  check('music bus ten-percent gain and mute are correct',abs(audio['music']['rms']/audio['loud']['rms']-.1)<.001 and audio['mute']['peak']==0)\n  page.evaluate('__BUZZ.sound.stop()');check('audio teardown stops generated voice nodes',page.evaluate('__BUZZ.sound.activeNodes===0 && __BUZZ.sound.paused'))\n  (base/'evidence/audio-report.json').write_text(json.dumps(audio,indent=2))\n  check('Chromium session has no page or native game errors',not errors and page.evaluate('__game.errors.length')==0,errors)\n  context.close()\n  # Touch landscape and portrait. Native invisible steering, assist and contextual actions.\n  touch=browser.new_context(**p.devices['iPhone 13'])\n  phone=touch.new_page();phone.goto(url);phone.wait_for_function('window.__BUZZ?.ready')\n  phone.evaluate('__BUZZ.start();__game.advance(3);__game.stop()')\n  can=phone.locator('canvas#screen').bounding_box();sx=can['width']/2;sy=can['height']/2+72\n  before=phone.evaluate('__BUZZ.world.players[0].x')\n  phone.evaluate(\\\"\\\"\\\"({x,y})=>{const el=document.querySelector('canvas');el.dispatchEvent(new PointerEvent('pointerdown',{pointerId:1,pointerType:'touch',clientX:x,clientY:y,bubbles:true}));el.dispatchEvent(new PointerEvent('pointermove',{pointerId:1,pointerType:'touch',clientX:x+55,clientY:y,bubbles:true}));__game.advance(.1);window.dispatchEvent(new PointerEvent('pointerup',{pointerId:1,pointerType:'touch',clientX:x+55,clientY:y,bubbles:true}));}\\\"\\\"\\\",{'x':sx,'y':sy})\n  check('touch drag steers the can with invisible controls',phone.evaluate('__BUZZ.world.players[0].x')\"'!=before)\n  phone.evaluate(\"const w=__BUZZ.world;w.bird.state='\"'retreat';w.bird.timer=99;BCP.spawnBee(w,{x:w.players[0].x,tier:6,kind:'worker',dir:1,reward:'touch-proof'});__game.input.lastDevice='touch';__game.advance(.2)\\\")\n  check('safe touch assistance fires useful ordinary spray',phone.evaluate('__BUZZ.world.stats.shots>0'))\n  phone.evaluate(\\\"__game.input.lastDevice='touch'; __BUZZ.world.obstacles=[];BCP.placeComb(__BUZZ.world,320,3,true,'touch-context');__game.advance(.02)\\\")\n  # Convert canonical comb coordinates through native screen buffer fit.\n  point=phone.evaluate(\\\"(()=>{const s=__game.screen,rc=s.canvas.getBoundingClientRect();const q=__game.r.w(320,173);return {x:rc.left+(q[0]-s.margX)*s.S/s.dpr,y:rc.top+(q[1]-s.margY)*s.S/s.dpr};})()\\\")\n  # Native screen uses centered buffer offset; calculate by pointer round-trip where no margin API is public.\n  point=phone.evaluate(\\\"(()=>{const rc=__game.screen.canvas.getBoundingClientRect(),S=__game.screen;const a=S.clientToScreen(rc.left,rc.top),b=S.clientToScreen(rc.right,rc.bottom);const x=(__game.W-640)/2+320,y=(__game.H-360)/2+173;return {x:rc.left+(x-a[0])/(b[0]-a[0])*rc.width,y:rc.top+(y-a[1])/(b[1]-a[1])*rc.height};})()\\\")\n  phone.touchscreen.tap(point['x'],point['y']);phone.evaluate('__game.advance(.05)')\n  check('touch parcel tap exposes contextual actions',phone.get_by_role('button',name='Harvest parcel',exact=True).count()==1)\n  if phone.get_by_role('button',name='Harvest parcel',exact=True).count():\n   phone.get_by_role('button',name='Harvest parcel',exact=True).click();phone.evaluate('__game.advance(.1)')\n   check('touch harvest uses the ordinary shared call',phone.evaluate('__BUZZ.world.coverage.call===true'))\n  phone.evaluate(\\\"__game.menu();__game.advance(.02)\\\")\n  check('touch menu opens native pause',phone.evaluate('__game.paused && __game.shell.screen===\\\\'pause\\\\''))\n  phone.evaluate('__game.shell.hide();__game.advance(.02)')\n  phone.set_viewport_size({'width':844,'height':390});phone.evaluate('__game.advance(.05)')\n  check('orientation change preserves canonical arena geometry',phone.evaluate('BCP.ARENA.w===640 && BCP.ARENA.h===360 && __BUZZ.world.players.every(p=>p.x>=28&&p.x<=612)'))\n  shot(phone,'touch-landscape.png')\n  touch.close();browser.close()\n  # A second compatible browser; WebKit is an emulation, not physical iOS.\n  webkit=p.webkit.launch(headless=True)\n  context=webkit.new_context(viewport={'width':1280,'height':720})\n  other=context.new_page();other.goto(url);other.wait_for_function('window.__BUZZ?.ready')\n  other.keyboard.press('Enter');other.wait_for_function(\\\"__game.sceneName==='play'\\\")\n  other.evaluate('__game.advance(3)');other.keyboard.down('Space');other.wait_for_timeout(250);other.keyboard.up('Space')\n  check('WebKit boots, takes input and draws native game without errors',other.evaluate('__BUZZ.world.stats.shots>0 && __game.errors.length===0'))\n  context.close();webkit.close()\nexcept Exception:\n check('browser automation completed',False,traceback.format_exc())\n(base/'evidence/browser-report.json').write_text(json.dumps({'checks':checks},indent=2))\nprint(json.dumps({'checks':checks}))\nPY\"","aggregated_output":"","exit_code":0,"status":"completed"}}
