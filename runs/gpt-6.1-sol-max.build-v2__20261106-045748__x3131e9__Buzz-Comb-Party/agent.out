{"type":"item.completed","item":{"id":"item_97","type":"command_execution","command":"/bin/bash -lc \"rg -n 'function about|function titleUpdate|fitTouchMenu|welcome|b.gag|Pip:|The fresh' src/screens.js src/main.js src/content.js && sed -n '470,556p' src/screens.js && sed -n '113,170p' tests/hub.py\"","aggregated_output":"src/content.js:21:\t\t\tgag: 'Pip: \"Five stars. Would nibble again.\"',\nsrc/content.js:27:\t\t\tcombs: [{ x: 320, tier: 2, red: false, id: \"welcome\" }],\nsrc/content.js:99:\t\t\tgag: 'Pip: \"Your shield tastes like strawberries.\"',\nsrc/content.js:117:\t\t\tgag: 'Pip: \"Lovely party. I ate the security system.\"',\nsrc/main.js:52:\tfunction fitTouchMenu(menu) {\nsrc/main.js:227:\tfunction titleUpdate(dt) {\nsrc/main.js:309:\t\t\t\t\t? 'Pip: \"I ate the security system.\"'\nsrc/main.js:310:\t\t\t\t\t: 'Pip: \"A few less warning shots next time?\"',\nsrc/main.js:388:\t\t\t\ttitleMenu = fitTouchMenu(\nsrc/main.js:453:\t\t\t\tresultMenu = fitTouchMenu(\nsrc/screens.js:546:\t\tfunction about(page = 0) {\n\t\t}\n\t\tfunction pickImport() {\n\t\t\tif (app.online || game.headless) return;\n\t\t\tconst file = document.createElement(\"input\");\n\t\t\tfile.type = \"file\";\n\t\t\tfile.accept = \".json,application/json\";\n\t\t\tfile.onchange = async () => {\n\t\t\t\tif (file.files?.[0]) {\n\t\t\t\t\timportData(await file.files[0].text());\n\t\t\t\t\tdiagnostics();\n\t\t\t\t}\n\t\t\t};\n\t\t\tfile.click();\n\t\t}\n\t\tfunction diagnostics() {\n\t\t\topen(\"diagnostics\", {\n\t\t\t\tkicker: \"Workshop\",\n\t\t\t\ttitle: \"Export / import\",\n\t\t\t\ttext: () =>\n\t\t\t\t\tdiagnostic ||\n\t\t\t\t\t\"Export includes the seed, tick, ledger, current world, tuning and authored content. Invalid profiles leave the last good values intact.\",\n\t\t\t\tactions: [\n\t\t\t\t\t[\n\t\t\t\t\t\t\"Download diagnostic JSON\",\n\t\t\t\t\t\t() => {\n\t\t\t\t\t\t\tdownload();\n\t\t\t\t\t\t\tshell.toast(\n\t\t\t\t\t\t\t\t\"Diagnostic exported\",\n\t\t\t\t\t\t\t\t\"JSON includes tuning, content and state.\",\n\t\t\t\t\t\t\t);\n\t\t\t\t\t\t},\n\t\t\t\t\t],\n\t\t\t\t\t[\n\t\t\t\t\t\t\"Copy diagnostic JSON\",\n\t\t\t\t\t\tasync () => {\n\t\t\t\t\t\t\ttry {\n\t\t\t\t\t\t\t\tawait navigator.clipboard.writeText(\n\t\t\t\t\t\t\t\t\tJSON.stringify(exportObject()),\n\t\t\t\t\t\t\t\t);\n\t\t\t\t\t\t\t\tshell.toast(\"Copied\", \"Diagnostic JSON is on the clipboard.\");\n\t\t\t\t\t\t\t} catch {\n\t\t\t\t\t\t\t\tdiagnostic =\n\t\t\t\t\t\t\t\t\t\"Clipboard unavailable here. Download the same JSON instead.\";\n\t\t\t\t\t\t\t\tdiagnostics();\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t},\n\t\t\t\t\t],\n\t\t\t\t\t[\"Import tuning / content JSON\", pickImport],\n\t\t\t\t\t[\"Back\", () => shell.back()],\n\t\t\t\t],\n\t\t\t});\n\t\t}\n\t\tfunction coop() {\n\t\t\topen(\"coop\", {\n\t\t\t\tkicker: \"Two cans, one garden\",\n\t\t\t\ttitle: \"Choose your devices\",\n\t\t\t\ttext: \"Both cans share score, reserves and Pip. They can pass each other. Keyboard and pointer always belong to player 1.\",\n\t\t\t\tactions: [\n\t\t\t\t\t[\"Keyboard + one pad\", () => app.start(2, \"mixed\")],\n\t\t\t\t\t[\"Two pads\", () => app.start(2, \"pads\")],\n\t\t\t\t\t[\"One shared keyboard\", () => app.start(2, \"keys\")],\n\t\t\t\t\t[\"Back\", () => shell.back()],\n\t\t\t\t],\n\t\t\t});\n\t\t}\n\t\tfunction records() {\n\t\t\tconst r = app.records();\n\t\t\topen(\"records\", {\n\t\t\t\tkicker: \"Local scorebook\",\n\t\t\t\ttitle: \"Garden records\",\n\t\t\t\ttext: r.runs\n\t\t\t\t\t? `${r.runs} unassisted runs • ${r.wins} parties saved\\nBest score ${r.best.toLocaleString()}\\nFastest win ${r.fastest ? B.formatTime(r.fastest) : \"unknown\"}`\n\t\t\t\t\t: \"Your scorebook is waiting for its first garden shift.\",\n\t\t\t\tactions: [[\"Back\", () => shell.back()]],\n\t\t\t});\n\t\t}\n\t\tfunction about(page = 0) {\n\t\t\taboutPage = (page + 4) % 4;\n\t\t\tconst d = B.REPORT || {};\n\t\t\tconst keys = [\n\t\t\t\t\t\"sourceInformation\",\n\t\t\t\t\t\"testingFeedback\",\n\t\t\t\t\t\"engineFeedback\",\n\t\t\t\t\t\"promptFeedback\",\n\t\t\t\t],\n\t\t\t\tlabels = [\n\t\t\t\t\t\"Source Information\",\n            all(f.evaluate(\"__BUZZ.world.tick===0\") for f in frames),\n        )\n        page.locator(\"#release\").click()\n        page.wait_for_function(\n            \"document.querySelector('iframe').contentWindow.__BUZZ.world.status==='live'\",\n            timeout=20000,\n        )\n        host = next(f for f in frames if f.evaluate(\"AIHub.isHost\"))\n        client = next(f for f in frames if not f.evaluate(\"AIHub.isHost\"))\n        # Both use ordinary controls; synchronized fixture only places the test bee in the firing lane.\n        host.evaluate(\n            \"\"\"(()=>{const w=__BUZZ.world;BCP.spawnBee(w,{kind:'worker',x:w.players[0].x,tier:6,dir:1,reward:'network-proof'});__game.input.hold('fire');})()\"\"\"\n        )\n        client.evaluate(\"__game.input.tap('call')\")\n        page.wait_for_function(\n            \"document.querySelector('iframe').contentWindow.__BUZZ.world.stats.hits>0\",\n            timeout=15000,\n        )\n        host.evaluate(\"__game.input.hold('fire',false)\")\n        page.wait_for_function(\n            \"(()=>{const f=Array.from(document.querySelectorAll('iframe'));return f[0].contentWindow.__BUZZ.world.score===f[1].contentWindow.__BUZZ.world.score&&f[0].contentWindow.__BUZZ.world.stats.hits>0})()\",\n            timeout=10000,\n        )\n        check(\n            \"two copies share actual bee conversion and score\",\n            host.evaluate(\"__BUZZ.world.stats.hits\")\n            == client.evaluate(\"__BUZZ.world.stats.hits\")\n            and host.evaluate(\"__BUZZ.world.score\")\n            == client.evaluate(\"__BUZZ.world.score\"),\n        )\n        check(\n            \"remote call is authoritative and shared\",\n            host.evaluate(\"__BUZZ.world.coverage.call===true\")\n            and client.evaluate(\"__BUZZ.world.coverage.call===true\"),\n        )\n        before = host.evaluate(\"__BUZZ.world.tick\")\n        host.evaluate(\"__game.menu('pause',{pause:false});null\")\n        page.wait_for_timeout(500)\n        check(\n            \"online local options keep the host world moving\",\n            host.evaluate(\"__BUZZ.world.tick\") > before\n            and host.evaluate(\"__game.shell.screen\") == \"pause\",\n        )\n        host.evaluate(\"__game.shell.hide();null\")\n        # Malformed and stale inputs travel through the real SDK; sender cannot claim P1.\n        client.evaluate(\n            \"AIHub.send({v:1,k:'input',seq:-1,move:Infinity,aim:null,fire:true,call:0,seat:1},{to:AIHub.host})\"\n        )\n        page.wait_for_timeout(200)\n        check(\n            \"host rejects malformed remote action\",\n            host.evaluate(\"__BUZZ.network.metrics.rejected\") > 0,\n        )\n        stock = host.evaluate(\"__BUZZ.world.reserves\")\n        host.evaluate(\"BCP.queueGrowth(__BUZZ.world,0,640,.01)\")\n        page.wait_for_function(\n            \"(()=>{const f=Array.from(document.querySelectorAll('iframe'));return f.every(x=>x.contentWindow.__BUZZ.world.stats.retries===1)})()\",\n            timeout=15000,\n","exit_code":0,"status":"completed"}}
