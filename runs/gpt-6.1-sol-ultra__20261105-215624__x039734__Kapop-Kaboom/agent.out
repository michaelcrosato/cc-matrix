{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='sim.js';s=open(p).read().replace(\\\"let b=candidates.sort((a,b)=>a.y-b.y)[0];p.target=b?clamp(b.x,-7.15,7.15):this.bomberX;\\\", \\\"let b=candidates.sort((a,b)=>a.y-b.y)[0];if(b){let pack=candidates.filter(c=>Math.abs(c.y-b.y)<.25&&Math.abs(c.x-b.x)<2*(this.settings.catchWidth+.12));p.target=clamp(pack.reduce((sum,c)=>sum+c.x,0)/pack.length,-7.15,7.15);}else p.target=this.bomberX;\\\")\nopen(p,'w').write(s)\np='sim.test.mjs';s=open(p).read().replace(\\\"g.spawn('gold',0,2);for(let i=0;i<15;i++)\\\", \\\"g.spawn('gold',0,2);for(let i=0;i<20;i++)\\\");open(p,'w').write(s)\nPY\nnode sim.test.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
