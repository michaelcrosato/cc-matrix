{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' network.js; sed -n '1,130p' scene.js\"","aggregated_output":"/* Kapop networking. AI Hub Session Protocol v1 + standalone PeerJS co-op.\n * Hub client is embedded unmodified in the document before this module.\n * PeerJS is loaded only after a standalone Host or Join action.\n */\nconst PEER_URL = 'https://cdn.jsdelivr.net/npm/peerjs@1.5.5/dist/peerjs.min.js';\nconst COLORS = ['#f27955', '#62d7d2', '#b7dd68', '#d09def'];\nlet peerLibrary;\nfunction loadPeer() {\n  if (globalThis.Peer) return Promise.resolve(globalThis.Peer);\n  if (peerLibrary) return peerLibrary;\n  peerLibrary = new Promise((resolve, reject) => {\n    const script = document.createElement('script');\n    script.src = PEER_URL;\n    script.crossOrigin = 'anonymous';\n    script.onload = () => globalThis.Peer ? resolve(globalThis.Peer) : reject(new Error('Room service did not load.'));\n    script.onerror = () => { peerLibrary = null; script.remove(); reject(new Error('Room service unavailable. Check your connection and retry.')); };\n    document.head.append(script);\n  });\n  return peerLibrary;\n}\nconst noop = () => {};\nconst cleanInput = (v = {}) => ({ x: Number.isFinite(v.x) ? Math.max(-7, Math.min(7, v.x)) : 0, pop: v.pop === true });\nfunction randomRoom() {\n  const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  return Array.from(crypto.getRandomValues(new Uint8Array(6)), (n) => alphabet[n % alphabet.length]).join('');\n}\nexport class Network {\n  constructor(callbacks = {}) {\n    this.callbacks = { onStatus: noop, onStart: noop, onInput: noop, onState: noop, onRoster: noop, onEnd: noop, onTimeUp: noop, ...callbacks };\n    this.role = 'offline';\n    this.connected = false;\n    this.roomCode = '';\n    this.players = [];\n    this.me = 0;\n    this.server = false;\n    this.started = false;\n    this.ended = false;\n    this.hubActive = globalThis.AIHub?.active === true;\n    this.status = this.hubActive ? 'Joining AI Hub…' : 'Play together. Catch together.';\n    this._hub = globalThis.AIHub;\n    this._peer = null;\n    this._connection = null;\n    this._input = { x: 0, pop: false };\n    this._popQueued = false;\n    this._sendClock = 0;\n    this._sequence = 0;\n    this._receivedSequence = -1;\n    this._reported = false;\n    this._lastScore = 0;\n    this._startAt = Infinity;\n    this._generation = 0;\n    this._off = [];\n    this.metrics = { sent: 0, received: 0, rejected: 0 };\n  }\n  get canPlay() {\n    if (!this.started || this.ended) return false;\n    return this.hubActive ? this._hub.time() >= 0 : performance.now() >= this._startAt;\n  }\n  _status(text) { this.status = text; this.callbacks.onStatus(text); }\n  _roster(players) { this.players = players.map((p) => ({ ...p })); this.callbacks.onRoster(this.players); }\n  async init() {\n    if (!this.hubActive) return null;\n    const hub = this._hub;\n    const info = await hub.connect({ mode: 'shared-world', seats: [1, 4] });\n    if (!info) { this.hubActive = false; this._status('Play together. Catch together.'); return null; }\n    this.role = info.isHost ? 'host' : 'guest';\n    this.me = info.me;\n    this.server = info.server === true;\n    this.connected = true;\n    this._roster(info.players);\n    this._off.push(hub.on('start', (event) => {\n      if (this.ended) return;\n      this.started = true;\n      this._startAt = performance.now() + event.in;\n      this._status('AI Hub · shared bucket brigade');\n      this.callbacks.onStart({ players: this.players, server: this.server, me: this.me, countdownMs: event.in || 0 });\n    }));\n    this._off.push(hub.on('message', (data, from) => this._receive(data, from)));\n    this._off.push(hub.on('leave', ({ id }) => {\n      this._roster(this.players.filter((p) => p.id !== id));\n      // Release a departed player's held action immediately.\n      if (this.role === 'host') this.callbacks.onInput(id, { x: 0, pop: false, left: true });\n    }));\n    this._off.push(hub.on('time-up', (event) => {\n      if (this.ended) return;\n      this.callbacks.onTimeUp(event);\n      if (this.role === 'host' && !this._reported) this.finish(false, this._lastScore);\n    }));\n    this._off.push(hub.on('end', (event) => {\n      this.ended = true;\n      this.started = false;\n      this._status('Round complete');\n      this.callbacks.onEnd(event);\n    }));\n    this._status('AI Hub · ready for the round');\n    hub.ready();\n    return info;\n  }\n  async host() {\n    if (this.hubActive) return null;\n    this.disconnect(false);\n    const generation = this._generation;\n    this._status('Opening a room…');\n    try {\n      const Peer = await loadPeer();\n      if (generation !== this._generation) return null;\n      this.roomCode = randomRoom();\n      const peer = this._peer = new Peer('kapop-v1-' + this.roomCode, { debug: 0 });\n      this.role = 'host'; this.me = 0;\n      this._roster([{ id: 0, name: 'Player 1', color: COLORS[0] }]);\n      peer.on('connection', (connection) => {\n        if (this._connection?.open || this.started) {\n          connection.on('open', () => { connection.send({ t: 'busy' }); setTimeout(() => connection.close(), 150); });\n          return;\n        }\n        this._wire(connection, 1);\n      });\n      await this._opened(peer, generation);\n      this._status('Room ' + this.roomCode + ' · waiting for a partner');\n      return this.roomCode;\n    } catch (error) {\n      if (generation === this._generation) { this.disconnect(false); this._status(error.message || 'Could not open a room.'); }\n      throw error;\n    }\n  }\n  async join(code) {\n    if (this.hubActive) return false;\n    const room = String(code || '').trim().toUpperCase().replace(/^KAPOP[- ]?/, '');\n    if (!/^[A-HJ-NP-Z2-9]{6}$/.test(room)) throw new Error('Enter the six-character room code.');\n    this.disconnect(false);\n    const generation = this._generation;\n    this._status('Finding room ' + room + '…');\n    try {\n      const Peer = await loadPeer();\n      if (generation !== this._generation) return false;\n      this.roomCode = room;\n      const peer = this._peer = new Peer({ debug: 0 });\n      this.role = 'guest'; this.me = 1;\n      await this._opened(peer, generation);\n      if (generation !== this._generation) return false;\n      const connection = peer.connect('kapop-v1-' + room, { reliable: true, serialization: 'json' });\n      this._wire(connection, 0);\n      await new Promise((resolve, reject) => {\n        const timeout = setTimeout(() => reject(new Error('Room did not answer. Check the code and try again.')), 18000);\n        connection.on('open', () => { clearTimeout(timeout); resolve(); });\n        connection.on('error', (error) => { clearTimeout(timeout); reject(error); });\n      });\n      return true;\n    } catch (error) {\n      if (generation === this._generation) { this.disconnect(false); this._status(error.message || 'Could not join the room.'); }\n      throw error;\n    }\n  }\n  _opened(peer, generation) {\n    return new Promise((resolve, reject) => {\n      let settled = false;\n      const timeout = setTimeout(() => { if (!settled) { settled = true; reject(new Error('Room service timed out. Please try again.')); } }, 18000);\n      peer.on('open', () => {\n        clearTimeout(timeout); settled = true;\n        generation === this._generation ? resolve() : reject(new Error('Room cancelled.'));\n      });\n      peer.on('error', (error) => {\n        clearTimeout(timeout);\n        const detail = error.type === 'unavailable-id' ? 'Room code in use. Try hosting again.' : error.type === 'peer-unavailable' ? 'Room not found. Check the code.' : 'Room connection failed. Please try again.';\n        if (!settled) { settled = true; reject(new Error(detail)); }\n        else if (generation === this._generation) this._status(detail);\n      });\n    });\n  }\n  _wire(connection, otherId) {\n    this._connection = connection;\n    connection.on('open', () => {\n      if (connection !== this._connection) { connection.close(); return; }\n      this.connected = true;\n      this.ended = false;\n      this._status(this.role === 'host' ? 'Partner connected · start when ready' : 'Connected · your host starts the run');\n      if (this.role === 'host') {\n        this._roster([{ id: 0, name: 'Player 1', color: COLORS[0] }, { id: 1, name: 'Player 2', color: COLORS[1] }]);\n        this._send({ t: 'roster', players: this.players });\n      }\n    });\n    connection.on('data', (data) => this._receive(data, otherId));\n    connection.on('close', () => {\n      if (connection !== this._connection) return;\n      this._connection = null;\n      this.connected = false;\n      this.started = false;\n      this.ended = true;\n      if (this.role === 'host') this._roster(this.players.filter((p) => p.id === 0));\n      this._status('Partner disconnected');\n      this.callbacks.onEnd({ reason: 'peer-left', standings: null });\n    });\n    connection.on('error', () => this._status('Connection interrupted. Rejoin the room.'));\n  }\n  start() {\n    if (this.hubActive || this.role !== 'host' || !this.connected) return false;\n    this.started = true; this.ended = false; this._reported = false;\n    this._sequence = 0; this._receivedSequence = -1;\n    const countdownMs = 3000;\n    this._startAt = performance.now() + countdownMs;\n    this._send({ t: 'start', countdownMs, players: this.players });\n    this.callbacks.onStart({ players: this.players, server: false, me: this.me, countdownMs });\n    return true;\n  }\n  _receive(data, from) {\n    if (!data || typeof data !== 'object' || (this.ended && !(!this.hubActive && data.t === 'start'))) return;\n    this.metrics.received++;\n    const hostId = this.hubActive ? this._hub.host : 0;\n    if (data.t === 'input' && this.role === 'host' && this.players.some((p) => p.id === from)) {\n      this.callbacks.onInput(from, cleanInput(data.input));\n    } else if (data.t === 'state' && this.role === 'guest' && from === hostId) {\n      if (!Number.isFinite(data.seq) || data.seq <= this._receivedSequence) return;\n      this._receivedSequence = data.seq;\n      this.callbacks.onState(data.state);\n    } else if (!this.hubActive && this.role === 'guest' && from === 0) {\n      if (data.t === 'roster' && Array.isArray(data.players)) this._roster(data.players.slice(0, 2));\n      else if (data.t === 'start') {\n        this.started = true; this.ended = false; this._reported = false;\n        this._receivedSequence = -1;\n        this._startAt = performance.now() + Math.max(0, Number(data.countdownMs) || 0);\n        if (Array.isArray(data.players)) this._roster(data.players.slice(0, 2));\n        this.callbacks.onStart({ players: this.players, server: false, me: this.me, countdownMs: data.countdownMs || 0 });\n      } else if (data.t === 'finish') {\n        this.ended = true; this.started = false;\n        this.callbacks.onEnd({ reason: 'finished', won: data.won, score: data.score });\n      } else if (data.t === 'busy') this._status('That room already has a partner or a run in progress.');\n    }\n  }\n  _send(data, to) {\n    if (this.ended) return false;\n    let sent = false;\n    if (this.hubActive) sent = this._hub.send(data, to == null ? {} : { to });\n    else if (this._connection?.open) { try { this._connection.send(data); sent = true; } catch { this._status('Connection interrupted.'); } }\n    if (sent) this.metrics.sent++;\n    return sent;\n  }\n  sendInput(input) {\n    this._input = cleanInput(input);\n    if (this._input.pop) this._popQueued = true;\n  }\nimport * as THREE from 'three/webgpu';\nimport { color, normalWorld, vec3 } from 'three/tsl';\n\nconst C={ink:0x243340,cream:0xf5e9ce,paper:0xfff3d7,coral:0xeb7159,mint:0x61c5b1,teal:0x278f88,navy:0x354d60,gold:0xf7bd50,rose:0xd9a08b,blue:0x85b8bf};\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nlet seed=281;\nconst rnd=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296;};\n\nexport class GameScene{\n constructor(){this.scene=new THREE.Scene();this.scene.background=new THREE.Color(C.cream);this.bombMeshes=new Map();this.playerGroups=[];this.particles=[];this.rings=[];this.time=0;this.materials=new Map();this.lastThrow=0;this.lastCatch=[0,0];this.mixers=[];this.shake=0;this.ready=false;this.renderCount=0;this.animCount=0;}\n async init(container){\n  this.container=container;\n  this.renderer=new THREE.WebGPURenderer({antialias:true,alpha:false,forceWebGL:new URLSearchParams(location.search).has('webgl')});\n  this.renderer.setPixelRatio(Math.min(devicePixelRatio,2));this.renderer.outputColorSpace=THREE.SRGBColorSpace;\n  this.renderer.setClearColor(C.cream,1);container.appendChild(this.renderer.domElement);\n  this.renderer.domElement.setAttribute('aria-label','Kapop: an inked rooftop bomb-catching arcade diorama');\n  await this.renderer.init();\n  this.camera=new THREE.OrthographicCamera(-12,12,15,-2,.1,100);this.camera.position.set(0,8.2,30);this.camera.lookAt(0,6.3,0);\n  this.scene.add(new THREE.HemisphereLight(0xfff6dc,0x6d8c99,2));\n  const key=new THREE.DirectionalLight(0xffe4b0,3);key.position.set(-8,16,12);this.scene.add(key);\n  this.buildStage();this.buildBomber();this.buildPlayers();this.resize();\n  this.ready=true;return this;\n }\n mat(hex,unlit=false){const id=hex+'-'+unlit;if(this.materials.has(id))return this.materials.get(id);let m;if(unlit)m=new THREE.MeshBasicMaterial({color:hex});else{m=new THREE.MeshBasicNodeMaterial();const bands=normalWorld.dot(vec3(-.35,.72,.6)).mul(.5).add(.5).mul(3).floor().div(3).mul(.35).add(.65);m.colorNode=color(hex).mul(bands);}this.materials.set(id,m);return m;}\n mesh(geo,col,parent=this.scene,ink=true){const m=new THREE.Mesh(geo,this.mat(col));parent.add(m);if(ink){const o=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({color:C.ink,side:THREE.BackSide}));o.scale.setScalar(1.045);m.add(o);}return m;}\n box(w,h,d,x,y,z,col,parent=this.scene,ink=true){const m=this.mesh(new THREE.BoxGeometry(w,h,d),col,parent,ink);m.position.set(x,y,z);return m;}\n sphere(r,x,y,z,col,parent=this.scene,ink=true){const m=this.mesh(new THREE.SphereGeometry(r,16,12),col,parent,ink);m.position.set(x,y,z);return m;}\n cylinder(rt,rb,h,x,y,z,col,parent=this.scene,ink=true,segments=24){const m=this.mesh(new THREE.CylinderGeometry(rt,rb,h,segments),col,parent,ink);m.position.set(x,y,z);return m;}\n line(points,col=C.ink,width=1,parent=this.scene){const geo=new THREE.BufferGeometry().setFromPoints(points.map(v=>new THREE.Vector3(...v)));const m=new THREE.Line(geo,new THREE.LineBasicMaterial({color:col,linewidth:width}));parent.add(m);return m;}\n text(label,x,y,z,{width=4,height=.8,fg='#243340',bg=null,size=80,rotate=0,font='900'}={},parent=this.scene){const canvas=document.createElement('canvas');canvas.width=1024;canvas.height=Math.round(1024*height/width);const ctx=canvas.getContext('2d');if(bg){ctx.fillStyle=bg;ctx.fillRect(0,0,canvas.width,canvas.height);}ctx.fillStyle=fg;ctx.font=`${font} ${Math.round(canvas.height*.79)}px \"Trebuchet MS\",sans-serif`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(label,512,canvas.height/2,980);const tex=new THREE.CanvasTexture(canvas);tex.colorSpace=THREE.SRGBColorSpace;const m=new THREE.Mesh(new THREE.PlaneGeometry(width,height),new THREE.MeshBasicMaterial({map:tex,transparent:!bg,depthWrite:!!bg}));m.position.set(x,y,z);m.rotation.z=rotate;parent.add(m);return m;}\n ellipse(rx,ry,x,y,z,col,opacity=1,parent=this.scene){const m=new THREE.Mesh(new THREE.CircleGeometry(1,40),new THREE.MeshBasicMaterial({color:col,transparent:opacity<1,opacity,depthWrite:opacity>=1}));m.scale.set(rx,ry,1);m.position.set(x,y,z);parent.add(m);return m;}\n buildStage(){\n  const bg=new THREE.Group();this.scene.add(bg);\n  // The paper texture is drawn in code; faint print-grain gives the whole set a physical feel.\n  const paper=document.createElement('canvas');paper.width=512;paper.height=512;const p=paper.getContext('2d');p.fillStyle='#f6eacf';p.fillRect(0,0,512,512);for(let i=0;i<4200;i++){p.fillStyle=i%2?'rgba(89,77,62,.035)':'rgba(255,255,255,.10)';p.fillRect(rnd()*512,rnd()*512,1+rnd()*2,1);}const tx=new THREE.CanvasTexture(paper);tx.wrapS=tx.wrapT=THREE.RepeatWrapping;tx.repeat.set(4,3);tx.colorSpace=THREE.SRGBColorSpace;\n  const back=new THREE.Mesh(new THREE.PlaneGeometry(38,27),new THREE.MeshBasicMaterial({map:tx}));back.position.set(0,8,-6);bg.add(back);\n  // A large setting sun and softly printed skyline sit behind the clear playfield.\n  this.ellipse(4.6,4.6,5.5,10,-5.8,0xf2ce9d);\n  for(let i=0;i<11;i++){const x=-16+i*3.0;const h=3+rnd()*5;this.box(2.7,h,.2,x,1+h/2,-5.3,0xe2d3bc,bg,false);this.box(2.95,.24,.35,x,1+h,-5.2,0xc5b7a7,bg,false);for(let k=0;k<2;k++)for(let r=0;r<Math.floor(h/1.5);r++)this.box(.28,.5,.05,x-.65+k*1.2,1.7+r*1.4,-5.1,0xc8bdaa,bg,false);}\n  // Balcony spanning the roof. Only the rails lie behind the bombs.\n  this.box(17.6,.38,1.6,0,10.62,-.2,C.coral);\n  this.box(18,.13,1.78,0,10.86,-.2,C.paper);\n  this.box(17.8,.16,.32,0,10.36,.65,C.ink,this.scene,false);\n  for(let x=-8.6;x<9;x+=.64){this.box(.065,.83,.07,x,11.32,-.62,C.navy);this.sphere(.065,x,11.74,-.62,C.gold,this.scene,false);}\n  this.box(17.6,.08,.09,0,11.74,-.62,C.navy);\n  // Finely ruled playfield: floor and faint plumb-lines read as a stage, not a flat HUD.\n  this.box(27,.6,6.0,0,-.58,-.7,C.rose);\n  this.box(26,.15,5.6,0,-.23,-.55,0xf0c9a2);\n  for(let x=-13;x<=13;x+=1.35)this.line([[x,-.14,-3],[x,-.14,2.3]],0xcc9f86);\n  for(let z=-2.6;z<2.5;z+=1.1)this.line([[-13,-.14,z],[13,-.14,z]],0xcc9f86);\n  this.box(19.0,.16,.14,0,.05,-.8,C.ink,this.scene,false);\n  // Curved washed-up puddles.\n  for(let i=0;i<6;i++){const m=this.ellipse(.45+rnd()*.5,.13,-8+rnd()*16,.04,1.2+rnd()*.2,C.teal,.22);m.rotation.x=-Math.PI/2;}\n  this.buildBuilding(-10.6,false);this.buildBuilding(10.6,true);\n  // Worn carnival signs suspended beneath the gallery.\n  this.box(4.65,.84,.12,0,9.83,-1.3,C.paper);\n  this.text('BUCKET BRIGADE',0,9.83,-1.21,{width:4.38,height:.57,size:94});\n  this.text('NO BOOMS. JUST BLOOMS.',0,9.14,-2.1,{width:4.65,height:.45,size:72,fg:'#a79279'});\n  for(let x of [-2.1,2.1]){this.line([[x,10.45,-1.3],[x,10.05,-1.3]],C.ink);this.sphere(.048,x,10.05,-1.18,C.gold);}\n  // Strings and flags arch over the courtyard.\n  const flagColors=[C.coral,C.mint,C.gold,C.paper];\n  for(let side of [-1,1]){const pts=[];for(let i=0;i<=20;i++){const x=side*(2.8+i*.47),y=13.1+Math.pow((i-10)/10,2)*.72;pts.push([x,y,-2]);}this.line(pts,C.ink);for(let i=0;i<19;i++){const x=side*(3.1+i*.47),y=13.1+Math.pow((i-10)/10,2)*.72;const geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute([-.22,0,0,0,-.6,0,.22,0,0],3));geo.computeVertexNormals();const f=this.mesh(geo,flagColors[i%4],this.scene,false);f.position.set(x,y,-1.95);const clip=new THREE.AnimationClip('flag',2.4,[new THREE.NumberKeyframeTrack('.rotation[y]',[0,1.2,2.4],[-.3,.3,-.3])]);const mix=new THREE.AnimationMixer(f);mix.clipAction(clip).play();this.mixers.push(mix);this.animCount++;}}\n  // A proper gallery clock.\n  this.cylinder(.53,.53,.11,-7.5,12.4,-.42,C.ink).rotation.x=Math.PI/2;\n  this.ellipse(.46,.46,-7.5,12.4,-.33,C.paper);for(let i=0;i<12;i++){const a=i*Math.PI/6;this.sphere(.025,-7.5+Math.sin(a)*.37,12.4+Math.cos(a)*.37,-.27,C.ink,this.scene,false);}\n  this.line([[-7.5,12.65,-.22],[-7.5,12.4,-.22],[-7.26,12.28,-.22]],C.ink);\n  this.text('EST. 1981',7.2,12.35,-.6,{width:2.1,height:.4,size:80,fg:'#765c4f'});\n  // Clouds, stars and a tiny crescent provide sky detail without harming readability.\n  for(let k=0;k<5;k++){const x=-10+rnd()*20,y=14+rnd()*2;for(let j=0;j<3;j++)this.ellipse(.55+j*.2,.25+j*.08,x+j*.55,y+(j===1?.13:0),-5,0xfff4d9,.8);}\n  this.ambient=new THREE.Group();this.scene.add(this.ambient);\n  for(let i=0;i<13;i++){const f=this.box(.05,.14,.025,-12+rnd()*24,12+rnd()*4,-3.3,C.gold,this.ambient,false);f.rotation.z=.6;}\n }\n buildBuilding(x,right){\n  const col=right?0xdcbda7:0xe9ccaa;this.box(3.4,13.4,2.4,x,6.4,-2.5,col);this.box(3.65,.25,2.65,x,12.9,-2.45,C.paper);\n  const roof=this.mesh(new THREE.ConeGeometry(2.65,2.2,4),C.navy);roof.position.set(x,14.1,-2.5);roof.rotation.y=Math.PI/4;\n  this.box(.55,1.55,.55,x+(right?.8:-.7),14.9,-2.6,C.coral);this.box(.7,.17,.69,x+(right?.8:-.7),15.7,-2.6,C.ink);\n  for(let row=0;row<4;row++)for(let coln=0;coln<2;coln++){\n   const wx=x-.83+coln*1.66,wy=2+row*2.8;\n   this.box(.96,1.68,.17,wx,wy,-1.2,C.ink);this.box(.79,1.5,.18,wx,wy,-1.08,row%2?0xffd288:0xa5c1bd);\n   this.box(.07,1.53,.12,wx,wy,-.94,C.paper);this.box(.85,.075,.12,wx,wy,-.94,C.paper);\n   for(let side of [-1,1]){this.box(.29,1.64,.16,wx+side*.63,wy,-1.03,right?C.teal:C.coral);for(let sy=0;sy<5;sy++)this.box(.25,.035,.05,wx+side*.63,wy-.59+sy*.28,-.92,C.ink,this.scene,false);}\n   this.box(1.24,.15,.57,wx,wy-.89,-1,C.paper);\n   if(row===1||row===3){this.box(.9,.3,.36,wx,wy-.72,-.66,C.rose);for(let f=0;f<5;f++){this.sphere(.12,wx-.32+f*.16,wy-.45+rnd()*.09,-.62,f%2?C.gold:C.coral);this.box(.04,.24,.04,wx-.32+f*.16,wy-.6,-.65,C.teal,this.scene,false);}}\n  }\n  // Drainpipe with collars, brick marks, little shop awning and lanterns.\n  const px=x+(right?-1.5:1.5);this.cylinder(.08,.08,12.3,px,6.0,-1.04,C.navy);\n  for(let y=1;y<13;y+=2.5)this.cylinder(.12,.12,.12,px,y,-1.04,C.gold);\n  for(let n=0;n<20;n++){const bx=x-1.25+rnd()*2.5,by=.5+rnd()*12;this.line([[bx,by,-1.25],[bx+.3,by,-1.25]],0xb9977e);}\n  this.box(3.1,.72,1.0,x,1,-.38,C.cream);\n  for(let i=0;i<7;i++){const aw=this.box(.43,.16,1.15,x-1.29+i*.43,1.48,-.3,i%2?C.paper:C.coral);aw.rotation.x=.12;}\n  this.text(right?'POP! POST':'EAU de BOOM',x,.77,.18,{width:2.8,height:.38,size:75});\n  this.box(.28,.64,.32,x+(right?-1.85:1.85),5.0,-.65,C.ink);this.box(.19,.44,.34,x+(right?-1.85:1.85),5.0,-.62,C.gold);\n }\n buildBomber(){\n  this.bomberRoot=new THREE.Group();this.bomberRoot.position.set(0,10.92,.2);this.scene.add(this.bomberRoot);\n  const body=new THREE.Group();body.name='prankster';this.bomberRoot.add(body);this.bomberBody=body;\n  // Oversized boots, striped sweater and rubbery mischievous silhouette.\n  this.sphere(.23,-.25,.08,.08,C.ink,body);this.sphere(.23,.25,.08,.08,C.ink,body);\n  this.cylinder(.36,.31,.83,0,.64,0,C.paper,body);\n  for(let i=0;i<4;i++)this.cylinder(.365,.365,.085,0,.33+i*.2,0,C.navy,body,false);\n  this.sphere(.39,0,1.39,.02,0xf3bb86,body);\n  this.box(.77,.19,.22,0,1.44,.31,C.ink,body);\n  this.ellipse(.115,.08,-.18,1.46,.435,C.paper,1,body);this.ellipse(.115,.08,.18,1.46,.435,C.paper,1,body);\n  this.sphere(.037,-.15,1.46,.45,C.ink,body,false);this.sphere(.037,.2,1.46,.45,C.ink,body,false);\n  this.sphere(.08,0,1.32,.4,0xef9b71,body);\n  this.line([[-.11,1.2,.39],[0,1.17,.41],[.11,1.21,.39]],C.ink,1,body);\n  this.cylinder(.38,.42,.2,0,1.73,-.01,C.navy,body);\n  this.sphere(.12,.36,1.79,-.01,C.gold,body);\n  const arm=new THREE.Group();arm.name='throwarm';arm.position.set(.39,.99,0);body.add(arm);this.throwArm=arm;\n  const sleeve=this.cylinder(.13,.11,.57,.15,-.16,0,C.navy,arm);sleeve.rotation.z=.7;this.sphere(.135,.32,-.36,.01,0xf3bb86,arm);\n  const arm2=new THREE.Group();arm2.position.set(-.37,.99,0);body.add(arm2);const s2=this.cylinder(.13,.11,.55,-.16,-.16,0,C.navy,arm2);s2.rotation.z=-.7;this.sphere(.135,-.32,-.36,.01,0xf3bb86,arm2);\n  this.mixer=new THREE.AnimationMixer(body);\n  const idle=new THREE.AnimationClip('mischief-idle',1.15,[new THREE.NumberKeyframeTrack('.position[y]',[0,.575,1.15],[0,.08,0]),new THREE.NumberKeyframeTrack('.rotation[z]',[0,.575,1.15],[-.035,.035,-.035])]);this.mixer.clipAction(idle).play();\n  const throwClip=new THREE.AnimationClip('bomb-toss',.32,[new THREE.NumberKeyframeTrack('throwarm.rotation[z]',[0,.09,.22,.32],[0,-1.65,.4,0])]);this.throwAction=this.mixer.clipAction(throwClip);this.throwAction.setLoop(THREE.LoopOnce,1);this.throwAction.clampWhenFinished=false;this.animCount+=2;\n }\n makeBucket(col,index,parent){const g=new THREE.Group();g.position.y=.055+index*.55;parent.add(g);this.cylinder(.73,.54,.48,0,0,0,col,g);const rim=this.mesh(new THREE.TorusGeometry(.73,.065,8,36),C.paper,g);rim.rotation.x=Math.PI/2;rim.position.y=.245;const water=this.cylinder(.66,.66,.035,0,.216,0,0x94e8d5,g,false);this.box(.62,.17,.03,0,-.01,.65,C.paper,g);this.text('K',0,-.01,.674,{width:.29,height:.22,size:110},g);for(let s of [-1,1]){this.sphere(.07,s*.69,.11,0,C.ink,g);const handle=this.mesh(new THREE.TorusGeometry(.2,.027,6,16,Math.PI),C.ink,g,false);handle.rotation.z=s*Math.PI/2;handle.position.set(s*.75,.02,0);}\n  this.line([[-.36,.02,.55],[-.4,-.15,.52]],0x208079,1,g);return g;}\n buildPlayers(){for(let i=0;i<2;i++){const root=new THREE.Group();root.name='bucket-player-'+i;this.scene.add(root);const bounce=new THREE.Group();bounce.name='bounce';root.add(bounce);const buckets=[];for(let j=0;j<3;j++)buckets.push(this.makeBucket(i?C.coral:C.mint,j,bounce));const label=this.text(i?'02':'01',0,-.11,.88,{width:.48,height:.22,size:90,fg:i?'#bf5949':'#247d76'},root);const shadow=this.ellipse(1.1,.18,0,-.08,.4,C.ink,.13,root);shadow.rotation.x=-Math.PI/2;\n   const mixer=new THREE.AnimationMixer(bounce);const clip=new THREE.AnimationClip('bucket-splosh',.24,[new THREE.VectorKeyframeTrack('.scale',[0,.06,.16,.24],[1,1,1,1.15,.8,1.1,.95,1.1,1,1,1,1])]);const action=mixer.clipAction(clip);action.setLoop(THREE.LoopOnce,1);action.clampWhenFinished=false;this.animCount++;this.playerGroups.push({root,bounce,buckets,mixer,action,label});}\n }\n makeBomb(kind){const g=new THREE.Group();const heavy=kind==='heavy'||kind==='anvil';const gold=kind==='gold'||kind==='bonus';const r=heavy?.37:.28;this.sphere(r,0,0,0,gold?C.gold:C.ink,g);this.sphere(r*.3,-r*.28,r*.32,r*.83,gold?C.paper:0x596a70,g,false);this.cylinder(.09,.085,.14,0,r+.01,0,C.navy,g);this.line([[0,r+.08,0],[.1,r+.2,0],[.18,r+.18,0]],C.ink,1,g);const spark=this.sphere(.075,.18,r+.2,0,C.gold,g,false);g.userData.spark=spark;\n  if(heavy){this.box(.7,.16,.42,0,-.05,.02,0x4a6170,g);this.text('!',0,.04,r+.05,{width:.17,height:.3,size:100,fg:'#fff3d7'},g);}else{for(let s of [-1,1]){this.ellipse(.045,.065,s*.095,-.02,r*.94,C.paper,1,g);this.sphere(.019,s*.095+.009,-.025,r*.99,C.ink,g,false);}}\n  this.scene.add(g);return g;}\n update(dt,state={}){if(!this.ready)return;this.time=state.time??this.time+dt;this.lastState=state;this.mixer.update(dt);for(const m of this.mixers)m.update(dt);this.bomberRoot.position.x=state.bomberX??Math.sin(this.time*.8)*4.8;\n  const pulse=state.throwPulse??Math.floor(this.time*2.0);if(pulse!==this.lastThrow){this.throwAction.reset().play();this.lastThrow=pulse;}\n  const players=state.players?.length?state.players:[{x:Math.sin(this.time)*3.5,lives:3}];\n  this.playerGroups.forEach((v,i)=>{const p=players[i];v.root.visible=!!p;if(!p)return;v.root.position.x=p.x??0;const lives=p.lives??3;v.buckets.forEach((b,j)=>{b.visible=j<lives;});v.bounce.rotation.z=clamp((p.vx??0)*-.006,-.09,.09);const pulse=p.catchPulse??0;if(pulse!==this.lastCatch[i]){v.action.reset().play();this.lastCatch[i]=pulse;}v.mixer.update(dt);v.label.visible=players.length>1;if(p.pop>0)v.bounce.scale.x=1+Math.sin(this.time*25)*.035;});\n  const ids=new Set();for(const b of state.bombs??[]){ids.add(b.id);let m=this.bombMeshes.get(b.id);if(!m){m=this.makeBomb(b.kind);this.bombMeshes.set(b.id,m);}m.position.set(b.x,b.y,.4);m.rotation.z=b.rotation??Math.sin(this.time*6+b.id)*.15;const s=.8+Math.sin(this.time*43+(Number(b.id)||0))*.25;m.userData.spark.scale.setScalar(s);}\n  for(const [id,m]of this.bombMeshes)if(!ids.has(id)){this.scene.remove(m);this.disposeGroup(m);this.bombMeshes.delete(id);}\n  for(let i=this.particles.length-1;i>=0;i--){const p=this.particles[i];p.life-=dt;if(p.life<=0){this.scene.remove(p.mesh);p.mesh.geometry.dispose();p.mesh.material.dispose();this.particles.splice(i,1);continue;}p.vy-=p.gravity*dt;p.mesh.position.x+=p.vx*dt;p.mesh.position.y+=p.vy*dt;p.mesh.position.z+=p.vz*dt;p.mesh.rotation.z+=p.spin*dt;p.mesh.scale.setScalar(Math.max(.01,p.life/p.max));}\n","exit_code":0,"status":"completed"}}
