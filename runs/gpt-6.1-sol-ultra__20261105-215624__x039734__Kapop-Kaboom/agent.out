{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"head -15 network.test.mjs; python3 - <<'PY'\np='test.py';s=open(p).read().replace('(?:simulation |browser |AI Hub |network )?checks','(?:simulation |browser |AI Hub |network |multiplayer integration )?checks');open(p,'w').write(s)\nPY\"","aggregated_output":"import fs from 'node:fs/promises';\nimport assert from 'node:assert/strict';\nconst source = await fs.readFile(new URL('./network.js', import.meta.url), 'utf8');\nconst { Network } = await import('data:text/javascript;base64,' + Buffer.from(source).toString('base64'));\nlet count = 0, failures = 0;\nasync function test(name, fn) { try { await fn(); count++; } catch (e) { failures++; console.error('FAIL ' + name + ': ' + e.message); } }\nfunction makeHub({ host = false, server = false } = {}) {\n  const handlers = {}, messages = [], results = [];\n  let clock = -Infinity;\n  const hub = {\n    active: true, me: server ? 4 : host ? 0 : 1, host: server ? 4 : 0,\n    isHost: host, server, players: [0,1,2,3].map(id => ({id,name:'Player '+id,color:'#fff'})),\n    connect: async options => { hub.options = options; return hub; },\n    ready: () => { hub.readyCount++; }, readyCount: 0,\n    on: (event, fn) => { handlers[event] = fn; return () => delete handlers[event]; },\n","exit_code":0,"status":"completed"}}
