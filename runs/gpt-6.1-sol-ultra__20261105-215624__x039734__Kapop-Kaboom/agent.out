{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='template.html';s=open(p).read().replace('#world{position:absolute;inset:0}', '#world{position:absolute;inset:0;touch-action:none}');open(p,'w').write(s)\np='browser-test.py';s=open(p).read();s=s.replace(\\\"  mobile.dispatch_event('#world','pointerdown',{'pointerType':'touch','pointerId':22,'clientX':100,'clientY':500})\\\\n  mobile.dispatch_event('#world','pointermove',{'pointerType':'touch','pointerId':22,'clientX':190,'clientY':500})\\\", \\\"  cdp=context.new_cdp_session(mobile)\\\\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':100,'y':500}]})\\\\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':190,'y':500}]})\\\")\ns=s.replace(\\\"  check(mobile.evaluate('window.__kapop.scene.inspect().viewHalfWidth')>=8.3\\\", \\\"  cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\\\\n  mobile.evaluate('__kapop.sim.intro=0;__kapop.sim.charge=1')\\\\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':110,'y':520},{'x':280,'y':520}]})\\\\n  cdp.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\\\\n  check(mobile.evaluate('__kapop.sim.stats.pops')>0,'native second-finger touch triggers splash')\\\\n  check(mobile.evaluate('window.__kapop.scene.inspect().viewHalfWidth')>=8.3\\\")\nopen(p,'w').write(s)\nPY\nnode build.mjs\nnpm test --silent\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
