omplete five-round playthrough wins');check(g.wave===WAVES.length&&g.score>20000,'full run completes all rounds and scores');check(g.stats.split>0&&g.stats.gold>0&&pops>0,'full run demonstrates gold, splits, and splash');check(g.lives>0&&g.stats.missed===0,'scripted full run survives using normal bucket rules');check(log.includes('victory')&&log.includes('clear'),'completion and clear events emitted');\ng.start(1,true);g.settings.autoCatch=false;g.settings.invincible=false;g.intro=0;g.spawn('normal',7,-.2);g.step();g.step();check(g.lives===3,'attract demo cannot lose buckets');\nObject.assign(g.settings,DEFAULTS);check(g.settings.fallSpeed===1&&g.settings.catchWidth===1.18&&\"'!g.settings.autoCatch,'\"'reset restores default balance');g.world.free();\nfor(const f of failures)console.log('FAIL: '+f);console.log(\"'`${checks} simulation checks, ${failures.length} failures`);if(failures.length)process.exitCode=1;\nEOF\nnode sim.test.mjs'","aggregated_output":"file:///home/micha/dev/cc-matrix/runs/gpt-6.1-sol-ultra__20261105-215624__x039734/work/Kapop-Kaboom-gpt-6.1-sol-ultra-20261105-215624/sim.test.mjs:1\nimport {GameSim,initPhysics,DEFAULTS,WAVES} from './sim.js';\n                            ^^^^^^^^\nSyntaxError: Named export 'DEFAULTS' not found. The requested module './sim.js' is a CommonJS module, which may not support all module.exports as named exports.\nCommonJS modules can always be imported via the default export, for example using:\n\nimport pkg from './sim.js';\nconst {GameSim,initPhysics,DEFAULTS,WAVES} = pkg;\n\n    at #asyncInstantiate (node:internal/modules/esm/module_job:455:21)\n    at async ModuleJob.run (node:internal/modules/esm/module_job:553:5)\n    at async node:internal/modules/esm/loader:647:26\n    at async asyncRunEntryPointWithESMLoader (node:internal/modules/run_main:101:5)\n\nNode.js v24.21.0\n","exit_code":1,"status":"failed"}}
