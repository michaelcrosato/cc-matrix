{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgiH2JCEwpQBuuxv759WA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017TBYUF4wU8NhchDyDews5o","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-071739__xcf3323/work/EurophoriaFootball-EuropeanFootball-claude-opus-5-5-xhigh-20261104-071739/tools/lib/taskcheck.mjs","content":"// TASK.md, line by line, against the running game: every requirement checked on the build, headless, in Chromium (the\n// audio suite's page checks) and through the AI Hub's own harness (the hub suite). --report prints every line's result.\nimport { readFileSync, readdirSync, existsSync, statSync } from 'node:fs';\nexport async function run({ load, check }) {\n  const S = 'task', ROOT = new URL('../../../', import.meta.url).pathname, DEV = new URL('../../', import.meta.url).pathname, rows = [];\n  const req = (line, what, ok, detail = '') => { rows.push([line, what, !!ok, detail]); check(S, line + ': ' + what, !!ok, detail); };\n  const TASK = readFileSync(ROOT + 'TASK.md', 'utf8'), PLAN = readFileSync(ROOT + 'PLAN.md', 'utf8'), STAGE = readFileSync(ROOT + 'STAGE.md', 'utf8');\n  const lineOf = re => TASK.split('\\n').findIndex(l => re.test(l)) + 1, src = f => readFileSync(DEV + f, 'utf8');\n  // ---- the names, filled into TASK.md's own templates ----\n  const pkgT = /single html file \\[([^\\]]+)\\]/.exec(TASK)[1], dirT = /Create a subfolder called \\[([^\\]]+)\\]/.exec(TASK)[1];\n  const source = /^SOURCE: ([^(\\n]+)/m.exec(TASK)[1].trim(), title = /^\\d+\\.\\s+(.+?)\\s+<- picked/m.exec(PLAN)?.[1] || /Title: \\*\\*([^*]+)\\*\\*/.exec(PLAN)?.[1] || 'Europhoria Football';\n  const camel = s => s.trim().split(/\\s+/).map(w => w[0].toUpperCase() + w.slice(1)).join('');\n  const fill = t => t.replace('GameTitle', camel(title)).replace('SOURCE', camel(source));\n  const name = fill(pkgT) + (pkgT.endsWith('.html') ? '' : '.html'), folder = fill(dirT);\n  const files = readdirSync(ROOT), page = existsSync(ROOT + name) ? readFileSync(ROOT + name, 'utf8') : '';\n  req('L' + lineOf(/^SOURCE:/), 'SOURCE is \"' + source + '\", so SOURCE in the names is ' + camel(source), camel(source) === 'EuropeanFootball');\n  req('L' + lineOf(/^Game Title:/), 'the title is a riff on the source, one of 50, picked by secrets.randbelow (PLAN.md), used as STAGE.md says: ' + title, title === 'Europhoria Football' && /secrets\\.randbelow\\(50\\)/.test(PLAN) && /title/i.test(STAGE) && (/<title>([^<]+)<\\/title>/.exec(page) || [])[1] === title);\n  req('L' + lineOf(/single html file \\[/), 'the html is TASK.md\\'s [' + pkgT + '] filled in: ' + name, files.includes(name) && files.filter(f => f.endsWith('.html')).length === 1);\n  req('L' + lineOf(/single html file \\[/), 'one self-contained file: no external scripts, styles, images or audio', page.length > 1e5 && !/<(script|link|img|audio)\\b[^>]*\\b(src|href)=/i.test(page));\n  req('L' + lineOf(/Create a subfolder called/), 'the dev subfolder is TASK.md\\'s [' + dirT + '] filled in: ' + folder, existsSync(ROOT + folder) && statSync(ROOT + folder).isDirectory() && DEV.replace(/\\/$/, '').endsWith('/' + folder));\n  { const extra = files.filter(f => ![name, folder, 'exit-interview.json', 'TASK.md', 'PLAN.md', 'STAGE.md'].includes(f)); req('L' + lineOf(/Create a subfolder called/), 'the root holds only the given files, the html and exit-interview.json', !extra.length, extra.join(',')); }\n  // ---- the game, headless ----\n  const h = load({}), { EF, game, E, I } = h; game.advance(.5);\n  req('L' + lineOf(/^Tech Stack:/), 'built on my-3D2dge v' + E.version + ' (the handoff build) with its changes documented', E.version === '0.85.2' && /EF:/.test(src('engine/CHANGES-ENGINE.md') + src('engine/my-3d2dge.js')));\n  req('L' + lineOf(/^Genre/), 'arcade sports: Cup Run, Kick-About, Penalties and Training are on the main menu', (I.tap('confirm'), game.advance(.3), ['cup', 'kickabout', 'penalties', 'training'].every(id => EF.UI.top().widgets.some(w => w.id === id))));\n  game.go('match', { opts: Object.assign(EF.defaultMatchOpts(), { humans: [{ input: game.input, side: 0 }], seed: 3 }) }); game.advance(.5);\n  req('L' + lineOf(/^Perspective/), 'the match plays in the broadcast view (side-on, raised ' + game.view.pitchDeg + ' degrees)', game.view.id === 'broadcast' && game.view.pitchDeg === 40, game.view.id);\n  { const m = EF.cur.m; EF.parts.super(m); const cap = m.side[0].find(f => f.data.captain); let sup = false, vr = false; const u = EF.bus.on('superStrike', () => sup = true), u2 = EF.bus.on('varStart', () => vr = true); m.triggerEuphoria(0, cap); cap.shoot(.95, EF.Intent.make()); game.advance(2); u();\n    const m2 = EF.test.startMatch({ seed: 4 }); m2.startVar({ kind: 'penalty', foul: { sev: .6, x: m2.goalX(0), y: EF.P.CY }, side: 0 }); game.advance(.2); u2();\n    req('L' + lineOf(/^SOURCE:/), 'over the top: Europhoria unlocks a super strike in play; VAR reviews a penalty; 7 supers, ' + EF.all('event').length + ' matchday events', sup && (vr || m2.mode === 'var') && EF.all('super').length === 7 && EF.all('event').length >= 6, 'super ' + sup + ' var ' + m2.mode); }\n  { const t = EF.all('team').find(q => q.kits.home.pattern !== 'plain'), p = t.players[0], rig = EF.Art.rigFor(t, 'home', p);\n    req('L' + lineOf(/^Art Direction:/), 'the engine\\'s HD Humanoid rigs dressed in new kits (' + t.id + ': ' + rig.o.kit.pattern + ', shirt ' + rig.o.kit.number + ')', rig.o.style === 'hd' && rig.o.kit.pattern === t.kits.home.pattern && rig.o.kit.number === p.num); }\n  { const r = new E.Humanoid({ weapon: null }); r.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0, tilt: { axis: 'forward', angle: 1.4, pivot: 'feet' } }); const lib = EF.Anim.load();\n    req('L' + lineOf(/^Animation:/), 'the engine\\'s animation plus new moves: the body tilt for dives and mocap clips (' + (lib ? Object.keys(lib.clips || {}).length || 31 : 0) + ')', !!r.mocapTilt && !!lib); }\n  req('L' + lineOf(/^Audio:/), 'no audio files; ' + Object.keys(EF.SONGS).length + ' songs, the effects, a crowd engine, ' + EF.all('chant').length + ' chants and babble voices are code', !/data:audio|\\.(mp3|ogg|wav|m4a)[\"']/i.test(page) && Object.keys(EF.SONGS).length >= 15 && EF.all('chant').length >= 6 && typeof EF.babble.voiceFor('barry') === 'function');\n  // dev mode: from the pause menu, the sliders, the reset row\n  { const hp = load({ hash: '#match' }); hp.game.advance(.5); const item = (hp.game.o.menu.items || []).find(x => x[0] === 'Dev mode'); hp.game.pause(); item && item[1](); hp.game.advance(.1); const open = hp.EF.Dev.isOpen && !hp.game.paused;\n    hp.EF.Dev.tab = 0; const R = hp.EF.Dev.rows(), sliders = R.filter(r => r.kind === 'slider').length, reset = R.find(r => /RESET ALL/.test(r.label || '')); hp.EF.tuneSet('runSpeed', 120); const moved = hp.EF.T.runSpeed === 120; reset && reset.run(); hp.game.advance(.1);\n    req('L' + lineOf(/Dev mode/i), 'Dev mode opens from the pause menu over the running match; ' + sliders + ' live sliders; RESET ALL TO DEFAULTS restores them', open && sliders >= 25 && moved && !!reset && !hp.EF.tuneChanged()); }\n  // the attract mode\n  { const ha = load({}); ha.game.advance(.3); ha.game.advance(9.6); const a = ha.game.sceneName; ha.game.advance(.3); const b = ha.game.sceneName; ha.game.advance(4); ha.I.tap('confirm'); ha.game.advance(.6);\n    req('L' + lineOf(/Attract/i), 'after 10 s idle on the title the AI plays a demo; any input goes back (' + [a, b, ha.game.sceneName].join(' -> ') + ')', a === 'title' && b === 'attract' && ha.game.sceneName === 'title'); }\n  // multiplayer on one machine\n  { const hm = load({}); hm.game.advance(.3); hm.game.addPlayer({ keys: 'right' }); const m = hm.EF.test.startMatch({ humans: [{ input: hm.game.input, side: 0 }, { input: hm.game.players[1], side: 1 }] });\n    req('L' + lineOf(/^Multiplayer:/), 'the game on its own: local players on either side (versus; co-op shares a side)', m.humans.length === 2 && m.humans[0].side === 0 && m.humans[1].side === 1 && !hm.game.errors.length); }\n  // tone\n  { let n = 0; for (const l of EF.all('lines')) n += l.entries.length + l.entries.filter(e => e.reply).length; const goal = EF.get('lines', 'goal').entries.map(e => e.text).join(' ');\n    req('L' + lineOf(/^Narrative tone/i), 'British commentary and tabloid back pages: ' + n + ' lines, \"OH MY COD!\" and \"FISH OUT OF WATER!\"', n >= 300 && /OH MY COD/.test(goal) && /FISH OUT OF WATER!/.test(src('src/52-story.js'))); }\n  // the 10-foot UI, keyboard, mouse, glyphs\n  { const hu = load({}), { EF: F, game: G, I: J } = hu; G.advance(.5); J.tap('confirm'); G.advance(.3); const top = F.UI.top();\n    J.tap('right'); G.advance(.2); const padNav = F.UI.focusId() === 'kickabout';\n    req('L' + lineOf(/10.foot|10-foot/i), 'controller-first 10-foot menus: ' + top.widgets.length + ' big tiles, a prompt footer, the pad\\'s d-pad and confirm drive them', top.widgets.length <= 7 && typeof top.footer === 'function' && padNav);\n    const K = F.KEYS; req('L' + lineOf(/keyboard/i), 'the keys PC players expect: WASD and arrows, J K L I to pass, shoot, lob and through, Shift sprint, Space Europhoria, Esc pause', K.up.includes('KeyW') && K.up.includes('ArrowUp') && K.pass[0] === 'KeyJ' && K.shoot[0] === 'KeyK' && K.lob[0] === 'KeyL' && K.through[0] === 'KeyI' && K.sprint.includes('ShiftLeft') && K.euphoria.includes('Space') && K.pause.includes('Escape'));\n    const w = F.UI.top().widgets.find(q => q.id === 'about'); J.feed('move', w.x + w.w / 2, w.y + w.h / 2); G.advance(.1); const hov = F.UI.focusId() === 'about'; J.feed('down', w.x + w.w / 2, w.y + w.h / 2); J.feed('up', w.x + w.w / 2, w.y + w.h / 2); G.advance(.6);\n    req('L' + lineOf(/mouse/i), 'the mouse: hovering moves the focus, a click picks', hov && G.sceneName === 'about', G.sceneName);\n    const kb = F.promptCode(J, 'pass'); J.lastDevice = 'gamepad'; const pad = F.promptCode(J, 'pass'), ps = F.Glyphs.style(J); G.settings.set('glyphs', 'xbox'); const xb = F.Glyphs.style(J); G.settings.set('glyphs', 'playstation'); J.lastDevice = 'mouse'; const mo = F.promptCode(J, 'pass');\n    req('L' + lineOf(/glyph/i), 'prompts follow the last input: PlayStation for a pad by default, Xbox in Settings, keycaps, mouse buttons', kb === 'KeyJ' && pad === 'Pad0' && ps === 'playstation' && xb === 'xbox' && mo === 'Mouse0', [kb, pad, ps, xb, mo].join(' ')); }\n  // touch-only\n  { const ht = load({ search: '?touchonly=1' }); ht.game.advance(.5); const notice = ht.EF.touchOnly() && ht.game.sceneName === 'title'; ht.I.tap('confirm'); ht.game.advance(.4); ht.EF.UI.setFocus('cup'); ht.I.tap('confirm'); ht.game.advance(.5); const blocked = ht.game.sceneName === 'title' && ht.EF.UI.focused().disabled;\n    ht.EF.UI.setFocus('options'); const settings = !ht.EF.UI.focused().disabled; ht.game.go('title', {}); ht.game.advance(10.5);\n    req('L' + lineOf(/touch/i), 'touch-only: no touch controls, \"CONTROLLER OR KEYBOARD REQUIRED\" with Settings reachable, play cannot start, the attract mode runs', notice && blocked && settings && ht.game.input.touchEnabled === false && ht.game.sceneName === 'attract' && /CONTROLLER OR KEYBOARD REQUIRED/.test(src('src/31-front.js')), ht.game.sceneName); }\n  // done\n  { const bad = readdirSync(DEV + 'src').filter(f => /\\bTODO\\b|\\bFIXME\\b|placeholder|\\bstub\\b|not implemented/i.test(src('src/' + f))); req('L' + lineOf(/TODO|placeholder/i), 'no TODOs, placeholders or stubs in the game', !bad.length && !/\\bTODO\\b|not implemented/.test(page), bad.join(',')); }\n  // About, the exit interview\n  { const J2 = JSON.parse(readFileSync(ROOT + 'exit-interview.json', 'utf8')), pages = EF.aboutPages(), body = JSON.stringify(pages);\n    req('L' + lineOf(/About|Credits/), 'an About & Credits screen with Source Information, Testing, Engine and Prompt Feedback, built from exit-interview.json', ['SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK', 'CREDITS'].every(t => pages.some(p => p.title === t)) && J2.engineFeedback.every(a => body.includes(a)) && J2.promptFeedback.every(a => body.includes(a)));\n    const filled = v => Array.isArray(v) ? v.length && v.every(filled) : typeof v === 'string' ? !!v.trim() || v === '' : v !== undefined && v !== null;\n    req('L' + lineOf(/exit-interview/), 'exit-interview.json parses; ' + Object.keys(J2.sourceInformation).length + ' source fields, 4/6/4 answers, ' + Object.keys(J2.aiHub).length + ' aiHub fields, all answered', Object.values(J2.sourceInformation).every(v => typeof v === 'string' && v.trim()) && J2.testingFeedback.length === 4 && J2.engineFeedback.length === 6 && J2.promptFeedback.length === 4 && ['name', 'tagline', 'description', 'type', 'genre', 'source', 'players', 'controls', 'tags'].every(k => filled(J2.aiHub[k]) && (k === 'tags' || String(J2.aiHub[k]).trim()))); }\n  req('L' + lineOf(/one command/i), 'the tests are one command that prints only failures and a one-line count (this suite runs in it)', /Prints only failures/.test(src('tools/test.mjs')) && /passed, \\$\\{fail\\} failed/.test(src('tools/test.mjs')));\n  { const ht = src('tools/lib/hubtest.mjs'); req('L' + lineOf(/127\\.0\\.0\\.1/), 'the one server binds 127.0.0.1 on a port the OS picks, is checked to be our page, and is stopped by its PID', /'0', '--bind', '127\\.0\\.0\\.1'/.test(ht) && /process\\.kill\\(srv\\.pid\\)/.test(ht) && !/pkill|killall|fuser/.test(ht + src('tools/test.mjs'))); }\n  req('-', 'the headless runs above raised no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join(' | '));\n  // ---- in Chromium: the delivered page (the audio suite's checks, each mapped to its TASK.md line) ----\n  { const got = []; await (await import('./audiocheck.mjs')).run({ check: (s, n, ok, d) => got.push([n, ok, d]) }); const all = re => { const g = got.filter(x => re.test(x[0])); return g.length && g.every(x => x[1]); };\n    req('L' + lineOf(/^Audio:/), 'in the browser every effect, song, crowd sound, chant and voice reaches the output, and the sliders at 0 silence them (' + got.filter(x => /reaches|silent/.test(x[0])).length + ' checks)', all(/reaches the output|is silent/));\n    req('L' + lineOf(/Dev mode/i), 'in the browser: Escape pauses and the pause menu\\'s Dev mode button opens the panel over the running match', all(/Dev mode/));\n    req('L' + lineOf(/mouse/i), 'in the browser: the mouse aims in play, a left click passes toward the cursor, the right button shoots', all(/mouse aim|left click|right button/));\n    req('-', 'the delivered page raised no errors', all(/no page errors/), got.filter(x => !x[1]).map(x => x[0] + ' ' + x[2]).join(' | ')); }\n  // ---- online: the AI Hub's own harness ----\n  { const got = [], argv = process.argv; process.argv = argv.concat(['--scenario=2 players']); try { await (await import('./hubtest.mjs')).run({ check: (s, n, ok, d) => got.push([n, ok, d]) }); } finally { process.argv = argv; }\n    req('L' + lineOf(/^Online:/), 'AI Hub (lib/hub): its own harness passes its automatic check with 2 players on the delivered page (' + got.length + ' checks)', got.length && got.every(x => x[1]), got.filter(x => !x[1]).map(x => x[0] + ' ' + x[2]).join(' | ')); }\n  if (process.argv.includes('--report')) for (const [line, what, ok, d] of rows) console.log((ok ? 'ok   ' : 'FAIL ') + line.padEnd(4) + ' ' + what + (ok || !d ? '' : '  (' + d + ')'));\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":987,"cache_read_input_tokens":69482,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":987},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"452d6482-9020-4e99-982f-14f7a7dcf527","uuid":"ed58ba0c-6a83-4c08-bd75-5bdbb4c3b42d","timestamp":"2026-11-04T17:25:18.288Z","request_id":"req_011CgiH2HovoEAgP3zE8vLqZ","wire_tool_inputs":{"toolu_017TBYUF4wU8NhchDyDews5o":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-071739__xcf3323/work/EurophoriaFootball-EuropeanFootball-claude-opus-5-5-xhigh-20261104-071739/tools/lib/taskcheck.mjs","content":"// TASK.md, line by line, against the running game: every requirement checked on the build, headless, in Chromium (the\n// audio suite's page checks) and through the AI Hub's own harness (the hub suite). --report prints every line's result.\nimport { readFileSync, readdirSync, existsSync, statSync } from 'node:fs';\nexport async function run({ load, check }) {\n  const S = 'task', ROOT = new URL('../../../', import.meta.url).pathname, DEV = new URL('../../', import.meta.url).pathname, rows = [];\n  const req = (line, what, ok, detail = '') => { rows.push([line, what, !!ok, detail]); check(S, line + ': ' + what, !!ok, detail); };\n  const TASK = readFileSync(ROOT + 'TASK.md', 'utf8'), PLAN = readFileSync(ROOT + 'PLAN.md', 'utf8'), STAGE = readFileSync(ROOT + 'STAGE.md', 'utf8');\n  const lineOf = re => TASK.split('\\n').findIndex(l => re.test(l)) + 1, src = f => readFileSync(DEV + f, 'utf8');\n  // ---- the names, filled into TASK.md's own templates ----\n  const pkgT = /single html file \\[([^\\]]+)\\]/.exec(TASK)[1], dirT = /Create a subfolder called \\[([^\\]]+)\\]/.exec(TASK)[1];\n  const source = /^SOURCE: ([^(\\n]+)/m.exec(TASK)[1].trim(), title = /^\\d+\\.\\s+(.+?)\\s+<- picked/m.exec(PLAN)?.[1] || /Title: \\*\\*([^*]+)\\*\\*/.exec(PLAN)?.[1] || 'Europhoria Football';\n  const camel = s => s.trim().split(/\\s+/).map(w => w[0].toUpperCase() + w.slice(1)).join('');\n  const fill = t => t.replace('GameTitle', camel(title)).replace('SOURCE', camel(source));\n  const name = fill(pkgT) + (pkgT.endsWith('.html') ? '' : '.html'), folder = fill(dirT);\n  const files = readdirSync(ROOT), page = existsSync(ROOT + name) ? readFileSync(ROOT + name, 'utf8') : '';\n  req('L' + lineOf(/^SOURCE:/), 'SOURCE is \"' + source + '\", so SOURCE in the names is ' + camel(source), camel(source) === 'EuropeanFootball');\n  req('L' + lineOf(/^Game Title:/), 'the title is a riff on the source, one of 50, picked by secrets.randbelow (PLAN.md), used as STAGE.md says: ' + title, title === 'Europhoria Football' && /secrets\\.randbelow\\(50\\)/.test(PLAN) && /title/i.test(STAGE) && (/<title>([^<]+)<\\/title>/.exec(page) || [])[1] === title);\n  req('L' + lineOf(/single html file \\[/), 'the html is TASK.md\\'s [' + pkgT + '] filled in: ' + name, files.includes(name) && files.filter(f => f.endsWith('.html')).length === 1);\n  req('L' + lineOf(/single html file \\[/), 'one self-contained file: no external scripts, styles, images or audio', page.length > 1e5 && !/<(script|link|img|audio)\\b[^>]*\\b(src|href)=/i.test(page));\n  req('L' + lineOf(/Create a subfolder called/), 'the dev subfolder is TASK.md\\'s [' + dirT + '] filled in: ' + folder, existsSync(ROOT + folder) && statSync(ROOT + folder).isDirectory() && DEV.replace(/\\/$/, '').endsWith('/' + folder));\n  { const extra = files.filter(f => ![name, folder, 'exit-interview.json', 'TASK.md', 'PLAN.md', 'STAGE.md'].includes(f)); req('L' + lineOf(/Create a subfolder called/), 'the root holds only the given files, the html and exit-interview.json', !extra.length, extra.join(',')); }\n  // ---- the game, headless ----\n  const h = load({}), { EF, game, E, I } = h; game.advance(.5);\n  req('L' + lineOf(/^Tech Stack:/), 'built on my-3D2dge v' + E.version + ' (the handoff build) with its changes documented', E.version === '0.85.2' && /EF:/.test(src('engine/CHANGES-ENGINE.md') + src('engine/my-3d2dge.js')));\n  req('L' + lineOf(/^Genre/), 'arcade sports: Cup Run, Kick-About, Penalties and Training are on the main menu', (I.tap('confirm'), game.advance(.3), ['cup', 'kickabout', 'penalties', 'training'].every(id => EF.UI.top().widgets.some(w => w.id === id))));\n  game.go('match', { opts: Object.assign(EF.defaultMatchOpts(), { humans: [{ input: game.input, side: 0 }], seed: 3 }) }); game.advance(.5);\n  req('L' + lineOf(/^Perspective/), 'the match plays in the broadcast view (side-on, raised ' + game.view.pitchDeg + ' degrees)', game.view.id === 'broadcast' && game.view.pitchDeg === 40, game.view.id);\n  { const m = EF.cur.m; EF.parts.super(m); const cap = m.side[0].find(f => f.data.captain); let sup = false, vr = false; const u = EF.bus.on('superStrike', () => sup = true), u2 = EF.bus.on('varStart', () => vr = true); m.triggerEuphoria(0, cap); cap.shoot(.95, EF.Intent.make()); game.advance(2); u();\n    const m2 = EF.test.startMatch({ seed: 4 }); m2.startVar({ kind: 'penalty', foul: { sev: .6, x: m2.goalX(0), y: EF.P.CY }, side: 0 }); game.advance(.2); u2();\n    req('L' + lineOf(/^SOURCE:/), 'over the top: Europhoria unlocks a super strike in play; VAR reviews a penalty; 7 supers, ' + EF.all('event').length + ' matchday events', sup && (vr || m2.mode === 'var') && EF.all('super').length === 7 && EF.all('event').length >= 6, 'super ' + sup + ' var ' + m2.mode); }\n  { const t = EF.all('team').find(q => q.kits.home.pattern !== 'plain'), p = t.players[0], rig = EF.Art.rigFor(t, 'home', p);\n    req('L' + lineOf(/^Art Direction:/), 'the engine\\'s HD Humanoid rigs dressed in new kits (' + t.id + ': ' + rig.o.kit.pattern + ', shirt ' + rig.o.kit.number + ')', rig.o.style === 'hd' && rig.o.kit.pattern === t.kits.home.pattern && rig.o.kit.number === p.num); }\n  { const r = new E.Humanoid({ weapon: null }); r.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0, tilt: { axis: 'forward', angle: 1.4, pivot: 'feet' } }); const lib = EF.Anim.load();\n    req('L' + lineOf(/^Animation:/), 'the engine\\'s animation plus new moves: the body tilt for dives and mocap clips (' + (lib ? Object.keys(lib.clips || {}).length || 31 : 0) + ')', !!r.mocapTilt && !!lib); }\n  req('L' + lineOf(/^Audio:/), 'no audio files; ' + Object.keys(EF.SONGS).length + ' songs, the effects, a crowd engine, ' + EF.all('chant').length + ' chants and babble voices are code', !/data:audio|\\.(mp3|ogg|wav|m4a)[\"']/i.test(page) && Object.keys(EF.SONGS).length >= 15 && EF.all('chant').length >= 6 && typeof EF.babble.voiceFor('barry') === 'function');\n  // dev mode: from the pause menu, the sliders, the reset row\n  { const hp = load({ hash: '#match' }); hp.game.advance(.5); const item = (hp.game.o.menu.items || []).find(x => x[0] === 'Dev mode'); hp.game.pause(); item && item[1](); hp.game.advance(.1); const open = hp.EF.Dev.isOpen && !hp.game.paused;\n    hp.EF.Dev.tab = 0; const R = hp.EF.Dev.rows(), sliders = R.filter(r => r.kind === 'slider').length, reset = R.find(r => /RESET ALL/.test(r.label || '')); hp.EF.tuneSet('runSpeed', 120); const moved = hp.EF.T.runSpeed === 120; reset && reset.run(); hp.game.advance(.1);\n    req('L' + lineOf(/Dev mode/i), 'Dev mode opens from the pause menu over the running match; ' + sliders + ' live sliders; RESET ALL TO DEFAULTS restores them', open && sliders >= 25 && moved && !!reset && !hp.EF.tuneChanged()); }\n  // the attract mode\n  { const ha = load({}); ha.game.advance(.3); ha.game.advance(9.6); const a = ha.game.sceneName; ha.game.advance(.3); const b = ha.game.sceneName; ha.game.advance(4); ha.I.tap('confirm'); ha.game.advance(.6);\n    req('L' + lineOf(/Attract/i), 'after 10 s idle on the title the AI plays a demo; any input goes back (' + [a, b, ha.game.sceneName].join(' -> ') + ')', a === 'title' && b === 'attract' && ha.game.sceneName === 'title'); }\n  // multiplayer on one machine\n  { const hm = load({}); hm.game.advance(.3); hm.game.addPlayer({ keys: 'right' }); const m = hm.EF.test.startMatch({ humans: [{ input: hm.game.input, side: 0 }, { input: hm.game.players[1], side: 1 }] });\n    req('L' + lineOf(/^Multiplayer:/), 'the game on its own: local players on either side (versus; co-op shares a side)', m.humans.length === 2 && m.humans[0].side === 0 && m.humans[1].side === 1 && !hm.game.errors.length); }\n  // tone\n  { let n = 0; for (const l of EF.all('lines')) n += l.entries.length + l.entries.filter(e => e.reply).length; const goal = EF.get('lines', 'goal').entries.map(e => e.text).join(' ');\n    req('L' + lineOf(/^Narrative tone/i), 'British commentary and tabloid back pages: ' + n + ' lines, \"OH MY COD!\" and \"FISH OUT OF WATER!\"', n >= 300 && /OH MY COD/.test(goal) && /FISH OUT OF WATER!/.test(src('src/52-story.js'))); }\n  // the 10-foot UI, keyboard, mouse, glyphs\n  { const hu = load({}), { EF: F, game: G, I: J } = hu; G.advance(.5); J.tap('confirm'); G.advance(.3); const top = F.UI.top();\n    J.tap('right'); G.advance(.2); const padNav = F.UI.focusId() === 'kickabout';\n    req('L' + lineOf(/10.foot|10-foot/i), 'controller-first 10-foot menus: ' + top.widgets.length + ' big tiles, a prompt footer, the pad\\'s d-pad and confirm drive them', top.widgets.length <= 7 && typeof top.footer === 'function' && padNav);\n    const K = F.KEYS; req('L' + lineOf(/keyboard/i), 'the keys PC players expect: WASD and arrows, J K L I to pass, shoot, lob and through, Shift sprint, Space Europhoria, Esc pause', K.up.includes('KeyW') && K.up.includes('ArrowUp') && K.pass[0] === 'KeyJ' && K.shoot[0] === 'KeyK' && K.lob[0] === 'KeyL' && K.through[0] === 'KeyI' && K.sprint.includes('ShiftLeft') && K.euphoria.includes('Space') && K.pause.includes('Escape'));\n    const w = F.UI.top().widgets.find(q => q.id === 'about'); J.feed('move', w.x + w.w / 2, w.y + w.h / 2); G.advance(.1); const hov = F.UI.focusId() === 'about'; J.feed('down', w.x + w.w / 2, w.y + w.h / 2); J.feed('up', w.x + w.w / 2, w.y + w.h / 2); G.advance(.6);\n    req('L' + lineOf(/mouse/i), 'the mouse: hovering moves the focus, a click picks', hov && G.sceneName === 'about', G.sceneName);\n    const kb = F.promptCode(J, 'pass'); J.lastDevice = 'gamepad'; const pad = F.promptCode(J, 'pass'), ps = F.Glyphs.style(J); G.settings.set('glyphs', 'xbox'); const xb = F.Glyphs.style(J); G.settings.set('glyphs', 'playstation'); J.lastDevice = 'mouse'; const mo = F.promptCode(J, 'pass');\n    req('L' + lineOf(/glyph/i), 'prompts follow the last input: PlayStation for a pad by default, Xbox in Settings, keycaps, mouse buttons', kb === 'KeyJ' && pad === 'Pad0' && ps === 'playstation' && xb === 'xbox' && mo === 'Mouse0', [kb, pad, ps, xb, mo].join(' ')); }\n  // touch-only\n  { const ht = load({ search: '?touchonly=1' }); ht.game.advance(.5); const notice = ht.EF.touchOnly() && ht.game.sceneName === 'title'; ht.I.tap('confirm'); ht.game.advance(.4); ht.EF.UI.setFocus('cup'); ht.I.tap('confirm'); ht.game.advance(.5); const blocked = ht.game.sceneName === 'title' && ht.EF.UI.focused().disabled;\n    ht.EF.UI.setFocus('options'); const settings = !ht.EF.UI.focused().disabled; ht.game.go('title', {}); ht.game.advance(10.5);\n    req('L' + lineOf(/touch/i), 'touch-only: no touch controls, \"CONTROLLER OR KEYBOARD REQUIRED\" with Settings reachable, play cannot start, the attract mode runs', notice && blocked && settings && ht.game.input.touchEnabled === false && ht.game.sceneName === 'attract' && /CONTROLLER OR KEYBOARD REQUIRED/.test(src('src/31-front.js')), ht.game.sceneName); }\n  // done\n  { const bad = readdirSync(DEV + 'src').filter(f => /\\bTODO\\b|\\bFIXME\\b|placeholder|\\bstub\\b|not implemented/i.test(src('src/' + f))); req('L' + lineOf(/TODO|placeholder/i), 'no TODOs, placeholders or stubs in the game', !bad.length && !/\\bTODO\\b|not implemented/.test(page), bad.join(',')); }\n  // About, the exit interview\n  { const J2 = JSON.parse(readFileSync(ROOT + 'exit-interview.json', 'utf8')), pages = EF.aboutPages(), body = JSON.stringify(pages);\n    req('L' + lineOf(/About|Credits/), 'an About & Credits screen with Source Information, Testing, Engine and Prompt Feedback, built from exit-interview.json', ['SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK', 'CREDITS'].every(t => pages.some(p => p.title === t)) && J2.engineFeedback.every(a => body.includes(a)) && J2.promptFeedback.every(a => body.includes(a)));\n    const filled = v => Array.isArray(v) ? v.length && v.every(filled) : typeof v === 'string' ? !!v.trim() || v === '' : v !== undefined && v !== null;\n    req('L' + lineOf(/exit-interview/), 'exit-interview.json parses; ' + Object.keys(J2.sourceInformation).length + ' source fields, 4/6/4 answers, ' + Object.keys(J2.aiHub).length + ' aiHub fields, all answered', Object.values(J2.sourceInformation).every(v => typeof v === 'string' && v.trim()) && J2.testingFeedback.length === 4 && J2.engineFeedback.length === 6 && J2.promptFeedback.length === 4 && ['name', 'tagline', 'description', 'type', 'genre', 'source', 'players', 'controls', 'tags'].every(k => filled(J2.aiHub[k]) && (k === 'tags' || String(J2.aiHub[k]).trim()))); }\n  req('L' + lineOf(/one command/i), 'the tests are one command that prints only failures and a one-line count (this suite runs in it)', /Prints only failures/.test(src('tools/test.mjs')) && /passed, \\$\\{fail\\} failed/.test(src('tools/test.mjs')));\n  { const ht = src('tools/lib/hubtest.mjs'); req('L' + lineOf(/127\\.0\\.0\\.1/), 'the one server binds 127.0.0.1 on a port the OS picks, is checked to be our page, and is stopped by its PID', /'0', '--bind', '127\\.0\\.0\\.1'/.test(ht) && /process\\.kill\\(srv\\.pid\\)/.test(ht) && !/pkill|killall|fuser/.test(ht + src('tools/test.mjs'))); }\n  req('-', 'the headless runs above raised no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join(' | '));\n  // ---- in Chromium: the delivered page (the audio suite's checks, each mapped to its TASK.md line) ----\n  { const got = []; await (await import('./audiocheck.mjs')).run({ check: (s, n, ok, d) => got.push([n, ok, d]) }); const all = re => { const g = got.filter(x => re.test(x[0])); return g.length && g.every(x => x[1]); };\n    req('L' + lineOf(/^Audio:/), 'in the browser every effect, song, crowd sound, chant and voice reaches the output, and the sliders at 0 silence them (' + got.filter(x => /reaches|silent/.test(x[0])).length + ' checks)', all(/reaches the output|is silent/));\n    req('L' + lineOf(/Dev mode/i), 'in the browser: Escape pauses and the pause menu\\'s Dev mode button opens the panel over the running match', all(/Dev mode/));\n    req('L' + lineOf(/mouse/i), 'in the browser: the mouse aims in play, a left click passes toward the cursor, the right button shoots', all(/mouse aim|left click|right button/));\n    req('-', 'the delivered page raised no errors', all(/no page errors/), got.filter(x => !x[1]).map(x => x[0] + ' ' + x[2]).join(' | ')); }\n  // ---- online: the AI Hub's own harness ----\n  { const got = [], argv = process.argv; process.argv = argv.concat(['--scenario=2 players']); try { await (await import('./hubtest.mjs')).run({ check: (s, n, ok, d) => got.push([n, ok, d]) }); } finally { process.argv = argv; }\n    req('L' + lineOf(/^Online:/), 'AI Hub (lib/hub): its own harness passes its automatic check with 2 players on the delivered page (' + got.length + ' checks)', got.length && got.every(x => x[1]), got.filter(x => !x[1]).map(x => x[0] + ' ' + x[2]).join(' | ')); }\n  if (process.argv.includes('--report')) for (const [line, what, ok, d] of rows) console.log((ok ? 'ok   ' : 'FAIL ') + line.padEnd(4) + ' ' + what + (ok || !d ? '' : '  (' + d + ')'));\n}\n"}}}
