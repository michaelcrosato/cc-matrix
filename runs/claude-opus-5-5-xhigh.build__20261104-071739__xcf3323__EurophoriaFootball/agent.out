{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgiGmSgZ6bChuQiRykKqB","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"The plan uses the same substitution convention as before, so I'm writing the `task` suite now: one check per TASK.md requirement, run against the live game headless and in Chromium.\n\n","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3129,"cache_read_input_tokens":953676,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3129},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"452d6482-9020-4e99-982f-14f7a7dcf527","uuid":"cc14ed92-b512-4cd4-8a0a-4219f25e5d5c","timestamp":"2026-11-04T17:21:08.004Z","request_id":"req_011CgiGmSJFHLNuHfY6vfb96","narration_block_indexes":[0],"thinking_duration_ms":1,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgiGmSgZ6bChuQiRykKqB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BQ2BoqXt5MK1RspTaoFyga","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-071739__xcf3323/work/EurophoriaFootball-EuropeanFootball-claude-opus-5-5-xhigh-20261104-071739/tools/lib/taskcheck.mjs","content":"// TASK.md, line by line, against the running game: each requirement checked on the build (headless, in Chromium, and\n// through the AI Hub harness). With --report every requirement prints its result.\nimport { readFileSync, readdirSync, existsSync, statSync } from 'node:fs';\nimport { chromium } from 'playwright';\nexport async function run({ load, check }) {\n  const S = 'task', ROOT = new URL('../../../', import.meta.url).pathname, DEV = new URL('../../', import.meta.url).pathname, rows = [];\n  const req = (id, what, ok, detail = '') => { rows.push([id, what, !!ok, detail]); check(S, id + ' ' + what, ok, detail); };\n  const TASK = readFileSync(ROOT + 'TASK.md', 'utf8');\n  // ---- the names, from TASK.md's own templates ----\n  const pkg = /single html file \\[([^\\]]+)\\]/.exec(TASK)[1], folderT = /Create a subfolder called \\[([^\\]]+)\\]/.exec(TASK)[1];\n  const files = readdirSync(ROOT), html = files.find(f => f.endsWith('.html'));\n  const page = html ? readFileSync(ROOT + html, 'utf8') : '';\n  const title = (/<title>([^<]+)<\\/title>/.exec(page) || [])[1] || '';\n  const source = /^SOURCE: ([^(\\n]+)/m.exec(TASK)[1].trim();\n  const camel = s => s.split(/\\s+/).map(w => w[0].toUpperCase() + w.slice(1)).join('');\n  const name = pkg.replace('GameTitle', camel(title)).replace('SOURCE', camel(source)), folder = folderT.replace('GameTitle', camel(title)).replace('SOURCE', camel(source));\n  req('Package', 'the single html file is TASK.md\\'s [GameTitle-SOURCE-...].html with GameTitle = \"' + title + '\" and SOURCE = \"' + source + '\": ' + name, existsSync(ROOT + name) && html === name, html);\n  req('Working environment', 'the dev subfolder is TASK.md\\'s [GameTitle-SOURCE-...]: ' + folder, existsSync(ROOT + folder) && statSync(ROOT + folder).isDirectory() && DEV.replace(/\\/$/, '').endsWith(folder));\n  const extra = files.filter(f => ![name, folder, 'exit-interview.json', 'TASK.md', 'PLAN.md', 'STAGE.md'].includes(f));\n  req('Working environment', 'the root holds only the given files, the html and exit-interview.json; every dev file is in the subfolder', !extra.length, extra.join(','));\n  req('Package', 'one file with everything inlined: no external scripts, styles or images', !/<(script|link|img)[^>]+(src|href)=/i.test(page) && /<script>/.test(page));\n  req('Game Title', 'a riff on the source (Euro + euphoria), 50 brainstormed and picked by secrets.randbelow per PLAN.md, as STAGE.md says to use', title === 'Europhoria Football' && /secrets\\.randbelow\\(50\\)/.test(readFileSync(ROOT + 'PLAN.md', 'utf8')) && /using the title it gives/.test(readFileSync(ROOT + 'STAGE.md', 'utf8')));\n  // ---- the game, headless ----\n  const h = load({}); const { EF, game, E, I } = h; game.advance(.5);\n  req('Tech Stack', 'built on my-3D2dge (the handoff engine v0.85.2) with its changes documented', E.version === '0.85.2' && existsSync(DEV + 'engine/CHANGES-ENGINE.md'), E.version);\n  req('SOURCE', 'over-the-top European football: a match with Europhoria, a super strike, VAR, dives and a parked bus', ['super', 'event', 'beat', 'drill', 'chant'].every(k => EF.all(k).length) && EF.all('super').length === 7 && typeof EF.Match.prototype.startVar === 'function' && typeof EF.Footballer.prototype.theatrics === 'function');\n  game.go('match', { opts: Object.assign(EF.defaultMatchOpts(), { humans: [{ input: game.input, side: 0 }], seed: 3 }) }); game.advance(.5);\n  req('Perspective', 'the match uses the broadcast view (side-on, raised 40 degrees)', game.view.id === 'broadcast' && E.VIEWS.broadcast.pitchDeg === 40, game.view.id);\n  { const m = EF.cur.m; EF.parts.super(m); let sup = false; const u = EF.bus.on('superStrike', () => sup = true); m.script = f => f === m.side[0].find(q => q.data.captain) && m.owner === f ? Object.assign(EF.Intent.make(), { shoot: { down: true, pressed: false, released: false }, power: .97 }) : null; game.advance(3); u(); req('SOURCE', 'in play: Europhoria unlocks a super strike', sup); }\n  { const rig = EF.Art.rigFor(EF.get('team', 'kipperton'), 'home', EF.get('team', 'kipperton').players[4]); req('Art Direction', 'the engine\\'s HD Humanoid rigs, dressed in new football kits (hoops) with shirt numbers', rig.o.kit && rig.o.kit.pattern === 'hoops' && rig.o.kit.number === 9 && rig.o.style === 'hd'); }\n  { const r2 = new E.Humanoid({ weapon: null }); r2.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0 }); const z0 = r2.J.head[2]; r2.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0, tilt: { axis: 'forward', angle: 1.5, pivot: 'feet' } }); req('Animation', 'the engine\\'s rig animation plus new moves (a body tilt for dives; mocap clips for slides and celebrations)', r2.J.head[2] < z0 - 5 && EF.Anim.lib && EF.Anim.lib.clip('Slide_Loop') && EF.Anim.lib.clip('Backflip'), z0 + ' -> ' + r2.J.head[2]); }\n  req('Audio', 'no audio files; music, effects and voices written in code (16 songs, a crowd engine, chants, babble voices)', !/\\.(mp3|ogg|wav|m4a)\\b|data:audio/i.test(page) && Object.keys(EF.SONGS).length >= 15 && typeof EF.babble.voiceFor('barry') === 'function' && EF.all('chant').length >= 6);\n  // dev mode from the pause menu, sliders and a reset\n  { const item = (game.o.menu.items || []).find(x => x[0] === 'Dev mode'); game.pause(); item && item[1](); game.advance(.1); const open = EF.Dev.isOpen && !game.paused; EF.Dev.tab = 0; const sliders = EF.Dev.rows().filter(r => r.kind === 'slider').length; EF.tuneSet('runSpeed', 120); const changed = EF.T.runSpeed === 120; EF.Dev.rows()[0].run(); EF.Dev.close();\n    req('Dev mode', 'reached from the pause menu, with live sliders for the gameplay variables (' + sliders + ') and a reset to defaults', open && sliders >= 25 && changed && EF.T.runSpeed === EF.TDEF.runSpeed && !EF.tuneChanged()); }\n  // the attract mode\n  { const h2 = load({}); h2.game.advance(.3); h2.game.advance(9.6); const at99 = h2.game.sceneName; h2.game.advance(.3); const on = h2.game.sceneName; h2.game.advance(5); h2.I.tap('confirm'); h2.game.advance(.5);\n    req('Attract Mode', 'after 10 s without input on the title an AI-played demo starts, and any input exits it', at99 === 'title' && on === 'attract' && h2.game.sceneName === 'title', at99 + ' ' + on + ' ' + h2.game.sceneName); }\n  // multiplayer on one machine\n  { const h3 = load({}); h3.game.advance(.3); const p2 = h3.game.addPlayer({ keys: 'right' }); h3.EF.test.startMatch({ humans: [{ input: h3.game.input, side: 0 }, { input: p2, side: 1 }] }); const m = h3.EF.cur.m; req('Multiplayer', 'the game on its own: local players on either side (versus) or together (co-op)', m.humans.length === 2 && m.humans[0].fb && m.humans[1].fb && m.humans[1].side === 1); }\n  // tone\n  { let n = 0; for (const l of EF.all('lines')) n += l.entries.length; const g = EF.get('lines', 'goal').entries.map(e => e.text).join(' '); req('Narrative tone', 'British football commentary and tabloid back pages (' + n + ' commentary lines, puns and deadpan replies)', n >= 300 && /OH MY COD/.test(g) && EF.get('beat', 'prologue').steps[0].headline === 'FISH OUT OF WATER!'); }\n  // the 10-foot UI: few choices, big type, footers with prompts; keyboard keys, mouse, glyphs by device\n  { const h4 = load({}); const { EF: F, game: G, I: J } = h4; G.advance(.3); J.tap('confirm'); G.advance(.3); const scr = F.UI.top();\n    req('UI & UX', '10-foot screens: at most 7 choices in view, a prompt footer, menus driven by the pad\\'s d-pad and confirm', scr.widgets.length <= 8 && !!scr.footer && (J.tap('right'), G.advance(.2), F.UI.focusId() === 'kickabout'));\n    const K = F.KEYS; req('UI & UX', 'keyboard keys PC players expect: WASD and arrows move, J/K/L/I pass, shoot, lob, through; Shift sprints; E skill; Q switch; Space Europhoria; Esc pauses', K.up.includes('KeyW') && K.up.includes('ArrowUp') && K.pass[0] === 'KeyJ' && K.shoot[0] === 'KeyK' && K.sprint.includes('ShiftLeft') && K.euphoria.includes('Space') && K.pause.includes('Escape'));\n    const w = F.UI.top().widgets.find(q => q.id === 'about'); J.feed('move', w.x + w.w / 2, w.y + w.h / 2); G.advance(.1); const hov = F.UI.focusId() === 'about'; J.feed('down', w.x + w.w / 2, w.y + w.h / 2); J.feed('up', w.x + w.w / 2, w.y + w.h / 2); G.advance(.5);\n    req('UI & UX', 'the mouse: hover moves the focus and a click picks a menu item', hov && G.sceneName === 'about', G.sceneName);\n    const kb = F.promptCode(J, 'pass'); J.lastDevice = 'gamepad'; const pad = F.promptCode(J, 'pass'), ps = F.Glyphs.style(J); G.settings.set('glyphs', 'xbox'); const xb = F.Glyphs.style(J); G.settings.set('glyphs', 'playstation'); J.lastDevice = 'mouse'; const mo = F.promptCode(J, 'pass');\n    req('UI & UX', 'prompts follow the last input: PlayStation glyphs for a pad (Xbox in Settings), keys for the keyboard, mouse buttons for the mouse', kb === 'KeyJ' && pad === 'Pad0' && ps === 'playstation' && xb === 'xbox' && mo === 'Mouse0' && G.settings.spec('glyphs').group === 'Controller'); }\n  // touch-only\n  { const h5 = load({ search: '?touchonly=1' }); h5.game.advance(.3); const T = h5.EF.touchOnly() && h5.game.sceneName === 'title' && h5.EF.scenes.title.state === 'press'; h5.I.tap('confirm'); h5.game.advance(.3); h5.EF.UI.setFocus('cup'); const dis = h5.EF.UI.focused().disabled; const noTouch = h5.game.input.touchEnabled === false && Object.values(h5.EF.scenes).every(sc => !sc.touch || sc.touch.length === 0);\n    h5.game.go('title', {}); h5.game.advance(10.5); req('Touch-only', 'no touch controls; \"Controller or keyboard required\" with a settings button; play cannot start; the attract mode runs', T && dis && noTouch && h5.game.sceneName === 'attract' && /CONTROLLER OR KEYBOARD REQUIRED/.test(readFileSync(DEV + 'src/31-front.js', 'utf8')), h5.game.sceneName); }\n  // done: no TODOs, placeholders or stubs\n  { const bad = []; for (const f of readdirSync(DEV + 'src')) { const s = readFileSync(DEV + 'src/' + f, 'utf8'); if (/\\bTODO\\b|\\bFIXME\\b|placeholder|\\bstub\\b|not implemented/i.test(s)) bad.push(f); } req('Done', 'no TODOs, placeholders or stubs in the game\\'s source', !bad.length, bad.join(',')); }\n  // About / Credits with the four sections; the exit interview\n  { const pages = EF.aboutPages().map(p => p.title); const J2 = JSON.parse(readFileSync(ROOT + 'exit-interview.json', 'utf8')); const si = J2.sourceInformation;\n    req('Source Information', 'an in-game About/Credits screen with Source Information, Testing, Engine and Prompt Feedback and credits', ['SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK', 'CREDITS'].every(t => pages.includes(t)));\n    req('Exit interview', 'exit-interview.json parses and answers every field', Object.keys(si).length === 15 && Object.values(si).every(v => typeof v === 'string' && v.trim()) && J2.testingFeedback.length === 4 && J2.engineFeedback.length === 6 && J2.promptFeedback.length === 4 && Object.values(J2.aiHub).every(v => v !== undefined)); }\n  req('Testing', 'one command prints only failures and a one-line count (this suite runs inside it)', /prints only failures|only failures/.test(readFileSync(DEV + 'tools/test.mjs', 'utf8')));\n  req('Working environment', 'a server only on 127.0.0.1 and a port the OS picks, the page checked to be ours, stopped by its PID', /'0', '--bind', '127\\.0\\.0\\.1'/.test(readFileSync(DEV + 'tools/lib/hubtest.mjs', 'utf8')) && /process\\.kill\\(srv\\.pid\\)/.test(readFileSync(DEV + 'tools/lib/hubtest.mjs', 'utf8')) && !/pkill|killall|fuser/.test(readFileSync(DEV + 'tools/lib/hubtest.mjs', 'utf8')));\n  req('No errors', 'the headless runs above raised no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join(' | '));\n  // ---- in Chromium: the real page ----\n  const b = await chromium.launch({ args: ['--autoplay-policy=no-user-gesture-required'] }), p = await b.newPage({ viewport: { width: 1280, height: 720 } }); const errs = []; p.on('pageerror', e => errs.push(String(e)));\n  await p.goto('file://' + ROOT + name + '#match'); await p.waitForTimeout(2500); await p.mouse.click(5, 5);\n  const audio = await p.evaluate(async () => { const A = My3D2dge.current.audio; A._init(); if (A.ctx.state !== 'running') await A.ctx.resume(); const an = A.ctx.createAnalyser(); A._master.connect(an); const buf = new Float32Array(2048); const peak = async ms => { let pk = 0; const end = performance.now() + ms; while (performance.now() < end) { an.getFloatTimeDomainData(buf); for (const v of buf) pk = Math.max(pk, Math.abs(v)); await new Promise(r => setTimeout(r, 15)); } return pk; }; EF.music(null); EF.crowdAudio.stop(); EF.mutedCrowd = true; await new Promise(r => setTimeout(r, 600)); EF.sfx('whistleLong'); const s1 = await peak(500); await new Promise(r => setTimeout(r, 600)); const v = EF.babble.voiceFor('barry'), line = 'What a goal!'; for (let i = 0; i < line.length; i++) setTimeout(() => v(line[i], i, line), i * 30); const s2 = await peak(600); EF.mutedCrowd = false; return [s1, s2]; });\n  req('Audio', 'in the browser the synthesised sound and the babble voices reach the output (peaks ' + audio.map(x => x.toFixed(2)).join(', ') + ')', audio[0] > .01 && audio[1] > .01);\n  await p.keyboard.press('Escape'); await p.waitForTimeout(500); const dev = p.getByText('Dev mode', { exact: true }); const nd = await dev.count(); if (nd) { await dev.first().click(); await p.waitForTimeout(400); }\n  const devOpen = await p.evaluate(() => EF.Dev.isOpen && !My3D2dge.current.paused);\n  req('Dev mode', 'in the browser: Escape opens the pause menu, and its Dev mode button opens the panel over the running match', nd > 0 && devOpen);\n  await p.evaluate(() => { EF.Dev.close(); EF.test.giveBall(0, 4, EF.P.CX - 60, EF.P.CY); EF.cur.m.cheats.freezeClock = true; window.__p = 0; EF.bus.on('pass', () => window.__p++); });\n  await p.mouse.move(700, 360); await p.waitForTimeout(80); await p.mouse.move(980, 380); await p.waitForTimeout(250); await p.mouse.down(); await p.waitForTimeout(60); await p.mouse.up(); await p.waitForTimeout(300);\n  const mouse = await p.evaluate(() => ({ aim: EF.cur.m.humans[0].ctl.mouse, passes: window.__p }));\n  req('UI & UX', 'in the browser: the mouse aims in play (a reticle on the pitch) and a click passes toward it', mouse.aim && mouse.passes > 0, JSON.stringify(mouse));\n  const tp = await b.newPage({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 3, isMobile: true, hasTouch: true }); await tp.goto('file://' + ROOT + name + '#touchonly'); await tp.waitForTimeout(2500);\n  const tstate = await tp.evaluate(() => ({ only: EF.touchOnly(), scene: My3D2dge.current.sceneName, touch: My3D2dge.current.input.touchEnabled }));\n  req('Touch-only', 'in the browser on a phone: the title shows the notice, with no touch controls', tstate.only && tstate.scene === 'title' && tstate.touch === false, JSON.stringify(tstate));\n  req('No errors', 'the browser pages raised no errors', !errs.length, errs.join(' | '));\n  await b.close();\n  // ---- online: the AI Hub harness ----\n  const before = rows.length; let hubOk = true; const argv = process.argv; process.argv = argv.concat(['--scenario=2']);\n  await (await import('./hubtest.mjs')).run({ check: (s, n, ok, d) => { if (!ok) hubOk = false; } });\n  process.argv = argv; void before;\n  req('Online', 'AI Hub (lib/hub): the hub\\'s own harness passes its automatic check (2 players), and outside a session the game reaches its title', hubOk);\n  if (process.argv.includes('--report')) for (const [id, what, ok, d] of rows) console.log((ok ? 'ok   ' : 'FAIL ') + id + ': ' + what + (ok || !d ? '' : '  (' + d + ')'));\n}\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3129,"cache_read_input_tokens":953676,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3129},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"452d6482-9020-4e99-982f-14f7a7dcf527","uuid":"4aa080c1-c373-47fc-abc2-897927eea4f7","timestamp":"2026-11-04T17:22:02.472Z","request_id":"req_011CgiGmSJFHLNuHfY6vfb96","wire_tool_inputs":{"toolu_01BQ2BoqXt5MK1RspTaoFyga":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-071739__xcf3323/work/EurophoriaFootball-EuropeanFootball-claude-opus-5-5-xhigh-20261104-071739/tools/lib/taskcheck.mjs","content":"// TASK.md, line by line, against the running game: each requirement checked on the build (headless, in Chromium, and\n// through the AI Hub harness). With --report every requirement prints its result.\nimport { readFileSync, readdirSync, existsSync, statSync } from 'node:fs';\nimport { chromium } from 'playwright';\nexport async function run({ load, check }) {\n  const S = 'task', ROOT = new URL('../../../', import.meta.url).pathname, DEV = new URL('../../', import.meta.url).pathname, rows = [];\n  const req = (id, what, ok, detail = '') => { rows.push([id, what, !!ok, detail]); check(S, id + ' ' + what, ok, detail); };\n  const TASK = readFileSync(ROOT + 'TASK.md', 'utf8');\n  // ---- the names, from TASK.md's own templates ----\n  const pkg = /single html file \\[([^\\]]+)\\]/.exec(TASK)[1], folderT = /Create a subfolder called \\[([^\\]]+)\\]/.exec(TASK)[1];\n  const files = readdirSync(ROOT), html = files.find(f => f.endsWith('.html'));\n  const page = html ? readFileSync(ROOT + html, 'utf8') : '';\n  const title = (/<title>([^<]+)<\\/title>/.exec(page) || [])[1] || '';\n  const source = /^SOURCE: ([^(\\n]+)/m.exec(TASK)[1].trim();\n  const camel = s => s.split(/\\s+/).map(w => w[0].toUpperCase() + w.slice(1)).join('');\n  const name = pkg.replace('GameTitle', camel(title)).replace('SOURCE', camel(source)), folder = folderT.replace('GameTitle', camel(title)).replace('SOURCE', camel(source));\n  req('Package', 'the single html file is TASK.md\\'s [GameTitle-SOURCE-...].html with GameTitle = \"' + title + '\" and SOURCE = \"' + source + '\": ' + name, existsSync(ROOT + name) && html === name, html);\n  req('Working environment', 'the dev subfolder is TASK.md\\'s [GameTitle-SOURCE-...]: ' + folder, existsSync(ROOT + folder) && statSync(ROOT + folder).isDirectory() && DEV.replace(/\\/$/, '').endsWith(folder));\n  const extra = files.filter(f => ![name, folder, 'exit-interview.json', 'TASK.md', 'PLAN.md', 'STAGE.md'].includes(f));\n  req('Working environment', 'the root holds only the given files, the html and exit-interview.json; every dev file is in the subfolder', !extra.length, extra.join(','));\n  req('Package', 'one file with everything inlined: no external scripts, styles or images', !/<(script|link|img)[^>]+(src|href)=/i.test(page) && /<script>/.test(page));\n  req('Game Title', 'a riff on the source (Euro + euphoria), 50 brainstormed and picked by secrets.randbelow per PLAN.md, as STAGE.md says to use', title === 'Europhoria Football' && /secrets\\.randbelow\\(50\\)/.test(readFileSync(ROOT + 'PLAN.md', 'utf8')) && /using the title it gives/.test(readFileSync(ROOT + 'STAGE.md', 'utf8')));\n  // ---- the game, headless ----\n  const h = load({}); const { EF, game, E, I } = h; game.advance(.5);\n  req('Tech Stack', 'built on my-3D2dge (the handoff engine v0.85.2) with its changes documented', E.version === '0.85.2' && existsSync(DEV + 'engine/CHANGES-ENGINE.md'), E.version);\n  req('SOURCE', 'over-the-top European football: a match with Europhoria, a super strike, VAR, dives and a parked bus', ['super', 'event', 'beat', 'drill', 'chant'].every(k => EF.all(k).length) && EF.all('super').length === 7 && typeof EF.Match.prototype.startVar === 'function' && typeof EF.Footballer.prototype.theatrics === 'function');\n  game.go('match', { opts: Object.assign(EF.defaultMatchOpts(), { humans: [{ input: game.input, side: 0 }], seed: 3 }) }); game.advance(.5);\n  req('Perspective', 'the match uses the broadcast view (side-on, raised 40 degrees)', game.view.id === 'broadcast' && E.VIEWS.broadcast.pitchDeg === 40, game.view.id);\n  { const m = EF.cur.m; EF.parts.super(m); let sup = false; const u = EF.bus.on('superStrike', () => sup = true); m.script = f => f === m.side[0].find(q => q.data.captain) && m.owner === f ? Object.assign(EF.Intent.make(), { shoot: { down: true, pressed: false, released: false }, power: .97 }) : null; game.advance(3); u(); req('SOURCE', 'in play: Europhoria unlocks a super strike', sup); }\n  { const rig = EF.Art.rigFor(EF.get('team', 'kipperton'), 'home', EF.get('team', 'kipperton').players[4]); req('Art Direction', 'the engine\\'s HD Humanoid rigs, dressed in new football kits (hoops) with shirt numbers', rig.o.kit && rig.o.kit.pattern === 'hoops' && rig.o.kit.number === 9 && rig.o.style === 'hd'); }\n  { const r2 = new E.Humanoid({ weapon: null }); r2.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0 }); const z0 = r2.J.head[2]; r2.update(1 / 60, { x: 0, y: 0, z: 0, facing: 0, tilt: { axis: 'forward', angle: 1.5, pivot: 'feet' } }); req('Animation', 'the engine\\'s rig animation plus new moves (a body tilt for dives; mocap clips for slides and celebrations)', r2.J.head[2] < z0 - 5 && EF.Anim.lib && EF.Anim.lib.clip('Slide_Loop') && EF.Anim.lib.clip('Backflip'), z0 + ' -> ' + r2.J.head[2]); }\n  req('Audio', 'no audio files; music, effects and voices written in code (16 songs, a crowd engine, chants, babble voices)', !/\\.(mp3|ogg|wav|m4a)\\b|data:audio/i.test(page) && Object.keys(EF.SONGS).length >= 15 && typeof EF.babble.voiceFor('barry') === 'function' && EF.all('chant').length >= 6);\n  // dev mode from the pause menu, sliders and a reset\n  { const item = (game.o.menu.items || []).find(x => x[0] === 'Dev mode'); game.pause(); item && item[1](); game.advance(.1); const open = EF.Dev.isOpen && !game.paused; EF.Dev.tab = 0; const sliders = EF.Dev.rows().filter(r => r.kind === 'slider').length; EF.tuneSet('runSpeed', 120); const changed = EF.T.runSpeed === 120; EF.Dev.rows()[0].run(); EF.Dev.close();\n    req('Dev mode', 'reached from the pause menu, with live sliders for the gameplay variables (' + sliders + ') and a reset to defaults', open && sliders >= 25 && changed && EF.T.runSpeed === EF.TDEF.runSpeed && !EF.tuneChanged()); }\n  // the attract mode\n  { const h2 = load({}); h2.game.advance(.3); h2.game.advance(9.6); const at99 = h2.game.sceneName; h2.game.advance(.3); const on = h2.game.sceneName; h2.game.advance(5); h2.I.tap('confirm'); h2.game.advance(.5);\n    req('Attract Mode', 'after 10 s without input on the title an AI-played demo starts, and any input exits it', at99 === 'title' && on === 'attract' && h2.game.sceneName === 'title', at99 + ' ' + on + ' ' + h2.game.sceneName); }\n  // multiplayer on one machine\n  { const h3 = load({}); h3.game.advance(.3); const p2 = h3.game.addPlayer({ keys: 'right' }); h3.EF.test.startMatch({ humans: [{ input: h3.game.input, side: 0 }, { input: p2, side: 1 }] }); const m = h3.EF.cur.m; req('Multiplayer', 'the game on its own: local players on either side (versus) or together (co-op)', m.humans.length === 2 && m.humans[0].fb && m.humans[1].fb && m.humans[1].side === 1); }\n  // tone\n  { let n = 0; for (const l of EF.all('lines')) n += l.entries.length; const g = EF.get('lines', 'goal').entries.map(e => e.text).join(' '); req('Narrative tone', 'British football commentary and tabloid back pages (' + n + ' commentary lines, puns and deadpan replies)', n >= 300 && /OH MY COD/.test(g) && EF.get('beat', 'prologue').steps[0].headline === 'FISH OUT OF WATER!'); }\n  // the 10-foot UI: few choices, big type, footers with prompts; keyboard keys, mouse, glyphs by device\n  { const h4 = load({}); const { EF: F, game: G, I: J } = h4; G.advance(.3); J.tap('confirm'); G.advance(.3); const scr = F.UI.top();\n    req('UI & UX', '10-foot screens: at most 7 choices in view, a prompt footer, menus driven by the pad\\'s d-pad and confirm', scr.widgets.length <= 8 && !!scr.footer && (J.tap('right'), G.advance(.2), F.UI.focusId() === 'kickabout'));\n    const K = F.KEYS; req('UI & UX', 'keyboard keys PC players expect: WASD and arrows move, J/K/L/I pass, shoot, lob, through; Shift sprints; E skill; Q switch; Space Europhoria; Esc pauses', K.up.includes('KeyW') && K.up.includes('ArrowUp') && K.pass[0] === 'KeyJ' && K.shoot[0] === 'KeyK' && K.sprint.includes('ShiftLeft') && K.euphoria.includes('Space') && K.pause.includes('Escape'));\n    const w = F.UI.top().widgets.find(q => q.id === 'about'); J.feed('move', w.x + w.w / 2, w.y + w.h / 2); G.advance(.1); const hov = F.UI.focusId() === 'about'; J.feed('down', w.x + w.w / 2, w.y + w.h / 2); J.feed('up', w.x + w.w / 2, w.y + w.h / 2); G.advance(.5);\n    req('UI & UX', 'the mouse: hover moves the focus and a click picks a menu item', hov && G.sceneName === 'about', G.sceneName);\n    const kb = F.promptCode(J, 'pass'); J.lastDevice = 'gamepad'; const pad = F.promptCode(J, 'pass'), ps = F.Glyphs.style(J); G.settings.set('glyphs', 'xbox'); const xb = F.Glyphs.style(J); G.settings.set('glyphs', 'playstation'); J.lastDevice = 'mouse'; const mo = F.promptCode(J, 'pass');\n    req('UI & UX', 'prompts follow the last input: PlayStation glyphs for a pad (Xbox in Settings), keys for the keyboard, mouse buttons for the mouse', kb === 'KeyJ' && pad === 'Pad0' && ps === 'playstation' && xb === 'xbox' && mo === 'Mouse0' && G.settings.spec('glyphs').group === 'Controller'); }\n  // touch-only\n  { const h5 = load({ search: '?touchonly=1' }); h5.game.advance(.3); const T = h5.EF.touchOnly() && h5.game.sceneName === 'title' && h5.EF.scenes.title.state === 'press'; h5.I.tap('confirm'); h5.game.advance(.3); h5.EF.UI.setFocus('cup'); const dis = h5.EF.UI.focused().disabled; const noTouch = h5.game.input.touchEnabled === false && Object.values(h5.EF.scenes).every(sc => !sc.touch || sc.touch.length === 0);\n    h5.game.go('title', {}); h5.game.advance(10.5); req('Touch-only', 'no touch controls; \"Controller or keyboard required\" with a settings button; play cannot start; the attract mode runs', T && dis && noTouch && h5.game.sceneName === 'attract' && /CONTROLLER OR KEYBOARD REQUIRED/.test(readFileSync(DEV + 'src/31-front.js', 'utf8')), h5.game.sceneName); }\n  // done: no TODOs, placeholders or stubs\n  { const bad = []; for (const f of readdirSync(DEV + 'src')) { const s = readFileSync(DEV + 'src/' + f, 'utf8'); if (/\\bTODO\\b|\\bFIXME\\b|placeholder|\\bstub\\b|not implemented/i.test(s)) bad.push(f); } req('Done', 'no TODOs, placeholders or stubs in the game\\'s source', !bad.length, bad.join(',')); }\n  // About / Credits with the four sections; the exit interview\n  { const pages = EF.aboutPages().map(p => p.title); const J2 = JSON.parse(readFileSync(ROOT + 'exit-interview.json', 'utf8')); const si = J2.sourceInformation;\n    req('Source Information', 'an in-game About/Credits screen with Source Information, Testing, Engine and Prompt Feedback and credits', ['SOURCE INFORMATION', 'TESTING FEEDBACK', 'ENGINE FEEDBACK', 'PROMPT FEEDBACK', 'CREDITS'].every(t => pages.includes(t)));\n    req('Exit interview', 'exit-interview.json parses and answers every field', Object.keys(si).length === 15 && Object.values(si).every(v => typeof v === 'string' && v.trim()) && J2.testingFeedback.length === 4 && J2.engineFeedback.length === 6 && J2.promptFeedback.length === 4 && Object.values(J2.aiHub).every(v => v !== undefined)); }\n  req('Testing', 'one command prints only failures and a one-line count (this suite runs inside it)', /prints only failures|only failures/.test(readFileSync(DEV + 'tools/test.mjs', 'utf8')));\n  req('Working environment', 'a server only on 127.0.0.1 and a port the OS picks, the page checked to be ours, stopped by its PID', /'0', '--bind', '127\\.0\\.0\\.1'/.test(readFileSync(DEV + 'tools/lib/hubtest.mjs', 'utf8')) && /process\\.kill\\(srv\\.pid\\)/.test(readFileSync(DEV + 'tools/lib/hubtest.mjs', 'utf8')) && !/pkill|killall|fuser/.test(readFileSync(DEV + 'tools/lib/hubtest.mjs', 'utf8')));\n  req('No errors', 'the headless runs above raised no errors', !game.errors.length, game.errors.slice(0, 2).map(e => e.message).join(' | '));\n  // ---- in Chromium: the real page ----\n  const b = await chromium.launch({ args: ['--autoplay-policy=no-user-gesture-required'] }), p = await b.newPage({ viewport: { width: 1280, height: 720 } }); const errs = []; p.on('pageerror', e => errs.push(String(e)));\n  await p.goto('file://' + ROOT + name + '#match'); await p.waitForTimeout(2500); await p.mouse.click(5, 5);\n  const audio = await p.evaluate(async () => { const A = My3D2dge.current.audio; A._init(); if (A.ctx.state !== 'running') await A.ctx.resume(); const an = A.ctx.createAnalyser(); A._master.connect(an); const buf = new Float32Array(2048); const peak = async ms => { let pk = 0; const end = performance.now() + ms; while (performance.now() < end) { an.getFloatTimeDomainData(buf); for (const v of buf) pk = Math.max(pk, Math.abs(v)); await new Promise(r => setTimeout(r, 15)); } return pk; }; EF.music(null); EF.crowdAudio.stop(); EF.mutedCrowd = true; await new Promise(r => setTimeout(r, 600)); EF.sfx('whistleLong'); const s1 = await peak(500); await new Promise(r => setTimeout(r, 600)); const v = EF.babble.voiceFor('barry'), line = 'What a goal!'; for (let i = 0; i < line.length; i++) setTimeout(() => v(line[i], i, line), i * 30); const s2 = await peak(600); EF.mutedCrowd = false; return [s1, s2]; });\n  req('Audio', 'in the browser the synthesised sound and the babble voices reach the output (peaks ' + audio.map(x => x.toFixed(2)).join(', ') + ')', audio[0] > .01 && audio[1] > .01);\n  await p.keyboard.press('Escape'); await p.waitForTimeout(500); const dev = p.getByText('Dev mode', { exact: true }); const nd = await dev.count(); if (nd) { await dev.first().click(); await p.waitForTimeout(400); }\n  const devOpen = await p.evaluate(() => EF.Dev.isOpen && !My3D2dge.current.paused);\n  req('Dev mode', 'in the browser: Escape opens the pause menu, and its Dev mode button opens the panel over the running match', nd > 0 && devOpen);\n  await p.evaluate(() => { EF.Dev.close(); EF.test.giveBall(0, 4, EF.P.CX - 60, EF.P.CY); EF.cur.m.cheats.freezeClock = true; window.__p = 0; EF.bus.on('pass', () => window.__p++); });\n  await p.mouse.move(700, 360); await p.waitForTimeout(80); await p.mouse.move(980, 380); await p.waitForTimeout(250); await p.mouse.down(); await p.waitForTimeout(60); await p.mouse.up(); await p.waitForTimeout(300);\n  const mouse = await p.evaluate(() => ({ aim: EF.cur.m.humans[0].ctl.mouse, passes: window.__p }));\n  req('UI & UX', 'in the browser: the mouse aims in play (a reticle on the pitch) and a click passes toward it', mouse.aim && mouse.passes > 0, JSON.stringify(mouse));\n  const tp = await b.newPage({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 3, isMobile: true, hasTouch: true }); await tp.goto('file://' + ROOT + name + '#touchonly'); await tp.waitForTimeout(2500);\n  const tstate = await tp.evaluate(() => ({ only: EF.touchOnly(), scene: My3D2dge.current.sceneName, touch: My3D2dge.current.input.touchEnabled }));\n  req('Touch-only', 'in the browser on a phone: the title shows the notice, with no touch controls', tstate.only && tstate.scene === 'title' && tstate.touch === false, JSON.stringify(tstate));\n  req('No errors', 'the browser pages raised no errors', !errs.length, errs.join(' | '));\n  await b.close();\n  // ---- online: the AI Hub harness ----\n  const before = rows.length; let hubOk = true; const argv = process.argv; process.argv = argv.concat(['--scenario=2']);\n  await (await import('./hubtest.mjs')).run({ check: (s, n, ok, d) => { if (!ok) hubOk = false; } });\n  process.argv = argv; void before;\n  req('Online', 'AI Hub (lib/hub): the hub\\'s own harness passes its automatic check (2 players), and outside a session the game reaches its title', hubOk);\n  if (process.argv.includes('--report')) for (const [id, what, ok, d] of rows) console.log((ok ? 'ok   ' : 'FAIL ') + id + ': ' + what + (ok || !d ? '' : '  (' + d + ')'));\n}\n"}}}
