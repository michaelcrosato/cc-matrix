{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017p3LLXqkENqX8rof8ZiEck","type":"tool_result","content":"// The 3D engine's check (engine/my-3d2dge-3d.js) and its kits (src/starter3d/, built into dist/my-3d2dge-3d.html and\n// dist/kits/my-3d2dge-3d-<slice>.html).\n//   1. the rules, read from the 3D engine's and the kits' own sources (not the vendored libraries): three.js through\n//      WebGPURenderer and node materials only (no WebGLRenderer, ShaderMaterial, onBeforeCompile, EffectComposer,\n//      addons), no WebGPU-only compute or storage buffers, nothing read back from the GPU; the import map points at\n//      vendored files that exist, and those files match their checksums (tools/vendor-3d.mjs --check)\n//   2. the manual's quick start (the ```js quickstart block in the engine's header) runs as the manual hosts it: no\n//      errors, a hero that walks and jumps, gems to take\n//   3. every 3D kit, served as Vercel serves it (/kits/3d-<slice>, /3d), on WebGL 2 and on WebGPU (headless Chromium runs\n//      WebGPU on SwiftShader, through a stand-in canvas): no page errors, the title\n//      draws, each slice starts; each slice's proof run gives the same hash twice and on both backends (the game never\n//      reads the renderer); a minute of scripted play builds no GPU pipeline mid-game (the warm-up's job) and moves\n//      the hero; pictures in check-output/kit3d/ (read them)\n//   3b. shapes (world.shape: the 2D engine's entries in 3D): every core shape builds and draws on WebGL 2 and on WebGPU (its\n//      pixels change where it stands), a hero walking into a solid one stops and one dropped on a table lands on it; a\n//      sheet of every core shape in 3D beside its 2D picture (check-output/kit3d/shapes-<backend>.png: read it)\n//   3c. the camera's contracts (lock-on, camera zones, tank steering) and the door between rooms, on a page of their own:\n//      lock picks the one in sight nearest where the hero faces (never one behind a wall), cycle goes round to the next\n//      and keeps the lock when none other is in sight, the chase camera frames both and ground() strafes round the\n//      target, the lock lets go of a target that dies, leaves or goes out of range; a zone's cut waits until the target\n//      is margin units in (and not back on the border), the stick held across a cut keeps its way until it is let go;\n//      tank steering turns and walks along the facing; world.reach finds the door in front, world.unlock takes the key,\n//      world.through puts the actor beyond the door while nothing else moves; the same at 60, 90, 120 and 144 frames\n//   3d. vehicles, tracks, flight and split screen, on a page of their own, on WebGL 2 and on WebGPU: a kart takes to its\n//      top speed along the road, a boost pad boosts it, a wall stops it, the grass beside the road slows it, a hop held\n//      into a bend drifts and charges a boost, a hovercraft rides its cushion, a kart on a banked bend sits on the bank;\n//      E.Race (the drive module) races two AI vehicles a lap over the hump (in the air) to the finish; a flyer on rails\n//      keeps the rail's pace and moves within its window, a barrel roll ends, one in free flight turns back into its\n//      bounds, seek picks the one in its cone and in sight; all of it twice the same and the same on both backends; a\n//      split screen draws two views through world.cameras (check-output/kit3d/split-<backend>.png: read it), side by side\n//      and stacked (viewport 0 on top, as the 2D layout has it: split-rows-<backend>.png)\n//   3e. first person with the cel filter, on both backends: the filtered hall and the overlay's gun are both drawn\n//      (check-output/kit3d/fps-cel-<backend>.png)\n//   4. on an emulated phone held upright (390 x 844 at 3x, touch): every kit starts, the 3D picture lies exactly under the\n//      game's, the touch buttons are there\n// Usage: node tools/kit3d-test.mjs   (run node tools/build.mjs first; CHROMIUM_PATH picks a browser). Exit code 1 on failure.\nimport { chromium } from 'playwright';\nimport { createServer } from 'node:http';\nimport { readFileSync, existsSync, statSync, readdirSync, mkdirSync, writeFileSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nimport { resolve, join, extname } from 'node:path';\n\nconst root = resolve('.');\nconst problems = [], notes = [];\nconst fail = m => problems.push(m);\nconst read = f => readFileSync(join(root, f), 'utf8');\n\n/* 1. the rules */\ntry { execFileSync('node', ['tools/vendor-3d.mjs', '--check'], { cwd: root, stdio: 'pipe' }); } catch (e) { fail(String(e.stderr || e.message).trim()); }   // the vendored files\nconst BANNED = [\n  [/\\bWebGLRenderer\\b/, 'WebGLRenderer (use WebGPURenderer: it falls back to WebGL 2 by itself)'],\n  [/\\b(Raw)?ShaderMaterial\\b/, 'ShaderMaterial (write node materials or TSL)'],\n  [/\\bonBeforeCompile\\b/, 'onBeforeCompile (not run by WebGPURenderer)'],\n  [/\\bEffectComposer\\b|three\\/examples|three\\/addons/, 'addons and EffectComposer (not vendored; post-processing is TSL)'],\n  [/\\bcompute\\s*\\(|\\bStorageBufferAttribute\\b|\\bstorage\\s*\\(|\\bcomputeAsync\\b/, 'compute shaders or storage buffers (WebGPU only)'],\n  [/readRenderTargetPixels|readPixels\\s*\\(/, 'reading pixels back (nothing comes back from the GPU into gameplay)']\n];\nconst SLICES = readdirSync(join(root, 'src/starter3d')).filter(f => /^[1-8]\\d-.+\\.js$/.test(f)).map(f => f.replace(/^\\d+-|\\.js$/g, ''));\nconst SOURCES = ['engine/my-3d2dge-3d.js', 'src/starter3d.template.html', ...readdirSync(join(root, 'src/starter3d')).filter(f => f.endsWith('.js')).map(f => 'src/starter3d/' + f)];\nconst engine3d = read('engine/my-3d2dge-3d.js'), manual = engine3d.slice(0, engine3d.indexOf('*/'));\nfor (const f of SOURCES) {\n  const text = f === 'engine/my-3d2dge-3d.js' ? engine3d.slice(manual.length) : read(f);   // (the manual names what is banned)\n  text.split('\\n').forEach((line, i) => {\n    const code = line.replace(/\\/\\/.*$|\\/\\*.*?\\*\\/|^\\s*\\*.*$/g, '');\n    for (const [re, why] of BANNED) if (re.test(code)) fail(`${f}:${i + 1}: ${why}`);\n  });\n}\n{\n  const map = JSON.parse(read('src/starter3d.template.html').match(/<script type=\"importmap\">([\\s\\S]*?)<\\/script>/)[1]);\n  for (const [k, v] of Object.entries(map.imports)) if (!v.startsWith('/vendor/') || !existsSync(join(root, v))) fail(`src/starter3d.template.html import map: ${k} -> ${v} is not a vendored file that exists`);\n}\n\n/* the site, served as Vercel serves it (vercel.json's rewrites), and the quick start's page at /check/quickstart.html */\nconst rules = JSON.parse(read('vercel.json')).rewrites.map(r => ({\n  re: new RegExp('^' + r.source.split(/(:\\w+\\([^)]+\\))/).map((part, i) => i % 2 ? part.replace(/:(\\w+)\\(([^)]+)\\)/, '(?<$1>$2)') : part.replace(/\\./g, '\\\\.').replace(/:(\\w+)(?![\\w>])/g, '(?<$1>[^/]+)')).join('') + '$'),\n  to: r.destination\n}));\nconst code = (manual.split('```js quickstart\\n')[1] || '').split('```')[0], host = manual.split('## Host it')[1] || '';\nif (!code) fail('the manual has no ```js quickstart block');\nconst importmap = (host.match(/<script type=\"importmap\">[\\s\\S]*?<\\/script>/) || [''])[0];\n...\n9://   3. every 3D kit, served as Vercel serves it (/kits/3d-<slice>, /3d), on WebGL 2 and on WebGPU (headless Chromium runs\n11://      draws, each slice starts; each slice's proof run gives the same hash twice and on both backends (the game never\n16://      sheet of every core shape in 3D beside its 2D picture (check-output/kit3d/shapes-<backend>.png: read it)\n29://      bounds, seek picks the one in its cone and in sight; all of it twice the same and the same on both backends; a\n30://      split screen draws two views through world.cameras (check-output/kit3d/split-<backend>.png: read it), side by side\n31://      and stacked (viewport 0 on top, as the 2D layout has it: split-rows-<backend>.png)\n32://   3e. first person with the cel filter, on both backends: the filtered hall and the overlay's gun are both drawn\n33://      (check-output/kit3d/fps-cel-<backend>.png)\n231:  let path = decodeURIComponent(new URL(req.url, 'http://x').pathname);\n244:const SITE = 'http://127.0.0.1:' + server.address().port;\n247:const browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-webg\n248:/** test-only: a WebGPU canvas context that renders into a plain texture (headless\n284:  await page.goto(SITE + '/check/quickstart.html?backend=webgl');\n303:/* 3. the kits on both backends */\n310:  const r = await page.goto(SITE + path + (want === 'webgl' ? '?backend=webgl' : ''));\n314:  const backend = await page.evaluate(() => My3D2dge.World3D.backend);\n315:  if (want === 'webgl' && backend !== 'WebGL 2') fail(`${label}: ?backend=webgl gave ${backend}`);\n316:  if (want === 'webgpu' && backend !== 'WebGPU') { notes.push('WebGPU is not available in this browser: the WebGPU runs fell back to WebGL 2'); await page.close(); continue; }\n328:    // the proof: twice, the same hash (and the same on both backends, below)\n370:    await page.goto(SITE + '/check/shapes.html' + (want === 'webgl' ? '?backend=webgl' : ''));\n373:      if (want === 'webgpu' && await page.evaluate(() => My3D2dge.World3D.backend) !== 'WebGPU') { notes.push('WebGPU is not available in this browser: the WebGPU runs fell back to WebGL 2'); awai\n465:  await page.goto(SITE + '/check/camera.html?backend=webgl');\n490:/* 3d. vehicles, tracks, flight and split screen, on both backends: twice the same, and the same on each */\n497:    await page.goto(SITE + '/check/vehicles.html' + (want === 'webgl' ? '?backend=webgl' : ''));\n500:      if (want === 'webgpu' && await page.evaluate(() => My3D2dge.World3D.backend) !== 'WebGPU') { notes.push('WebGPU is not available in this browser: the WebGPU runs fell back to WebGL 2'); awai\n544:  if (seen.webgl && seen.webgpu && seen.webgl !== seen.webgpu) fail(`vehicles: not the same on both backends: ${seen.webgl} on WebGL 2, ${seen.webgpu} on WebGPU`);\n547:/* 3e. first person under a filter, on both backends: the world and the overlay's gun both on screen (not black) */\n554:    await page.goto(SITE + '/check/fps.html' + (want === 'webgl' ? '?backend=webgl' : ''));\n557:      if (want === 'webgpu' && await page.evaluate(() => My3D2dge.World3D.backend) !== 'WebGPU') { await page.close(); continue; }\n576:  await page.goto(SITE + '/kits/3d-' + id + '?backend=webgl#' + id);\n----CHECK\n// my-3D2dge game checker: loads a game in a headless browser, presses start, plays it for a\n// moment, switches through the game's camera views, and reports errors, warnings, frame rate,\n// how much of the window the picture covers (covers: 1 = no black bars), how much is actually on screen, and screenshots.\n//\n// Setup (once):   npm install          (installs Playwright)\n//                 npx playwright install chromium\n// Usage:          node tools/check.mjs path/to/game.html[#scene] [--seconds 4] [--out check-output] [--size 390x844@3]\n//                 (--size: the window in CSS pixels and its pixel density; @2 and up is a phone or tablet, with touch)\n// Exit code is 1 if the page threw any error or never drew anything, so agents and CI can rely on it.\n// A game that sets game.debug = { snapshot() { return {...} } } gets its snapshot printed after play (its own state:\n// the hero, the objective, what an agent needs to see the game is where it should be).\nimport { chromium } from 'playwright';\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { resolve, join } from 'node:path';\nimport { pathToFileURL } from 'node:url';\n\nconst args = process.argv.slice(2);\nconst file = args.find(a => !a.startsWith('--') && !/^\\d+(\\.\\d+)?$/.test(a));\nconst opt = (name, def) => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : def; };\nif (!file) { console.error('Usage: node tools/check.mjs path/to/game.html [--seconds 4] [--out check-output]'); process.exit(2); }\nconst seconds = +opt('seconds', 4), out = resolve(opt('out', 'check-output'));\nconst [, sw, sh, sd] = (opt('size', '1280x720') || '').match(/^(\\d+)x(\\d+)(?:@(\\d+(?:\\.\\d+)?))?$/) || [0, 1280, 720];\nconst dpr = +(sd || 1), size = { viewport: { width: +sw, height: +sh }, deviceScaleFactor: dpr, ...(dpr >= 2 && { isMobile: true, hasTouch: true }) };\nmkdirSync(out, { recursive: true });\n\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--autoplay-policy=no-user-gesture-required'] });\nconst page = await browser.newPage(size);\nconst errors = [], warnings = [], engineWarnings = [], external = new Set();\npage.on('pageerror', e => errors.push(String(e && e.stack || e)));\npage.on('console', m => {\n  const t = m.text();\n  if (m.type() === 'error') errors.push(t);\n  else if (m.type() === 'warning') (t.startsWith('my-3D2dge:') ? engineWarnings : warnings).push(t);\n});\npage.on('request', r => { const u = r.url(); if (/^https?:/i.test(u)) external.add(u.split('?')[0]); });\n\n// a #hash after the file name is kept, so deep links like game.html#platformer work\nconst [filePath, hash] = file.split('#');\nawait page.goto(pathToFileURL(resolve(filePath)).href + (hash ? '#' + hash : ''));\nawait page.waitForTimeout(1200);","is_error":false}]},"parent_tool_use_id":null,"session_id":"23de6e6b-3ae6-4bf5-9764-44b18bb5857c","uuid":"dc0fc9a8-bbaa-4eac-9594-da0655a9431b","timestamp":"2026-11-05T04:27:25.722Z","tool_use_result":{"stdout":"// The 3D engine's check (engine/my-3d2dge-3d.js) and its kits (src/starter3d/, built into dist/my-3d2dge-3d.html and\n// dist/kits/my-3d2dge-3d-<slice>.html).\n//   1. the rules, read from the 3D engine's and the kits' own sources (not the vendored libraries): three.js through\n//      WebGPURenderer and node materials only (no WebGLRenderer, ShaderMaterial, onBeforeCompile, EffectComposer,\n//      addons), no WebGPU-only compute or storage buffers, nothing read back from the GPU; the import map points at\n//      vendored files that exist, and those files match their checksums (tools/vendor-3d.mjs --check)\n//   2. the manual's quick start (the ```js quickstart block in the engine's header) runs as the manual hosts it: no\n//      errors, a hero that walks and jumps, gems to take\n//   3. every 3D kit, served as Vercel serves it (/kits/3d-<slice>, /3d), on WebGL 2 and on WebGPU (headless Chromium runs\n//      WebGPU on SwiftShader, through a stand-in canvas): no page errors, the title\n//      draws, each slice starts; each slice's proof run gives the same hash twice and on both backends (the game never\n//      reads the renderer); a minute of scripted play builds no GPU pipeline mid-game (the warm-up's job) and moves\n//      the hero; pictures in check-output/kit3d/ (read them)\n//   3b. shapes (world.shape: the 2D engine's entries in 3D): every core shape builds and draws on WebGL 2 and on WebGPU (its\n//      pixels change where it stands), a hero walking into a solid one stops and one dropped on a table lands on it; a\n//      sheet of every core shape in 3D beside its 2D picture (check-output/kit3d/shapes-<backend>.png: read it)\n//   3c. the camera's contracts (lock-on, camera zones, tank steering) and the door between rooms, on a page of their own:\n//      lock picks the one in sight nearest where the hero faces (never one behind a wall), cycle goes round to the next\n//      and keeps the lock when none other is in sight, the chase camera frames both and ground() strafes round the\n//      target, the lock lets go of a target that dies, leaves or goes out of range; a zone's cut waits until the target\n//      is margin units in (and not back on the border), the stick held across a cut keeps its way until it is let go;\n//      tank steering turns and walks along the facing; world.reach finds the door in front, world.unlock takes the key,\n//      world.through puts the actor beyond the door while nothing else moves; the same at 60, 90, 120 and 144 frames\n//   3d. vehicles, tracks, flight and split screen, on a page of their own, on WebGL 2 and on WebGPU: a kart takes to its\n//      top speed along the road, a boost pad boosts it, a wall stops it, the grass beside the road slows it, a hop held\n//      into a bend drifts and charges a boost, a hovercraft rides its cushion, a kart on a banked bend sits on the bank;\n//      E.Race (the drive module) races two AI vehicles a lap over the hump (in the air) to the finish; a flyer on rails\n//      keeps the rail's pace and moves within its window, a barrel roll ends, one in free flight turns back into its\n//      bounds, seek picks the one in its cone and in sight; all of it twice the same and the same on both backends; a\n//      split screen draws two views through world.cameras (check-output/kit3d/split-<backend>.png: read it), side by side\n//      and stacked (viewport 0 on top, as the 2D layout has it: split-rows-<backend>.png)\n//   3e. first person with the cel filter, on both backends: the filtered hall and the overlay's gun are both drawn\n//      (check-output/kit3d/fps-cel-<backend>.png)\n//   4. on an emulated phone held upright (390 x 844 at 3x, touch): every kit starts, the 3D picture lies exactly under the\n//      game's, the touch buttons are there\n// Usage: node tools/kit3d-test.mjs   (run node tools/build.mjs first; CHROMIUM_PATH picks a browser). Exit code 1 on failure.\nimport { chromium } from 'playwright';\nimport { createServer } from 'node:http';\nimport { readFileSync, existsSync, statSync, readdirSync, mkdirSync, writeFileSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nimport { resolve, join, extname } from 'node:path';\n\nconst root = resolve('.');\nconst problems = [], notes = [];\nconst fail = m => problems.push(m);\nconst read = f => readFileSync(join(root, f), 'utf8');\n\n/* 1. the rules */\ntry { execFileSync('node', ['tools/vendor-3d.mjs', '--check'], { cwd: root, stdio: 'pipe' }); } catch (e) { fail(String(e.stderr || e.message).trim()); }   // the vendored files\nconst BANNED = [\n  [/\\bWebGLRenderer\\b/, 'WebGLRenderer (use WebGPURenderer: it falls back to WebGL 2 by itself)'],\n  [/\\b(Raw)?ShaderMaterial\\b/, 'ShaderMaterial (write node materials or TSL)'],\n  [/\\bonBeforeCompile\\b/, 'onBeforeCompile (not run by WebGPURenderer)'],\n  [/\\bEffectComposer\\b|three\\/examples|three\\/addons/, 'addons and EffectComposer (not vendored; post-processing is TSL)'],\n  [/\\bcompute\\s*\\(|\\bStorageBufferAttribute\\b|\\bstorage\\s*\\(|\\bcomputeAsync\\b/, 'compute shaders or storage buffers (WebGPU only)'],\n  [/readRenderTargetPixels|readPixels\\s*\\(/, 'reading pixels back (nothing comes back from the GPU into gameplay)']\n];\nconst SLICES = readdirSync(join(root, 'src/starter3d')).filter(f => /^[1-8]\\d-.+\\.js$/.test(f)).map(f => f.replace(/^\\d+-|\\.js$/g, ''));\nconst SOURCES = ['engine/my-3d2dge-3d.js', 'src/starter3d.template.html', ...readdirSync(join(root, 'src/starter3d')).filter(f => f.endsWith('.js')).map(f => 'src/starter3d/' + f)];\nconst engine3d = read('engine/my-3d2dge-3d.js'), manual = engine3d.slice(0, engine3d.indexOf('*/'));\nfor (const f of SOURCES) {\n  const text = f === 'engine/my-3d2dge-3d.js' ? engine3d.slice(manual.length) : read(f);   // (the manual names what is banned)\n  text.split('\\n').forEach((line, i) => {\n    const code = line.replace(/\\/\\/.*$|\\/\\*.*?\\*\\/|^\\s*\\*.*$/g, '');\n    for (const [re, why] of BANNED) if (re.test(code)) fail(`${f}:${i + 1}: ${why}`);\n  });\n}\n{\n  const map = JSON.parse(read('src/starter3d.template.html').match(/<script type=\"importmap\">([\\s\\S]*?)<\\/script>/)[1]);\n  for (const [k, v] of Object.entries(map.imports)) if (!v.startsWith('/vendor/') || !existsSync(join(root, v))) fail(`src/starter3d.template.html import map: ${k} -> ${v} is not a vendored file that exists`);\n}\n\n/* the site, served as Vercel serves it (vercel.json's rewrites), and the quick start's page at /check/quickstart.html */\nconst rules = JSON.parse(read('vercel.json')).rewrites.map(r => ({\n  re: new RegExp('^' + r.source.split(/(:\\w+\\([^)]+\\))/).map((part, i) => i % 2 ? part.replace(/:(\\w+)\\(([^)]+)\\)/, '(?<$1>$2)') : part.replace(/\\./g, '\\\\.').replace(/:(\\w+)(?![\\w>])/g, '(?<$1>[^/]+)')).join('') + '$'),\n  to: r.destination\n}));\nconst code = (manual.split('```js quickstart\\n')[1] || '').split('```')[0], host = manual.split('## Host it')[1] || '';\nif (!code) fail('the manual has no ```js quickstart block');\nconst importmap = (host.match(/<script type=\"importmap\">[\\s\\S]*?<\\/script>/) || [''])[0];\n...\n9://   3. every 3D kit, served as Vercel serves it (/kits/3d-<slice>, /3d), on WebGL 2 and on WebGPU (headless Chromium runs\n11://      draws, each slice starts; each slice's proof run gives the same hash twice and on both backends (the game never\n16://      sheet of every core shape in 3D beside its 2D picture (check-output/kit3d/shapes-<backend>.png: read it)\n29://      bounds, seek picks the one in its cone and in sight; all of it twice the same and the same on both backends; a\n30://      split screen draws two views through world.cameras (check-output/kit3d/split-<backend>.png: read it), side by side\n31://      and stacked (viewport 0 on top, as the 2D layout has it: split-rows-<backend>.png)\n32://   3e. first person with the cel filter, on both backends: the filtered hall and the overlay's gun are both drawn\n33://      (check-output/kit3d/fps-cel-<backend>.png)\n231:  let path = decodeURIComponent(new URL(req.url, 'http://x').pathname);\n244:const SITE = 'http://127.0.0.1:' + server.address().port;\n247:const browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-webg\n248:/** test-only: a WebGPU canvas context that renders into a plain texture (headless\n284:  await page.goto(SITE + '/check/quickstart.html?backend=webgl');\n303:/* 3. the kits on both backends */\n310:  const r = await page.goto(SITE + path + (want === 'webgl' ? '?backend=webgl' : ''));\n314:  const backend = await page.evaluate(() => My3D2dge.World3D.backend);\n315:  if (want === 'webgl' && backend !== 'WebGL 2') fail(`${label}: ?backend=webgl gave ${backend}`);\n316:  if (want === 'webgpu' && backend !== 'WebGPU') { notes.push('WebGPU is not available in this browser: the WebGPU runs fell back to WebGL 2'); await page.close(); continue; }\n328:    // the proof: twice, the same hash (and the same on both backends, below)\n370:    await page.goto(SITE + '/check/shapes.html' + (want === 'webgl' ? '?backend=webgl' : ''));\n373:      if (want === 'webgpu' && await page.evaluate(() => My3D2dge.World3D.backend) !== 'WebGPU') { notes.push('WebGPU is not available in this browser: the WebGPU runs fell back to WebGL 2'); awai\n465:  await page.goto(SITE + '/check/camera.html?backend=webgl');\n490:/* 3d. vehicles, tracks, flight and split screen, on both backends: twice the same, and the same on each */\n497:    await page.goto(SITE + '/check/vehicles.html' + (want === 'webgl' ? '?backend=webgl' : ''));\n500:      if (want === 'webgpu' && await page.evaluate(() => My3D2dge.World3D.backend) !== 'WebGPU') { notes.push('WebGPU is not available in this browser: the WebGPU runs fell back to WebGL 2'); awai\n544:  if (seen.webgl && seen.webgpu && seen.webgl !== seen.webgpu) fail(`vehicles: not the same on both backends: ${seen.webgl} on WebGL 2, ${seen.webgpu} on WebGPU`);\n547:/* 3e. first person under a filter, on both backends: the world and the overlay's gun both on screen (not black) */\n554:    await page.goto(SITE + '/check/fps.html' + (want === 'webgl' ? '?backend=webgl' : ''));\n557:      if (want === 'webgpu' && await page.evaluate(() => My3D2dge.World3D.backend) !== 'WebGPU') { await page.close(); continue; }\n576:  await page.goto(SITE + '/kits/3d-' + id + '?backend=webgl#' + id);\n----CHECK\n// my-3D2dge game checker: loads a game in a headless browser, presses start, plays it for a\n// moment, switches through the game's camera views, and reports errors, warnings, frame rate,\n// how much of the window the picture covers (covers: 1 = no black bars), how much is actually on screen, and screenshots.\n//\n// Setup (once):   npm install          (installs Playwright)\n//                 npx playwright install chromium\n// Usage:          node tools/check.mjs path/to/game.html[#scene] [--seconds 4] [--out check-output] [--size 390x844@3]\n//                 (--size: the window in CSS pixels and its pixel density; @2 and up is a phone or tablet, with touch)\n// Exit code is 1 if the page threw any error or never drew anything, so agents and CI can rely on it.\n// A game that sets game.debug = { snapshot() { return {...} } } gets its snapshot printed after play (its own state:\n// the hero, the objective, what an agent needs to see the game is where it should be).\nimport { chromium } from 'playwright';\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { resolve, join } from 'node:path';\nimport { pathToFileURL } from 'node:url';\n\nconst args = process.argv.slice(2);\nconst file = args.find(a => !a.startsWith('--') && !/^\\d+(\\.\\d+)?$/.test(a));\nconst opt = (name, def) => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : def; };\nif (!file) { console.error('Usage: node tools/check.mjs path/to/game.html [--seconds 4] [--out check-output]'); process.exit(2); }\nconst seconds = +opt('seconds', 4), out = resolve(opt('out', 'check-output'));\nconst [, sw, sh, sd] = (opt('size', '1280x720') || '').match(/^(\\d+)x(\\d+)(?:@(\\d+(?:\\.\\d+)?))?$/) || [0, 1280, 720];\nconst dpr = +(sd || 1), size = { viewport: { width: +sw, height: +sh }, deviceScaleFactor: dpr, ...(dpr >= 2 && { isMobile: true, hasTouch: true }) };\nmkdirSync(out, { recursive: true });\n\nconst browser = await chromium.launch({ executablePath: process.env.CHROMIUM_PATH || undefined, args: ['--autoplay-policy=no-user-gesture-required'] });\nconst page = await browser.newPage(size);\nconst errors = [], warnings = [], engineWarnings = [], external = new Set();\npage.on('pageerror', e => errors.push(String(e && e.stack || e)));\npage.on('console', m => {\n  const t = m.text();\n  if (m.type() === 'error') errors.push(t);\n  else if (m.type() === 'warning') (t.startsWith('my-3D2dge:') ? engineWarnings : warnings).push(t);\n});\npage.on('request', r => { const u = r.url(); if (/^https?:/i.test(u)) external.add(u.split('?')[0]); });\n\n// a #hash after the file name is kept, so deep links like game.html#platformer work\nconst [filePath, hash] = file.split('#');\nawait page.goto(pathToFileURL(resolve(filePath)).href + (hash ? '#' + hash : ''));\nawait page.waitForTimeout(1200);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_017p3LLXqkENqX8rof8ZiEck","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
