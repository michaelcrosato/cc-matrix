 pitch, roll, fov }: your own),\n292:// (their capsules shove mobs aside); mobs each other too; flyers the level and each other; the downed (setSolid(false))\n328:/** the mouse turns the chase, first-person and fly cameras of the world drawn last: a click on the game's canvas in\n334:    const c = cam(); if (!c || e.pointerType !== 'mouse' || !c.mouseLook || !(c.capture || ['chase', 'first', 'fly'].includes(c.mode)) || document.pointerLockElement) return;\n346:    else if (c.mode === 'fly') c.fly.pitch = clamp(c.fly.pitch - dy * k, -1.5, 1.5);\n1626: *      'first'  the target's eyes (its body isn't drawn), 'fly' a free camera the move stick flies (jump up, dash\n1645:    /** mode: 'view' | 'chase' | 'first' | 'fly' | 'fixed'; proj: 'persp' | 'ortho' (view mode); fov: the view lens\n1651:     *  round behind the target as it moves) }; first: { pitch, fov }; fly: { x, y, z, yaw, pitch, fov }; fixed: a pose */\n1657:    this.fly = { x: 0, y: 0, z: 90, yaw: -Math.PI / 2, pitch: -.32, fov: 70 }; this.fixed = o.fixed || null;\n1658:    /** yaw: the heading of the chase, first and fly cameras (radians, the ground angle they look along); locked: the\n1682:    if (!['view', 'chase', 'first', 'fly', 'fixed', 'zones', 'behind'].includes(mode) || mode === this.mode) return this;\n\n * 4. PARTS DRAWN BY CODE  instanced batches of four shapes (tube, ball, box, cone) in a toon look with outlines, and\n *    two that glow (glow, halo); a pen that draws with them in engine units. Puppets, things and anything a game draws\n *    in 3D go through them, so thousands of parts cost a handful of draw calls\n * ============================================================================= */\nconst FLASH = lin('#ffe6d8'), BLACKISH = lin('#1a1320');\n/* three r182 uploads an instanced mesh's matrices and colors (over 1,000 slots) in the ranges its node copied from the\n * mesh the frame before (a render uploads the geometry, then updates the nodes), so a slot past the last frame's count\n *