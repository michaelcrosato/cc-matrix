{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DZg36DkDgVJuxLmHQWq5Bu","type":"tool_result","content":"  268 src/mocap/mocap.js\n  338 src/mocap/readable.js\n  606 total\n/* =============================================================================\n * MOCAP  plays animation sets in the readable format (src/mocap/readable.js; written by tools/anim-import.mjs) on\n * my-3D2dge rigs.\n *   const lib = Mocap.load(window.MOCAP.QUATERNIUS);   // a set: its clips, and the bodies they were measured on\n *   const clip = lib.clip('Dance_Loop');               // { name, dur, loop, tags, desc, keys }\n *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n *   const man = new Mocap.Mannequin(lib, { height: 34 });  man.draw(g, ox, oy, view, pose, facing)\n *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n *     window.Mocap.)\n *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n *     only the chest, head and arms over the rig's own legs (an interaction while walking); humanoid.mocapBlade = true\n *     while the clip holds a sword (the blade follows the fist).\n * Points are in the rig's local frame: f = forward, r = right, z = up, centred on the root on the ground.\n * ============================================================================= */\nconst Mocap = (() => {\n'use strict';\nconst E = My3D2dge, { px } = E, MR = MocapReadable;\n\n/* ---- sets ---- */\n/**\n * Every clip is rebuilt on the first library's proportions (the format does not depend on size); each keeps how its own\n * library bends the spine, since the key poses were measured that way.\n */\nfunction load(set) {\n  const P = MR.P, idx = MR.IDX, ids = Object.keys(set.sources), base = set.sources[ids[0]].rest, rests = {};\n  for (const id of ids) rests[id] = Object.assign({}, base, { spineW: set.sources[id].rest.spineW, neckW: set.sources[id].rest.neckW });\n  const meta = c => ({ name: c.clip, fps: set.fps, n: Math.round(c.dur * set.fps) + 1 }), clips = {};\n  for (const [name, c] of Object.entries(set.clips)) clips[name] = Object.assign(meta(Object.assign({ clip: name }, c)), c);\n  const restOf = c => rests[c.src] || base;\n  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n  lib.clip = name => clips[name] || null;\n  /** the pose at time t (seconds): key poses in-betweened, loops wrap, one-shots hold their last pose */\n  lib.sample = (clip, t, out = new Float32Array(P * 3)) => { MR.pose(restOf(clip), clip, t, out); out.src = clip.src; return out; };   // (src: whose rest it is measured against)\n  /** a clip that travels: how far it has carried the body at time t ([forward, right] mm), or null */\n  lib.moveAt = (clip, t) => MR.moveAt(restOf(clip), clip, t);\n  /** swap in an edited clip (readable text a person or a model changed); the original is kept for restore() */\n  const originals = {};\n  lib.replace = (name, edited) => { if (!originals[name]) originals[name] = clips[name]; clips[name] = Object.assign({}, originals[name], edited, { name, keys: edited.keys }); return clips[name]; };\n  lib.restore = name => { if (originals[name]) { clips[name] = originals[name]; delete originals[name]; } return clips[name]; };\n  lib.edited = name => !!originals[name];\n6: *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n8: *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n10: *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n30:  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n167: * Mocap.drive(rig, lib): after the rig poses itself each step it takes the pose in rig.mocap (a sampled pose, or\n171: * draws around the joints follows the clip's body and head (rig.mocapTilt: upside down in a cartwheel, a face that\n173: * rig.mocapW fades the clip over the rig's own pose; rig.mocapMask = 'upper' leaves the hips and legs to the rig.\n175:function drive(rig, lib) {\n176:  const base = E.Humanoid.prototype.solvePose, update = E.Humanoid.prototype.update, R = lib.rest, hipH = R.hipZ, ankleH = R.ankleZ;\n178:  // the rig's own turn this step (an attack's spin), read before the clip turns it: solvePose can run more than once a step\n180:  rig.solvePose = function () {\n182:    const pose = this.mocap, w = this.mocapW === undefined ? 1 : Math.max(0, Math.min(1, this.mocapW));\n185:    const o = this.o, J = this.J, k = o.hipZ / hipH, upper = this.mocapMask === 'upper';\n265:return { load, Mannequin, drive, LEGEND: MR.LEGEND };\n\nZombie_Walk_Loop [\"walk zombie loop\", \"A zombie's shamble: head and shoulders slumped forward, a dragging step, arms hanging. One cycle, in place\"]\nWounded_Walk_Loop [\"walk hurt loop\", \"Limping on a wounded leg: a short careful step on the bad leg, a longer one on the good. One cycle, in place\"]\nRoundhouse_Kick [\"attack kick once\", \"A karate roundhouse kick (mawashi-geri): the leg swings round in an arc at head height\"]\nFront_Kick [\"attack kick once\", \"A karate front kick (mae-geri): knee up, foot snapped straight ahead, back to the stance\"]\nFall_On_Face [\"death hurt once\", \"Toppling forward flat onto the face\"]\nGet_Up_Face_Down [\"getup once\", \"Getting up from lying face down: push up on the arms, a knee under, stand\"]\nClimb_Ladder [\"climb once\", \"Climbing a ladder hand over hand, rising about a step a second (no ladder is drawn)\"]\nFrankenstein_Walk_Loop [\"walk monster zombie loop\", \"Frankenstein's monster: stiff legs, arms held straight out ahead, a heavy lurching walk. One cycle, in place\"]\nChop_Wood [\"work once\", \"Chopping wood: an axe raised overhead in both hands and brought down hard, again and again (no axe is drawn)\"]\nSearch_Ground [\"interact crouch once\", \"Crouching to search the ground, peering about and poking at it\"]","is_error":false}]},"parent_tool_use_id":null,"session_id":"23de6e6b-3ae6-4bf5-9764-44b18bb5857c","uuid":"0f42eba2-025f-4ebe-b4eb-b88f0e8354e8","timestamp":"2026-11-05T04:38:36.546Z","tool_use_result":{"stdout":"  268 src/mocap/mocap.js\n  338 src/mocap/readable.js\n  606 total\n/* =============================================================================\n * MOCAP  plays animation sets in the readable format (src/mocap/readable.js; written by tools/anim-import.mjs) on\n * my-3D2dge rigs.\n *   const lib = Mocap.load(window.MOCAP.QUATERNIUS);   // a set: its clips, and the bodies they were measured on\n *   const clip = lib.clip('Dance_Loop');               // { name, dur, loop, tags, desc, keys }\n *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n *   const man = new Mocap.Mannequin(lib, { height: 34 });  man.draw(g, ox, oy, view, pose, facing)\n *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n *     window.Mocap.)\n *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n *     only the chest, head and arms over the rig's own legs (an interaction while walking); humanoid.mocapBlade = true\n *     while the clip holds a sword (the blade follows the fist).\n * Points are in the rig's local frame: f = forward, r = right, z = up, centred on the root on the ground.\n * ============================================================================= */\nconst Mocap = (() => {\n'use strict';\nconst E = My3D2dge, { px } = E, MR = MocapReadable;\n\n/* ---- sets ---- */\n/**\n * Every clip is rebuilt on the first library's proportions (the format does not depend on size); each keeps how its own\n * library bends the spine, since the key poses were measured that way.\n */\nfunction load(set) {\n  const P = MR.P, idx = MR.IDX, ids = Object.keys(set.sources), base = set.sources[ids[0]].rest, rests = {};\n  for (const id of ids) rests[id] = Object.assign({}, base, { spineW: set.sources[id].rest.spineW, neckW: set.sources[id].rest.neckW });\n  const meta = c => ({ name: c.clip, fps: set.fps, n: Math.round(c.dur * set.fps) + 1 }), clips = {};\n  for (const [name, c] of Object.entries(set.clips)) clips[name] = Object.assign(meta(Object.assign({ clip: name }, c)), c);\n  const restOf = c => rests[c.src] || base;\n  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n  lib.clip = name => clips[name] || null;\n  /** the pose at time t (seconds): key poses in-betweened, loops wrap, one-shots hold their last pose */\n  lib.sample = (clip, t, out = new Float32Array(P * 3)) => { MR.pose(restOf(clip), clip, t, out); out.src = clip.src; return out; };   // (src: whose rest it is measured against)\n  /** a clip that travels: how far it has carried the body at time t ([forward, right] mm), or null */\n  lib.moveAt = (clip, t) => MR.moveAt(restOf(clip), clip, t);\n  /** swap in an edited clip (readable text a person or a model changed); the original is kept for restore() */\n  const originals = {};\n  lib.replace = (name, edited) => { if (!originals[name]) originals[name] = clips[name]; clips[name] = Object.assign({}, originals[name], edited, { name, keys: edited.keys }); return clips[name]; };\n  lib.restore = name => { if (originals[name]) { clips[name] = originals[name]; delete originals[name]; } return clips[name]; };\n  lib.edited = name => !!originals[name];\n6: *   const pose = lib.sample(clip, t);                  // Float32Array: every body point's f r z (mm), in-betweened\n8: *   Mocap.drive(humanoid, lib)  then each step  humanoid.mocap = pose: the rig plays it at its own build. (Mocap is also\n10: *     humanoid.mocapW (0..1) fades it in and out over the rig's own animation; humanoid.mocapMask = 'upper' plays\n30:  const lib = { set, P, idx, clips, names: Object.keys(clips), fps: set.fps, body: set.body, rest: base, points: MR.POINTS };\n167: * Mocap.drive(rig, lib): after the rig poses itself each step it takes the pose in rig.mocap (a sampled pose, or\n171: * draws around the joints follows the clip's body and head (rig.mocapTilt: upside down in a cartwheel, a face that\n173: * rig.mocapW fades the clip over the rig's own pose; rig.mocapMask = 'upper' leaves the hips and legs to the rig.\n175:function drive(rig, lib) {\n176:  const base = E.Humanoid.prototype.solvePose, update = E.Humanoid.prototype.update, R = lib.rest, hipH = R.hipZ, ankleH = R.ankleZ;\n178:  // the rig's own turn this step (an attack's spin), read before the clip turns it: solvePose can run more than once a step\n180:  rig.solvePose = function () {\n182:    const pose = this.mocap, w = this.mocapW === undefined ? 1 : Math.max(0, Math.min(1, this.mocapW));\n185:    const o = this.o, J = this.J, k = o.hipZ / hipH, upper = this.mocapMask === 'upper';\n265:return { load, Mannequin, drive, LEGEND: MR.LEGEND };\n\nZombie_Walk_Loop [\"walk zombie loop\", \"A zombie's shamble: head and shoulders slumped forward, a dragging step, arms hanging. One cycle, in place\"]\nWounded_Walk_Loop [\"walk hurt loop\", \"Limping on a wounded leg: a short careful step on the bad leg, a longer one on the good. One cycle, in place\"]\nRoundhouse_Kick [\"attack kick once\", \"A karate roundhouse kick (mawashi-geri): the leg swings round in an arc at head height\"]\nFront_Kick [\"attack kick once\", \"A karate front kick (mae-geri): knee up, foot snapped straight ahead, back to the stance\"]\nFall_On_Face [\"death hurt once\", \"Toppling forward flat onto the face\"]\nGet_Up_Face_Down [\"getup once\", \"Getting up from lying face down: push up on the arms, a knee under, stand\"]\nClimb_Ladder [\"climb once\", \"Climbing a ladder hand over hand, rising about a step a second (no ladder is drawn)\"]\nFrankenstein_Walk_Loop [\"walk monster zombie loop\", \"Frankenstein's monster: stiff legs, arms held straight out ahead, a heavy lurching walk. One cycle, in place\"]\nChop_Wood [\"work once\", \"Chopping wood: an axe raised overhead in both hands and brought down hard, again and again (no axe is drawn)\"]\nSearch_Ground [\"interact crouch once\", \"Crouching to search the ground, peering about and poking at it\"]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DZg36DkDgVJuxLmHQWq5Bu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjAQgJKeBHzFUarTfw2m","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0182D7ZtjBzh7fDma7cXQK57","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211953__xee4d12/work/_research/engine/src/starter3d/30-shooter.js","offset":648,"limit":75},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15057,"cache_read_input_tokens":255264,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15057},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"23de6e6b-3ae6-4bf5-9764-44b18bb5857c","uuid":"820bd9fa-8d1a-4f09-826a-94c3217775c2","timestamp":"2026-11-05T04:38:38.443Z","request_id":"req_011CgjAQfziTTYtDotqBGSGX","wire_tool_inputs":{"toolu_0182D7ZtjBzh7fDma7cXQK57":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211953__xee4d12/work/_research/engine/src/starter3d/30-shooter.js","offset":648,"limit":75}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0182D7ZtjBzh7fDma7cXQK57","type":"tool_result","content":"648\t  /* =====================================================================\n649\t   * THE SOLDIER: a procedural skeleton posed every frame from what the body is doing (its speed and heading, crouch,\n650\t   * slide, air, the ledge or wall or rung or cable it holds, the gun's pose: aim, recoil, reload, a punch, a kick,\n651\t   * a throw, a hit, a death), then drawn with the pen (boots, pads, plates, pouches, a helmet and visor). The player in\n652\t   * third person, the raiders and the range's dummies are all soldiers\n653\t   * ===================================================================== */\n654\t  const v3 = (x = 0, y = 0, z = 0) => [x, y, z];\n655\t  const add = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];\n656\t  const sub = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\n657\t  const mul = (a, k) => [a[0] * k, a[1] * k, a[2] * k];\n658\t  const dot = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];\n659\t  const cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];\n660\t  const nrm = a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\n661\t  const mixv = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\n662\t  const UP = [0, 0, 1], ease = t => t * t * (3 - 2 * t), win = (t, a, b) => ease(clamp((t - a) / (b - a), 0, 1));\n663\t  /** a point in a frame: o + f*a + u*b + r*c */\n664\t  const at = (F, a, b, c = 0) => [F.o[0] + F.f[0] * a + F.u[0] * b + F.r[0] * c, F.o[1] + F.f[1] * a + F.u[1] * b + F.r[1] * c, F.o[2] + F.f[2] * a + F.u[2] * b + F.r[2] * c];\n665\t  /** a frame looking along yaw and pitch (and rolled): { o, f (ahead), u (up), r (right) } */\n666\t  function frameYP(o, yaw, pitch, roll = 0) {\n667\t    const cp = Math.cos(pitch), f = [Math.cos(yaw) * cp, Math.sin(yaw) * cp, Math.sin(pitch)], r0 = [-Math.sin(yaw), Math.cos(yaw), 0], u0 = cross(f, r0);\n668\t    const cr = Math.cos(roll), sr = Math.sin(roll);\n669\t    return { o, f, u: add(mul(u0, cr), r0, -sr), r: add(mul(r0, cr), u0, sr) };\n670\t  }\n671\t  /** turn a frame about its own axes: pitch (about r: the muzzle up), yaw (about u: to the right), roll (about f) */\n672\t  function turn(F, pitch, yaw, roll) {\n673\t    let { f, u, r } = F;\n674\t    if (pitch) { const c = Math.cos(pitch), s = Math.sin(pitch); [f, u] = [add(mul(f, c), u, s), add(mul(u, c), f, -s)]; }\n675\t    if (yaw) { const c = Math.cos(yaw), s = Math.sin(yaw); [f, r] = [add(mul(f, c), r, s), add(mul(r, c), f, -s)]; }\n676\t    if (roll) { const c = Math.cos(roll), s = Math.sin(roll); [u, r] = [add(mul(u, c), r, s), add(mul(r, c), u, -s)]; }\n677\t    return { o: F.o, f, u, r };\n678\t  }\n679\t  /** two-bone IK: the joint between a (a hip, a shoulder) and the end b, bending toward hint; b pulled in if too far */\n680\t  function ik(a, b, L1, L2, hint) {\n681\t    let d = sub(b, a), dist = Math.hypot(...d); const mx = (L1 + L2) * .999;\n682\t    if (dist > mx) { d = mul(d, mx / dist); b = add(a, d); dist = mx; }\n683\t    dist = Math.max(dist, .01); const n = mul(d, 1 / dist);\n684\t    let h = sub(hint, mul(n, dot(hint, n))); const hl = Math.hypot(...h); h = hl < 1e-4 ? [n[1], -n[0], 0] : mul(h, 1 / hl);\n685\t    const x = (L1 * L1 - L2 * L2 + dist * dist) / (2 * dist), y = Math.sqrt(Math.max(0, L1 * L1 - x * x));\n686\t    return [add(add(a, n, x), h, y), b];\n687\t  }\n688\t  /** a spring toward a target: s = { x, v } (or arrays of them); k stiffness, d damping */\n689\t  const spring = (s, target, k, d, dt) => { s.v += (k * (target - s.x) - d * s.v) * dt; s.x += s.v * dt; return s.x; };\n690\t  const SPR = () => ({ x: 0, v: 0 });\n691\t\n692\t  const LOOKS = {\n693\t    player: { cloth: '#4a5440', plate: '#cbb48a', dark: '#2c3036', glove: '#33302c', helmet: '#4a5058', visor: '#6ef0ff', skin: '#c89a78', boot: '#2a2622', accent: '#e8742a', pack: '#3a3f36' },\n694\t    raider: { cloth: '#6e3a2a', plate: '#3c3632', dark: '#262224', glove: '#2a2420', helmet: '#d8cfbc', visor: '#ff3a2a', skin: '#a87a5a', boot: '#221e1c', accent: '#c8a03a', pack: '#4a3a2e', mask: true },\n695\t    heavy: { cloth: '#4a3a4a', plate: '#5a5048', dark: '#24222a', glove: '#2a2428', helmet: '#3a3438', visor: '#c86aff', skin: '#a87a5a', boot: '#221e1c', accent: '#b05ae8', pack: '#3a3240' },\n696\t    dummy: { cloth: '#8a8c94', plate: '#e8e4dc', dark: '#4a4c54', glove: '#5a5c64', helmet: '#e8e4dc', visor: '#ffb347', skin: '#d8d4cc', boot: '#3a3c44', accent: '#ff5a2a', pack: '#6a6c74', dummy: true }\n697\t  };\n698\t  /** a new soldier's body: what the game sets (x, y, z, yaw, aim, velocity, move, the gun's state) and the springs and\n699\t   *  phases its pose keeps */\n700\t  function body(look, k = 1) {\n701\t    return { look: LOOKS[look], k, x: 0, y: 0, z: 0, yaw: 0, aimYaw: 0, aimPitch: 0, vx: 0, vy: 0, vz: 0, grounded: true, move: 'stand', sprint: false, ads: false, weapon: 'rifle',\n702\t      act: null, actT: 0, ledge: null, wallN: null, zipP: null, ladder: null, dead: null, hit: [0, 0, 0], flinch: 0, fire: 0, visible: true, onGround: null,\n703\t      // pose state\n704\t      ph: 0, amp: 0, cr: 0, sl: 0, air: 0, adsB: 0, spB: 0, leanF: SPR(), leanS: SPR(), dip: SPR(), jx: SPR(), jy: SPR(), jz: SPR(), rec: SPR(), pvx: 0, pvy: 0, twist: 0, J: null, G: null, feet: [null, null], stance: null, low: false, lowB: 0 };\n705\t  }\n706\t  /** joints that would jump when what they do changes (a stride ends, a slide starts, a ledge is caught or let go) go\n707\t   *  there over dur seconds from where they were, carried along with the body (key: what they do now) */\n708\t  function settle(b, name, key, pts, dt, dur = .12) {\n709\t    const o = [b.x, b.y, b.z], s = b[name] || (b[name] = { key, last: null, from: null, t: 0 });\n710\t    if (key !== s.key && s.last) { s.from = s.last; s.t = 0; } s.key = key;\n711\t    if (s.from) { s.t += dt; const u = ease(clamp(s.t / dur, 0, 1)); for (let i = 0; i < pts.length; i++) if (pts[i] && s.from[i]) pts[i] = mixv(add(o, s.from[i]), pts[i], u); if (u >= 1) s.from = null; }\n712\t    s.last = pts.map(q => q && sub(q, o));\n713\t  }\n714\t  /** the ground under a foot: the level's (the terrain, a floor, a roof) by a short ray down, else the body's own */\n715\t  function footGround(world, b, x, y) {\n716\t    const h = world.ray(x, y, b.z + 14 * b.k, 0, 0, -1, 30 * b.k, { level: true });\n717\t    return h ? h.z : b.z;\n718\t  }\n719\t  /** pose a soldier for this frame (dt: game seconds since the last pose). Sets b.J (joints) and b.G (the gun's frame) */\n720\t  function pose(world, b, dt) {\n721\t    const k = b.k, LT = 7.4 * k, LS = 7.1 * k, LU = 4.9 * k, LF = 4.7 * k, sp = Math.hypot(b.vx, b.vy), fine = b.visible;\n722\t    // the blends, eased toward what the body is doing"}]},"parent_tool_use_id":null,"session_id":"23de6e6b-3ae6-4bf5-9764-44b18bb5857c","uuid":"a97ff23c-981f-48b2-958d-d0b0778ed985","timestamp":"2026-11-05T04:38:38.460Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211953__xee4d12/work/_research/engine/src/starter3d/30-shooter.js","content":"  /* =====================================================================\n   * THE SOLDIER: a procedural skeleton posed every frame from what the body is doing (its speed and heading, crouch,\n   * slide, air, the ledge or wall or rung or cable it holds, the gun's pose: aim, recoil, reload, a punch, a kick,\n   * a throw, a hit, a death), then drawn with the pen (boots, pads, plates, pouches, a helmet and visor). The player in\n   * third person, the raiders and the range's dummies are all soldiers\n   * ===================================================================== */\n  const v3 = (x = 0, y = 0, z = 0) => [x, y, z];\n  const add = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];\n  const sub = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\n  const mul = (a, k) => [a[0] * k, a[1] * k, a[2] * k];\n  const dot = (a, b) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];\n  const cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];\n  const nrm = a => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\n  const mixv = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];\n  const UP = [0, 0, 1], ease = t => t * t * (3 - 2 * t), win = (t, a, b) => ease(clamp((t - a) / (b - a), 0, 1));\n  /** a point in a frame: o + f*a + u*b + r*c */\n  const at = (F, a, b, c = 0) => [F.o[0] + F.f[0] * a + F.u[0] * b + F.r[0] * c, F.o[1] + F.f[1] * a + F.u[1] * b + F.r[1] * c, F.o[2] + F.f[2] * a + F.u[2] * b + F.r[2] * c];\n  /** a frame looking along yaw and pitch (and rolled): { o, f (ahead), u (up), r (right) } */\n  function frameYP(o, yaw, pitch, roll = 0) {\n    const cp = Math.cos(pitch), f = [Math.cos(yaw) * cp, Math.sin(yaw) * cp, Math.sin(pitch)], r0 = [-Math.sin(yaw), Math.cos(yaw), 0], u0 = cross(f, r0);\n    const cr = Math.cos(roll), sr = Math.sin(roll);\n    return { o, f, u: add(mul(u0, cr), r0, -sr), r: add(mul(r0, cr), u0, sr) };\n  }\n  /** turn a frame about its own axes: pitch (about r: the muzzle up), yaw (about u: to the right), roll (about f) */\n  function turn(F, pitch, yaw, roll) {\n    let { f, u, r } = F;\n    if (pitch) { const c = Math.cos(pitch), s = Math.sin(pitch); [f, u] = [add(mul(f, c), u, s), add(mul(u, c), f, -s)]; }\n    if (yaw) { const c = Math.cos(yaw), s = Math.sin(yaw); [f, r] = [add(mul(f, c), r, s), add(mul(r, c), f, -s)]; }\n    if (roll) { const c = Math.cos(roll), s = Math.sin(roll); [u, r] = [add(mul(u, c), r, s), add(mul(r, c), u, -s)]; }\n    return { o: F.o, f, u, r };\n  }\n  /** two-bone IK: the joint between a (a hip, a shoulder) and the end b, bending toward hint; b pulled in if too far */\n  function ik(a, b, L1, L2, hint) {\n    let d = sub(b, a), dist = Math.hypot(...d); const mx = (L1 + L2) * .999;\n    if (dist > mx) { d = mul(d, mx / dist); b = add(a, d); dist = mx; }\n    dist = Math.max(dist, .01); const n = mul(d, 1 / dist);\n    let h = sub(hint, mul(n, dot(hint, n))); const hl = Math.hypot(...h); h = hl < 1e-4 ? [n[1], -n[0], 0] : mul(h, 1 / hl);\n    const x = (L1 * L1 - L2 * L2 + dist * dist) / (2 * dist), y = Math.sqrt(Math.max(0, L1 * L1 - x * x));\n    return [add(add(a, n, x), h, y), b];\n  }\n  /** a spring toward a target: s = { x, v } (or arrays of them); k stiffness, d damping */\n  const spring = (s, target, k, d, dt) => { s.v += (k * (target - s.x) - d * s.v) * dt; s.x += s.v * dt; return s.x; };\n  const SPR = () => ({ x: 0, v: 0 });\n\n  const LOOKS = {\n    player: { cloth: '#4a5440', plate: '#cbb48a', dark: '#2c3036', glove: '#33302c', helmet: '#4a5058', visor: '#6ef0ff', skin: '#c89a78', boot: '#2a2622', accent: '#e8742a', pack: '#3a3f36' },\n    raider: { cloth: '#6e3a2a', plate: '#3c3632', dark: '#262224', glove: '#2a2420', helmet: '#d8cfbc', visor: '#ff3a2a', skin: '#a87a5a', boot: '#221e1c', accent: '#c8a03a', pack: '#4a3a2e', mask: true },\n    heavy: { cloth: '#4a3a4a', plate: '#5a5048', dark: '#24222a', glove: '#2a2428', helmet: '#3a3438', visor: '#c86aff', skin: '#a87a5a', boot: '#221e1c', accent: '#b05ae8', pack: '#3a3240' },\n    dummy: { cloth: '#8a8c94', plate: '#e8e4dc', dark: '#4a4c54', glove: '#5a5c64', helmet: '#e8e4dc', visor: '#ffb347', skin: '#d8d4cc', boot: '#3a3c44', accent: '#ff5a2a', pack: '#6a6c74', dummy: true }\n  };\n  /** a new soldier's body: what the game sets (x, y, z, yaw, aim, velocity, move, the gun's state) and the springs and\n   *  phases its pose keeps */\n  function body(look, k = 1) {\n    return { look: LOOKS[look], k, x: 0, y: 0, z: 0, yaw: 0, aimYaw: 0, aimPitch: 0, vx: 0, vy: 0, vz: 0, grounded: true, move: 'stand', sprint: false, ads: false, weapon: 'rifle',\n      act: null, actT: 0, ledge: null, wallN: null, zipP: null, ladder: null, dead: null, hit: [0, 0, 0], flinch: 0, fire: 0, visible: true, onGround: null,\n      // pose state\n      ph: 0, amp: 0, cr: 0, sl: 0, air: 0, adsB: 0, spB: 0, leanF: SPR(), leanS: SPR(), dip: SPR(), jx: SPR(), jy: SPR(), jz: SPR(), rec: SPR(), pvx: 0, pvy: 0, twist: 0, J: null, G: null, feet: [null, null], stance: null, low: false, lowB: 0 };\n  }\n  /** joints that would jump when what they do changes (a stride ends, a slide starts, a ledge is caught or let go) go\n   *  there over dur seconds from where they were, carried along with the body (key: what they do now) */\n  function settle(b, name, key, pts, dt, dur = .12) {\n    const o = [b.x, b.y, b.z], s = b[name] || (b[name] = { key, last: null, from: null, t: 0 });\n    if (key !== s.key && s.last) { s.from = s.last; s.t = 0; } s.key = key;\n    if (s.from) { s.t += dt; const u = ease(clamp(s.t / dur, 0, 1)); for (let i = 0; i < pts.length; i++) if (pts[i] && s.from[i]) pts[i] = mixv(add(o, s.from[i]), pts[i], u); if (u >= 1) s.from = null; }\n    s.last = pts.map(q => q && sub(q, o));\n  }\n  /** the ground under a foot: the level's (the terrain, a floor, a roof) by a short ray down, else the body's own */\n  function footGround(world, b, x, y) {\n    const h = world.ray(x, y, b.z + 14 * b.k, 0, 0, -1, 30 * b.k, { level: true });\n    return h ? h.z : b.z;\n  }\n  /** pose a soldier for this frame (dt: game seconds since the last pose). Sets b.J (joints) and b.G (the gun's frame) */\n  function pose(world, b, dt) {\n    const k = b.k, LT = 7.4 * k, LS = 7.1 * k, LU = 4.9 * k, LF = 4.7 * k, sp = Math.hypot(b.vx, b.vy), fine = b.visible;\n    // the blends, eased toward what the body is doing","numLines":75,"startLine":648,"totalLines":2089}},"tool_result_meta":[{"id":"toolu_0182D7ZtjBzh7fDma7cXQK57","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
