orch: true },\n    T: { floor: 16, side: 'planks', color: '#6a4a30' }, c: { shape: 'crate' }, B: { shape: 'barrel' }, b: { shape: 'cart', facing: .7 }, f: { shape: 'well' }, w: { shape: 'bench' }, W: { shape: 'fence' }, z: { mark: 'z' }, '@': { mark: 'start' } } };\nlet world, hero, mobs = [], T = 0;\nconst C = { skin: '#d8ae8c', hair: '#3a2a1c', cloth: '#31415a', coat: '#4a3a2c', pants: '#2c2c34', boot: '#1e1a1a', belt: '#3a2a1a', glove: '#222', metal: '#3a3c44', metalDk: '#22232a', hilt: '#2a2a2e' };\nconst VILL = [{ skin: '#b89a80', hair: '#3a3028', cloth: '#6a5a44', pants: '#3a3430', boot: '#231f1b', belt: '#3a2a1c', eye: '#ff5a2a' },\n  { skin: '#a89684', hair: '#20201c', cloth: '#4a5a3a', pants: '#34302c', boot: '#24201c', belt: '#2a2018', eye: '#ff5a2a' },\n  { skin: '#c0a088', hair: '#5a4a34', cloth: '#5a3a3a', pants: '#2e2c30', boot: '#1e1c1a', belt: '#2a2018', eye: '#ff5a2a' }];\nconst play = { pausable: true, view: 'iso',\n  enter() {\n    world.reset(); const s = world.marks.start[0];\n    hero = world.hero({ x: s.x, y: s.y, r: 4.5, half: 9, rig: new E.Humanoid({ weapon: 'gun', build: 'heroic', outfit: 'coat', hair: 'short', sleeves: 'long', colors: C, speedRef: 60 }) });\n    hero.facing = -PI / 2; hero.anim = { point: true, aim: 0 };\n    mobs = world.marks.z.map((m, i) => { const a = world.mob({ x: m.x, y: m.y, r: 5, half: 8, rig: new E.Humanoid({ weapon: i % 2 ? 'sword' : null, build: i % 3 == 2 ? 'bulky' : 'heroic', hunch: .22, lean: .1, hair: i % 2 ? 'short' : 'bald', outfit: i % 2 ? 'shirt' : 'tunic', sleeves: 'long', colors: VILL[i % 3], eyeGlow: '#ff5a2a', speedRef: 30 }) }); a.facing = PI / 2; a.anim = { pose: i % 3 == 0 ? 'cast' : null, expr: 'angry' }; return a; });\n    world.camera.set('fixed'); world.camera.follow(hero);\n  },\n  update(dt) {\n    T += dt; const h = hero, yaw = -PI / 2 + Math.sin(T * .2) * .12, pitch = -.06;\n    h.facing = yaw; h.anim = { point: true, aim: -pitch };\n    const r = [-Math.sin(yaw), Math.cos(yaw)], f = [Math.cos(yaw), Math.sin(yaw)];\n    const px = h.x + r[0] * 9, py = h.y + r[1] * 9, pz = h.z + 28, back = 26;\n    world.camera.fixed = { x: px - f[0] * back, y: py - f[1] * back, z: pz + 2, yaw, pitch, roll: 0, fov: 58 };\n    for (const m of mobs) { const a = Math.atan2(h.y - m.y, h.x - m.x), d = Math.hypot(h.y - m.y, h.x - m.x); m.facing = a; const sp = d > 34 ? 16 : 0; m.vx = Math.cos(a) * sp; m.vy = Math.sin(a) * sp; }\n    world.step(dt);\n  },\n  draw(r) {\n    world.draw(r);\n    r.overlay(g => { E.font.text(g, 'HP', 8, r.H - 30, '#e8e0d0', { outline: '#000' }); E.ui.bar(g, 24, r.H - 30, 70, 7, .72, '#7ac05a'); E.font.text(g, '11 / 34', r.W - 8, r.H - 22, '#fff', { align: 'right', outline: '#000', scale: 2 }); });\n  }\n};\ngame.start({ scenes: { play }, scene: 'play', boot: { steps: [\n  ['3D', () => W3.init(game)],\n  ['Level', () => { world = new W3(game, { level: LEVEL, look: 'puppet', res: 'balanced', sky: ['#2a2a3a', '#a08868'], fog: { color: '#8a7a64', near: 120, far: 560 }, ambient: ['#a0a4b8', '#403428', 1.5], sun: { color: '#ffd8a8', intensity: 2.2, dir: [.6, .35, -.7], area: 320, shadow: true }, torchLights: 2, lights: 2, camera: { mode: 'fixed' },\n    onDraw: (w) => { const h = hero; if (!h) return; const f = [Math.cos(h.facing), Math.sin(h.facing)], rx = -f[1], ry = f[0]; const x = h.x + f[0] * 10 + rx * 3, y = h.y + f[1] * 10 + ry * 3, z = h.z + 19; const hit = w.ray(x, y, z, f[0], f[1], .02, 400, { skip: h }); const L = hit ? hit.dist : 400; w.pen.bar(x, y, z, x + f[0] * L, y + f[1] * L, z + .02 * L, .35, .35, '#ff2a1a'); w.pen.glow(x + f[0] * L, y + f[1] * L, z + .02 * L, 1.2, '#ff3a2a'); } });\n    world.prepare(); }]] } });\nwindow.__spike = { game, get world() { return world; }, get hero() { return hero; }, get mobs() { return mobs; } };\nEOF\ncat > drive_ots.py <<'EOF'\nimport sys, json, time, pathlib\nfrom playwright.sync_api import sync_playwright\npath = pathlib.Path(sys.argv[1]).resolve().as_uri()\nwith sync_playwright() as p:\n    b = 