, 2.2, 1.6, c.boot);\n  }\n  // torso: a smock over the belt, an apron\n  slab(add(pel, [0, 0, .4]), add(che, nrm(sub(che, pel)), -.3), rtP, 6.4, 4.2, c.shirt); slab(add(che, nrm(sub(pel, che)), .6), nek, rt, 6.6, 3.8, c.shirt);\n  slab(add(add(pel, face, 2.3), [0, 0, -5]), add(add(che, face, 2.4), [0, 0, -1]), rtP, 4.8, .5, c.apron);\n  slab(add(pel, rtP, -3), add(pel, rtP, 3), face, 3.4, 4.2, c.belt);\n  for (const s of ['L', 'R']) { const sh = P('sh' + s), el = P('elbow' + s), wr = P('wrist' + s), fi = P('fist' + s); ball(sh, 1.8, c.shirt); tube(sh, el, 1.3, c.shirt); tube(el, wr, 1.05, c.skin); ball(fi, 1.05, c.skin); }\n  // head: neck, skull, jaw, hair or cap, glowing eyes\n  tube(nek, hed, 1, c.skin); const hc = lerp3(hed, top, .45), up = nrm(sub(top, hed));\n  pen.ball(hc[0], hc[1], hc[2], 2.2, 2.2, 2.5, c.skin); const jaw = add(add(hc, up, -1.8), face, .6); pen.ball(jaw[0], jaw[1], jaw[2], 1.5, 1.5, 1.1, c.skin);\n  const cap = add(hc, up, .9); pen.ball(cap[0], cap[1], cap[2], 2.45, 2.45, 1.9, c.hair); slab(add(add(hc, up, 1.5), face, .9), add(add(hc, up, 1.3), face, 3.1), rt, 3.2, .3, c.hair);\n  for (const s of [-1, 1]) { const e = add(add(add(hc, face, 2.05), rt, s * .85), up, .05); pen.glow(e[0], e[1], e[2], .36, '#ff5a2a'); }\n}\nconst CASTC = [{ skin: '#b89a80', hair: '#4a3a24', shirt: '#7a6a4c', pants: '#3a3430', boot: '#231f1b', belt: '#2a2018', apron: '#8a7a64' }, { skin: '#a89684', hair: '#20201c', shirt: '#4a5a3a', pants: '#34302c', boot: '#24201c', belt: '#2a2018', apron: '#5a4a3a' }, { skin: '#c0a088', hair: '#5a2a24', shirt: '#6a3a3a', pants: '#2e2c30', boot: '#1e1c1a', belt: '#2a2018', apron: '#3a3a44' }];\nconst LINE = ['Zombie_Walk_Loop', 'Wounded_Walk_Loop', 'Chop_Wood', 'Roundhouse_Kick', 'Fall_On_Face', 'Get_Up_Face_Down', 'Climb_Ladder', 'Zombie_Scratch'];\nlet world, hero, T = 0, cast = [];\nconst buf = new Float32Array(lib.P * 3);\nconst play = { pausable: true, view: 'iso',\n  enter() { world.reset(); const s = world.marks.start[0]; hero = world.hero({ x: s.x, y: s.y, r: 4.5, half: 9, visible: false, shadow: false });\n    cast = LINE.map((n, i) => ({ clip: lib.clip(n), name: n, x: s.x - 7 * 16 / 2 * 1.0 + i * 16 * 1.0 - 8, y: s.y - 7 * 16, z: 0, yaw: PI / 2, c: CASTC[i % 3], t: i * .3 }));\n    world.camera.set('fixed'); world.camera.follow(hero); },\n  update(dt) { T += dt; for (const a of cast) a.t += dt; const h = hero; world.camera.fixed = { x: h.x + 6, y: h.y + 26, z: h.z + 30, yaw: -PI / 2, pitch: -.06, roll: 0, fov: 58 }; world.step(dt); },\n  draw(r) { world.draw(r); r.overlay(g => E.font.text(g, 'MUSIC ' + game.audio.musicVolume + ' SETTING ' + game.settings.music + ' GLYPH ' + game.input.label('confirm', 'gamepad'), 6, 6, '#fff', { outline: '#000' })); } };\ngame.start({ scenes: { play }, scene: 'play', boot: { steps: [['3D', () => W3.init(game)], ['Level', () => { world = new W3(game, { level: LEVEL, res: 'balanced', sky: ['#2a2a3a', '#a08868'], fog: { color: '#8a7a64', near: 200, far: 700 }, ambient: ['#a0a4b8', '#403428', 1.6], sun: { color: '#ffd8a8', intensity: 2.2, dir: [.6, .35, -.7], area: 300, shadow: true }, camera: { mode: 'fixed' },\n  onDraw: w => { for (const a of cast) { lib.sample(a.clip, a.t % (a.clip.dur + .4), buf); drawVillager(w.pen, a, buf, a.c); } } }); world.prepare(); }]] } });\nwindow.__spike = { game, get world() { return world; }, get hero() { return hero; } };\nEOF\ncat > build2.mjs <<'EOF'\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nconst [R, out, ...parts] = process.argv.slice(2);\nconst classic = [`${R}/dist/my-3d2dge.js`, `${R}/src/mocap/readable.js`, `${R}/src/mocap/mocap.js`, 'spike-clips.js'];\nwriteFileSync('src/entry.js', `import '${R}/dist/my-3d2dge-3d.js';\\n` + parts.map(f => readFileSync(f, 'utf8')).join('\\n'));\nexecFileSync('esbuild', ['src/entry.js', '--bundle', '--format=esm', '--target=es2022', '--legal-comments=none', '--minify-syntax', '--minify-whitespace',\n  `--alias:three/webgpu=${R}/vendor/three-0.182.0/three.webgpu.min.js`, `--alias:three/tsl=${R}/vendor/three-0.182.0/three.tsl.min.js`, `--alias:three=${R}/vendor/three-0.182.0/three.webgpu.min.js`,\n  `--alias:@dimforge/rapier3d-simd-compat=${R}/vendor/rapier3d-simd-compat-0.19.3/rapier.js`, '--outfile=src/bundle.js', '--log-level=warning'], { stdio: 'inherit' });\nconst esc = s => s.replace(/<\\/script/gi, '<\\\\/script');\nconst html = `<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>spike</title><style>html, body { margin: 0; height: 100%; overflow: hidden; background: #000 }</style></head><body>\n<div id=\"stage\" style=\"position:relative;width:100%;height:100%;overflow:hidden\"><canvas id=\"view\"></canvas><canvas id=\"screen\" style=\"position:absolute;inset:0;width:100%;height:100%\"></canvas></div>\n${classic.map(f => `<script>${esc(readFileSync(f, 'utf8'))}</script>`).join('\\n')}\n<script>if(!self.GPUShaderStage)self.GPUShaderStage={VERTEX:1,FRAGMENT:2,COMPUTE:4};</script>\n<script type=\"module\">${esc(readFileSync('src/bundle.js', 'utf8'))}</script></body></html>`;\nwriteFileSync(out, html); console.log('wrote', out, (html.length / 1e6).toFixed(2), 'MB');\nEOF\nnode build2.mjs \"$R\" mocap_pen.html mocap_pen.js; cat > drive_mp.py <<'EOF'\nimport sys, json, time, pathlib\nfrom playwright.sync_api import sync_playwright\npath = pathlib.Path(sys.argv[1]).resolve().as_uri()\nwith sync_playwright() as p:\n    b = p.chromium.launch()\n    pg = b.new_page(viewport={'width': 1280, 'height': 720})\n    errs = []\n    pg.on('pageerror', lambda e: errs.append('pageerror: ' + str(e)[:500]))\n    pg.on('console', lambda m: errs.append(m.type + ': ' + m.text[:500]) if m.type == 'error' else None)\n    pg.goto(path)\n    for i in range(120):\n        if pg.evaluate(\"!!(window.__spike && __spike.hero)\"): break\n        time.sleep(.5)\n    time.sleep(2.5); pg.screenshot(path='mp-1.png')\n    time.sleep(1.3); pg.screenshot(path='mp-2.png')\n    print(pg.evaluate(\"({ music: __spike.game.settings.music, mv: __spike.game.audio.musicVolume, vol: __spike.game.settings.volume, glyphs: __spike.game.settings.glyphs })\"))\n    print(errs[:5])\n    b.close()\nEOF\ntimeout 120 python3 drive_mp.py mocap_pen.html","description":"Test motion clips driving a pen-drawn villager body","timeout":180000}}}
