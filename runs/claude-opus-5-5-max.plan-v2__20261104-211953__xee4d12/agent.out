, FRAGMENT: 2, COMPUTE: 4 };</script>\n<script type=\"module\">${esc(readFileSync('src/bundle.js', 'utf8'))}</script></body></html>`);\nEOF\nnode build4.mjs \"$R\" horror2.html \"$R/src/starter3d/00-shell.js\" \"$R/src/starter3d/05-families.js\" \"$R/src/starter3d/40-horror.js\" \"$R/src/starter3d/90-start.js\"; cat > hash.py <<'EOF'\nimport sys, json, time, pathlib\nfrom playwright.sync_api import sync_playwright\npath = pathlib.Path('horror2.html').resolve().as_uri()\nwhich = sys.argv[1]\nwith sync_playwright() as p:\n    kw = {}\n    if which == 'webgpu': kw['args'] = ['--enable-unsafe-webgpu', '--enable-features=Vulkan', '--use-vulkan=swiftshader', '--use-webgpu-adapter=swiftshader', '--disable-vulkan-surface']\n    if which == 'firefox': kw = dict(headless=False, firefox_user_prefs={'webgl.force-enabled': True})\n    b = getattr(p, 'chromium' if which in ('webgl', 'webgpu') else which).launch(**kw)\n    pg = b.new_page(viewport={'width': 800, 'height': 450})\n    if which == 'webgpu': pg.add_init_script(path='../dryrun/plan-files/standin.js')\n    pg.goto(path + '#horror')\n    ok = False\n    for i in range(240):\n        ok = pg.evaluate(\"!!(window.__game && window.My3D2dge && My3D2dge.World3D && My3D2dge.World3D.backend && window.__game.scenes.horror && window.__game.scenes.horror.world && window.__game.scenes.horror.hero)\")\n        if ok: break\n        time.sleep(.25)\n    r = pg.evaluate(\"(() => { const H = __game.scenes.horror; return { backend: My3D2dge.World3D.backend, a: H.run(600), b: H.run(600), v: My3D2dge.version }; })()\") if ok else None\n    print(which, json.dumps(r), flush=True)\n    b.close()\nEOF\nfor w in webgl webgpu webkit; do timeout 100 python3 hash.py $w 2>&1 | tail -1 | cut -c1-200; done; timeout 110 xvfb-run -a python3 hash.py firefox 2>&1 | tail -1 | cut -c1-200","description":"Re-verify cross-browser determinism on the current engine","timeout":450000}}}
