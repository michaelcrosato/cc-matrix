{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FbP4SzNXrW7mSFnT1oE6td","type":"tool_result","content":"20:const POINTS = ['pelvis', 'spine1', 'spine2', 'chest', 'neck', 'head', 'headTop', 'faceF', 'chestF', 'pelvisF',\n22:const IDX = {}; POINTS.forEach((p, i) => IDX[p] = i);\n23:const P = POINTS.length;\n125:const pt = (X, n) => { const i = IDX[n] * 3; return [X[i], X[i + 1], X[i + 2]]; };\n134:const SHOWN = POINTS.map((p, i) => /^(index|pinky)/.test(p) ? -1 : i * 3).filter(i => i >= 0);\n236:  const D = derived(R), tq = torso(R, k), set = (n, v) => { const i = IDX[n] * 3; out[i] = v[0]; out[i + 1] = v[1]; out[i + 2] = v[2]; };\n337:return { POINTS, IDX, P, LEGEND, measure, fit, encode, pose, moveAt, keyAt, text, parse, mirror, error, meanError, capSample, reduce };\n/* =============================================================================\n * READABLE KEY POSES: the animation format my-3D2dge stores, and the one AI models (and people) read and edit.\n * A clip is a short list of key poses. Each pose names what an animator would: where the hips are, how the body,\n * chest and head turn and lean, how the shoulders reach and shrug, which way each arm and leg points with how much\n * elbow or knee bend, and how the feet point. It does not depend on body size, so the same clip fits any build, and\n * it mirrors by swapping L and R. Limbs are a direction plus a bend, not joint angles: an arm swinging through\n * straight down has no angle that flips, a bend in degrees rounds well, and an IK rig consumes exactly this.\n *\n * Shared by tools/anim-import.mjs (Node: it measures a captured body, fits each clip, writes the set) and the\n * browser (src/mocap/mocap.js: it rebuilds every body point from a set to draw or drive a rig). No dependencies.\n *   const rest = MocapReadable.measure(captureClips)          // a body's proportions, from its own clips\n *   const { clip } = MocapReadable.fit(rest, capClip, 30)     // key poses within 30 mm of the capture\n *   MocapReadable.text(clip)  MocapReadable.parse(text)  MocapReadable.mirror(clip)\n *   MocapReadable.pose(rest, clip, t, out)                    // 36 body points (mm) at time t\n * ============================================================================= */\nvar MocapReadable = (() => {\n'use strict';\n\n/** the body points a pose rebuilds, in the rig's local frame (f forward, r right, z up), millimetres */\nconst POINTS = ['pelvis', 'spine1', 'spine2', 'chest', 'neck', 'head', 'headTop', 'faceF', 'chestF', 'pelvisF',\n  ...['L', 'R'].flatMap(s => ['clav', 'sh', 'elbow', 'wrist', 'index', 'knuck', 'pinky', 'fist', 'hip', 'knee', 'ankle', 'ball', 'toe'].map(p => p + s))];\nconst IDX = {}; POINTS.forEach((p, i) => IDX[p] = i);\nconst P = POINTS.length;\n\nconst LEGEND = `// my-3D2dge readable clip. Times in seconds; every other number is a whole number. Rig frame: forward, right, up.\n// L and R are the figure's own sides. Directions are percentages and need not add up: [100, 0, 0] and [50, 0, 0] agree.\n// hips   [forward, right, up]   the pelvis, in percent of standing hip height (100 = standing, 55 = sitting on a chair)\n// body   [turn, lean, tilt]     the pelvis, degrees: turn + = toward the right, lean + = forward, tilt + = toward the right\n// chest  [turn, lean, tilt]     the chest, relative to the pelvis        head [turn, lean, tilt]  relative to the chest\n// shL shR    [reach, shrug]     degrees the shoulder swings forward (into a punch or an aim) and up, from rest\n// A smaller animation set from bigger ones: the clips a game adopts (for example a hero's), with the records of the\n// libraries they came from (their proportions and origins) and the mannequin's look. No source files needed: it reads\n// and writes readable set files. The first set's first library gives the proportions every clip is rebuilt on.\n// Usage: node tools/anim-set.mjs src/mocap/sets/quaternius.js [src/mocap/sets/mesh2motion.js ...] --clips Death01,Land_Three_Point,...\n//          --name HERO --out src/mocap/sets/hero.js [--credit \"...\"] [--title Hero]\n// A clip name found in more than one of the sets is picked as SET:Clip (QUATERNIUS:Interact).\nimport { resolve } from 'node:path';\nimport { readSet, writeSet } from './mocap-lib.mjs';\n\nconst args = process.argv.slice(2), opt = name => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : undefined; };\nconst files = args.filter((a, i) => !a.startsWith('--') && !(args[i - 1] || '').startsWith('--'));\nif (!files.length || !opt('clips') || !opt('name') || !opt('out')) { console.error('Usage: node tools/anim-set.mjs a.js [b.js ...] --clips A,SET:B --name NAME --out out.js [--credit \"...\"] [--title Ti\nconst srcs = files.map(f => readSet(resolve(f))), clips = {}, fit = {}, used = new Set(), from = [];\nfor (const want of opt('clips').split(',')) {\n  const [setName, clipName] = want.includes(':') ? want.split(':') : [null, want];\n  const hits = srcs.filter(S => (!setName || S.set === setName) && S.clips[clipName]);\n  if (!hits.length) { console.error('no clip ' + want + ' in ' + srcs.map(S => S.set).join(', ')); process.exit(1); }\n  if (hits.length > 1) { console.error(clipName + ' is in ' + hits.map(S => S.set).join(' and ') + ': pick one as SET:' + clipName); process.exit(1); }\n  const S = hits[0], c = S.clips[clipName];\n  if (clips[clipName]) { console.error(clipName + ' is picked twice'); process.exit(1); }\n  if (!S.sources[c.src]) { console.error(S.set + ' ' + clipName + ': its library ' + c.src + ' is not on record'); process.exit(1); }\n  clips[clipName] = c; fit[clipName] = S.fit[clipName]; used.add(S.set + '/' + c.src); if (!from.includes(S.set)) from.push(S.set);\n}\n// the libraries the picked clips came from, with their records; the first set's first library leads (its proportions)\nconst sources = {}, first = srcs[0], lead = Object.keys(first.sources)[0];\nsources[lead] = first.sources[lead];\nfor (const S of srcs) for (const [id, rec] of Object.entries(S.sources)) if (used.has(S.set + '/' + id)) {\n  if (sources[id] && sources[id] !== rec) { console.error('two sets name a library ' + id + ': rename one'); process.exit(1); }\n  sources[id] = rec;\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"23de6e6b-3ae6-4bf5-9764-44b18bb5857c","uuid":"08b35f61-e812-4b28-a8f8-f1ff689d9f78","timestamp":"2026-11-05T04:38:52.153Z","tool_use_result":{"stdout":"20:const POINTS = ['pelvis', 'spine1', 'spine2', 'chest', 'neck', 'head', 'headTop', 'faceF', 'chestF', 'pelvisF',\n22:const IDX = {}; POINTS.forEach((p, i) => IDX[p] = i);\n23:const P = POINTS.length;\n125:const pt = (X, n) => { const i = IDX[n] * 3; return [X[i], X[i + 1], X[i + 2]]; };\n134:const SHOWN = POINTS.map((p, i) => /^(index|pinky)/.test(p) ? -1 : i * 3).filter(i => i >= 0);\n236:  const D = derived(R), tq = torso(R, k), set = (n, v) => { const i = IDX[n] * 3; out[i] = v[0]; out[i + 1] = v[1]; out[i + 2] = v[2]; };\n337:return { POINTS, IDX, P, LEGEND, measure, fit, encode, pose, moveAt, keyAt, text, parse, mirror, error, meanError, capSample, reduce };\n/* =============================================================================\n * READABLE KEY POSES: the animation format my-3D2dge stores, and the one AI models (and people) read and edit.\n * A clip is a short list of key poses. Each pose names what an animator would: where the hips are, how the body,\n * chest and head turn and lean, how the shoulders reach and shrug, which way each arm and leg points with how much\n * elbow or knee bend, and how the feet point. It does not depend on body size, so the same clip fits any build, and\n * it mirrors by swapping L and R. Limbs are a direction plus a bend, not joint angles: an arm swinging through\n * straight down has no angle that flips, a bend in degrees rounds well, and an IK rig consumes exactly this.\n *\n * Shared by tools/anim-import.mjs (Node: it measures a captured body, fits each clip, writes the set) and the\n * browser (src/mocap/mocap.js: it rebuilds every body point from a set to draw or drive a rig). No dependencies.\n *   const rest = MocapReadable.measure(captureClips)          // a body's proportions, from its own clips\n *   const { clip } = MocapReadable.fit(rest, capClip, 30)     // key poses within 30 mm of the capture\n *   MocapReadable.text(clip)  MocapReadable.parse(text)  MocapReadable.mirror(clip)\n *   MocapReadable.pose(rest, clip, t, out)                    // 36 body points (mm) at time t\n * ============================================================================= */\nvar MocapReadable = (() => {\n'use strict';\n\n/** the body points a pose rebuilds, in the rig's local frame (f forward, r right, z up), millimetres */\nconst POINTS = ['pelvis', 'spine1', 'spine2', 'chest', 'neck', 'head', 'headTop', 'faceF', 'chestF', 'pelvisF',\n  ...['L', 'R'].flatMap(s => ['clav', 'sh', 'elbow', 'wrist', 'index', 'knuck', 'pinky', 'fist', 'hip', 'knee', 'ankle', 'ball', 'toe'].map(p => p + s))];\nconst IDX = {}; POINTS.forEach((p, i) => IDX[p] = i);\nconst P = POINTS.length;\n\nconst LEGEND = `// my-3D2dge readable clip. Times in seconds; every other number is a whole number. Rig frame: forward, right, up.\n// L and R are the figure's own sides. Directions are percentages and need not add up: [100, 0, 0] and [50, 0, 0] agree.\n// hips   [forward, right, up]   the pelvis, in percent of standing hip height (100 = standing, 55 = sitting on a chair)\n// body   [turn, lean, tilt]     the pelvis, degrees: turn + = toward the right, lean + = forward, tilt + = toward the right\n// chest  [turn, lean, tilt]     the chest, relative to the pelvis        head [turn, lean, tilt]  relative to the chest\n// shL shR    [reach, shrug]     degrees the shoulder swings forward (into a punch or an aim) and up, from rest\n// A smaller animation set from bigger ones: the clips a game adopts (for example a hero's), with the records of the\n// libraries they came from (their proportions and origins) and the mannequin's look. No source files needed: it reads\n// and writes readable set files. The first set's first library gives the proportions every clip is rebuilt on.\n// Usage: node tools/anim-set.mjs src/mocap/sets/quaternius.js [src/mocap/sets/mesh2motion.js ...] --clips Death01,Land_Three_Point,...\n//          --name HERO --out src/mocap/sets/hero.js [--credit \"...\"] [--title Hero]\n// A clip name found in more than one of the sets is picked as SET:Clip (QUATERNIUS:Interact).\nimport { resolve } from 'node:path';\nimport { readSet, writeSet } from './mocap-lib.mjs';\n\nconst args = process.argv.slice(2), opt = name => { const i = args.indexOf('--' + name); return i >= 0 ? args[i + 1] : undefined; };\nconst files = args.filter((a, i) => !a.startsWith('--') && !(args[i - 1] || '').startsWith('--'));\nif (!files.length || !opt('clips') || !opt('name') || !opt('out')) { console.error('Usage: node tools/anim-set.mjs a.js [b.js ...] --clips A,SET:B --name NAME --out out.js [--credit \"...\"] [--title Ti\nconst srcs = files.map(f => readSet(resolve(f))), clips = {}, fit = {}, used = new Set(), from = [];\nfor (const want of opt('clips').split(',')) {\n  const [setName, clipName] = want.includes(':') ? want.split(':') : [null, want];\n  const hits = srcs.filter(S => (!setName || S.set === setName) && S.clips[clipName]);\n  if (!hits.length) { console.error('no clip ' + want + ' in ' + srcs.map(S => S.set).join(', ')); process.exit(1); }\n  if (hits.length > 1) { console.error(clipName + ' is in ' + hits.map(S => S.set).join(' and ') + ': pick one as SET:' + clipName); process.exit(1); }\n  const S = hits[0], c = S.clips[clipName];\n  if (clips[clipName]) { console.error(clipName + ' is picked twice'); process.exit(1); }\n  if (!S.sources[c.src]) { console.error(S.set + ' ' + clipName + ': its library ' + c.src + ' is not on record'); process.exit(1); }\n  clips[clipName] = c; fit[clipName] = S.fit[clipName]; used.add(S.set + '/' + c.src); if (!from.includes(S.set)) from.push(S.set);\n}\n// the libraries the picked clips came from, with their records; the first set's first library leads (its proportions)\nconst sources = {}, first = srcs[0], lead = Object.keys(first.sources)[0];\nsources[lead] = first.sources[lead];\nfor (const S of srcs) for (const [id, rec] of Object.entries(S.sources)) if (used.has(S.set + '/' + id)) {\n  if (sources[id] && sources[id] !== rec) { console.error('two sets name a library ' + id + ': rename one'); process.exit(1); }\n  sources[id] = rec;\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01FbP4SzNXrW7mSFnT1oE6td","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjATaomHkBFdBcJiCnfo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0185caEmmvWHAqBTP4BGSnfz","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211953__xee4d12/work/_research/spike; R=$(cd ../engine && pwd); node \"$R/tools/anim-set.mjs\" \"$R/src/mocap/sets/cmu.js\" \"$R/src/mocap/sets/quaternius.js\" --clips CMU:Zombie_Walk_Loop,CMU:Wounded_Walk_Loop,CMU:Roundhouse_Kick,CMU:Fall_On_Face,CMU:Get_Up_Face_Down,CMU:Climb_Ladder,CMU:Chop_Wood,QUATERNIUS:Pistol_Aim_Neutral,QUATERNIUS:Pistol_Reload,QUATERNIUS:Zombie_Scratch --name SPIKE --out spike-clips.js 2>&1 | tail -2; ls -la spike-clips.js; cat > mocap_pen.js <<'EOF'\nconst E = My3D2dge, W3 = E.World3D, PI = Math.PI;\nconst game = new E.Game({ canvas: 'screen', res: 'ps1', expand: true, bg: null, input: Object.assign({}, W3.INPUT), touch: 'never',\n  menu: { settings: [...W3.SETTINGS, { key: 'music', value: .1 }, { key: 'glyphs', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox']] }] } });\nconst LEVEL = { rows: [\n  '##############################', '#............................#', '#....####......####..........#', '#....#..#......#..#..........#', '#....####......####..........#',\n  '#............................#', '#............................#', '#............................#', '#............................#', '#............................#', '#..............@.............#', '#............................#', '##############################'],\n  ground: 'dirt', colors: { base: '#5e4a34', dark: '#4e3c2a', light: '#6e5a42' }, legend: { '@': { mark: 'start' }, '#': { wall: 48, side: 'brick', color: '#7a6e5e' } } };\nconst lib = Mocap.load(window.MOCAP.SPIKE), I = lib.idx, K = 26 / 1829 * 1.0;   // mm to engine units: a 1.83 m clip body stands 29 units\nconst v = (X, n) => { const i = I[n] * 3; return [X[i], X[i + 1], X[i + 2]]; };\nconst add = (a, b, k = 1) => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k], sub = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]], mul = (a, k) => [a[0] * k, a[1] * k, a[2] * k], nrm = a => { const l = Math.hypot(...a) || 1; return mul(a, 1 / l); }, cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]], lerp3 = (a, b, t) => add(a, sub(b, a), t);\n/** a body point in the world: local f, r, z (mm) on an actor at x, y, z facing yaw */\nconst W = (a, p) => { const c = Math.cos(a.yaw), s = Math.sin(a.yaw), f = p[0] * K, r = p[1] * K, z = p[2] * K; return [a.x + c * f - s * r, a.y + s * f + c * r, a.z + z]; };\nfunction drawVillager(pen, a, X, c) {\n  const P = n => W(a, v(X, n)), tube = (p, q, r, col) => pen.tube(p[0], p[1], p[2], q[0], q[1], q[2], r, col), ball = (p, r, col) => pen.ball(p[0], p[1], p[2], r, r, r, col);\n  const slab = (p, q, ac, w, t, col) => pen.slab(p[0], p[1], p[2], q[0], q[1], q[2], ac[0], ac[1], ac[2], w, t, col);\n  const pel = P('pelvis'), che = P('chest'), nek = P('neck'), hed = P('head'), top = P('headTop'), face = nrm(sub(P('faceF'), hed)), rt = nrm(sub(P('shR'), P('shL'))), rtP = nrm(sub(P('hipR'), P('hipL')));\n  for (const s of ['L', 'R']) {   // legs: boots, trousers\n    const hip = P('hip' + s), kn = P('knee' + s), an = P('ankle' + s), toe = P('toe' + s), ballf = P('ball' + s);\n    tube(hip, kn, 1.9, c.pants); tube(kn, an, 1.35, c.pants); ball(kn, 1.5, c.pants);\n    slab(lerp3(an, kn, .25), an, rt, 2.2, 2.2, c.boot); slab(add(an, [0, 0, -.5]), add(toe, [0, 0, .4]), rt, 2.2, 1.6, c.boot);\n  }\n  // torso: a smock over the belt, an apron\n  slab(add(pel, [0, 0, .4]), add(che, nrm(sub(che, pel)), -.3), rtP, 6.4, 4.2, c.shirt); slab(add(che, nrm(sub(pel, che)), .6), nek, rt, 6.6, 3.8, c.shirt);\n  slab(add(add(pel, face, 2.3), [0, 0, -5]), add(add(che, face, 2.4), [0, 0, -1]), rtP, 4.8, .5, c.apron);\n  slab(add(pel, rtP, -3), add(pel, rtP, 3), face, 3.4, 4.2, c.belt);\n  for (const s of ['L', 'R']) { const sh = P('sh' + s), el = P('elbow' + s), wr = P('wrist' + s), fi = P('fist' + s); ball(sh, 1.8, c.shirt); tube(sh, el, 1.3, c.shirt); tube(el, wr, 1.05, c.skin); ball(fi, 1.05, c.skin); }\n  // head: neck, skull, jaw, hair or cap, glowing eyes\n  tube(nek, hed, 1, c.skin); const hc = lerp3(hed, top, .45), up = nrm(sub(top, hed));\n  pen.ball(hc[0], hc[1], hc[2], 2.2, 2.2, 2.5, c.skin); const jaw = add(add(hc, up, -1.8), face, .6); pen.ball(jaw[0], jaw[1], jaw[2], 1.5, 1.5, 1.1, c.skin);\n  const cap = add(hc, up, .9); pen.ball(cap[0], cap[1], cap[2], 2.45, 2.45, 1.9, c.hair); slab(add(add(hc, up, 1.5), face, .9), add(add(hc, up, 1.3), face, 3.1), rt, 3.2, .3, c.hair);\n  for (const s of [-1, 1]) { const e = add(add(add(hc, face, 2.05), rt, s * .85), up, .05); pen.glow(e[0], e[1], e[2], .36, '#ff5a2a'); }\n}\nconst CASTC = [{ skin: '#b89a80', hair: '#4a3a24', shirt: '#7a6a4c', pants: '#3a3430', boot: '#231f1b', belt: '#2a2018', apron: '#8a7a64' }, { skin: '#a89684', hair: '#20201c', shirt: '#4a5a3a', pants: '#34302c', boot: '#24201c', belt: '#2a2018', apron: '#5a4a3a' }, { skin: '#c0a088', hair: '#5a2a24', shirt: '#6a3a3a', pants: '#2e2c30', boot: '#1e1c1a', belt: '#2a2018', apron: '#3a3a44' }];\nconst LINE = ['Zombie_Walk_Loop', 'Wounded_Walk_Loop', 'Chop_Wood', 'Roundhouse_Kick', 'Fall_On_Face', 'Get_Up_Face_Down', 'Climb_Ladder', 'Zombie_Scratch'];\nlet world, hero, T = 0, cast = [];\nconst buf = new Float32Array(lib.P * 3);\nconst play = { pausable: true, view: 'iso',\n  enter() { world.reset(); const s = world.marks.start[0]; hero = world.hero({ x: s.x, y: s.y, r: 4.5, half: 9, visible: false, shadow: false });\n    cast = LINE.map((n, i) => ({ clip: lib.clip(n), name: n, x: s.x - 7 * 16 / 2 * 1.0 + i * 16 * 1.0 - 8, y: s.y - 7 * 16, z: 0, yaw: PI / 2, c: CASTC[i % 3], t: i * .3 }));\n    world.camera.set('fixed'); world.camera.follow(hero); },\n  update(dt) { T += dt; for (const a of cast) a.t += dt; const h = hero; world.camera.fixed = { x: h.x + 6, y: h.y + 26, z: h.z + 30, yaw: -PI / 2, pitch: -.06, roll: 0, fov: 58 }; world.step(dt); },\n  draw(r) { world.draw(r); r.overlay(g => E.font.text(g, 'MUSIC ' + game.audio.musicVolume + ' SETTING ' + game.settings.music + ' GLYPH ' + game.input.label('confirm', 'gamepad'), 6, 6, '#fff', { outline: '#000' })); } };\ngame.start({ scenes: { play }, scene: 'play', boot: { steps: [['3D', () => W3.init(game)], ['Level', () => { world = new W3(game, { level: LEVEL, res: 'balanced', sky: ['#2a2a3a', '#a08868'], fog: { color: '#8a7a64', near: 200, far: 700 }, ambient: ['#a0a4b8', '#403428', 1.6], sun: { color: '#ffd8a8', intensity: 2.2, dir: [.6, .35, -.7], area: 300, shadow: true }, camera: { mode: 'fixed' },\n  onDraw: w => { for (const a of cast) { lib.sample(a.clip, a.t % (a.clip.dur + .4), buf); drawVillager(w.pen, a, buf, a.c); } } }); world.prepare(); }]] } });\nwindow.__spike = { game, get world() { return world; }, get hero() { return hero; } };\nEOF\ncat > build2.mjs <<'EOF'\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nconst [R, out, ...parts] = process.argv.slice(2);\nconst classic = [`${R}/dist/my-3d2dge.js`, `${R}/src/mocap/readable.js`, `${R}/src/mocap/mocap.js`, 'spike-clips.js'];\nwriteFileSync('src/entry.js', `import '${R}/dist/my-3d2dge-3d.js';\\n` + parts.map(f => readFileSync(f, 'utf8')).join('\\n'));\nexecFileSync('esbuild', ['src/entry.js', '--bundle', '--format=esm', '--target=es2022', '--legal-comments=none', '--minify-syntax', '--minify-whitespace',\n  `--alias:three/webgpu=${R}/vendor/three-0.182.0/three.webgpu.min.js`, `--alias:three/tsl=${R}/vendor/three-0.182.0/three.tsl.min.js`, `--alias:three=${R}/vendor/three-0.182.0/three.webgpu.min.js`,\n  `--alias:@dimforge/rapier3d-simd-compat=${R}/vendor/rapier3d-simd-compat-0.19.3/rapier.js`, '--outfile=src/bundle.js', '--log-level=warning'], { stdio: 'inherit' });\nconst esc = s => s.replace(/<\\/script/gi, '<\\\\/script');\nconst html = `<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>spike</title><style>html, body { margin: 0; height: 100%; overflow: hidden; background: #000 }</style></head><body>\n<div id=\"stage\" style=\"position:relative;width:100%;height:100%;overflow:hidden\"><canvas id=\"view\"></canvas><canvas id=\"screen\" style=\"position:absolute;inset:0;width:100%;height:100%\"></canvas></div>\n${classic.map(f => `<script>${esc(readFileSync(f, 'utf8'))}</script>`).join('\\n')}\n<script>if(!self.GPUShaderStage)self.GPUShaderStage={VERTEX:1,FRAGMENT:2,COMPUTE:4};</script>\n<script type=\"module\">${esc(readFileSync('src/bundle.js', 'utf8'))}</script></body></html>`;\nwriteFileSync(out, html); console.log('wrote', out, (html.length / 1e6).toFixed(2), 'MB');\nEOF\nnode build2.mjs \"$R\" mocap_pen.html mocap_pen.js; cat > drive_mp.py <<'EOF'\nimport sys, json, time, pathlib\nfrom playwright.sync_api import sync_playwright\npath = pathlib.Path(sys.argv[1]).resolve().as_uri()\nwith sync_playwright() as p:\n    b = p.chromium.launch()\n    pg = b.new_page(viewport={'width': 1280, 'height': 720})\n    errs = []\n    pg.on('pageerror', lambda e: errs.append('pageerror: ' + str(e)[:500]))\n    pg.on('console', lambda m: errs.append(m.type + ': ' + m.text[:500]) if m.type == 'error' else None)\n    pg.goto(path)\n    for i in range(120):\n        if pg.evaluate(\"!!(window.__spike && __spike.hero)\"): break\n        time.sleep(.5)\n    time.sleep(2.5); pg.screenshot(path='mp-1.png')\n    time.sleep(1.3); pg.screenshot(path='mp-2.png')\n    print(pg.evaluate(\"({ music: __spike.game.settings.music, mv: __spike.game.audio.musicVolume, vol: __spike.game.settings.volume, glyphs: __spike.game.settings.glyphs })\"))\n    print(errs[:5])\n    b.close()\nEOF\ntimeout 120 python3 drive_mp.py mocap_pen.html","description":"Test motion clips driving a pen-drawn villager body","timeout":180000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_seq