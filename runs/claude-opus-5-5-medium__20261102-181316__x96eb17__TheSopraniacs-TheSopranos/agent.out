'], ['aim', 'Camera']]: centred at cx (or left at x with o.left)","+function badgeWidth(act) {","+  const lab = typeof act === 'string' && act.startsWith('#') ? act.slice(1) : keyLabel(act);","+  if (PS_COL[lab] || /click/i.test(lab)) return 11;","+  if (XB_COL[lab] && lab.length === 1 && I.padStyle && I.padStyle() === 'xbox' && lastDev() === 'gamepad') return 11;","+  return Math.max(9, E.font.width(lab) + 6);","+}"," function promptRow(g, items, cx, y, o = {}) {","-  const parts = items.map(([a, t]) => ({ a, t, w: 11 + 3 + E.font.width(t) + 10 }));","-  for (const p of parts) if (!(typeof p.a === 'string' && p.a.startsWith('#'))) { const l = keyLabel(p.a); if (!PS_COL[l] && !/click/i.test(l)) p.w = Math.max(9, E.font.width(l) + 6) + 3 + E.font.width(p.t) + 10; }","+  const parts = items.map(([a, t]) => ({ a, t, w: badgeWidth(a) + 3 + E.font.width(t) + 10 }));","   let total = parts.reduce((s, p) => s + p.w, 0) - 10, x = o.left ? cx : Math.round(cx - total / 2);","   if (o.bg !== false) E.ui.box(g, x - 5, y - 3, total + 10, 17, { bg: ['#0c0c12', '#16161e'], border: '#3a3a48', alpha: .85 });","   for (const p of parts) { const bw = badge(g, p.a, x, y); E.font.text(g, p.t, x + bw + 3, y + 2, o.color || '#e8e4dc', { shadow: '#000', outline: false }); x += p.w; }"]},{"oldStart":320,"oldLines":7,"newStart":325,"newLines":7,"lines":["   r.overlay(g => {","     px.blend(g, .75, 'normal', () => px.rect(g, 0, 0, r.W, r.H, '#000000'));","     const w = Math.min(380, r.W - 20), h = Math.min(220, r.H - 20), x = Math.round((r.W - w) / 2), y = Math.round((r.H - h) / 2);","-    panel(g, x, y, w, h, NOTES.page === 0 ? 'CASE NOTES  ·  ' + (CHAPTERS[CASE.chapter] ? CHAPTERS[CASE.chapter].tape + ': ' + CHAPTERS[CASE.chapter].name.toUpperCase() : '') : 'EVIDENCE AND INTEL');","+    panel(g, x, y, w, h, NOTES.page === 0 ? 'CASE NOTES  •  ' + (CHAPTERS[CASE.chapter] ? CHAPTERS[CASE.chapter].tape + ': ' + CHAPTERS[CASE.chapter].name.toUpperCase() : '') : 'EVIDENCE AND INTEL');","     if 