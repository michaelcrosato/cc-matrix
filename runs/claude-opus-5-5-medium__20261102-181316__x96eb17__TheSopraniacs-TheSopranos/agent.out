    b = p.chromium.launch()\\n    for q in SCEN:\\n        page = b.new_page(viewport={'width': 1400, 'height': 900})\\n        page.goto(f'http://127.0.0.1:{PORT}/harness.html?game=game.html&limit=40&{q}')\\n        try: page.wait_for_function('document.body.dataset.complete === \\\"true\\\"', timeout=150000)\\n        except Exception as e: print('timeout', q)\\n        res = page.evaluate('JSON.stringify(window.__hubCheck || null)')\\n        r = json.loads(res) if res else None\\n        ok = bool(r and r.get('pass'))\\n        print(('ok   ' if ok else 'FAIL ') + q)\\n        if not ok:\\n            fails += 1; print(json.dumps(r, indent=1)[:3000])\\n        page.screenshot(path=f'/tmp/bb-xb81546/shots/hub-{len(q)}.png')\\n        page.close()\\n    b.close()\\nsrv.terminate()\\nsys.exit(1 if fails else 0)\\nEOF\\ntimeout 700 python3 test/hubcheck.py 2>&1 | tail -60\",\"description\":\"Run AI Hub harness scenarios\",\"timeout\":720000}},\"wire_ingest_context\":{\"toolu_01Q2NttL2oooMifnzzDC3LLL\":{\"cwd\":\"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181319__xb81546/work/BreakingBackyard-BreakingBad-claude-opus-5-5-medium-20261102-181319\"}}}"," {\"type\":\"system\",\"subtype\":\"task_started\",\"task_id\":\"biq3jl5g0\",\"run_id\":\"0mw01353o-094cf2ab\",\"tool_use_id\":\"toolu_01Q2NttL2oooMifnzzDC3LLL\",\"description\":\"Run AI Hub harness scenarios\",\"is_backgrounded\":false,\"task_type\":\"local_bash\",\"uuid\":\"798030be-31f5-44c0-b92c-b1a30b9f664b\",\"session_id\":\"3f3c3e9b-9eb4-44c2-94b1-164e7be1aa93\"}","+{\"type\":\"tool_progress\",\"tool_use_id\":\"toolu_01Q2NttL2oooMifnzzDC3LLL-heartbeat-0\",\"tool_name\":\"Bash\",\"parent_tool_use_id\":\"toolu_01Q2NttL2oooMifnzzDC3LLL\",\"elapsed_time_seconds\":30,\"heartbeat\":true,\"session_id\":\"3f3c3e9b-9eb4-44c2-94b1-164e7be1aa93\",\"uuid\":\"69e37011-918e-43c5-81d5-41bf2649212d\"}","+{\"type\":\"system\",\"subtype\":\"task_notification\",\"task_id\":\"biq3jl5g0\",\"run_id\":\"0mw01353o-094