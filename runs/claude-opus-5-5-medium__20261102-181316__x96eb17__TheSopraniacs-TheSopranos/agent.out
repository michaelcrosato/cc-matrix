teleport(c.x, c.y + 16);\", ['press:KeyE', 'wait:9000', 'hold:Mouse2:900']),","+  ('xbox', '#corner/1', 4000, G + \"g.settings.set('glyphs','xbox'); I.lastDevice='gamepad';\", ['wait:300']),","+  ('touchonly', '?touchonly=1', 3000, '', ['wait:300']),","+  ('coldopen', '#coldopen', 4000, '', ['hold:KeyD:1200']),","+  ('ending-board', '#ending', 3000, '', ['wait:300']),","+]","+async def main():","+    async with async_playwright() as p:","+        b = await getattr(p, ENGINE).launch()","+        for name, link, wait, js, steps in SCEN:","+            pg = await b.new_page(viewport={'width': W, 'height': H})","+            errs = []","+            pg.on('pageerror', lambda e, errs=errs: errs.append(str(e)))","+            pg.on('console', lambda m, errs=errs: errs.append(m.text) if m.type == 'error' else None)","+            await pg.goto(URL + link)","+            await pg.wait_for_timeout(wait)","+            await pg.mouse.move(W/2, H/2)","+            if js: await pg.evaluate(js)","+            for s in steps:","+                k = s.split(':')","+                if k[0] == 'press': await pg.keyboard.press(k[1])","+                elif k[0] == 'wait': await pg.wait_for_timeout(int(k[1]))","+                elif k[0] == 'hold':","+                    if k[1].startswith('Mouse'):","+                        await pg.mouse.down(button='right'); await pg.wait_for_timeout(int(k[2])); ","+                    else:","+                        await pg.keyboard.down(k[1]); await pg.wait_for_timeout(int(k[2]))","+            await pg.screenshot(path=f'{OUT}/act-{ENGINE}-{name}.png')","+            print(name, errs[:3])","+            await pg.close()","+        await b.close()","+asyncio.run(main())"]}],"created":true},{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium__20261102-181310__xac1bf5/agent.out","hunks":[{"oldStart":799,"oldLines":3,"newStart":799,"newLines":4,"lines":[" {\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-5-5\",\"id\":\"ms