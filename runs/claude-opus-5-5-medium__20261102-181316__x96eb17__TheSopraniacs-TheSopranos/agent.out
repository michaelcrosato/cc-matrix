);\\\\ntalkThrough(30, CHOICE % 2);\\\\nconst bag = W.items.find(i => i.kind === 'bag');\\\\ncheck('the bag drops', !!bag);\\\\nif (bag) { D.teleport(bag.x, bag.y); run(1); talkThrough(); }\\\\ncheck('the book and the money', S.flags.book === 1 && S.cash >= 5000, JSON.stringify(snap()));\\\\nwaitFor(() => /road/.test(snap().objective || ''));\\\\nD.teleport(b.exit.x, b.exit.y); run(.5); talkThrough();\\\\ncheck('session three', waitFor(() => snap().scene === 'therapy'), JSON.stringify(snap()));\\\\nrun(1.5); talkThrough();\\\\ncheck('chapter four: rain at night', waitFor(() => snap().scene === 'play' && snap().ch === 6) && game.weather && game.weather.kind === 'rain', JSON.stringify(snap()));\\\\nrun(1); use(t1.gino); talkThrough();\\\\nwaitFor(() => /yard/.test(snap().objective || ''));\\\\nD.teleport(t1.yardGate.x, t1.yardGate.y); run(.5);\\\\ncheck('the yard gate fight', fightAll(120) && waitFor(() => S.flags.gateDone), JSON.stringify(snap()));\\\\nwaitFor(() => !!W.carmine); talkThrough();\\\\ncheck('Carmine \\\\\\\"The Tenor\\\\\\\" fights in three movements', fightAll(240) && W.carmine.surrender, JSON.stringify(snap()) + ' phase ' + (W.carmine && W.carmine.phase));\\\\ntalkThrough();\\\\ncheck('the Feds take him', waitFor(() => S.flags.yard), JSON.stringify(snap()));\\\\nwaitFor(() => /Diner/.test(snap().objective || ''));\\\\nuse(t1.diner, 10);\\\\ncheck('the epilogue at the diner', waitFor(() => snap().scene === 'diner', 5), JSON.stringify(snap()));\\\\ncheck('the diner plays out and cuts to black, then the credits', waitFor(() => snap().scene === 'credits', 90), JSON.stringify(snap()));\\\\nI.tap('start'); run(1);\\\\ncheck('the credits end on the title', snap().scene === 'title', JSON.stringify(snap()));\\\\ncheck('a save is there to continue', game.saves.any);\\\\ncheck('no errors', !game.errors.length, game.errors.map(e => e.where + ': ' + e.message + ' ' + (e.stack || '').split('\\\\\\\\n')[1]).join(' | '));\\\\nconsole.log(`final: cash ${S.cash}, respect ${S.respect}, family ${S.family}, panics ${S.panics || 0}, choices ${S.choices.length}`);\\\\nconsole.log(failed ? `${failed} check(s) failed` : 'all checks passed');\\\\nprocess.exit(failed ? 1 : 0);\\\\n\\\",\\\"structuredPatch\\\":[],\\\"originalFile\\\":null,\\\"userModified\\\":false},\\\"tool_result_meta\\\":[{\\\"id\\\":\\\"toolu_01EMLkaPi5atmPqyv9n7aTCx\\\",\\\"permission_decision\\\":{\\\"decision\\\":\\\"accept\\\",\\\"source\\\":\\\"config\\\",\\\"reason_type\\\":\\\"mode\\\"}}]}\",\" {\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-opus-5-5\\\",\\\"id\\\":\\\"msg_011Cgf9C3BwwjZ1SLZLUrKfQ\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"tool_use\\\",\\\"id\\\":\\\"toolu_015mcv6ah2eiWoLc5MC4v7GP\\\",\\\"name\\\":\\\"Bash\\\",\\\"input\\\":{\\\"command\\\":\\\"timeout 600 node tests/playthrough.mjs 2>&1 | tail -40\\\",\\\"description\\\":\\\"Run the full headless playthrough test\\\",\\\"timeout\\\":620000},\\\"caller\\\":{\\\"type\\\":\\\"direct\\\"}}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":2,\\\"cache_creation_input_tokens\\\":4344,\\\"cache_read_input_tokens\\\":317397,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":4344,\\\"ephemeral_1h_input_tokens\\\":0},\\\"output_tokens\\\":16,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\",\\\"speed\\\":\\\"standard\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"70b9b3fb-a482-4430-a756-95fe6fe59945\\\",\\\"uuid\\\":\\\"d46d42e8-0897-4c3a-9e34-4a8dd6b14864\\\",\\\"timestamp\\\":\\\"2026-11-03T01:39:54.508Z\\\",\\\"request_id\\\":\\\"req_011Cgf9C2k9LBkgPzAFqYwHA\\\",\\\"wire_tool_inputs\\\":{\\\"toolu_015mcv6ah2eiWoLc5MC4v7GP\\\":{\\\"command\\\":\\\"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium