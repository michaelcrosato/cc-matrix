 350 },","+      { type: 'grenadier', every: 500, n: [1, 1], mode: 'pop', z: [150, 200], from: 250 },","+      { type: 'knife', every: 600, n: [1, 1], mode: 'pop', z: [55, 90], from: 500 },","+    ],","+    holds: [{ at: 1100, max: 22, radio: 'op2.river' }],","+    radio: [[0, 'op2.go'], ['end', 'op2.croc']],","+    quotas: { soldier: 24, boat: 4 },","+    boss: 'crocodile', heal: 10, perk: 'riverClear', hostages: [], decor: ['palm', 'palm'],","+    cut: 'interrogation',","+  },","+  op3: {","+    id: 'op3', n: 3, name: 'PALM VILLAGE', card: 'FIND THE WORKERS AND CLEAR THE HUTS', time: 'noon',","     sky: ['#2a6aa8', '#5aa6d8', '#9ad6e8', '#e8f4d0'], sun: '#fff4c0', ground: ['#7a9a4a', '#5a7a34', '#3a5a22'], hill: '#3f7a4a',","     length: 2100, speed: 13,","     rail: [[0, 0], [500, -260], [1100, 180], [2100, -60]],","-    gen: { group: 120, groupSize: [1, 2], runner: 0, jeep: 1100, civilian: 200, goat: 700 },","-    holds: [{ at: 1000, max: 25, radio: 'op2.hostage' }],","-    radio: [[0, 'op2.go'], ['end', 'op2.vane']],","+    gen: [","+      { type: 'civilian', every: 200, n: [1, 2], mode: 'civ', z: [120, 170], from: 160 },","+      { type: 'soldier', every: 150, n: [1, 2], mode: 'pop', z: [140, 200] },","+      { type: 'jeep', every: 1100, n: [1, 1], mode: 'vehicle', z: [190, 190], from: 500 },","+      { type: 'goat', every: 700, n: [1, 1], mode: 'goat', z: [140, 170], from: 330 },","+      { type: 'grenadier', every: 800, n: [1, 1], mode: 'pop', z: [150, 200], from: 600 },","+    ],","+    holds: [{ at: 1000, max: 25, radio: 'op3.hostage' }],","+    radio: [[0, 'op3.go'], ['end', 'op3.warthog']],","     quotas: { soldier: 28, vehicle: 2 },","-    boss: 'vane', heal: 25, perk: 'villageAid',","+    boss: 'warthog', heal: 25, perk: 'villageAid', decor: ['hut', 'palm'],","     hostages: [{ at: 350, lx: -60 }, { at: 700, lx: 40 }, { at: 1000, lx: -120 }, { at: 1400, lx: 80 }, { at: 1750, lx: 0 }],","   },","+  op4: {","+    id: 'op4', n: 4, name: 'POWDER KEG DEPOT', card: 'BLOW THE DEPOT. KEEP THE DYNAMITE OFF THE TRUCKS', time: 'dusk',","+    sky: ['#2a1420', '#7a2a2a', '#d86a30', '#f8b060'], sun: '#ffb070', ground: ['#4a3a2a', '#3a2c20', '#24190f'], hill: '#4a2a2a',","+    length: 2200, speed: 14,","+    rail: [[0, 0], [700, 240], [1500, -200], [2200, 120]],","+    gen: [","+      { type: 'soldier', every: 130, n: [2, 3], mode: 'pop', z: [150, 230], sandbag: true },","+      { type: 'crate', every: 300, n: [1, 1], mode: 'crate', z: [120, 160], dyn: 0.5 },","+      { type: 'apc', every: 800, n: [1, 1], mode: 'vehicle', z: [200, 200], from: 400 },","+      { type: 'tank', every: 1100, n: [1, 1], mode: 'vehicle', z: [210, 210], from: 600 },","+      { type: 'mortar', every: 900, n: [1, 1], mode: 'pop', z: [200, 230], sandbag: true, from: 300 },","+      { type: 'grenadier', every: 500, n: [1, 1], mode: 'pop', z: [150, 200], from: 250 },","+    ],","+    holds: [{ at: 1000, max: 24, radio: 'op4.depot' }, { at: 1800, max: 24, radio: 'op4.tanks' }],","+    radio: [[0, 'op4.go'], ['end', 'op4.hog']],","+    quotas: { soldier: 30, vehicle: 3 },","+    boss: 'ironHog', heal: 20, perk: 'ammoDrop', hostages: [], decor: ['hut', 'mast'],","+  },","+  op5: {","+    id: 'op5', n: 5, name: 'THE KENNEL', card: 'BREAK THE WORKERS OUT OF THE KENNEL. IT IS NIGHT', time: 'night',","+    night: true,","+    sky: ['#05060f', '#0c1028', '#1a2038', '#2a3050'], sun: null, ground: ['#1a2220', '#101a18', '#081010'], hill: '#101828',","+    length: 2300, speed: 13,","+    rail: [[0, 0], [800, -220], [1500, 240], [2300, -100]],","+    gen: [","+      { type: 'soldier', every: 140, n: [2, 3], mode: 'pop', z: [150, 230], sandbag: true },","+      { type: 'sniper', every: 500, n: [1, 1], mode: 'pop', z: [230, 260] },","+      { type: 'knife', every: 400, n: [1, 1], mode: 'pop', z: [55, 90], from: 300 },","+      { type: 'brute', every: 1000, n: [1, 1], mode: 'pop', z: [160, 200], sandbag: true, from: 500 },","+      { type: 'jeep', every: 900, n: [1, 1], mode: 'vehicle', z: [190, 190], from: 600 },","+    ],","+    holds: [{ at: 800, max: 24, radio: 'op5.kennel' }, { at: 1600, max: 24, radio: 'op5.breakout' }],","+    radio: [[0, 'op5.go'], ['end', 'op5.tusk']],","+    quotas: { soldier: 34, vehicle: 1 },","+    boss: 'tusk', heal: 25, perk: 'nightVision', decor: ['mast', 'hut'],","+    hostages: [{ at: 300, lx: -90 }, { at: 600, lx: 60 }, { at: 900, lx: -40 }, { at: 1250, lx: 110 }, { at: 1650, lx: -100 }],","+  },","+  op6: {","+    id: 'op6', n: 6, name: 'LAST FLIGHT OUT', card: 'THE CARGO PLANE IS ON THE STRIP. GET THEM ABOARD', time: 'sunrise',","+    storm: true,","+    sky: ['#2a3a58', '#5a6a88', '#c89a80', '#f0c890'], sun: '#ffe0a0', ground: ['#5a6a48', '#3e4e34', '#26321f'], hill: '#3a4a50',","+    length: 2000, speed: 13,","+    rail: [[0, 0], [600, 180], [1300, -240], [2000, 60]],","+    gen: [","+      { type: 'soldier', every: 160, n: [2, 3], mode: 'pop', z: [150, 230], sandbag: true },","+      { type: 'runner', every: 400, n: [1, 2], mode: 'cross', z: [130, 200] },","+      { type: 'jeep', every: 600, n: [1, 1], mode: 'vehicle', z: [190, 190], from: 300 },","+      { type: 'grenadier', every: 500, n: [1, 1], mode: 'pop', z: [150, 200], from: 250 },","+      { type: 'heli', every: 700, n: [1, 1], mode: 'air', z: [170, 170], from: 900, only: true },","+    ],","+    holds: [{ at: 1000, max: 24, radio: 'op6.gunship' }],","+    radio: [[0, 'op6.go'], ['end', 'op6.hyena']],","+    quotas: { soldier: 26, vehicle: 2, air: 1 },","+    boss: 'hyenaOne', heal: 30, perk: 'lastFlight', decor: ['mast', 'palm'],","+    hostages: [{ at: 400, lx: -80 }, { at: 800, lx: 50 }, { at: 1100, lx: -30 }, { at: 1400, lx: 90 }, { at: 1700, lx: -110 }],","+  },"," };","-WP.OP_ORDER = ['op1', 'op2'];","+WP.OP_ORDER = ['op1', 'op2', 'op3', 'op4', 'op5', 'op6'];"," ","-// the scenery along the rail: palms and huts (or radio masts on the hill), at depths behind the fight, so they parallax","+// the scenery along the rail: palms, huts, radio masts, at depths behind the fight, so they parallax"," WP.decorFor = (op, rand) => {","   const out = [];","-  const kinds = op.id === 'op1' ? ['mast', 'palm', 'palm'] : ['hut', 'palm', 'palm', 'hut'];","+  const kinds = op.decor;","   for (let d = 0; d < op.length + 800; d += 150 + rand() * 90) {","     const cam = WP.railX(op.rail, Math.min(d, op.length));","     out.push({ kind: kinds[Math.floor(rand() * kinds.length)], x: cam + (rand() - 0.5) * 900, z: 240 + rand() * 180 });"]},{"oldStart":52,"oldLines":38,"newStart":142,"newLines":48,"lines":["   const T = WP.T;","   const cam = d => WP.railX(op.rail, d);","   const add = (at, item) => { out.push(Object.assign({ at }, item)); };","-  const g = op.gen;","-  // soldiers pop from cover in groups; sandbags stand in front of them","-  for (let d = 110; d < op.length - 300; d += g.group * pick(0.8, 1.2)) {","-    const n = Math.round(pick(g.groupSize[0], g.groupSize[1]) * T.density);","-    const sx = cam(d) + pick(-150, 150);","-    const sp = [{ type: 'sandbag', x: sx, z: 150 + pick(0, 40) }];","-    for (let i = 0; i < n; i++) sp.push({ type: 'soldier', x: sx + (i - (n - 1) / 2) * 16, z: 150 + pick(0, 90), wave: true });","-    add(d, { spawn: sp });","+  for (const g of op.gen) {","+    const from = g.from || 110;","+    const count = () => Math.max(1, Math.round(pick(g.n[0], g.n[1]) * (g.mode === 'civ' || g.mode === 'goat' ? 1 : T.density)));","+    let flew = false;","+    for (let d = from; d < op.length - 300; d += g.every * pick(0.8, 1.2)) {","+      if (g.mode === 'pop') {","+        const n = count(), sx = cam(d) + pick(-150, 150);","+        const sp = [];","+        if (g.sandbag) sp.push({ type: 'sandbag', x: sx, z: g.z[0] + 4 });","+        for (let i = 0; i < n; i++) sp.push({ type: g.type, x: sx + (i - (n - 1) / 2) * 16, z: pick(g.z[0], g.z[1]), wave: true });","+        add(d, { spawn: sp });","+      } else if (g.mode === 'cross') {","+        const side = rand() < 0.5 ? -1 : 1;","+        add(d, { spawn: [{ type: g.type, x: cam(d) - side * 200, z: pick(g.z[0], g.z[1]), vx: side * pick(40, 60), wave: true }] });","+      } else if (g.mode === 'vehicle') {","+        const side = rand() < 0.5 ? -1 : 1;","+        add(d, { spawn: [{ type: g.type, x: cam(d) - side * 220, z: g.z[0], vx: side * 42, wave: true }] });","+      } else if (g.mode === 'boat') {","+        const n = count(), side = rand() < 0.5 ? -1 : 1, sp = [];","+        for (let i = 0; i < n; i++) sp.push({ type: g.type, x: cam(d) + side * (200 + i * 40), z: pick(g.z[0], g.z[1]), vx: -side * pick(30, 44), wave: true });","+        add(d, { spawn: sp });","+      } else if (g.mode === 'air') {","+        if (g.only && flew) continue;","+        flew = true;","+        add(d, { spawn: [{ type: g.type, x: cam(d) + pick(-60, 60), z: 260, wave: true, fly: true }] });","+      } else if (g.mode === 'civ') {","+        const side = rand() < 0.5 ? -1 : 1;","+        add(d, { spawn: [{ type: g.type, x: cam(d) - side * 120, z: pick(g.z[0], g.z[1]), vx: side * 16 }] });","+      } else if (g.mode === 'goat') {","+        add(d, { spawn: [{ type: g.type, x: cam(d) - 200, z: pick(g.z[0], g.z[1]), vx: 26 }] });","+      } else if (g.mode === 'crate') {","+        const type = g.dyn && rand() < g.dyn ? 'dynamite' : g.type;","+        add(d, { spawn: [{ type, x: cam(d) + pick(-110, 110), z: pick(g.z[0], g.z[1]) }] });","+      }","+    }","   }","-  if (g.runner) for (let d = 240; d < op.length - 300; d += g.runner * pick(0.8, 1.2)) {","-    const side = rand() < 0.5 ? -1 : 1;","-    add(d, { spawn: [{ type: 'runner', x: cam(d) - side * 200, z: pick(130, 200), vx: side * pick(40, 60), wave: true }] });","-  }","-  if (g.jeep) for (let d = 500; d < op.length - 300; d += g.jeep) {","-    const side = rand() < 0.5 ? -1 : 1;","-    add(d, { spawn: [{ type: 'jeep', x: cam(d) - side * 220, z: 190, vx: side * 42, wave: true }] });","-  }","-  if (g.civilian) for (let d = 160; d < op.length - 300; d += g.civilian * pick(0.8, 1.2)) {","-    const side = rand() < 0.5 ? -1 : 1;","-    add(d, { spawn: [{ type: 'civilian', x: cam(d) - side * 120, z: pick(120, 170), vx: side * 16, wave: false }] });","-  }","-  if (g.goat) for (let d = 330; d < op.length - 300; d += g.goat) {","-    add(d, { spawn: [{ type: 'goat', x: cam(d) - 200, z: pick(140, 170), vx: 26 }] });","-  }","-  // crates along the way: shoot one for a magazine, a grenade or medicine","+  // supply crates along the way, and a FURY drop now and then","   for (let d = 260; d < op.length - 300; d += 380) add(d, { spawn: [{ type: 'crate', x: cam(d) + pick(-110, 110), z: pick(120, 150) }] });","-  // hostages stand in the village with two guards each; the guards are part of the wave","+  for (let d = 800; d < op.length - 300; d += 900) add(d, { spawn: [{ type: 'pickup', x: cam(d), z: 130, item: 'fury' }] });","+  // hostages stand with two guards each (the battle spawns the guards when the beat fires)","   let hid = 0;","-  for (const h of op.hostages || []) {","-    add(h.at, { hostage: { x: cam(h.at) + h.lx, z: 140, id: ++hid } });","-  }","-  // the radio cues","+  for (const h of op.hostages || []) add(h.at, { hostage: { x: cam(h.at) + h.lx, z: 140, id: ++hid } });","   for (const [at, key] of op.radio) if (typeof at === 'number') add(at, { radio: key });","   for (const h of op.holds) add(h.at, { radio: h.radio, hold: h });","   out.sort((a, b) => a.at - b.at);"]}],"originalFile":"// The operations: data, then the beat generator that turns each one into timed spawns (the same seed, the same battle).\n// rail: the camera's knots [[dist, x], ...]. length: the rail's end. speed: world units a second before railSpeed.\n// gen: how often each kind of group arrives along the rail. holds: where the rail stops until the wave is clear.\n// hostages: the people to bring home (guards stand around each one; they run when the guards are dead).\n(() => {\n'use strict';\nconst WP = globalThis.WP;\n\nWP.OPS = {\n  op1: {\n    id: 'op1', n: 1, name: 'RADIO HILL', card: 'DESTROY THE ENEMY RADIO STATION', time: 'dawn',\n    sky: ['#1d1a3a', '#5a2f5e', '#d8786a', '#f6c48c'], sun: '#ffd6a0', ground: ['#3d4a2a', '#2a3a1e', '#1a2614'], hill: '#4a2f4a',\n    length: 2300, speed: 15,\n    rail: [[0, 0], [700, 220], [1400, -160], [2300, 260]],\n    gen: { group: 120, groupSize: [2, 3], runner: 380, jeep: 520, civilian: 0, goat: 0 },\n    holds: [{ at: 900, max: 22, radio: 'op1.hold' }, { at: 1700, max: 22, radio: 'op1.jeep' }],\n    radio: [[0, 'op1.go'], ['end', 'op1.station']],\n    quotas: { soldier: 36, vehicle: 3 },\n    boss: 'holt', heal: 15, perk: 'commsDown', hostages: [],\n  },\n  op2: {\n    id: 'op2', n: 2, name: 'PALM VILLAGE', card: 'FIND THE HOSTAGES AND CLEAR THE HUTS', time: 'noon',\n    sky: ['#2a6aa8', '#5aa6d8', '#9ad6e8', '#e8f4d0'], sun: '#fff4c0', ground: ['#7a9a4a', '#5a7a34', '#3a5a22'], hill: '#3f7a4a',\n    length: 2100, speed: 13,\n    rail: [[0, 0], [500, -260], [1100, 180], [2100, -60]],\n    gen: { group: 120, groupSize: [1, 2], runner: 0, jeep: 1100, civilian: 200, goat: 700 },\n    holds: [{ at: 1000, max: 25, radio: 'op2.hostage' }],\n    radio: [[0, 'op2.go'], ['end', 'op2.vane']],\n    quotas: { soldier: 28, vehicle: 2 },\n    boss: 'vane', heal: 25, perk: 'villageAid',\n    hostages: [{ at: 350, lx: -60 }, { at: 700, lx: 40 }, { at: 1000, lx: -120 }, { at: 1400, lx: 80 }, { at: 1750, lx: 0 }],\n  },\n};\nWP.OP_ORDER = ['op1', 'op2'];\n\n// the scenery along the rail: palms and huts (or radio masts on the hill), at depths behind the fight, so they parallax\nWP.decorFor = (op, rand) => {\n  const out = [];\n  const kinds = op.id === 'op1' ? ['mast', 'palm', 'palm'] : ['hut', 'palm', 'palm', 'hut'];\n  for (let d = 0; d < op.length + 800; d += 150 + rand() * 90) {\n    const cam = WP.railX(op.rail, Math.min(d, op.length));\n    out.push({ kind: kinds[Math.floor(rand() * kinds.length)], x: cam + (rand() - 0.5) * 900, z: 240 + rand() * 180 });\n  }\n  return out;\n};\n\n// the beat list for an operation: spawns and radio cues, sorted by distance along the rail. Coordinates are absolute\n// (the camera's x at that distance plus an offset), so the battle needs no randomness of its own\nWP.beatsFor = (op, rand) => {\n  const out = [];\n  const pick = (a, b) => a + rand() * (b - a);\n  const T = WP.T;\n  const cam = d => WP.railX(op.rail, d);\n  const add = (at, item) => { out.push(Object.assign({ at }, item)); };\n  const g = op.gen;\n  // soldiers pop from cover in groups; sandbags stand in front of them\n  for (let d = 110; d < op.length - 300; d += g.group * pick(0.8, 1.2)) {\n    const n = Math.round(pick(g.groupSize[0], g.groupSize[1]) * T.density);\n    const sx = cam(d) + pick(-150, 150);\n    const sp = [{ type: 'sandbag', x: sx, z: 150 + pick(0, 40) }];\n    for (let i = 0; i < n; i++) sp.push({ type: 'soldier', x: sx + (i - (n - 1) / 2) * 16, z: 150 + pick(0, 90), wave: true });\n    add(d, { spawn: sp });\n  }\n  if (g.runner) for (let d = 240; d < op.length - 300; d += g.runner * pick(0.8, 1.2)) {\n    const side = rand() < 0.5 ? -1 : 1;\n    add(d, { spawn: [{ type: 'runner', x: cam(d) - side * 200, z: pick(130, 200), vx: side * pick(40, 60), wave: true }] });\n  }\n  if (g.jeep) for (let d = 500; d < op.length - 300; d += g.jeep) {\n    const side = rand() < 0.5 ? -1 : 1;\n    add(d, { spawn: [{ type: 'jeep', x: cam(d) - side * 220, z: 190, vx: side * 42, wave: true }] });\n  }\n  if (g.civilian) for (let d = 160; d < op.length - 300; d += g.civilian * pick(0.8, 1.2)) {\n    const side = rand() < 0.5 ? -1 : 1;\n    add(d, { spawn: [{ type: 'civilian', x: cam(d) - side * 120, z: pick(120, 170), vx: side * 16, wave: false }] });\n  }\n  if (g.goat) for (let d = 330; d < op.length - 300; d += g.goat) {\n    add(d, { spawn: [{ type: 'goat', x: cam(d) - 200, z: pick(140, 170), vx: 26 }] });\n  }\n  // crates along the way: shoot one for a magazine, a grenade or medicine\n  for (let d = 260; d < op.length - 300; d += 380) add(d, { spawn: [{ type: 'crate', x: cam(d) + pick(-110, 110), z: pick(120, 150) }] });\n  // hostages stand in the village with two guards each; the guards are part of the wave\n  let hid = 0;\n  for (const h of op.hostages || []) {\n    add(h.at, { hostage: { x: cam(h.at) + h.lx, z: 140, id: ++hid } });\n  }\n  // the radio cues\n  for (const [at, key] of op.radio) if (typeof at === 'number') add(at, { radio: key });\n  for (const h of op.holds) add(h.at, { radio: h.radio, hold: h });\n  out.sort((a, b) => a.at - b.at);\n  return out;\n};\n})();\n","userModified":false},"tool_result_meta":[{"id":"toolu_01LwebC9F4tNnLFYahBYo4uJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
