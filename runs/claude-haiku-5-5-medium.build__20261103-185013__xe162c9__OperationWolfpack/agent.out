, 0.25, 3, 0.25, 'multiplier on each boss\\'s health'],\n  ['density', 'Enemy density', 1, 0.5, 2, 0.1, 'multiplier on enemies per beat'],\n  ['bloom', 'Bloom', 1, 0, 3, 0.1, 'how far the crosshair opens while firing'],\n];\nWP.T = {};\nWP.resetTuning = () => { for (const s of WP.TUNING_SPEC) WP.T[s[0]] = s[2]; };\nWP.resetTuning();\n\n// the difficulty presets: RECRUIT is kind, VETERAN is the reference, ARCADE is unforgiving. Only ARCADE ends the run\n// when the magazines and the grenades run dry; the others drop a magazine on the field.\nWP.DIFF = {\n  recruit: { label: 'RECRUIT', telegraph: 1.35, damage: 0.6, emergency: true, cheer: 'Easy' },\n  veteran: { label: 'VETERAN', telegraph: 1.0, damage: 1, emergency: true, cheer: 'Normal' },\n  arcade: { label: 'ARCADE', telegraph: 0.8, damage: 1.3, emergency: false, cheer: 'Hard' },\n};\n\n// entity types. kind: soldier | runner | vehicle | civilian | hostage | animal | crate | cover | rocket | pickup | boss\n// w, h: the body's width and height in world units. hp: hits to kill. score: points (negative: a penalty).\nWP.TYPES = {\n  soldier: { kind: 'soldier', w: 9, h: 20, hp: 1, score: 100, sprite: 'soldier' },\n  runner: { kind: 'runner', w: 9, h: 20, hp: 1, score: 100, sprite: 'soldier' },\n  jeep: { kind: 'vehicle', w: 30, h: 14, hp: 3, score: 500, sprite: 'jeep' },\n  civilian: { kind: 'civilian', w: 8, h: 18, hp: 1, score: -500, sprite: 'civilian' },\n  hostage: { kind: 'hostage', w: 9, h: 20, hp: 1, score: 0, sprite: 'hostage' },\n  goat: { kind: 'animal', w: 11, h: 9, hp: 1, score: 50, sprite: 'goat' },\n  crate: { kind: 'crate', w: 12, h: 12, hp: 1, score: 100, sprite: 'crate' },\n  sandbag: { kind: 'cover', w: 26, h: 8, hp: 0, score: 0, sprite: 'sandbag' },\n  rocket: { kind: 'rocket', w: 4, h: 4, hp: 1, score: 50, sprite: 'rocket' },\n  pickup: { kind: 'pickup', w: 8, h: 8, hp: 1, score: 0, sprite: 'pickup' },\n};\n\n// the boss roster (25-battle reads these)\nWP.BOSSES = {\n  holt: { name: 'BRIGADIER HOLT', hp: 40, w: 46, h: 70, rate: 2.4, volley: 3, sprite: 'holt' },\n  vane: { name: 'DOG HANDLER VANE', hp: 55, w: 40, h: 66, rate: 2.0, volley: 4, sprite: 'vane' },\n};\n})();\n","structuredPatch":[],"originalFile":null,"userModified":false},"tool_result_meta":[{"id":"toolu_01ViBPDAsq5fhisThhSa1tGG","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh44wnEHzeuAT6Hob3M2","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2122,"cache_read_input_tokens":113135,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2122},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"972ca841-0540-4c71-85fe-204eae6bea61","uuid":"30473c19-2ad1-4ba5-809c-add90fc02d5a","timestamp":"2026-11-04T01:53:53.941Z","request_id":"req_011Cgh44wTtZJ7EfYNxjwn36","thinking_duration_ms":115,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh44wnEHzeuAT6Hob3M2","type":"message","role":"assistant","content":[{"type":"text","text":"Now the two operations' data and the beat generator that turns each one into timed spawns."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2122,"cache_read_input_tokens":113135,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2122},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"972ca841-0540-4c71-85fe-204eae6bea61","uuid":"9cb922ea-7628-4a86-a82f-983919d3d85d","timestamp":"2026-11-04T01:53:54.086Z","request_id":"req_011Cgh44wTtZJ7EfYNxjwn36"}
{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011Cgh44wnEHzeuAT6Hob3M2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WmFDwKBHoakRTQg1WNatoT","name":"Write","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-185013__xe162c9/work/OperationWolfpack-OperationWolf-claude-haiku-5-5-medium-20261103-185013/src/11-ops.js","content":"// The operations: data, then the beat generator that turns each one into timed spawns (the same seed, the same battle).\n// rail: the camera's knots [[dist, x], ...]. length: the rail's end. speed: world units a second before railSpeed.\n// gen: how often each kind of group arrives along the rail. holds: where the rail stops until the wave is clear.\n// hostages: the people to bring home (guards stand around each one; they run when the guards are dead).\n(() => {\n'use strict';\nconst WP = globalThis.WP;\n\nWP.OPS = {\n  op1: {\n    id: 'op1', n: 1, name: 'RADIO HILL', card: 'DESTROY THE ENEMY RADIO STATION', time: 'dawn',\n    sky: ['#1d1a3a', '#5a2f5e', '#d8786a', '#f6c48c'], sun: '#ffd6a0', ground: ['#3d4a2a', '#2a3a1e', '#1a2614'], hill: '#4a2f4a',\n    length: 2300, speed: 15,\n    rail: [[0, 0], [700, 220], [1400, -160], [2300, 260]],\n    gen: { group: 120, groupSize: [2, 3], runner: 380, jeep: 520, civilian: 0, goat: 0 },\n    holds: [{ at: 900, max: 22, radio: 'op1.hold' }, { at: 1700, max: 22, radio: 'op1.jeep' }],\n    radio: [[0, 'op1.go'], ['end', 'op1.station']],\n    quotas: { soldier: 36, vehicle: 3 },\n    boss: 'holt', heal: 15, perk: 'commsDown', hostages: [],\n  },\n  op2: {\n    id: 'op2', n: 2, name: 'PALM VILLAGE', card: 'FIND THE HOSTAGES AND CLEAR THE HUTS', time: 'noon',\n    sky: ['#2a6aa8', '#5aa6d8', '#9ad6e8', '#e8f4d0'], sun: '#fff4c0', ground: ['#7a9a4a', '#5a7a34', '#3a5a22'], hill: '#3f7a4a',\n    length: 2100, speed: 13,\n    rail: [[0, 0], [500, -260], [1100, 180], [2100, -60]],\n    gen: { group: 150, groupSize: [1, 2], runner: 0, jeep: 1100, civilian: 200, goat: 700 },\n    holds: [{ at: 1000, max: 25, radio: 'op2.hostage' }],\n    radio: [[0, 'op2.go'], ['end', 'op2.vane']],\n    quotas: { soldier: 28, vehicle: 2 },\n    boss: 'vane', heal: 25, perk: 'villageAid',\n    hostages: [{ at: 350, lx: -60 }, { at: 700, lx: 40 }, { at: 1000, lx: -120 }, { at: 1400, lx: 80 }, { at: 1750, lx: 0 }],\n  },\n};\nWP.OP_ORDER = ['op1', 'op2'];\n\n// the beat list for an operation: spawns and radio cues, sorted by distance along the rail. Coordinates are absolute\n// (the camera's x at that distance plus an offset), so the battle needs no randomness of its own\nWP.beatsFor = (op, rand) => {\n  const out = [];\n  const pick = (a, b) => a + rand() * (b - a);\n  const T = WP.T;\n  const cam = d => WP.railX(op.rail, d);\n  const add = (at, item) => { out.push(Object.assign({ at }, item)); };\n  const g = op.gen;\n  // soldiers pop from cover in groups; sandbags stand in front of them\n  for (let d = 110; d < op.length - 300; d += g.group * pick(0.8, 1.2)) {\n    const n = Math.round(pick(g.groupSize[0], g.groupSize[1]) * T.density);\n    const sx = cam(d) + pick(-150, 150);\n    const sp = [{ type: 'sandbag', x: sx, z: 150 + pick(0, 40) }];\n    for (let i = 0; i < n; i++) sp.push({ type: 'soldier', x: sx + (i - (n - 1) / 2) * 16, z: 150 + pick(0, 90), wave: true });\n    add(d, { spawn: sp });\n  }\n  if (g.runner) for (let d = 240; d < op.length - 300; d += g.runner * pick(0.8, 1.2)) {\n    const side = rand() < 0.5 ? -1 : 1;\n    add(d, { spawn: [{ type: 'runner', x: cam(d) - side * 200, z: pick(130, 200), vx: side * pick(40, 60), wave: true }] });\n  }\n  if (g.jeep) for (let d = 500; d < op.length - 300; d += g.jeep) {\n    const side = rand() < 0.5 ? -1 : 1;\n    add(d, { spawn: [{ type: 'jeep', x: cam(d) - side * 220, z: 190, vx: side * 42, wave: true }] });\n  }\n  if (g.civilian) for (let d = 160; d < op.length - 300; d += g.civilian * pick(0.8, 1.2)) {\n    const side = rand() < 0.5 ? -1 : 1;\n    add(d, { spawn: [{ type: 'civilian', x: cam(d) - side * 120, z: pick(120, 170), vx: side * 16, wave: false }] });\n  }\n  if (g.goat) for (let d = 330; d < op.length - 300; d += g.goat) {\n    add(d, { spawn: [{ type: 'goat', x: cam(d) - 200, z: pick(140, 170), vx: 26 }] });\n  }\n  // crates along the way: shoot one for a magazine, a grenade or medicine\n  for (let d = 260; d < op.length - 300; d += 380) add(d, { spawn: [{ type: 'crate', x: cam(d) + pick(-110, 110), z: pick(120, 150) }] });\n  // hostages stand in the village with two guards each; the guards are part of the wave\n  let hid = 0;\n  for (const h of op.hostages || []) {\n    add(h.at, { hostage: { x: cam(h.at) + h.lx, z: 140, id: ++hid } });\n  }\n  // the radio cues\n  for (const [at, key] of op.radio) if (typeof at === 'number') add(at, { radio: key });\n  for (const h of op.holds) add(h.at, { radio: h.radio, hold: h });\n  out.sort((a, b) => a.at - b.at);\n  return out;\n};\n})();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2122,"cache_read_input_tokens":113135,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2122},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"972ca841-0540-4c71-85fe-204eae6bea61","uuid":"941cfd23-48f1-49d8-8cc0-15995cc2e061","timestamp":"2026-11-04T01:54:03.151Z","request_id":"req_011Cgh44wTtZJ7EfYNxjwn36","wire_tool_inputs":{"toolu_01WmFDwKBHoakRTQg1WNatoT":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-185013__xe162c9/work/OperationWolfpack-OperationWolf-claude-haiku-5-5-medium-20261103-185013/src/11-ops.js","content":"// The operations: data, then the beat generator that turns each one into timed spawns (the same seed, the same battle).\n// rail: the camera's knots [[dist, x], ...]. length: the rail's end. speed: world units a second before railSpeed.\n// gen: how often each kind of group arrives along the rail. holds: where the rail stops until the wave is clear.\n// hostages: the people to bring home (guards stand around each one; they run when the guards are dead).\n(() => {\n'use strict';\nconst WP = globalThis.WP;\n\nWP.OPS = {\n  op1: {\n    id: 'op1', n: 1, name: 'RADIO HILL', card: 'DESTROY THE ENEMY RADIO STATION', time: 'dawn',\n    sky: ['#1d1a3a', '#5a2f5e', '#d8786a', '#f6c48c'], sun: '#ffd6a0', ground: ['#3d4a2a', '#2a3a1e', '#1a2614'], hill: '#4a2f4a',\n    length: 2300, speed: 15,\n    rail: [[0, 0], [700, 220], [1400, -160], [2300, 260]],\n    gen: { group: 120, groupSize: [2, 3], runner: 380, jeep: 520, civilian: 0, goat: 0 },\n    holds: [{ at: 900, max: 22, radio: 'op1.hold' }, { at: 1700, max: 22, radio: 'op1.jeep' }],\n    radio: [[0, 'op1.go'], ['end', 'op1.station']],\n    quotas: { soldier: 36, vehicle: 3 },\n    boss: 'holt', heal: 15, perk: 'commsDown', hostages: [],\n  },\n  op2: {\n    id: 'op2', n: 2, name: 'PALM VILLAGE', card: 'FIND THE HOSTAGES AND CLEAR THE HUTS', time: 'noon',\n    sky: ['#2a6aa8', '#5aa6d8', '#9ad6e8', '#e8f4d0'], sun: '#fff4c0', ground: ['#7a9a4a', '#5a7a34', '#3a5a22'], hill: '#3f7a4a',\n    length: 2100, speed: 13,\n    rail: [[0, 0], [500, -260], [1100, 180], [2100, -60]],\n    gen: { group: 150, groupSize: [1, 2], runner: 0, jeep: 1100, civilian: 200, goat: 700 },\n    holds: [{ at: 1000, max: 25, radio: 'op2.hostage' }],\n    radio: [[0, 'op2.go'], ['end', 'op2.vane']],\n    quotas: { soldier: 28, vehicle: 2 },\n    boss: 'vane', heal: 25, perk: 'villageAid',\n    hostages: [{ at: 350, lx: -60 }, { at: 700, lx: 40 }, { at: 1000, lx: -120 }, { at: 1400, lx: 80 }, { at: 1750, lx: 0 }],\n  },\n};\nWP.OP_ORDER = ['op1', 'op2'];\n\n// the beat list for an operation: spawns and radio cues, sorted by distance along the rail. Coordinates are absolute\n// (the camera's x at that distance plus an offset), so the battle needs no randomness of its own\nWP.beatsFor = (op, rand) => {\n  const out = [];\n  const pick = (a, b) => a + rand() * (b - a);\n  const T = WP.T;\n  const cam = d => WP.railX(op.rail, d);\n  const add = (at, item) => { out.push(Object.assign({ at }, item)); };\n  const g = op.gen;\n  // soldiers pop from cover in groups; sandbags stand in front of them\n  for (let d = 110; d < op.length - 300; d += g.group * pick(0.8, 1.2)) {\n    const n = Math.round(pick(g.groupSize[0], g.groupSize[1]) * T.density);\n    const sx = cam(d) + pick(-150, 150);\n    const sp = [{ type: 'sandbag', x: sx, z: 150 + pick(0, 40) }];\n    for (let i = 0; i < n; i++) sp.push({ type: 'soldier', x: sx + (i - (n - 1) / 2) * 16, z: 150 + pick(0, 90), wave: true });\n    add(d, { spawn: sp });\n  }\n  if (g.runner) for (let d = 240; d < op.length - 300; d += g.runner * pick(0.8, 1.2)) {\n    const side = rand() < 0.5 ? -1 : 1;\n    add(d, { spawn: [{ type: 'runner', x: cam(d) - side * 200, z: pick(130, 200), vx: side * pick(40, 60), wave: true }] });\n  }\n  if (g.jeep) for (let d = 500; d < op.length - 300; d += g.jeep) {\n    const side = rand() < 0.5 ? -1 : 1;\n    add(d, { spawn: [{ type: 'jeep', x: cam(d) - side * 220, z: 190, vx: side * 42, wave: true }] });\n  }\n  if (g.civilian) for (let d = 160; d < op.length - 300; d += g.civilian * pick(0.8, 1.2)) {\n    const side = rand() < 0.5 ? -1 : 1;\n    add(d, { spawn: [{ type: 'civilian', x: cam(d) - side * 120, z: pick(120, 170), vx: side * 16, wave: false }] });\n  }\n  if (g.goat) for (let d = 330; d < op.length - 300; d += g.goat) {\n    add(d, { spawn: [{ type: 'goat', x: cam(d) - 200, z: pick(140, 170), vx: 26 }] });\n  }\n  // crates along the way: shoot one for a magazine, a grenade or medicine\n  for (let d = 260; d < op.length - 300; d += 380) add(d, { spawn: [{ type: 'crate', x: cam(d) + pick(-110, 110), z: pick(120, 150) }] });\n  // hostages stand in the village with two guards each; the guards are part of the wave\n  let hid = 0;\n  for (const h of op.hostages || []) {\n    add(h.at, { hostage: { x: cam(h.at) + h.lx, z: 140, id: ++hid } });\n  }\n  // the radio cues\n  for (const [at, key] of op.radio) if (typeof at === 'number') add(at, { radio: key });\n  for (const h of op.holds) add(h.at, { radio: h.radio, hold: h });\n  out.sort((a, b) => a.at - b.at);\n  return out;\n};\n})();\n"}}}
