 if (pl) { pl.streak++; pl.bestStreak = Math.max(pl.bestStreak, pl.streak); }","+    this.events.push({ k: 'kill', what: e.kind, id: e.id, z: e.z, x: e.x, pid: pl && pl.id });","   }","-  civHit(e) {","-    this.kill(e, 'civilian', 1);","-    this.p.civHit++; this.p.score = Math.max(0, this.p.score - 500); this.p.streak = 0;","-    this.hurt(12, 'civilian');","+  civHit(e, pl) {","+    this.kill(e, pl);","+    this.civHit++; pl.score = Math.max(0, pl.score - 500); pl.streak = 0;","+    this.hurt(12, 'civilian', pl);","     this.events.push({ k: 'civhit', id: e.id });","   }","-  score(base) { this.p.score += base * this.multiplier; }","+  score(pl, base) { pl.score += base * this.multiplier(pl); }","   popup(sx, sy, text, color) { if (sx !== undefined && text) this.popups.push({ x: sx, y: sy, text, color, t: 0 }); }","   updatePopups(dt) {","     for (const q of this.popups) q.t += dt;"]},{"oldStart":467,"oldLines":47,"newStart":523,"newLines":49,"lines":["     this.booms = this.booms.filter(b => b.t < 1.0);","   }","   // a blast: everything within r (depth counts half, so it is a flat ellipse on the ground) takes what a shot would","-  explode(x, z, r) {","+  explode(x, z, r, pl) {","     this.booms.push({ x, z, r, t: 0, big: r > 30 });","     for (const e of this.ents.slice()) {","       if (e.dead || e.gone || e.kind === 'animal' || e.kind === 'pickup' || e.kind === 'cover') continue;","       if (Math.hypot(e.x - x, (e.z - z) * 0.5) > r) continue;","       switch (e.kind) {","-        case 'soldier': case 'runner': this.applyHit(e, 1, {}); break;","-        case 'vehicle': this.applyHit(e, 1, {}); break;","-        case 'civilian': this.civHit(e); break;","-        case 'hostage': this.applyHit(e, 1, {}); break;","-        case 'crate': this.applyHit(e, 1, {}); break;","-        case 'rocket': this.applyHit(e, 1, {}); break;","-        case 'boss': if (e.state === 'fight') { e.hp -= 2; e.flash = 1; if (e.hp <= 0) this.defeatBoss(e); } break;","+        case 'soldier': case 'vehicle': case 'boat': case 'air': case 'rocket': case 'crate': case 'hostage': this.applyHit(e, 1, {}, pl || this.p); break;","+        case 'civilian': this.civHit(e, pl || this.p); break;","+        case 'boss': if (e.state === 'fight') { e.hp -= 2; e.flash = 1; if (e.hp <= 0) this.defeatBoss(e, pl || this.p); } break;","         default: break;","       }","     }","   }","-  defeatBoss(e) {","+  defeatBoss(e, pl) {","     e.hp = 0;","-    this.kill(e, 'boss', 1);","-    this.p.kills.boss++; this.score(5000);","+    this.kill(e, pl);","+    if (pl) { pl.kills.boss++; this.score(pl, 5000); }","     this.events.push({ k: 'bossdown', name: e.name });","     this.booms.push({ x: e.x, z: e.z, r: 60, t: 0, big: true });","     this.result = 'won'; this.resultAt = this.t;","   }","   drop(x, z, item) { this.spawn('pickup', x, z, { item }); this.events.push({ k: 'drop', what: item }); }","-  collect(item) {","-    const p = this.p, T = WP.T;","-    if (item === 'mag') p.spares = Math.min(8, p.spares + 1);","-    else if (item === 'grenade') p.grenades = Math.min(8, p.grenades + 1);","-    else if (item === 'med') p.damage = Math.max(0, p.damage - 25);","-    this.events.push({ k: 'pickup', what: item });","-    void T;","+  collect(pl, item) {","+    if (item === 'mag') pl.spares = Math.min(8, pl.spares + 1);","+    else if (item === 'grenade') pl.grenades = Math.min(8, pl.grenades + 1);","+    else if (item === 'med') pl.damage = Math.max(0, pl.damage - 25);","+    else if (item === 'fury') { pl.fury = 10; this.events.push({ k: 'fury', pid: pl.id }); }","+    this.events.push({ k: 'pickup', what: item, pid: pl.id });","   }","-  hurt(amount, source) {","+  // damage to a player: the one named, else a random player still up (shared fire lands on the team)","+  hurt(amount, source, pl) {","     if (this.god || this.result !== null) return;","-    const p = this.p;","-    p.damage = Math.min(100, p.damage + amount);","-    p.dmgFlash = 1; p.streak = 0;","-    this.events.push({ k: 'hurt', amount, source });","-    if (p.damage >= 100) this.lose('down');","+    const up = this.active;","+    if (!up.length) return;","+    const target = pl && !pl.down ? pl : up[Math.floor(this.rand() * up.length)];","+    target.damage = Math.min(100, target.damage + amount);","+    target.dmgFlash = 1; target.streak = 0;","+    this.events.push({ k: 'hurt', amount, source, pid: target.id });","+    if (target.damage >= 100) {","+      target.down = true; target.reload = 0;","+      this.events.push({ k: 'down', pid: target.id });","+      if (!this.active.length) this.lose('down');","+    }","   }","   lose(why) {","     if (this.result !== null) return;"]},{"oldStart":515,"oldLines":13,"newStart":573,"newLines":72,"lines":["     this.events.push({ k: 'lost', why });","   }"," ","+  // ---- bosses: the path they take, and the attacks ------------------------------------------------------------------","+  bossAI(e, dt) {","+    if (e.state === 'enter') {","+      e.rise = Math.min(1, e.rise + dt / 1.2);","+      if (e.rise >= 1) { e.state = 'fight'; this.events.push({ k: 'boss', name: e.name, phase: 'fight' }); }","+      return;","+    }","+    e.t += dt;","+    // where it stands: parked, weaving, swaying, tracking, standing or flying in a circle","+    switch (e.path) {","+      case 'park': e.x = this.camX + 120 * Math.sin(e.t * 0.8) * 0.5; break;","+      case 'weave': e.x = this.camX + 80 * Math.sin(e.t * 0.9); break;","+      case 'sway': e.x = this.camX + 100 * Math.sin(e.t * 0.5); break;","+      case 'track': e.x = this.camX + 260 * Math.sin(e.t * 0.2); break;","+      case 'fly': e.x = this.camX + 60 * Math.sin(e.t * 0.6); break;","+      default: e.x = this.camX;","+    }","+    const enraged = e.hp <= e.hpMax / 2;","+    if (enraged && !e.enraged) { e.enraged = true; this.events.push({ k: 'boss', name: e.name, phase: 'enraged' }); }","+    this.bossSpecial(e, dt, enraged);","+    if (e.tg > 0) {","+      e.tg += dt / (1.1 * this.diff.telegraph * WP.T.telegraph);","+      if (e.tg >= 1) {","+        e.tg = 0;","+        const n = e.volley + (enraged ? 1 : 0);","+        if (e.special === 'salvo') for (let i = 0; i < n; i++) this.spawnProj('missile', e);","+        else for (let i = 0; i < n; i++) this.hurt(WP.T.enemyDamage * 0.55 * this.diff.damage, 'boss');","+        this.events.push({ k: 'volley', n });","+        e.cd = e.rate * WP.T.enemyRate * (enraged ? 0.7 : 1);","+      }","+    } else {","+      e.cd -= dt;","+      if (e.cd <= 0) e.tg = 0.0001;","+    }","+  }","+  // the extra things a boss does: paratroopers from the hill, the shield coming down, the flame nozzle, the vents","+  bossSpecial(e, dt, enraged) {","+    if (e.special === 'paratroopers') {","+      e.spec -= dt;","+      if (e.spec <= 0) {","+        e.spec = 12 / WP.T.density;","+        for (const side of [-1, 1]) this.spawn('soldier', this.camX + side * 170, 150, { wave: true });","+        this.events.push({ k: 'radio', key: 'boss.para' });","+      }","+    }","+    if (e.special === 'shield') {","+      e.spec -= dt;","+      if (e.spec <= 0) { e.shieldUp = !e.shieldUp; e.spec = e.shieldUp ? 4 : 1; }","+    }","+    if (e.special === 'nozzle' || e.special === 'vents') {","+      e.spec -= dt;","+      if (e.spec <= 0) {","+        e.spec = (enraged ? 6 : 9) * WP.T.enemyRate;","+        this.hurt(WP.T.enemyDamage * 1.2 * this.diff.damage, 'flame');","+        this.booms.push({ x: e.x, z: e.z + 40, r: 40, t: 0 });","+        this.events.push({ k: 'flame' });","+      }","+    }","+  }","+","   // ---- phases: the quota, the boss, the end ------------------------------------------------------------------------","+  quotaMet() { return QUOTA_KEYS.every(k => !this.quota[k] || this.done[k] >= this.quota[k]); }","   checkPhase() {","     if (this.result !== null) return;","-    const q = this.quota, d = this.done;","     if (this.phase === 'endhold') {","-      const met = d.soldier >= q.soldier && d.vehicle >= q.vehicle;","-      if (met) {","+      if (this.quotaMet()) {","         this.phase = 'boss';","         this.spawn(this.op.boss, this.camX, 150, {});","         this.events.push({ k: 'radio', key: this.op.radio.find(r => r[0] === 'end')[1] });"]},{"oldStart":532,"oldLines":9,"newStart":649,"newLines":12,"lines":["       if (this.reinfT <= 0) {","         this.reinfT = 4.8 / WP.T.density;","         this.reinfN++;","-        if (d.vehicle < q.vehicle && this.reinfN % 3 === 0) this.spawn('jeep', this.camX - 230, 190, { vx: 42, wave: true });","+        const q = this.quota, d = this.done, n = this.reinfN;","+        if (q.air && d.air < q.air && n % 4 === 0) this.spawn('heli', this.camX, 260, { wave: true, fly: true });","+        else if (q.boat && d.boat < q.boat && n % 3 === 0) this.spawn('skiff', this.camX + 200, 150, { vx: -36, wave: true });","+        else if (q.vehicle && d.vehicle < q.vehicle && n % 3 === 1) this.spawn('jeep', this.camX - 230, 190, { vx: 42, wave: true });","         else {","-          const side = this.reinfN % 2 ? -1 : 1;","+          const side = n % 2 ? -1 : 1;","           this.spawn('soldier', this.camX + side * 150, 150 + this.rand() * 40, { wave: true });","           this.spawn('soldier', this.camX + side * 166, 170 + this.rand() * 30, { wave: true });","         }"]},{"oldStart":547,"oldLines":8,"newStart":667,"newLines":7,"lines":["     this.hold = null;","     this.dist = this.op.length;","     this.phase = 'endhold';","-    this.done.soldier = Math.max(this.done.soldier, this.quota.soldier);","-    this.done.vehicle = Math.max(this.done.vehicle, this.quota.vehicle);","+    for (const k of QUOTA_KEYS) this.done[k] = Math.max(this.done[k], this.quota[k] || 0);","     this.camX = WP.railX(this.op.rail, this.dist);","   }","   // ---- snapshot for the tests and the debug handle -----------------------------------------------------------------"]},{"oldStart":557,"oldLines":8,"newStart":676,"newLines":9,"lines":["     return {","       op: this.opId, phase: this.phase, result: this.result, t: +this.t.toFixed(2), dist: Math.round(this.dist), camX: Math.round(this.camX),","       hold: !!this.hold, quota: this.quota, done: Object.assign({}, this.done),","-      player: { mag: p.mag, spares: p.spares, grenades: p.grenades, damage: Math.round(p.damage), score: p.score, streak: p.streak, shots: p.shots, hits: p.hits, saved: p.saved, lost: p.lost, civHit: p.civHit, kills: Object.assign({}, p.kills), cx: Math.round(p.cx), cy: Math.round(p.cy) },","-      boss: (() => { const b = this.ents.find(e => e.kind === 'boss'); return b ? { hp: b.hp, state: b.state, dead: b.dead } : null; })(),","+      player: { mag: p.mag, spares: p.spares, grenades: p.grenades, damage: Math.round(p.damage), score: p.score, streak: p.streak, shots: p.shots, hits: p.hits, kills: Object.assign({}, p.kills), cx: Math.round(p.cx), cy: Math.round(p.cy), down: p.down },","+      team: { saved: this.saved, lost: this.lost, civHit: this.civHit },","+      boss: (() => { const b = this.ents.find(e => e.kind === 'boss'); return b ? { hp: b.hp, state: b.state, dead: b.dead, name: b.name } : null; })(),","       alive: this.ents.filter(e => !e.dead && !e.gone).length,","       hostages: this.ents.filter(e => e.kind === 'hostage' && !e.gone).length,","     };"]}],"originalFile":"// The battle: one operation's rules, with no DOM, no audio and no drawing. step(dt, input) advances it in fixed steps.\n// input: { mx, my (crosshair velocity, -1..1), aim: [x, y] | null (sets the crosshair), fire (held), grenade (pressed),\n// reload (pressed) }. Every noteworthy thing goes into battle.events (kill, shot, hurt, pickup, boom, radio, ...), and the\n// renderer reads battle.booms, battle.popups and the entities. Enemies telegraph every shot with a closing ring (tg): the\n// shot lands when the ring closes unless the enemy is killed first.\n(() => {\n'use strict';\nconst WP = globalThis.WP;\nconst { clamp, proj, unproj } = WP;\n\nWP.Battle = class Battle {\n  constructor(opId, o = {}) {\n    const op = (this.op = WP.OPS[opId]);\n    if (!op) throw new Error('no operation ' + opId);\n    this.opId = opId;\n    this.diff = WP.DIFF[o.difficulty || 'veteran'];\n    this.god = !!o.god;             // the attract mode and the tests: damage does nothing\n    this.infinite = !!o.infinite;   // the attract mode and the tests: magazines never run dry\n    this.rand = WP.rng(o.seed === undefined ? WP.hashSeed(opId) : o.seed);\n    this.t = 0;\n    this.dist = 0;\n    this.camX = WP.railX(op.rail, 0);\n    this.phase = 'rail';            // rail | endhold | boss | won | lost\n    this.hold = null;               // the rail is stopped: { max } until the wave is clear\n    this.holdT = 0;\n    this.beats = WP.beatsFor(op, this.rand);\n    this.decor = WP.decorFor(op, this.rand);\n    this.nextBeat = 0;\n    this.ents = [];\n    this.nid = 1;\n    this.events = [];\n    this.booms = [];\n    this.popups = [];\n    this.grens = [];\n    this.result = null;\n    this.resultAt = 0;\n    this.reinfT = 1.5;\n    this.reinfN = 0;\n    this.emergencyAt = -99;\n    this.boss = null;\n    this.hostagesTotal = op.hostages.length;\n    this.quota = Object.assign({}, op.quotas);\n    this.done = { soldier: 0, vehicle: 0 };\n    this.p = {\n      cx: WP.W / 2, cy: 120, mag: WP.T.magSize, spares: WP.T.spares, grenades: WP.T.grenades,\n      damage: 0, score: 0, streak: 0, bestStreak: 0, shots: 0, hits: 0,\n      kills: { soldier: 0, vehicle: 0, boss: 0 }, civHit: 0, saved: 0, lost: 0,\n      reload: 0, cool: 0, gcool: 0, bloom: 0, muzzle: 0, dmgFlash: 0, hitFlash: 0, reloads: 0,\n    };\n    // what the last operation left the player with (score, damage, spares, grenades, hostages home)\n    if (o.carry) Object.assign(this.p, { score: o.carry.score, damage: o.carry.damage, spares: o.carry.spares, grenades: o.carry.grenades, saved: o.carry.saved, lost: o.carry.lost, civHit: o.carry.civHit, kills: Object.assign({}, o.carry.kills) });\n  }\n\n  // ---- queries the renderer and the bot use -------------------------------------------------------------------------\n  get over() { return this.result !== null; }\n  // the battle has ended and its last moments have played out\n  get finished() { return this.result !== null && this.t >= this.resultAt + 2.2; }\n  // an entity's screen anchor: the pixel of its ground point and its scale (k), with y as its height above ground\n  anchor(e) {\n    const p = proj(e.x, e.z, this.camX);\n    return { sx: p.sx, gy: p.gy, k: p.k, sy: p.gy - (e.y || 0) * p.k };\n  }\n  // the screen rectangle an entity can be hit in (null if it has none)\n  rect(e) {\n    const a = this.anchor(e), t = WP.TYPES[e.type] || {};\n    if (e.kind === 'boss') {\n      const up = clamp(e.rise === undefined ? 1 : e.rise, 0, 1);\n      const w = e.w * a.k, top = a.gy - e.h * a.k * up;\n      return { x0: a.sx - w / 2, x1: a.sx + w / 2, y0: top, y1: a.gy, headY: top + 0.32 * (a.gy - top) };\n    }\n    if (e.kind === 'rocket') {\n      const s = Math.max(2, 4 * a.k);\n      return { x0: a.sx - s, x1: a.sx + s, y0: a.sy - s, y1: a.sy + s };\n    }\n    if (e.kind === 'pickup') {\n      const s = Math.max(4, 6 * a.k);\n      return { x0: a.sx - s, x1: a.sx + s, y0: a.sy - s, y1: a.sy + s };\n    }\n    const w = t.w * a.k, h = t.h * a.k * (e.kind === 'soldier' || e.kind === 'runner' ? Math.max(0.05, e.rise) : 1);\n    return { x0: a.sx - w / 2, x1: a.sx + w / 2, y0: a.gy - h, y1: a.gy };\n  }\n  // can the crosshair hit this entity right now?\n  targetable(e) {\n    if (e.dead || e.gone) return false;\n    switch (e.kind) {\n      case 'soldier': return e.rise >= 0.55;\n      case 'runner': case 'vehicle': case 'civilian': case 'hostage': case 'animal': case 'crate': case 'pickup': case 'rocket':\n        return true;\n      case 'boss': return e.state === 'fight';\n      default: return false;\n    }\n  }\n  alive(kind) { return this.ents.filter(e => !e.dead && !e.gone && (kind ? e.kind === kind : true)); }\n  waveAlive() { return this.ents.some(e => e.wave && !e.dead && !e.gone && (e.kind === 'soldier' || e.kind === 'runner' || e.kind === 'vehicle')); }\n  get accuracy() { return this.p.shots ? this.p.hits / this.p.shots : 0; }\n  get multiplier() { return 1 + Math.min(3, Math.floor(this.p.streak / 5)); }\n\n  // ---- the step -----------------------------------------------------------------------------------------------------\n  step(dt, inp = {}) {\n    this.events.length = 0;\n    this.t += dt;\n    this.updatePopups(dt);\n    this.updateBooms(dt);\n    if (this.result !== null) { this.updateEntities(dt, true); return; }\n    this.aim(dt, inp);\n    this.rail(dt);\n    this.updateEntities(dt, false);\n    this.trigger(dt, inp);\n    this.updateGrenades(dt, inp);\n    this.ents = this.ents.filter(e => !e.gone);\n    this.checkPhase();\n  }\n\n  aim(dt, inp) {\n    const p = this.p, T = WP.T;\n    if (inp.aim) { p.cx = inp.aim[0]; p.cy = inp.aim[1]; }\n    else { p.cx += (inp.mx || 0) * T.crosshairSpeed * dt; p.cy += (inp.my || 0) * T.crosshairSpeed * dt; }\n    p.cx = clamp(p.cx, 0, WP.W - 1);\n    p.cy = clamp(p.cy, 8, WP.PLAY_H - 6);\n  }\n\n  rail(dt) {\n    const op = this.op;\n    if (this.phase === 'rail') {\n      if (this.hold) {\n        this.holdT += dt;\n        if (!this.waveAlive() || this.holdT >= this.hold.max) this.hold = null;\n      } else {\n        this.dist += op.speed * WP.T.railSpeed * dt;\n        const h = op.holds.find(h => !h.used && this.dist >= h.at);\n        if (h) { h.used = true; this.hold = h; this.holdT = 0; this.dist = h.at; }\n      }\n      while (this.nextBeat < this.beats.length && this.beats[this.nextBeat].at <= this.dist) this.fireBeat(this.beats[this.nextBeat++]);\n      if (this.dist >= op.length) {\n        this.dist = op.length;\n        this.phase = 'endhold';\n        this.events.push({ k: 'radio', key: 'end' });\n      }\n    }\n    this.camX = WP.railX(op.rail, this.dist);\n  }\n\n  fireBeat(b) {\n    if (b.radio) this.events.push({ k: 'radio', key: b.radio });\n    if (b.hold) this.events.push({ k: 'hold' });\n    if (b.spawn) for (const s of b.spawn) this.spawn(s.type, s.x, s.z, s);\n    if (b.hostage) {\n      const h = b.hostage;\n      this.spawn('hostage', h.x, h.z, { state: 'held', id: h.id });\n      for (let i = 0; i < 2; i++) this.spawn('soldier', h.x + (i ? 22 : -22), h.z + 30 + i * 12, { wave: true, guardOf: h.id });\n    }\n  }\n\n  spawn(type, x, z, o = {}) {\n    const def = WP.TYPES[type] || WP.BOSSES[type];\n    const e = {\n      id: this.nid++, type, kind: def.kind || 'boss', x, z, y: o.y || 0,\n      hp: def.hp || 1, state: o.state || 'hide', t: 0, tg: 0, cd: 0, rise: 0,\n      vx: o.vx || 0, wave: !!o.wave, guardOf: o.guardOf, id2: o.id, dead: false, gone: false, deadT: 0, flash: 0,\n      upFor: 0, item: o.item,\n    };\n    if (e.kind === 'soldier') {\n      e.state = 'hide'; e.t = 0.3 + this.rand() * 1.4; e.upFor = 2.0 + this.rand() * 1.6; e.cd = 0.5 + this.rand() * 1.5;\n    }\n    if (e.kind === 'runner') { e.rise = 1; e.state = 'run'; e.cd = 1.0 + this.rand(); }\n    if (e.kind === 'vehicle') { e.cd = 1.5 + this.rand() * 1.2; }\n    if (e.kind === 'hostage') { e.rise = 1; }\n    if (e.kind === 'rocket') { e.z = z; e.y = o.y || 10; }\n    if (e.kind === 'boss') {\n      const b = WP.BOSSES[type];\n      e.hp = Math.round(b.hp * WP.T.bossHealth);\n      e.hpMax = e.hp; e.w = b.w; e.h = b.h; e.z = 150; e.x = this.camX; e.state = 'enter'; e.t = 0; e.cd = 2.2; e.rise = 0;\n      e.volley = b.volley; e.rate = b.rate; e.name = b.name;\n    }\n    this.ents.push(e);\n    return e;\n  }\n\n  // ---- entity behaviour ---------------------------------------------------------------------------------------------\n  updateEntities(dt, frozen) {\n    for (const e of this.ents) {\n      if (e.dead) { e.deadT -= dt; if (e.deadT <= 0) e.gone = true; e.tg = 0; continue; }\n      if (e.flash > 0) e.flash = Math.max(0, e.flash - dt * 4);\n      if (frozen) continue;\n      switch (e.kind) {\n        case 'soldier': this.soldierAI(e, dt); break;\n        case 'runner': this.runnerAI(e, dt); break;\n        case 'vehicle': this.vehicleAI(e, dt); break;\n        case 'civilian': this.walkAI(e, dt, 200); break;\n        case 'hostage': this.hostageAI(e, dt); break;\n        case 'animal': this.animalAI(e, dt); break;\n        case 'pickup': e.t += dt; if (e.t > 9.5) e.gone = true; break;\n        case 'rocket': this.rocketAI(e, dt); break;\n        case 'boss': this.bossAI(e, dt); break;\n        default: break;\n      }\n    }\n  }\n  soldierAI(e, dt) {\n    if (e.state === 'hide') {\n      e.rise = 0; e.t -= dt;\n      if (e.t <= 0) { e.state = 'rise'; }\n    } else if (e.state === 'rise') {\n      e.rise = Math.min(1, e.rise + dt / 0.22);\n      if (e.rise >= 1) { e.state = 'up'; e.t = e.upFor; }\n    } else if (e.state === 'up') {\n      e.t -= dt;\n      this.fireCycle(e, dt);\n      if (e.t <= 0) { e.state = 'drop'; e.tg = 0; }\n    } else if (e.state === 'drop') {\n      e.rise = Math.max(0, e.rise - dt / 0.2);\n      if (e.rise <= 0) { e.state = 'hide'; e.t = 1.2 + this.rand() * 1.4; e.cd = 1 + this.rand(); }\n    }\n  }\n  runnerAI(e, dt) {\n    e.x += e.vx * dt;\n    if (Math.abs(e.x - this.camX) > 300) { e.gone = true; return; }\n    this.fireCycle(e, dt);\n  }\n  vehicleAI(e, dt) {\n    e.x += e.vx * dt;\n    const lim = 240;\n    if (e.x - this.camX > lim) { e.x = this.camX + lim; e.vx = -Math.abs(e.vx); }\n    if (e.x - this.camX < -lim) { e.x = this.camX - lim; e.vx = Math.abs(e.vx); }\n    this.fireCycle(e, dt);\n  }\n  walkAI(e, dt, lim) {\n    e.x += e.vx * dt;\n    if (e.x - this.camX > lim) e.vx = -Math.abs(e.vx);\n    if (e.x - this.camX < -lim) e.vx = Math.abs(e.vx);\n  }\n  hostageAI(e, dt) {\n    if (e.state === 'held') {\n      const guards = this.ents.some(g => g.guardOf === e.id2 && !g.dead && !g.gone);\n      if (!guards) { e.state = 'run'; e.vx = (e.x < this.camX ? -1 : 1) * 58; e.z = e.z; this.events.push({ k: 'freed', id: e.id }); }\n      return;\n    }\n    e.x += e.vx * dt;\n    const p = proj(e.x, e.z, this.camX);\n    if (p.sx < -24 || p.sx > WP.W + 24) {\n      e.gone = true;\n      this.p.saved++; this.p.score += 1000 * this.multiplier;\n      this.events.push({ k: 'saved', id: e.id });\n    }\n  }\n  animalAI(e, dt) {\n    if (e.fleeing) e.vx = e.fleeing * 90;\n    e.x += e.vx * dt;\n    if (Math.abs(e.x - this.camX) > 300) e.gone = true;\n  }\n  rocketAI(e, dt) {\n    e.z -= 88 * dt;\n    if (e.z <= 96) {\n      this.explode(e.x, 96, 16, { source: 'rocket' });\n      this.hurt(WP.T.enemyDamage * 1.6 * this.diff.damage, 'rocket');\n      e.gone = true;\n    }\n  }\n  bossAI(e, dt) {\n    if (e.state === 'enter') {\n      e.rise = Math.min(1, e.rise + dt / 1.2);\n      if (e.rise >= 1) { e.state = 'fight'; this.events.push({ k: 'boss', name: e.name, phase: 'fight' }); }\n      return;\n    }\n    const enraged = e.hp <= e.hpMax / 2;\n    if (enraged && !e.enraged) { e.enraged = true; this.events.push({ k: 'boss', name: e.name, phase: 'enraged' }); }\n    if (e.tg > 0) {\n      e.tg += dt / (1.1 * this.diff.telegraph * WP.T.telegraph);\n      if (e.tg >= 1) {\n        e.tg = 0;\n        const n = e.volley + (enraged ? 1 : 0);\n        for (let i = 0; i < n; i++) this.hurt(WP.T.enemyDamage * 0.55 * this.diff.damage, 'boss');\n        this.events.push({ k: 'volley', n });\n        e.cd = (e.rate * WP.T.enemyRate) * (enraged ? 0.7 : 1);\n      }\n    } else {\n      e.cd -= dt;\n      if (e.cd <= 0) e.tg = 0.0001;\n    }\n    e.x = this.camX;\n  }\n  // a shooter's closing ring: it starts when the cooldown ends and the shot lands when the ring closes\n  fireCycle(e, dt) {\n    if (e.tg > 0) {\n      e.tg += dt / (WP.T.telegraph * this.diff.telegraph);\n      if (e.tg >= 1) { e.tg = 0; this.fireAt(e); }\n    } else {\n      e.cd -= dt;\n      if (e.cd <= 0 && (e.rise >= 0.9 || e.kind === 'vehicle' || e.kind === 'runner')) e.tg = 0.0001;\n    }\n  }\n  fireAt(e) {\n    e.cd = (2.2 + this.rand() * 1.6) * WP.T.enemyRate;\n    if (e.kind === 'vehicle') {\n      this.spawn('rocket', e.x, e.z, { y: 14 });\n      this.events.push({ k: 'launch', id: e.id });\n      e.cd = (3.6 + this.rand() * 1.4) * WP.T.enemyRate;\n      return;\n    }\n    this.hurt(WP.T.enemyDamage * this.diff.damage, 'shot');\n    this.events.push({ k: 'shot', id: e.id, kind: e.kind });\n  }\n\n  // ---- the player's gun and grenades --------------------------------------------------------------------------------\n  trigger(dt, inp) {\n    const p = this.p, T = WP.T;\n    p.cool -= dt; p.gcool -= dt;\n    p.muzzle = Math.max(0, p.muzzle - dt * 14);\n    p.dmgFlash = Math.max(0, p.dmgFlash - dt * 2.5);\n    p.hitFlash = Math.max(0, p.hitFlash - dt * 5);\n    p.bloom = Math.max(0, p.bloom - dt * 3.2);\n    if (p.reload > 0) {\n      p.reload -= dt;\n      if (p.reload <= 0) {\n        p.reload = 0;\n        const need = Math.min(T.magSize - p.mag, this.infinite ? T.magSize : p.spares * T.magSize);\n        if (this.infinite) p.mag = T.magSize;\n        else { p.mag += need; p.spares -= Math.ceil(need / T.magSize); if (p.spares < 0) p.spares = 0; }\n        this.events.push({ k: 'reloaded' });\n      }\n    } else if (inp.reload && p.mag < T.magSize && (this.infinite || p.spares > 0)) {\n      p.reload = 1.1; p.reloads++; this.events.push({ k: 'reload' });\n    }\n    if (inp.grenade && p.grenades > 0 && p.gcool <= 0) this.throwGrenade();\n    if (inp.fire && p.reload <= 0 && p.cool <= 0) {\n      if (p.mag <= 0 && !this.infinite) {\n        if (p.spares > 0) { p.reload = 1.1; p.reloads++; this.events.push({ k: 'reload' }); }\n        else this.outOfAmmo();\n      } else this.shoot();\n    }\n  }\n  outOfAmmo() {\n    const p = this.p;\n    if (this.diff.emergency) {\n      if (this.t - this.emergencyAt > 14) {\n        this.emergencyAt = this.t;\n        this.spawn('pickup', this.camX + (this.rand() - 0.5) * 60, 130, { item: 'mag' });\n        this.events.push({ k: 'drop', what: 'emergency' });\n      }\n    } else if (p.grenades <= 0) this.lose('ammo');\n  }\n  shoot() {\n    const p = this.p, T = WP.T;\n    p.mag -= this.infinite ? 0 : 1;\n    if (this.infinite) p.mag = Math.max(p.mag, 1);\n    p.shots++; p.cool = 1 / T.fireRate; p.muzzle = 1; p.bloom = Math.min(1, p.bloom + 0.22);\n    this.events.push({ k: 'shot-fired', x: p.cx, y: p.cy });\n    const r = 2 + 5 * p.bloom * T.bloom;\n    let best = null;\n    for (const e of this.ents) {\n      if (!this.targetable(e)) continue;\n      const R = this.rect(e);\n      if (!R) continue;\n      if (p.cx >= R.x0 - r && p.cx <= R.x1 + r && p.cy >= R.y0 - r && p.cy <= R.y1 + r) {\n        if (!best || e.z < best.e.z) best = { e, R };\n      }\n    }\n    if (!best) { p.streak = 0; this.events.push({ k: 'miss', x: p.cx, y: p.cy }); return; }\n    const head = best.e.kind === 'boss' && p.cy < best.R.headY;\n    p.hits++;\n    this.applyHit(best.e, head ? 3 : 1, { head, sx: p.cx, sy: p.cy });\n  }\n  throwGrenade() {\n    const p = this.p;\n    p.grenades--; p.gcool = 0.5;\n    const g = unproj(p.cx, p.cy, this.camX) || { x: this.camX, z: 170 };\n    const z = clamp(g.z, 84, 300);\n    this.grens.push({ x: g.x, z, t: 0, dur: 0.7 + (z / 300) * 0.25, sx: p.cx, sy: p.cy });\n    this.events.push({ k: 'throw' });\n  }\n  updateGrenades(dt) {\n    for (const g of this.grens) {\n      g.t += dt;\n      if (g.t >= g.dur) {\n        g.done = true;\n        this.explode(g.x, g.z, 36, { source: 'grenade' });\n        this.events.push({ k: 'boom', what: 'grenade' });\n      }\n    }\n    this.grens = this.grens.filter(g => !g.done);\n  }\n\n  // ---- hits, kills and blasts ---------------------------------------------------------------------------------------\n  applyHit(e, mult, where) {\n    const p = this.p;\n    p.hitFlash = 1;\n    switch (e.kind) {\n      case 'soldier': case 'runner':\n        this.kill(e, 'soldier', mult);\n        p.kills.soldier++; this.done.soldier++;\n        this.score(100);\n        break;\n      case 'vehicle':\n        e.hp -= mult; e.flash = 1;\n        if (e.hp <= 0) { this.kill(e, 'vehicle', 1); p.kills.vehicle++; this.done.vehicle++; this.score(500); }\n        else this.events.push({ k: 'hitvehicle', id: e.id });\n        break;\n      case 'boss': {\n        if (e.state !== 'fight') break;\n        e.hp -= mult; e.flash = 1;\n        this.popup(where.sx, where.sy, where.head ? 'HEAD' : '', '#ffe060');\n        this.events.push({ k: 'bosshit', head: !!where.head });\n        if (e.hp <= 0) this.defeatBoss(e);\n        break;\n      }\n      case 'civilian':\n        this.civHit(e);\n        break;\n      case 'hostage':\n        this.kill(e, 'hostage', 1);\n        p.lost++; this.p.score = Math.max(0, p.score - 1000);\n        this.hurt(25, 'hostage');\n        this.events.push({ k: 'hostagelost', id: e.id });\n        break;\n      case 'animal':\n        // animals are never killed: the first hit makes them drop what they carry, and they run off\n        if (!e.hit) {\n          e.hit = true;\n          this.drop(e.x, e.z, this.rand() < 0.5 ? 'mag' : this.rand() < 0.6 ? 'grenade' : 'med');\n          this.score(50);\n          this.events.push({ k: 'animal', id: e.id });\n        }\n        e.fleeing = e.vx >= 0 ? 1 : -1;\n        e.vx = e.fleeing * 90;\n        break;\n      case 'crate':\n        this.drop(e.x, e.z, this.rand() < 0.45 ? 'mag' : this.rand() < 0.5 ? 'grenade' : 'med');\n        this.score(100);\n        this.booms.push({ x: e.x, z: e.z, r: 10, t: 0 });\n        e.gone = true;\n        this.events.push({ k: 'crate', id: e.id });\n        break;\n      case 'pickup':\n        this.collect(e.item); e.gone = true;\n        break;\n      case 'rocket':\n        this.booms.push({ x: e.x, z: e.z, r: 12, t: 0 });\n        e.gone = true; this.score(50);\n        this.events.push({ k: 'shootdown' });\n        break;\n      default: break;\n    }\n    if (where.sx !== undefined && e.kind !== 'boss') this.popup(where.sx, where.sy, '+' + (this.multiplier > 1 ? this.multiplier + 'x' : ''), '#ffffff');\n    if (e.kind === 'soldier' || e.kind === 'runner') this.popup(where.sx, where.sy, 'KILL', '#ffe060');\n  }\n  kill(e, what, mult) {\n    if (e.dead) return;\n    e.dead = true; e.deadT = 0.5; e.tg = 0; e.flash = 1;\n    this.p.streak++; this.p.bestStreak = Math.max(this.p.bestStreak, this.p.streak);\n    this.events.push({ k: 'kill', what, id: e.id, z: e.z, x: e.x });\n    void mult;\n  }\n  civHit(e) {\n    this.kill(e, 'civilian', 1);\n    this.p.civHit++; this.p.score = Math.max(0, this.p.score - 500); this.p.streak = 0;\n    this.hurt(12, 'civilian');\n    this.events.push({ k: 'civhit', id: e.id });\n  }\n  score(base) { this.p.score += base * this.multiplier; }\n  popup(sx, sy, text, color) { if (sx !== undefined && text) this.popups.push({ x: sx, y: sy, text, color, t: 0 }); }\n  updatePopups(dt) {\n    for (const q of this.popups) q.t += dt;\n    this.popups = this.popups.filter(q => q.t < 0.9);\n  }\n  updateBooms(dt) {\n    for (const b of this.booms) b.t += dt;\n    this.booms = this.booms.filter(b => b.t < 1.0);\n  }\n  // a blast: everything within r (depth counts half, so it is a flat ellipse on the ground) takes what a shot would\n  explode(x, z, r) {\n    this.booms.push({ x, z, r, t: 0, big: r > 30 });\n    for (const e of this.ents.slice()) {\n      if (e.dead || e.gone || e.kind === 'animal' || e.kind === 'pickup' || e.kind === 'cover') continue;\n      if (Math.hypot(e.x - x, (e.z - z) * 0.5) > r) continue;\n      switch (e.kind) {\n        case 'soldier': case 'runner': this.applyHit(e, 1, {}); break;\n        case 'vehicle': this.applyHit(e, 1, {}); break;\n        case 'civilian': this.civHit(e); break;\n        case 'hostage': this.applyHit(e, 1, {}); break;\n        case 'crate': this.applyHit(e, 1, {}); break;\n        case 'rocket': this.applyHit(e, 1, {}); break;\n        case 'boss': if (e.state === 'fight') { e.hp -= 2; e.flash = 1; if (e.hp <= 0) this.defeatBoss(e); } break;\n        default: break;\n      }\n    }\n  }\n  defeatBoss(e) {\n    e.hp = 0;\n    this.kill(e, 'boss', 1);\n    this.p.kills.boss++; this.score(5000);\n    this.events.push({ k: 'bossdown', name: e.name });\n    this.booms.push({ x: e.x, z: e.z, r: 60, t: 0, big: true });\n    this.result = 'won'; this.resultAt = this.t;\n  }\n  drop(x, z, item) { this.spawn('pickup', x, z, { item }); this.events.push({ k: 'drop', what: item }); }\n  collect(item) {\n    const p = this.p, T = WP.T;\n    if (item === 'mag') p.spares = Math.min(8, p.spares + 1);\n    else if (item === 'grenade') p.grenades = Math.min(8, p.grenades + 1);\n    else if (item === 'med') p.damage = Math.max(0, p.damage - 25);\n    this.events.push({ k: 'pickup', what: item });\n    void T;\n  }\n  hurt(amount, source) {\n    if (this.god || this.result !== null) return;\n    const p = this.p;\n    p.damage = Math.min(100, p.damage + amount);\n    p.dmgFlash = 1; p.streak = 0;\n    this.events.push({ k: 'hurt', amount, source });\n    if (p.damage >= 100) this.lose('down');\n  }\n  lose(why) {\n    if (this.result !== null) return;\n    this.result = 'lost'; this.resultAt = this.t;\n    this.events.push({ k: 'lost', why });\n  }\n\n  // ---- phases: the quota, the boss, the end ------------------------------------------------------------------------\n  checkPhase() {\n    if (this.result !== null) return;\n    const q = this.quota, d = this.done;\n    if (this.phase === 'endhold') {\n      const met = d.soldier >= q.soldier && d.vehicle >= q.vehicle;\n      if (met) {\n        this.phase = 'boss';\n        this.spawn(this.op.boss, this.camX, 150, {});\n        this.events.push({ k: 'radio', key: this.op.radio.find(r => r[0] === 'end')[1] });\n        return;\n      }\n      // the quota is not met: reinforcements keep coming until it is\n      this.reinfT -= 1 / 120;\n      if (this.reinfT <= 0) {\n        this.reinfT = 4.8 / WP.T.density;\n        this.reinfN++;\n        if (d.vehicle < q.vehicle && this.reinfN % 3 === 0) this.spawn('jeep', this.camX - 230, 190, { vx: 42, wave: true });\n        else {\n          const side = this.reinfN % 2 ? -1 : 1;\n          this.spawn('soldier', this.camX + side * 150, 150 + this.rand() * 40, { wave: true });\n          this.spawn('soldier', this.camX + side * 166, 170 + this.rand() * 30, { wave: true });\n        }\n      }\n    }\n  }\n  // the dev screen's skip: the rail ends here and the quota counts as met, so the boss comes next\n  skipToBoss() {\n    if (this.result !== null || this.phase !== 'rail') return;\n    this.hold = null;\n    this.dist = this.op.length;\n    this.phase = 'endhold';\n    this.done.soldier = Math.max(this.done.soldier, this.quota.soldier);\n    this.done.vehicle = Math.max(this.done.vehicle, this.quota.vehicle);\n    this.camX = WP.railX(this.op.rail, this.dist);\n  }\n  // ---- snapshot for the tests and the debug handle -----------------------------------------------------------------\n  snapshot() {\n    const p = this.p;\n    return {\n      op: this.opId, phase: this.phase, result: this.result, t: +this.t.toFixed(2), dist: Math.round(this.dist), camX: Math.round(this.camX),\n      hold: !!this.hold, quota: this.quota, done: Object.assign({}, this.done),\n      player: { mag: p.mag, spares: p.spares, grenades: p.grenades, damage: Math.round(p.damage), score: p.score, streak: p.streak, shots: p.shots, hits: p.hits, saved: p.saved, lost: p.lost, civHit: p.civHit, kills: Object.assign({}, p.kills), cx: Math.round(p.cx), cy: Math.round(p.cy) },\n      boss: (() => { const b = this.ents.find(e => e.kind === 'boss'); return b ? { hp: b.hp, state: b.state, dead: b.dead } : null; })(),\n      alive: this.ents.filter(e => !e.dead && !e.gone).length,\n      hostages: this.ents.filter(e => e.kind === 'hostage' && !e.gone).length,\n    };\n  }\n};\n})();\n","userModified":false},"tool_result_meta":[{"id":"toolu_018Gbr2LXo64J5qfjdz3inSn","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
