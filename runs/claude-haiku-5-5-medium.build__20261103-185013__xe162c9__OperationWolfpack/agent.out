tub), text() {}, prop() {}, actor() {}, shape() {} };\n  const b = new WP.Battle('op2', { seed: 41 });\n  for (let i = 0; i < 600; i++) b.step(1 / 120, { mx: 0.2, fire: i % 7 < 4, grenade: i === 200 });\n  let drawn = 0;\n  try { WP.drawBattle(stub, b); drawn++; } catch (e) { check('the battle draws', false, e.message); }\n  for (const [name, sc] of Object.entries(WP.scenes)) {\n    try { sc.draw && sc.draw(fakeR); drawn++; } catch (e) { check(`the ${name} screen draws`, false, e.message); }\n  }\n  check('every screen draws without error', drawn >= 11, 'drawn ' + drawn);\n}\ngame.debug.start('op2', { seed: 32 });\nfor (let i = 0; i < 120 * 8 && !(snap().scene === 'play' && game.debug.battle() && game.debug.battle().opId === 'op2'); i++) game.advance(1 / 120);\n\"\"\")\nrep(\"\"\"  check(`${id}: no errors during the playthrough`, game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n}\"\"\",\"\"\"  check(`${id}: no errors during the playthrough`, game.errors.length === 0, game.errors.map(e => e.message).join(' | '));\n  if (id === 'op2') check('op2: the bot brings the workers home', b.p.saved >= 1, JSON.stringify(b.snapshot().player));\n}\"\"\")\nopen(p,'w').write(s)\nEOF\ntimeout 900 node tests/run.mjs 2>&1 | head -20","description":"Add pause-return, draw-smoke and rescue checks, run suite"}},"wire_ingest_context":{"toolu_01Vmhkp5s1cdWK5n53UmbDrM":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-haiku-5-5-medium.build__20261103-185013__xe162c9/work/OperationWolfpack-OperationWolf-claude-haiku-5-5-medium-20261103-185013"}}}
