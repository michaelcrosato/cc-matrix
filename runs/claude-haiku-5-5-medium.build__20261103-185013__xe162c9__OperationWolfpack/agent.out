chronized start: negative during the countdown, -Infinity before start. */\n382:  hub.time = function () {\n386:  /** A seeded random number generator (0 ≤ n < 1), the same sequence on every device for the same label. */\n387:  hub.rng = function (label) {\n397:  /** A number the hub can rank: finite, given as a number or as text. Not null, '' or true, which JSON or Number would make 0. */\n398:  function finite(v) {\n402:  /**\n407:  function outcomeOf(outcome) {\n422:  /** Race and side by side: report your own outcome once, {time: ms} (lower wins) or {score: n} (higher wins), with optional stats and awards. */\n423:  hub.result = function (outcome) {\n438:  /** Versus and co-op: the host reports the standings once, best first, ties grouped: [[2], [0, 3], [1]]. */\n439:  hub.finish = function (outcome) {\n449:  function sendProgress() {\n457:  /** Your standing during play, for the hub's scoreboard: {score, label}. Call it as often as you like; the hub hears it about once a second. */\n458:  hub.progress = function (p) {\n467:  /** For the harness, in or out of a session: fn() → { scene, menu, world, input }, read with inspect(). */\n468:  hub.probe = function (fn) {\n472:  hub.inspect = function () {\n481:  /** The game cannot run here (no WebGL, failed load): the hub skips it. */\n482:  hub.fail = function (message) {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_015Y3YmHbmC3JbCoFF4GHopm","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
