 s = this.players.reduce((n, p) => n + p.shots, 0), h = this.players.reduce((n, p) => n + p.hits, 0); return s ? h / s : 0; }","+  multiplier(pl = this.p) { return 1 + Math.min(3, Math.floor(pl.streak / 5)); }","+  get done2() { return this.done; }"," ","   // ---- the step -----------------------------------------------------------------------------------------------------","-  step(dt, inp = {}) {","+  step(dt, inputs = {}) {","+    const list = Array.isArray(inputs) ? inputs : [inputs];","     this.events.length = 0;","     this.t += dt;","     this.updatePopups(dt);","     this.updateBooms(dt);","     if (this.result !== null) { this.updateEntities(dt, true); return; }","-    this.aim(dt, inp);","+    this.players.forEach((pl, i) => {","+      if (pl.down) return;","+      const inp = list[i] || {};","+      this.aim(pl, dt, inp);","+      this.trigger(pl, dt, inp);","+    });","     this.rail(dt);","     this.updateEntities(dt, false);","-    this.trigger(dt, inp);","-    this.updateGrenades(dt, inp);","+    this.updateGrenades(dt);","     this.ents = this.ents.filter(e => !e.gone);","     this.checkPhase();","   }"," ","-  aim(dt, inp) {","-    const p = this.p, T = WP.T;","-    if (inp.aim) { p.cx = inp.aim[0]; p.cy = inp.aim[1]; }","-    else { p.cx += (inp.mx || 0) * T.crosshairSpeed * dt; p.cy += (inp.my || 0) * T.crosshairSpeed * dt; }","-    p.cx = clamp(p.cx, 0, WP.W - 1);","-    p.cy = clamp(p.cy, 8, WP.PLAY_H - 6);","+  aim(pl, dt, inp) {","+    const T = WP.T;","+    if (inp.aim) { pl.cx = inp.aim[0]; pl.cy = inp.aim[1]; }","+    else { pl.cx += (inp.mx || 0) * T.crosshairSpeed * dt; pl.cy += (inp.my || 0) * T.crosshairSpeed * dt; }","+    pl.cx = clamp(pl.cx, 0, WP.W - 1);","+    pl.cy = clamp(pl.cy, 8, WP.PLAY_H - 6);","   }"," ","   rail(dt) {"]},{"oldStart":152,"oldLines":25,"newStart":169,"newLines":37,"lines":["   }"," ","   spawn(type, x, z, o = {}) {","-    const def = WP.TYPES[type] || WP.BOSSES[type];","+    const def = WP.TYPES[type] || {};","     const e = {","       id: this.nid++, type, kind: def.kind || 'boss', x, z, y: o.y || 0,","       hp: def.hp || 1, state: o.state || 'hide', t: 0, tg: 0, cd: 0, rise: 0,","       vx: o.vx || 0, wave: !!o.wave, guardOf: o.guardOf, id2: o.id, dead: false, gone: false, deadT: 0, flash: 0,","-      upFor: 0, item: o.item,","+      upFor: 0, item: o.item, weapon: def.weapon, quota: def.quota, dmg: def.dmg || 1, pk: o.pk, owner: o.owner,","+      telegraphMult: def.weapon === 'sniper' ? 1.6 : 1, speed: 0,","     };","     if (e.kind === 'soldier') {","-      e.state = 'hide'; e.t = 0.3 + this.rand() * 1.4; e.upFor = 2.0 + this.rand() * 1.6; e.cd = 0.5 + this.rand() * 1.5;","+      if (def.rise1 || def.runs) { e.state = 'run'; e.rise = 1; }","+      else { e.state = 'hide'; e.t = 0.3 + this.rand() * 1.4; e.upFor = 2.0 + this.rand() * 1.6; }","+      if (def.runs) e.cd = 1 + this.rand();","+      else e.cd = 0.5 + this.rand() * 1.5;","+      if (def.weapon === 'mortar') e.cd = 2.0;","     }","-    if (e.kind === 'runner') { e.rise = 1; e.state = 'run'; e.cd = 1.0 + this.rand(); }","-    if (e.kind === 'vehicle') { e.cd = 1.5 + this.rand() * 1.2; }","+    if (e.kind === 'vehicle' || e.kind === 'boat') { e.cd = 1.5 + this.rand() * 1.2; }","+    if (e.kind === 'air') {","+      e.cd = 2.0; e.hover = { z: 170, y: 55 }; e.y = 55; e.z = 260; e.state = 'fly';","+      e.hp = def.hp; e.speed = 45;","+    }","     if (e.kind === 'hostage') { e.rise = 1; }","-    if (e.kind === 'rocket') { e.z = z; e.y = o.y || 10; }","+    if (e.kind === 'rocket') { e.z = z; e.y = o.y || 10; e.pk = o.pk || 'rocket'; }","+    if (e.kind === 'crate' && type === 'dynamite') { e.dyn = true; }","     if (e.kind === 'boss') {","       const b = WP.BOSSES[type];","-      e.hp = Math.round(b.hp * WP.T.bossHealth);","-      e.hpMax = e.hp; e.w = b.w; e.h = b.h; e.z = 150; e.x = this.camX; e.state = 'enter'; e.t = 0; e.cd = 2.2; e.rise = 0;","-      e.volley = b.volley; e.rate = b.rate; e.name = b.name;","+      e.name = b.name; e.hp = Math.round(b.hp * WP.T.bossHealth); e.hpMax = e.hp;","+      e.w = b.w; e.h = b.h; e.special = b.special; e.path = b.path; e.shield = !!b.shield; e.shieldUp = !!b.shield;","+      e.sprite = b.sprite; e.rate = b.rate; e.volley = b.volley; e.flies = !!b.flies;","+      e.z = b.path === 'fly' ? 180 : b.path === 'track' ? 240 : b.path === 'weave' ? 200 : 150;","+      e.y = b.flies ? 60 : 0;","+      e.x = this.camX; e.state = 'enter'; e.t = 0; e.cd = 2.4; e.rise = 0; e.spec = 0;","     }","     this.ents.push(e);","     return e;"]},{"oldStart":184,"oldLines":22,"newStart":213,"newLines":28,"lines":["       if (frozen) continue;","       switch (e.kind) {","         case 'soldier': this.soldierAI(e, dt); break;","-        case 'runner': this.runnerAI(e, dt); break;","         case 'vehicle': this.vehicleAI(e, dt); break;","+        case 'boat': this.boatAI(e, dt); break;","+        case 'air': this.heliAI(e, dt); break;","         case 'civilian': this.walkAI(e, dt, 200); break;","         case 'hostage': this.hostageAI(e, dt); break;","         case 'animal': this.animalAI(e, dt); break;","         case 'pickup': e.t += dt; if (e.t > 9.5) e.gone = true; break;","-        case 'rocket': this.rocketAI(e, dt); break;","+        case 'rocket': this.projectileAI(e, dt); break;","         case 'boss': this.bossAI(e, dt); break;","         default: break;","       }","     }","   }","   soldierAI(e, dt) {","+    if (e.state === 'run') {","+      if (e.vx) { e.x += e.vx * dt; if (Math.abs(e.x - this.camX) > 300) { e.gone = true; return; } }","+      this.fireCycle(e, dt);","+      return;","+    }","     if (e.state === 'hide') {","       e.rise = 0; e.t -= dt;","-      if (e.t <= 0) { e.state = 'rise'; }","+      if (e.t <= 0) e.state = 'rise';","     } else if (e.state === 'rise') {","       e.rise = Math.min(1, e.rise + dt / 0.22);","       if (e.rise >= 1) { e.state = 'up'; e.t = e.upFor; }"]},{"oldStart":212,"oldLines":16,"newStart":247,"newLines":29,"lines":["       if (e.rise <= 0) { e.state = 'hide'; e.t = 1.2 + this.rand() * 1.4; e.cd = 1 + this.rand(); }","     }","   }","-  runnerAI(e, dt) {","+  vehicleAI(e, dt) {","+    if (e.vx) {","+      e.x += e.vx * dt;","+      const lim = 240;","+      if (e.x - this.camX > lim) { e.x = this.camX + lim; e.vx = -Math.abs(e.vx); }","+      if (e.x - this.camX < -lim) { e.x = this.camX - lim; e.vx = Math.abs(e.vx); }","+    }","+    if (e.type !== 'truck') this.fireCycle(e, dt);","+  }","+  boatAI(e, dt) {","     e.x += e.vx * dt;","-    if (Math.abs(e.x - this.camX) > 300) { e.gone = true; return; }","+    if (Math.abs(e.x - this.camX) > 260) { e.vx = -e.vx; e.x = this.camX + clamp(e.x - this.camX, -260, 260); }","     this.fireCycle(e, dt);","   }","-  vehicleAI(e, dt) {","-    e.x += e.vx * dt;","-    const lim = 240;","-    if (e.x - this.camX > lim) { e.x = this.camX + lim; e.vx = -Math.abs(e.vx); }","-    if (e.x - this.camX < -lim) { e.x = this.camX - lim; e.vx = Math.abs(e.vx); }","+  // the gunship flies in from far off, hovers at its station and strafes side to side, until it is shot down","+  heliAI(e, dt) {","+    if (e.state === 'fly') {","+      e.z -= e.speed * dt;","+      if (e.z <= e.hover.z) { e.z = e.hover.z; e.state = 'hover'; }","+    } else {","+      e.x += Math.sin(this.t * 0.7 + e.id) * 40 * dt;","+      e.x = clamp(e.x, this.camX - 200, this.camX + 200);","+    }","     this.fireCycle(e, dt);","   }","   walkAI(e, dt, lim) {"]},{"oldStart":232,"oldLines":14,"newStart":280,"newLines":14,"lines":["   hostageAI(e, dt) {","     if (e.state === 'held') {","       const guards = this.ents.some(g => g.guardOf === e.id2 && !g.dead && !g.gone);","-      if (!guards) { e.state = 'run'; e.vx = (e.x < this.camX ? -1 : 1) * 58; e.z = e.z; this.events.push({ k: 'freed', id: e.id }); }","+      if (!guards) { e.state = 'run'; e.vx = (e.x < this.camX ? -1 : 1) * 58; this.events.push({ k: 'freed', id: e.id }); }","       return;","     }","