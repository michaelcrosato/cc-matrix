e coverage run and the screen captures. Screens were last viewed on 3b61c36c; since then only About's text, the bot, the gate's exit and the Tin changed.\nEOF\nrm -rf .scratch dist tests/browser/__pycache__; echo \"temp left: $(ls -d .scratch dist tests/browser/__pycache__ 2>/dev/null | wc -l)\"; n=0; for p in $(pgrep -x node; pgrep -x MainThread; pgrep -x python3; pgrep -f \"chrome|headless_shell\"); do c=$(readlink /proc/$p/cwd 2>/dev/null); case \"$c\" in \"$PWD\"*) [ \"$(cat /proc/$p/comm 2>/dev/null)\" != \"bash\" ] && { echo \"mine: $p\"; n=$((n+1)); };; esac; done; echo \"my processes running: $n\"; sha256sum $H | cut -c1-24; sha256sum pixel-engine.js | cut -c1-24; python3 - <<'EOF'\nimport json\nd=json.load(open('../exit-interview.json'))\nprint('interview parses:',list(d.keys()))\nprint('testing[0]:',d['testingFeedback'][0][:40],'| testing[3]:',d['testingFeedback'][3][:50])\nprint('mentions owner ending:','owner ended the build' in d['testingFeedback'][2].lower(), '| prompt:', 'ending the build' in d['promptFeedback'][1])\nprint('usage:',d['sourceInformation']['usage'])\nEOF\npython3 - <<'EOF'\nimport glob\ns=open(glob.glob('../RegrettableEvil4-*.html')[0],errors='ignore').read()\nprint('About text in the HTML:', 'took the death limit and the balance rules out of the requirements' in s)\nEOF\ngrep -c \"'DAMAGE TAKEN X', 1, 0.1\" src/data/tuning.js; ls .. | tr '\\n' ' '","description":"Record the ending, clean up, verify the hand-in","timeout":60000}}}
