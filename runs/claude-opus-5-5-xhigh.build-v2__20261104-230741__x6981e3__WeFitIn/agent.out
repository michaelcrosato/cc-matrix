#...#oooo#...#'\"),\n            (\"'#.oo..#..##..#'\",\"'#oooo.#..##..#'\"),(\"'#..##...#.oo.#'\",\"'#..##...#oooo#'\")]:\n    assert a in t; t=t.replace(a,b)\nopen(p,'w').write(t)\n\n# ---------- tray: cups are triggers, all eight are live\np='src/scenes/activity/tray.js'; t=open(p).read()\na=\"          this.cups.push({ x, z, color: ch });\\n\"\nassert a in t\nt=t.replace(a,\"\"\"          // Untagged, so it sees dynamic bodies. A ball touches it with its surface: this much radius means its centre is within CUP_R.\n          this.cups.push({ x, z, color: ch, trigger: physics.trigger({ cylinder: { halfHeight: 0.5, radius: CUP_R - BALL_R } }, [x, 0.3, z]) });\n\"\"\")\na=\"\"\"      physics.world.createCollider(RAPIER.ColliderDesc.ball(BALL_R).setFriction(0.3).setRestitution(0.2).setDensity(2), body);\n      this.vits.push({ mesh, body, color, done: false, wait: 0, i });\n\"\"\"\nassert a in t\nt=t.replace(a,\"\"\"      const collider = physics.world.createCollider(RAPIER.ColliderDesc.ball(BALL_R).setFriction(0.3).setRestitution(0.2).setDensity(2), body);\n      this.vits.push({ mesh, body, collider, color, done: false, wait: 0, i });\n\"\"\")\na=\"\"\"    const jitter = (i * 2.399) % 6.28;\n    return [s[0] + Math.cos(jitter) * 0.2, 0.3, s[1] + Math.sin(jitter) * 0.2];\n\"\"\"\nassert a in t\nt=t.replace(a,\"\"\"    const jitter = (i * 2.399) % 6.28;\n    return [s[0] + Math.cos(jitter) * 0.04, 0.3, s[1] + Math.sin(jitter) * 0.04];\n\"\"\")\na=t[t.index(\"    for (const v of this.vits ?? []) {\\n      v.done = false; v.wait = 0; v.queued = true;\"):t.index(\"  get timeLimit()\")]\nt=t.replace(a,\"\"\"    for (const v of this.vits ?? []) {\n      v.done = false; v.wait = 0;\n      this.respawnVit(v);\n    }\n  }\n\n\"\"\")\nt=t.replace(\"let best = this.botVit && !this.botVit.done && !this.botVit.queued && this.botVit.wait <= 0 ? this.botVit : null;\",\"let best = this.botVit && !this.botVit.done && this.botVit.wait <= 0 ? this.botVit : null;\")\nt=t.replace(\"    