{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjLHLxx99DuVwnrCLwpe","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Fm9CdfnWpqhMmStu6Lvx5m","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/scenes/report.js <<'EOF'\n// The Evening Report: minutes, Drips, stars, the chart, tomorrow's concern, new unlocks. Then dusk, then morning.\nimport { applySky, skyAt } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { CONFIRM } from '../core/actions.js';\nimport { goalMet, nextDay, shownAge } from '../core/week.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { Ounce, place } from '../art/props.js';\nimport { ACTIVITIES, CLASSMATE_SCORES } from '../data/activities.js';\nimport { CONCERNS, REPORT_LINES } from '../data/lines.js';\nimport { MILESTONES } from '../data/unlocks.js';\nimport { drawAgeChart } from '../ui/chart.js';\nimport { DialogueScreen } from '../ui/dialogue.js';\nimport { say, sayCentered, sayRight } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading, panel, starRow } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nexport class ReportScene extends BaseScene {\n  name = 'report';\n  id = 'report';\n  canPause = true;\n  phase = 'count';\n  countT = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [3.2, 2.8, 9], target: [3.2, 1.3, 0], fov: 32 }; }\n\n  async build(ctx) {\n    plazaSet(ctx, 19);\n    applySky(ctx.engine, skyAt(19));\n    const slot = App.slot;\n    place(ctx, 'hammock', { at: [5.4, 0, 0.8] });\n    this.lantern = ctx.lights.request({ position: [3, 2.4, 2], color: 0xffcf80, intensity: 8, radius: 9, flicker: 'torch' });\n    this.ounce = new Ounce(ctx, { at: [2, 0.04, 1.6], yaw: 0.5, scale: 1.5 });\n    const av = await makeAvatar(ctx, withWardrobe(slot?.look ?? {}, slot), { at: [5.4, 0.9, 0.8], yaw: 1.57, clip: 'LieIdle', shadow: false });\n    this.avatar = av;\n    App.music('report');\n    this.lines = this.buildLines();\n    this.concern = CONCERNS[((slot?.day ?? 1) - 1 + (slot?.week ?? 1) * 2) % CONCERNS.length];\n    this.minutes = Math.floor((slot?.todaySeconds ?? 0) / 60);\n    this.seconds = Math.round((slot?.todaySeconds ?? 0) % 60);\n  }\n\n  buildLines() {\n    const slot = App.slot;\n    if (!slot) return [];\n    const lines = [];\n    const beat = new Set();\n    for (const d of slot.todayDone) for (const w of d.beat ?? []) beat.add(w);\n    const firstNew = ['marguerite', 'june', 'dennis'].find((w) => beat.has(w) && !(slot.reacted ??= {})[w]);\n    if (firstNew) { slot.reacted[firstNew] = true; lines.push(REPORT_LINES[`beat${firstNew[0].toUpperCase()}${firstNew.slice(1)}`]); }\n    if (!slot.todayDone.length) lines.push(`ounce: ${REPORT_LINES.empty}`);\n    else lines.push(`ounce: ${goalMet(slot) ? REPORT_LINES.goal : REPORT_LINES.noGoal}`);\n    return lines;\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    const go = input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft');\n    if (this.phase === 'count' && (go || this.countT > 4.5)) {\n      this.phase = 'talk';\n      const lines = [...this.lines, `ounce: ${this.concern}`];\n      App.stack.push(new DialogueScreen(lines, { onDone: () => { this.phase = 'done'; } }));\n    } else if (this.phase === 'done' && !App.loading) {\n      this.phase = 'leaving';\n      this.nextMorning();\n    }\n  }\n\n  nextMorning() {\n    const slot = App.slot;\n    nextDay(slot);\n    App.store.write();\n    App.go('weighin');\n  }\n\n  onUpdate(ctx, dt) {\n    this.ounce.update(dt);\n    this.avatar.update(dt);\n    this.countT += dt;\n    if (this.phase === 'done' && !this.saidDone && App.dev.autopilot) { this.saidDone = true; this.phase = 'leaving'; this.nextMorning(); }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const slot = App.slot;\n    if (!slot) return;\n    const x = 12;\n    const w = Math.min(208, Math.round(hud.width * 0.5));\n    heading2(hud, slot.week > 1 ? `Week ${slot.week}, day ${slot.day}` : `Day ${slot.day} Report`, x);\n    const y = 34;\n    panel(hud, x, y, w, 54, { fill: 'white', name: 'report-numbers' });\n    say(hud, x + 5, y + 4, 'Time in class', { color: 'teal', shadow: false, name: 'report' });\n    sayRight(hud, x + w - 5, y + 4, `${this.minutes}m ${String(this.seconds).padStart(2, '0')}s`, { color: 'ink', shadow: false, name: 'report' });\n    say(hud, x + 5, y + 16, 'Drips today', { color: 'teal', shadow: false, name: 'report' });\n    sayRight(hud, x + w - 5, y + 16, `+${slot.todayDrips}`, { color: 'ink', shadow: false, name: 'report' });\n    say(hud, x + 5, y + 28, 'Stars', { color: 'teal', shadow: false, name: 'report' });\n    sayRight(hud, x + w - 5, y + 28, `${slot.todayStars}`, { color: 'ink', shadow: false, name: 'report' });\n    const goal = goalMet(slot);\n    say(hud, x + 5, y + 40, goal ? 'Prescription filled' : 'Prescription open', { color: goal ? 'green' : 'red', shadow: false, name: 'report' });\n    const chartY = y + 60;\n    const chartH = Math.max(58, Math.min(96, hud.height - chartY - 30));\n    const ages = slot.ages.slice(-7).map((a) => shownAge(slot, a));\n    drawAgeChart(hud, x, chartY, w, chartH, ages);\n    const items = slot.todayNew ?? [];\n    if (items.length) {\n      const m = MILESTONES.find((n) => n.id === items[items.length - 1]);\n      if (m) say(hud, x + 1, chartY + chartH + 4, `New: ${m.name}`, { color: 'lime', name: 'report-new' });\n    }\n    if (!App.stack.open) promptBar(hud, App.device, [['confirm', this.phase === 'done' ? 'Good night' : 'Next']]);\n    void starRow; void ACTIVITIES; void CLASSMATE_SCORES; void sayCentered; void heading;\n  }\n\n  status() { const s = App.slot; return `report | day ${s?.day} | ${this.phase} | drips ${s?.todayDrips}`; }\n  dispose() { this.lantern?.release?.(); }\n}\n\nfunction heading2(hud, text, x) {\n  const w = text.length * 12 + 8;\n  hud.rect(x - 1, 6, w, 21, 'navy');\n  say(hud, x + 3, 8, text, { scale: 2, name: 'heading' });\n}\nEOF\ncat > src/scenes/jar.js <<'EOF'\n// The Sweat Jar, close up. One focal element: the jar, slowly filling.\nimport { PALETTE, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { BACK, CONFIRM } from '../core/actions.js';\nimport { place } from '../art/props.js';\nimport { JAR_MAX, MILESTONES } from '../data/unlocks.js';\nimport { sayCentered, say, wrap, charsIn } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading, panel, disc } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\n\nconst { CylinderGeometry, Mesh, BoxGeometry } = THREE;\n\nexport class JarScene extends BaseScene {\n  name = 'jar';\n  id = 'jar';\n  canPause = true;\n  shownFill = 0;\n  dripT = 0;\n  i = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [-1.4, 2.4, 7.6], target: [-1.4, 1.7, 0], fov: 32 }; }\n\n  build(ctx) {\n    plazaSet(ctx, 12);\n    place(ctx, 'sweat-jar', { at: [0, 0, 0] });\n    // Toon materials are opaque, so the fluid is faked: a sky cylinder 1 cm wider than the wall, with a highlight.\n    this.fluid = new Mesh(new CylinderGeometry(0.96, 0.96, 1, 12), toonMaterial(PALETTE.sky));\n    this.fluid.position.set(0, 0.4, 0);\n    this.fluid.scale.y = 0.02;\n    ctx.scene.add(this.fluid);\n    this.shine = new Mesh(new BoxGeometry(0.1, 1, 0.05), toonMaterial(PALETTE.white));\n    this.shine.position.set(-0.48, 0.4, 0.84);\n    this.shine.scale.y = 0.02;\n    ctx.scene.add(this.shine);\n    App.music('title');\n    const s = App.slot;\n    this.target = Math.min(1, (s?.drips ?? 0) / JAR_MAX);\n    this.lastDrips = s?.jarSeen ?? 0;\n    if (s) { s.jarSeen = s.drips; App.store.write(); }\n    this.shownFill = Math.min(1, this.lastDrips / JAR_MAX);\n    this.i = Math.max(0, MILESTONES.findIndex((m) => (s?.drips ?? 0) < m.drips));\n  }\n\n  leave() { App.go('hub', { from: 'jar' }); }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight') || input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft')) { App.sfx('menuBack'); this.leave(); }\n  }\n\n  onUpdate(ctx, dt) {\n    if (this.shownFill < this.target) {\n      this.shownFill = Math.min(this.target, this.shownFill + dt * 0.08);\n      this.dripT -= dt;\n      if (this.dripT <= 0) {\n        this.dripT = 0.24;\n        App.sfx('jarDrip', { pitch: this.shownFill * 12 });\n        ctx.particles.burst('dripDrop', [0, 0.4 + this.fluid.scale.y + 0.1, 0.4]);\n      }\n    }\n    const h = Math.max(0.02, this.shownFill * 2.05);\n    this.fluid.scale.y = h;\n    this.fluid.position.y = 0.4 + h / 2;\n    this.shine.scale.y = h * 0.8;\n    this.shine.position.y = 0.4 + h * 0.5;\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const s = App.slot;\n    const x = Math.round(hud.width * 0.52);\n    const w = Math.min(hud.width - x - 12, 210);\n    heading(hud, 'The Sweat Jar', 10);\n    sayCentered(hud, x + w / 2, 36, `${s?.drips ?? 0}`, { scale: 4, color: 'cyan', name: 'drips' });\n    sayCentered(hud, x + w / 2, 72, 'Drips', { color: 'white', name: 'drips-label' });\n    const next = MILESTONES.find((m) => (s?.drips ?? 0) < m.drips);\n    const got = MILESTONES.filter((m) => (s?.drips ?? 0) >= m.drips);\n    const y = 88;\n    const rowH = 11;\n    const lastGot = got[got.length - 1];\n    const lines = [];\n    if (next) lines.push({ t: `Next at ${next.drips}: ${next.name}`, c: 'teal' });\n    else lines.push({ t: 'The jar is full. There is no next.', c: 'teal' });\n    if (lastGot) wrap(lastGot.remark, charsIn(w - 10)).forEach((t) => lines.push({ t, c: 'ink' }));\n    panel(hud, x, y, w, lines.length * rowH + 8, { fill: 'white', name: 'jar-panel' });\n    lines.forEach((l, i) => say(hud, x + 5, y + 4 + i * rowH, l.t.slice(0, charsIn(w - 10)), { color: l.c, shadow: false, name: 'jar-text' }));\n    // Milestone dots along the jar's scale.\n    const by = y + lines.length * rowH + 16;\n    MILESTONES.forEach((m, i) => {\n      const dx = x + 8 + i * Math.floor((w - 16) / MILESTONES.length);\n      disc(hud, dx, by, 3.5, (s?.drips ?? 0) >= m.drips ? 'lime' : 'slate');\n    });\n    promptBar(hud, App.device, [['back', 'Back to the island']]);\n  }\n\n  status() { return `jar | drips ${App.slot?.drips ?? 0}`; }\n}\nEOF\ncat > src/scenes/records.js <<'EOF'\n// The Hall of Numbers: chart, records one activity a page, calendar.\nimport { App } from '../app.js';\nimport { BACK, MENU_LEFT, MENU_RIGHT } from '../core/actions.js';\nimport { shownAge } from '../core/week.js';\nimport { place } from '../art/props.js';\nimport { ACTIVITIES, CLASSMATE_SCORES, PLAYABLE_IDS } from '../data/activities.js';\nimport { drawAgeChart } from '../ui/chart.js';\nimport { say, sayCentered, sayRight } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { TabBar } from '../ui/screens/common.js';\nimport { heading, panel, starRow, starRowWidth } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\n\nexport class RecordsScene extends BaseScene {\n  name = 'records';\n  id = 'records';\n  canPause = true;\n  page = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.4, 9], target: [0, 2, 0], fov: 32 }; }\n\n  build(ctx) {\n    plazaSet(ctx, 11);\n    place(ctx, 'numbers-board', { at: [0, 0, -2], scale: 1.8 });\n    this.tabs = new TabBar(['Chart', 'Records', 'Calendar']);\n    App.music('title');\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    this.tabs.update(ctx);\n    if (this.tabs.current === 'Records') {\n      const n = PLAYABLE_IDS.length;\n      if (input.wasPressed(...MENU_RIGHT) || input.wheel > 0) { this.page = (this.page + 1) % n; App.sfx('menuMove'); }\n      if (input.wasPressed(...MENU_LEFT) || input.wheel < 0) { this.page = (this.page - 1 + n) % n; App.sfx('menuMove'); }\n    }\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight')) { App.sfx('menuBack'); App.go('hub', { from: 'hall' }); }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const s = App.slot;\n    heading(hud, 'Hall of Numbers', 8);\n    this.tabs.draw(ctx, 34);\n    const w = Math.min(hud.width - 24, 340);\n    const x = Math.round((hud.width - w) / 2);\n    const y = 52;\n    const h = hud.height - y - 26;\n    if (this.tabs.current === 'Chart') {\n      const ages = (s?.ages ?? []).slice(-7).map((a) => shownAge(s, a));\n      drawAgeChart(hud, x, y, w, Math.min(h, 150), ages);\n    } else if (this.tabs.current === 'Records') {\n      const id = PLAYABLE_IDS[this.page];\n      const def = ACTIVITIES[id];\n      const rec = s?.records[id];\n      panel(hud, x, y, w, Math.min(h, 142), { fill: 'white', name: 'record' });\n      sayCentered(hud, hud.width / 2, y + 5, def.name, { color: 'teal', shadow: false, name: 'record-name' });\n      sayCentered(hud, hud.width / 2, y + 20, rec ? `${Math.round(rec.best)}` : '-', { scale: 4, color: 'ink', shadow: false, name: 'record-best' });\n      starRow(hud, Math.round(hud.width / 2 - starRowWidth(1) / 2), y + 58, rec?.stars ?? 0);\n      const others = CLASSMATE_SCORES[id];\n      let ry = y + 74;\n      for (const k of ['dennis', 'june', 'marguerite']) {\n        say(hud, x + 40, ry, k[0].toUpperCase() + k.slice(1), { color: 'slate', shadow: false, name: 'record-row' });\n        sayRight(hud, x + w - 40, ry, String(others[k]), { color: 'ink', shadow: false, name: 'record-row' });\n        ry += 11;\n      }\n      sayCentered(hud, hud.width / 2, y + Math.min(h, 142) - 13, `${this.page + 1} / ${PLAYABLE_IDS.length}`, { color: 'slate', shadow: false, name: 'record-page' });\n    } else {\n      panel(hud, x, y, w, Math.min(h, 110), { fill: 'white', name: 'calendar' });\n      const cw = Math.floor((w - 16) / 7);\n      for (let d = 1; d <= 7; d++) {\n        const cx = x + 8 + (d - 1) * cw;\n        const past = s && (s.week > 1 || d < s.day);\n        const today = s && s.week === 1 && d === s.day;\n        hud.rect(cx + 1, y + 26, cw - 3, 44, today ? 'cyan' : past ? 'lime' : 'mist');\n        sayCentered(hud, cx + cw / 2, y + 42, String(d), { scale: 2, color: 'ink', shadow: false, name: 'calendar-day' });\n        if (s?.ages?.[d - 1] !== undefined && s.week === 1) sayCentered(hud, cx + cw / 2, y + 74, String(shownAge(s, s.ages[d - 1])), { color: 'slate', shadow: false, name: 'calendar-age' });\n      }\n      sayCentered(hud, hud.width / 2, y + 8, s?.week > 1 ? `Week ${s.week}` : 'The Week', { color: 'teal', shadow: false, name: 'calendar-title' });\n    }\n    promptBar(hud, App.device, this.tabs.current === 'Records' ? [['adjust', 'Activity'], ['tabs', 'Page'], ['back', 'Back']] : [['tabs', 'Page'], ['back', 'Back']]);\n  }\n\n  status() { return `records | ${this.tabs?.current} | page ${this.page}`; }\n}\nEOF\ncat > src/scenes/locker.js <<'EOF'\n// The Locker Room: you, on a turntable. Skin, hair, top, bottom, headband, jar unlocks.\nimport { App } from '../app.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { place } from '../art/props.js';\nimport { BOTTOM_COLORS, HAIR_COLORS, HAIR_STYLES, HEADBANDS, SKINS, TOP_COLORS } from '../data/classmates.js';\nimport { MILESTONES } from '../data/unlocks.js';\nimport { Menu } from '../ui/menu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { box, setSky } from './sets.js';\nimport { floorPlane } from '../art/textures.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nexport class LockerScene extends BaseScene {\n  name = 'locker';\n  id = 'locker';\n  canPause = false;\n  spin = 0;\n  rebuilding = false;\n\n  cameraConfig() { return { preset: 'fixed', position: [1.6, 1.8, 5.8], target: [1.6, 1, 0], fov: 32 }; }\n\n  async build(ctx) {\n    setSky(ctx, 12);\n    ctx.scene.add(floorPlane('clinic-tile', 16, 10, { at: [0, 0, 0] }));\n    box(ctx, 16, 0.5, 10, [0, -0.26, 0], 'mist', { cast: false });\n    box(ctx, 16, 5, 0.3, [0, 2.5, -2.8], 'white', { cast: false });\n    box(ctx, 16, 0.3, 0.2, [0, 2.6, -2.6], 'cyan', { cast: false });\n    place(ctx, 'lockers', { at: [-2.4, 0, -2.2] });\n    place(ctx, 'lockers', { at: [2.8, 0, -2.2] });\n    place(ctx, 'towel-rack', { at: [5.6, 0, -1.8] });\n    place(ctx, 'dais', { at: [1.6, -0.2, 0] });\n    App.music('title');\n    this.look = { ...App.slot.look };\n    this.avatar = await makeAvatar(ctx, withWardrobe(this.look, App.slot), { at: [1.6, 0.14, 0], clip: 'Idle' });\n    this.menu = new Menu(this.items(), { width: 196, y: 42, scale: 1, rowH: 16, maxRows: 11, onBack: () => this.leave() });\n    this.menu.o.x = 12;\n  }\n\n  cycle(key, list, d) {\n    const i = Math.max(0, list.indexOf(this.look[key] ?? list[0]));\n    const v = list[(i + d + list.length) % list.length];\n    if (v === null) delete this.look[key]; else this.look[key] = v;\n    this.changed();\n  }\n\n  /** Long sleeves and trousers together: \"long\". The bun is a hair style. */\n  items() {\n    const slot = App.slot;\n    const row = (label, id, key, list) => ({ label, id, value: () => String(this.look[key] ?? 'none'), adjust: (d) => this.cycle(key, list, d), action: () => this.cycle(key, list, 1), sound: 'menuMove' });\n    const items = [\n      row('Skin', 'skin', 'skin', SKINS),\n      row('Hair style', 'hairStyle', 'hairStyle', HAIR_STYLES),\n      row('Hair colour', 'hair', 'hair', HAIR_COLORS),\n      row('Top', 'top', 'top', TOP_COLORS),\n      row('Bottom', 'bottom', 'bottom', BOTTOM_COLORS),\n      { label: 'Length', id: 'long', value: () => (this.look.long ? 'Long' : 'Short'), adjust: () => { this.look.long = !this.look.long; this.changed(); }, action: () => { this.look.long = !this.look.long; this.changed(); }, sound: 'menuMove' },\n      row('Headband', 'headband', 'headband', HEADBANDS),\n    ];\n    for (const m of MILESTONES) {\n      if (!slot.wardrobe.includes(m.id)) continue;\n      items.push({ label: m.name, id: m.id, value: () => (this.isWorn(m.id) ? 'On' : 'Off'), adjust: () => this.toggleWorn(m.id), action: () => this.toggleWorn(m.id), sound: 'menuMove' });\n    }\n    return items;\n  }\n\n  isWorn(id) { return (App.slot.worn ?? App.slot.wardrobe).includes(id); }\n\n  toggleWorn(id) {\n    const slot = App.slot;\n    const worn = new Set(slot.worn ?? slot.wardrobe);\n    if (worn.has(id)) worn.delete(id); else worn.add(id);\n    slot.worn = [...worn];\n    if (id === 'confidence') App.say('ounce', 'No visible effect. As advertised.');\n    this.changed();\n  }\n\n  changed() {\n    App.slot.look = { ...this.look };\n    App.store.write();\n    this.dirty = true;\n  }\n\n  async rebuild(ctx) {\n    this.rebuilding = true;\n    const old = this.avatar;\n    const fresh = await makeAvatar(ctx, withWardrobe(this.look, App.slot), { at: [1.6, 0.14, 0], clip: 'Idle' });\n    fresh.root.rotation.y = this.spin;\n    ctx.scene.remove(old.root);\n    if (old.shadow) ctx.scene.remove(old.shadow);\n    fresh.squash.kick(0.6);\n    this.avatar = fresh;\n    this.rebuilding = false;\n  }\n\n  leave() { App.go('hub', { from: 'locker' }); }\n\n  onInput(ctx, dt) { this.menu?.update(ctx, dt); }\n\n  onUpdate(ctx, dt) {\n    if (this.dirty && !this.rebuilding) { this.dirty = false; this.rebuild(ctx); }\n    if (!this.avatar) return;\n    this.spin += dt * 0.7;\n    this.avatar.root.rotation.y = this.spin;\n    this.avatar.update(dt);\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    heading(hud, 'Locker Room', 8);\n    if (this.menu) {\n      const save = hud.width;\n      this.drawMenuLeft(ctx, save);\n    }\n    promptBar(hud, App.device, [['adjust', 'Change'], ['move', 'Choose'], ['back', 'Done']]);\n  }\n\n  /** The same menu, on the left, so the turntable has the right of the screen. */\n  drawMenuLeft(ctx) {\n    const m = this.menu;\n    const { hud } = ctx;\n    const w = Math.min(196, Math.round(hud.width * 0.48));\n    m.o.width = w;\n    const shim = { ...ctx, hud: new Proxy(hud, { get(t, k) { if (k === 'width') return w + 24; const v = t[k]; return typeof v === 'function' ? v.bind(t) : v; } }) };\n    m.draw(shim);\n  }\n\n  status() { return `locker | focus ${this.menu?.focus} | look ${JSON.stringify(this.look)}`; }\n}\nEOF\ncat > src/scenes/ferry.js <<'EOF'\n// Day 1: the ferry comes in, Ounce's island gets bigger, you get off.\nimport { App } from '../app.js';\nimport { BACK, CONFIRM } from '../core/actions.js';\nimport { Timeline, THREE } from '../../pixel-engine.js';\nimport { place } from '../art/props.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { FERRY_LINES } from '../data/lines.js';\nimport { TITLE } from '../data/title.js';\nimport { sanitize, sayCentered, wrap, charsIn } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { BaseScene } from './base.js';\nimport { buildIsland } from './hub.js';\nimport { gulls } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nconst { Vector3 } = THREE;\nconst LENGTH = 16;\n\nexport class FerryScene extends BaseScene {\n  name = 'ferry';\n  id = 'ferry';\n  canPause = false;\n\n  cameraConfig() { return { preset: 'fixed', position: [12, 7, 44], target: [0, 1, 14], fov: 34 }; }\n\n  async build(ctx) {\n    const world = buildIsland(ctx, { walls: false });\n    this.water = world.water;\n    this.gulls = gulls(ctx, 7, { min: [-10, 4, 6], max: [12, 8, 26] });\n    this.boat = place(ctx, 'ferry', { at: [8, -0.7, 52], yaw: 180 }).object;\n    const slot = App.slot;\n    this.avatar = await makeAvatar(ctx, withWardrobe(slot?.look ?? {}, slot), { at: [8, 0.55, 49], yaw: 3.14, clip: 'Idle', shadow: false });\n    place(ctx, 'pier', { at: [8, -1.1, 24.5], params: { len: 15 } });\n    App.music('title');\n    this.tl = new Timeline({\n      shots: [\n        { at: 0, position: [14, 6, 62], target: [8, 1, 48], fov: 34 },\n        { at: 7, position: [20, 7, 42], target: [4, 1, 22], fov: 34 },\n        { at: 13, position: [15, 4, 38], target: [8, 1.2, 28], fov: 34 },\n        { at: LENGTH, position: [13.5, 3.2, 35], target: [8, 1.3, 26], fov: 34 },\n      ],\n      lines: FERRY_LINES.map((l) => ({ ...l })),\n      cues: [\n        { at: 2, name: 'squawk', cosmetic: true, run: () => App.sfx('gullSquawk') },\n        { at: 10.5, name: 'horn', cosmetic: true, run: () => App.sfx('rumble', { volume: 0.5 }) },\n        { at: 13.4, name: 'off', run: () => { this.disembark = true; this.avatar.play('Walk', { fade: 0.2 }); } },\n      ],\n      duration: LENGTH,\n      onEnd: () => this.finish(),\n    });\n    this.tl.play();\n    this.disembark = false;\n    this.camP = new Vector3();\n  }\n\n  finish() {\n    if (this.done) return;\n    this.done = true;\n    const slot = App.slot;\n    if (slot) { slot.phase = 'morning'; App.store.write(); }\n    App.go('weighin');\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (input.wasPressed(...CONFIRM) || input.wasPressed(...BACK) || input.wasPressed('MouseLeft')) this.tl.skip();\n  }\n\n  onFixed(ctx, dt) { this.tl.update(dt); }\n\n  onUpdate(ctx, dt) {\n    const shot = this.tl.camera();\n    const cam = ctx.camera.camera;\n    if (shot) {\n      cam.position.set(...shot.position);\n      cam.lookAt(shot.target[0], shot.target[1], shot.target[2]);\n      if (shot.fov && cam.fov !== shot.fov) { cam.fov = shot.fov; cam.updateProjectionMatrix(); }\n    }\n    const u = Math.min(1, this.tl.time / 12);\n    const e = 1 - (1 - u) * (1 - u);\n    const z = 52 - e * 20;\n    this.boat.position.z = z;\n    this.boat.position.y = -0.7 + Math.sin(this.t * 1.4) * 0.05;\n    this.boat.rotation.z = Math.sin(this.t * 0.9) * 0.012;\n    if (!this.disembark) this.avatar.root.position.set(8, 0.55 + Math.sin(this.t * 1.4) * 0.05, z - 3);\n    else {\n      const a = this.avatar.root.position;\n      a.z = Math.max(26.5, a.z - dt * 1.6);\n      a.y = 0.4;\n    }\n    this.avatar.update(dt);\n    this.gulls.update(dt, this.t);\n    this.water?.update(ctx.time);\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const bars = this.tl.bars();\n    if (bars > 0) {\n      const h = Math.round(bars * 26);\n      hud.rect(0, 0, hud.width, h, 'ink');\n      hud.rect(0, hud.height - h, hud.width, h, 'ink');\n    }\n    const line = this.tl.line();\n    if (line) {\n      const rows = wrap(sanitize(line.text), charsIn(hud.width - 40));\n      const y = hud.height - 22 - rows.length * 10;\n      rows.forEach((r, i) => sayCentered(hud, hud.width / 2, y + i * 10, r, { color: 'white', name: 'subtitle' }));\n    }\n    if (this.tl.time < 4) sayCentered(hud, hud.width / 2, 40, TITLE, { scale: 3, color: 'white', name: 'ferry-title' });\n    promptBar(hud, App.device, [['confirm', 'Skip']], { y: 8, strip: false });\n  }\n\n  status() { return `ferry | t ${this.tl?.time?.toFixed(1)}`; }\n}\nEOF\ncat > src/scenes/ending.js <<'EOF'\n// The confession. The chart of your week slides down seven years. Credits. Week 2.\nimport { applySky, Precipitation as _P, skyAt, Timeline } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { CONFIRM } from '../core/actions.js';\nimport { nextDay, shownAge } from '../core/week.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { Kevin, Ounce } from '../art/props.js';\nimport { CREDITS, DISCLAIMER } from '../data/about.js';\nimport { LOOKS } from '../data/classmates.js';\nimport { CONFESSION, CONFESSION_AFTER, CREDITS_SIGNOFF } from '../data/lines.js';\nimport { AGE_OFFSET } from '../data/week.js';\nimport { TITLE } from '../data/title.js';\nimport { drawAgeChart } from '../ui/chart.js';\nimport { DialogueScreen } from '../ui/dialogue.js';\nimport { sayCentered, wrap, charsIn } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nvoid _P;\n\nexport class EndingScene extends BaseScene {\n  name = 'ending';\n  id = 'ending';\n  canPause = false;\n  phase = 'confess';\n  slide = 0;\n  creditsT = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.5, 8.6], target: [0, 1.3, 0], fov: 34 }; }\n\n  async build(ctx) {\n    plazaSet(ctx, 18);\n    applySky(ctx.engine, skyAt(18.5));\n    this.ounce = new Ounce(ctx, { at: [0, 0.04, 0.6], scale: 1.7 });\n    const slot = App.slot;\n    this.you = await makeAvatar(ctx, withWardrobe(slot?.look ?? LOOKS.coach, slot), { at: [0, 0, 2.6], yaw: 3.14, clip: 'Idle' });\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [-2.8, 0, 0.4], yaw: 0.5, clip: 'CoachStand' });\n    this.coach.addPlumb();\n    this.marguerite = await makeAvatar(ctx, LOOKS.marguerite, { at: [2.8, 0, 0.6], yaw: -0.5, clip: 'SlowClap' });\n    this.dennis = await makeAvatar(ctx, LOOKS.dennis, { at: [4.3, 0, 1.6], yaw: -0.8, clip: 'Slump' });\n    this.june = await makeAvatar(ctx, LOOKS.june, { at: [-4.4, 0, 1.4], yaw: 0.8, clip: 'Watch' });\n    this.kevin = new Kevin(ctx, { at: [-1.4, 0, 1.8], yaw: 0.8 });\n    App.music('credits');\n    this.ages = (slot?.ages ?? [80, 78, 74, 70, 66, 60, 54]).slice(-7);\n    this.shownBefore = this.ages.map((a) => a + AGE_OFFSET);\n    App.stack.push(new DialogueScreen(CONFESSION, { onDone: () => this.startSlide() }));\n  }\n\n  startSlide() {\n    this.phase = 'slide';\n    this.slideT = 0;\n    this.ounce.setMood('spin');\n    App.sfx('fanfareSoft');\n    const slot = App.slot;\n    if (slot) { slot.confessed = true; App.store.write(); }\n  }\n\n  afterSlide() {\n    this.phase = 'after';\n    this.ounce.setMood('pleased');\n    App.stack.push(new DialogueScreen(CONFESSION_AFTER, { onDone: () => this.rollCredits() }));\n  }\n\n  rollCredits() {\n    this.phase = 'credits';\n    this.creditsT = 0;\n    this.creditLines = [TITLE, '', ...CREDITS.slice(1), '', DISCLAIMER, '', CREDITS_SIGNOFF];\n    this.you.play('Wave', { fade: 0.3 });\n    this.coach.play('Bow', { once: true, fade: 0.3 });\n    this.kevin.flyTo(-12, 8, -14, 6);\n  }\n\n  finish() {\n    if (this.finished) return;\n    this.finished = true;\n    const slot = App.slot;\n    if (slot) {\n      slot.day = 7;\n      nextDay(slot); // Week 2, day 1\n      App.store.write();\n      App.go('weighin');\n    } else App.go('title');\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (this.phase === 'credits' && this.creditsT > 1.5 && (input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft'))) this.finish();\n  }\n\n  onUpdate(ctx, dt) {\n    for (const a of [this.you, this.coach, this.marguerite, this.dennis, this.june]) a.update(dt);\n    this.ounce.update(dt);\n    this.kevin.update(dt);\n    if (this.phase === 'slide') {\n      this.slideT += dt;\n      const u = Math.min(1, this.slideT / 3);\n      this.slide = AGE_OFFSET * (u * u * (3 - 2 * u));\n      if (Math.floor(this.slideT * 12) !== Math.floor((this.slideT - dt) * 12) && u < 1) App.sfx('needleTick', { pitch: u * 10 });\n      if (this.slideT > 4.5) { this.slide = AGE_OFFSET; this.afterSlide(); }\n    }\n    if (this.phase === 'credits') {\n      this.creditsT += dt;\n      if (this.creditsT > 26) this.finish();\n    }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    if (this.phase === 'slide' || this.phase === 'after') {\n      const w = Math.min(hud.width - 40, 300);\n      drawAgeChart(hud, Math.round((hud.width - w) / 2), 16, w, 100, this.shownBefore, { slide: this.slide });\n      sayCentered(hud, hud.width / 2, 120, `-${Math.round(this.slide)} years`, { scale: 2, color: 'lime', name: 'slide' });\n    }\n    if (this.phase === 'credits') {\n      hud.rect(0, 0, hud.width, hud.height, 'ink');\n      const rows = this.creditLines.flatMap((l) => (l ? wrap(l, charsIn(hud.width - 40)) : ['']));\n      const lineH = 13;\n      const total = rows.length * lineH;\n      const y0 = hud.height - Math.min(this.creditsT * 12, total + hud.height * 0.32);\n      rows.forEach((r, i) => {\n        const y = Math.round(y0 + i * lineH);\n        if (r && y > -10 && y < hud.height - 24) sayCentered(hud, hud.width / 2, y, r, { color: r === CREDITS_SIGNOFF ? 'sand' : 'white', name: 'credits' });\n      });\n      promptBar(hud, App.device, [['confirm', 'See you tomorrow']]);\n    }\n    void shownAge; void Timeline;\n  }\n\n  status() { return `ending | ${this.phase} | slide ${this.slide.toFixed(2)}`; }\n}\nEOF\ncat > src/scenes/viewer.js <<'EOF'\n// Dev Tools' animation viewer: every clip on an avatar.\nimport { App } from '../app.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { VIEWER_CLIPS } from '../art/clips.js';\nimport { BACK, CONFIRM, MENU_LEFT, MENU_RIGHT, TAB_LEFT, TAB_RIGHT } from '../core/actions.js';\nimport { PRESET_LOOKS } from '../data/classmates.js';\nimport { say, sayCentered } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\n\nexport class ViewerScene extends BaseScene {\n  name = 'viewer';\n  id = 'viewer';\n  i = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [0, 1.7, 6], target: [0, 0.95, 0], fov: 30 }; }\n\n  async build(ctx) {\n    plazaSet(ctx, 11);\n    this.avatar = await makeAvatar(ctx, App.slot?.look ?? PRESET_LOOKS[0], { at: [0, 0, 0], clip: VIEWER_CLIPS[0] });\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    const n = VIEWER_CLIPS.length;\n    if (input.wasPressed(...MENU_RIGHT, ...TAB_RIGHT) || input.wheel > 0) { this.i = (this.i + 1) % n; this.show(); }\n    if (input.wasPressed(...MENU_LEFT, ...TAB_LEFT) || input.wheel < 0) { this.i = (this.i - 1 + n) % n; this.show(); }\n    if (input.wasPressed(...CONFIRM)) this.show();\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight')) App.go(App.slot ? 'hub' : 'title', {});\n  }\n\n  show() { this.avatar.play(VIEWER_CLIPS[this.i], { fade: 0.15, once: false }); App.sfx('menuMove'); }\n\n  onUpdate(ctx, dt) {\n    this.avatar.root.rotation.y += dt * 0.5;\n    this.avatar.update(dt);\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    heading(hud, 'Animation Viewer', 8);\n    sayCentered(hud, hud.width / 2, 36, `${VIEWER_CLIPS[this.i]}  ${this.i + 1}/${VIEWER_CLIPS.length}`, { scale: 1, color: 'sand', name: 'clip' });\n    promptBar(hud, App.device, [['adjust', 'Clip'], ['confirm', 'Replay'], ['back', 'Back']]);\n    void say;\n  }\n\n  status() { return `viewer | ${VIEWER_CLIPS[this.i]}`; }\n}\nEOF\npython3 - <<'EOF'\np='src/scenes/index.js'; s=open(p).read()\ns=s.replace(\"\"\"import './attract.js';\"\"\",\"\"\"import { HubScene } from './hub.js';\nimport { WeighInScene } from './weighin.js';\nimport { ReportScene } from './report.js';\nimport { JarScene } from './jar.js';\nimport { RecordsScene } from './records.js';\nimport { LockerScene } from './locker.js';\nimport { FerryScene } from './ferry.js';\nimport { EndingScene } from './ending.js';\nimport { ViewerScene } from './viewer.js';\nimport './attract.js';\"\"\")\ns=s.replace(\"\"\"  title: (a) => new TitleScene(a),\"\"\",\"\"\"  title: (a) => new TitleScene(a),\n  hub: (a) => new HubScene(a),\n  weighin: (a) => new WeighInScene(a),\n  report: (a) => new ReportScene(a),\n  jar: (a) => new JarScene(a),\n  records: (a) => new RecordsScene(a),\n  locker: (a) => new LockerScene(a),\n  ferry: (a) => new FerryScene(a),\n  ending: (a) => new EndingScene(a),\n  viewer: (a) => new ViewerScene(a),\"\"\")\nopen(p,'w').write(s)\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [ ] 4 Island and week\",\"- [~] 4 Island and week: all scenes written (hub, weighin, report, jar, records, locker, ferry, ending, viewer); needs test + look\")\nopen(p,'w').write(s)\nEOF\ncat > .scratch/week.mjs <<'EOF'\nimport { boot, App, assert } from '../tests/lib.mjs';\nconst h = await boot({ scene:'title' });\nh.step(5);\nh.press('Enter'); h.step(2); console.log(App.state().stack);\nh.press('Enter'); h.step(2); console.log(App.state().stack);\nh.press('Enter'); h.step(2); console.log(App.state().stack);\nh.press('Enter'); h.step(2); console.log(App.state().stack);\nh.press('Enter'); h.step(3); \nawait h.settle(); console.log(App.state().scene, App.slot?.name);\nh.press('Enter'); await h.settle(); h.step(5); console.log(App.state().scene, App.state().status);\nApp.dev.autopilot='good';\nfor (let i=0;i<60 && App.scene.id!=='hub';i++){ h.step(30); if(App.stack.open){h.press('Enter');} await h.settle(); }\nconsole.log(App.state().scene, App.state().status, App.slot.ages, h.errors());\nprocess.exit(0);\nEOF\ntimeout 100 node .scratch/week.mjs </dev/null 2>&1 | tail -14 | cut -c1-500","description":"Write report, jar, records, locker, ferry, ending and viewer, then smoke test","timeout":130000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":27501,"cache_read_input_tokens":398168,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":27501},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"4a13d6dc-edce-49cd-b0e5-8eec4ec8332e","timestamp":"2026-11-05T06:49:42.061Z","request_id":"req_011CgjLHLdcnEKfQN7G17RMx","wire_tool_inputs":{"toolu_01Fm9CdfnWpqhMmStu6Lvx5m":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/scenes/report.js <<'EOF'\n// The Evening Report: minutes, Drips, stars, the chart, tomorrow's concern, new unlocks. Then dusk, then morning.\nimport { applySky, skyAt } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { CONFIRM } from '../core/actions.js';\nimport { goalMet, nextDay, shownAge } from '../core/week.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { Ounce, place } from '../art/props.js';\nimport { ACTIVITIES, CLASSMATE_SCORES } from '../data/activities.js';\nimport { CONCERNS, REPORT_LINES } from '../data/lines.js';\nimport { MILESTONES } from '../data/unlocks.js';\nimport { drawAgeChart } from '../ui/chart.js';\nimport { DialogueScreen } from '../ui/dialogue.js';\nimport { say, sayCentered, sayRight } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading, panel, starRow } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nexport class ReportScene extends BaseScene {\n  name = 'report';\n  id = 'report';\n  canPause = true;\n  phase = 'count';\n  countT = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [3.2, 2.8, 9], target: [3.2, 1.3, 0], fov: 32 }; }\n\n  async build(ctx) {\n    plazaSet(ctx, 19);\n    applySky(ctx.engine, skyAt(19));\n    const slot = App.slot;\n    place(ctx, 'hammock', { at: [5.4, 0, 0.8] });\n    this.lantern = ctx.lights.request({ position: [3, 2.4, 2], color: 0xffcf80, intensity: 8, radius: 9, flicker: 'torch' });\n    this.ounce = new Ounce(ctx, { at: [2, 0.04, 1.6], yaw: 0.5, scale: 1.5 });\n    const av = await makeAvatar(ctx, withWardrobe(slot?.look ?? {}, slot), { at: [5.4, 0.9, 0.8], yaw: 1.57, clip: 'LieIdle', shadow: false });\n    this.avatar = av;\n    App.music('report');\n    this.lines = this.buildLines();\n    this.concern = CONCERNS[((slot?.day ?? 1) - 1 + (slot?.week ?? 1) * 2) % CONCERNS.length];\n    this.minutes = Math.floor((slot?.todaySeconds ?? 0) / 60);\n    this.seconds = Math.round((slot?.todaySeconds ?? 0) % 60);\n  }\n\n  buildLines() {\n    const slot = App.slot;\n    if (!slot) return [];\n    const lines = [];\n    const beat = new Set();\n    for (const d of slot.todayDone) for (const w of d.beat ?? []) beat.add(w);\n    const firstNew = ['marguerite', 'june', 'dennis'].find((w) => beat.has(w) && !(slot.reacted ??= {})[w]);\n    if (firstNew) { slot.reacted[firstNew] = true; lines.push(REPORT_LINES[`beat${firstNew[0].toUpperCase()}${firstNew.slice(1)}`]); }\n    if (!slot.todayDone.length) lines.push(`ounce: ${REPORT_LINES.empty}`);\n    else lines.push(`ounce: ${goalMet(slot) ? REPORT_LINES.goal : REPORT_LINES.noGoal}`);\n    return lines;\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    const go = input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft');\n    if (this.phase === 'count' && (go || this.countT > 4.5)) {\n      this.phase = 'talk';\n      const lines = [...this.lines, `ounce: ${this.concern}`];\n      App.stack.push(new DialogueScreen(lines, { onDone: () => { this.phase = 'done'; } }));\n    } else if (this.phase === 'done' && !App.loading) {\n      this.phase = 'leaving';\n      this.nextMorning();\n    }\n  }\n\n  nextMorning() {\n    const slot = App.slot;\n    nextDay(slot);\n    App.store.write();\n    App.go('weighin');\n  }\n\n  onUpdate(ctx, dt) {\n    this.ounce.update(dt);\n    this.avatar.update(dt);\n    this.countT += dt;\n    if (this.phase === 'done' && !this.saidDone && App.dev.autopilot) { this.saidDone = true; this.phase = 'leaving'; this.nextMorning(); }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const slot = App.slot;\n    if (!slot) return;\n    const x = 12;\n    const w = Math.min(208, Math.round(hud.width * 0.5));\n    heading2(hud, slot.week > 1 ? `Week ${slot.week}, day ${slot.day}` : `Day ${slot.day} Report`, x);\n    const y = 34;\n    panel(hud, x, y, w, 54, { fill: 'white', name: 'report-numbers' });\n    say(hud, x + 5, y + 4, 'Time in class', { color: 'teal', shadow: false, name: 'report' });\n    sayRight(hud, x + w - 5, y + 4, `${this.minutes}m ${String(this.seconds).padStart(2, '0')}s`, { color: 'ink', shadow: false, name: 'report' });\n    say(hud, x + 5, y + 16, 'Drips today', { color: 'teal', shadow: false, name: 'report' });\n    sayRight(hud, x + w - 5, y + 16, `+${slot.todayDrips}`, { color: 'ink', shadow: false, name: 'report' });\n    say(hud, x + 5, y + 28, 'Stars', { color: 'teal', shadow: false, name: 'report' });\n    sayRight(hud, x + w - 5, y + 28, `${slot.todayStars}`, { color: 'ink', shadow: false, name: 'report' });\n    const goal = goalMet(slot);\n    say(hud, x + 5, y + 40, goal ? 'Prescription filled' : 'Prescription open', { color: goal ? 'green' : 'red', shadow: false, name: 'report' });\n    const chartY = y + 60;\n    const chartH = Math.max(58, Math.min(96, hud.height - chartY - 30));\n    const ages = slot.ages.slice(-7).map((a) => shownAge(slot, a));\n    drawAgeChart(hud, x, chartY, w, chartH, ages);\n    const items = slot.todayNew ?? [];\n    if (items.length) {\n      const m = MILESTONES.find((n) => n.id === items[items.length - 1]);\n      if (m) say(hud, x + 1, chartY + chartH + 4, `New: ${m.name}`, { color: 'lime', name: 'report-new' });\n    }\n    if (!App.stack.open) promptBar(hud, App.device, [['confirm', this.phase === 'done' ? 'Good night' : 'Next']]);\n    void starRow; void ACTIVITIES; void CLASSMATE_SCORES; void sayCentered; void heading;\n  }\n\n  status() { const s = App.slot; return `report | day ${s?.day} | ${this.phase} | drips ${s?.todayDrips}`; }\n  dispose() { this.lantern?.release?.(); }\n}\n\nfunction heading2(hud, text, x) {\n  const w = text.length * 12 + 8;\n  hud.rect(x - 1, 6, w, 21, 'navy');\n  say(hud, x + 3, 8, text, { scale: 2, name: 'heading' });\n}\nEOF\ncat > src/scenes/jar.js <<'EOF'\n// The Sweat Jar, close up. One focal element: the jar, slowly filling.\nimport { PALETTE, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { BACK, CONFIRM } from '../core/actions.js';\nimport { place } from '../art/props.js';\nimport { JAR_MAX, MILESTONES } from '../data/unlocks.js';\nimport { sayCentered, say, wrap, charsIn } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading, panel, disc } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\n\nconst { CylinderGeometry, Mesh, BoxGeometry } = THREE;\n\nexport class JarScene extends BaseScene {\n  name = 'jar';\n  id = 'jar';\n  canPause = true;\n  shownFill = 0;\n  dripT = 0;\n  i = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [-1.4, 2.4, 7.6], target: [-1.4, 1.7, 0], fov: 32 }; }\n\n  build(ctx) {\n    plazaSet(ctx, 12);\n    place(ctx, 'sweat-jar', { at: [0, 0, 0] });\n    // Toon materials are opaque, so the fluid is faked: a sky cylinder 1 cm wider than the wall, with a highlight.\n    this.fluid = new Mesh(new CylinderGeometry(0.96, 0.96, 1, 12), toonMaterial(PALETTE.sky));\n    this.fluid.position.set(0, 0.4, 0);\n    this.fluid.scale.y = 0.02;\n    ctx.scene.add(this.fluid);\n    this.shine = new Mesh(new BoxGeometry(0.1, 1, 0.05), toonMaterial(PALETTE.white));\n    this.shine.position.set(-0.48, 0.4, 0.84);\n    this.shine.scale.y = 0.02;\n    ctx.scene.add(this.shine);\n    App.music('title');\n    const s = App.slot;\n    this.target = Math.min(1, (s?.drips ?? 0) / JAR_MAX);\n    this.lastDrips = s?.jarSeen ?? 0;\n    if (s) { s.jarSeen = s.drips; App.store.write(); }\n    this.shownFill = Math.min(1, this.lastDrips / JAR_MAX);\n    this.i = Math.max(0, MILESTONES.findIndex((m) => (s?.drips ?? 0) < m.drips));\n  }\n\n  leave() { App.go('hub', { from: 'jar' }); }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight') || input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft')) { App.sfx('menuBack'); this.leave(); }\n  }\n\n  onUpdate(ctx, dt) {\n    if (this.shownFill < this.target) {\n      this.shownFill = Math.min(this.target, this.shownFill + dt * 0.08);\n      this.dripT -= dt;\n      if (this.dripT <= 0) {\n        this.dripT = 0.24;\n        App.sfx('jarDrip', { pitch: this.shownFill * 12 });\n        ctx.particles.burst('dripDrop', [0, 0.4 + this.fluid.scale.y + 0.1, 0.4]);\n      }\n    }\n    const h = Math.max(0.02, this.shownFill * 2.05);\n    this.fluid.scale.y = h;\n    this.fluid.position.y = 0.4 + h / 2;\n    this.shine.scale.y = h * 0.8;\n    this.shine.position.y = 0.4 + h * 0.5;\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const s = App.slot;\n    const x = Math.round(hud.width * 0.52);\n    const w = Math.min(hud.width - x - 12, 210);\n    heading(hud, 'The Sweat Jar', 10);\n    sayCentered(hud, x + w / 2, 36, `${s?.drips ?? 0}`, { scale: 4, color: 'cyan', name: 'drips' });\n    sayCentered(hud, x + w / 2, 72, 'Drips', { color: 'white', name: 'drips-label' });\n    const next = MILESTONES.find((m) => (s?.drips ?? 0) < m.drips);\n    const got = MILESTONES.filter((m) => (s?.drips ?? 0) >= m.drips);\n    const y = 88;\n    const rowH = 11;\n    const lastGot = got[got.length - 1];\n    const lines = [];\n    if (next) lines.push({ t: `Next at ${next.drips}: ${next.name}`, c: 'teal' });\n    else lines.push({ t: 'The jar is full. There is no next.', c: 'teal' });\n    if (lastGot) wrap(lastGot.remark, charsIn(w - 10)).forEach((t) => lines.push({ t, c: 'ink' }));\n    panel(hud, x, y, w, lines.length * rowH + 8, { fill: 'white', name: 'jar-panel' });\n    lines.forEach((l, i) => say(hud, x + 5, y + 4 + i * rowH, l.t.slice(0, charsIn(w - 10)), { color: l.c, shadow: false, name: 'jar-text' }));\n    // Milestone dots along the jar's scale.\n    const by = y + lines.length * rowH + 16;\n    MILESTONES.forEach((m, i) => {\n      const dx = x + 8 + i * Math.floor((w - 16) / MILESTONES.length);\n      disc(hud, dx, by, 3.5, (s?.drips ?? 0) >= m.drips ? 'lime' : 'slate');\n    });\n    promptBar(hud, App.device, [['back', 'Back to the island']]);\n  }\n\n  status() { return `jar | drips ${App.slot?.drips ?? 0}`; }\n}\nEOF\ncat > src/scenes/records.js <<'EOF'\n// The Hall of Numbers: chart, records one activity a page, calendar.\nimport { App } from '../app.js';\nimport { BACK, MENU_LEFT, MENU_RIGHT } from '../core/actions.js';\nimport { shownAge } from '../core/week.js';\nimport { place } from '../art/props.js';\nimport { ACTIVITIES, CLASSMATE_SCORES, PLAYABLE_IDS } from '../data/activities.js';\nimport { drawAgeChart } from '../ui/chart.js';\nimport { say, sayCentered, sayRight } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { TabBar } from '../ui/screens/common.js';\nimport { heading, panel, starRow, starRowWidth } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\n\nexport class RecordsScene extends BaseScene {\n  name = 'records';\n  id = 'records';\n  canPause = true;\n  page = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.4, 9], target: [0, 2, 0], fov: 32 }; }\n\n  build(ctx) {\n    plazaSet(ctx, 11);\n    place(ctx, 'numbers-board', { at: [0, 0, -2], scale: 1.8 });\n    this.tabs = new TabBar(['Chart', 'Records', 'Calendar']);\n    App.music('title');\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    this.tabs.update(ctx);\n    if (this.tabs.current === 'Records') {\n      const n = PLAYABLE_IDS.length;\n      if (input.wasPressed(...MENU_RIGHT) || input.wheel > 0) { this.page = (this.page + 1) % n; App.sfx('menuMove'); }\n      if (input.wasPressed(...MENU_LEFT) || input.wheel < 0) { this.page = (this.page - 1 + n) % n; App.sfx('menuMove'); }\n    }\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight')) { App.sfx('menuBack'); App.go('hub', { from: 'hall' }); }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const s = App.slot;\n    heading(hud, 'Hall of Numbers', 8);\n    this.tabs.draw(ctx, 34);\n    const w = Math.min(hud.width - 24, 340);\n    const x = Math.round((hud.width - w) / 2);\n    const y = 52;\n    const h = hud.height - y - 26;\n    if (this.tabs.current === 'Chart') {\n      const ages = (s?.ages ?? []).slice(-7).map((a) => shownAge(s, a));\n      drawAgeChart(hud, x, y, w, Math.min(h, 150), ages);\n    } else if (this.tabs.current === 'Records') {\n      const id = PLAYABLE_IDS[this.page];\n      const def = ACTIVITIES[id];\n      const rec = s?.records[id];\n      panel(hud, x, y, w, Math.min(h, 142), { fill: 'white', name: 'record' });\n      sayCentered(hud, hud.width / 2, y + 5, def.name, { color: 'teal', shadow: false, name: 'record-name' });\n      sayCentered(hud, hud.width / 2, y + 20, rec ? `${Math.round(rec.best)}` : '-', { scale: 4, color: 'ink', shadow: false, name: 'record-best' });\n      starRow(hud, Math.round(hud.width / 2 - starRowWidth(1) / 2), y + 58, rec?.stars ?? 0);\n      const others = CLASSMATE_SCORES[id];\n      let ry = y + 74;\n      for (const k of ['dennis', 'june', 'marguerite']) {\n        say(hud, x + 40, ry, k[0].toUpperCase() + k.slice(1), { color: 'slate', shadow: false, name: 'record-row' });\n        sayRight(hud, x + w - 40, ry, String(others[k]), { color: 'ink', shadow: false, name: 'record-row' });\n        ry += 11;\n      }\n      sayCentered(hud, hud.width / 2, y + Math.min(h, 142) - 13, `${this.page + 1} / ${PLAYABLE_IDS.length}`, { color: 'slate', shadow: false, name: 'record-page' });\n    } else {\n      panel(hud, x, y, w, Math.min(h, 110), { fill: 'white', name: 'calendar' });\n      const cw = Math.floor((w - 16) / 7);\n      for (let d = 1; d <= 7; d++) {\n        const cx = x + 8 + (d - 1) * cw;\n        const past = s && (s.week > 1 || d < s.day);\n        const today = s && s.week === 1 && d === s.day;\n        hud.rect(cx + 1, y + 26, cw - 3, 44, today ? 'cyan' : past ? 'lime' : 'mist');\n        sayCentered(hud, cx + cw / 2, y + 42, String(d), { scale: 2, color: 'ink', shadow: false, name: 'calendar-day' });\n        if (s?.ages?.[d - 1] !== undefined && s.week === 1) sayCentered(hud, cx + cw / 2, y + 74, String(shownAge(s, s.ages[d - 1])), { color: 'slate', shadow: false, name: 'calendar-age' });\n      }\n      sayCentered(hud, hud.width / 2, y + 8, s?.week > 1 ? `Week ${s.week}` : 'The Week', { color: 'teal', shadow: false, name: 'calendar-title' });\n    }\n    promptBar(hud, App.device, this.tabs.current === 'Records' ? [['adjust', 'Activity'], ['tabs', 'Page'], ['back', 'Back']] : [['tabs', 'Page'], ['back', 'Back']]);\n  }\n\n  status() { return `records | ${this.tabs?.current} | page ${this.page}`; }\n}\nEOF\ncat > src/scenes/locker.js <<'EOF'\n// The Locker Room: you, on a turntable. Skin, hair, top, bottom, headband, jar unlocks.\nimport { App } from '../app.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { place } from '../art/props.js';\nimport { BOTTOM_COLORS, HAIR_COLORS, HAIR_STYLES, HEADBANDS, SKINS, TOP_COLORS } from '../data/classmates.js';\nimport { MILESTONES } from '../data/unlocks.js';\nimport { Menu } from '../ui/menu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { box, setSky } from './sets.js';\nimport { floorPlane } from '../art/textures.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nexport class LockerScene extends BaseScene {\n  name = 'locker';\n  id = 'locker';\n  canPause = false;\n  spin = 0;\n  rebuilding = false;\n\n  cameraConfig() { return { preset: 'fixed', position: [1.6, 1.8, 5.8], target: [1.6, 1, 0], fov: 32 }; }\n\n  async build(ctx) {\n    setSky(ctx, 12);\n    ctx.scene.add(floorPlane('clinic-tile', 16, 10, { at: [0, 0, 0] }));\n    box(ctx, 16, 0.5, 10, [0, -0.26, 0], 'mist', { cast: false });\n    box(ctx, 16, 5, 0.3, [0, 2.5, -2.8], 'white', { cast: false });\n    box(ctx, 16, 0.3, 0.2, [0, 2.6, -2.6], 'cyan', { cast: false });\n    place(ctx, 'lockers', { at: [-2.4, 0, -2.2] });\n    place(ctx, 'lockers', { at: [2.8, 0, -2.2] });\n    place(ctx, 'towel-rack', { at: [5.6, 0, -1.8] });\n    place(ctx, 'dais', { at: [1.6, -0.2, 0] });\n    App.music('title');\n    this.look = { ...App.slot.look };\n    this.avatar = await makeAvatar(ctx, withWardrobe(this.look, App.slot), { at: [1.6, 0.14, 0], clip: 'Idle' });\n    this.menu = new Menu(this.items(), { width: 196, y: 42, scale: 1, rowH: 16, maxRows: 11, onBack: () => this.leave() });\n    this.menu.o.x = 12;\n  }\n\n  cycle(key, list, d) {\n    const i = Math.max(0, list.indexOf(this.look[key] ?? list[0]));\n    const v = list[(i + d + list.length) % list.length];\n    if (v === null) delete this.look[key]; else this.look[key] = v;\n    this.changed();\n  }\n\n  /** Long sleeves and trousers together: \"long\". The bun is a hair style. */\n  items() {\n    const slot = App.slot;\n    const row = (label, id, key, list) => ({ label, id, value: () => String(this.look[key] ?? 'none'), adjust: (d) => this.cycle(key, list, d), action: () => this.cycle(key, list, 1), sound: 'menuMove' });\n    const items = [\n      row('Skin', 'skin', 'skin', SKINS),\n      row('Hair style', 'hairStyle', 'hairStyle', HAIR_STYLES),\n      row('Hair colour', 'hair', 'hair', HAIR_COLORS),\n      row('Top', 'top', 'top', TOP_COLORS),\n      row('Bottom', 'bottom', 'bottom', BOTTOM_COLORS),\n      { label: 'Length', id: 'long', value: () => (this.look.long ? 'Long' : 'Short'), adjust: () => { this.look.long = !this.look.long; this.changed(); }, action: () => { this.look.long = !this.look.long; this.changed(); }, sound: 'menuMove' },\n      row('Headband', 'headband', 'headband', HEADBANDS),\n    ];\n    for (const m of MILESTONES) {\n      if (!slot.wardrobe.includes(m.id)) continue;\n      items.push({ label: m.name, id: m.id, value: () => (this.isWorn(m.id) ? 'On' : 'Off'), adjust: () => this.toggleWorn(m.id), action: () => this.toggleWorn(m.id), sound: 'menuMove' });\n    }\n    return items;\n  }\n\n  isWorn(id) { return (App.slot.worn ?? App.slot.wardrobe).includes(id); }\n\n  toggleWorn(id) {\n    const slot = App.slot;\n    const worn = new Set(slot.worn ?? slot.wardrobe);\n    if (worn.has(id)) worn.delete(id); else worn.add(id);\n    slot.worn = [...worn];\n    if (id === 'confidence') App.say('ounce', 'No visible effect. As advertised.');\n    this.changed();\n  }\n\n  changed() {\n    App.slot.look = { ...this.look };\n    App.store.write();\n    this.dirty = true;\n  }\n\n  async rebuild(ctx) {\n    this.rebuilding = true;\n    const old = this.avatar;\n    const fresh = await makeAvatar(ctx, withWardrobe(this.look, App.slot), { at: [1.6, 0.14, 0], clip: 'Idle' });\n    fresh.root.rotation.y = this.spin;\n    ctx.scene.remove(old.root);\n    if (old.shadow) ctx.scene.remove(old.shadow);\n    fresh.squash.kick(0.6);\n    this.avatar = fresh;\n    this.rebuilding = false;\n  }\n\n  leave() { App.go('hub', { from: 'locker' }); }\n\n  onInput(ctx, dt) { this.menu?.update(ctx, dt); }\n\n  onUpdate(ctx, dt) {\n    if (this.dirty && !this.rebuilding) { this.dirty = false; this.rebuild(ctx); }\n    if (!this.avatar) return;\n    this.spin += dt * 0.7;\n    this.avatar.root.rotation.y = this.spin;\n    this.avatar.update(dt);\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    heading(hud, 'Locker Room', 8);\n    if (this.menu) {\n      const save = hud.width;\n      this.drawMenuLeft(ctx, save);\n    }\n    promptBar(hud, App.device, [['adjust', 'Change'], ['move', 'Choose'], ['back', 'Done']]);\n  }\n\n  /** The same menu, on the left, so the turntable has the right of the screen. */\n  drawMenuLeft(ctx) {\n    const m = this.menu;\n    const { hud } = ctx;\n    const w = Math.min(196, Math.round(hud.width * 0.48));\n    m.o.width = w;\n    const shim = { ...ctx, hud: new Proxy(hud, { get(t, k) { if (k === 'width') return w + 24; const v = t[k]; return typeof v === 'function' ? v.bind(t) : v; } }) };\n    m.draw(shim);\n  }\n\n  status() { return `locker | focus ${this.menu?.focus} | look ${JSON.stringify(this.look)}`; }\n}\nEOF\ncat > src/scenes/ferry.js <<'EOF'\n// Day 1: the ferry comes in, Ounce's island gets bigger, you get off.\nimport { App } from '../app.js';\nimport { BACK, CONFIRM } from '../core/actions.js';\nimport { Timeline, THREE } from '../../pixel-engine.js';\nimport { place } from '../art/props.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { FERRY_LINES } from '../data/lines.js';\nimport { TITLE } from '../data/title.js';\nimport { sanitize, sayCentered, wrap, charsIn } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { BaseScene } from './base.js';\nimport { buildIsland } from './hub.js';\nimport { gulls } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nconst { Vector3 } = THREE;\nconst LENGTH = 16;\n\nexport class FerryScene extends BaseScene {\n  name = 'ferry';\n  id = 'ferry';\n  canPause = false;\n\n  cameraConfig() { return { preset: 'fixed', position: [12, 7, 44], target: [0, 1, 14], fov: 34 }; }\n\n  async build(ctx) {\n    const world = buildIsland(ctx, { walls: false });\n    this.water = world.water;\n    this.gulls = gulls(ctx, 7, { min: [-10, 4, 6], max: [12, 8, 26] });\n    this.boat = place(ctx, 'ferry', { at: [8, -0.7, 52], yaw: 180 }).object;\n    const slot = App.slot;\n    this.avatar = await makeAvatar(ctx, withWardrobe(slot?.look ?? {}, slot), { at: [8, 0.55, 49], yaw: 3.14, clip: 'Idle', shadow: false });\n    place(ctx, 'pier', { at: [8, -1.1, 24.5], params: { len: 15 } });\n    App.music('title');\n    this.tl = new Timeline({\n      shots: [\n        { at: 0, position: [14, 6, 62], target: [8, 1, 48], fov: 34 },\n        { at: 7, position: [20, 7, 42], target: [4, 1, 22], fov: 34 },\n        { at: 13, position: [15, 4, 38], target: [8, 1.2, 28], fov: 34 },\n        { at: LENGTH, position: [13.5, 3.2, 35], target: [8, 1.3, 26], fov: 34 },\n      ],\n      lines: FERRY_LINES.map((l) => ({ ...l })),\n      cues: [\n        { at: 2, name: 'squawk', cosmetic: true, run: () => App.sfx('gullSquawk') },\n        { at: 10.5, name: 'horn', cosmetic: true, run: () => App.sfx('rumble', { volume: 0.5 }) },\n        { at: 13.4, name: 'off', run: () => { this.disembark = true; this.avatar.play('Walk', { fade: 0.2 }); } },\n      ],\n      duration: LENGTH,\n      onEnd: () => this.finish(),\n    });\n    this.tl.play();\n    this.disembark = false;\n    this.camP = new Vector3();\n  }\n\n  finish() {\n    if (this.done) return;\n    this.done = true;\n    const slot = App.slot;\n    if (slot) { slot.phase = 'morning'; App.store.write(); }\n    App.go('weighin');\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (input.wasPressed(...CONFIRM) || input.wasPressed(...BACK) || input.wasPressed('MouseLeft')) this.tl.skip();\n  }\n\n  onFixed(ctx, dt) { this.tl.update(dt); }\n\n  onUpdate(ctx, dt) {\n    const shot = this.tl.camera();\n    const cam = ctx.camera.camera;\n    if (shot) {\n      cam.position.set(...shot.position);\n      cam.lookAt(shot.target[0], shot.target[1], shot.target[2]);\n      if (shot.fov && cam.fov !== shot.fov) { cam.fov = shot.fov; cam.updateProjectionMatrix(); }\n    }\n    const u = Math.min(1, this.tl.time / 12);\n    const e = 1 - (1 - u) * (1 - u);\n    const z = 52 - e * 20;\n    this.boat.position.z = z;\n    this.boat.position.y = -0.7 + Math.sin(this.t * 1.4) * 0.05;\n    this.boat.rotation.z = Math.sin(this.t * 0.9) * 0.012;\n    if (!this.disembark) this.avatar.root.position.set(8, 0.55 + Math.sin(this.t * 1.4) * 0.05, z - 3);\n    else {\n      const a = this.avatar.root.position;\n      a.z = Math.max(26.5, a.z - dt * 1.6);\n      a.y = 0.4;\n    }\n    this.avatar.update(dt);\n    this.gulls.update(dt, this.t);\n    this.water?.update(ctx.time);\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const bars = this.tl.bars();\n    if (bars > 0) {\n      const h = Math.round(bars * 26);\n      hud.rect(0, 0, hud.width, h, 'ink');\n      hud.rect(0, hud.height - h, hud.width, h, 'ink');\n    }\n    const line = this.tl.line();\n    if (line) {\n      const rows = wrap(sanitize(line.text), charsIn(hud.width - 40));\n      const y = hud.height - 22 - rows.length * 10;\n      rows.forEach((r, i) => sayCentered(hud, hud.width / 2, y + i * 10, r, { color: 'white', name: 'subtitle' }));\n    }\n    if (this.tl.time < 4) sayCentered(hud, hud.width / 2, 40, TITLE, { scale: 3, color: 'white', name: 'ferry-title' });\n    promptBar(hud, App.device, [['confirm', 'Skip']], { y: 8, strip: false });\n  }\n\n  status() { return `ferry | t ${this.tl?.time?.toFixed(1)}`; }\n}\nEOF\ncat > src/scenes/ending.js <<'EOF'\n// The confession. The chart of your week slides down seven years. Credits. Week 2.\nimport { applySky, Precipitation as _P, skyAt, Timeline } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { CONFIRM } from '../core/actions.js';\nimport { nextDay, shownAge } from '../core/week.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { Kevin, Ounce } from '../art/props.js';\nimport { CREDITS, DISCLAIMER } from '../data/about.js';\nimport { LOOKS } from '../data/classmates.js';\nimport { CONFESSION, CONFESSION_AFTER, CREDITS_SIGNOFF } from '../data/lines.js';\nimport { AGE_OFFSET } from '../data/week.js';\nimport { TITLE } from '../data/title.js';\nimport { drawAgeChart } from '../ui/chart.js';\nimport { DialogueScreen } from '../ui/dialogue.js';\nimport { sayCentered, wrap, charsIn } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nvoid _P;\n\nexport class EndingScene extends BaseScene {\n  name = 'ending';\n  id = 'ending';\n  canPause = false;\n  phase = 'confess';\n  slide = 0;\n  creditsT = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.5, 8.6], target: [0, 1.3, 0], fov: 34 }; }\n\n  async build(ctx) {\n    plazaSet(ctx, 18);\n    applySky(ctx.engine, skyAt(18.5));\n    this.ounce = new Ounce(ctx, { at: [0, 0.04, 0.6], scale: 1.7 });\n    const slot = App.slot;\n    this.you = await makeAvatar(ctx, withWardrobe(slot?.look ?? LOOKS.coach, slot), { at: [0, 0, 2.6], yaw: 3.14, clip: 'Idle' });\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [-2.8, 0, 0.4], yaw: 0.5, clip: 'CoachStand' });\n    this.coach.addPlumb();\n    this.marguerite = await makeAvatar(ctx, LOOKS.marguerite, { at: [2.8, 0, 0.6], yaw: -0.5, clip: 'SlowClap' });\n    this.dennis = await makeAvatar(ctx, LOOKS.dennis, { at: [4.3, 0, 1.6], yaw: -0.8, clip: 'Slump' });\n    this.june = await makeAvatar(ctx, LOOKS.june, { at: [-4.4, 0, 1.4], yaw: 0.8, clip: 'Watch' });\n    this.kevin = new Kevin(ctx, { at: [-1.4, 0, 1.8], yaw: 0.8 });\n    App.music('credits');\n    this.ages = (slot?.ages ?? [80, 78, 74, 70, 66, 60, 54]).slice(-7);\n    this.shownBefore = this.ages.map((a) => a + AGE_OFFSET);\n    App.stack.push(new DialogueScreen(CONFESSION, { onDone: () => this.startSlide() }));\n  }\n\n  startSlide() {\n    this.phase = 'slide';\n    this.slideT = 0;\n    this.ounce.setMood('spin');\n    App.sfx('fanfareSoft');\n    const slot = App.slot;\n    if (slot) { slot.confessed = true; App.store.write(); }\n  }\n\n  afterSlide() {\n    this.phase = 'after';\n    this.ounce.setMood('pleased');\n    App.stack.push(new DialogueScreen(CONFESSION_AFTER, { onDone: () => this.rollCredits() }));\n  }\n\n  rollCredits() {\n    this.phase = 'credits';\n    this.creditsT = 0;\n    this.creditLines = [TITLE, '', ...CREDITS.slice(1), '', DISCLAIMER, '', CREDITS_SIGNOFF];\n    this.you.play('Wave', { fade: 0.3 });\n    this.coach.play('Bow', { once: true, fade: 0.3 });\n    this.kevin.flyTo(-12, 8, -14, 6);\n  }\n\n  finish() {\n    if (this.finished) return;\n    this.finished = true;\n    const slot = App.slot;\n    if (slot) {\n      slot.day = 7;\n      nextDay(slot); // Week 2, day 1\n      App.store.write();\n      App.go('weighin');\n    } else App.go('title');\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (this.phase === 'credits' && this.creditsT > 1.5 && (input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft'))) this.finish();\n  }\n\n  onUpdate(ctx, dt) {\n    for (const a of [this.you, this.coach, this.marguerite, this.dennis, this.june]) a.update(dt);\n    this.ounce.update(dt);\n    this.kevin.update(dt);\n    if (this.phase === 'slide') {\n      this.slideT += dt;\n      const u = Math.min(1, this.slideT / 3);\n      this.slide = AGE_OFFSET * (u * u * (3 - 2 * u));\n      if (Math.floor(this.slideT * 12) !== Math.floor((this.slideT - dt) * 12) && u < 1) App.sfx('needleTick', { pitch: u * 10 });\n      if (this.slideT > 4.5) { this.slide = AGE_OFFSET; this.afterSlide(); }\n    }\n    if (this.phase === 'credits') {\n      this.creditsT += dt;\n      if (this.creditsT > 26) this.finish();\n    }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    if (this.phase === 'slide' || this.phase === 'after') {\n      const w = Math.min(hud.width - 40, 300);\n      drawAgeChart(hud, Math.round((hud.width - w) / 2), 16, w, 100, this.shownBefore, { slide: this.slide });\n      sayCentered(hud, hud.width / 2, 120, `-${Math.round(this.slide)} years`, { scale: 2, color: 'lime', name: 'slide' });\n    }\n    if (this.phase === 'credits') {\n      hud.rect(0, 0, hud.width, hud.height, 'ink');\n      const rows = this.creditLines.flatMap((l) => (l ? wrap(l, charsIn(hud.width - 40)) : ['']));\n      const lineH = 13;\n      const total = rows.length * lineH;\n      const y0 = hud.height - Math.min(this.creditsT * 12, total + hud.height * 0.32);\n      rows.forEach((r, i) => {\n        const y = Math.round(y0 + i * lineH);\n        if (r && y > -10 && y < hud.height - 24) sayCentered(hud, hud.width / 2, y, r, { color: r === CREDITS_SIGNOFF ? 'sand' : 'white', name: 'credits' });\n      });\n      promptBar(hud, App.device, [['confirm', 'See you tomorrow']]);\n    }\n    void shownAge; void Timeline;\n  }\n\n  status() { return `ending | ${this.phase} | slide ${this.slide.toFixed(2)}`; }\n}\nEOF\ncat > src/scenes/viewer.js <<'EOF'\n// Dev Tools' animation viewer: every clip on an avatar.\nimport { App } from '../app.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { VIEWER_CLIPS } from '../art/clips.js';\nimport { BACK, CONFIRM, MENU_LEFT, MENU_RIGHT, TAB_LEFT, TAB_RIGHT } from '../core/actions.js';\nimport { PRESET_LOOKS } from '../data/classmates.js';\nimport { say, sayCentered } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\n\nexport class ViewerScene extends BaseScene {\n  name = 'viewer';\n  id = 'viewer';\n  i = 0;\n\n  cameraConfig() { return { preset: 'fixed', position: [0, 1.7, 6], target: [0, 0.95, 0], fov: 30 }; }\n\n  async build(ctx) {\n    plazaSet(ctx, 11);\n    this.avatar = await makeAvatar(ctx, App.slot?.look ?? PRESET_LOOKS[0], { at: [0, 0, 0], clip: VIEWER_CLIPS[0] });\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    const n = VIEWER_CLIPS.length;\n    if (input.wasPressed(...MENU_RIGHT, ...TAB_RIGHT) || input.wheel > 0) { this.i = (this.i + 1) % n; this.show(); }\n    if (input.wasPressed(...MENU_LEFT, ...TAB_LEFT) || input.wheel < 0) { this.i = (this.i - 1 + n) % n; this.show(); }\n    if (input.wasPressed(...CONFIRM)) this.show();\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight')) App.go(App.slot ? 'hub' : 'title', {});\n  }\n\n  show() { this.avatar.play(VIEWER_CLIPS[this.i], { fade: 0.15, once: false }); App.sfx('menuMove'); }\n\n  onUpdate(ctx, dt) {\n    this.avatar.root.rotation.y += dt * 0.5;\n    this.avatar.update(dt);\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    heading(hud, 'Animation Viewer', 8);\n    sayCentered(hud, hud.width / 2, 36, `${VIEWER_CLIPS[this.i]}  ${this.i + 1}/${VIEWER_CLIPS.length}`, { scale: 1, color: 'sand', name: 'clip' });\n    promptBar(hud, App.device, [['adjust', 'Clip'], ['confirm', 'Replay'], ['back', 'Back']]);\n    void say;\n  }\n\n  status() { return `viewer | ${VIEWER_CLIPS[this.i]}`; }\n}\nEOF\npython3 - <<'EOF'\np='src/scenes/index.js'; s=open(p).read()\ns=s.replace(\"\"\"import './attract.js';\"\"\",\"\"\"import { HubScene } from './hub.js';\nimport { WeighInScene } from './weighin.js';\nimport { ReportScene } from './report.js';\nimport { JarScene } from './jar.js';\nimport { RecordsScene } from './records.js';\nimport { LockerScene } from './locker.js';\nimport { FerryScene } from './ferry.js';\nimport { EndingScene } from './ending.js';\nimport { ViewerScene } from './viewer.js';\nimport './attract.js';\"\"\")\ns=s.replace(\"\"\"  title: (a) => new TitleScene(a),\"\"\",\"\"\"  title: (a) => new TitleScene(a),\n  hub: (a) => new HubScene(a),\n  weighin: (a) => new WeighInScene(a),\n  report: (a) => new ReportScene(a),\n  jar: (a) => new JarScene(a),\n  records: (a) => new RecordsScene(a),\n  locker: (a) => new LockerScene(a),\n  ferry: (a) => new FerryScene(a),\n  ending: (a) => new EndingScene(a),\n  viewer: (a) => new ViewerScene(a),\"\"\")\nopen(p,'w').write(s)\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [ ] 4 Island and week\",\"- [~] 4 Island and week: all scenes written (hub, weighin, report, jar, records, locker, ferry, ending, viewer); needs test + look\")\nopen(p,'w').write(s)\nEOF\ncat > .scratch/week.mjs <<'EOF'\nimport { boot, App, assert } from '../tests/lib.mjs';\nconst h = await boot({ scene:'title' });\nh.step(5);\nh.press('Enter'); h.step(2); console.log(App.state().stack);\nh.press('Enter'); h.step(2); console.log(App.state().stack);\nh.press('Enter'); h.step(2); console.log(App.state().stack);\nh.press('Enter'); h.step(2); console.log(App.state().stack);\nh.press('Enter'); h.step(3); \nawait h.settle(); console.log(App.state().scene, App.slot?.name);\nh.press('Enter'); await h.settle(); h.step(5); console.log(App.state().scene, App.state().status);\nApp.dev.autopilot='good';\nfor (let i=0;i<60 && App.scene.id!=='hub';i++){ h.step(30); if(App.stack.open){h.press('Enter');} await h.settle(); }\nconsole.log(App.state().scene, App.state().status, App.slot.ages, h.errors());\nprocess.exit(0);\nEOF\ntimeout 100 node .scratch/week.mjs </dev/null 2>&1 | tail -14 | cut -c1-500","description":"Write report, jar, records, locker, ferry, ending and viewer, then smoke test","timeout":130000}}}
