{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjKzsyHuMqteWTr8LHP1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01J1FA7bZe5imQCkEwETAbU3","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [~] 1 Skeleton: data + core + ui + art written, build/test tools not yet\",\"- [x] 1 Skeleton: tools/build.mjs, tools/shot.mjs, tests/lib.mjs work (tools/test.mjs not yet)\")\ns=s.replace(\"- [ ] 2 Dot and UI kit\",\"- [x] 2 Dot and UI kit (src/core, src/ui, src/art, src/audio, src/data all written)\")\ns=s.replace(\"- [ ] 3 Holding Still end to end\",\"- [x] 3 Holding Still end to end (src/scenes/activity/{base,lanes,events,poses}.js). Looks good at 1080p\")\ns=s.replace(\"- Tests caught: (keep a count here)\",\"- Tests/screens caught so far: lean accumulation on joints with no clip track (avatars folded into heaps, critical visually); title text shadow mismatch; class-rail Array.from bug via checkModel; 5 model/clip problems via checkModel/analyzeClip\\n- Stuck/guess wrong: awaiting App.go while engine in manual step mode hangs (no frames run); e.step() makes it manual\")\nopen(p,'w').write(s)\nEOF\ncat > src/ui/chart.js <<'EOF'\n// The Wobble Age chart: one line, seven points, and at the confession every point slides down by seven.\nimport { layout } from './layout.js';\nimport { line, panel } from './widgets.js';\nimport { say, sayCentered } from './font.js';\n\n/** ages: numbers already as shown. slide: subtracted from each point, for the animation. */\nexport function drawAgeChart(hud, x, y, w, h, ages, { slide = 0, days = 7, min = 18, max = 102, title = 'Wobble Age', fill = 'white', labels = true } = {}) {\n  layout.rec('chart', x, y, w, h);\n  panel(hud, x, y, w, h, { fill, name: 'chart-panel' });\n  const px = x + 24, py = y + 14, pw = w - 34, ph = h - 26;\n  if (title) say(hud, x + 5, y + 3, title, { color: 'teal', shadow: false, name: 'chart-title' });\n  for (const v of [30, 60, 90]) {\n    const gy = py + ph - Math.round(((v - min) / (max - min)) * ph);\n    hud.rect(px, gy, pw, 1, 'mist');\n    say(hud, x + 5, gy - 4, String(v), { color: 'slate', shadow: false, name: 'chart-axis' });\n  }\n  const pts = ages.slice(-days).map((a, i) => {\n    const v = a - slide;\n    return { x: px + Math.round((i / Math.max(1, days - 1)) * pw), y: py + ph - Math.round(((Math.max(min, Math.min(max, v)) - min) / (max - min)) * ph), v };\n  });\n  for (let i = 1; i < pts.length; i++) line(hud, pts[i - 1].x, pts[i - 1].y, pts[i].x, pts[i].y, 'sky', 2);\n  for (const p of pts) { hud.rect(p.x - 2, p.y - 2, 5, 5, 'red'); hud.rect(p.x - 1, p.y - 1, 3, 3, 'white'); }\n  if (labels && pts.length) {\n    const last = pts[pts.length - 1];\n    sayCentered(hud, Math.min(last.x, x + w - 12), Math.max(py - 2, last.y - 13), String(Math.round(last.v)), { color: 'ink', shadow: false, name: 'chart-value' });\n  }\n}\nEOF\ncat > src/scenes/hub.js <<'EOF'\n// Tare Island. Walk between stations, do what you like, end the day in the hammock.\nimport { compileClips as _unused, ContactShadow, Decals, HERO_MODEL, HERO_RIG, PALETTE, PlatformerCharacter, readMoveInput, setLookLayer, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { CONFIRM, SIT, WAVE } from '../core/actions.js';\nimport { dayData, goalMet, goalOf, hardOpen, isOpen } from '../core/week.js';\nimport { clipsFor, dress, makeAvatar } from '../art/avatar.js';\nimport { Kevin, Ounce, place } from '../art/props.js';\nimport { floorPlane } from '../art/textures.js';\nimport { ACTIVITIES } from '../data/activities.js';\nimport { LOOKS, SPEAKERS } from '../data/classmates.js';\nimport { HAMMOCK_LINES, IDLE_BARKS, ISLAND_BARKS, STATION_REMARKS, WEEK2_LINES } from '../data/lines.js';\nimport { STATIONS, STATION_IDS } from '../data/stations.js';\nimport { MILESTONES } from '../data/unlocks.js';\nimport { DialogueScreen } from '../ui/dialogue.js';\nimport { say, sayRight, textWidth, wrap, charsIn } from '../ui/font.js';\nimport { Menu } from '../ui/menu.js';\nimport { drawPrompt, promptBar } from '../ui/prompts.js';\nimport { MenuScreen } from '../ui/screens/common.js';\nimport { SAFE } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { box, grass, gulls, sea, setSky } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nconst { Vector3 } = THREE;\nvoid _unused; void SPEAKERS; void hardOpen;\n\nexport const ISLAND = { halfX: 22, halfZ: 17 };\n\nexport function buildIsland(ctx, { walls = true, dusk = false } = {}) {\n  setSky(ctx, dusk ? 19 : 10.5);\n  const { physics } = ctx;\n  // Ground: sand around the edge, lawn inside, white tile at the heart. A cut for the inlet.\n  physics.addStaticBox({ position: [-2.5, -0.46, 0], halfExtents: [19.5, 0.5, 17] });\n  physics.addStaticBox({ position: [19.5, -0.46, -9.5], halfExtents: [2.5, 0.5, 7.5] });\n  physics.addStaticBox({ position: [19.5, -0.46, 11], halfExtents: [2.5, 0.5, 6] });\n  box(ctx, 39, 0.8, 34, [-2.5, -0.42, 0], 'sand', { cast: false });\n  box(ctx, 5, 0.8, 15, [19.5, -0.42, -9.5], 'sand', { cast: false });\n  box(ctx, 5, 0.8, 12, [19.5, -0.42, 11], 'sand', { cast: false });\n  box(ctx, 34, 0.1, 19, [-1, -0.0, 5.5], 'lime', { cast: false });\n  box(ctx, 12, 0.1, 9, [0, -0.0, -8.5], 'lime', { cast: false });\n  ctx.scene.add(floorPlane('clinic-tile', 18, 14, { at: [0, 0.06, 0] }));\n  box(ctx, 18.6, 0.06, 14.6, [0, 0.02, 0], 'mist', { cast: false });\n  // Paths, in tile, out to the stations.\n  for (const [w, d, x, z] of [[8, 2.4, -11, 3], [8, 2.4, 11, 3], [2.4, 6, 0, 10], [2.4, 7, 7, -8.6], [2.4, 7, -7, -8.6]]) {\n    ctx.scene.add(floorPlane('clinic-tile', w, d, { at: [x, 0.055, z] }));\n  }\n  const water = sea(ctx, { at: [0, -0.34, 0], size: [240, 200] });\n  grass(ctx, [34, 19], [-1, 0.03, 5.5], (x, z) => {\n    if (Math.abs(x) < 9.6 && Math.abs(z) < 7.6) return false;\n    if (Math.abs(z - 3) < 1.4 && Math.abs(x) < 15.2) return false;\n    if (Math.abs(x) < 1.4 && z > 6 && z < 13) return false;\n    return true;\n  }, 3000);\n  if (walls) {\n    for (const [pos, half] of [\n      [[0, 2, -ISLAND.halfZ - 0.2], [ISLAND.halfX + 1, 3, 0.4]], [[0, 2, ISLAND.halfZ + 0.2], [ISLAND.halfX + 1, 3, 0.4]],\n      [[-ISLAND.halfX + 0.2, 2, 0], [0.4, 3, ISLAND.halfZ + 1]], [[ISLAND.halfX + 0.2, 2, 0], [0.4, 3, ISLAND.halfZ + 1]],\n      [[17.2, 2, 1.5], [0.3, 3, 3.5]], [[19.5, 2, -2.2], [2.5, 3, 0.3]], [[19.5, 2, 5.2], [2.5, 3, 0.3]],\n    ]) physics.addStaticBox({ position: pos, halfExtents: half });\n  }\n  // Stations.\n  const solid = (at, r) => physics.addStaticCylinder([at[0], 1.5, at[1]], 1.5, r);\n  const pav = place(ctx, 'pavilion', { at: [-11, 0, 3], palette: { roof: 'sky' } });\n  for (const a of [[-13.7, 1.4], [-13.7, 4.6], [-8.3, 1.4], [-8.3, 4.6]]) solid(a, 0.35);\n  place(ctx, 'rep-shed', { at: [11, 0, 1.6], collide: true });\n  place(ctx, 'giant-dumbbell', { at: [7.2, 0, 0.4], yaw: 30 });\n  place(ctx, 'beat-stage', { at: [12, 0, -11.6] });\n  physics.addStaticBox({ position: [12, 0.25, -11.6], halfExtents: [4, 0.25, 2.2] });\n  place(ctx, 'pier', { at: [-9.4, -1.1, -16], params: { len: 16 } });\n  physics.addStaticBox({ position: [-9.4, 0.25, -14], halfExtents: [1.6, 0.25, 1] });\n  place(ctx, 'catapult', { at: [-13.6, 0, -11.4], yaw: 30 });\n  place(ctx, 'slack-anchor', { at: [-15.4, 0, -14.4], scale: 0.7 });\n  place(ctx, 'slack-anchor', { at: [-6, 0, -15], scale: 0.7 });\n  for (const x of [-1.8, 1.8]) { box(ctx, 0.4, 3.1, 0.4, [x, 1.55, 11], 'white'); physics.addStaticBox({ position: [x, 1.5, 11], halfExtents: [0.22, 1.5, 0.22] }); }\n  box(ctx, 4.1, 0.6, 0.3, [0, 3.2, 11], 'cyan');\n  box(ctx, 2.8, 0.14, 0.34, [0, 3.2, 11.02], 'white');\n  const jar = place(ctx, 'sweat-jar', { at: [4, 0.06, -4] });\n  solid([4, -4], 1.1);\n  const fluid = new THREE.Mesh(new THREE.CylinderGeometry(0.96, 0.96, 1, 12), toonMaterial(PALETTE.sky));\n  fluid.position.set(4, 0.06 + 0.4, -4);\n  fluid.scale.y = 0.02;\n  ctx.scene.add(fluid);\n  place(ctx, 'lockers', { at: [-4, 0.06, -4.9], collide: true });\n  place(ctx, 'numbers-board', { at: [0, 0.06, -9.6], collide: true });\n  place(ctx, 'hammock', { at: [14.3, 0, 10] });\n  place(ctx, 'palm', { at: [12.2, 0, 10.2], yaw: 180 });\n  place(ctx, 'palm', { at: [16.4, 0, 10.4], yaw: 10 });\n  // Scenery, tall things in the -x, -z quadrant.\n  const volcano = place(ctx, 'kettlebell-volcano', { at: [-19, -0.2, -19], scale: 0.86 });\n  place(ctx, 'foam-roller-hill', { at: [18, 0, -17], yaw: 8, scale: 0.8 });\n  place(ctx, 'dumbbell-bridge', { at: [19.6, -0.1, 1.5], yaw: 90 });\n  for (const [x, z, s] of [[-17, -2, 0.9], [-16, -5, 0.6], [18.4, -12, 0.7], [-3, -14.6, 0.8], [8, 14.6, 0.7], [-14, 14, 1]]) place(ctx, 'medicine-ball', { at: [x, 0, z], scale: s, collide: true });\n  for (const [x, z, yaw, s] of [[-20, 9, 40, 1.1], [-17.5, 12.5, 200, 1], [20, 14, 100, 1.1], [-3, -15.5, 160, 1.1], [3.6, 15, 300, 1]]) place(ctx, 'palm', { at: [x, 0, z], yaw, scale: s });\n  for (const [x, z] of [[-7.6, 7.2], [7.6, 7.2], [-7.6, -7.2], [7.6, -7.2]]) place(ctx, 'lamp-post', { at: [x, 0.06, z] });\n  place(ctx, 'fountain', { at: [-5.8, 0.06, 2.6], collide: true });\n  place(ctx, 'bench', { at: [5.4, 0.06, 5.8], yaw: 180 });\n  place(ctx, 'bench', { at: [-5.4, 0.06, 5.8], yaw: 180 });\n  for (const [x, z] of [[-3, 8.2], [3, 8.2], [-16.5, 6.5], [15.6, 6.8], [7.6, 9.8], [-7.6, 9.8], [-6, -11.2], [6, -12.6]]) place(ctx, 'bush', { at: [x, 0, z], seed: Math.abs(Math.round(x * 3)) + 1 });\n  for (const [x, z] of [[-1.8, 8.4], [1.8, 8.4], [-11.5, 7.5], [11.5, 6.4], [-5.2, 12.5], [5.2, 12.8]]) place(ctx, 'flowers', { at: [x, 0, z], seed: Math.abs(Math.round(z * 3)) + 1 });\n  void pav; void jar; void volcano;\n  return { water, fluid };\n}\n\n/** A person walking small loops around the island. */\nclass Local {\n  constructor(avatar, stops, rand) { this.av = avatar; this.stops = stops; this.rand = rand; this.i = 0; this.wait = rand() * 3; this.at = new Vector3(...stops[0].at); this.walking = false; avatar.root.position.copy(this.at); this.speed = 1.6; this.frozen = false; }\n  update(dt) {\n    if (this.frozen) { this.av.update(dt); return; }\n    const stop = this.stops[this.i];\n    if (this.walking) {\n      const dx = stop.at[0] - this.at.x, dz = stop.at[2] - this.at.z;\n      const d = Math.hypot(dx, dz);\n      if (d < 0.1) { this.walking = false; this.wait = stop.wait ?? 4 + this.rand() * 3; this.av.play(stop.clip ?? 'Idle', { fade: 0.25 }); this.av.root.rotation.y = stop.yaw ?? this.av.root.rotation.y; } else {\n        this.at.x += (dx / d) * this.speed * dt; this.at.z += (dz / d) * this.speed * dt;\n        this.av.root.rotation.y = Math.atan2(dx, dz);\n      }\n    } else {\n      this.wait -= dt;\n      if (this.wait <= 0) { this.i = (this.i + 1) % this.stops.length; this.walking = true; this.av.play('Walk', { fade: 0.2 }); }\n    }\n    this.av.root.position.set(this.at.x, stop.at[1] ?? 0, this.at.z);\n    this.av.groundY = 0;\n    this.av.update(dt);\n  }\n}\n\nconst LOCAL_ROUTES = {\n  marguerite: [{ at: [-5, 0.06, 4.6], clip: 'Stretch', yaw: 1.2 }, { at: [-8, 0.06, -0.4], clip: 'Tree', yaw: 0.6 }, { at: [-6, 0.06, 6.4], clip: 'Sit', yaw: 3.1, wait: 7 }],\n  dennis: [{ at: [8, 0, 8.6], clip: 'Teeter', yaw: 0.5 }, { at: [6.2, 0, 11], clip: 'Flail', yaw: 2.1, wait: 3 }, { at: [12, 0, 7.2], clip: 'Slump', yaw: 0.3 }, { at: [8.6, 0, -1.4], clip: 'Stretch', yaw: 0.4 }],\n  june: [{ at: [6.4, 0.06, 6.4], clip: 'Sit', yaw: 3.1, wait: 8 }, { at: [3, 0.06, -6], clip: 'Heron', yaw: 0.6, wait: 6 }, { at: [8.5, 0, -7.4], clip: 'Watch', yaw: 1.2 }],\n};\n\nexport class StationScreen extends MenuScreen {\n  constructor(id, scene) {\n    const st = STATIONS[id];\n    const menu = new Menu([], { width: 420, y: 44, onBack: () => App.stack.pop(this) });\n    super('station', st.name, menu, { remark: STATION_REMARKS[id] });\n    this.id = id; this.scene = scene; this.hard = false;\n    this.refresh();\n  }\n  refresh() {\n    const slot = App.slot;\n    const st = STATIONS[this.id];\n    const items = st.activities.map((a) => {\n      const def = ACTIVITIES[a];\n      const open = isOpen(slot, a, App.dev.allUnlocked);\n      const rec = slot.records[a];\n      return {\n        label: open ? def.name : `${def.name}`, id: a, disabled: !open, focusable: true,\n        stars: open ? (rec?.stars ?? 0) : undefined,\n        right: () => (open ? (rec ? `${Math.round(rec.best)}` : '-') : `Day ${def.day}`),\n        action: () => this.scene.enterActivity(a, this.hard),\n      };\n    });\n    if (hardOpen(slot, App.dev.allUnlocked)) items.push({ label: 'Difficulty', id: 'hard', value: () => (this.hard ? 'Hard' : 'Standard'), adjust: () => { this.hard = !this.hard; }, action: () => { this.hard = !this.hard; } });\n    this.menu.setItems(items);\n  }\n}\n\nclass HammockScreen extends MenuScreen {\n  constructor(scene) {\n    const menu = new Menu([\n      { label: 'Stay up', id: 'no', action: () => App.stack.pop(this) },\n      { label: 'End the day', id: 'yes', action: () => { App.stack.pop(this); scene.endDay(); } },\n    ], { width: 220, y: 84, align: 'center', onBack: () => App.stack.pop(this) });\n    super('hammock', 'The Hammock', menu, { remark: HAMMOCK_LINES.ask });\n  }\n}\n\nexport class HubScene extends BaseScene {\n  name = 'hub';\n  id = 'hub';\n  canPause = true;\n  pauseToIsland = false;\n  nearest = null;\n  barkT = 9;\n  walkTarget = null;\n  autoEnter = null;\n  feet = new Vector3();\n  camT = new Vector3();\n  rayO = new Vector3();\n  rayD = new Vector3();\n\n  cameraConfig() { return { preset: 'iso', zoom: 1.15, minZoom: 1.15, maxZoom: 1.15 }; }\n\n  get attractMode() { return !!this.args.attract; }\n\n  async build(ctx) {\n    this.cosmetic = ctx.random.fork('cosmetic');\n    const world = buildIsland(ctx);\n    this.water = world.water;\n    this.fluid = world.fluid;\n    this.gulls = gulls(ctx, 9);\n    const rand = () => this.cosmetic.next();\n    // The hero.\n    const slot = App.slot;\n    const look = withWardrobe(slot?.look ?? { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink', headband: 'red' }, slot);\n    const model = (await ctx.loadModel(HERO_MODEL, { castShadow: false })).scene;\n    dress(model, look);\n    setLookLayer(model, 'actors');\n    ctx.scene.add(model);\n    this.model = model;\n    this.shadow = new ContactShadow(0.42);\n    ctx.scene.add(this.shadow);\n    const start = this.args.from && STATIONS[this.args.from] ? this.spawnFor(this.args.from) : [0, 0.08, 5.2];\n    this.hero = new PlatformerCharacter(ctx.physics, { position: start, lockDepth: false });\n    this.hero.attachModel(model, clipsFor(model), HERO_RIG);\n    this.input = null;\n    // Ounce, who hops after you.\n    this.ounce = new Ounce(ctx, { at: [start[0] + 1.6, 0.06, start[2] + 0.6], scale: 1.4 });\n    this.ounceRest = 0;\n    this.kevin = new Kevin(ctx, { at: [-4, 2.5, -4.9], yaw: 0.6 });\n    this.locals = {};\n    for (const who of ['marguerite', 'dennis', 'june']) {\n      const av = await makeAvatar(ctx, LOOKS[who], { at: LOCAL_ROUTES[who][0].at, clip: LOCAL_ROUTES[who][0].clip ?? 'Idle' });\n      this.locals[who] = new Local(av, LOCAL_ROUTES[who], rand);\n    }\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [-1.8, 0.06, 2.2], yaw: 0.6, clip: 'CoachStand' });\n    this.coach.addPlumb();\n    this.decals = new Decals(ctx.scene, { capacity: 200 });\n    this.footT = 0;\n    this.side = 1;\n    this.updateJar();\n    App.music('title');\n    if (!this.attractMode) this.onArrive();\n    else { this.route = ['pavilion', 'jar', 'beach', 'hall', 'gate', 'hammock', 'lagoon', 'terrace']; this.routeI = 0; this.autoRoute(); }\n  }\n\n  spawnFor(id) {\n    const st = STATIONS[id];\n    const dx = -st.at[0], dz = -st.at[1];\n    const d = Math.hypot(dx, dz) || 1;\n    return [st.at[0] + (dx / d) * (st.radius - 0.8), 0.08, st.at[1] + (dz / d) * (st.radius - 0.8)];\n  }\n\n  updateJar() {\n    const drips = App.slot?.drips ?? 40;\n    const f = Math.min(1, drips / MILESTONES[MILESTONES.length - 1].drips);\n    this.fluid.scale.y = Math.max(0.02, f * 2.1);\n    this.fluid.position.y = 0.46 + this.fluid.scale.y / 2;\n  }\n\n  /** Coming back to the island. Today's story beat plays once. */\n  onArrive() {\n    const slot = App.slot;\n    if (!slot) return;\n    if (slot.week === 1 && slot.heardBeat < slot.day) {\n      const lines = dayData(slot).beat;\n      slot.heardBeat = slot.day;\n      App.store.write();\n      if (lines.length) this.playBeat(lines);\n    } else if (slot.week === 2 && slot.day === 1 && !slot.week2Said) {\n      slot.week2Said = true;\n      App.store.write();\n      App.stack.push(new DialogueScreen(WEEK2_LINES));\n    }\n    if (slot.week === 1 && slot.day === 7 && !goalMet(slot)) App.say('coach', 'Stand on the terrace, when you are ready.');\n  }\n\n  /** Stage whoever is speaking near the hero. */\n  playBeat(lines) {\n    const hero = this.hero.feetInto(this.feet);\n    const staged = lines.map((l) => (typeof l === 'string' ? { who: l.split(':')[0], text: l.slice(l.indexOf(':') + 2) } : { ...l }));\n    for (const l of staged) {\n      if (typeof l.run === 'string') { const name = l.run; l.run = () => this.beatAction(name); }\n      else if (l.who && this.locals[l.who]) {\n        const who = l.who;\n        l.run = () => this.bring(who);\n      } else if (l.who === 'coach') l.run = () => this.coachNear();\n    }\n    void hero;\n    App.stack.push(new DialogueScreen(staged, { onDone: () => this.afterBeat() }));\n  }\n\n  bring(who) {\n    const f = this.hero.feetInto(this.feet);\n    const l = this.locals[who];\n    l.frozen = true;\n    l.at.set(f.x - 1.8, 0.06, f.z + 0.3);\n    l.av.root.position.copy(l.at);\n    l.av.root.rotation.y = 1.2;\n    l.av.play('Idle', { fade: 0.1 });\n  }\n\n  coachNear() {\n    const f = this.hero.feetInto(this.feet);\n    this.coach.root.position.set(f.x - 1.4, 0.06, f.z - 0.4);\n    this.coach.root.rotation.y = 1.0;\n  }\n\n  afterBeat() { for (const l of Object.values(this.locals)) l.frozen = false; }\n\n  beatAction(name) {\n    const o = this.ounce.root.position;\n    switch (name) {\n      case 'plumb': { this.coach.root.position.set(o.x - 1.1, 0.06, o.z + 0.2); this.coach.root.rotation.y = 1.2; this.coach.play('Point', { fade: 0.2 }); this.ounce.setMood('concern'); break; }\n      case 'kevinSits': { this.kevin.flyTo(o.x, o.y + 1.5, o.z, 0.9); this.seven = false; break; }\n      case 'dialSeven': { this.seven = true; this.ounce.read(0.7); break; }\n      case 'kevinLeaves': { this.kevin.flyTo(-4, 2.5, -4.9, 1.2); this.seven = false; this.ounce.read(null); break; }\n      case 'ounceHides': { this.ounce.hopTo(4, -5.8, 0.5); break; }\n      case 'ounceBack': { const f = this.hero.feetInto(this.feet); this.ounce.hopTo(f.x + 1.4, f.z + 0.4, 0.5); break; }\n      default: break;\n    }\n  }\n\n  onFixed(ctx, dt) {\n    if (App.stack.open || App.loading) {\n      const inp = this.input ??= readMoveInput(ctx, this.hero, this.input);\n      inp.move.set(0, 0, 0); inp.jump = false; inp.jumpHeld = false;\n      inp.wave = false; inp.sit = false; inp.crouch = false; inp.crouchPressed = false; inp.prone = false; inp.lie = false; inp.attack = false; inp.grab = false;\n      this.hero.fixedUpdate(dt, inp);\n      return;\n    }\n    this.input = readMoveInput(ctx, this.hero, this.input);\n    const inp = this.input;\n    const { input } = ctx;\n    if (input.padAxis && (input.padAxis.x || input.padAxis.y)) this.walkTarget = null;\n    // Pad buttons are remapped at boot, so OR them in.\n    if (this.nearest) { inp.jump = false; inp.jumpHeld = false; input.clearQueued('Space'); } else {\n      if (input.consumePress('PadCross')) { inp.jump = true; this.justJumped = true; }\n      if (input.isDown('PadCross')) inp.jumpHeld = true;\n    }\n    if (inp.jump && !this.nearest) this.justJumped = true;\n    if (input.consumeAny(WAVE)) { inp.wave = true; this.justWaved = true; }\n    if (input.consumeAny(SIT)) { inp.sit = true; this.justSat = true; }\n    if (this.walkTarget) this.steer(inp);\n    if (this.attractMode) this.attractSteer(inp);\n    this.hero.fixedUpdate(dt, inp);\n    this.hero.feetInto(this.feet);\n    this.updateNearest();\n    this.footsteps(dt);\n    this.followOunce(dt);\n  }\n\n  steer(inp) {\n    const f = this.hero.feetInto(this.feet);\n    const dx = this.walkTarget.x - f.x, dz = this.walkTarget.z - f.z;\n    const d = Math.hypot(dx, dz);\n    if (d < 0.5) {\n      this.walkTarget = null;\n      inp.move.set(0, 0, 0);\n      if (this.autoEnter && this.nearest === this.autoEnter) { const id = this.autoEnter; this.autoEnter = null; this.activate(id); }\n      return;\n    }\n    inp.move.set(dx / d, 0, dz / d);\n    if (this.autoEnter && this.nearest === this.autoEnter) { const id = this.autoEnter; this.autoEnter = null; this.walkTarget = null; inp.move.set(0, 0, 0); this.activate(id); }\n  }\n\n  attractSteer(inp) {\n    const f = this.hero.feetInto(this.feet);\n    const st = STATIONS[this.route[this.routeI]];\n    const dx = st.at[0] - f.x, dz = st.at[1] - f.z;\n    const d = Math.hypot(dx, dz);\n    if (d < st.radius) { this.routeI = (this.routeI + 1) % this.route.length; return; }\n    inp.move.set(dx / d, 0, dz / d);\n  }\n\n  autoRoute() {}\n\n  updateNearest() {\n    if (this.attractMode) { this.nearest = null; return; }\n    const f = this.feet;\n    let best = null, bestD = Infinity;\n    const slot = App.slot;\n    for (const id of STATION_IDS) {\n      const st = STATIONS[id];\n      if (st.unlockDay && slot && !isUnlockedDay(slot, st.unlockDay)) continue;\n      const d = Math.hypot(f.x - st.at[0], f.z - st.at[1]);\n      if (d < st.radius && d < bestD) { best = id; bestD = d; }\n    }\n    this.nearest = best;\n  }\n\n  footsteps(dt) {\n    const f = this.feet;\n    this.footT += dt * this.hero.speed;\n    if (this.footT > 1.1 && this.hero.grounded) {\n      this.footT = 0;\n      this.side = -this.side;\n      const onSand = Math.abs(f.x) > 16 || Math.abs(f.z) > 14 || (f.z < -4 && Math.abs(f.x) > 6);\n      if (onSand) this.decals.add('footprint', { x: f.x + this.side * 0.12, y: 0.01, z: f.z }, { x: 0, y: 1, z: 0 }, { size: 0.5 });\n    }\n  }\n\n  followOunce(dt) {\n    const o = this.ounce.root.position;\n    this.ounceRest -= dt;\n    const dx = this.feet.x - o.x, dz = this.feet.z - o.z;\n    const d = Math.hypot(dx, dz);\n    if (!this.ounce.hopping && this.ounceRest <= 0 && d > 2.3 && !this.ounceHiding) {\n      const step = Math.min(1.5, d - 1.5);\n      this.ounce.hopTo(o.x + (dx / d) * step, o.z + (dz / d) * step, 0.3);\n      this.ounceRest = 0.12;\n    }\n    if (!this.ounce.hopping) this.ounce.face2(this.feet.x, this.feet.z);\n  }\n\n  onInput(ctx, dt) {\n    const { input } = ctx;\n    const dev = App.device;\n    this.hoverStation = null;\n    // The mouse: hover names a station, a click walks there; ground just walks.\n    if (dev.last === 'mouse') {\n      const hit = this.groundAtPointer(ctx);\n      if (hit) {\n        for (const id of STATION_IDS) {\n          const st = STATIONS[id];\n          if (Math.hypot(hit.x - st.at[0], hit.z - st.at[1]) < st.radius * 0.85) { this.hoverStation = id; break; }\n        }\n        if (input.wasPressed('MouseLeft')) {\n          this.walkTarget = { x: hit.x, z: hit.z };\n          this.autoEnter = this.hoverStation;\n          if (this.hoverStation) { const st = STATIONS[this.hoverStation]; this.walkTarget = { x: st.at[0], z: st.at[1] }; }\n          if (this.hoverStation && this.nearest === this.hoverStation) { this.autoEnter = null; this.walkTarget = null; this.activate(this.hoverStation); return; }\n        }\n      }\n    }\n    if (this.nearest && input.wasPressed(...CONFIRM)) this.activate(this.nearest);\n    void dt;\n  }\n\n  groundAtPointer(ctx) {\n    const p = ctx.input.pointer;\n    ctx.camera.rayAt(p.x, p.y, this.rayO, this.rayD);\n    if (Math.abs(this.rayD.y) < 1e-4) return null;\n    const hitPhys = ctx.physics.castRay(this.rayO, this.rayD, 200);\n    const t = hitPhys ? hitPhys.distance : -this.rayO.y / this.rayD.y;\n    const out = this.rayO.clone().addScaledVector(this.rayD, t);\n    return out;\n  }\n\n  activate(id) {\n    const st = STATIONS[id];\n    App.sfx('menuConfirm');\n    switch (st.kind) {\n      case 'menu': App.stack.push(new StationScreen(id, this)); break;\n      case 'scene': App.go(st.scene, { from: id }); break;\n      case 'hammock': this.hammock(); break;\n      case 'terrace': this.terrace(); break;\n      default: break;\n    }\n  }\n\n  terrace() {\n    const slot = App.slot;\n    if (slot.week === 1 && slot.day === 7 && !goalMet(slot)) { App.go('activity', { id: 'stand', mode: 'week' }); return; }\n    App.stack.push(new DialogueScreen([{ who: 'ounce', text: this.terraceLine(), mood: 'smug' }]));\n  }\n\n  terraceLine() {\n    const slot = App.slot;\n    const goal = goalOf(slot);\n    return goalMet(slot) ? 'You have done what Coach asked. Everything after that is vanity.' : `Coach has asked for: ${goal.text} I would do it. She knows where you live. You live here.`;\n  }\n\n  hammock() {\n    const slot = App.slot;\n    if (slot.week === 1 && slot.day === 7 && !goalMet(slot)) {\n      App.stack.push(new DialogueScreen([{ who: 'ounce', text: 'Not today. Today you stand. Then you may lie down for as long as you like.', mood: 'concern' }]));\n      return;\n    }\n    if (!slot.todayDone.length) { App.stack.push(new HammockScreen(this)); return; }\n    if (!goalMet(slot)) { App.stack.push(new DialogueScreen([{ who: 'ounce', text: HAMMOCK_LINES.early, mood: 'droop' }], { onDone: () => this.endDay() })); return; }\n    App.stack.push(new DialogueScreen([{ who: 'ounce', text: HAMMOCK_LINES.fine, mood: 'pleased' }], { onDone: () => this.endDay() }));\n  }\n\n  endDay() {\n    const slot = App.slot;\n    slot.phase = 'report';\n    App.store.write();\n    App.go('report');\n  }\n\n  enterActivity(id, hard) { App.go('activity', { id, mode: 'week', hard }); }\n\n  onUpdate(ctx, dt) {\n    this.hero.updateVisual(this.model, dt, ctx.physics.alpha);\n    const p = this.model.position;\n    this.shadow.place(p.x, 0.07, p.z, Math.max(0, p.y - 0.07));\n    this.ounce.update(dt);\n    this.kevin.update(dt);\n    if (this.seven && this.kevin.state !== 'fly') this.kevin.root.position.set(this.ounce.root.position.x, this.ounce.root.position.y + 1.5, this.ounce.root.position.z);\n    this.coach.update(dt);\n    for (const l of Object.values(this.locals)) l.update(dt);\n    this.gulls.update(dt, this.t);\n    this.water?.update(ctx.time);\n    this.decals.update(dt);\n    if (!App.stack.open && !this.attractMode) this.islandBarks(dt);\n    if (this.justJumped) { this.justJumped = false; this.barkOnce('jump'); }\n    if (this.justWaved) { this.justWaved = false; this.barkOnce('wave'); }\n    if (this.justSat) { this.justSat = false; this.barkOnce('sit'); }\n  }\n\n  barkOnce(kind) {\n    if (this.barkT > 4) return;\n    App.say('ounce', this.cosmetic.pick(IDLE_BARKS[kind]));\n    this.barkT = 6;\n  }\n\n  islandBarks(dt) {\n    this.barkT -= dt;\n    if (this.barkT <= 0 && !this.bark.active) {\n      this.barkT = 16 + this.cosmetic.next() * 14;\n      App.say('ounce', this.cosmetic.pick(ISLAND_BARKS));\n    }\n  }\n\n  onDraw(ctx) {\n    if (this.attractMode) return;\n    const { hud } = ctx;\n    const slot = App.slot;\n    if (slot) {\n      const dayText = slot.week > 1 ? `Week ${slot.week}, day ${slot.day}` : `Day ${slot.day}`;\n      hud.rect(SAFE - 3, 6, textWidth(dayText, 2) + 6, 20, 'navy');\n      say(hud, SAFE, 8, dayText, { scale: 2, name: 'day' });\n      const goal = goalOf(slot);\n      const met = goalMet(slot);\n      const rows = wrap(`Coach: ${goal.text}${met ? ' Done.' : ''}`, charsIn(Math.min(hud.width - 120, 220)));\n      rows.forEach((r, i) => { hud.rect(SAFE - 3, 28 + i * 11, textWidth(r) + 6, 11, 'navy'); say(hud, SAFE, 29 + i * 11, r, { color: met ? 'lime' : 'sand', name: 'prescription' }); });\n      const drips = `${slot.drips} Drips`;\n      const dx = hud.width - SAFE;\n      const hasPauseIcon = !!this.pauseIconHit;\n      const right = hasPauseIcon ? dx - 16 : dx;\n      hud.rect(right - textWidth(drips, 2) - 3, 6, textWidth(drips, 2) + 6, 20, 'navy');\n      sayRight(hud, right, 8, drips, { scale: 2, color: 'cyan', name: 'drips' });\n    }\n    if (this.seven) {\n      const p = this.projected(ctx, this.ounce.root.position, 1.9);\n      hud.rect(p.x - 13, p.y - 16, 26, 22, 'white');\n      say(hud, p.x - 5, p.y - 14, '7', { scale: 2, color: 'red', shadow: false, name: 'dial-seven' });\n    }\n    if (App.stack.open) return;\n    // Prompts, bottom.\n    const list = [];\n    if (this.nearest) {\n      const st = STATIONS[this.nearest];\n      const label = this.nearest === 'terrace' && slot && slot.week === 1 && slot.day === 7 && !goalMet(slot) ? 'Stand' : `${st.verb}: ${st.name}`;\n      list.push(['confirm', label]);\n    } else {\n      if (App.device.last === 'mouse') list.push(['confirm', 'Click to walk']);\n      else list.push(['lean', 'Walk'], ['jump', 'Jump'], ['wave', 'Wave'], ['sit', 'Sit']);\n    }\n    list.push(['pause', 'Pause']);\n    if (!this.bark.active) promptBar(hud, App.device, list);\n    if (this.hoverStation && !this.nearest) {\n      const st = STATIONS[this.hoverStation];\n      const p = this.projected(ctx, new Vector3(st.at[0], 0, st.at[1]), 3);\n      const w = textWidth(st.name) + 8;\n      const x = Math.max(4, Math.min(hud.width - w - 4, Math.round(p.x - w / 2)));\n      const y = Math.max(44, Math.round(p.y) - 8);\n      hud.rect(x, y, w, 12, 'cyan');\n      say(hud, x + 4, y + 2, st.name, { color: 'ink', shadow: false, name: 'hover' });\n    }\n    void drawPrompt;\n  }\n\n  projected(ctx, v, up = 0) {\n    const out = new Vector3(v.x, v.y + up, v.z).project(ctx.camera.camera);\n    return { x: (out.x + 1) * 0.5 * ctx.hud.width, y: (1 - out.y) * 0.5 * ctx.hud.height };\n  }\n\n  cameraTarget() {\n    const p = this.model?.position;\n    return p ? this.camT.set(p.x, p.y + 0.9, p.z) : this.camT.set(0, 1, 5);\n  }\n\n  status() {\n    const s = App.slot;\n    return `hub | day ${s?.day ?? '-'} | near ${this.nearest ?? '-'} | drips ${s?.drips ?? 0} | hero ${this.feet.x.toFixed(1)},${this.feet.z.toFixed(1)}`;\n  }\n\n  fingerprint() { return `${this.feet.x.toFixed(4)},${this.feet.z.toFixed(4)}`; }\n\n  /** Tests and Dev Tools: stand at a station. */\n  stand(id) {\n    const st = STATIONS[id];\n    const s = this.spawnFor(id);\n    this.hero.teleport(s);\n    this.hero.feetInto(this.feet);\n    this.feet.x = s[0]; this.feet.z = s[2];\n    void st;\n    this.updateNearest();\n    return this.nearest;\n  }\n\n  dispose() { this.decals?.dispose?.(); }\n}\n\nfunction isUnlockedDay(slot, day) { return slot.week > 1 || slot.day >= day || slot.unlockedAll || App.dev.allUnlocked; }\nEOF\ncat > src/scenes/weighin.js <<'EOF'\n// The Morning Weigh-In: balance test, one absurd question, today's Wobble Age.\nimport { App } from '../app.js';\nimport { CONFIRM } from '../core/actions.js';\nimport { Dot } from '../core/dot.js';\nimport { BotBrain, LocalDriver, blankInput } from '../core/drivers.js';\nimport { T } from '../core/tunables.js';\nimport { recordWeighIn, dayData, totalStarsOf } from '../core/week.js';\nimport { Ounce } from '../art/props.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { AGE_LINES, INTRO_LINES, MORNINGS, OW_JOKE, OW_LINES } from '../data/lines.js';\nimport { AGE_QUESTION, QUESTIONS } from '../data/questions.js';\nimport { TESTS } from '../data/week.js';\nimport { DialogueScreen } from '../ui/dialogue.js';\nimport { say, sayCentered, wrap, charsIn } from '../ui/font.js';\nimport { Menu } from '../ui/menu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { MenuScreen } from '../ui/screens/common.js';\nimport { bar, drawDial, panel } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nexport const TEST_SECONDS = { stillness: 14, lean: 15, chase: 13 };\nconst LEAN_TARGETS = [{ x: -0.7, y: 0, label: '70% left' }, { x: 0.5, y: 0, label: '50% right' }, { x: 0, y: 0.6, label: 'Lean forward' }];\nconst HOLD_NEEDED = 1.5;\nconst RING = 0.3;\n\nexport function testT(kind, st) {\n  switch (kind) {\n    case 'stillness': return st.n ? st.in / st.n : 0;\n    case 'lean': {\n      const part = st.targetsDone / LEAN_TARGETS.length;\n      const quick = st.targetsDone === LEAN_TARGETS.length ? Math.max(0, 1 - (st.doneAt - 6) / 9) : 0;\n      return Math.max(0, Math.min(1, part * 0.6 + quick * 0.4));\n    }\n    case 'chase': return Math.max(0, Math.min(1, 1 - (st.n ? st.dist / st.n : 1) * 2));\n    default: return 0;\n  }\n}\n\nexport class WeighInScene extends BaseScene {\n  name = 'weighin';\n  id = 'weighin';\n  canPause = true;\n  pauseToTitle = true;\n  phase = 'greet';\n  testT = 0;\n  inp = blankInput();\n  driver = new LocalDriver();\n\n  cameraConfig() { return { preset: 'fixed', position: [1.2, 2.5, 6.2], target: [1.2, 1.25, 0], fov: 30 }; }\n\n  get test() { return this.args.test ?? dayData(App.slot).test; }\n\n  async build(ctx) {\n    plazaSet(ctx, 9);\n    const slot = App.slot;\n    this.rng = ctx.random.fork('test');\n    this.ounce = new Ounce(ctx, { at: [0, 0.04, 0], scale: 2 });\n    this.avatar = await makeAvatar(ctx, withWardrobe(slot.look, slot), { at: [0.1, 0, 2.2], yaw: 3.1, clip: 'Walk' });\n    this.dot = new Dot(() => this.rng.next());\n    this.st = { in: 0, n: 0, dist: 0, targetsDone: 0, holdT: 0, doneAt: 15 };\n    this.groupT = 0;\n    App.music('title');\n    this.step('walkOn');\n    this.ownStep = 0;\n    this.feelAge = 34;\n    if (slot.week > 1) this.test2 = TESTS[(slot.day + slot.week) % TESTS.length];\n  }\n\n  step(phase) { this.phase = phase; this.phaseT = 0; }\n\n  get auto() { return App.dev.autopilot; }\n\n  /** Lines, then what comes next. */\n  talk(lines, then) { App.stack.push(new DialogueScreen(lines, { onDone: then })); }\n\n  greet() {\n    const slot = App.slot;\n    const first = slot.day === 1 && slot.week === 1 && !slot.introHeard;\n    if (first) {\n      slot.introHeard = true;\n      App.store.write();\n      this.talk(INTRO_LINES, () => this.startTest());\n      return;\n    }\n    const ow = OW_LINES[(slot.day + slot.week * 3) % OW_LINES.length];\n    const morning = MORNINGS[(slot.day - 1) % MORNINGS.length];\n    const lines = [{ who: 'ounce', text: ow, mood: 'alarm' }];\n    if (slot.day === 2 && slot.week === 1) lines.push({ who: 'ounce', text: OW_JOKE, mood: 'smug' });\n    lines.push({ who: 'ounce', text: morning, mood: 'neutral' });\n    this.talk(lines, () => this.startTest());\n  }\n\n  startTest() {\n    this.step('test');\n    this.testT = 0;\n    this.dot.reset();\n    this.st = { in: 0, n: 0, dist: 0, targetsDone: 0, holdT: 0, doneAt: TEST_SECONDS[this.kind()] };\n    this.ounce.read(0);\n    App.sfx('menuConfirm');\n  }\n\n  kind() { return this.test2 ?? this.test; }\n\n  chaseTarget(t) { return { x: 0.6 * Math.sin(0.7 * t), y: 0.42 * Math.sin(1.1 * t + 1) }; }\n  targetNow() {\n    const k = this.kind();\n    if (k === 'lean') return LEAN_TARGETS[Math.min(this.st.targetsDone, LEAN_TARGETS.length - 1)];\n    if (k === 'chase') return this.chaseTarget(this.testT);\n    return { x: 0, y: 0 };\n  }\n\n  onFixed(ctx, dt) {\n    this.phaseT += dt;\n    if (this.phase === 'walkOn') {\n      if (this.phaseT > 1) { this.avatar.play('StepOn', { once: true, fade: 0.1 }); App.sfx('ow'); this.step('settle'); this.onScale = true; }\n      return;\n    }\n    if (this.phase === 'settle') {\n      if (this.phaseT > 0.7) { this.step('talking'); this.greet(); }\n      return;\n    }\n    if (this.phase !== 'test') return;\n    this.testT += dt;\n    const kind = this.kind();\n    const target = this.targetNow();\n    const inp = this.inp;\n    const auto = this.auto;\n    if (auto) {\n      if (!this.brain || this.brain.skill !== auto) this.brain = new BotBrain(auto, () => this.rng.next());\n      this.brain.lean(inp, this.dot, target.x, target.y, dt);\n    } else this.driver.read(inp, ctx, dt, App, this.dialPos);\n    this.dot.step(dt, inp.x, inp.y, T, { noise: App.noiseScale() });\n    const st = this.st;\n    const inside = Math.hypot(this.dot.x - target.x, this.dot.y - target.y) <= App.ringOf(kind === 'stillness' ? RING : 0.1);\n    if (kind === 'stillness') { st.n++; if (inside) st.in++; } else if (kind === 'chase') { st.n++; st.dist += Math.hypot(this.dot.x - target.x, this.dot.y - target.y); } else if (kind === 'lean' && st.targetsDone < LEAN_TARGETS.length) {\n      st.holdT = inside ? st.holdT + dt : Math.max(0, st.holdT - dt * 0.5);\n      if (st.holdT >= HOLD_NEEDED) {\n        st.targetsDone++; st.holdT = 0; App.sfx('ringIn');\n        if (st.targetsDone === LEAN_TARGETS.length) st.doneAt = this.testT;\n      }\n    }\n    if (inside && !this.wasInside) App.sfx('needleTick');\n    this.wasInside = inside;\n    this.ounce.read((this.dot.x + this.dot.y * 0.4) * 0.9);\n    const over = this.testT >= TEST_SECONDS[kind] || (kind === 'lean' && st.targetsDone === LEAN_TARGETS.length);\n    if (over) this.endTest();\n  }\n\n  endTest() {\n    this.score = testT(this.kind(), this.st);\n    this.ounce.read(null);\n    this.step('question');\n    App.stack.push(new QuestionScreen(this));\n  }\n\n  /** After the question: the Day 1 joke, then the reveal. */\n  reveal() {\n    const slot = App.slot;\n    const r = recordWeighIn(slot, this.score);\n    this.result = r;\n    App.store.write();\n    this.step('reveal');\n    this.rollT = 0;\n    this.ounce.setMood('spin');\n    App.music(null);\n    this.ticker = 0;\n  }\n\n  remark() {\n    const r = this.result;\n    const slot = App.slot;\n    let list = AGE_LINES.same;\n    if (r.previous === null) list = AGE_LINES.first;\n    else if (r.shown > r.previous) list = AGE_LINES.worse;\n    else if (r.shown < r.previous) list = AGE_LINES.better;\n    let text = list[(slot.day + slot.week) % list.length].replace('%A', String(r.shown));\n    const lines = [{ who: 'ounce', text, mood: r.previous !== null && r.shown < r.previous ? 'pleased' : 'concern' }];\n    if (this.feel !== undefined) lines.push({ who: 'ounce', text: AGE_LINES.feel[0].replace('%A', String(r.shown)).replace('%F', String(this.feel)), mood: 'droop' });\n    return lines;\n  }\n\n  finishReveal() {\n    const slot = App.slot;\n    slot.phase = 'day';\n    App.store.write();\n    App.go('hub', { from: 'terrace' });\n  }\n\n  onUpdate(ctx, dt) {\n    this.ounce.update(dt);\n    const a = this.avatar;\n    if (this.phase === 'walkOn') {\n      a.root.position.z = 2.2 - Math.min(1, this.phaseT) * 1.4;\n    } else if (this.onScale) {\n      const u = Math.min(1, this.phaseT / 0.5);\n      if (this.phase === 'settle') { a.root.position.y = 0.58 * u; a.root.position.z = 0.8 - 1.24 * u; a.root.rotation.y = 3.1 * (1 - u); if (u >= 1) a.play('Idle'); } else { a.root.position.set(0.1, 0.58, -0.44); a.root.rotation.y = 0; a.groundY = 0.58; }\n    }\n    a.update(dt);\n    if (this.phase === 'test') a.lean(this.dot.x, this.dot.y, 0, this.t);\n    if (this.phase === 'reveal') {\n      this.rollT += dt;\n      this.ticker -= dt;\n      const spin = this.rollT < 2.2;\n      if (spin && this.ticker <= 0) { this.ticker = 0.05; App.sfx('needleTick', { pitch: this.rollT * 2 }); }\n      if (!spin && !this.revealed) {\n        this.revealed = true;\n        this.ounce.setMood('neutral');\n        App.sfx('fanfareSoft');\n        this.talk(this.remark(), () => this.finishReveal());\n      }\n    }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const dx = Math.round(hud.width * 0.27);\n    const dy = Math.round(hud.height * 0.42);\n    const r = Math.min(62, Math.round(hud.height * 0.23));\n    if (this.phase === 'test') {\n      const kind = this.kind();\n      this.dialPos = { x: dx, y: dy };\n      const target = kind === 'stillness' ? null : this.targetNow();\n      const fade = kind === 'stillness' && this.testT > 3 ? 0 : 1;\n      const mouse = App.device.last === 'mouse' && !this.auto ? App.device.pointerArt(ctx) : null;\n      drawDial(hud, { x: dx, y: dy, r, dot: this.dot, ringR: App.ringOf(kind === 'stillness' ? RING : 0.1), ringX: target?.x ?? 0, ringY: target?.y ?? 0, inside: this.wasInside, fade, target: kind === 'chase' ? target : null, mouse, hideDot: fade === 0 });\n      const label = kind === 'stillness' ? (this.testT > 3 ? 'Eyes closed.' : 'Stand still. Then, eyes closed.') : kind === 'lean' ? this.targetNow().label : 'Follow the orange dot.';\n      const w = Math.min(hud.width - 24, label.length * 6 + 12);\n      hud.rect(Math.round(hud.width / 2 - w / 2), 8, w, 14, 'navy');\n      sayCentered(hud, hud.width / 2, 10, label, { color: 'sand', name: 'test-label' });\n      bar(hud, dx - r, dy + r + 8, r * 2, 6, 1 - this.testT / TEST_SECONDS[kind], 'cyan');\n      if (kind === 'lean') bar(hud, dx - r, dy + r + 16, r * 2, 6, this.st.holdT / HOLD_NEEDED, 'lime');\n      promptBar(hud, App.device, [['lean', 'Lean'], ['pause', 'Pause']]);\n    }\n    if (this.phase === 'reveal') {\n      const u = Math.min(1, this.rollT / 2.2);\n      const shown = this.result.shown;\n      const roll = u >= 1 ? shown : Math.floor(((Math.sin(this.rollT * 41) + 1) / 2) * 80) + 18;\n      panel(hud, dx - 56, dy - 40, 112, 80, { fill: 'white', name: 'age-panel' });\n      sayCentered(hud, dx, dy - 34, 'Wobble Age', { color: 'teal', shadow: false, name: 'age-title' });\n      sayCentered(hud, dx, dy - 14, String(roll), { scale: 5, color: 'red', shadow: false, name: 'age' });\n    }\n  }\n\n  overlayDot() { return `${this.dot.x.toFixed(2)},${this.dot.y.toFixed(2)}`; }\n  status() { return `weighin | ${this.phase} | test ${this.kind()} | t ${this.testT.toFixed(1)}${this.score !== undefined ? ` | T ${this.score.toFixed(2)}` : ''}`; }\n  fingerprint() { return `${this.dot.x.toFixed(5)},${this.dot.y.toFixed(5)}`; }\n}\n\nclass QuestionScreen {\n  name = 'question';\n  constructor(scene) {\n    this.scene = scene;\n    const slot = App.slot;\n    this.q = QUESTIONS[slot.week === 1 ? slot.day - 1 : (slot.day - 1) % (QUESTIONS.length - 1)];\n    this.firstDay = slot.day === 1 && slot.week === 1;\n    this.syl = null;\n    this.menu = new Menu(this.q.a.map((a, i) => ({ label: a, id: `a${i}`, action: () => this.answer(i) })), { scale: 1, rowH: 18, width: 320, y: 0, align: 'center' });\n    App.say('ounce', this.q.q);\n  }\n  answer(i) {\n    App.stack.pop(this);\n    App.slot.answers = (App.slot.answers ?? 0) + 1;\n    const after = [{ who: 'ounce', text: this.q.r[i], mood: 'smug' }, { who: 'ounce', text: 'Thank you. I have written that down.', mood: 'neutral' }];\n    App.stack.push(new DialogueScreen(after, { onDone: () => {\n      if (this.firstDay) App.stack.push(new FeelScreen(this.scene));\n      else this.scene.reveal();\n    } }));\n  }\n  update(ctx, dt) { this.menu.update(ctx, dt); }\n  draw(ctx) {\n    const { hud } = ctx;\n    const w = Math.min(hud.width - 24, 330);\n    const x = Math.round((hud.width - w) / 2);\n    const lines = wrap(this.q.q, charsIn(w - 20));\n    panel(hud, x, 20, w, lines.length * 11 + 12, { fill: 'white', name: 'question' });\n    lines.forEach((l, i) => sayCentered(hud, hud.width / 2, 26 + i * 11, l, { color: 'ink', shadow: false, name: 'question-text' }));\n    this.menu.o.y = 24 + lines.length * 11 + 12;\n    this.menu.draw(ctx);\n    promptBar(hud, App.device, [['confirm', 'Answer']]);\n  }\n}\n\n/** \"How old do you feel? This is not binding.\" Used once, in the joke, and never saved. */\nclass FeelScreen {\n  name = 'feel';\n  value = 34;\n  constructor(scene) {\n    this.scene = scene;\n    App.say('ounce', AGE_QUESTION);\n    this.menu = new Menu([{ label: 'How old do you feel?', id: 'age', value: () => `${this.value}`, adjust: (d) => { this.value = Math.max(1, Math.min(120, this.value + d)); }, action: () => this.done() }], { width: 320, y: 80 });\n  }\n  done() { this.scene.feel = this.value; App.stack.pop(this); this.scene.reveal(); }\n  update(ctx, dt) { this.menu.update(ctx, dt); if (ctx.input.wheel) this.value = Math.max(1, Math.min(120, this.value - Math.sign(ctx.input.wheel))); }\n  draw(ctx) {\n    this.menu.draw(ctx);\n    promptBar(ctx.hud, App.device, [['adjust', 'Change'], ['confirm', 'That\\'s it']]);\n  }\n}\n\nexport { CONFIRM, MenuScreen, say, totalStarsOf };\nEOF\necho ok","description":"Write the island hub and the Weigh-In scenes","timeout":30000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5735,"cache_read_input_tokens":392433,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5735},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"8aff3826-28bc-4168-a692-0682ce263632","timestamp":"2026-11-05T06:47:41.389Z","request_id":"req_011CgjKzsgSUcbfqBtw5GhAZ","wire_tool_inputs":{"toolu_01J1FA7bZe5imQCkEwETAbU3":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [~] 1 Skeleton: data + core + ui + art written, build/test tools not yet\",\"- [x] 1 Skeleton: tools/build.mjs, tools/shot.mjs, tests/lib.mjs work (tools/test.mjs not yet)\")\ns=s.replace(\"- [ ] 2 Dot and UI kit\",\"- [x] 2 Dot and UI kit (src/core, src/ui, src/art, src/audio, src/data all written)\")\ns=s.replace(\"- [ ] 3 Holding Still end to end\",\"- [x] 3 Holding Still end to end (src/scenes/activity/{base,lanes,events,poses}.js). Looks good at 1080p\")\ns=s.replace(\"- Tests caught: (keep a count here)\",\"- Tests/screens caught so far: lean accumulation on joints with no clip track (avatars folded into heaps, critical visually); title text shadow mismatch; class-rail Array.from bug via checkModel; 5 model/clip problems via checkModel/analyzeClip\\n- Stuck/guess wrong: awaiting App.go while engine in manual step mode hangs (no frames run); e.step() makes it manual\")\nopen(p,'w').write(s)\nEOF\ncat > src/ui/chart.js <<'EOF'\n// The Wobble Age chart: one line, seven points, and at the confession every point slides down by seven.\nimport { layout } from './layout.js';\nimport { line, panel } from './widgets.js';\nimport { say, sayCentered } from './font.js';\n\n/** ages: numbers already as shown. slide: subtracted from each point, for the animation. */\nexport function drawAgeChart(hud, x, y, w, h, ages, { slide = 0, days = 7, min = 18, max = 102, title = 'Wobble Age', fill = 'white', labels = true } = {}) {\n  layout.rec('chart', x, y, w, h);\n  panel(hud, x, y, w, h, { fill, name: 'chart-panel' });\n  const px = x + 24, py = y + 14, pw = w - 34, ph = h - 26;\n  if (title) say(hud, x + 5, y + 3, title, { color: 'teal', shadow: false, name: 'chart-title' });\n  for (const v of [30, 60, 90]) {\n    const gy = py + ph - Math.round(((v - min) / (max - min)) * ph);\n    hud.rect(px, gy, pw, 1, 'mist');\n    say(hud, x + 5, gy - 4, String(v), { color: 'slate', shadow: false, name: 'chart-axis' });\n  }\n  const pts = ages.slice(-days).map((a, i) => {\n    const v = a - slide;\n    return { x: px + Math.round((i / Math.max(1, days - 1)) * pw), y: py + ph - Math.round(((Math.max(min, Math.min(max, v)) - min) / (max - min)) * ph), v };\n  });\n  for (let i = 1; i < pts.length; i++) line(hud, pts[i - 1].x, pts[i - 1].y, pts[i].x, pts[i].y, 'sky', 2);\n  for (const p of pts) { hud.rect(p.x - 2, p.y - 2, 5, 5, 'red'); hud.rect(p.x - 1, p.y - 1, 3, 3, 'white'); }\n  if (labels && pts.length) {\n    const last = pts[pts.length - 1];\n    sayCentered(hud, Math.min(last.x, x + w - 12), Math.max(py - 2, last.y - 13), String(Math.round(last.v)), { color: 'ink', shadow: false, name: 'chart-value' });\n  }\n}\nEOF\ncat > src/scenes/hub.js <<'EOF'\n// Tare Island. Walk between stations, do what you like, end the day in the hammock.\nimport { compileClips as _unused, ContactShadow, Decals, HERO_MODEL, HERO_RIG, PALETTE, PlatformerCharacter, readMoveInput, setLookLayer, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { CONFIRM, SIT, WAVE } from '../core/actions.js';\nimport { dayData, goalMet, goalOf, hardOpen, isOpen } from '../core/week.js';\nimport { clipsFor, dress, makeAvatar } from '../art/avatar.js';\nimport { Kevin, Ounce, place } from '../art/props.js';\nimport { floorPlane } from '../art/textures.js';\nimport { ACTIVITIES } from '../data/activities.js';\nimport { LOOKS, SPEAKERS } from '../data/classmates.js';\nimport { HAMMOCK_LINES, IDLE_BARKS, ISLAND_BARKS, STATION_REMARKS, WEEK2_LINES } from '../data/lines.js';\nimport { STATIONS, STATION_IDS } from '../data/stations.js';\nimport { MILESTONES } from '../data/unlocks.js';\nimport { DialogueScreen } from '../ui/dialogue.js';\nimport { say, sayRight, textWidth, wrap, charsIn } from '../ui/font.js';\nimport { Menu } from '../ui/menu.js';\nimport { drawPrompt, promptBar } from '../ui/prompts.js';\nimport { MenuScreen } from '../ui/screens/common.js';\nimport { SAFE } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { box, grass, gulls, sea, setSky } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nconst { Vector3 } = THREE;\nvoid _unused; void SPEAKERS; void hardOpen;\n\nexport const ISLAND = { halfX: 22, halfZ: 17 };\n\nexport function buildIsland(ctx, { walls = true, dusk = false } = {}) {\n  setSky(ctx, dusk ? 19 : 10.5);\n  const { physics } = ctx;\n  // Ground: sand around the edge, lawn inside, white tile at the heart. A cut for the inlet.\n  physics.addStaticBox({ position: [-2.5, -0.46, 0], halfExtents: [19.5, 0.5, 17] });\n  physics.addStaticBox({ position: [19.5, -0.46, -9.5], halfExtents: [2.5, 0.5, 7.5] });\n  physics.addStaticBox({ position: [19.5, -0.46, 11], halfExtents: [2.5, 0.5, 6] });\n  box(ctx, 39, 0.8, 34, [-2.5, -0.42, 0], 'sand', { cast: false });\n  box(ctx, 5, 0.8, 15, [19.5, -0.42, -9.5], 'sand', { cast: false });\n  box(ctx, 5, 0.8, 12, [19.5, -0.42, 11], 'sand', { cast: false });\n  box(ctx, 34, 0.1, 19, [-1, -0.0, 5.5], 'lime', { cast: false });\n  box(ctx, 12, 0.1, 9, [0, -0.0, -8.5], 'lime', { cast: false });\n  ctx.scene.add(floorPlane('clinic-tile', 18, 14, { at: [0, 0.06, 0] }));\n  box(ctx, 18.6, 0.06, 14.6, [0, 0.02, 0], 'mist', { cast: false });\n  // Paths, in tile, out to the stations.\n  for (const [w, d, x, z] of [[8, 2.4, -11, 3], [8, 2.4, 11, 3], [2.4, 6, 0, 10], [2.4, 7, 7, -8.6], [2.4, 7, -7, -8.6]]) {\n    ctx.scene.add(floorPlane('clinic-tile', w, d, { at: [x, 0.055, z] }));\n  }\n  const water = sea(ctx, { at: [0, -0.34, 0], size: [240, 200] });\n  grass(ctx, [34, 19], [-1, 0.03, 5.5], (x, z) => {\n    if (Math.abs(x) < 9.6 && Math.abs(z) < 7.6) return false;\n    if (Math.abs(z - 3) < 1.4 && Math.abs(x) < 15.2) return false;\n    if (Math.abs(x) < 1.4 && z > 6 && z < 13) return false;\n    return true;\n  }, 3000);\n  if (walls) {\n    for (const [pos, half] of [\n      [[0, 2, -ISLAND.halfZ - 0.2], [ISLAND.halfX + 1, 3, 0.4]], [[0, 2, ISLAND.halfZ + 0.2], [ISLAND.halfX + 1, 3, 0.4]],\n      [[-ISLAND.halfX + 0.2, 2, 0], [0.4, 3, ISLAND.halfZ + 1]], [[ISLAND.halfX + 0.2, 2, 0], [0.4, 3, ISLAND.halfZ + 1]],\n      [[17.2, 2, 1.5], [0.3, 3, 3.5]], [[19.5, 2, -2.2], [2.5, 3, 0.3]], [[19.5, 2, 5.2], [2.5, 3, 0.3]],\n    ]) physics.addStaticBox({ position: pos, halfExtents: half });\n  }\n  // Stations.\n  const solid = (at, r) => physics.addStaticCylinder([at[0], 1.5, at[1]], 1.5, r);\n  const pav = place(ctx, 'pavilion', { at: [-11, 0, 3], palette: { roof: 'sky' } });\n  for (const a of [[-13.7, 1.4], [-13.7, 4.6], [-8.3, 1.4], [-8.3, 4.6]]) solid(a, 0.35);\n  place(ctx, 'rep-shed', { at: [11, 0, 1.6], collide: true });\n  place(ctx, 'giant-dumbbell', { at: [7.2, 0, 0.4], yaw: 30 });\n  place(ctx, 'beat-stage', { at: [12, 0, -11.6] });\n  physics.addStaticBox({ position: [12, 0.25, -11.6], halfExtents: [4, 0.25, 2.2] });\n  place(ctx, 'pier', { at: [-9.4, -1.1, -16], params: { len: 16 } });\n  physics.addStaticBox({ position: [-9.4, 0.25, -14], halfExtents: [1.6, 0.25, 1] });\n  place(ctx, 'catapult', { at: [-13.6, 0, -11.4], yaw: 30 });\n  place(ctx, 'slack-anchor', { at: [-15.4, 0, -14.4], scale: 0.7 });\n  place(ctx, 'slack-anchor', { at: [-6, 0, -15], scale: 0.7 });\n  for (const x of [-1.8, 1.8]) { box(ctx, 0.4, 3.1, 0.4, [x, 1.55, 11], 'white'); physics.addStaticBox({ position: [x, 1.5, 11], halfExtents: [0.22, 1.5, 0.22] }); }\n  box(ctx, 4.1, 0.6, 0.3, [0, 3.2, 11], 'cyan');\n  box(ctx, 2.8, 0.14, 0.34, [0, 3.2, 11.02], 'white');\n  const jar = place(ctx, 'sweat-jar', { at: [4, 0.06, -4] });\n  solid([4, -4], 1.1);\n  const fluid = new THREE.Mesh(new THREE.CylinderGeometry(0.96, 0.96, 1, 12), toonMaterial(PALETTE.sky));\n  fluid.position.set(4, 0.06 + 0.4, -4);\n  fluid.scale.y = 0.02;\n  ctx.scene.add(fluid);\n  place(ctx, 'lockers', { at: [-4, 0.06, -4.9], collide: true });\n  place(ctx, 'numbers-board', { at: [0, 0.06, -9.6], collide: true });\n  place(ctx, 'hammock', { at: [14.3, 0, 10] });\n  place(ctx, 'palm', { at: [12.2, 0, 10.2], yaw: 180 });\n  place(ctx, 'palm', { at: [16.4, 0, 10.4], yaw: 10 });\n  // Scenery, tall things in the -x, -z quadrant.\n  const volcano = place(ctx, 'kettlebell-volcano', { at: [-19, -0.2, -19], scale: 0.86 });\n  place(ctx, 'foam-roller-hill', { at: [18, 0, -17], yaw: 8, scale: 0.8 });\n  place(ctx, 'dumbbell-bridge', { at: [19.6, -0.1, 1.5], yaw: 90 });\n  for (const [x, z, s] of [[-17, -2, 0.9], [-16, -5, 0.6], [18.4, -12, 0.7], [-3, -14.6, 0.8], [8, 14.6, 0.7], [-14, 14, 1]]) place(ctx, 'medicine-ball', { at: [x, 0, z], scale: s, collide: true });\n  for (const [x, z, yaw, s] of [[-20, 9, 40, 1.1], [-17.5, 12.5, 200, 1], [20, 14, 100, 1.1], [-3, -15.5, 160, 1.1], [3.6, 15, 300, 1]]) place(ctx, 'palm', { at: [x, 0, z], yaw, scale: s });\n  for (const [x, z] of [[-7.6, 7.2], [7.6, 7.2], [-7.6, -7.2], [7.6, -7.2]]) place(ctx, 'lamp-post', { at: [x, 0.06, z] });\n  place(ctx, 'fountain', { at: [-5.8, 0.06, 2.6], collide: true });\n  place(ctx, 'bench', { at: [5.4, 0.06, 5.8], yaw: 180 });\n  place(ctx, 'bench', { at: [-5.4, 0.06, 5.8], yaw: 180 });\n  for (const [x, z] of [[-3, 8.2], [3, 8.2], [-16.5, 6.5], [15.6, 6.8], [7.6, 9.8], [-7.6, 9.8], [-6, -11.2], [6, -12.6]]) place(ctx, 'bush', { at: [x, 0, z], seed: Math.abs(Math.round(x * 3)) + 1 });\n  for (const [x, z] of [[-1.8, 8.4], [1.8, 8.4], [-11.5, 7.5], [11.5, 6.4], [-5.2, 12.5], [5.2, 12.8]]) place(ctx, 'flowers', { at: [x, 0, z], seed: Math.abs(Math.round(z * 3)) + 1 });\n  void pav; void jar; void volcano;\n  return { water, fluid };\n}\n\n/** A person walking small loops around the island. */\nclass Local {\n  constructor(avatar, stops, rand) { this.av = avatar; this.stops = stops; this.rand = rand; this.i = 0; this.wait = rand() * 3; this.at = new Vector3(...stops[0].at); this.walking = false; avatar.root.position.copy(this.at); this.speed = 1.6; this.frozen = false; }\n  update(dt) {\n    if (this.frozen) { this.av.update(dt); return; }\n    const stop = this.stops[this.i];\n    if (this.walking) {\n      const dx = stop.at[0] - this.at.x, dz = stop.at[2] - this.at.z;\n      const d = Math.hypot(dx, dz);\n      if (d < 0.1) { this.walking = false; this.wait = stop.wait ?? 4 + this.rand() * 3; this.av.play(stop.clip ?? 'Idle', { fade: 0.25 }); this.av.root.rotation.y = stop.yaw ?? this.av.root.rotation.y; } else {\n        this.at.x += (dx / d) * this.speed * dt; this.at.z += (dz / d) * this.speed * dt;\n        this.av.root.rotation.y = Math.atan2(dx, dz);\n      }\n    } else {\n      this.wait -= dt;\n      if (this.wait <= 0) { this.i = (this.i + 1) % this.stops.length; this.walking = true; this.av.play('Walk', { fade: 0.2 }); }\n    }\n    this.av.root.position.set(this.at.x, stop.at[1] ?? 0, this.at.z);\n    this.av.groundY = 0;\n    this.av.update(dt);\n  }\n}\n\nconst LOCAL_ROUTES = {\n  marguerite: [{ at: [-5, 0.06, 4.6], clip: 'Stretch', yaw: 1.2 }, { at: [-8, 0.06, -0.4], clip: 'Tree', yaw: 0.6 }, { at: [-6, 0.06, 6.4], clip: 'Sit', yaw: 3.1, wait: 7 }],\n  dennis: [{ at: [8, 0, 8.6], clip: 'Teeter', yaw: 0.5 }, { at: [6.2, 0, 11], clip: 'Flail', yaw: 2.1, wait: 3 }, { at: [12, 0, 7.2], clip: 'Slump', yaw: 0.3 }, { at: [8.6, 0, -1.4], clip: 'Stretch', yaw: 0.4 }],\n  june: [{ at: [6.4, 0.06, 6.4], clip: 'Sit', yaw: 3.1, wait: 8 }, { at: [3, 0.06, -6], clip: 'Heron', yaw: 0.6, wait: 6 }, { at: [8.5, 0, -7.4], clip: 'Watch', yaw: 1.2 }],\n};\n\nexport class StationScreen extends MenuScreen {\n  constructor(id, scene) {\n    const st = STATIONS[id];\n    const menu = new Menu([], { width: 420, y: 44, onBack: () => App.stack.pop(this) });\n    super('station', st.name, menu, { remark: STATION_REMARKS[id] });\n    this.id = id; this.scene = scene; this.hard = false;\n    this.refresh();\n  }\n  refresh() {\n    const slot = App.slot;\n    const st = STATIONS[this.id];\n    const items = st.activities.map((a) => {\n      const def = ACTIVITIES[a];\n      const open = isOpen(slot, a, App.dev.allUnlocked);\n      const rec = slot.records[a];\n      return {\n        label: open ? def.name : `${def.name}`, id: a, disabled: !open, focusable: true,\n        stars: open ? (rec?.stars ?? 0) : undefined,\n        right: () => (open ? (rec ? `${Math.round(rec.best)}` : '-') : `Day ${def.day}`),\n        action: () => this.scene.enterActivity(a, this.hard),\n      };\n    });\n    if (hardOpen(slot, App.dev.allUnlocked)) items.push({ label: 'Difficulty', id: 'hard', value: () => (this.hard ? 'Hard' : 'Standard'), adjust: () => { this.hard = !this.hard; }, action: () => { this.hard = !this.hard; } });\n    this.menu.setItems(items);\n  }\n}\n\nclass HammockScreen extends MenuScreen {\n  constructor(scene) {\n    const menu = new Menu([\n      { label: 'Stay up', id: 'no', action: () => App.stack.pop(this) },\n      { label: 'End the day', id: 'yes', action: () => { App.stack.pop(this); scene.endDay(); } },\n    ], { width: 220, y: 84, align: 'center', onBack: () => App.stack.pop(this) });\n    super('hammock', 'The Hammock', menu, { remark: HAMMOCK_LINES.ask });\n  }\n}\n\nexport class HubScene extends BaseScene {\n  name = 'hub';\n  id = 'hub';\n  canPause = true;\n  pauseToIsland = false;\n  nearest = null;\n  barkT = 9;\n  walkTarget = null;\n  autoEnter = null;\n  feet = new Vector3();\n  camT = new Vector3();\n  rayO = new Vector3();\n  rayD = new Vector3();\n\n  cameraConfig() { return { preset: 'iso', zoom: 1.15, minZoom: 1.15, maxZoom: 1.15 }; }\n\n  get attractMode() { return !!this.args.attract; }\n\n  async build(ctx) {\n    this.cosmetic = ctx.random.fork('cosmetic');\n    const world = buildIsland(ctx);\n    this.water = world.water;\n    this.fluid = world.fluid;\n    this.gulls = gulls(ctx, 9);\n    const rand = () => this.cosmetic.next();\n    // The hero.\n    const slot = App.slot;\n    const look = withWardrobe(slot?.look ?? { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink', headband: 'red' }, slot);\n    const model = (await ctx.loadModel(HERO_MODEL, { castShadow: false })).scene;\n    dress(model, look);\n    setLookLayer(model, 'actors');\n    ctx.scene.add(model);\n    this.model = model;\n    this.shadow = new ContactShadow(0.42);\n    ctx.scene.add(this.shadow);\n    const start = this.args.from && STATIONS[this.args.from] ? this.spawnFor(this.args.from) : [0, 0.08, 5.2];\n    this.hero = new PlatformerCharacter(ctx.physics, { position: start, lockDepth: false });\n    this.hero.attachModel(model, clipsFor(model), HERO_RIG);\n    this.input = null;\n    // Ounce, who hops after you.\n    this.ounce = new Ounce(ctx, { at: [start[0] + 1.6, 0.06, start[2] + 0.6], scale: 1.4 });\n    this.ounceRest = 0;\n    this.kevin = new Kevin(ctx, { at: [-4, 2.5, -4.9], yaw: 0.6 });\n    this.locals = {};\n    for (const who of ['marguerite', 'dennis', 'june']) {\n      const av = await makeAvatar(ctx, LOOKS[who], { at: LOCAL_ROUTES[who][0].at, clip: LOCAL_ROUTES[who][0].clip ?? 'Idle' });\n      this.locals[who] = new Local(av, LOCAL_ROUTES[who], rand);\n    }\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [-1.8, 0.06, 2.2], yaw: 0.6, clip: 'CoachStand' });\n    this.coach.addPlumb();\n    this.decals = new Decals(ctx.scene, { capacity: 200 });\n    this.footT = 0;\n    this.side = 1;\n    this.updateJar();\n    App.music('title');\n    if (!this.attractMode) this.onArrive();\n    else { this.route = ['pavilion', 'jar', 'beach', 'hall', 'gate', 'hammock', 'lagoon', 'terrace']; this.routeI = 0; this.autoRoute(); }\n  }\n\n  spawnFor(id) {\n    const st = STATIONS[id];\n    const dx = -st.at[0], dz = -st.at[1];\n    const d = Math.hypot(dx, dz) || 1;\n    return [st.at[0] + (dx / d) * (st.radius - 0.8), 0.08, st.at[1] + (dz / d) * (st.radius - 0.8)];\n  }\n\n  updateJar() {\n    const drips = App.slot?.drips ?? 40;\n    const f = Math.min(1, drips / MILESTONES[MILESTONES.length - 1].drips);\n    this.fluid.scale.y = Math.max(0.02, f * 2.1);\n    this.fluid.position.y = 0.46 + this.fluid.scale.y / 2;\n  }\n\n  /** Coming back to the island. Today's story beat plays once. */\n  onArrive() {\n    const slot = App.slot;\n    if (!slot) return;\n    if (slot.week === 1 && slot.heardBeat < slot.day) {\n      const lines = dayData(slot).beat;\n      slot.heardBeat = slot.day;\n      App.store.write();\n      if (lines.length) this.playBeat(lines);\n    } else if (slot.week === 2 && slot.day === 1 && !slot.week2Said) {\n      slot.week2Said = true;\n      App.store.write();\n      App.stack.push(new DialogueScreen(WEEK2_LINES));\n    }\n    if (slot.week === 1 && slot.day === 7 && !goalMet(slot)) App.say('coach', 'Stand on the terrace, when you are ready.');\n  }\n\n  /** Stage whoever is speaking near the hero. */\n  playBeat(lines) {\n    const hero = this.hero.feetInto(this.feet);\n    const staged = lines.map((l) => (typeof l === 'string' ? { who: l.split(':')[0], text: l.slice(l.indexOf(':') + 2) } : { ...l }));\n    for (const l of staged) {\n      if (typeof l.run === 'string') { const name = l.run; l.run = () => this.beatAction(name); }\n      else if (l.who && this.locals[l.who]) {\n        const who = l.who;\n        l.run = () => this.bring(who);\n      } else if (l.who === 'coach') l.run = () => this.coachNear();\n    }\n    void hero;\n    App.stack.push(new DialogueScreen(staged, { onDone: () => this.afterBeat() }));\n  }\n\n  bring(who) {\n    const f = this.hero.feetInto(this.feet);\n    const l = this.locals[who];\n    l.frozen = true;\n    l.at.set(f.x - 1.8, 0.06, f.z + 0.3);\n    l.av.root.position.copy(l.at);\n    l.av.root.rotation.y = 1.2;\n    l.av.play('Idle', { fade: 0.1 });\n  }\n\n  coachNear() {\n    const f = this.hero.feetInto(this.feet);\n    this.coach.root.position.set(f.x - 1.4, 0.06, f.z - 0.4);\n    this.coach.root.rotation.y = 1.0;\n  }\n\n  afterBeat() { for (const l of Object.values(this.locals)) l.frozen = false; }\n\n  beatAction(name) {\n    const o = this.ounce.root.position;\n    switch (name) {\n      case 'plumb': { this.coach.root.position.set(o.x - 1.1, 0.06, o.z + 0.2); this.coach.root.rotation.y = 1.2; this.coach.play('Point', { fade: 0.2 }); this.ounce.setMood('concern'); break; }\n      case 'kevinSits': { this.kevin.flyTo(o.x, o.y + 1.5, o.z, 0.9); this.seven = false; break; }\n      case 'dialSeven': { this.seven = true; this.ounce.read(0.7); break; }\n      case 'kevinLeaves': { this.kevin.flyTo(-4, 2.5, -4.9, 1.2); this.seven = false; this.ounce.read(null); break; }\n      case 'ounceHides': { this.ounce.hopTo(4, -5.8, 0.5); break; }\n      case 'ounceBack': { const f = this.hero.feetInto(this.feet); this.ounce.hopTo(f.x + 1.4, f.z + 0.4, 0.5); break; }\n      default: break;\n    }\n  }\n\n  onFixed(ctx, dt) {\n    if (App.stack.open || App.loading) {\n      const inp = this.input ??= readMoveInput(ctx, this.hero, this.input);\n      inp.move.set(0, 0, 0); inp.jump = false; inp.jumpHeld = false;\n      inp.wave = false; inp.sit = false; inp.crouch = false; inp.crouchPressed = false; inp.prone = false; inp.lie = false; inp.attack = false; inp.grab = false;\n      this.hero.fixedUpdate(dt, inp);\n      return;\n    }\n    this.input = readMoveInput(ctx, this.hero, this.input);\n    const inp = this.input;\n    const { input } = ctx;\n    if (input.padAxis && (input.padAxis.x || input.padAxis.y)) this.walkTarget = null;\n    // Pad buttons are remapped at boot, so OR them in.\n    if (this.nearest) { inp.jump = false; inp.jumpHeld = false; input.clearQueued('Space'); } else {\n      if (input.consumePress('PadCross')) { inp.jump = true; this.justJumped = true; }\n      if (input.isDown('PadCross')) inp.jumpHeld = true;\n    }\n    if (inp.jump && !this.nearest) this.justJumped = true;\n    if (input.consumeAny(WAVE)) { inp.wave = true; this.justWaved = true; }\n    if (input.consumeAny(SIT)) { inp.sit = true; this.justSat = true; }\n    if (this.walkTarget) this.steer(inp);\n    if (this.attractMode) this.attractSteer(inp);\n    this.hero.fixedUpdate(dt, inp);\n    this.hero.feetInto(this.feet);\n    this.updateNearest();\n    this.footsteps(dt);\n    this.followOunce(dt);\n  }\n\n  steer(inp) {\n    const f = this.hero.feetInto(this.feet);\n    const dx = this.walkTarget.x - f.x, dz = this.walkTarget.z - f.z;\n    const d = Math.hypot(dx, dz);\n    if (d < 0.5) {\n      this.walkTarget = null;\n      inp.move.set(0, 0, 0);\n      if (this.autoEnter && this.nearest === this.autoEnter) { const id = this.autoEnter; this.autoEnter = null; this.activate(id); }\n      return;\n    }\n    inp.move.set(dx / d, 0, dz / d);\n    if (this.autoEnter && this.nearest === this.autoEnter) { const id = this.autoEnter; this.autoEnter = null; this.walkTarget = null; inp.move.set(0, 0, 0); this.activate(id); }\n  }\n\n  attractSteer(inp) {\n    const f = this.hero.feetInto(this.feet);\n    const st = STATIONS[this.route[this.routeI]];\n    const dx = st.at[0] - f.x, dz = st.at[1] - f.z;\n    const d = Math.hypot(dx, dz);\n    if (d < st.radius) { this.routeI = (this.routeI + 1) % this.route.length; return; }\n    inp.move.set(dx / d, 0, dz / d);\n  }\n\n  autoRoute() {}\n\n  updateNearest() {\n    if (this.attractMode) { this.nearest = null; return; }\n    const f = this.feet;\n    let best = null, bestD = Infinity;\n    const slot = App.slot;\n    for (const id of STATION_IDS) {\n      const st = STATIONS[id];\n      if (st.unlockDay && slot && !isUnlockedDay(slot, st.unlockDay)) continue;\n      const d = Math.hypot(f.x - st.at[0], f.z - st.at[1]);\n      if (d < st.radius && d < bestD) { best = id; bestD = d; }\n    }\n    this.nearest = best;\n  }\n\n  footsteps(dt) {\n    const f = this.feet;\n    this.footT += dt * this.hero.speed;\n    if (this.footT > 1.1 && this.hero.grounded) {\n      this.footT = 0;\n      this.side = -this.side;\n      const onSand = Math.abs(f.x) > 16 || Math.abs(f.z) > 14 || (f.z < -4 && Math.abs(f.x) > 6);\n      if (onSand) this.decals.add('footprint', { x: f.x + this.side * 0.12, y: 0.01, z: f.z }, { x: 0, y: 1, z: 0 }, { size: 0.5 });\n    }\n  }\n\n  followOunce(dt) {\n    const o = this.ounce.root.position;\n    this.ounceRest -= dt;\n    const dx = this.feet.x - o.x, dz = this.feet.z - o.z;\n    const d = Math.hypot(dx, dz);\n    if (!this.ounce.hopping && this.ounceRest <= 0 && d > 2.3 && !this.ounceHiding) {\n      const step = Math.min(1.5, d - 1.5);\n      this.ounce.hopTo(o.x + (dx / d) * step, o.z + (dz / d) * step, 0.3);\n      this.ounceRest = 0.12;\n    }\n    if (!this.ounce.hopping) this.ounce.face2(this.feet.x, this.feet.z);\n  }\n\n  onInput(ctx, dt) {\n    const { input } = ctx;\n    const dev = App.device;\n    this.hoverStation = null;\n    // The mouse: hover names a station, a click walks there; ground just walks.\n    if (dev.last === 'mouse') {\n      const hit = this.groundAtPointer(ctx);\n      if (hit) {\n        for (const id of STATION_IDS) {\n          const st = STATIONS[id];\n          if (Math.hypot(hit.x - st.at[0], hit.z - st.at[1]) < st.radius * 0.85) { this.hoverStation = id; break; }\n        }\n        if (input.wasPressed('MouseLeft')) {\n          this.walkTarget = { x: hit.x, z: hit.z };\n          this.autoEnter = this.hoverStation;\n          if (this.hoverStation) { const st = STATIONS[this.hoverStation]; this.walkTarget = { x: st.at[0], z: st.at[1] }; }\n          if (this.hoverStation && this.nearest === this.hoverStation) { this.autoEnter = null; this.walkTarget = null; this.activate(this.hoverStation); return; }\n        }\n      }\n    }\n    if (this.nearest && input.wasPressed(...CONFIRM)) this.activate(this.nearest);\n    void dt;\n  }\n\n  groundAtPointer(ctx) {\n    const p = ctx.input.pointer;\n    ctx.camera.rayAt(p.x, p.y, this.rayO, this.rayD);\n    if (Math.abs(this.rayD.y) < 1e-4) return null;\n    const hitPhys = ctx.physics.castRay(this.rayO, this.rayD, 200);\n    const t = hitPhys ? hitPhys.distance : -this.rayO.y / this.rayD.y;\n    const out = this.rayO.clone().addScaledVector(this.rayD, t);\n    return out;\n  }\n\n  activate(id) {\n    const st = STATIONS[id];\n    App.sfx('menuConfirm');\n    switch (st.kind) {\n      case 'menu': App.stack.push(new StationScreen(id, this)); break;\n      case 'scene': App.go(st.scene, { from: id }); break;\n      case 'hammock': this.hammock(); break;\n      case 'terrace': this.terrace(); break;\n      default: break;\n    }\n  }\n\n  terrace() {\n    const slot = App.slot;\n    if (slot.week === 1 && slot.day === 7 && !goalMet(slot)) { App.go('activity', { id: 'stand', mode: 'week' }); return; }\n    App.stack.push(new DialogueScreen([{ who: 'ounce', text: this.terraceLine(), mood: 'smug' }]));\n  }\n\n  terraceLine() {\n    const slot = App.slot;\n    const goal = goalOf(slot);\n    return goalMet(slot) ? 'You have done what Coach asked. Everything after that is vanity.' : `Coach has asked for: ${goal.text} I would do it. She knows where you live. You live here.`;\n  }\n\n  hammock() {\n    const slot = App.slot;\n    if (slot.week === 1 && slot.day === 7 && !goalMet(slot)) {\n      App.stack.push(new DialogueScreen([{ who: 'ounce', text: 'Not today. Today you stand. Then you may lie down for as long as you like.', mood: 'concern' }]));\n      return;\n    }\n    if (!slot.todayDone.length) { App.stack.push(new HammockScreen(this)); return; }\n    if (!goalMet(slot)) { App.stack.push(new DialogueScreen([{ who: 'ounce', text: HAMMOCK_LINES.early, mood: 'droop' }], { onDone: () => this.endDay() })); return; }\n    App.stack.push(new DialogueScreen([{ who: 'ounce', text: HAMMOCK_LINES.fine, mood: 'pleased' }], { onDone: () => this.endDay() }));\n  }\n\n  endDay() {\n    const slot = App.slot;\n    slot.phase = 'report';\n    App.store.write();\n    App.go('report');\n  }\n\n  enterActivity(id, hard) { App.go('activity', { id, mode: 'week', hard }); }\n\n  onUpdate(ctx, dt) {\n    this.hero.updateVisual(this.model, dt, ctx.physics.alpha);\n    const p = this.model.position;\n    this.shadow.place(p.x, 0.07, p.z, Math.max(0, p.y - 0.07));\n    this.ounce.update(dt);\n    this.kevin.update(dt);\n    if (this.seven && this.kevin.state !== 'fly') this.kevin.root.position.set(this.ounce.root.position.x, this.ounce.root.position.y + 1.5, this.ounce.root.position.z);\n    this.coach.update(dt);\n    for (const l of Object.values(this.locals)) l.update(dt);\n    this.gulls.update(dt, this.t);\n    this.water?.update(ctx.time);\n    this.decals.update(dt);\n    if (!App.stack.open && !this.attractMode) this.islandBarks(dt);\n    if (this.justJumped) { this.justJumped = false; this.barkOnce('jump'); }\n    if (this.justWaved) { this.justWaved = false; this.barkOnce('wave'); }\n    if (this.justSat) { this.justSat = false; this.barkOnce('sit'); }\n  }\n\n  barkOnce(kind) {\n    if (this.barkT > 4) return;\n    App.say('ounce', this.cosmetic.pick(IDLE_BARKS[kind]));\n    this.barkT = 6;\n  }\n\n  islandBarks(dt) {\n    this.barkT -= dt;\n    if (this.barkT <= 0 && !this.bark.active) {\n      this.barkT = 16 + this.cosmetic.next() * 14;\n      App.say('ounce', this.cosmetic.pick(ISLAND_BARKS));\n    }\n  }\n\n  onDraw(ctx) {\n    if (this.attractMode) return;\n    const { hud } = ctx;\n    const slot = App.slot;\n    if (slot) {\n      const dayText = slot.week > 1 ? `Week ${slot.week}, day ${slot.day}` : `Day ${slot.day}`;\n      hud.rect(SAFE - 3, 6, textWidth(dayText, 2) + 6, 20, 'navy');\n      say(hud, SAFE, 8, dayText, { scale: 2, name: 'day' });\n      const goal = goalOf(slot);\n      const met = goalMet(slot);\n      const rows = wrap(`Coach: ${goal.text}${met ? ' Done.' : ''}`, charsIn(Math.min(hud.width - 120, 220)));\n      rows.forEach((r, i) => { hud.rect(SAFE - 3, 28 + i * 11, textWidth(r) + 6, 11, 'navy'); say(hud, SAFE, 29 + i * 11, r, { color: met ? 'lime' : 'sand', name: 'prescription' }); });\n      const drips = `${slot.drips} Drips`;\n      const dx = hud.width - SAFE;\n      const hasPauseIcon = !!this.pauseIconHit;\n      const right = hasPauseIcon ? dx - 16 : dx;\n      hud.rect(right - textWidth(drips, 2) - 3, 6, textWidth(drips, 2) + 6, 20, 'navy');\n      sayRight(hud, right, 8, drips, { scale: 2, color: 'cyan', name: 'drips' });\n    }\n    if (this.seven) {\n      const p = this.projected(ctx, this.ounce.root.position, 1.9);\n      hud.rect(p.x - 13, p.y - 16, 26, 22, 'white');\n      say(hud, p.x - 5, p.y - 14, '7', { scale: 2, color: 'red', shadow: false, name: 'dial-seven' });\n    }\n    if (App.stack.open) return;\n    // Prompts, bottom.\n    const list = [];\n    if (this.nearest) {\n      const st = STATIONS[this.nearest];\n      const label = this.nearest === 'terrace' && slot && slot.week === 1 && slot.day === 7 && !goalMet(slot) ? 'Stand' : `${st.verb}: ${st.name}`;\n      list.push(['confirm', label]);\n    } else {\n      if (App.device.last === 'mouse') list.push(['confirm', 'Click to walk']);\n      else list.push(['lean', 'Walk'], ['jump', 'Jump'], ['wave', 'Wave'], ['sit', 'Sit']);\n    }\n    list.push(['pause', 'Pause']);\n    if (!this.bark.active) promptBar(hud, App.device, list);\n    if (this.hoverStation && !this.nearest) {\n      const st = STATIONS[this.hoverStation];\n      const p = this.projected(ctx, new Vector3(st.at[0], 0, st.at[1]), 3);\n      const w = textWidth(st.name) + 8;\n      const x = Math.max(4, Math.min(hud.width - w - 4, Math.round(p.x - w / 2)));\n      const y = Math.max(44, Math.round(p.y) - 8);\n      hud.rect(x, y, w, 12, 'cyan');\n      say(hud, x + 4, y + 2, st.name, { color: 'ink', shadow: false, name: 'hover' });\n    }\n    void drawPrompt;\n  }\n\n  projected(ctx, v, up = 0) {\n    const out = new Vector3(v.x, v.y + up, v.z).project(ctx.camera.camera);\n    return { x: (out.x + 1) * 0.5 * ctx.hud.width, y: (1 - out.y) * 0.5 * ctx.hud.height };\n  }\n\n  cameraTarget() {\n    const p = this.model?.position;\n    return p ? this.camT.set(p.x, p.y + 0.9, p.z) : this.camT.set(0, 1, 5);\n  }\n\n  status() {\n    const s = App.slot;\n    return `hub | day ${s?.day ?? '-'} | near ${this.nearest ?? '-'} | drips ${s?.drips ?? 0} | hero ${this.feet.x.toFixed(1)},${this.feet.z.toFixed(1)}`;\n  }\n\n  fingerprint() { return `${this.feet.x.toFixed(4)},${this.feet.z.toFixed(4)}`; }\n\n  /** Tests and Dev Tools: stand at a station. */\n  stand(id) {\n    const st = STATIONS[id];\n    const s = this.spawnFor(id);\n    this.hero.teleport(s);\n    this.hero.feetInto(this.feet);\n    this.feet.x = s[0]; this.feet.z = s[2];\n    void st;\n    this.updateNearest();\n    return this.nearest;\n  }\n\n  dispose() { this.decals?.dispose?.(); }\n}\n\nfunction isUnlockedDay(slot, day) { return slot.week > 1 || slot.day >= day || slot.unlockedAll || App.dev.allUnlocked; }\nEOF\ncat > src/scenes/weighin.js <<'EOF'\n// The Morning Weigh-In: balance test, one absurd question, today's Wobble Age.\nimport { App } from '../app.js';\nimport { CONFIRM } from '../core/actions.js';\nimport { Dot } from '../core/dot.js';\nimport { BotBrain, LocalDriver, blankInput } from '../core/drivers.js';\nimport { T } from '../core/tunables.js';\nimport { recordWeighIn, dayData, totalStarsOf } from '../core/week.js';\nimport { Ounce } from '../art/props.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { AGE_LINES, INTRO_LINES, MORNINGS, OW_JOKE, OW_LINES } from '../data/lines.js';\nimport { AGE_QUESTION, QUESTIONS } from '../data/questions.js';\nimport { TESTS } from '../data/week.js';\nimport { DialogueScreen } from '../ui/dialogue.js';\nimport { say, sayCentered, wrap, charsIn } from '../ui/font.js';\nimport { Menu } from '../ui/menu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { MenuScreen } from '../ui/screens/common.js';\nimport { bar, drawDial, panel } from '../ui/widgets.js';\nimport { BaseScene } from './base.js';\nimport { plazaSet } from './sets.js';\nimport { withWardrobe } from './activity/lanes.js';\n\nexport const TEST_SECONDS = { stillness: 14, lean: 15, chase: 13 };\nconst LEAN_TARGETS = [{ x: -0.7, y: 0, label: '70% left' }, { x: 0.5, y: 0, label: '50% right' }, { x: 0, y: 0.6, label: 'Lean forward' }];\nconst HOLD_NEEDED = 1.5;\nconst RING = 0.3;\n\nexport function testT(kind, st) {\n  switch (kind) {\n    case 'stillness': return st.n ? st.in / st.n : 0;\n    case 'lean': {\n      const part = st.targetsDone / LEAN_TARGETS.length;\n      const quick = st.targetsDone === LEAN_TARGETS.length ? Math.max(0, 1 - (st.doneAt - 6) / 9) : 0;\n      return Math.max(0, Math.min(1, part * 0.6 + quick * 0.4));\n    }\n    case 'chase': return Math.max(0, Math.min(1, 1 - (st.n ? st.dist / st.n : 1) * 2));\n    default: return 0;\n  }\n}\n\nexport class WeighInScene extends BaseScene {\n  name = 'weighin';\n  id = 'weighin';\n  canPause = true;\n  pauseToTitle = true;\n  phase = 'greet';\n  testT = 0;\n  inp = blankInput();\n  driver = new LocalDriver();\n\n  cameraConfig() { return { preset: 'fixed', position: [1.2, 2.5, 6.2], target: [1.2, 1.25, 0], fov: 30 }; }\n\n  get test() { return this.args.test ?? dayData(App.slot).test; }\n\n  async build(ctx) {\n    plazaSet(ctx, 9);\n    const slot = App.slot;\n    this.rng = ctx.random.fork('test');\n    this.ounce = new Ounce(ctx, { at: [0, 0.04, 0], scale: 2 });\n    this.avatar = await makeAvatar(ctx, withWardrobe(slot.look, slot), { at: [0.1, 0, 2.2], yaw: 3.1, clip: 'Walk' });\n    this.dot = new Dot(() => this.rng.next());\n    this.st = { in: 0, n: 0, dist: 0, targetsDone: 0, holdT: 0, doneAt: 15 };\n    this.groupT = 0;\n    App.music('title');\n    this.step('walkOn');\n    this.ownStep = 0;\n    this.feelAge = 34;\n    if (slot.week > 1) this.test2 = TESTS[(slot.day + slot.week) % TESTS.length];\n  }\n\n  step(phase) { this.phase = phase; this.phaseT = 0; }\n\n  get auto() { return App.dev.autopilot; }\n\n  /** Lines, then what comes next. */\n  talk(lines, then) { App.stack.push(new DialogueScreen(lines, { onDone: then })); }\n\n  greet() {\n    const slot = App.slot;\n    const first = slot.day === 1 && slot.week === 1 && !slot.introHeard;\n    if (first) {\n      slot.introHeard = true;\n      App.store.write();\n      this.talk(INTRO_LINES, () => this.startTest());\n      return;\n    }\n    const ow = OW_LINES[(slot.day + slot.week * 3) % OW_LINES.length];\n    const morning = MORNINGS[(slot.day - 1) % MORNINGS.length];\n    const lines = [{ who: 'ounce', text: ow, mood: 'alarm' }];\n    if (slot.day === 2 && slot.week === 1) lines.push({ who: 'ounce', text: OW_JOKE, mood: 'smug' });\n    lines.push({ who: 'ounce', text: morning, mood: 'neutral' });\n    this.talk(lines, () => this.startTest());\n  }\n\n  startTest() {\n    this.step('test');\n    this.testT = 0;\n    this.dot.reset();\n    this.st = { in: 0, n: 0, dist: 0, targetsDone: 0, holdT: 0, doneAt: TEST_SECONDS[this.kind()] };\n    this.ounce.read(0);\n    App.sfx('menuConfirm');\n  }\n\n  kind() { return this.test2 ?? this.test; }\n\n  chaseTarget(t) { return { x: 0.6 * Math.sin(0.7 * t), y: 0.42 * Math.sin(1.1 * t + 1) }; }\n  targetNow() {\n    const k = this.kind();\n    if (k === 'lean') return LEAN_TARGETS[Math.min(this.st.targetsDone, LEAN_TARGETS.length - 1)];\n    if (k === 'chase') return this.chaseTarget(this.testT);\n    return { x: 0, y: 0 };\n  }\n\n  onFixed(ctx, dt) {\n    this.phaseT += dt;\n    if (this.phase === 'walkOn') {\n      if (this.phaseT > 1) { this.avatar.play('StepOn', { once: true, fade: 0.1 }); App.sfx('ow'); this.step('settle'); this.onScale = true; }\n      return;\n    }\n    if (this.phase === 'settle') {\n      if (this.phaseT > 0.7) { this.step('talking'); this.greet(); }\n      return;\n    }\n    if (this.phase !== 'test') return;\n    this.testT += dt;\n    const kind = this.kind();\n    const target = this.targetNow();\n    const inp = this.inp;\n    const auto = this.auto;\n    if (auto) {\n      if (!this.brain || this.brain.skill !== auto) this.brain = new BotBrain(auto, () => this.rng.next());\n      this.brain.lean(inp, this.dot, target.x, target.y, dt);\n    } else this.driver.read(inp, ctx, dt, App, this.dialPos);\n    this.dot.step(dt, inp.x, inp.y, T, { noise: App.noiseScale() });\n    const st = this.st;\n    const inside = Math.hypot(this.dot.x - target.x, this.dot.y - target.y) <= App.ringOf(kind === 'stillness' ? RING : 0.1);\n    if (kind === 'stillness') { st.n++; if (inside) st.in++; } else if (kind === 'chase') { st.n++; st.dist += Math.hypot(this.dot.x - target.x, this.dot.y - target.y); } else if (kind === 'lean' && st.targetsDone < LEAN_TARGETS.length) {\n      st.holdT = inside ? st.holdT + dt : Math.max(0, st.holdT - dt * 0.5);\n      if (st.holdT >= HOLD_NEEDED) {\n        st.targetsDone++; st.holdT = 0; App.sfx('ringIn');\n        if (st.targetsDone === LEAN_TARGETS.length) st.doneAt = this.testT;\n      }\n    }\n    if (inside && !this.wasInside) App.sfx('needleTick');\n    this.wasInside = inside;\n    this.ounce.read((this.dot.x + this.dot.y * 0.4) * 0.9);\n    const over = this.testT >= TEST_SECONDS[kind] || (kind === 'lean' && st.targetsDone === LEAN_TARGETS.length);\n    if (over) this.endTest();\n  }\n\n  endTest() {\n    this.score = testT(this.kind(), this.st);\n    this.ounce.read(null);\n    this.step('question');\n    App.stack.push(new QuestionScreen(this));\n  }\n\n  /** After the question: the Day 1 joke, then the reveal. */\n  reveal() {\n    const slot = App.slot;\n    const r = recordWeighIn(slot, this.score);\n    this.result = r;\n    App.store.write();\n    this.step('reveal');\n    this.rollT = 0;\n    this.ounce.setMood('spin');\n    App.music(null);\n    this.ticker = 0;\n  }\n\n  remark() {\n    const r = this.result;\n    const slot = App.slot;\n    let list = AGE_LINES.same;\n    if (r.previous === null) list = AGE_LINES.first;\n    else if (r.shown > r.previous) list = AGE_LINES.worse;\n    else if (r.shown < r.previous) list = AGE_LINES.better;\n    let text = list[(slot.day + slot.week) % list.length].replace('%A', String(r.shown));\n    const lines = [{ who: 'ounce', text, mood: r.previous !== null && r.shown < r.previous ? 'pleased' : 'concern' }];\n    if (this.feel !== undefined) lines.push({ who: 'ounce', text: AGE_LINES.feel[0].replace('%A', String(r.shown)).replace('%F', String(this.feel)), mood: 'droop' });\n    return lines;\n  }\n\n  finishReveal() {\n    const slot = App.slot;\n    slot.phase = 'day';\n    App.store.write();\n    App.go('hub', { from: 'terrace' });\n  }\n\n  onUpdate(ctx, dt) {\n    this.ounce.update(dt);\n    const a = this.avatar;\n    if (this.phase === 'walkOn') {\n      a.root.position.z = 2.2 - Math.min(1, this.phaseT) * 1.4;\n    } else if (this.onScale) {\n      const u = Math.min(1, this.phaseT / 0.5);\n      if (this.phase === 'settle') { a.root.position.y = 0.58 * u; a.root.position.z = 0.8 - 1.24 * u; a.root.rotation.y = 3.1 * (1 - u); if (u >= 1) a.play('Idle'); } else { a.root.position.set(0.1, 0.58, -0.44); a.root.rotation.y = 0; a.groundY = 0.58; }\n    }\n    a.update(dt);\n    if (this.phase === 'test') a.lean(this.dot.x, this.dot.y, 0, this.t);\n    if (this.phase === 'reveal') {\n      this.rollT += dt;\n      this.ticker -= dt;\n      const spin = this.rollT < 2.2;\n      if (spin && this.ticker <= 0) { this.ticker = 0.05; App.sfx('needleTick', { pitch: this.rollT * 2 }); }\n      if (!spin && !this.revealed) {\n        this.revealed = true;\n        this.ounce.setMood('neutral');\n        App.sfx('fanfareSoft');\n        this.talk(this.remark(), () => this.finishReveal());\n      }\n    }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const dx = Math.round(hud.width * 0.27);\n    const dy = Math.round(hud.height * 0.42);\n    const r = Math.min(62, Math.round(hud.height * 0.23));\n    if (this.phase === 'test') {\n      const kind = this.kind();\n      this.dialPos = { x: dx, y: dy };\n      const target = kind === 'stillness' ? null : this.targetNow();\n      const fade = kind === 'stillness' && this.testT > 3 ? 0 : 1;\n      const mouse = App.device.last === 'mouse' && !this.auto ? App.device.pointerArt(ctx) : null;\n      drawDial(hud, { x: dx, y: dy, r, dot: this.dot, ringR: App.ringOf(kind === 'stillness' ? RING : 0.1), ringX: target?.x ?? 0, ringY: target?.y ?? 0, inside: this.wasInside, fade, target: kind === 'chase' ? target : null, mouse, hideDot: fade === 0 });\n      const label = kind === 'stillness' ? (this.testT > 3 ? 'Eyes closed.' : 'Stand still. Then, eyes closed.') : kind === 'lean' ? this.targetNow().label : 'Follow the orange dot.';\n      const w = Math.min(hud.width - 24, label.length * 6 + 12);\n      hud.rect(Math.round(hud.width / 2 - w / 2), 8, w, 14, 'navy');\n      sayCentered(hud, hud.width / 2, 10, label, { color: 'sand', name: 'test-label' });\n      bar(hud, dx - r, dy + r + 8, r * 2, 6, 1 - this.testT / TEST_SECONDS[kind], 'cyan');\n      if (kind === 'lean') bar(hud, dx - r, dy + r + 16, r * 2, 6, this.st.holdT / HOLD_NEEDED, 'lime');\n      promptBar(hud, App.device, [['lean', 'Lean'], ['pause', 'Pause']]);\n    }\n    if (this.phase === 'reveal') {\n      const u = Math.min(1, this.rollT / 2.2);\n      const shown = this.result.shown;\n      const roll = u >= 1 ? shown : Math.floor(((Math.sin(this.rollT * 41) + 1) / 2) * 80) + 18;\n      panel(hud, dx - 56, dy - 40, 112, 80, { fill: 'white', name: 'age-panel' });\n      sayCentered(hud, dx, dy - 34, 'Wobble Age', { color: 'teal', shadow: false, name: 'age-title' });\n      sayCentered(hud, dx, dy - 14, String(roll), { scale: 5, color: 'red', shadow: false, name: 'age' });\n    }\n  }\n\n  overlayDot() { return `${this.dot.x.toFixed(2)},${this.dot.y.toFixed(2)}`; }\n  status() { return `weighin | ${this.phase} | test ${this.kind()} | t ${this.testT.toFixed(1)}${this.score !== undefined ? ` | T ${this.score.toFixed(2)}` : ''}`; }\n  fingerprint() { return `${this.dot.x.toFixed(5)},${this.dot.y.toFixed(5)}`; }\n}\n\nclass QuestionScreen {\n  name = 'question';\n  constructor(scene) {\n    this.scene = scene;\n    const slot = App.slot;\n    this.q = QUESTIONS[slot.week === 1 ? slot.day - 1 : (slot.day - 1) % (QUESTIONS.length - 1)];\n    this.firstDay = slot.day === 1 && slot.week === 1;\n    this.syl = null;\n    this.menu = new Menu(this.q.a.map((a, i) => ({ label: a, id: `a${i}`, action: () => this.answer(i) })), { scale: 1, rowH: 18, width: 320, y: 0, align: 'center' });\n    App.say('ounce', this.q.q);\n  }\n  answer(i) {\n    App.stack.pop(this);\n    App.slot.answers = (App.slot.answers ?? 0) + 1;\n    const after = [{ who: 'ounce', text: this.q.r[i], mood: 'smug' }, { who: 'ounce', text: 'Thank you. I have written that down.', mood: 'neutral' }];\n    App.stack.push(new DialogueScreen(after, { onDone: () => {\n      if (this.firstDay) App.stack.push(new FeelScreen(this.scene));\n      else this.scene.reveal();\n    } }));\n  }\n  update(ctx, dt) { this.menu.update(ctx, dt); }\n  draw(ctx) {\n    const { hud } = ctx;\n    const w = Math.min(hud.width - 24, 330);\n    const x = Math.round((hud.width - w) / 2);\n    const lines = wrap(this.q.q, charsIn(w - 20));\n    panel(hud, x, 20, w, lines.length * 11 + 12, { fill: 'white', name: 'question' });\n    lines.forEach((l, i) => sayCentered(hud, hud.width / 2, 26 + i * 11, l, { color: 'ink', shadow: false, name: 'question-text' }));\n    this.menu.o.y = 24 + lines.length * 11 + 12;\n    this.menu.draw(ctx);\n    promptBar(hud, App.device, [['confirm', 'Answer']]);\n  }\n}\n\n/** \"How old do you feel? This is not binding.\" Used once, in the joke, and never saved. */\nclass FeelScreen {\n  name = 'feel';\n  value = 34;\n  constructor(scene) {\n    this.scene = scene;\n    App.say('ounce', AGE_QUESTION);\n    this.menu = new Menu([{ label: 'How old do you feel?', id: 'age', value: () => `${this.value}`, adjust: (d) => { this.value = Math.max(1, Math.min(120, this.value + d)); }, action: () => this.done() }], { width: 320, y: 80 });\n  }\n  done() { this.scene.feel = this.value; App.stack.pop(this); this.scene.reveal(); }\n  update(ctx, dt) { this.menu.update(ctx, dt); if (ctx.input.wheel) this.value = Math.max(1, Math.min(120, this.value - Math.sign(ctx.input.wheel))); }\n  draw(ctx) {\n    this.menu.draw(ctx);\n    promptBar(ctx.hud, App.device, [['adjust', 'Change'], ['confirm', 'That\\'s it']]);\n  }\n}\n\nexport { CONFIRM, MenuScreen, say, totalStarsOf };\nEOF\necho ok","description":"Write the island hub and the Weigh-In scenes","timeout":30000}}}
