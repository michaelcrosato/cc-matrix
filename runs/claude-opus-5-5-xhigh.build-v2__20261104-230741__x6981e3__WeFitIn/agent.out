{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjMyrqYLNLKhTR92qUGi","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01M3xZAKhnZ1iM2mjoLiZzru","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > tests/browser/game.mjs <<'EOF'\n// 14 boot, 15 devices and prompts, 17 Family Hour, 18 audio, on the built html via file://.\nimport { assert, done, eq, test } from '../lib-pure.mjs';\nimport { bootPage, FILE_URL, launch, PAD_INIT } from './_lib.mjs';\n\nconst browser = await launch();\nconst errors = [];\nasync function page(opts = {}) {\n  const ctx = await browser.newContext({ viewport: { width: 1280, height: 720 }, ...opts });\n  const p = await ctx.newPage();\n  p.on('pageerror', (e) => errors.push(`pageerror: ${e.message}`));\n  p.on('console', (m) => { if (m.type() === 'error') errors.push(`console: ${m.text()}`); });\n  return p;\n}\nconst state = (p) => p.evaluate(() => window.__GAME__.state());\nconst frames = (p, n = 30) => p.waitForFunction(([start, want]) => window.__PIXEL_ENGINE__.frame >= start + want, [0, 0]).then(async () => {\n  const start = await p.evaluate(() => window.__PIXEL_ENGINE__.frame);\n  await p.waitForFunction(([s, w]) => window.__PIXEL_ENGINE__.frame >= s + w, [start, n], { timeout: 60000 });\n});\nconst SETTLE = () => !window.__GAME__.loading;\nasync function go(p, id, args = {}) {\n  await p.evaluate(([i, a]) => window.__GAME__.go(i, a), [id, args]);\n  await p.waitForFunction(SETTLE, null, { timeout: 60000 });\n}\n\nawait test('14 boots on WebGPU with no errors, title visible, music exactly 0.10 on first run', async () => {\n  const p = await page();\n  await bootPage(p);\n  const s = await p.evaluate(() => {\n    const e = window.__PIXEL_ENGINE__;\n    return { backend: e.state().backend, ok: e.state().errors.length, music: window.__GAME__.engine.audio.volume.music, scene: window.__GAME__.state().scene, active: !!window.AIHub?.active, gpu: e.state().gpuErrors.length };\n  });\n  eq(s.backend, 'webgpu');\n  eq(s.ok, 0);\n  eq(s.gpu, 0);\n  eq(s.music, 0.1);\n  eq(s.scene, 'title');\n  await frames(p, 20);\n  const seen = await p.evaluate(() => {\n    const c = window.__PIXEL_ENGINE__.hud.canvas;\n    const d = c.getContext('2d').getImageData(0, 0, c.width, c.height).data;\n    let n = 0;\n    for (let i = 3; i < d.length; i += 4) if (d[i]) n++;\n    return n;\n  });\n  assert(seen > 500, `HUD pixels: ${seen}`);\n  eq(errors.length, 0, errors.join(' | '));\n  await p.context().close();\n});\n\nawait test('14 the engine\\'s stored volume can\\'t move ours: music is 0.10 at every boot', async () => {\n  const p = await page();\n  await p.addInitScript(() => localStorage.setItem('pixel-engine:audio', JSON.stringify({ master: 0.8, sfx: 1, music: 0.9, muted: false })));\n  await bootPage(p);\n  eq(await p.evaluate(() => window.__GAME__.engine.audio.volume.music), 0.1);\n  await p.context().close();\n});\n\nawait test('15 pad stub: Cross confirms, PlayStation glyphs, Settings gives Xbox, keys give keycaps, mouse gives mouse prompts, hover and click', async () => {\n  const p = await page();\n  await p.addInitScript(PAD_INIT);\n  await bootPage(p);\n  await frames(p, 5);\n  const press = async (i) => { await p.evaluate((b) => { window.__pads[0].buttons[b].pressed = true; window.__pads[0].buttons[b].value = 1; }, i); await frames(p, 4); await p.evaluate((b) => { window.__pads[0].buttons[b].pressed = false; window.__pads[0].buttons[b].value = 0; }, i); await frames(p, 4); };\n  await press(0);\n  let s = await state(p);\n  eq(s.stack.join(), 'main', 'Cross opened the menu');\n  eq(s.device, 'pad');\n  eq(s.column, 'ps');\n  assert(s.prompts.some((x) => x.startsWith('ps:cross')), `prompts ${s.prompts}`);\n  // The option in Settings swaps the glyphs.\n  await p.evaluate(() => { const G = window.__GAME__; G.settings.glyphs = 'xbox'; G.saveSettings(); });\n  await frames(p, 3);\n  s = await state(p);\n  eq(s.column, 'xbox');\n  assert(s.prompts.some((x) => x.startsWith('xbox:a')), `prompts ${s.prompts}`);\n  await p.evaluate(() => { const G = window.__GAME__; G.settings.glyphs = 'ps'; G.saveSettings(); });\n  // A key press switches to keycaps.\n  await p.keyboard.press('ArrowDown');\n  await frames(p, 4);\n  s = await state(p);\n  eq(s.device, 'keyboard');\n  eq(s.column, 'key');\n  assert(s.prompts.some((x) => x.startsWith('key:Enter')), `prompts ${s.prompts}`);\n  // A mouse move switches to mouse prompts, and hover moves the focus.\n  const rect = await p.evaluate(() => {\n    const G = window.__GAME__; const m = G.stack.top.menu; const r = m.rects[3];\n    const h = G.engine.hud; const c = h.canvas.getBoundingClientRect();\n    return { x: c.left + ((r.x + 20) / h.width) * c.width, y: c.top + ((r.y + 6) / h.height) * c.height };\n  });\n  await p.mouse.move(rect.x, rect.y);\n  await frames(p, 4);\n  await p.mouse.move(rect.x + 3, rect.y + 1);\n  await frames(p, 4);\n  s = await state(p);\n  eq(s.device, 'mouse');\n  eq(s.column, 'mouse');\n  assert(s.prompts.some((x) => x.startsWith('mouse:mouseL')), `prompts ${s.prompts}`);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.menu.focus), 3, 'hover moved the focus');\n  // A click activates.\n  await p.mouse.down();\n  await frames(p, 3);\n  await p.mouse.up();\n  await frames(p, 4);\n  s = await state(p);\n  eq(s.stack.join(), 'main,settings', 'click opened Settings');\n  // Stick navigates with repeat.\n  await p.evaluate(() => { window.__pads[0].axes[1] = 1; });\n  await frames(p, 10);\n  await p.evaluate(() => { window.__pads[0].axes[1] = 0; });\n  await frames(p, 3);\n  s = await state(p);\n  eq(s.device, 'pad', 'the stick counts as the pad');\n  eq(errors.length, 0, errors.join(' | '));\n  await p.context().close();\n});\n\nawait test('15 lean: stick, keys and mouse all drive the Dot; the mouse takes over when it moves', async () => {\n  const p = await page();\n  await p.addInitScript(PAD_INIT);\n  await bootPage(p);\n  await go(p, 'activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  await p.keyboard.press('Enter');\n  await p.waitForFunction(() => window.__GAME__.scene.phase === 'play', null, { timeout: 30000 });\n  const dotOf = () => p.evaluate(() => { const l = window.__GAME__.scene.playerLane; return { x: l.dot.x, ux: l.inp.x, uy: l.inp.y }; });\n  await p.evaluate(() => { window.__pads[0].axes[0] = 0.8; window.__pads[0].axes[1] = -0.6; });\n  await frames(p, 10);\n  let d = await dotOf();\n  assert(d.ux > 0.6 && d.uy > 0.4, `stick ${JSON.stringify(d)}`);\n  await p.evaluate(() => { window.__pads[0].axes[0] = 0; window.__pads[0].axes[1] = 0; });\n  await frames(p, 4);\n  await p.keyboard.down('KeyD');\n  await frames(p, 14);\n  d = await dotOf();\n  await p.keyboard.up('KeyD');\n  assert(d.ux > 0.5, `keys ${JSON.stringify(d)}`);\n  await p.mouse.move(100, 100);\n  await frames(p, 3);\n  await p.mouse.move(900, 200);\n  await frames(p, 6);\n  d = await dotOf();\n  assert(d.ux > 0.5, `mouse ${JSON.stringify(d)}`);\n  eq((await state(p)).device, 'mouse');\n  await p.context().close();\n});\n\nawait test('17 Family Hour with 2 stub pads plus keyboard: three lanes move independently', async () => {\n  const p = await page();\n  await p.addInitScript(PAD_INIT);\n  await p.addInitScript(() => { window.__padCount = 2; });\n  await bootPage(p);\n  await go(p, 'join');\n  await frames(p, 5);\n  const padDown = async (i, b, on) => p.evaluate(([pi, bi, o]) => { window.__pads[pi].buttons[bi].pressed = o; }, [i, b, on]);\n  await padDown(0, 0, true); await frames(p, 3); await padDown(0, 0, false); await frames(p, 3);\n  await padDown(1, 0, true); await frames(p, 3); await padDown(1, 0, false); await frames(p, 3);\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  const seats = await p.evaluate(() => window.__GAME__.scene.seats.map((s) => (s ? `${s.kind}${s.index ?? ''}` : null)));\n  eq(seats.slice(0, 3).join(), 'pad0,pad1,keyboard', 'seats');\n  await p.keyboard.press('KeyB'); // no bots\n  await frames(p, 3);\n  await p.keyboard.press('Enter'); // the keyboard's second press starts it\n  await p.waitForFunction(() => window.__GAME__.scene.id === 'medley' && !window.__GAME__.loading, null, { timeout: 60000 });\n  eq(await p.evaluate(() => window.__GAME__.scene.lanes.length), 3);\n  await p.waitForFunction(() => window.__GAME__.scene.phase === 'play' && window.__GAME__.scene.current, null, { timeout: 30000 });\n  // Pad 0 leans left, pad 1 leans right, keys lean forward: three different Dots.\n  await p.evaluate(() => { window.__pads[0].axes[0] = -1; window.__pads[1].axes[0] = 1; });\n  await p.keyboard.down('KeyW');\n  await frames(p, 40);\n  const dots = await p.evaluate(() => window.__GAME__.scene.lanes.map((l) => ({ x: l.dot.x, y: l.dot.y, ux: l.inp.x, uy: l.inp.y, kind: l.driver.kind })));\n  await p.keyboard.up('KeyW');\n  assert(dots[0].x < -0.2 && dots[0].kind === 'pad', `pad 0 ${JSON.stringify(dots[0])}`);\n  assert(dots[1].x > 0.2 && dots[1].kind === 'pad', `pad 1 ${JSON.stringify(dots[1])}`);\n  assert(dots[2].y > 0.2 && Math.abs(dots[2].x) < 0.3 && dots[2].kind === 'keyboard', `keys ${JSON.stringify(dots[2])}`);\n  eq(errors.length, 0, errors.join(' | '));\n  await p.context().close();\n});\n\nawait test('18 audio after a real click: an AnalyserNode on the destination reads non-silent, for SFX and for music', async () => {\n  const p = await page();\n  await bootPage(p);\n  await p.mouse.click(640, 360);\n  await frames(p, 20);\n  const levels = await p.evaluate(async () => {\n    const G = window.__GAME__; const a = G.engine.audio; const ctx = a.context;\n    if (ctx.state !== 'running') await ctx.resume();\n    const an = ctx.createAnalyser();\n    an.fftSize = 2048;\n    // Tap whatever goes out, at the buses' shared gain.\n    a.buses.music.connect(an);\n    a.buses.sfx.connect(an);\n    const buf = new Float32Array(an.fftSize);\n    const peak = async (ms) => { let m = 0; const end = performance.now() + ms; while (performance.now() < end) { an.getFloatTimeDomainData(buf); for (const v of buf) m = Math.max(m, Math.abs(v)); await new Promise((r) => setTimeout(r, 25)); } return m; };\n    G.music('title');\n    const music = await peak(2200);\n    G.music(null);\n    await new Promise((r) => setTimeout(r, 500));\n    G.sfx('splash');\n    const sfx = await peak(500);\n    return { music, sfx, state: ctx.state, musicVol: a.volume.music };\n  });\n  eq(levels.state, 'running');\n  assert(levels.music > 0.003, `music peak ${levels.music}`);\n  assert(levels.sfx > 0.02, `sfx peak ${levels.sfx}`);\n  await p.context().close();\n});\n\nawait test('18 voice in an OfflineAudioContext: RMS over .02, and Ounce\\'s mean pitch exceeds Coach\\'s', async () => {\n  const p = await page();\n  await bootPage(p);\n  const r = await p.evaluate(async () => {\n    const { syllabify, renderVoice } = window.__GAME__.voiceApi;\n    const render = async (who) => {\n      const syl = syllabify('Thank you. I have written that down. Is that close?', who);\n      const len = Math.max(1, syl[syl.length - 1].t + 0.4);\n      const off = new OfflineAudioContext(1, Math.ceil(44100 * len), 44100);\n      renderVoice(off, off.destination, syl, 0.01, who);\n      const buf = await off.startRendering();\n      const d = buf.getChannelData(0);\n      let s = 0; let crossings = 0;\n      for (let i = 1; i < d.length; i++) { s += d[i] * d[i]; }\n      void crossings;\n      // Autocorrelation over the voiced part gives the pitch.\n      const start = Math.floor(44100 * 0.02), n = 4096;\n      let best = 0, bestLag = 1;\n      for (let lag = 60; lag < 600; lag++) {\n        let c = 0;\n        for (let i = 0; i < n; i++) c += d[start + i] * d[start + i + lag];\n        if (c > best) { best = c; bestLag = lag; }\n      }\n      return { rms: Math.sqrt(s / d.length), pitch: 44100 / bestLag, mean: syl.filter((x) => !x.tick).reduce((a, x) => a + x.f0, 0) / syl.filter((x) => !x.tick).length };\n    };\n    return { ounce: await render('ounce'), coach: await render('coach'), june: await render('june') };\n  });\n  assert(r.ounce.rms > 0.02, `ounce rms ${r.ounce.rms}`);\n  assert(r.coach.rms > 0.02, `coach rms ${r.coach.rms}`);\n  assert(r.ounce.mean > r.coach.mean, 'mean f0');\n  assert(r.ounce.pitch > r.coach.pitch, `rendered pitch ${r.ounce.pitch} vs ${r.coach.pitch}`);\n  await p.context().close();\n});\n\nawait browser.close();\ndone();\nEOF\ncat > tests/browser/devices.mjs <<'EOF'\n// 16 touch-only phones, 20 browsers without WebGPU.\nimport { assert, done, eq, test } from '../lib-pure.mjs';\nimport { devices, firefox, webkit } from 'playwright';\nimport { bootPage, FILE_URL, launch } from './_lib.mjs';\n\nawait test('16 phone with touch: message showing, gear present, engine.touch null, attract runs and a tap returns', async () => {\n  const browser = await launch();\n  const ctx = await browser.newContext({ ...devices['Pixel 7'] });\n  const p = await ctx.newPage();\n  const errors = [];\n  p.on('pageerror', (e) => errors.push(e.message));\n  await bootPage(p);\n  const s = await p.evaluate(() => {\n    const G = window.__GAME__, e = window.__PIXEL_ENGINE__;\n    return { touchOnly: G.touchOnly, touch: e.touch, msg: G.scene.touchMessage, scene: G.scene.id, width: e.hud.width };\n  });\n  eq(s.touchOnly, true, 'touch-only detected');\n  eq(s.touch, null, 'no touch controls');\n  eq(s.msg, true, 'message showing');\n  eq(s.scene, 'title');\n  const gear = await p.evaluate(() => [...document.querySelectorAll('button, [role=button], div')].some((b) => /⚙/.test(b.textContent ?? '') && b.children.length === 0));\n  assert(gear, 'the settings button is present');\n  // The message fits, even on a narrow portrait art size.\n  const fits = await p.evaluate(() => {\n    const G = window.__GAME__;\n    G.layoutCheck = true;\n    return { w: G.engine.hud.width };\n  });\n  assert(fits.w > 100);\n  // A tap on the screen stays on the title, with the message, and restarts the timer.\n  await p.touchscreen.tap(100, 300);\n  await p.waitForTimeout(400);\n  eq(await p.evaluate(() => window.__GAME__.stack.names().length), 0, 'no menu opens');\n  eq(await p.evaluate(() => window.__GAME__.scene.touchMessage), true);\n  assert(await p.evaluate(() => window.__GAME__.scene.idle < 3), 'timer restarted');\n  // Attract runs and loops.\n  await p.evaluate(() => { window.__GAME__.scene.idle = 9.9; });\n  await p.waitForFunction(() => !!window.__GAME__.attract, null, { timeout: 15000 });\n  await p.waitForFunction(() => !window.__GAME__.loading && window.__GAME__.scene.id === 'hub', null, { timeout: 40000 });\n  await p.touchscreen.tap(100, 300);\n  await p.waitForFunction(() => !window.__GAME__.attract, null, { timeout: 10000 });\n  await p.waitForFunction(() => !window.__GAME__.loading && window.__GAME__.scene.id === 'title', null, { timeout: 40000 });\n  eq(await p.evaluate(() => window.__GAME__.scene.touchMessage), true, 'back to the message');\n  // A key press drops the message and plays normally.\n  await p.keyboard.press('Enter');\n  await p.waitForTimeout(400);\n  eq(await p.evaluate(() => window.__GAME__.scene.touchMessage), false);\n  eq(await p.evaluate(() => window.__GAME__.stack.names().join()), 'main');\n  eq(errors.length, 0, errors.join(' | '));\n  await browser.close();\n});\nfor (const [name, type, profile] of [['WebKit iPhone', webkit, devices['iPhone 15']], ['Firefox', firefox, {}]]) {\n  await test(`20 ${name}: no navigator.gpu here, so the engine's message shows, and no page error`, async () => {\n    const browser = await type.launch();\n    const ctx = await browser.newContext(profile);\n    const p = await ctx.newPage();\n    const errors = [];\n    p.on('pageerror', (e) => errors.push(e.message));\n    await p.goto(FILE_URL);\n    const hasGpu = await p.evaluate(() => !!navigator.gpu);\n    if (!hasGpu) {\n      await p.waitForFunction(() => /Failed to start: WebGPU unavailable/.test(document.body.innerText), null, { timeout: 60000 });\n      await p.waitForTimeout(500);\n      eq(errors.length, 0, errors.join(' | '));\n    }\n    await browser.close();\n  });\n}\ndone();\nEOF\npython3 - <<'EOF'\np='src/app.js'; s=open(p).read()\ns=s.replace(\"import { VoicePlayer } from './audio/voice.js';\",\"import { renderVoice, syllabify, VoicePlayer } from './audio/voice.js';\")\ns=s.replace(\"  voice: new VoicePlayer(),\\n\",\"  voice: new VoicePlayer(),\\n  voiceApi: { syllabify, renderVoice },\\n\")\nopen(p,'w').write(s)\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- Run log: test runner race\",\"- Run log: tests caught Lane constructor dropping seat so ghost messages never reached ghosts (harness cannot see it), Medley idling 10 s after the last event; test runner race\")\nopen(p,'w').write(s)\nEOF\ntimeout 590 node tools/test.mjs game devices </dev/null 2>&1 | tail -22 | cut -c1-640","description":"Write browser tests for boot, devices, Family Hour, audio, touch and no-WebGPU, then run them","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3351,"cache_read_input_tokens":586847,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3351},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"4aead13c-cea4-40a6-be30-b637d3031920","timestamp":"2026-11-05T07:10:56.414Z","request_id":"req_011CgjMyrXBT5otNMYJ9YpBp","wire_tool_inputs":{"toolu_01M3xZAKhnZ1iM2mjoLiZzru":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > tests/browser/game.mjs <<'EOF'\n// 14 boot, 15 devices and prompts, 17 Family Hour, 18 audio, on the built html via file://.\nimport { assert, done, eq, test } from '../lib-pure.mjs';\nimport { bootPage, FILE_URL, launch, PAD_INIT } from './_lib.mjs';\n\nconst browser = await launch();\nconst errors = [];\nasync function page(opts = {}) {\n  const ctx = await browser.newContext({ viewport: { width: 1280, height: 720 }, ...opts });\n  const p = await ctx.newPage();\n  p.on('pageerror', (e) => errors.push(`pageerror: ${e.message}`));\n  p.on('console', (m) => { if (m.type() === 'error') errors.push(`console: ${m.text()}`); });\n  return p;\n}\nconst state = (p) => p.evaluate(() => window.__GAME__.state());\nconst frames = (p, n = 30) => p.waitForFunction(([start, want]) => window.__PIXEL_ENGINE__.frame >= start + want, [0, 0]).then(async () => {\n  const start = await p.evaluate(() => window.__PIXEL_ENGINE__.frame);\n  await p.waitForFunction(([s, w]) => window.__PIXEL_ENGINE__.frame >= s + w, [start, n], { timeout: 60000 });\n});\nconst SETTLE = () => !window.__GAME__.loading;\nasync function go(p, id, args = {}) {\n  await p.evaluate(([i, a]) => window.__GAME__.go(i, a), [id, args]);\n  await p.waitForFunction(SETTLE, null, { timeout: 60000 });\n}\n\nawait test('14 boots on WebGPU with no errors, title visible, music exactly 0.10 on first run', async () => {\n  const p = await page();\n  await bootPage(p);\n  const s = await p.evaluate(() => {\n    const e = window.__PIXEL_ENGINE__;\n    return { backend: e.state().backend, ok: e.state().errors.length, music: window.__GAME__.engine.audio.volume.music, scene: window.__GAME__.state().scene, active: !!window.AIHub?.active, gpu: e.state().gpuErrors.length };\n  });\n  eq(s.backend, 'webgpu');\n  eq(s.ok, 0);\n  eq(s.gpu, 0);\n  eq(s.music, 0.1);\n  eq(s.scene, 'title');\n  await frames(p, 20);\n  const seen = await p.evaluate(() => {\n    const c = window.__PIXEL_ENGINE__.hud.canvas;\n    const d = c.getContext('2d').getImageData(0, 0, c.width, c.height).data;\n    let n = 0;\n    for (let i = 3; i < d.length; i += 4) if (d[i]) n++;\n    return n;\n  });\n  assert(seen > 500, `HUD pixels: ${seen}`);\n  eq(errors.length, 0, errors.join(' | '));\n  await p.context().close();\n});\n\nawait test('14 the engine\\'s stored volume can\\'t move ours: music is 0.10 at every boot', async () => {\n  const p = await page();\n  await p.addInitScript(() => localStorage.setItem('pixel-engine:audio', JSON.stringify({ master: 0.8, sfx: 1, music: 0.9, muted: false })));\n  await bootPage(p);\n  eq(await p.evaluate(() => window.__GAME__.engine.audio.volume.music), 0.1);\n  await p.context().close();\n});\n\nawait test('15 pad stub: Cross confirms, PlayStation glyphs, Settings gives Xbox, keys give keycaps, mouse gives mouse prompts, hover and click', async () => {\n  const p = await page();\n  await p.addInitScript(PAD_INIT);\n  await bootPage(p);\n  await frames(p, 5);\n  const press = async (i) => { await p.evaluate((b) => { window.__pads[0].buttons[b].pressed = true; window.__pads[0].buttons[b].value = 1; }, i); await frames(p, 4); await p.evaluate((b) => { window.__pads[0].buttons[b].pressed = false; window.__pads[0].buttons[b].value = 0; }, i); await frames(p, 4); };\n  await press(0);\n  let s = await state(p);\n  eq(s.stack.join(), 'main', 'Cross opened the menu');\n  eq(s.device, 'pad');\n  eq(s.column, 'ps');\n  assert(s.prompts.some((x) => x.startsWith('ps:cross')), `prompts ${s.prompts}`);\n  // The option in Settings swaps the glyphs.\n  await p.evaluate(() => { const G = window.__GAME__; G.settings.glyphs = 'xbox'; G.saveSettings(); });\n  await frames(p, 3);\n  s = await state(p);\n  eq(s.column, 'xbox');\n  assert(s.prompts.some((x) => x.startsWith('xbox:a')), `prompts ${s.prompts}`);\n  await p.evaluate(() => { const G = window.__GAME__; G.settings.glyphs = 'ps'; G.saveSettings(); });\n  // A key press switches to keycaps.\n  await p.keyboard.press('ArrowDown');\n  await frames(p, 4);\n  s = await state(p);\n  eq(s.device, 'keyboard');\n  eq(s.column, 'key');\n  assert(s.prompts.some((x) => x.startsWith('key:Enter')), `prompts ${s.prompts}`);\n  // A mouse move switches to mouse prompts, and hover moves the focus.\n  const rect = await p.evaluate(() => {\n    const G = window.__GAME__; const m = G.stack.top.menu; const r = m.rects[3];\n    const h = G.engine.hud; const c = h.canvas.getBoundingClientRect();\n    return { x: c.left + ((r.x + 20) / h.width) * c.width, y: c.top + ((r.y + 6) / h.height) * c.height };\n  });\n  await p.mouse.move(rect.x, rect.y);\n  await frames(p, 4);\n  await p.mouse.move(rect.x + 3, rect.y + 1);\n  await frames(p, 4);\n  s = await state(p);\n  eq(s.device, 'mouse');\n  eq(s.column, 'mouse');\n  assert(s.prompts.some((x) => x.startsWith('mouse:mouseL')), `prompts ${s.prompts}`);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.menu.focus), 3, 'hover moved the focus');\n  // A click activates.\n  await p.mouse.down();\n  await frames(p, 3);\n  await p.mouse.up();\n  await frames(p, 4);\n  s = await state(p);\n  eq(s.stack.join(), 'main,settings', 'click opened Settings');\n  // Stick navigates with repeat.\n  await p.evaluate(() => { window.__pads[0].axes[1] = 1; });\n  await frames(p, 10);\n  await p.evaluate(() => { window.__pads[0].axes[1] = 0; });\n  await frames(p, 3);\n  s = await state(p);\n  eq(s.device, 'pad', 'the stick counts as the pad');\n  eq(errors.length, 0, errors.join(' | '));\n  await p.context().close();\n});\n\nawait test('15 lean: stick, keys and mouse all drive the Dot; the mouse takes over when it moves', async () => {\n  const p = await page();\n  await p.addInitScript(PAD_INIT);\n  await bootPage(p);\n  await go(p, 'activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  await p.keyboard.press('Enter');\n  await p.waitForFunction(() => window.__GAME__.scene.phase === 'play', null, { timeout: 30000 });\n  const dotOf = () => p.evaluate(() => { const l = window.__GAME__.scene.playerLane; return { x: l.dot.x, ux: l.inp.x, uy: l.inp.y }; });\n  await p.evaluate(() => { window.__pads[0].axes[0] = 0.8; window.__pads[0].axes[1] = -0.6; });\n  await frames(p, 10);\n  let d = await dotOf();\n  assert(d.ux > 0.6 && d.uy > 0.4, `stick ${JSON.stringify(d)}`);\n  await p.evaluate(() => { window.__pads[0].axes[0] = 0; window.__pads[0].axes[1] = 0; });\n  await frames(p, 4);\n  await p.keyboard.down('KeyD');\n  await frames(p, 14);\n  d = await dotOf();\n  await p.keyboard.up('KeyD');\n  assert(d.ux > 0.5, `keys ${JSON.stringify(d)}`);\n  await p.mouse.move(100, 100);\n  await frames(p, 3);\n  await p.mouse.move(900, 200);\n  await frames(p, 6);\n  d = await dotOf();\n  assert(d.ux > 0.5, `mouse ${JSON.stringify(d)}`);\n  eq((await state(p)).device, 'mouse');\n  await p.context().close();\n});\n\nawait test('17 Family Hour with 2 stub pads plus keyboard: three lanes move independently', async () => {\n  const p = await page();\n  await p.addInitScript(PAD_INIT);\n  await p.addInitScript(() => { window.__padCount = 2; });\n  await bootPage(p);\n  await go(p, 'join');\n  await frames(p, 5);\n  const padDown = async (i, b, on) => p.evaluate(([pi, bi, o]) => { window.__pads[pi].buttons[bi].pressed = o; }, [i, b, on]);\n  await padDown(0, 0, true); await frames(p, 3); await padDown(0, 0, false); await frames(p, 3);\n  await padDown(1, 0, true); await frames(p, 3); await padDown(1, 0, false); await frames(p, 3);\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  const seats = await p.evaluate(() => window.__GAME__.scene.seats.map((s) => (s ? `${s.kind}${s.index ?? ''}` : null)));\n  eq(seats.slice(0, 3).join(), 'pad0,pad1,keyboard', 'seats');\n  await p.keyboard.press('KeyB'); // no bots\n  await frames(p, 3);\n  await p.keyboard.press('Enter'); // the keyboard's second press starts it\n  await p.waitForFunction(() => window.__GAME__.scene.id === 'medley' && !window.__GAME__.loading, null, { timeout: 60000 });\n  eq(await p.evaluate(() => window.__GAME__.scene.lanes.length), 3);\n  await p.waitForFunction(() => window.__GAME__.scene.phase === 'play' && window.__GAME__.scene.current, null, { timeout: 30000 });\n  // Pad 0 leans left, pad 1 leans right, keys lean forward: three different Dots.\n  await p.evaluate(() => { window.__pads[0].axes[0] = -1; window.__pads[1].axes[0] = 1; });\n  await p.keyboard.down('KeyW');\n  await frames(p, 40);\n  const dots = await p.evaluate(() => window.__GAME__.scene.lanes.map((l) => ({ x: l.dot.x, y: l.dot.y, ux: l.inp.x, uy: l.inp.y, kind: l.driver.kind })));\n  await p.keyboard.up('KeyW');\n  assert(dots[0].x < -0.2 && dots[0].kind === 'pad', `pad 0 ${JSON.stringify(dots[0])}`);\n  assert(dots[1].x > 0.2 && dots[1].kind === 'pad', `pad 1 ${JSON.stringify(dots[1])}`);\n  assert(dots[2].y > 0.2 && Math.abs(dots[2].x) < 0.3 && dots[2].kind === 'keyboard', `keys ${JSON.stringify(dots[2])}`);\n  eq(errors.length, 0, errors.join(' | '));\n  await p.context().close();\n});\n\nawait test('18 audio after a real click: an AnalyserNode on the destination reads non-silent, for SFX and for music', async () => {\n  const p = await page();\n  await bootPage(p);\n  await p.mouse.click(640, 360);\n  await frames(p, 20);\n  const levels = await p.evaluate(async () => {\n    const G = window.__GAME__; const a = G.engine.audio; const ctx = a.context;\n    if (ctx.state !== 'running') await ctx.resume();\n    const an = ctx.createAnalyser();\n    an.fftSize = 2048;\n    // Tap whatever goes out, at the buses' shared gain.\n    a.buses.music.connect(an);\n    a.buses.sfx.connect(an);\n    const buf = new Float32Array(an.fftSize);\n    const peak = async (ms) => { let m = 0; const end = performance.now() + ms; while (performance.now() < end) { an.getFloatTimeDomainData(buf); for (const v of buf) m = Math.max(m, Math.abs(v)); await new Promise((r) => setTimeout(r, 25)); } return m; };\n    G.music('title');\n    const music = await peak(2200);\n    G.music(null);\n    await new Promise((r) => setTimeout(r, 500));\n    G.sfx('splash');\n    const sfx = await peak(500);\n    return { music, sfx, state: ctx.state, musicVol: a.volume.music };\n  });\n  eq(levels.state, 'running');\n  assert(levels.music > 0.003, `music peak ${levels.music}`);\n  assert(levels.sfx > 0.02, `sfx peak ${levels.sfx}`);\n  await p.context().close();\n});\n\nawait test('18 voice in an OfflineAudioContext: RMS over .02, and Ounce\\'s mean pitch exceeds Coach\\'s', async () => {\n  const p = await page();\n  await bootPage(p);\n  const r = await p.evaluate(async () => {\n    const { syllabify, renderVoice } = window.__GAME__.voiceApi;\n    const render = async (who) => {\n      const syl = syllabify('Thank you. I have written that down. Is that close?', who);\n      const len = Math.max(1, syl[syl.length - 1].t + 0.4);\n      const off = new OfflineAudioContext(1, Math.ceil(44100 * len), 44100);\n      renderVoice(off, off.destination, syl, 0.01, who);\n      const buf = await off.startRendering();\n      const d = buf.getChannelData(0);\n      let s = 0; let crossings = 0;\n      for (let i = 1; i < d.length; i++) { s += d[i] * d[i]; }\n      void crossings;\n      // Autocorrelation over the voiced part gives the pitch.\n      const start = Math.floor(44100 * 0.02), n = 4096;\n      let best = 0, bestLag = 1;\n      for (let lag = 60; lag < 600; lag++) {\n        let c = 0;\n        for (let i = 0; i < n; i++) c += d[start + i] * d[start + i + lag];\n        if (c > best) { best = c; bestLag = lag; }\n      }\n      return { rms: Math.sqrt(s / d.length), pitch: 44100 / bestLag, mean: syl.filter((x) => !x.tick).reduce((a, x) => a + x.f0, 0) / syl.filter((x) => !x.tick).length };\n    };\n    return { ounce: await render('ounce'), coach: await render('coach'), june: await render('june') };\n  });\n  assert(r.ounce.rms > 0.02, `ounce rms ${r.ounce.rms}`);\n  assert(r.coach.rms > 0.02, `coach rms ${r.coach.rms}`);\n  assert(r.ounce.mean > r.coach.mean, 'mean f0');\n  assert(r.ounce.pitch > r.coach.pitch, `rendered pitch ${r.ounce.pitch} vs ${r.coach.pitch}`);\n  await p.context().close();\n});\n\nawait browser.close();\ndone();\nEOF\ncat > tests/browser/devices.mjs <<'EOF'\n// 16 touch-only phones, 20 browsers without WebGPU.\nimport { assert, done, eq, test } from '../lib-pure.mjs';\nimport { devices, firefox, webkit } from 'playwright';\nimport { bootPage, FILE_URL, launch } from './_lib.mjs';\n\nawait test('16 phone with touch: message showing, gear present, engine.touch null, attract runs and a tap returns', async () => {\n  const browser = await launch();\n  const ctx = await browser.newContext({ ...devices['Pixel 7'] });\n  const p = await ctx.newPage();\n  const errors = [];\n  p.on('pageerror', (e) => errors.push(e.message));\n  await bootPage(p);\n  const s = await p.evaluate(() => {\n    const G = window.__GAME__, e = window.__PIXEL_ENGINE__;\n    return { touchOnly: G.touchOnly, touch: e.touch, msg: G.scene.touchMessage, scene: G.scene.id, width: e.hud.width };\n  });\n  eq(s.touchOnly, true, 'touch-only detected');\n  eq(s.touch, null, 'no touch controls');\n  eq(s.msg, true, 'message showing');\n  eq(s.scene, 'title');\n  const gear = await p.evaluate(() => [...document.querySelectorAll('button, [role=button], div')].some((b) => /\\u2699/.test(b.textContent ?? '') && b.children.length === 0));\n  assert(gear, 'the settings button is present');\n  // The message fits, even on a narrow portrait art size.\n  const fits = await p.evaluate(() => {\n    const G = window.__GAME__;\n    G.layoutCheck = true;\n    return { w: G.engine.hud.width };\n  });\n  assert(fits.w > 100);\n  // A tap on the screen stays on the title, with the message, and restarts the timer.\n  await p.touchscreen.tap(100, 300);\n  await p.waitForTimeout(400);\n  eq(await p.evaluate(() => window.__GAME__.stack.names().length), 0, 'no menu opens');\n  eq(await p.evaluate(() => window.__GAME__.scene.touchMessage), true);\n  assert(await p.evaluate(() => window.__GAME__.scene.idle < 3), 'timer restarted');\n  // Attract runs and loops.\n  await p.evaluate(() => { window.__GAME__.scene.idle = 9.9; });\n  await p.waitForFunction(() => !!window.__GAME__.attract, null, { timeout: 15000 });\n  await p.waitForFunction(() => !window.__GAME__.loading && window.__GAME__.scene.id === 'hub', null, { timeout: 40000 });\n  await p.touchscreen.tap(100, 300);\n  await p.waitForFunction(() => !window.__GAME__.attract, null, { timeout: 10000 });\n  await p.waitForFunction(() => !window.__GAME__.loading && window.__GAME__.scene.id === 'title', null, { timeout: 40000 });\n  eq(await p.evaluate(() => window.__GAME__.scene.touchMessage), true, 'back to the message');\n  // A key press drops the message and plays normally.\n  await p.keyboard.press('Enter');\n  await p.waitForTimeout(400);\n  eq(await p.evaluate(() => window.__GAME__.scene.touchMessage), false);\n  eq(await p.evaluate(() => window.__GAME__.stack.names().join()), 'main');\n  eq(errors.length, 0, errors.join(' | '));\n  await browser.close();\n});\nfor (const [name, type, profile] of [['WebKit iPhone', webkit, devices['iPhone 15']], ['Firefox', firefox, {}]]) {\n  await test(`20 ${name}: no navigator.gpu here, so the engine's message shows, and no page error`, async () => {\n    const browser = await type.launch();\n    const ctx = await browser.newContext(profile);\n    const p = await ctx.newPage();\n    const errors = [];\n    p.on('pageerror', (e) => errors.push(e.message));\n    await p.goto(FILE_URL);\n    const hasGpu = await p.evaluate(() => !!navigator.gpu);\n    if (!hasGpu) {\n      await p.waitForFunction(() => /Failed to start: WebGPU unavailable/.test(document.body.innerText), null, { timeout: 60000 });\n      await p.waitForTimeout(500);\n      eq(errors.length, 0, errors.join(' | '));\n    }\n    await browser.close();\n  });\n}\ndone();\nEOF\npython3 - <<'EOF'\np='src/app.js'; s=open(p).read()\ns=s.replace(\"import { VoicePlayer } from './audio/voice.js';\",\"import { renderVoice, syllabify, VoicePlayer } from './audio/voice.js';\")\ns=s.replace(\"  voice: new VoicePlayer(),\\n\",\"  voice: new VoicePlayer(),\\n  voiceApi: { syllabify, renderVoice },\\n\")\nopen(p,'w').write(s)\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- Run log: test runner race\",\"- Run log: tests caught Lane constructor dropping seat so ghost messages never reached ghosts (harness cannot see it), Medley idling 10 s after the last event; test runner race\")\nopen(p,'w').write(s)\nEOF\ntimeout 590 node tools/test.mjs game devices </dev/null 2>&1 | tail -22 | cut -c1-640","description":"Write browser tests for boot, devices, Family Hour, audio, touch and no-WebGPU, then run them","timeout":600000}}}
