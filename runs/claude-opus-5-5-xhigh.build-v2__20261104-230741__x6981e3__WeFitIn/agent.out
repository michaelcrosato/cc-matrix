{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjRWEHa47S4tmA3xSFDj","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_015Z5soBetJeBDZ5TmWdVbcr","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > tools/clip-sheet.mjs <<'EOF'\n// Preview clips without a GPU: node tools/clip-sheet.mjs [ClipName ...] writes check/clips/<name>.png.\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { crc32, deflateSync } from 'node:zlib';\nimport { dirname, join } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { compileClips, Engine, HERO_MODEL, HERO_RIG, renderSheet, THREE } from '../pixel-engine.js';\nimport { dress } from '../src/art/avatar.js';\nimport { GAME_CLIPS } from '../src/art/clips.js';\n\nconst OUT = join(dirname(fileURLToPath(import.meta.url)), '..', 'check', 'clips');\nmkdirSync(OUT, { recursive: true });\n\nfunction png({ width, height, data }) {\n  const chunk = (type, body) => {\n    const t = Buffer.from(type), len = Buffer.alloc(4), crc = Buffer.alloc(4);\n    len.writeUInt32BE(body.length);\n    crc.writeUInt32BE(crc32(Buffer.concat([t, body])) >>> 0);\n    return Buffer.concat([len, t, body, crc]);\n  };\n  const raw = Buffer.alloc((width * 4 + 1) * height);\n  for (let y = 0; y < height; y++) Buffer.from(data.buffer, data.byteOffset + y * width * 4, width * 4).copy(raw, y * (width * 4 + 1) + 1);\n  const ihdr = Buffer.alloc(13);\n  ihdr.writeUInt32BE(width, 0); ihdr.writeUInt32BE(height, 4); ihdr[8] = 8; ihdr[9] = 6;\n  return Buffer.concat([Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]), chunk('IHDR', ihdr), chunk('IDAT', deflateSync(raw)), chunk('IEND', Buffer.alloc(0))]);\n}\n\nclass Holder { name = 'clip-sheet'; assets = [HERO_MODEL]; async setup(ctx) { this.model = (await ctx.loadModel(HERO_MODEL, { castShadow: false })).scene; } cameraTarget() { return new THREE.Vector3(); } }\nconst holder = new Holder();\nawait Engine.headless(holder, {});\n// Dress it first, so we judge the real silhouette and not the kit's hat and moustache.\ndress(holder.model, { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink', headband: 'red' });\nconst only = process.argv.slice(2);\nconst defs = GAME_CLIPS.filter((c) => !only.length || only.includes(c.name));\nconst clips = compileClips(defs, HERO_RIG, holder.model);\ndefs.forEach((def, i) => {\n  const frames = def.frames > 36 ? 5 : 6;\n  writeFileSync(join(OUT, `${def.name}.png`), png(renderSheet(holder.model, HERO_RIG, def, clips[i], { frames, views: ['front', 'side'], scale: 90, trails: false, skeleton: false })));\n});\nconsole.log(`${defs.length} sheets in check/clips`);\nprocess.exit(0);\nEOF\npython3 - <<'EOF'\ndef sub(p, pairs):\n    s=open(p).read()\n    for a,b in pairs:\n        if a not in s: print('MISSING in',p,':',a[:80])\n        s=s.replace(a,b)\n    open(p,'w').write(s)\nsub('tests/headless/core.mjs',[\n(\"\"\"await test('the line bank has 120+ lines',\"\"\",\"\"\"const SAMPLES = [\"Hello! I'm Ounce. Please step on me.\", 'Ow.', \"That was a joke. I can't feel pain. I can only keep records.\", 'How old do you feel? This is not binding.', \"Your Wobble Age is 68. Is that close? No? I'm so sorry.\", 'Thank you. I have written that down.', 'You wobbled 14 times. I only counted the ones you noticed.', \"Your left side is doing very well. I'll let your right side know.\", 'No change since yesterday. Which is, in a way, consistent.', 'Excellent! ...Compared to Dennis.', \"I'm not angry. Scales don't get angry. We get accurate.\", \"Have you been stretching? Please don't lie. I'm very sensitive.\", \"Today's concern: your ankles. I've been concerned all night.\", \"Good morning. You look rested. I can't see. But you felt rested.\", 'Kevin has been with us eleven years. He has never once held a pose.', 'This is a recording. The person in it is doing better than you.', 'I have been adding seven. To everyone. For years. It felt motivating.', 'See you tomorrow. Bring your knees.', 'You are a tree. A tree does not check its phone.', 'Your left knee has wandered off. Please collect it.', 'Breathe in. Not like that.', 'Good. Again. That was also good. Again.', 'Hold. You may blink on Thursday.', 'I am eighty-one. I say this so that you feel something.', 'Stillness is a muscle. So is regret. We train both here.', 'The floor is your friend. It has never once let go.', 'Both hips, new. Knee, new. Opinions, original.', 'I used to do this professionally. Not this. Something near it.', \"It's fine. It's just the one leg.\", \"I'm pacing myself.\", \"My gran says you're doing your best. She said it very slowly.\"];\nawait test('every sample line from the plan is in the game, verbatim', () => {\n  const blob = allLines().map((l) => l.text).join(' | ');\n  for (const s of SAMPLES) assert(blob.includes(s), `missing: ${s}`);\n});\nawait test('the line bank has 120+ lines beyond the samples', () => assert(allLines().length - SAMPLES.length >= 120, `${allLines().length}`));\nawait test('the old bank check',\"\"\"),\n])\ns=open('tests/headless/core.mjs').read()\ns=s.replace(\"\"\"await test('the old bank check', () => assert(allLines().length >= 120, `${allLines().length}`));\\n\"\"\",\"\")\nopen('tests/headless/core.mjs','w').write(s)\nsub('tests/headless/systems.mjs',[\n(\"\"\"  const toolDev = () => { const d = new DevScreen(); d.tabs.i = d.tabs.labels.length - 1; d.refresh(); return d; };\n  const item = (d, id) => d.menu.items.find((i) => i.id === id);\"\"\",\"\"\"  const toolDev = () => new DevScreen();\n  const item = (d, id) => d.toolItems().find((i) => i.id === id);\"\"\"),\n(\"\"\"await test('god mode keeps the Dot in the ring; autopilot plays', async () => {\"\"\",\"\"\"await test('dev: no tab shows more than 8 rows at once, and Go and Test hold every tool', async () => {\n  const { DevScreen } = await import('../../src/ui/screens/dev.js');\n  const d = new DevScreen();\n  for (let i = 0; i < d.tabs.labels.length; i++) {\n    d.tabs.set(i);\n    assert(d.menu.visibleRows() <= 8, `${d.tabs.current} shows ${d.menu.visibleRows()}`);\n    if (['Go', 'Test'].includes(d.tabs.current)) assert(d.menu.items.length <= 8, `${d.tabs.current} has ${d.menu.items.length} rows`);\n  }\n  eq(d.toolItems().length, 16);\n});\nawait test('every scene gives a real status line and a fingerprint', async () => {\n  App.store.create(0, 'Scenes', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  App.slot.phase = 'day'; App.slot.heardBeat = 7;\n  const list = [['title', {}], ['hub', {}], ['weighin', {}], ['report', {}], ['jar', {}], ['records', {}], ['locker', {}], ['ferry', {}], ['ending', {}], ['viewer', {}], ['join', {}], ['medley', { family: [{ kind: 'bot' }] }], ...ACTIVITY_IDS.map((id) => ['activity', { id, mode: 'dropin', noPractice: true }])];\n  for (const [id, args] of list) {\n    await h.go(id, args);\n    h.step(5);\n    const s = App.scene.status(App.ctx);\n    assert(typeof s === 'string' && s.length > 3 && s.includes(id === 'activity' ? args.id : id), `${id} status: ${s}`);\n    assert(typeof App.scene.fingerprint(App.ctx) === 'string', `${id} fingerprint`);\n    assert(engine.fingerprint().length > 0);\n    App.stack.clear();\n  }\n  App.store.resetAll();\n  await h.go('title', {});\n});\nawait test('tabs change with the wheel; lists that scroll keep the wheel', async () => {\n  const { SettingsScreen } = await import('../../src/ui/screens/settings.js');\n  const { DevScreen } = await import('../../src/ui/screens/dev.js');\n  const s = new SettingsScreen();\n  App.stack.push(s);\n  h.step(1);\n  engine.input.addPointer(0, 0, 1);\n  h.step(2);\n  eq(s.tabs.i, 1, 'Settings tab by wheel');\n  App.stack.pop(s);\n  const d = new DevScreen();\n  App.stack.push(d);\n  h.step(1);\n  engine.input.addPointer(0, 0, 1);\n  h.step(2);\n  eq(d.tabs.i, 0, 'Balance has 11 rows, so the wheel scrolls');\n  eq(d.menu.top, 1, 'scrolled');\n  App.stack.clear();\n});\nawait test('Step Class: pause stops the music; resume counts in and restarts at the current bar', async () => {\n  await h.go('activity', { id: 'step', mode: 'dropin', noPractice: true });\n  App.dev.autopilot = 'good';\n  h.step(60 * 3 + 60 * 12);\n  const s = App.scene;\n  eq(s.phase, 'play');\n  const { BAR_SECONDS } = await import('../../src/scenes/activity/step.js');\n  const before = s.localClock;\n  engine.input.setKey('Escape', true); h.step(1); engine.input.setKey('Escape', false); h.step(1);\n  eq(App.stack.top?.name, 'pause');\n  eq(engine.audio.playing, '', 'the music stopped');\n  engine.input.setKey('Escape', true); h.step(1); engine.input.setKey('Escape', false);\n  const bar = Math.floor(before / BAR_SECONDS);\n  near(s.localClock, bar * BAR_SECONDS, 1e-6, 'clock back at the bar');\n  assert(s.counting > 0, 'counting in');\n  h.step(30);\n  near(s.localClock, bar * BAR_SECONDS, 1e-6, 'held during the count');\n  h.step(120);\n  eq(engine.audio.playing, 'step', 'music back');\n  assert(s.localClock > bar * BAR_SECONDS, 'moving again');\n  App.dev.autopilot = null;\n});\nawait test('the island talks: classmates when you pass, Coach during a hold', async () => {\n  App.store.create(0, 'Talk', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  App.slot.phase = 'day'; App.slot.heardBeat = 7;\n  await h.go('hub', {});\n  const hub = App.scene;\n  const l = hub.locals.june;\n  hub.hero.teleport([l.at.x + 1, 0.1, l.at.z]);\n  hub.barkT = 99; hub.chatT = 0;\n  h.step(30);\n  eq(App.bark.who, 'june', 'June says something');\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  App.dev.autopilot = 'expert';\n  let coach = false;\n  for (let i = 0; i < 60 && !coach; i++) { h.step(30); if (App.bark.who === 'coach' && App.scene.phase === 'play') coach = true; }\n  assert(coach, 'Coach remarks during the hold');\n  App.dev.autopilot = null;\n  App.store.resetAll();\n  await h.go('title', {});\n});\nawait test('Island Jog is about 220 m', async () => {\n  await h.go('activity', { id: 'jog', mode: 'dropin', noPractice: true });\n  assert(App.scene.length > 205 && App.scene.length < 235, `${App.scene.length}`);\n  await h.go('title', {});\n});\nawait test('the wobble count reaches the remark', async () => {\n  const { ResultsScreen } = await import('../../src/ui/screens/results.js');\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  let found = false;\n  for (let i = 0; i < 40 && !found; i++) {\n    const r = new ResultsScreen(App.scene, { id: 'tree', stars: 1, score: 50, firstEver: false, wobbles: 9, mode: 'dropin' });\n    found = r.line.includes('You wobbled 9 times');\n  }\n  assert(found);\n  await h.go('title', {});\n});\nawait test('god mode keeps the Dot in the ring; autopilot plays', async () => {\"\"\"),\n])\nsub('tests/browser/game.mjs',[\n(\"\"\"await test('18 audio after a real click:\"\"\",\"\"\"await test('15 mouse details: slider drags, right click goes back, the wheel changes tabs, the pause icon opens pause', async () => {\n  const p = await page();\n  await bootPage(p);\n  await frames(p, 5);\n  const artToPage = (x, y) => p.evaluate(([ax, ay]) => { const h = window.__GAME__.engine.hud; const c = h.canvas.getBoundingClientRect(); return { x: c.left + (ax / h.width) * c.width, y: c.top + (ay / h.height) * c.height }; }, [x, y]);\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  await p.evaluate(() => { const m = window.__GAME__.stack.top.menu; m.focus = 3; });\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.name), 'settings');\n  // Drag the music slider all the way right, then put it back.\n  const r = await p.evaluate(() => { const row = window.__GAME__.stack.top.menu.rects[0]; return { sx: row.sx, sw: row.sw, y: row.y + row.h / 2 }; });\n  const from = await artToPage(r.sx + 2, r.y);\n  const to = await artToPage(r.sx + r.sw, r.y);\n  await p.mouse.move(from.x, from.y);\n  await frames(p, 3);\n  await p.mouse.down();\n  await frames(p, 2);\n  await p.mouse.move(to.x, to.y);\n  await frames(p, 4);\n  await p.mouse.up();\n  await frames(p, 3);\n  const after = await p.evaluate(() => window.__GAME__.engine.audio.volume.music);\n  assert(after > 0.8, `slider dragged to ${after}`);\n  await p.evaluate(() => { const G = window.__GAME__; G.settings.music = 0.1; G.saveSettings(); });\n  await p.mouse.wheel(0, 120);\n  await frames(p, 4);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.tabs.i), 1, 'wheel changed tab');\n  await p.mouse.click(to.x, to.y, { button: 'right' });\n  await frames(p, 4);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.name), 'main', 'right click is Back');\n  // The pause icon, top right, while the mouse moves.\n  await go(p, 'activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  await p.keyboard.press('Enter');\n  await p.waitForFunction(() => window.__GAME__.scene.phase === 'play', null, { timeout: 30000 });\n  await p.mouse.move(300, 300);\n  await frames(p, 2);\n  await p.mouse.move(320, 310);\n  await frames(p, 2);\n  const icon = await p.evaluate(() => window.__GAME__.scene.pauseIconHit);\n  assert(icon, 'icon shown while the mouse moves');\n  const at = await artToPage(icon.x + 8, icon.y + 8);\n  await p.mouse.move(at.x, at.y);\n  await frames(p, 2);\n  await p.mouse.down();\n  await frames(p, 3);\n  await p.mouse.up();\n  await frames(p, 3);\n  eq(await p.evaluate(() => window.__GAME__.stack.top?.name), 'pause', 'icon opens pause');\n  eq(errors.length, 0, errors.join(' | '));\n  await p.context().close();\n});\n\nfor (const [W, H, artW, artH] of [[1920, 1080, 480, 270], [1280, 720, 427, 240], [640, 360, 640, 360]]) {\n  await test(`19 no layout overflow in a real page at ${W}x${H}`, async () => {\n    const p = await page({ viewport: { width: W, height: H } });\n    await bootPage(p);\n    await frames(p, 6);\n    const size = await p.evaluate(() => { const h = window.__GAME__.engine.hud; return `${h.width}x${h.height}`; });\n    eq(size, `${artW}x${artH}`, 'art size');\n    const check = async (where) => {\n      await frames(p, 4);\n      const bad = await p.evaluate(() => { const G = window.__GAME__; const h = G.engine.hud; return G.layout.overflow(h.width, h.height).filter((r) => r.name !== 'dial').slice(0, 3).map((r) => `${r.name} \"${r.text}\" ${r.x},${r.y} ${r.w}x${r.h}`); });\n      assert(!bad.length, `${where}: ${bad.join('; ')}`);\n    };\n    await p.evaluate(() => { window.__GAME__.layout.record = true; });\n    await check('title');\n    await p.keyboard.press('Enter');\n    await check('main menu');\n    await p.evaluate(() => { const G = window.__GAME__; G.store.create(0, 'Kimberly', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' }); G.slot.phase = 'day'; G.slot.heardBeat = 7; });\n    for (const [id, args] of [['hub', {}], ['activity', { id: 'warrior', mode: 'week', noPractice: true }], ['activity', { id: 'step', mode: 'week', noPractice: true }], ['medley', { family: [{ kind: 'keyboard' }, { kind: 'bot' }, { kind: 'bot' }, { kind: 'bot' }] }], ['records', {}], ['locker', {}]]) {\n      await go(p, id, args);\n      await check(`${id} ${args.id ?? ''}`);\n      if (id === 'activity') { await p.keyboard.press('Enter'); await check(`${args.id} countdown`); await p.waitForFunction(() => window.__GAME__.scene.phase === 'play', null, { timeout: 30000 }); await check(`${args.id} play`); }\n    }\n    eq(errors.length, 0, errors.join(' | '));\n    await p.context().close();\n  });\n}\n\nawait test('20 About: every section is there, and CREDITS.md is shipped in full and scrolls', async () => {\n  const p = await page();\n  await bootPage(p);\n  const a = await p.evaluate(async () => {\n    const G = window.__GAME__;\n    await frames0(10);\n    return null;\n    function frames0() { return new Promise((r) => setTimeout(r, 200)); }\n  });\n  void a;\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  await p.evaluate(() => { window.__GAME__.stack.top.menu.focus = 4; });\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  const info = await p.evaluate(() => {\n    const s = window.__GAME__.stack.top;\n    const titles = s.pages.map((pg) => pg.title);\n    const text = (t) => s.pages.find((pg) => pg.title === t).rows.map((r) => r.h ?? r.t).join(' ');\n    return { name: s.name, titles, note: text('Please Note'), source: text('Source Information'), testing: text('Testing Feedback'), engine: text('Engine Feedback'), prompt: text('Prompt Feedback'), credits: text('CREDITS.md').length };\n  });\n  eq(info.name, 'about');\n  for (const t of ['Credits', 'Please Note', 'Source Information', 'Testing Feedback', 'Engine Feedback', 'Prompt Feedback', 'Engine Kit Credits', 'CREDITS.md']) assert(info.titles.includes(t), `page ${t}`);\n  assert(info.note.includes('This is not medical advice. Ounce is a scale.'), 'disclaimer');\n  for (const f of ['Date', 'Source', 'Plan', 'Genre', 'Perspective', 'Tech', 'Art Direction', 'Animation', 'Audio', 'Online', 'Testing', 'Research', 'Environment', 'Model', 'Usage', 'added on import']) assert(info.source.includes(f), `field ${f}`);\n  assert(!/\\\\bunknown\\\\b/.test(info.testing + info.engine + info.prompt), 'every answer filled in');\n  assert(info.credits > 30000, `CREDITS.md text is ${info.credits} chars`);\n  await p.evaluate(() => { const s = window.__GAME__.stack.top; s.i = s.pages.findIndex((pg) => pg.title === 'CREDITS.md'); });\n  await frames(p, 3);\n  await p.keyboard.down('ArrowDown');\n  await frames(p, 30);\n  await p.keyboard.up('ArrowDown');\n  assert(await p.evaluate(() => window.__GAME__.stack.top.scroll > 3), 'it scrolls');\n  await p.keyboard.press('ArrowRight');\n  await frames(p, 3);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.i), 0, 'arrows page round');\n  await p.context().close();\n});\n\nawait test('18 audio after a real click:\"\"\"),\n])\ns=open('tests/browser/game.mjs').read()\ns=s.replace(\"\"\"  const a = await p.evaluate(async () => {\n    const G = window.__GAME__;\n    await frames0(10);\n    return null;\n    function frames0() { return new Promise((r) => setTimeout(r, 200)); }\n  });\n  void a;\n\"\"\",\"\"\"  await frames(p, 5);\n\"\"\")\nopen('tests/browser/game.mjs','w').write(s)\nsub('tests/browser/devices.mjs',[\n(\"\"\"  // The message fits, even on a narrow portrait art size.\n  const fits = await p.evaluate(() => {\n    const G = window.__GAME__;\n    G.layoutCheck = true;\n    return { w: G.engine.hud.width };\n  });\n  assert(fits.w > 100);\n\"\"\",\"\"\"  // The message fits, even on a narrow portrait art size.\n  await p.evaluate(() => { window.__GAME__.layout.record = true; });\n  await p.waitForTimeout(300);\n  const fits = await p.evaluate(() => {\n    const G = window.__GAME__; const h = G.engine.hud;\n    const lines = G.layout.rects.filter((r) => r.name === 'touch-message');\n    return { w: h.width, lines: lines.length, bad: lines.filter((r) => r.x < 0 || r.x + r.w > h.width).length, text: lines.map((r) => r.text).join(' ') };\n  });\n  assert(fits.lines >= 1, 'the message is drawn');\n  eq(fits.text, 'Controller or keyboard required', 'the words');\n  eq(fits.bad, 0, `fits in ${fits.w}`);\n\"\"\"),\n(\"\"\"  const browser = await launch();\n  const ctx = await browser.newContext({ ...devices['Pixel 7'] });\"\"\",\"\"\"  const browser = await launch();\n  const ctx = await browser.newContext({ ...devices['Pixel 7'] }); // portrait, touch, no hover\"\"\"),\n])\np='.gitignore'; s=open(p).read(); \nopen(p,'w').write(s)\nEOF\ntimeout 100 node tools/clip-sheet.mjs </dev/null 2>&1 | tail -2 | cut -c1-200\ncd check/clips && ls | wc -l; for n in Press StepL Cannonball Fly PaddleUp SlowClap Sneeze Flail Bow; do magick \"$n.png\" -resize 800x -background '#223' -gravity center -extent 800x \"../_$n.png\"; done; cd .. ; magick _Press.png _StepL.png _Cannonball.png _Fly.png -append clipsA.png; magick _PaddleUp.png _SlowClap.png _Sneeze.png _Flail.png _Bow.png -append clipsB.png; magick identify clipsA.png clipsB.png | cut -c1-60","description":"Write the clip-sheet tool and new tests, render the clip sheets","timeout":200000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16210,"cache_read_input_tokens":740764,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16210},"output_tokens":10,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"4782d2df-2a0f-457a-a049-0d8d684d024c","timestamp":"2026-11-05T07:57:20.872Z","request_id":"req_011CgjRWDt17qC4TShPKNymW","wire_tool_inputs":{"toolu_015Z5soBetJeBDZ5TmWdVbcr":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > tools/clip-sheet.mjs <<'EOF'\n// Preview clips without a GPU: node tools/clip-sheet.mjs [ClipName ...] writes check/clips/<name>.png.\nimport { mkdirSync, writeFileSync } from 'node:fs';\nimport { crc32, deflateSync } from 'node:zlib';\nimport { dirname, join } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { compileClips, Engine, HERO_MODEL, HERO_RIG, renderSheet, THREE } from '../pixel-engine.js';\nimport { dress } from '../src/art/avatar.js';\nimport { GAME_CLIPS } from '../src/art/clips.js';\n\nconst OUT = join(dirname(fileURLToPath(import.meta.url)), '..', 'check', 'clips');\nmkdirSync(OUT, { recursive: true });\n\nfunction png({ width, height, data }) {\n  const chunk = (type, body) => {\n    const t = Buffer.from(type), len = Buffer.alloc(4), crc = Buffer.alloc(4);\n    len.writeUInt32BE(body.length);\n    crc.writeUInt32BE(crc32(Buffer.concat([t, body])) >>> 0);\n    return Buffer.concat([len, t, body, crc]);\n  };\n  const raw = Buffer.alloc((width * 4 + 1) * height);\n  for (let y = 0; y < height; y++) Buffer.from(data.buffer, data.byteOffset + y * width * 4, width * 4).copy(raw, y * (width * 4 + 1) + 1);\n  const ihdr = Buffer.alloc(13);\n  ihdr.writeUInt32BE(width, 0); ihdr.writeUInt32BE(height, 4); ihdr[8] = 8; ihdr[9] = 6;\n  return Buffer.concat([Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]), chunk('IHDR', ihdr), chunk('IDAT', deflateSync(raw)), chunk('IEND', Buffer.alloc(0))]);\n}\n\nclass Holder { name = 'clip-sheet'; assets = [HERO_MODEL]; async setup(ctx) { this.model = (await ctx.loadModel(HERO_MODEL, { castShadow: false })).scene; } cameraTarget() { return new THREE.Vector3(); } }\nconst holder = new Holder();\nawait Engine.headless(holder, {});\n// Dress it first, so we judge the real silhouette and not the kit's hat and moustache.\ndress(holder.model, { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink', headband: 'red' });\nconst only = process.argv.slice(2);\nconst defs = GAME_CLIPS.filter((c) => !only.length || only.includes(c.name));\nconst clips = compileClips(defs, HERO_RIG, holder.model);\ndefs.forEach((def, i) => {\n  const frames = def.frames > 36 ? 5 : 6;\n  writeFileSync(join(OUT, `${def.name}.png`), png(renderSheet(holder.model, HERO_RIG, def, clips[i], { frames, views: ['front', 'side'], scale: 90, trails: false, skeleton: false })));\n});\nconsole.log(`${defs.length} sheets in check/clips`);\nprocess.exit(0);\nEOF\npython3 - <<'EOF'\ndef sub(p, pairs):\n    s=open(p).read()\n    for a,b in pairs:\n        if a not in s: print('MISSING in',p,':',a[:80])\n        s=s.replace(a,b)\n    open(p,'w').write(s)\nsub('tests/headless/core.mjs',[\n(\"\"\"await test('the line bank has 120+ lines',\"\"\",\"\"\"const SAMPLES = [\"Hello! I'm Ounce. Please step on me.\", 'Ow.', \"That was a joke. I can't feel pain. I can only keep records.\", 'How old do you feel? This is not binding.', \"Your Wobble Age is 68. Is that close? No? I'm so sorry.\", 'Thank you. I have written that down.', 'You wobbled 14 times. I only counted the ones you noticed.', \"Your left side is doing very well. I'll let your right side know.\", 'No change since yesterday. Which is, in a way, consistent.', 'Excellent! ...Compared to Dennis.', \"I'm not angry. Scales don't get angry. We get accurate.\", \"Have you been stretching? Please don't lie. I'm very sensitive.\", \"Today's concern: your ankles. I've been concerned all night.\", \"Good morning. You look rested. I can't see. But you felt rested.\", 'Kevin has been with us eleven years. He has never once held a pose.', 'This is a recording. The person in it is doing better than you.', 'I have been adding seven. To everyone. For years. It felt motivating.', 'See you tomorrow. Bring your knees.', 'You are a tree. A tree does not check its phone.', 'Your left knee has wandered off. Please collect it.', 'Breathe in. Not like that.', 'Good. Again. That was also good. Again.', 'Hold. You may blink on Thursday.', 'I am eighty-one. I say this so that you feel something.', 'Stillness is a muscle. So is regret. We train both here.', 'The floor is your friend. It has never once let go.', 'Both hips, new. Knee, new. Opinions, original.', 'I used to do this professionally. Not this. Something near it.', \"It's fine. It's just the one leg.\", \"I'm pacing myself.\", \"My gran says you're doing your best. She said it very slowly.\"];\nawait test('every sample line from the plan is in the game, verbatim', () => {\n  const blob = allLines().map((l) => l.text).join(' | ');\n  for (const s of SAMPLES) assert(blob.includes(s), `missing: ${s}`);\n});\nawait test('the line bank has 120+ lines beyond the samples', () => assert(allLines().length - SAMPLES.length >= 120, `${allLines().length}`));\nawait test('the old bank check',\"\"\"),\n])\ns=open('tests/headless/core.mjs').read()\ns=s.replace(\"\"\"await test('the old bank check', () => assert(allLines().length >= 120, `${allLines().length}`));\\n\"\"\",\"\")\nopen('tests/headless/core.mjs','w').write(s)\nsub('tests/headless/systems.mjs',[\n(\"\"\"  const toolDev = () => { const d = new DevScreen(); d.tabs.i = d.tabs.labels.length - 1; d.refresh(); return d; };\n  const item = (d, id) => d.menu.items.find((i) => i.id === id);\"\"\",\"\"\"  const toolDev = () => new DevScreen();\n  const item = (d, id) => d.toolItems().find((i) => i.id === id);\"\"\"),\n(\"\"\"await test('god mode keeps the Dot in the ring; autopilot plays', async () => {\"\"\",\"\"\"await test('dev: no tab shows more than 8 rows at once, and Go and Test hold every tool', async () => {\n  const { DevScreen } = await import('../../src/ui/screens/dev.js');\n  const d = new DevScreen();\n  for (let i = 0; i < d.tabs.labels.length; i++) {\n    d.tabs.set(i);\n    assert(d.menu.visibleRows() <= 8, `${d.tabs.current} shows ${d.menu.visibleRows()}`);\n    if (['Go', 'Test'].includes(d.tabs.current)) assert(d.menu.items.length <= 8, `${d.tabs.current} has ${d.menu.items.length} rows`);\n  }\n  eq(d.toolItems().length, 16);\n});\nawait test('every scene gives a real status line and a fingerprint', async () => {\n  App.store.create(0, 'Scenes', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  App.slot.phase = 'day'; App.slot.heardBeat = 7;\n  const list = [['title', {}], ['hub', {}], ['weighin', {}], ['report', {}], ['jar', {}], ['records', {}], ['locker', {}], ['ferry', {}], ['ending', {}], ['viewer', {}], ['join', {}], ['medley', { family: [{ kind: 'bot' }] }], ...ACTIVITY_IDS.map((id) => ['activity', { id, mode: 'dropin', noPractice: true }])];\n  for (const [id, args] of list) {\n    await h.go(id, args);\n    h.step(5);\n    const s = App.scene.status(App.ctx);\n    assert(typeof s === 'string' && s.length > 3 && s.includes(id === 'activity' ? args.id : id), `${id} status: ${s}`);\n    assert(typeof App.scene.fingerprint(App.ctx) === 'string', `${id} fingerprint`);\n    assert(engine.fingerprint().length > 0);\n    App.stack.clear();\n  }\n  App.store.resetAll();\n  await h.go('title', {});\n});\nawait test('tabs change with the wheel; lists that scroll keep the wheel', async () => {\n  const { SettingsScreen } = await import('../../src/ui/screens/settings.js');\n  const { DevScreen } = await import('../../src/ui/screens/dev.js');\n  const s = new SettingsScreen();\n  App.stack.push(s);\n  h.step(1);\n  engine.input.addPointer(0, 0, 1);\n  h.step(2);\n  eq(s.tabs.i, 1, 'Settings tab by wheel');\n  App.stack.pop(s);\n  const d = new DevScreen();\n  App.stack.push(d);\n  h.step(1);\n  engine.input.addPointer(0, 0, 1);\n  h.step(2);\n  eq(d.tabs.i, 0, 'Balance has 11 rows, so the wheel scrolls');\n  eq(d.menu.top, 1, 'scrolled');\n  App.stack.clear();\n});\nawait test('Step Class: pause stops the music; resume counts in and restarts at the current bar', async () => {\n  await h.go('activity', { id: 'step', mode: 'dropin', noPractice: true });\n  App.dev.autopilot = 'good';\n  h.step(60 * 3 + 60 * 12);\n  const s = App.scene;\n  eq(s.phase, 'play');\n  const { BAR_SECONDS } = await import('../../src/scenes/activity/step.js');\n  const before = s.localClock;\n  engine.input.setKey('Escape', true); h.step(1); engine.input.setKey('Escape', false); h.step(1);\n  eq(App.stack.top?.name, 'pause');\n  eq(engine.audio.playing, '', 'the music stopped');\n  engine.input.setKey('Escape', true); h.step(1); engine.input.setKey('Escape', false);\n  const bar = Math.floor(before / BAR_SECONDS);\n  near(s.localClock, bar * BAR_SECONDS, 1e-6, 'clock back at the bar');\n  assert(s.counting > 0, 'counting in');\n  h.step(30);\n  near(s.localClock, bar * BAR_SECONDS, 1e-6, 'held during the count');\n  h.step(120);\n  eq(engine.audio.playing, 'step', 'music back');\n  assert(s.localClock > bar * BAR_SECONDS, 'moving again');\n  App.dev.autopilot = null;\n});\nawait test('the island talks: classmates when you pass, Coach during a hold', async () => {\n  App.store.create(0, 'Talk', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  App.slot.phase = 'day'; App.slot.heardBeat = 7;\n  await h.go('hub', {});\n  const hub = App.scene;\n  const l = hub.locals.june;\n  hub.hero.teleport([l.at.x + 1, 0.1, l.at.z]);\n  hub.barkT = 99; hub.chatT = 0;\n  h.step(30);\n  eq(App.bark.who, 'june', 'June says something');\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  App.dev.autopilot = 'expert';\n  let coach = false;\n  for (let i = 0; i < 60 && !coach; i++) { h.step(30); if (App.bark.who === 'coach' && App.scene.phase === 'play') coach = true; }\n  assert(coach, 'Coach remarks during the hold');\n  App.dev.autopilot = null;\n  App.store.resetAll();\n  await h.go('title', {});\n});\nawait test('Island Jog is about 220 m', async () => {\n  await h.go('activity', { id: 'jog', mode: 'dropin', noPractice: true });\n  assert(App.scene.length > 205 && App.scene.length < 235, `${App.scene.length}`);\n  await h.go('title', {});\n});\nawait test('the wobble count reaches the remark', async () => {\n  const { ResultsScreen } = await import('../../src/ui/screens/results.js');\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  let found = false;\n  for (let i = 0; i < 40 && !found; i++) {\n    const r = new ResultsScreen(App.scene, { id: 'tree', stars: 1, score: 50, firstEver: false, wobbles: 9, mode: 'dropin' });\n    found = r.line.includes('You wobbled 9 times');\n  }\n  assert(found);\n  await h.go('title', {});\n});\nawait test('god mode keeps the Dot in the ring; autopilot plays', async () => {\"\"\"),\n])\nsub('tests/browser/game.mjs',[\n(\"\"\"await test('18 audio after a real click:\"\"\",\"\"\"await test('15 mouse details: slider drags, right click goes back, the wheel changes tabs, the pause icon opens pause', async () => {\n  const p = await page();\n  await bootPage(p);\n  await frames(p, 5);\n  const artToPage = (x, y) => p.evaluate(([ax, ay]) => { const h = window.__GAME__.engine.hud; const c = h.canvas.getBoundingClientRect(); return { x: c.left + (ax / h.width) * c.width, y: c.top + (ay / h.height) * c.height }; }, [x, y]);\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  await p.evaluate(() => { const m = window.__GAME__.stack.top.menu; m.focus = 3; });\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.name), 'settings');\n  // Drag the music slider all the way right, then put it back.\n  const r = await p.evaluate(() => { const row = window.__GAME__.stack.top.menu.rects[0]; return { sx: row.sx, sw: row.sw, y: row.y + row.h / 2 }; });\n  const from = await artToPage(r.sx + 2, r.y);\n  const to = await artToPage(r.sx + r.sw, r.y);\n  await p.mouse.move(from.x, from.y);\n  await frames(p, 3);\n  await p.mouse.down();\n  await frames(p, 2);\n  await p.mouse.move(to.x, to.y);\n  await frames(p, 4);\n  await p.mouse.up();\n  await frames(p, 3);\n  const after = await p.evaluate(() => window.__GAME__.engine.audio.volume.music);\n  assert(after > 0.8, `slider dragged to ${after}`);\n  await p.evaluate(() => { const G = window.__GAME__; G.settings.music = 0.1; G.saveSettings(); });\n  await p.mouse.wheel(0, 120);\n  await frames(p, 4);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.tabs.i), 1, 'wheel changed tab');\n  await p.mouse.click(to.x, to.y, { button: 'right' });\n  await frames(p, 4);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.name), 'main', 'right click is Back');\n  // The pause icon, top right, while the mouse moves.\n  await go(p, 'activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  await p.keyboard.press('Enter');\n  await p.waitForFunction(() => window.__GAME__.scene.phase === 'play', null, { timeout: 30000 });\n  await p.mouse.move(300, 300);\n  await frames(p, 2);\n  await p.mouse.move(320, 310);\n  await frames(p, 2);\n  const icon = await p.evaluate(() => window.__GAME__.scene.pauseIconHit);\n  assert(icon, 'icon shown while the mouse moves');\n  const at = await artToPage(icon.x + 8, icon.y + 8);\n  await p.mouse.move(at.x, at.y);\n  await frames(p, 2);\n  await p.mouse.down();\n  await frames(p, 3);\n  await p.mouse.up();\n  await frames(p, 3);\n  eq(await p.evaluate(() => window.__GAME__.stack.top?.name), 'pause', 'icon opens pause');\n  eq(errors.length, 0, errors.join(' | '));\n  await p.context().close();\n});\n\nfor (const [W, H, artW, artH] of [[1920, 1080, 480, 270], [1280, 720, 427, 240], [640, 360, 640, 360]]) {\n  await test(`19 no layout overflow in a real page at ${W}x${H}`, async () => {\n    const p = await page({ viewport: { width: W, height: H } });\n    await bootPage(p);\n    await frames(p, 6);\n    const size = await p.evaluate(() => { const h = window.__GAME__.engine.hud; return `${h.width}x${h.height}`; });\n    eq(size, `${artW}x${artH}`, 'art size');\n    const check = async (where) => {\n      await frames(p, 4);\n      const bad = await p.evaluate(() => { const G = window.__GAME__; const h = G.engine.hud; return G.layout.overflow(h.width, h.height).filter((r) => r.name !== 'dial').slice(0, 3).map((r) => `${r.name} \"${r.text}\" ${r.x},${r.y} ${r.w}x${r.h}`); });\n      assert(!bad.length, `${where}: ${bad.join('; ')}`);\n    };\n    await p.evaluate(() => { window.__GAME__.layout.record = true; });\n    await check('title');\n    await p.keyboard.press('Enter');\n    await check('main menu');\n    await p.evaluate(() => { const G = window.__GAME__; G.store.create(0, 'Kimberly', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' }); G.slot.phase = 'day'; G.slot.heardBeat = 7; });\n    for (const [id, args] of [['hub', {}], ['activity', { id: 'warrior', mode: 'week', noPractice: true }], ['activity', { id: 'step', mode: 'week', noPractice: true }], ['medley', { family: [{ kind: 'keyboard' }, { kind: 'bot' }, { kind: 'bot' }, { kind: 'bot' }] }], ['records', {}], ['locker', {}]]) {\n      await go(p, id, args);\n      await check(`${id} ${args.id ?? ''}`);\n      if (id === 'activity') { await p.keyboard.press('Enter'); await check(`${args.id} countdown`); await p.waitForFunction(() => window.__GAME__.scene.phase === 'play', null, { timeout: 30000 }); await check(`${args.id} play`); }\n    }\n    eq(errors.length, 0, errors.join(' | '));\n    await p.context().close();\n  });\n}\n\nawait test('20 About: every section is there, and CREDITS.md is shipped in full and scrolls', async () => {\n  const p = await page();\n  await bootPage(p);\n  const a = await p.evaluate(async () => {\n    const G = window.__GAME__;\n    await frames0(10);\n    return null;\n    function frames0() { return new Promise((r) => setTimeout(r, 200)); }\n  });\n  void a;\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  await p.evaluate(() => { window.__GAME__.stack.top.menu.focus = 4; });\n  await p.keyboard.press('Enter');\n  await frames(p, 4);\n  const info = await p.evaluate(() => {\n    const s = window.__GAME__.stack.top;\n    const titles = s.pages.map((pg) => pg.title);\n    const text = (t) => s.pages.find((pg) => pg.title === t).rows.map((r) => r.h ?? r.t).join(' ');\n    return { name: s.name, titles, note: text('Please Note'), source: text('Source Information'), testing: text('Testing Feedback'), engine: text('Engine Feedback'), prompt: text('Prompt Feedback'), credits: text('CREDITS.md').length };\n  });\n  eq(info.name, 'about');\n  for (const t of ['Credits', 'Please Note', 'Source Information', 'Testing Feedback', 'Engine Feedback', 'Prompt Feedback', 'Engine Kit Credits', 'CREDITS.md']) assert(info.titles.includes(t), `page ${t}`);\n  assert(info.note.includes('This is not medical advice. Ounce is a scale.'), 'disclaimer');\n  for (const f of ['Date', 'Source', 'Plan', 'Genre', 'Perspective', 'Tech', 'Art Direction', 'Animation', 'Audio', 'Online', 'Testing', 'Research', 'Environment', 'Model', 'Usage', 'added on import']) assert(info.source.includes(f), `field ${f}`);\n  assert(!/\\\\bunknown\\\\b/.test(info.testing + info.engine + info.prompt), 'every answer filled in');\n  assert(info.credits > 30000, `CREDITS.md text is ${info.credits} chars`);\n  await p.evaluate(() => { const s = window.__GAME__.stack.top; s.i = s.pages.findIndex((pg) => pg.title === 'CREDITS.md'); });\n  await frames(p, 3);\n  await p.keyboard.down('ArrowDown');\n  await frames(p, 30);\n  await p.keyboard.up('ArrowDown');\n  assert(await p.evaluate(() => window.__GAME__.stack.top.scroll > 3), 'it scrolls');\n  await p.keyboard.press('ArrowRight');\n  await frames(p, 3);\n  eq(await p.evaluate(() => window.__GAME__.stack.top.i), 0, 'arrows page round');\n  await p.context().close();\n});\n\nawait test('18 audio after a real click:\"\"\"),\n])\ns=open('tests/browser/game.mjs').read()\ns=s.replace(\"\"\"  const a = await p.evaluate(async () => {\n    const G = window.__GAME__;\n    await frames0(10);\n    return null;\n    function frames0() { return new Promise((r) => setTimeout(r, 200)); }\n  });\n  void a;\n\"\"\",\"\"\"  await frames(p, 5);\n\"\"\")\nopen('tests/browser/game.mjs','w').write(s)\nsub('tests/browser/devices.mjs',[\n(\"\"\"  // The message fits, even on a narrow portrait art size.\n  const fits = await p.evaluate(() => {\n    const G = window.__GAME__;\n    G.layoutCheck = true;\n    return { w: G.engine.hud.width };\n  });\n  assert(fits.w > 100);\n\"\"\",\"\"\"  // The message fits, even on a narrow portrait art size.\n  await p.evaluate(() => { window.__GAME__.layout.record = true; });\n  await p.waitForTimeout(300);\n  const fits = await p.evaluate(() => {\n    const G = window.__GAME__; const h = G.engine.hud;\n    const lines = G.layout.rects.filter((r) => r.name === 'touch-message');\n    return { w: h.width, lines: lines.length, bad: lines.filter((r) => r.x < 0 || r.x + r.w > h.width).length, text: lines.map((r) => r.text).join(' ') };\n  });\n  assert(fits.lines >= 1, 'the message is drawn');\n  eq(fits.text, 'Controller or keyboard required', 'the words');\n  eq(fits.bad, 0, `fits in ${fits.w}`);\n\"\"\"),\n(\"\"\"  const browser = await launch();\n  const ctx = await browser.newContext({ ...devices['Pixel 7'] });\"\"\",\"\"\"  const browser = await launch();\n  const ctx = await browser.newContext({ ...devices['Pixel 7'] }); // portrait, touch, no hover\"\"\"),\n])\np='.gitignore'; s=open(p).read(); \nopen(p,'w').write(s)\nEOF\ntimeout 100 node tools/clip-sheet.mjs </dev/null 2>&1 | tail -2 | cut -c1-200\ncd check/clips && ls | wc -l; for n in Press StepL Cannonball Fly PaddleUp SlowClap Sneeze Flail Bow; do magick \"$n.png\" -resize 800x -background '#223' -gravity center -extent 800x \"../_$n.png\"; done; cd .. ; magick _Press.png _StepL.png _Cannonball.png _Fly.png -append clipsA.png; magick _PaddleUp.png _SlowClap.png _Sneeze.png _Flail.png _Bow.png -append clipsB.png; magick identify clipsA.png clipsB.png | cut -c1-60","description":"Write the clip-sheet tool and new tests, render the clip sheets","timeout":200000}}}
