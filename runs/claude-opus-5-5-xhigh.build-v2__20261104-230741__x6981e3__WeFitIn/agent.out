 '../../data/classmates.js';\",\"import { LOOKS } from '../../data/classmates.js';\\nimport { HEADER } from '../../data/games.js';\")\nopen('src/scenes/activity/header.js','w').write(s)\ns=open('src/scenes/activity/pier.js').read()\ns,n=re.subn(r\"export const PIER = \\{.*?\\};\\n\",\"\",s,count=1); assert n==1\ns=s.replace(\"import { LOOKS } from '../../data/classmates.js';\",\"import { LOOKS } from '../../data/classmates.js';\\nimport { PIER } from '../../data/games.js';\")\nopen('src/scenes/activity/pier.js','w').write(s)\n# Lanterns at dusk: lamps you can see, and lights the kit's pool hands out\nsub('src/scenes/report.js',[\n(\"\"\"    this.lantern = ctx.lights.request({ position: [3, 2.4, 2], color: 0xffcf80, intensity: 8, radius: 9, flicker: 'torch' });\"\"\",\"\"\"    // Dusk: the pavilion's lanterns come on along the terrace.\n    this.lanterns = [[0.6, 0.4], [6.6, -1.2]].map(([x, z]) => {\n      place(ctx, 'lamp-post', { at: [x, 0, z] });\n      return ctx.lights.request({ position: [x, 2.5, z + 0.4], color: 0xffcf80, intensity: 8, radius: 8, flicker: 'torch' });\n    });\"\"\"),\n(\"\"\"  dispose() { this.lantern?.release?.(); }\"\"\",\"\"\"  dispose() { for (const l of this.lanterns ?? []) l.release?.(); }\"\"\"),\n])\nsub('src/scenes/ending.js',[\n(\"\"\"    this.kevin = new Kevin(ctx, { at: [-1.4, 0, 1.8], yaw: 0.8 });\"\"\",\"\"\"    this.kevin = new Kevin(ctx, { at: [-1.4, 0, 1.8], yaw: 0.8 });\n    this.lanterns = [[-6, -2], [6.4, -2]].map(([x, z]) => {\n      place(ctx, 'lamp-post', { at: [x, 0, z] });\n      return ctx.lights.request({ position: [x, 2.5, z + 0.4], color: 0xffcf80, intensity: 10, radius: 9, flicker: 'torch' });\n    });\"\"\"),\n(\"\"\"import { Kevin, Ounce } from '../art/props.js';\"\"\",\"\"\"import { Kevin, Ounce, place } from '../art/props.js';\"\"\"),\n])\n# Research, exactly as it happened\nsub('src/data/about.js',[\n(\"\"\"  research: 'Read the kit guides and the hub README, searched API.md. The director\\\\'s plan included engine and hub research and spikes',\"\"\",\"\"\"  research: 'Read GUIDE.md, ASSETS.md and the hub README whole, searched API.md and the type files, and read the engine bundle for its font table and audio fields. No web research. The director\\\\'s plan included engine and hub research and spikes',\"\"\"),\n])\n# Layout test: the plan's margin, and a list of what's outside it\nsub('tests/headless/layout.mjs',[\n(\"\"\"    const bad = layout.overflow(hud.width, hud.height).filter((r) => !['dial', 'star'].includes(r.name) || r.x < -1);\"\"\",\"\"\"    const bad = layout.overflow(hud.width, hud.height, SAFE);\"\"\"),\n(\"\"\"const SIZES = [\"\"\",\"\"\"const SAFE = 12;\nconst SIZES = [\"\"\"),\n])\nEOF\ncat > .scratch/safe.mjs <<'EOF'\n// Every rect outside the 12 px margin, by name, across the layout test's screens at 480x270.\nprocess.env.SAFE_REPORT='1';\nEOF\nsed -n 1,5p src/data/about.js >/dev/null; timeout 280 node tests/headless/layout.mjs </dev/null 2>/dev/null | grep -o '@@RESULTS.*' | python3 -c \"\nimport json,sys,re\nd=json.loads(sys.stdin.read().split(' ',1)[1])\nfor r in d:\n    if not r['ok']: print('FAIL',r['name'],'::',r['detail'].split('|')[0][:230])\nprint(sum(1 for r in d if r['ok']),'/',len(d))\"","description":"Apply plan details and run the layout test with the strict 12 px margin","timeout":295000}}}
