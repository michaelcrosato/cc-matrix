{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjMo2RC1Tfzyk8NuzTxR","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"The playthrough exposed a bug where Esc in the Jar opened the pause menu instead of going back. I'm fixing that, then writing the remaining tests for pause, dev tools, attract, Medley, layout and the browser.\n\n","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2879,"cache_read_input_tokens":567429,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2879},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"0bf4c1c2-de3d-41b8-b8ad-96397cc45cdf","timestamp":"2026-11-05T07:07:35.786Z","request_id":"req_011CgjMo25r45katUhFQQE5J","narration_block_indexes":[0],"thinking_duration_ms":2,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjMo2RC1Tfzyk8NuzTxR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013J678YP2gqh46M9cKEZLxB","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\nfor p in ['src/scenes/jar.js','src/scenes/records.js']:\n    s=open(p).read()\n    s=s.replace(\"  canPause = true;\\n\",\"  canPause = false; // Esc is Back here\\n\")\n    open(p,'w').write(s)\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- Run log: bot sweep caught\",\"- Run log: test runner race lost results (fixed); playthrough caught Esc in Jar/Hall opening pause instead of Back; bot sweep caught\")\nopen(p,'w').write(s)\nEOF\ncat > tests/headless/systems.mjs <<'EOF'\n// 7 Pause, 8 Dev, 9 Attract, 11 Medley, 19 layout.\nimport { assert, boot, done, eq, near, test, App, tick } from '../lib.mjs';\nimport { T, TUNABLE_DEFS, resetTunables } from '../../src/core/tunables.js';\nimport { layout } from '../../src/ui/layout.js';\nimport { ATTRACT_PLAYLIST, ATTRACT_SECONDS } from '../../src/scenes/attract.js';\nimport { ACTIVITY_IDS } from '../../src/data/activities.js';\nimport { MEDLEY } from '../../src/data/medley.js';\nimport { MEDLEY_LENGTH } from '../../src/scenes/medley.js';\nimport { GhostDriver } from '../../src/core/drivers.js';\nimport { dripsFor, starsFor, ageFromTests } from '../../src/core/week.js';\nimport { ACTIVITIES } from '../../src/data/activities.js';\nimport { repTarget } from '../../src/scenes/activity/reps.js';\n\nconst h = await boot({ scene: 'title' });\nconst { engine } = h;\n\n// ---- Pause ------------------------------------------------------------------------------------\nawait test('pause: timeScale 0, fixedUpdate frozen, menu navigable, resume exact', async () => {\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  App.dev.autopilot = 'good';\n  h.step(60 * 6);\n  const s = App.scene;\n  eq(s.phase, 'play');\n  h.press('Escape');\n  eq(App.stack.top?.name, 'pause');\n  eq(engine.timeScale, 0);\n  const fp = engine.fingerprint();\n  const t = s.eventT;\n  const time = engine.time;\n  h.step(120);\n  eq(engine.fingerprint(), fp, 'frozen');\n  eq(s.eventT, t);\n  eq(engine.time, time, 'game time frozen');\n  const f0 = App.stack.top.menu.focus;\n  h.press('ArrowDown');\n  assert(App.stack.top.menu.focus !== f0, 'menu moves');\n  h.press('ArrowUp');\n  h.press('Escape');\n  eq(App.stack.open, false, 'resumed by Back');\n  eq(engine.timeScale, 1);\n  eq(s.eventT, t, 'resume is exact');\n  h.step(10);\n  assert(s.eventT > t, 'runs again');\n  App.dev.autopilot = null;\n});\nawait test('pause: every item works: Restart, Settings, How to play, About, Dev Tools', async () => {\n  const open = () => { h.press('Escape'); eq(App.stack.top?.name, 'pause'); };\n  const pick = (id) => {\n    const m = App.stack.top.menu; const i = m.items.findIndex((x) => x.id === id);\n    assert(i >= 0, id);\n    m.focus = i;\n    h.press('Enter');\n  };\n  open();\n  for (const [id, name] of [['settings', 'settings'], ['howto', 'howto'], ['about', 'about'], ['dev', 'dev']]) {\n    pick(id);\n    eq(App.stack.top?.name, name, id);\n    h.step(3);\n    h.press('Escape');\n    eq(App.stack.top?.name, 'pause', `back from ${id}`);\n  }\n  pick('resume');\n  eq(App.stack.open, false);\n  open();\n  pick('restart');\n  await h.settle();\n  eq(App.scene.phase, 'intro', 'restarted');\n  eq(engine.timeScale, 1, 'time back after restart');\n});\nawait test('Create + Options does not pause (the hub\\'s chord)', async () => {\n  engine.input.setKey('PadCreate', true);\n  h.press('PadOptions');\n  eq(App.stack.open, false);\n  engine.input.setKey('PadCreate', false);\n  h.press('PadOptions');\n  eq(App.stack.top?.name, 'pause');\n  h.press('Escape');\n});\n\n// ---- Settings ---------------------------------------------------------------------------------\nawait test('settings: music defaults to 10%, and every control takes effect', async () => {\n  eq(App.settings.music, 0.1);\n  eq(engine.audio.volume.music, 0.1);\n  App.settings.music = 0.3; App.saveSettings();\n  near(engine.audio.volume.music, 0.3, 1e-6);\n  App.settings.music = 0.1; App.saveSettings();\n  App.settings.glyphs = 'xbox'; App.saveSettings();\n  eq(App.device.glyphs, 'xbox');\n  App.settings.glyphs = 'ps'; App.saveSettings();\n  App.settings.gentle = true;\n  near(App.ringOf(0.4), 0.5, 1e-6);\n  near(App.noiseScale(), 0.8, 1e-6);\n  App.settings.gentle = false;\n  App.settings.look = 'arcade'; App.saveSettings();\n  eq(engine.settings.values.look, 'arcade');\n  App.settings.look = 'default'; App.saveSettings();\n  eq(engine.settings.values.look, undefined);\n  App.settings.mouseLeanRadius = 90; App.saveSettings();\n  eq(T.mouseLeanRadius, 90);\n  App.settings.mouseLeanRadius = 70; App.saveSettings();\n});\n\n// ---- Dev tools: every slider changes live behaviour ------------------------------------------\nfunction dotRun(fn) {\n  resetTunables();\n  fn();\n  return null;\n}\nvoid dotRun;\nconst liveChecks = {\n  async dotInstability(run) { return run('tree'); }, async dotAuthority(run) { return run('tree'); }, async dotDamping(run) { return run('tree'); },\n  async dotNoise(run) { return run('tree'); }, async dotLag(run) { return run('tree'); },\n};\nasync function fingerprintAfter(id, frames = 300, skill = 'average', extra = {}) {\n  await h.go('activity', { id, mode: 'dropin', noPractice: true, ...extra });\n  App.dev.autopilot = skill;\n  h.step(10);\n  h.step(60 * 3 + frames);\n  const fp = engine.fingerprint();\n  App.dev.autopilot = null;\n  return fp;\n}\nconst PROBE = {\n  dotInstability: 'tree', dotAuthority: 'tree', dotDamping: 'tree', dotNoise: 'tree', dotLag: 'tree', ringScale: 'tree', gustForce: 'slackline',\n  breathBonus: 'warrior', repLag: 'squats', repFatigue: 'squats', repTempoScale: 'squats',\n  hoopLow: 'hoop', hoopHigh: 'hoop', hoopLiftRate: 'hoop', headerInterval: 'header', slackWalkInst: 'slackline', trayGravity: 'tray', trayMaxTilt: 'tray',\n  jogTargetCadence: 'jog', pierBoost: 'pier', stepWindow: 'step', stepOffsetMs: 'step',\n};\nvoid liveChecks;\nfor (const d of TUNABLE_DEFS) {\n  const probe = PROBE[d.id];\n  if (!probe) continue;\n  await test(`dev slider ${d.id} changes live behaviour`, async () => {\n    resetTunables();\n    const frames = d.id === 'gustForce' || d.id === 'slackWalkInst' ? 60 * 8 : d.id === 'pierBoost' ? 60 * 10 : d.id === 'stepWindow' || d.id === 'stepOffsetMs' ? 60 * 12 : 300;\n    const skill = d.id === 'hoopHigh' || d.id === 'hoopLow' ? 'average' : d.id === 'stepWindow' || d.id === 'stepOffsetMs' ? 'sloppy' : 'average';\n    const a = await fingerprintAfter(probe, frames, skill);\n    T[d.id] = d.id === 'stepOffsetMs' ? 150 : d.id === 'stepWindow' ? 0.5 : d.id === 'hoopLow' ? 1.6 : d.id === 'hoopHigh' ? 1.05 : d.id === 'dotLag' ? d.def * 3 : d.max;\n    const b = await fingerprintAfter(probe, frames, skill);\n    resetTunables();\n    assert(a !== b, `${probe} fingerprint unchanged: ${a}`);\n  });\n}\nawait test('dev slider mouseLeanRadius changes the lean', async () => {\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  h.press('Enter');\n  h.step(30);\n  App.device.last = 'mouse';\n  const s = App.scene;\n  const lane = s.playerLane;\n  engine.input.setPointer(0.2, 0.2, false);\n  h.step(3);\n  const x0 = lane.inp.x;\n  T.mouseLeanRadius = 140;\n  h.step(3);\n  const x1 = lane.inp.x;\n  resetTunables();\n  assert(Math.abs(x0) > Math.abs(x1) * 1.5, `${x0} vs ${x1}`);\n  engine.input.setPointer(0, 0, false);\n  App.device.last = 'keyboard';\n});\nawait test('dev slider dripRate, starThresholdScale, ageTrainingWeight change the economy', () => {\n  const d0 = dripsFor(2, 60);\n  T.dripRate = 2;\n  assert(dripsFor(2, 60) === d0 * 2);\n  T.dripRate = 1;\n  const s0 = starsFor(ACTIVITIES.tree, 80);\n  T.starThresholdScale = 1.5;\n  assert(starsFor(ACTIVITIES.tree, 80) < s0);\n  T.starThresholdScale = 1;\n  const a0 = ageFromTests([0.5], 10);\n  T.ageTrainingWeight = 2;\n  assert(ageFromTests([0.5], 10) < a0);\n  resetTunables();\n});\nawait test('dev: one button resets the tab, one resets everything, export lists changes', async () => {\n  const { DevScreen } = await import('../../src/ui/screens/dev.js');\n  const dev = new DevScreen();\n  T.dotNoise = 2; T.repLag = 0.3;\n  dev.menu.items.find((i) => i.id === 'resetTab').action();\n  eq(T.dotNoise, 0.8, 'tab');\n  eq(T.repLag, 0.3, 'other tab untouched');\n  dev.menu.items.find((i) => i.id === 'export').action();\n  assert(dev.exported.includes('repLag'));\n  dev.menu.items.find((i) => i.id === 'resetAll').action();\n  eq(T.repLag, 0.1, 'all');\n});\nawait test('dev tools: every tool works', async () => {\n  const { DevScreen } = await import('../../src/ui/screens/dev.js');\n  const toolDev = () => { const d = new DevScreen(); d.tabs.i = d.tabs.labels.length - 1; d.refresh(); return d; };\n  const item = (d, id) => d.menu.items.find((i) => i.id === id);\n  App.store.create(1, 'Dev', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  App.slot.phase = 'day';\n  await h.go('hub', {});\n  let d = toolDev();\n  App.stack.push(d);\n  item(d, 'god').action(); eq(App.dev.god, true); item(d, 'god').action(); eq(App.dev.god, false);\n  item(d, 'overlay').action(); h.step(2); eq(App.dev.overlay, true); item(d, 'overlay').action();\n  item(d, 'hideHud').action(); h.step(2); eq(App.dev.hideHud, true); item(d, 'hideHud').action();\n  item(d, 'unlock').action(); eq(App.dev.allUnlocked, true); item(d, 'unlock').action();\n  item(d, 'autopilot').adjust(1); eq(App.dev.autopilot, 'idle'); item(d, 'autopilot').adjust(-1); eq(App.dev.autopilot, null);\n  item(d, 'timescale').adjust(1); eq(App.dev.timeScale, 1.25); item(d, 'timescale').adjust(-1); eq(App.dev.timeScale, 1);\n  const before = App.slot.drips;\n  item(d, 'drips').action();\n  eq(App.slot.drips, before + 50);\n  await tick(); await tick();\n  assert(App.slot.wardrobe.length >= 2, 'milestones from 50 Drips');\n  item(d, 'freeCam').action(); h.step(2); eq(engine.camera.preset, 'free'); item(d, 'freeCam').action(); h.step(2); eq(engine.camera.preset, 'iso');\n  item(d, 'dialogue').action();\n  eq(App.stack.top?.name, 'dialogue');\n  h.press('Enter'); h.press('Enter'); h.step(2);\n  item(d, 'sound').action();\n  eq(App.stack.top?.name, 'soundtest');\n  for (const it of App.stack.top.menu.items) it.action?.();\n  h.step(2);\n  App.stack.pop();\n  // Finish the current activity with N stars.\n  d.closeAll();\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  d = toolDev();\n  App.stack.push(d);\n  item(d, 'finish').adjust(-1);\n  eq(d.starPick, 2);\n  item(d, 'finish').action();\n  eq(App.scene.lastResult.stars, 2);\n  eq(App.stack.top?.name, 'results');\n  // Go to a day, a scene, an activity.\n  d = toolDev();\n  App.stack.push(d);\n  d.dayPick = 4;\n  item(d, 'day').action();\n  await h.settle();\n  eq(App.slot.day, 4);\n  eq(App.scene.id, 'weighin');\n  d = toolDev();\n  App.stack.push(d);\n  d.sceneI = d.constructor === DevScreen ? 3 : 3;\n  item(d, 'scene').action();\n  await h.settle();\n  eq(App.scene.id, 'report');\n  d = toolDev();\n  App.stack.push(d);\n  d.activityI = ACTIVITY_IDS.indexOf('hoop');\n  item(d, 'activity').action();\n  await h.settle();\n  eq(App.scene.activity, 'hoop');\n  d = toolDev();\n  App.stack.push(d);\n  item(d, 'anim').action();\n  await h.settle();\n  eq(App.scene.id, 'viewer');\n  h.press('ArrowRight'); h.step(10);\n  assert(App.scene.i === 1);\n  h.press('Escape');\n  await h.settle();\n  d = toolDev();\n  App.stack.push(d);\n  item(d, 'resetSave').action();\n  await h.settle();\n  eq(App.scene.id, 'title');\n  eq(App.store.data.slots[1], null);\n  App.stack.clear();\n  App.dev = { god: false, autopilot: null, overlay: false, hideHud: false, timeScale: 1, freeCam: false, allUnlocked: false };\n});\nawait test('god mode keeps the Dot in the ring; autopilot plays', async () => {\n  await h.go('activity', { id: 'plank', mode: 'dropin', noPractice: true });\n  h.press('Enter');\n  App.dev.god = true;\n  h.step(60 * 3 + 60 * 10);\n  const s = App.scene;\n  const ring = s.event.ring();\n  assert(Math.hypot(s.playerLane.dot.x, s.playerLane.dot.y) <= ring + 0.01, 'held');\n  App.dev.god = false;\n});\n\n// ---- Attract ----------------------------------------------------------------------------------\nawait test('attract: 10 s idle on the title starts it', async () => {\n  await h.go('title', {});\n  engine.input.setKey('Enter', false);\n  h.step(60 * 9);\n  eq(App.attract, null, 'not yet');\n  h.step(60 * 1 + 5);\n  assert(App.attract, 'started');\n  await h.settle();\n  eq(App.scene.id, 'hub');\n});\nawait test('attract: any input exits: key, click, mouse move, wheel, stick', async () => {\n  const inputs = {\n    key() { engine.input.setKey('KeyQ', true); h.step(2); engine.input.setKey('KeyQ', false); },\n    click() { engine.input.setButtons(1); h.step(1); engine.input.setButtons(0); h.step(1); },\n    move() { engine.input.setPointer(0.5, 0.5, false); h.step(2); engine.input.setPointer(0, 0, false); },\n    wheel() { engine.input.addPointer(0, 0, 1); h.step(2); },\n    pad() { engine.input.setKey('PadCross', true); h.step(2); engine.input.setKey('PadCross', false); },\n  };\n  for (const [name, fn] of Object.entries(inputs)) {\n    if (!App.attract) { App.startAttract(); await h.settle(); }\n    h.step(30);\n    fn();\n    eq(App.attract, null, `${name} exits`);\n    await h.settle();\n    eq(App.scene.id, 'title', `${name} returns to title`);\n    h.step(5);\n  }\n});\nawait test('attract: 10 s idle on a menu starts it; no trigger during play or on pause', async () => {\n  await h.go('title', {});\n  h.press('Enter');\n  eq(App.stack.top?.name, 'main');\n  h.step(60 * 10 + 5);\n  assert(App.attract, 'started from a menu');\n  App.attract.exit();\n  await h.settle();\n  h.step(5);\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  h.step(60 * 12);\n  eq(App.attract, null, 'not during an intro');\n  h.press('Enter');\n  h.step(60 * 12);\n  eq(App.attract, null, 'not during play');\n  h.press('Escape');\n  h.step(60 * 12);\n  eq(App.attract, null, 'not on the pause menu');\n  h.press('Escape');\n});\nawait test('attract: a full loop covers every item with no errors, then comes round again', async () => {\n  await h.go('title', {});\n  App.startAttract();\n  await h.settle();\n  const seen = new Set();\n  let n = 0;\n  const startLoops = App.attract.loops;\n  while (App.attract.loops === startLoops && n < 60 * ATTRACT_SECONDS * (ATTRACT_PLAYLIST.length + 2)) {\n    h.step(15);\n    await tick();\n    n += 15;\n    seen.add(App.scene.activity ?? App.scene.id);\n    if (App.loading) await h.settle();\n  }\n  for (const item of ATTRACT_PLAYLIST) assert(seen.has(item.args.id ?? item.scene), `${item.args.id ?? item.scene} never showed: ${[...seen].join(',')}`);\n  eq(h.errors().length, 0, h.errors().join(' | '));\n  eq(App.scene.resultsShown ?? false, false);\n  App.attract.exit();\n  await h.settle();\n});\nawait test('attract: each activity actually plays, cheating freely', async () => {\n  for (const id of ['tree', 'hoop', 'header', 'step', 'slackline', 'tray', 'pier', 'jog', 'squats']) {\n    await h.go('activity', { id, attract: true });\n    const fp = engine.fingerprint();\n    h.step(60 * 6);\n    assert(engine.fingerprint() !== fp, `${id} stands still`);\n    assert(App.scene.phase === 'play', `${id} phase ${App.scene.phase}`);\n    assert(App.scene.result().score >= 0);\n  }\n  await h.go('title', {});\n});\n\n// ---- The Medley -------------------------------------------------------------------------------\nconst FAMILY = [{ kind: 'bot', skill: 'expert' }, { kind: 'bot', skill: 'good' }, { kind: 'bot', skill: 'average' }, { kind: 'bot', skill: 'idle' }];\nawait test('medley: 4 bot lanes, windows respected, scores in range, podium, rematch', async () => {\n  await h.go('medley', { family: FAMILY, picks: { pose: 'tree', beat: 'hoop', header: 'header' } });\n  const s = App.scene;\n  eq(s.lanes.length, 4);\n  eq(s.phase, 'intro');\n  h.step(60 * MEDLEY.introSeconds + 2);\n  eq(s.phase, 'play');\n  eq(s.area, 0, 'first window');\n  h.step(60 * MEDLEY.eventSeconds + 30);\n  eq(s.area, -1, 'a break between events');\n  eq(s.lanes[0].points.length, 1);\n  h.step(60 * (MEDLEY.breakSeconds + 1));\n  eq(s.area, 1, 'second window');\n  eq(s.current.kind, 'hoop');\n  h.step(60 * (MEDLEY.eventSeconds + MEDLEY.breakSeconds));\n  eq(s.area, 2, 'third window');\n  eq(s.current.kind, 'header');\n  h.step(60 * MEDLEY.eventSeconds + 30);\n  eq(s.phase, 'podium');\n  eq(s.clock.now() >= MEDLEY_LENGTH - 0.2, true);\n  for (const l of s.lanes) {\n    eq(l.points.length, 3);\n    for (const p of l.points) assert(p >= 0 && p <= 1000, `points ${p}`);\n    assert(l.total >= 0 && l.total <= 3000);\n  }\n  assert(s.lanes[0].total > s.lanes[3].total, 'expert beats idle');\n  eq(s.order[0], s.lanes[0], 'expert on top');\n  assert(s.awards.length === 4);\n  h.step(10);\n  eq(h.errors().length, 0, h.errors().join(' | '));\n  s.menu.items.find((i) => i.id === 'rematch').action();\n  await h.settle();\n  eq(App.scene.id, 'medley');\n  eq(App.scene.phase, 'intro');\n});\nfor (const [beat, kind] of [['squats', 'reps'], ['lunges', 'reps'], ['step', 'step']]) {\n  await test(`medley: the Beat event ${beat} runs in its window and scores`, async () => {\n    await h.go('medley', { family: FAMILY, picks: { pose: 'heron', beat, header: 'header' } });\n    const s = App.scene;\n    h.step(60 * MEDLEY.introSeconds + 2);\n    h.step(60 * (MEDLEY.eventSeconds + MEDLEY.breakSeconds) + 5);\n    eq(s.current.kind, kind);\n    h.step(60 * (MEDLEY.eventSeconds - 2));\n    assert(s.current.normalized(s.lanes[0]) > s.current.normalized(s.lanes[3]), `expert over idle: ${s.current.normalized(s.lanes[0])} vs ${s.current.normalized(s.lanes[3])}`);\n    eq(h.errors().length, 0);\n  });\n}\nawait test('medley: picks come from a seeded stream, the same on every run', async () => {\n  await h.go('medley', { family: FAMILY });\n  const a = App.scene.picks.join();\n  await h.go('medley', { family: FAMILY });\n  eq(App.scene.picks.join(), a);\n  for (let i = 0; i < 3; i++) assert(MEDLEY.events[i].options.includes(App.scene.picks[i]), 'pick from options');\n});\n\n// A pretend hub, in-process: the protocol's events, by hand.\nfunction fakeHub(info) {\n  const on = {};\n  const hub = {\n    active: true, sent: [], progressed: [], results: [], answers: [], t: -Infinity,\n    on(ev, fn) { (on[ev] ??= []).push(fn); return () => { on[ev] = on[ev].filter((f) => f !== fn); }; },\n    emit(ev, ...a) { for (const f of on[ev] ?? []) f(...a); },\n    time() { return this.t; },\n    answer(x) { this.answers.push(x); },\n    send(d, o) { this.sent.push({ d, o }); return true; },\n    progress(p) { this.progressed.push(p); },\n    result(r) { this.results.push(r); },\n    ready() {}, fail() {},\n    rng: () => () => 0.5,\n  };\n  return hub;\n}\nawait test('session: card, start, ghosts lerp and never simulate, leave, result once, end stops everything', async () => {\n  const info = { me: 0, players: [{ id: 0, name: 'Zoë <b>', color: '#e8443a' }, { id: 1, name: 'Bea', color: '#3b82f6' }, { id: 2, name: 'Cy', color: '#22c55e' }], host: 0, isHost: true, mode: 'ghost', round: 1, limitMs: 300000, seed: 123 };\n  const fake = fakeHub(info);\n  globalThis.AIHub = fake;\n  App.session = info;\n  await h.go('medley', { session: true, picks: { pose: 'tree', beat: 'squats', header: 'header' } });\n  const s = App.scene;\n  eq(s.phase, 'card');\n  eq(App.stack.open, false);\n  h.step(5);\n  fake.emit('card', { left: 12000, paused: false, starting: false, ready: [1], asking: 0, asked: false });\n  h.step(2);\n  h.press('PadCross');\n  eq(fake.answers[0], 'ready', 'Cross answers Ready');\n  h.press('KeyM');\n  eq(fake.answers[1], 'more', 'M asks for more time');\n  fake.emit('start', { in: 3000 });\n  fake.t = -3000;\n  h.step(5);\n  eq(s.phase, 'countdown');\n  assert(s.ghostSender.timer, 'sending as soon as start arrives');\n  fake.t = 0;\n  h.step(2);\n  eq(s.phase, 'play');\n  const ghost = s.lanes[1];\n  assert(ghost.driver instanceof GhostDriver);\n  assert(ghost.ghost, 'lane is a ghost');\n  fake.t = 1000;\n  h.step(2);\n  eq(s.area, 0);\n  const dot0 = [ghost.dot.x, ghost.dot.y];\n  fake.emit('message', { a: 0, x: 0.5, y: -0.25, c: 1, t: 0.2, s: 77 }, 1);\n  fake.t = 2000;\n  h.step(90);\n  eq(ghost.dot.x, dot0[0], 'a ghost never simulates');\n  eq(ghost.dot.y, dot0[1]);\n  near(ghost.driver.x, 0.5, 0.05, 'it lerps');\n  eq(s.scoreOf(ghost), 77, 'its score is what it sent');\n  eq(ghost.avatar.root.visible, true, 'same area shows');\n  fake.emit('message', { a: 1, x: 0, y: 0, c: 0, t: 0, s: 80 }, 1);\n  h.step(3);\n  eq(ghost.avatar.root.visible, false, 'a ghost in another area is hidden');\n  fake.emit('leave', { id: 2, reason: 'left' });\n  h.step(30);\n  assert(s.lanes[2].gone, 'leaves');\n  eq(s.phase, 'play', 'the round goes on');\n  fake.t = 300000;\n  fake.emit('time-up', { graceMs: 3000 });\n  eq(fake.results.length, 1, 'result at time-up');\n  fake.emit('time-up', { graceMs: 3000 });\n  eq(fake.results.length, 1, 'result only once');\n  assert(typeof fake.results[0].score === 'number');\n  assert(fake.results[0].awards.length >= 1);\n  fake.emit('end', { reason: 'finished', standings: [] });\n  eq(s.ended, true);\n  eq(s.ghostSender.timer, null, 'sends nothing after end');\n  eq(engine.audio.playing, '', 'sound stops');\n  // In a session the pause menu has Resume and Settings, and nothing freezes.\n  const { PauseScreen } = await import('../../src/ui/screens/pause.js');\n  const p = new PauseScreen(s);\n  eq(p.freezes, false);\n  eq(p.menu.items.map((i) => i.id).join(), 'resume,settings');\n  App.session = null;\n  delete globalThis.AIHub;\n  s.dispose();\n  await h.go('title', {});\n});\n\n// ---- 19 Layout: no overflow at every size ----------------------------------------------------\nawait test('rep curve: 0 to 1 in 40%, hold 15%, 1 to 0 in 35%, rest 10%', () => {\n  eq(repTarget(0), 0); eq(repTarget(0.4), 1); eq(repTarget(0.5), 1); near(repTarget(0.725), 0.5, 1e-9); eq(repTarget(0.95), 0);\n});\ndone();\nEOF\ncat > tests/headless/layout.mjs <<'EOF'\n// 19: no layout overflow at 1920x1080, 1280x720 and 640x360 (and 800x600): widgets record rects.\nimport { assert, boot, done, eq, test, App, tick } from '../lib.mjs';\nimport { layout } from '../../src/ui/layout.js';\nimport { PLAYABLE_IDS } from '../../src/data/activities.js';\nimport { MainMenuScreen, DropInScreen, SlotScreen, NameEntryScreen, DropInStation } from '../../src/ui/screens/mainmenu.js';\nimport { SettingsScreen } from '../../src/ui/screens/settings.js';\nimport { AboutScreen } from '../../src/ui/screens/about.js';\nimport { DevScreen } from '../../src/ui/screens/dev.js';\nimport { HowToScreen } from '../../src/ui/screens/howto.js';\nimport { StationScreen } from '../../src/scenes/hub.js';\n\nconst SIZES = [[1920, 1080, 480, 270], [1280, 720, 427, 240], [640, 360, 640, 360], [800, 600, 400, 300]];\n\nfor (const [w, h0, artW, artH] of SIZES) {\n  const h = await boot({ scene: 'title', viewport: { width: w, height: h0, dpr: 1 } });\n  layout.record = true;\n  const { hud } = App.engine;\n  const check = (where) => {\n    const bad = layout.overflow(hud.width, hud.height).filter((r) => !['dial', 'star'].includes(r.name) || r.x < -1);\n    assert(!bad.length, `${where} at ${w}x${h0}: ${bad.slice(0, 4).map((r) => `${r.name} \"${r.text}\" ${r.x},${r.y} ${r.w}x${r.h}`).join('; ')}`);\n  };\n  const shot = (where, frames = 3) => { h.step(frames); check(where); };\n  void artW; void artH;\n  App.store.create(0, 'Kimberly', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  App.slot.phase = 'day';\n  App.slot.drips = 88;\n  App.slot.wardrobe = ['band2', 'cape', 'confidence', 'wrist'];\n  App.slot.ages = [80, 78, 74, 70, 66];\n  App.slot.day = 3;\n  App.slot.heardBeat = 7;\n\n  await test(`layout ${w}x${h0}: menus`, async () => {\n    shot('title');\n    App.stack.push(new MainMenuScreen()); shot('main');\n    App.stack.push(new SlotScreen()); shot('slots'); App.stack.pop();\n    App.stack.push(new NameEntryScreen(1)); shot('name'); App.stack.pop();\n    const dropin = new DropInScreen();\n    App.stack.push(dropin); shot('dropin');\n    for (const g of ['pavilion', 'shed', 'beach', 'lagoon', 'gate']) { App.stack.push(new DropInStation(g)); shot(`dropin ${g}`); App.stack.pop(); }\n    App.stack.pop();\n    const s = new SettingsScreen();\n    App.stack.push(s);\n    for (let i = 0; i < 4; i++) { s.tabs.set(i); shot(`settings tab ${i}`); }\n    App.stack.pop();\n    const a = new AboutScreen();\n    App.stack.push(a);\n    for (let i = 0; i < a.pages.length; i++) { a.i = i; a.scroll = 0; shot(`about ${i}`); }\n    App.stack.pop();\n    App.stack.push(new HowToScreen()); shot('howto'); App.stack.pop();\n    const d = new DevScreen();\n    App.stack.push(d);\n    for (let i = 0; i < d.tabs.labels.length; i++) { d.tabs.set(i); shot(`dev tab ${i}`); }\n    App.stack.pop();\n    App.stack.clear();\n  });\n  await test(`layout ${w}x${h0}: every device's prompts fit`, async () => {\n    await h.go('hub', {});\n    for (const dev of ['pad', 'keyboard', 'mouse']) {\n      App.device.last = dev;\n      App.engine.input.setPointer(0, 0, false);\n      App.scene.stand('pavilion'); App.device.last = dev; shot(`hub ${dev} near`);\n      App.stack.push(new StationScreen('pavilion', App.scene)); App.device.last = dev; shot(`station ${dev}`); App.stack.pop();\n      App.scene.stand('lagoon'); App.stack.push(new StationScreen('lagoon', App.scene)); shot('station lagoon'); App.stack.pop();\n    }\n    App.device.last = 'keyboard';\n  });\n  await test(`layout ${w}x${h0}: every activity's card, play and results`, async () => {\n    for (const id of [...PLAYABLE_IDS, 'stand']) {\n      await h.go('activity', { id, mode: 'week', noPractice: true });\n      shot(`${id} card`);\n      App.dev.autopilot = 'good';\n      h.step(60 * 6);\n      check(`${id} play`);\n      h.step(60 * 2);\n      check(`${id} play later`);\n      App.dev.autopilot = null;\n      App.scene.devFinish(3);\n      shot(`${id} results start`);\n      h.step(60 * 2);\n      check(`${id} results`);\n      assert(App.stack.top?.menuReady, 'results menu');\n      App.stack.clear();\n    }\n  });\n  await test(`layout ${w}x${h0}: scenes of the week`, async () => {\n    for (const scene of ['jar', 'records', 'locker']) { await h.go(scene, {}); shot(scene, 5); }\n    const rec = App.scene;\n    void rec;\n    await h.go('records', {});\n    const r = App.scene;\n    for (let i = 0; i < 3; i++) { r.tabs.set(i); shot(`records tab ${i}`); }\n    await h.go('report', {});\n    shot('report', 10);\n    App.slot.phase = 'morning';\n    App.dev.autopilot = 'good';\n    await h.go('weighin', {});\n    let n = 0;\n    while (App.scene.id === 'weighin' && n++ < 400) {\n      h.step(5);\n      check(`weighin ${App.scene.phase}`);\n      if (App.stack.top?.name) { h.step(10); check(`weighin ${App.stack.top.name}`); h.press('Enter'); }\n      await tick();\n      if (App.loading) await h.settle();\n    }\n    App.dev.autopilot = null;\n    await h.go('join', {});\n    shot('join');\n    h.press('Enter');\n    shot('join with one');\n    App.slot.confessed = false;\n    await h.go('ending', {});\n    shot('ending');\n    await h.go('medley', { family: [{ kind: 'keyboard' }, { kind: 'bot', skill: 'good' }, { kind: 'bot', skill: 'good' }, { kind: 'bot', skill: 'good' }], picks: { pose: 'warrior', beat: 'step', header: 'header' } });\n    const m = App.scene;\n    shot('medley intro');\n    m.clock.local = 0;\n    h.step(60 * 6 + 5);\n    h.step(60 * 6);\n    check('medley stillness');\n    m.clock.local = 60;\n    h.step(60 * 2);\n    check('medley break');\n    m.clock.local = 66;\n    h.step(60 * 6);\n    check('medley beat');\n    m.clock.local = 131;\n    h.step(60 * 6);\n    check('medley header');\n    m.clock.local = 186;\n    h.step(5);\n    eq(m.phase, 'podium');\n    shot('podium', 10);\n    h.step(60);\n    check('podium later');\n    eq(h.errors().length, 0, h.errors().join(' | '));\n  });\n  layout.record = false;\n}\ndone();\nEOF\ntimeout 590 node tools/test.mjs --fast systems layout </dev/null 2>&1 | tail -40 | cut -c1-520","description":"Write systems and layout tests and run them","timeout":600000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2879,"cache_read_input_tokens":567429,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2879},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"f03d46ff-9387-476d-a1dc-54fbaa706c0b","timestamp":"2026-11-05T07:09:12.220Z","request_id":"req_011CgjMo25r45katUhFQQE5J","wire_tool_inputs":{"toolu_013J678YP2gqh46M9cKEZLxB":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\nfor p in ['src/scenes/jar.js','src/scenes/records.js']:\n    s=open(p).read()\n    s=s.replace(\"  canPause = true;\\n\",\"  canPause = false; // Esc is Back here\\n\")\n    open(p,'w').write(s)\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- Run log: bot sweep caught\",\"- Run log: test runner race lost results (fixed); playthrough caught Esc in Jar/Hall opening pause instead of Back; bot sweep caught\")\nopen(p,'w').write(s)\nEOF\ncat > tests/headless/systems.mjs <<'EOF'\n// 7 Pause, 8 Dev, 9 Attract, 11 Medley, 19 layout.\nimport { assert, boot, done, eq, near, test, App, tick } from '../lib.mjs';\nimport { T, TUNABLE_DEFS, resetTunables } from '../../src/core/tunables.js';\nimport { layout } from '../../src/ui/layout.js';\nimport { ATTRACT_PLAYLIST, ATTRACT_SECONDS } from '../../src/scenes/attract.js';\nimport { ACTIVITY_IDS } from '../../src/data/activities.js';\nimport { MEDLEY } from '../../src/data/medley.js';\nimport { MEDLEY_LENGTH } from '../../src/scenes/medley.js';\nimport { GhostDriver } from '../../src/core/drivers.js';\nimport { dripsFor, starsFor, ageFromTests } from '../../src/core/week.js';\nimport { ACTIVITIES } from '../../src/data/activities.js';\nimport { repTarget } from '../../src/scenes/activity/reps.js';\n\nconst h = await boot({ scene: 'title' });\nconst { engine } = h;\n\n// ---- Pause ------------------------------------------------------------------------------------\nawait test('pause: timeScale 0, fixedUpdate frozen, menu navigable, resume exact', async () => {\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  App.dev.autopilot = 'good';\n  h.step(60 * 6);\n  const s = App.scene;\n  eq(s.phase, 'play');\n  h.press('Escape');\n  eq(App.stack.top?.name, 'pause');\n  eq(engine.timeScale, 0);\n  const fp = engine.fingerprint();\n  const t = s.eventT;\n  const time = engine.time;\n  h.step(120);\n  eq(engine.fingerprint(), fp, 'frozen');\n  eq(s.eventT, t);\n  eq(engine.time, time, 'game time frozen');\n  const f0 = App.stack.top.menu.focus;\n  h.press('ArrowDown');\n  assert(App.stack.top.menu.focus !== f0, 'menu moves');\n  h.press('ArrowUp');\n  h.press('Escape');\n  eq(App.stack.open, false, 'resumed by Back');\n  eq(engine.timeScale, 1);\n  eq(s.eventT, t, 'resume is exact');\n  h.step(10);\n  assert(s.eventT > t, 'runs again');\n  App.dev.autopilot = null;\n});\nawait test('pause: every item works: Restart, Settings, How to play, About, Dev Tools', async () => {\n  const open = () => { h.press('Escape'); eq(App.stack.top?.name, 'pause'); };\n  const pick = (id) => {\n    const m = App.stack.top.menu; const i = m.items.findIndex((x) => x.id === id);\n    assert(i >= 0, id);\n    m.focus = i;\n    h.press('Enter');\n  };\n  open();\n  for (const [id, name] of [['settings', 'settings'], ['howto', 'howto'], ['about', 'about'], ['dev', 'dev']]) {\n    pick(id);\n    eq(App.stack.top?.name, name, id);\n    h.step(3);\n    h.press('Escape');\n    eq(App.stack.top?.name, 'pause', `back from ${id}`);\n  }\n  pick('resume');\n  eq(App.stack.open, false);\n  open();\n  pick('restart');\n  await h.settle();\n  eq(App.scene.phase, 'intro', 'restarted');\n  eq(engine.timeScale, 1, 'time back after restart');\n});\nawait test('Create + Options does not pause (the hub\\'s chord)', async () => {\n  engine.input.setKey('PadCreate', true);\n  h.press('PadOptions');\n  eq(App.stack.open, false);\n  engine.input.setKey('PadCreate', false);\n  h.press('PadOptions');\n  eq(App.stack.top?.name, 'pause');\n  h.press('Escape');\n});\n\n// ---- Settings ---------------------------------------------------------------------------------\nawait test('settings: music defaults to 10%, and every control takes effect', async () => {\n  eq(App.settings.music, 0.1);\n  eq(engine.audio.volume.music, 0.1);\n  App.settings.music = 0.3; App.saveSettings();\n  near(engine.audio.volume.music, 0.3, 1e-6);\n  App.settings.music = 0.1; App.saveSettings();\n  App.settings.glyphs = 'xbox'; App.saveSettings();\n  eq(App.device.glyphs, 'xbox');\n  App.settings.glyphs = 'ps'; App.saveSettings();\n  App.settings.gentle = true;\n  near(App.ringOf(0.4), 0.5, 1e-6);\n  near(App.noiseScale(), 0.8, 1e-6);\n  App.settings.gentle = false;\n  App.settings.look = 'arcade'; App.saveSettings();\n  eq(engine.settings.values.look, 'arcade');\n  App.settings.look = 'default'; App.saveSettings();\n  eq(engine.settings.values.look, undefined);\n  App.settings.mouseLeanRadius = 90; App.saveSettings();\n  eq(T.mouseLeanRadius, 90);\n  App.settings.mouseLeanRadius = 70; App.saveSettings();\n});\n\n// ---- Dev tools: every slider changes live behaviour ------------------------------------------\nfunction dotRun(fn) {\n  resetTunables();\n  fn();\n  return null;\n}\nvoid dotRun;\nconst liveChecks = {\n  async dotInstability(run) { return run('tree'); }, async dotAuthority(run) { return run('tree'); }, async dotDamping(run) { return run('tree'); },\n  async dotNoise(run) { return run('tree'); }, async dotLag(run) { return run('tree'); },\n};\nasync function fingerprintAfter(id, frames = 300, skill = 'average', extra = {}) {\n  await h.go('activity', { id, mode: 'dropin', noPractice: true, ...extra });\n  App.dev.autopilot = skill;\n  h.step(10);\n  h.step(60 * 3 + frames);\n  const fp = engine.fingerprint();\n  App.dev.autopilot = null;\n  return fp;\n}\nconst PROBE = {\n  dotInstability: 'tree', dotAuthority: 'tree', dotDamping: 'tree', dotNoise: 'tree', dotLag: 'tree', ringScale: 'tree', gustForce: 'slackline',\n  breathBonus: 'warrior', repLag: 'squats', repFatigue: 'squats', repTempoScale: 'squats',\n  hoopLow: 'hoop', hoopHigh: 'hoop', hoopLiftRate: 'hoop', headerInterval: 'header', slackWalkInst: 'slackline', trayGravity: 'tray', trayMaxTilt: 'tray',\n  jogTargetCadence: 'jog', pierBoost: 'pier', stepWindow: 'step', stepOffsetMs: 'step',\n};\nvoid liveChecks;\nfor (const d of TUNABLE_DEFS) {\n  const probe = PROBE[d.id];\n  if (!probe) continue;\n  await test(`dev slider ${d.id} changes live behaviour`, async () => {\n    resetTunables();\n    const frames = d.id === 'gustForce' || d.id === 'slackWalkInst' ? 60 * 8 : d.id === 'pierBoost' ? 60 * 10 : d.id === 'stepWindow' || d.id === 'stepOffsetMs' ? 60 * 12 : 300;\n    const skill = d.id === 'hoopHigh' || d.id === 'hoopLow' ? 'average' : d.id === 'stepWindow' || d.id === 'stepOffsetMs' ? 'sloppy' : 'average';\n    const a = await fingerprintAfter(probe, frames, skill);\n    T[d.id] = d.id === 'stepOffsetMs' ? 150 : d.id === 'stepWindow' ? 0.5 : d.id === 'hoopLow' ? 1.6 : d.id === 'hoopHigh' ? 1.05 : d.id === 'dotLag' ? d.def * 3 : d.max;\n    const b = await fingerprintAfter(probe, frames, skill);\n    resetTunables();\n    assert(a !== b, `${probe} fingerprint unchanged: ${a}`);\n  });\n}\nawait test('dev slider mouseLeanRadius changes the lean', async () => {\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  h.press('Enter');\n  h.step(30);\n  App.device.last = 'mouse';\n  const s = App.scene;\n  const lane = s.playerLane;\n  engine.input.setPointer(0.2, 0.2, false);\n  h.step(3);\n  const x0 = lane.inp.x;\n  T.mouseLeanRadius = 140;\n  h.step(3);\n  const x1 = lane.inp.x;\n  resetTunables();\n  assert(Math.abs(x0) > Math.abs(x1) * 1.5, `${x0} vs ${x1}`);\n  engine.input.setPointer(0, 0, false);\n  App.device.last = 'keyboard';\n});\nawait test('dev slider dripRate, starThresholdScale, ageTrainingWeight change the economy', () => {\n  const d0 = dripsFor(2, 60);\n  T.dripRate = 2;\n  assert(dripsFor(2, 60) === d0 * 2);\n  T.dripRate = 1;\n  const s0 = starsFor(ACTIVITIES.tree, 80);\n  T.starThresholdScale = 1.5;\n  assert(starsFor(ACTIVITIES.tree, 80) < s0);\n  T.starThresholdScale = 1;\n  const a0 = ageFromTests([0.5], 10);\n  T.ageTrainingWeight = 2;\n  assert(ageFromTests([0.5], 10) < a0);\n  resetTunables();\n});\nawait test('dev: one button resets the tab, one resets everything, export lists changes', async () => {\n  const { DevScreen } = await import('../../src/ui/screens/dev.js');\n  const dev = new DevScreen();\n  T.dotNoise = 2; T.repLag = 0.3;\n  dev.menu.items.find((i) => i.id === 'resetTab').action();\n  eq(T.dotNoise, 0.8, 'tab');\n  eq(T.repLag, 0.3, 'other tab untouched');\n  dev.menu.items.find((i) => i.id === 'export').action();\n  assert(dev.exported.includes('repLag'));\n  dev.menu.items.find((i) => i.id === 'resetAll').action();\n  eq(T.repLag, 0.1, 'all');\n});\nawait test('dev tools: every tool works', async () => {\n  const { DevScreen } = await import('../../src/ui/screens/dev.js');\n  const toolDev = () => { const d = new DevScreen(); d.tabs.i = d.tabs.labels.length - 1; d.refresh(); return d; };\n  const item = (d, id) => d.menu.items.find((i) => i.id === id);\n  App.store.create(1, 'Dev', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  App.slot.phase = 'day';\n  await h.go('hub', {});\n  let d = toolDev();\n  App.stack.push(d);\n  item(d, 'god').action(); eq(App.dev.god, true); item(d, 'god').action(); eq(App.dev.god, false);\n  item(d, 'overlay').action(); h.step(2); eq(App.dev.overlay, true); item(d, 'overlay').action();\n  item(d, 'hideHud').action(); h.step(2); eq(App.dev.hideHud, true); item(d, 'hideHud').action();\n  item(d, 'unlock').action(); eq(App.dev.allUnlocked, true); item(d, 'unlock').action();\n  item(d, 'autopilot').adjust(1); eq(App.dev.autopilot, 'idle'); item(d, 'autopilot').adjust(-1); eq(App.dev.autopilot, null);\n  item(d, 'timescale').adjust(1); eq(App.dev.timeScale, 1.25); item(d, 'timescale').adjust(-1); eq(App.dev.timeScale, 1);\n  const before = App.slot.drips;\n  item(d, 'drips').action();\n  eq(App.slot.drips, before + 50);\n  await tick(); await tick();\n  assert(App.slot.wardrobe.length >= 2, 'milestones from 50 Drips');\n  item(d, 'freeCam').action(); h.step(2); eq(engine.camera.preset, 'free'); item(d, 'freeCam').action(); h.step(2); eq(engine.camera.preset, 'iso');\n  item(d, 'dialogue').action();\n  eq(App.stack.top?.name, 'dialogue');\n  h.press('Enter'); h.press('Enter'); h.step(2);\n  item(d, 'sound').action();\n  eq(App.stack.top?.name, 'soundtest');\n  for (const it of App.stack.top.menu.items) it.action?.();\n  h.step(2);\n  App.stack.pop();\n  // Finish the current activity with N stars.\n  d.closeAll();\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  d = toolDev();\n  App.stack.push(d);\n  item(d, 'finish').adjust(-1);\n  eq(d.starPick, 2);\n  item(d, 'finish').action();\n  eq(App.scene.lastResult.stars, 2);\n  eq(App.stack.top?.name, 'results');\n  // Go to a day, a scene, an activity.\n  d = toolDev();\n  App.stack.push(d);\n  d.dayPick = 4;\n  item(d, 'day').action();\n  await h.settle();\n  eq(App.slot.day, 4);\n  eq(App.scene.id, 'weighin');\n  d = toolDev();\n  App.stack.push(d);\n  d.sceneI = d.constructor === DevScreen ? 3 : 3;\n  item(d, 'scene').action();\n  await h.settle();\n  eq(App.scene.id, 'report');\n  d = toolDev();\n  App.stack.push(d);\n  d.activityI = ACTIVITY_IDS.indexOf('hoop');\n  item(d, 'activity').action();\n  await h.settle();\n  eq(App.scene.activity, 'hoop');\n  d = toolDev();\n  App.stack.push(d);\n  item(d, 'anim').action();\n  await h.settle();\n  eq(App.scene.id, 'viewer');\n  h.press('ArrowRight'); h.step(10);\n  assert(App.scene.i === 1);\n  h.press('Escape');\n  await h.settle();\n  d = toolDev();\n  App.stack.push(d);\n  item(d, 'resetSave').action();\n  await h.settle();\n  eq(App.scene.id, 'title');\n  eq(App.store.data.slots[1], null);\n  App.stack.clear();\n  App.dev = { god: false, autopilot: null, overlay: false, hideHud: false, timeScale: 1, freeCam: false, allUnlocked: false };\n});\nawait test('god mode keeps the Dot in the ring; autopilot plays', async () => {\n  await h.go('activity', { id: 'plank', mode: 'dropin', noPractice: true });\n  h.press('Enter');\n  App.dev.god = true;\n  h.step(60 * 3 + 60 * 10);\n  const s = App.scene;\n  const ring = s.event.ring();\n  assert(Math.hypot(s.playerLane.dot.x, s.playerLane.dot.y) <= ring + 0.01, 'held');\n  App.dev.god = false;\n});\n\n// ---- Attract ----------------------------------------------------------------------------------\nawait test('attract: 10 s idle on the title starts it', async () => {\n  await h.go('title', {});\n  engine.input.setKey('Enter', false);\n  h.step(60 * 9);\n  eq(App.attract, null, 'not yet');\n  h.step(60 * 1 + 5);\n  assert(App.attract, 'started');\n  await h.settle();\n  eq(App.scene.id, 'hub');\n});\nawait test('attract: any input exits: key, click, mouse move, wheel, stick', async () => {\n  const inputs = {\n    key() { engine.input.setKey('KeyQ', true); h.step(2); engine.input.setKey('KeyQ', false); },\n    click() { engine.input.setButtons(1); h.step(1); engine.input.setButtons(0); h.step(1); },\n    move() { engine.input.setPointer(0.5, 0.5, false); h.step(2); engine.input.setPointer(0, 0, false); },\n    wheel() { engine.input.addPointer(0, 0, 1); h.step(2); },\n    pad() { engine.input.setKey('PadCross', true); h.step(2); engine.input.setKey('PadCross', false); },\n  };\n  for (const [name, fn] of Object.entries(inputs)) {\n    if (!App.attract) { App.startAttract(); await h.settle(); }\n    h.step(30);\n    fn();\n    eq(App.attract, null, `${name} exits`);\n    await h.settle();\n    eq(App.scene.id, 'title', `${name} returns to title`);\n    h.step(5);\n  }\n});\nawait test('attract: 10 s idle on a menu starts it; no trigger during play or on pause', async () => {\n  await h.go('title', {});\n  h.press('Enter');\n  eq(App.stack.top?.name, 'main');\n  h.step(60 * 10 + 5);\n  assert(App.attract, 'started from a menu');\n  App.attract.exit();\n  await h.settle();\n  h.step(5);\n  await h.go('activity', { id: 'tree', mode: 'dropin', noPractice: true });\n  h.step(60 * 12);\n  eq(App.attract, null, 'not during an intro');\n  h.press('Enter');\n  h.step(60 * 12);\n  eq(App.attract, null, 'not during play');\n  h.press('Escape');\n  h.step(60 * 12);\n  eq(App.attract, null, 'not on the pause menu');\n  h.press('Escape');\n});\nawait test('attract: a full loop covers every item with no errors, then comes round again', async () => {\n  await h.go('title', {});\n  App.startAttract();\n  await h.settle();\n  const seen = new Set();\n  let n = 0;\n  const startLoops = App.attract.loops;\n  while (App.attract.loops === startLoops && n < 60 * ATTRACT_SECONDS * (ATTRACT_PLAYLIST.length + 2)) {\n    h.step(15);\n    await tick();\n    n += 15;\n    seen.add(App.scene.activity ?? App.scene.id);\n    if (App.loading) await h.settle();\n  }\n  for (const item of ATTRACT_PLAYLIST) assert(seen.has(item.args.id ?? item.scene), `${item.args.id ?? item.scene} never showed: ${[...seen].join(',')}`);\n  eq(h.errors().length, 0, h.errors().join(' | '));\n  eq(App.scene.resultsShown ?? false, false);\n  App.attract.exit();\n  await h.settle();\n});\nawait test('attract: each activity actually plays, cheating freely', async () => {\n  for (const id of ['tree', 'hoop', 'header', 'step', 'slackline', 'tray', 'pier', 'jog', 'squats']) {\n    await h.go('activity', { id, attract: true });\n    const fp = engine.fingerprint();\n    h.step(60 * 6);\n    assert(engine.fingerprint() !== fp, `${id} stands still`);\n    assert(App.scene.phase === 'play', `${id} phase ${App.scene.phase}`);\n    assert(App.scene.result().score >= 0);\n  }\n  await h.go('title', {});\n});\n\n// ---- The Medley -------------------------------------------------------------------------------\nconst FAMILY = [{ kind: 'bot', skill: 'expert' }, { kind: 'bot', skill: 'good' }, { kind: 'bot', skill: 'average' }, { kind: 'bot', skill: 'idle' }];\nawait test('medley: 4 bot lanes, windows respected, scores in range, podium, rematch', async () => {\n  await h.go('medley', { family: FAMILY, picks: { pose: 'tree', beat: 'hoop', header: 'header' } });\n  const s = App.scene;\n  eq(s.lanes.length, 4);\n  eq(s.phase, 'intro');\n  h.step(60 * MEDLEY.introSeconds + 2);\n  eq(s.phase, 'play');\n  eq(s.area, 0, 'first window');\n  h.step(60 * MEDLEY.eventSeconds + 30);\n  eq(s.area, -1, 'a break between events');\n  eq(s.lanes[0].points.length, 1);\n  h.step(60 * (MEDLEY.breakSeconds + 1));\n  eq(s.area, 1, 'second window');\n  eq(s.current.kind, 'hoop');\n  h.step(60 * (MEDLEY.eventSeconds + MEDLEY.breakSeconds));\n  eq(s.area, 2, 'third window');\n  eq(s.current.kind, 'header');\n  h.step(60 * MEDLEY.eventSeconds + 30);\n  eq(s.phase, 'podium');\n  eq(s.clock.now() >= MEDLEY_LENGTH - 0.2, true);\n  for (const l of s.lanes) {\n    eq(l.points.length, 3);\n    for (const p of l.points) assert(p >= 0 && p <= 1000, `points ${p}`);\n    assert(l.total >= 0 && l.total <= 3000);\n  }\n  assert(s.lanes[0].total > s.lanes[3].total, 'expert beats idle');\n  eq(s.order[0], s.lanes[0], 'expert on top');\n  assert(s.awards.length === 4);\n  h.step(10);\n  eq(h.errors().length, 0, h.errors().join(' | '));\n  s.menu.items.find((i) => i.id === 'rematch').action();\n  await h.settle();\n  eq(App.scene.id, 'medley');\n  eq(App.scene.phase, 'intro');\n});\nfor (const [beat, kind] of [['squats', 'reps'], ['lunges', 'reps'], ['step', 'step']]) {\n  await test(`medley: the Beat event ${beat} runs in its window and scores`, async () => {\n    await h.go('medley', { family: FAMILY, picks: { pose: 'heron', beat, header: 'header' } });\n    const s = App.scene;\n    h.step(60 * MEDLEY.introSeconds + 2);\n    h.step(60 * (MEDLEY.eventSeconds + MEDLEY.breakSeconds) + 5);\n    eq(s.current.kind, kind);\n    h.step(60 * (MEDLEY.eventSeconds - 2));\n    assert(s.current.normalized(s.lanes[0]) > s.current.normalized(s.lanes[3]), `expert over idle: ${s.current.normalized(s.lanes[0])} vs ${s.current.normalized(s.lanes[3])}`);\n    eq(h.errors().length, 0);\n  });\n}\nawait test('medley: picks come from a seeded stream, the same on every run', async () => {\n  await h.go('medley', { family: FAMILY });\n  const a = App.scene.picks.join();\n  await h.go('medley', { family: FAMILY });\n  eq(App.scene.picks.join(), a);\n  for (let i = 0; i < 3; i++) assert(MEDLEY.events[i].options.includes(App.scene.picks[i]), 'pick from options');\n});\n\n// A pretend hub, in-process: the protocol's events, by hand.\nfunction fakeHub(info) {\n  const on = {};\n  const hub = {\n    active: true, sent: [], progressed: [], results: [], answers: [], t: -Infinity,\n    on(ev, fn) { (on[ev] ??= []).push(fn); return () => { on[ev] = on[ev].filter((f) => f !== fn); }; },\n    emit(ev, ...a) { for (const f of on[ev] ?? []) f(...a); },\n    time() { return this.t; },\n    answer(x) { this.answers.push(x); },\n    send(d, o) { this.sent.push({ d, o }); return true; },\n    progress(p) { this.progressed.push(p); },\n    result(r) { this.results.push(r); },\n    ready() {}, fail() {},\n    rng: () => () => 0.5,\n  };\n  return hub;\n}\nawait test('session: card, start, ghosts lerp and never simulate, leave, result once, end stops everything', async () => {\n  const info = { me: 0, players: [{ id: 0, name: 'Zo\\u00eb <b>', color: '#e8443a' }, { id: 1, name: 'Bea', color: '#3b82f6' }, { id: 2, name: 'Cy', color: '#22c55e' }], host: 0, isHost: true, mode: 'ghost', round: 1, limitMs: 300000, seed: 123 };\n  const fake = fakeHub(info);\n  globalThis.AIHub = fake;\n  App.session = info;\n  await h.go('medley', { session: true, picks: { pose: 'tree', beat: 'squats', header: 'header' } });\n  const s = App.scene;\n  eq(s.phase, 'card');\n  eq(App.stack.open, false);\n  h.step(5);\n  fake.emit('card', { left: 12000, paused: false, starting: false, ready: [1], asking: 0, asked: false });\n  h.step(2);\n  h.press('PadCross');\n  eq(fake.answers[0], 'ready', 'Cross answers Ready');\n  h.press('KeyM');\n  eq(fake.answers[1], 'more', 'M asks for more time');\n  fake.emit('start', { in: 3000 });\n  fake.t = -3000;\n  h.step(5);\n  eq(s.phase, 'countdown');\n  assert(s.ghostSender.timer, 'sending as soon as start arrives');\n  fake.t = 0;\n  h.step(2);\n  eq(s.phase, 'play');\n  const ghost = s.lanes[1];\n  assert(ghost.driver instanceof GhostDriver);\n  assert(ghost.ghost, 'lane is a ghost');\n  fake.t = 1000;\n  h.step(2);\n  eq(s.area, 0);\n  const dot0 = [ghost.dot.x, ghost.dot.y];\n  fake.emit('message', { a: 0, x: 0.5, y: -0.25, c: 1, t: 0.2, s: 77 }, 1);\n  fake.t = 2000;\n  h.step(90);\n  eq(ghost.dot.x, dot0[0], 'a ghost never simulates');\n  eq(ghost.dot.y, dot0[1]);\n  near(ghost.driver.x, 0.5, 0.05, 'it lerps');\n  eq(s.scoreOf(ghost), 77, 'its score is what it sent');\n  eq(ghost.avatar.root.visible, true, 'same area shows');\n  fake.emit('message', { a: 1, x: 0, y: 0, c: 0, t: 0, s: 80 }, 1);\n  h.step(3);\n  eq(ghost.avatar.root.visible, false, 'a ghost in another area is hidden');\n  fake.emit('leave', { id: 2, reason: 'left' });\n  h.step(30);\n  assert(s.lanes[2].gone, 'leaves');\n  eq(s.phase, 'play', 'the round goes on');\n  fake.t = 300000;\n  fake.emit('time-up', { graceMs: 3000 });\n  eq(fake.results.length, 1, 'result at time-up');\n  fake.emit('time-up', { graceMs: 3000 });\n  eq(fake.results.length, 1, 'result only once');\n  assert(typeof fake.results[0].score === 'number');\n  assert(fake.results[0].awards.length >= 1);\n  fake.emit('end', { reason: 'finished', standings: [] });\n  eq(s.ended, true);\n  eq(s.ghostSender.timer, null, 'sends nothing after end');\n  eq(engine.audio.playing, '', 'sound stops');\n  // In a session the pause menu has Resume and Settings, and nothing freezes.\n  const { PauseScreen } = await import('../../src/ui/screens/pause.js');\n  const p = new PauseScreen(s);\n  eq(p.freezes, false);\n  eq(p.menu.items.map((i) => i.id).join(), 'resume,settings');\n  App.session = null;\n  delete globalThis.AIHub;\n  s.dispose();\n  await h.go('title', {});\n});\n\n// ---- 19 Layout: no overflow at every size ----------------------------------------------------\nawait test('rep curve: 0 to 1 in 40%, hold 15%, 1 to 0 in 35%, rest 10%', () => {\n  eq(repTarget(0), 0); eq(repTarget(0.4), 1); eq(repTarget(0.5), 1); near(repTarget(0.725), 0.5, 1e-9); eq(repTarget(0.95), 0);\n});\ndone();\nEOF\ncat > tests/headless/layout.mjs <<'EOF'\n// 19: no layout overflow at 1920x1080, 1280x720 and 640x360 (and 800x600): widgets record rects.\nimport { assert, boot, done, eq, test, App, tick } from '../lib.mjs';\nimport { layout } from '../../src/ui/layout.js';\nimport { PLAYABLE_IDS } from '../../src/data/activities.js';\nimport { MainMenuScreen, DropInScreen, SlotScreen, NameEntryScreen, DropInStation } from '../../src/ui/screens/mainmenu.js';\nimport { SettingsScreen } from '../../src/ui/screens/settings.js';\nimport { AboutScreen } from '../../src/ui/screens/about.js';\nimport { DevScreen } from '../../src/ui/screens/dev.js';\nimport { HowToScreen } from '../../src/ui/screens/howto.js';\nimport { StationScreen } from '../../src/scenes/hub.js';\n\nconst SIZES = [[1920, 1080, 480, 270], [1280, 720, 427, 240], [640, 360, 640, 360], [800, 600, 400, 300]];\n\nfor (const [w, h0, artW, artH] of SIZES) {\n  const h = await boot({ scene: 'title', viewport: { width: w, height: h0, dpr: 1 } });\n  layout.record = true;\n  const { hud } = App.engine;\n  const check = (where) => {\n    const bad = layout.overflow(hud.width, hud.height).filter((r) => !['dial', 'star'].includes(r.name) || r.x < -1);\n    assert(!bad.length, `${where} at ${w}x${h0}: ${bad.slice(0, 4).map((r) => `${r.name} \"${r.text}\" ${r.x},${r.y} ${r.w}x${r.h}`).join('; ')}`);\n  };\n  const shot = (where, frames = 3) => { h.step(frames); check(where); };\n  void artW; void artH;\n  App.store.create(0, 'Kimberly', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  App.slot.phase = 'day';\n  App.slot.drips = 88;\n  App.slot.wardrobe = ['band2', 'cape', 'confidence', 'wrist'];\n  App.slot.ages = [80, 78, 74, 70, 66];\n  App.slot.day = 3;\n  App.slot.heardBeat = 7;\n\n  await test(`layout ${w}x${h0}: menus`, async () => {\n    shot('title');\n    App.stack.push(new MainMenuScreen()); shot('main');\n    App.stack.push(new SlotScreen()); shot('slots'); App.stack.pop();\n    App.stack.push(new NameEntryScreen(1)); shot('name'); App.stack.pop();\n    const dropin = new DropInScreen();\n    App.stack.push(dropin); shot('dropin');\n    for (const g of ['pavilion', 'shed', 'beach', 'lagoon', 'gate']) { App.stack.push(new DropInStation(g)); shot(`dropin ${g}`); App.stack.pop(); }\n    App.stack.pop();\n    const s = new SettingsScreen();\n    App.stack.push(s);\n    for (let i = 0; i < 4; i++) { s.tabs.set(i); shot(`settings tab ${i}`); }\n    App.stack.pop();\n    const a = new AboutScreen();\n    App.stack.push(a);\n    for (let i = 0; i < a.pages.length; i++) { a.i = i; a.scroll = 0; shot(`about ${i}`); }\n    App.stack.pop();\n    App.stack.push(new HowToScreen()); shot('howto'); App.stack.pop();\n    const d = new DevScreen();\n    App.stack.push(d);\n    for (let i = 0; i < d.tabs.labels.length; i++) { d.tabs.set(i); shot(`dev tab ${i}`); }\n    App.stack.pop();\n    App.stack.clear();\n  });\n  await test(`layout ${w}x${h0}: every device's prompts fit`, async () => {\n    await h.go('hub', {});\n    for (const dev of ['pad', 'keyboard', 'mouse']) {\n      App.device.last = dev;\n      App.engine.input.setPointer(0, 0, false);\n      App.scene.stand('pavilion'); App.device.last = dev; shot(`hub ${dev} near`);\n      App.stack.push(new StationScreen('pavilion', App.scene)); App.device.last = dev; shot(`station ${dev}`); App.stack.pop();\n      App.scene.stand('lagoon'); App.stack.push(new StationScreen('lagoon', App.scene)); shot('station lagoon'); App.stack.pop();\n    }\n    App.device.last = 'keyboard';\n  });\n  await test(`layout ${w}x${h0}: every activity's card, play and results`, async () => {\n    for (const id of [...PLAYABLE_IDS, 'stand']) {\n      await h.go('activity', { id, mode: 'week', noPractice: true });\n      shot(`${id} card`);\n      App.dev.autopilot = 'good';\n      h.step(60 * 6);\n      check(`${id} play`);\n      h.step(60 * 2);\n      check(`${id} play later`);\n      App.dev.autopilot = null;\n      App.scene.devFinish(3);\n      shot(`${id} results start`);\n      h.step(60 * 2);\n      check(`${id} results`);\n      assert(App.stack.top?.menuReady, 'results menu');\n      App.stack.clear();\n    }\n  });\n  await test(`layout ${w}x${h0}: scenes of the week`, async () => {\n    for (const scene of ['jar', 'records', 'locker']) { await h.go(scene, {}); shot(scene, 5); }\n    const rec = App.scene;\n    void rec;\n    await h.go('records', {});\n    const r = App.scene;\n    for (let i = 0; i < 3; i++) { r.tabs.set(i); shot(`records tab ${i}`); }\n    await h.go('report', {});\n    shot('report', 10);\n    App.slot.phase = 'morning';\n    App.dev.autopilot = 'good';\n    await h.go('weighin', {});\n    let n = 0;\n    while (App.scene.id === 'weighin' && n++ < 400) {\n      h.step(5);\n      check(`weighin ${App.scene.phase}`);\n      if (App.stack.top?.name) { h.step(10); check(`weighin ${App.stack.top.name}`); h.press('Enter'); }\n      await tick();\n      if (App.loading) await h.settle();\n    }\n    App.dev.autopilot = null;\n    await h.go('join', {});\n    shot('join');\n    h.press('Enter');\n    shot('join with one');\n    App.slot.confessed = false;\n    await h.go('ending', {});\n    shot('ending');\n    await h.go('medley', { family: [{ kind: 'keyboard' }, { kind: 'bot', skill: 'good' }, { kind: 'bot', skill: 'good' }, { kind: 'bot', skill: 'good' }], picks: { pose: 'warrior', beat: 'step', header: 'header' } });\n    const m = App.scene;\n    shot('medley intro');\n    m.clock.local = 0;\n    h.step(60 * 6 + 5);\n    h.step(60 * 6);\n    check('medley stillness');\n    m.clock.local = 60;\n    h.step(60 * 2);\n    check('medley break');\n    m.clock.local = 66;\n    h.step(60 * 6);\n    check('medley beat');\n    m.clock.local = 131;\n    h.step(60 * 6);\n    check('medley header');\n    m.clock.local = 186;\n    h.step(5);\n    eq(m.phase, 'podium');\n    shot('podium', 10);\n    h.step(60);\n    check('podium later');\n    eq(h.errors().length, 0, h.errors().join(' | '));\n  });\n  layout.record = false;\n}\ndone();\nEOF\ntimeout 590 node tools/test.mjs --fast systems layout </dev/null 2>&1 | tail -40 | cut -c1-520","description":"Write systems and layout tests and run them","timeout":600000}}}
