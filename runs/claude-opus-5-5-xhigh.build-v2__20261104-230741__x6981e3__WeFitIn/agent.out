{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G1EVJsed3AutHiTQXFWYpV","type":"tool_result","content":"1\t// One seam for \"who is moving this lane\": a person, a pad, a bot or a ghost.\n2\t// read(out, ...) fills { x, y, breath, stepL, stepR, confirm, rate }.\n3\timport { LEFT_FOOT, RIGHT_FOOT, BREATH, CONFIRM_PLAY } from './actions.js';\n4\t\n5\texport function blankInput() {\n6\t  return { x: 0, y: 0, breath: false, stepL: false, stepR: false, confirm: false, rate: false, flick: 0 };\n7\t}\n8\t\n9\texport const SKILLS = {\n10\t  idle: null,\n11\t  sloppy: { tau: 0.42, kp: 0.7, kd: 0.12, err: 1.3 },\n12\t  average: { tau: 0.3, kp: 1.1, kd: 0.35, err: 0.8 },\n13\t  good: { tau: 0.22, kp: 1.5, kd: 0.55, err: 0.45 },\n14\t  expert: { tau: 0.17, kp: 1.9, kd: 0.7, err: 0.2 },\n15\t};\n16\texport const SKILL_NAMES = ['idle', 'sloppy', 'average', 'good', 'expert'];\n17\t\n18\t/** How well a skill does things other than balance: timing error (s), slip chance, reaction (s). */\n19\texport const SKILL_PLAY = {\n20\t  idle: { timing: 0, miss: 1, react: 9, wander: 0, speed: 0 },\n21\t  sloppy: { timing: 0.16, miss: 0.35, react: 0.6, wander: 0.35, speed: 0.55 },\n22\t  average: { timing: 0.085, miss: 0.1, react: 0.38, wander: 0.18, speed: 0.8 },\n23\t  good: { timing: 0.045, miss: 0.03, react: 0.24, wander: 0.09, speed: 0.95 },\n24\t  expert: { timing: 0.02, miss: 0.005, react: 0.14, wander: 0.04, speed: 1 },\n25\t};\n26\t\n27\texport function clampDisc(o) {\n28\t  const d = Math.hypot(o.x, o.y);\n29\t  if (d > 1) { o.x /= d; o.y /= d; }\n30\t  return o;\n31\t}\n32\t\n33\t/** The delayed PD controller every bot balances with. */\n34\texport class BotBrain {\n35\t  constructor(skill, rand) {\n36\t    this.skill = skill;\n37\t    this.p = SKILLS[skill];\n38\t    this.play = SKILL_PLAY[skill] ?? SKILL_PLAY.idle;\n39\t    this.rand = rand;\n40\t    this.hist = [];\n41\t    this.dx = 0; this.dy = 0;\n42\t  }\n43\t\n44\t  /** Writes a lean toward (tx, ty) into out, from what the bot saw tau seconds ago. */\n45\t  lean(out, dot, tx, ty, dt) {\n46\t    if (!this.p) { out.x = 0; out.y = 0; return out; }\n47\t    const { tau, kp, kd, err } = this.p;\n48\t    this.hist.push(dot.x, dot.y, dot.vx, dot.vy);\n49\t    const n = Math.max(1, Math.round(tau / dt));\n50\t    if (this.hist.length > (n + 1) * 4) this.hist.splice(0, this.hist.length - (n + 1) * 4);\n51\t    const sx = this.hist[0], sy = this.hist[1], svx = this.hist[2], svy = this.hist[3];\n52\t    this.dx += (this.rand() - 0.5) * err * dt * 6; this.dx *= 0.995;\n53\t    this.dy += (this.rand() - 0.5) * err * dt * 6; this.dy *= 0.995;\n54\t    out.x = -kp * (sx - tx) - kd * svx + this.dx;\n55\t    out.y = -kp * (sy - ty) - kd * svy + this.dy;\n56\t    return clampDisc(out);\n57\t  }\n58\t}\n59\t\n60\tconst DESK_LEFT = ['KeyF', 'ArrowLeft', 'MouseLeft'];\n61\tconst DESK_RIGHT = ['KeyJ', 'ArrowRight', 'MouseRight'];\n62\tconst DESK_CONFIRM = ['Space', 'Enter', 'MouseLeft'];\n63\t\n64\t/** One click is a left foot and a confirm at once: take it once, then hand it to both. */\n65\tfunction readPresses(out, input, left, right, confirm) {\n66\t  const click = input.consumePress('MouseLeft');\n67\t  out.stepL = click || input.consumeAny(left);\n68\t  out.stepR = input.consumeAny(right);\n69\t  out.confirm = click || input.consumeAny(confirm);\n70\t}\n71\t\n72\t/** Keyboard lean, smoothed. attack .10 s, release .06 s, Shift for half. */\n73\texport class KeyLean {\n74\t  x = 0; y = 0;\n75\t  step(input, dt, out) {\n76\t    const rawX = (input.isDown('KeyD', 'ArrowRight') ? 1 : 0) - (input.isDown('KeyA', 'ArrowLeft') ? 1 : 0);\n77\t    const rawY = (input.isDown('KeyW', 'ArrowUp') ? 1 : 0) - (input.isDown('KeyS', 'ArrowDown') ? 1 : 0);\n78\t    const half = input.isDown('ShiftLeft', 'ShiftRight') ? 0.5 : 1;\n79\t    this.x = approach(this.x, rawX * half, dt);\n80\t    this.y = approach(this.y, rawY * half, dt);\n81\t    out.x = this.x; out.y = this.y;\n82\t    clampDisc(out);\n83\t    return rawX !== 0 || rawY !== 0;\n84\t  }\n85\t}\n86\tfunction approach(v, to, dt) {\n87\t  const tau = Math.abs(to) > Math.abs(v) ? 0.1 : 0.06;\n88\t  return v + (to - v) * Math.min(1, dt / tau);\n89\t}\n90\t\n91\t/** The player: stick, keys or mouse, whichever was used last. */\n92\texport class LocalDriver {\n93\t  kind = 'local';\n94\t  keys = new KeyLean();\n95\t\n96\t  /** dial: { x, y } centre of the player's dial in art pixels (mouse lean). */\n97\t  read(out, ctx, dt, app, dial) {\n98\t    const { input } = ctx;\n99\t    const dev = app.device.last;\n100\t    const pad = input.padAxis;\n101\t    const heldKeys = this.keys.step(input, dt, out);\n102\t    out.rate = false;\n103\t    if (dev === 'mouse') {\n104\t      const p = app.device.pointerArt(ctx);\n105\t      const r = app.T.mouseLeanRadius;\n106\t      const cx = dial?.x ?? ctx.hud.width / 2, cy = dial?.y ?? ctx.hud.height / 2;\n107\t      out.x = (p.x - cx) / r; out.y = (cy - p.y) / r;\n108\t      clampDisc(out);\n109\t    } else if (dev === 'pad' || Math.hypot(pad.x, pad.y) > 0) {\n110\t      out.x = pad.x; out.y = pad.y;\n111\t      clampDisc(out);\n112\t    } else {\n113\t      out.rate = heldKeys || dev === 'keyboard';\n114\t    }\n115\t    out.breath = input.anyDown(BREATH);\n116\t    readPresses(out, input, LEFT_FOOT, RIGHT_FOOT, CONFIRM_PLAY);\n117\t    return out;\n118\t  }\n119\t}\n120\t\n121\t/** Keyboard and mouse only: Family Hour's K+M mat, which must not see pads. */\n122\texport class KeyboardDriver extends LocalDriver {\n123\t  kind = 'keyboard';\n124\t  read(out, ctx, dt, app, dial) {\n125\t    const { input } = ctx;\n126\t    const dev = app.device.lastDesk;\n127\t    const held = this.keys.step(input, dt, out);\n128\t    out.rate = false;\n129\t    if (dev === 'mouse') {\n130\t      const p = app.device.pointerArt(ctx);\n131\t      const r = app.T.mouseLeanRadius;\n132\t      out.x = (p.x - (dial?.x ?? ctx.hud.width / 2)) / r;\n133\t      out.y = ((dial?.y ?? ctx.hud.height / 2) - p.y) / r;\n134\t      clampDisc(out);\n135\t    } else out.rate = held || true;\n136\t    out.breath = input.isDown('Space', 'MouseLeft');\n137\t    readPresses(out, input, DESK_LEFT, DESK_RIGHT, DESK_CONFIRM);\n138\t    return out;\n139\t  }\n140\t}\n141\t\n142\t/** One pad by index. The engine merges pads, so Family Hour reads them itself. */\n143\texport class PadDriver {\n144\t  kind = 'pad';\n145\t  constructor(index, deadzone) { this.index = index; this.deadzone = deadzone; this.prev = []; }\n146\t  read(out) {\n147\t    const pad = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads()[this.index] : null;\n148\t    out.rate = false;\n149\t    if (!pad) { out.x = out.y = 0; out.breath = out.stepL = out.stepR = out.confirm = false; return out; }\n150\t    const [ax, ay] = this.deadzone(pad.axes[0] ?? 0, pad.axes[1] ?? 0);\n151\t    out.x = ax; out.y = -ay;\n152\t    clampDisc(out);\n153\t    const b = (i) => !!pad.buttons[i]?.pressed;\n154\t    const edge = (i) => b(i) && !this.prev[i];\n155\t    out.breath = b(7) || b(0);\n156\t    out.stepL = edge(4) || edge(6);\n157\t    out.stepR = edge(5) || edge(7);\n158\t    out.confirm = edge(0);\n159\t    for (let i = 0; i < pad.buttons.length; i++) this.prev[i] = b(i);\n160\t    return out;\n161\t  }\n162\t}\n163\t\n164\t/** Bots: the event decides what \"good play\" means. */\n165\texport class BotDriver {\n166\t  kind = 'bot';\n167\t  constructor(skill, rand) { this.skill = skill; this.brain = new BotBrain(skill, rand); this.rand = rand; }\n168\t}\n169\t\n170\t/** Another player's copy: display only, nothing is simulated. */\n171\texport class GhostDriver {\n172\t  kind = 'ghost';\n173\t  x = 0; y = 0; tx = 0; ty = 0; clip = 0; clipTime = 0; score = 0; area = -1; lastAt = -1;\n174\t  receive(d) { this.tx = d.x ?? 0; this.ty = d.y ?? 0; this.clip = d.c ?? 0; this.clipTime = d.t ?? 0; this.score = d.s ?? 0; this.area = d.a ?? -1; }\n175\t  lerp(dt) {\n176\t    const k = Math.min(1, dt * 10);\n177\t    this.x += (this.tx - this.x) * k; this.y += (this.ty - this.y) * k;\n178\t  }\n179\t}\n180\t\n181\t"}]},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"9543ff6d-ae8b-42c4-bd79-efa4e2133c79","timestamp":"2026-11-05T09:31:49.157Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741/src/core/drivers.js","content":"// One seam for \"who is moving this lane\": a person, a pad, a bot or a ghost.\n// read(out, ...) fills { x, y, breath, stepL, stepR, confirm, rate }.\nimport { LEFT_FOOT, RIGHT_FOOT, BREATH, CONFIRM_PLAY } from './actions.js';\n\nexport function blankInput() {\n  return { x: 0, y: 0, breath: false, stepL: false, stepR: false, confirm: false, rate: false, flick: 0 };\n}\n\nexport const SKILLS = {\n  idle: null,\n  sloppy: { tau: 0.42, kp: 0.7, kd: 0.12, err: 1.3 },\n  average: { tau: 0.3, kp: 1.1, kd: 0.35, err: 0.8 },\n  good: { tau: 0.22, kp: 1.5, kd: 0.55, err: 0.45 },\n  expert: { tau: 0.17, kp: 1.9, kd: 0.7, err: 0.2 },\n};\nexport const SKILL_NAMES = ['idle', 'sloppy', 'average', 'good', 'expert'];\n\n/** How well a skill does things other than balance: timing error (s), slip chance, reaction (s). */\nexport const SKILL_PLAY = {\n  idle: { timing: 0, miss: 1, react: 9, wander: 0, speed: 0 },\n  sloppy: { timing: 0.16, miss: 0.35, react: 0.6, wander: 0.35, speed: 0.55 },\n  average: { timing: 0.085, miss: 0.1, react: 0.38, wander: 0.18, speed: 0.8 },\n  good: { timing: 0.045, miss: 0.03, react: 0.24, wander: 0.09, speed: 0.95 },\n  expert: { timing: 0.02, miss: 0.005, react: 0.14, wander: 0.04, speed: 1 },\n};\n\nexport function clampDisc(o) {\n  const d = Math.hypot(o.x, o.y);\n  if (d > 1) { o.x /= d; o.y /= d; }\n  return o;\n}\n\n/** The delayed PD controller every bot balances with. */\nexport class BotBrain {\n  constructor(skill, rand) {\n    this.skill = skill;\n    this.p = SKILLS[skill];\n    this.play = SKILL_PLAY[skill] ?? SKILL_PLAY.idle;\n    this.rand = rand;\n    this.hist = [];\n    this.dx = 0; this.dy = 0;\n  }\n\n  /** Writes a lean toward (tx, ty) into out, from what the bot saw tau seconds ago. */\n  lean(out, dot, tx, ty, dt) {\n    if (!this.p) { out.x = 0; out.y = 0; return out; }\n    const { tau, kp, kd, err } = this.p;\n    this.hist.push(dot.x, dot.y, dot.vx, dot.vy);\n    const n = Math.max(1, Math.round(tau / dt));\n    if (this.hist.length > (n + 1) * 4) this.hist.splice(0, this.hist.length - (n + 1) * 4);\n    const sx = this.hist[0], sy = this.hist[1], svx = this.hist[2], svy = this.hist[3];\n    this.dx += (this.rand() - 0.5) * err * dt * 6; this.dx *= 0.995;\n    this.dy += (this.rand() - 0.5) * err * dt * 6; this.dy *= 0.995;\n    out.x = -kp * (sx - tx) - kd * svx + this.dx;\n    out.y = -kp * (sy - ty) - kd * svy + this.dy;\n    return clampDisc(out);\n  }\n}\n\nconst DESK_LEFT = ['KeyF', 'ArrowLeft', 'MouseLeft'];\nconst DESK_RIGHT = ['KeyJ', 'ArrowRight', 'MouseRight'];\nconst DESK_CONFIRM = ['Space', 'Enter', 'MouseLeft'];\n\n/** One click is a left foot and a confirm at once: take it once, then hand it to both. */\nfunction readPresses(out, input, left, right, confirm) {\n  const click = input.consumePress('MouseLeft');\n  out.stepL = click || input.consumeAny(left);\n  out.stepR = input.consumeAny(right);\n  out.confirm = click || input.consumeAny(confirm);\n}\n\n/** Keyboard lean, smoothed. attack .10 s, release .06 s, Shift for half. */\nexport class KeyLean {\n  x = 0; y = 0;\n  step(input, dt, out) {\n    const rawX = (input.isDown('KeyD', 'ArrowRight') ? 1 : 0) - (input.isDown('KeyA', 'ArrowLeft') ? 1 : 0);\n    const rawY = (input.isDown('KeyW', 'ArrowUp') ? 1 : 0) - (input.isDown('KeyS', 'ArrowDown') ? 1 : 0);\n    const half = input.isDown('ShiftLeft', 'ShiftRight') ? 0.5 : 1;\n    this.x = approach(this.x, rawX * half, dt);\n    this.y = approach(this.y, rawY * half, dt);\n    out.x = this.x; out.y = this.y;\n    clampDisc(out);\n    return rawX !== 0 || rawY !== 0;\n  }\n}\nfunction approach(v, to, dt) {\n  const tau = Math.abs(to) > Math.abs(v) ? 0.1 : 0.06;\n  return v + (to - v) * Math.min(1, dt / tau);\n}\n\n/** The player: stick, keys or mouse, whichever was used last. */\nexport class LocalDriver {\n  kind = 'local';\n  keys = new KeyLean();\n\n  /** dial: { x, y } centre of the player's dial in art pixels (mouse lean). */\n  read(out, ctx, dt, app, dial) {\n    const { input } = ctx;\n    const dev = app.device.last;\n    const pad = input.padAxis;\n    const heldKeys = this.keys.step(input, dt, out);\n    out.rate = false;\n    if (dev === 'mouse') {\n      const p = app.device.pointerArt(ctx);\n      const r = app.T.mouseLeanRadius;\n      const cx = dial?.x ?? ctx.hud.width / 2, cy = dial?.y ?? ctx.hud.height / 2;\n      out.x = (p.x - cx) / r; out.y = (cy - p.y) / r;\n      clampDisc(out);\n    } else if (dev === 'pad' || Math.hypot(pad.x, pad.y) > 0) {\n      out.x = pad.x; out.y = pad.y;\n      clampDisc(out);\n    } else {\n      out.rate = heldKeys || dev === 'keyboard';\n    }\n    out.breath = input.anyDown(BREATH);\n    readPresses(out, input, LEFT_FOOT, RIGHT_FOOT, CONFIRM_PLAY);\n    return out;\n  }\n}\n\n/** Keyboard and mouse only: Family Hour's K+M mat, which must not see pads. */\nexport class KeyboardDriver extends LocalDriver {\n  kind = 'keyboard';\n  read(out, ctx, dt, app, dial) {\n    const { input } = ctx;\n    const dev = app.device.lastDesk;\n    const held = this.keys.step(input, dt, out);\n    out.rate = false;\n    if (dev === 'mouse') {\n      const p = app.device.pointerArt(ctx);\n      const r = app.T.mouseLeanRadius;\n      out.x = (p.x - (dial?.x ?? ctx.hud.width / 2)) / r;\n      out.y = ((dial?.y ?? ctx.hud.height / 2) - p.y) / r;\n      clampDisc(out);\n    } else out.rate = held || true;\n    out.breath = input.isDown('Space', 'MouseLeft');\n    readPresses(out, input, DESK_LEFT, DESK_RIGHT, DESK_CONFIRM);\n    return out;\n  }\n}\n\n/** One pad by index. The engine merges pads, so Family Hour reads them itself. */\nexport class PadDriver {\n  kind = 'pad';\n  constructor(index, deadzone) { this.index = index; this.deadzone = deadzone; this.prev = []; }\n  read(out) {\n    const pad = typeof navigator !== 'undefined' && navigator.getGamepads ? navigator.getGamepads()[this.index] : null;\n    out.rate = false;\n    if (!pad) { out.x = out.y = 0; out.breath = out.stepL = out.stepR = out.confirm = false; return out; }\n    const [ax, ay] = this.deadzone(pad.axes[0] ?? 0, pad.axes[1] ?? 0);\n    out.x = ax; out.y = -ay;\n    clampDisc(out);\n    const b = (i) => !!pad.buttons[i]?.pressed;\n    const edge = (i) => b(i) && !this.prev[i];\n    out.breath = b(7) || b(0);\n    out.stepL = edge(4) || edge(6);\n    out.stepR = edge(5) || edge(7);\n    out.confirm = edge(0);\n    for (let i = 0; i < pad.buttons.length; i++) this.prev[i] = b(i);\n    return out;\n  }\n}\n\n/** Bots: the event decides what \"good play\" means. */\nexport class BotDriver {\n  kind = 'bot';\n  constructor(skill, rand) { this.skill = skill; this.brain = new BotBrain(skill, rand); this.rand = rand; }\n}\n\n/** Another player's copy: display only, nothing is simulated. */\nexport class GhostDriver {\n  kind = 'ghost';\n  x = 0; y = 0; tx = 0; ty = 0; clip = 0; clipTime = 0; score = 0; area = -1; lastAt = -1;\n  receive(d) { this.tx = d.x ?? 0; this.ty = d.y ?? 0; this.clip = d.c ?? 0; this.clipTime = d.t ?? 0; this.score = d.s ?? 0; this.area = d.a ?? -1; }\n  lerp(dt) {\n    const k = Math.min(1, dt * 10);\n    this.x += (this.tx - this.x) * k; this.y += (this.ty - this.y) * k;\n  }\n}\n\n","numLines":181,"startLine":1,"totalLines":181}},"tool_result_meta":[{"id":"toolu_01G1EVJsed3AutHiTQXFWYpV","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
