{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjLSJBH8aTYtGBYuVJNm","type":"message","role":"assistant","content":[{"type":"text","text":"The whole week flow already runs headless. Now I'm writing the remaining activities: Reps, Hoop, Step, Header, Slackline, Tray, Pier Jump, Jog and the Long Stand."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16942,"cache_read_input_tokens":425669,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16942},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"166b4b5b-732d-41de-94a7-2f20310804c4","timestamp":"2026-11-05T06:51:24.982Z","request_id":"req_011CgjLSHqgehVq9YFNv5Uew"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjLSJBH8aTYtGBYuVJNm","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EP1cbXigDX4qm4Xu3PoLVf","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\nsed -n 1900,1915p API.md | cut -c1-200; grep -n \"interface RippleOptions\" -A10 API.md </dev/null | cut -c1-170; grep -n \"applyDeadzone\" -A6 API.md </dev/null | sed -n 2,9p | cut -c1-200\ncat > src/scenes/activity/reps.js <<'EOF'\n// The Rep Shed. You scrub the animation with the stick.\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { REPS, EXTRA_REPS, REP_SHAPE } from '../../data/reps.js';\nimport { line, panel, ring as ringLine } from '../../ui/widgets.js';\nimport { sayCentered } from '../../ui/font.js';\nimport { LaneEvent, worldToArt } from './events.js';\nimport { LaneActivity } from './lanes.js';\nimport { shedSet } from '../sets.js';\n\nexport function repTarget(u) {\n  const { up, hold, down } = REP_SHAPE;\n  if (u < up) return u / up;\n  if (u < up + hold) return 1;\n  if (u < up + hold + down) return 1 - (u - up - hold) / down;\n  return 0;\n}\n\nexport class RepsEvent extends LaneEvent {\n  kind = 'reps';\n  lead = 1.2;\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.repId = opts.rep;\n    this.data = REPS[opts.rep];\n    this.announced = opts.reps ?? this.data.reps;\n    this.extra = opts.extra ?? EXTRA_REPS;\n    this.total = this.announced + this.extra;\n    this.baseTempo = this.data.tempo * (this.hard.tempo ?? 1);\n    this.duration = opts.duration ?? this.lead + this.total * this.baseTempo * T.repTempoScale + 0.4;\n  }\n\n  get tempo() { return this.baseTempo * T.repTempoScale; }\n\n  beginLane(l) {\n    l.state = { r: 0, rVis: 0, rep: 0, err: 0, n: 0, sum: 0, count: 0, grade: null, gradeT: 0, lastRep: -1, botR: 0, phase: l.rand() * 6 };\n    l.score = 0;\n    l.avatar?.scrub(this.data.clip, 0);\n  }\n\n  repAt(t) { return Math.floor((t - this.lead) / this.tempo); }\n\n  targetAt(t) {\n    const tt = t - this.lead;\n    if (tt < 0) return 0;\n    const rep = Math.floor(tt / this.tempo);\n    if (rep >= this.total) return 0;\n    return repTarget((tt % this.tempo) / this.tempo);\n  }\n\n  side(rep) { return rep % 2 === 0 ? 1 : -1; }\n\n  /** Stick to rep depth, 0..1. */\n  mapInput(inp, rep) {\n    switch (this.data.input) {\n      case 'down': return Math.max(0, -inp.y);\n      case 'up': return Math.max(0, inp.y);\n      default: return Math.max(0, inp.x * this.side(rep));\n    }\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const st = lane.state;\n    const rep = Math.max(0, this.repAt(t));\n    const lag = T.repLag * (this.data.lagScale ?? 1);\n    if (inp.rate) {\n      // Keys use rate control: S/W move r at the target speed, no key holds it.\n      const speed = 1 / (REP_SHAPE.up * this.tempo);\n      const v = this.data.input === 'down' ? -inp.y : this.data.input === 'up' ? inp.y : inp.x * this.side(rep);\n      if (Math.abs(v) > 0.3) st.r = Math.max(0, Math.min(1, st.r + Math.sign(v) * speed * dt));\n    } else {\n      st.r += (this.mapInput(inp, rep) - st.r) * Math.min(1, dt / lag);\n    }\n    const fatigue = T.repFatigue * (this.hard.fatigue ?? 1) * (rep / this.total) ** 2;\n    st.rVis = Math.max(0, Math.min(1, st.r + fatigue * Math.sin(t * 19 + st.phase)));\n    if (t < this.lead || rep >= this.total) return;\n    if (rep !== st.lastRep) {\n      if (st.lastRep >= 0 && scoring) this.closeRep(lane);\n      st.lastRep = rep;\n      if (lane.isLocal) this.scene.onRep?.(rep, this.announced);\n    }\n    if (scoring) { st.err += Math.abs(st.rVis - this.targetAt(t)); st.n++; lane.score = this.scoreOf(lane); }\n  }\n\n  closeRep(lane) {\n    const st = lane.state;\n    const q = st.n ? Math.max(0, 1 - 1.6 * (st.err / st.n)) : 0;\n    st.sum += q; st.count++;\n    st.err = 0; st.n = 0;\n    st.grade = q >= 0.85 ? 'Perfect' : q >= 0.65 ? 'Good' : 'Wobbly';\n    st.gradeT = 0.9;\n    lane.score = this.scoreOf(lane);\n    if (lane.isLocal) {\n      App.sfx(q >= 0.85 ? 'repPerfect' : 'repTick');\n      if (q >= 0.85) this.ctx.particles.burst('sweat', [lane.x, 1.5, lane.z]);\n    }\n  }\n\n  /** The last rep is closed by the end of the event. */\n  finishLane(lane) { if (lane.state.n > 0) this.closeRep(lane); }\n\n  botInput(lane, out, dt, t, brain) {\n    out.x = out.y = 0;\n    if (!brain.p) return;\n    const play = brain.play;\n    const rep = Math.max(0, this.repAt(t));\n    const st = lane.state;\n    const seen = this.targetAt(t - play.react * 0.45);\n    st.botR += (seen + Math.sin(t * 2.2 + st.phase) * play.wander * 0.5 - st.botR) * Math.min(1, dt / 0.08);\n    const v = Math.max(0, Math.min(1, st.botR));\n    if (this.data.input === 'down') out.y = -v;\n    else if (this.data.input === 'up') out.y = v;\n    else out.x = v * this.side(rep);\n  }\n\n  scoreOf(lane) {\n    const st = lane.state;\n    const n = st.count + (st.n ? 1 : 0);\n    if (!n) return 0;\n    const open = st.n ? Math.max(0, 1 - 1.6 * (st.err / st.n)) : 0;\n    return 100 * ((st.sum + open) / n);\n  }\n\n  clipFor(rep) {\n    if (this.data.input === 'sides' && this.side(rep) < 0) return this.data.clipLeft;\n    return this.data.clip;\n  }\n\n  ghostScrubs(name) { return ['SquatRep', 'LungeRep', 'LungeRepL', 'Press'].includes(name); }\n  clipState(lane) {\n    const rep = Math.max(0, this.repAt(this.lastT ?? 0));\n    return [App.clipIndex(this.clipFor(rep)), lane.state.rVis];\n  }\n\n  visual(ctx, dt, t) {\n    this.lastT = t;\n    const rep = Math.max(0, this.repAt(t));\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) { this.ghostVisual(lane, dt); continue; }\n      if (!lane.frozenClip) lane.avatar.scrub(this.clipFor(rep), lane.state.rVis);\n      lane.avatar.update(dt);\n    }\n  }\n\n  draw(ctx, t) {\n    const { hud } = ctx;\n    for (const lane of this.lanes) {\n      if (!lane.isLocal || lane.gone) continue;\n      const st = lane.state;\n      const small = this.lanes.length >= 4;\n      const rep = Math.max(0, this.repAt(t));\n      const target = this.targetAt(t);\n      let cx, cy, len;\n      if (small) { const p = worldToArt(ctx, lane.x, 2.2, lane.z); cx = Math.round(p.x); cy = Math.max(32, Math.round(p.y) - 20); len = 40; } else { cx = Math.round(hud.width / 2); cy = 58; len = 84; }\n      lane.dial = { x: cx, y: cy };\n      const mouse = App.device.last === 'mouse' && lane.driver.kind !== 'pad' && !App.dev.autopilot ? App.device.pointerArt(ctx) : null;\n      if (this.data.input === 'sides') {\n        // A horizontal track: the marker goes out to the side it wants.\n        const w = small ? 64 : 180, h = 16;\n        panel(hud, cx - w / 2, cy - h / 2, w, h, { fill: 'white', name: 'track' });\n        hud.rect(cx - 1, cy - h / 2, 2, h, 'mist');\n        const s = this.side(rep);\n        const half = w / 2 - 5;\n        const tx = cx + s * target * half;\n        hud.rect(Math.round(tx) - 4, cy - h / 2, 8, h, 'orange');\n        const you = cx + s * st.rVis * half;\n        hud.rect(Math.round(you) - 3, cy - h / 2 + 2, 6, h - 4, 'red');\n        const arrow = s > 0 ? '>' : '<';\n        sayCentered(hud, cx + s * (w / 2 + 8), cy - 4, arrow, { scale: 1, color: 'sand', name: 'track-arrow' });\n      } else {\n        // A vertical track. Squats go down, presses go up.\n        const w = small ? 14 : 22;\n        const dir = this.data.input === 'down' ? 1 : -1;\n        panel(hud, cx - w / 2, cy - len / 2, w, len, { fill: 'white', name: 'track' });\n        const base = dir > 0 ? cy - len / 2 + 4 : cy + len / 2 - 4;\n        const span = len - 8;\n        hud.rect(cx - w / 2, Math.round(base + dir * target * span) - 4, w, 8, 'orange');\n        hud.rect(cx - w / 2 + 2, Math.round(base + dir * st.rVis * span) - 3, w - 4, 6, 'red');\n      }\n      if (mouse) { line(hud, cx, cy, mouse.x, mouse.y, 'mist', 1); ringLine(hud, mouse.x, mouse.y, 3, 1, 'ink'); }\n      if (st.gradeT > 0) sayCentered(hud, cx, small ? cy + 26 : cy + 48, st.grade, { color: st.grade === 'Perfect' ? 'lime' : st.grade === 'Good' ? 'sand' : 'white', name: 'grade' });\n      st.gradeT -= 1 / 60;\n    }\n  }\n}\n\nexport class RepsActivity extends LaneActivity {\n  makeEvent(lanes, rng, hard) { return new RepsEvent(this, lanes, rng, { rep: this.def.rep, hard }); }\n\n  async dress(ctx) {\n    this.set = shedSet(ctx);\n    await this.addCoach(ctx, { at: [3.5, 0, -1.2], yaw: -0.45, clip: 'Watch' });\n    this.lastGag = -1;\n  }\n\n  /** \"Last one.\" Then \"Last one.\" Then \"I lied. This is the last one.\" */\n  onRep(rep, announced) {\n    if (rep === this.lastGag || this.attractMode) return;\n    this.lastGag = rep;\n    if (rep === announced - 1 || rep === announced) App.say('coach', 'Last one.');\n    if (rep === announced + 1) App.say('coach', 'I lied. This is the last one.');\n  }\n\n  result() {\n    return super.result();\n  }\n\n  onOutroStart() {\n    for (const l of this.lanes) this.event.finishLane(l);\n    super.onOutroStart();\n  }\n\n  fingerprint() { const l = this.playerLane; return l ? `${l.state.sum.toFixed(5)}|${l.state.r.toFixed(5)}` : ''; }\n  overlayDot() { const l = this.playerLane; return l ? `r ${l.state.rVis.toFixed(2)} rep ${l.state.rep}` : '-'; }\n  dispose() { this.set?.stop?.(); this.set?.mirror?.dispose?.(); }\n}\nEOF\ncat > src/scenes/activity/hoop.js <<'EOF'\n// Hoop Economics: circle the stick to keep the hoops up. June throws you more.\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { place } from '../../art/props.js';\nimport { HOOP_THROW } from '../../data/hoop.js';\nimport { bar, drawDial, line, ring as ringLine } from '../../ui/widgets.js';\nimport { sayCentered } from '../../ui/font.js';\nimport { LaneEvent, worldToArt } from './events.js';\nimport { LaneActivity } from './lanes.js';\nimport { beachSet } from '../sets.js';\n\nconst TAU = Math.PI * 2;\nconst wrapPi = (a) => ((a + Math.PI * 3) % TAU) - Math.PI;\nconst BOT_RATE = { sloppy: 1.0, average: 1.5, good: 1.75, expert: 2.0 };\n\nexport class HoopEvent extends LaneEvent {\n  kind = 'hoop';\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.duration = opts.duration ?? 60;\n    this.segments = opts.duration ? [[opts.duration * 0.45, 1], [opts.duration * 0.45, -1], [opts.duration * 0.1, 0]] : [[25, 1], [25, -1], [10, 0]];\n    this.throws = [];\n    let t = HOOP_THROW.first;\n    while (t < this.duration - 3) {\n      this.throws.push({ t, side: rng.chance(0.5) ? 1 : -1 });\n      t += rng.range(HOOP_THROW.gap - 1.5, HOOP_THROW.gap + 1.5);\n    }\n  }\n\n  dirAt(t) {\n    let acc = 0;\n    for (const [len, d] of this.segments) { acc += len; if (t < acc) return d; }\n    return 0;\n  }\n\n  band() {\n    const k = this.hard.band ?? 1;\n    const mid = (T.hoopLow + T.hoopHigh) / 2, half = ((T.hoopHigh - T.hoopLow) / 2) * k;\n    return [mid - half, mid + half];\n  }\n\n  beginLane(l) {\n    l.state = {\n      a: 0, lastA: null, w: 0, lift: 0.5, hoops: 1, down: 0, angle: 0, score: 0, inBand: false, wrongWay: false, catches: 0, thrown: 0, rot: 0,\n      throwI: 0, flicked: false, botA: l.rand() * TAU, phase: l.rand() * 6, flickT: 0, plannedCatch: false,\n    };\n    l.score = 0;\n    for (const h of l.hoopMeshes ?? []) h.visible = false;\n    l.avatar?.play('Idle', { fade: 0.3 });\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const st = lane.state;\n    const mag = Math.hypot(inp.x, inp.y);\n    let raw = 0;\n    if (mag > 0.5) {\n      const a = Math.atan2(inp.y, inp.x);\n      if (st.lastA !== null) raw = (wrapPi(a - st.lastA) / dt) / TAU;\n      st.lastA = a;\n    } else st.lastA = null;\n    st.w += (raw - st.w) * Math.min(1, dt / 0.25);\n    const dir = this.dirAt(t);\n    const speed = Math.abs(st.w);\n    const way = dir === 0 ? Math.sign(st.w) || 1 : dir;\n    const [low, high] = this.band();\n    const right = st.w * way > 0;\n    st.inBand = right && speed >= low && speed <= high;\n    st.wrongWay = !right && speed > 0.3;\n    if (st.down > 0) {\n      // Picking it up. For 1.5 s you have no hoop and a comment.\n      st.down -= dt;\n      if (st.down <= 0) { st.lift = 0.4; }\n    } else {\n      const rate = T.hoopLiftRate * (this.hard.lift ?? 1);\n      st.lift += (st.inBand ? rate : st.wrongWay ? -0.5 : -0.25) * dt;\n      st.lift = Math.min(1, st.lift);\n      if (st.lift <= 0) {\n        st.lift = 0;\n        st.down = 1.5;\n        st.hoops = 1;\n        if (lane.isLocal) { App.sfx('hoopDrop'); this.scene.hoopDropped?.(); }\n      }\n      if (st.inBand) {\n        st.rot += speed * dt;\n        if (scoring) st.score += speed * dt * (1 + 0.5 * (st.hoops - 1));\n        if (lane.isLocal && Math.floor(st.rot * 2) !== Math.floor((st.rot - speed * dt) * 2)) this.ctx.particles.burst('hoopSpark', [lane.x, 0.9, lane.z]);\n      }\n    }\n    st.angle += st.w * TAU * dt;\n    lane.score = st.score;\n    this.stepThrows(lane, inp, t);\n  }\n\n  stepThrows(lane, inp, t) {\n    const st = lane.state;\n    const th = this.throws[st.throwI];\n    if (!th) return;\n    if (t >= th.t - HOOP_THROW.telegraph && !st.announced) { st.announced = true; if (lane.isLocal) App.sfx('gust', { volume: 0.3 }); }\n    if (t >= th.t - HOOP_THROW.window && t <= th.t && Math.abs(inp.x) > 0.7 && Math.sign(inp.x) === th.side && st.down <= 0) {\n      if (st.hoops < 4) st.hoops++;\n      st.catches++;\n      st.caught = t;\n      if (lane.isLocal) { App.sfx('hoopCatch'); this.ctx.particles.burst('confetti', [lane.x, 1.2, lane.z], { count: 12 }); }\n      st.throwI++; st.announced = false;\n      return;\n    }\n    if (t > th.t) { st.throwI++; st.announced = false; }\n  }\n\n  botInput(lane, out, dt, t, brain) {\n    out.x = out.y = 0;\n    if (!brain.p) return;\n    const st = lane.state;\n    const dir = this.dirAt(t) || 1;\n    const base = BOT_RATE[brain.skill] ?? 1.5;\n    const rate = base + Math.sin(t * 0.7 + st.phase) * brain.play.wander * 1.2;\n    // Sloppy circlers stop to think.\n    const slack = brain.skill === 'sloppy' && Math.sin(t * 0.45 + st.phase) > 0.25;\n    if (!slack) st.botA += dir * rate * TAU * dt;\n    out.x = Math.cos(st.botA);\n    out.y = Math.sin(st.botA);\n    if (slack) { out.x *= 0.3; out.y *= 0.3; }\n    const th = this.throws[st.throwI];\n    if (th && t >= th.t - HOOP_THROW.window + 0.03 && t <= th.t) {\n      if (st.planFor !== st.throwI) { st.planFor = st.throwI; st.planned = lane.rand() > brain.play.miss * 4 && st.hoops < 4; }\n      if (st.planned) { out.x = th.side; out.y = 0; }\n    }\n  }\n\n  scoreOf(lane) { return lane.state.score; }\n  normalized(lane) { return Math.min(1000, Math.round((lane.state.score / 130) * 1000)); }\n\n  visual(ctx, dt, t) {\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) { this.ghostVisual(lane, dt); this.hoopVisual(lane, t, true); continue; }\n      const st = lane.state;\n      if (!lane.frozenClip) lane.avatar.play(st.down > 0 ? 'Slump' : 'Idle', { fade: 0.25 });\n      lane.avatar.update(dt);\n      const c = st.down > 0 ? 0 : Math.min(1, Math.abs(st.w)) * 0.75;\n      lane.avatar.lean(Math.cos(st.angle) * c, Math.sin(st.angle) * c, 0, t);\n      this.hoopVisual(lane, t, false);\n    }\n  }\n\n  hoopVisual(lane, t, ghost) {\n    const meshes = lane.hoopMeshes;\n    if (!meshes) return;\n    const st = lane.state;\n    const n = ghost ? 1 : (st.down > 0 ? 0 : st.hoops);\n    for (let i = 0; i < meshes.length; i++) {\n      const m = meshes[i];\n      m.visible = i < n;\n      if (!m.visible) continue;\n      const lift = ghost ? 0.8 : st.lift;\n      const a = (ghost ? t * 8 : st.angle) + i * 1.3;\n      const r = 0.1 + (1 - lift) * 0.18;\n      m.position.set(lane.x + Math.cos(a) * r, 0.25 + 0.72 * lift + i * 0.1, lane.z + Math.sin(a) * r);\n      m.rotation.x = Math.sin(a) * (0.32 - lift * 0.2);\n      m.rotation.z = Math.cos(a) * (0.32 - lift * 0.2);\n    }\n  }\n\n  draw(ctx, t) {\n    const { hud } = ctx;\n    for (const lane of this.lanes) {\n      if (!lane.isLocal || lane.gone) continue;\n      const st = lane.state;\n      const small = this.lanes.length >= 4;\n      let x, y, r;\n      if (small) { const p = worldToArt(ctx, lane.x, 2.2, lane.z); x = p.x; y = Math.max(38, p.y - 24); r = 24; } else { x = Math.round(hud.width / 2); y = 56; r = 44; }\n      lane.dial = { x, y };\n      const dir = this.dirAt(t);\n      drawDial(hud, { x, y, r, dot: null, ringR: 0.9, fade: 1, inside: st.inBand, brighten: st.inBand ? 1 : 0 });\n      // The stick, on the circle, and which way to go.\n      const inp = lane.inp;\n      const s = r / 1.2 * 0.9;\n      const dx = x + inp.x * s, dy = y - inp.y * s;\n      ringLine(hud, dx, dy, 3, 2, st.inBand ? 'lime' : 'red');\n      if (dir !== 0) {\n        const steps = 5;\n        for (let i = 0; i < steps; i++) {\n          const a = t * 2.4 * dir + (i / steps) * TAU;\n          hud.rect(Math.round(x + Math.cos(a) * r * 0.42) - 1, Math.round(y - Math.sin(a) * r * 0.42) - 1, 2, 2, i === 0 ? 'orange' : 'mist');\n        }\n      }\n      bar(hud, x - r, y + r + 5, r * 2, 6, st.lift, st.inBand ? 'lime' : 'cyan', 'ink', 'lift');\n      if (!small) {\n        const label = dir === 1 ? 'Anticlockwise.' : dir === -1 ? 'Now the other way.' : 'Either way.';\n        sayCentered(hud, x, y + r + 14, label, { color: 'white', name: 'hoop-way' });\n      }\n      const mouse = App.device.last === 'mouse' && lane.driver.kind !== 'pad' && !App.dev.autopilot ? App.device.pointerArt(ctx) : null;\n      if (mouse) line(hud, x, y, mouse.x, mouse.y, 'mist', 1);\n      // June's throw.\n      const th = this.throws[st.throwI];\n      if (th && t >= th.t - HOOP_THROW.telegraph && t <= th.t) {\n        const u = 1 - (th.t - t) / HOOP_THROW.telegraph;\n        const late = t >= th.t - HOOP_THROW.window;\n        const fx = x + th.side * (r + 22 + (1 - u) * 44);\n        ringLine(hud, fx, y, 9, 3, late ? 'lime' : 'red');\n        sayCentered(hud, x + th.side * (r + 22), y + 14, late ? 'Catch!' : 'June!', { color: late ? 'lime' : 'sand', name: 'catch' });\n        // A landing shadow, near your lane.\n        const p = worldToArt(ctx, lane.x + th.side * 0.9, 0.05, lane.z);\n        hud.rect(Math.round(p.x) - 8, Math.round(p.y) - 1, 16, 3, late ? 'lime' : 'slate');\n      }\n      if (st.hoops > 1 && !small) sayCentered(hud, x, y - r - 8 < 0 ? 2 : y + r + 24, `x${1 + 0.5 * (st.hoops - 1)}`, { color: 'sand', name: 'hoop-mult' });\n    }\n  }\n}\n\nexport class HoopActivity extends LaneActivity {\n  makeEvent(lanes, rng, hard) { return new HoopEvent(this, lanes, rng, { hard }); }\n\n  async dress(ctx) {\n    this.set = beachSet(ctx);\n    await this.addCoach(ctx, { at: [3.6, 0, -1], yaw: -0.5, clip: 'Watch' });\n    this.lastRemark = -10;\n  }\n\n  afterLanes(ctx) {\n    for (const lane of this.lanes) lane.hoopMeshes = [0, 1, 2, 3].map((i) => {\n      const m = place(ctx, 'hoop', { palette: { hoop: ['red', 'sky', 'lime', 'sand'][i] }, actor: true, shadow: false }).object;\n      m.visible = false;\n      return m;\n    });\n    this.whirr = ctx.audio.loop('hoopWhirr', { volume: 0 });\n  }\n\n  hoopDropped() {\n    if (this.t - this.lastRemark < 6) return;\n    this.lastRemark = this.t;\n    App.say('ounce', this.cosmetic.pick(['The hoop has left you. It left a note.', 'Pick it up. Everyone is watching. No one is helping.', 'The hoop has been downgraded.']));\n  }\n\n  playVisual() {\n    const st = this.playerLane?.state;\n    this.whirr?.set({ volume: st && st.inBand ? 0.6 : 0, pitch: st ? Math.min(6, Math.abs(st.w) * 2) : 0 });\n  }\n\n  scoreText() { return `${Math.floor(this.playerLane.state.score)}`; }\n  fingerprint() { const l = this.playerLane; return l ? `${l.state.score.toFixed(5)}|${l.state.lift.toFixed(5)}` : ''; }\n  overlayDot() { const l = this.playerLane; return l ? `w ${l.state.w.toFixed(2)} lift ${l.state.lift.toFixed(2)} x${l.state.hoops}` : '-'; }\n}\nEOF\ncat > src/data/hoop.js <<'EOF'\n// June's throws: every ~9 s, 1.5 s of telegraph, flick in the last .4 s.\nexport const HOOP_THROW = { first: 7, gap: 9, telegraph: 1.5, window: 0.4 };\nEOF\ncat > src/scenes/activity/step.js <<'EOF'\n// Step Class. Footprints scroll to a hit line. Left foot, right foot. It is not complicated.\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { STEP_BPM, STEP_SONG, stepSongFrom } from '../../audio/songs.js';\nimport { STEP_CHART, STEP_CHART_HARD, STEP_CHART_MEDLEY, WEIGHTS, WINDOWS } from '../../data/charts.js';\nimport { sayCentered, say, sayRight } from '../../ui/font.js';\nimport { panel } from '../../ui/widgets.js';\nimport { LaneEvent, worldToArt } from './events.js';\nimport { LaneActivity } from './lanes.js';\nimport { beachSet } from '../sets.js';\n\nexport const BAR_SECONDS = (60 / STEP_BPM) * 4;\nconst EIGHTH = BAR_SECONDS / 8;\nconst FOOT_L = ['..oo.', '.ooo.', '.ooo.', '.oo..', '.....', '.oo..', '.oo..'];\nconst FOOT_R = ['.oo..', '.ooo.', '.ooo.', '..oo.', '.....', '..oo.', '..oo.'];\n\nexport function chartNotes(chart) {\n  const notes = [];\n  chart.forEach((bar, b) => {\n    [...bar].forEach((c, i) => {\n      if (c === 'L' || c === 'R') notes.push({ t: (b + i / 8) * BAR_SECONDS, foot: c });\n    });\n  });\n  return notes;\n}\n\nexport class StepEvent extends LaneEvent {\n  kind = 'step';\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.chart = opts.chart ?? (this.hard.chart === 'hard' ? STEP_CHART_HARD : STEP_CHART);\n    this.notes = chartNotes(this.chart);\n    this.duration = opts.duration ?? this.chart.length * BAR_SECONDS + 1;\n    this.windowScale = this.hard.window ?? 1;\n  }\n\n  /** The song's clock when audio runs, otherwise game time. */\n  clock(t) { return this.scene.beatClock ? this.scene.beatClock(t) : t; }\n\n  beginLane(l) {\n    l.state = { i: 0, P: 0, G: 0, O: 0, M: 0, combo: 0, best: 0, last: null, lastT: 0, botI: 0, botAt: null, botFoot: null, stepClip: null };\n    l.score = 0;\n    l.avatar?.play('StepRest', { fade: 0.25 });\n    l.judged = new Int8Array(this.notes.length);\n  }\n\n  window(name) { return WINDOWS[name] * T.stepWindow * this.windowScale; }\n\n  press(lane, foot, now) {\n    const st = lane.state;\n    const off = T.stepOffsetMs / 1000;\n    const notes = this.notes;\n    const ok = this.window('ok');\n    let found = -1, bestErr = Infinity;\n    for (let i = st.i; i < notes.length; i++) {\n      const n = notes[i];\n      const err = now - off - n.t;\n      if (err < -ok) break;\n      if (lane.judged[i] || n.foot !== foot) continue;\n      if (Math.abs(err) < bestErr) { bestErr = Math.abs(err); found = i; }\n    }\n    lane.avatar?.play(foot === 'L' ? 'StepL' : 'StepR', { once: true, fade: 0.04, then: () => lane.avatar?.play('StepRest', { fade: 0.1 }) });\n    if (found < 0) { st.combo = 0; st.last = 'Off'; st.lastT = now; return; }\n    lane.judged[found] = 1;\n    const grade = bestErr <= this.window('perfect') ? 'P' : bestErr <= this.window('good') ? 'G' : 'O';\n    st[grade]++;\n    st.combo++;\n    st.best = Math.max(st.best, st.combo);\n    st.last = grade === 'P' ? 'Perfect' : grade === 'G' ? 'Good' : 'OK';\n    st.lastT = now;\n    if (lane.isLocal) {\n      App.sfx(grade === 'P' ? 'stepPerfect' : 'stepGood');\n      if (st.combo % 16 === 0) { App.sfx('combo'); this.ctx.particles.burst('confetti', [lane.x, 1.6, lane.z]); }\n    }\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const st = lane.state;\n    const now = this.clock(t);\n    const off = T.stepOffsetMs / 1000;\n    if (inp.stepL) this.press(lane, 'L', now);\n    if (inp.stepR) this.press(lane, 'R', now);\n    const ok = this.window('ok');\n    while (st.i < this.notes.length && now - off - this.notes[st.i].t > ok) {\n      if (!lane.judged[st.i]) {\n        lane.judged[st.i] = 2;\n        st.M++;\n        st.combo = 0;\n        st.last = 'Miss';\n        st.lastT = now;\n        if (lane.isLocal && scoring) App.sfx('stepMiss');\n      }\n      st.i++;\n    }\n    lane.score = this.scoreOf(lane);\n  }\n\n  botInput(lane, out, dt, t, brain) {\n    out.x = out.y = 0;\n    out.stepL = out.stepR = false;\n    if (!brain.p) return;\n    const st = lane.state;\n    const now = this.clock(t);\n    const off = T.stepOffsetMs / 1000;\n    const play = brain.play;\n    while (st.botI < this.notes.length) {\n      const n = this.notes[st.botI];\n      if (st.botAt === null) {\n        st.botAt = lane.rand() < play.miss ? Infinity : n.t + off + (lane.rand() + lane.rand() - 1) * play.timing * 1.2;\n      }\n      if (st.botAt === Infinity) {\n        if (now - off - n.t > 0.2) { st.botI++; st.botAt = null; continue; }\n        break;\n      }\n      if (now >= st.botAt) {\n        if (n.foot === 'L') out.stepL = true; else out.stepR = true;\n        st.botI++; st.botAt = null;\n        if (this.notes[st.botI]?.foot === n.foot) break;\n        continue;\n      }\n      break;\n    }\n  }\n\n  scoreOf(lane) {\n    const st = lane.state;\n    return 100 * ((st.P * WEIGHTS.perfect + st.G * WEIGHTS.good + st.O * WEIGHTS.ok) / Math.max(1, this.notes.length));\n  }\n\n  visual(ctx, dt) {\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) { this.ghostVisual(lane, dt); continue; }\n      lane.avatar.update(dt);\n    }\n  }\n\n  draw(ctx, t) {\n    const { hud } = ctx;\n    const now = this.clock(t);\n    const off = T.stepOffsetMs / 1000;\n    const lanes = this.lanes.filter((l) => l.isLocal && !l.gone);\n    lanes.forEach((lane) => {\n      const small = this.lanes.length >= 4;\n      const st = lane.state;\n      const px = small ? worldToArt(ctx, lane.x, 2.2, lane.z) : null;\n      const w = small ? 92 : Math.min(hud.width - 28, 380);\n      const cx = small ? Math.max(w / 2 + 2, Math.min(hud.width - w / 2 - 2, px.x)) : hud.width / 2;\n      const x = Math.round(cx - w / 2);\n      const y = small ? Math.max(24, Math.round(px.y) - 42) : 26;\n      const h = small ? 28 : 46;\n      panel(hud, x, y, w, h, { fill: 'white', name: 'highway' });\n      const rowL = y + Math.round(h * 0.25), rowR = y + Math.round(h * 0.75);\n      hud.rect(x, y + Math.round(h / 2), w, 1, 'mist');\n      const hitX = x + (small ? 16 : 40);\n      hud.rect(hitX - 1, y, 3, h, 'teal');\n      const pxPerSec = small ? 42 : 96;\n      const horizon = (w - (hitX - x)) / pxPerSec;\n      for (let i = st.i; i < this.notes.length; i++) {\n        const n = this.notes[i];\n        const dt2 = n.t + off - now;\n        if (dt2 > horizon) break;\n        if (lane.judged[i]) continue;\n        const nx = hitX + dt2 * pxPerSec;\n        if (nx < x + 2) continue;\n        const left = n.foot === 'L';\n        const yy = (left ? rowL : rowR) - 7;\n        hud.sprite(Math.round(nx) - 5, yy, left ? FOOT_L : FOOT_R, { o: left ? 'blue' : 'orange' }, { scale: small ? 1 : 2, shadow: false });\n      }\n      if (!small) {\n        say(hud, x + 3, rowL - 4, 'L', { color: 'blue', shadow: false, name: 'hw-l' });\n        say(hud, x + 3, rowR - 4, 'R', { color: 'orange', shadow: false, name: 'hw-r' });\n      }\n      if (now - st.lastT < 0.6 && st.last) sayCentered(hud, hitX + (small ? 16 : 26), y + h + 3, st.last, { color: st.last === 'Perfect' ? 'lime' : st.last === 'Miss' || st.last === 'Off' ? 'red' : 'sand', name: 'judge' });\n      if (st.combo >= 4) sayRight(hud, x + w - 2, y + h + 3, `${st.combo} combo`, { color: 'white', name: 'combo' });\n    });\n  }\n}\n\nexport class StepActivity extends LaneActivity {\n  counting = 0;\n  localClock = 0;\n  offset = 0;\n\n  makeEvent(lanes, rng, hard) { return new StepEvent(this, lanes, rng, { hard }); }\n  laneOptions() { return { mat: 'step-platform' }; }\n  startMusic() {}\n\n  async dress(ctx) {\n    this.set = beachSet(ctx);\n    await this.addCoach(ctx, { at: [3.6, 0, -1], yaw: -0.5, clip: 'Watch' });\n  }\n\n  onEnter(phase) {\n    if (phase === 'practice' || phase === 'play') this.startSongAt(0);\n    if (phase === 'countdown' || phase === 'outro') this.ctx.audio.stopMusic();\n  }\n\n  startSongAt(bar) {\n    this.offset = bar * BAR_SECONDS;\n    this.localClock = this.offset;\n    this.ctx.audio.playMusic(bar === 0 ? { ...STEP_SONG, order: STEP_SONG.order, loop: false } : stepSongFrom(bar), 'step');\n    this.songStarted = true;\n  }\n\n  /** The song's step clock when audio runs (undocumented but present), otherwise game time. */\n  beatClock() {\n    const a = this.ctx.audio;\n    const song = a.song;\n    if (a.context && a.unlocked && song && typeof song.start === 'number' && !this.attractMode && !App.dev.autopilot) {\n      const audioT = a.context.currentTime - song.start;\n      if (audioT >= 0) return audioT + this.offset;\n    }\n    return this.localClock;\n  }\n\n  /** On pause: stop the music. On resume: count in and restart at the current bar. */\n  onPause() { if (this.phase === 'play') this.ctx.audio.stopMusic(); }\n  onResume() {\n    if (this.phase !== 'play') return;\n    const bar = Math.floor(this.beatClock() / BAR_SECONDS);\n    this.resumeBar = bar;\n    this.localClock = bar * BAR_SECONDS;\n    this.offset = this.localClock;\n    this.counting = (60 / STEP_BPM) * 4;\n    this.countBeat = 4;\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    if (this.counting > 0) {\n      this.counting -= dt;\n      const n = Math.ceil(this.counting / (60 / STEP_BPM));\n      if (n !== this.countBeat && n > 0) { this.countBeat = n; App.sfx('count'); }\n      if (this.counting <= 0) this.startSongAt(this.resumeBar);\n      return;\n    }\n    this.localClock += dt;\n    this.eventT = this.localClock;\n    this.event.step(ctx, dt, this.eventT, scoring);\n  }\n\n  isOver() { return this.localClock >= this.event.duration; }\n  playLength() { return this.event.duration; }\n  begin() { super.begin(); this.localClock = 0; this.offset = 0; }\n\n  drawGame(ctx) {\n    super.drawGame(ctx);\n    if (this.counting > 0) sayCentered(ctx.hud, ctx.hud.width / 2, Math.round(ctx.hud.height * 0.42), String(Math.ceil(this.counting / (60 / STEP_BPM))), { scale: 4, color: 'sand', name: 'count-in' });\n  }\n\n  scoreText() { return `${Math.round(this.event.scoreOf(this.playerLane))}%`; }\n  fingerprint() { const l = this.playerLane; return l ? `${l.state.P}|${l.state.G}|${l.state.O}|${l.state.M}|${l.state.combo}` : ''; }\n  overlayDot() { const l = this.playerLane; return l ? `P${l.state.P} G${l.state.G} O${l.state.O} M${l.state.M}` : '-'; }\n}\n\nexport { STEP_CHART_MEDLEY };\nEOF\ncat > src/scenes/activity/header.js <<'EOF'\n// Coconut Header. Lean along the sand. Dennis runs a catapult. Dennis stops being fine.\nimport { ContactShadow, THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { place } from '../../art/props.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { sayCentered, sayRight } from '../../ui/font.js';\nimport { LaneEvent, worldToArt } from './events.js';\nimport { LaneActivity, playerInfo } from './lanes.js';\nimport { lagoonSet } from '../sets.js';\n\nconst { Vector3 } = THREE;\nexport const HEADER = { flight: 1.4, reach: 0.55, speed: 4.5, startGap: 1.3, endGap: 0.7, tiers: [[20, 4], [10, 3], [5, 2]], coconut: 10, flip: -10, pineapple: 30, daze: 0.6 };\nconst POOL = { coconut: 5, flip: 3, pineapple: 1 };\nconst MODEL = { coconut: 'coconut', flip: 'flip-flop', pineapple: 'golden-pineapple' };\n\nexport class HeaderEvent extends LaneEvent {\n  kind = 'header';\n  time = 0;\n  next = 0.8;\n  waves = [];\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.duration = opts.duration ?? 60;\n    this.range = opts.range ?? (lanes.length === 1 ? 2 : 0.8);\n    this.flipShare = this.hard.flipFlop ?? 0.25;\n  }\n\n  gap(t) {\n    const u = Math.min(1, t / this.duration);\n    return (HEADER.startGap + (HEADER.endGap - HEADER.startGap) * u) * T.headerInterval * (this.hard.interval ?? 1);\n  }\n\n  beginLane(l) {\n    l.state = { pos: 0, combo: 0, score: 0, daze: 0, heads: 0, hitT: 0, phase: l.rand() * 6, wave: 0, seen: 0 };\n    l.score = 0;\n    l.avatar?.play('Idle', { fade: 0.2 });\n  }\n\n  begin() {\n    this.next = 0.8;\n    this.waves.length = 0;\n    this.rngPlay = this.rng.fork('waves');\n    super.begin();\n    for (const l of this.lanes) for (const o of l.objects ?? []) { o.mesh.visible = false; o.shadow.visible = false; o.busy = false; }\n  }\n\n  /** The same object waves for everyone, in lane-relative x. */\n  tick(ctx, dt, t) {\n    if (t >= this.next && t < this.duration - HEADER.flight) {\n      const r = this.rngPlay.next();\n      const type = r < 0.05 ? 'pineapple' : r < 0.05 + this.flipShare ? 'flip' : 'coconut';\n      const x = this.rngPlay.range(-this.range, this.range);\n      this.waves.push({ t0: t, t1: t + HEADER.flight, type, x });\n      this.next = t + this.gap(t);\n      this.scene.onLaunch?.();\n    }\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const st = lane.state;\n    if (st.daze > 0) st.daze -= dt;\n    else st.pos = Math.max(-this.range, Math.min(this.range, st.pos + HEADER.speed * inp.x * dt));\n    while (st.wave < this.waves.length && this.waves[st.wave].t1 <= t) {\n      const w = this.waves[st.wave];\n      const hit = Math.abs(st.pos - w.x) < HEADER.reach;\n      if (hit) this.onHit(ctx, lane, w, scoring);\n      else if (w.type !== 'flip') { st.combo = 0; }\n      st.wave++;\n    }\n    lane.score = st.score;\n  }\n\n  tier(combo) {\n    for (const [at, mult] of HEADER.tiers) if (combo >= at) return mult;\n    return 1;\n  }\n\n  onHit(ctx, lane, w, scoring) {\n    const st = lane.state;\n    const at = [lane.x + w.x, 1.65, lane.z];\n    if (w.type === 'flip') {\n      if (scoring) st.score = Math.max(0, st.score + HEADER.flip);\n      st.combo = 0;\n      st.daze = HEADER.daze;\n      if (lane.isLocal) { App.sfx('flipFlopThwap'); this.scene.onThwap?.(); ctx.particles.burst('puff', at); }\n      lane.avatar?.play('Daze', { fade: 0.08 });\n      lane.dazeUntil = HEADER.daze;\n      return;\n    }\n    const value = w.type === 'pineapple' ? HEADER.pineapple : HEADER.coconut * this.tier(st.combo);\n    if (scoring) st.score += value;\n    if (w.type === 'coconut') st.combo++;\n    st.heads++;\n    st.hitT = 0.3;\n    lane.avatar?.play('HeaderNod', { once: true, fade: 0.03, then: () => lane.avatar?.play('Idle', { fade: 0.1 }) });\n    lane.avatar?.squash.kick(-0.9);\n    if (lane.isLocal) {\n      App.sfx(w.type === 'pineapple' ? 'pineapple' : 'coconutBonk', { pitch: Math.min(12, st.combo * 0.3) });\n      if (!App.dev.autopilot && !this.scene.attractMode) ctx.engine.hitstop(0.05);\n      ctx.particles.burst('bonk', at);\n      this.scene.onHeaded?.(lane, st, value);\n      if ([5, 10, 20].includes(st.combo)) { App.sfx('combo'); ctx.particles.burst('confetti', at); }\n    }\n  }\n\n  botInput(lane, out, dt, t, brain) {\n    out.x = out.y = 0;\n    if (!brain.p) return;\n    const st = lane.state;\n    const play = brain.play;\n    let target = st.pos;\n    let avoid = null;\n    for (let i = st.wave; i < this.waves.length; i++) {\n      const w = this.waves[i];\n      if (t - w.t0 < play.react) continue;\n      if (w.type === 'flip') { if (avoid === null && w.t1 - t < 0.6) avoid = w.x; continue; }\n      target = w.x + Math.sin(t * 2 + st.phase) * play.wander;\n      break;\n    }\n    if (avoid !== null && Math.abs(target - avoid) < HEADER.reach + 0.1) target = avoid + Math.sign(target - avoid || 1) * (HEADER.reach + 0.2);\n    out.x = Math.max(-1, Math.min(1, (target - st.pos) * 3.5)) * play.speed;\n  }\n\n  scoreOf(lane) { return lane.state.score; }\n  normalized(lane) { return Math.min(1000, Math.round((lane.state.score / 900) * 1000)); }\n\n  visual(ctx, dt, t) {\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) {\n        this.ghostVisual(lane, dt);\n        lane.avatar.root.position.x = lane.x + lane.driver.x;\n        continue;\n      }\n      const st = lane.state;\n      if (st.daze <= 0 && lane.dazeUntil) { lane.dazeUntil = 0; if (!lane.frozenClip) lane.avatar.play('Idle', { fade: 0.15 }); }\n      lane.avatar.root.position.x = lane.x + st.pos;\n      lane.avatar.update(dt);\n      lane.avatar.lean(lane.inp.x * 0.8, 0, 0, t);\n      this.objects(ctx, lane, t);\n    }\n  }\n\n  objects(ctx, lane, t) {\n    if (!lane.objects) return;\n    const st = lane.state;\n    for (const o of lane.objects) { o.mesh.visible = false; o.shadow.visible = false; }\n    const used = {};\n    for (let i = st.wave; i < this.waves.length; i++) {\n      const w = this.waves[i];\n      const u = (t - w.t0) / (w.t1 - w.t0);\n      if (u < 0 || u >= 1) continue;\n      used[w.type] = (used[w.type] ?? 0);\n      const o = lane.pool[w.type][used[w.type]++];\n      if (!o) continue;\n      const x = lane.x + w.x, z = lane.z;\n      const y = 1.7 + (1 - u) * (1 - u) * 1.2 + Math.sin(u * Math.PI) * 5.2;\n      const zFrom = this.launchZ ?? -7;\n      o.mesh.visible = true;\n      o.mesh.position.set(x * Math.min(1, u * 1.6) + (lane.launchX ?? 0) * (1 - Math.min(1, u * 1.6)), y, zFrom + (z - zFrom) * u);\n      o.mesh.rotation.x = t * 7;\n      o.mesh.rotation.z = t * 5;\n      o.shadow.visible = true;\n      o.shadow.place(x, 0.02, z, Math.max(0, (1 - u) * 1.2));\n    }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    for (const lane of this.lanes) {\n      if (!lane.isLocal || lane.gone) continue;\n      const st = lane.state;\n      const small = this.lanes.length >= 4;\n      if (small) {\n        const p = worldToArt(ctx, lane.x + st.pos, 2.2, lane.z);\n        lane.dial = { x: p.x, y: p.y };\n        sayCentered(hud, p.x, Math.max(26, p.y - 20), `${st.score}`, { color: 'sand', name: 'head-score' });\n        if (st.combo >= 5) sayCentered(hud, p.x, Math.max(36, p.y - 10), `x${this.tier(st.combo)}`, { color: 'lime', name: 'head-combo' });\n      } else {\n        lane.dial = { x: hud.width / 2, y: hud.height / 2 };\n        if (st.combo >= 5) sayCentered(hud, hud.width / 2, 26, `x${this.tier(st.combo)}  ${st.combo} in a row`, { scale: 2, color: 'lime', name: 'head-combo' });\n      }\n    }\n    void sayRight;\n  }\n}\n\nexport async function buildHeaderProps(ctx, lane) {\n  lane.objects = [];\n  lane.pool = {};\n  for (const [type, n] of Object.entries(POOL)) {\n    lane.pool[type] = [];\n    for (let i = 0; i < n; i++) {\n      const mesh = place(ctx, MODEL[type], { actor: true, shadow: false }).object;\n      const shadow = new ContactShadow(type === 'pineapple' ? 0.34 : 0.26);\n      ctx.scene.add(shadow);\n      mesh.visible = false;\n      const o = { mesh, shadow };\n      lane.pool[type].push(o);\n      lane.objects.push(o);\n    }\n  }\n}\n\nexport class HeaderActivity extends LaneActivity {\n  makeEvent(lanes, rng, hard) { return new HeaderEvent(this, lanes, rng, { hard }); }\n  laneOptions() { return { mat: null, z: 1.2 }; }\n  laneSpecs() {\n    const p = playerInfo();\n    return [{ name: p.name, look: p.look, driver: this.driver, isPlayer: true, isLocal: true, color: 'red' }];\n  }\n\n  async dress(ctx) {\n    this.set = lagoonSet(ctx);\n    this.catapult = place(ctx, 'catapult', { at: [0, 0, -7], yaw: 180, scale: 1.2 });\n    this.arm = this.catapult.object.getObjectByName('arm');\n    this.dennis = await makeAvatar(ctx, LOOKS.dennis, { at: [2.4, 0, -7], yaw: -0.6, clip: 'Idle' });\n    this.spare = place(ctx, 'coconut', { at: [1.6, 0, -6.2], scale: 1.1 });\n    this.armT = 0;\n    this.dennisHits = 0;\n  }\n\n  async afterLanes(ctx) {\n    this.event.launchZ = -7;\n    await buildHeaderProps(ctx, this.lanes[0]);\n    for (const o of this.lanes[0].objects) o.mesh.scale.setScalar(1.2);\n    // A ball that goes back the other way, at Dennis.\n    this.returning = [];\n    for (let i = 0; i < 4; i++) { const m = place(ctx, 'coconut', { actor: true, shadow: false }).object; m.visible = false; this.returning.push({ m, u: 1 }); }\n  }\n\n  onLaunch() { this.armT = 0.35; App.sfx('catapult', { volume: 0.6 }); }\n\n  onThwap() { if (this.t > (this.remarkT ?? 0)) { this.remarkT = this.t + 5; App.say('ounce', this.cosmetic.pick(['That one had a strap. They have straps.', 'Flip-flop. I did mention.', 'Please only head the round ones.'])); } }\n\n  onHeaded(lane, st) {\n    const free = this.returning.find((r) => r.u >= 1);\n    if (free && st.combo >= 3) { free.u = 0; free.x = lane.x + st.pos; free.m.visible = true; }\n  }\n\n  playVisual(ctx, dt) {\n    this.armT = Math.max(0, this.armT - dt);\n    if (this.arm) this.arm.rotation.x = this.armT > 0 ? -1.2 * (this.armT / 0.35) : 0.2;\n    for (const r of this.returning ?? []) {\n      if (r.u >= 1) continue;\n      r.u = Math.min(1, r.u + dt / 0.9);\n      r.m.position.set(r.x + (2.4 - r.x) * r.u, 1.7 + Math.sin(r.u * Math.PI) * 2.4, 1.2 + (-7 - 1.2) * r.u);\n      r.m.rotation.x += dt * 12;\n      if (r.u >= 1) {\n        r.m.visible = false;\n        this.dennisHits++;\n        App.sfx('coconutBonk', { volume: 0.5, pitch: -3 });\n        ctx.particles.burst('bonk', [2.4, 1.7, -7]);\n        this.dennis.play(this.dennisHits % 5 === 0 ? 'Fall' : 'Hurt', { once: true, fade: 0.05, then: () => this.dennis.play('Idle', { fade: 0.3 }) });\n      }\n    }\n    this.dennis?.update(dt);\n  }\n\n  drawGameHud(ctx) {\n    super.drawGameHud(ctx);\n  }\n\n  scoreText() { return `${this.playerLane.state.score}`; }\n  fingerprint() { const l = this.playerLane; return l ? `${l.state.score}|${l.state.pos.toFixed(5)}` : ''; }\n  overlayDot() { const l = this.playerLane; return l ? `x ${l.state.pos.toFixed(2)} combo ${l.state.combo}` : '-'; }\n}\n\nexport { Vector3 };\nEOF\necho ok","description":"Write Reps, Hoop, Step and Coconut Header activities","timeout":30000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":16942,"cache_read_input_tokens":425669,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":16942},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"af8f2419-886f-454c-8b4f-a257a3c07eba","timestamp":"2026-11-05T06:53:52.463Z","request_id":"req_011CgjLSHqgehVq9YFNv5Uew","wire_tool_inputs":{"toolu_01EP1cbXigDX4qm4Xu3PoLVf":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\nsed -n 1900,1915p API.md | cut -c1-200; grep -n \"interface RippleOptions\" -A10 API.md </dev/null | cut -c1-170; grep -n \"applyDeadzone\" -A6 API.md </dev/null | sed -n 2,9p | cut -c1-200\ncat > src/scenes/activity/reps.js <<'EOF'\n// The Rep Shed. You scrub the animation with the stick.\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { REPS, EXTRA_REPS, REP_SHAPE } from '../../data/reps.js';\nimport { line, panel, ring as ringLine } from '../../ui/widgets.js';\nimport { sayCentered } from '../../ui/font.js';\nimport { LaneEvent, worldToArt } from './events.js';\nimport { LaneActivity } from './lanes.js';\nimport { shedSet } from '../sets.js';\n\nexport function repTarget(u) {\n  const { up, hold, down } = REP_SHAPE;\n  if (u < up) return u / up;\n  if (u < up + hold) return 1;\n  if (u < up + hold + down) return 1 - (u - up - hold) / down;\n  return 0;\n}\n\nexport class RepsEvent extends LaneEvent {\n  kind = 'reps';\n  lead = 1.2;\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.repId = opts.rep;\n    this.data = REPS[opts.rep];\n    this.announced = opts.reps ?? this.data.reps;\n    this.extra = opts.extra ?? EXTRA_REPS;\n    this.total = this.announced + this.extra;\n    this.baseTempo = this.data.tempo * (this.hard.tempo ?? 1);\n    this.duration = opts.duration ?? this.lead + this.total * this.baseTempo * T.repTempoScale + 0.4;\n  }\n\n  get tempo() { return this.baseTempo * T.repTempoScale; }\n\n  beginLane(l) {\n    l.state = { r: 0, rVis: 0, rep: 0, err: 0, n: 0, sum: 0, count: 0, grade: null, gradeT: 0, lastRep: -1, botR: 0, phase: l.rand() * 6 };\n    l.score = 0;\n    l.avatar?.scrub(this.data.clip, 0);\n  }\n\n  repAt(t) { return Math.floor((t - this.lead) / this.tempo); }\n\n  targetAt(t) {\n    const tt = t - this.lead;\n    if (tt < 0) return 0;\n    const rep = Math.floor(tt / this.tempo);\n    if (rep >= this.total) return 0;\n    return repTarget((tt % this.tempo) / this.tempo);\n  }\n\n  side(rep) { return rep % 2 === 0 ? 1 : -1; }\n\n  /** Stick to rep depth, 0..1. */\n  mapInput(inp, rep) {\n    switch (this.data.input) {\n      case 'down': return Math.max(0, -inp.y);\n      case 'up': return Math.max(0, inp.y);\n      default: return Math.max(0, inp.x * this.side(rep));\n    }\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const st = lane.state;\n    const rep = Math.max(0, this.repAt(t));\n    const lag = T.repLag * (this.data.lagScale ?? 1);\n    if (inp.rate) {\n      // Keys use rate control: S/W move r at the target speed, no key holds it.\n      const speed = 1 / (REP_SHAPE.up * this.tempo);\n      const v = this.data.input === 'down' ? -inp.y : this.data.input === 'up' ? inp.y : inp.x * this.side(rep);\n      if (Math.abs(v) > 0.3) st.r = Math.max(0, Math.min(1, st.r + Math.sign(v) * speed * dt));\n    } else {\n      st.r += (this.mapInput(inp, rep) - st.r) * Math.min(1, dt / lag);\n    }\n    const fatigue = T.repFatigue * (this.hard.fatigue ?? 1) * (rep / this.total) ** 2;\n    st.rVis = Math.max(0, Math.min(1, st.r + fatigue * Math.sin(t * 19 + st.phase)));\n    if (t < this.lead || rep >= this.total) return;\n    if (rep !== st.lastRep) {\n      if (st.lastRep >= 0 && scoring) this.closeRep(lane);\n      st.lastRep = rep;\n      if (lane.isLocal) this.scene.onRep?.(rep, this.announced);\n    }\n    if (scoring) { st.err += Math.abs(st.rVis - this.targetAt(t)); st.n++; lane.score = this.scoreOf(lane); }\n  }\n\n  closeRep(lane) {\n    const st = lane.state;\n    const q = st.n ? Math.max(0, 1 - 1.6 * (st.err / st.n)) : 0;\n    st.sum += q; st.count++;\n    st.err = 0; st.n = 0;\n    st.grade = q >= 0.85 ? 'Perfect' : q >= 0.65 ? 'Good' : 'Wobbly';\n    st.gradeT = 0.9;\n    lane.score = this.scoreOf(lane);\n    if (lane.isLocal) {\n      App.sfx(q >= 0.85 ? 'repPerfect' : 'repTick');\n      if (q >= 0.85) this.ctx.particles.burst('sweat', [lane.x, 1.5, lane.z]);\n    }\n  }\n\n  /** The last rep is closed by the end of the event. */\n  finishLane(lane) { if (lane.state.n > 0) this.closeRep(lane); }\n\n  botInput(lane, out, dt, t, brain) {\n    out.x = out.y = 0;\n    if (!brain.p) return;\n    const play = brain.play;\n    const rep = Math.max(0, this.repAt(t));\n    const st = lane.state;\n    const seen = this.targetAt(t - play.react * 0.45);\n    st.botR += (seen + Math.sin(t * 2.2 + st.phase) * play.wander * 0.5 - st.botR) * Math.min(1, dt / 0.08);\n    const v = Math.max(0, Math.min(1, st.botR));\n    if (this.data.input === 'down') out.y = -v;\n    else if (this.data.input === 'up') out.y = v;\n    else out.x = v * this.side(rep);\n  }\n\n  scoreOf(lane) {\n    const st = lane.state;\n    const n = st.count + (st.n ? 1 : 0);\n    if (!n) return 0;\n    const open = st.n ? Math.max(0, 1 - 1.6 * (st.err / st.n)) : 0;\n    return 100 * ((st.sum + open) / n);\n  }\n\n  clipFor(rep) {\n    if (this.data.input === 'sides' && this.side(rep) < 0) return this.data.clipLeft;\n    return this.data.clip;\n  }\n\n  ghostScrubs(name) { return ['SquatRep', 'LungeRep', 'LungeRepL', 'Press'].includes(name); }\n  clipState(lane) {\n    const rep = Math.max(0, this.repAt(this.lastT ?? 0));\n    return [App.clipIndex(this.clipFor(rep)), lane.state.rVis];\n  }\n\n  visual(ctx, dt, t) {\n    this.lastT = t;\n    const rep = Math.max(0, this.repAt(t));\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) { this.ghostVisual(lane, dt); continue; }\n      if (!lane.frozenClip) lane.avatar.scrub(this.clipFor(rep), lane.state.rVis);\n      lane.avatar.update(dt);\n    }\n  }\n\n  draw(ctx, t) {\n    const { hud } = ctx;\n    for (const lane of this.lanes) {\n      if (!lane.isLocal || lane.gone) continue;\n      const st = lane.state;\n      const small = this.lanes.length >= 4;\n      const rep = Math.max(0, this.repAt(t));\n      const target = this.targetAt(t);\n      let cx, cy, len;\n      if (small) { const p = worldToArt(ctx, lane.x, 2.2, lane.z); cx = Math.round(p.x); cy = Math.max(32, Math.round(p.y) - 20); len = 40; } else { cx = Math.round(hud.width / 2); cy = 58; len = 84; }\n      lane.dial = { x: cx, y: cy };\n      const mouse = App.device.last === 'mouse' && lane.driver.kind !== 'pad' && !App.dev.autopilot ? App.device.pointerArt(ctx) : null;\n      if (this.data.input === 'sides') {\n        // A horizontal track: the marker goes out to the side it wants.\n        const w = small ? 64 : 180, h = 16;\n        panel(hud, cx - w / 2, cy - h / 2, w, h, { fill: 'white', name: 'track' });\n        hud.rect(cx - 1, cy - h / 2, 2, h, 'mist');\n        const s = this.side(rep);\n        const half = w / 2 - 5;\n        const tx = cx + s * target * half;\n        hud.rect(Math.round(tx) - 4, cy - h / 2, 8, h, 'orange');\n        const you = cx + s * st.rVis * half;\n        hud.rect(Math.round(you) - 3, cy - h / 2 + 2, 6, h - 4, 'red');\n        const arrow = s > 0 ? '>' : '<';\n        sayCentered(hud, cx + s * (w / 2 + 8), cy - 4, arrow, { scale: 1, color: 'sand', name: 'track-arrow' });\n      } else {\n        // A vertical track. Squats go down, presses go up.\n        const w = small ? 14 : 22;\n        const dir = this.data.input === 'down' ? 1 : -1;\n        panel(hud, cx - w / 2, cy - len / 2, w, len, { fill: 'white', name: 'track' });\n        const base = dir > 0 ? cy - len / 2 + 4 : cy + len / 2 - 4;\n        const span = len - 8;\n        hud.rect(cx - w / 2, Math.round(base + dir * target * span) - 4, w, 8, 'orange');\n        hud.rect(cx - w / 2 + 2, Math.round(base + dir * st.rVis * span) - 3, w - 4, 6, 'red');\n      }\n      if (mouse) { line(hud, cx, cy, mouse.x, mouse.y, 'mist', 1); ringLine(hud, mouse.x, mouse.y, 3, 1, 'ink'); }\n      if (st.gradeT > 0) sayCentered(hud, cx, small ? cy + 26 : cy + 48, st.grade, { color: st.grade === 'Perfect' ? 'lime' : st.grade === 'Good' ? 'sand' : 'white', name: 'grade' });\n      st.gradeT -= 1 / 60;\n    }\n  }\n}\n\nexport class RepsActivity extends LaneActivity {\n  makeEvent(lanes, rng, hard) { return new RepsEvent(this, lanes, rng, { rep: this.def.rep, hard }); }\n\n  async dress(ctx) {\n    this.set = shedSet(ctx);\n    await this.addCoach(ctx, { at: [3.5, 0, -1.2], yaw: -0.45, clip: 'Watch' });\n    this.lastGag = -1;\n  }\n\n  /** \"Last one.\" Then \"Last one.\" Then \"I lied. This is the last one.\" */\n  onRep(rep, announced) {\n    if (rep === this.lastGag || this.attractMode) return;\n    this.lastGag = rep;\n    if (rep === announced - 1 || rep === announced) App.say('coach', 'Last one.');\n    if (rep === announced + 1) App.say('coach', 'I lied. This is the last one.');\n  }\n\n  result() {\n    return super.result();\n  }\n\n  onOutroStart() {\n    for (const l of this.lanes) this.event.finishLane(l);\n    super.onOutroStart();\n  }\n\n  fingerprint() { const l = this.playerLane; return l ? `${l.state.sum.toFixed(5)}|${l.state.r.toFixed(5)}` : ''; }\n  overlayDot() { const l = this.playerLane; return l ? `r ${l.state.rVis.toFixed(2)} rep ${l.state.rep}` : '-'; }\n  dispose() { this.set?.stop?.(); this.set?.mirror?.dispose?.(); }\n}\nEOF\ncat > src/scenes/activity/hoop.js <<'EOF'\n// Hoop Economics: circle the stick to keep the hoops up. June throws you more.\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { place } from '../../art/props.js';\nimport { HOOP_THROW } from '../../data/hoop.js';\nimport { bar, drawDial, line, ring as ringLine } from '../../ui/widgets.js';\nimport { sayCentered } from '../../ui/font.js';\nimport { LaneEvent, worldToArt } from './events.js';\nimport { LaneActivity } from './lanes.js';\nimport { beachSet } from '../sets.js';\n\nconst TAU = Math.PI * 2;\nconst wrapPi = (a) => ((a + Math.PI * 3) % TAU) - Math.PI;\nconst BOT_RATE = { sloppy: 1.0, average: 1.5, good: 1.75, expert: 2.0 };\n\nexport class HoopEvent extends LaneEvent {\n  kind = 'hoop';\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.duration = opts.duration ?? 60;\n    this.segments = opts.duration ? [[opts.duration * 0.45, 1], [opts.duration * 0.45, -1], [opts.duration * 0.1, 0]] : [[25, 1], [25, -1], [10, 0]];\n    this.throws = [];\n    let t = HOOP_THROW.first;\n    while (t < this.duration - 3) {\n      this.throws.push({ t, side: rng.chance(0.5) ? 1 : -1 });\n      t += rng.range(HOOP_THROW.gap - 1.5, HOOP_THROW.gap + 1.5);\n    }\n  }\n\n  dirAt(t) {\n    let acc = 0;\n    for (const [len, d] of this.segments) { acc += len; if (t < acc) return d; }\n    return 0;\n  }\n\n  band() {\n    const k = this.hard.band ?? 1;\n    const mid = (T.hoopLow + T.hoopHigh) / 2, half = ((T.hoopHigh - T.hoopLow) / 2) * k;\n    return [mid - half, mid + half];\n  }\n\n  beginLane(l) {\n    l.state = {\n      a: 0, lastA: null, w: 0, lift: 0.5, hoops: 1, down: 0, angle: 0, score: 0, inBand: false, wrongWay: false, catches: 0, thrown: 0, rot: 0,\n      throwI: 0, flicked: false, botA: l.rand() * TAU, phase: l.rand() * 6, flickT: 0, plannedCatch: false,\n    };\n    l.score = 0;\n    for (const h of l.hoopMeshes ?? []) h.visible = false;\n    l.avatar?.play('Idle', { fade: 0.3 });\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const st = lane.state;\n    const mag = Math.hypot(inp.x, inp.y);\n    let raw = 0;\n    if (mag > 0.5) {\n      const a = Math.atan2(inp.y, inp.x);\n      if (st.lastA !== null) raw = (wrapPi(a - st.lastA) / dt) / TAU;\n      st.lastA = a;\n    } else st.lastA = null;\n    st.w += (raw - st.w) * Math.min(1, dt / 0.25);\n    const dir = this.dirAt(t);\n    const speed = Math.abs(st.w);\n    const way = dir === 0 ? Math.sign(st.w) || 1 : dir;\n    const [low, high] = this.band();\n    const right = st.w * way > 0;\n    st.inBand = right && speed >= low && speed <= high;\n    st.wrongWay = !right && speed > 0.3;\n    if (st.down > 0) {\n      // Picking it up. For 1.5 s you have no hoop and a comment.\n      st.down -= dt;\n      if (st.down <= 0) { st.lift = 0.4; }\n    } else {\n      const rate = T.hoopLiftRate * (this.hard.lift ?? 1);\n      st.lift += (st.inBand ? rate : st.wrongWay ? -0.5 : -0.25) * dt;\n      st.lift = Math.min(1, st.lift);\n      if (st.lift <= 0) {\n        st.lift = 0;\n        st.down = 1.5;\n        st.hoops = 1;\n        if (lane.isLocal) { App.sfx('hoopDrop'); this.scene.hoopDropped?.(); }\n      }\n      if (st.inBand) {\n        st.rot += speed * dt;\n        if (scoring) st.score += speed * dt * (1 + 0.5 * (st.hoops - 1));\n        if (lane.isLocal && Math.floor(st.rot * 2) !== Math.floor((st.rot - speed * dt) * 2)) this.ctx.particles.burst('hoopSpark', [lane.x, 0.9, lane.z]);\n      }\n    }\n    st.angle += st.w * TAU * dt;\n    lane.score = st.score;\n    this.stepThrows(lane, inp, t);\n  }\n\n  stepThrows(lane, inp, t) {\n    const st = lane.state;\n    const th = this.throws[st.throwI];\n    if (!th) return;\n    if (t >= th.t - HOOP_THROW.telegraph && !st.announced) { st.announced = true; if (lane.isLocal) App.sfx('gust', { volume: 0.3 }); }\n    if (t >= th.t - HOOP_THROW.window && t <= th.t && Math.abs(inp.x) > 0.7 && Math.sign(inp.x) === th.side && st.down <= 0) {\n      if (st.hoops < 4) st.hoops++;\n      st.catches++;\n      st.caught = t;\n      if (lane.isLocal) { App.sfx('hoopCatch'); this.ctx.particles.burst('confetti', [lane.x, 1.2, lane.z], { count: 12 }); }\n      st.throwI++; st.announced = false;\n      return;\n    }\n    if (t > th.t) { st.throwI++; st.announced = false; }\n  }\n\n  botInput(lane, out, dt, t, brain) {\n    out.x = out.y = 0;\n    if (!brain.p) return;\n    const st = lane.state;\n    const dir = this.dirAt(t) || 1;\n    const base = BOT_RATE[brain.skill] ?? 1.5;\n    const rate = base + Math.sin(t * 0.7 + st.phase) * brain.play.wander * 1.2;\n    // Sloppy circlers stop to think.\n    const slack = brain.skill === 'sloppy' && Math.sin(t * 0.45 + st.phase) > 0.25;\n    if (!slack) st.botA += dir * rate * TAU * dt;\n    out.x = Math.cos(st.botA);\n    out.y = Math.sin(st.botA);\n    if (slack) { out.x *= 0.3; out.y *= 0.3; }\n    const th = this.throws[st.throwI];\n    if (th && t >= th.t - HOOP_THROW.window + 0.03 && t <= th.t) {\n      if (st.planFor !== st.throwI) { st.planFor = st.throwI; st.planned = lane.rand() > brain.play.miss * 4 && st.hoops < 4; }\n      if (st.planned) { out.x = th.side; out.y = 0; }\n    }\n  }\n\n  scoreOf(lane) { return lane.state.score; }\n  normalized(lane) { return Math.min(1000, Math.round((lane.state.score / 130) * 1000)); }\n\n  visual(ctx, dt, t) {\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) { this.ghostVisual(lane, dt); this.hoopVisual(lane, t, true); continue; }\n      const st = lane.state;\n      if (!lane.frozenClip) lane.avatar.play(st.down > 0 ? 'Slump' : 'Idle', { fade: 0.25 });\n      lane.avatar.update(dt);\n      const c = st.down > 0 ? 0 : Math.min(1, Math.abs(st.w)) * 0.75;\n      lane.avatar.lean(Math.cos(st.angle) * c, Math.sin(st.angle) * c, 0, t);\n      this.hoopVisual(lane, t, false);\n    }\n  }\n\n  hoopVisual(lane, t, ghost) {\n    const meshes = lane.hoopMeshes;\n    if (!meshes) return;\n    const st = lane.state;\n    const n = ghost ? 1 : (st.down > 0 ? 0 : st.hoops);\n    for (let i = 0; i < meshes.length; i++) {\n      const m = meshes[i];\n      m.visible = i < n;\n      if (!m.visible) continue;\n      const lift = ghost ? 0.8 : st.lift;\n      const a = (ghost ? t * 8 : st.angle) + i * 1.3;\n      const r = 0.1 + (1 - lift) * 0.18;\n      m.position.set(lane.x + Math.cos(a) * r, 0.25 + 0.72 * lift + i * 0.1, lane.z + Math.sin(a) * r);\n      m.rotation.x = Math.sin(a) * (0.32 - lift * 0.2);\n      m.rotation.z = Math.cos(a) * (0.32 - lift * 0.2);\n    }\n  }\n\n  draw(ctx, t) {\n    const { hud } = ctx;\n    for (const lane of this.lanes) {\n      if (!lane.isLocal || lane.gone) continue;\n      const st = lane.state;\n      const small = this.lanes.length >= 4;\n      let x, y, r;\n      if (small) { const p = worldToArt(ctx, lane.x, 2.2, lane.z); x = p.x; y = Math.max(38, p.y - 24); r = 24; } else { x = Math.round(hud.width / 2); y = 56; r = 44; }\n      lane.dial = { x, y };\n      const dir = this.dirAt(t);\n      drawDial(hud, { x, y, r, dot: null, ringR: 0.9, fade: 1, inside: st.inBand, brighten: st.inBand ? 1 : 0 });\n      // The stick, on the circle, and which way to go.\n      const inp = lane.inp;\n      const s = r / 1.2 * 0.9;\n      const dx = x + inp.x * s, dy = y - inp.y * s;\n      ringLine(hud, dx, dy, 3, 2, st.inBand ? 'lime' : 'red');\n      if (dir !== 0) {\n        const steps = 5;\n        for (let i = 0; i < steps; i++) {\n          const a = t * 2.4 * dir + (i / steps) * TAU;\n          hud.rect(Math.round(x + Math.cos(a) * r * 0.42) - 1, Math.round(y - Math.sin(a) * r * 0.42) - 1, 2, 2, i === 0 ? 'orange' : 'mist');\n        }\n      }\n      bar(hud, x - r, y + r + 5, r * 2, 6, st.lift, st.inBand ? 'lime' : 'cyan', 'ink', 'lift');\n      if (!small) {\n        const label = dir === 1 ? 'Anticlockwise.' : dir === -1 ? 'Now the other way.' : 'Either way.';\n        sayCentered(hud, x, y + r + 14, label, { color: 'white', name: 'hoop-way' });\n      }\n      const mouse = App.device.last === 'mouse' && lane.driver.kind !== 'pad' && !App.dev.autopilot ? App.device.pointerArt(ctx) : null;\n      if (mouse) line(hud, x, y, mouse.x, mouse.y, 'mist', 1);\n      // June's throw.\n      const th = this.throws[st.throwI];\n      if (th && t >= th.t - HOOP_THROW.telegraph && t <= th.t) {\n        const u = 1 - (th.t - t) / HOOP_THROW.telegraph;\n        const late = t >= th.t - HOOP_THROW.window;\n        const fx = x + th.side * (r + 22 + (1 - u) * 44);\n        ringLine(hud, fx, y, 9, 3, late ? 'lime' : 'red');\n        sayCentered(hud, x + th.side * (r + 22), y + 14, late ? 'Catch!' : 'June!', { color: late ? 'lime' : 'sand', name: 'catch' });\n        // A landing shadow, near your lane.\n        const p = worldToArt(ctx, lane.x + th.side * 0.9, 0.05, lane.z);\n        hud.rect(Math.round(p.x) - 8, Math.round(p.y) - 1, 16, 3, late ? 'lime' : 'slate');\n      }\n      if (st.hoops > 1 && !small) sayCentered(hud, x, y - r - 8 < 0 ? 2 : y + r + 24, `x${1 + 0.5 * (st.hoops - 1)}`, { color: 'sand', name: 'hoop-mult' });\n    }\n  }\n}\n\nexport class HoopActivity extends LaneActivity {\n  makeEvent(lanes, rng, hard) { return new HoopEvent(this, lanes, rng, { hard }); }\n\n  async dress(ctx) {\n    this.set = beachSet(ctx);\n    await this.addCoach(ctx, { at: [3.6, 0, -1], yaw: -0.5, clip: 'Watch' });\n    this.lastRemark = -10;\n  }\n\n  afterLanes(ctx) {\n    for (const lane of this.lanes) lane.hoopMeshes = [0, 1, 2, 3].map((i) => {\n      const m = place(ctx, 'hoop', { palette: { hoop: ['red', 'sky', 'lime', 'sand'][i] }, actor: true, shadow: false }).object;\n      m.visible = false;\n      return m;\n    });\n    this.whirr = ctx.audio.loop('hoopWhirr', { volume: 0 });\n  }\n\n  hoopDropped() {\n    if (this.t - this.lastRemark < 6) return;\n    this.lastRemark = this.t;\n    App.say('ounce', this.cosmetic.pick(['The hoop has left you. It left a note.', 'Pick it up. Everyone is watching. No one is helping.', 'The hoop has been downgraded.']));\n  }\n\n  playVisual() {\n    const st = this.playerLane?.state;\n    this.whirr?.set({ volume: st && st.inBand ? 0.6 : 0, pitch: st ? Math.min(6, Math.abs(st.w) * 2) : 0 });\n  }\n\n  scoreText() { return `${Math.floor(this.playerLane.state.score)}`; }\n  fingerprint() { const l = this.playerLane; return l ? `${l.state.score.toFixed(5)}|${l.state.lift.toFixed(5)}` : ''; }\n  overlayDot() { const l = this.playerLane; return l ? `w ${l.state.w.toFixed(2)} lift ${l.state.lift.toFixed(2)} x${l.state.hoops}` : '-'; }\n}\nEOF\ncat > src/data/hoop.js <<'EOF'\n// June's throws: every ~9 s, 1.5 s of telegraph, flick in the last .4 s.\nexport const HOOP_THROW = { first: 7, gap: 9, telegraph: 1.5, window: 0.4 };\nEOF\ncat > src/scenes/activity/step.js <<'EOF'\n// Step Class. Footprints scroll to a hit line. Left foot, right foot. It is not complicated.\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { STEP_BPM, STEP_SONG, stepSongFrom } from '../../audio/songs.js';\nimport { STEP_CHART, STEP_CHART_HARD, STEP_CHART_MEDLEY, WEIGHTS, WINDOWS } from '../../data/charts.js';\nimport { sayCentered, say, sayRight } from '../../ui/font.js';\nimport { panel } from '../../ui/widgets.js';\nimport { LaneEvent, worldToArt } from './events.js';\nimport { LaneActivity } from './lanes.js';\nimport { beachSet } from '../sets.js';\n\nexport const BAR_SECONDS = (60 / STEP_BPM) * 4;\nconst EIGHTH = BAR_SECONDS / 8;\nconst FOOT_L = ['..oo.', '.ooo.', '.ooo.', '.oo..', '.....', '.oo..', '.oo..'];\nconst FOOT_R = ['.oo..', '.ooo.', '.ooo.', '..oo.', '.....', '..oo.', '..oo.'];\n\nexport function chartNotes(chart) {\n  const notes = [];\n  chart.forEach((bar, b) => {\n    [...bar].forEach((c, i) => {\n      if (c === 'L' || c === 'R') notes.push({ t: (b + i / 8) * BAR_SECONDS, foot: c });\n    });\n  });\n  return notes;\n}\n\nexport class StepEvent extends LaneEvent {\n  kind = 'step';\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.chart = opts.chart ?? (this.hard.chart === 'hard' ? STEP_CHART_HARD : STEP_CHART);\n    this.notes = chartNotes(this.chart);\n    this.duration = opts.duration ?? this.chart.length * BAR_SECONDS + 1;\n    this.windowScale = this.hard.window ?? 1;\n  }\n\n  /** The song's clock when audio runs, otherwise game time. */\n  clock(t) { return this.scene.beatClock ? this.scene.beatClock(t) : t; }\n\n  beginLane(l) {\n    l.state = { i: 0, P: 0, G: 0, O: 0, M: 0, combo: 0, best: 0, last: null, lastT: 0, botI: 0, botAt: null, botFoot: null, stepClip: null };\n    l.score = 0;\n    l.avatar?.play('StepRest', { fade: 0.25 });\n    l.judged = new Int8Array(this.notes.length);\n  }\n\n  window(name) { return WINDOWS[name] * T.stepWindow * this.windowScale; }\n\n  press(lane, foot, now) {\n    const st = lane.state;\n    const off = T.stepOffsetMs / 1000;\n    const notes = this.notes;\n    const ok = this.window('ok');\n    let found = -1, bestErr = Infinity;\n    for (let i = st.i; i < notes.length; i++) {\n      const n = notes[i];\n      const err = now - off - n.t;\n      if (err < -ok) break;\n      if (lane.judged[i] || n.foot !== foot) continue;\n      if (Math.abs(err) < bestErr) { bestErr = Math.abs(err); found = i; }\n    }\n    lane.avatar?.play(foot === 'L' ? 'StepL' : 'StepR', { once: true, fade: 0.04, then: () => lane.avatar?.play('StepRest', { fade: 0.1 }) });\n    if (found < 0) { st.combo = 0; st.last = 'Off'; st.lastT = now; return; }\n    lane.judged[found] = 1;\n    const grade = bestErr <= this.window('perfect') ? 'P' : bestErr <= this.window('good') ? 'G' : 'O';\n    st[grade]++;\n    st.combo++;\n    st.best = Math.max(st.best, st.combo);\n    st.last = grade === 'P' ? 'Perfect' : grade === 'G' ? 'Good' : 'OK';\n    st.lastT = now;\n    if (lane.isLocal) {\n      App.sfx(grade === 'P' ? 'stepPerfect' : 'stepGood');\n      if (st.combo % 16 === 0) { App.sfx('combo'); this.ctx.particles.burst('confetti', [lane.x, 1.6, lane.z]); }\n    }\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const st = lane.state;\n    const now = this.clock(t);\n    const off = T.stepOffsetMs / 1000;\n    if (inp.stepL) this.press(lane, 'L', now);\n    if (inp.stepR) this.press(lane, 'R', now);\n    const ok = this.window('ok');\n    while (st.i < this.notes.length && now - off - this.notes[st.i].t > ok) {\n      if (!lane.judged[st.i]) {\n        lane.judged[st.i] = 2;\n        st.M++;\n        st.combo = 0;\n        st.last = 'Miss';\n        st.lastT = now;\n        if (lane.isLocal && scoring) App.sfx('stepMiss');\n      }\n      st.i++;\n    }\n    lane.score = this.scoreOf(lane);\n  }\n\n  botInput(lane, out, dt, t, brain) {\n    out.x = out.y = 0;\n    out.stepL = out.stepR = false;\n    if (!brain.p) return;\n    const st = lane.state;\n    const now = this.clock(t);\n    const off = T.stepOffsetMs / 1000;\n    const play = brain.play;\n    while (st.botI < this.notes.length) {\n      const n = this.notes[st.botI];\n      if (st.botAt === null) {\n        st.botAt = lane.rand() < play.miss ? Infinity : n.t + off + (lane.rand() + lane.rand() - 1) * play.timing * 1.2;\n      }\n      if (st.botAt === Infinity) {\n        if (now - off - n.t > 0.2) { st.botI++; st.botAt = null; continue; }\n        break;\n      }\n      if (now >= st.botAt) {\n        if (n.foot === 'L') out.stepL = true; else out.stepR = true;\n        st.botI++; st.botAt = null;\n        if (this.notes[st.botI]?.foot === n.foot) break;\n        continue;\n      }\n      break;\n    }\n  }\n\n  scoreOf(lane) {\n    const st = lane.state;\n    return 100 * ((st.P * WEIGHTS.perfect + st.G * WEIGHTS.good + st.O * WEIGHTS.ok) / Math.max(1, this.notes.length));\n  }\n\n  visual(ctx, dt) {\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) { this.ghostVisual(lane, dt); continue; }\n      lane.avatar.update(dt);\n    }\n  }\n\n  draw(ctx, t) {\n    const { hud } = ctx;\n    const now = this.clock(t);\n    const off = T.stepOffsetMs / 1000;\n    const lanes = this.lanes.filter((l) => l.isLocal && !l.gone);\n    lanes.forEach((lane) => {\n      const small = this.lanes.length >= 4;\n      const st = lane.state;\n      const px = small ? worldToArt(ctx, lane.x, 2.2, lane.z) : null;\n      const w = small ? 92 : Math.min(hud.width - 28, 380);\n      const cx = small ? Math.max(w / 2 + 2, Math.min(hud.width - w / 2 - 2, px.x)) : hud.width / 2;\n      const x = Math.round(cx - w / 2);\n      const y = small ? Math.max(24, Math.round(px.y) - 42) : 26;\n      const h = small ? 28 : 46;\n      panel(hud, x, y, w, h, { fill: 'white', name: 'highway' });\n      const rowL = y + Math.round(h * 0.25), rowR = y + Math.round(h * 0.75);\n      hud.rect(x, y + Math.round(h / 2), w, 1, 'mist');\n      const hitX = x + (small ? 16 : 40);\n      hud.rect(hitX - 1, y, 3, h, 'teal');\n      const pxPerSec = small ? 42 : 96;\n      const horizon = (w - (hitX - x)) / pxPerSec;\n      for (let i = st.i; i < this.notes.length; i++) {\n        const n = this.notes[i];\n        const dt2 = n.t + off - now;\n        if (dt2 > horizon) break;\n        if (lane.judged[i]) continue;\n        const nx = hitX + dt2 * pxPerSec;\n        if (nx < x + 2) continue;\n        const left = n.foot === 'L';\n        const yy = (left ? rowL : rowR) - 7;\n        hud.sprite(Math.round(nx) - 5, yy, left ? FOOT_L : FOOT_R, { o: left ? 'blue' : 'orange' }, { scale: small ? 1 : 2, shadow: false });\n      }\n      if (!small) {\n        say(hud, x + 3, rowL - 4, 'L', { color: 'blue', shadow: false, name: 'hw-l' });\n        say(hud, x + 3, rowR - 4, 'R', { color: 'orange', shadow: false, name: 'hw-r' });\n      }\n      if (now - st.lastT < 0.6 && st.last) sayCentered(hud, hitX + (small ? 16 : 26), y + h + 3, st.last, { color: st.last === 'Perfect' ? 'lime' : st.last === 'Miss' || st.last === 'Off' ? 'red' : 'sand', name: 'judge' });\n      if (st.combo >= 4) sayRight(hud, x + w - 2, y + h + 3, `${st.combo} combo`, { color: 'white', name: 'combo' });\n    });\n  }\n}\n\nexport class StepActivity extends LaneActivity {\n  counting = 0;\n  localClock = 0;\n  offset = 0;\n\n  makeEvent(lanes, rng, hard) { return new StepEvent(this, lanes, rng, { hard }); }\n  laneOptions() { return { mat: 'step-platform' }; }\n  startMusic() {}\n\n  async dress(ctx) {\n    this.set = beachSet(ctx);\n    await this.addCoach(ctx, { at: [3.6, 0, -1], yaw: -0.5, clip: 'Watch' });\n  }\n\n  onEnter(phase) {\n    if (phase === 'practice' || phase === 'play') this.startSongAt(0);\n    if (phase === 'countdown' || phase === 'outro') this.ctx.audio.stopMusic();\n  }\n\n  startSongAt(bar) {\n    this.offset = bar * BAR_SECONDS;\n    this.localClock = this.offset;\n    this.ctx.audio.playMusic(bar === 0 ? { ...STEP_SONG, order: STEP_SONG.order, loop: false } : stepSongFrom(bar), 'step');\n    this.songStarted = true;\n  }\n\n  /** The song's step clock when audio runs (undocumented but present), otherwise game time. */\n  beatClock() {\n    const a = this.ctx.audio;\n    const song = a.song;\n    if (a.context && a.unlocked && song && typeof song.start === 'number' && !this.attractMode && !App.dev.autopilot) {\n      const audioT = a.context.currentTime - song.start;\n      if (audioT >= 0) return audioT + this.offset;\n    }\n    return this.localClock;\n  }\n\n  /** On pause: stop the music. On resume: count in and restart at the current bar. */\n  onPause() { if (this.phase === 'play') this.ctx.audio.stopMusic(); }\n  onResume() {\n    if (this.phase !== 'play') return;\n    const bar = Math.floor(this.beatClock() / BAR_SECONDS);\n    this.resumeBar = bar;\n    this.localClock = bar * BAR_SECONDS;\n    this.offset = this.localClock;\n    this.counting = (60 / STEP_BPM) * 4;\n    this.countBeat = 4;\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    if (this.counting > 0) {\n      this.counting -= dt;\n      const n = Math.ceil(this.counting / (60 / STEP_BPM));\n      if (n !== this.countBeat && n > 0) { this.countBeat = n; App.sfx('count'); }\n      if (this.counting <= 0) this.startSongAt(this.resumeBar);\n      return;\n    }\n    this.localClock += dt;\n    this.eventT = this.localClock;\n    this.event.step(ctx, dt, this.eventT, scoring);\n  }\n\n  isOver() { return this.localClock >= this.event.duration; }\n  playLength() { return this.event.duration; }\n  begin() { super.begin(); this.localClock = 0; this.offset = 0; }\n\n  drawGame(ctx) {\n    super.drawGame(ctx);\n    if (this.counting > 0) sayCentered(ctx.hud, ctx.hud.width / 2, Math.round(ctx.hud.height * 0.42), String(Math.ceil(this.counting / (60 / STEP_BPM))), { scale: 4, color: 'sand', name: 'count-in' });\n  }\n\n  scoreText() { return `${Math.round(this.event.scoreOf(this.playerLane))}%`; }\n  fingerprint() { const l = this.playerLane; return l ? `${l.state.P}|${l.state.G}|${l.state.O}|${l.state.M}|${l.state.combo}` : ''; }\n  overlayDot() { const l = this.playerLane; return l ? `P${l.state.P} G${l.state.G} O${l.state.O} M${l.state.M}` : '-'; }\n}\n\nexport { STEP_CHART_MEDLEY };\nEOF\ncat > src/scenes/activity/header.js <<'EOF'\n// Coconut Header. Lean along the sand. Dennis runs a catapult. Dennis stops being fine.\nimport { ContactShadow, THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { place } from '../../art/props.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { sayCentered, sayRight } from '../../ui/font.js';\nimport { LaneEvent, worldToArt } from './events.js';\nimport { LaneActivity, playerInfo } from './lanes.js';\nimport { lagoonSet } from '../sets.js';\n\nconst { Vector3 } = THREE;\nexport const HEADER = { flight: 1.4, reach: 0.55, speed: 4.5, startGap: 1.3, endGap: 0.7, tiers: [[20, 4], [10, 3], [5, 2]], coconut: 10, flip: -10, pineapple: 30, daze: 0.6 };\nconst POOL = { coconut: 5, flip: 3, pineapple: 1 };\nconst MODEL = { coconut: 'coconut', flip: 'flip-flop', pineapple: 'golden-pineapple' };\n\nexport class HeaderEvent extends LaneEvent {\n  kind = 'header';\n  time = 0;\n  next = 0.8;\n  waves = [];\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.duration = opts.duration ?? 60;\n    this.range = opts.range ?? (lanes.length === 1 ? 2 : 0.8);\n    this.flipShare = this.hard.flipFlop ?? 0.25;\n  }\n\n  gap(t) {\n    const u = Math.min(1, t / this.duration);\n    return (HEADER.startGap + (HEADER.endGap - HEADER.startGap) * u) * T.headerInterval * (this.hard.interval ?? 1);\n  }\n\n  beginLane(l) {\n    l.state = { pos: 0, combo: 0, score: 0, daze: 0, heads: 0, hitT: 0, phase: l.rand() * 6, wave: 0, seen: 0 };\n    l.score = 0;\n    l.avatar?.play('Idle', { fade: 0.2 });\n  }\n\n  begin() {\n    this.next = 0.8;\n    this.waves.length = 0;\n    this.rngPlay = this.rng.fork('waves');\n    super.begin();\n    for (const l of this.lanes) for (const o of l.objects ?? []) { o.mesh.visible = false; o.shadow.visible = false; o.busy = false; }\n  }\n\n  /** The same object waves for everyone, in lane-relative x. */\n  tick(ctx, dt, t) {\n    if (t >= this.next && t < this.duration - HEADER.flight) {\n      const r = this.rngPlay.next();\n      const type = r < 0.05 ? 'pineapple' : r < 0.05 + this.flipShare ? 'flip' : 'coconut';\n      const x = this.rngPlay.range(-this.range, this.range);\n      this.waves.push({ t0: t, t1: t + HEADER.flight, type, x });\n      this.next = t + this.gap(t);\n      this.scene.onLaunch?.();\n    }\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const st = lane.state;\n    if (st.daze > 0) st.daze -= dt;\n    else st.pos = Math.max(-this.range, Math.min(this.range, st.pos + HEADER.speed * inp.x * dt));\n    while (st.wave < this.waves.length && this.waves[st.wave].t1 <= t) {\n      const w = this.waves[st.wave];\n      const hit = Math.abs(st.pos - w.x) < HEADER.reach;\n      if (hit) this.onHit(ctx, lane, w, scoring);\n      else if (w.type !== 'flip') { st.combo = 0; }\n      st.wave++;\n    }\n    lane.score = st.score;\n  }\n\n  tier(combo) {\n    for (const [at, mult] of HEADER.tiers) if (combo >= at) return mult;\n    return 1;\n  }\n\n  onHit(ctx, lane, w, scoring) {\n    const st = lane.state;\n    const at = [lane.x + w.x, 1.65, lane.z];\n    if (w.type === 'flip') {\n      if (scoring) st.score = Math.max(0, st.score + HEADER.flip);\n      st.combo = 0;\n      st.daze = HEADER.daze;\n      if (lane.isLocal) { App.sfx('flipFlopThwap'); this.scene.onThwap?.(); ctx.particles.burst('puff', at); }\n      lane.avatar?.play('Daze', { fade: 0.08 });\n      lane.dazeUntil = HEADER.daze;\n      return;\n    }\n    const value = w.type === 'pineapple' ? HEADER.pineapple : HEADER.coconut * this.tier(st.combo);\n    if (scoring) st.score += value;\n    if (w.type === 'coconut') st.combo++;\n    st.heads++;\n    st.hitT = 0.3;\n    lane.avatar?.play('HeaderNod', { once: true, fade: 0.03, then: () => lane.avatar?.play('Idle', { fade: 0.1 }) });\n    lane.avatar?.squash.kick(-0.9);\n    if (lane.isLocal) {\n      App.sfx(w.type === 'pineapple' ? 'pineapple' : 'coconutBonk', { pitch: Math.min(12, st.combo * 0.3) });\n      if (!App.dev.autopilot && !this.scene.attractMode) ctx.engine.hitstop(0.05);\n      ctx.particles.burst('bonk', at);\n      this.scene.onHeaded?.(lane, st, value);\n      if ([5, 10, 20].includes(st.combo)) { App.sfx('combo'); ctx.particles.burst('confetti', at); }\n    }\n  }\n\n  botInput(lane, out, dt, t, brain) {\n    out.x = out.y = 0;\n    if (!brain.p) return;\n    const st = lane.state;\n    const play = brain.play;\n    let target = st.pos;\n    let avoid = null;\n    for (let i = st.wave; i < this.waves.length; i++) {\n      const w = this.waves[i];\n      if (t - w.t0 < play.react) continue;\n      if (w.type === 'flip') { if (avoid === null && w.t1 - t < 0.6) avoid = w.x; continue; }\n      target = w.x + Math.sin(t * 2 + st.phase) * play.wander;\n      break;\n    }\n    if (avoid !== null && Math.abs(target - avoid) < HEADER.reach + 0.1) target = avoid + Math.sign(target - avoid || 1) * (HEADER.reach + 0.2);\n    out.x = Math.max(-1, Math.min(1, (target - st.pos) * 3.5)) * play.speed;\n  }\n\n  scoreOf(lane) { return lane.state.score; }\n  normalized(lane) { return Math.min(1000, Math.round((lane.state.score / 900) * 1000)); }\n\n  visual(ctx, dt, t) {\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) {\n        this.ghostVisual(lane, dt);\n        lane.avatar.root.position.x = lane.x + lane.driver.x;\n        continue;\n      }\n      const st = lane.state;\n      if (st.daze <= 0 && lane.dazeUntil) { lane.dazeUntil = 0; if (!lane.frozenClip) lane.avatar.play('Idle', { fade: 0.15 }); }\n      lane.avatar.root.position.x = lane.x + st.pos;\n      lane.avatar.update(dt);\n      lane.avatar.lean(lane.inp.x * 0.8, 0, 0, t);\n      this.objects(ctx, lane, t);\n    }\n  }\n\n  objects(ctx, lane, t) {\n    if (!lane.objects) return;\n    const st = lane.state;\n    for (const o of lane.objects) { o.mesh.visible = false; o.shadow.visible = false; }\n    const used = {};\n    for (let i = st.wave; i < this.waves.length; i++) {\n      const w = this.waves[i];\n      const u = (t - w.t0) / (w.t1 - w.t0);\n      if (u < 0 || u >= 1) continue;\n      used[w.type] = (used[w.type] ?? 0);\n      const o = lane.pool[w.type][used[w.type]++];\n      if (!o) continue;\n      const x = lane.x + w.x, z = lane.z;\n      const y = 1.7 + (1 - u) * (1 - u) * 1.2 + Math.sin(u * Math.PI) * 5.2;\n      const zFrom = this.launchZ ?? -7;\n      o.mesh.visible = true;\n      o.mesh.position.set(x * Math.min(1, u * 1.6) + (lane.launchX ?? 0) * (1 - Math.min(1, u * 1.6)), y, zFrom + (z - zFrom) * u);\n      o.mesh.rotation.x = t * 7;\n      o.mesh.rotation.z = t * 5;\n      o.shadow.visible = true;\n      o.shadow.place(x, 0.02, z, Math.max(0, (1 - u) * 1.2));\n    }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    for (const lane of this.lanes) {\n      if (!lane.isLocal || lane.gone) continue;\n      const st = lane.state;\n      const small = this.lanes.length >= 4;\n      if (small) {\n        const p = worldToArt(ctx, lane.x + st.pos, 2.2, lane.z);\n        lane.dial = { x: p.x, y: p.y };\n        sayCentered(hud, p.x, Math.max(26, p.y - 20), `${st.score}`, { color: 'sand', name: 'head-score' });\n        if (st.combo >= 5) sayCentered(hud, p.x, Math.max(36, p.y - 10), `x${this.tier(st.combo)}`, { color: 'lime', name: 'head-combo' });\n      } else {\n        lane.dial = { x: hud.width / 2, y: hud.height / 2 };\n        if (st.combo >= 5) sayCentered(hud, hud.width / 2, 26, `x${this.tier(st.combo)}  ${st.combo} in a row`, { scale: 2, color: 'lime', name: 'head-combo' });\n      }\n    }\n    void sayRight;\n  }\n}\n\nexport async function buildHeaderProps(ctx, lane) {\n  lane.objects = [];\n  lane.pool = {};\n  for (const [type, n] of Object.entries(POOL)) {\n    lane.pool[type] = [];\n    for (let i = 0; i < n; i++) {\n      const mesh = place(ctx, MODEL[type], { actor: true, shadow: false }).object;\n      const shadow = new ContactShadow(type === 'pineapple' ? 0.34 : 0.26);\n      ctx.scene.add(shadow);\n      mesh.visible = false;\n      const o = { mesh, shadow };\n      lane.pool[type].push(o);\n      lane.objects.push(o);\n    }\n  }\n}\n\nexport class HeaderActivity extends LaneActivity {\n  makeEvent(lanes, rng, hard) { return new HeaderEvent(this, lanes, rng, { hard }); }\n  laneOptions() { return { mat: null, z: 1.2 }; }\n  laneSpecs() {\n    const p = playerInfo();\n    return [{ name: p.name, look: p.look, driver: this.driver, isPlayer: true, isLocal: true, color: 'red' }];\n  }\n\n  async dress(ctx) {\n    this.set = lagoonSet(ctx);\n    this.catapult = place(ctx, 'catapult', { at: [0, 0, -7], yaw: 180, scale: 1.2 });\n    this.arm = this.catapult.object.getObjectByName('arm');\n    this.dennis = await makeAvatar(ctx, LOOKS.dennis, { at: [2.4, 0, -7], yaw: -0.6, clip: 'Idle' });\n    this.spare = place(ctx, 'coconut', { at: [1.6, 0, -6.2], scale: 1.1 });\n    this.armT = 0;\n    this.dennisHits = 0;\n  }\n\n  async afterLanes(ctx) {\n    this.event.launchZ = -7;\n    await buildHeaderProps(ctx, this.lanes[0]);\n    for (const o of this.lanes[0].objects) o.mesh.scale.setScalar(1.2);\n    // A ball that goes back the other way, at Dennis.\n    this.returning = [];\n    for (let i = 0; i < 4; i++) { const m = place(ctx, 'coconut', { actor: true, shadow: false }).object; m.visible = false; this.returning.push({ m, u: 1 }); }\n  }\n\n  onLaunch() { this.armT = 0.35; App.sfx('catapult', { volume: 0.6 }); }\n\n  onThwap() { if (this.t > (this.remarkT ?? 0)) { this.remarkT = this.t + 5; App.say('ounce', this.cosmetic.pick(['That one had a strap. They have straps.', 'Flip-flop. I did mention.', 'Please only head the round ones.'])); } }\n\n  onHeaded(lane, st) {\n    const free = this.returning.find((r) => r.u >= 1);\n    if (free && st.combo >= 3) { free.u = 0; free.x = lane.x + st.pos; free.m.visible = true; }\n  }\n\n  playVisual(ctx, dt) {\n    this.armT = Math.max(0, this.armT - dt);\n    if (this.arm) this.arm.rotation.x = this.armT > 0 ? -1.2 * (this.armT / 0.35) : 0.2;\n    for (const r of this.returning ?? []) {\n      if (r.u >= 1) continue;\n      r.u = Math.min(1, r.u + dt / 0.9);\n      r.m.position.set(r.x + (2.4 - r.x) * r.u, 1.7 + Math.sin(r.u * Math.PI) * 2.4, 1.2 + (-7 - 1.2) * r.u);\n      r.m.rotation.x += dt * 12;\n      if (r.u >= 1) {\n        r.m.visible = false;\n        this.dennisHits++;\n        App.sfx('coconutBonk', { volume: 0.5, pitch: -3 });\n        ctx.particles.burst('bonk', [2.4, 1.7, -7]);\n        this.dennis.play(this.dennisHits % 5 === 0 ? 'Fall' : 'Hurt', { once: true, fade: 0.05, then: () => this.dennis.play('Idle', { fade: 0.3 }) });\n      }\n    }\n    this.dennis?.update(dt);\n  }\n\n  drawGameHud(ctx) {\n    super.drawGameHud(ctx);\n  }\n\n  scoreText() { return `${this.playerLane.state.score}`; }\n  fingerprint() { const l = this.playerLane; return l ? `${l.state.score}|${l.state.pos.toFixed(5)}` : ''; }\n  overlayDot() { const l = this.playerLane; return l ? `x ${l.state.pos.toFixed(2)} combo ${l.state.combo}` : '-'; }\n}\n\nexport { Vector3 };\nEOF\necho ok","description":"Write Reps, Hoop, Step and Coconut Header activities","timeout":30000}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EP1cbXigDX4qm4Xu3PoLVf","type":"tool_result","content":"- `damping: number`\n- `h: Float32Array`: Heights now and one step ago.\n- `get cell: number`\n- `contains(x: number, z: number): boolean`: Is (x, z) over this water?\n- `heightAt(x: number, z: number): number`: Ripple height at a world point (bilinear between cells; 0 outside).\n- `splash(x: number, z: number, radius: number, strength: number): void`: Push the surface down (strength > 0) in a disc: a splash, a footstep, a raindrop.\n- `energy(): number`: Total |height| (tests: ripples spread and die away).\n- `step(dt: number): void`\n\n### interface RippleOptions\n\n- `size: readonly [number, number]`: Width and depth of the water (m).\n- `cells: readonly [number, number]`: Grid cells across and down (more: finer ripples, more cost).\n- `center?: readonly [number, number]`: World x, z of the water's middle.\n- `speed?: number`: Wave speed (m/s). Default 2.2.\n- `damping?: number`: Energy kept per second (0..1). Default 0.35.\n1909:### interface RippleOptions\n1910-\n1911-- `size: readonly [number, number]`: Width and depth of the water (m).\n1912-- `cells: readonly [number, number]`: Grid cells across and down (more: finer ripples, more cost).\n1913-- `center?: readonly [number, number]`: World x, z of the water's middle.\n1914-- `speed?: number`: Wave speed (m/s). Default 2.2.\n1915-- `damping?: number`: Energy kept per second (0..1). Default 0.35.\n1916-\n1917-### ropeBridge()\n1918-\n1919-```ts\n14-8. Audio: `attenuation`, `AudioManager`, `AudioSettings`, `Instrument`, `Listener`, `muffleCutoff`, `noteFrequency`, `parseSong`, `PLAYGROUND_SONG`, `PlayOptions`, `renderSound`, `SFX`, `SfxName`, \n15-9. Particles: `BurstOptions`, `ParticlePool`, `ParticlePreset`, `ParticlePresetName`, `Particles`, `PARTICLES`\n16-10. HUD: `Hud`, `HudAnchor`, `HudColor`, `HudOptions`, `hudPlace`\n17-11. Models and textures (ASSETS.md): `addModelColliders