{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjKFxnKi62F8B5idZQWe","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Af8h4XWJSDA1oKmLQA1zSL","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='src/scenes/activity/base.js'; s=open(p).read()\ns=s.replace(\"import { Kevin, Ounce } from '../../art/props.js';\",\"import { Kevin, Ounce, place } from '../../art/props.js';\")\ns=s.replace(\"\"\"    if (dais) {\n      const { place } = await import('../../art/props.js');\n      place(ctx, 'dais', { at: [at[0], 0, at[2]] });\n    }\"\"\",\"\"\"    if (dais) place(ctx, 'dais', { at: [at[0], 0, at[2]] });\"\"\")\nopen(p,'w').write(s)\np='src/scenes/activity/poses.js'; s=open(p).read()\ns=s.replace(\"\"\"      lane.avatar.play(far ? 'Teeter' : this.pose.clip, { fade: 0.3 });\"\"\",\"\"\"      if (!lane.frozenClip) lane.avatar.play(far ? 'Teeter' : this.pose.clip, { fade: 0.3 });\"\"\")\ns=s.replace(\"\"\"    l.dot.reset();\n    l.state = { in: 0,\"\"\",\"\"\"    l.dot.reset();\n    l.frozenClip = false;\n    l.state = { in: 0,\"\"\")\nopen(p,'w').write(s)\np='src/scenes/activity/lanes.js'; s=open(p).read()\ns=s.replace(\"\"\"    this.playerLane?.avatar?.play('Bow', { once: true, fade: 0.3 });\"\"\",\"\"\"    if (this.playerLane) { this.playerLane.frozenClip = true; this.playerLane.avatar?.play('Bow', { once: true, fade: 0.3 }); }\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/ui/screens/common.js <<'EOF'\n// Shared bits for full-screen menus.\nimport { App } from '../../app.js';\nimport { TAB_LEFT, TAB_RIGHT } from '../../core/actions.js';\nimport { promptBar } from '../prompts.js';\nimport { say, sayCentered, textWidth } from '../font.js';\nimport { heading, panel } from '../widgets.js';\nimport { drawGlyph, glyphWidth } from '../../art/glyphs.js';\nimport { promptGlyphs } from '../prompts.js';\n\nexport class MenuScreen {\n  opaque = false;\n  constructor(name, title, menu, { prompts = null, remark = null, dim = true } = {}) {\n    this.name = name; this.title = title; this.menu = menu; this.prompts = prompts; this.remark = remark; this.dim = dim;\n  }\n  update(ctx, dt) { this.menu.update(ctx, dt); }\n  draw(ctx) {\n    const { hud } = ctx;\n    if (this.dim) dim(hud);\n    if (this.title) heading(hud, this.title);\n    this.menu.draw(ctx);\n    if (this.remark) drawRemark(ctx, typeof this.remark === 'function' ? this.remark() : this.remark);\n    promptBar(hud, App.device, this.prompts ?? [['confirm', 'Select'], ['back', 'Back']]);\n  }\n}\n\nexport function dim(hud) {\n  // A checker dither, so the world stays visible behind the menu.\n  for (let y = 0; y < hud.height; y += 2) hud.rect(0, y, hud.width, 1, 'night');\n}\n\nexport function drawRemark(ctx, text) {\n  const { hud } = ctx;\n  const lines = wrapTo(text, Math.min(hud.width - 40, 320));\n  const h = lines.length * 11 + 6;\n  const y = hud.height - 22 - h - 4;\n  const w = Math.min(hud.width - 24, 330);\n  panel(hud, Math.round((hud.width - w) / 2), y, w, h, { fill: 'white', name: 'remark' });\n  lines.forEach((l, i) => sayCentered(hud, hud.width / 2, y + 3 + i * 11, l, { color: 'ink', shadow: false, name: 'remark-text' }));\n}\n\nimport { wrap, charsIn } from '../font.js';\nexport const wrapTo = (text, width, scale = 1) => wrap(text, charsIn(width, scale));\n\n/** Tabs along the top: L1/R1, Q/E, wheel, or click. */\nexport class TabBar {\n  rects = [];\n  constructor(labels, { onChange } = {}) { this.labels = labels; this.i = 0; this.onChange = onChange; }\n  get current() { return this.labels[this.i]; }\n  set(i) { if (i !== this.i) { this.i = i; App.sfx('menuMove'); this.onChange?.(i); } }\n  update(ctx) {\n    const { input } = ctx;\n    const n = this.labels.length;\n    if (input.wasPressed(...TAB_LEFT)) this.set((this.i - 1 + n) % n);\n    if (input.wasPressed(...TAB_RIGHT)) this.set((this.i + 1) % n);\n    if (input.wasPressed('MouseLeft')) {\n      const p = App.device.pointerArt(ctx);\n      for (const r of this.rects) if (p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h) { this.set(r.i); break; }\n    }\n  }\n  draw(ctx, y = 34) {\n    const { hud } = ctx;\n    const widths = this.labels.map((l) => textWidth(l) + 10);\n    const col = App.device.promptColumn();\n    const glyphL = promptGlyphs('tabs', col);\n    const glyphW = glyphL.length === 2 ? glyphWidth(glyphL[0]) + glyphWidth(glyphL[1]) + 8 : 0;\n    const total = widths.reduce((a, b) => a + b + 3, -3) + glyphW;\n    let x = Math.round((hud.width - total) / 2);\n    if (glyphL.length === 2) { drawGlyph(hud, x, y, glyphL[0]); x += glyphWidth(glyphL[0]) + 4; }\n    this.rects = [];\n    this.labels.forEach((l, i) => {\n      const on = i === this.i;\n      hud.rect(x, y, widths[i], 11, on ? 'cyan' : 'navy');\n      say(hud, x + 5, y + 2, l, { color: on ? 'ink' : 'white', shadow: false, name: 'tab' });\n      this.rects.push({ i, x, y, w: widths[i], h: 11 });\n      x += widths[i] + 3;\n    });\n    if (glyphL.length === 2) drawGlyph(hud, x + 1, y, glyphL[1]);\n  }\n}\nEOF\ncat > src/ui/screens/results.js <<'EOF'\n// Results: stars pop in one by one, big score, a line chosen by activity and stars, classmates' scores.\nimport { App } from '../../app.js';\nimport { hardOpen, nextActivity } from '../../core/week.js';\nimport { ACTIVITIES } from '../../data/activities.js';\nimport { RESULT_LINES } from '../../data/lines.js';\nimport { Menu } from '../menu.js';\nimport { promptBar } from '../prompts.js';\nimport { say, sayCentered, textWidth } from '../font.js';\nimport { heading, panel, star, STAR_W } from '../widgets.js';\nimport { dim, wrapTo } from './common.js';\nimport { MILESTONES } from '../../data/unlocks.js';\n\nexport function pickResultLine(id, stars, firstEver, rand) {\n  const lines = RESULT_LINES[id];\n  if (!lines) return '';\n  const list = firstEver && lines.first ? lines.first : (lines[stars] ?? []);\n  const which = list.length ? list[Math.floor(rand() * list.length) % list.length] : '';\n  return which;\n}\n\nexport class ResultsScreen {\n  name = 'results';\n  t = 0;\n  shownStars = 0;\n\n  constructor(scene, r) {\n    this.scene = scene;\n    this.r = r;\n    const rand = () => scene.cosmetic.next();\n    this.line = pickResultLine(r.id, r.stars, r.firstEver, rand) || (RESULT_LINES[r.id]?.[r.stars]?.[0] ?? '');\n    if (!r.firstEver && r.stars < 3 && rand() < 0.25 && RESULT_LINES[r.id]?.repeat) this.line = RESULT_LINES[r.id].repeat[0];\n    const items = [\n      { label: 'Again', id: 'retry', action: () => App.go('activity', { ...scene.args, noPractice: true }) },\n    ];\n    const next = nextActivity(r.id, r.mode === 'week' ? App.slot : null, App.dev.allUnlocked);\n    if (next !== r.id && !ACTIVITIES[r.id].hidden) items.push({ label: 'Next', id: 'next', action: () => App.go('activity', { ...scene.args, id: next, noPractice: false }) });\n    if (r.id !== 'stand') items.push({ label: r.mode === 'week' ? 'Back to the island' : 'Back to the class', id: 'back', action: () => this.leave() });\n    else { items.length = 0; items.push({ label: 'Continue', id: 'continue', action: () => App.go('ending') }); }\n    this.menu = new Menu(items, { scale: 1, rowH: 15, width: 170, align: 'center', onBack: r.id === 'stand' ? undefined : () => this.leave() });\n    this.menuReady = false;\n  }\n\n  leave() {\n    if (this.r.mode === 'week') App.go('hub', { from: ACTIVITIES[this.r.id].station });\n    else App.go('title', { menu: 'dropin' });\n  }\n\n  update(ctx, dt) {\n    const uiDt = dt || 1 / 60;\n    this.t += uiDt;\n    const due = Math.min(this.r.stars, Math.floor((this.t - 0.4) / 0.42) + 1);\n    if (due > this.shownStars && this.t > 0.4) {\n      this.shownStars = due;\n      App.sfx('starPop', { pitch: this.shownStars * 2 });\n      if (this.shownStars === 3 && !App.settings.reduceFlashes) App.flash('white', { duration: 0.08 });\n    }\n    if (this.t > 0.4 + this.r.stars * 0.42 + 0.25 && !this.spoke) {\n      this.spoke = true;\n      this.menuReady = true;\n      App.say('ounce', this.line);\n    }\n    if (this.menuReady) this.menu.update(ctx, dt);\n    else if (ctx.input.wasPressed('Enter', 'Space', 'PadCross', 'MouseLeft')) { this.shownStars = this.r.stars; this.t = 99; }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    const r = this.r;\n    const cx = Math.round(hud.width / 2);\n    heading(hud, ACTIVITIES[r.id].name, 12, hud.width > 360 ? 2 : 1);\n    // Stars: the focal element.\n    const scale = 3;\n    const total = 3 * (STAR_W * scale + 4) - 4;\n    let x = cx - Math.round(total / 2);\n    for (let i = 0; i < 3; i++) {\n      const on = i < this.shownStars;\n      star(hud, x, 38, on, scale);\n      x += STAR_W * scale + 4;\n    }\n    sayCentered(hud, cx, 70, r.display ?? String(r.score), { scale: 3, color: 'white', name: 'score' });\n    let y = 98;\n    const bits = [];\n    if (r.mode === 'week') bits.push(`+${r.drips ?? 0} Drips${r.bonus ? ` (Coach: +${r.bonus})` : ''}`);\n    if (r.newBest) bits.push('New best');\n    if (bits.length) { sayCentered(hud, cx, y, bits.join('   '), { color: 'sand', name: 'drips' }); y += 12; }\n    if (r.unlocked?.length) {\n      const m = r.unlocked[0];\n      sayCentered(hud, cx, y, `The jar gave you: ${m.name}`, { color: 'lime', name: 'unlock' });\n      y += 12;\n    }\n    // Classmates' scores.\n    const rows = this.classRows(r);\n    if (rows.length) {\n      const w = rows.reduce((a, s) => a + textWidth(s) + 12, -12);\n      let tx = cx - Math.round(w / 2);\n      for (const s of rows) { say(hud, tx, y, s, { color: 'mist', name: 'class-score' }); tx += textWidth(s) + 12; }\n      y += 12;\n    }\n    if (this.menuReady) {\n      this.menu.o.y = Math.max(y + 2, hud.height - 22 - 18 - this.menu.items.length * 15 - 34);\n      this.menu.draw(ctx);\n      if (!this.scene.bark.active) drawInlineLine(ctx, this.line);\n      promptBar(hud, App.device, [['confirm', 'Select'], ['back', 'Back']]);\n    }\n  }\n\n  classRows(r) {\n    if (r.classmates?.length) return r.classmates.map((c) => `${c.name} ${c.score}`);\n    return [];\n  }\n}\n\nfunction drawInlineLine(ctx, line) {\n  if (!line) return;\n  const { hud } = ctx;\n  const lines = wrapTo(line, Math.min(hud.width - 40, 320));\n  const h = lines.length * 11 + 6;\n  const y = hud.height - h - 24;\n  const w = Math.min(hud.width - 24, 330);\n  panel(hud, Math.round((hud.width - w) / 2), y, w, h, { fill: 'white', name: 'line' });\n  lines.forEach((l, i) => sayCentered(hud, hud.width / 2, y + 3 + i * 11, l, { color: 'ink', shadow: false, name: 'line-text' }));\n}\n\nexport { MILESTONES, hardOpen };\nEOF\ncat > src/ui/screens/pause.js <<'EOF'\n// Pause: engine.timeScale = 0 freezes physics, fixedUpdate and game time while update still runs.\nimport { App } from '../../app.js';\nimport { Menu } from '../menu.js';\nimport { MenuScreen } from './common.js';\nimport { SettingsScreen } from './settings.js';\nimport { AboutScreen } from './about.js';\nimport { HowToScreen } from './howto.js';\nimport { DevScreen } from './dev.js';\n\nexport class PauseScreen extends MenuScreen {\n  freezes = true;\n\n  constructor(scene) {\n    const items = [{ label: 'Resume', id: 'resume', action: () => this.resume() }];\n    const inSession = !!App.session;\n    if (inSession) {\n      items.push({ label: 'Settings', id: 'settings', action: () => App.stack.push(new SettingsScreen()) });\n    } else {\n      if (scene.restart) items.push({ label: 'Restart activity', id: 'restart', action: () => { this.resume(false); scene.restart(); } });\n      if (scene.id !== 'hub' && App.slot && (scene.mode === 'week' || scene.pauseToIsland)) items.push({ label: 'Back to the island', id: 'island', action: () => { this.resume(false); App.go('hub', {}); } });\n      if (scene.mode === 'dropin' || scene.pauseToTitle) items.push({ label: 'Back to the class', id: 'class', action: () => { this.resume(false); App.go('title', { menu: 'dropin' }); } });\n      if (scene.id === 'hub') items.push({ label: 'Back to title', id: 'title', action: () => { this.resume(false); App.go('title', {}); } });\n      items.push(\n        { label: 'Settings', id: 'settings', action: () => App.stack.push(new SettingsScreen()) },\n        { label: 'How to play', id: 'howto', action: () => App.stack.push(new HowToScreen()) },\n        { label: 'About & Credits', id: 'about', action: () => App.stack.push(new AboutScreen()) },\n        { label: 'Dev Tools', id: 'dev', action: () => App.stack.push(new DevScreen()) },\n      );\n    }\n    const menu = new Menu(items, { width: 240, align: 'center', onBack: () => this.resume() });\n    super('pause', 'Paused', menu, { prompts: [['confirm', 'Select'], ['back', 'Resume']] });\n    this.scene = scene;\n    this.freezes = !inSession;\n  }\n\n  onOpen() {\n    if (this.freezes) App.engine.timeScale = 0;\n    App.voice.stop();\n    this.scene.onPause?.();\n  }\n\n  resume(tellScene = true) {\n    App.stack.pop(this);\n    App.engine.timeScale = App.dev.timeScale;\n    if (tellScene) this.scene.onResume?.();\n  }\n}\n\nApp.openPause = () => { if (App.scene && !App.stack.open) App.stack.push(new PauseScreen(App.scene)); };\nEOF\ncat > src/ui/screens/settings.js <<'EOF'\n// Settings: our own HUD menu, not the engine panel.\nimport { App, APP_LOOKS } from '../../app.js';\nimport { DEFAULT_SETTINGS } from '../../core/save.js';\nimport { Menu } from '../menu.js';\nimport { MenuScreen, TabBar } from './common.js';\nimport { heading } from '../widgets.js';\nimport { promptBar } from '../prompts.js';\n\nconst pct = (v) => `${Math.round(v * 100)}%`;\nconst LOOK_KEYS = Object.keys(APP_LOOKS);\nconst LOOK_LABEL = { default: 'Default', storybook: 'Storybook', arcade: 'Arcade', handheld: 'Handheld' };\n\nfunction volume(label, key, id) {\n  const set = (v) => { App.settings[key] = Math.round(Math.max(0, Math.min(1, v)) * 20) / 20; App.saveSettings(); };\n  return {\n    label, id, value: () => pct(App.settings[key]),\n    adjust: (d) => set(App.settings[key] + d * 0.05),\n    slider: { get: () => App.settings[key], set, min: 0, max: 1 },\n    action: () => set(App.settings[key] >= 1 ? 0 : App.settings[key] + 0.05),\n    sound: 'menuMove',\n  };\n}\n\nexport class SettingsScreen extends MenuScreen {\n  freezes = false;\n  constructor() {\n    const pages = [\n      () => [\n        volume('Music', 'music', 'music'),\n        volume('SFX', 'sfx', 'sfx'),\n        volume('Voice', 'voice', 'voice'),\n      ],\n      () => [\n        { label: 'Button glyphs', id: 'glyphs', value: () => (App.settings.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'),\n          adjust: () => this.flipGlyphs(), action: () => this.flipGlyphs() },\n        { label: 'Gentle Mode', id: 'gentle', value: () => (App.settings.gentle ? 'On' : 'Off'),\n          adjust: () => this.flip('gentle'), action: () => this.flip('gentle') },\n        { label: 'Mouse radius', id: 'mouseLeanRadius', value: () => `${App.settings.mouseLeanRadius}`,\n          adjust: (d) => this.step('mouseLeanRadius', d * 5, 20, 140), action: () => this.step('mouseLeanRadius', 5, 20, 140, true) },\n        { label: 'Step offset', id: 'stepOffsetMs', value: () => `${App.settings.stepOffsetMs} ms`,\n          adjust: (d) => this.step('stepOffsetMs', d * 5, -200, 200), action: () => this.step('stepOffsetMs', 5, -200, 200, true) },\n      ],\n      () => [\n        { label: 'Reduce flashes', id: 'reduceFlashes', value: () => (App.settings.reduceFlashes ? 'On' : 'Off'),\n          adjust: () => this.flip('reduceFlashes'), action: () => this.flip('reduceFlashes') },\n        { label: 'Look', id: 'look', value: () => LOOK_LABEL[App.settings.look] ?? 'Default',\n          adjust: (d) => this.cycleLook(d), action: () => this.cycleLook(1) },\n        { label: 'Pixel size', id: 'pixelSize', value: () => (App.settings.pixelSize ? 'Chunky' : 'Fine'),\n          adjust: () => this.flipPixel(), action: () => this.flipPixel() },\n        { label: 'Fullscreen', id: 'fullscreen', value: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'On' : 'Off'),\n          adjust: () => this.fullscreen(), action: () => this.fullscreen() },\n      ],\n      () => [\n        { label: 'Reset to defaults', id: 'reset', action: () => { Object.assign(App.settings, DEFAULT_SETTINGS); App.saveSettings(); } },\n      ],\n    ];\n    const menu = new Menu(pages[0](), { y: 56, width: 320, tabbed: true, onBack: () => App.stack.pop(this) });\n    super('settings', 'Settings', menu, { prompts: [['adjust', 'Change'], ['tabs', 'Page'], ['back', 'Back']] });\n    this.pages = pages;\n    this.tabs = new TabBar(['Sound', 'Controls', 'Picture', 'Reset'], { onChange: (i) => { this.menu.focus = 0; this.menu.top = 0; this.menu.setItems(pages[i]()); } });\n  }\n\n  flip(key) { App.settings[key] = !App.settings[key]; App.saveSettings(); }\n  flipGlyphs() { App.settings.glyphs = App.settings.glyphs === 'xbox' ? 'ps' : 'xbox'; App.saveSettings(); }\n  flipPixel() { App.settings.pixelSize = App.settings.pixelSize ? 0 : 1; App.saveSettings(); }\n  step(key, d, lo, hi, wrapAround = false) {\n    let v = App.settings[key] + d;\n    if (wrapAround && v > hi) v = lo;\n    App.settings[key] = Math.max(lo, Math.min(hi, v));\n    App.saveSettings();\n  }\n  cycleLook(d) {\n    const i = LOOK_KEYS.indexOf(App.settings.look);\n    App.settings.look = LOOK_KEYS[(i + d + LOOK_KEYS.length) % LOOK_KEYS.length];\n    App.saveSettings();\n  }\n  fullscreen() {\n    if (typeof document === 'undefined') return;\n    if (document.fullscreenElement) document.exitFullscreen?.();\n    else document.documentElement.requestFullscreen?.();\n  }\n\n  update(ctx, dt) { this.tabs.update(ctx); this.menu.update(ctx, dt); }\n\n  draw(ctx) {\n    super.draw(ctx);\n    heading(ctx.hud, 'Settings');\n    this.tabs.draw(ctx, 36);\n    void promptBar;\n  }\n}\nEOF\ncat > src/ui/screens/howto.js <<'EOF'\nimport { App } from '../../app.js';\nimport { BACK, TAB_LEFT, TAB_RIGHT, MENU_LEFT, MENU_RIGHT } from '../../core/actions.js';\nimport { HOW_TO } from '../../data/howto.js';\nimport { promptBar } from '../prompts.js';\nimport { sayCentered } from '../font.js';\nimport { heading, panel, SAFE } from '../widgets.js';\nimport { dim, wrapTo } from './common.js';\n\n/** How to play: one idea per page. */\nexport class HowToScreen {\n  name = 'howto'; i = 0;\n  update(ctx) {\n    const { input } = ctx;\n    const n = HOW_TO.length;\n    if (input.wasPressed(...TAB_RIGHT, ...MENU_RIGHT) || input.wasPressed('MouseLeft') || input.wheel > 0) { this.i = (this.i + 1) % n; App.sfx('menuMove'); }\n    if (input.wasPressed(...TAB_LEFT, ...MENU_LEFT) || input.wheel < 0) { this.i = (this.i - 1 + n) % n; App.sfx('menuMove'); }\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight') || input.wasPressed('PadCross', 'Enter')) App.stack.pop(this);\n  }\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    const p = HOW_TO[this.i];\n    heading(hud, p.title);\n    const w = Math.min(hud.width - SAFE * 2, 340);\n    const rows = p.lines.flatMap((l) => wrapTo(l, w - 16));\n    const y = 60;\n    panel(hud, Math.round((hud.width - w) / 2), y, w, rows.length * 13 + 14, { fill: 'white', name: 'howto' });\n    rows.forEach((l, k) => sayCentered(hud, hud.width / 2, y + 7 + k * 13, l, { color: 'ink', shadow: false, name: 'howto-text' }));\n    sayCentered(hud, hud.width / 2, y + rows.length * 13 + 22, `${this.i + 1} / ${HOW_TO.length}`, { color: 'sand', name: 'howto-page' });\n    promptBar(hud, App.device, [['tabs', 'Page'], ['back', 'Back']]);\n  }\n}\nEOF\necho ok","description":"Write results, pause, settings and how-to screens","timeout":30000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":23481,"cache_read_input_tokens":313082,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":23481},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"98f03cef-49d5-4e43-9e5d-e21dd23cf611","timestamp":"2026-11-05T06:35:25.599Z","request_id":"req_011CgjKFxVDCdAoXtusvKzN7","wire_tool_inputs":{"toolu_01Af8h4XWJSDA1oKmLQA1zSL":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='src/scenes/activity/base.js'; s=open(p).read()\ns=s.replace(\"import { Kevin, Ounce } from '../../art/props.js';\",\"import { Kevin, Ounce, place } from '../../art/props.js';\")\ns=s.replace(\"\"\"    if (dais) {\n      const { place } = await import('../../art/props.js');\n      place(ctx, 'dais', { at: [at[0], 0, at[2]] });\n    }\"\"\",\"\"\"    if (dais) place(ctx, 'dais', { at: [at[0], 0, at[2]] });\"\"\")\nopen(p,'w').write(s)\np='src/scenes/activity/poses.js'; s=open(p).read()\ns=s.replace(\"\"\"      lane.avatar.play(far ? 'Teeter' : this.pose.clip, { fade: 0.3 });\"\"\",\"\"\"      if (!lane.frozenClip) lane.avatar.play(far ? 'Teeter' : this.pose.clip, { fade: 0.3 });\"\"\")\ns=s.replace(\"\"\"    l.dot.reset();\n    l.state = { in: 0,\"\"\",\"\"\"    l.dot.reset();\n    l.frozenClip = false;\n    l.state = { in: 0,\"\"\")\nopen(p,'w').write(s)\np='src/scenes/activity/lanes.js'; s=open(p).read()\ns=s.replace(\"\"\"    this.playerLane?.avatar?.play('Bow', { once: true, fade: 0.3 });\"\"\",\"\"\"    if (this.playerLane) { this.playerLane.frozenClip = true; this.playerLane.avatar?.play('Bow', { once: true, fade: 0.3 }); }\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/ui/screens/common.js <<'EOF'\n// Shared bits for full-screen menus.\nimport { App } from '../../app.js';\nimport { TAB_LEFT, TAB_RIGHT } from '../../core/actions.js';\nimport { promptBar } from '../prompts.js';\nimport { say, sayCentered, textWidth } from '../font.js';\nimport { heading, panel } from '../widgets.js';\nimport { drawGlyph, glyphWidth } from '../../art/glyphs.js';\nimport { promptGlyphs } from '../prompts.js';\n\nexport class MenuScreen {\n  opaque = false;\n  constructor(name, title, menu, { prompts = null, remark = null, dim = true } = {}) {\n    this.name = name; this.title = title; this.menu = menu; this.prompts = prompts; this.remark = remark; this.dim = dim;\n  }\n  update(ctx, dt) { this.menu.update(ctx, dt); }\n  draw(ctx) {\n    const { hud } = ctx;\n    if (this.dim) dim(hud);\n    if (this.title) heading(hud, this.title);\n    this.menu.draw(ctx);\n    if (this.remark) drawRemark(ctx, typeof this.remark === 'function' ? this.remark() : this.remark);\n    promptBar(hud, App.device, this.prompts ?? [['confirm', 'Select'], ['back', 'Back']]);\n  }\n}\n\nexport function dim(hud) {\n  // A checker dither, so the world stays visible behind the menu.\n  for (let y = 0; y < hud.height; y += 2) hud.rect(0, y, hud.width, 1, 'night');\n}\n\nexport function drawRemark(ctx, text) {\n  const { hud } = ctx;\n  const lines = wrapTo(text, Math.min(hud.width - 40, 320));\n  const h = lines.length * 11 + 6;\n  const y = hud.height - 22 - h - 4;\n  const w = Math.min(hud.width - 24, 330);\n  panel(hud, Math.round((hud.width - w) / 2), y, w, h, { fill: 'white', name: 'remark' });\n  lines.forEach((l, i) => sayCentered(hud, hud.width / 2, y + 3 + i * 11, l, { color: 'ink', shadow: false, name: 'remark-text' }));\n}\n\nimport { wrap, charsIn } from '../font.js';\nexport const wrapTo = (text, width, scale = 1) => wrap(text, charsIn(width, scale));\n\n/** Tabs along the top: L1/R1, Q/E, wheel, or click. */\nexport class TabBar {\n  rects = [];\n  constructor(labels, { onChange } = {}) { this.labels = labels; this.i = 0; this.onChange = onChange; }\n  get current() { return this.labels[this.i]; }\n  set(i) { if (i !== this.i) { this.i = i; App.sfx('menuMove'); this.onChange?.(i); } }\n  update(ctx) {\n    const { input } = ctx;\n    const n = this.labels.length;\n    if (input.wasPressed(...TAB_LEFT)) this.set((this.i - 1 + n) % n);\n    if (input.wasPressed(...TAB_RIGHT)) this.set((this.i + 1) % n);\n    if (input.wasPressed('MouseLeft')) {\n      const p = App.device.pointerArt(ctx);\n      for (const r of this.rects) if (p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h) { this.set(r.i); break; }\n    }\n  }\n  draw(ctx, y = 34) {\n    const { hud } = ctx;\n    const widths = this.labels.map((l) => textWidth(l) + 10);\n    const col = App.device.promptColumn();\n    const glyphL = promptGlyphs('tabs', col);\n    const glyphW = glyphL.length === 2 ? glyphWidth(glyphL[0]) + glyphWidth(glyphL[1]) + 8 : 0;\n    const total = widths.reduce((a, b) => a + b + 3, -3) + glyphW;\n    let x = Math.round((hud.width - total) / 2);\n    if (glyphL.length === 2) { drawGlyph(hud, x, y, glyphL[0]); x += glyphWidth(glyphL[0]) + 4; }\n    this.rects = [];\n    this.labels.forEach((l, i) => {\n      const on = i === this.i;\n      hud.rect(x, y, widths[i], 11, on ? 'cyan' : 'navy');\n      say(hud, x + 5, y + 2, l, { color: on ? 'ink' : 'white', shadow: false, name: 'tab' });\n      this.rects.push({ i, x, y, w: widths[i], h: 11 });\n      x += widths[i] + 3;\n    });\n    if (glyphL.length === 2) drawGlyph(hud, x + 1, y, glyphL[1]);\n  }\n}\nEOF\ncat > src/ui/screens/results.js <<'EOF'\n// Results: stars pop in one by one, big score, a line chosen by activity and stars, classmates' scores.\nimport { App } from '../../app.js';\nimport { hardOpen, nextActivity } from '../../core/week.js';\nimport { ACTIVITIES } from '../../data/activities.js';\nimport { RESULT_LINES } from '../../data/lines.js';\nimport { Menu } from '../menu.js';\nimport { promptBar } from '../prompts.js';\nimport { say, sayCentered, textWidth } from '../font.js';\nimport { heading, panel, star, STAR_W } from '../widgets.js';\nimport { dim, wrapTo } from './common.js';\nimport { MILESTONES } from '../../data/unlocks.js';\n\nexport function pickResultLine(id, stars, firstEver, rand) {\n  const lines = RESULT_LINES[id];\n  if (!lines) return '';\n  const list = firstEver && lines.first ? lines.first : (lines[stars] ?? []);\n  const which = list.length ? list[Math.floor(rand() * list.length) % list.length] : '';\n  return which;\n}\n\nexport class ResultsScreen {\n  name = 'results';\n  t = 0;\n  shownStars = 0;\n\n  constructor(scene, r) {\n    this.scene = scene;\n    this.r = r;\n    const rand = () => scene.cosmetic.next();\n    this.line = pickResultLine(r.id, r.stars, r.firstEver, rand) || (RESULT_LINES[r.id]?.[r.stars]?.[0] ?? '');\n    if (!r.firstEver && r.stars < 3 && rand() < 0.25 && RESULT_LINES[r.id]?.repeat) this.line = RESULT_LINES[r.id].repeat[0];\n    const items = [\n      { label: 'Again', id: 'retry', action: () => App.go('activity', { ...scene.args, noPractice: true }) },\n    ];\n    const next = nextActivity(r.id, r.mode === 'week' ? App.slot : null, App.dev.allUnlocked);\n    if (next !== r.id && !ACTIVITIES[r.id].hidden) items.push({ label: 'Next', id: 'next', action: () => App.go('activity', { ...scene.args, id: next, noPractice: false }) });\n    if (r.id !== 'stand') items.push({ label: r.mode === 'week' ? 'Back to the island' : 'Back to the class', id: 'back', action: () => this.leave() });\n    else { items.length = 0; items.push({ label: 'Continue', id: 'continue', action: () => App.go('ending') }); }\n    this.menu = new Menu(items, { scale: 1, rowH: 15, width: 170, align: 'center', onBack: r.id === 'stand' ? undefined : () => this.leave() });\n    this.menuReady = false;\n  }\n\n  leave() {\n    if (this.r.mode === 'week') App.go('hub', { from: ACTIVITIES[this.r.id].station });\n    else App.go('title', { menu: 'dropin' });\n  }\n\n  update(ctx, dt) {\n    const uiDt = dt || 1 / 60;\n    this.t += uiDt;\n    const due = Math.min(this.r.stars, Math.floor((this.t - 0.4) / 0.42) + 1);\n    if (due > this.shownStars && this.t > 0.4) {\n      this.shownStars = due;\n      App.sfx('starPop', { pitch: this.shownStars * 2 });\n      if (this.shownStars === 3 && !App.settings.reduceFlashes) App.flash('white', { duration: 0.08 });\n    }\n    if (this.t > 0.4 + this.r.stars * 0.42 + 0.25 && !this.spoke) {\n      this.spoke = true;\n      this.menuReady = true;\n      App.say('ounce', this.line);\n    }\n    if (this.menuReady) this.menu.update(ctx, dt);\n    else if (ctx.input.wasPressed('Enter', 'Space', 'PadCross', 'MouseLeft')) { this.shownStars = this.r.stars; this.t = 99; }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    const r = this.r;\n    const cx = Math.round(hud.width / 2);\n    heading(hud, ACTIVITIES[r.id].name, 12, hud.width > 360 ? 2 : 1);\n    // Stars: the focal element.\n    const scale = 3;\n    const total = 3 * (STAR_W * scale + 4) - 4;\n    let x = cx - Math.round(total / 2);\n    for (let i = 0; i < 3; i++) {\n      const on = i < this.shownStars;\n      star(hud, x, 38, on, scale);\n      x += STAR_W * scale + 4;\n    }\n    sayCentered(hud, cx, 70, r.display ?? String(r.score), { scale: 3, color: 'white', name: 'score' });\n    let y = 98;\n    const bits = [];\n    if (r.mode === 'week') bits.push(`+${r.drips ?? 0} Drips${r.bonus ? ` (Coach: +${r.bonus})` : ''}`);\n    if (r.newBest) bits.push('New best');\n    if (bits.length) { sayCentered(hud, cx, y, bits.join('   '), { color: 'sand', name: 'drips' }); y += 12; }\n    if (r.unlocked?.length) {\n      const m = r.unlocked[0];\n      sayCentered(hud, cx, y, `The jar gave you: ${m.name}`, { color: 'lime', name: 'unlock' });\n      y += 12;\n    }\n    // Classmates' scores.\n    const rows = this.classRows(r);\n    if (rows.length) {\n      const w = rows.reduce((a, s) => a + textWidth(s) + 12, -12);\n      let tx = cx - Math.round(w / 2);\n      for (const s of rows) { say(hud, tx, y, s, { color: 'mist', name: 'class-score' }); tx += textWidth(s) + 12; }\n      y += 12;\n    }\n    if (this.menuReady) {\n      this.menu.o.y = Math.max(y + 2, hud.height - 22 - 18 - this.menu.items.length * 15 - 34);\n      this.menu.draw(ctx);\n      if (!this.scene.bark.active) drawInlineLine(ctx, this.line);\n      promptBar(hud, App.device, [['confirm', 'Select'], ['back', 'Back']]);\n    }\n  }\n\n  classRows(r) {\n    if (r.classmates?.length) return r.classmates.map((c) => `${c.name} ${c.score}`);\n    return [];\n  }\n}\n\nfunction drawInlineLine(ctx, line) {\n  if (!line) return;\n  const { hud } = ctx;\n  const lines = wrapTo(line, Math.min(hud.width - 40, 320));\n  const h = lines.length * 11 + 6;\n  const y = hud.height - h - 24;\n  const w = Math.min(hud.width - 24, 330);\n  panel(hud, Math.round((hud.width - w) / 2), y, w, h, { fill: 'white', name: 'line' });\n  lines.forEach((l, i) => sayCentered(hud, hud.width / 2, y + 3 + i * 11, l, { color: 'ink', shadow: false, name: 'line-text' }));\n}\n\nexport { MILESTONES, hardOpen };\nEOF\ncat > src/ui/screens/pause.js <<'EOF'\n// Pause: engine.timeScale = 0 freezes physics, fixedUpdate and game time while update still runs.\nimport { App } from '../../app.js';\nimport { Menu } from '../menu.js';\nimport { MenuScreen } from './common.js';\nimport { SettingsScreen } from './settings.js';\nimport { AboutScreen } from './about.js';\nimport { HowToScreen } from './howto.js';\nimport { DevScreen } from './dev.js';\n\nexport class PauseScreen extends MenuScreen {\n  freezes = true;\n\n  constructor(scene) {\n    const items = [{ label: 'Resume', id: 'resume', action: () => this.resume() }];\n    const inSession = !!App.session;\n    if (inSession) {\n      items.push({ label: 'Settings', id: 'settings', action: () => App.stack.push(new SettingsScreen()) });\n    } else {\n      if (scene.restart) items.push({ label: 'Restart activity', id: 'restart', action: () => { this.resume(false); scene.restart(); } });\n      if (scene.id !== 'hub' && App.slot && (scene.mode === 'week' || scene.pauseToIsland)) items.push({ label: 'Back to the island', id: 'island', action: () => { this.resume(false); App.go('hub', {}); } });\n      if (scene.mode === 'dropin' || scene.pauseToTitle) items.push({ label: 'Back to the class', id: 'class', action: () => { this.resume(false); App.go('title', { menu: 'dropin' }); } });\n      if (scene.id === 'hub') items.push({ label: 'Back to title', id: 'title', action: () => { this.resume(false); App.go('title', {}); } });\n      items.push(\n        { label: 'Settings', id: 'settings', action: () => App.stack.push(new SettingsScreen()) },\n        { label: 'How to play', id: 'howto', action: () => App.stack.push(new HowToScreen()) },\n        { label: 'About & Credits', id: 'about', action: () => App.stack.push(new AboutScreen()) },\n        { label: 'Dev Tools', id: 'dev', action: () => App.stack.push(new DevScreen()) },\n      );\n    }\n    const menu = new Menu(items, { width: 240, align: 'center', onBack: () => this.resume() });\n    super('pause', 'Paused', menu, { prompts: [['confirm', 'Select'], ['back', 'Resume']] });\n    this.scene = scene;\n    this.freezes = !inSession;\n  }\n\n  onOpen() {\n    if (this.freezes) App.engine.timeScale = 0;\n    App.voice.stop();\n    this.scene.onPause?.();\n  }\n\n  resume(tellScene = true) {\n    App.stack.pop(this);\n    App.engine.timeScale = App.dev.timeScale;\n    if (tellScene) this.scene.onResume?.();\n  }\n}\n\nApp.openPause = () => { if (App.scene && !App.stack.open) App.stack.push(new PauseScreen(App.scene)); };\nEOF\ncat > src/ui/screens/settings.js <<'EOF'\n// Settings: our own HUD menu, not the engine panel.\nimport { App, APP_LOOKS } from '../../app.js';\nimport { DEFAULT_SETTINGS } from '../../core/save.js';\nimport { Menu } from '../menu.js';\nimport { MenuScreen, TabBar } from './common.js';\nimport { heading } from '../widgets.js';\nimport { promptBar } from '../prompts.js';\n\nconst pct = (v) => `${Math.round(v * 100)}%`;\nconst LOOK_KEYS = Object.keys(APP_LOOKS);\nconst LOOK_LABEL = { default: 'Default', storybook: 'Storybook', arcade: 'Arcade', handheld: 'Handheld' };\n\nfunction volume(label, key, id) {\n  const set = (v) => { App.settings[key] = Math.round(Math.max(0, Math.min(1, v)) * 20) / 20; App.saveSettings(); };\n  return {\n    label, id, value: () => pct(App.settings[key]),\n    adjust: (d) => set(App.settings[key] + d * 0.05),\n    slider: { get: () => App.settings[key], set, min: 0, max: 1 },\n    action: () => set(App.settings[key] >= 1 ? 0 : App.settings[key] + 0.05),\n    sound: 'menuMove',\n  };\n}\n\nexport class SettingsScreen extends MenuScreen {\n  freezes = false;\n  constructor() {\n    const pages = [\n      () => [\n        volume('Music', 'music', 'music'),\n        volume('SFX', 'sfx', 'sfx'),\n        volume('Voice', 'voice', 'voice'),\n      ],\n      () => [\n        { label: 'Button glyphs', id: 'glyphs', value: () => (App.settings.glyphs === 'xbox' ? 'Xbox' : 'PlayStation'),\n          adjust: () => this.flipGlyphs(), action: () => this.flipGlyphs() },\n        { label: 'Gentle Mode', id: 'gentle', value: () => (App.settings.gentle ? 'On' : 'Off'),\n          adjust: () => this.flip('gentle'), action: () => this.flip('gentle') },\n        { label: 'Mouse radius', id: 'mouseLeanRadius', value: () => `${App.settings.mouseLeanRadius}`,\n          adjust: (d) => this.step('mouseLeanRadius', d * 5, 20, 140), action: () => this.step('mouseLeanRadius', 5, 20, 140, true) },\n        { label: 'Step offset', id: 'stepOffsetMs', value: () => `${App.settings.stepOffsetMs} ms`,\n          adjust: (d) => this.step('stepOffsetMs', d * 5, -200, 200), action: () => this.step('stepOffsetMs', 5, -200, 200, true) },\n      ],\n      () => [\n        { label: 'Reduce flashes', id: 'reduceFlashes', value: () => (App.settings.reduceFlashes ? 'On' : 'Off'),\n          adjust: () => this.flip('reduceFlashes'), action: () => this.flip('reduceFlashes') },\n        { label: 'Look', id: 'look', value: () => LOOK_LABEL[App.settings.look] ?? 'Default',\n          adjust: (d) => this.cycleLook(d), action: () => this.cycleLook(1) },\n        { label: 'Pixel size', id: 'pixelSize', value: () => (App.settings.pixelSize ? 'Chunky' : 'Fine'),\n          adjust: () => this.flipPixel(), action: () => this.flipPixel() },\n        { label: 'Fullscreen', id: 'fullscreen', value: () => (typeof document !== 'undefined' && document.fullscreenElement ? 'On' : 'Off'),\n          adjust: () => this.fullscreen(), action: () => this.fullscreen() },\n      ],\n      () => [\n        { label: 'Reset to defaults', id: 'reset', action: () => { Object.assign(App.settings, DEFAULT_SETTINGS); App.saveSettings(); } },\n      ],\n    ];\n    const menu = new Menu(pages[0](), { y: 56, width: 320, tabbed: true, onBack: () => App.stack.pop(this) });\n    super('settings', 'Settings', menu, { prompts: [['adjust', 'Change'], ['tabs', 'Page'], ['back', 'Back']] });\n    this.pages = pages;\n    this.tabs = new TabBar(['Sound', 'Controls', 'Picture', 'Reset'], { onChange: (i) => { this.menu.focus = 0; this.menu.top = 0; this.menu.setItems(pages[i]()); } });\n  }\n\n  flip(key) { App.settings[key] = !App.settings[key]; App.saveSettings(); }\n  flipGlyphs() { App.settings.glyphs = App.settings.glyphs === 'xbox' ? 'ps' : 'xbox'; App.saveSettings(); }\n  flipPixel() { App.settings.pixelSize = App.settings.pixelSize ? 0 : 1; App.saveSettings(); }\n  step(key, d, lo, hi, wrapAround = false) {\n    let v = App.settings[key] + d;\n    if (wrapAround && v > hi) v = lo;\n    App.settings[key] = Math.max(lo, Math.min(hi, v));\n    App.saveSettings();\n  }\n  cycleLook(d) {\n    const i = LOOK_KEYS.indexOf(App.settings.look);\n    App.settings.look = LOOK_KEYS[(i + d + LOOK_KEYS.length) % LOOK_KEYS.length];\n    App.saveSettings();\n  }\n  fullscreen() {\n    if (typeof document === 'undefined') return;\n    if (document.fullscreenElement) document.exitFullscreen?.();\n    else document.documentElement.requestFullscreen?.();\n  }\n\n  update(ctx, dt) { this.tabs.update(ctx); this.menu.update(ctx, dt); }\n\n  draw(ctx) {\n    super.draw(ctx);\n    heading(ctx.hud, 'Settings');\n    this.tabs.draw(ctx, 36);\n    void promptBar;\n  }\n}\nEOF\ncat > src/ui/screens/howto.js <<'EOF'\nimport { App } from '../../app.js';\nimport { BACK, TAB_LEFT, TAB_RIGHT, MENU_LEFT, MENU_RIGHT } from '../../core/actions.js';\nimport { HOW_TO } from '../../data/howto.js';\nimport { promptBar } from '../prompts.js';\nimport { sayCentered } from '../font.js';\nimport { heading, panel, SAFE } from '../widgets.js';\nimport { dim, wrapTo } from './common.js';\n\n/** How to play: one idea per page. */\nexport class HowToScreen {\n  name = 'howto'; i = 0;\n  update(ctx) {\n    const { input } = ctx;\n    const n = HOW_TO.length;\n    if (input.wasPressed(...TAB_RIGHT, ...MENU_RIGHT) || input.wasPressed('MouseLeft') || input.wheel > 0) { this.i = (this.i + 1) % n; App.sfx('menuMove'); }\n    if (input.wasPressed(...TAB_LEFT, ...MENU_LEFT) || input.wheel < 0) { this.i = (this.i - 1 + n) % n; App.sfx('menuMove'); }\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight') || input.wasPressed('PadCross', 'Enter')) App.stack.pop(this);\n  }\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    const p = HOW_TO[this.i];\n    heading(hud, p.title);\n    const w = Math.min(hud.width - SAFE * 2, 340);\n    const rows = p.lines.flatMap((l) => wrapTo(l, w - 16));\n    const y = 60;\n    panel(hud, Math.round((hud.width - w) / 2), y, w, rows.length * 13 + 14, { fill: 'white', name: 'howto' });\n    rows.forEach((l, k) => sayCentered(hud, hud.width / 2, y + 7 + k * 13, l, { color: 'ink', shadow: false, name: 'howto-text' }));\n    sayCentered(hud, hud.width / 2, y + rows.length * 13 + 22, `${this.i + 1} / ${HOW_TO.length}`, { color: 'sand', name: 'howto-page' });\n    promptBar(hud, App.device, [['tabs', 'Page'], ['back', 'Back']]);\n  }\n}\nEOF\necho ok","description":"Write results, pause, settings and how-to screens","timeout":30000}}}
