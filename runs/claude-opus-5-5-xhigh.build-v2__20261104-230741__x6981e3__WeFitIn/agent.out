=> App.stack.pop(this) });\",\"this.menu = new Menu([], { y: 50, width: 456, maxRows: 8, tabbed: true, onBack: () => App.stack.pop(this) });\")\ns=s.replace(\"\"\"    this.menu.setItems(tab === 'Tools' ? this.toolItems() : this.sliderItems(tab));\"\"\",\"\"\"    this.menu.setItems(tab === 'Go' || tab === 'Test' ? this.toolItems().filter((t) => t.tab === tab) : this.sliderItems(tab));\"\"\")\ns=s.replace(\"value: () => `${fmt(T[d.id])}  (${fmt(d.def)})`,\",\"value: () => `${fmt(T[d.id])} (${fmt(d.def)})`,\")\ns=s.replace(\"{ label: 'Export changes (console, clipboard)', id: 'export',\",\"{ label: 'Export changes', id: 'export',\")\ns=s.replace(\"\"\"    return [\n      { label: 'Go to day', id: 'day',\"\"\",\"\"\"    const go = (t) => ({ ...t, tab: 'Go' }), test = (t) => ({ ...t, tab: 'Test' });\n    return [\n      { label: 'Go to day', id: 'day',\"\"\")\ns=s.replace(\"{ label: 'Finish activity with stars', id: 'finish',\",\"{ label: 'Finish with stars', id: 'finish',\")\ns=s.replace(\"\"\"      { label: 'Reset save', id: 'resetSave', action: () => { App.store.resetAll(); App.go('title'); } },\n    ];\"\"\",\"\"\"      { label: 'Reset save', id: 'resetSave', action: () => { App.store.resetAll(); App.go('title'); } },\n    ].map((t) => (['day', 'scene', 'activity', 'finish', 'drips', 'unlock', 'anim', 'resetSave'].includes(t.id) ? go(t) : test(t)));\"\"\")\ns=s.replace(\"\"\"  update(ctx, dt) { this.tabs.update(ctx); this.menu.update(ctx, dt); }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    heading(hud, 'Dev Tools', 8);\n    this.tabs.draw(ctx, 32);\"\"\",\"\"\"  update(ctx, dt) { this.tabs.update(ctx, { wheel: this.menu.items.length <= this.menu.visibleRows() }); this.menu.update(ctx, dt); }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    heading(hud, 'Dev Tools', 8);\n    this.tabs.draw(ctx, 32);\"\"\")\nopen('src/ui/screens/dev.js','w').write(s)\n\n# Tabs: wheel, or click the tab\nsub('src/ui/screens/common.js',[\n(\"\"\"  update(ctx) {\n    const { input } = ctx;\n    const n = this.labels.length;\n    if (input.wasPressed(...TAB_LEFT)) this.set((this.i - 1 + n) % n);\n    if (input.wasPressed(...TAB_RIGHT)) this.set((this.i + 1) % n);\"\"\",\"\"\"  update(ctx, { wheel = true } = {}) {\n    const { input } = ctx;\n    const n = this.labels.length;\n    if (input.wasPressed(...TAB_LEFT)) this.set((this.i - 1 + n) % n);\n    if (input.wasPressed(...TAB_RIGHT)) this.set((this.i + 1) % n);\n    if (wheel && input.wheel) this.set((this.i + Math.sign(input.wheel) + n) % n);\"\"\"),\n])\nsub('src/scenes/records.js',[\n(\"\"\"    this.tabs.update(ctx);\n    if (this.tabs.current === 'Records') {\n      const n = PLAYABLE_IDS.length;\n      if (input.wasPressed(...MENU_RIGHT) || input.wheel > 0) { this.page = (this.page + 1) % n; App.sfx('menuMove'); }\n      if (input.wasPressed(...MENU_LEFT) || input.wheel < 0) { this.page = (this.page - 1 + n) % n; App.sfx('menuMove'); }\n    }\"\"\",\"\"\"    this.tabs.update(ctx, { wheel: this.tabs.current !== 'Records' });\n    if (this.tabs.current === 'Records') {\n      const n = PLAYABLE_IDS.length;\n      if (input.wasPressed(...MENU_RIGHT) || input.wheel > 0) { this.page = (this.page + 1) % n; App.sfx('menuMove'); }\n      if (input.wasPressed(...MENU_LEFT) || input.wheel < 0) { this.page = (this.page - 1 + n) % n; App.sfx('menuMove'); }\n    }\"\"\"),\n])\n\n# ---------------- Menu rows at scale 2 wherever they fit\nsub('src/ui/screens/results.js',[\n(\"\"\"      this.menu.o.y = Math.max(y + 2, hud.height - 22 - 18 - this.menu.items.length * 15 - 34);\n      this.menu.draw(ctx);\"\"\",\"\"\"      // Scale 2 rows when there's room; a 720p window's art is only 240 tall.\n      const big = hud.height >= 270;\n      this.menu.o.scale = big ? 2 : 1;\n      this.menu.o.rowH = big ? 21 : 15;\n      this.menu.o.width = big ? 260 : 170;\n      this.menu.o.y = Math.max(y + 3, hud.height - 22 - 18 - this.menu.items.length * this.menu.o.rowH - 34);\n      this.menu.d