n a little stand', tags: ['prop', 'item'],\n  palette: { paper: 'white', water: 'sky', stand: 'slate' },\n  parts: [\n    { name: 'stand', cyl: [0.07, 0.6, 0.07], at: [0, 0.3, 0], c: 'stand', seg: 6 },\n    { name: 'cup', cyl: [0.36, 0.34, 0.36], at: [0, 0.76, 0], top: 1.3, c: 'paper', seg: 8 },\n    { name: 'water', cyl: [0.32, 0.03, 0.32], at: [0, 0.94, 0], c: 'water', seg: 8 },\n  ],\n});\n\nexport const sprinkler = model({\n  id: 'sprinkler', about: 'A brass lawn sprinkler with a spinning arm', tags: ['prop', 'hazard'],\n  palette: { base: 'green', brass: 'sand', arm: 'orange' },\n  parts: [\n    { name: 'base', cyl: [0.5, 0.12, 0.5], at: [0, 0.06, 0], c: 'base', seg: 8 },\n    { name: 'stem', cyl: [0.12, 0.4, 0.12], at: [0, 0.32, 0], c: 'brass', seg: 6 },\n    { group: [{ name: 'armBar', box: [0.9, 0.08, 0.08], at: [0, 0, 0], c: 'arm' }], name: 'arm', pivot: true, at: [0, 0.54, 0] },\n  ],\n});\n\nexport const picnic = model({\n  id: 'picnic', about: 'A picnic rug with a basket, directly in the way', tags: ['prop', 'hazard'],\n  palette: { rug: 'red', check: 'white', basket: 'orange', lid: 'plum' },\n  parts: [\n    { name: 'rug', box: [1.6, 0.05, 1.3], at: [0, 0.025, 0], c: 'rug' },\n    ...[-0.5, 0, 0.5].map((x) => ({ box: [0.2, 0.02, 1.26], at: [x, 0.06, 0], c: 'check' })),\n    { name: 'basket', box: [0.6, 0.32, 0.42], at: [0.2, 0.22, -0.1], c: 'basket' },\n    { name: 'lid', box: [0.64, 0.08, 0.46], at: [0.2, 0.41, -0.1], c: 'lid' },\n  ],\n});\n\n/** Kevin. Staff. Two poses: wings as pivots. */\nexport const kevin = model({\n  id: 'kevin', about: 'Kevin, a seagull. He has been with us eleven years.', tags: ['character'],\n  palette: { body: 'white', wing: 'mist', tip: 'slate', beak: 'orange', eye: 'ink', leg: 'orange' },\n  parts: [\n    { name: 'body', ball: [0.34, 0.3, 0.56], at: [0, 0.3, 0], c: 'body', seg: 8 },\n    { name: 'head', ball: [0.24, 0.24, 0.24], at: [0, 0.48, 0.24], c: 'body', seg: 8 },\n    { name: 'beak', box: [0.08, 0.07, 0.16], at: [0, 0.46, 0.42], c: 'beak' },\n    { mirror: [{ name: 'eye', box: [0.06, 0.06, 0.06], at: [0.1, 0.52, 0.28], c: 'eye' }], axis: 'x' },\n    { name: 'tail', box: [0.2, 0.06, 0.24], at: [0, 0.34, -0.36], rot: [-14, 0, 0], c: 'tip' },\n    { mirror: [{ name: 'leg', box: [0.06, 0.16, 0.06], at: [0.08, 0.08, 0], c: 'leg' }], axis: 'x' },\n    { group: [{ box: [0.5, 0.06, 0.26], at: [0.25, 0, 0], c: 'wing' }, { box: [0.2, 0.06, 0.2], at: [0.58, 0, 0], c: 'tip' }], name: 'wingR', pivot: true, at: [0.16, 0.36, 0] },\n    { group: [{ box: [0.5, 0.06, 0.26], at: [-0.25, 0, 0], c: 'wing' }, { box: [0.2, 0.06, 0.2], at: [-0.58, 0, 0], c: 'tip' }], name: 'wingL', pivot: true, at: [-0.16, 0.36, 0] },\n  ],\n});\n\nexport const dais = model({\n  id: 'dais', about: 'A small round white dais for an instructor who never needs one', tags: ['prop'],\n  palette: { top: 'white', side: 'mist', trim: 'cyan' },\n  parts: [\n    { name: 'side', cyl: [2.2, 0.3, 2.2], at: [0, 0.15, 0], c: 'side', seg: 12 },\n    { name: 'top', cyl: [2, 0.06, 2], at: [0, 0.33, 0], c: 'top', seg: 12 },\n    { name: 'trim', cyl: [2.26, 0.06, 2.26], at: [0, 0.03, 0], c: 'trim', seg: 12 },\n  ],\n});\n\nexport const rail = model({\n  id: 'class-rail', about: 'A plain white rail for Kevin to sit on', tags: ['prop'],\n  params: { len: [6, 2, 16] },\n  palette: { rail: 'white', post: 'mist' },\n  parts: (p) => [\n    { name: 'bar', box: [p.len, 0.12, 0.12], at: [0, 1.05, 0], c: 'rail' },\n    ...Array.from({ length: Math.max(2, Math.ceil(p.len / 2)) + 1 }, (_, i, a) => ({ box: [0.12, 1, 0.12], at: [-p.len / 2 + (i * p.len) / (a.length - 1), 0.5, 0], c: 'post' })),\n  ],\n});\n\nexport const giantDumbbell = model({\n  id: 'giant-dumbbell', about: 'A rack-sized dumbbell for the Rep Shed floor', tags: ['prop'],\n  palette: { plate: 'slate', bar: 'mist', rim: 'ink' },\n  parts: [\n    { name: 'bar', cyl: [0.2, 1.6, 0.2], at: [0, 0.4, 0], rot: [0, 0, 90], c: 'bar', seg: 8 },\n    { mirror: [{ name: 'plate', cyl: [0.8, 0.3, 0.8], at: [0.62, 0.4, 0], rot: [0, 0, 90], c: 'plate', seg: 10 }, { name: 'cap', cyl: [0.5, 0.12, 0.5], at: [0.82, 0.4, 0], rot: [0, 0, 90], c: 'rim', seg: 8 }], axis: 'x' },\n  ],\n});\n\nexport const towelRack = model({\n  id: 'towel-rack', about: 'A rack of folded white towels', tags: ['prop'],\n  palette: { wood: 'orange', towel: 'white', towel2: 'cyan' },\n  parts: [\n    { mirror: [{ box: [0.1, 1.4, 0.5], at: [0.7, 0.7, 0], c: 'wood' }], axis: 'x' },\n    ...[0.3, 0.75, 1.2].map((y) => ({ box: [1.5, 0.07, 0.5], at: [0, y, 0], c: 'wood' })),\n    ...[0.42, 0.87].flatMap((y, k) => [-0.4, 0, 0.4].map((x, i) => ({ box: [0.32, 0.17, 0.4], at: [x, y, 0], c: (i + k) % 2 ? 'towel' : 'towel2' }))),\n  ],\n});\n\nexport const GAME_MODELS = [\n  ounce, kettlebellVolcano, foamRollerHill, dumbbellBridge, medicineBall, pavilion, sweatJar, repShed, beatStage, pier, palm,\n  yogaMat, stepPlatform, hoop, coconut, flipFlop, goldenPineapple, catapult, tray, vitaminCup, vitamin, slackAnchor, hammock,\n  lockers, numbersBoard, judgePaddle, mobilityScooter, ferry, waterCup, sprinkler, picnic, kevin, dais, rail, giantDumbbell, towelRack,\n];\n\nexport const MODELS = new ModelCatalog([...MODEL_LIBRARY.all(), ...GAME_MODELS]);\nEOF\ncat > src/art/textures.js <<'EOF'\n// Surfaces. A floor is a PlaneGeometry whose UVs are scaled by metres / tile size, never a stretched map.\nimport { DEFAULT_TEXEL, PALETTE, TEXTURE_LIBRARY, textureDef, textureMap, THREE, toonMaterial } from '../../pixel-engine.js';\n\nconst { Mesh, PlaneGeometry } = THREE;\n\nexport const clinicTile = textureDef({\n  id: 'clinic-tile', size: [16, 16], tile: true, palette: { grout: 'mist', a: 'white', b: 'white' },\n  layers: [{ pattern: 'tiles', colors: ['grout', 'a', 'b'], w: 16, h: 16, mortar: 1, seed: 3 }],\n  about: 'Spotless white clinic tile with thin grey grout', tags: ['floor'],\n});\n\nexport const gymFloor = textureDef({\n  id: 'gym-floor', size: [32, 32], tile: true, palette: { gap: 'orange', a: 'sand', b: 'sand' },\n  layers: [{ pattern: 'planks', colors: ['gap', 'a', 'b'], w: 8, gap: 1, length: 32, seed: 4 }],\n  about: 'Warm sprung-wood gym floor', tags: ['floor', 'wood'],\n});\n\nexport const GAME_TEXTURES = [clinicTile, gymFloor];\nlet added = false;\nexport function ensureTextures() {\n  if (added) return;\n  added = true;\n  for (const t of GAME_TEXTURES) if (!TEXTURE_LIBRARY.has(t.id)) TEXTURE_LIBRARY.add(t);\n}\n\n/** A flat floor with the map at its proper density. */\nexport function floorPlane(id, w, d, { at = [0, 0, 0], receive = true } = {}) {\n  ensureTextures();\n  const tile = TEXTURE_LIBRARY.get(id).size[0] / DEFAULT_TEXEL;\n  const g = new PlaneGeometry(w, d).rotateX(-Math.PI / 2);\n  const uv = g.attributes.uv;\n  for (let i = 0; i < uv.count; i++) uv.setXY(i, (uv.getX(i) * w) / tile, (uv.getY(i) * d) / tile);\n  const m = new Mesh(g, toonMaterial(PALETTE.white, { map: textureMap(id) }));\n  m.position.set(...at);\n  m.receiveShadow = receive;\n  return m;\n}\nEOF\ncat > src/art/clips.js <<'EOF'\n// Everything the hero rig learns here. ClipDef data, compiled once and shared between avatars.\nimport { gaitClip, HERO_CLIPS, HERO_RIG, mirror, placeFeet } from '../../pixel-engine.js';\n\nconst hold = (name, pose) => ({ name, frames: 60, loop: true, keys: [[0, pose], [60, pose]] });\nconst feet = (pose, R, L) => placeFeet(pose, HERO_RIG, { R, L });\nconst stand = (pose = {}) => feet({ Pelvis: { p: [0, -0.02, 0] }, ...pose }, { z: 0 }, { z: 0 });\n\nconst squatTop = { Pelvis: { p: [0, -0.02, 0] }, Torso: [2, 0, 0], ArmR: [6, 0, -9], ArmL: [6, 0, 9] };\nconst squatLow = { Pelvis: { p: [0, -0.3, -0.05] }, Torso: [26, 0, 0], Head: [-20, 0, 0], ArmR: [-85, 0, -8], ArmL: [-85, 0, 8] };\nconst lungeTop = { Pelvis: { p: [0, -0.02, 0] }, Torso: [2, 0, 0], ArmR: [0, 0, -14], ArmL: [0, 0, 14] };\nconst lungeLow = { Pelvis: { p: [0, -0.24, 0] }, Torso: [6, 0, 0], ArmR: [8, 0, -22], ArmL: [8, 0, 22] };\nconst lungeGoalsR = [{ z: 0 }, { z: 0 }];\nconst lungeGoalsLow = { R: { z: 0.34 }, L: { z: -0.32, pitch: 25, pivot: 'ball' } };\n\nconst pressBottom = { Pelvis: { p: [0, -0.04, 0] }, Torso: [0, 0, 0], ArmR: [-46, 0, -52], ForearmR: [-128, 0, 0], ArmL: [-46, 0, 52], ForearmL: [-128, 0, 0] };\nconst pressTop = { Pelvis: { p: [0, -0.01, 0] }, Torso: [-3, 0, 0], Head: [-12, 0, 0], ArmR: [-176, 0, -7], ForearmR: [-5, 0, 0], ArmL: [-176, 0, 7], ForearmL: [-5, 0, 0] };\n\nconst stepUpPose = (side) => {\n  const base = { Pelvis: { p: [0, 0.04, 0] }, Torso: [4, 0, side === 'L' ? -3 : 3], ArmR: [side === 'L' ? -40 : 30, 0, -14], ForearmR: [-60, 0, 0], ArmL: [side === 'L' ? 30 : -40, 0, 14], ForearmL: [-60, 0, 0] };\n  return side === 'L' ? placeFeet(base, HERO_RIG, { R: { z: 0 }, L: { z: 0.12, y: 0.22 } }) : placeFeet(base, HERO_RIG, { L: { z: 0 }, R: { z: 0.12, y: 0.22 } });\n};\nconst stepRest = stand({ ArmR: [0, 0, -10], ForearmR: [-40, 0, 0], ArmL: [0, 0, 10], ForearmL: [-40, 0, 0] });\n\nconst nodBack = stand({ Torso: [-14, 0, 0], Head: [-34, 0, 0], ArmR: [14, 0, -24], ArmL: [14, 0, 24] });\nconst nodHit = stand({ Torso: [20, 0, 0], Head: [30, 0, 0], ArmR: [24, 0, -30], ArmL: [24, 0, 30] });\n\nconst flailA = stand({ Torso: [-6, 0, 8], ArmR: [-160, 0, -40], ForearmR: [-40, 0, 0], ArmL: [-30, 0, 70], ForearmL: [-30, 0, 0], Head: [-10, 0, 12] });\nconst flailB = stand({ Torso: [-6, 0, -8], ArmR: [-30, 0, -70], ForearmR: [-30, 0, 0], ArmL: [-160, 0, 40], ForearmL: [-40, 0, 0], Head: [-10, 0, -12] });\n\nconst clapOpen = stand({ ArmR: [-62, 0, -28], ForearmR: [-60, 0, 0], ArmL: [-62, 0, 28], ForearmL: [-60, 0, 0] });\nconst clapShut = stand({ ArmR: [-68, 12, -6], ForearmR: [-66, 0, 0], ArmL: [-68, -12, 6], ForearmL: [-66, 0, 0] });\n\nconst tuckCrouch = { Pelvis: { p: [0, -0.34, -0.04] }, Torso: [46, 0, 0], Head: [-34, 0, 0], ArmR: [-20, 0, -14], ForearmR: [-90, 0, 0], ArmL: [-20, 0, 14], ForearmL: [-90, 0, 0] };\n\nconst cannon = {\n  Pelvis: { p: [0, 0.1, 0] }, Torso: [40, 0, 0], Head: [-20, 0, 0],\n  ArmR: [-70, 0, -14], ForearmR: [-120, 0, 0], ArmL: [-70, 0, 14], ForearmL: [-120, 0, 0],\n  LegR: [-118, 0, 0], ShinR: [146, 0, 0], FootR: [30, 0, 0], LegL: [-118, 0, 0], ShinL: [146, 0, 0], FootL: [30, 0, 0],\n};\nconst flyPose = {\n  Pelvis: { r: [18, 0, 0], p: [0, 0.12, 0] }, Head: [-14, 0, 0],\n  ArmR: [-60, 0, -66], ArmL: [-60, 0, 66], LegR: [-12, 0, 0], ShinR: [28, 0, 0], LegL: [18, 0, 0], ShinL: [46, 0, 0],\n};\n\nexport const GAME_CLIPS = [\n  hold('Tree', { Pelvis: { p: [0.03, -0.02, 0] }, ArmR: [-172, 0, -6], ForearmR: [-14, 0, 0], ArmL: [-172, 0, 6], ForearmL: [-14, 0, 0], LegR: [-62, 0, -58], ShinR: [150, 0, 0], FootR: [30, 0, 0] }),\n  hold('Heron', { Pelvis: { p: [0, -0.02, 0] }, Torso: [10, 0, 0], Head: [-14, 0, 0], ArmR: [-20, 0, -80], ArmL: [-20, 0, 80], ForearmR: [-30, 0, 0], ForearmL: [-30, 0, 0], LegR: [-85, 0, 0], ShinR: [95, 0, 0], FootR: [35, 0, 0] }),\n  hold('Warrior', feet({ Pelvis: { p: [0, -0.2, 0] }, Torso: [0, 25, 0], Head: [0, 40, 0], ArmR: [0, 0, -90], ArmL: [0, 0, 90] }, { z: 0.38 }, { z: -0.38 })),\n  hold('Chair', feet({ Pelvis: { p: [0, -0.28, -0.06] }, Torso: [24, 0, 0], Head: [-18, 0, 0], ArmR: [-110, 0, -8], ArmL: [-110, 0, 8] }, { z: 0 }, { z: 0 })),\n  hold('Fold', feet({ Pelvis: { p: [0, -0.03, -0.03] }, Torso: [88, 0, 0], Head: [10, 0, 0], ArmR: [-70, 0, -6], ArmL: [-70, 0, 6], ForearmR: [-8, 0, 0], ForearmL: [-8, 0, 0] }, { z: 0 }, { z: 0 })),\n  hold('Plank', { Pelvis: { r: [66, 0, 0], p: [0, -0.2, 0] }, Head: [-48, 0, 0], ArmR: [-63, 0, -5], ArmL: [-63, 0, 5], HandR: [-40, 0, 0], HandL: [-40, 0, 0], FootR: [55, 0, 0], FootL: [55, 0, 0] }),\n\n  // Scrubbed reps: keys built with placeFeet AND a feet track, or the sole dips through the floor mid-clip.\n  { name: 'SquatRep', frames: 30, grounded: true, keys: [[0, feet(squatTop, { z: 0 }, { z: 0 })], [30, feet(squatLow, { z: 0 }, { z: 0 })]], feet: [[0, { R: { z: 0 }, L: { z: 0 } }], [30, { R: { z: 0 }, L: { z: 0 } }]] },\n  { name: 'LungeRep', frames: 30, grounded: true, keys: [[0, feet(lungeTop, ...lungeGoalsR)], [30, feet(lungeLow, lungeGoalsLow.R, lungeGoalsLow.L)]], feet: [[0, { R: { z: 0 }, L: { z: 0 } }], [30, lungeGoalsLow]] },\n  { name: 'LungeRepL', frames: 30, grounded: true,\n    keys: [[0, feet(mirror(lungeTop, HERO_RIG), ...lungeGoalsR)], [30, placeFeet(mirror(lungeLow, HERO_RIG), HERO_RIG, { L: lungeGoalsLow.R, R: lungeGoalsLow.L })]],\n    feet: [[0, { R: { z: 0 }, L: { z: 0 } }], [30, { L: lungeGoalsLow.R, R: lungeGoalsLow.L }]] },\n  { name: 'Press', frames: 30, grounded: true, keys: [[0, feet(pressBottom, { z: 0 }, { z: 0 })], [30, feet(pressTop, { z: 0 }, { z: 0 })]], feet: [[0, { R: { z: 0 }, L: { z: 0 } }], [30, { R: { z: 0 }, L: { z: 0 } }]] },\n\n  { name: 'StepRest', frames: 60, loop: true, keys: [[0, stepRest], [60, stepRest]] },\n  { name: 'StepL', frames: 12, keys: [[0, stepRest], [4, stepUpPose('L'), 'outQuad'], [12, stepRest]] },\n  { name: 'StepR', frames: 12, keys: [[0, stepRest], [4, stepUpPose('R'), 'outQuad'], [12, stepRest]] },\n\n  { name: 'HeaderNod', frames: 12, fast: true, keys: [[0, nodBack], [4, nodHit, 'outQuad'], [12, stand()]] },\n  { name: 'Flail', frames: 16, loop: true, fast: true, keys: [[0, flailA], [8, flailB], [16, flailA]] },\n  { name: 'Daze', frames: 40, loop: true, keys: [[0, stand({ Torso: [4, 0, 6], Head: [14, 0, 14], ArmR: [8, 0, -18], ArmL: [8, 0, 18] })], [20, stand({ Torso: [4, 0, -6], Head: [14, 0, -14], ArmR: [8, 0, -18], ArmL: [8, 0, 18] })], [40, stand({ Torso: [4, 0, 6], Head: [14, 0, 14], ArmR: [8, 0, -18], ArmL: [8, 0, 18] })]] },\n  { name: 'Bow', frames: 44, keys: [[0, stand()], [16, stand({ Torso: [52, 0, 0], Head: [12, 0, 0], ArmR: [-8, 0, -6], ArmL: [-8, 0, 6] })], [30, stand({ Torso: [52, 0, 0], Head: [12, 0, 0], ArmR: [-8, 0, -6], ArmL: [-8, 0, 6] })], [44, stand()]] },\n  { name: 'SlowClap', frames: 36, loop: true, keys: [[0, clapOpen], [14, clapOpen], [18, clapShut, 'outQuad'], [20, clapShut], [36, clapOpen]] },\n  { name: 'Sneeze', frames: 26, fast: true, keys: [[0, stand()], [10, stand({ Torso: [-20, 0, 0], Head: [-34, 0, 0], ArmR: [-20, 0, -12], ArmL: [-20, 0, 12] })], [14, stand({ Torso: [38, 0, 0], Head: [30, 0, 0], ArmR: [-30, 0, -12], ArmL: [-30, 0, 12] }), 'outQuad'], [26, stand()]] },\n  hold('Point', stand({ Head: [0, 0, 0], ArmR: [-90, 0, -8], ForearmR: [-4, 0, 0], ArmL: [10, 0, 16], ForearmL: [-90, 0, 0] })),\n  hold('CoachStand', stand({ Torso: [0, 0, 0], ArmR: [0, 0, -9], ForearmR: [-6, 0, 0], ArmL: [0, 0, 9], ForearmL: [-6, 0, 0] })),\n  hold('Stretch', stand({ Torso: [0, 0, 22], Head: [0, 0, 10], ArmR: [-170, 0, 10], ForearmR: [-8, 0, 0], ArmL: [6, 0, 14] })),\n  hold('Watch', stand({ Head: [-4, 0, 0], ArmR: [10, 0, -22], ForearmR: [-100, 0, 0], ArmL: [10, 0, 22], ForearmL: [-100, 0, 0] })),\n  hold('TuckHold', feet(tuckCrouch, { z: 0.1 }, { z: -0.12 })),\n  hold('Cannonball', cannon),\n  hold('Fly', flyPose),\n  { name: 'PaddleUp', frames: 16, keys: [[0, stand({ ArmR: [-60, 0, -8], ForearmR: [-60, 0, 0] })], [8, stand({ ArmR: [-176, 0, -10], ForearmR: [-6, 0, 0] }), 'outQuad'], [16, stand({ ArmR: [-176, 0, -10], ForearmR: [-6, 0, 0] })]] },\n  { name: 'StepOn', frames: 24, keys: [[0, stand()], [10, placeFeet({ Pelvis: { p: [0, 0.14, 0] }, Torso: [10, 0, 0], ArmR: [-20, 0, -30], ArmL: [-20, 0, 30] }, HERO_RIG, { L: { z: 0 }, R: { z: 0.24, y: 0.36 } })], [24, stand()]] },\n  { name: 'HopDown', frames: 20, keys: [[0, stand()], [8, stand({ Pelvis: { p: [0, -0.2, 0] }, Torso: [18, 0, 0], ArmR: [20, 0, -20], ArmL: [20, 0, 20] })], [20, stand()]] },\n  { name: 'Slump', frames: 40, loop: true, keys: [[0, stand({ Torso: [22, 0, 0], Head: [20, 0, 0], ArmR: [-6, 0, -4], ArmL: [-6, 0, 4] })], [20, stand({ Torso: [26, 0, 0], Head: [24, 0, 0], ArmR: [-6, 0, -4], ArmL: [-6, 0, 4] })], [40, stand({ Torso: [22, 0, 0], Head: [20, 0, 0], ArmR: [-6, 0, -4], ArmL: [-6, 0, 4] })]] },\n  { name: 'ArmsOut', frames: 60, loop: true, keys: [[0, stand({ ArmR: [0, 0, -86], ArmL: [0, 0, 86] })], [30, stand({ ArmR: [0, 0, -78], ArmL: [0, 0, 94] })], [60, stand({ ArmR: [0, 0, -86], ArmL: [0, 0, 86] })]] },\n\n  gaitClip(HERO_RIG, { name: 'Jog', frames: 16, speed: 3, stance: 0.42, hip: -0.04, bob: 0.03, lift: 0.1, lean: 6, sway: 2, arms: { swing: 30, elbow: 75 } }),\n  gaitClip(HERO_RIG, { name: 'SlackWalk', frames: 28, speed: 1.1, stance: 0.62, hip: -0.05, bob: 0.015, lift: 0.08, lean: 3, sway: 5, tiptoe: 12, pose: { ArmR: [0, 0, -84], ArmL: [0, 0, 84] } }),\n  gaitClip(HERO_RIG, { name: 'TuckRun', frames: 12, speed: 8, stance: 0.34, hip: -0.22, bob: 0.03, lift: 0.14, lean: 34, arms: { swing: 42, elbow: 92 } }),\n];\n\nexport const ALL_CLIPS = [...HERO_CLIPS, ...GAME_CLIPS];\nexport const CLIP_NAMES = ALL_CLIPS.map((c) => c.name);\n/** Clips worth listing in the Dev Tools animation viewer. */\nexport const VIEWER_CLIPS = GAME_CLIPS.map((c) => c.name).concat(['Idle', 'Walk', 'Run', 'Sit', 'LieIdle', 'Wave', 'Victory', 'Teeter', 'Hurt', 'Fall', 'GetUp', 'Tiptoe', 'StepUp', 'StepDown']);\nEOF\ncat > .scratch/checkart.mjs <<'EOF'\nimport { checkModel, analyzeClip, compileClips, HERO_RIG, THREE, validateClip, validateTexture, Engine, HERO_MODEL, loadModel, setAssetReader } from '../pixel-engine.js';\nimport { GAME_MODELS, MODELS } from '../src/art/models.js';\nimport { GAME_CLIPS } from '../src/art/clips.js';\nimport { GAME_TEXTURES } from '../src/art/textures.js';\nlet bad=0;\nfor (const m of GAME_MODELS) { const r=checkModel(m,{catalog:MODELS}); if(r.problems.length||r.warnings.length){ console.log(m.id,'P:',r.problems.join(' | ').slice(0,300),'W:',r.warnings.join(' | ').slice(0,400)); if(r.problems.length)bad++; } }\nfor (const t of GAME_TEXTURES) { const r=validateTexture(t); if(r.problems.length||r.warnings.length) console.log(t.id,r); }\nclass G{name='g';assets=[HERO_MODEL];async setup(ctx){this.model=(await ctx.loadModel(HERO_MODEL)).scene;} cameraTarget(){return new THREE.Vector3();}}\nconst g=new G(); const e=await Engine.headless(g,{}); \nconst clips=compileClips(GAME_CLIPS,HERO_RIG,g.model);\nGAME_CLIPS.forEach((d,i)=>{ const v=validateClip(d,HERO_RIG); const a=analyzeClip(g.model,HERO_RIG,d,clips[i]); if(v.length||a.problems.length) {console.log('CLIP',d.name,'V:',v.join(';'),'P:',a.problems.join(';')); bad++;} else if(a.warnings.length) console.log('clipwarn',d.name,a.warnings.join(';').slice(0,200)); });\nconsole.log('bad',bad);\nprocess.exit(0);\nEOF\ntimeout 100 node .scratch/checkart.mjs </dev/null 2>&1 | cut -c1-900 | tail -50","description":"Write models, textures and clips, then run the engine's checks on them","timeout":130000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2501,"cache_read_input_tokens":234885,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2501},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"7290bcf9-dc21-4012-bf3e-49dde8961def","timestamp":"2026-11-05T06:24:34.574Z","request_id":"req_011CgjJJGxuBy93LNQ47uVgT","wire_tool_inputs":{"toolu_01WyRwZZycxSr3DHbKjW6RkZ":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/art/models.js <<'EOF'\n// Tare Island, as plain data: the landscape is exercise equipment at enormous scale.\nimport { model, MODEL_LIBRARY, ModelCatalog } from '../../pixel-engine.js';\n\nconst rad = (a) => (a * Math.PI) / 180;\n\nexport const ounce = model({\n  id: 'ounce', about: 'Ounce: a mint retro bathroom scale whose round dial is its face', tags: ['character'], size: [1.1, 1.05, 1.1],\n  palette: { body: 'cyan', base: 'teal', tread: 'sky', face: 'white', rim: 'slate', tick: 'mist', needle: 'red', eye: 'ink' },\n  parts: [\n    { name: 'base', box: [1.04, 0.08, 1.04], at: [0, 0.04, 0], c: 'base' },\n    { name: 'plate', box: [0.96, 0.2, 0.96], at: [0, 0.18, 0], c: 'body' },\n    { mirror: [{ name: 'tread', box: [0.3, 0.03, 0.42], at: [0.22, 0.295, -0.22], c: 'tread' }], axis: 'x' },\n    { group: [\n      { name: 'neck', box: [0.5, 0.42, 0.14], at: [0, 0.21, 0], c: 'body' },\n      { group: [\n        { name: 'rim', cyl: [0.78, 0.1, 0.78], at: [0, 0, 0], c: 'rim', seg: 14 },\n        { name: 'dial', cyl: [0.66, 0.04, 0.66], at: [0, 0.06, 0], c: 'face', seg: 14 },\n        ...[-60, -30, 0, 30, 60].map((a) => ({ box: [0.06, 0.03, 0.09], at: [Math.sin(rad(a)) * 0.26, 0.085, -Math.cos(rad(a)) * 0.26], rot: [0, -a, 0], c: 'tick' })),\n        { mirror: [{ name: 'eye', box: [0.08, 0.03, 0.11], at: [0.12, 0.09, -0.07], c: 'eye' }], axis: 'x' },\n        { group: [{ name: 'needleBar', box: [0.06, 0.03, 0.22], at: [0, 0, 0.1], c: 'needle' }, { name: 'hub', cyl: [0.07, 0.04, 0.07], at: [0, 0, 0], c: 'needle', seg: 8 }], name: 'needle', pivot: true, at: [0, 0.1, 0.1], rot: [0, 180, 0] },\n      ], name: 'face', pivot: true, at: [0, 0.5, 0.08], rot: [72, 0, 0] },\n    ], name: 'head', pivot: true, at: [0, 0.26, 0.2] },\n  ],\n});\n\nexport const kettlebellVolcano = model({\n  id: 'kettlebell-volcano', about: 'Kettlebell Volcano: a dormant, mostly, giant iron kettlebell with a glowing top', tags: ['scenery', 'landmark'],\n  palette: { iron: 'slate', dark: 'night', band: 'ink', lava: 'orange', hot: 'sand', rock: 'mist' },\n  parts: [\n    { name: 'skirt', cyl: [14, 1.2, 14], at: [0, 0.6, 0], top: 0.86, c: 'rock', seg: 12 },\n    { name: 'bell', ball: [12, 9, 12], at: [0, 5, 0], c: 'iron', seg: 14 },\n    { name: 'belt', cyl: [11.6, 0.5, 11.6], at: [0, 3.2, 0], c: 'band', seg: 14 },\n    { mirror: [{ name: 'lug', box: [1.4, 3.4, 1.4], at: [3.2, 9.8, 0], c: 'dark' }], axis: 'x' },\n    { name: 'handle', torus: [8.6, 1.3, 2.4], at: [0, 12, 0], rot: [90, 0, 0], c: 'dark', seg: 14 },\n    { name: 'crater', cyl: [4.2, 0.5, 4.2], at: [0, 9.3, 0], c: 'band', seg: 12 },\n    { name: 'lava', cyl: [3.4, 0.3, 3.4], at: [0, 9.56, 0], c: 'lava', glow: true, seg: 10 },\n    { name: 'hot', cyl: [1.6, 0.12, 1.6], at: [0, 9.74, 0], c: 'hot', glow: true, seg: 8 },\n  ],\n});\n\nexport const foamRollerHill = model({\n  id: 'foam-roller-hill', about: 'Foam Roller Hill: a huge ribbed foam roller lying on its side', tags: ['scenery', 'landmark'],\n  palette: { foam: 'sky', band: 'blue', end: 'navy', turf: 'green' },\n  parts: [\n    { name: 'turf', box: [12, 0.4, 7.2], at: [0, 0.2, 0], c: 'turf' },\n    { name: 'roller', cyl: [5, 10, 5], at: [0, 2.7, 0], rot: [0, 0, 90], c: 'foam', seg: 12 },\n    ...[-3.8, -1.9, 0, 1.9, 3.8].map((x) => ({ cyl: [5.3, 0.5, 5.3], at: [x, 2.7, 0], rot: [0, 0, 90], c: 'band', seg: 12 })),\n    { mirror: [{ name: 'cap', cyl: [3.2, 0.2, 3.2], at: [5.08, 2.7, 0], rot: [0, 0, 90], c: 'end', seg: 12 }], axis: 'x' },\n  ],\n});\n\nexport const dumbbellBridge = model({\n  id: 'dumbbell-bridge', about: 'The Dumbbell Bridge: a giant dumbbell laid over an inlet as a walkway', tags: ['scenery', 'landmark'],\n  palette: { plate: 'slate', steel: 'mist', deck: 'white', rim: 'ink' },\n  parts: [\n    { name: 'bar', cyl: [0.9, 9, 0.9], at: [0, 0.2, 0], rot: [0, 0, 90], c: 'steel', seg: 10 },\n    { name: 'deck', box: [8, 0.18, 2.4], at: [0, 0.74, 0], c: 'deck' },\n    { mirror: [\n      { name: 'plateBig', cyl: [4.4, 1.3, 4.4], at: [4.8, 1.6, 0], rot: [0, 0, 90], c: 'plate', seg: 12 },\n      { name: 'plateSmall', cyl: [3.2, 0.7, 3.2], at: [5.8, 1.6, 0], rot: [0, 0, 90], c: 'rim', seg: 12 },\n      { name: 'nut', cyl: [1.1, 0.4, 1.1], at: [6.3, 1.6, 0], rot: [0, 0, 90], c: 'steel', seg: 8 },\n    ], axis: 'x' },\n  ],\n});\n\nexport const medicineBall = model({\n  id: 'medicine-ball', about: 'A boulder-sized medicine ball with stitched seams', tags: ['scenery', 'prop'],\n  palette: { hide: 'red', seam: 'ink', patch: 'sand' },\n  parts: [\n    { name: 'ball', ball: [1.6, 1.6, 1.6], at: [0, 0.8, 0], c: 'hide', seg: 12 },\n    { name: 'seamA', cyl: [1.66, 0.08, 1.66], at: [0, 0.8, 0], c: 'seam', seg: 12 },\n    { name: 'seamB', cyl: [1.66, 0.08, 1.66], at: [0, 0.8, 0], rot: [90, 0, 0], c: 'seam', seg: 12 },\n    { name: 'patch', box: [0.42, 0.06, 0.42], at: [0, 1.61, 0], c: 'patch' },\n  ],\n});\n\n/** Columns and a cone roof; recolour the roof per station. */\nexport const pavilion = model({\n  id: 'pavilion', about: 'An open white pavilion: columns on a dais, a coloured cone roof', tags: ['building'],\n  palette: { stone: 'white', trim: 'mist', roof: 'sky', cap: 'white', step: 'mist' },\n  params: { w: [7, 4, 12] },\n  parts: (p) => [\n    { name: 'dais', cyl: [p.w, 0.3, p.w], at: [0, 0.15, 0], c: 'stone', seg: 12 },\n    { name: 'stepRing', cyl: [p.w + 0.8, 0.14, p.w + 0.8], at: [0, 0.07, 0], c: 'step', seg: 12 },\n    ...[0, 60, 120, 180, 240, 300].map((a) => ({ cyl: [0.42, 3, 0.42], at: [Math.sin(rad(a)) * (p.w / 2 - 0.5), 1.8, Math.cos(rad(a)) * (p.w / 2 - 0.5)], c: 'trim', seg: 8 })),\n    { name: 'ringBeam', cyl: [p.w + 0.1, 0.34, p.w + 0.1], at: [0, 3.46, 0], c: 'stone', seg: 12 },\n    { name: 'roof', cone: [p.w + 1.2, 2.2, p.w + 1.2], at: [0, 4.73, 0], c: 'roof', seg: 12 },\n    { name: 'finial', ball: [0.5, 0.5, 0.5], at: [0, 5.95, 0], c: 'cap' },\n  ],\n});\n\nexport const sweatJar = model({\n  id: 'sweat-jar', about: 'The Sweat Jar: a tall glass jar on a plinth with a lid and a label', tags: ['prop', 'landmark'],\n  palette: { glass: 'mist', plinth: 'white', trim: 'slate', lid: 'cyan', label: 'white', ink: 'ink' },\n  parts: [\n    { name: 'plinth', box: [2.5, 0.3, 2.5], at: [0, 0.15, 0], c: 'plinth' },\n    { name: 'plinthTrim', box: [2.2, 0.1, 2.2], at: [0, 0.35, 0], c: 'trim' },\n    { name: 'wall', lathe: [[0.85, 0], [0.95, 0.1], [0.95, 2.1], [0.75, 2.4], [0.75, 2.55]], at: [0, 0.3, 0], c: 'glass', seg: 12 },\n    { name: 'lid', cyl: [1.7, 0.22, 1.7], at: [0, 2.96, 0], c: 'lid', seg: 12 },\n    { name: 'knob', ball: [0.42, 0.34, 0.42], at: [0, 3.2, 0], c: 'trim' },\n    { name: 'label', box: [0.9, 0.5, 0.05], at: [0, 0.96, 0.95], c: 'label' },\n    { name: 'labelMark', box: [0.54, 0.09, 0.03], at: [0, 1.04, 0.99], c: 'ink' },\n  ],\n});\n\nexport const repShed = model({\n  id: 'rep-shed', about: 'The Rep Shed: a little corrugated gym shed with an orange roof', tags: ['building'],\n  palette: { wall: 'white', band: 'mist', roof: 'orange', door: 'night', sign: 'ink', eave: 'red' },\n  parts: [\n    { name: 'body', box: [6, 3, 4.6], at: [0, 1.5, 0], c: 'wall' },\n    ...[0.7, 1.5, 2.3].map((y) => ({ box: [6.04, 0.1, 4.64], at: [0, y, 0], c: 'band' })),\n    { name: 'roofL', box: [3.5, 0.26, 5.4], at: [-1.5, 3.72, 0], rot: [0, 0, 26], c: 'roof' },\n    { name: 'roofR', box: [3.5, 0.26, 5.4], at: [1.5, 3.72, 0], rot: [0, 0, -26], c: 'roof' },\n    { name: 'gable', box: [3.2, 0.82, 4.5], at: [0, 3.4, 0], c: 'wall' },\n    { name: 'door', box: [1.9, 2.3, 0.1], at: [0, 1.15, 2.33], c: 'door' },\n    { name: 'sign', box: [2.6, 0.5, 0.1], at: [0, 2.72, 2.34], c: 'sign' },\n    { name: 'eave', box: [6.1, 0.14, 0.14], at: [0, 3.02, 2.34], c: 'eave' },\n  ],\n});\n\nexport const beatStage = model({\n  id: 'beat-stage', about: 'Beat Stage: a low white stage on the sand with two big speakers', tags: ['building'],\n  palette: { deck: 'white', skirt: 'sky', cab: 'ink', cone: 'slate', dust: 'mist', truss: 'mist', lamp: 'sand' },\n  parts: [\n    { name: 'deck', box: [8, 0.5, 4.4], at: [0, 0.25, 0], c: 'deck' },\n    { name: 'skirt', box: [8.1, 0.2, 4.5], at: [0, 0.1, 0], c: 'skirt' },\n    { mirror: [\n      { name: 'cab', box: [1.2, 2.4, 1], at: [3.7, 1.7, -1.4], c: 'cab' },\n      { name: 'woofer', cyl: [0.82, 0.1, 0.82], at: [3.7, 1.26, -0.86], rot: [90, 0, 0], c: 'cone', seg: 10 },\n      { name: 'tweeter', cyl: [0.42, 0.1, 0.42], at: [3.7, 2.34, -0.86], rot: [90, 0, 0], c: 'dust', seg: 8 },\n      { name: 'post', box: [0.16, 3.6, 0.16], at: [4.3, 2.3, 2], c: 'truss' },\n    ], axis: 'x' },\n    { name: 'beam', box: [8.76, 0.2, 0.2], at: [0, 4.1, 2], c: 'truss' },\n    ...[-2.4, 0, 2.4].map((x) => ({ box: [0.4, 0.3, 0.4], at: [x, 3.85, 2], c: 'lamp', glow: true })),\n  ],\n});\n\nexport const pier = model({\n  id: 'pier', about: 'A wooden pier with white railings and a diving lip', tags: ['building'],\n  params: { len: [12, 4, 40] },\n  palette: { plank: 'sand', beam: 'orange', post: 'plum', rail: 'white' },\n  parts: (p) => [\n    { name: 'deck', box: [3.2, 0.2, p.len], at: [0, 1.5, 0], c: 'plank' },\n    ...Array.from({ length: Math.max(2, Math.floor(p.len / 3)) }, (_, i) => ({ box: [3.3, 0.12, 0.3], at: [0, 1.36, -p.len / 2 + (i + 0.5) * (p.len / Math.max(2, Math.floor(p.len / 3)))], c: 'beam' })),\n    ...Array.from({ length: Math.max(2, Math.floor(p.len / 4)) }, (_, i) => {\n      const z = -p.len / 2 + (i + 0.5) * (p.len / Math.max(2, Math.floor(p.len / 4)));\n      return { mirror: [{ cyl: [0.36, 2.6, 0.36], at: [1.4, 0.3, z], c: 'post', seg: 8 }, { box: [0.12, 1, 0.12], at: [1.5, 2.1, z], c: 'rail' }], axis: 'x' };\n    }),\n    { mirror: [{ box: [0.12, 0.12, p.len], at: [1.5, 2.56, 0], c: 'rail' }], axis: 'x' },\n  ],\n  floats: true,\n});\n\nexport const palm = model({\n  id: 'palm', about: 'A chunky palm tree: curved trunk, drooping fronds, coconuts', tags: ['scenery', 'plant'],\n  palette: { trunk: 'orange', ring: 'plum', frond: 'green', frond2: 'lime', nut: 'plum' },\n  parts: [\n    { name: 'trunk', tube: [[0, 0, 0], [0.12, 1.1, 0], [0.38, 2.2, 0], [0.78, 3.3, 0], [1.2, 4.1, 0]], r: [0.3, 0.17], at: [0, 0, 0], c: 'trunk', seg: 7 },\n    ...[[0.05, 0.6, 0.3], [0.25, 1.8, 0.28], [0.65, 2.9, 0.24]].map(([x, y, r]) => ({ cyl: [r * 2.3, 0.1, r * 2.3], at: [x, y, 0], c: 'ring', seg: 7 })),\n    ...[0, 60, 120, 180, 240, 300].map((a, i) => ({ group: [\n      { box: [0.7, 0.1, 2.0], at: [0, -0.14, 1.0], rot: [14, 0, 0], c: i % 2 ? 'frond' : 'frond2' },\n      { box: [0.44, 0.1, 1.1], at: [0, -0.68, 2.3], rot: [38, 0, 0], c: i % 2 ? 'frond' : 'frond2' },\n    ], at: [1.2, 4.2, 0], rot: [0, a, 0] })),\n    { 