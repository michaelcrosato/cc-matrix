{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjMbnGM1RXrZkbqfE164","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016FWtofB9FuPv8TfJ68A265","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [~] 4 Island and week: all scenes written (hub, weighin, report, jar, records, locker, ferry, ending, viewer); needs test + look\",\"- [~] 4 Island and week: scenes written; smoke OK; look check pending\")\ns=s.replace(\"- [~] 5 Other activities: all written (src/scenes/activity/*) incl longstand; bot tuning/tests next\",\"- [x] 5 Other activities: written and bot-tuned (src/scenes/activity/*) incl longstand\")\ns=s.replace(\"- [ ] 6 Medley, Family Hour, session card, ghosts\",\"- [x] 6 Medley, Family Hour, session card, ghosts: hub harness 4/4 + outside session pass (tests/browser/hub.mjs)\")\ns=s.replace(\"- [ ] 7 Attract, Dev tools, touch-only, Locker, Hall of Numbers\",\"- [~] 7 Attract, Dev tools, touch-only, Locker, Hall of Numbers: written, untested\")\ns+=\"\"\"\n## Next up\n- Write tests/headless/*.mjs and tests/browser/*.mjs per PLAN 18 (test runner tools/test.mjs exists). Helpers: tests/lib.mjs (Node), tests/browser/_lib.mjs, tests/lib-pure.mjs.\n- Then look at every screen at 1920x1080 via tools/shot.mjs (in page use `await go(id,args)`; `e.step`).\n- Then fill src/data/about.js feedback answers honestly, final build (writes html + exit-interview.json), remove .scratch .shots node_modules? keep package.json.\n- More bot-found tuning notes in run log below.\n- Run log: bot sweep caught Step palette crash, Tray bodies sleeping through gravity (all scores 0), reps unreachable 3 stars, hoop/header too generous, jog steering reversed.\n\"\"\"\nopen(p,'w').write(s)\nEOF\ncat > tests/headless/core.mjs <<'EOF'\n// 1 Dot, 2 clips, 3 data, 12 voice, 13 engine hash.\nimport { createHash } from 'node:crypto';\nimport { readFileSync } from 'node:fs';\nimport { analyzeClip, checkModel, compileClips, Engine, HERO_MODEL, HERO_RIG, parseSong, THREE, validateClip, validateTexture } from '../../pixel-engine.js';\nimport { assert, done, eq, test } from '../lib.mjs';\nimport { Dot } from '../../src/core/dot.js';\nimport { BotBrain, blankInput } from '../../src/core/drivers.js';\nimport { T } from '../../src/core/tunables.js';\nimport { GAME_CLIPS } from '../../src/art/clips.js';\nimport { GAME_MODELS, MODELS } from '../../src/art/models.js';\nimport { GAME_TEXTURES } from '../../src/art/textures.js';\nimport { SONGS, STEP_BPM, STEP_SONG } from '../../src/audio/songs.js';\nimport { syllabify, voiceLength, VOICES, revealAt } from '../../src/audio/voice.js';\nimport { GLYPH_NAMES } from '../../src/art/glyphs.js';\nimport { allLines } from '../../src/data/alllines.js';\nimport { ACTIVITIES, ACTIVITY_IDS, CLASSMATE_SCORES } from '../../src/data/activities.js';\nimport { POSES } from '../../src/data/poses.js';\nimport { REPS } from '../../src/data/reps.js';\nimport { STATIONS } from '../../src/data/stations.js';\nimport { DAYS } from '../../src/data/week.js';\nimport { MILESTONES } from '../../src/data/unlocks.js';\nimport { QUESTIONS } from '../../src/data/questions.js';\nimport { BOARDS } from '../../src/data/boards.js';\nimport { STEP_CHART, STEP_CHART_HARD, STEP_CHART_MEDLEY } from '../../src/data/charts.js';\nimport { RESULT_LINES } from '../../src/data/lines.js';\nimport { MEDLEY } from '../../src/data/medley.js';\nimport { hasGlyph, sanitize, wrap } from '../../src/ui/font.js';\nimport { AI_HUB, CREDITS, SOURCE_INFO, exitInterview } from '../../src/data/about.js';\nimport { TITLE } from '../../src/data/title.js';\n\nfunction rng(seed) { let a = seed >>> 0; return () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\nfunction ringTime(skill, ring = 0.3, seeds = 40) {\n  const dt = 1 / 60;\n  let total = 0;\n  for (let s = 0; s < seeds; s++) {\n    const r = rng(s * 97 + 11), d = new Dot(r), b = new BotBrain(skill, r), o = blankInput();\n    let inside = 0, n = 0;\n    for (let i = 0; i < 35 * 60; i++) {\n      b.lean(o, d, 0, 0, dt);\n      d.step(dt, o.x, o.y, T);\n      if (i >= 120) { n++; if (Math.hypot(d.x, d.y) <= ring) inside++; }\n    }\n    total += inside / n;\n  }\n  return (100 * total) / seeds;\n}\n\nawait test('dot: idle bot under 20% at ring .30', () => assert(ringTime('idle') < 20));\nawait test('dot: average bot 35-65% at ring .30', () => { const v = ringTime('average'); assert(v > 35 && v < 65, `${v}`); });\nawait test('dot: good bot over 80% at ring .30', () => assert(ringTime('good') > 80));\nawait test('dot: expert bot over 95% at ring .30', () => assert(ringTime('expert') > 95));\nawait test('dot: stays inside 1.2, impulses add to velocity', () => {\n  const d = new Dot(rng(1));\n  for (let i = 0; i < 600; i++) d.step(1 / 60, 1, 1, T);\n  assert(Math.hypot(d.x, d.y) <= 1.2001);\n  const v = d.vx;\n  d.impulse(0.5, 0);\n  assert(Math.abs(d.vx - v - 0.5) < 1e-9);\n});\n\nclass G { name = 'g'; assets = [HERO_MODEL]; async setup(ctx) { this.model = (await ctx.loadModel(HERO_MODEL)).scene; } cameraTarget() { return new THREE.Vector3(); } }\nconst g = new G();\nawait Engine.headless(g, {});\nconst compiled = compileClips(GAME_CLIPS, HERO_RIG, g.model);\nfor (let i = 0; i < GAME_CLIPS.length; i++) {\n  const d = GAME_CLIPS[i];\n  await test(`clip ${d.name}`, () => {\n    const v = validateClip(d, HERO_RIG);\n    assert(!v.length, v.join(';'));\n    const a = analyzeClip(g.model, HERO_RIG, d, compiled[i]);\n    assert(!a.problems.length, a.problems.join(';'));\n  });\n}\nfor (const m of GAME_MODELS) await test(`model ${m.id}`, () => { const r = checkModel(m, { catalog: MODELS }); assert(!r.problems.length, r.problems.join(';')); });\nfor (const t of GAME_TEXTURES) await test(`texture ${t.id}`, () => { const r = validateTexture(t); assert(!r.problems.length, r.problems.join(';')); });\nfor (const [name, song] of Object.entries(SONGS)) {\n  await test(`song ${name} parses`, () => { parseSong(song); });\n  await test(`song ${name} is loud enough at 10%`, () => {\n    const sum = Object.values(song.tracks).reduce((a, t) => a + (t.volume ?? 0.5), 0);\n    assert(sum * 0.1 * 0.8 >= 0.03, `level ${sum * 0.08}`);\n  });\n}\nawait test('step song is 104 BPM, 32 bars, and each bar is one chart line', () => {\n  eq(STEP_BPM, 104);\n  eq(STEP_SONG.order.length, 32);\n  eq(STEP_CHART.length, 32);\n  eq(STEP_CHART_HARD.length, 32);\n  eq(STEP_CHART_MEDLEY.length, 24);\n  for (const bar of [...STEP_CHART, ...STEP_CHART_HARD]) { eq(bar.length, 8, bar); assert(/^[LR.]{8}$/.test(bar), bar); }\n});\nawait test('every id resolves', () => {\n  for (const id of ACTIVITY_IDS) {\n    const a = ACTIVITIES[id];\n    assert(SONGS[a.song], `song ${a.song}`);\n    if (a.pose) assert(POSES[a.pose], `pose ${a.pose}`);\n    if (a.rep) assert(REPS[a.rep], `rep ${a.rep}`);\n    assert(STATIONS[a.station], `station ${a.station}`);\n    assert(CLASSMATE_SCORES[id], `scores ${id}`);\n    assert(RESULT_LINES[id], `lines ${id}`);\n  }\n  for (const s of Object.values(STATIONS)) for (const a of s.activities ?? []) assert(ACTIVITIES[a], `station activity ${a}`);\n  for (const e of MEDLEY.events) for (const o of e.options) assert(ACTIVITIES[o], `medley ${o}`);\n  eq(DAYS.length, 7); eq(QUESTIONS.length, 7); eq(MILESTONES.length, 7);\n  assert(BOARDS.length === 3);\n  assert(GLYPH_NAMES.includes('cross') && GLYPH_NAMES.includes('a'));\n});\nawait test('every activity has lines for 0-3 stars, first time and repeat', () => {\n  for (const id of ACTIVITY_IDS) for (const k of ['0', '1', '2', '3', 'first', 'repeat']) assert(RESULT_LINES[id][k]?.length, `${id} ${k}`);\n});\nawait test('the line bank has 120+ lines', () => assert(allLines().length >= 120, `${allLines().length}`));\nawait test('every line fits its box: 3 lines of 52 characters', () => {\n  for (const l of allLines()) assert(wrap(l.text, 52).length <= 3, `too long: ${l.text}`);\n});\nawait test('every character of every string has a glyph', () => {\n  const strings = [...allLines().map((l) => l.text), ...Object.values(ACTIVITIES).map((a) => a.name), ...Object.values(STATIONS).map((s) => s.name), ...MILESTONES.map((m) => m.name), ...Object.values(SOURCE_INFO), ...CREDITS, TITLE];\n  for (const s of strings) for (const ch of s) assert(hasGlyph(ch) || ch === '\\n', `no glyph for \"${ch}\" in: ${s}`);\n  eq(sanitize('Zoë ☃'), 'Zo? ?', 'sanitize');\n});\nawait test('no bad words in the plan\\'s forbidden list', () => {\n  const banned = /\\b(wii|mii|wuhu|balance board|fit age)\\b/i;\n  for (const l of allLines()) assert(!banned.test(l.text), l.text);\n  for (const a of Object.values(ACTIVITIES)) assert(!banned.test(a.name), a.name);\n  assert(!banned.test(TITLE));\n});\nawait test('exit interview has the exact shape', () => {\n  const e = exitInterview();\n  for (const k of ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage']) assert(typeof e.sourceInformation[k] === 'string' && e.sourceInformation[k].length, k);\n  eq(e.sourceInformation.usage, 'added on import');\n  eq(e.testingFeedback.length, 4); eq(e.engineFeedback.length, 6); eq(e.promptFeedback.length, 4);\n  for (const k of ['name', 'tagline', 'description', 'type', 'genre', 'source', 'series', 'players', 'controls']) assert(typeof AI_HUB[k] === 'string' && AI_HUB[k].length, k);\n  assert(AI_HUB.tags.length >= 3 && AI_HUB.tags.length <= 6);\n  eq(AI_HUB.name, TITLE);\n});\n\nawait test('voice: syllabify is stable and the same word gives the same syllables', () => {\n  const a = syllabify('Thank you. Thank you.', 'ounce').filter((s) => !s.tick);\n  const b = syllabify('Thank you. Thank you.', 'ounce').filter((s) => !s.tick);\n  eq(JSON.stringify(a), JSON.stringify(b));\n  eq(a[0].vowel, a[2].vowel, 'same word');\n  eq(a[0].cons, a[2].cons, 'same word');\n});\nawait test('voice: a question rises; declination falls', () => {\n  const q = syllabify('Is that close to anything at all?', 'ounce').filter((s) => !s.tick);\n  const flat = syllabify('Is that close to anything at all.', 'ounce').filter((s) => !s.tick);\n  assert(q[q.length - 1].f0 > flat[flat.length - 1].f0 * 1.1, 'rises');\n  assert(flat[0].f0 > flat[flat.length - 1].f0 * 0.98, 'falls');\n});\nawait test('voice: June has no contour, Coach is low and slow, Ounce high and quick', () => {\n  const june = syllabify('Are you nearly done?', 'june').filter((s) => !s.tick);\n  assert(new Set(june.map((s) => s.f0.toFixed(2))).size === 1, 'june flat');\n  const coach = syllabify('You are a tree.', 'coach'), ounce = syllabify('You are a tree.', 'ounce');\n  assert(coach[0].f0 < ounce[0].f0);\n  assert(voiceLength(coach) > voiceLength(ounce));\n  eq(syllabify('Squawk.', 'kevin').length, 0, 'kevin never speaks');\n  assert(Object.keys(VOICES).length >= 6);\n});\nawait test('voice: the typewriter reveals in step, and ends with the whole line', () => {\n  const text = 'Thank you. I have written that down.';\n  const syl = syllabify(text, 'ounce');\n  const end = voiceLength(syl);\n  assert(revealAt(syl, text, end * 0.3) < revealAt(syl, text, end * 0.8));\n  assert(revealAt(syl, text, end + 0.2) >= text.length - 2);\n});\nawait test('engine untouched: pixel-engine.js hash equals the kit\\'s', () => {\n  const want = readFileSync('vendor/pixel-engine.sha256', 'utf8').split(/\\s+/)[0];\n  eq(createHash('sha256').update(readFileSync('pixel-engine.js')).digest('hex'), want);\n});\nawait test('hub client untouched and first in the build', () => {\n  const html = readFileSync('tools/build.mjs', 'utf8');\n  assert(html.includes('vendor/hub/session.js'));\n  assert(readFileSync('vendor/hub/session.js', 'utf8').length > 5000);\n});\ndone();\nEOF\ncat > tests/headless/activities.mjs <<'EOF'\n// 4 Every activity: idle 0 stars, expert 2+, sloppy under expert, result written, Drips correct. 10 Determinism.\nimport { assert, boot, done, eq, makeScene, test, App } from '../lib.mjs';\nimport { ACTIVITIES, ACTIVITY_IDS } from '../../src/data/activities.js';\nimport { dripsFor } from '../../src/core/week.js';\nimport { BOARDS } from '../../src/data/boards.js';\n\nconst h = await boot({ scene: 'title' });\nconst EASY = new Set(['tree', 'heron', 'squats', 'lunges', 'hoop', 'step', 'header']);\n\nasync function play(id, skill, extra = {}) {\n  await h.go('activity', { id, mode: 'dropin', noPractice: true, ...extra });\n  App.dev.autopilot = skill;\n  await h.until(() => App.scene.resultsShown, { what: `${id} ${skill}`, max: 60 * 200, every: 60 });\n  App.dev.autopilot = null;\n  return App.scene.lastResult;\n}\n\nfor (const id of ACTIVITY_IDS) {\n  const scores = {};\n  await test(`${id}: idle bot finishes with 0 stars and no error`, async () => {\n    const r = await play(id, 'idle');\n    eq(r.stars, 0, `stars (score ${r.score})`);\n    eq(h.errors().length, 0, h.errors().join(';'));\n  });\n  await test(`${id}: expert bot gets ${EASY.has(id) ? '3' : '2+'} stars`, async () => {\n    const r = await play(id, 'expert');\n    scores.expert = r.score;\n    assert(r.stars >= (EASY.has(id) ? 3 : 2), `stars ${r.stars} score ${r.score}`);\n  });\n  await test(`${id}: sloppy bot scores under expert`, async () => {\n    const r = await play(id, 'sloppy');\n    assert(r.score < scores.expert, `sloppy ${r.score} expert ${scores.expert}`);\n    assert(r.stars <= 2, `sloppy stars ${r.stars}`);\n  });\n}\nfor (let board = 0; board < BOARDS.length; board++) {\n  await test(`tray board ${board}: expert 2+ stars, idle none`, async () => {\n    const r = await play('tray', 'expert', { board });\n    assert(r.stars >= 2, `stars ${r.stars} score ${r.score}/${r.max}`);\n    eq((await play('tray', 'idle', { board })).stars, 0);\n  });\n}\n\nawait test('result written in Drop-In: records only, no Drips', async () => {\n  const before = JSON.stringify(App.store.data.dropin?.tree ?? null);\n  const r = await play('tree', 'expert');\n  assert(JSON.stringify(App.store.data.dropin.tree) !== before);\n  eq(r.drips, 0);\n  eq(App.slot, null, 'no guest needed');\n});\nawait test('week mode: result written and Drips are 2 + 3 stars + time, plus the goal', async () => {\n  App.store.create(0, 'Test', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  const slot = App.slot;\n  slot.phase = 'day';\n  await h.go('activity', { id: 'squats', mode: 'week', noPractice: true });\n  App.dev.autopilot = 'expert';\n  await h.until(() => App.scene.resultsShown, { max: 60 * 100 });\n  App.dev.autopilot = null;\n  const r = App.scene.lastResult;\n  eq(slot.records.squats.plays, 1);\n  eq(slot.records.squats.stars, r.stars);\n  eq(slot.drips, dripsFor(r.stars, r.seconds) + (r.bonus ?? 0));\n  assert(slot.drips >= 2 + 3 * r.stars);\n});\nawait test('hard versions make it harder', async () => {\n  const a = await play('heron', 'average');\n  const b = await play('heron', 'average', { hard: true });\n  assert(b.score <= a.score + 6, `${b.score} vs ${a.score}`);\n});\nawait test('a first time gets 8 s of practice, unscored, then a count', async () => {\n  App.practised = {};\n  delete App.store.data.dropin.heron;\n  await h.go('activity', { id: 'heron', mode: 'dropin' });\n  const s = App.scene;\n  eq(s.phase, 'intro');\n  h.press('Enter');\n  eq(s.phase, 'practice');\n  h.step(60 * 8 + 2);\n  eq(s.phase, 'countdown');\n  h.step(60 * 3 + 2);\n  eq(s.phase, 'play');\n  eq(s.event.scoreOf(s.playerLane) < 5, true, 'score starts clean');\n});\n\n// 10 Determinism: record, replay, fingerprints equal.\nfor (const id of ['tree', 'hoop', 'step', 'header', 'tray', 'slackline', 'pier']) {\n  await test(`determinism: ${id} replays to the same fingerprint`, async () => {\n    await h.go('activity', { id, mode: 'dropin', noPractice: true });\n    const engine = h.engine;\n    h.press('Enter');\n    App.dev.autopilot = null;\n    const keys = ['KeyD', 'KeyA', 'KeyW', 'KeyS', 'KeyF', 'KeyJ', 'Space'];\n    for (let i = 0; i < 40; i++) {\n      const k = keys[i % keys.length];\n      engine.input.setKey(k, true); engine.step(6); engine.input.setKey(k, false); engine.step(4);\n    }\n    const rec = engine.recording();\n    const end = engine.fingerprint();\n    await engine.replay(rec, () => engine.loadGame(makeScene('activity', { id, mode: 'dropin', noPractice: true })));\n    eq(engine.fingerprint(), end, `${id}`);\n    engine.manual = true;\n  });\n}\ndone();\nEOF\ncat > tests/headless/week.mjs <<'EOF'\n// 5 The full scripted playthrough through the real menus. 6 Save. Weigh-In and Wobble Age.\nimport { assert, boot, done, eq, MemoryStorage, near, test, App, tick } from '../lib.mjs';\nimport { ACTIVITIES, HARD_DAY } from '../../src/data/activities.js';\nimport { goalMet, isOpen, totalStarsOf, ageFromTests, shownAge } from '../../src/core/week.js';\nimport { MILESTONES } from '../../src/data/unlocks.js';\nimport { AGE_OFFSET, DAYS } from '../../src/data/week.js';\nimport { Store, SAVE_KEY } from '../../src/core/save.js';\n\nconst storage = new MemoryStorage();\nconst h = await boot({ scene: 'title', storage });\nconst { engine } = h;\n\n/** Move the top menu to an item and press Enter, through real key presses. */\nfunction pick(id, screen = App.stack.top) {\n  const menu = screen.menu;\n  const i = menu.items.findIndex((it) => it.id === id);\n  assert(i >= 0, `no item ${id} in ${App.stack.names().join('>')}: ${menu.items.map((x) => x.id).join(',')}`);\n  let guard = 0;\n  while (menu.focus !== i && guard++ < 30) { h.press('ArrowDown'); h.step(1); }\n  eq(menu.focus, i, `focus on ${id}`);\n  h.press('Enter');\n  h.step(1);\n}\n\nasync function settle() { await tick(); await h.settle(); }\n\n/** Press through dialogue, questions and the like until a test passes. */\nasync function drive(pred, { max = 60 * 400, what = '' } = {}) {\n  let n = 0;\n  while (!pred()) {\n    const top = App.stack.top;\n    if (top?.name === 'dialogue' || top?.name === 'question' || top?.name === 'feel') h.press('Enter');\n    else if (App.scene.id === 'ferry') h.press('Enter');\n    else h.step(10);\n    await tick();\n    n += 10;\n    if (App.loading) await settle();\n    if (n > max) throw new Error(`drive timed out (${what}): ${JSON.stringify(App.state())}`);\n  }\n  if (App.loading) await settle();\n}\n\nasync function doActivity(station, id, { hard = false, skill = 'expert' } = {}) {\n  await drive(() => App.scene.id === 'hub' && !App.stack.open, { what: 'back at hub' });\n  assert(App.scene.stand(station) === station, `standing at ${station}: near ${App.scene.nearest}`);\n  h.step(2);\n  h.press('Enter');\n  eq(App.stack.top?.name, 'station', `station menu for ${station}`);\n  if (hard) { pick('hard'); }\n  pick(id);\n  await settle();\n  eq(App.scene.id, 'activity', `activity ${id}`);\n  eq(App.scene.activity, id);\n  App.dev.autopilot = skill;\n  await h.until(() => App.scene.resultsShown, { max: 60 * 200, every: 30, what: id });\n  App.dev.autopilot = null;\n  const r = App.scene.lastResult;\n  h.step(60 * 2);\n  await drive(() => App.stack.top?.name === 'results' && App.stack.top.menuReady, { what: 'results menu' });\n  pick('back');\n  await settle();\n  eq(App.scene.id, 'hub');\n  return r;\n}\n\nasync function morning(day) {\n  App.dev.autopilot = 'good';\n  await drive(() => App.scene.id === 'hub', { what: `morning of day ${day}` });\n  App.dev.autopilot = null;\n  await drive(() => !App.stack.open, { what: 'story beat' });\n  eq(App.slot.day, day, 'day');\n  eq(App.slot.phase, 'day');\n}\n\nasync function endDay(day) {\n  await drive(() => App.scene.id === 'hub' && !App.stack.open);\n  App.scene.stand('hammock');\n  h.step(2);\n  h.press('Enter');\n  await drive(() => App.scene.id === 'report', { what: `report of day ${day}` });\n  eq(App.slot.phase, 'report');\n  h.step(30);\n  h.press('Enter'); // into the talk\n  await drive(() => App.scene.phase === 'done' || App.scene.id !== 'report', { what: 'report talk' });\n  h.step(2);\n  h.press('Enter'); // good night\n  await drive(() => App.scene.id === 'weighin', { what: 'next morning' });\n}\n\nawait test('title: any button opens the main menu', async () => {\n  h.step(5);\n  eq(App.state().scene, 'title');\n  h.press('Enter');\n  eq(App.stack.top?.name, 'main');\n});\nawait test('new week: slot, name entry, avatar, ferry', async () => {\n  pick('week');\n  eq(App.stack.top?.name, 'slots');\n  pick('slot0');\n  eq(App.stack.top?.name, 'name-entry');\n  App.stack.top.typed = 'K'; h.step(1); App.stack.top.typed = 'i'; h.step(1); App.stack.top.typed = 'm'; h.step(1);\n  eq(App.stack.top.text, 'Kim');\n  h.press('Enter');\n  eq(App.stack.top?.name, 'avatar-pick');\n  pick('look2');\n  await settle();\n  eq(App.scene.id, 'ferry');\n  eq(App.slot.name, 'Kim');\n  eq(App.slot.phase, 'ferry');\n});\nawait test('ferry: skips or plays through to the first Weigh-In', async () => {\n  h.step(60 * 2);\n  h.press('Enter');\n  await drive(() => App.scene.id === 'weighin', { what: 'ferry end' });\n  eq(App.slot.phase, 'morning');\n});\nawait test('day 1: intro teaches the Dot, then a test, a question, an age; the age question is never saved', async () => {\n  await drive(() => App.stack.top?.name === 'dialogue' || App.scene.phase === 'test');\n  App.dev.autopilot = 'good';\n  await drive(() => App.stack.top?.name === 'feel', { what: 'feel question' });\n  App.stack.top.value = 77;\n  h.press('Enter');\n  await morning(1);\n  eq(App.slot.ages.length, 1);\n  assert(!JSON.stringify(App.store.data).includes('\"feel\"'), 'feel not saved');\n});\n\nconst SCHEDULE = [\n  { day: 1, plays: [['pavilion', 'tree'], ['shed', 'squats'], ['beach', 'hoop'], ['pavilion', 'heron']], open: ['tree', 'heron', 'squats', 'hoop'], closed: ['header', 'lunges', 'warrior', 'step', 'tray', 'jog', 'stand'] },\n  { day: 2, plays: [['lagoon', 'header'], ['shed', 'lunges'], ['pavilion', 'warrior']], open: ['header', 'lunges', 'warrior'], closed: ['step', 'slackline', 'chair', 'tray'] },\n  { day: 3, plays: [['beach', 'step'], ['lagoon', 'slackline'], ['pavilion', 'chair']], open: ['step', 'slackline', 'chair'], closed: ['tray', 'press', 'fold', 'jog'] },\n  { day: 4, plays: [['lagoon', 'tray'], ['shed', 'press'], ['pavilion', 'fold']], open: ['tray', 'press', 'fold'], closed: ['jog', 'pier', 'plank'] },\n  { day: 5, plays: [['gate', 'jog'], ['lagoon', 'pier'], ['pavilion', 'plank']], open: ['jog', 'pier', 'plank'], closed: ['stand'] },\n  { day: 6, plays: [['pavilion', 'tree', true]], open: ['tree'], closed: ['stand'] },\n];\n\nfor (const d of SCHEDULE) {\n  await test(`day ${d.day}: the schedule opens what it should, and nothing else`, async () => {\n    if (d.day > 1) await morning(d.day);\n    const slot = App.slot;\n    eq(slot.day, d.day);\n    for (const id of d.open) assert(isOpen(slot, id), `${id} should be open on day ${d.day}`);\n    for (const id of d.closed) assert(!isOpen(slot, id), `${id} should be closed on day ${d.day}`);\n    eq(DAYS[d.day - 1].day, d.day);\n    if (d.day >= 2) eq(slot.heardBeat, d.day, 'story beat heard');\n  });\n  await test(`day ${d.day}: stations, the prescription pays +5, and the record is kept`, async () => {\n    const before = App.slot.drips;\n    let any = false;\n    for (const [station, id, hard] of d.plays) {\n      const r = await doActivity(station, id, { hard: !!hard });\n      assert(App.slot.records[id].plays >= 1, `${id} recorded`);\n      any = true;\n      assert(r.stars >= 2, `${id} stars ${r.stars}`);\n    }\n    assert(any);\n    assert(goalMet(App.slot), `goal of day ${d.day}: ${JSON.stringify(App.slot.todayDone)}`);\n    assert(App.slot.goalPaid, 'bonus paid');\n    assert(App.slot.drips > before + 5);\n  });\n  await test(`day ${d.day}: the hammock ends the day; the Report leads to morning`, async () => { await endDay(d.day); eq(App.slot.day, d.day + 1); });\n}\n\nawait test('hard versions are open on day 6, not before', () => {\n  eq(HARD_DAY, 6);\n});\n\nawait test('the jar, the locker and the hall all open and come back', async () => {\n  App.dev.autopilot = 'good';\n  await morning(7);\n  for (const [station, scene] of [['jar', 'jar'], ['locker', 'locker'], ['hall', 'records']]) {\n    App.scene.stand(station);\n    h.step(2);\n    h.press('Enter');\n    await settle();\n    eq(App.scene.id, scene);\n    h.step(120);\n    h.press('Escape');\n    await settle();\n    eq(App.scene.id, 'hub');\n  }\n});\nawait test('jar milestones arrive in order, each with a Locker Room item', () => {\n  const slot = App.slot;\n  const expect = MILESTONES.filter((m) => m.drips <= slot.drips).map((m) => m.id);\n  eq(slot.wardrobe.join(), expect.join());\n  assert(slot.wardrobe.length >= 4, `only ${slot.wardrobe.length} by day 7 with ${slot.drips} drips`);\n});\n\nlet shownBefore;\nawait test('day 7: the hammock refuses; the terrace stands; the Long Stand plays; no way to fail', async () => {\n  App.scene.stand('hammock');\n  h.step(2);\n  h.press('Enter');\n  eq(App.stack.top?.name, 'dialogue', 'hammock says not today');\n  await drive(() => !App.stack.open);\n  eq(App.scene.id, 'hub');\n  App.scene.stand('terrace');\n  h.step(2);\n  h.press('Enter');\n  await settle();\n  eq(App.scene.activity, 'stand');\n  shownBefore = App.slot.ages.map((a) => shownAge(App.slot, a));\n  App.dev.autopilot = 'good';\n  h.step(60 * 1);\n  await h.until(() => App.scene.resultsShown, { max: 60 * 120, every: 30 });\n  App.dev.autopilot = null;\n  assert(goalMet(App.slot), 'stand fills the prescription');\n  eq(App.slot.confessed, false);\n  h.step(60 * 2);\n  await drive(() => App.stack.top?.name === 'results' && App.stack.top.menuReady);\n  pick('continue');\n  await settle();\n  eq(App.scene.id, 'ending');\n});\nawait test('the confession subtracts exactly 7 from every point', async () => {\n  await drive(() => App.scene.phase === 'slide', { what: 'slide' });\n  eq(App.slot.confessed, true);\n  const after = App.slot.ages.map((a) => shownAge(App.slot, a));\n  after.forEach((v, i) => eq(shownBefore[i] - v, AGE_OFFSET, `point ${i}`));\n  h.step(60 * 3);\n  near(App.scene.slide, AGE_OFFSET, 0.01, 'chart slide');\n});\nawait test('credits roll, then Week 2 opens everything', async () => {\n  await drive(() => App.scene.phase === 'credits', { what: 'credits' });\n  h.step(60 * 3);\n  h.press('Enter');\n  await drive(() => App.scene.id === 'weighin', { what: 'week 2 morning' });\n  eq(App.slot.week, 2);\n  eq(App.slot.day, 1);\n  for (const id of Object.keys(ACTIVITIES)) assert(isOpen(App.slot, id), `${id} open in week 2`);\n  App.dev.autopilot = 'good';\n  await morning(1);\n  await drive(() => !App.stack.open);\n  eq(App.scene.id, 'hub');\n  eq(h.errors().length, 0, h.errors().join(' | '));\n});\nawait test('Week 2 goes on: days keep turning over, ages stay honest', async () => {\n  const slot = App.slot;\n  const r = await doActivity('pavilion', 'tree');\n  assert(r.stars >= 2);\n  await endDay(1);\n  eq(slot.day, 2);\n  const a = slot.ages.length;\n  App.dev.autopilot = 'good';\n  await morning(2);\n  eq(slot.ages.length, a + 1);\n  eq(shownAge(slot, slot.ages[a]), slot.ages[a], 'no more adding seven');\n});\n\n// 6 Save.\nawait test('save: reload mid-week restores', () => {\n  const again = new Store(storage);\n  eq(again.data.slots[0].name, 'Kim');\n  eq(again.data.slots[0].week, App.slot.week);\n  eq(again.data.slots[0].drips, App.slot.drips);\n  assert(storage.getItem(SAVE_KEY).length > 10);\n});\nawait test('save: corrupt JSON falls back safely', () => {\n  const s = new MemoryStorage();\n  s.setItem(SAVE_KEY, '{not json');\n  const st = new Store(s);\n  eq(st.recovered, true);\n  eq(st.data.slots[0], null);\n  eq(st.settings.music, 0.1);\n  st.create(1, 'B', {});\n  assert(new Store(s).data.slots[1]);\n});\nawait test('save: a wrong version falls back safely', () => {\n  const s = new MemoryStorage();\n  s.setItem(SAVE_KEY, JSON.stringify({ v: 99, slots: 'nope' }));\n  eq(new Store(s).data.slots.length, 3);\n});\nawait test('save: no storage works, in memory', () => {\n  const broken = { getItem() { throw new Error('denied'); }, setItem() { throw new Error('denied'); } };\n  const st = new Store(broken);\n  st.create(0, 'M', {});\n  eq(st.slot.name, 'M');\n  st.write();\n  eq(JSON.parse(st.memory).slots[0].name, 'M');\n});\n\n// The numbers.\nawait test('Wobble Age: expert ends lower than average; idle stays high; clamped 18..95', async () => {\n  const ages = {};\n  for (const skill of ['idle', 'average', 'expert']) {\n    const slot = App.store.create(2, skill, { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n    slot.phase = 'morning';\n    slot.introHeard = true;\n    for (const test2 of ['stillness', 'lean', 'chase']) {\n      await h.go('weighin', { test: test2 });\n      App.dev.autopilot = skill;\n      await drive(() => App.scene.id === 'weighin' && App.scene.result !== undefined, { what: `${skill} ${test2}` });\n      await drive(() => App.scene.id !== 'weighin', { what: 'leave' });\n      await settle();\n      App.dev.autopilot = null;\n    }\n    ages[skill] = slot.ages[slot.ages.length - 1];\n  }\n  assert(ages.expert < ages.average, `expert ${ages.expert} average ${ages.average}`);\n  assert(ages.average < ages.idle, `average ${ages.average} idle ${ages.idle}`);\n  assert(ages.idle >= 70, `idle ${ages.idle}`);\n  eq(ageFromTests([0, 0, 0], 0), 80);\n  eq(ageFromTests([1, 1, 1], 200), 18);\n  eq(totalStarsOf({ records: { a: { stars: 2 }, b: { stars: 3 } } }), 5);\n});\nawait test('Week: a test of T = 0.5 with no stars is an age of 50, shown as 57', () => {\n  eq(ageFromTests([0.5], 0), 50);\n  eq(shownAge({ confessed: false }, 50), 57);\n  eq(shownAge({ confessed: true }, 50), 50);\n});\nawait test('no game errors anywhere in the week', () => eq(h.errors().length, 0, h.errors().join(' | ')));\ndone();\nEOF\ntimeout 300 node tools/test.mjs --fast core activities </dev/null 2>&1 | tail -30 | cut -c1-420","description":"Write core, activity and week tests and run the first two","timeout":310000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5090,"cache_read_input_tokens":546808,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5090},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"5a66d600-72c8-4913-bb65-b9b8e6077e1e","timestamp":"2026-11-05T07:06:58.056Z","request_id":"req_011CgjMbmvzWVKgjGoMg6mXu","wire_tool_inputs":{"toolu_016FWtofB9FuPv8TfJ68A265":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [~] 4 Island and week: all scenes written (hub, weighin, report, jar, records, locker, ferry, ending, viewer); needs test + look\",\"- [~] 4 Island and week: scenes written; smoke OK; look check pending\")\ns=s.replace(\"- [~] 5 Other activities: all written (src/scenes/activity/*) incl longstand; bot tuning/tests next\",\"- [x] 5 Other activities: written and bot-tuned (src/scenes/activity/*) incl longstand\")\ns=s.replace(\"- [ ] 6 Medley, Family Hour, session card, ghosts\",\"- [x] 6 Medley, Family Hour, session card, ghosts: hub harness 4/4 + outside session pass (tests/browser/hub.mjs)\")\ns=s.replace(\"- [ ] 7 Attract, Dev tools, touch-only, Locker, Hall of Numbers\",\"- [~] 7 Attract, Dev tools, touch-only, Locker, Hall of Numbers: written, untested\")\ns+=\"\"\"\n## Next up\n- Write tests/headless/*.mjs and tests/browser/*.mjs per PLAN 18 (test runner tools/test.mjs exists). Helpers: tests/lib.mjs (Node), tests/browser/_lib.mjs, tests/lib-pure.mjs.\n- Then look at every screen at 1920x1080 via tools/shot.mjs (in page use `await go(id,args)`; `e.step`).\n- Then fill src/data/about.js feedback answers honestly, final build (writes html + exit-interview.json), remove .scratch .shots node_modules? keep package.json.\n- More bot-found tuning notes in run log below.\n- Run log: bot sweep caught Step palette crash, Tray bodies sleeping through gravity (all scores 0), reps unreachable 3 stars, hoop/header too generous, jog steering reversed.\n\"\"\"\nopen(p,'w').write(s)\nEOF\ncat > tests/headless/core.mjs <<'EOF'\n// 1 Dot, 2 clips, 3 data, 12 voice, 13 engine hash.\nimport { createHash } from 'node:crypto';\nimport { readFileSync } from 'node:fs';\nimport { analyzeClip, checkModel, compileClips, Engine, HERO_MODEL, HERO_RIG, parseSong, THREE, validateClip, validateTexture } from '../../pixel-engine.js';\nimport { assert, done, eq, test } from '../lib.mjs';\nimport { Dot } from '../../src/core/dot.js';\nimport { BotBrain, blankInput } from '../../src/core/drivers.js';\nimport { T } from '../../src/core/tunables.js';\nimport { GAME_CLIPS } from '../../src/art/clips.js';\nimport { GAME_MODELS, MODELS } from '../../src/art/models.js';\nimport { GAME_TEXTURES } from '../../src/art/textures.js';\nimport { SONGS, STEP_BPM, STEP_SONG } from '../../src/audio/songs.js';\nimport { syllabify, voiceLength, VOICES, revealAt } from '../../src/audio/voice.js';\nimport { GLYPH_NAMES } from '../../src/art/glyphs.js';\nimport { allLines } from '../../src/data/alllines.js';\nimport { ACTIVITIES, ACTIVITY_IDS, CLASSMATE_SCORES } from '../../src/data/activities.js';\nimport { POSES } from '../../src/data/poses.js';\nimport { REPS } from '../../src/data/reps.js';\nimport { STATIONS } from '../../src/data/stations.js';\nimport { DAYS } from '../../src/data/week.js';\nimport { MILESTONES } from '../../src/data/unlocks.js';\nimport { QUESTIONS } from '../../src/data/questions.js';\nimport { BOARDS } from '../../src/data/boards.js';\nimport { STEP_CHART, STEP_CHART_HARD, STEP_CHART_MEDLEY } from '../../src/data/charts.js';\nimport { RESULT_LINES } from '../../src/data/lines.js';\nimport { MEDLEY } from '../../src/data/medley.js';\nimport { hasGlyph, sanitize, wrap } from '../../src/ui/font.js';\nimport { AI_HUB, CREDITS, SOURCE_INFO, exitInterview } from '../../src/data/about.js';\nimport { TITLE } from '../../src/data/title.js';\n\nfunction rng(seed) { let a = seed >>> 0; return () => { a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\nfunction ringTime(skill, ring = 0.3, seeds = 40) {\n  const dt = 1 / 60;\n  let total = 0;\n  for (let s = 0; s < seeds; s++) {\n    const r = rng(s * 97 + 11), d = new Dot(r), b = new BotBrain(skill, r), o = blankInput();\n    let inside = 0, n = 0;\n    for (let i = 0; i < 35 * 60; i++) {\n      b.lean(o, d, 0, 0, dt);\n      d.step(dt, o.x, o.y, T);\n      if (i >= 120) { n++; if (Math.hypot(d.x, d.y) <= ring) inside++; }\n    }\n    total += inside / n;\n  }\n  return (100 * total) / seeds;\n}\n\nawait test('dot: idle bot under 20% at ring .30', () => assert(ringTime('idle') < 20));\nawait test('dot: average bot 35-65% at ring .30', () => { const v = ringTime('average'); assert(v > 35 && v < 65, `${v}`); });\nawait test('dot: good bot over 80% at ring .30', () => assert(ringTime('good') > 80));\nawait test('dot: expert bot over 95% at ring .30', () => assert(ringTime('expert') > 95));\nawait test('dot: stays inside 1.2, impulses add to velocity', () => {\n  const d = new Dot(rng(1));\n  for (let i = 0; i < 600; i++) d.step(1 / 60, 1, 1, T);\n  assert(Math.hypot(d.x, d.y) <= 1.2001);\n  const v = d.vx;\n  d.impulse(0.5, 0);\n  assert(Math.abs(d.vx - v - 0.5) < 1e-9);\n});\n\nclass G { name = 'g'; assets = [HERO_MODEL]; async setup(ctx) { this.model = (await ctx.loadModel(HERO_MODEL)).scene; } cameraTarget() { return new THREE.Vector3(); } }\nconst g = new G();\nawait Engine.headless(g, {});\nconst compiled = compileClips(GAME_CLIPS, HERO_RIG, g.model);\nfor (let i = 0; i < GAME_CLIPS.length; i++) {\n  const d = GAME_CLIPS[i];\n  await test(`clip ${d.name}`, () => {\n    const v = validateClip(d, HERO_RIG);\n    assert(!v.length, v.join(';'));\n    const a = analyzeClip(g.model, HERO_RIG, d, compiled[i]);\n    assert(!a.problems.length, a.problems.join(';'));\n  });\n}\nfor (const m of GAME_MODELS) await test(`model ${m.id}`, () => { const r = checkModel(m, { catalog: MODELS }); assert(!r.problems.length, r.problems.join(';')); });\nfor (const t of GAME_TEXTURES) await test(`texture ${t.id}`, () => { const r = validateTexture(t); assert(!r.problems.length, r.problems.join(';')); });\nfor (const [name, song] of Object.entries(SONGS)) {\n  await test(`song ${name} parses`, () => { parseSong(song); });\n  await test(`song ${name} is loud enough at 10%`, () => {\n    const sum = Object.values(song.tracks).reduce((a, t) => a + (t.volume ?? 0.5), 0);\n    assert(sum * 0.1 * 0.8 >= 0.03, `level ${sum * 0.08}`);\n  });\n}\nawait test('step song is 104 BPM, 32 bars, and each bar is one chart line', () => {\n  eq(STEP_BPM, 104);\n  eq(STEP_SONG.order.length, 32);\n  eq(STEP_CHART.length, 32);\n  eq(STEP_CHART_HARD.length, 32);\n  eq(STEP_CHART_MEDLEY.length, 24);\n  for (const bar of [...STEP_CHART, ...STEP_CHART_HARD]) { eq(bar.length, 8, bar); assert(/^[LR.]{8}$/.test(bar), bar); }\n});\nawait test('every id resolves', () => {\n  for (const id of ACTIVITY_IDS) {\n    const a = ACTIVITIES[id];\n    assert(SONGS[a.song], `song ${a.song}`);\n    if (a.pose) assert(POSES[a.pose], `pose ${a.pose}`);\n    if (a.rep) assert(REPS[a.rep], `rep ${a.rep}`);\n    assert(STATIONS[a.station], `station ${a.station}`);\n    assert(CLASSMATE_SCORES[id], `scores ${id}`);\n    assert(RESULT_LINES[id], `lines ${id}`);\n  }\n  for (const s of Object.values(STATIONS)) for (const a of s.activities ?? []) assert(ACTIVITIES[a], `station activity ${a}`);\n  for (const e of MEDLEY.events) for (const o of e.options) assert(ACTIVITIES[o], `medley ${o}`);\n  eq(DAYS.length, 7); eq(QUESTIONS.length, 7); eq(MILESTONES.length, 7);\n  assert(BOARDS.length === 3);\n  assert(GLYPH_NAMES.includes('cross') && GLYPH_NAMES.includes('a'));\n});\nawait test('every activity has lines for 0-3 stars, first time and repeat', () => {\n  for (const id of ACTIVITY_IDS) for (const k of ['0', '1', '2', '3', 'first', 'repeat']) assert(RESULT_LINES[id][k]?.length, `${id} ${k}`);\n});\nawait test('the line bank has 120+ lines', () => assert(allLines().length >= 120, `${allLines().length}`));\nawait test('every line fits its box: 3 lines of 52 characters', () => {\n  for (const l of allLines()) assert(wrap(l.text, 52).length <= 3, `too long: ${l.text}`);\n});\nawait test('every character of every string has a glyph', () => {\n  const strings = [...allLines().map((l) => l.text), ...Object.values(ACTIVITIES).map((a) => a.name), ...Object.values(STATIONS).map((s) => s.name), ...MILESTONES.map((m) => m.name), ...Object.values(SOURCE_INFO), ...CREDITS, TITLE];\n  for (const s of strings) for (const ch of s) assert(hasGlyph(ch) || ch === '\\n', `no glyph for \"${ch}\" in: ${s}`);\n  eq(sanitize('Zo\\u00eb \\u2603'), 'Zo? ?', 'sanitize');\n});\nawait test('no bad words in the plan\\'s forbidden list', () => {\n  const banned = /\\b(wii|mii|wuhu|balance board|fit age)\\b/i;\n  for (const l of allLines()) assert(!banned.test(l.text), l.text);\n  for (const a of Object.values(ACTIVITIES)) assert(!banned.test(a.name), a.name);\n  assert(!banned.test(TITLE));\n});\nawait test('exit interview has the exact shape', () => {\n  const e = exitInterview();\n  for (const k of ['date', 'source', 'plan', 'genre', 'perspective', 'tech', 'artDirection', 'animation', 'audio', 'online', 'testing', 'research', 'environment', 'model', 'usage']) assert(typeof e.sourceInformation[k] === 'string' && e.sourceInformation[k].length, k);\n  eq(e.sourceInformation.usage, 'added on import');\n  eq(e.testingFeedback.length, 4); eq(e.engineFeedback.length, 6); eq(e.promptFeedback.length, 4);\n  for (const k of ['name', 'tagline', 'description', 'type', 'genre', 'source', 'series', 'players', 'controls']) assert(typeof AI_HUB[k] === 'string' && AI_HUB[k].length, k);\n  assert(AI_HUB.tags.length >= 3 && AI_HUB.tags.length <= 6);\n  eq(AI_HUB.name, TITLE);\n});\n\nawait test('voice: syllabify is stable and the same word gives the same syllables', () => {\n  const a = syllabify('Thank you. Thank you.', 'ounce').filter((s) => !s.tick);\n  const b = syllabify('Thank you. Thank you.', 'ounce').filter((s) => !s.tick);\n  eq(JSON.stringify(a), JSON.stringify(b));\n  eq(a[0].vowel, a[2].vowel, 'same word');\n  eq(a[0].cons, a[2].cons, 'same word');\n});\nawait test('voice: a question rises; declination falls', () => {\n  const q = syllabify('Is that close to anything at all?', 'ounce').filter((s) => !s.tick);\n  const flat = syllabify('Is that close to anything at all.', 'ounce').filter((s) => !s.tick);\n  assert(q[q.length - 1].f0 > flat[flat.length - 1].f0 * 1.1, 'rises');\n  assert(flat[0].f0 > flat[flat.length - 1].f0 * 0.98, 'falls');\n});\nawait test('voice: June has no contour, Coach is low and slow, Ounce high and quick', () => {\n  const june = syllabify('Are you nearly done?', 'june').filter((s) => !s.tick);\n  assert(new Set(june.map((s) => s.f0.toFixed(2))).size === 1, 'june flat');\n  const coach = syllabify('You are a tree.', 'coach'), ounce = syllabify('You are a tree.', 'ounce');\n  assert(coach[0].f0 < ounce[0].f0);\n  assert(voiceLength(coach) > voiceLength(ounce));\n  eq(syllabify('Squawk.', 'kevin').length, 0, 'kevin never speaks');\n  assert(Object.keys(VOICES).length >= 6);\n});\nawait test('voice: the typewriter reveals in step, and ends with the whole line', () => {\n  const text = 'Thank you. I have written that down.';\n  const syl = syllabify(text, 'ounce');\n  const end = voiceLength(syl);\n  assert(revealAt(syl, text, end * 0.3) < revealAt(syl, text, end * 0.8));\n  assert(revealAt(syl, text, end + 0.2) >= text.length - 2);\n});\nawait test('engine untouched: pixel-engine.js hash equals the kit\\'s', () => {\n  const want = readFileSync('vendor/pixel-engine.sha256', 'utf8').split(/\\s+/)[0];\n  eq(createHash('sha256').update(readFileSync('pixel-engine.js')).digest('hex'), want);\n});\nawait test('hub client untouched and first in the build', () => {\n  const html = readFileSync('tools/build.mjs', 'utf8');\n  assert(html.includes('vendor/hub/session.js'));\n  assert(readFileSync('vendor/hub/session.js', 'utf8').length > 5000);\n});\ndone();\nEOF\ncat > tests/headless/activities.mjs <<'EOF'\n// 4 Every activity: idle 0 stars, expert 2+, sloppy under expert, result written, Drips correct. 10 Determinism.\nimport { assert, boot, done, eq, makeScene, test, App } from '../lib.mjs';\nimport { ACTIVITIES, ACTIVITY_IDS } from '../../src/data/activities.js';\nimport { dripsFor } from '../../src/core/week.js';\nimport { BOARDS } from '../../src/data/boards.js';\n\nconst h = await boot({ scene: 'title' });\nconst EASY = new Set(['tree', 'heron', 'squats', 'lunges', 'hoop', 'step', 'header']);\n\nasync function play(id, skill, extra = {}) {\n  await h.go('activity', { id, mode: 'dropin', noPractice: true, ...extra });\n  App.dev.autopilot = skill;\n  await h.until(() => App.scene.resultsShown, { what: `${id} ${skill}`, max: 60 * 200, every: 60 });\n  App.dev.autopilot = null;\n  return App.scene.lastResult;\n}\n\nfor (const id of ACTIVITY_IDS) {\n  const scores = {};\n  await test(`${id}: idle bot finishes with 0 stars and no error`, async () => {\n    const r = await play(id, 'idle');\n    eq(r.stars, 0, `stars (score ${r.score})`);\n    eq(h.errors().length, 0, h.errors().join(';'));\n  });\n  await test(`${id}: expert bot gets ${EASY.has(id) ? '3' : '2+'} stars`, async () => {\n    const r = await play(id, 'expert');\n    scores.expert = r.score;\n    assert(r.stars >= (EASY.has(id) ? 3 : 2), `stars ${r.stars} score ${r.score}`);\n  });\n  await test(`${id}: sloppy bot scores under expert`, async () => {\n    const r = await play(id, 'sloppy');\n    assert(r.score < scores.expert, `sloppy ${r.score} expert ${scores.expert}`);\n    assert(r.stars <= 2, `sloppy stars ${r.stars}`);\n  });\n}\nfor (let board = 0; board < BOARDS.length; board++) {\n  await test(`tray board ${board}: expert 2+ stars, idle none`, async () => {\n    const r = await play('tray', 'expert', { board });\n    assert(r.stars >= 2, `stars ${r.stars} score ${r.score}/${r.max}`);\n    eq((await play('tray', 'idle', { board })).stars, 0);\n  });\n}\n\nawait test('result written in Drop-In: records only, no Drips', async () => {\n  const before = JSON.stringify(App.store.data.dropin?.tree ?? null);\n  const r = await play('tree', 'expert');\n  assert(JSON.stringify(App.store.data.dropin.tree) !== before);\n  eq(r.drips, 0);\n  eq(App.slot, null, 'no guest needed');\n});\nawait test('week mode: result written and Drips are 2 + 3 stars + time, plus the goal', async () => {\n  App.store.create(0, 'Test', { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n  const slot = App.slot;\n  slot.phase = 'day';\n  await h.go('activity', { id: 'squats', mode: 'week', noPractice: true });\n  App.dev.autopilot = 'expert';\n  await h.until(() => App.scene.resultsShown, { max: 60 * 100 });\n  App.dev.autopilot = null;\n  const r = App.scene.lastResult;\n  eq(slot.records.squats.plays, 1);\n  eq(slot.records.squats.stars, r.stars);\n  eq(slot.drips, dripsFor(r.stars, r.seconds) + (r.bonus ?? 0));\n  assert(slot.drips >= 2 + 3 * r.stars);\n});\nawait test('hard versions make it harder', async () => {\n  const a = await play('heron', 'average');\n  const b = await play('heron', 'average', { hard: true });\n  assert(b.score <= a.score + 6, `${b.score} vs ${a.score}`);\n});\nawait test('a first time gets 8 s of practice, unscored, then a count', async () => {\n  App.practised = {};\n  delete App.store.data.dropin.heron;\n  await h.go('activity', { id: 'heron', mode: 'dropin' });\n  const s = App.scene;\n  eq(s.phase, 'intro');\n  h.press('Enter');\n  eq(s.phase, 'practice');\n  h.step(60 * 8 + 2);\n  eq(s.phase, 'countdown');\n  h.step(60 * 3 + 2);\n  eq(s.phase, 'play');\n  eq(s.event.scoreOf(s.playerLane) < 5, true, 'score starts clean');\n});\n\n// 10 Determinism: record, replay, fingerprints equal.\nfor (const id of ['tree', 'hoop', 'step', 'header', 'tray', 'slackline', 'pier']) {\n  await test(`determinism: ${id} replays to the same fingerprint`, async () => {\n    await h.go('activity', { id, mode: 'dropin', noPractice: true });\n    const engine = h.engine;\n    h.press('Enter');\n    App.dev.autopilot = null;\n    const keys = ['KeyD', 'KeyA', 'KeyW', 'KeyS', 'KeyF', 'KeyJ', 'Space'];\n    for (let i = 0; i < 40; i++) {\n      const k = keys[i % keys.length];\n      engine.input.setKey(k, true); engine.step(6); engine.input.setKey(k, false); engine.step(4);\n    }\n    const rec = engine.recording();\n    const end = engine.fingerprint();\n    await engine.replay(rec, () => engine.loadGame(makeScene('activity', { id, mode: 'dropin', noPractice: true })));\n    eq(engine.fingerprint(), end, `${id}`);\n    engine.manual = true;\n  });\n}\ndone();\nEOF\ncat > tests/headless/week.mjs <<'EOF'\n// 5 The full scripted playthrough through the real menus. 6 Save. Weigh-In and Wobble Age.\nimport { assert, boot, done, eq, MemoryStorage, near, test, App, tick } from '../lib.mjs';\nimport { ACTIVITIES, HARD_DAY } from '../../src/data/activities.js';\nimport { goalMet, isOpen, totalStarsOf, ageFromTests, shownAge } from '../../src/core/week.js';\nimport { MILESTONES } from '../../src/data/unlocks.js';\nimport { AGE_OFFSET, DAYS } from '../../src/data/week.js';\nimport { Store, SAVE_KEY } from '../../src/core/save.js';\n\nconst storage = new MemoryStorage();\nconst h = await boot({ scene: 'title', storage });\nconst { engine } = h;\n\n/** Move the top menu to an item and press Enter, through real key presses. */\nfunction pick(id, screen = App.stack.top) {\n  const menu = screen.menu;\n  const i = menu.items.findIndex((it) => it.id === id);\n  assert(i >= 0, `no item ${id} in ${App.stack.names().join('>')}: ${menu.items.map((x) => x.id).join(',')}`);\n  let guard = 0;\n  while (menu.focus !== i && guard++ < 30) { h.press('ArrowDown'); h.step(1); }\n  eq(menu.focus, i, `focus on ${id}`);\n  h.press('Enter');\n  h.step(1);\n}\n\nasync function settle() { await tick(); await h.settle(); }\n\n/** Press through dialogue, questions and the like until a test passes. */\nasync function drive(pred, { max = 60 * 400, what = '' } = {}) {\n  let n = 0;\n  while (!pred()) {\n    const top = App.stack.top;\n    if (top?.name === 'dialogue' || top?.name === 'question' || top?.name === 'feel') h.press('Enter');\n    else if (App.scene.id === 'ferry') h.press('Enter');\n    else h.step(10);\n    await tick();\n    n += 10;\n    if (App.loading) await settle();\n    if (n > max) throw new Error(`drive timed out (${what}): ${JSON.stringify(App.state())}`);\n  }\n  if (App.loading) await settle();\n}\n\nasync function doActivity(station, id, { hard = false, skill = 'expert' } = {}) {\n  await drive(() => App.scene.id === 'hub' && !App.stack.open, { what: 'back at hub' });\n  assert(App.scene.stand(station) === station, `standing at ${station}: near ${App.scene.nearest}`);\n  h.step(2);\n  h.press('Enter');\n  eq(App.stack.top?.name, 'station', `station menu for ${station}`);\n  if (hard) { pick('hard'); }\n  pick(id);\n  await settle();\n  eq(App.scene.id, 'activity', `activity ${id}`);\n  eq(App.scene.activity, id);\n  App.dev.autopilot = skill;\n  await h.until(() => App.scene.resultsShown, { max: 60 * 200, every: 30, what: id });\n  App.dev.autopilot = null;\n  const r = App.scene.lastResult;\n  h.step(60 * 2);\n  await drive(() => App.stack.top?.name === 'results' && App.stack.top.menuReady, { what: 'results menu' });\n  pick('back');\n  await settle();\n  eq(App.scene.id, 'hub');\n  return r;\n}\n\nasync function morning(day) {\n  App.dev.autopilot = 'good';\n  await drive(() => App.scene.id === 'hub', { what: `morning of day ${day}` });\n  App.dev.autopilot = null;\n  await drive(() => !App.stack.open, { what: 'story beat' });\n  eq(App.slot.day, day, 'day');\n  eq(App.slot.phase, 'day');\n}\n\nasync function endDay(day) {\n  await drive(() => App.scene.id === 'hub' && !App.stack.open);\n  App.scene.stand('hammock');\n  h.step(2);\n  h.press('Enter');\n  await drive(() => App.scene.id === 'report', { what: `report of day ${day}` });\n  eq(App.slot.phase, 'report');\n  h.step(30);\n  h.press('Enter'); // into the talk\n  await drive(() => App.scene.phase === 'done' || App.scene.id !== 'report', { what: 'report talk' });\n  h.step(2);\n  h.press('Enter'); // good night\n  await drive(() => App.scene.id === 'weighin', { what: 'next morning' });\n}\n\nawait test('title: any button opens the main menu', async () => {\n  h.step(5);\n  eq(App.state().scene, 'title');\n  h.press('Enter');\n  eq(App.stack.top?.name, 'main');\n});\nawait test('new week: slot, name entry, avatar, ferry', async () => {\n  pick('week');\n  eq(App.stack.top?.name, 'slots');\n  pick('slot0');\n  eq(App.stack.top?.name, 'name-entry');\n  App.stack.top.typed = 'K'; h.step(1); App.stack.top.typed = 'i'; h.step(1); App.stack.top.typed = 'm'; h.step(1);\n  eq(App.stack.top.text, 'Kim');\n  h.press('Enter');\n  eq(App.stack.top?.name, 'avatar-pick');\n  pick('look2');\n  await settle();\n  eq(App.scene.id, 'ferry');\n  eq(App.slot.name, 'Kim');\n  eq(App.slot.phase, 'ferry');\n});\nawait test('ferry: skips or plays through to the first Weigh-In', async () => {\n  h.step(60 * 2);\n  h.press('Enter');\n  await drive(() => App.scene.id === 'weighin', { what: 'ferry end' });\n  eq(App.slot.phase, 'morning');\n});\nawait test('day 1: intro teaches the Dot, then a test, a question, an age; the age question is never saved', async () => {\n  await drive(() => App.stack.top?.name === 'dialogue' || App.scene.phase === 'test');\n  App.dev.autopilot = 'good';\n  await drive(() => App.stack.top?.name === 'feel', { what: 'feel question' });\n  App.stack.top.value = 77;\n  h.press('Enter');\n  await morning(1);\n  eq(App.slot.ages.length, 1);\n  assert(!JSON.stringify(App.store.data).includes('\"feel\"'), 'feel not saved');\n});\n\nconst SCHEDULE = [\n  { day: 1, plays: [['pavilion', 'tree'], ['shed', 'squats'], ['beach', 'hoop'], ['pavilion', 'heron']], open: ['tree', 'heron', 'squats', 'hoop'], closed: ['header', 'lunges', 'warrior', 'step', 'tray', 'jog', 'stand'] },\n  { day: 2, plays: [['lagoon', 'header'], ['shed', 'lunges'], ['pavilion', 'warrior']], open: ['header', 'lunges', 'warrior'], closed: ['step', 'slackline', 'chair', 'tray'] },\n  { day: 3, plays: [['beach', 'step'], ['lagoon', 'slackline'], ['pavilion', 'chair']], open: ['step', 'slackline', 'chair'], closed: ['tray', 'press', 'fold', 'jog'] },\n  { day: 4, plays: [['lagoon', 'tray'], ['shed', 'press'], ['pavilion', 'fold']], open: ['tray', 'press', 'fold'], closed: ['jog', 'pier', 'plank'] },\n  { day: 5, plays: [['gate', 'jog'], ['lagoon', 'pier'], ['pavilion', 'plank']], open: ['jog', 'pier', 'plank'], closed: ['stand'] },\n  { day: 6, plays: [['pavilion', 'tree', true]], open: ['tree'], closed: ['stand'] },\n];\n\nfor (const d of SCHEDULE) {\n  await test(`day ${d.day}: the schedule opens what it should, and nothing else`, async () => {\n    if (d.day > 1) await morning(d.day);\n    const slot = App.slot;\n    eq(slot.day, d.day);\n    for (const id of d.open) assert(isOpen(slot, id), `${id} should be open on day ${d.day}`);\n    for (const id of d.closed) assert(!isOpen(slot, id), `${id} should be closed on day ${d.day}`);\n    eq(DAYS[d.day - 1].day, d.day);\n    if (d.day >= 2) eq(slot.heardBeat, d.day, 'story beat heard');\n  });\n  await test(`day ${d.day}: stations, the prescription pays +5, and the record is kept`, async () => {\n    const before = App.slot.drips;\n    let any = false;\n    for (const [station, id, hard] of d.plays) {\n      const r = await doActivity(station, id, { hard: !!hard });\n      assert(App.slot.records[id].plays >= 1, `${id} recorded`);\n      any = true;\n      assert(r.stars >= 2, `${id} stars ${r.stars}`);\n    }\n    assert(any);\n    assert(goalMet(App.slot), `goal of day ${d.day}: ${JSON.stringify(App.slot.todayDone)}`);\n    assert(App.slot.goalPaid, 'bonus paid');\n    assert(App.slot.drips > before + 5);\n  });\n  await test(`day ${d.day}: the hammock ends the day; the Report leads to morning`, async () => { await endDay(d.day); eq(App.slot.day, d.day + 1); });\n}\n\nawait test('hard versions are open on day 6, not before', () => {\n  eq(HARD_DAY, 6);\n});\n\nawait test('the jar, the locker and the hall all open and come back', async () => {\n  App.dev.autopilot = 'good';\n  await morning(7);\n  for (const [station, scene] of [['jar', 'jar'], ['locker', 'locker'], ['hall', 'records']]) {\n    App.scene.stand(station);\n    h.step(2);\n    h.press('Enter');\n    await settle();\n    eq(App.scene.id, scene);\n    h.step(120);\n    h.press('Escape');\n    await settle();\n    eq(App.scene.id, 'hub');\n  }\n});\nawait test('jar milestones arrive in order, each with a Locker Room item', () => {\n  const slot = App.slot;\n  const expect = MILESTONES.filter((m) => m.drips <= slot.drips).map((m) => m.id);\n  eq(slot.wardrobe.join(), expect.join());\n  assert(slot.wardrobe.length >= 4, `only ${slot.wardrobe.length} by day 7 with ${slot.drips} drips`);\n});\n\nlet shownBefore;\nawait test('day 7: the hammock refuses; the terrace stands; the Long Stand plays; no way to fail', async () => {\n  App.scene.stand('hammock');\n  h.step(2);\n  h.press('Enter');\n  eq(App.stack.top?.name, 'dialogue', 'hammock says not today');\n  await drive(() => !App.stack.open);\n  eq(App.scene.id, 'hub');\n  App.scene.stand('terrace');\n  h.step(2);\n  h.press('Enter');\n  await settle();\n  eq(App.scene.activity, 'stand');\n  shownBefore = App.slot.ages.map((a) => shownAge(App.slot, a));\n  App.dev.autopilot = 'good';\n  h.step(60 * 1);\n  await h.until(() => App.scene.resultsShown, { max: 60 * 120, every: 30 });\n  App.dev.autopilot = null;\n  assert(goalMet(App.slot), 'stand fills the prescription');\n  eq(App.slot.confessed, false);\n  h.step(60 * 2);\n  await drive(() => App.stack.top?.name === 'results' && App.stack.top.menuReady);\n  pick('continue');\n  await settle();\n  eq(App.scene.id, 'ending');\n});\nawait test('the confession subtracts exactly 7 from every point', async () => {\n  await drive(() => App.scene.phase === 'slide', { what: 'slide' });\n  eq(App.slot.confessed, true);\n  const after = App.slot.ages.map((a) => shownAge(App.slot, a));\n  after.forEach((v, i) => eq(shownBefore[i] - v, AGE_OFFSET, `point ${i}`));\n  h.step(60 * 3);\n  near(App.scene.slide, AGE_OFFSET, 0.01, 'chart slide');\n});\nawait test('credits roll, then Week 2 opens everything', async () => {\n  await drive(() => App.scene.phase === 'credits', { what: 'credits' });\n  h.step(60 * 3);\n  h.press('Enter');\n  await drive(() => App.scene.id === 'weighin', { what: 'week 2 morning' });\n  eq(App.slot.week, 2);\n  eq(App.slot.day, 1);\n  for (const id of Object.keys(ACTIVITIES)) assert(isOpen(App.slot, id), `${id} open in week 2`);\n  App.dev.autopilot = 'good';\n  await morning(1);\n  await drive(() => !App.stack.open);\n  eq(App.scene.id, 'hub');\n  eq(h.errors().length, 0, h.errors().join(' | '));\n});\nawait test('Week 2 goes on: days keep turning over, ages stay honest', async () => {\n  const slot = App.slot;\n  const r = await doActivity('pavilion', 'tree');\n  assert(r.stars >= 2);\n  await endDay(1);\n  eq(slot.day, 2);\n  const a = slot.ages.length;\n  App.dev.autopilot = 'good';\n  await morning(2);\n  eq(slot.ages.length, a + 1);\n  eq(shownAge(slot, slot.ages[a]), slot.ages[a], 'no more adding seven');\n});\n\n// 6 Save.\nawait test('save: reload mid-week restores', () => {\n  const again = new Store(storage);\n  eq(again.data.slots[0].name, 'Kim');\n  eq(again.data.slots[0].week, App.slot.week);\n  eq(again.data.slots[0].drips, App.slot.drips);\n  assert(storage.getItem(SAVE_KEY).length > 10);\n});\nawait test('save: corrupt JSON falls back safely', () => {\n  const s = new MemoryStorage();\n  s.setItem(SAVE_KEY, '{not json');\n  const st = new Store(s);\n  eq(st.recovered, true);\n  eq(st.data.slots[0], null);\n  eq(st.settings.music, 0.1);\n  st.create(1, 'B', {});\n  assert(new Store(s).data.slots[1]);\n});\nawait test('save: a wrong version falls back safely', () => {\n  const s = new MemoryStorage();\n  s.setItem(SAVE_KEY, JSON.stringify({ v: 99, slots: 'nope' }));\n  eq(new Store(s).data.slots.length, 3);\n});\nawait test('save: no storage works, in memory', () => {\n  const broken = { getItem() { throw new Error('denied'); }, setItem() { throw new Error('denied'); } };\n  const st = new Store(broken);\n  st.create(0, 'M', {});\n  eq(st.slot.name, 'M');\n  st.write();\n  eq(JSON.parse(st.memory).slots[0].name, 'M');\n});\n\n// The numbers.\nawait test('Wobble Age: expert ends lower than average; idle stays high; clamped 18..95', async () => {\n  const ages = {};\n  for (const skill of ['idle', 'average', 'expert']) {\n    const slot = App.store.create(2, skill, { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink' });\n    slot.phase = 'morning';\n    slot.introHeard = true;\n    for (const test2 of ['stillness', 'lean', 'chase']) {\n      await h.go('weighin', { test: test2 });\n      App.dev.autopilot = skill;\n      await drive(() => App.scene.id === 'weighin' && App.scene.result !== undefined, { what: `${skill} ${test2}` });\n      await drive(() => App.scene.id !== 'weighin', { what: 'leave' });\n      await settle();\n      App.dev.autopilot = null;\n    }\n    ages[skill] = slot.ages[slot.ages.length - 1];\n  }\n  assert(ages.expert < ages.average, `expert ${ages.expert} average ${ages.average}`);\n  assert(ages.average < ages.idle, `average ${ages.average} idle ${ages.idle}`);\n  assert(ages.idle >= 70, `idle ${ages.idle}`);\n  eq(ageFromTests([0, 0, 0], 0), 80);\n  eq(ageFromTests([1, 1, 1], 200), 18);\n  eq(totalStarsOf({ records: { a: { stars: 2 }, b: { stars: 3 } } }), 5);\n});\nawait test('Week: a test of T = 0.5 with no stars is an age of 50, shown as 57', () => {\n  eq(ageFromTests([0.5], 0), 50);\n  eq(shownAge({ confessed: false }, 50), 57);\n  eq(shownAge({ confessed: true }, 50), 50);\n});\nawait test('no game errors anywhere in the week', () => eq(h.errors().length, 0, h.errors().join(' | ')));\ndone();\nEOF\ntimeout 300 node tools/test.mjs --fast core activities </dev/null 2>&1 | tail -30 | cut -c1-420","description":"Write core, activity and week tests and run the first two","timeout":310000}}}
