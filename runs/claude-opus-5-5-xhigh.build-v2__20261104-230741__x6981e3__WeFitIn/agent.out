{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjMGpuZAfY3tU3VhbJTL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0153ADDVBztYVexaKU1grUdW","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\nsed -n 2242,2252p API.md | cut -c1-200\ncat > src/core/clock.js <<'EOF'\n// The Medley's clock. In a session it reads the hub's timeline, so all copies stay in step.\nexport class MedleyClock {\n  local = 0;\n  constructor(hub = null) { this.hub = hub; }\n  tick(dt) { this.local += dt; }\n  /** Seconds since play began; negative in the countdown. */\n  now() {\n    if (this.hub) return this.hub.time() / 1000;\n    return this.local;\n  }\n}\nEOF\ncat > src/core/net.js <<'EOF'\n// The only network: the AI Hub client, when a hub opened the page.\nexport const hub = () => (typeof globalThis !== 'undefined' ? globalThis.AIHub : undefined);\nexport const SEAT_COLORS = [0xe8443a, 0x3b82f6, 0x22c55e, 0xf5b700];\nexport const SEAT_PALETTE = ['red', 'blue', 'green', 'sand'];\n\n/** Ghosts: 100 ms, not tied to rendering. Start as soon as `start` arrives, even with score 0. */\nexport class GhostSender {\n  timer = null;\n  start(getState, h = hub()) {\n    if (this.timer || !h) return;\n    this.timer = setInterval(() => {\n      const s = getState();\n      if (!s) return;\n      h.send({ a: s.area, x: s.x, y: s.y, c: s.clip, t: s.time, s: s.score }, { reliable: false });\n      h.progress({ score: s.score, label: s.label });\n    }, 100);\n  }\n  stop() { if (this.timer) clearInterval(this.timer); this.timer = null; }\n}\nEOF\ncat > src/scenes/medley.js <<'EOF'\n// The Medley: Stillness, then Beat, then Balance. Family Hour on one TV, AI Hub ghosts online.\nimport { Rng, THREE } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { MedleyClock } from '../core/clock.js';\nimport { BotDriver, GhostDriver, KeyboardDriver, LocalDriver, PadDriver } from '../core/drivers.js';\nimport { GhostSender, hub, SEAT_COLORS, SEAT_PALETTE } from '../core/net.js';\nimport { MORE_TIME } from '../core/actions.js';\nimport { Kevin, place } from '../art/props.js';\nimport { LOOKS, PRESET_LOOKS } from '../data/classmates.js';\nimport { MEDLEY } from '../data/medley.js';\nimport { ACTIVITIES } from '../data/activities.js';\nimport { TITLE } from '../data/title.js';\nimport { sanitize, say, sayCentered, sayRight, textWidth } from '../ui/font.js';\nimport { Menu } from '../ui/menu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { panel, star, STAR_W } from '../ui/widgets.js';\nimport { BaseScene, laneCamera } from './base.js';\nimport { buildLanes, playerInfo } from './activity/lanes.js';\nimport { PoseEvent } from './activity/poses.js';\nimport { RepsEvent } from './activity/reps.js';\nimport { HoopEvent } from './activity/hoop.js';\nimport { StepEvent, STEP_CHART_MEDLEY } from './activity/step.js';\nimport { buildHeaderProps, HeaderEvent } from './activity/header.js';\nimport { box, plazaSet } from './sets.js';\nimport { SONGS, stepSongFrom } from '../audio/songs.js';\n\nconst { Vector3 } = THREE;\nconst LOOK_ORDER = [LOOKS.june, LOOKS.dennis, LOOKS.marguerite, PRESET_LOOKS[1]];\nconst WINDOW = MEDLEY.eventSeconds + MEDLEY.breakSeconds;\nexport const MEDLEY_LENGTH = MEDLEY.events.length * MEDLEY.eventSeconds + (MEDLEY.events.length - 1) * MEDLEY.breakSeconds;\n\nconst SONG_FOR = { pose: 'hold', reps: 'rep', hoop: 'hoop', step: 'step', header: 'lagoon' };\n\nexport class MedleyScene extends BaseScene {\n  name = 'medley';\n  id = 'medley';\n  canPause = true;\n  centreDial = false;\n  phase = 'intro';\n  area = -1;\n  phaseT = 0;\n  ended = false;\n  resultSent = false;\n\n  constructor(args = {}) {\n    super(args);\n    this.session = !!args.session;\n    this.family = args.family ?? null;\n    this.pauseToTitle = !this.session;\n  }\n\n  cameraConfig() { return laneCamera(4); }\n\n  async build(ctx) {\n    plazaSet(ctx, 11);\n    box(ctx, 14, 0.14, 4, [0, 0.04, 0.8], 'white', { cast: false });\n    place(ctx, 'class-rail', { at: [0, 0, -3.1], params: { len: 14 } });\n    this.kevin = new Kevin(ctx, { at: [-4.8, 1.11, -3.1], yaw: 0.4 });\n    this.cosmetic = ctx.random.fork('cosmetic');\n    this.rngPick = ctx.random.fork('medley-picks');\n    this.hub = this.session ? hub() : null;\n    this.clock = new MedleyClock(this.hub);\n    this.ghostSender = new GhostSender();\n    const rand = (() => { const r = ctx.random.fork('bots'); return () => r.next(); })();\n    this.lanes = await buildLanes(ctx, this.specs(rand), { rand, xs: this.seatXs() });\n    for (const l of this.lanes) { l.points = []; l.total = 0; l.lastNorm = 0; }\n    this.local = this.lanes.filter((l) => l.isLocal);\n    this.me = this.lanes.find((l) => l.isMe) ?? this.local[0] ?? null;\n    this.playerLane = this.me;\n    // Picks come from a seeded stream, so all copies choose the same.\n    this.picks = MEDLEY.events.map((e) => this.args.picks?.[e.kind] ?? this.rngPick.pick(e.options));\n    this.events = this.picks.map((id, i) => this.makeEvent(id, i));\n    for (const lane of this.lanes) {\n      if (!lane.ghost) await buildHeaderProps(ctx, lane);\n      lane.hoopMeshes = [0, 1, 2, 3].map((i) => {\n        const m = place(ctx, 'hoop', { palette: { hoop: ['red', 'sky', 'lime', 'sand'][i] }, actor: true, shadow: false }).object;\n        m.visible = false;\n        return m;\n      });\n    }\n    this.current = null;\n    App.music(this.session ? 'title' : 'title');\n    if (this.session) this.connectHub(); else this.enterPhase('intro');\n  }\n\n  seatXs() {\n    const n = this.session ? (App.session?.players.length ?? 1) : (this.family?.length ?? 1);\n    return [[0], [-1, 1], [-2.2, 0, 2.2], [-3, -1, 1, 3]][n - 1] ?? [-3, -1, 1, 3];\n  }\n\n  specs(rand) {\n    if (this.session) {\n      const info = App.session;\n      return info.players.map((p, i) => {\n        const mine = p.id === info.me;\n        return { name: p.name, look: LOOK_ORDER[i % LOOK_ORDER.length], driver: mine ? new LocalDriver() : new GhostDriver(), isLocal: mine, isMe: mine, isPlayer: mine, color: 'red', seat: p.id, matColor: SEAT_PALETTE[i], hex: SEAT_COLORS[i] };\n      });\n    }\n    const list = this.family ?? [{ kind: 'keyboard' }];\n    const playerI = playerInfo();\n    return list.map((f, i) => {\n      let driver;\n      if (f.kind === 'pad') driver = new PadDriver(f.index, (x, y) => App.deadzone(x, y));\n      else if (f.kind === 'bot') driver = new BotDriver(f.skill ?? 'average', rand);\n      else driver = new KeyboardDriver();\n      const human = f.kind !== 'bot';\n      return { name: f.name ?? (human ? `Player ${i + 1}` : ['June', 'Dennis', 'Marguerite', 'Kevin'][i]), look: f.look ?? (i === 0 && App.slot ? playerI.look : PRESET_LOOKS[i]), driver, isLocal: human, isPlayer: false, color: 'red', seat: i, matColor: SEAT_PALETTE[i], hex: SEAT_COLORS[i] };\n    });\n  }\n\n  makeEvent(id, i) {\n    const def = ACTIVITIES[id];\n    const rng = this.ctx.random.fork(`event:${i}`);\n    const opts = { hard: {}, duration: MEDLEY.eventSeconds };\n    if (def.family === 'pose') return new PoseEvent(this, this.lanes, rng, { pose: def.pose, hard: {}, hold: MEDLEY.poseHold, settle: 4, release: 2 });\n    if (def.family === 'reps') return new RepsEvent(this, this.lanes, rng, { rep: def.rep, hard: {}, reps: MEDLEY.repsCount, extra: 0, duration: MEDLEY.eventSeconds });\n    if (def.family === 'hoop') return new HoopEvent(this, this.lanes, rng, opts);\n    if (def.family === 'step') return new StepEvent(this, this.lanes, rng, { ...opts, chart: STEP_CHART_MEDLEY });\n    return new HeaderEvent(this, this.lanes, rng, { ...opts, range: 0.8 });\n  }\n\n  // ---- The hub ----------------------------------------------------------------------------\n\n  connectHub() {\n    const h = this.hub;\n    this.enterPhase('card');\n    this.cardState = { left: null, ready: [], asking: 0, asked: false, paused: false, starting: false };\n    this.offs = [\n      h.on('card', (c) => { this.cardState = c; }),\n      h.on('start', () => this.onStart()),\n      h.on('message', (d, from) => this.onMessage(d, from)),\n      h.on('leave', (e) => this.onLeave(e)),\n      h.on('time-up', () => this.sendResult()),\n      h.on('end', () => this.onEnd()),\n    ];\n    // Enter answers Ready: a direct listener, because the card has no menus.\n    this.keyHandler = (e) => {\n      if (this.phase !== 'card') return;\n      if (e.key === 'Enter') { this.answered = true; h.answer('ready'); }\n      if (e.key === 'm' || e.key === 'M') h.answer('more');\n    };\n    if (typeof window !== 'undefined') window.addEventListener('keydown', this.keyHandler);\n  }\n\n  onStart() {\n    if (this.started) return;\n    this.started = true;\n    this.enterPhase('countdown');\n    this.ghostSender.start(() => this.ghostState(), this.hub);\n  }\n\n  ghostState() {\n    if (this.ended) return null;\n    const lane = this.me;\n    if (!lane) return null;\n    const ev = this.current;\n    const [c, t] = ev ? ev.clipState(lane) : [0, 0];\n    const score = this.scoreOf(lane);\n    return { area: this.area, x: round3(lane.dot?.x ?? 0), y: round3(lane.dot?.y ?? 0), clip: c, time: round3(t), score, label: ev ? ACTIVITIES[this.picks[this.area]]?.name ?? '' : TITLE };\n  }\n\n  onMessage(d, from) {\n    if (this.ended) return;\n    const lane = this.lanes.find((l) => l.seat === from);\n    if (!lane || !lane.ghost) return;\n    lane.driver.receive(d);\n    lane.score = lane.driver.score;\n  }\n\n  /** That avatar waves and walks off. The round goes on, host included. */\n  onLeave(e) {\n    const lane = this.lanes.find((l) => l.seat === e.id);\n    if (!lane || lane.gone) return;\n    lane.gone = true;\n    lane.leaveT = 0;\n    lane.avatar.play('Wave', { fade: 0.2 });\n  }\n\n  sendResult() {\n    if (this.resultSent || !this.hub) return;\n    this.resultSent = true;\n    const lane = this.me;\n    const score = this.scoreOf(lane);\n    const stats = {};\n    this.picks.forEach((id, i) => { stats[ACTIVITIES[id].name] = lane.points[i] ?? 0; });\n    this.hub.result({ score, stats, awards: this.awardsFor(lane) });\n    this.enterPhase('waiting');\n  }\n\n  onEnd() {\n    this.ended = true;\n    this.ghostSender.stop();\n    this.ctx.audio.stopMusic();\n    this.ctx.audio.stopLoops();\n    App.voice.stop();\n  }\n\n  awardsFor(lane) {\n    const a = MEDLEY.awards;\n    const out = [];\n    const pts = lane.points;\n    if ((pts[0] ?? 0) >= 700) out.push(a.stillest);\n    if ((pts[1] ?? 0) >= 700) out.push(a.beat);\n    if ((pts[2] ?? 0) >= 500) out.push(a.headed);\n    if (!out.length) out.push(a.apologetic);\n    return out.map((x) => ({ title: x.title, detail: x.detail }));\n  }\n\n  // ---- The round ----------------------------------------------------------------------------\n\n  enterPhase(p) {\n    this.phase = p;\n    this.phaseT = 0;\n    if (p === 'podium') this.buildPodium();\n  }\n\n  scoreOf(lane) {\n    if (!lane) return 0;\n    if (lane.ghost) return lane.driver.score;\n    const live = this.current && this.current.lanes.includes(lane) && this.phase === 'play' ? this.current.normalized(lane) : 0;\n    return Math.round(lane.total + live);\n  }\n\n  eventIndexAt(t) {\n    if (t < 0) return -1;\n    const i = Math.floor(t / WINDOW);\n    if (i >= this.events.length) return -2;\n    return t - i * WINDOW < MEDLEY.eventSeconds ? i : -1;\n  }\n\n  startEvent(i) {\n    this.area = i;\n    this.current = this.events[i];\n    this.current.begin();\n    const kind = this.current.kind;\n    if (kind === 'step') { this.ctx.audio.playMusic(stepSongFrom(0, 24), 'step'); App.songName = 'step'; } else App.music(SONG_FOR[kind] ?? 'title');\n    App.say('coach', ACTIVITIES[this.picks[i]].coach);\n    for (const l of this.lanes) { if (l.hoopMeshes) for (const m of l.hoopMeshes) m.visible = false; }\n    if (kind !== 'header') for (const l of this.lanes) { if (l.objects) for (const o of l.objects) { o.mesh.visible = false; o.shadow.visible = false; } l.avatar.root.position.x = l.x; }\n    if (kind === 'header') this.current.launchZ = -7;\n  }\n\n  closeEvent() {\n    const ev = this.current;\n    if (!ev) return;\n    for (const lane of this.lanes) {\n      if (lane.ghost) continue;\n      ev.finishLane?.(lane);\n      const pts = ev.normalized(lane);\n      lane.points[this.area] = pts;\n      lane.total += pts;\n    }\n    this.current = null;\n    this.area = -1;\n    this.breakRemark = this.cosmetic.pick(MEDLEY.remarks.middle);\n    for (const lane of this.lanes) if (!lane.gone) lane.avatar.play('Idle', { fade: 0.3 });\n    App.music('title');\n  }\n\n  onFixed(ctx, dt) {\n    if (this.ended) return;\n    this.phaseT += dt;\n    switch (this.phase) {\n      case 'intro':\n        if (this.phaseT >= MEDLEY.introSeconds) { this.enterPhase('play'); this.clock.local = 0; }\n        break;\n      case 'countdown':\n        if (this.hub.time() >= 0) this.enterPhase('play');\n        break;\n      case 'play': {\n        this.clock.tick(dt);\n        const t = this.clock.now();\n        const i = this.eventIndexAt(t);\n        if (i === -2) { this.closeEvent(); this.finishRound(); break; }\n        if (i !== this.area) {\n          if (this.area >= 0) this.closeEvent();\n          if (i >= 0) this.startEvent(i);\n        }\n        if (this.current) {\n          const et = t - this.area * WINDOW;\n          this.eventT = et;\n          this.current.step(ctx, dt, et, true);\n        }\n        break;\n      }\n      default:\n        break;\n    }\n  }\n\n  finishRound() {\n    if (this.session) { this.sendResult(); return; }\n    this.enterPhase('podium');\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (this.phase === 'card') {\n      if (input.wasPressed('PadCross')) { this.answered = true; this.hub.answer('ready'); }\n      if (input.wasPressed(...MORE_TIME)) this.hub.answer('more');\n      if (input.wasPressed('MouseLeft') && this.cardButtons) {\n        const p = App.device.pointerArt(ctx);\n        const hit = (r) => p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;\n        if (hit(this.cardButtons.ready)) { this.answered = true; this.hub.answer('ready'); }\n        if (hit(this.cardButtons.more)) this.hub.answer('more');\n      }\n    }\n    if (this.phase === 'podium' && this.menu) this.menu.update(ctx, 0);\n  }\n\n  buildPodium() {\n    const order = [...this.lanes].sort((a, b) => b.total - a.total);\n    this.order = order;\n    const steps = [[0, 0.9], [-1.6, 0.6], [1.6, 0.35], [3.2, 0.05]];\n    order.forEach((lane, i) => {\n      const [x, h] = steps[i] ?? [0, 0];\n      if (h > 0.06) box(this.ctx, 1.5, h, 1.4, [x, h / 2, -0.4], 'white');\n      lane.avatar.root.position.set(x, h, -0.4);\n      lane.avatar.groundY = h;\n      lane.avatar.root.rotation.y = 0;\n      lane.avatar.play(i === 0 ? 'Victory' : i === order.length - 1 ? 'Slump' : 'Wave', { fade: 0.3 });\n    });\n    App.sfx('fanfareSoft');\n    App.music('report');\n    const remark = order.length > 1 ? this.cosmetic.pick(MEDLEY.remarks.first) : this.cosmetic.pick(MEDLEY.remarks.middle);\n    App.say('ounce', remark);\n    this.awards = order.map((l) => this.awardsFor(l)[0]);\n    this.menu = new Menu([\n      { label: 'Rematch', id: 'rematch', action: () => App.go('medley', { ...this.args }) },\n      { label: 'Back to title', id: 'title', action: () => App.go('title', { menu: 'main' }) },\n    ], { width: 180, scale: 1, rowH: 15, align: 'center', y: 0 });\n    for (const l of this.lanes) { if (l.hoopMeshes) for (const m of l.hoopMeshes) m.visible = false; }\n  }\n\n  onUpdate(ctx, dt) {\n    this.kevin.update(dt);\n    if (this.current) this.current.visual(ctx, dt, this.eventT ?? 0);\n    else for (const l of this.lanes) {\n      if (l.ghost && !l.gone) l.driver.lerp(dt);\n      if (!l.gone || l.leaveT === undefined) l.avatar.update(dt);\n    }\n    for (const l of this.lanes) {\n      if (l.gone) {\n        l.leaveT += dt;\n        if (l.leaveT > 1.4) { l.avatar.play('Walk', { fade: 0.2 }); l.avatar.root.rotation.y = 1.57 * (l.x >= 0 ? 1 : -1); l.avatar.root.position.x += (l.x >= 0 ? 1 : -1) * dt * 1.8; }\n        l.avatar.update(dt);\n        if (l.leaveT > 6) l.avatar.root.visible = false;\n      } else if (l.ghost) {\n        // Hide a ghost that's in a different part of the round.\n        l.avatar.root.visible = this.phase !== 'play' || l.driver.area === this.area;\n      }\n    }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    switch (this.phase) {\n      case 'card': this.drawCard(ctx); return;\n      case 'intro': this.drawIntro(ctx); return;\n      case 'countdown': {\n        const n = Math.max(1, Math.ceil(-this.hub.time() / 1000));\n        sayCentered(hud, hud.width / 2, Math.round(hud.height * 0.32), String(n), { scale: 5, color: 'sand', name: 'count' });\n        this.drawNames(ctx);\n        return;\n      }\n      case 'play': this.drawPlay(ctx); return;\n      case 'waiting':\n        panel(hud, Math.round(hud.width / 2) - 100, 40, 200, 34, { fill: 'white', name: 'waiting' });\n        sayCentered(hud, hud.width / 2, 46, 'Thank you. I have written that down.', { color: 'ink', shadow: false, name: 'waiting-text' });\n        sayCentered(hud, hud.width / 2, 58, `Your score: ${this.scoreOf(this.me)}`, { color: 'teal', shadow: false, name: 'waiting-score' });\n        this.drawNames(ctx);\n        return;\n      case 'podium': this.drawPodium(ctx); return;\n      default:\n    }\n  }\n\n  drawNames(ctx) {\n    const { hud } = ctx;\n    for (const lane of this.lanes) {\n      if (lane.gone && lane.leaveT > 3) continue;\n      if (!lane.avatar.root.visible) continue;\n      const v = new Vector3(lane.avatar.root.position.x, lane.avatar.root.position.y + 2.05, lane.avatar.root.position.z).project(ctx.camera.camera);\n      const x = (v.x + 1) * 0.5 * hud.width, y = (1 - v.y) * 0.5 * hud.height;\n      const name = sanitize(lane.name).slice(0, 10);\n      const w = textWidth(name) + 6;\n      const bx = Math.max(2, Math.min(hud.width - w - 2, Math.round(x - w / 2)));\n      hud.rect(bx, Math.round(y) + 2, w, 11, lane.hex ?? 'navy');\n      say(hud, bx + 3, Math.round(y) + 4, name, { color: 'white', name: 'lane-name' });\n    }\n  }\n\n  drawCard(ctx) {\n    const { hud } = ctx;\n    const c = this.cardState ?? {};\n    const cx = Math.round(hud.width / 2);\n    const scale = hud.width >= 300 ? 3 : 2;\n    hud.rect(cx - Math.round(textWidth(TITLE, scale) / 2) - 6, 6, textWidth(TITLE, scale) + 12, 9 * scale + 6, 'navy');\n    sayCentered(hud, cx, 9, TITLE, { scale, color: 'white', name: 'title' });\n    const y0 = 44;\n    const w = Math.min(hud.width - 24, 330);\n    const x = Math.round((hud.width - w) / 2);\n    panel(hud, x, y0, w, 46, { fill: 'white', name: 'card-panel' });\n    sayCentered(hud, cx, y0 + 4, 'Score the most across three events.', { color: 'ink', shadow: false, name: 'card-goal' });\n    sayCentered(hud, cx, y0 + 15, 'Stay in the circle.', { color: 'teal', shadow: false, name: 'card-goal' });\n    const events = this.picks.map((p) => ACTIVITIES[p].name).join(', ');\n    sayCentered(hud, cx, y0 + 30, events.slice(0, Math.floor((w - 10) / 6)), { color: 'slate', shadow: false, name: 'card-events' });\n    this.drawNames(ctx);\n    // Ready ticks.\n    const ready = new Set(c.ready ?? []);\n    let rx = x;\n    for (const lane of this.lanes) {\n      const on = ready.has(lane.seat);\n      const name = sanitize(lane.name).slice(0, 8);\n      const tw = textWidth(name) + 18;\n      if (rx + tw > x + w) break;\n      hud.rect(rx, y0 + 50, tw, 12, on ? lane.hex : 'navy');\n      say(hud, rx + 3, y0 + 52, on ? `${name} ok` : name, { color: 'white', shadow: false, name: 'ready-tick' });\n      rx += tw + 4;\n    }\n    const left = c.left === null || c.left === undefined ? '' : `${Math.ceil(c.left / 1000)}s`;\n    if (left) sayRight(hud, x + w, 10, left, { scale: 2, color: 'sand', name: 'card-left' });\n    if (c.paused) sayCentered(hud, cx, y0 + 66, 'Waiting. Somebody asked for more time.', { color: 'sand', name: 'card-paused' });\n    // Controls for the last device, and Ready / More time.\n    promptBar(hud, App.device, [['lean', 'Lean'], ['breath', 'Breathe'], ['stepL', 'Left'], ['stepR', 'Right']], { y: hud.height - 34 });\n    promptBar(hud, App.device, [['confirm', this.answered ? 'Ready!' : 'Ready'], ['more', c.asked ? 'Never mind' : 'More time']]);\n    const by = hud.height - 20;\n    this.cardButtons = { ready: { x: 0, y: by, w: cx, h: 20 }, more: { x: cx, y: by, w: cx, h: 20 } };\n  }\n\n  drawIntro(ctx) {\n    const { hud } = ctx;\n    const cx = Math.round(hud.width / 2);\n    hud.rect(cx - 90, 10, 180, 24, 'navy');\n    sayCentered(hud, cx, 14, 'The Medley', { scale: 2, color: 'white', name: 'title' });\n    const w = Math.min(hud.width - 24, 300);\n    panel(hud, cx - Math.round(w / 2), 40, w, this.picks.length * 11 + 8, { fill: 'white', name: 'intro-panel' });\n    this.picks.forEach((id, i) => sayCentered(hud, cx, 44 + i * 11, `${i + 1}. ${ACTIVITIES[id].name}`, { color: 'ink', shadow: false, name: 'intro-event' }));\n    this.drawNames(ctx);\n  }\n\n  drawPlay(ctx) {\n    const { hud } = ctx;\n    const t = this.clock.now();\n    // Standings along the top: one small cell a player.\n    this.drawStandings(ctx);\n    if (this.current) {\n      this.current.draw(ctx, this.eventT ?? 0);\n      const left = Math.ceil(MEDLEY.eventSeconds - (this.eventT ?? 0));\n      sayCentered(hud, hud.width / 2, hud.height - 12, `${ACTIVITIES[this.picks[this.area]].name}  ${left}s`, { color: 'white', name: 'event-name' });\n    } else {\n      const next = Math.floor(t / WINDOW) + 1;\n      const until = Math.ceil(next * WINDOW - t);\n      const w = Math.min(hud.width - 24, 300);\n      const cx = Math.round(hud.width / 2);\n      panel(hud, cx - Math.round(w / 2), 34, w, 42, { fill: 'white', name: 'break' });\n      sayCentered(hud, cx, 38, `Next: ${ACTIVITIES[this.picks[next]]?.name ?? ''}`, { color: 'teal', shadow: false, name: 'next-event' });\n      sayCentered(hud, cx, 50, this.breakRemark ?? '', { color: 'ink', shadow: false, name: 'break-remark' });\n      sayCentered(hud, cx, 62, `${until}s`, { color: 'slate', shadow: false, name: 'break-count' });\n    }\n    this.drawNames(ctx);\n  }\n\n  drawStandings(ctx) {\n    const { hud } = ctx;\n    const cells = this.lanes;\n    const w = Math.min(Math.floor((hud.width - 16) / cells.length) - 2, 112);\n    const total = cells.length * (w + 2) - 2;\n    let x = Math.round((hud.width - total) / 2);\n    for (const lane of cells) {\n      hud.rect(x, 3, w, 12, lane.gone ? 'slate' : lane.hex ?? 'navy');\n      const name = sanitize(lane.name).slice(0, Math.max(3, Math.floor((w - 34) / 6)));\n      say(hud, x + 2, 5, name, { color: 'white', shadow: false, name: 'standing' });\n      sayRight(hud, x + w - 2, 5, String(this.scoreOf(lane)), { color: 'white', shadow: false, name: 'standing-score' });\n      x += w + 2;\n    }\n  }\n\n  drawPodium(ctx) {\n    const { hud } = ctx;\n    const cx = Math.round(hud.width / 2);\n    hud.rect(cx - 90, 6, 180, 24, 'navy');\n    sayCentered(hud, cx, 10, 'The Podium', { scale: 2, color: 'white', name: 'title' });\n    const w = Math.min(hud.width - 24, 330);\n    const x = cx - Math.round(w / 2);\n    panel(hud, x, 34, w, this.order.length * 12 + 8, { fill: 'white', name: 'podium-panel' });\n    this.order.forEach((lane, i) => {\n      const y = 38 + i * 12;\n      const medal = ['sand', 'mist', 'orange', 'slate'][i];\n      star(hud, x + 5, y, true);\n      hud.rect(x + 5 + STAR_W + 2, y + 1, 3, 7, medal);\n      say(hud, x + 24, y, `${sanitize(lane.name).slice(0, 10)}  ${lane.total}`, { color: 'ink', shadow: false, name: 'podium-row' });\n      const a = this.awards[i];\n      if (a && w > 240) sayRight(hud, x + w - 5, y, a.title, { color: 'teal', shadow: false, name: 'podium-award' });\n    });\n    if (this.menu) {\n      this.menu.o.y = Math.max(34 + this.order.length * 12 + 14, hud.height - 22 - 34 - 30);\n      this.menu.draw(ctx);\n    }\n    promptBar(hud, App.device, [['confirm', 'Select']]);\n  }\n\n  overlayDot() { const l = this.me; return l ? `${l.dot.x.toFixed(2)},${l.dot.y.toFixed(2)} area ${this.area}` : '-'; }\n  status() {\n    const t = this.clock?.now?.() ?? 0;\n    return `medley | ${this.phase} | area ${this.area} | t ${Number.isFinite(t) ? t.toFixed(1) : 'waiting'} | ${(this.lanes ?? []).map((l) => this.scoreOf(l)).join(',')}`;\n  }\n  fingerprint() { return (this.lanes ?? []).map((l) => (l.ghost ? '' : `${l.total}|${l.dot.x.toFixed(4)}`)).join(';'); }\n\n  dispose() {\n    this.ghostSender?.stop();\n    for (const off of this.offs ?? []) off?.();\n    if (this.keyHandler && typeof window !== 'undefined') window.removeEventListener('keydown', this.keyHandler);\n  }\n}\n\nconst round3 = (v) => Math.round(v * 1000) / 1000;\nexport { SONGS };\nEOF\ncat > src/scenes/join.js <<'EOF'\n// Family Hour: each device claims a mat by pressing Cross or Enter. Up to 4 pads plus keyboard and mouse.\nimport { App } from '../app.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { place } from '../art/props.js';\nimport { PRESET_LOOKS } from '../data/classmates.js';\nimport { SEAT_COLORS, SEAT_PALETTE } from '../core/net.js';\nimport { say, sayCentered } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading } from '../ui/widgets.js';\nimport { BaseScene, laneCamera } from './base.js';\nimport { box, plazaSet } from './sets.js';\n\nconst MATS = [-3, -1, 1, 3];\n\nexport class JoinScene extends BaseScene {\n  name = 'join';\n  id = 'join';\n  allowsAttract = true;\n  canPause = false;\n  seats = [null, null, null, null];\n  bots = true;\n  prevPads = [];\n  avatars = [];\n\n  cameraConfig() { return laneCamera(4); }\n\n  async build(ctx) {\n    plazaSet(ctx, 11);\n    box(ctx, 14, 0.14, 4, [0, 0.04, 0.8], 'white', { cast: false });\n    for (let i = 0; i < 4; i++) {\n      place(ctx, 'yoga-mat', { at: [MATS[i], 0, 0.8], palette: { mat: SEAT_PALETTE[i] }, shadow: false });\n      const a = await makeAvatar(ctx, PRESET_LOOKS[i], { at: [MATS[i], 0.05, 0.8], clip: 'Idle' });\n      a.root.visible = false;\n      if (a.shadow) a.shadow.visible = false;\n      this.avatars.push(a);\n    }\n    App.music('title');\n  }\n\n  /** The pads, read by index: the engine merges them into one. */\n  pads() {\n    if (typeof navigator === 'undefined' || !navigator.getGamepads) return [];\n    return [...navigator.getGamepads()];\n  }\n\n  seatOf(kind, index = 0) { return this.seats.findIndex((s) => s && s.kind === kind && (kind !== 'pad' || s.index === index)); }\n\n  claim(device) {\n    const free = this.seats.findIndex((s) => !s);\n    if (free < 0) return;\n    this.seats[free] = device;\n    const a = this.avatars[free];\n    a.root.visible = true;\n    if (a.shadow) a.shadow.visible = true;\n    a.play('Wave', { once: true, fade: 0.1, then: () => a.play('Idle', { fade: 0.2 }) });\n    a.squash.kick(1);\n    App.sfx('menuConfirm', { pitch: free * 2 });\n    this.idle = 0;\n  }\n\n  drop(i) {\n    this.seats[i] = null;\n    const a = this.avatars[i];\n    a.root.visible = false;\n    if (a.shadow) a.shadow.visible = false;\n    App.sfx('menuBack');\n  }\n\n  begin() {\n    const list = [];\n    this.seats.forEach((s, i) => {\n      if (s) list.push({ ...s, name: `Player ${i + 1}`, look: PRESET_LOOKS[i] });\n      else if (this.bots) list.push({ kind: 'bot', skill: ['good', 'sloppy', 'expert', 'average'][i], look: undefined });\n    });\n    App.sfx('countGo');\n    App.go('medley', { family: list });\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    const joined = this.seats.filter(Boolean).length;\n    // Keyboard and mouse claim one mat between them.\n    if (input.wasPressed('Enter')) {\n      const k = this.seatOf('keyboard');\n      if (k < 0) this.claim({ kind: 'keyboard' });\n      else this.begin();\n      return;\n    }\n    if (input.wasPressed('Escape', 'Backspace')) {\n      const k = this.seatOf('keyboard');\n      if (k >= 0) this.drop(k);\n      else App.go('title', { menu: 'main' });\n      return;\n    }\n    if (input.wasPressed('KeyT') || input.wasPressed('KeyB')) { this.bots = !this.bots; App.sfx('menuMove'); }\n    if (input.wasPressed('MouseLeft')) {\n      const p = App.device.pointerArt(ctx);\n      const r = this.startRect;\n      if (r && p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h && joined) this.begin();\n      else if (this.seatOf('keyboard') < 0) this.claim({ kind: 'keyboard' });\n    }\n    if (input.wasPressed('MouseRight')) {\n      const k = this.seatOf('keyboard');\n      if (k >= 0) this.drop(k); else App.go('title', { menu: 'main' });\n      return;\n    }\n    // Each pad, by its own index.\n    const pads = this.pads();\n    pads.forEach((pad, i) => {\n      if (!pad) return;\n      const was = this.prevPads[i] ?? {};\n      const is = { cross: !!pad.buttons[0]?.pressed, circle: !!pad.buttons[1]?.pressed, square: !!pad.buttons[2]?.pressed, options: !!pad.buttons[9]?.pressed, create: !!pad.buttons[8]?.pressed };\n      const seat = this.seatOf('pad', i);\n      if (is.cross && !was.cross) { if (seat < 0) this.claim({ kind: 'pad', index: i }); else if (this.seats.filter(Boolean).length) this.begin(); }\n      if (is.circle && !was.circle) { if (seat >= 0) this.drop(seat); else App.go('title', { menu: 'main' }); }\n      if (is.square && !was.square) { this.bots = !this.bots; App.sfx('menuMove'); }\n      if (is.options && !was.options && !is.create && this.seats.filter(Boolean).length) this.begin();\n      this.prevPads[i] = is;\n    });\n  }\n\n  onUpdate(ctx, dt) {\n    for (const a of this.avatars) a.update(dt);\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    heading(hud, 'Family Hour', 10);\n    const cx = Math.round(hud.width / 2);\n    sayCentered(hud, cx, 34, 'Press your confirm button to take a mat.', { color: 'white', name: 'join-help' });\n    const cell = Math.min(Math.floor((hud.width - 28) / 4) - 2, 100);\n    const total = 4 * (cell + 2) - 2;\n    let x = Math.round((hud.width - total) / 2);\n    const y = 48;\n    this.seats.forEach((s, i) => {\n      hud.rect(x, y, cell, 26, s ? SEAT_COLORS[i] : 'navy');\n      say(hud, x + 3, y + 3, `Mat ${i + 1}`, { color: 'white', shadow: false, name: 'seat' });\n      const who = s ? (s.kind === 'pad' ? `Pad ${s.index + 1}` : 'Keys+mouse') : this.bots ? 'Bot' : 'Empty';\n      say(hud, x + 3, y + 14, who.slice(0, Math.floor((cell - 4) / 6)), { color: s ? 'white' : 'mist', shadow: false, name: 'seat-who' });\n      x += cell + 2;\n    });\n    const joined = this.seats.filter(Boolean).length;\n    if (joined) {\n      const w = 110;\n      this.startRect = { x: cx - Math.round(w / 2), y: y + 30, w, h: 16 };\n      hud.rect(this.startRect.x, this.startRect.y, w, 16, 'cyan');\n      sayCentered(hud, cx, y + 34, 'Start the Medley', { color: 'ink', shadow: false, name: 'join-start' });\n    } else this.startRect = null;\n    const list = joined ? [['confirm', 'Start'], ['sit', this.bots ? 'Bots: on' : 'Bots: off'], ['back', 'Leave']] : [['confirm', 'Join'], ['sit', this.bots ? 'Bots: on' : 'Bots: off'], ['back', 'Back']];\n    promptBar(hud, App.device, list);\n  }\n\n  status() { return `join | seats ${this.seats.map((s) => (s ? s.kind : '-')).join(',')} | bots ${this.bots}`; }\n}\nEOF\npython3 - <<'EOF'\np='src/scenes/index.js'; s=open(p).read()\ns=s.replace(\"\"\"import { ViewerScene } from './viewer.js';\"\"\",\"\"\"import { ViewerScene } from './viewer.js';\nimport { MedleyScene } from './medley.js';\nimport { JoinScene } from './join.js';\"\"\")\ns=s.replace(\"\"\"  viewer: (a) => new ViewerScene(a),\"\"\",\"\"\"  viewer: (a) => new ViewerScene(a),\n  medley: (a) => new MedleyScene(a),\n  join: (a) => new JoinScene(a),\"\"\")\nopen(p,'w').write(s)\np='src/main.js'; s=open(p).read()\ns=s.replace(\"App.applyDeadzone = applyDeadzone;\",\"App.deadzone = (x, y) => { const v = applyDeadzone(x, y, 0.12); return Array.isArray(v) ? v : [v.x, v.y]; };\")\nopen(p,'w').write(s)\np='src/data/jog.js'; s=open(p).read()\ns=s.replace(\"hitRadius: 0.75,\",\"hitRadius: 0.6,\")\ns=s.replace(\"[-13, -6.2], [-20, -7], [-20.6, 1], [-20.2, 10], [-15, 15],\",\"[-13, -6.2], [-20, -7], [-16.5, -3.2], [-20.6, 1], [-20.2, 10], [-14.5, 9.4], [-18, 13.4], [-15, 15],\")\nopen(p,'w').write(s)\np='src/scenes/activity/jog.js'; s=open(p).read()\ns=s.replace(\"\"\"    const nominal = this.length / JOG.speed;\n    const pace\"\"\",\"\"\"    const nominal = (this.length / JOG.speed) * 0.92; // starting from a standstill takes a moment\n    const pace\"\"\")\nopen(p,'w').write(s)\np='src/data/boards.js'; s=open(p).read()\ns=s.replace(\"{ name: 'Morning Dose', count: 8,\",\"{ name: 'Morning Dose', count: 8, active: 3,\")\ns=s.replace(\"{ name: 'Second Opinion', count: 8,\",\"{ name: 'Second Opinion', count: 8, active: 2,\")\ns=s.replace(\"{ name: 'Full Prescription', count: 8,\",\"{ name: 'Full Prescription', count: 8, active: 3,\")\nopen(p,'w').write(s)\np='src/scenes/activity/tray.js'; s=open(p).read()\ns=s.replace(\"\"\"      v.done = false; v.wait = 0;\n      const p = this.spawnPos(v.i);\n      v.body.setTranslation({ x: p[0], y: p[1], z: p[2] }, true);\n      v.body.setLinvel({ x: 0, y: 0, z: 0 }, true);\n      v.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n      v.body.setEnabled(true);\n      v.mesh.visible = true;\n    }\n  }\n\"\"\",\"\"\"      v.done = false; v.wait = 0; v.queued = true;\n      v.body.setEnabled(false);\n      v.mesh.visible = false;\n    }\n    this.releaseNext();\n  }\n\n  /** A few at a time: the board is a maze for two or three pills, not a stampede. */\n  releaseNext() {\n    const live = this.vits.filter((v) => !v.done && !v.queued).length;\n    let room = (this.board.active ?? 3) - live;\n    for (const v of this.vits) {\n      if (room <= 0) break;\n      if (!v.done && v.queued) { v.queued = false; v.wait = 0; this.respawnVit(v); room--; }\n    }\n  }\n\"\"\")\ns=s.replace(\"\"\"    for (const v of this.vits) {\n      if (v.done) continue;\n      if (v.wait > 0) {\"\"\",\"\"\"    for (const v of this.vits) {\n      if (v.done || v.queued) continue;\n      if (v.wait > 0) {\"\"\")\ns=s.replace(\"\"\"    if (scoring) { this.score += 10; this.correct++; }\n    App.sfx('vitaminIn', { pitch: this.correct });\n    ctx.particles.burst('sparkle', [c.x, 0.6, c.z], { count: 8 });\"\"\",\"\"\"    if (scoring) { this.score += 10; this.correct++; }\n    App.sfx('vitaminIn', { pitch: this.correct });\n    ctx.particles.burst('sparkle', [c.x, 0.6, c.z], { count: 8 });\n    this.releaseNext();\"\"\")\ns=s.replace(\"\"\"    for (const v of this.vits) {\n      if (v.done || v.wait > 0) continue;\n      const p = v.body.translation(), q = v.body.rotation();\"\"\",\"\"\"    for (const v of this.vits) {\n      if (v.done || v.wait > 0 || v.queued) continue;\n      const p = v.body.translation(), q = v.body.rotation();\"\"\")\ns=s.replace(\"\"\"    let best = this.botVit && !this.botVit.done && this.botVit.wait <= 0 ? this.botVit : null;\n    let cup = null, bestD = Infinity;\n    const pool = best ? [best] : this.vits;\n    for (const v of pool) {\n      if (v.done || v.wait > 0) continue;\"\"\",\"\"\"    let best = this.botVit && !this.botVit.done && !this.botVit.queued && this.botVit.wait <= 0 ? this.botVit : null;\n    let cup = null, bestD = Infinity;\n    const pool = best ? [best] : this.vits;\n    for (const v of pool) {\n      if (v.done || v.wait > 0 || v.queued) continue;\"\"\")\ns=s.replace(\"\"\"    const p = best.body.translation(), vel = best.body.linvel();\n    const k = 0.36 * play.speed, kd = 0.38;\n    const t = this.time;\n    out.x = (cup.x - p.x) * k - vel.x * kd + Math.sin(t * 2.3) * play.wander * 1.2;\n    out.y = -(cup.z - p.z) * k + vel.z * kd + Math.sin(t * 1.9) * play.wander * 1.2;\"\"\",\"\"\"    const p = best.body.translation(), vel = best.body.linvel();\n    // Round the walls: aim for the next cell on the shortest way to the cup.\n    const way = this.nextCell(p.x, p.z, cup);\n    const k = 0.5 * play.speed, kd = 0.42;\n    const t = this.time;\n    out.x = (way.x - p.x) * k - vel.x * kd + Math.sin(t * 2.3) * play.wander * 1.2;\n    out.y = -(way.z - p.z) * k + vel.z * kd + Math.sin(t * 1.9) * play.wander * 1.2;\"\"\")\ns=s.replace(\"\"\"  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    const dial\"\"\",\"\"\"  /** Breadth-first over the board's cells, keeping off the wrong cups. */\n  nextCell(px, pz, cup) {\n    const rows = this.board.rows, h = rows.length, w = rows[0].length, cell = TRAY_CELL;\n    const toCell = (x, z) => [Math.max(0, Math.min(w - 1, Math.floor((x + this.halfW) / cell))), Math.max(0, Math.min(h - 1, Math.floor((z + this.halfD) / cell)))];\n    const [sx, sz] = toCell(px, pz);\n    const [tx, tz] = toCell(cup.x, cup.z);\n    const key = (x, z) => z * w + x;\n    const prev = new Map([[key(tx, tz), -1]]);\n    const queue = [[tx, tz]];\n    const open = (x, z) => {\n      if (x < 0 || z < 0 || x >= w || z >= h) return false;\n      const ch = rows[z][x];\n      if (ch === '#' || ch === '_') return false;\n      return !COLORS[ch] || (x === tx && z === tz);\n    };\n    while (queue.length) {\n      const [x, z] = queue.shift();\n      if (x === sx && z === sz) break;\n      for (const [dx, dz] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {\n        const nx = x + dx, nz = z + dz;\n        if (!open(nx, nz) || prev.has(key(nx, nz))) continue;\n        prev.set(key(nx, nz), key(x, z));\n        queue.push([nx, nz]);\n      }\n    }\n    const step = prev.get(key(sx, sz));\n    if (step === undefined || step < 0) return { x: cup.x, z: cup.z };\n    const nz = Math.floor(step / w), nx = step - nz * w;\n    return { x: (nx + 0.5) * cell - this.halfW, z: (nz + 0.5) * cell - this.halfD };\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    const dial\"\"\")\nopen(p,'w').write(s)\nEOF\ntimeout 250 node .scratch/acts2.mjs </dev/null 2>&1 | tail -8 | cut -c1-320","description":"Write Medley and Family Hour, rework Tray to release pills gradually with a pathfinding bot","timeout":300000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5492,"cache_read_input_tokens":519546,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5492},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"c18e99d5-8c64-44cb-9396-3e3a05dc50cf","timestamp":"2026-11-05T07:03:26.437Z","request_id":"req_011CgjMGpZingQwKkiZPXn4C","wire_tool_inputs":{"toolu_0153ADDVBztYVexaKU1grUdW":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\nsed -n 2242,2252p API.md | cut -c1-200\ncat > src/core/clock.js <<'EOF'\n// The Medley's clock. In a session it reads the hub's timeline, so all copies stay in step.\nexport class MedleyClock {\n  local = 0;\n  constructor(hub = null) { this.hub = hub; }\n  tick(dt) { this.local += dt; }\n  /** Seconds since play began; negative in the countdown. */\n  now() {\n    if (this.hub) return this.hub.time() / 1000;\n    return this.local;\n  }\n}\nEOF\ncat > src/core/net.js <<'EOF'\n// The only network: the AI Hub client, when a hub opened the page.\nexport const hub = () => (typeof globalThis !== 'undefined' ? globalThis.AIHub : undefined);\nexport const SEAT_COLORS = [0xe8443a, 0x3b82f6, 0x22c55e, 0xf5b700];\nexport const SEAT_PALETTE = ['red', 'blue', 'green', 'sand'];\n\n/** Ghosts: 100 ms, not tied to rendering. Start as soon as `start` arrives, even with score 0. */\nexport class GhostSender {\n  timer = null;\n  start(getState, h = hub()) {\n    if (this.timer || !h) return;\n    this.timer = setInterval(() => {\n      const s = getState();\n      if (!s) return;\n      h.send({ a: s.area, x: s.x, y: s.y, c: s.clip, t: s.time, s: s.score }, { reliable: false });\n      h.progress({ score: s.score, label: s.label });\n    }, 100);\n  }\n  stop() { if (this.timer) clearInterval(this.timer); this.timer = null; }\n}\nEOF\ncat > src/scenes/medley.js <<'EOF'\n// The Medley: Stillness, then Beat, then Balance. Family Hour on one TV, AI Hub ghosts online.\nimport { Rng, THREE } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { MedleyClock } from '../core/clock.js';\nimport { BotDriver, GhostDriver, KeyboardDriver, LocalDriver, PadDriver } from '../core/drivers.js';\nimport { GhostSender, hub, SEAT_COLORS, SEAT_PALETTE } from '../core/net.js';\nimport { MORE_TIME } from '../core/actions.js';\nimport { Kevin, place } from '../art/props.js';\nimport { LOOKS, PRESET_LOOKS } from '../data/classmates.js';\nimport { MEDLEY } from '../data/medley.js';\nimport { ACTIVITIES } from '../data/activities.js';\nimport { TITLE } from '../data/title.js';\nimport { sanitize, say, sayCentered, sayRight, textWidth } from '../ui/font.js';\nimport { Menu } from '../ui/menu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { panel, star, STAR_W } from '../ui/widgets.js';\nimport { BaseScene, laneCamera } from './base.js';\nimport { buildLanes, playerInfo } from './activity/lanes.js';\nimport { PoseEvent } from './activity/poses.js';\nimport { RepsEvent } from './activity/reps.js';\nimport { HoopEvent } from './activity/hoop.js';\nimport { StepEvent, STEP_CHART_MEDLEY } from './activity/step.js';\nimport { buildHeaderProps, HeaderEvent } from './activity/header.js';\nimport { box, plazaSet } from './sets.js';\nimport { SONGS, stepSongFrom } from '../audio/songs.js';\n\nconst { Vector3 } = THREE;\nconst LOOK_ORDER = [LOOKS.june, LOOKS.dennis, LOOKS.marguerite, PRESET_LOOKS[1]];\nconst WINDOW = MEDLEY.eventSeconds + MEDLEY.breakSeconds;\nexport const MEDLEY_LENGTH = MEDLEY.events.length * MEDLEY.eventSeconds + (MEDLEY.events.length - 1) * MEDLEY.breakSeconds;\n\nconst SONG_FOR = { pose: 'hold', reps: 'rep', hoop: 'hoop', step: 'step', header: 'lagoon' };\n\nexport class MedleyScene extends BaseScene {\n  name = 'medley';\n  id = 'medley';\n  canPause = true;\n  centreDial = false;\n  phase = 'intro';\n  area = -1;\n  phaseT = 0;\n  ended = false;\n  resultSent = false;\n\n  constructor(args = {}) {\n    super(args);\n    this.session = !!args.session;\n    this.family = args.family ?? null;\n    this.pauseToTitle = !this.session;\n  }\n\n  cameraConfig() { return laneCamera(4); }\n\n  async build(ctx) {\n    plazaSet(ctx, 11);\n    box(ctx, 14, 0.14, 4, [0, 0.04, 0.8], 'white', { cast: false });\n    place(ctx, 'class-rail', { at: [0, 0, -3.1], params: { len: 14 } });\n    this.kevin = new Kevin(ctx, { at: [-4.8, 1.11, -3.1], yaw: 0.4 });\n    this.cosmetic = ctx.random.fork('cosmetic');\n    this.rngPick = ctx.random.fork('medley-picks');\n    this.hub = this.session ? hub() : null;\n    this.clock = new MedleyClock(this.hub);\n    this.ghostSender = new GhostSender();\n    const rand = (() => { const r = ctx.random.fork('bots'); return () => r.next(); })();\n    this.lanes = await buildLanes(ctx, this.specs(rand), { rand, xs: this.seatXs() });\n    for (const l of this.lanes) { l.points = []; l.total = 0; l.lastNorm = 0; }\n    this.local = this.lanes.filter((l) => l.isLocal);\n    this.me = this.lanes.find((l) => l.isMe) ?? this.local[0] ?? null;\n    this.playerLane = this.me;\n    // Picks come from a seeded stream, so all copies choose the same.\n    this.picks = MEDLEY.events.map((e) => this.args.picks?.[e.kind] ?? this.rngPick.pick(e.options));\n    this.events = this.picks.map((id, i) => this.makeEvent(id, i));\n    for (const lane of this.lanes) {\n      if (!lane.ghost) await buildHeaderProps(ctx, lane);\n      lane.hoopMeshes = [0, 1, 2, 3].map((i) => {\n        const m = place(ctx, 'hoop', { palette: { hoop: ['red', 'sky', 'lime', 'sand'][i] }, actor: true, shadow: false }).object;\n        m.visible = false;\n        return m;\n      });\n    }\n    this.current = null;\n    App.music(this.session ? 'title' : 'title');\n    if (this.session) this.connectHub(); else this.enterPhase('intro');\n  }\n\n  seatXs() {\n    const n = this.session ? (App.session?.players.length ?? 1) : (this.family?.length ?? 1);\n    return [[0], [-1, 1], [-2.2, 0, 2.2], [-3, -1, 1, 3]][n - 1] ?? [-3, -1, 1, 3];\n  }\n\n  specs(rand) {\n    if (this.session) {\n      const info = App.session;\n      return info.players.map((p, i) => {\n        const mine = p.id === info.me;\n        return { name: p.name, look: LOOK_ORDER[i % LOOK_ORDER.length], driver: mine ? new LocalDriver() : new GhostDriver(), isLocal: mine, isMe: mine, isPlayer: mine, color: 'red', seat: p.id, matColor: SEAT_PALETTE[i], hex: SEAT_COLORS[i] };\n      });\n    }\n    const list = this.family ?? [{ kind: 'keyboard' }];\n    const playerI = playerInfo();\n    return list.map((f, i) => {\n      let driver;\n      if (f.kind === 'pad') driver = new PadDriver(f.index, (x, y) => App.deadzone(x, y));\n      else if (f.kind === 'bot') driver = new BotDriver(f.skill ?? 'average', rand);\n      else driver = new KeyboardDriver();\n      const human = f.kind !== 'bot';\n      return { name: f.name ?? (human ? `Player ${i + 1}` : ['June', 'Dennis', 'Marguerite', 'Kevin'][i]), look: f.look ?? (i === 0 && App.slot ? playerI.look : PRESET_LOOKS[i]), driver, isLocal: human, isPlayer: false, color: 'red', seat: i, matColor: SEAT_PALETTE[i], hex: SEAT_COLORS[i] };\n    });\n  }\n\n  makeEvent(id, i) {\n    const def = ACTIVITIES[id];\n    const rng = this.ctx.random.fork(`event:${i}`);\n    const opts = { hard: {}, duration: MEDLEY.eventSeconds };\n    if (def.family === 'pose') return new PoseEvent(this, this.lanes, rng, { pose: def.pose, hard: {}, hold: MEDLEY.poseHold, settle: 4, release: 2 });\n    if (def.family === 'reps') return new RepsEvent(this, this.lanes, rng, { rep: def.rep, hard: {}, reps: MEDLEY.repsCount, extra: 0, duration: MEDLEY.eventSeconds });\n    if (def.family === 'hoop') return new HoopEvent(this, this.lanes, rng, opts);\n    if (def.family === 'step') return new StepEvent(this, this.lanes, rng, { ...opts, chart: STEP_CHART_MEDLEY });\n    return new HeaderEvent(this, this.lanes, rng, { ...opts, range: 0.8 });\n  }\n\n  // ---- The hub ----------------------------------------------------------------------------\n\n  connectHub() {\n    const h = this.hub;\n    this.enterPhase('card');\n    this.cardState = { left: null, ready: [], asking: 0, asked: false, paused: false, starting: false };\n    this.offs = [\n      h.on('card', (c) => { this.cardState = c; }),\n      h.on('start', () => this.onStart()),\n      h.on('message', (d, from) => this.onMessage(d, from)),\n      h.on('leave', (e) => this.onLeave(e)),\n      h.on('time-up', () => this.sendResult()),\n      h.on('end', () => this.onEnd()),\n    ];\n    // Enter answers Ready: a direct listener, because the card has no menus.\n    this.keyHandler = (e) => {\n      if (this.phase !== 'card') return;\n      if (e.key === 'Enter') { this.answered = true; h.answer('ready'); }\n      if (e.key === 'm' || e.key === 'M') h.answer('more');\n    };\n    if (typeof window !== 'undefined') window.addEventListener('keydown', this.keyHandler);\n  }\n\n  onStart() {\n    if (this.started) return;\n    this.started = true;\n    this.enterPhase('countdown');\n    this.ghostSender.start(() => this.ghostState(), this.hub);\n  }\n\n  ghostState() {\n    if (this.ended) return null;\n    const lane = this.me;\n    if (!lane) return null;\n    const ev = this.current;\n    const [c, t] = ev ? ev.clipState(lane) : [0, 0];\n    const score = this.scoreOf(lane);\n    return { area: this.area, x: round3(lane.dot?.x ?? 0), y: round3(lane.dot?.y ?? 0), clip: c, time: round3(t), score, label: ev ? ACTIVITIES[this.picks[this.area]]?.name ?? '' : TITLE };\n  }\n\n  onMessage(d, from) {\n    if (this.ended) return;\n    const lane = this.lanes.find((l) => l.seat === from);\n    if (!lane || !lane.ghost) return;\n    lane.driver.receive(d);\n    lane.score = lane.driver.score;\n  }\n\n  /** That avatar waves and walks off. The round goes on, host included. */\n  onLeave(e) {\n    const lane = this.lanes.find((l) => l.seat === e.id);\n    if (!lane || lane.gone) return;\n    lane.gone = true;\n    lane.leaveT = 0;\n    lane.avatar.play('Wave', { fade: 0.2 });\n  }\n\n  sendResult() {\n    if (this.resultSent || !this.hub) return;\n    this.resultSent = true;\n    const lane = this.me;\n    const score = this.scoreOf(lane);\n    const stats = {};\n    this.picks.forEach((id, i) => { stats[ACTIVITIES[id].name] = lane.points[i] ?? 0; });\n    this.hub.result({ score, stats, awards: this.awardsFor(lane) });\n    this.enterPhase('waiting');\n  }\n\n  onEnd() {\n    this.ended = true;\n    this.ghostSender.stop();\n    this.ctx.audio.stopMusic();\n    this.ctx.audio.stopLoops();\n    App.voice.stop();\n  }\n\n  awardsFor(lane) {\n    const a = MEDLEY.awards;\n    const out = [];\n    const pts = lane.points;\n    if ((pts[0] ?? 0) >= 700) out.push(a.stillest);\n    if ((pts[1] ?? 0) >= 700) out.push(a.beat);\n    if ((pts[2] ?? 0) >= 500) out.push(a.headed);\n    if (!out.length) out.push(a.apologetic);\n    return out.map((x) => ({ title: x.title, detail: x.detail }));\n  }\n\n  // ---- The round ----------------------------------------------------------------------------\n\n  enterPhase(p) {\n    this.phase = p;\n    this.phaseT = 0;\n    if (p === 'podium') this.buildPodium();\n  }\n\n  scoreOf(lane) {\n    if (!lane) return 0;\n    if (lane.ghost) return lane.driver.score;\n    const live = this.current && this.current.lanes.includes(lane) && this.phase === 'play' ? this.current.normalized(lane) : 0;\n    return Math.round(lane.total + live);\n  }\n\n  eventIndexAt(t) {\n    if (t < 0) return -1;\n    const i = Math.floor(t / WINDOW);\n    if (i >= this.events.length) return -2;\n    return t - i * WINDOW < MEDLEY.eventSeconds ? i : -1;\n  }\n\n  startEvent(i) {\n    this.area = i;\n    this.current = this.events[i];\n    this.current.begin();\n    const kind = this.current.kind;\n    if (kind === 'step') { this.ctx.audio.playMusic(stepSongFrom(0, 24), 'step'); App.songName = 'step'; } else App.music(SONG_FOR[kind] ?? 'title');\n    App.say('coach', ACTIVITIES[this.picks[i]].coach);\n    for (const l of this.lanes) { if (l.hoopMeshes) for (const m of l.hoopMeshes) m.visible = false; }\n    if (kind !== 'header') for (const l of this.lanes) { if (l.objects) for (const o of l.objects) { o.mesh.visible = false; o.shadow.visible = false; } l.avatar.root.position.x = l.x; }\n    if (kind === 'header') this.current.launchZ = -7;\n  }\n\n  closeEvent() {\n    const ev = this.current;\n    if (!ev) return;\n    for (const lane of this.lanes) {\n      if (lane.ghost) continue;\n      ev.finishLane?.(lane);\n      const pts = ev.normalized(lane);\n      lane.points[this.area] = pts;\n      lane.total += pts;\n    }\n    this.current = null;\n    this.area = -1;\n    this.breakRemark = this.cosmetic.pick(MEDLEY.remarks.middle);\n    for (const lane of this.lanes) if (!lane.gone) lane.avatar.play('Idle', { fade: 0.3 });\n    App.music('title');\n  }\n\n  onFixed(ctx, dt) {\n    if (this.ended) return;\n    this.phaseT += dt;\n    switch (this.phase) {\n      case 'intro':\n        if (this.phaseT >= MEDLEY.introSeconds) { this.enterPhase('play'); this.clock.local = 0; }\n        break;\n      case 'countdown':\n        if (this.hub.time() >= 0) this.enterPhase('play');\n        break;\n      case 'play': {\n        this.clock.tick(dt);\n        const t = this.clock.now();\n        const i = this.eventIndexAt(t);\n        if (i === -2) { this.closeEvent(); this.finishRound(); break; }\n        if (i !== this.area) {\n          if (this.area >= 0) this.closeEvent();\n          if (i >= 0) this.startEvent(i);\n        }\n        if (this.current) {\n          const et = t - this.area * WINDOW;\n          this.eventT = et;\n          this.current.step(ctx, dt, et, true);\n        }\n        break;\n      }\n      default:\n        break;\n    }\n  }\n\n  finishRound() {\n    if (this.session) { this.sendResult(); return; }\n    this.enterPhase('podium');\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (this.phase === 'card') {\n      if (input.wasPressed('PadCross')) { this.answered = true; this.hub.answer('ready'); }\n      if (input.wasPressed(...MORE_TIME)) this.hub.answer('more');\n      if (input.wasPressed('MouseLeft') && this.cardButtons) {\n        const p = App.device.pointerArt(ctx);\n        const hit = (r) => p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;\n        if (hit(this.cardButtons.ready)) { this.answered = true; this.hub.answer('ready'); }\n        if (hit(this.cardButtons.more)) this.hub.answer('more');\n      }\n    }\n    if (this.phase === 'podium' && this.menu) this.menu.update(ctx, 0);\n  }\n\n  buildPodium() {\n    const order = [...this.lanes].sort((a, b) => b.total - a.total);\n    this.order = order;\n    const steps = [[0, 0.9], [-1.6, 0.6], [1.6, 0.35], [3.2, 0.05]];\n    order.forEach((lane, i) => {\n      const [x, h] = steps[i] ?? [0, 0];\n      if (h > 0.06) box(this.ctx, 1.5, h, 1.4, [x, h / 2, -0.4], 'white');\n      lane.avatar.root.position.set(x, h, -0.4);\n      lane.avatar.groundY = h;\n      lane.avatar.root.rotation.y = 0;\n      lane.avatar.play(i === 0 ? 'Victory' : i === order.length - 1 ? 'Slump' : 'Wave', { fade: 0.3 });\n    });\n    App.sfx('fanfareSoft');\n    App.music('report');\n    const remark = order.length > 1 ? this.cosmetic.pick(MEDLEY.remarks.first) : this.cosmetic.pick(MEDLEY.remarks.middle);\n    App.say('ounce', remark);\n    this.awards = order.map((l) => this.awardsFor(l)[0]);\n    this.menu = new Menu([\n      { label: 'Rematch', id: 'rematch', action: () => App.go('medley', { ...this.args }) },\n      { label: 'Back to title', id: 'title', action: () => App.go('title', { menu: 'main' }) },\n    ], { width: 180, scale: 1, rowH: 15, align: 'center', y: 0 });\n    for (const l of this.lanes) { if (l.hoopMeshes) for (const m of l.hoopMeshes) m.visible = false; }\n  }\n\n  onUpdate(ctx, dt) {\n    this.kevin.update(dt);\n    if (this.current) this.current.visual(ctx, dt, this.eventT ?? 0);\n    else for (const l of this.lanes) {\n      if (l.ghost && !l.gone) l.driver.lerp(dt);\n      if (!l.gone || l.leaveT === undefined) l.avatar.update(dt);\n    }\n    for (const l of this.lanes) {\n      if (l.gone) {\n        l.leaveT += dt;\n        if (l.leaveT > 1.4) { l.avatar.play('Walk', { fade: 0.2 }); l.avatar.root.rotation.y = 1.57 * (l.x >= 0 ? 1 : -1); l.avatar.root.position.x += (l.x >= 0 ? 1 : -1) * dt * 1.8; }\n        l.avatar.update(dt);\n        if (l.leaveT > 6) l.avatar.root.visible = false;\n      } else if (l.ghost) {\n        // Hide a ghost that's in a different part of the round.\n        l.avatar.root.visible = this.phase !== 'play' || l.driver.area === this.area;\n      }\n    }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    switch (this.phase) {\n      case 'card': this.drawCard(ctx); return;\n      case 'intro': this.drawIntro(ctx); return;\n      case 'countdown': {\n        const n = Math.max(1, Math.ceil(-this.hub.time() / 1000));\n        sayCentered(hud, hud.width / 2, Math.round(hud.height * 0.32), String(n), { scale: 5, color: 'sand', name: 'count' });\n        this.drawNames(ctx);\n        return;\n      }\n      case 'play': this.drawPlay(ctx); return;\n      case 'waiting':\n        panel(hud, Math.round(hud.width / 2) - 100, 40, 200, 34, { fill: 'white', name: 'waiting' });\n        sayCentered(hud, hud.width / 2, 46, 'Thank you. I have written that down.', { color: 'ink', shadow: false, name: 'waiting-text' });\n        sayCentered(hud, hud.width / 2, 58, `Your score: ${this.scoreOf(this.me)}`, { color: 'teal', shadow: false, name: 'waiting-score' });\n        this.drawNames(ctx);\n        return;\n      case 'podium': this.drawPodium(ctx); return;\n      default:\n    }\n  }\n\n  drawNames(ctx) {\n    const { hud } = ctx;\n    for (const lane of this.lanes) {\n      if (lane.gone && lane.leaveT > 3) continue;\n      if (!lane.avatar.root.visible) continue;\n      const v = new Vector3(lane.avatar.root.position.x, lane.avatar.root.position.y + 2.05, lane.avatar.root.position.z).project(ctx.camera.camera);\n      const x = (v.x + 1) * 0.5 * hud.width, y = (1 - v.y) * 0.5 * hud.height;\n      const name = sanitize(lane.name).slice(0, 10);\n      const w = textWidth(name) + 6;\n      const bx = Math.max(2, Math.min(hud.width - w - 2, Math.round(x - w / 2)));\n      hud.rect(bx, Math.round(y) + 2, w, 11, lane.hex ?? 'navy');\n      say(hud, bx + 3, Math.round(y) + 4, name, { color: 'white', name: 'lane-name' });\n    }\n  }\n\n  drawCard(ctx) {\n    const { hud } = ctx;\n    const c = this.cardState ?? {};\n    const cx = Math.round(hud.width / 2);\n    const scale = hud.width >= 300 ? 3 : 2;\n    hud.rect(cx - Math.round(textWidth(TITLE, scale) / 2) - 6, 6, textWidth(TITLE, scale) + 12, 9 * scale + 6, 'navy');\n    sayCentered(hud, cx, 9, TITLE, { scale, color: 'white', name: 'title' });\n    const y0 = 44;\n    const w = Math.min(hud.width - 24, 330);\n    const x = Math.round((hud.width - w) / 2);\n    panel(hud, x, y0, w, 46, { fill: 'white', name: 'card-panel' });\n    sayCentered(hud, cx, y0 + 4, 'Score the most across three events.', { color: 'ink', shadow: false, name: 'card-goal' });\n    sayCentered(hud, cx, y0 + 15, 'Stay in the circle.', { color: 'teal', shadow: false, name: 'card-goal' });\n    const events = this.picks.map((p) => ACTIVITIES[p].name).join(', ');\n    sayCentered(hud, cx, y0 + 30, events.slice(0, Math.floor((w - 10) / 6)), { color: 'slate', shadow: false, name: 'card-events' });\n    this.drawNames(ctx);\n    // Ready ticks.\n    const ready = new Set(c.ready ?? []);\n    let rx = x;\n    for (const lane of this.lanes) {\n      const on = ready.has(lane.seat);\n      const name = sanitize(lane.name).slice(0, 8);\n      const tw = textWidth(name) + 18;\n      if (rx + tw > x + w) break;\n      hud.rect(rx, y0 + 50, tw, 12, on ? lane.hex : 'navy');\n      say(hud, rx + 3, y0 + 52, on ? `${name} ok` : name, { color: 'white', shadow: false, name: 'ready-tick' });\n      rx += tw + 4;\n    }\n    const left = c.left === null || c.left === undefined ? '' : `${Math.ceil(c.left / 1000)}s`;\n    if (left) sayRight(hud, x + w, 10, left, { scale: 2, color: 'sand', name: 'card-left' });\n    if (c.paused) sayCentered(hud, cx, y0 + 66, 'Waiting. Somebody asked for more time.', { color: 'sand', name: 'card-paused' });\n    // Controls for the last device, and Ready / More time.\n    promptBar(hud, App.device, [['lean', 'Lean'], ['breath', 'Breathe'], ['stepL', 'Left'], ['stepR', 'Right']], { y: hud.height - 34 });\n    promptBar(hud, App.device, [['confirm', this.answered ? 'Ready!' : 'Ready'], ['more', c.asked ? 'Never mind' : 'More time']]);\n    const by = hud.height - 20;\n    this.cardButtons = { ready: { x: 0, y: by, w: cx, h: 20 }, more: { x: cx, y: by, w: cx, h: 20 } };\n  }\n\n  drawIntro(ctx) {\n    const { hud } = ctx;\n    const cx = Math.round(hud.width / 2);\n    hud.rect(cx - 90, 10, 180, 24, 'navy');\n    sayCentered(hud, cx, 14, 'The Medley', { scale: 2, color: 'white', name: 'title' });\n    const w = Math.min(hud.width - 24, 300);\n    panel(hud, cx - Math.round(w / 2), 40, w, this.picks.length * 11 + 8, { fill: 'white', name: 'intro-panel' });\n    this.picks.forEach((id, i) => sayCentered(hud, cx, 44 + i * 11, `${i + 1}. ${ACTIVITIES[id].name}`, { color: 'ink', shadow: false, name: 'intro-event' }));\n    this.drawNames(ctx);\n  }\n\n  drawPlay(ctx) {\n    const { hud } = ctx;\n    const t = this.clock.now();\n    // Standings along the top: one small cell a player.\n    this.drawStandings(ctx);\n    if (this.current) {\n      this.current.draw(ctx, this.eventT ?? 0);\n      const left = Math.ceil(MEDLEY.eventSeconds - (this.eventT ?? 0));\n      sayCentered(hud, hud.width / 2, hud.height - 12, `${ACTIVITIES[this.picks[this.area]].name}  ${left}s`, { color: 'white', name: 'event-name' });\n    } else {\n      const next = Math.floor(t / WINDOW) + 1;\n      const until = Math.ceil(next * WINDOW - t);\n      const w = Math.min(hud.width - 24, 300);\n      const cx = Math.round(hud.width / 2);\n      panel(hud, cx - Math.round(w / 2), 34, w, 42, { fill: 'white', name: 'break' });\n      sayCentered(hud, cx, 38, `Next: ${ACTIVITIES[this.picks[next]]?.name ?? ''}`, { color: 'teal', shadow: false, name: 'next-event' });\n      sayCentered(hud, cx, 50, this.breakRemark ?? '', { color: 'ink', shadow: false, name: 'break-remark' });\n      sayCentered(hud, cx, 62, `${until}s`, { color: 'slate', shadow: false, name: 'break-count' });\n    }\n    this.drawNames(ctx);\n  }\n\n  drawStandings(ctx) {\n    const { hud } = ctx;\n    const cells = this.lanes;\n    const w = Math.min(Math.floor((hud.width - 16) / cells.length) - 2, 112);\n    const total = cells.length * (w + 2) - 2;\n    let x = Math.round((hud.width - total) / 2);\n    for (const lane of cells) {\n      hud.rect(x, 3, w, 12, lane.gone ? 'slate' : lane.hex ?? 'navy');\n      const name = sanitize(lane.name).slice(0, Math.max(3, Math.floor((w - 34) / 6)));\n      say(hud, x + 2, 5, name, { color: 'white', shadow: false, name: 'standing' });\n      sayRight(hud, x + w - 2, 5, String(this.scoreOf(lane)), { color: 'white', shadow: false, name: 'standing-score' });\n      x += w + 2;\n    }\n  }\n\n  drawPodium(ctx) {\n    const { hud } = ctx;\n    const cx = Math.round(hud.width / 2);\n    hud.rect(cx - 90, 6, 180, 24, 'navy');\n    sayCentered(hud, cx, 10, 'The Podium', { scale: 2, color: 'white', name: 'title' });\n    const w = Math.min(hud.width - 24, 330);\n    const x = cx - Math.round(w / 2);\n    panel(hud, x, 34, w, this.order.length * 12 + 8, { fill: 'white', name: 'podium-panel' });\n    this.order.forEach((lane, i) => {\n      const y = 38 + i * 12;\n      const medal = ['sand', 'mist', 'orange', 'slate'][i];\n      star(hud, x + 5, y, true);\n      hud.rect(x + 5 + STAR_W + 2, y + 1, 3, 7, medal);\n      say(hud, x + 24, y, `${sanitize(lane.name).slice(0, 10)}  ${lane.total}`, { color: 'ink', shadow: false, name: 'podium-row' });\n      const a = this.awards[i];\n      if (a && w > 240) sayRight(hud, x + w - 5, y, a.title, { color: 'teal', shadow: false, name: 'podium-award' });\n    });\n    if (this.menu) {\n      this.menu.o.y = Math.max(34 + this.order.length * 12 + 14, hud.height - 22 - 34 - 30);\n      this.menu.draw(ctx);\n    }\n    promptBar(hud, App.device, [['confirm', 'Select']]);\n  }\n\n  overlayDot() { const l = this.me; return l ? `${l.dot.x.toFixed(2)},${l.dot.y.toFixed(2)} area ${this.area}` : '-'; }\n  status() {\n    const t = this.clock?.now?.() ?? 0;\n    return `medley | ${this.phase} | area ${this.area} | t ${Number.isFinite(t) ? t.toFixed(1) : 'waiting'} | ${(this.lanes ?? []).map((l) => this.scoreOf(l)).join(',')}`;\n  }\n  fingerprint() { return (this.lanes ?? []).map((l) => (l.ghost ? '' : `${l.total}|${l.dot.x.toFixed(4)}`)).join(';'); }\n\n  dispose() {\n    this.ghostSender?.stop();\n    for (const off of this.offs ?? []) off?.();\n    if (this.keyHandler && typeof window !== 'undefined') window.removeEventListener('keydown', this.keyHandler);\n  }\n}\n\nconst round3 = (v) => Math.round(v * 1000) / 1000;\nexport { SONGS };\nEOF\ncat > src/scenes/join.js <<'EOF'\n// Family Hour: each device claims a mat by pressing Cross or Enter. Up to 4 pads plus keyboard and mouse.\nimport { App } from '../app.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { place } from '../art/props.js';\nimport { PRESET_LOOKS } from '../data/classmates.js';\nimport { SEAT_COLORS, SEAT_PALETTE } from '../core/net.js';\nimport { say, sayCentered } from '../ui/font.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { heading } from '../ui/widgets.js';\nimport { BaseScene, laneCamera } from './base.js';\nimport { box, plazaSet } from './sets.js';\n\nconst MATS = [-3, -1, 1, 3];\n\nexport class JoinScene extends BaseScene {\n  name = 'join';\n  id = 'join';\n  allowsAttract = true;\n  canPause = false;\n  seats = [null, null, null, null];\n  bots = true;\n  prevPads = [];\n  avatars = [];\n\n  cameraConfig() { return laneCamera(4); }\n\n  async build(ctx) {\n    plazaSet(ctx, 11);\n    box(ctx, 14, 0.14, 4, [0, 0.04, 0.8], 'white', { cast: false });\n    for (let i = 0; i < 4; i++) {\n      place(ctx, 'yoga-mat', { at: [MATS[i], 0, 0.8], palette: { mat: SEAT_PALETTE[i] }, shadow: false });\n      const a = await makeAvatar(ctx, PRESET_LOOKS[i], { at: [MATS[i], 0.05, 0.8], clip: 'Idle' });\n      a.root.visible = false;\n      if (a.shadow) a.shadow.visible = false;\n      this.avatars.push(a);\n    }\n    App.music('title');\n  }\n\n  /** The pads, read by index: the engine merges them into one. */\n  pads() {\n    if (typeof navigator === 'undefined' || !navigator.getGamepads) return [];\n    return [...navigator.getGamepads()];\n  }\n\n  seatOf(kind, index = 0) { return this.seats.findIndex((s) => s && s.kind === kind && (kind !== 'pad' || s.index === index)); }\n\n  claim(device) {\n    const free = this.seats.findIndex((s) => !s);\n    if (free < 0) return;\n    this.seats[free] = device;\n    const a = this.avatars[free];\n    a.root.visible = true;\n    if (a.shadow) a.shadow.visible = true;\n    a.play('Wave', { once: true, fade: 0.1, then: () => a.play('Idle', { fade: 0.2 }) });\n    a.squash.kick(1);\n    App.sfx('menuConfirm', { pitch: free * 2 });\n    this.idle = 0;\n  }\n\n  drop(i) {\n    this.seats[i] = null;\n    const a = this.avatars[i];\n    a.root.visible = false;\n    if (a.shadow) a.shadow.visible = false;\n    App.sfx('menuBack');\n  }\n\n  begin() {\n    const list = [];\n    this.seats.forEach((s, i) => {\n      if (s) list.push({ ...s, name: `Player ${i + 1}`, look: PRESET_LOOKS[i] });\n      else if (this.bots) list.push({ kind: 'bot', skill: ['good', 'sloppy', 'expert', 'average'][i], look: undefined });\n    });\n    App.sfx('countGo');\n    App.go('medley', { family: list });\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    const joined = this.seats.filter(Boolean).length;\n    // Keyboard and mouse claim one mat between them.\n    if (input.wasPressed('Enter')) {\n      const k = this.seatOf('keyboard');\n      if (k < 0) this.claim({ kind: 'keyboard' });\n      else this.begin();\n      return;\n    }\n    if (input.wasPressed('Escape', 'Backspace')) {\n      const k = this.seatOf('keyboard');\n      if (k >= 0) this.drop(k);\n      else App.go('title', { menu: 'main' });\n      return;\n    }\n    if (input.wasPressed('KeyT') || input.wasPressed('KeyB')) { this.bots = !this.bots; App.sfx('menuMove'); }\n    if (input.wasPressed('MouseLeft')) {\n      const p = App.device.pointerArt(ctx);\n      const r = this.startRect;\n      if (r && p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h && joined) this.begin();\n      else if (this.seatOf('keyboard') < 0) this.claim({ kind: 'keyboard' });\n    }\n    if (input.wasPressed('MouseRight')) {\n      const k = this.seatOf('keyboard');\n      if (k >= 0) this.drop(k); else App.go('title', { menu: 'main' });\n      return;\n    }\n    // Each pad, by its own index.\n    const pads = this.pads();\n    pads.forEach((pad, i) => {\n      if (!pad) return;\n      const was = this.prevPads[i] ?? {};\n      const is = { cross: !!pad.buttons[0]?.pressed, circle: !!pad.buttons[1]?.pressed, square: !!pad.buttons[2]?.pressed, options: !!pad.buttons[9]?.pressed, create: !!pad.buttons[8]?.pressed };\n      const seat = this.seatOf('pad', i);\n      if (is.cross && !was.cross) { if (seat < 0) this.claim({ kind: 'pad', index: i }); else if (this.seats.filter(Boolean).length) this.begin(); }\n      if (is.circle && !was.circle) { if (seat >= 0) this.drop(seat); else App.go('title', { menu: 'main' }); }\n      if (is.square && !was.square) { this.bots = !this.bots; App.sfx('menuMove'); }\n      if (is.options && !was.options && !is.create && this.seats.filter(Boolean).length) this.begin();\n      this.prevPads[i] = is;\n    });\n  }\n\n  onUpdate(ctx, dt) {\n    for (const a of this.avatars) a.update(dt);\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    heading(hud, 'Family Hour', 10);\n    const cx = Math.round(hud.width / 2);\n    sayCentered(hud, cx, 34, 'Press your confirm button to take a mat.', { color: 'white', name: 'join-help' });\n    const cell = Math.min(Math.floor((hud.width - 28) / 4) - 2, 100);\n    const total = 4 * (cell + 2) - 2;\n    let x = Math.round((hud.width - total) / 2);\n    const y = 48;\n    this.seats.forEach((s, i) => {\n      hud.rect(x, y, cell, 26, s ? SEAT_COLORS[i] : 'navy');\n      say(hud, x + 3, y + 3, `Mat ${i + 1}`, { color: 'white', shadow: false, name: 'seat' });\n      const who = s ? (s.kind === 'pad' ? `Pad ${s.index + 1}` : 'Keys+mouse') : this.bots ? 'Bot' : 'Empty';\n      say(hud, x + 3, y + 14, who.slice(0, Math.floor((cell - 4) / 6)), { color: s ? 'white' : 'mist', shadow: false, name: 'seat-who' });\n      x += cell + 2;\n    });\n    const joined = this.seats.filter(Boolean).length;\n    if (joined) {\n      const w = 110;\n      this.startRect = { x: cx - Math.round(w / 2), y: y + 30, w, h: 16 };\n      hud.rect(this.startRect.x, this.startRect.y, w, 16, 'cyan');\n      sayCentered(hud, cx, y + 34, 'Start the Medley', { color: 'ink', shadow: false, name: 'join-start' });\n    } else this.startRect = null;\n    const list = joined ? [['confirm', 'Start'], ['sit', this.bots ? 'Bots: on' : 'Bots: off'], ['back', 'Leave']] : [['confirm', 'Join'], ['sit', this.bots ? 'Bots: on' : 'Bots: off'], ['back', 'Back']];\n    promptBar(hud, App.device, list);\n  }\n\n  status() { return `join | seats ${this.seats.map((s) => (s ? s.kind : '-')).join(',')} | bots ${this.bots}`; }\n}\nEOF\npython3 - <<'EOF'\np='src/scenes/index.js'; s=open(p).read()\ns=s.replace(\"\"\"import { ViewerScene } from './viewer.js';\"\"\",\"\"\"import { ViewerScene } from './viewer.js';\nimport { MedleyScene } from './medley.js';\nimport { JoinScene } from './join.js';\"\"\")\ns=s.replace(\"\"\"  viewer: (a) => new ViewerScene(a),\"\"\",\"\"\"  viewer: (a) => new ViewerScene(a),\n  medley: (a) => new MedleyScene(a),\n  join: (a) => new JoinScene(a),\"\"\")\nopen(p,'w').write(s)\np='src/main.js'; s=open(p).read()\ns=s.replace(\"App.applyDeadzone = applyDeadzone;\",\"App.deadzone = (x, y) => { const v = applyDeadzone(x, y, 0.12); return Array.isArray(v) ? v : [v.x, v.y]; };\")\nopen(p,'w').write(s)\np='src/data/jog.js'; s=open(p).read()\ns=s.replace(\"hitRadius: 0.75,\",\"hitRadius: 0.6,\")\ns=s.replace(\"[-13, -6.2], [-20, -7], [-20.6, 1], [-20.2, 10], [-15, 15],\",\"[-13, -6.2], [-20, -7], [-16.5, -3.2], [-20.6, 1], [-20.2, 10], [-14.5, 9.4], [-18, 13.4], [-15, 15],\")\nopen(p,'w').write(s)\np='src/scenes/activity/jog.js'; s=open(p).read()\ns=s.replace(\"\"\"    const nominal = this.length / JOG.speed;\n    const pace\"\"\",\"\"\"    const nominal = (this.length / JOG.speed) * 0.92; // starting from a standstill takes a moment\n    const pace\"\"\")\nopen(p,'w').write(s)\np='src/data/boards.js'; s=open(p).read()\ns=s.replace(\"{ name: 'Morning Dose', count: 8,\",\"{ name: 'Morning Dose', count: 8, active: 3,\")\ns=s.replace(\"{ name: 'Second Opinion', count: 8,\",\"{ name: 'Second Opinion', count: 8, active: 2,\")\ns=s.replace(\"{ name: 'Full Prescription', count: 8,\",\"{ name: 'Full Prescription', count: 8, active: 3,\")\nopen(p,'w').write(s)\np='src/scenes/activity/tray.js'; s=open(p).read()\ns=s.replace(\"\"\"      v.done = false; v.wait = 0;\n      const p = this.spawnPos(v.i);\n      v.body.setTranslation({ x: p[0], y: p[1], z: p[2] }, true);\n      v.body.setLinvel({ x: 0, y: 0, z: 0 }, true);\n      v.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n      v.body.setEnabled(true);\n      v.mesh.visible = true;\n    }\n  }\n\"\"\",\"\"\"      v.done = false; v.wait = 0; v.queued = true;\n      v.body.setEnabled(false);\n      v.mesh.visible = false;\n    }\n    this.releaseNext();\n  }\n\n  /** A few at a time: the board is a maze for two or three pills, not a stampede. */\n  releaseNext() {\n    const live = this.vits.filter((v) => !v.done && !v.queued).length;\n    let room = (this.board.active ?? 3) - live;\n    for (const v of this.vits) {\n      if (room <= 0) break;\n      if (!v.done && v.queued) { v.queued = false; v.wait = 0; this.respawnVit(v); room--; }\n    }\n  }\n\"\"\")\ns=s.replace(\"\"\"    for (const v of this.vits) {\n      if (v.done) continue;\n      if (v.wait > 0) {\"\"\",\"\"\"    for (const v of this.vits) {\n      if (v.done || v.queued) continue;\n      if (v.wait > 0) {\"\"\")\ns=s.replace(\"\"\"    if (scoring) { this.score += 10; this.correct++; }\n    App.sfx('vitaminIn', { pitch: this.correct });\n    ctx.particles.burst('sparkle', [c.x, 0.6, c.z], { count: 8 });\"\"\",\"\"\"    if (scoring) { this.score += 10; this.correct++; }\n    App.sfx('vitaminIn', { pitch: this.correct });\n    ctx.particles.burst('sparkle', [c.x, 0.6, c.z], { count: 8 });\n    this.releaseNext();\"\"\")\ns=s.replace(\"\"\"    for (const v of this.vits) {\n      if (v.done || v.wait > 0) continue;\n      const p = v.body.translation(), q = v.body.rotation();\"\"\",\"\"\"    for (const v of this.vits) {\n      if (v.done || v.wait > 0 || v.queued) continue;\n      const p = v.body.translation(), q = v.body.rotation();\"\"\")\ns=s.replace(\"\"\"    let best = this.botVit && !this.botVit.done && this.botVit.wait <= 0 ? this.botVit : null;\n    let cup = null, bestD = Infinity;\n    const pool = best ? [best] : this.vits;\n    for (const v of pool) {\n      if (v.done || v.wait > 0) continue;\"\"\",\"\"\"    let best = this.botVit && !this.botVit.done && !this.botVit.queued && this.botVit.wait <= 0 ? this.botVit : null;\n    let cup = null, bestD = Infinity;\n    const pool = best ? [best] : this.vits;\n    for (const v of pool) {\n      if (v.done || v.wait > 0 || v.queued) continue;\"\"\")\ns=s.replace(\"\"\"    const p = best.body.translation(), vel = best.body.linvel();\n    const k = 0.36 * play.speed, kd = 0.38;\n    const t = this.time;\n    out.x = (cup.x - p.x) * k - vel.x * kd + Math.sin(t * 2.3) * play.wander * 1.2;\n    out.y = -(cup.z - p.z) * k + vel.z * kd + Math.sin(t * 1.9) * play.wander * 1.2;\"\"\",\"\"\"    const p = best.body.translation(), vel = best.body.linvel();\n    // Round the walls: aim for the next cell on the shortest way to the cup.\n    const way = this.nextCell(p.x, p.z, cup);\n    const k = 0.5 * play.speed, kd = 0.42;\n    const t = this.time;\n    out.x = (way.x - p.x) * k - vel.x * kd + Math.sin(t * 2.3) * play.wander * 1.2;\n    out.y = -(way.z - p.z) * k + vel.z * kd + Math.sin(t * 1.9) * play.wander * 1.2;\"\"\")\ns=s.replace(\"\"\"  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    const dial\"\"\",\"\"\"  /** Breadth-first over the board's cells, keeping off the wrong cups. */\n  nextCell(px, pz, cup) {\n    const rows = this.board.rows, h = rows.length, w = rows[0].length, cell = TRAY_CELL;\n    const toCell = (x, z) => [Math.max(0, Math.min(w - 1, Math.floor((x + this.halfW) / cell))), Math.max(0, Math.min(h - 1, Math.floor((z + this.halfD) / cell)))];\n    const [sx, sz] = toCell(px, pz);\n    const [tx, tz] = toCell(cup.x, cup.z);\n    const key = (x, z) => z * w + x;\n    const prev = new Map([[key(tx, tz), -1]]);\n    const queue = [[tx, tz]];\n    const open = (x, z) => {\n      if (x < 0 || z < 0 || x >= w || z >= h) return false;\n      const ch = rows[z][x];\n      if (ch === '#' || ch === '_') return false;\n      return !COLORS[ch] || (x === tx && z === tz);\n    };\n    while (queue.length) {\n      const [x, z] = queue.shift();\n      if (x === sx && z === sz) break;\n      for (const [dx, dz] of [[1, 0], [-1, 0], [0, 1], [0, -1]]) {\n        const nx = x + dx, nz = z + dz;\n        if (!open(nx, nz) || prev.has(key(nx, nz))) continue;\n        prev.set(key(nx, nz), key(x, z));\n        queue.push([nx, nz]);\n      }\n    }\n    const step = prev.get(key(sx, sz));\n    if (step === undefined || step < 0) return { x: cup.x, z: cup.z };\n    const nz = Math.floor(step / w), nx = step - nz * w;\n    return { x: (nx + 0.5) * cell - this.halfW, z: (nz + 0.5) * cell - this.halfD };\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    const dial\"\"\")\nopen(p,'w').write(s)\nEOF\ntimeout 250 node .scratch/acts2.mjs </dev/null 2>&1 | tail -8 | cut -c1-320","description":"Write Medley and Family Hour, rework Tray to release pills gradually with a pathfinding bot","timeout":300000}}}
