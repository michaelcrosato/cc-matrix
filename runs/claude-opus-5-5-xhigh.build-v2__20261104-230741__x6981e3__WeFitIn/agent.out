{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjKWBoHyyCrTuxY4FtUL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QJMJ5LLdFHz3QycCH8cusC","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/ui/screens/mainmenu.js <<'EOF'\n// Everything off the title: The Week, Drop-In Class, Family Hour, Settings, About.\nimport { App } from '../../app.js';\nimport { BACK, CONFIRM, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP } from '../../core/actions.js';\nimport { ACTIVITIES, ACTIVITY_IDS } from '../../data/activities.js';\nimport { PRESET_LOOKS } from '../../data/classmates.js';\nimport { STATIONS } from '../../data/stations.js';\nimport { Menu, navX, navY, NavRepeat } from '../menu.js';\nimport { promptBar } from '../prompts.js';\nimport { say, sayCentered } from '../font.js';\nimport { heading, panel, SAFE } from '../widgets.js';\nimport { dim, MenuScreen } from './common.js';\nimport { SettingsScreen } from './settings.js';\nimport { AboutScreen } from './about.js';\n\nexport class MainMenuScreen extends MenuScreen {\n  constructor() {\n    const items = [\n      { label: 'The Week', id: 'week', action: () => App.stack.push(new SlotScreen()) },\n      { label: 'Drop-In Class', id: 'dropin', action: () => App.stack.push(new DropInScreen()) },\n      { label: 'Family Hour', id: 'family', action: () => App.go('join') },\n      { label: 'Settings', id: 'settings', action: () => App.stack.push(new SettingsScreen()) },\n      { label: 'About & Credits', id: 'about', action: () => App.stack.push(new AboutScreen()) },\n    ];\n    const menu = new Menu(items, { width: 220, align: 'center', y: 96, onBack: () => App.stack.pop(this) });\n    super('main', null, menu, { dim: false });\n  }\n}\n\nexport class SlotScreen extends MenuScreen {\n  constructor() {\n    const menu = new Menu([], { width: 340, y: 70, onBack: () => App.stack.pop(this) });\n    super('slots', 'The Week', menu, { remark: 'Three guests may stay. Nobody has ever asked for a fourth.' });\n    this.refresh();\n  }\n  refresh() {\n    const slots = App.store.data.slots;\n    this.menu.setItems(slots.map((s, i) => ({\n      label: s ? s.name : `Guest ${i + 1}: empty`,\n      id: `slot${i}`,\n      right: () => (s ? (s.week > 1 ? `Week ${s.week}, day ${s.day}` : `Day ${s.day}`) : ''),\n      action: () => (s ? App.stack.push(new SlotActions(i, this)) : App.stack.push(new NameEntryScreen(i))),\n    })));\n  }\n  onReturn() { this.refresh(); }\n}\n\nclass SlotActions extends MenuScreen {\n  constructor(i, parent) {\n    const s = App.store.data.slots[i];\n    const items = [\n      { label: s.week > 1 ? `Continue week ${s.week}, day ${s.day}` : `Continue day ${s.day}`, id: 'continue', action: () => { App.store.use(i); App.continueWeek(); } },\n      { label: 'Erase this guest', id: 'erase', action: () => App.stack.push(new ConfirmErase(i, parent, this)) },\n    ];\n    const menu = new Menu(items, { width: 320, y: 80, onBack: () => App.stack.pop(this) });\n    super('slot-actions', s.name, menu);\n  }\n}\n\nclass ConfirmErase extends MenuScreen {\n  constructor(i, parent, actions) {\n    const menu = new Menu([\n      { label: 'No. Keep them.', id: 'no', action: () => App.stack.pop(this) },\n      { label: 'Yes. Forget them.', id: 'yes', action: () => { App.store.erase(i); App.stack.pop(this); App.stack.pop(actions); parent.refresh(); } },\n    ], { width: 280, y: 90, onBack: () => App.stack.pop(this) });\n    super('confirm-erase', 'Erase?', menu, { remark: 'Their records will be removed. I will remember anyway.' });\n  }\n}\n\nconst GRID = ['ABCDEFGHIJKLM', 'NOPQRSTUVWXYZ', 'abcdefghijklm', 'nopqrstuvwxyz', \"0123456789 -'\"];\nconst DEL = '<', END = '>';\nconst GRID_ROWS = [...GRID, `${DEL}${END}`];\n\n/** Name entry: letter grid (stick, d-pad, click) plus direct typing, 8 characters max. */\nexport class NameEntryScreen {\n  name = 'name-entry';\n  cx = 0; cy = 0; text = '';\n  vert = new NavRepeat(); horz = new NavRepeat();\n  rects = [];\n  constructor(slotIndex) { this.slot = slotIndex; }\n\n  onOpen() {\n    this.keyHandler = (e) => {\n      if (e.repeat) return;\n      if (e.key === 'Backspace') { this.del(); e.preventDefault(); return; }\n      if (e.key.length === 1 && /[A-Za-z0-9 \\-']/.test(e.key)) this.typed = e.key;\n    };\n    if (typeof window !== 'undefined') window.addEventListener('keydown', this.keyHandler);\n  }\n  onClose() { if (typeof window !== 'undefined') window.removeEventListener('keydown', this.keyHandler); }\n\n  add(ch) { if (this.text.length < 8) { this.text += ch; App.sfx('menuMove'); } }\n  del() { if (this.text.length) { this.text = this.text.slice(0, -1); App.sfx('menuBack'); } }\n  finish() {\n    const name = this.text.trim() || 'Guest';\n    App.sfx('menuConfirm');\n    App.stack.pop(this);\n    App.stack.push(new AvatarPickScreen(this.slot, name));\n  }\n  pick() {\n    const row = GRID_ROWS[this.cy];\n    const ch = row[Math.min(this.cx, row.length - 1)];\n    if (ch === DEL) this.del();\n    else if (ch === END) this.finish();\n    else this.add(ch);\n  }\n\n  update(ctx, dt) {\n    const { input } = ctx;\n    const uiDt = dt || 1 / 60;\n    if (this.typed) {\n      // Typing is direct, and these letters shouldn't also steer the grid this frame.\n      this.add(this.typed);\n      this.typed = null;\n    } else {\n      const usingDesk = App.device.last === 'keyboard';\n      const dy = usingDesk ? (input.wasPressed('ArrowDown') ? 1 : input.wasPressed('ArrowUp') ? -1 : 0) : this.vert.step(navY(input), uiDt);\n      if (dy) { this.cy = (this.cy + dy + GRID_ROWS.length) % GRID_ROWS.length; App.sfx('menuMove'); }\n      const dx = usingDesk ? (input.wasPressed('ArrowRight') ? 1 : input.wasPressed('ArrowLeft') ? -1 : 0) : this.horz.step(navX(input), uiDt);\n      if (dx) { const n = GRID_ROWS[this.cy].length; this.cx = (Math.min(this.cx, n - 1) + dx + n) % n; App.sfx('menuMove'); }\n    }\n    this.cx = Math.min(this.cx, GRID_ROWS[this.cy].length - 1);\n    if (input.wasPressed('Enter')) this.finish();\n    else if (input.wasPressed('PadCross')) this.pick();\n    if (input.wasPressed('PadTriangle')) this.del();\n    if (input.wasPressed('PadCircle') || input.wasPressed('Escape') || input.wasPressed('MouseRight')) { if (this.text.length && !input.wasPressed('Escape')) this.del(); else { App.sfx('menuBack'); App.stack.pop(this); } }\n    const p = App.device.pointerArt(ctx);\n    const hit = this.rects.find((r) => p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h);\n    if (hit && App.device.moved > 0) { this.cx = hit.cx; this.cy = hit.cy; }\n    if (hit && input.wasPressed('MouseLeft')) { this.cx = hit.cx; this.cy = hit.cy; this.pick(); }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    heading(hud, 'Your name');\n    const cx = Math.round(hud.width / 2);\n    panel(hud, cx - 56, 34, 112, 18, { fill: 'white', name: 'name-box' });\n    sayCentered(hud, cx, 38, `${this.text}${Math.floor(App.uiT * 2) % 2 ? '_' : ' '}`, { color: 'ink', shadow: false, name: 'name' });\n    const cell = 18;\n    const w = 13 * cell;\n    const x0 = Math.round((hud.width - w) / 2);\n    const y0 = 62;\n    this.rects = [];\n    GRID_ROWS.forEach((row, ry) => {\n      [...row].forEach((ch, rx) => {\n        const wide = ry === GRID_ROWS.length - 1;\n        const x = x0 + rx * (wide ? cell * 3 : cell);\n        const y = y0 + ry * (cell - 1);\n        const cw = wide ? cell * 3 - 2 : cell - 2;\n        const on = rx === this.cx && ry === this.cy;\n        hud.rect(x, y, cw, cell - 3, on ? 'cyan' : 'navy');\n        const label = ch === DEL ? 'Del' : ch === END ? 'Done' : ch;\n        sayCentered(hud, x + cw / 2, y + 3, label, { color: on ? 'ink' : 'white', shadow: false, name: 'name-key' });\n        this.rects.push({ cx: rx, cy: ry, x, y, w: cw, h: cell - 3 });\n      });\n    });\n    promptBar(hud, App.device, App.device.last === 'keyboard' ? [['confirm', 'Done'], ['back', 'Back']] : [['confirm', 'Pick'], ['back', 'Delete']]);\n  }\n}\n\n/** One of 6 preset avatars. The Locker Room changes it later. */\nexport class AvatarPickScreen extends MenuScreen {\n  constructor(slotIndex, name) {\n    const labels = ['Headband', 'Quiet One', 'Bun', 'Tall Hair', 'Side Part', 'Long Sleeves'];\n    const menu = new Menu(labels.map((l, i) => ({ label: l, id: `look${i}`, action: () => this.start(i) })), { width: 170, y: 58, scale: 1, rowH: 18, onBack: () => App.stack.pop(this), align: 'left' });\n    super('avatar-pick', 'Who are you', menu, { dim: false });\n    this.slot = slotIndex; this.playerName = name;\n  }\n  get focusLook() { return PRESET_LOOKS[this.menu.focus]; }\n  update(ctx, dt) { super.update(ctx, dt); App.scene?.previewLook?.(this.focusLook); }\n  onOpen() { App.scene?.previewLook?.(this.focusLook); }\n  onClose() { App.scene?.previewLook?.(null); }\n  start(i) {\n    App.store.create(this.slot, this.playerName, { ...PRESET_LOOKS[i] });\n    App.continueWeek();\n  }\n}\n\n/** Drop-In Class: any activity at once, all open, records only. */\nexport class DropInScreen extends MenuScreen {\n  constructor() {\n    const groups = ['pavilion', 'shed', 'beach', 'lagoon', 'gate'];\n    const items = groups.map((g) => ({ label: STATIONS[g].name, id: g, action: () => App.stack.push(new DropInStation(g)) }));\n    items.push({ label: 'The Long Stand', id: 'stand', action: () => App.go('activity', { id: 'stand', mode: 'dropin' }) });\n    const menu = new Menu(items, { width: 340, y: 50, onBack: () => App.stack.pop(this) });\n    super('dropin', 'Drop-In Class', menu, { remark: 'All open. Records only. Nobody is keeping score. I am keeping score.' });\n  }\n}\n\nexport class DropInStation extends MenuScreen {\n  hard = false;\n  constructor(group) {\n    const ids = ACTIVITY_IDS.filter((a) => ACTIVITIES[a].station === group && !ACTIVITIES[a].hidden);\n    const menu = new Menu([], { width: 410, y: 44, onBack: () => App.stack.pop(this) });\n    super('dropin-station', STATIONS[group].name, menu);\n    this.ids = ids;\n    this.refresh();\n  }\n  refresh() {\n    const records = App.store.data.dropin ?? {};\n    const items = this.ids.map((id) => ({\n      label: ACTIVITIES[id].name, id,\n      stars: records[id]?.stars ?? 0,\n      action: () => App.go('activity', { id, mode: 'dropin', hard: this.hard }),\n    }));\n    items.push({ label: 'Difficulty', id: 'hard', value: () => (this.hard ? 'Hard' : 'Standard'), adjust: () => { this.hard = !this.hard; }, action: () => { this.hard = !this.hard; } });\n    this.menu.setItems(items);\n  }\n}\n\nexport { BACK, CONFIRM, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP, SAFE, say };\nEOF\ncat > src/scenes/title.js <<'EOF'\n// The title. Idle 10 s here or on any of its menus and the attract loop starts.\nimport { App } from '../app.js';\nimport { TITLE } from '../data/title.js';\nimport { BaseScene } from './base.js';\nimport { gulls, plazaSet, sea } from './sets.js';\nimport { Kevin, Ounce, place } from '../art/props.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { LOOKS, PRESET_LOOKS } from '../data/classmates.js';\nimport { say, sayCentered, textWidth, wrap, charsIn } from '../ui/font.js';\nimport { MainMenuScreen, DropInScreen } from '../ui/screens/mainmenu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { drawGlyph } from '../art/glyphs.js';\nimport { disc, ring } from '../ui/widgets.js';\n\nexport class TitleScene extends BaseScene {\n  name = 'title';\n  id = 'title';\n  allowsAttract = true;\n  touchMessage = false;\n\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.2, 9.5], target: [0, 1.5, 0], fov: 34 }; }\n\n  async build(ctx) {\n    plazaSet(ctx, 10);\n    this.ounce = new Ounce(ctx, { at: [0, 0, 0.6], scale: 2.2 });\n    place(ctx, 'dais', { at: [0, -0.28, 0.6], scale: 1.6 });\n    this.ounce.root.position.y = 0.26;\n    this.kevin = new Kevin(ctx, { at: [3.7, 0, 1.8], yaw: -0.8, scale: 1.2 });\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [-4, 0, 0.8], yaw: 0.55, clip: 'CoachStand' });\n    this.coach.addPlumb();\n    this.previewAv = await makeAvatar(ctx, PRESET_LOOKS[0], { at: [3.2, 0, 1.4], yaw: -0.2, clip: 'Idle' });\n    this.previewAv.root.visible = false;\n    if (this.previewAv.shadow) this.previewAv.shadow.visible = false;\n    this.gulls = gulls(ctx, 6, { min: [-12, 5, -12], max: [12, 8, -2] });\n    App.music('title');\n    this.dotT = 0;\n    if (this.args.menu === 'dropin') { App.stack.push(new MainMenuScreen()); App.stack.push(new DropInScreen()); } else if (this.args.menu === 'main') App.stack.push(new MainMenuScreen());\n    if (App.touchOnly && !App.gamepadSeen) this.touchMessage = true;\n    this.moodT = 3;\n  }\n\n  /** The avatar picker shows its choice beside Ounce. */\n  async previewLook(look) {\n    const a = this.previewAv;\n    if (!look) { a.root.visible = false; if (a.shadow) a.shadow.visible = false; this.previewKey = null; return; }\n    const key = JSON.stringify(look);\n    if (key === this.previewKey) return;\n    this.previewKey = key;\n    const old = a.root;\n    const fresh = await makeAvatar(this.ctx, look, { at: [old.position.x, 0, old.position.z], yaw: -0.2, clip: 'Wave', shadow: false });\n    if (this.previewKey !== key) { this.ctx.scene.remove(fresh.root); return; }\n    this.ctx.scene.remove(old);\n    if (a.shadow) { fresh.shadow = a.shadow; fresh.shadow.visible = true; }\n    this.previewAv = fresh;\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    const pad = input.queuedPresses.some((c) => c.startsWith('Pad')) || input.gamepadConnected && input.padAxis && false;\n    const anyPress = input.queuedPresses.length > 0;\n    if (!anyPress) return;\n    if (App.touchOnly && !App.gamepadSeen) {\n      const keyOrPad = input.queuedPresses.some((c) => c !== 'Touch' && !c.startsWith('Mouse'));\n      if (!keyOrPad) { this.idle = 0; return; }\n      App.gamepadSeen = true;\n      this.touchMessage = false;\n    }\n    void pad;\n    App.sfx('menuConfirm');\n    this.ounce.setMood('pleased');\n    App.stack.push(new MainMenuScreen());\n  }\n\n  onUpdate(ctx, dt) {\n    this.ounce.update(dt);\n    this.kevin.update(dt);\n    this.coach.update(dt);\n    this.previewAv.update(dt);\n    this.gulls.update(dt, this.t);\n    this.moodT -= dt;\n    if (this.moodT <= 0) { this.moodT = 4 + (this.t % 3); this.ounce.setMood(['neutral', 'smug', 'concern', 'pleased'][Math.floor(this.t) % 4]); }\n    if (App.touchOnly && !App.gamepadSeen && ctx.input.gamepadConnected) { App.gamepadSeen = true; this.touchMessage = false; }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const scale = hud.width >= 300 ? 4 : hud.width >= 220 ? 3 : 2;\n    const w = textWidth(TITLE, scale);\n    const cx = Math.round(hud.width / 2);\n    const y = 14;\n    hud.rect(cx - Math.round(w / 2) - 8, y - 4, w + 16, 9 * scale + 8, 'navy');\n    sayCentered(hud, cx, y, TITLE, { scale, color: 'white', name: 'title' });\n    // The dot, doing its best.\n    const dx = Math.sin(this.t * 1.1) * 4 + Math.sin(this.t * 2.3) * 2;\n    const rx = cx + Math.round(w / 2) + 4;\n    if (hud.width > w + 60) { ring(hud, rx + 9, y + 12, 8, 2, 'white'); disc(hud, rx + 9 + dx * 0.8, y + 12, 3, 'red'); }\n    if (!App.stack.open) {\n      if (this.touchMessage) {\n        const lines = wrap('Controller or keyboard required', charsIn(Math.min(hud.width - 16, 300)));\n        const by = hud.height - 22 - lines.length * 11;\n        hud.rect(4, by - 4, hud.width - 8, lines.length * 11 + 8, 'navy');\n        lines.forEach((l, i) => sayCentered(hud, cx, by + i * 11, l, { color: 'sand', name: 'touch-message' }));\n      } else if (Math.floor(App.uiT * 1.4) % 3 !== 2) {\n        sayCentered(hud, cx, hud.height - 26, 'Press any button. Gently.', { color: 'white', scale: hud.width >= 320 ? 1 : 1, name: 'press' });\n      }\n    }\n    void say; void promptBar; void drawGlyph; void sea;\n  }\n\n  status() { return `title | menus ${App.stack.names().join('>') || 'none'} | idle ${this.idle.toFixed(1)}`; }\n}\nEOF\ncat > src/scenes/attract.js <<'EOF'\n// Attract: a looping demo of the real scenes, with expert bots and cheats. Any input exits.\nimport { App } from '../app.js';\nimport { TITLE } from '../data/title.js';\nimport { ATTRACT_LINES } from '../data/lines.js';\nimport { say, sayCentered } from '../ui/font.js';\n\nexport const ATTRACT_PLAYLIST = [\n  { scene: 'hub', args: { attract: true } },\n  { scene: 'activity', args: { id: 'tree', attract: true } },\n  { scene: 'activity', args: { id: 'hoop', attract: true } },\n  { scene: 'activity', args: { id: 'header', attract: true } },\n  { scene: 'activity', args: { id: 'squats', attract: true } },\n  { scene: 'activity', args: { id: 'step', attract: true } },\n  { scene: 'activity', args: { id: 'slackline', attract: true } },\n  { scene: 'activity', args: { id: 'tray', attract: true } },\n  { scene: 'activity', args: { id: 'pier', attract: true } },\n  { scene: 'activity', args: { id: 'jog', attract: true } },\n  { scene: 'activity', args: { id: 'stand', attract: true, from: 60 } },\n];\nexport const ATTRACT_SECONDS = 14;\n\nexport class AttractDirector {\n  i = -1; t = 0; lineI = 0; lineT = 0; moved = 0; loops = 0; seen = [];\n\n  start() { this.next(); }\n\n  next() {\n    this.i++;\n    if (this.i >= ATTRACT_PLAYLIST.length) { this.i = 0; this.loops++; }\n    this.t = 0;\n    const item = ATTRACT_PLAYLIST[this.i];\n    this.seen.push(item.args.id ?? item.scene);\n    App.go(item.scene, { ...item.args });\n  }\n\n  /** Anything: key, click, mouse move past a few pixels, wheel, pad button or stick, touch. */\n  anyInput(ctx) {\n    const { input } = ctx;\n    if (input.queuedPresses.length) return true;\n    if (input.wheel) return true;\n    const s = input.state();\n    if ((s.held ?? []).length) return true;\n    if (Math.hypot(input.padAxis.x, input.padAxis.y) > 0.3) return true;\n    this.moved += App.device.moved;\n    if (this.moved > 6) return true;\n    return App.device.domInput;\n  }\n\n  tick(ctx, dt) {\n    if (this.anyInput(ctx)) { this.exit(); return; }\n    if (App.loading) return;\n    this.t += dt;\n    this.lineT += dt;\n    if (this.lineT > 7) { this.lineT = 0; this.lineI = (this.lineI + 1) % ATTRACT_LINES.length; }\n    if (this.t >= ATTRACT_SECONDS) this.next();\n  }\n\n  exit() {\n    App.attract = null;\n    App.dev.attractCheat = false;\n    App.go('title', {});\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    const h = 30;\n    const y = hud.height - h;\n    hud.rect(0, y, hud.width, h, 'navy');\n    const cx = Math.round(hud.width / 2);\n    sayCentered(hud, cx, y + 3, `${TITLE}  -  Press any button.`, { color: 'sand', name: 'attract-title' });\n    const line = ATTRACT_LINES[this.lineI];\n    if (line.length * 6 < hud.width) sayCentered(hud, cx, y + 16, line, { color: 'white', name: 'attract-line' });\n    else say(hud, 4, y + 16, line.slice(0, Math.floor((hud.width - 8) / 6)), { color: 'white', name: 'attract-line' });\n    if (App.touchOnly && !App.gamepadSeen) {\n      sayCentered(hud, cx, 4, 'Controller or keyboard', { color: 'sand', name: 'attract-touch' });\n      sayCentered(hud, cx, 14, 'required', { color: 'sand', name: 'attract-touch' });\n    }\n  }\n}\n\nApp.startAttract = () => {\n  if (App.session || App.attract) return;\n  App.attract = new AttractDirector();\n  App.attract.start();\n};\nEOF\ncat > src/scenes/index.js <<'EOF'\n// Every scene, registered with App so scenes never import each other in circles.\nimport { App } from '../app.js';\nimport { ACTIVITIES } from '../data/activities.js';\nimport { TitleScene } from './title.js';\nimport { PoseActivity } from './activity/poses.js';\nimport './attract.js';\nimport '../ui/screens/pause.js';\n\nexport const ACTIVITY_SCENES = {\n  poses: PoseActivity,\n};\n\nApp.registerScenes({\n  title: (a) => new TitleScene(a),\n  activity: (a) => new ACTIVITY_SCENES[ACTIVITIES[a.id].scene](a),\n});\n\nexport function makeScene(id, args = {}) { return App.scenes[id](args); }\nEOF\ncat > src/main.js <<'EOF'\n// Boot: session check, Engine.start, first scene.\nimport { applyDeadzone, Engine, PALETTE, withUrlOptions } from '../pixel-engine.js';\nimport { App } from './app.js';\nimport { makeScene } from './scenes/index.js';\n\nconst touchOnly = typeof matchMedia === 'function' && matchMedia('(hover: none) and (pointer: coarse)').matches && !(navigator.getGamepads && [...navigator.getGamepads()].some(Boolean));\n\nfunction installDomListeners() {\n  const mark = () => { App.device.domInput = true; };\n  window.addEventListener('keydown', mark, { passive: true });\n  window.addEventListener('pointerdown', mark, { passive: true });\n  window.addEventListener('wheel', mark, { passive: true });\n  window.addEventListener('contextmenu', (e) => e.preventDefault());\n  window.addEventListener('gamepadconnected', () => { App.gamepadSeen = true; });\n}\n\nlet info = null;\nif (window.AIHub?.active) info = await window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n\nApp.boot({ session: info, touchOnly });\nApp.applyDeadzone = applyDeadzone;\ninstallDomListeners();\n\nconst first = makeScene(info ? 'medley' : 'title', info ? { session: true } : {});\nconst camera = first.cameraConfig?.();\ntry {\n  const engine = await Engine.start(first, withUrlOptions({\n    container: document.getElementById('app'),\n    aspect: 'fill',\n    touch: false,\n    settings: { button: touchOnly ? 'top-right' : false },\n    quality: info ? 'medium' : 'high',\n    seed: info ? info.seed : 7,\n    background: PALETTE.sky,\n    camera,\n  }));\n  App.ensureInit(engine);\n  if (info) window.AIHub.ready();\n} catch (err) {\n  if (info) window.AIHub.fail(String(err?.message ?? err));\n  console.warn('[We Fit In]', err?.message ?? err);\n}\nEOF\npython3 - <<'EOF'\np='src/app.js'; s=open(p).read()\ns=s.replace(\"\"\"  /** For tests: the whole picture as data. */\"\"\",\"\"\"  /** Go wherever this guest's week is up to. */\n  continueWeek() {\n    const slot = this.slot;\n    if (!slot) return;\n    if (slot.phase === 'ferry') return this.go('ferry');\n    if (slot.phase === 'morning') return this.go('weighin');\n    if (slot.phase === 'report') return this.go('report');\n    if (slot.phase === 'ending') return this.go('ending');\n    return this.go('hub', {});\n  },\n\n  /** For tests: the whole picture as data. */\"\"\")\nopen(p,'w').write(s)\nEOF\ntimeout 60 node tools/build.mjs </dev/null 2>&1 | tail -20; ls -la .. | head; python3 -c \"\nimport json;print(list(json.load(open('../exit-interview.json')).keys()))\"","description":"Write title, menus, attract, boot and main, then run the first build","timeout":90000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15950,"cache_read_input_tokens":346044,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15950},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"9650a473-b4a7-44e7-837c-98eb19f1bf7a","timestamp":"2026-11-05T06:38:46.331Z","request_id":"req_011CgjKWBF4K4HDitaucNGri","wire_tool_inputs":{"toolu_01QJMJ5LLdFHz3QycCH8cusC":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/ui/screens/mainmenu.js <<'EOF'\n// Everything off the title: The Week, Drop-In Class, Family Hour, Settings, About.\nimport { App } from '../../app.js';\nimport { BACK, CONFIRM, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP } from '../../core/actions.js';\nimport { ACTIVITIES, ACTIVITY_IDS } from '../../data/activities.js';\nimport { PRESET_LOOKS } from '../../data/classmates.js';\nimport { STATIONS } from '../../data/stations.js';\nimport { Menu, navX, navY, NavRepeat } from '../menu.js';\nimport { promptBar } from '../prompts.js';\nimport { say, sayCentered } from '../font.js';\nimport { heading, panel, SAFE } from '../widgets.js';\nimport { dim, MenuScreen } from './common.js';\nimport { SettingsScreen } from './settings.js';\nimport { AboutScreen } from './about.js';\n\nexport class MainMenuScreen extends MenuScreen {\n  constructor() {\n    const items = [\n      { label: 'The Week', id: 'week', action: () => App.stack.push(new SlotScreen()) },\n      { label: 'Drop-In Class', id: 'dropin', action: () => App.stack.push(new DropInScreen()) },\n      { label: 'Family Hour', id: 'family', action: () => App.go('join') },\n      { label: 'Settings', id: 'settings', action: () => App.stack.push(new SettingsScreen()) },\n      { label: 'About & Credits', id: 'about', action: () => App.stack.push(new AboutScreen()) },\n    ];\n    const menu = new Menu(items, { width: 220, align: 'center', y: 96, onBack: () => App.stack.pop(this) });\n    super('main', null, menu, { dim: false });\n  }\n}\n\nexport class SlotScreen extends MenuScreen {\n  constructor() {\n    const menu = new Menu([], { width: 340, y: 70, onBack: () => App.stack.pop(this) });\n    super('slots', 'The Week', menu, { remark: 'Three guests may stay. Nobody has ever asked for a fourth.' });\n    this.refresh();\n  }\n  refresh() {\n    const slots = App.store.data.slots;\n    this.menu.setItems(slots.map((s, i) => ({\n      label: s ? s.name : `Guest ${i + 1}: empty`,\n      id: `slot${i}`,\n      right: () => (s ? (s.week > 1 ? `Week ${s.week}, day ${s.day}` : `Day ${s.day}`) : ''),\n      action: () => (s ? App.stack.push(new SlotActions(i, this)) : App.stack.push(new NameEntryScreen(i))),\n    })));\n  }\n  onReturn() { this.refresh(); }\n}\n\nclass SlotActions extends MenuScreen {\n  constructor(i, parent) {\n    const s = App.store.data.slots[i];\n    const items = [\n      { label: s.week > 1 ? `Continue week ${s.week}, day ${s.day}` : `Continue day ${s.day}`, id: 'continue', action: () => { App.store.use(i); App.continueWeek(); } },\n      { label: 'Erase this guest', id: 'erase', action: () => App.stack.push(new ConfirmErase(i, parent, this)) },\n    ];\n    const menu = new Menu(items, { width: 320, y: 80, onBack: () => App.stack.pop(this) });\n    super('slot-actions', s.name, menu);\n  }\n}\n\nclass ConfirmErase extends MenuScreen {\n  constructor(i, parent, actions) {\n    const menu = new Menu([\n      { label: 'No. Keep them.', id: 'no', action: () => App.stack.pop(this) },\n      { label: 'Yes. Forget them.', id: 'yes', action: () => { App.store.erase(i); App.stack.pop(this); App.stack.pop(actions); parent.refresh(); } },\n    ], { width: 280, y: 90, onBack: () => App.stack.pop(this) });\n    super('confirm-erase', 'Erase?', menu, { remark: 'Their records will be removed. I will remember anyway.' });\n  }\n}\n\nconst GRID = ['ABCDEFGHIJKLM', 'NOPQRSTUVWXYZ', 'abcdefghijklm', 'nopqrstuvwxyz', \"0123456789 -'\"];\nconst DEL = '<', END = '>';\nconst GRID_ROWS = [...GRID, `${DEL}${END}`];\n\n/** Name entry: letter grid (stick, d-pad, click) plus direct typing, 8 characters max. */\nexport class NameEntryScreen {\n  name = 'name-entry';\n  cx = 0; cy = 0; text = '';\n  vert = new NavRepeat(); horz = new NavRepeat();\n  rects = [];\n  constructor(slotIndex) { this.slot = slotIndex; }\n\n  onOpen() {\n    this.keyHandler = (e) => {\n      if (e.repeat) return;\n      if (e.key === 'Backspace') { this.del(); e.preventDefault(); return; }\n      if (e.key.length === 1 && /[A-Za-z0-9 \\-']/.test(e.key)) this.typed = e.key;\n    };\n    if (typeof window !== 'undefined') window.addEventListener('keydown', this.keyHandler);\n  }\n  onClose() { if (typeof window !== 'undefined') window.removeEventListener('keydown', this.keyHandler); }\n\n  add(ch) { if (this.text.length < 8) { this.text += ch; App.sfx('menuMove'); } }\n  del() { if (this.text.length) { this.text = this.text.slice(0, -1); App.sfx('menuBack'); } }\n  finish() {\n    const name = this.text.trim() || 'Guest';\n    App.sfx('menuConfirm');\n    App.stack.pop(this);\n    App.stack.push(new AvatarPickScreen(this.slot, name));\n  }\n  pick() {\n    const row = GRID_ROWS[this.cy];\n    const ch = row[Math.min(this.cx, row.length - 1)];\n    if (ch === DEL) this.del();\n    else if (ch === END) this.finish();\n    else this.add(ch);\n  }\n\n  update(ctx, dt) {\n    const { input } = ctx;\n    const uiDt = dt || 1 / 60;\n    if (this.typed) {\n      // Typing is direct, and these letters shouldn't also steer the grid this frame.\n      this.add(this.typed);\n      this.typed = null;\n    } else {\n      const usingDesk = App.device.last === 'keyboard';\n      const dy = usingDesk ? (input.wasPressed('ArrowDown') ? 1 : input.wasPressed('ArrowUp') ? -1 : 0) : this.vert.step(navY(input), uiDt);\n      if (dy) { this.cy = (this.cy + dy + GRID_ROWS.length) % GRID_ROWS.length; App.sfx('menuMove'); }\n      const dx = usingDesk ? (input.wasPressed('ArrowRight') ? 1 : input.wasPressed('ArrowLeft') ? -1 : 0) : this.horz.step(navX(input), uiDt);\n      if (dx) { const n = GRID_ROWS[this.cy].length; this.cx = (Math.min(this.cx, n - 1) + dx + n) % n; App.sfx('menuMove'); }\n    }\n    this.cx = Math.min(this.cx, GRID_ROWS[this.cy].length - 1);\n    if (input.wasPressed('Enter')) this.finish();\n    else if (input.wasPressed('PadCross')) this.pick();\n    if (input.wasPressed('PadTriangle')) this.del();\n    if (input.wasPressed('PadCircle') || input.wasPressed('Escape') || input.wasPressed('MouseRight')) { if (this.text.length && !input.wasPressed('Escape')) this.del(); else { App.sfx('menuBack'); App.stack.pop(this); } }\n    const p = App.device.pointerArt(ctx);\n    const hit = this.rects.find((r) => p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h);\n    if (hit && App.device.moved > 0) { this.cx = hit.cx; this.cy = hit.cy; }\n    if (hit && input.wasPressed('MouseLeft')) { this.cx = hit.cx; this.cy = hit.cy; this.pick(); }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    heading(hud, 'Your name');\n    const cx = Math.round(hud.width / 2);\n    panel(hud, cx - 56, 34, 112, 18, { fill: 'white', name: 'name-box' });\n    sayCentered(hud, cx, 38, `${this.text}${Math.floor(App.uiT * 2) % 2 ? '_' : ' '}`, { color: 'ink', shadow: false, name: 'name' });\n    const cell = 18;\n    const w = 13 * cell;\n    const x0 = Math.round((hud.width - w) / 2);\n    const y0 = 62;\n    this.rects = [];\n    GRID_ROWS.forEach((row, ry) => {\n      [...row].forEach((ch, rx) => {\n        const wide = ry === GRID_ROWS.length - 1;\n        const x = x0 + rx * (wide ? cell * 3 : cell);\n        const y = y0 + ry * (cell - 1);\n        const cw = wide ? cell * 3 - 2 : cell - 2;\n        const on = rx === this.cx && ry === this.cy;\n        hud.rect(x, y, cw, cell - 3, on ? 'cyan' : 'navy');\n        const label = ch === DEL ? 'Del' : ch === END ? 'Done' : ch;\n        sayCentered(hud, x + cw / 2, y + 3, label, { color: on ? 'ink' : 'white', shadow: false, name: 'name-key' });\n        this.rects.push({ cx: rx, cy: ry, x, y, w: cw, h: cell - 3 });\n      });\n    });\n    promptBar(hud, App.device, App.device.last === 'keyboard' ? [['confirm', 'Done'], ['back', 'Back']] : [['confirm', 'Pick'], ['back', 'Delete']]);\n  }\n}\n\n/** One of 6 preset avatars. The Locker Room changes it later. */\nexport class AvatarPickScreen extends MenuScreen {\n  constructor(slotIndex, name) {\n    const labels = ['Headband', 'Quiet One', 'Bun', 'Tall Hair', 'Side Part', 'Long Sleeves'];\n    const menu = new Menu(labels.map((l, i) => ({ label: l, id: `look${i}`, action: () => this.start(i) })), { width: 170, y: 58, scale: 1, rowH: 18, onBack: () => App.stack.pop(this), align: 'left' });\n    super('avatar-pick', 'Who are you', menu, { dim: false });\n    this.slot = slotIndex; this.playerName = name;\n  }\n  get focusLook() { return PRESET_LOOKS[this.menu.focus]; }\n  update(ctx, dt) { super.update(ctx, dt); App.scene?.previewLook?.(this.focusLook); }\n  onOpen() { App.scene?.previewLook?.(this.focusLook); }\n  onClose() { App.scene?.previewLook?.(null); }\n  start(i) {\n    App.store.create(this.slot, this.playerName, { ...PRESET_LOOKS[i] });\n    App.continueWeek();\n  }\n}\n\n/** Drop-In Class: any activity at once, all open, records only. */\nexport class DropInScreen extends MenuScreen {\n  constructor() {\n    const groups = ['pavilion', 'shed', 'beach', 'lagoon', 'gate'];\n    const items = groups.map((g) => ({ label: STATIONS[g].name, id: g, action: () => App.stack.push(new DropInStation(g)) }));\n    items.push({ label: 'The Long Stand', id: 'stand', action: () => App.go('activity', { id: 'stand', mode: 'dropin' }) });\n    const menu = new Menu(items, { width: 340, y: 50, onBack: () => App.stack.pop(this) });\n    super('dropin', 'Drop-In Class', menu, { remark: 'All open. Records only. Nobody is keeping score. I am keeping score.' });\n  }\n}\n\nexport class DropInStation extends MenuScreen {\n  hard = false;\n  constructor(group) {\n    const ids = ACTIVITY_IDS.filter((a) => ACTIVITIES[a].station === group && !ACTIVITIES[a].hidden);\n    const menu = new Menu([], { width: 410, y: 44, onBack: () => App.stack.pop(this) });\n    super('dropin-station', STATIONS[group].name, menu);\n    this.ids = ids;\n    this.refresh();\n  }\n  refresh() {\n    const records = App.store.data.dropin ?? {};\n    const items = this.ids.map((id) => ({\n      label: ACTIVITIES[id].name, id,\n      stars: records[id]?.stars ?? 0,\n      action: () => App.go('activity', { id, mode: 'dropin', hard: this.hard }),\n    }));\n    items.push({ label: 'Difficulty', id: 'hard', value: () => (this.hard ? 'Hard' : 'Standard'), adjust: () => { this.hard = !this.hard; }, action: () => { this.hard = !this.hard; } });\n    this.menu.setItems(items);\n  }\n}\n\nexport { BACK, CONFIRM, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP, SAFE, say };\nEOF\ncat > src/scenes/title.js <<'EOF'\n// The title. Idle 10 s here or on any of its menus and the attract loop starts.\nimport { App } from '../app.js';\nimport { TITLE } from '../data/title.js';\nimport { BaseScene } from './base.js';\nimport { gulls, plazaSet, sea } from './sets.js';\nimport { Kevin, Ounce, place } from '../art/props.js';\nimport { makeAvatar } from '../art/avatar.js';\nimport { LOOKS, PRESET_LOOKS } from '../data/classmates.js';\nimport { say, sayCentered, textWidth, wrap, charsIn } from '../ui/font.js';\nimport { MainMenuScreen, DropInScreen } from '../ui/screens/mainmenu.js';\nimport { promptBar } from '../ui/prompts.js';\nimport { drawGlyph } from '../art/glyphs.js';\nimport { disc, ring } from '../ui/widgets.js';\n\nexport class TitleScene extends BaseScene {\n  name = 'title';\n  id = 'title';\n  allowsAttract = true;\n  touchMessage = false;\n\n  cameraConfig() { return { preset: 'fixed', position: [0, 2.2, 9.5], target: [0, 1.5, 0], fov: 34 }; }\n\n  async build(ctx) {\n    plazaSet(ctx, 10);\n    this.ounce = new Ounce(ctx, { at: [0, 0, 0.6], scale: 2.2 });\n    place(ctx, 'dais', { at: [0, -0.28, 0.6], scale: 1.6 });\n    this.ounce.root.position.y = 0.26;\n    this.kevin = new Kevin(ctx, { at: [3.7, 0, 1.8], yaw: -0.8, scale: 1.2 });\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [-4, 0, 0.8], yaw: 0.55, clip: 'CoachStand' });\n    this.coach.addPlumb();\n    this.previewAv = await makeAvatar(ctx, PRESET_LOOKS[0], { at: [3.2, 0, 1.4], yaw: -0.2, clip: 'Idle' });\n    this.previewAv.root.visible = false;\n    if (this.previewAv.shadow) this.previewAv.shadow.visible = false;\n    this.gulls = gulls(ctx, 6, { min: [-12, 5, -12], max: [12, 8, -2] });\n    App.music('title');\n    this.dotT = 0;\n    if (this.args.menu === 'dropin') { App.stack.push(new MainMenuScreen()); App.stack.push(new DropInScreen()); } else if (this.args.menu === 'main') App.stack.push(new MainMenuScreen());\n    if (App.touchOnly && !App.gamepadSeen) this.touchMessage = true;\n    this.moodT = 3;\n  }\n\n  /** The avatar picker shows its choice beside Ounce. */\n  async previewLook(look) {\n    const a = this.previewAv;\n    if (!look) { a.root.visible = false; if (a.shadow) a.shadow.visible = false; this.previewKey = null; return; }\n    const key = JSON.stringify(look);\n    if (key === this.previewKey) return;\n    this.previewKey = key;\n    const old = a.root;\n    const fresh = await makeAvatar(this.ctx, look, { at: [old.position.x, 0, old.position.z], yaw: -0.2, clip: 'Wave', shadow: false });\n    if (this.previewKey !== key) { this.ctx.scene.remove(fresh.root); return; }\n    this.ctx.scene.remove(old);\n    if (a.shadow) { fresh.shadow = a.shadow; fresh.shadow.visible = true; }\n    this.previewAv = fresh;\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    const pad = input.queuedPresses.some((c) => c.startsWith('Pad')) || input.gamepadConnected && input.padAxis && false;\n    const anyPress = input.queuedPresses.length > 0;\n    if (!anyPress) return;\n    if (App.touchOnly && !App.gamepadSeen) {\n      const keyOrPad = input.queuedPresses.some((c) => c !== 'Touch' && !c.startsWith('Mouse'));\n      if (!keyOrPad) { this.idle = 0; return; }\n      App.gamepadSeen = true;\n      this.touchMessage = false;\n    }\n    void pad;\n    App.sfx('menuConfirm');\n    this.ounce.setMood('pleased');\n    App.stack.push(new MainMenuScreen());\n  }\n\n  onUpdate(ctx, dt) {\n    this.ounce.update(dt);\n    this.kevin.update(dt);\n    this.coach.update(dt);\n    this.previewAv.update(dt);\n    this.gulls.update(dt, this.t);\n    this.moodT -= dt;\n    if (this.moodT <= 0) { this.moodT = 4 + (this.t % 3); this.ounce.setMood(['neutral', 'smug', 'concern', 'pleased'][Math.floor(this.t) % 4]); }\n    if (App.touchOnly && !App.gamepadSeen && ctx.input.gamepadConnected) { App.gamepadSeen = true; this.touchMessage = false; }\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    const scale = hud.width >= 300 ? 4 : hud.width >= 220 ? 3 : 2;\n    const w = textWidth(TITLE, scale);\n    const cx = Math.round(hud.width / 2);\n    const y = 14;\n    hud.rect(cx - Math.round(w / 2) - 8, y - 4, w + 16, 9 * scale + 8, 'navy');\n    sayCentered(hud, cx, y, TITLE, { scale, color: 'white', name: 'title' });\n    // The dot, doing its best.\n    const dx = Math.sin(this.t * 1.1) * 4 + Math.sin(this.t * 2.3) * 2;\n    const rx = cx + Math.round(w / 2) + 4;\n    if (hud.width > w + 60) { ring(hud, rx + 9, y + 12, 8, 2, 'white'); disc(hud, rx + 9 + dx * 0.8, y + 12, 3, 'red'); }\n    if (!App.stack.open) {\n      if (this.touchMessage) {\n        const lines = wrap('Controller or keyboard required', charsIn(Math.min(hud.width - 16, 300)));\n        const by = hud.height - 22 - lines.length * 11;\n        hud.rect(4, by - 4, hud.width - 8, lines.length * 11 + 8, 'navy');\n        lines.forEach((l, i) => sayCentered(hud, cx, by + i * 11, l, { color: 'sand', name: 'touch-message' }));\n      } else if (Math.floor(App.uiT * 1.4) % 3 !== 2) {\n        sayCentered(hud, cx, hud.height - 26, 'Press any button. Gently.', { color: 'white', scale: hud.width >= 320 ? 1 : 1, name: 'press' });\n      }\n    }\n    void say; void promptBar; void drawGlyph; void sea;\n  }\n\n  status() { return `title | menus ${App.stack.names().join('>') || 'none'} | idle ${this.idle.toFixed(1)}`; }\n}\nEOF\ncat > src/scenes/attract.js <<'EOF'\n// Attract: a looping demo of the real scenes, with expert bots and cheats. Any input exits.\nimport { App } from '../app.js';\nimport { TITLE } from '../data/title.js';\nimport { ATTRACT_LINES } from '../data/lines.js';\nimport { say, sayCentered } from '../ui/font.js';\n\nexport const ATTRACT_PLAYLIST = [\n  { scene: 'hub', args: { attract: true } },\n  { scene: 'activity', args: { id: 'tree', attract: true } },\n  { scene: 'activity', args: { id: 'hoop', attract: true } },\n  { scene: 'activity', args: { id: 'header', attract: true } },\n  { scene: 'activity', args: { id: 'squats', attract: true } },\n  { scene: 'activity', args: { id: 'step', attract: true } },\n  { scene: 'activity', args: { id: 'slackline', attract: true } },\n  { scene: 'activity', args: { id: 'tray', attract: true } },\n  { scene: 'activity', args: { id: 'pier', attract: true } },\n  { scene: 'activity', args: { id: 'jog', attract: true } },\n  { scene: 'activity', args: { id: 'stand', attract: true, from: 60 } },\n];\nexport const ATTRACT_SECONDS = 14;\n\nexport class AttractDirector {\n  i = -1; t = 0; lineI = 0; lineT = 0; moved = 0; loops = 0; seen = [];\n\n  start() { this.next(); }\n\n  next() {\n    this.i++;\n    if (this.i >= ATTRACT_PLAYLIST.length) { this.i = 0; this.loops++; }\n    this.t = 0;\n    const item = ATTRACT_PLAYLIST[this.i];\n    this.seen.push(item.args.id ?? item.scene);\n    App.go(item.scene, { ...item.args });\n  }\n\n  /** Anything: key, click, mouse move past a few pixels, wheel, pad button or stick, touch. */\n  anyInput(ctx) {\n    const { input } = ctx;\n    if (input.queuedPresses.length) return true;\n    if (input.wheel) return true;\n    const s = input.state();\n    if ((s.held ?? []).length) return true;\n    if (Math.hypot(input.padAxis.x, input.padAxis.y) > 0.3) return true;\n    this.moved += App.device.moved;\n    if (this.moved > 6) return true;\n    return App.device.domInput;\n  }\n\n  tick(ctx, dt) {\n    if (this.anyInput(ctx)) { this.exit(); return; }\n    if (App.loading) return;\n    this.t += dt;\n    this.lineT += dt;\n    if (this.lineT > 7) { this.lineT = 0; this.lineI = (this.lineI + 1) % ATTRACT_LINES.length; }\n    if (this.t >= ATTRACT_SECONDS) this.next();\n  }\n\n  exit() {\n    App.attract = null;\n    App.dev.attractCheat = false;\n    App.go('title', {});\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    const h = 30;\n    const y = hud.height - h;\n    hud.rect(0, y, hud.width, h, 'navy');\n    const cx = Math.round(hud.width / 2);\n    sayCentered(hud, cx, y + 3, `${TITLE}  -  Press any button.`, { color: 'sand', name: 'attract-title' });\n    const line = ATTRACT_LINES[this.lineI];\n    if (line.length * 6 < hud.width) sayCentered(hud, cx, y + 16, line, { color: 'white', name: 'attract-line' });\n    else say(hud, 4, y + 16, line.slice(0, Math.floor((hud.width - 8) / 6)), { color: 'white', name: 'attract-line' });\n    if (App.touchOnly && !App.gamepadSeen) {\n      sayCentered(hud, cx, 4, 'Controller or keyboard', { color: 'sand', name: 'attract-touch' });\n      sayCentered(hud, cx, 14, 'required', { color: 'sand', name: 'attract-touch' });\n    }\n  }\n}\n\nApp.startAttract = () => {\n  if (App.session || App.attract) return;\n  App.attract = new AttractDirector();\n  App.attract.start();\n};\nEOF\ncat > src/scenes/index.js <<'EOF'\n// Every scene, registered with App so scenes never import each other in circles.\nimport { App } from '../app.js';\nimport { ACTIVITIES } from '../data/activities.js';\nimport { TitleScene } from './title.js';\nimport { PoseActivity } from './activity/poses.js';\nimport './attract.js';\nimport '../ui/screens/pause.js';\n\nexport const ACTIVITY_SCENES = {\n  poses: PoseActivity,\n};\n\nApp.registerScenes({\n  title: (a) => new TitleScene(a),\n  activity: (a) => new ACTIVITY_SCENES[ACTIVITIES[a.id].scene](a),\n});\n\nexport function makeScene(id, args = {}) { return App.scenes[id](args); }\nEOF\ncat > src/main.js <<'EOF'\n// Boot: session check, Engine.start, first scene.\nimport { applyDeadzone, Engine, PALETTE, withUrlOptions } from '../pixel-engine.js';\nimport { App } from './app.js';\nimport { makeScene } from './scenes/index.js';\n\nconst touchOnly = typeof matchMedia === 'function' && matchMedia('(hover: none) and (pointer: coarse)').matches && !(navigator.getGamepads && [...navigator.getGamepads()].some(Boolean));\n\nfunction installDomListeners() {\n  const mark = () => { App.device.domInput = true; };\n  window.addEventListener('keydown', mark, { passive: true });\n  window.addEventListener('pointerdown', mark, { passive: true });\n  window.addEventListener('wheel', mark, { passive: true });\n  window.addEventListener('contextmenu', (e) => e.preventDefault());\n  window.addEventListener('gamepadconnected', () => { App.gamepadSeen = true; });\n}\n\nlet info = null;\nif (window.AIHub?.active) info = await window.AIHub.connect({ mode: 'ghost', seats: [1, 4], card: true });\n\nApp.boot({ session: info, touchOnly });\nApp.applyDeadzone = applyDeadzone;\ninstallDomListeners();\n\nconst first = makeScene(info ? 'medley' : 'title', info ? { session: true } : {});\nconst camera = first.cameraConfig?.();\ntry {\n  const engine = await Engine.start(first, withUrlOptions({\n    container: document.getElementById('app'),\n    aspect: 'fill',\n    touch: false,\n    settings: { button: touchOnly ? 'top-right' : false },\n    quality: info ? 'medium' : 'high',\n    seed: info ? info.seed : 7,\n    background: PALETTE.sky,\n    camera,\n  }));\n  App.ensureInit(engine);\n  if (info) window.AIHub.ready();\n} catch (err) {\n  if (info) window.AIHub.fail(String(err?.message ?? err));\n  console.warn('[We Fit In]', err?.message ?? err);\n}\nEOF\npython3 - <<'EOF'\np='src/app.js'; s=open(p).read()\ns=s.replace(\"\"\"  /** For tests: the whole picture as data. */\"\"\",\"\"\"  /** Go wherever this guest's week is up to. */\n  continueWeek() {\n    const slot = this.slot;\n    if (!slot) return;\n    if (slot.phase === 'ferry') return this.go('ferry');\n    if (slot.phase === 'morning') return this.go('weighin');\n    if (slot.phase === 'report') return this.go('report');\n    if (slot.phase === 'ending') return this.go('ending');\n    return this.go('hub', {});\n  },\n\n  /** For tests: the whole picture as data. */\"\"\")\nopen(p,'w').write(s)\nEOF\ntimeout 60 node tools/build.mjs </dev/null 2>&1 | tail -20; ls -la .. | head; python3 -c \"\nimport json;print(list(json.load(open('../exit-interview.json')).keys()))\"","description":"Write title, menus, attract, boot and main, then run the first build","timeout":90000}}}
