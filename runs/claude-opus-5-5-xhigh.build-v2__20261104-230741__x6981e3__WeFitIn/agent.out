ething near it.', 'It\\\\'s fine. It\\\\'s just the one leg.', 'Nearly had it that time. Nearly had what, I don\\\\'t know.', 'Don\\\\'t look at the deck chair. It knows.'],\n  june: ['I\\\\'m pacing myself.', 'My gran says you\\\\'re doing your best. She said it very slowly.', 'I\\\\'m twelve. I don\\\\'t have knees yet.', 'This is the fun part. Apparently.'],\n};\n\n/** Ounce, following you around the island. */\"\"\"),\n])\nsub('src/data/alllines.js',[\n(\"import { AGE_LINES, ATTRACT_LINES, BARKS, CONCERNS, CONFESSION, CONFESSION_AFTER, CREDITS_SIGNOFF, FERRY_LINES, HAMMOCK_LINES, INTRO_LINES, IDLE_BARKS, ISLAND_BARKS, LONG_STAND_LINES, MORNINGS, OW_JOKE, OW_LINES, REPORT_LINES, RESULT_LINES, STATION_REMARKS, WEEK2_LINES } from './lines.js';\",\n \"import { AGE_LINES, ATTRACT_LINES, BARKS, CLASSMATE_BARKS, CONCERNS, CONFESSION, CONFESSION_AFTER, CREDITS_SIGNOFF, FERRY_LINES, HAMMOCK_LINES, INTRO_LINES, IDLE_BARKS, ISLAND_BARKS, MORNINGS, OW_JOKE, OW_LINES, REPORT_LINES, RESULT_LINES, STATION_REMARKS, WEEK2_LINES, WOBBLE_LINE } from './lines.js';\\nimport { STAND_TIMELINE } from './longstand.js';\"),\n(\"  for (const s of Object.values(LONG_STAND_LINES)) push('coach', s);\\n\",\"  for (const e of STAND_TIMELINE) if (e.say) out.push({ who: e.say[0], text: e.say[1] });\\n  for (const [who, list] of Object.entries(CLASSMATE_BARKS)) for (const s of list) out.push({ who, text: s });\\n  push('ounce', WOBBLE_LINE.replace('%W', '14'));\\n\"),\n])\n# Results: the wobble count, for real\nsub('src/ui/screens/results.js',[\n(\"import { RESULT_LINES } from '../../data/lines.js';\",\"import { RESULT_LINES, WOBBLE_LINE } from '../../data/lines.js';\"),\n(\"\"\"    if (!r.firstEver && r.stars < 3 && rand() < 0.25 && RESULT_LINES[r.id]?.repeat) this.line = RESULT_LINES[r.id].repeat[0];\n\"\"\",\"\"\"    if (!r.firstEver && r.stars < 3 && rand() < 0.25 && RESULT_LINES[r.id]?.repeat) this.line = RESULT_LINES[r.id].repeat[0];\n    if (r.wobbles > 1 && !r.firstEver && rand() < 0.35) 