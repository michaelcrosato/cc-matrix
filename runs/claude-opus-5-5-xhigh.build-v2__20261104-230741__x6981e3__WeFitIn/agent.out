{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjK2FjtyuBUSJr1C24QN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PmnGVQiLxin2TeY9o2M1iS","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/scenes/sets.js <<'EOF'\n// Places. Everything is built from the island's giant equipment and clean white tile.\nimport { applySky, Boids, GrassField, Mirror, PALETTE, RippleField, setLookLayer, skyAt, THREE, toonMaterial, WAVES_CALM, WaterSurface } from '../../pixel-engine.js';\nimport { place } from '../art/props.js';\nimport { floorPlane } from '../art/textures.js';\n\nconst { BoxGeometry, Color, Group, Mesh, MeshBasicMaterial, DoubleSide, PlaneGeometry } = THREE;\n\nexport function box(ctx, w, h, d, at, color, { cast = true, receive = true, collide = false, parent = null } = {}) {\n  const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(PALETTE[color]));\n  m.position.set(...at);\n  m.castShadow = cast;\n  m.receiveShadow = receive;\n  (parent ?? ctx.scene).add(m);\n  if (collide) ctx.physics.addStaticBox({ position: at, halfExtents: [w / 2, h / 2, d / 2] });\n  return m;\n}\n\nexport function setSky(ctx, hour = 11) {\n  applySky(ctx.engine, skyAt(hour));\n  if (hour > 8 && hour < 16) {\n    ctx.scene.background = new Color(PALETTE.sky);\n    ctx.engine.sun.intensity = Math.max(ctx.engine.sun.intensity, 2.4);\n    ctx.engine.ambient.intensity = Math.max(ctx.engine.ambient.intensity, 1.3);\n  }\n}\n\nexport function sea(ctx, { size = [160, 120], at = [0, -0.5, -60], ripples = false } = {}) {\n  const rip = ripples ? new RippleField({ size, cells: [Math.round(size[0] * 3), Math.round(size[1] * 3)], center: [at[0], at[2]] }) : null;\n  const water = new WaterSurface({ size, at, waves: WAVES_CALM, segments: rip ? undefined : [40, 30], ripples: rip, deep: PALETTE.blue, shallow: PALETTE.cyan, foam: PALETTE.white });\n  ctx.scene.add(water);\n  return water;\n}\n\n/** Soft light, faked as a slanted ghost of a plane. */\nexport function sunbeam(ctx, x, z, h = 7, w = 1.1) {\n  const m = new Mesh(new PlaneGeometry(w, h), new MeshBasicMaterial({ color: PALETTE.sand, transparent: true, opacity: 0.1, depthWrite: false, side: DoubleSide }));\n  m.position.set(x, h / 2 - 0.1, z);\n  m.rotation.z = 0.32;\n  m.rotation.y = 0.2;\n  m.castShadow = false;\n  ctx.scene.add(m);\n  return m;\n}\n\nexport function matsFor(n) {\n  if (n >= 4) return [-3, -1, 1, 3];\n  if (n === 3) return [-2.2, 0, 2.2];\n  if (n === 2) return [-1, 1];\n  return [0];\n}\nexport const MAT_Z3 = 0.8;\nexport const MAT_Z4 = 0.8;\n\nconst roofFor = { pavilion: 'sky', medley: 'teal' };\n\n/** Pavilion of Holding Still: tile, columns, sea behind, a rail for Kevin. */\nexport function pavilionSet(ctx) {\n  setSky(ctx, 10);\n  ctx.scene.add(floorPlane('clinic-tile', 36, 22, { at: [0, 0, -2] }));\n  box(ctx, 36, 0.5, 22, [0, -0.26, -2], 'mist', { cast: false });\n  sea(ctx, { at: [0, -0.9, -70], size: [200, 120] });\n  // Colonnade behind the mats.\n  for (const x of [-10, -6.5, 6.5, 10]) {\n    const m = new Mesh(new THREE.CylinderGeometry(0.36, 0.42, 5.2, 8), toonMaterial(PALETTE.white));\n    m.position.set(x, 2.6, -5);\n    m.castShadow = true;\n    ctx.scene.add(m);\n    box(ctx, 1, 0.3, 1, [x, 5.25, -5], 'mist');\n  }\n  box(ctx, 24, 0.5, 1.2, [0, 5.6, -5], 'white');\n  box(ctx, 26, 0.3, 2.2, [0, 6, -5], 'sky');\n  const rail = place(ctx, 'class-rail', { at: [0, 0, -3.1], params: { len: 11 } });\n  place(ctx, 'palm', { at: [-13, 0, -7.5], yaw: 30, scale: 1.3 });\n  place(ctx, 'palm', { at: [12.5, 0, -8.5], yaw: 200, scale: 1.2 });\n  sunbeam(ctx, -4.5, -1.4); sunbeam(ctx, -1, -2.4, 7.5, 1.4); sunbeam(ctx, 3.2, -1.8, 7, 0.9);\n  ctx.engine.setSunDirection([0.5, 0.75, 0.55]);\n  return { railY: 1.11, railZ: -3.1, rail };\n}\n\n/** The Rep Shed, inside: sprung floor, a mirror wall, giant dumbbells. */\nexport function shedSet(ctx) {\n  setSky(ctx, 11);\n  ctx.scene.background = new Color(PALETTE.white);\n  ctx.scene.add(floorPlane('gym-floor', 24, 14, { at: [0, 0, 0] }));\n  box(ctx, 24, 0.5, 14, [0, -0.26, 0], 'orange', { cast: false });\n  box(ctx, 24, 6, 0.4, [0, 3, -3.4], 'white', { cast: false });\n  box(ctx, 0.4, 6, 14, [-9, 3, 0], 'mist', { cast: false });\n  box(ctx, 0.4, 6, 14, [9, 3, 0], 'mist', { cast: false });\n  box(ctx, 24, 0.5, 14, [0, 6, 0], 'mist', { cast: false });\n  box(ctx, 24, 0.3, 0.1, [0, 3.7, -3.1], 'orange', { cast: false });\n  box(ctx, 24, 0.5, 0.1, [0, 0.25, -3.15], 'slate', { cast: false });\n  const mirror = new Mirror({ size: [11, 3] });\n  mirror.mesh.position.set(0, 2.1, -3.14);\n  ctx.scene.add(mirror.mesh);\n  const stop = mirror.attach(ctx.engine.renderer, ctx.scene);\n  place(ctx, 'giant-dumbbell', { at: [-6.6, 0, -1.8], yaw: 20 });\n  place(ctx, 'giant-dumbbell', { at: [6.6, 0, -2], yaw: -15 });\n  place(ctx, 'giant-dumbbell', { at: [6.2, 0.82, -2], yaw: 10 });\n  place(ctx, 'towel-rack', { at: [-7.6, 0, 1.4], yaw: 90 });\n  ctx.engine.setSunDirection([0.3, 0.9, 0.4]);\n  return { mirror, stop };\n}\n\n/** Beat Beach: sand, the stage behind, the sea. */\nexport function beachSet(ctx) {\n  setSky(ctx, 12);\n  box(ctx, 44, 0.6, 26, [0, -0.3, -2], 'sand', { cast: false });\n  sea(ctx, { at: [0, -0.7, -75], size: [220, 120] });\n  place(ctx, 'beat-stage', { at: [0, 0, -5.6] });\n  place(ctx, 'palm', { at: [-9.5, 0, -3.8], yaw: 10, scale: 1.2 });\n  place(ctx, 'palm', { at: [9.8, 0, -4.4], yaw: 170, scale: 1.3 });\n  place(ctx, 'medicine-ball', { at: [-7.4, 0, 1.2], scale: 0.7 });\n  ctx.engine.setSunDirection([0.4, 0.85, 0.5]);\n  return {};\n}\n\n/** Lagoon Games: sand, water, the pier running off to one side. */\nexport function lagoonSet(ctx) {\n  setSky(ctx, 13);\n  box(ctx, 44, 0.6, 18, [0, -0.3, 0], 'sand', { cast: false });\n  sea(ctx, { at: [0, -0.6, -70], size: [220, 120] });\n  place(ctx, 'palm', { at: [-10, 0, -5], yaw: 20, scale: 1.2 });\n  place(ctx, 'palm', { at: [10.5, 0, -6], yaw: 150, scale: 1.1 });\n  place(ctx, 'medicine-ball', { at: [8, 0, 1.6], scale: 0.6 });\n  ctx.engine.setSunDirection([0.3, 0.85, 0.5]);\n  return {};\n}\n\n/** Tare Island, close up, for the title: tile, Ounce's dais, palms, the volcano far off. */\nexport function plazaSet(ctx, hour = 10) {\n  setSky(ctx, hour);\n  ctx.scene.add(floorPlane('clinic-tile', 40, 26, { at: [0, 0, -2] }));\n  box(ctx, 40, 0.5, 26, [0, -0.26, -2], 'mist', { cast: false });\n  sea(ctx, { at: [0, -0.9, -80], size: [260, 130] });\n  place(ctx, 'kettlebell-volcano', { at: [-16, -1, -26], scale: 1 });\n  place(ctx, 'foam-roller-hill', { at: [15, -1, -22], yaw: 16 });\n  place(ctx, 'palm', { at: [-9.5, 0, -6], yaw: 60, scale: 1.3 });\n  place(ctx, 'palm', { at: [8.5, 0, -7], yaw: 210, scale: 1.2 });\n  place(ctx, 'palm', { at: [12.5, 0, -2], yaw: 170 });\n  place(ctx, 'medicine-ball', { at: [-6.5, 0, -8] });\n  place(ctx, 'medicine-ball', { at: [-4.2, 0, -9.5], scale: 0.7 });\n  return {};\n}\n\nexport function gulls(ctx, n = 7, bounds = { min: [-14, 6, -14], max: [14, 10, 4] }) {\n  const flock = new Boids(n, { bounds, maxSpeed: 3.2, minSpeed: 1.8, view: 5, space: 2, seed: 4 });\n  const meshes = [];\n  const mat = toonMaterial(PALETTE.white);\n  for (let i = 0; i < n; i++) {\n    const g = new Group();\n    const body = new Mesh(new BoxGeometry(0.22, 0.14, 0.42), mat);\n    const w1 = new Mesh(new BoxGeometry(0.5, 0.05, 0.2), mat);\n    const w2 = new Mesh(new BoxGeometry(0.5, 0.05, 0.2), mat);\n    w1.position.x = 0.32; w2.position.x = -0.32;\n    g.add(body, w1, w2);\n    setLookLayer(g, 'actors');\n    ctx.scene.add(g);\n    meshes.push({ g, w1, w2 });\n  }\n  return {\n    flock,\n    update(dt, t) {\n      flock.step(Math.min(dt, 1 / 30));\n      meshes.forEach((m, i) => {\n        const p = i * 3;\n        m.g.position.set(flock.pos[p], flock.pos[p + 1], flock.pos[p + 2]);\n        m.g.rotation.y = Math.atan2(flock.vel[p], flock.vel[p + 2]);\n        const f = Math.sin(t * 9 + i) * 0.5;\n        m.w1.rotation.z = f; m.w2.rotation.z = -f;\n      });\n    },\n  };\n}\n\nexport function grass(ctx, area, at, mask, count = 1600) {\n  const g = new GrassField({ area, at, count, height: [0.2, 0.42], base: PALETTE.green, tip: PALETTE.lime, mask, seed: 3 });\n  ctx.scene.add(g);\n  return g;\n}\n\nexport { roofFor };\nEOF\ncat > src/scenes/activity/events.js <<'EOF'\n// Lane events: the same code for solo classes, Family Hour and online ghosts.\nimport { THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { BotBrain, blankInput } from '../../core/drivers.js';\nimport { CLIP_NAMES } from '../../art/clips.js';\nimport { drawDial } from '../../ui/widgets.js';\n\nconst { Vector3 } = THREE;\nconst v = new Vector3();\n\n/** Project a world point to art pixels. */\nexport function worldToArt(ctx, x, y, z) {\n  v.set(x, y, z).project(ctx.camera.camera);\n  return { x: (v.x + 1) * 0.5 * ctx.hud.width, y: (1 - v.y) * 0.5 * ctx.hud.height };\n}\n\nexport class Lane {\n  constructor({ index, name, who = null, look, driver, x = 0, z = 0.8, color = 'red', isPlayer = false, isLocal = false, rand }) {\n    Object.assign(this, { index, name, who, look, driver, x, z, color, isPlayer, isLocal, rand });\n    this.inp = blankInput();\n    this.dot = new Dot(rand);\n    this.m = {};\n    this.score = 0;\n    this.brain = null;\n    this.state = {};\n    this.gone = false;\n    this.dial = null;\n  }\n\n  get ghost() { return this.driver?.kind === 'ghost'; }\n}\n\nexport class LaneEvent {\n  kind = 'event';\n  duration = 60;\n\n  constructor(scene, lanes, rng, opts = {}) {\n    this.scene = scene;\n    this.ctx = scene.ctx;\n    this.lanes = lanes;\n    this.rng = rng;\n    this.opts = opts;\n    this.hard = opts.hard ?? {};\n  }\n\n  begin() { for (const l of this.lanes) this.beginLane(l); }\n  beginLane() {}\n\n  /** Fill lane.inp for this step, whoever's driving. */\n  read(ctx, lane, dt, t) {\n    const inp = lane.inp;\n    inp.stepL = inp.stepR = inp.confirm = false;\n    const d = lane.driver;\n    const auto = lane.isPlayer ? App.dev.autopilot : null;\n    if (d.kind === 'bot' || auto) {\n      const skill = auto ?? d.skill;\n      if (!lane.brain || lane.brain.skill !== skill) lane.brain = new BotBrain(skill, lane.rand);\n      inp.rate = false;\n      this.botInput(lane, inp, dt, t, lane.brain);\n    } else if (d.kind === 'pad') d.read(inp);\n    else if (d.kind !== 'ghost') d.read(inp, ctx, dt, App, lane.dial);\n    return inp;\n  }\n\n  /** One fixed step for the whole event. */\n  step(ctx, dt, t, scoring = true) {\n    this.tick?.(ctx, dt, t, scoring);\n    for (const lane of this.lanes) {\n      if (lane.gone || lane.ghost) continue;\n      this.read(ctx, lane, dt, t);\n      this.stepLane(ctx, lane, lane.inp, dt, t, scoring);\n    }\n  }\n\n  stepLane() {}\n  botInput(lane, out) { out.x = out.y = 0; }\n  visual() {}\n  draw() {}\n  scoreOf(lane) { return lane.score; }\n  /** 0..1000 for the Medley. */\n  normalized(lane) { return Math.max(0, Math.min(1000, Math.round(this.scoreOf(lane) * 10))); }\n  /** For ghosts: the clip and time this lane shows. */\n  clipState(lane) {\n    const a = lane.avatar?.current;\n    if (!a) return [0, 0];\n    return [CLIP_NAMES.indexOf(a.getClip().name), a.time];\n  }\n  /** Show a ghost's lane: lerp, never simulate. */\n  ghostVisual(lane, dt) {\n    const g = lane.driver;\n    g.lerp(dt);\n    const av = lane.avatar;\n    if (!av) return;\n    const name = CLIP_NAMES[g.clip] ?? 'Idle';\n    if (this.ghostScrubs?.(name)) av.scrub(name, g.clipTime);\n    else av.play(name, { fade: 0.25 });\n    av.update(dt);\n    av.lean(g.x, g.y);\n  }\n  dispose() {}\n}\n\n/** The dial for a local lane. In 4-mat staging each player gets a small one over their head. */\nexport function drawLaneDial(ctx, event, lane, ringR, { ringX = 0, ringY = 0, inside = false, brighten = 0, target = null, fade = 1 } = {}) {\n  const small = event.lanes.length >= 4 || !event.scene.centreDial;\n  let x, y, r;\n  if (small) {\n    const p = worldToArt(ctx, lane.x, 2.2, lane.z);\n    r = 24;\n    x = p.x; y = Math.max(r + 14, p.y - r);\n    x = Math.max(r + 4, Math.min(ctx.hud.width - r - 4, x));\n  } else {\n    x = Math.round(ctx.hud.width / 2); y = 56; r = 44;\n    if (ctx.hud.height < 250) y = 52;\n  }\n  lane.dial = { x, y };\n  const mouse = lane.isLocal && App.device.last === 'mouse' && lane.driver.kind !== 'pad' && lane.driver.kind !== 'bot' && !App.dev.autopilot ? App.device.pointerArt(ctx) : null;\n  drawDial(ctx.hud, { x, y, r, dot: lane.dot, ringR, ringX, ringY, inside, brighten, target, fade, mouse, color: lane.color });\n  return { x, y, r };\n}\nEOF\ncat > src/scenes/activity/poses.js <<'EOF'\n// Holding Still. The whole game in miniature.\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { POSES, RELEASE, SETTLE } from '../../data/poses.js';\nimport { BARKS } from '../../data/lines.js';\nimport { bar, say, sayCentered } from '../../ui/widgets.js';\nimport { drawLaneDial, LaneEvent } from './events.js';\nimport { LaneActivity } from './lanes.js';\nimport { pavilionSet } from '../sets.js';\n\nexport class PoseEvent extends LaneEvent {\n  kind = 'pose';\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.poseId = opts.pose;\n    this.pose = POSES[opts.pose];\n    this.hold = opts.hold ?? this.pose.hold;\n    this.settle = opts.settle ?? SETTLE;\n    this.release = opts.release ?? RELEASE;\n    this.duration = this.settle + this.hold + this.release;\n    this.ringBase = this.pose.ring * (this.hard.ring ?? 1);\n    this.wanderPhase = rng.range(0, 6.28);\n    this.ringX = 0;\n  }\n\n  get breathing() { return this.pose.breath > 0; }\n\n  beginLane(l) {\n    l.dot.reset();\n    l.state = { in: 0, n: 0, breath: 0, s: 0.5, inside: false, streak: 0, wobbles: 0, clip: this.pose.clip };\n    l.score = 0;\n    l.avatar?.play(this.pose.clip, { fade: 0.5 });\n  }\n\n  ring() { return App.ringOf(this.ringBase) * (this.scene.ringBoost ?? 1); }\n\n  wantIn(t) { const p = this.pose.breath; return ((t % p) / p) < 0.5; }\n  breathLevel(t) { const p = this.pose.breath; const u = (t % p) / p; return u < 0.5 ? u * 2 : (1 - u) * 2; }\n\n  tick(ctx, dt, t) {\n    const tw = this.pose.twist;\n    if (tw.wanderX) this.ringX = tw.wanderX * (this.hard.wander ?? 1) * Math.sin(t * (tw.wanderSpeed ?? 0.3) * 6.283 * 0.5 + this.wanderPhase);\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const tw = this.pose.twist;\n    const m = lane.m;\n    const u = this.hold > 0 ? Math.min(1, Math.max(0, (t - this.settle) / this.hold)) : 0;\n    let noise = App.noiseScale();\n    if (tw.noiseRamp) noise *= tw.noiseRamp[0] + (tw.noiseRamp[1] - tw.noiseRamp[0]) * u;\n    m.noiseY = tw.noiseY ?? 1;\n    m.inst = tw.inst ?? 1;\n    const st = lane.state;\n    if (this.breathing) {\n      const match = inp.breath === this.wantIn(t) ? 1 : 0;\n      st.s += (match - st.s) * Math.min(1, dt / 0.6);\n      noise *= 1.25 - T.breathBonus * st.s;\n    }\n    if (tw.tremorAfter && t - this.settle > tw.tremorAfter) noise *= 1.35;\n    m.noise = noise;\n    lane.dot.step(dt, inp.x, inp.y, T, m);\n    const ring = this.ring();\n    if (App.dev.god && lane.isPlayer) lane.dot.clampTo(this.ringX, 0, ring * 0.9);\n    if (this.scene.cheatRing && lane.isPlayer) lane.dot.clampTo(this.ringX, 0, ring * 0.9);\n    const inside = Math.hypot(lane.dot.x - this.ringX, lane.dot.y) <= ring;\n    const counts = scoring && t >= this.settle && t < this.settle + this.hold;\n    if (inside !== st.inside) {\n      st.inside = inside;\n      if (lane.isPlayer && t >= this.settle) {\n        if (inside) { App.sfx('ringIn', { volume: 0.7 }); this.scene.ringBark?.('in'); } else { st.wobbles++; App.sfx('ringOut', { volume: 0.5 }); this.scene.ringBark?.('out'); }\n      }\n    }\n    st.streak = inside ? st.streak + dt : 0;\n    if (counts) {\n      st.n++;\n      if (inside) st.in++;\n      if (this.breathing) st.breath += st.s;\n      lane.score = this.scoreOf(lane);\n    }\n  }\n\n  botInput(lane, out, dt, t, brain) {\n    brain.lean(out, lane.dot, this.ringX, 0, dt);\n    if (this.breathing && brain.p) {\n      const late = brain.play.react * 0.7;\n      out.breath = this.wantIn(t - late);\n      if (brain.play.miss > 0 && lane.rand() < brain.play.miss * 0.02) lane.state.slip = 0.8;\n      if ((lane.state.slip ?? 0) > 0) { lane.state.slip -= dt; out.breath = !out.breath; }\n    } else out.breath = false;\n  }\n\n  scoreOf(lane) {\n    const st = lane.state;\n    if (!st.n) return 0;\n    const inRing = st.in / st.n;\n    if (this.breathing) return 100 * (0.8 * inRing + 0.2 * (st.breath / st.n));\n    return 100 * inRing;\n  }\n\n  visual(ctx, dt, t) {\n    const ring = this.ring();\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) { this.ghostVisual(lane, dt); continue; }\n      const d = Math.hypot(lane.dot.x - this.ringX, lane.dot.y);\n      const far = d > ring + 0.5;\n      lane.avatar.play(far ? 'Teeter' : this.pose.clip, { fade: 0.3 });\n      lane.avatar.update(dt);\n      const tremble = d > ring ? Math.min(1.5, (d - ring) * 3) : 0;\n      lane.avatar.lean(lane.dot.x, lane.dot.y, tremble, t);\n    }\n  }\n\n  draw(ctx, t) {\n    const { hud } = ctx;\n    const local = this.lanes.filter((l) => l.isLocal && !l.gone);\n    const ring = this.ring();\n    for (const lane of local) {\n      const st = lane.state;\n      const before = t < this.settle;\n      const dial = drawLaneDial(ctx, this, lane, ring, { ringX: this.ringX, inside: st.inside, brighten: Math.min(1, st.streak / 4) });\n      if (this.breathing) {\n        const w = 8, h = dial.r * 2;\n        const bx = dial.x + dial.r + 6;\n        const lvl = this.breathLevel(t);\n        hud.rect(bx - 1, dial.y - dial.r - 1, w + 2, h + 2, 'ink');\n        hud.rect(bx, dial.y - dial.r, w, h, 'white');\n        hud.rect(bx, dial.y + dial.r - Math.round(h * lvl), w, Math.round(h * lvl), this.wantIn(t) ? 'sky' : 'cyan');\n        if (lane.isLocal && this.lanes.length < 4) say(hud, bx + w + 3, dial.y - 4, this.wantIn(t) ? 'In...' : 'Out...', { color: inpMatch(lane, this, t) ? 'lime' : 'white', name: 'breath' });\n      }\n      if (before && this.lanes.length < 4) sayCentered(hud, dial.x, dial.y + dial.r + 5, 'Settle.', { color: 'white', name: 'settle' });\n    }\n  }\n}\n\nfunction inpMatch(lane, ev, t) { return lane.inp.breath === ev.wantIn(t); }\n\nexport class PoseActivity extends LaneActivity {\n  makeEvent(lanes, rng, hard) { return new PoseEvent(this, lanes, rng, { pose: this.def.pose, hard, hold: this.args.hold }); }\n\n  async dress(ctx) {\n    this.set = pavilionSet(ctx);\n    await this.addCoach(ctx, { at: [4.1, 0.36, -0.9], yaw: -0.5, clip: this.def.pose ? POSES[this.def.pose].clip : 'CoachStand', dais: true });\n    await this.addKevin(ctx, [-3.6, this.set.railY, this.set.railZ]);\n    this.nextMote = 0;\n    this.barkT = 0;\n    this.pushIn = 0;\n  }\n\n  ringBark(kind) {\n    if (this.t < this.barkT || this.attractMode) return;\n    this.barkT = this.t + 6;\n    const list = kind === 'in' ? BARKS.ringIn : BARKS.ringOut;\n    App.say('ounce', this.cosmetic.pick(list));\n  }\n\n  playVisual(ctx, dt) {\n    if (this.t > this.nextMote) {\n      this.nextMote = this.t + 0.28;\n      ctx.particles.burst('zen', [this.cosmetic.range(-6, 6), this.cosmetic.range(0.6, 3.6), this.cosmetic.range(-2, 2)]);\n    }\n    const you = this.playerLane;\n    if (you && this.phase === 'play') {\n      this.pushIn += ((you.state.inside ? 1 : 0) - this.pushIn) * Math.min(1, dt * 0.25);\n      this.camPush = this.pushIn * 0.9;\n      if (you.state.streak > 10 && !this.saidStreak) { this.saidStreak = true; App.say('ounce', this.cosmetic.pick(BARKS.streak)); }\n    }\n  }\n\n  fingerprint() {\n    const l = this.playerLane;\n    return l ? `${l.state.in}|${l.state.n}|${l.dot.x.toFixed(6)}|${l.dot.y.toFixed(6)}` : '';\n  }\n\n  overlayDot() {\n    const l = this.playerLane;\n    return l ? `${l.dot.x.toFixed(2)},${l.dot.y.toFixed(2)} ring ${this.event.ring().toFixed(2)}` : '-';\n  }\n}\n\nexport { bar };\nEOF\ncat > src/scenes/activity/base.js <<'EOF'\n// The shared flow: intro -> practice -> countdown -> play -> outro -> Results.\nimport { THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { blankInput, BotBrain, LocalDriver } from '../../core/drivers.js';\nimport { applyResult, hardOpen, starsFor } from '../../core/week.js';\nimport { CONFIRM } from '../../core/actions.js';\nimport { ACTIVITIES } from '../../data/activities.js';\nimport { BaseScene, laneCamera } from '../base.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { panel, say, sayCentered, SAFE, wrapCard } from '../../ui/activity-hud.js';\nimport { ResultsScreen } from '../../ui/screens/results.js';\nimport { Kevin, Ounce } from '../../art/props.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { controlsFor } from '../../data/howto.js';\n\nconst { Vector3 } = THREE;\n\nexport const CAMERAS = {\n  lane3: () => laneCamera(3),\n  lane4: () => laneCamera(4),\n  header: () => ({ preset: 'fixed', position: [0, 3.1, 8.6], target: [0, 1.4, 0], fov: 34 }),\n  slackline: () => ({ preset: 'fixed', position: [0, 3.2, -6], target: [0, 1.6, 6], fov: 46 }),\n  tray: () => ({ preset: 'fixed', position: [0, 7.6, 4.2], target: [0, 0, 0.1], fov: 38 }),\n  pier: () => ({ preset: 'side', zoom: 1, minZoom: 0.2, maxZoom: 4 }),\n  jog: () => ({ preset: 'iso', zoom: 1.4, minZoom: 1.4, maxZoom: 1.4 }),\n  stand: () => ({ preset: 'fixed', position: [0, 2.2, 7.6], target: [0, 1.1, 0], fov: 32 }),\n};\n\nconst scratch = new Vector3();\n\nexport class ActivityScene extends BaseScene {\n  canPause = true;\n  id = 'activity';\n  phase = 'boot';\n  phaseT = 0;\n  playT = 0;\n  totalPlay = 0;\n  camPush = 0;\n  camGlide = 0;\n  scoring = false;\n\n  constructor(args = {}) {\n    super(args);\n    this.activity = args.id;\n    this.def = ACTIVITIES[args.id];\n    this.name = `activity:${args.id}`;\n    this.mode = args.mode ?? 'dropin';\n    this.hard = !!args.hard;\n    this.attractMode = !!args.attract;\n    this.hardData = this.hard ? (this.def.hard ?? {}) : {};\n    this.ringBoost = this.attractMode ? 2 : 1;\n    this.cheatRing = this.attractMode;\n    this.inp = blankInput();\n    this.driver = new LocalDriver();\n  }\n\n  cameraConfig() { return CAMERAS[this.def.camera]?.() ?? CAMERAS.lane3(); }\n\n  get autopilot() { return this.attractMode ? 'expert' : App.dev.autopilot; }\n\n  async build(ctx) {\n    this.rng = ctx.random.fork('play');\n    this.cosmetic = ctx.random.fork('cosmetic');\n    this.botRand = ctx.random.fork('bot');\n    this.base = this.cameraConfig();\n    await this.stage(ctx);\n    this.startMusic();\n    if (this.attractMode) { this.begin(false); this.enter('play'); } else this.enter('intro');\n  }\n\n  startMusic() { App.music(this.def.song); }\n\n  async stage() {}\n  begin() {}\n  stepPlay() {}\n  isOver() { return this.playT >= this.playLength(); }\n  playLength() { return 60; }\n  /** { score, seconds, display, stars?, max? } */\n  result() { return { score: 0, seconds: this.playT, display: '0' }; }\n  botInput() {}\n  visual() {}\n  drawGame() {}\n  drawGameHud() {}\n\n  /** One player, not on a lane: stick, keys, mouse or autopilot. */\n  readPlayer(ctx, dt, dial) {\n    const out = this.inp;\n    out.stepL = out.stepR = out.confirm = false;\n    const auto = this.autopilot;\n    if (auto) {\n      if (!this.brain || this.brain.skill !== auto) this.brain = new BotBrain(auto, () => this.botRand.next());\n      out.rate = false;\n      this.botInput(out, dt, this.brain);\n    } else this.driver.read(out, ctx, dt, App, dial);\n    return out;\n  }\n\n  get practised() {\n    if (this.attractMode || this.args.noPractice) return true;\n    const rec = this.mode === 'week' ? App.slot?.records[this.activity] : App.store.data.dropin?.[this.activity];\n    return !!rec || (App.practised ??= {})[this.activity];\n  }\n\n  enter(phase) {\n    this.phase = phase;\n    this.phaseT = 0;\n    this.onEnter?.(phase);\n    switch (phase) {\n      case 'intro':\n        App.say('coach', this.def.coach);\n        this.camGlide = 1;\n        break;\n      case 'practice':\n        (App.practised ??= {})[this.activity] = true;\n        this.begin(true);\n        this.playT = 0;\n        break;\n      case 'countdown':\n        this.begin(false);\n        this.playT = 0;\n        this.lastCount = 4;\n        break;\n      case 'play':\n        this.playT = 0;\n        this.scoring = true;\n        this.onPlayStart?.();\n        break;\n      case 'outro':\n        this.scoring = false;\n        this.onOutroStart?.();\n        break;\n      default:\n        break;\n    }\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (this.phase === 'intro') {\n      if (input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft')) this.advanceIntro();\n    }\n  }\n\n  advanceIntro() {\n    if (this.phase !== 'intro') return;\n    App.sfx('menuConfirm');\n    this.enter(this.practised ? 'countdown' : 'practice');\n  }\n\n  onFixed(ctx, dt) {\n    if (this.resultsShown) { this.idleStep?.(ctx, dt); return; }\n    this.phaseT += dt;\n    switch (this.phase) {\n      case 'intro':\n        if (this.autopilot && this.phaseT > 0.4) this.advanceIntro();\n        break;\n      case 'practice':\n        this.playT += dt;\n        this.stepPlay(ctx, dt, false);\n        if (this.phaseT >= 8) this.enter('countdown');\n        break;\n      case 'countdown': {\n        this.countStep?.(ctx, dt);\n        const n = Math.ceil(3 - this.phaseT);\n        if (n !== this.lastCount && n > 0) { this.lastCount = n; App.sfx('count'); }\n        if (this.phaseT >= 3) { App.sfx('countGo'); this.enter('play'); }\n        break;\n      }\n      case 'play':\n        this.playT += dt;\n        this.totalPlay += dt;\n        this.stepPlay(ctx, dt, true);\n        if (this.isOver()) this.enter('outro');\n        break;\n      case 'outro':\n        this.idleStep?.(ctx, dt);\n        if (this.phaseT >= (this.outroLength ?? 1.6)) this.finish();\n        break;\n      default:\n        break;\n    }\n  }\n\n  /** Write the result and show it. Dev Tools can force the stars. */\n  finish(force = null) {\n    if (this.resultsShown || this.attractMode) return;\n    this.resultsShown = true;\n    this.phase = 'results';\n    const r = this.result();\n    let stars = starsFor(this.def, r.score, r);\n    if (force !== null) stars = force;\n    const seconds = Math.max(r.seconds ?? this.totalPlay, 0);\n    const out = { ...r, stars, seconds, id: this.activity, hard: this.hard, mode: this.mode };\n    if (this.mode === 'week' && App.slot) {\n      Object.assign(out, applyResult(App.slot, this.activity, { score: r.score, stars, seconds, hard: this.hard }));\n      App.store.write();\n    } else if (this.mode === 'dropin') {\n      const d = (App.store.data.dropin ??= {});\n      const rec = d[this.activity] ?? { best: 0, stars: 0, plays: 0 };\n      out.firstEver = !d[this.activity];\n      out.newBest = r.score > rec.best;\n      rec.best = Math.max(rec.best, r.score); rec.stars = Math.max(rec.stars, stars); rec.plays++;\n      d[this.activity] = rec;\n      out.drips = 0;\n      App.store.write();\n    }\n    this.lastResult = out;\n    this.onFinish?.(out);\n    if (!this.args.noResults) App.stack.push(new ResultsScreen(this, out));\n  }\n\n  onUpdate(ctx, dt) {\n    if (this.base?.preset === 'fixed' && !App.dev.freeCam && !this.ownCamera) this.applyCamera(ctx, dt);\n    this.ounce?.update(dt);\n    this.kevin?.update(dt);\n    this.coach?.update(dt);\n    this.visual(ctx, dt);\n    this.playVisual?.(ctx, dt);\n  }\n\n  applyCamera(ctx, dt) {\n    const cam = ctx.camera.camera;\n    const b = this.base;\n    this.camGlide = this.phase === 'intro' ? Math.max(0, this.camGlide - dt * 0.5) : 0;\n    const g = this.camGlide * this.camGlide;\n    const px = b.position[0] + g * 3;\n    const py = b.position[1] + g * 1.6;\n    const pz = b.position[2] + g * 4 - this.camPush;\n    cam.position.set(px, py, pz);\n    cam.lookAt(b.target[0], b.target[1], b.target[2]);\n    if (cam.fov !== b.fov) { cam.fov = b.fov; cam.updateProjectionMatrix(); }\n    void scratch;\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    this.drawGame(ctx);\n    if (this.attractMode) return;\n    if (this.phase === 'intro') this.drawCard(ctx);\n    if (this.phase === 'practice') {\n      hud.rect(Math.round(hud.width / 2) - 40, hud.height - 56, 80, 14, 'navy');\n      sayCentered(hud, hud.width / 2, hud.height - 54, 'Try it.', { color: 'sand', name: 'practice' });\n      this.drawControls(ctx);\n    }\n    if (this.phase === 'countdown') {\n      const n = Math.max(1, Math.ceil(3 - this.phaseT));\n      sayCentered(hud, hud.width / 2, Math.round(hud.height * 0.42), String(n), { scale: 4, color: 'sand', name: 'count' });\n    }\n    if (this.phase === 'play' && this.playT < 0.8) sayCentered(hud, hud.width / 2, Math.round(hud.height * 0.42), 'Begin.', { scale: 3, color: 'white', name: 'begin' });\n    if (this.phase === 'play') this.drawGameHud(ctx);\n  }\n\n  drawControls(ctx) {\n    promptBar(ctx.hud, App.device, controlsFor(this.def, App.device.promptColumn()));\n  }\n\n  drawCard(ctx) {\n    const { hud } = ctx;\n    const w = Math.min(hud.width - SAFE * 2, 300);\n    const x = Math.round((hud.width - w) / 2);\n    const lines = wrapCard(this.def.goal, w - 16);\n    const h = 30 + lines.length * 11;\n    const y = 18;\n    panel(hud, x, y, w, h, { fill: 'navy', border: 'ink', name: 'card' });\n    sayCentered(hud, hud.width / 2, y + 5, this.def.name, { scale: 1, color: 'sand', name: 'card-title' });\n    if (this.hard) say(hud, x + 5, y + 5, 'HARD', { color: 'red', name: 'card-hard' });\n    lines.forEach((l, i) => sayCentered(hud, hud.width / 2, y + 18 + i * 11, l, { color: 'white', name: 'card-goal' }));\n    const list = [...controlsFor(this.def, App.device.promptColumn()), ['confirm', 'Begin']];\n    promptBar(hud, App.device, list);\n  }\n\n  /** Coach: to one side of the player, never directly behind: their silhouettes merge. */\n  async addCoach(ctx, { at, yaw = 0, clip = 'CoachStand', dais = false }) {\n    if (dais) {\n      const { place } = await import('../../art/props.js');\n      place(ctx, 'dais', { at: [at[0], 0, at[2]] });\n    }\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at, yaw, clip });\n    this.coach.addPlumb();\n    return this.coach;\n  }\n\n  async addKevin(ctx, at, yaw = 0.4) {\n    this.kevin = new Kevin(ctx, { at, yaw });\n    return this.kevin;\n  }\n\n  addOunce(ctx, opts) {\n    this.ounce = new Ounce(ctx, opts);\n    return this.ounce;\n  }\n\n  // Pause menu's \"Restart activity\".\n  restart() { App.go('activity', { ...this.args }); }\n\n  /** Dev Tools: finish with 0-3 stars. */\n  devFinish(stars) { if (!this.resultsShown) { this.scoring = false; this.finish(stars); } }\n\n  hardAvailable() { return App.slot ? hardOpen(App.slot, App.dev.allUnlocked) : true; }\n\n  status() {\n    const r = this.phase === 'play' ? this.result() : null;\n    return `activity ${this.activity} | ${this.phase} | t ${this.playT.toFixed(1)}${r ? ` | score ${Math.round(r.score)}` : ''}`;\n  }\n}\nEOF\ncat > src/ui/activity-hud.js <<'EOF'\n// A few bits every activity's HUD shares.\nimport { charsIn, say, sayCentered, sayRight, wrap } from './font.js';\nimport { bar, panel, SAFE } from './widgets.js';\n\nexport const wrapCard = (text, width, scale = 1) => wrap(text, charsIn(width, scale));\n\n/** A row at the top of the screen: time left on the left, score on the right. */\nexport function topRow(hud, left, right, { y = 8 } = {}) {\n  if (left) { hud.rect(SAFE - 3, y - 2, left.length * 6 + 5, 12, 'navy'); say(hud, SAFE, y, left, { name: 'top-left' }); }\n  if (right) { const x = hud.width - SAFE; hud.rect(x - right.length * 6 - 2, y - 2, right.length * 6 + 5, 12, 'navy'); sayRight(hud, x, y, right, { color: 'sand', name: 'top-right' }); }\n}\n\nexport { bar, panel, say, sayCentered, sayRight, SAFE };\nEOF\ncat > src/data/howto.js <<'EOF'\n// What each activity asks of the hands, for cards and How to Play.\nconst FAMILY = {\n  pose: [['lean', 'Lean']],\n  poseBreath: [['lean', 'Lean'], ['breath', 'Breathe in']],\n  reps: [['lean', 'Move']],\n  hoop: [['lean', 'Circle']],\n  step: [['stepL', 'Left'], ['stepR', 'Right']],\n  header: [['lean', 'Lean']],\n  slackline: [['lean', 'Lean, push up to walk']],\n  tray: [['lean', 'Tilt']],\n  pier: [['lean', 'Tuck, hold'], ['confirm', 'Jump']],\n  jog: [['stepL', 'Left'], ['stepR', 'Right'], ['lean', 'Steer']],\n  stand: [['lean', 'Lean']],\n};\n\nexport function controlsFor(def) {\n  if (def.family === 'pose') return ['warrior', 'chair', 'fold', 'plank'].includes(def.pose) ? FAMILY.poseBreath : FAMILY.pose;\n  if (def.scene === 'slackline') return FAMILY.slackline;\n  if (def.scene === 'tray') return FAMILY.tray;\n  if (def.scene === 'pier') return FAMILY.pier;\n  if (def.scene === 'jog') return FAMILY.jog;\n  if (def.family === 'finale') return FAMILY.stand;\n  return FAMILY[def.family] ?? FAMILY.pose;\n}\n\nexport const HOW_TO = [\n  { title: 'The Dot', lines: ['This dot is you. Keep it in the circle.', 'Lean with the left stick, WASD or the mouse.', 'It has weight. It sways. It overshoots. So will you.'] },\n  { title: 'Breath', lines: ['When a bar appears, breathe with it.', 'Hold R2, Space or the left button on In.', 'Let go on Out. It calms the Dot. It calms nobody else.'] },\n  { title: 'Stars and Drips', lines: ['Everything gives up to three stars.', 'Stars and minutes make Drips. Drips fill the Sweat Jar.', 'The jar unlocks things. None of them help.'] },\n  { title: 'Falling', lines: ['You cannot lose here. You can only be noted.', 'Falls cost points and dignity.', 'Ounce will write it down. Ounce is very gentle about it.'] },\n];\nEOF\ncat > src/scenes/activity/lanes.js <<'EOF'\n// Lane staging: up to 4 mats in a row, each with its own driver (local, bot or ghost).\nimport { App } from '../../app.js';\nimport { BotDriver, LocalDriver } from '../../core/drivers.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { place } from '../../art/props.js';\nimport { CLASSMATE_SKILL, LOOKS, PRESET_LOOKS } from '../../data/classmates.js';\nimport { ActivityScene } from './base.js';\nimport { Lane } from './events.js';\nimport { matsFor } from '../sets.js';\nimport { topRow } from '../../ui/activity-hud.js';\n\nconst PAIRS = [['june', 'dennis'], ['marguerite', 'dennis'], ['june', 'marguerite'], ['dennis', 'marguerite']];\nconst SEAT_NAMES = { june: 'June', dennis: 'Dennis', marguerite: 'Marguerite' };\n\n/** Mats and avatars. specs: [{ name, who, look, driver, isPlayer, isLocal, color }] */\nexport async function buildLanes(ctx, specs, { rand, mat = 'yoga-mat', matOpts = {}, xs = null, z = 0.8, yaw = 0 } = {}) {\n  const positions = xs ?? matsFor(specs.length);\n  const lanes = [];\n  for (let i = 0; i < specs.length; i++) {\n    const s = specs[i];\n    const x = positions[i];\n    const lane = new Lane({ index: i, x, z, rand, ...s });\n    if (mat) lane.mat = place(ctx, mat, { at: [x, 0, z], palette: s.matColor ? { mat: s.matColor } : undefined, shadow: false, ...matOpts });\n    lane.avatar = await makeAvatar(ctx, s.look ?? PRESET_LOOKS[i % PRESET_LOOKS.length], { at: [x, mat ? 0.05 : 0, z], yaw });\n    lanes.push(lane);\n  }\n  return lanes;\n}\n\n/** You on the centre mat, two classmates as bots. */\nexport function soloSpecs(player, botRand, pairIndex = 0) {\n  const [a, b] = PAIRS[pairIndex % PAIRS.length];\n  const bot = (who) => ({ name: SEAT_NAMES[who], who, look: LOOKS[who], driver: new BotDriver(CLASSMATE_SKILL[who], botRand), color: 'slate', matColor: who === 'june' ? 'plum' : who === 'dennis' ? 'lime' : 'mist' });\n  return [bot(a), { name: player.name, look: player.look, driver: new LocalDriver(), isPlayer: true, isLocal: true, color: 'red', matColor: 'sky' }, bot(b)];\n}\n\nexport function playerInfo() {\n  const slot = App.slot;\n  return { name: slot?.name ?? 'You', look: withWardrobe(slot?.look ?? PRESET_LOOKS[0], slot) };\n}\n\n/** A look plus whatever the jar has given and you have chosen to wear. */\nexport function withWardrobe(look, slot) {\n  if (!slot) return look;\n  const worn = slot.worn ?? slot.wardrobe ?? [];\n  const out = { ...look };\n  for (const id of worn) {\n    if (id === 'band2') out.band2 = 'cyan';\n    else if (id === 'cape') out.cape = true;\n    else if (id === 'wrist') out.wrist = true;\n    else if (id === 'visor') out.visor = true;\n    else if (id === 'whistle') out.whistle = true;\n    else if (id === 'goldShoes') out.goldShoes = true;\n  }\n  return out;\n}\n\nconst LANE_ORDER = { tree: 0, heron: 1, warrior: 2, chair: 3, fold: 0, plank: 1, squats: 0, lunges: 2, press: 1, hoop: 2, step: 3 };\n\nexport class LaneActivity extends ActivityScene {\n  centreDial = true;\n\n  async stage(ctx) {\n    await this.dress(ctx);\n    const rand = () => this.botRand.next();\n    const specs = this.laneSpecs(rand);\n    this.lanes = await buildLanes(ctx, specs, { rand, ...this.laneOptions() });\n    this.playerLane = this.lanes.find((l) => l.isPlayer);\n    this.event = this.makeEvent(this.lanes, this.rng, this.hardData);\n    this.event.begin();\n    this.afterLanes?.(ctx);\n  }\n\n  laneOptions() { return {}; }\n\n  laneSpecs(rand) {\n    return soloSpecs(playerInfo(), rand, LANE_ORDER[this.activity] ?? 0);\n  }\n\n  async dress() {}\n  makeEvent() { throw new Error('makeEvent'); }\n\n  begin() {\n    this.event.begin();\n    this.eventT = 0;\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    this.eventT += dt;\n    this.event.step(ctx, dt, this.eventT, scoring);\n  }\n\n  /** While waiting, classmates keep wobbling. */\n  countStep(ctx, dt) { this.eventT = (this.eventT ?? 0) + dt * 0; this.event.step?.(ctx, dt, 0, false); }\n  idleStep(ctx, dt) { this.eventT += dt; this.event.step(ctx, dt, this.eventT, false); }\n\n  playLength() { return this.event.duration; }\n  isOver() { return (this.eventT ?? 0) >= this.event.duration; }\n\n  visual(ctx, dt) {\n    this.event.visual(ctx, dt, this.eventT ?? 0);\n  }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    this.event.draw(ctx, this.eventT ?? 0);\n  }\n\n  drawGameHud(ctx) {\n    const left = Math.max(0, this.event.duration - (this.eventT ?? 0));\n    topRow(ctx.hud, `${Math.ceil(left)}s`, this.scoreText());\n  }\n\n  scoreText() { return `${Math.round(this.event.scoreOf(this.playerLane))}${this.def.unit === '%' ? '%' : ''}`; }\n\n  result() {\n    const score = this.event.scoreOf(this.playerLane);\n    const round = Math.round(score);\n    return { score: round, seconds: this.totalPlay, display: `${round}${this.def.unit === '%' ? '%' : ` ${this.def.unit}`}`, classmates: this.lanes.filter((l) => l.who).map((l) => ({ who: l.who, name: l.name, score: Math.round(this.event.scoreOf(l)) })) };\n  }\n\n  onOutroStart() {\n    this.playerLane?.avatar?.play('Bow', { once: true, fade: 0.3 });\n    this.coach?.play('CoachStand', { fade: 0.4 });\n  }\n}\nEOF\necho ok","description":"Write sets, lane events, Holding Still and the activity base","timeout":30000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10817,"cache_read_input_tokens":302265,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10817},"output_tokens":4,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"e21bfa4e-3f5c-4202-bb52-4a752a9b314d","timestamp":"2026-11-05T06:34:15.480Z","request_id":"req_011CgjK2FR3SaiU7kj3e5FTQ","wire_tool_inputs":{"toolu_01PmnGVQiLxin2TeY9o2M1iS":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/scenes/sets.js <<'EOF'\n// Places. Everything is built from the island's giant equipment and clean white tile.\nimport { applySky, Boids, GrassField, Mirror, PALETTE, RippleField, setLookLayer, skyAt, THREE, toonMaterial, WAVES_CALM, WaterSurface } from '../../pixel-engine.js';\nimport { place } from '../art/props.js';\nimport { floorPlane } from '../art/textures.js';\n\nconst { BoxGeometry, Color, Group, Mesh, MeshBasicMaterial, DoubleSide, PlaneGeometry } = THREE;\n\nexport function box(ctx, w, h, d, at, color, { cast = true, receive = true, collide = false, parent = null } = {}) {\n  const m = new Mesh(new BoxGeometry(w, h, d), toonMaterial(PALETTE[color]));\n  m.position.set(...at);\n  m.castShadow = cast;\n  m.receiveShadow = receive;\n  (parent ?? ctx.scene).add(m);\n  if (collide) ctx.physics.addStaticBox({ position: at, halfExtents: [w / 2, h / 2, d / 2] });\n  return m;\n}\n\nexport function setSky(ctx, hour = 11) {\n  applySky(ctx.engine, skyAt(hour));\n  if (hour > 8 && hour < 16) {\n    ctx.scene.background = new Color(PALETTE.sky);\n    ctx.engine.sun.intensity = Math.max(ctx.engine.sun.intensity, 2.4);\n    ctx.engine.ambient.intensity = Math.max(ctx.engine.ambient.intensity, 1.3);\n  }\n}\n\nexport function sea(ctx, { size = [160, 120], at = [0, -0.5, -60], ripples = false } = {}) {\n  const rip = ripples ? new RippleField({ size, cells: [Math.round(size[0] * 3), Math.round(size[1] * 3)], center: [at[0], at[2]] }) : null;\n  const water = new WaterSurface({ size, at, waves: WAVES_CALM, segments: rip ? undefined : [40, 30], ripples: rip, deep: PALETTE.blue, shallow: PALETTE.cyan, foam: PALETTE.white });\n  ctx.scene.add(water);\n  return water;\n}\n\n/** Soft light, faked as a slanted ghost of a plane. */\nexport function sunbeam(ctx, x, z, h = 7, w = 1.1) {\n  const m = new Mesh(new PlaneGeometry(w, h), new MeshBasicMaterial({ color: PALETTE.sand, transparent: true, opacity: 0.1, depthWrite: false, side: DoubleSide }));\n  m.position.set(x, h / 2 - 0.1, z);\n  m.rotation.z = 0.32;\n  m.rotation.y = 0.2;\n  m.castShadow = false;\n  ctx.scene.add(m);\n  return m;\n}\n\nexport function matsFor(n) {\n  if (n >= 4) return [-3, -1, 1, 3];\n  if (n === 3) return [-2.2, 0, 2.2];\n  if (n === 2) return [-1, 1];\n  return [0];\n}\nexport const MAT_Z3 = 0.8;\nexport const MAT_Z4 = 0.8;\n\nconst roofFor = { pavilion: 'sky', medley: 'teal' };\n\n/** Pavilion of Holding Still: tile, columns, sea behind, a rail for Kevin. */\nexport function pavilionSet(ctx) {\n  setSky(ctx, 10);\n  ctx.scene.add(floorPlane('clinic-tile', 36, 22, { at: [0, 0, -2] }));\n  box(ctx, 36, 0.5, 22, [0, -0.26, -2], 'mist', { cast: false });\n  sea(ctx, { at: [0, -0.9, -70], size: [200, 120] });\n  // Colonnade behind the mats.\n  for (const x of [-10, -6.5, 6.5, 10]) {\n    const m = new Mesh(new THREE.CylinderGeometry(0.36, 0.42, 5.2, 8), toonMaterial(PALETTE.white));\n    m.position.set(x, 2.6, -5);\n    m.castShadow = true;\n    ctx.scene.add(m);\n    box(ctx, 1, 0.3, 1, [x, 5.25, -5], 'mist');\n  }\n  box(ctx, 24, 0.5, 1.2, [0, 5.6, -5], 'white');\n  box(ctx, 26, 0.3, 2.2, [0, 6, -5], 'sky');\n  const rail = place(ctx, 'class-rail', { at: [0, 0, -3.1], params: { len: 11 } });\n  place(ctx, 'palm', { at: [-13, 0, -7.5], yaw: 30, scale: 1.3 });\n  place(ctx, 'palm', { at: [12.5, 0, -8.5], yaw: 200, scale: 1.2 });\n  sunbeam(ctx, -4.5, -1.4); sunbeam(ctx, -1, -2.4, 7.5, 1.4); sunbeam(ctx, 3.2, -1.8, 7, 0.9);\n  ctx.engine.setSunDirection([0.5, 0.75, 0.55]);\n  return { railY: 1.11, railZ: -3.1, rail };\n}\n\n/** The Rep Shed, inside: sprung floor, a mirror wall, giant dumbbells. */\nexport function shedSet(ctx) {\n  setSky(ctx, 11);\n  ctx.scene.background = new Color(PALETTE.white);\n  ctx.scene.add(floorPlane('gym-floor', 24, 14, { at: [0, 0, 0] }));\n  box(ctx, 24, 0.5, 14, [0, -0.26, 0], 'orange', { cast: false });\n  box(ctx, 24, 6, 0.4, [0, 3, -3.4], 'white', { cast: false });\n  box(ctx, 0.4, 6, 14, [-9, 3, 0], 'mist', { cast: false });\n  box(ctx, 0.4, 6, 14, [9, 3, 0], 'mist', { cast: false });\n  box(ctx, 24, 0.5, 14, [0, 6, 0], 'mist', { cast: false });\n  box(ctx, 24, 0.3, 0.1, [0, 3.7, -3.1], 'orange', { cast: false });\n  box(ctx, 24, 0.5, 0.1, [0, 0.25, -3.15], 'slate', { cast: false });\n  const mirror = new Mirror({ size: [11, 3] });\n  mirror.mesh.position.set(0, 2.1, -3.14);\n  ctx.scene.add(mirror.mesh);\n  const stop = mirror.attach(ctx.engine.renderer, ctx.scene);\n  place(ctx, 'giant-dumbbell', { at: [-6.6, 0, -1.8], yaw: 20 });\n  place(ctx, 'giant-dumbbell', { at: [6.6, 0, -2], yaw: -15 });\n  place(ctx, 'giant-dumbbell', { at: [6.2, 0.82, -2], yaw: 10 });\n  place(ctx, 'towel-rack', { at: [-7.6, 0, 1.4], yaw: 90 });\n  ctx.engine.setSunDirection([0.3, 0.9, 0.4]);\n  return { mirror, stop };\n}\n\n/** Beat Beach: sand, the stage behind, the sea. */\nexport function beachSet(ctx) {\n  setSky(ctx, 12);\n  box(ctx, 44, 0.6, 26, [0, -0.3, -2], 'sand', { cast: false });\n  sea(ctx, { at: [0, -0.7, -75], size: [220, 120] });\n  place(ctx, 'beat-stage', { at: [0, 0, -5.6] });\n  place(ctx, 'palm', { at: [-9.5, 0, -3.8], yaw: 10, scale: 1.2 });\n  place(ctx, 'palm', { at: [9.8, 0, -4.4], yaw: 170, scale: 1.3 });\n  place(ctx, 'medicine-ball', { at: [-7.4, 0, 1.2], scale: 0.7 });\n  ctx.engine.setSunDirection([0.4, 0.85, 0.5]);\n  return {};\n}\n\n/** Lagoon Games: sand, water, the pier running off to one side. */\nexport function lagoonSet(ctx) {\n  setSky(ctx, 13);\n  box(ctx, 44, 0.6, 18, [0, -0.3, 0], 'sand', { cast: false });\n  sea(ctx, { at: [0, -0.6, -70], size: [220, 120] });\n  place(ctx, 'palm', { at: [-10, 0, -5], yaw: 20, scale: 1.2 });\n  place(ctx, 'palm', { at: [10.5, 0, -6], yaw: 150, scale: 1.1 });\n  place(ctx, 'medicine-ball', { at: [8, 0, 1.6], scale: 0.6 });\n  ctx.engine.setSunDirection([0.3, 0.85, 0.5]);\n  return {};\n}\n\n/** Tare Island, close up, for the title: tile, Ounce's dais, palms, the volcano far off. */\nexport function plazaSet(ctx, hour = 10) {\n  setSky(ctx, hour);\n  ctx.scene.add(floorPlane('clinic-tile', 40, 26, { at: [0, 0, -2] }));\n  box(ctx, 40, 0.5, 26, [0, -0.26, -2], 'mist', { cast: false });\n  sea(ctx, { at: [0, -0.9, -80], size: [260, 130] });\n  place(ctx, 'kettlebell-volcano', { at: [-16, -1, -26], scale: 1 });\n  place(ctx, 'foam-roller-hill', { at: [15, -1, -22], yaw: 16 });\n  place(ctx, 'palm', { at: [-9.5, 0, -6], yaw: 60, scale: 1.3 });\n  place(ctx, 'palm', { at: [8.5, 0, -7], yaw: 210, scale: 1.2 });\n  place(ctx, 'palm', { at: [12.5, 0, -2], yaw: 170 });\n  place(ctx, 'medicine-ball', { at: [-6.5, 0, -8] });\n  place(ctx, 'medicine-ball', { at: [-4.2, 0, -9.5], scale: 0.7 });\n  return {};\n}\n\nexport function gulls(ctx, n = 7, bounds = { min: [-14, 6, -14], max: [14, 10, 4] }) {\n  const flock = new Boids(n, { bounds, maxSpeed: 3.2, minSpeed: 1.8, view: 5, space: 2, seed: 4 });\n  const meshes = [];\n  const mat = toonMaterial(PALETTE.white);\n  for (let i = 0; i < n; i++) {\n    const g = new Group();\n    const body = new Mesh(new BoxGeometry(0.22, 0.14, 0.42), mat);\n    const w1 = new Mesh(new BoxGeometry(0.5, 0.05, 0.2), mat);\n    const w2 = new Mesh(new BoxGeometry(0.5, 0.05, 0.2), mat);\n    w1.position.x = 0.32; w2.position.x = -0.32;\n    g.add(body, w1, w2);\n    setLookLayer(g, 'actors');\n    ctx.scene.add(g);\n    meshes.push({ g, w1, w2 });\n  }\n  return {\n    flock,\n    update(dt, t) {\n      flock.step(Math.min(dt, 1 / 30));\n      meshes.forEach((m, i) => {\n        const p = i * 3;\n        m.g.position.set(flock.pos[p], flock.pos[p + 1], flock.pos[p + 2]);\n        m.g.rotation.y = Math.atan2(flock.vel[p], flock.vel[p + 2]);\n        const f = Math.sin(t * 9 + i) * 0.5;\n        m.w1.rotation.z = f; m.w2.rotation.z = -f;\n      });\n    },\n  };\n}\n\nexport function grass(ctx, area, at, mask, count = 1600) {\n  const g = new GrassField({ area, at, count, height: [0.2, 0.42], base: PALETTE.green, tip: PALETTE.lime, mask, seed: 3 });\n  ctx.scene.add(g);\n  return g;\n}\n\nexport { roofFor };\nEOF\ncat > src/scenes/activity/events.js <<'EOF'\n// Lane events: the same code for solo classes, Family Hour and online ghosts.\nimport { THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { BotBrain, blankInput } from '../../core/drivers.js';\nimport { CLIP_NAMES } from '../../art/clips.js';\nimport { drawDial } from '../../ui/widgets.js';\n\nconst { Vector3 } = THREE;\nconst v = new Vector3();\n\n/** Project a world point to art pixels. */\nexport function worldToArt(ctx, x, y, z) {\n  v.set(x, y, z).project(ctx.camera.camera);\n  return { x: (v.x + 1) * 0.5 * ctx.hud.width, y: (1 - v.y) * 0.5 * ctx.hud.height };\n}\n\nexport class Lane {\n  constructor({ index, name, who = null, look, driver, x = 0, z = 0.8, color = 'red', isPlayer = false, isLocal = false, rand }) {\n    Object.assign(this, { index, name, who, look, driver, x, z, color, isPlayer, isLocal, rand });\n    this.inp = blankInput();\n    this.dot = new Dot(rand);\n    this.m = {};\n    this.score = 0;\n    this.brain = null;\n    this.state = {};\n    this.gone = false;\n    this.dial = null;\n  }\n\n  get ghost() { return this.driver?.kind === 'ghost'; }\n}\n\nexport class LaneEvent {\n  kind = 'event';\n  duration = 60;\n\n  constructor(scene, lanes, rng, opts = {}) {\n    this.scene = scene;\n    this.ctx = scene.ctx;\n    this.lanes = lanes;\n    this.rng = rng;\n    this.opts = opts;\n    this.hard = opts.hard ?? {};\n  }\n\n  begin() { for (const l of this.lanes) this.beginLane(l); }\n  beginLane() {}\n\n  /** Fill lane.inp for this step, whoever's driving. */\n  read(ctx, lane, dt, t) {\n    const inp = lane.inp;\n    inp.stepL = inp.stepR = inp.confirm = false;\n    const d = lane.driver;\n    const auto = lane.isPlayer ? App.dev.autopilot : null;\n    if (d.kind === 'bot' || auto) {\n      const skill = auto ?? d.skill;\n      if (!lane.brain || lane.brain.skill !== skill) lane.brain = new BotBrain(skill, lane.rand);\n      inp.rate = false;\n      this.botInput(lane, inp, dt, t, lane.brain);\n    } else if (d.kind === 'pad') d.read(inp);\n    else if (d.kind !== 'ghost') d.read(inp, ctx, dt, App, lane.dial);\n    return inp;\n  }\n\n  /** One fixed step for the whole event. */\n  step(ctx, dt, t, scoring = true) {\n    this.tick?.(ctx, dt, t, scoring);\n    for (const lane of this.lanes) {\n      if (lane.gone || lane.ghost) continue;\n      this.read(ctx, lane, dt, t);\n      this.stepLane(ctx, lane, lane.inp, dt, t, scoring);\n    }\n  }\n\n  stepLane() {}\n  botInput(lane, out) { out.x = out.y = 0; }\n  visual() {}\n  draw() {}\n  scoreOf(lane) { return lane.score; }\n  /** 0..1000 for the Medley. */\n  normalized(lane) { return Math.max(0, Math.min(1000, Math.round(this.scoreOf(lane) * 10))); }\n  /** For ghosts: the clip and time this lane shows. */\n  clipState(lane) {\n    const a = lane.avatar?.current;\n    if (!a) return [0, 0];\n    return [CLIP_NAMES.indexOf(a.getClip().name), a.time];\n  }\n  /** Show a ghost's lane: lerp, never simulate. */\n  ghostVisual(lane, dt) {\n    const g = lane.driver;\n    g.lerp(dt);\n    const av = lane.avatar;\n    if (!av) return;\n    const name = CLIP_NAMES[g.clip] ?? 'Idle';\n    if (this.ghostScrubs?.(name)) av.scrub(name, g.clipTime);\n    else av.play(name, { fade: 0.25 });\n    av.update(dt);\n    av.lean(g.x, g.y);\n  }\n  dispose() {}\n}\n\n/** The dial for a local lane. In 4-mat staging each player gets a small one over their head. */\nexport function drawLaneDial(ctx, event, lane, ringR, { ringX = 0, ringY = 0, inside = false, brighten = 0, target = null, fade = 1 } = {}) {\n  const small = event.lanes.length >= 4 || !event.scene.centreDial;\n  let x, y, r;\n  if (small) {\n    const p = worldToArt(ctx, lane.x, 2.2, lane.z);\n    r = 24;\n    x = p.x; y = Math.max(r + 14, p.y - r);\n    x = Math.max(r + 4, Math.min(ctx.hud.width - r - 4, x));\n  } else {\n    x = Math.round(ctx.hud.width / 2); y = 56; r = 44;\n    if (ctx.hud.height < 250) y = 52;\n  }\n  lane.dial = { x, y };\n  const mouse = lane.isLocal && App.device.last === 'mouse' && lane.driver.kind !== 'pad' && lane.driver.kind !== 'bot' && !App.dev.autopilot ? App.device.pointerArt(ctx) : null;\n  drawDial(ctx.hud, { x, y, r, dot: lane.dot, ringR, ringX, ringY, inside, brighten, target, fade, mouse, color: lane.color });\n  return { x, y, r };\n}\nEOF\ncat > src/scenes/activity/poses.js <<'EOF'\n// Holding Still. The whole game in miniature.\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { POSES, RELEASE, SETTLE } from '../../data/poses.js';\nimport { BARKS } from '../../data/lines.js';\nimport { bar, say, sayCentered } from '../../ui/widgets.js';\nimport { drawLaneDial, LaneEvent } from './events.js';\nimport { LaneActivity } from './lanes.js';\nimport { pavilionSet } from '../sets.js';\n\nexport class PoseEvent extends LaneEvent {\n  kind = 'pose';\n\n  constructor(scene, lanes, rng, opts) {\n    super(scene, lanes, rng, opts);\n    this.poseId = opts.pose;\n    this.pose = POSES[opts.pose];\n    this.hold = opts.hold ?? this.pose.hold;\n    this.settle = opts.settle ?? SETTLE;\n    this.release = opts.release ?? RELEASE;\n    this.duration = this.settle + this.hold + this.release;\n    this.ringBase = this.pose.ring * (this.hard.ring ?? 1);\n    this.wanderPhase = rng.range(0, 6.28);\n    this.ringX = 0;\n  }\n\n  get breathing() { return this.pose.breath > 0; }\n\n  beginLane(l) {\n    l.dot.reset();\n    l.state = { in: 0, n: 0, breath: 0, s: 0.5, inside: false, streak: 0, wobbles: 0, clip: this.pose.clip };\n    l.score = 0;\n    l.avatar?.play(this.pose.clip, { fade: 0.5 });\n  }\n\n  ring() { return App.ringOf(this.ringBase) * (this.scene.ringBoost ?? 1); }\n\n  wantIn(t) { const p = this.pose.breath; return ((t % p) / p) < 0.5; }\n  breathLevel(t) { const p = this.pose.breath; const u = (t % p) / p; return u < 0.5 ? u * 2 : (1 - u) * 2; }\n\n  tick(ctx, dt, t) {\n    const tw = this.pose.twist;\n    if (tw.wanderX) this.ringX = tw.wanderX * (this.hard.wander ?? 1) * Math.sin(t * (tw.wanderSpeed ?? 0.3) * 6.283 * 0.5 + this.wanderPhase);\n  }\n\n  stepLane(ctx, lane, inp, dt, t, scoring) {\n    const tw = this.pose.twist;\n    const m = lane.m;\n    const u = this.hold > 0 ? Math.min(1, Math.max(0, (t - this.settle) / this.hold)) : 0;\n    let noise = App.noiseScale();\n    if (tw.noiseRamp) noise *= tw.noiseRamp[0] + (tw.noiseRamp[1] - tw.noiseRamp[0]) * u;\n    m.noiseY = tw.noiseY ?? 1;\n    m.inst = tw.inst ?? 1;\n    const st = lane.state;\n    if (this.breathing) {\n      const match = inp.breath === this.wantIn(t) ? 1 : 0;\n      st.s += (match - st.s) * Math.min(1, dt / 0.6);\n      noise *= 1.25 - T.breathBonus * st.s;\n    }\n    if (tw.tremorAfter && t - this.settle > tw.tremorAfter) noise *= 1.35;\n    m.noise = noise;\n    lane.dot.step(dt, inp.x, inp.y, T, m);\n    const ring = this.ring();\n    if (App.dev.god && lane.isPlayer) lane.dot.clampTo(this.ringX, 0, ring * 0.9);\n    if (this.scene.cheatRing && lane.isPlayer) lane.dot.clampTo(this.ringX, 0, ring * 0.9);\n    const inside = Math.hypot(lane.dot.x - this.ringX, lane.dot.y) <= ring;\n    const counts = scoring && t >= this.settle && t < this.settle + this.hold;\n    if (inside !== st.inside) {\n      st.inside = inside;\n      if (lane.isPlayer && t >= this.settle) {\n        if (inside) { App.sfx('ringIn', { volume: 0.7 }); this.scene.ringBark?.('in'); } else { st.wobbles++; App.sfx('ringOut', { volume: 0.5 }); this.scene.ringBark?.('out'); }\n      }\n    }\n    st.streak = inside ? st.streak + dt : 0;\n    if (counts) {\n      st.n++;\n      if (inside) st.in++;\n      if (this.breathing) st.breath += st.s;\n      lane.score = this.scoreOf(lane);\n    }\n  }\n\n  botInput(lane, out, dt, t, brain) {\n    brain.lean(out, lane.dot, this.ringX, 0, dt);\n    if (this.breathing && brain.p) {\n      const late = brain.play.react * 0.7;\n      out.breath = this.wantIn(t - late);\n      if (brain.play.miss > 0 && lane.rand() < brain.play.miss * 0.02) lane.state.slip = 0.8;\n      if ((lane.state.slip ?? 0) > 0) { lane.state.slip -= dt; out.breath = !out.breath; }\n    } else out.breath = false;\n  }\n\n  scoreOf(lane) {\n    const st = lane.state;\n    if (!st.n) return 0;\n    const inRing = st.in / st.n;\n    if (this.breathing) return 100 * (0.8 * inRing + 0.2 * (st.breath / st.n));\n    return 100 * inRing;\n  }\n\n  visual(ctx, dt, t) {\n    const ring = this.ring();\n    for (const lane of this.lanes) {\n      if (!lane.avatar || lane.gone) continue;\n      if (lane.ghost) { this.ghostVisual(lane, dt); continue; }\n      const d = Math.hypot(lane.dot.x - this.ringX, lane.dot.y);\n      const far = d > ring + 0.5;\n      lane.avatar.play(far ? 'Teeter' : this.pose.clip, { fade: 0.3 });\n      lane.avatar.update(dt);\n      const tremble = d > ring ? Math.min(1.5, (d - ring) * 3) : 0;\n      lane.avatar.lean(lane.dot.x, lane.dot.y, tremble, t);\n    }\n  }\n\n  draw(ctx, t) {\n    const { hud } = ctx;\n    const local = this.lanes.filter((l) => l.isLocal && !l.gone);\n    const ring = this.ring();\n    for (const lane of local) {\n      const st = lane.state;\n      const before = t < this.settle;\n      const dial = drawLaneDial(ctx, this, lane, ring, { ringX: this.ringX, inside: st.inside, brighten: Math.min(1, st.streak / 4) });\n      if (this.breathing) {\n        const w = 8, h = dial.r * 2;\n        const bx = dial.x + dial.r + 6;\n        const lvl = this.breathLevel(t);\n        hud.rect(bx - 1, dial.y - dial.r - 1, w + 2, h + 2, 'ink');\n        hud.rect(bx, dial.y - dial.r, w, h, 'white');\n        hud.rect(bx, dial.y + dial.r - Math.round(h * lvl), w, Math.round(h * lvl), this.wantIn(t) ? 'sky' : 'cyan');\n        if (lane.isLocal && this.lanes.length < 4) say(hud, bx + w + 3, dial.y - 4, this.wantIn(t) ? 'In...' : 'Out...', { color: inpMatch(lane, this, t) ? 'lime' : 'white', name: 'breath' });\n      }\n      if (before && this.lanes.length < 4) sayCentered(hud, dial.x, dial.y + dial.r + 5, 'Settle.', { color: 'white', name: 'settle' });\n    }\n  }\n}\n\nfunction inpMatch(lane, ev, t) { return lane.inp.breath === ev.wantIn(t); }\n\nexport class PoseActivity extends LaneActivity {\n  makeEvent(lanes, rng, hard) { return new PoseEvent(this, lanes, rng, { pose: this.def.pose, hard, hold: this.args.hold }); }\n\n  async dress(ctx) {\n    this.set = pavilionSet(ctx);\n    await this.addCoach(ctx, { at: [4.1, 0.36, -0.9], yaw: -0.5, clip: this.def.pose ? POSES[this.def.pose].clip : 'CoachStand', dais: true });\n    await this.addKevin(ctx, [-3.6, this.set.railY, this.set.railZ]);\n    this.nextMote = 0;\n    this.barkT = 0;\n    this.pushIn = 0;\n  }\n\n  ringBark(kind) {\n    if (this.t < this.barkT || this.attractMode) return;\n    this.barkT = this.t + 6;\n    const list = kind === 'in' ? BARKS.ringIn : BARKS.ringOut;\n    App.say('ounce', this.cosmetic.pick(list));\n  }\n\n  playVisual(ctx, dt) {\n    if (this.t > this.nextMote) {\n      this.nextMote = this.t + 0.28;\n      ctx.particles.burst('zen', [this.cosmetic.range(-6, 6), this.cosmetic.range(0.6, 3.6), this.cosmetic.range(-2, 2)]);\n    }\n    const you = this.playerLane;\n    if (you && this.phase === 'play') {\n      this.pushIn += ((you.state.inside ? 1 : 0) - this.pushIn) * Math.min(1, dt * 0.25);\n      this.camPush = this.pushIn * 0.9;\n      if (you.state.streak > 10 && !this.saidStreak) { this.saidStreak = true; App.say('ounce', this.cosmetic.pick(BARKS.streak)); }\n    }\n  }\n\n  fingerprint() {\n    const l = this.playerLane;\n    return l ? `${l.state.in}|${l.state.n}|${l.dot.x.toFixed(6)}|${l.dot.y.toFixed(6)}` : '';\n  }\n\n  overlayDot() {\n    const l = this.playerLane;\n    return l ? `${l.dot.x.toFixed(2)},${l.dot.y.toFixed(2)} ring ${this.event.ring().toFixed(2)}` : '-';\n  }\n}\n\nexport { bar };\nEOF\ncat > src/scenes/activity/base.js <<'EOF'\n// The shared flow: intro -> practice -> countdown -> play -> outro -> Results.\nimport { THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { blankInput, BotBrain, LocalDriver } from '../../core/drivers.js';\nimport { applyResult, hardOpen, starsFor } from '../../core/week.js';\nimport { CONFIRM } from '../../core/actions.js';\nimport { ACTIVITIES } from '../../data/activities.js';\nimport { BaseScene, laneCamera } from '../base.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { panel, say, sayCentered, SAFE, wrapCard } from '../../ui/activity-hud.js';\nimport { ResultsScreen } from '../../ui/screens/results.js';\nimport { Kevin, Ounce } from '../../art/props.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { controlsFor } from '../../data/howto.js';\n\nconst { Vector3 } = THREE;\n\nexport const CAMERAS = {\n  lane3: () => laneCamera(3),\n  lane4: () => laneCamera(4),\n  header: () => ({ preset: 'fixed', position: [0, 3.1, 8.6], target: [0, 1.4, 0], fov: 34 }),\n  slackline: () => ({ preset: 'fixed', position: [0, 3.2, -6], target: [0, 1.6, 6], fov: 46 }),\n  tray: () => ({ preset: 'fixed', position: [0, 7.6, 4.2], target: [0, 0, 0.1], fov: 38 }),\n  pier: () => ({ preset: 'side', zoom: 1, minZoom: 0.2, maxZoom: 4 }),\n  jog: () => ({ preset: 'iso', zoom: 1.4, minZoom: 1.4, maxZoom: 1.4 }),\n  stand: () => ({ preset: 'fixed', position: [0, 2.2, 7.6], target: [0, 1.1, 0], fov: 32 }),\n};\n\nconst scratch = new Vector3();\n\nexport class ActivityScene extends BaseScene {\n  canPause = true;\n  id = 'activity';\n  phase = 'boot';\n  phaseT = 0;\n  playT = 0;\n  totalPlay = 0;\n  camPush = 0;\n  camGlide = 0;\n  scoring = false;\n\n  constructor(args = {}) {\n    super(args);\n    this.activity = args.id;\n    this.def = ACTIVITIES[args.id];\n    this.name = `activity:${args.id}`;\n    this.mode = args.mode ?? 'dropin';\n    this.hard = !!args.hard;\n    this.attractMode = !!args.attract;\n    this.hardData = this.hard ? (this.def.hard ?? {}) : {};\n    this.ringBoost = this.attractMode ? 2 : 1;\n    this.cheatRing = this.attractMode;\n    this.inp = blankInput();\n    this.driver = new LocalDriver();\n  }\n\n  cameraConfig() { return CAMERAS[this.def.camera]?.() ?? CAMERAS.lane3(); }\n\n  get autopilot() { return this.attractMode ? 'expert' : App.dev.autopilot; }\n\n  async build(ctx) {\n    this.rng = ctx.random.fork('play');\n    this.cosmetic = ctx.random.fork('cosmetic');\n    this.botRand = ctx.random.fork('bot');\n    this.base = this.cameraConfig();\n    await this.stage(ctx);\n    this.startMusic();\n    if (this.attractMode) { this.begin(false); this.enter('play'); } else this.enter('intro');\n  }\n\n  startMusic() { App.music(this.def.song); }\n\n  async stage() {}\n  begin() {}\n  stepPlay() {}\n  isOver() { return this.playT >= this.playLength(); }\n  playLength() { return 60; }\n  /** { score, seconds, display, stars?, max? } */\n  result() { return { score: 0, seconds: this.playT, display: '0' }; }\n  botInput() {}\n  visual() {}\n  drawGame() {}\n  drawGameHud() {}\n\n  /** One player, not on a lane: stick, keys, mouse or autopilot. */\n  readPlayer(ctx, dt, dial) {\n    const out = this.inp;\n    out.stepL = out.stepR = out.confirm = false;\n    const auto = this.autopilot;\n    if (auto) {\n      if (!this.brain || this.brain.skill !== auto) this.brain = new BotBrain(auto, () => this.botRand.next());\n      out.rate = false;\n      this.botInput(out, dt, this.brain);\n    } else this.driver.read(out, ctx, dt, App, dial);\n    return out;\n  }\n\n  get practised() {\n    if (this.attractMode || this.args.noPractice) return true;\n    const rec = this.mode === 'week' ? App.slot?.records[this.activity] : App.store.data.dropin?.[this.activity];\n    return !!rec || (App.practised ??= {})[this.activity];\n  }\n\n  enter(phase) {\n    this.phase = phase;\n    this.phaseT = 0;\n    this.onEnter?.(phase);\n    switch (phase) {\n      case 'intro':\n        App.say('coach', this.def.coach);\n        this.camGlide = 1;\n        break;\n      case 'practice':\n        (App.practised ??= {})[this.activity] = true;\n        this.begin(true);\n        this.playT = 0;\n        break;\n      case 'countdown':\n        this.begin(false);\n        this.playT = 0;\n        this.lastCount = 4;\n        break;\n      case 'play':\n        this.playT = 0;\n        this.scoring = true;\n        this.onPlayStart?.();\n        break;\n      case 'outro':\n        this.scoring = false;\n        this.onOutroStart?.();\n        break;\n      default:\n        break;\n    }\n  }\n\n  onInput(ctx) {\n    const { input } = ctx;\n    if (this.phase === 'intro') {\n      if (input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft')) this.advanceIntro();\n    }\n  }\n\n  advanceIntro() {\n    if (this.phase !== 'intro') return;\n    App.sfx('menuConfirm');\n    this.enter(this.practised ? 'countdown' : 'practice');\n  }\n\n  onFixed(ctx, dt) {\n    if (this.resultsShown) { this.idleStep?.(ctx, dt); return; }\n    this.phaseT += dt;\n    switch (this.phase) {\n      case 'intro':\n        if (this.autopilot && this.phaseT > 0.4) this.advanceIntro();\n        break;\n      case 'practice':\n        this.playT += dt;\n        this.stepPlay(ctx, dt, false);\n        if (this.phaseT >= 8) this.enter('countdown');\n        break;\n      case 'countdown': {\n        this.countStep?.(ctx, dt);\n        const n = Math.ceil(3 - this.phaseT);\n        if (n !== this.lastCount && n > 0) { this.lastCount = n; App.sfx('count'); }\n        if (this.phaseT >= 3) { App.sfx('countGo'); this.enter('play'); }\n        break;\n      }\n      case 'play':\n        this.playT += dt;\n        this.totalPlay += dt;\n        this.stepPlay(ctx, dt, true);\n        if (this.isOver()) this.enter('outro');\n        break;\n      case 'outro':\n        this.idleStep?.(ctx, dt);\n        if (this.phaseT >= (this.outroLength ?? 1.6)) this.finish();\n        break;\n      default:\n        break;\n    }\n  }\n\n  /** Write the result and show it. Dev Tools can force the stars. */\n  finish(force = null) {\n    if (this.resultsShown || this.attractMode) return;\n    this.resultsShown = true;\n    this.phase = 'results';\n    const r = this.result();\n    let stars = starsFor(this.def, r.score, r);\n    if (force !== null) stars = force;\n    const seconds = Math.max(r.seconds ?? this.totalPlay, 0);\n    const out = { ...r, stars, seconds, id: this.activity, hard: this.hard, mode: this.mode };\n    if (this.mode === 'week' && App.slot) {\n      Object.assign(out, applyResult(App.slot, this.activity, { score: r.score, stars, seconds, hard: this.hard }));\n      App.store.write();\n    } else if (this.mode === 'dropin') {\n      const d = (App.store.data.dropin ??= {});\n      const rec = d[this.activity] ?? { best: 0, stars: 0, plays: 0 };\n      out.firstEver = !d[this.activity];\n      out.newBest = r.score > rec.best;\n      rec.best = Math.max(rec.best, r.score); rec.stars = Math.max(rec.stars, stars); rec.plays++;\n      d[this.activity] = rec;\n      out.drips = 0;\n      App.store.write();\n    }\n    this.lastResult = out;\n    this.onFinish?.(out);\n    if (!this.args.noResults) App.stack.push(new ResultsScreen(this, out));\n  }\n\n  onUpdate(ctx, dt) {\n    if (this.base?.preset === 'fixed' && !App.dev.freeCam && !this.ownCamera) this.applyCamera(ctx, dt);\n    this.ounce?.update(dt);\n    this.kevin?.update(dt);\n    this.coach?.update(dt);\n    this.visual(ctx, dt);\n    this.playVisual?.(ctx, dt);\n  }\n\n  applyCamera(ctx, dt) {\n    const cam = ctx.camera.camera;\n    const b = this.base;\n    this.camGlide = this.phase === 'intro' ? Math.max(0, this.camGlide - dt * 0.5) : 0;\n    const g = this.camGlide * this.camGlide;\n    const px = b.position[0] + g * 3;\n    const py = b.position[1] + g * 1.6;\n    const pz = b.position[2] + g * 4 - this.camPush;\n    cam.position.set(px, py, pz);\n    cam.lookAt(b.target[0], b.target[1], b.target[2]);\n    if (cam.fov !== b.fov) { cam.fov = b.fov; cam.updateProjectionMatrix(); }\n    void scratch;\n  }\n\n  onDraw(ctx) {\n    const { hud } = ctx;\n    this.drawGame(ctx);\n    if (this.attractMode) return;\n    if (this.phase === 'intro') this.drawCard(ctx);\n    if (this.phase === 'practice') {\n      hud.rect(Math.round(hud.width / 2) - 40, hud.height - 56, 80, 14, 'navy');\n      sayCentered(hud, hud.width / 2, hud.height - 54, 'Try it.', { color: 'sand', name: 'practice' });\n      this.drawControls(ctx);\n    }\n    if (this.phase === 'countdown') {\n      const n = Math.max(1, Math.ceil(3 - this.phaseT));\n      sayCentered(hud, hud.width / 2, Math.round(hud.height * 0.42), String(n), { scale: 4, color: 'sand', name: 'count' });\n    }\n    if (this.phase === 'play' && this.playT < 0.8) sayCentered(hud, hud.width / 2, Math.round(hud.height * 0.42), 'Begin.', { scale: 3, color: 'white', name: 'begin' });\n    if (this.phase === 'play') this.drawGameHud(ctx);\n  }\n\n  drawControls(ctx) {\n    promptBar(ctx.hud, App.device, controlsFor(this.def, App.device.promptColumn()));\n  }\n\n  drawCard(ctx) {\n    const { hud } = ctx;\n    const w = Math.min(hud.width - SAFE * 2, 300);\n    const x = Math.round((hud.width - w) / 2);\n    const lines = wrapCard(this.def.goal, w - 16);\n    const h = 30 + lines.length * 11;\n    const y = 18;\n    panel(hud, x, y, w, h, { fill: 'navy', border: 'ink', name: 'card' });\n    sayCentered(hud, hud.width / 2, y + 5, this.def.name, { scale: 1, color: 'sand', name: 'card-title' });\n    if (this.hard) say(hud, x + 5, y + 5, 'HARD', { color: 'red', name: 'card-hard' });\n    lines.forEach((l, i) => sayCentered(hud, hud.width / 2, y + 18 + i * 11, l, { color: 'white', name: 'card-goal' }));\n    const list = [...controlsFor(this.def, App.device.promptColumn()), ['confirm', 'Begin']];\n    promptBar(hud, App.device, list);\n  }\n\n  /** Coach: to one side of the player, never directly behind: their silhouettes merge. */\n  async addCoach(ctx, { at, yaw = 0, clip = 'CoachStand', dais = false }) {\n    if (dais) {\n      const { place } = await import('../../art/props.js');\n      place(ctx, 'dais', { at: [at[0], 0, at[2]] });\n    }\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at, yaw, clip });\n    this.coach.addPlumb();\n    return this.coach;\n  }\n\n  async addKevin(ctx, at, yaw = 0.4) {\n    this.kevin = new Kevin(ctx, { at, yaw });\n    return this.kevin;\n  }\n\n  addOunce(ctx, opts) {\n    this.ounce = new Ounce(ctx, opts);\n    return this.ounce;\n  }\n\n  // Pause menu's \"Restart activity\".\n  restart() { App.go('activity', { ...this.args }); }\n\n  /** Dev Tools: finish with 0-3 stars. */\n  devFinish(stars) { if (!this.resultsShown) { this.scoring = false; this.finish(stars); } }\n\n  hardAvailable() { return App.slot ? hardOpen(App.slot, App.dev.allUnlocked) : true; }\n\n  status() {\n    const r = this.phase === 'play' ? this.result() : null;\n    return `activity ${this.activity} | ${this.phase} | t ${this.playT.toFixed(1)}${r ? ` | score ${Math.round(r.score)}` : ''}`;\n  }\n}\nEOF\ncat > src/ui/activity-hud.js <<'EOF'\n// A few bits every activity's HUD shares.\nimport { charsIn, say, sayCentered, sayRight, wrap } from './font.js';\nimport { bar, panel, SAFE } from './widgets.js';\n\nexport const wrapCard = (text, width, scale = 1) => wrap(text, charsIn(width, scale));\n\n/** A row at the top of the screen: time left on the left, score on the right. */\nexport function topRow(hud, left, right, { y = 8 } = {}) {\n  if (left) { hud.rect(SAFE - 3, y - 2, left.length * 6 + 5, 12, 'navy'); say(hud, SAFE, y, left, { name: 'top-left' }); }\n  if (right) { const x = hud.width - SAFE; hud.rect(x - right.length * 6 - 2, y - 2, right.length * 6 + 5, 12, 'navy'); sayRight(hud, x, y, right, { color: 'sand', name: 'top-right' }); }\n}\n\nexport { bar, panel, say, sayCentered, sayRight, SAFE };\nEOF\ncat > src/data/howto.js <<'EOF'\n// What each activity asks of the hands, for cards and How to Play.\nconst FAMILY = {\n  pose: [['lean', 'Lean']],\n  poseBreath: [['lean', 'Lean'], ['breath', 'Breathe in']],\n  reps: [['lean', 'Move']],\n  hoop: [['lean', 'Circle']],\n  step: [['stepL', 'Left'], ['stepR', 'Right']],\n  header: [['lean', 'Lean']],\n  slackline: [['lean', 'Lean, push up to walk']],\n  tray: [['lean', 'Tilt']],\n  pier: [['lean', 'Tuck, hold'], ['confirm', 'Jump']],\n  jog: [['stepL', 'Left'], ['stepR', 'Right'], ['lean', 'Steer']],\n  stand: [['lean', 'Lean']],\n};\n\nexport function controlsFor(def) {\n  if (def.family === 'pose') return ['warrior', 'chair', 'fold', 'plank'].includes(def.pose) ? FAMILY.poseBreath : FAMILY.pose;\n  if (def.scene === 'slackline') return FAMILY.slackline;\n  if (def.scene === 'tray') return FAMILY.tray;\n  if (def.scene === 'pier') return FAMILY.pier;\n  if (def.scene === 'jog') return FAMILY.jog;\n  if (def.family === 'finale') return FAMILY.stand;\n  return FAMILY[def.family] ?? FAMILY.pose;\n}\n\nexport const HOW_TO = [\n  { title: 'The Dot', lines: ['This dot is you. Keep it in the circle.', 'Lean with the left stick, WASD or the mouse.', 'It has weight. It sways. It overshoots. So will you.'] },\n  { title: 'Breath', lines: ['When a bar appears, breathe with it.', 'Hold R2, Space or the left button on In.', 'Let go on Out. It calms the Dot. It calms nobody else.'] },\n  { title: 'Stars and Drips', lines: ['Everything gives up to three stars.', 'Stars and minutes make Drips. Drips fill the Sweat Jar.', 'The jar unlocks things. None of them help.'] },\n  { title: 'Falling', lines: ['You cannot lose here. You can only be noted.', 'Falls cost points and dignity.', 'Ounce will write it down. Ounce is very gentle about it.'] },\n];\nEOF\ncat > src/scenes/activity/lanes.js <<'EOF'\n// Lane staging: up to 4 mats in a row, each with its own driver (local, bot or ghost).\nimport { App } from '../../app.js';\nimport { BotDriver, LocalDriver } from '../../core/drivers.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { place } from '../../art/props.js';\nimport { CLASSMATE_SKILL, LOOKS, PRESET_LOOKS } from '../../data/classmates.js';\nimport { ActivityScene } from './base.js';\nimport { Lane } from './events.js';\nimport { matsFor } from '../sets.js';\nimport { topRow } from '../../ui/activity-hud.js';\n\nconst PAIRS = [['june', 'dennis'], ['marguerite', 'dennis'], ['june', 'marguerite'], ['dennis', 'marguerite']];\nconst SEAT_NAMES = { june: 'June', dennis: 'Dennis', marguerite: 'Marguerite' };\n\n/** Mats and avatars. specs: [{ name, who, look, driver, isPlayer, isLocal, color }] */\nexport async function buildLanes(ctx, specs, { rand, mat = 'yoga-mat', matOpts = {}, xs = null, z = 0.8, yaw = 0 } = {}) {\n  const positions = xs ?? matsFor(specs.length);\n  const lanes = [];\n  for (let i = 0; i < specs.length; i++) {\n    const s = specs[i];\n    const x = positions[i];\n    const lane = new Lane({ index: i, x, z, rand, ...s });\n    if (mat) lane.mat = place(ctx, mat, { at: [x, 0, z], palette: s.matColor ? { mat: s.matColor } : undefined, shadow: false, ...matOpts });\n    lane.avatar = await makeAvatar(ctx, s.look ?? PRESET_LOOKS[i % PRESET_LOOKS.length], { at: [x, mat ? 0.05 : 0, z], yaw });\n    lanes.push(lane);\n  }\n  return lanes;\n}\n\n/** You on the centre mat, two classmates as bots. */\nexport function soloSpecs(player, botRand, pairIndex = 0) {\n  const [a, b] = PAIRS[pairIndex % PAIRS.length];\n  const bot = (who) => ({ name: SEAT_NAMES[who], who, look: LOOKS[who], driver: new BotDriver(CLASSMATE_SKILL[who], botRand), color: 'slate', matColor: who === 'june' ? 'plum' : who === 'dennis' ? 'lime' : 'mist' });\n  return [bot(a), { name: player.name, look: player.look, driver: new LocalDriver(), isPlayer: true, isLocal: true, color: 'red', matColor: 'sky' }, bot(b)];\n}\n\nexport function playerInfo() {\n  const slot = App.slot;\n  return { name: slot?.name ?? 'You', look: withWardrobe(slot?.look ?? PRESET_LOOKS[0], slot) };\n}\n\n/** A look plus whatever the jar has given and you have chosen to wear. */\nexport function withWardrobe(look, slot) {\n  if (!slot) return look;\n  const worn = slot.worn ?? slot.wardrobe ?? [];\n  const out = { ...look };\n  for (const id of worn) {\n    if (id === 'band2') out.band2 = 'cyan';\n    else if (id === 'cape') out.cape = true;\n    else if (id === 'wrist') out.wrist = true;\n    else if (id === 'visor') out.visor = true;\n    else if (id === 'whistle') out.whistle = true;\n    else if (id === 'goldShoes') out.goldShoes = true;\n  }\n  return out;\n}\n\nconst LANE_ORDER = { tree: 0, heron: 1, warrior: 2, chair: 3, fold: 0, plank: 1, squats: 0, lunges: 2, press: 1, hoop: 2, step: 3 };\n\nexport class LaneActivity extends ActivityScene {\n  centreDial = true;\n\n  async stage(ctx) {\n    await this.dress(ctx);\n    const rand = () => this.botRand.next();\n    const specs = this.laneSpecs(rand);\n    this.lanes = await buildLanes(ctx, specs, { rand, ...this.laneOptions() });\n    this.playerLane = this.lanes.find((l) => l.isPlayer);\n    this.event = this.makeEvent(this.lanes, this.rng, this.hardData);\n    this.event.begin();\n    this.afterLanes?.(ctx);\n  }\n\n  laneOptions() { return {}; }\n\n  laneSpecs(rand) {\n    return soloSpecs(playerInfo(), rand, LANE_ORDER[this.activity] ?? 0);\n  }\n\n  async dress() {}\n  makeEvent() { throw new Error('makeEvent'); }\n\n  begin() {\n    this.event.begin();\n    this.eventT = 0;\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    this.eventT += dt;\n    this.event.step(ctx, dt, this.eventT, scoring);\n  }\n\n  /** While waiting, classmates keep wobbling. */\n  countStep(ctx, dt) { this.eventT = (this.eventT ?? 0) + dt * 0; this.event.step?.(ctx, dt, 0, false); }\n  idleStep(ctx, dt) { this.eventT += dt; this.event.step(ctx, dt, this.eventT, false); }\n\n  playLength() { return this.event.duration; }\n  isOver() { return (this.eventT ?? 0) >= this.event.duration; }\n\n  visual(ctx, dt) {\n    this.event.visual(ctx, dt, this.eventT ?? 0);\n  }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    this.event.draw(ctx, this.eventT ?? 0);\n  }\n\n  drawGameHud(ctx) {\n    const left = Math.max(0, this.event.duration - (this.eventT ?? 0));\n    topRow(ctx.hud, `${Math.ceil(left)}s`, this.scoreText());\n  }\n\n  scoreText() { return `${Math.round(this.event.scoreOf(this.playerLane))}${this.def.unit === '%' ? '%' : ''}`; }\n\n  result() {\n    const score = this.event.scoreOf(this.playerLane);\n    const round = Math.round(score);\n    return { score: round, seconds: this.totalPlay, display: `${round}${this.def.unit === '%' ? '%' : ` ${this.def.unit}`}`, classmates: this.lanes.filter((l) => l.who).map((l) => ({ who: l.who, name: l.name, score: Math.round(this.event.scoreOf(l)) })) };\n  }\n\n  onOutroStart() {\n    this.playerLane?.avatar?.play('Bow', { once: true, fade: 0.3 });\n    this.coach?.play('CoachStand', { fade: 0.4 });\n  }\n}\nEOF\necho ok","description":"Write sets, lane events, Holding Still and the activity base","timeout":30000}}}
