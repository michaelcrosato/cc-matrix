{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjUkRSGr4AwrrNi6wrZw","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"The stub pad runs through Node's real input path, so I can script hand-like plays of every activity on all three devices. I'm writing one script per activity and measuring the results next.\n\n","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12135,"cache_read_input_tokens":850761,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12135},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"27545893-baab-4361-ad56-b346165c5a3c","timestamp":"2026-11-05T08:38:58.989Z","request_id":"req_011CgjUkQxztjhAYjgy2WvLv","narration_block_indexes":[0],"thinking_duration_ms":1,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjUkRSGr4AwrrNi6wrZw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01T4tHgEjbhNJCn4g9N8esZa","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='tests/headless/_people.mjs'; s=open(p).read()\n# pads go through a real stub, so the boot-time remap and the deadzone are exercised\ns=s.replace(\"\"\"const PAD_KEYS = { up: 'KeyW', down: 'KeyS', left: 'KeyA', right: 'KeyD' };\n\"\"\",\"\"\"const PAD_KEYS = { up: 'KeyW', down: 'KeyS', left: 'KeyA', right: 'KeyD' };\n\n/** A standard-mapping pad, through navigator.getGamepads: the boot-time remap and deadzone all run. */\nexport const stubPad = { id: 'Stub', index: 0, connected: true, mapping: 'standard', timestamp: 0, axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })) };\nexport function installPad() {\n  Object.defineProperty(globalThis.navigator, 'getGamepads', { value: () => [stubPad, null, null, null], configurable: true });\n}\nconst PAD_INDEX = { PadCross: 0, PadCircle: 1, PadSquare: 2, PadTriangle: 3, PadL1: 4, PadR1: 5, PadL2: 6, PadR2: 7, PadOptions: 9 };\n\"\"\")\ns=s.replace(\"\"\"  const setHeld = (code, on) => { if (on && !held.has(code)) { input.setKey(code, true); held.add(code); } else if (!on && held.has(code)) { input.setKey(code, false); held.delete(code); } };\n  let tapQueue = [];\n  const tap = (code) => { input.setKey(code, true); tapQueue.push(code); };\n  const release = () => { for (const c of tapQueue) input.setKey(c, false); tapQueue = []; };\"\"\",\"\"\"  const setCode = (code, on) => {\n    if (code in PAD_INDEX) { stubPad.buttons[PAD_INDEX[code]].pressed = on; stubPad.buttons[PAD_INDEX[code]].value = on ? 1 : 0; } else input.setKey(code, on);\n  };\n  const setHeld = (code, on) => { if (on && !held.has(code)) { setCode(code, true); held.add(code); } else if (!on && held.has(code)) { setCode(code, false); held.delete(code); } };\n  let tapQueue = [];\n  const tap = (code) => { setCode(code, true); tapQueue.push(code); };\n  const release = () => { for (const c of tapQueue) setCode(c, false); tapQueue = []; };\"\"\")\ns=s.replace(\"\"\"      } else if (device === 'pad') {\n        hands.stick.x = x; hands.stick.y = y;\n      } else {\"\"\",\"\"\"      } else if (device === 'pad') {\n        stubPad.axes[0] = x; stubPad.axes[1] = -y;\n      } else {\"\"\")\ns=s.replace(\"\"\"    stick: { x: 0, y: 0 },\n    hold(role, on) {\"\"\",\"\"\"    hold(role, on) {\"\"\")\ns=s.replace(\"\"\"    letGo() { for (const c of [...held]) setHeld(c, false); hands.stick.x = 0; hands.stick.y = 0; if (device === 'mouse') input.setButtons(0); },\"\"\",\"\"\"    letGo() { for (const c of [...held]) setHeld(c, false); stubPad.axes[0] = 0; stubPad.axes[1] = 0; if (device === 'mouse') input.setButtons(0); release(); },\"\"\")\ns+=\"\"\"\nconst TAU = Math.PI * 2;\n\n/** How a person plays each activity: what they can see on screen, and their hands. Called once a frame. */\nexport const PLAYS = {\n  poses(scene, hands, eyes, st) {\n    const lane = scene.playerLane, ev = scene.event, t = scene.eventT ?? 0;\n    const [x, y] = eyes.lean(lane.dot, ev.ringX, 0);\n    hands.lean(x, y, lane.dial);\n    if (ev.breathing) hands.hold('breath', ev.wantIn(t - 0.15));\n    void st;\n  },\n  longstand(scene, hands, eyes) {\n    const [x, y] = eyes.lean(scene.dot, 0, 0);\n    hands.lean(x, y, scene.dial);\n  },\n  reps(scene, hands) {\n    const lane = scene.playerLane, ev = scene.event, t = scene.eventT ?? 0;\n    const rep = Math.max(0, ev.repAt(t));\n    const target = ev.targetAt(t + 0.14);\n    const r = lane.state.r;\n    if (hands.device === 'keyboard') {\n      // Keys are rate control: push while the marker is ahead of you, let go when you're with it.\n      const diff = ev.targetAt(t + 0.08) - r;\n      const v = diff > 0.03 ? 1 : diff < -0.03 ? -1 : 0;\n      if (ev.data.input === 'down') hands.lean(0, -v, lane.dial);\n      else if (ev.data.input === 'up') hands.lean(0, v, lane.dial);\n      else hands.lean(v * ev.side(rep), 0, lane.dial);\n      return;\n    }\n    if (ev.data.input === 'down') hands.lean(0, -target, lane.dial);\n    else if (ev.data.input === 'up') hands.lean(0, target, lane.dial);\n    else hands.lean(target * ev.side(rep), 0, lane.dial);\n  },\n  hoop(scene, hands, eyes, st) {\n    const lane = scene.playerLane, ev = scene.event, t = scene.eventT ?? 0;\n    const dir = ev.dirAt(t) || 1;\n    const rate = hands.device === 'keyboard' ? 1.3 : 1.6;\n    st.a = (st.a ?? 0) + dir * rate * TAU * (1 / 60);\n    let x = Math.cos(st.a), y = Math.sin(st.a);\n    if (hands.device === 'keyboard') {\n      // Rolling the keys: W, then D, then S, then A, one at a time, as fingers do.\n      const q = Math.round(((st.a % TAU) + TAU) / (TAU / 4)) % 4;\n      x = [1, 0, -1, 0][q]; y = [0, 1, 0, -1][q];\n    }\n    const th = ev.throws[lane.state.throwI];\n    if (th && t >= th.t - 0.33 && t <= th.t && lane.state.hoops < 3) { x = th.side; y = 0; }\n    hands.lean(x, y, lane.dial);\n  },\n  step(scene, hands, eyes, st) {\n    const lane = scene.playerLane, ev = scene.event;\n    const now = scene.beatClock();\n    st.i = st.i ?? 0;\n    while (st.i < ev.notes.length && ev.notes[st.i].t + 0.02 <= now) {\n      if (now - ev.notes[st.i].t < 0.1) hands.press(ev.notes[st.i].foot === 'L' ? 'stepL' : 'stepR');\n      st.i++;\n      if (hands.device === 'mouse') break; // one button at a time on a mouse\n    }\n    void lane; void eyes;\n  },\n  header(scene, hands) {\n    const lane = scene.playerLane, ev = scene.event, s = lane.state, t = scene.eventT ?? 0;\n    let target = s.pos;\n    for (let i = s.wave; i < ev.waves.length; i++) {\n      const w = ev.waves[i];\n      if (t - w.t0 < 0.22) break;\n      if (w.type === 'flip') { if (Math.abs(s.pos - w.x) < 0.6 && w.t1 - t < 0.6) { target = w.x + (s.pos >= w.x ? 0.75 : -0.75); break; } continue; }\n      target = w.x;\n      break;\n    }\n    const v = Math.max(-1, Math.min(1, (target - s.pos) * 3));\n    hands.lean(Math.abs(v) < 0.08 ? 0 : v, 0, lane.dial);\n  },\n  slackline(scene, hands, eyes) {\n    const [x] = eyes.lean(scene.dot, 0, 0);\n    hands.lean(x, Math.abs(scene.dot.x) < 0.4 ? 1 : 0, scene.dial);\n  },\n  tray(scene, hands, eyes, st) {\n    const live = scene.vits.filter((v) => !v.done && !v.queued && v.wait <= 0);\n    let v = st.v && live.includes(st.v) ? st.v : null;\n    let cup = null, best = Infinity;\n    for (const c of live) {\n      if (v && c !== v) continue;\n      const p = c.body.translation();\n      for (const k of scene.cups) { if (k.color !== c.color) continue; const d = Math.hypot(k.x - p.x, k.z - p.z); if (d < best) { best = d; st.v = c; cup = k; } }\n    }\n    v = st.v;\n    if (!v || !cup) { hands.lean(0, 0); return; }\n    const p = v.body.translation(), vel = v.body.linvel();\n    const way = scene.nextCell(p.x, p.z, cup);\n    let ux = (way.x - p.x) * 0.5 - vel.x * 0.42, uy = -(way.z - p.z) * 0.5 + vel.z * 0.42;\n    const d = Math.hypot(ux, uy);\n    if (d > 0.62) { ux *= 0.62 / d; uy *= 0.62 / d; }\n    hands.lean(ux, uy);\n  },\n  pier(scene, hands, eyes, st) {\n    const stage = scene.stage2;\n    if (stage === 'runup') {\n      const [x, y] = eyes.lean(scene.dot, 0, -0.6);\n      hands.lean(x, y, scene.dial);\n      if (scene.st >= 4.97 && st.pressed !== scene.attempt) { st.pressed = scene.attempt; hands.press('confirm'); }\n    } else if (stage === 'flight') {\n      const [x, y] = eyes.lean(scene.dot, 0, 0);\n      hands.lean(x, y, scene.dial);\n      if (scene.flight - scene.st < 0.3 && st.canned !== scene.attempt) { st.canned = scene.attempt; hands.press('confirm'); }\n    } else hands.lean(0, 0, scene.dial);\n  },\n  jog(scene, hands, eyes, st) {\n    st.next = st.next ?? 0;\n    if (scene.time >= st.next) {\n      st.foot = st.foot === 'stepL' ? 'stepR' : 'stepL';\n      hands.press(st.foot);\n      st.next = scene.time + 1 / scene.targetCadence;\n    }\n    const u = scene.dist / scene.length;\n    let want = 0;\n    const next = scene.cups.find((c) => !c.taken && c.u > u && (c.u - u) * scene.length < 14);\n    if (next) want = next.x;\n    for (const o of scene.obs) { const d = (o.u - u) * scene.length; if (d > 0 && d < 5 && Math.abs(want - o.x) < 0.7) want = o.x + (o.x > 0 ? -1.2 : 1.2); }\n    const w = Math.max(-1, Math.min(1, (want - scene.x) * 3));\n    const n = scene.normalAt(u);\n    const { right, forward } = scene.ctx.camera.groundBasis();\n    const close = Math.abs(want - scene.x) < 0.15;\n    hands.lean(close ? 0 : w * (n.x * right.x + n.z * right.z), close ? 0 : w * (n.x * forward.x + n.z * forward.z));\n  },\n};\n\"\"\"\nopen(p,'w').write(s)\nEOF\ncat > .scratch/playsweep.mjs <<'EOF'\nimport { boot, App, tick } from '../tests/lib.mjs';\nimport { Eyes, installPad, makeHands, PLAYS, stubPad } from '../tests/headless/_people.mjs';\nimport { ACTIVITIES, ACTIVITY_IDS } from '../src/data/activities.js';\ninstallPad();\nconst h = await boot({ scene:'title' });\nconst only = process.argv[2] ? process.argv[2].split(',') : ACTIVITY_IDS;\nfor (const id of only) {\n  const row=[];\n  for (const dev of ['pad','keyboard','mouse']) {\n    await h.go('activity',{ id, mode:'dropin', noPractice:true, board: id==='tray'?0:undefined });\n    const hands=makeHands(h.engine,dev); hands.announce();\n    const s=App.scene;\n    // Begin with the confirm the card asks for, on this device.\n    hands.press('confirm'); h.step(1); hands.endFrame(); h.step(1);\n    const eyes=new Eyes(); const st={}; const play=PLAYS[ACTIVITIES[id].scene];\n    let n=0;\n    while(!s.resultsShown && n++<60*200){ if(s.phase==='play') play(s,hands,eyes,st); h.step(1); hands.endFrame(); }\n    hands.letGo(); h.step(2);\n    const r=s.lastResult; row.push(`${dev}:${r? (typeof r.score==='number'?r.score.toFixed(0):r.score)+'/'+r.stars+'*':'NO RESULT '+s.phase}`);\n  }\n  console.log(id.padEnd(10),row.join('  '));\n}\nconsole.log('errors',h.errors());\nprocess.exit(0);\nEOF\ntimeout 280 node .scratch/playsweep.mjs </dev/null 2>&1 | tail -20 | cut -c1-200","description":"Write per-activity human-like play scripts and sweep all activities on all devices","timeout":295000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12135,"cache_read_input_tokens":850761,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12135},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"4966a6b7-e3d7-4cd8-8f26-472d7d2acb07","timestamp":"2026-11-05T08:39:32.861Z","request_id":"req_011CgjUkQxztjhAYjgy2WvLv","wire_tool_inputs":{"toolu_01T4tHgEjbhNJCn4g9N8esZa":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='tests/headless/_people.mjs'; s=open(p).read()\n# pads go through a real stub, so the boot-time remap and the deadzone are exercised\ns=s.replace(\"\"\"const PAD_KEYS = { up: 'KeyW', down: 'KeyS', left: 'KeyA', right: 'KeyD' };\n\"\"\",\"\"\"const PAD_KEYS = { up: 'KeyW', down: 'KeyS', left: 'KeyA', right: 'KeyD' };\n\n/** A standard-mapping pad, through navigator.getGamepads: the boot-time remap and deadzone all run. */\nexport const stubPad = { id: 'Stub', index: 0, connected: true, mapping: 'standard', timestamp: 0, axes: [0, 0, 0, 0], buttons: Array.from({ length: 17 }, () => ({ pressed: false, value: 0, touched: false })) };\nexport function installPad() {\n  Object.defineProperty(globalThis.navigator, 'getGamepads', { value: () => [stubPad, null, null, null], configurable: true });\n}\nconst PAD_INDEX = { PadCross: 0, PadCircle: 1, PadSquare: 2, PadTriangle: 3, PadL1: 4, PadR1: 5, PadL2: 6, PadR2: 7, PadOptions: 9 };\n\"\"\")\ns=s.replace(\"\"\"  const setHeld = (code, on) => { if (on && !held.has(code)) { input.setKey(code, true); held.add(code); } else if (!on && held.has(code)) { input.setKey(code, false); held.delete(code); } };\n  let tapQueue = [];\n  const tap = (code) => { input.setKey(code, true); tapQueue.push(code); };\n  const release = () => { for (const c of tapQueue) input.setKey(c, false); tapQueue = []; };\"\"\",\"\"\"  const setCode = (code, on) => {\n    if (code in PAD_INDEX) { stubPad.buttons[PAD_INDEX[code]].pressed = on; stubPad.buttons[PAD_INDEX[code]].value = on ? 1 : 0; } else input.setKey(code, on);\n  };\n  const setHeld = (code, on) => { if (on && !held.has(code)) { setCode(code, true); held.add(code); } else if (!on && held.has(code)) { setCode(code, false); held.delete(code); } };\n  let tapQueue = [];\n  const tap = (code) => { setCode(code, true); tapQueue.push(code); };\n  const release = () => { for (const c of tapQueue) setCode(c, false); tapQueue = []; };\"\"\")\ns=s.replace(\"\"\"      } else if (device === 'pad') {\n        hands.stick.x = x; hands.stick.y = y;\n      } else {\"\"\",\"\"\"      } else if (device === 'pad') {\n        stubPad.axes[0] = x; stubPad.axes[1] = -y;\n      } else {\"\"\")\ns=s.replace(\"\"\"    stick: { x: 0, y: 0 },\n    hold(role, on) {\"\"\",\"\"\"    hold(role, on) {\"\"\")\ns=s.replace(\"\"\"    letGo() { for (const c of [...held]) setHeld(c, false); hands.stick.x = 0; hands.stick.y = 0; if (device === 'mouse') input.setButtons(0); },\"\"\",\"\"\"    letGo() { for (const c of [...held]) setHeld(c, false); stubPad.axes[0] = 0; stubPad.axes[1] = 0; if (device === 'mouse') input.setButtons(0); release(); },\"\"\")\ns+=\"\"\"\nconst TAU = Math.PI * 2;\n\n/** How a person plays each activity: what they can see on screen, and their hands. Called once a frame. */\nexport const PLAYS = {\n  poses(scene, hands, eyes, st) {\n    const lane = scene.playerLane, ev = scene.event, t = scene.eventT ?? 0;\n    const [x, y] = eyes.lean(lane.dot, ev.ringX, 0);\n    hands.lean(x, y, lane.dial);\n    if (ev.breathing) hands.hold('breath', ev.wantIn(t - 0.15));\n    void st;\n  },\n  longstand(scene, hands, eyes) {\n    const [x, y] = eyes.lean(scene.dot, 0, 0);\n    hands.lean(x, y, scene.dial);\n  },\n  reps(scene, hands) {\n    const lane = scene.playerLane, ev = scene.event, t = scene.eventT ?? 0;\n    const rep = Math.max(0, ev.repAt(t));\n    const target = ev.targetAt(t + 0.14);\n    const r = lane.state.r;\n    if (hands.device === 'keyboard') {\n      // Keys are rate control: push while the marker is ahead of you, let go when you're with it.\n      const diff = ev.targetAt(t + 0.08) - r;\n      const v = diff > 0.03 ? 1 : diff < -0.03 ? -1 : 0;\n      if (ev.data.input === 'down') hands.lean(0, -v, lane.dial);\n      else if (ev.data.input === 'up') hands.lean(0, v, lane.dial);\n      else hands.lean(v * ev.side(rep), 0, lane.dial);\n      return;\n    }\n    if (ev.data.input === 'down') hands.lean(0, -target, lane.dial);\n    else if (ev.data.input === 'up') hands.lean(0, target, lane.dial);\n    else hands.lean(target * ev.side(rep), 0, lane.dial);\n  },\n  hoop(scene, hands, eyes, st) {\n    const lane = scene.playerLane, ev = scene.event, t = scene.eventT ?? 0;\n    const dir = ev.dirAt(t) || 1;\n    const rate = hands.device === 'keyboard' ? 1.3 : 1.6;\n    st.a = (st.a ?? 0) + dir * rate * TAU * (1 / 60);\n    let x = Math.cos(st.a), y = Math.sin(st.a);\n    if (hands.device === 'keyboard') {\n      // Rolling the keys: W, then D, then S, then A, one at a time, as fingers do.\n      const q = Math.round(((st.a % TAU) + TAU) / (TAU / 4)) % 4;\n      x = [1, 0, -1, 0][q]; y = [0, 1, 0, -1][q];\n    }\n    const th = ev.throws[lane.state.throwI];\n    if (th && t >= th.t - 0.33 && t <= th.t && lane.state.hoops < 3) { x = th.side; y = 0; }\n    hands.lean(x, y, lane.dial);\n  },\n  step(scene, hands, eyes, st) {\n    const lane = scene.playerLane, ev = scene.event;\n    const now = scene.beatClock();\n    st.i = st.i ?? 0;\n    while (st.i < ev.notes.length && ev.notes[st.i].t + 0.02 <= now) {\n      if (now - ev.notes[st.i].t < 0.1) hands.press(ev.notes[st.i].foot === 'L' ? 'stepL' : 'stepR');\n      st.i++;\n      if (hands.device === 'mouse') break; // one button at a time on a mouse\n    }\n    void lane; void eyes;\n  },\n  header(scene, hands) {\n    const lane = scene.playerLane, ev = scene.event, s = lane.state, t = scene.eventT ?? 0;\n    let target = s.pos;\n    for (let i = s.wave; i < ev.waves.length; i++) {\n      const w = ev.waves[i];\n      if (t - w.t0 < 0.22) break;\n      if (w.type === 'flip') { if (Math.abs(s.pos - w.x) < 0.6 && w.t1 - t < 0.6) { target = w.x + (s.pos >= w.x ? 0.75 : -0.75); break; } continue; }\n      target = w.x;\n      break;\n    }\n    const v = Math.max(-1, Math.min(1, (target - s.pos) * 3));\n    hands.lean(Math.abs(v) < 0.08 ? 0 : v, 0, lane.dial);\n  },\n  slackline(scene, hands, eyes) {\n    const [x] = eyes.lean(scene.dot, 0, 0);\n    hands.lean(x, Math.abs(scene.dot.x) < 0.4 ? 1 : 0, scene.dial);\n  },\n  tray(scene, hands, eyes, st) {\n    const live = scene.vits.filter((v) => !v.done && !v.queued && v.wait <= 0);\n    let v = st.v && live.includes(st.v) ? st.v : null;\n    let cup = null, best = Infinity;\n    for (const c of live) {\n      if (v && c !== v) continue;\n      const p = c.body.translation();\n      for (const k of scene.cups) { if (k.color !== c.color) continue; const d = Math.hypot(k.x - p.x, k.z - p.z); if (d < best) { best = d; st.v = c; cup = k; } }\n    }\n    v = st.v;\n    if (!v || !cup) { hands.lean(0, 0); return; }\n    const p = v.body.translation(), vel = v.body.linvel();\n    const way = scene.nextCell(p.x, p.z, cup);\n    let ux = (way.x - p.x) * 0.5 - vel.x * 0.42, uy = -(way.z - p.z) * 0.5 + vel.z * 0.42;\n    const d = Math.hypot(ux, uy);\n    if (d > 0.62) { ux *= 0.62 / d; uy *= 0.62 / d; }\n    hands.lean(ux, uy);\n  },\n  pier(scene, hands, eyes, st) {\n    const stage = scene.stage2;\n    if (stage === 'runup') {\n      const [x, y] = eyes.lean(scene.dot, 0, -0.6);\n      hands.lean(x, y, scene.dial);\n      if (scene.st >= 4.97 && st.pressed !== scene.attempt) { st.pressed = scene.attempt; hands.press('confirm'); }\n    } else if (stage === 'flight') {\n      const [x, y] = eyes.lean(scene.dot, 0, 0);\n      hands.lean(x, y, scene.dial);\n      if (scene.flight - scene.st < 0.3 && st.canned !== scene.attempt) { st.canned = scene.attempt; hands.press('confirm'); }\n    } else hands.lean(0, 0, scene.dial);\n  },\n  jog(scene, hands, eyes, st) {\n    st.next = st.next ?? 0;\n    if (scene.time >= st.next) {\n      st.foot = st.foot === 'stepL' ? 'stepR' : 'stepL';\n      hands.press(st.foot);\n      st.next = scene.time + 1 / scene.targetCadence;\n    }\n    const u = scene.dist / scene.length;\n    let want = 0;\n    const next = scene.cups.find((c) => !c.taken && c.u > u && (c.u - u) * scene.length < 14);\n    if (next) want = next.x;\n    for (const o of scene.obs) { const d = (o.u - u) * scene.length; if (d > 0 && d < 5 && Math.abs(want - o.x) < 0.7) want = o.x + (o.x > 0 ? -1.2 : 1.2); }\n    const w = Math.max(-1, Math.min(1, (want - scene.x) * 3));\n    const n = scene.normalAt(u);\n    const { right, forward } = scene.ctx.camera.groundBasis();\n    const close = Math.abs(want - scene.x) < 0.15;\n    hands.lean(close ? 0 : w * (n.x * right.x + n.z * right.z), close ? 0 : w * (n.x * forward.x + n.z * forward.z));\n  },\n};\n\"\"\"\nopen(p,'w').write(s)\nEOF\ncat > .scratch/playsweep.mjs <<'EOF'\nimport { boot, App, tick } from '../tests/lib.mjs';\nimport { Eyes, installPad, makeHands, PLAYS, stubPad } from '../tests/headless/_people.mjs';\nimport { ACTIVITIES, ACTIVITY_IDS } from '../src/data/activities.js';\ninstallPad();\nconst h = await boot({ scene:'title' });\nconst only = process.argv[2] ? process.argv[2].split(',') : ACTIVITY_IDS;\nfor (const id of only) {\n  const row=[];\n  for (const dev of ['pad','keyboard','mouse']) {\n    await h.go('activity',{ id, mode:'dropin', noPractice:true, board: id==='tray'?0:undefined });\n    const hands=makeHands(h.engine,dev); hands.announce();\n    const s=App.scene;\n    // Begin with the confirm the card asks for, on this device.\n    hands.press('confirm'); h.step(1); hands.endFrame(); h.step(1);\n    const eyes=new Eyes(); const st={}; const play=PLAYS[ACTIVITIES[id].scene];\n    let n=0;\n    while(!s.resultsShown && n++<60*200){ if(s.phase==='play') play(s,hands,eyes,st); h.step(1); hands.endFrame(); }\n    hands.letGo(); h.step(2);\n    const r=s.lastResult; row.push(`${dev}:${r? (typeof r.score==='number'?r.score.toFixed(0):r.score)+'/'+r.stars+'*':'NO RESULT '+s.phase}`);\n  }\n  console.log(id.padEnd(10),row.join('  '));\n}\nconsole.log('errors',h.errors());\nprocess.exit(0);\nEOF\ntimeout 280 node .scratch/playsweep.mjs </dev/null 2>&1 | tail -20 | cut -c1-200","description":"Write per-activity human-like play scripts and sweep all activities on all devices","timeout":295000}}}
