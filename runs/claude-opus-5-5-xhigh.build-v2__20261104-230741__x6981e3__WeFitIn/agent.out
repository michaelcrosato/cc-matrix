? 0;\n    const th = st && this.phase === 'play' ? this.event.throws[st.throwI] : null;\n    const live = th && t >= th.t - HOOP_THROW.telegraph && t <= th.t;\n    this.flying.visible = !!live;\n    if (live) {\n      const u = 1 - (th.t - t) / HOOP_THROW.telegraph;\n      const fromX = this.june ? this.june.x : lane.x - th.side * 2.2;\n      const toX = lane.x + th.side * 0.9;\n      this.flying.position.set(fromX + (toX - fromX) * u, 1.1 + Math.sin(u * Math.PI) * 1.5, lane.z + (1 - u) * 0.2);\n      this.flying.rotation.x = u * 7;\n    }\n    if (this.june?.avatar && !this.june.gone) {\n      if (live && !this.juneWinding) { this.juneWinding = true; this.june.frozenClip = true; this.june.avatar.play('Point', { fade: 0.15 }); }\n      if (!live && this.juneWinding) { this.juneWinding = false; this.june.frozenClip = false; }\n    }\n  }\"\"\")\nopen(p,'w').write(s)\n\np='tests/headless/week.mjs'; s=open(p).read()\ns=s.replace(\"\"\"await test('save: corrupt JSON falls back safely', () => {\"\"\",\"\"\"await test('save: Drop-In records survive a reload', () => {\n  const s2 = new MemoryStorage();\n  const st = new Store(s2);\n  st.data.dropin = { tree: { best: 70, stars: 2, plays: 1 } };\n  st.write();\n  eq(new Store(s2).data.dropin.tree.best, 70);\n});\nawait test('save: corrupt JSON falls back safely', () => {\"\"\")\nopen(p,'w').write(s)\n\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [~] 7 Attract, Dev tools, touch-only, Locker, Hall of Numbers: written, untested\",\"- [x] 7 Attract, Dev tools, touch-only, Locker, Hall of Numbers: written and tested\")\ns=s.replace(\"- [ ] 8 Story and finish (ferry, beats, Long Stand, ending, 120+ lines, songs, models)\",\"- [x] 8 Story and finish (ferry, beats, Long Stand, ending, 120+ lines, songs, models)\")\ns=s.replace(\"\"\"## Next up\n- Write tests/headless/*.mjs and tests/browser/*.mjs per PLAN 18 (test runner tools/test.mjs exists). Helpers: tests/lib.mjs (Node), tests/browser/_lib.mjs, tests/lib-pure.mjs.\n- Then look at every screen at 1920x1080 via tools/shot.mjs (in page use `await go(id,args)`; `e.step`).\n- Then fill\"\"\",\"\"\"## Next up\n- All tests written (tests/headless, tests/browser). Look pass at 1080p nearly done (shots: .scratch/acts-shots.sh, .scratch/ui-shots.sh).\n- Then fill\"\"\")\nopen(p,'w').write(s)\nEOF\nsed -i 's/if (inp.jump \\&\\& !this.nearest) this.justJumped = true;/if (inp.jump \\&\\& !this.nearest) this.justJumped = true;/' src/scenes/hub.js\ntimeout 60 node tools/build.mjs </dev/null 2>&1 | tail -3\nSETUP=\"G.store.create(0,'Kim',{skin:'sand',top:'white',bottom:'sky',shoe:'white',hair:'ink',headband:'red'}); const sl=G.slot; sl.phase='day'; sl.day=3; sl.heardBeat=7; sl.drips=88; sl.wardrobe=['band2','cape','confidence','wrist']; sl.ages=[71,66,63,64,58,57]; sl.tests=[.3,.5,.6]; sl.introHeard=true; sl.todayDone=[{id:'tree',stars:2,score:80,beat:['dennis']}]; sl.todayDrips=14; sl.todaySeconds=134; sl.todayStars=2; sl.records={tree:{best:88,stars:2,plays:2}};\"\ntimeout 280 node tools/shot.mjs \\\n  v-weigh \"$SETUP await go('weighin',{test:'lean'}); e.step(120); G.setDriver('average'); while(G.stack.open){ G.stack.top.advance?.(); e.step(2);} e.step(160);\" \\\n  v-reveal \"e.step(60*16); while(G.stack.open && G.stack.top.name!=='dialogue'){ const t=G.stack.top; if(t.answer) t.answer(0); else t.advance?.(); e.step(2);} for(let i=0;i<30&&G.stack.open;i++){G.stack.top.advance?.(); e.step(2);} e.step(80);\" \\\n  v-report \"G.stack.clear(); G.setDriver(null); await go('report',{}); e.step(60);\" \\\n  v-jar \"await go('jar',{}); e.step(200);\" \\\n  v-locker \"await go('locker',{}); e.step(40);\" \\\n  v-medleyhead \"await go('medley',{family:[{kind:'keyboard'},{kind:'bot',skill:'good'},{kind:'bot',skill:'sloppy'},{kind:'bot',skill:'expert'}],picks:{pose:'tree',beat:'hoop',header:'header'}}); e.step(60*6+5); G.scene.clock.local=135; e.step(60*7);\" \\\n  v-attract \"await go('title',{}); e.step(5); G.startAttract(); for(let i=0;i<300&&G.loading;i++){e.step(1); await wait();} for(let i=0;i<30;i++){e.step(5); await wait();}  G.attract.t=0;  e.step(60*5);\" \\\n  v-avatarpick \"G.attract.exit(); for(let i=0;i<300&&G.loading;i++){e.step(1); await wait();} e.step(3); const {AvatarPickScreen}=G; e.input.setKey('Enter',true); e.step(1); e.input.setKey('Enter',false); e.step(2);\" \\\n  --frames 6 </dev/null 2>&1 | tail -1 | cut -c1-200\ncd .shots; row() { magick \"$1\" -resize 800x450 \"$2\" -resize 800x450 +append \"$3\"; }\nrow v-weigh.png v-reveal.png r1.png; row v-report.png v-jar.png r2.png; row v-locker.png v-medleyhead.png r3.png; row v-attract.png v-avatarpick.png r4.png\nmagick r1.png r2.png r3.png r4.png -append sheet6.png; rm r1.png r2.png r3.png r4.png; ls -la sheet6.png | cut -c20-","description":"Apply this round of fixes, rebuild, and re-capture the changed screens","timeout":400000}}}
