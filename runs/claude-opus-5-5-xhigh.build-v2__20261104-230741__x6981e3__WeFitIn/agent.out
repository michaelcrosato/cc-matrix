{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjJ4VCTRzEum5XFWRaJW","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BFbaLJWFL1ZAh5hWCVpTFW","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/audio/voice.js <<'EOF'\n// Gibberish voices. syllabify() is pure; renderVoice() works on any BaseAudioContext.\nexport const VOICES = {\n  ounce: { f0: 340, rate: 13, shift: 1.25, tick: true },\n  coach: { f0: 165, rate: 7.5, shift: 0.9, flat: true, pause: 0.34 },\n  marguerite: { f0: 230, rate: 9, shift: 1, vibrato: true },\n  dennis: { f0: 120, rate: 11, shift: 0.95, lastUp: true },\n  june: { f0: 300, rate: 10, shift: 1.15, flat: true, noContour: true },\n  kevin: { squawk: true, f0: 0, rate: 8, shift: 1 },\n  narrator: { f0: 200, rate: 11, shift: 1 },\n};\n\nconst FORMANTS = { a: [800, 1200], e: [500, 1900], i: [300, 2300], o: [500, 900], u: [350, 800] };\nconst VOWELS = ['a', 'e', 'i', 'o', 'u'];\nconst CONS = ['plosive', 'fricative', 'nasal', 'none'];\n\nfunction hash(word) {\n  let h = 2166136261;\n  for (let i = 0; i < word.length; i++) { h ^= word.charCodeAt(i); h = Math.imul(h, 16777619); }\n  return h >>> 0;\n}\n\nfunction syllableCount(word) {\n  const groups = word.toLowerCase().match(/[aeiouy]+/g);\n  return Math.max(1, Math.min(5, groups ? groups.length : Math.ceil(word.length / 3)));\n}\n\n/** Text to syllables: [{ t, dur, f0, vowel, cons, charIndex }]. The same word always sounds the same. */\nexport function syllabify(text, speaker = 'ounce') {\n  const v = VOICES[speaker] ?? VOICES.narrator;\n  const out = [];\n  if (v.squawk) return out;\n  const unit = 1 / v.rate;\n  let t = 0;\n  // Sentences, so declination restarts and ends get their own contour.\n  const sentenceRe = /[^.!?]+(?:\\.\\.\\.|[.!?]+|$)|\\.\\.\\./g;\n  let m;\n  while ((m = sentenceRe.exec(text)) !== null) {\n    const sentence = m[0];\n    const base = m.index;\n    const words = [];\n    const wordRe = /[A-Za-z0-9']+/g;\n    let w;\n    while ((w = wordRe.exec(sentence)) !== null) words.push({ s: w[0], at: base + w.index });\n    if (!words.length) { if (m[0].length === 0) sentenceRe.lastIndex++; continue; }\n    let total = 0;\n    for (const word of words) total += syllableCount(word.s);\n    const q = /\\?/.test(sentence), ex = /!/.test(sentence), dots = /\\.\\.\\.\\s*$/.test(sentence);\n    let k = 0;\n    words.forEach((word, wi) => {\n      const lower = word.s.toLowerCase();\n      const h0 = hash(lower);\n      const n = syllableCount(word.s);\n      for (let i = 0; i < n; i++) {\n        const h = Math.imul(h0 ^ (i * 2654435761), 2246822519) >>> 0;\n        const pos = total > 1 ? k / (total - 1) : 0;\n        let pitch = 1;\n        if (!v.noContour) {\n          if (!v.flat) pitch *= 1 - 0.15 * pos;\n          if (q && pos > 0.6) pitch *= 1 + 0.25 * ((pos - 0.6) / 0.4);\n          if (ex) pitch *= 1.15;\n          if (v.lastUp && wi === words.length - 1) pitch *= 1.2;\n        }\n        // A small per-syllable lilt, from the word's hash, so a voice isn't a drone.\n        if (!v.flat) pitch *= 1 + (((h >> 8) & 15) / 15 - 0.5) * 0.12;\n        const dur = unit * (dots ? 1.5 : 1);\n        out.push({\n          t, dur, f0: v.f0 * pitch,\n          vowel: VOWELS[h % 5], cons: CONS[(h >> 4) % 4],\n          charIndex: word.at + Math.round((i / n) * word.s.length),\n        });\n        t += dur;\n        k++;\n      }\n      t += unit * 0.25; // the breath between words\n    });\n    if (v.tick) out.push({ t, dur: 0, f0: 0, vowel: 'a', cons: 'tick', tick: true, charIndex: base + sentence.length - 1 });\n    t += unit * (dots ? 5 : 3) + (v.pause ?? 0);\n  }\n  return out;\n}\n\nexport function voiceLength(syllables) {\n  if (!syllables.length) return 0;\n  const last = syllables[syllables.length - 1];\n  return last.t + last.dur;\n}\n\n/** How many characters a typewriter should show at time t. */\nexport function revealAt(syllables, text, t) {\n  if (!syllables.length) return Math.min(text.length, Math.floor(t * 40));\n  let shown = 0;\n  for (let i = 0; i < syllables.length; i++) {\n    const s = syllables[i];\n    if (s.t > t) break;\n    const next = syllables[i + 1]?.charIndex ?? text.length;\n    const f = s.dur > 0 ? Math.min(1, (t - s.t) / s.dur) : 1;\n    shown = Math.round(s.charIndex + (next - s.charIndex) * f);\n  }\n  return Math.min(text.length, shown);\n}\n\nconst NOISE = new WeakMap();\nfunction noiseBuffer(ctx) {\n  let b = NOISE.get(ctx);\n  if (!b) {\n    const len = Math.floor(ctx.sampleRate * 0.25);\n    b = ctx.createBuffer(1, len, ctx.sampleRate);\n    const d = b.getChannelData(0);\n    let a = 12345;\n    for (let i = 0; i < len; i++) { a = (Math.imul(a, 1664525) + 1013904223) >>> 0; d[i] = a / 2147483648 - 1; }\n    NOISE.set(ctx, b);\n  }\n  return b;\n}\n\nfunction burst(ctx, dest, when, dur, level, freq) {\n  const src = ctx.createBufferSource();\n  src.buffer = noiseBuffer(ctx);\n  const f = ctx.createBiquadFilter();\n  f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = 1.2;\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(0.0001, when);\n  g.gain.linearRampToValueAtTime(level, when + 0.002);\n  g.gain.linearRampToValueAtTime(0.0001, when + dur);\n  src.connect(f); f.connect(g); g.connect(dest);\n  src.start(when); src.stop(when + dur + 0.01);\n  return src;\n}\n\n/** Schedule syllables on any BaseAudioContext. Returns the nodes that can still be stopped. */\nexport function renderVoice(ctx, destination, syllables, when = 0, speaker = 'ounce') {\n  const v = VOICES[speaker] ?? VOICES.narrator;\n  const nodes = [];\n  for (const s of syllables) {\n    const at = when + s.t;\n    if (s.tick) {\n      nodes.push(burst(ctx, destination, at, 0.012, 0.5, 3600));\n      continue;\n    }\n    const osc = ctx.createOscillator();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(s.f0, at);\n    if (v.vibrato) {\n      osc.frequency.linearRampToValueAtTime(s.f0 * 1.025, at + s.dur * 0.5);\n      osc.frequency.linearRampToValueAtTime(s.f0 * 0.985, at + s.dur);\n    }\n    const [f1, f2] = FORMANTS[s.vowel];\n    const env = ctx.createGain();\n    const end = at + s.dur + 0.03;\n    env.gain.setValueAtTime(0.0001, at);\n    env.gain.linearRampToValueAtTime(1, at + 0.006);\n    env.gain.setValueAtTime(1, Math.max(at + 0.007, end - 0.03));\n    env.gain.linearRampToValueAtTime(0.0001, end);\n    for (const [f, q, lvl] of [[f1, 7, 1], [f2, 9, 0.7]]) {\n      const bp = ctx.createBiquadFilter();\n      bp.type = 'bandpass'; bp.frequency.value = f * v.shift; bp.Q.value = q;\n      const g = ctx.createGain();\n      g.gain.value = lvl * 1.6;\n      osc.connect(bp); bp.connect(g); g.connect(env);\n    }\n    env.connect(destination);\n    osc.start(at); osc.stop(end + 0.01);\n    nodes.push(osc);\n    if (s.cons === 'plosive') nodes.push(burst(ctx, destination, at, 0.008, 0.45, 1800 * v.shift));\n    else if (s.cons === 'fricative') nodes.push(burst(ctx, destination, at, 0.04, 0.22, 4600 * v.shift));\n  }\n  return nodes;\n}\n\n/** Live speech over the engine's sfx bus, through its own Voice gain. */\nexport class VoicePlayer {\n  gain = null;\n  level = 1;\n  nodes = [];\n  log = [];\n\n  ensure(audio) {\n    const ctx = audio.context;\n    if (!ctx || !audio.buses?.sfx) return null;\n    if (!this.gain || this.gain.context !== ctx) {\n      this.gain = ctx.createGain();\n      this.gain.gain.value = this.level;\n      this.gain.connect(audio.buses.sfx);\n    }\n    return ctx;\n  }\n\n  setLevel(v) { this.level = v; if (this.gain) this.gain.gain.value = v; }\n\n  speak(audio, syllables, speaker) {\n    this.stop();\n    this.log.push(speaker);\n    if (this.log.length > 40) this.log.shift();\n    const ctx = this.ensure(audio);\n    if (!ctx) return false;\n    this.nodes = renderVoice(ctx, this.gain, syllables, ctx.currentTime + 0.02, speaker);\n    return true;\n  }\n\n  stop() {\n    for (const n of this.nodes) { try { n.stop(); } catch { /* already over */ } }\n    this.nodes = [];\n  }\n}\nEOF\ncat > src/audio/sfx.js <<'EOF'\n// Sound effects as data.\nexport const SFX_DEFS = {\n  needleTick: { wave: 'square', duty: 0.125, freq: 2400, decay: 0.02, volume: 0.25 },\n  ringIn: { wave: 'triangle', freq: 880, decay: 0.28, volume: 0.32, arp: [0, 7], arpRate: 0.06 },\n  ringOut: { wave: 'triangle', freq: 523, freqEnd: 392, decay: 0.2, volume: 0.22 },\n  wobble: { wave: 'square', duty: 0.25, freq: 240, decay: 0.12, volume: 0.14, vibrato: { depth: 1.5, rate: 18 } },\n  repTick: { wave: 'triangle', freq: 660, decay: 0.08, volume: 0.28 },\n  repPerfect: { wave: 'triangle', freq: 880, decay: 0.16, volume: 0.3, arp: [0, 4, 7], arpRate: 0.04 },\n  stepPerfect: { wave: 'triangle', freq: 1046, decay: 0.09, volume: 0.32 },\n  stepGood: { wave: 'triangle', freq: 784, decay: 0.08, volume: 0.26 },\n  stepMiss: { wave: 'noise', freq: 900, decay: 0.07, volume: 0.14 },\n  combo: { wave: 'square', duty: 0.25, freq: 660, decay: 0.2, volume: 0.22, arp: [0, 4, 7, 12], arpRate: 0.045 },\n  coconutBonk: { wave: 'triangle', freq: 300, freqEnd: 120, decay: 0.12, volume: 0.5, layers: [{ wave: 'noise', freq: 1800, decay: 0.03, volume: 0.25 }] },\n  flipFlopThwap: { wave: 'noise', freq: 2600, decay: 0.09, volume: 0.42, layers: [{ wave: 'square', freq: 170, freqEnd: 90, decay: 0.08, volume: 0.25 }] },\n  pineapple: { wave: 'triangle', freq: 784, decay: 0.32, volume: 0.32, arp: [0, 4, 7, 12, 16], arpRate: 0.05 },\n  hoopWhirr: { wave: 'triangle', freq: 180, freqEnd: 240, attack: 0.05, sustain: 0.45, decay: 0.05, volume: 0.18, vibrato: { depth: 2.5, rate: 11 } },\n  hoopDrop: { wave: 'triangle', freq: 420, freqEnd: 110, decay: 0.35, volume: 0.3 },\n  hoopCatch: { wave: 'triangle', freq: 523, decay: 0.2, volume: 0.32, arp: [0, 7, 12], arpRate: 0.05 },\n  splash: { wave: 'noise', freq: 1400, freqEnd: 300, attack: 0.01, decay: 0.7, volume: 0.6, layers: [{ wave: 'sine', freq: 130, freqEnd: 50, decay: 0.4, volume: 0.5 }] },\n  gust: { wave: 'noise', freq: 500, freqEnd: 1500, attack: 0.2, sustain: 0.3, decay: 0.5, volume: 0.22 },\n  gullSquawk: { wave: 'saw', freq: 1500, freqEnd: 800, decay: 0.2, volume: 0.22, vibrato: { depth: 3, rate: 26 }, layers: [{ wave: 'saw', delay: 0.16, freq: 1350, freqEnd: 700, decay: 0.22, volume: 0.2, vibrato: { depth: 3, rate: 26 } }] },\n  jarDrip: { wave: 'sine', freq: 620, freqEnd: 1300, decay: 0.12, volume: 0.42 },\n  starPop: { wave: 'triangle', freq: 988, decay: 0.26, volume: 0.42, arp: [0, 7, 12], arpRate: 0.05 },\n  menuMove: { wave: 'square', duty: 0.25, freq: 720, decay: 0.03, volume: 0.1 },\n  menuConfirm: { wave: 'triangle', freq: 660, decay: 0.12, volume: 0.28, arp: [0, 7], arpRate: 0.05 },\n  menuBack: { wave: 'triangle', freq: 440, freqEnd: 300, decay: 0.1, volume: 0.22 },\n  ow: { wave: 'square', duty: 0.125, freq: 900, freqEnd: 420, decay: 0.16, volume: 0.22 },\n  fanfareSoft: { wave: 'triangle', freq: 523, decay: 0.45, volume: 0.34, arp: [0, 4, 7, 12], arpRate: 0.1 },\n  sneeze: { wave: 'noise', freq: 3000, freqEnd: 900, attack: 0.08, decay: 0.2, volume: 0.42 },\n  rumble: { wave: 'sine', freq: 62, freqEnd: 40, attack: 0.1, sustain: 0.9, decay: 0.5, volume: 0.6, layers: [{ wave: 'noise', freq: 110, attack: 0.1, sustain: 0.8, decay: 0.5, volume: 0.25 }] },\n  clap: { wave: 'noise', freq: 2800, decay: 0.05, volume: 0.28 },\n  catapult: { wave: 'saw', freq: 220, freqEnd: 90, decay: 0.12, volume: 0.2 },\n  paddle: { wave: 'square', duty: 0.25, freq: 340, decay: 0.05, volume: 0.2 },\n  stitch: { wave: 'square', duty: 0.125, freq: 500, freqEnd: 180, decay: 0.28, volume: 0.22 },\n  cupGet: { wave: 'triangle', freq: 880, decay: 0.1, volume: 0.25, arp: [0, 5], arpRate: 0.04 },\n  vitaminIn: { wave: 'triangle', freq: 988, decay: 0.2, volume: 0.32, arp: [0, 4, 7], arpRate: 0.04 },\n  vitaminWrong: { wave: 'square', duty: 0.25, freq: 220, freqEnd: 170, decay: 0.16, volume: 0.2 },\n  vitaminRoll: { wave: 'noise', freq: 700, decay: 0.03, volume: 0.1 },\n  hop: { wave: 'triangle', freq: 300, freqEnd: 500, decay: 0.07, volume: 0.16 },\n  count: { wave: 'triangle', freq: 660, decay: 0.15, volume: 0.28 },\n  countGo: { wave: 'triangle', freq: 1046, decay: 0.3, volume: 0.32 },\n};\n\nexport function registerSfx(audio) {\n  for (const [name, def] of Object.entries(SFX_DEFS)) audio.register(name, def);\n}\nEOF\ncat > src/audio/songs.js <<'EOF'\n// Every tune in the game, as Song data. All original. Track volumes are written loud (.45-.8):\n// music plays at 10% by default, through a master of .8.\nconst rep = (s, n) => Array(n).fill(s).join(' ');\nconst rest = (n = 16) => rep('.', n);\n\n/** Waiting-room bossa, 92 BPM, soft triangle plucks. */\nexport const TITLE_SONG = {\n  bpm: 92,\n  tracks: {\n    pluck: { wave: 'triangle', decay: 0.34, volume: 0.62 },\n    strumA: { wave: 'triangle', decay: 0.16, volume: 0.42 },\n    strumB: { wave: 'triangle', decay: 0.16, volume: 0.38 },\n    bass: { wave: 'sine', decay: 0.42, volume: 0.72 },\n    shaker: { wave: 'noise', freq: 9000, decay: 0.025, volume: 0.14 },\n  },\n  patterns: (() => {\n    const shake = 'C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8';\n    const strum = (a, b) => ({ strumA: `. . . ${a} . . ${a} . . . ${a} . . ${a} . .`, strumB: `. . . ${b} . . ${b} . . . ${b} . . ${b} . .` });\n    const bassline = (r, f) => `${r} . . ${r} . . . . ${f} . . ${f} . . . .`;\n    return {\n      a1: { pluck: 'A4 . . C5 . . E5 . - . D5 . C5 . . .', ...strum('A3', 'E4'), bass: bassline('F2', 'C3'), shaker: shake },\n      a2: { pluck: 'B4 . . . . A4 . F4 . . . . A4 . . .', ...strum('A3', 'F4'), bass: bassline('D2', 'A2'), shaker: shake },\n      a3: { pluck: 'G4 . . Bb4 . . D5 . - . C5 . Bb4 . . .', ...strum('Bb3', 'F4'), bass: bassline('G2', 'D3'), shaker: shake },\n      a4: { pluck: 'A4 . . . G4 . . . E4 . . . . . . .', ...strum('Bb3', 'E4'), bass: bassline('C3', 'G2'), shaker: shake },\n      b1: { pluck: 'C5 . D5 . . E5 . . F5 . . E5 . C5 . .', ...strum('A3', 'E4'), bass: bassline('F2', 'C3'), shaker: shake },\n      b2: { pluck: 'E5 . . D5 . . Bb4 . . . . . A4 . . .', ...strum('G3', 'D4'), bass: bassline('E2', 'B2'), shaker: shake },\n      b3: { pluck: 'D5 . C5 . Bb4 . A4 . G4 . . . . . F4 .', ...strum('Bb3', 'F4'), bass: bassline('Bb2', 'F2'), shaker: shake },\n      b4: { pluck: 'G4 . . . . . . . . . . . . . . .', ...strum('Bb3', 'E4'), bass: bassline('C3', 'C2'), shaker: shake },\n    };\n  })(),\n  order: ['a1', 'a2', 'a3', 'a4', 'a1', 'a2', 'a3', 'a4', 'b1', 'b2', 'b3', 'b4', 'a1', 'a2', 'a3', 'a4'],\n};\n\n/** Holding Still: slow, sparse, breath-paced, 60 BPM. */\nexport const HOLD_SONG = {\n  bpm: 60,\n  tracks: {\n    bell: { wave: 'sine', decay: 1.6, volume: 0.62 },\n    pad: { wave: 'triangle', attack: 0.5, decay: 1.8, volume: 0.42 },\n    low: { wave: 'sine', attack: 0.3, decay: 2.4, volume: 0.6 },\n  },\n  patterns: {\n    a: { bell: 'E5 . . . . . . . . . . . . . . . . . . . . . . . B4 . . . . . . .', pad: 'A3 . . . . . . . . . . . . . . . E4 . . . . . . . . . . . . . . .', low: 'A2 . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .' },\n    b: { bell: '. . . . . . . . D5 . . . . . . . . . . . . . . . C5 . . . . . . .', pad: 'F3 . . . . . . . . . . . . . . . C4 . . . . . . . . . . . . . . .', low: 'F2 . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .' },\n    c: { bell: 'G4 . . . . . . . . . . . . . . . A4 . . . . . . . . . . . . . . .', pad: 'C4 . . . . . . . . . . . . . . . G3 . . . . . . . . . . . . . . .', low: 'C3 . . . . . . . . . . . . . . . G2 . . . . . . . . . . . . . . .' },\n  },\n  order: ['a', 'b', 'a', 'c'],\n};\n\n/** The Rep Shed: light funk bass, 110 BPM. */\nexport const REP_SONG = {\n  bpm: 110,\n  tracks: {\n    bass: { wave: 'square', duty: 0.25, decay: 0.16, volume: 0.5 },\n    keys: { wave: 'triangle', decay: 0.12, volume: 0.5 },\n    kick: { wave: 'sine', freq: 90, decay: 0.09, volume: 0.62 },\n    hat: { wave: 'noise', decay: 0.02, volume: 0.14 },\n  },\n  patterns: {\n    a: { bass: 'E2 . . E2 . . G2 . A2 . . A2 . G2 E2 .', keys: '. . E4 . . . . G4 . . E4 . . . . .', kick: 'C2 . . . . . C2 . . . C2 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    b: { bass: 'E2 . . E2 . . B2 . D3 . . B2 . A2 G2 .', keys: '. . G4 . . . . A4 . . G4 . . . E4 .', kick: 'C2 . . . . . C2 . . . C2 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    c: { bass: 'A2 . . A2 . . C3 . D3 . . D3 . C3 A2 .', keys: '. . C5 . . . . D5 . . C5 . . . . .', kick: 'C2 . . . . . C2 . . . C2 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    d: { bass: 'B2 . . B2 . . D3 . E3 . D3 . B2 . G2 .', keys: 'F#4 . . . A4 . . . B4 . . . . . . .', kick: 'C2 . . . . . C2 . C2 . C2 . . . C2 .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 C8 C8 C8' },\n  },\n  order: ['a', 'b', 'a', 'b', 'c', 'c', 'a', 'd'],\n};\n\n/** Hoop Economics: bright, four-on-the-floor, 118 BPM. */\nexport const HOOP_SONG = {\n  bpm: 118,\n  tracks: {\n    lead: { wave: 'square', duty: 0.25, decay: 0.14, volume: 0.42 },\n    arp: { wave: 'triangle', decay: 0.1, volume: 0.46 },\n    bass: { wave: 'triangle', decay: 0.18, volume: 0.72 },\n    kick: { wave: 'sine', freq: 100, freqEnd: 45, decay: 0.1, volume: 0.72 },\n    hat: { wave: 'noise', decay: 0.02, volume: 0.16 },\n  },\n  patterns: (() => {\n    const kick = 'C2 . . . C2 . . . C2 . . . C2 . . .';\n    const hat = '. . C8 . . . C8 . . . C8 . . . C8 C8';\n    return {\n      a: { lead: 'G5 . E5 . C5 . E5 . G5 . . A5 . G5 E5 .', arp: 'C4 E4 G4 E4 C4 E4 G4 E4 C4 E4 G4 E4 C4 E4 G4 E4', bass: 'C3 . . C3 . . C3 . . C3 . . C3 . G2 .', kick, hat },\n      b: { lead: 'A5 . F5 . C5 . F5 . A5 . . C6 . A5 F5 .', arp: 'F4 A4 C5 A4 F4 A4 C5 A4 F4 A4 C5 A4 F4 A4 C5 A4', bass: 'F2 . . F2 . . F2 . . F2 . . F2 . C3 .', kick, hat },\n      c: { lead: 'B5 . G5 . D5 . G5 . B5 . . D6 . B5 G5 .', arp: 'G4 B4 D5 B4 G4 B4 D5 B4 G4 B4 D5 B4 G4 B4 D5 B4', bass: 'G2 . . G2 . . G2 . . G2 . . G2 . D3 .', kick, hat },\n      d: { lead: 'C6 . . . G5 . . . E5 . . . C5 . . .', arp: 'A4 C5 E5 C5 A4 C5 E5 C5 G4 B4 D5 B4 G4 B4 D5 B4', bass: 'A2 . . A2 . . A2 . G2 . . G2 . . G2 .', kick, hat },\n    };\n  })(),\n  order: ['a', 'a', 'b', 'a', 'a', 'a', 'c', 'd'],\n};\n\n/** Step Class: 104 BPM exactly, 32 bars: intro 4, verse 8, chorus 8, breakdown 4, final 8. */\nexport const STEP_BPM = 104;\nconst stepPatterns = (() => {\n  const kick = 'C2 . . . C2 . . . C2 . . . C2 . . .';\n  const hat = '. . C8 . . . C8 . . . C8 . . . C8 .';\n  const none = rest();\n  return {\n    intro1: { lead: none, arp: 'D4 . F#4 . A4 . F#4 . D4 . F#4 . A4 . F#4 .', bass: none, kick, hat: none },\n    intro2: { lead: none, arp: 'G4 . B4 . D5 . B4 . A4 . C#5 . E5 . C#5 .', bass: 'D3 . . . . . . . . . . . . . . .', kick, hat },\n    verse1: { lead: 'F#5 . . E5 D5 . . . A4 . . B4 D5 . . .', arp: 'D4 F#4 A4 F#4 D4 F#4 A4 F#4 D4 F#4 A4 F#4 D4 F#4 A4 F#4', bass: 'D3 . . D3 . . A2 . D3 . . D3 . . A2 .', kick, hat },\n    verse2: { lead: 'G5 . . F#5 E5 . . . B4 . . C#5 E5 . . .', arp: 'G4 B4 D5 B4 G4 B4 D5 B4 A4 C#5 E5 C#5 A4 C#5 E5 C#5', bass: 'G2 . . G2 . . D3 . A2 . . A2 . . E3 .', kick, hat },\n    chorus1: { lead: 'A5 . F#5 . D5 . F#5 . A5 . B5 . A5 . F#5 .', arp: 'D5 A4 F#4 A4 D5 A4 F#4 A4 D5 A4 F#4 A4 D5 A4 F#4 A4', bass: 'D3 D3 . D3 A2 . D3 . D3 D3 . D3 A2 . D3 .', kick, hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    chorus2: { lead: 'B5 . G5 . D5 . G5 . A5 . G5 . E5 . C#5 .', arp: 'G4 D5 B4 D5 G4 D5 B4 D5 A4 E5 C#5 E5 A4 E5 C#5 E5', bass: 'G2 G2 . G2 D3 . G2 . A2 A2 . A2 E3 . A2 .', kick, hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    breakdown: { lead: 'D5 . . . . . . . A4 . . . . . . .', arp: none, bass: 'D2 . . . . . . . D2 . . . . . . .', kick: 'C2 . . . . . . . C2 . . . . . . .', hat: none },\n    build: { lead: 'A4 . . . B4 . . . C#5 . . . E5 . . .', arp: none, bass: 'A2 . . . A2 . . . A2 . A2 . A2 A2 A2 A2', kick, hat: 'C8 . C8 . C8 . C8 . C8 C8 C8 C8 C8 C8 C8 C8' },\n  };\n})();\nconst STEP_ORDER = [\n  'intro1', 'intro1', 'intro2', 'intro2',\n  'verse1', 'verse2', 'verse1', 'verse2', 'verse1', 'verse2', 'verse1', 'verse2',\n  'chorus1', 'chorus2', 'chorus1', 'chorus2', 'chorus1', 'chorus2', 'chorus1', 'chorus2',\n  'breakdown', 'breakdown', 'breakdown', 'build',\n  'chorus1', 'chorus2', 'chorus1', 'chorus2', 'chorus1', 'chorus2', 'chorus1', 'chorus2',\n];\nexport const STEP_SONG = {\n  bpm: STEP_BPM,\n  tracks: {\n    lead: { wave: 'square', duty: 0.25, decay: 0.16, volume: 0.42 },\n    arp: { wave: 'triangle', decay: 0.1, volume: 0.45 },\n    bass: { wave: 'triangle', decay: 0.2, volume: 0.72 },\n    kick: { wave: 'sine', freq: 100, freqEnd: 45, decay: 0.1, volume: 0.72 },\n    hat: { wave: 'noise', decay: 0.02, volume: 0.16 },\n  },\n  patterns: stepPatterns,\n  order: STEP_ORDER,\n  loop: false,\n};\n/** The Step song from a bar onward: after a pause the count-in restarts at the current bar. */\nexport function stepSongFrom(bar, lastBar = STEP_ORDER.length) {\n  return { ...STEP_SONG, order: STEP_ORDER.slice(Math.max(0, bar), lastBar) };\n}\n\n/** Lagoon Games: staccato ukulele feel, 120 BPM. */\nexport const LAGOON_SONG = {\n  bpm: 120,\n  tracks: {\n    uke1: { wave: 'triangle', decay: 0.09, volume: 0.56 },\n    uke2: { wave: 'triangle', decay: 0.09, volume: 0.46 },\n    tune: { wave: 'square', duty: 0.5, decay: 0.12, volume: 0.36 },\n    bass: { wave: 'sine', decay: 0.2, volume: 0.66 },\n    tick: { wave: 'noise', decay: 0.015, volume: 0.14 },\n  },\n  patterns: (() => {\n    const tick = 'C8 . . C8 . . C8 . C8 . . C8 . . C8 .';\n    const uke = (a, b) => ({ uke1: `${a} . ${a} ${a} . ${a} . ${a} ${a} . ${a} ${a} . ${a} . ${a}`, uke2: `${b} . ${b} ${b} . ${b} . ${b} ${b} . ${b} ${b} . ${b} . ${b}` });\n    return {\n      a: { ...uke('G4', 'C5'), tune: 'E5 . . . G5 . . E5 . . D5 . C5 . . .', bass: 'C3 . . . G2 . . . C3 . . . G2 . . .', tick },\n      b: { ...uke('A4', 'C5'), tune: 'A5 . . . G5 . . E5 . . G5 . . . . .', bass: 'F2 . . . C3 . . . F2 . . . C3 . . .', tick },\n      c: { ...uke('G4', 'B4'), tune: 'D5 . . . E5 . . F5 . . E5 . D5 . . .', bass: 'G2 . . . D3 . . . G2 . . . D3 . . .', tick },\n      d: { ...uke('G4', 'C5'), tune: 'C5 . E5 . G5 . E5 . C5 . . . . . . .', bass: 'C3 . . . G2 . . . C3 . G2 . C3 . . .', tick },\n    };\n  })(),\n  order: ['a', 'b', 'c', 'd', 'a', 'b', 'c', 'd'],\n};\n\n/** Island Jog: steady, cheerful, 112 BPM. */\nexport const JOG_SONG = {\n  bpm: 112,\n  tracks: {\n    lead: { wave: 'triangle', decay: 0.2, volume: 0.6 },\n    keys: { wave: 'square', duty: 0.125, decay: 0.1, volume: 0.32 },\n    bass: { wave: 'triangle', decay: 0.2, volume: 0.72 },\n    kick: { wave: 'sine', freq: 90, freqEnd: 45, decay: 0.09, volume: 0.6 },\n    hat: { wave: 'noise', decay: 0.02, volume: 0.14 },\n  },\n  patterns: (() => {\n    const kick = 'C2 . . . . . . . C2 . . . . . . .';\n    const hat = 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .';\n    return {\n      a: { lead: 'B4 . . D5 . . G5 . . . F#5 . E5 . D5 .', keys: 'G4 . B4 . G4 . B4 . G4 . B4 . G4 . B4 .', bass: 'G2 . . . G2 . . . D3 . . . D3 . . .', kick, hat },\n      b: { lead: 'C5 . . E5 . . A5 . . . G5 . F#5 . E5 .', keys: 'A4 . C5 . A4 . C5 . A4 . C5 . A4 . C5 .', bass: 'C3 . . . C3 . . . G2 . . . G2 . . .', kick, hat },\n      c: { lead: 'D5 . . G5 . . B5 . . . A5 . G5 . E5 .', keys: 'B4 . D5 . B4 . D5 . C5 . E5 . C5 . E5 .', bass: 'E2 . . . E2 . . . C3 . . . C3 . . .', kick, hat },\n      d: { lead: 'D5 . . . E5 . F#5 . G5 . . . . . . .', keys: 'A4 . D5 . A4 . D5 . B4 . D5 . B4 . D5 .', bass: 'D3 . . . D3 . . . G2 . . . G2 . G2 .', kick, hat },\n    };\n  })(),\n  order: ['a', 'b', 'c', 'd', 'a', 'b', 'c', 'd'],\n};\n\n/** Evening Report: music box, 70 BPM. */\nexport const REPORT_SONG = {\n  bpm: 70,\n  tracks: {\n    box: { wave: 'sine', decay: 0.7, volume: 0.66 },\n    box2: { wave: 'triangle', decay: 0.5, volume: 0.45 },\n    low: { wave: 'sine', decay: 1.1, volume: 0.48 },\n  },\n  patterns: {\n    a: { box: 'E6 . . . G5 . . . C6 . . . B5 . A5 .', box2: 'C5 . E5 . G5 . E5 . A4 . C5 . E5 . C5 .', low: 'C3 . . . . . . . A2 . . . . . . .' },\n    b: { box: 'D6 . . . F5 . . . B5 . . . A5 . G5 .', box2: 'D5 . F5 . A5 . F5 . G4 . B4 . D5 . B4 .', low: 'D3 . . . . . . . G2 . . . . . . .' },\n    c: { box: 'C6 . E6 . G6 . . . F6 . E6 . D6 . . .', box2: 'E5 . G5 . C6 . G5 . F5 . A5 . F5 . D5 .', low: 'C3 . . . . . . . F2 . . . . . . .' },\n    d: { box: 'C6 . . . . . . . . . . . . . . .', box2: 'E5 . G5 . C6 . . . . . . . . . . .', low: 'C3 . . . . . . . . . . . . . . .' },\n  },\n  order: ['a', 'b', 'a', 'c', 'a', 'b', 'c', 'd'],\n};\n\n/** The Long Stand: near silence, then one swelling chord line at t = 75. 48 BPM: 5 s a bar. */\nexport const STAND_SONG = {\n  bpm: 48,\n  tracks: {\n    drone: { wave: 'sine', attack: 2, decay: 3, volume: 0.5 },\n    swell1: { wave: 'triangle', attack: 3, sustain: 1, decay: 3, volume: 0.62 },\n    swell2: { wave: 'triangle', attack: 3, sustain: 1, decay: 3, volume: 0.5 },\n    swell3: { wave: 'sine', attack: 3, sustain: 1, decay: 3, volume: 0.56 },\n  },\n  patterns: {\n    hush: { drone: `D2 ${rest(15)}`, swell1: rest(), swell2: rest(), swell3: rest() },\n    quiet: { drone: rest(), swell1: rest(), swell2: rest(), swell3: rest() },\n    swellA: { drone: `D2 ${rest(15)}`, swell1: `A4 ${rest(15)}`, swell2: `D5 ${rest(15)}`, swell3: `F#5 ${rest(15)}` },\n    swellB: { drone: `G2 ${rest(15)}`, swell1: `B4 ${rest(15)}`, swell2: `D5 ${rest(15)}`, swell3: `G5 ${rest(15)}` },\n    swellC: { drone: `D2 ${rest(15)}`, swell1: `A4 ${rest(15)}`, swell2: `F#5 ${rest(15)}`, swell3: `D6 ${rest(15)}` },\n  },\n  order: ['hush', 'quiet', 'hush', 'quiet', 'quiet', 'hush', 'quiet', 'quiet', 'hush', 'quiet', 'quiet', 'hush', 'quiet', 'quiet', 'quiet', 'swellA', 'swellB', 'swellC'],\n  loop: false,\n};\n\n/** Ending and credits: the bossa, warmer, as a music box. */\nexport const CREDITS_SONG = { ...TITLE_SONG, bpm: 84, tracks: { ...TITLE_SONG.tracks, pluck: { wave: 'sine', decay: 0.6, volume: 0.66 } } };\n\nexport const SONGS = {\n  title: TITLE_SONG, hold: HOLD_SONG, rep: REP_SONG, hoop: HOOP_SONG, step: STEP_SONG,\n  lagoon: LAGOON_SONG, jog: JOG_SONG, report: REPORT_SONG, stand: STAND_SONG, credits: CREDITS_SONG,\n};\nexport const SONG_LABELS = {\n  title: 'Waiting Room', hold: 'Holding Still', rep: 'The Rep Shed', hoop: 'Beat Beach', step: 'Step Class',\n  lagoon: 'Lagoon Games', jog: 'Island Jog', report: 'Evening Report', stand: 'The Long Stand', credits: 'Bring Your Knees',\n};\nEOF\ncat > src/data/classmates.js <<'EOF'\n// The cast: names, looks and how well they score.\nexport const SPEAKERS = {\n  ounce: { name: 'Ounce', color: 'teal' },\n  coach: { name: 'Coach Plumb', color: 'teal' },\n  marguerite: { name: 'Marguerite', color: 'plum' },\n  dennis: { name: 'Dennis', color: 'orange' },\n  june: { name: 'June', color: 'blue' },\n  kevin: { name: 'Kevin', color: 'slate' },\n  narrator: { name: '', color: 'teal' },\n};\n\nexport const LOOKS = {\n  coach: { skin: 'sand', top: 'cyan', bottom: 'cyan', shoe: 'white', hair: 'mist', bun: true, long: true },\n  marguerite: { skin: 'sand', top: 'plum', bottom: 'white', shoe: 'white', hair: 'white', bun: true, long: true },\n  dennis: { skin: 'orange', top: 'lime', bottom: 'navy', shoe: 'slate', hair: 'slate', headband: 'orange' },\n  june: { skin: 'sand', top: 'red', bottom: 'ink', shoe: 'white', hair: 'ink', long: true },\n};\n\n/** Six starting avatars. */\nexport const PRESET_LOOKS = [\n  { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink', headband: 'red' },\n  { skin: 'orange', top: 'cyan', bottom: 'navy', shoe: 'white', hair: 'ink', hairStyle: 'short' },\n  { skin: 'red', top: 'sand', bottom: 'teal', shoe: 'slate', hair: 'ink', bun: true, long: true },\n  { skin: 'plum', top: 'lime', bottom: 'slate', shoe: 'white', hair: 'ink', hairStyle: 'tall' },\n  { skin: 'sand', top: 'orange', bottom: 'white', shoe: 'navy', hair: 'red', hairStyle: 'side' },\n  { skin: 'orange', top: 'plum', bottom: 'mist', shoe: 'white', hair: 'mist', headband: 'cyan', long: true },\n];\nexport const SKINS = ['sand', 'orange', 'red', 'plum'];\nexport const HAIR_STYLES = ['cap', 'short', 'bun', 'tall', 'side', 'bald'];\nexport const HAIR_COLORS = ['ink', 'slate', 'mist', 'white', 'red', 'orange', 'sand', 'blue'];\nexport const TOP_COLORS = ['white', 'cyan', 'sky', 'lime', 'orange', 'red', 'plum', 'sand', 'navy'];\nexport const BOTTOM_COLORS = ['sky', 'navy', 'teal', 'slate', 'white', 'mist', 'ink', 'plum'];\nexport const HEADBANDS = [null, 'red', 'cyan', 'lime', 'sand', 'white'];\n\n/** Reference skill of each classmate when they share your mats. */\nexport const CLASSMATE_SKILL = { dennis: 'sloppy', june: 'good', marguerite: 'expert' };\nEOF\necho ok","description":"Write voice, SFX, songs and classmate data modules","timeout":30000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15924,"cache_read_input_tokens":192789,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15924},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"9415378b-936d-4921-be0e-64f957d21dda","timestamp":"2026-11-05T06:20:56.421Z","request_id":"req_011CgjJ4Uq8bm7skR3FfMd2B","wire_tool_inputs":{"toolu_01BFbaLJWFL1ZAh5hWCVpTFW":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/audio/voice.js <<'EOF'\n// Gibberish voices. syllabify() is pure; renderVoice() works on any BaseAudioContext.\nexport const VOICES = {\n  ounce: { f0: 340, rate: 13, shift: 1.25, tick: true },\n  coach: { f0: 165, rate: 7.5, shift: 0.9, flat: true, pause: 0.34 },\n  marguerite: { f0: 230, rate: 9, shift: 1, vibrato: true },\n  dennis: { f0: 120, rate: 11, shift: 0.95, lastUp: true },\n  june: { f0: 300, rate: 10, shift: 1.15, flat: true, noContour: true },\n  kevin: { squawk: true, f0: 0, rate: 8, shift: 1 },\n  narrator: { f0: 200, rate: 11, shift: 1 },\n};\n\nconst FORMANTS = { a: [800, 1200], e: [500, 1900], i: [300, 2300], o: [500, 900], u: [350, 800] };\nconst VOWELS = ['a', 'e', 'i', 'o', 'u'];\nconst CONS = ['plosive', 'fricative', 'nasal', 'none'];\n\nfunction hash(word) {\n  let h = 2166136261;\n  for (let i = 0; i < word.length; i++) { h ^= word.charCodeAt(i); h = Math.imul(h, 16777619); }\n  return h >>> 0;\n}\n\nfunction syllableCount(word) {\n  const groups = word.toLowerCase().match(/[aeiouy]+/g);\n  return Math.max(1, Math.min(5, groups ? groups.length : Math.ceil(word.length / 3)));\n}\n\n/** Text to syllables: [{ t, dur, f0, vowel, cons, charIndex }]. The same word always sounds the same. */\nexport function syllabify(text, speaker = 'ounce') {\n  const v = VOICES[speaker] ?? VOICES.narrator;\n  const out = [];\n  if (v.squawk) return out;\n  const unit = 1 / v.rate;\n  let t = 0;\n  // Sentences, so declination restarts and ends get their own contour.\n  const sentenceRe = /[^.!?]+(?:\\.\\.\\.|[.!?]+|$)|\\.\\.\\./g;\n  let m;\n  while ((m = sentenceRe.exec(text)) !== null) {\n    const sentence = m[0];\n    const base = m.index;\n    const words = [];\n    const wordRe = /[A-Za-z0-9']+/g;\n    let w;\n    while ((w = wordRe.exec(sentence)) !== null) words.push({ s: w[0], at: base + w.index });\n    if (!words.length) { if (m[0].length === 0) sentenceRe.lastIndex++; continue; }\n    let total = 0;\n    for (const word of words) total += syllableCount(word.s);\n    const q = /\\?/.test(sentence), ex = /!/.test(sentence), dots = /\\.\\.\\.\\s*$/.test(sentence);\n    let k = 0;\n    words.forEach((word, wi) => {\n      const lower = word.s.toLowerCase();\n      const h0 = hash(lower);\n      const n = syllableCount(word.s);\n      for (let i = 0; i < n; i++) {\n        const h = Math.imul(h0 ^ (i * 2654435761), 2246822519) >>> 0;\n        const pos = total > 1 ? k / (total - 1) : 0;\n        let pitch = 1;\n        if (!v.noContour) {\n          if (!v.flat) pitch *= 1 - 0.15 * pos;\n          if (q && pos > 0.6) pitch *= 1 + 0.25 * ((pos - 0.6) / 0.4);\n          if (ex) pitch *= 1.15;\n          if (v.lastUp && wi === words.length - 1) pitch *= 1.2;\n        }\n        // A small per-syllable lilt, from the word's hash, so a voice isn't a drone.\n        if (!v.flat) pitch *= 1 + (((h >> 8) & 15) / 15 - 0.5) * 0.12;\n        const dur = unit * (dots ? 1.5 : 1);\n        out.push({\n          t, dur, f0: v.f0 * pitch,\n          vowel: VOWELS[h % 5], cons: CONS[(h >> 4) % 4],\n          charIndex: word.at + Math.round((i / n) * word.s.length),\n        });\n        t += dur;\n        k++;\n      }\n      t += unit * 0.25; // the breath between words\n    });\n    if (v.tick) out.push({ t, dur: 0, f0: 0, vowel: 'a', cons: 'tick', tick: true, charIndex: base + sentence.length - 1 });\n    t += unit * (dots ? 5 : 3) + (v.pause ?? 0);\n  }\n  return out;\n}\n\nexport function voiceLength(syllables) {\n  if (!syllables.length) return 0;\n  const last = syllables[syllables.length - 1];\n  return last.t + last.dur;\n}\n\n/** How many characters a typewriter should show at time t. */\nexport function revealAt(syllables, text, t) {\n  if (!syllables.length) return Math.min(text.length, Math.floor(t * 40));\n  let shown = 0;\n  for (let i = 0; i < syllables.length; i++) {\n    const s = syllables[i];\n    if (s.t > t) break;\n    const next = syllables[i + 1]?.charIndex ?? text.length;\n    const f = s.dur > 0 ? Math.min(1, (t - s.t) / s.dur) : 1;\n    shown = Math.round(s.charIndex + (next - s.charIndex) * f);\n  }\n  return Math.min(text.length, shown);\n}\n\nconst NOISE = new WeakMap();\nfunction noiseBuffer(ctx) {\n  let b = NOISE.get(ctx);\n  if (!b) {\n    const len = Math.floor(ctx.sampleRate * 0.25);\n    b = ctx.createBuffer(1, len, ctx.sampleRate);\n    const d = b.getChannelData(0);\n    let a = 12345;\n    for (let i = 0; i < len; i++) { a = (Math.imul(a, 1664525) + 1013904223) >>> 0; d[i] = a / 2147483648 - 1; }\n    NOISE.set(ctx, b);\n  }\n  return b;\n}\n\nfunction burst(ctx, dest, when, dur, level, freq) {\n  const src = ctx.createBufferSource();\n  src.buffer = noiseBuffer(ctx);\n  const f = ctx.createBiquadFilter();\n  f.type = 'bandpass'; f.frequency.value = freq; f.Q.value = 1.2;\n  const g = ctx.createGain();\n  g.gain.setValueAtTime(0.0001, when);\n  g.gain.linearRampToValueAtTime(level, when + 0.002);\n  g.gain.linearRampToValueAtTime(0.0001, when + dur);\n  src.connect(f); f.connect(g); g.connect(dest);\n  src.start(when); src.stop(when + dur + 0.01);\n  return src;\n}\n\n/** Schedule syllables on any BaseAudioContext. Returns the nodes that can still be stopped. */\nexport function renderVoice(ctx, destination, syllables, when = 0, speaker = 'ounce') {\n  const v = VOICES[speaker] ?? VOICES.narrator;\n  const nodes = [];\n  for (const s of syllables) {\n    const at = when + s.t;\n    if (s.tick) {\n      nodes.push(burst(ctx, destination, at, 0.012, 0.5, 3600));\n      continue;\n    }\n    const osc = ctx.createOscillator();\n    osc.type = 'sawtooth';\n    osc.frequency.setValueAtTime(s.f0, at);\n    if (v.vibrato) {\n      osc.frequency.linearRampToValueAtTime(s.f0 * 1.025, at + s.dur * 0.5);\n      osc.frequency.linearRampToValueAtTime(s.f0 * 0.985, at + s.dur);\n    }\n    const [f1, f2] = FORMANTS[s.vowel];\n    const env = ctx.createGain();\n    const end = at + s.dur + 0.03;\n    env.gain.setValueAtTime(0.0001, at);\n    env.gain.linearRampToValueAtTime(1, at + 0.006);\n    env.gain.setValueAtTime(1, Math.max(at + 0.007, end - 0.03));\n    env.gain.linearRampToValueAtTime(0.0001, end);\n    for (const [f, q, lvl] of [[f1, 7, 1], [f2, 9, 0.7]]) {\n      const bp = ctx.createBiquadFilter();\n      bp.type = 'bandpass'; bp.frequency.value = f * v.shift; bp.Q.value = q;\n      const g = ctx.createGain();\n      g.gain.value = lvl * 1.6;\n      osc.connect(bp); bp.connect(g); g.connect(env);\n    }\n    env.connect(destination);\n    osc.start(at); osc.stop(end + 0.01);\n    nodes.push(osc);\n    if (s.cons === 'plosive') nodes.push(burst(ctx, destination, at, 0.008, 0.45, 1800 * v.shift));\n    else if (s.cons === 'fricative') nodes.push(burst(ctx, destination, at, 0.04, 0.22, 4600 * v.shift));\n  }\n  return nodes;\n}\n\n/** Live speech over the engine's sfx bus, through its own Voice gain. */\nexport class VoicePlayer {\n  gain = null;\n  level = 1;\n  nodes = [];\n  log = [];\n\n  ensure(audio) {\n    const ctx = audio.context;\n    if (!ctx || !audio.buses?.sfx) return null;\n    if (!this.gain || this.gain.context !== ctx) {\n      this.gain = ctx.createGain();\n      this.gain.gain.value = this.level;\n      this.gain.connect(audio.buses.sfx);\n    }\n    return ctx;\n  }\n\n  setLevel(v) { this.level = v; if (this.gain) this.gain.gain.value = v; }\n\n  speak(audio, syllables, speaker) {\n    this.stop();\n    this.log.push(speaker);\n    if (this.log.length > 40) this.log.shift();\n    const ctx = this.ensure(audio);\n    if (!ctx) return false;\n    this.nodes = renderVoice(ctx, this.gain, syllables, ctx.currentTime + 0.02, speaker);\n    return true;\n  }\n\n  stop() {\n    for (const n of this.nodes) { try { n.stop(); } catch { /* already over */ } }\n    this.nodes = [];\n  }\n}\nEOF\ncat > src/audio/sfx.js <<'EOF'\n// Sound effects as data.\nexport const SFX_DEFS = {\n  needleTick: { wave: 'square', duty: 0.125, freq: 2400, decay: 0.02, volume: 0.25 },\n  ringIn: { wave: 'triangle', freq: 880, decay: 0.28, volume: 0.32, arp: [0, 7], arpRate: 0.06 },\n  ringOut: { wave: 'triangle', freq: 523, freqEnd: 392, decay: 0.2, volume: 0.22 },\n  wobble: { wave: 'square', duty: 0.25, freq: 240, decay: 0.12, volume: 0.14, vibrato: { depth: 1.5, rate: 18 } },\n  repTick: { wave: 'triangle', freq: 660, decay: 0.08, volume: 0.28 },\n  repPerfect: { wave: 'triangle', freq: 880, decay: 0.16, volume: 0.3, arp: [0, 4, 7], arpRate: 0.04 },\n  stepPerfect: { wave: 'triangle', freq: 1046, decay: 0.09, volume: 0.32 },\n  stepGood: { wave: 'triangle', freq: 784, decay: 0.08, volume: 0.26 },\n  stepMiss: { wave: 'noise', freq: 900, decay: 0.07, volume: 0.14 },\n  combo: { wave: 'square', duty: 0.25, freq: 660, decay: 0.2, volume: 0.22, arp: [0, 4, 7, 12], arpRate: 0.045 },\n  coconutBonk: { wave: 'triangle', freq: 300, freqEnd: 120, decay: 0.12, volume: 0.5, layers: [{ wave: 'noise', freq: 1800, decay: 0.03, volume: 0.25 }] },\n  flipFlopThwap: { wave: 'noise', freq: 2600, decay: 0.09, volume: 0.42, layers: [{ wave: 'square', freq: 170, freqEnd: 90, decay: 0.08, volume: 0.25 }] },\n  pineapple: { wave: 'triangle', freq: 784, decay: 0.32, volume: 0.32, arp: [0, 4, 7, 12, 16], arpRate: 0.05 },\n  hoopWhirr: { wave: 'triangle', freq: 180, freqEnd: 240, attack: 0.05, sustain: 0.45, decay: 0.05, volume: 0.18, vibrato: { depth: 2.5, rate: 11 } },\n  hoopDrop: { wave: 'triangle', freq: 420, freqEnd: 110, decay: 0.35, volume: 0.3 },\n  hoopCatch: { wave: 'triangle', freq: 523, decay: 0.2, volume: 0.32, arp: [0, 7, 12], arpRate: 0.05 },\n  splash: { wave: 'noise', freq: 1400, freqEnd: 300, attack: 0.01, decay: 0.7, volume: 0.6, layers: [{ wave: 'sine', freq: 130, freqEnd: 50, decay: 0.4, volume: 0.5 }] },\n  gust: { wave: 'noise', freq: 500, freqEnd: 1500, attack: 0.2, sustain: 0.3, decay: 0.5, volume: 0.22 },\n  gullSquawk: { wave: 'saw', freq: 1500, freqEnd: 800, decay: 0.2, volume: 0.22, vibrato: { depth: 3, rate: 26 }, layers: [{ wave: 'saw', delay: 0.16, freq: 1350, freqEnd: 700, decay: 0.22, volume: 0.2, vibrato: { depth: 3, rate: 26 } }] },\n  jarDrip: { wave: 'sine', freq: 620, freqEnd: 1300, decay: 0.12, volume: 0.42 },\n  starPop: { wave: 'triangle', freq: 988, decay: 0.26, volume: 0.42, arp: [0, 7, 12], arpRate: 0.05 },\n  menuMove: { wave: 'square', duty: 0.25, freq: 720, decay: 0.03, volume: 0.1 },\n  menuConfirm: { wave: 'triangle', freq: 660, decay: 0.12, volume: 0.28, arp: [0, 7], arpRate: 0.05 },\n  menuBack: { wave: 'triangle', freq: 440, freqEnd: 300, decay: 0.1, volume: 0.22 },\n  ow: { wave: 'square', duty: 0.125, freq: 900, freqEnd: 420, decay: 0.16, volume: 0.22 },\n  fanfareSoft: { wave: 'triangle', freq: 523, decay: 0.45, volume: 0.34, arp: [0, 4, 7, 12], arpRate: 0.1 },\n  sneeze: { wave: 'noise', freq: 3000, freqEnd: 900, attack: 0.08, decay: 0.2, volume: 0.42 },\n  rumble: { wave: 'sine', freq: 62, freqEnd: 40, attack: 0.1, sustain: 0.9, decay: 0.5, volume: 0.6, layers: [{ wave: 'noise', freq: 110, attack: 0.1, sustain: 0.8, decay: 0.5, volume: 0.25 }] },\n  clap: { wave: 'noise', freq: 2800, decay: 0.05, volume: 0.28 },\n  catapult: { wave: 'saw', freq: 220, freqEnd: 90, decay: 0.12, volume: 0.2 },\n  paddle: { wave: 'square', duty: 0.25, freq: 340, decay: 0.05, volume: 0.2 },\n  stitch: { wave: 'square', duty: 0.125, freq: 500, freqEnd: 180, decay: 0.28, volume: 0.22 },\n  cupGet: { wave: 'triangle', freq: 880, decay: 0.1, volume: 0.25, arp: [0, 5], arpRate: 0.04 },\n  vitaminIn: { wave: 'triangle', freq: 988, decay: 0.2, volume: 0.32, arp: [0, 4, 7], arpRate: 0.04 },\n  vitaminWrong: { wave: 'square', duty: 0.25, freq: 220, freqEnd: 170, decay: 0.16, volume: 0.2 },\n  vitaminRoll: { wave: 'noise', freq: 700, decay: 0.03, volume: 0.1 },\n  hop: { wave: 'triangle', freq: 300, freqEnd: 500, decay: 0.07, volume: 0.16 },\n  count: { wave: 'triangle', freq: 660, decay: 0.15, volume: 0.28 },\n  countGo: { wave: 'triangle', freq: 1046, decay: 0.3, volume: 0.32 },\n};\n\nexport function registerSfx(audio) {\n  for (const [name, def] of Object.entries(SFX_DEFS)) audio.register(name, def);\n}\nEOF\ncat > src/audio/songs.js <<'EOF'\n// Every tune in the game, as Song data. All original. Track volumes are written loud (.45-.8):\n// music plays at 10% by default, through a master of .8.\nconst rep = (s, n) => Array(n).fill(s).join(' ');\nconst rest = (n = 16) => rep('.', n);\n\n/** Waiting-room bossa, 92 BPM, soft triangle plucks. */\nexport const TITLE_SONG = {\n  bpm: 92,\n  tracks: {\n    pluck: { wave: 'triangle', decay: 0.34, volume: 0.62 },\n    strumA: { wave: 'triangle', decay: 0.16, volume: 0.42 },\n    strumB: { wave: 'triangle', decay: 0.16, volume: 0.38 },\n    bass: { wave: 'sine', decay: 0.42, volume: 0.72 },\n    shaker: { wave: 'noise', freq: 9000, decay: 0.025, volume: 0.14 },\n  },\n  patterns: (() => {\n    const shake = 'C8 . C8 C8 C8 . C8 C8 C8 . C8 C8 C8 . C8 C8';\n    const strum = (a, b) => ({ strumA: `. . . ${a} . . ${a} . . . ${a} . . ${a} . .`, strumB: `. . . ${b} . . ${b} . . . ${b} . . ${b} . .` });\n    const bassline = (r, f) => `${r} . . ${r} . . . . ${f} . . ${f} . . . .`;\n    return {\n      a1: { pluck: 'A4 . . C5 . . E5 . - . D5 . C5 . . .', ...strum('A3', 'E4'), bass: bassline('F2', 'C3'), shaker: shake },\n      a2: { pluck: 'B4 . . . . A4 . F4 . . . . A4 . . .', ...strum('A3', 'F4'), bass: bassline('D2', 'A2'), shaker: shake },\n      a3: { pluck: 'G4 . . Bb4 . . D5 . - . C5 . Bb4 . . .', ...strum('Bb3', 'F4'), bass: bassline('G2', 'D3'), shaker: shake },\n      a4: { pluck: 'A4 . . . G4 . . . E4 . . . . . . .', ...strum('Bb3', 'E4'), bass: bassline('C3', 'G2'), shaker: shake },\n      b1: { pluck: 'C5 . D5 . . E5 . . F5 . . E5 . C5 . .', ...strum('A3', 'E4'), bass: bassline('F2', 'C3'), shaker: shake },\n      b2: { pluck: 'E5 . . D5 . . Bb4 . . . . . A4 . . .', ...strum('G3', 'D4'), bass: bassline('E2', 'B2'), shaker: shake },\n      b3: { pluck: 'D5 . C5 . Bb4 . A4 . G4 . . . . . F4 .', ...strum('Bb3', 'F4'), bass: bassline('Bb2', 'F2'), shaker: shake },\n      b4: { pluck: 'G4 . . . . . . . . . . . . . . .', ...strum('Bb3', 'E4'), bass: bassline('C3', 'C2'), shaker: shake },\n    };\n  })(),\n  order: ['a1', 'a2', 'a3', 'a4', 'a1', 'a2', 'a3', 'a4', 'b1', 'b2', 'b3', 'b4', 'a1', 'a2', 'a3', 'a4'],\n};\n\n/** Holding Still: slow, sparse, breath-paced, 60 BPM. */\nexport const HOLD_SONG = {\n  bpm: 60,\n  tracks: {\n    bell: { wave: 'sine', decay: 1.6, volume: 0.62 },\n    pad: { wave: 'triangle', attack: 0.5, decay: 1.8, volume: 0.42 },\n    low: { wave: 'sine', attack: 0.3, decay: 2.4, volume: 0.6 },\n  },\n  patterns: {\n    a: { bell: 'E5 . . . . . . . . . . . . . . . . . . . . . . . B4 . . . . . . .', pad: 'A3 . . . . . . . . . . . . . . . E4 . . . . . . . . . . . . . . .', low: 'A2 . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .' },\n    b: { bell: '. . . . . . . . D5 . . . . . . . . . . . . . . . C5 . . . . . . .', pad: 'F3 . . . . . . . . . . . . . . . C4 . . . . . . . . . . . . . . .', low: 'F2 . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .' },\n    c: { bell: 'G4 . . . . . . . . . . . . . . . A4 . . . . . . . . . . . . . . .', pad: 'C4 . . . . . . . . . . . . . . . G3 . . . . . . . . . . . . . . .', low: 'C3 . . . . . . . . . . . . . . . G2 . . . . . . . . . . . . . . .' },\n  },\n  order: ['a', 'b', 'a', 'c'],\n};\n\n/** The Rep Shed: light funk bass, 110 BPM. */\nexport const REP_SONG = {\n  bpm: 110,\n  tracks: {\n    bass: { wave: 'square', duty: 0.25, decay: 0.16, volume: 0.5 },\n    keys: { wave: 'triangle', decay: 0.12, volume: 0.5 },\n    kick: { wave: 'sine', freq: 90, decay: 0.09, volume: 0.62 },\n    hat: { wave: 'noise', decay: 0.02, volume: 0.14 },\n  },\n  patterns: {\n    a: { bass: 'E2 . . E2 . . G2 . A2 . . A2 . G2 E2 .', keys: '. . E4 . . . . G4 . . E4 . . . . .', kick: 'C2 . . . . . C2 . . . C2 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    b: { bass: 'E2 . . E2 . . B2 . D3 . . B2 . A2 G2 .', keys: '. . G4 . . . . A4 . . G4 . . . E4 .', kick: 'C2 . . . . . C2 . . . C2 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    c: { bass: 'A2 . . A2 . . C3 . D3 . . D3 . C3 A2 .', keys: '. . C5 . . . . D5 . . C5 . . . . .', kick: 'C2 . . . . . C2 . . . C2 . . . . .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    d: { bass: 'B2 . . B2 . . D3 . E3 . D3 . B2 . G2 .', keys: 'F#4 . . . A4 . . . B4 . . . . . . .', kick: 'C2 . . . . . C2 . C2 . C2 . . . C2 .', hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 C8 C8 C8' },\n  },\n  order: ['a', 'b', 'a', 'b', 'c', 'c', 'a', 'd'],\n};\n\n/** Hoop Economics: bright, four-on-the-floor, 118 BPM. */\nexport const HOOP_SONG = {\n  bpm: 118,\n  tracks: {\n    lead: { wave: 'square', duty: 0.25, decay: 0.14, volume: 0.42 },\n    arp: { wave: 'triangle', decay: 0.1, volume: 0.46 },\n    bass: { wave: 'triangle', decay: 0.18, volume: 0.72 },\n    kick: { wave: 'sine', freq: 100, freqEnd: 45, decay: 0.1, volume: 0.72 },\n    hat: { wave: 'noise', decay: 0.02, volume: 0.16 },\n  },\n  patterns: (() => {\n    const kick = 'C2 . . . C2 . . . C2 . . . C2 . . .';\n    const hat = '. . C8 . . . C8 . . . C8 . . . C8 C8';\n    return {\n      a: { lead: 'G5 . E5 . C5 . E5 . G5 . . A5 . G5 E5 .', arp: 'C4 E4 G4 E4 C4 E4 G4 E4 C4 E4 G4 E4 C4 E4 G4 E4', bass: 'C3 . . C3 . . C3 . . C3 . . C3 . G2 .', kick, hat },\n      b: { lead: 'A5 . F5 . C5 . F5 . A5 . . C6 . A5 F5 .', arp: 'F4 A4 C5 A4 F4 A4 C5 A4 F4 A4 C5 A4 F4 A4 C5 A4', bass: 'F2 . . F2 . . F2 . . F2 . . F2 . C3 .', kick, hat },\n      c: { lead: 'B5 . G5 . D5 . G5 . B5 . . D6 . B5 G5 .', arp: 'G4 B4 D5 B4 G4 B4 D5 B4 G4 B4 D5 B4 G4 B4 D5 B4', bass: 'G2 . . G2 . . G2 . . G2 . . G2 . D3 .', kick, hat },\n      d: { lead: 'C6 . . . G5 . . . E5 . . . C5 . . .', arp: 'A4 C5 E5 C5 A4 C5 E5 C5 G4 B4 D5 B4 G4 B4 D5 B4', bass: 'A2 . . A2 . . A2 . G2 . . G2 . . G2 .', kick, hat },\n    };\n  })(),\n  order: ['a', 'a', 'b', 'a', 'a', 'a', 'c', 'd'],\n};\n\n/** Step Class: 104 BPM exactly, 32 bars: intro 4, verse 8, chorus 8, breakdown 4, final 8. */\nexport const STEP_BPM = 104;\nconst stepPatterns = (() => {\n  const kick = 'C2 . . . C2 . . . C2 . . . C2 . . .';\n  const hat = '. . C8 . . . C8 . . . C8 . . . C8 .';\n  const none = rest();\n  return {\n    intro1: { lead: none, arp: 'D4 . F#4 . A4 . F#4 . D4 . F#4 . A4 . F#4 .', bass: none, kick, hat: none },\n    intro2: { lead: none, arp: 'G4 . B4 . D5 . B4 . A4 . C#5 . E5 . C#5 .', bass: 'D3 . . . . . . . . . . . . . . .', kick, hat },\n    verse1: { lead: 'F#5 . . E5 D5 . . . A4 . . B4 D5 . . .', arp: 'D4 F#4 A4 F#4 D4 F#4 A4 F#4 D4 F#4 A4 F#4 D4 F#4 A4 F#4', bass: 'D3 . . D3 . . A2 . D3 . . D3 . . A2 .', kick, hat },\n    verse2: { lead: 'G5 . . F#5 E5 . . . B4 . . C#5 E5 . . .', arp: 'G4 B4 D5 B4 G4 B4 D5 B4 A4 C#5 E5 C#5 A4 C#5 E5 C#5', bass: 'G2 . . G2 . . D3 . A2 . . A2 . . E3 .', kick, hat },\n    chorus1: { lead: 'A5 . F#5 . D5 . F#5 . A5 . B5 . A5 . F#5 .', arp: 'D5 A4 F#4 A4 D5 A4 F#4 A4 D5 A4 F#4 A4 D5 A4 F#4 A4', bass: 'D3 D3 . D3 A2 . D3 . D3 D3 . D3 A2 . D3 .', kick, hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    chorus2: { lead: 'B5 . G5 . D5 . G5 . A5 . G5 . E5 . C#5 .', arp: 'G4 D5 B4 D5 G4 D5 B4 D5 A4 E5 C#5 E5 A4 E5 C#5 E5', bass: 'G2 G2 . G2 D3 . G2 . A2 A2 . A2 E3 . A2 .', kick, hat: 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 C8' },\n    breakdown: { lead: 'D5 . . . . . . . A4 . . . . . . .', arp: none, bass: 'D2 . . . . . . . D2 . . . . . . .', kick: 'C2 . . . . . . . C2 . . . . . . .', hat: none },\n    build: { lead: 'A4 . . . B4 . . . C#5 . . . E5 . . .', arp: none, bass: 'A2 . . . A2 . . . A2 . A2 . A2 A2 A2 A2', kick, hat: 'C8 . C8 . C8 . C8 . C8 C8 C8 C8 C8 C8 C8 C8' },\n  };\n})();\nconst STEP_ORDER = [\n  'intro1', 'intro1', 'intro2', 'intro2',\n  'verse1', 'verse2', 'verse1', 'verse2', 'verse1', 'verse2', 'verse1', 'verse2',\n  'chorus1', 'chorus2', 'chorus1', 'chorus2', 'chorus1', 'chorus2', 'chorus1', 'chorus2',\n  'breakdown', 'breakdown', 'breakdown', 'build',\n  'chorus1', 'chorus2', 'chorus1', 'chorus2', 'chorus1', 'chorus2', 'chorus1', 'chorus2',\n];\nexport const STEP_SONG = {\n  bpm: STEP_BPM,\n  tracks: {\n    lead: { wave: 'square', duty: 0.25, decay: 0.16, volume: 0.42 },\n    arp: { wave: 'triangle', decay: 0.1, volume: 0.45 },\n    bass: { wave: 'triangle', decay: 0.2, volume: 0.72 },\n    kick: { wave: 'sine', freq: 100, freqEnd: 45, decay: 0.1, volume: 0.72 },\n    hat: { wave: 'noise', decay: 0.02, volume: 0.16 },\n  },\n  patterns: stepPatterns,\n  order: STEP_ORDER,\n  loop: false,\n};\n/** The Step song from a bar onward: after a pause the count-in restarts at the current bar. */\nexport function stepSongFrom(bar, lastBar = STEP_ORDER.length) {\n  return { ...STEP_SONG, order: STEP_ORDER.slice(Math.max(0, bar), lastBar) };\n}\n\n/** Lagoon Games: staccato ukulele feel, 120 BPM. */\nexport const LAGOON_SONG = {\n  bpm: 120,\n  tracks: {\n    uke1: { wave: 'triangle', decay: 0.09, volume: 0.56 },\n    uke2: { wave: 'triangle', decay: 0.09, volume: 0.46 },\n    tune: { wave: 'square', duty: 0.5, decay: 0.12, volume: 0.36 },\n    bass: { wave: 'sine', decay: 0.2, volume: 0.66 },\n    tick: { wave: 'noise', decay: 0.015, volume: 0.14 },\n  },\n  patterns: (() => {\n    const tick = 'C8 . . C8 . . C8 . C8 . . C8 . . C8 .';\n    const uke = (a, b) => ({ uke1: `${a} . ${a} ${a} . ${a} . ${a} ${a} . ${a} ${a} . ${a} . ${a}`, uke2: `${b} . ${b} ${b} . ${b} . ${b} ${b} . ${b} ${b} . ${b} . ${b}` });\n    return {\n      a: { ...uke('G4', 'C5'), tune: 'E5 . . . G5 . . E5 . . D5 . C5 . . .', bass: 'C3 . . . G2 . . . C3 . . . G2 . . .', tick },\n      b: { ...uke('A4', 'C5'), tune: 'A5 . . . G5 . . E5 . . G5 . . . . .', bass: 'F2 . . . C3 . . . F2 . . . C3 . . .', tick },\n      c: { ...uke('G4', 'B4'), tune: 'D5 . . . E5 . . F5 . . E5 . D5 . . .', bass: 'G2 . . . D3 . . . G2 . . . D3 . . .', tick },\n      d: { ...uke('G4', 'C5'), tune: 'C5 . E5 . G5 . E5 . C5 . . . . . . .', bass: 'C3 . . . G2 . . . C3 . G2 . C3 . . .', tick },\n    };\n  })(),\n  order: ['a', 'b', 'c', 'd', 'a', 'b', 'c', 'd'],\n};\n\n/** Island Jog: steady, cheerful, 112 BPM. */\nexport const JOG_SONG = {\n  bpm: 112,\n  tracks: {\n    lead: { wave: 'triangle', decay: 0.2, volume: 0.6 },\n    keys: { wave: 'square', duty: 0.125, decay: 0.1, volume: 0.32 },\n    bass: { wave: 'triangle', decay: 0.2, volume: 0.72 },\n    kick: { wave: 'sine', freq: 90, freqEnd: 45, decay: 0.09, volume: 0.6 },\n    hat: { wave: 'noise', decay: 0.02, volume: 0.14 },\n  },\n  patterns: (() => {\n    const kick = 'C2 . . . . . . . C2 . . . . . . .';\n    const hat = 'C8 . C8 . C8 . C8 . C8 . C8 . C8 . C8 .';\n    return {\n      a: { lead: 'B4 . . D5 . . G5 . . . F#5 . E5 . D5 .', keys: 'G4 . B4 . G4 . B4 . G4 . B4 . G4 . B4 .', bass: 'G2 . . . G2 . . . D3 . . . D3 . . .', kick, hat },\n      b: { lead: 'C5 . . E5 . . A5 . . . G5 . F#5 . E5 .', keys: 'A4 . C5 . A4 . C5 . A4 . C5 . A4 . C5 .', bass: 'C3 . . . C3 . . . G2 . . . G2 . . .', kick, hat },\n      c: { lead: 'D5 . . G5 . . B5 . . . A5 . G5 . E5 .', keys: 'B4 . D5 . B4 . D5 . C5 . E5 . C5 . E5 .', bass: 'E2 . . . E2 . . . C3 . . . C3 . . .', kick, hat },\n      d: { lead: 'D5 . . . E5 . F#5 . G5 . . . . . . .', keys: 'A4 . D5 . A4 . D5 . B4 . D5 . B4 . D5 .', bass: 'D3 . . . D3 . . . G2 . . . G2 . G2 .', kick, hat },\n    };\n  })(),\n  order: ['a', 'b', 'c', 'd', 'a', 'b', 'c', 'd'],\n};\n\n/** Evening Report: music box, 70 BPM. */\nexport const REPORT_SONG = {\n  bpm: 70,\n  tracks: {\n    box: { wave: 'sine', decay: 0.7, volume: 0.66 },\n    box2: { wave: 'triangle', decay: 0.5, volume: 0.45 },\n    low: { wave: 'sine', decay: 1.1, volume: 0.48 },\n  },\n  patterns: {\n    a: { box: 'E6 . . . G5 . . . C6 . . . B5 . A5 .', box2: 'C5 . E5 . G5 . E5 . A4 . C5 . E5 . C5 .', low: 'C3 . . . . . . . A2 . . . . . . .' },\n    b: { box: 'D6 . . . F5 . . . B5 . . . A5 . G5 .', box2: 'D5 . F5 . A5 . F5 . G4 . B4 . D5 . B4 .', low: 'D3 . . . . . . . G2 . . . . . . .' },\n    c: { box: 'C6 . E6 . G6 . . . F6 . E6 . D6 . . .', box2: 'E5 . G5 . C6 . G5 . F5 . A5 . F5 . D5 .', low: 'C3 . . . . . . . F2 . . . . . . .' },\n    d: { box: 'C6 . . . . . . . . . . . . . . .', box2: 'E5 . G5 . C6 . . . . . . . . . . .', low: 'C3 . . . . . . . . . . . . . . .' },\n  },\n  order: ['a', 'b', 'a', 'c', 'a', 'b', 'c', 'd'],\n};\n\n/** The Long Stand: near silence, then one swelling chord line at t = 75. 48 BPM: 5 s a bar. */\nexport const STAND_SONG = {\n  bpm: 48,\n  tracks: {\n    drone: { wave: 'sine', attack: 2, decay: 3, volume: 0.5 },\n    swell1: { wave: 'triangle', attack: 3, sustain: 1, decay: 3, volume: 0.62 },\n    swell2: { wave: 'triangle', attack: 3, sustain: 1, decay: 3, volume: 0.5 },\n    swell3: { wave: 'sine', attack: 3, sustain: 1, decay: 3, volume: 0.56 },\n  },\n  patterns: {\n    hush: { drone: `D2 ${rest(15)}`, swell1: rest(), swell2: rest(), swell3: rest() },\n    quiet: { drone: rest(), swell1: rest(), swell2: rest(), swell3: rest() },\n    swellA: { drone: `D2 ${rest(15)}`, swell1: `A4 ${rest(15)}`, swell2: `D5 ${rest(15)}`, swell3: `F#5 ${rest(15)}` },\n    swellB: { drone: `G2 ${rest(15)}`, swell1: `B4 ${rest(15)}`, swell2: `D5 ${rest(15)}`, swell3: `G5 ${rest(15)}` },\n    swellC: { drone: `D2 ${rest(15)}`, swell1: `A4 ${rest(15)}`, swell2: `F#5 ${rest(15)}`, swell3: `D6 ${rest(15)}` },\n  },\n  order: ['hush', 'quiet', 'hush', 'quiet', 'quiet', 'hush', 'quiet', 'quiet', 'hush', 'quiet', 'quiet', 'hush', 'quiet', 'quiet', 'quiet', 'swellA', 'swellB', 'swellC'],\n  loop: false,\n};\n\n/** Ending and credits: the bossa, warmer, as a music box. */\nexport const CREDITS_SONG = { ...TITLE_SONG, bpm: 84, tracks: { ...TITLE_SONG.tracks, pluck: { wave: 'sine', decay: 0.6, volume: 0.66 } } };\n\nexport const SONGS = {\n  title: TITLE_SONG, hold: HOLD_SONG, rep: REP_SONG, hoop: HOOP_SONG, step: STEP_SONG,\n  lagoon: LAGOON_SONG, jog: JOG_SONG, report: REPORT_SONG, stand: STAND_SONG, credits: CREDITS_SONG,\n};\nexport const SONG_LABELS = {\n  title: 'Waiting Room', hold: 'Holding Still', rep: 'The Rep Shed', hoop: 'Beat Beach', step: 'Step Class',\n  lagoon: 'Lagoon Games', jog: 'Island Jog', report: 'Evening Report', stand: 'The Long Stand', credits: 'Bring Your Knees',\n};\nEOF\ncat > src/data/classmates.js <<'EOF'\n// The cast: names, looks and how well they score.\nexport const SPEAKERS = {\n  ounce: { name: 'Ounce', color: 'teal' },\n  coach: { name: 'Coach Plumb', color: 'teal' },\n  marguerite: { name: 'Marguerite', color: 'plum' },\n  dennis: { name: 'Dennis', color: 'orange' },\n  june: { name: 'June', color: 'blue' },\n  kevin: { name: 'Kevin', color: 'slate' },\n  narrator: { name: '', color: 'teal' },\n};\n\nexport const LOOKS = {\n  coach: { skin: 'sand', top: 'cyan', bottom: 'cyan', shoe: 'white', hair: 'mist', bun: true, long: true },\n  marguerite: { skin: 'sand', top: 'plum', bottom: 'white', shoe: 'white', hair: 'white', bun: true, long: true },\n  dennis: { skin: 'orange', top: 'lime', bottom: 'navy', shoe: 'slate', hair: 'slate', headband: 'orange' },\n  june: { skin: 'sand', top: 'red', bottom: 'ink', shoe: 'white', hair: 'ink', long: true },\n};\n\n/** Six starting avatars. */\nexport const PRESET_LOOKS = [\n  { skin: 'sand', top: 'white', bottom: 'sky', shoe: 'white', hair: 'ink', headband: 'red' },\n  { skin: 'orange', top: 'cyan', bottom: 'navy', shoe: 'white', hair: 'ink', hairStyle: 'short' },\n  { skin: 'red', top: 'sand', bottom: 'teal', shoe: 'slate', hair: 'ink', bun: true, long: true },\n  { skin: 'plum', top: 'lime', bottom: 'slate', shoe: 'white', hair: 'ink', hairStyle: 'tall' },\n  { skin: 'sand', top: 'orange', bottom: 'white', shoe: 'navy', hair: 'red', hairStyle: 'side' },\n  { skin: 'orange', top: 'plum', bottom: 'mist', shoe: 'white', hair: 'mist', headband: 'cyan', long: true },\n];\nexport const SKINS = ['sand', 'orange', 'red', 'plum'];\nexport const HAIR_STYLES = ['cap', 'short', 'bun', 'tall', 'side', 'bald'];\nexport const HAIR_COLORS = ['ink', 'slate', 'mist', 'white', 'red', 'orange', 'sand', 'blue'];\nexport const TOP_COLORS = ['white', 'cyan', 'sky', 'lime', 'orange', 'red', 'plum', 'sand', 'navy'];\nexport const BOTTOM_COLORS = ['sky', 'navy', 'teal', 'slate', 'white', 'mist', 'ink', 'plum'];\nexport const HEADBANDS = [null, 'red', 'cyan', 'lime', 'sand', 'white'];\n\n/** Reference skill of each classmate when they share your mats. */\nexport const CLASSMATE_SKILL = { dennis: 'sloppy', june: 'good', marguerite: 'expert' };\nEOF\necho ok","description":"Write voice, SFX, songs and classmate data modules","timeout":30000}}}
