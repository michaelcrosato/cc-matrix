g anything.'];\")])\ns=open('src/data/activities.js').read()\nassert \"You are a tree. A tree does not check its phone.\" in s\n\n# Hub: classmates talk when you walk past\nsub('src/scenes/hub.js',[\n(\"import { HAMMOCK_LINES, IDLE_BARKS, ISLAND_BARKS, STATION_REMARKS, WEEK2_LINES } from '../data/lines.js';\",\"import { CLASSMATE_BARKS, HAMMOCK_LINES, IDLE_BARKS, ISLAND_BARKS, STATION_REMARKS, WEEK2_LINES } from '../data/lines.js';\"),\n(\"\"\"    if (!App.stack.open && !this.attractMode) this.islandBarks(dt);\"\"\",\"\"\"    if (!App.stack.open && !this.attractMode) { this.islandBarks(dt); this.classmateBarks(dt); }\"\"\"),\n(\"\"\"  islandBarks(dt) {\"\"\",\"\"\"  /** Walk past a classmate and they will tell you something. Not too often. */\n  classmateBarks(dt) {\n    this.chatT = (this.chatT ?? 2) - dt;\n    if (this.chatT > 0 || this.bark.active) return;\n    for (const [who, l] of Object.entries(this.locals)) {\n      if (Math.hypot(this.feet.x - l.at.x, this.feet.z - l.at.z) < 2.4) {\n        this.chatT = 14;\n        this.barkT = Math.max(this.barkT, 8);\n        App.say(who, this.cosmetic.pick(CLASSMATE_BARKS[who]));\n        return;\n      }\n    }\n  }\n\n  islandBarks(dt) {\"\"\"),\n])\n\n# ---------------- PLAN 16's files: portraits, boot, card\ns=open('src/ui/dialogue.js').read()\nm=re.search(r\"const MOOD_ANGLE = .*?\\n\\nexport function drawOuncePortrait\\(.*?\\n}\\n\", s, re.S)\nportrait=m.group(0)\ns=s.replace(portrait,'')\ns=s.replace(\"import { disc, line, panel } from './widgets.js';\",\"import { panel } from './widgets.js';\\nimport { drawOuncePortrait } from '../art/portraits.js';\")\nopen('src/ui/dialogue.js','w').write(s)\nopen('src/art/portraits.js','w').write(\"// Ounce's small dial portrait, with a needle for her mood.\\nimport { disc, line } from '../ui/widgets.js';\\n\\n\"+portrait)\n\nopen('src/scenes/boot.js','w').write(\"\"\"// What the page starts on: the game's own title, or in an AI Hub session the round itself.\nimport { makeScen