{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JUunuyw6WDcthnpTJgWcGH","type":"tool_result","content":"1\t// Lane staging: up to 4 mats in a row, each with its own driver (local, bot or ghost).\n2\timport { App } from '../../app.js';\n3\timport { BotDriver, LocalDriver } from '../../core/drivers.js';\n4\timport { makeAvatar } from '../../art/avatar.js';\n5\timport { place } from '../../art/props.js';\n6\timport { CLASSMATE_SKILL, LOOKS, PRESET_LOOKS } from '../../data/classmates.js';\n7\timport { ActivityScene } from './base.js';\n8\timport { Lane } from './events.js';\n9\timport { matsFor } from '../sets.js';\n10\timport { topRow } from '../../ui/activity-hud.js';\n11\t\n12\tconst PAIRS = [['june', 'dennis'], ['marguerite', 'dennis'], ['june', 'marguerite'], ['dennis', 'marguerite']];\n13\tconst SEAT_NAMES = { june: 'June', dennis: 'Dennis', marguerite: 'Marguerite' };\n14\t\n15\t/** Mats and avatars. specs: [{ name, who, look, driver, isPlayer, isLocal, color }] */\n16\texport async function buildLanes(ctx, specs, { rand, mat = 'yoga-mat', matOpts = {}, xs = null, z = 0.8, yaw = 0 } = {}) {\n17\t  const positions = xs ?? matsFor(specs.length);\n18\t  const lanes = [];\n19\t  for (let i = 0; i < specs.length; i++) {\n20\t    const s = specs[i];\n21\t    const x = positions[i];\n22\t    const lane = new Lane({ index: i, x, z, rand, ...s });\n23\t    if (mat) lane.mat = place(ctx, mat, { at: [x, 0, z], palette: s.matColor && mat === 'yoga-mat' ? { mat: s.matColor } : undefined, shadow: false, ...matOpts });\n24\t    lane.avatar = await makeAvatar(ctx, s.look ?? PRESET_LOOKS[i % PRESET_LOOKS.length], { at: [x, mat === 'step-platform' ? 0.28 : mat ? 0.05 : 0, z], yaw });\n25\t    lanes.push(lane);\n26\t  }\n27\t  return lanes;\n28\t}\n29\t\n30\t/** You on the centre mat, two classmates as bots. */\n31\texport function soloSpecs(player, botRand, pairIndex = 0) {\n32\t  const [a, b] = PAIRS[pairIndex % PAIRS.length];\n33\t  const bot = (who) => ({ name: SEAT_NAMES[who], who, look: LOOKS[who], driver: new BotDriver(CLASSMATE_SKILL[who], botRand), color: 'slate', matColor: who === 'june' ? 'plum' : who === 'dennis' ? 'lime' : 'mist' });\n34\t  return [bot(a), { name: player.name, look: player.look, driver: new LocalDriver(), isPlayer: true, isLocal: true, color: 'red', matColor: 'sky' }, bot(b)];\n35\t}\n36\t\n37\texport function playerInfo() {\n38\t  const slot = App.slot;\n39\t  return { name: slot?.name ?? 'You', look: withWardrobe(slot?.look ?? PRESET_LOOKS[0], slot) };\n40\t}\n41\t\n42\t/** A look plus whatever the jar has given and you have chosen to wear. */\n43\texport function withWardrobe(look, slot) {\n44\t  if (!slot) return look;\n45\t  const worn = slot.worn ?? slot.wardrobe ?? [];\n46\t  const out = { ...look };\n47\t  for (const id of worn) {\n48\t    if (id === 'band2') out.band2 = 'cyan';\n49\t    else if (id === 'cape') out.cape = true;\n50\t    else if (id === 'wrist') out.wrist = true;\n51\t    else if (id === 'visor') out.visor = true;\n52\t    else if (id === 'whistle') out.whistle = true;\n53\t    else if (id === 'goldShoes') out.goldShoes = true;\n54\t  }\n55\t  return out;\n56\t}\n57\t\n58\tconst LANE_ORDER = { tree: 0, heron: 1, warrior: 2, chair: 3, fold: 0, plank: 1, squats: 0, lunges: 2, press: 1, hoop: 2, step: 3 };\n59\t\n60\texport class LaneActivity extends ActivityScene {\n61\t  centreDial = true;\n62\t\n63\t  async stage(ctx) {\n64\t    await this.dress(ctx);\n65\t    const rand = () => this.botRand.next();\n66\t    const specs = this.laneSpecs(rand);\n67\t    this.lanes = await buildLanes(ctx, specs, { rand, ...this.laneOptions() });\n68\t    this.playerLane = this.lanes.find((l) => l.isPlayer);\n69\t    this.event = this.makeEvent(this.lanes, this.rng, this.hardData);\n70\t    this.event.begin();\n71\t    this.afterLanes?.(ctx);\n72\t  }\n73\t\n74\t  laneOptions() { return {}; }\n75\t\n76\t  laneSpecs(rand) {\n77\t    return soloSpecs(playerInfo(), rand, LANE_ORDER[this.activity] ?? 0);\n78\t  }\n79\t\n80\t  async dress() {}\n81\t  makeEvent() { throw new Error('makeEvent'); }\n82\t\n83\t  begin() {\n84\t    this.event.begin();\n85\t    this.eventT = 0;\n86\t  }\n87\t\n88\t  stepPlay(ctx, dt, scoring) {\n89\t    this.eventT += dt;\n90\t    this.event.step(ctx, dt, this.eventT, scoring);\n91\t  }\n92\t\n93\t  /** During the count, people on poses are already wobbling. Nothing else has started: no hoop drops before Go. */\n94\t  countStep(ctx, dt) { if (this.event.kind === 'pose') this.event.step(ctx, dt, 0, false); }\n95\t  idleStep(ctx, dt) { this.eventT += dt; this.event.step(ctx, dt, this.eventT, false); }\n96\t\n97\t  playLength() { return this.event.duration; }\n98\t  isOver() { return (this.eventT ?? 0) >= this.event.duration; }\n99\t\n100\t  visual(ctx, dt) {\n101\t    this.event.visual(ctx, dt, this.eventT ?? 0);\n102\t  }\n103\t\n104\t  drawGame(ctx) {\n105\t    if (this.phase === 'intro') return;\n106\t    this.event.draw(ctx, this.eventT ?? 0);\n107\t  }\n108\t\n109\t  drawGameHud(ctx) {\n110\t    const left = Math.max(0, this.event.duration - (this.eventT ?? 0));\n111\t    topRow(ctx.hud, `${Math.ceil(left)}s`, this.scoreText());\n112\t  }\n113\t\n114\t  scoreText() { return `${Math.round(this.event.scoreOf(this.playerLane))}${this.def.unit === '%' ? '%' : ''}`; }\n115\t\n116\t  result() {\n117\t    const score = this.event.scoreOf(this.playerLane);\n118\t    const round = Math.round(score);\n119\t    return { score: round, seconds: this.totalPlay, display: `${round}${this.def.unit === '%' ? '%' : ` ${this.def.unit}`}`, classmates: this.lanes.filter((l) => l.who).map((l) => ({ who: l.who, name: l.name, score: Math.round(this.event.scoreOf(l)) })) };\n120\t  }\n121\t\n122\t  onOutroStart() {\n123\t    if (this.playerLane) { this.playerLane.frozenClip = true; this.playerLane.avatar?.play('Bow', { once: true, fade: 0.3 }); }\n124\t    this.coach?.play('CoachStand', { fade: 0.4 });\n125\t  }\n126\t}\n127\t"}]},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"52408a20-eb7b-44de-b1e4-1b81ecc3b044","timestamp":"2026-11-05T09:34:53.677Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741/src/scenes/activity/lanes.js","content":"// Lane staging: up to 4 mats in a row, each with its own driver (local, bot or ghost).\nimport { App } from '../../app.js';\nimport { BotDriver, LocalDriver } from '../../core/drivers.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { place } from '../../art/props.js';\nimport { CLASSMATE_SKILL, LOOKS, PRESET_LOOKS } from '../../data/classmates.js';\nimport { ActivityScene } from './base.js';\nimport { Lane } from './events.js';\nimport { matsFor } from '../sets.js';\nimport { topRow } from '../../ui/activity-hud.js';\n\nconst PAIRS = [['june', 'dennis'], ['marguerite', 'dennis'], ['june', 'marguerite'], ['dennis', 'marguerite']];\nconst SEAT_NAMES = { june: 'June', dennis: 'Dennis', marguerite: 'Marguerite' };\n\n/** Mats and avatars. specs: [{ name, who, look, driver, isPlayer, isLocal, color }] */\nexport async function buildLanes(ctx, specs, { rand, mat = 'yoga-mat', matOpts = {}, xs = null, z = 0.8, yaw = 0 } = {}) {\n  const positions = xs ?? matsFor(specs.length);\n  const lanes = [];\n  for (let i = 0; i < specs.length; i++) {\n    const s = specs[i];\n    const x = positions[i];\n    const lane = new Lane({ index: i, x, z, rand, ...s });\n    if (mat) lane.mat = place(ctx, mat, { at: [x, 0, z], palette: s.matColor && mat === 'yoga-mat' ? { mat: s.matColor } : undefined, shadow: false, ...matOpts });\n    lane.avatar = await makeAvatar(ctx, s.look ?? PRESET_LOOKS[i % PRESET_LOOKS.length], { at: [x, mat === 'step-platform' ? 0.28 : mat ? 0.05 : 0, z], yaw });\n    lanes.push(lane);\n  }\n  return lanes;\n}\n\n/** You on the centre mat, two classmates as bots. */\nexport function soloSpecs(player, botRand, pairIndex = 0) {\n  const [a, b] = PAIRS[pairIndex % PAIRS.length];\n  const bot = (who) => ({ name: SEAT_NAMES[who], who, look: LOOKS[who], driver: new BotDriver(CLASSMATE_SKILL[who], botRand), color: 'slate', matColor: who === 'june' ? 'plum' : who === 'dennis' ? 'lime' : 'mist' });\n  return [bot(a), { name: player.name, look: player.look, driver: new LocalDriver(), isPlayer: true, isLocal: true, color: 'red', matColor: 'sky' }, bot(b)];\n}\n\nexport function playerInfo() {\n  const slot = App.slot;\n  return { name: slot?.name ?? 'You', look: withWardrobe(slot?.look ?? PRESET_LOOKS[0], slot) };\n}\n\n/** A look plus whatever the jar has given and you have chosen to wear. */\nexport function withWardrobe(look, slot) {\n  if (!slot) return look;\n  const worn = slot.worn ?? slot.wardrobe ?? [];\n  const out = { ...look };\n  for (const id of worn) {\n    if (id === 'band2') out.band2 = 'cyan';\n    else if (id === 'cape') out.cape = true;\n    else if (id === 'wrist') out.wrist = true;\n    else if (id === 'visor') out.visor = true;\n    else if (id === 'whistle') out.whistle = true;\n    else if (id === 'goldShoes') out.goldShoes = true;\n  }\n  return out;\n}\n\nconst LANE_ORDER = { tree: 0, heron: 1, warrior: 2, chair: 3, fold: 0, plank: 1, squats: 0, lunges: 2, press: 1, hoop: 2, step: 3 };\n\nexport class LaneActivity extends ActivityScene {\n  centreDial = true;\n\n  async stage(ctx) {\n    await this.dress(ctx);\n    const rand = () => this.botRand.next();\n    const specs = this.laneSpecs(rand);\n    this.lanes = await buildLanes(ctx, specs, { rand, ...this.laneOptions() });\n    this.playerLane = this.lanes.find((l) => l.isPlayer);\n    this.event = this.makeEvent(this.lanes, this.rng, this.hardData);\n    this.event.begin();\n    this.afterLanes?.(ctx);\n  }\n\n  laneOptions() { return {}; }\n\n  laneSpecs(rand) {\n    return soloSpecs(playerInfo(), rand, LANE_ORDER[this.activity] ?? 0);\n  }\n\n  async dress() {}\n  makeEvent() { throw new Error('makeEvent'); }\n\n  begin() {\n    this.event.begin();\n    this.eventT = 0;\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    this.eventT += dt;\n    this.event.step(ctx, dt, this.eventT, scoring);\n  }\n\n  /** During the count, people on poses are already wobbling. Nothing else has started: no hoop drops before Go. */\n  countStep(ctx, dt) { if (this.event.kind === 'pose') this.event.step(ctx, dt, 0, false); }\n  idleStep(ctx, dt) { this.eventT += dt; this.event.step(ctx, dt, this.eventT, false); }\n\n  playLength() { return this.event.duration; }\n  isOver() { return (this.eventT ?? 0) >= this.event.duration; }\n\n  visual(ctx, dt) {\n    this.event.visual(ctx, dt, this.eventT ?? 0);\n  }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    this.event.draw(ctx, this.eventT ?? 0);\n  }\n\n  drawGameHud(ctx) {\n    const left = Math.max(0, this.event.duration - (this.eventT ?? 0));\n    topRow(ctx.hud, `${Math.ceil(left)}s`, this.scoreText());\n  }\n\n  scoreText() { return `${Math.round(this.event.scoreOf(this.playerLane))}${this.def.unit === '%' ? '%' : ''}`; }\n\n  result() {\n    const score = this.event.scoreOf(this.playerLane);\n    const round = Math.round(score);\n    return { score: round, seconds: this.totalPlay, display: `${round}${this.def.unit === '%' ? '%' : ` ${this.def.unit}`}`, classmates: this.lanes.filter((l) => l.who).map((l) => ({ who: l.who, name: l.name, score: Math.round(this.event.scoreOf(l)) })) };\n  }\n\n  onOutroStart() {\n    if (this.playerLane) { this.playerLane.frozenClip = true; this.playerLane.avatar?.play('Bow', { once: true, fade: 0.3 }); }\n    this.coach?.play('CoachStand', { fade: 0.4 });\n  }\n}\n","numLines":127,"startLine":1,"totalLines":127}},"tool_result_meta":[{"id":"toolu_01JUunuyw6WDcthnpTJgWcGH","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjYxkqNyCKBRGhp9U4qd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JrMQa39WHh646kjJxK2gWY","name":"Read","input":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741/src/ui/menu.js"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":26264,"cache_read_input_tokens":84052,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":26264},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"968f8087-c1cf-40dc-a79c-51ecfc7e2de2","timestamp":"2026-11-05T09:34:55.811Z","request_id":"req_011CgjYxkY2mdMtCHLfBpMnA","wire_tool_inputs":{"toolu_01JrMQa39WHh646kjJxK2gWY":{"file_path":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741/src/ui/menu.js"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JrMQa39WHh646kjJxK2gWY","type":"tool_result","content":"1\t// The one menu. D-pad, stick (with repeat), arrows, WASD, hover, click, wheel, slider drag.\n2\timport { App } from '../app.js';\n3\timport { BACK, CONFIRM, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP } from '../core/actions.js';\n4\timport { ABOVE_PROMPTS, layout } from './layout.js';\n5\timport { say, sayCentered, sayRight, textWidth } from './font.js';\n6\timport { bar, panel, SAFE, starRow, starRowWidth } from './widgets.js';\n7\t\n8\tconst REPEAT_FIRST = 0.34;\n9\tconst REPEAT_NEXT = 0.11;\n10\t\n11\texport class NavRepeat {\n12\t  dir = 0; timer = 0;\n13\t  /** dirNow -1/0/1: returns a step when it should fire. */\n14\t  step(dirNow, dt) {\n15\t    if (dirNow === 0) { this.dir = 0; this.timer = 0; return 0; }\n16\t    if (dirNow !== this.dir) { this.dir = dirNow; this.timer = REPEAT_FIRST; return dirNow; }\n17\t    this.timer -= dt;\n18\t    if (this.timer <= 0) { this.timer = REPEAT_NEXT; return dirNow; }\n19\t    return 0;\n20\t  }\n21\t}\n22\t\n23\t/** Direction helpers shared by menus, the name grid and the Locker Room. */\n24\texport function navY(input) {\n25\t  const stick = input.padAxis.y;\n26\t  if (input.anyDown(MENU_UP) || stick > 0.5) return -1;\n27\t  if (input.anyDown(MENU_DOWN) || stick < -0.5) return 1;\n28\t  return 0;\n29\t}\n30\texport function navX(input) {\n31\t  const stick = input.padAxis.x;\n32\t  if (input.anyDown(MENU_LEFT) || stick < -0.5) return -1;\n33\t  if (input.anyDown(MENU_RIGHT) || stick > 0.5) return 1;\n34\t  return 0;\n35\t}\n36\t\n37\texport const pressed = (input, codes) => input.wasPressed(...codes);\n38\tconst CONFIRM_NO_E = CONFIRM.filter((c) => c !== 'KeyE');\n39\t\n40\texport class Menu {\n41\t  focus = 0;\n42\t  top = 0;\n43\t  rects = [];\n44\t  vert = new NavRepeat();\n45\t  horz = new NavRepeat();\n46\t\n47\t  /**\n48\t   * items: { label, action, disabled, value() , adjust(dir), slider: {get, set, min, max}, right(), locked, id }\n49\t   * opts: { y, width, scale, rowH, maxRows, onBack, align, panel, tabbed }\n50\t   */\n51\t  constructor(items, opts = {}) {\n52\t    this.items = items;\n53\t    this.o = { scale: 2, maxRows: 8, panel: true, align: 'left', ...opts };\n54\t    this.focus = this.firstEnabled();\n55\t  }\n56\t\n57\t  firstEnabled() {\n58\t    const i = this.items.findIndex((it) => !it.disabled);\n59\t    return i < 0 ? 0 : i;\n60\t  }\n61\t\n62\t  setItems(items) {\n63\t    this.items = items;\n64\t    this.focus = Math.min(this.focus, Math.max(0, items.length - 1));\n65\t    this.keepInView();\n66\t  }\n67\t\n68\t  label(item) { return typeof item.label === 'function' ? item.label() : item.label; }\n69\t\n70\t  get rowH() { return this.o.rowH ?? (this.o.scale >= 2 ? 22 : 14); }\n71\t\n72\t  move(dir) {\n73\t    const n = this.items.length;\n74\t    if (!n) return;\n75\t    let i = this.focus;\n76\t    for (let k = 0; k < n; k++) {\n77\t      i = (i + dir + n) % n;\n78\t      if (!this.items[i].disabled || this.items[i].focusable) break;\n79\t    }\n80\t    if (i !== this.focus) { this.focus = i; App.sfx('menuMove'); }\n81\t    this.keepInView();\n82\t  }\n83\t\n84\t  keepInView() {\n85\t    const max = this.visibleRows();\n86\t    if (this.focus < this.top) this.top = this.focus;\n87\t    if (this.focus >= this.top + max) this.top = this.focus - max + 1;\n88\t    this.top = Math.max(0, Math.min(this.top, Math.max(0, this.items.length - max)));\n89\t  }\n90\t\n91\t  visibleRows() {\n92\t    const hud = App.ctx?.hud;\n93\t    const h = hud ? hud.height : 270;\n94\t    const avail = h - (this.o.y ?? 56) - ABOVE_PROMPTS - 8;\n95\t    return Math.max(1, Math.min(this.o.maxRows, Math.floor(avail / this.rowH)));\n96\t  }\n97\t\n98\t  activate(item) {\n99\t    if (!item || item.disabled) { App.sfx('menuBack'); return; }\n100\t    App.sfx(item.sound ?? 'menuConfirm');\n101\t    item.action?.();\n102\t  }\n103\t\n104\t  update(ctx, dt) {\n105\t    const { input } = ctx;\n106\t    const uiDt = dt || 1 / 60;\n107\t    const dy = this.vert.step(navY(input), uiDt);\n108\t    if (dy) this.move(dy);\n109\t    const dx = this.horz.step(navX(input), uiDt);\n110\t    const item = this.items[this.focus];\n111\t    if (dx && item) {\n112\t      if (item.adjust) { item.adjust(dx); App.sfx('menuMove'); } else if (this.o.onLeftRight) this.o.onLeftRight(dx);\n113\t    }\n114\t    if (pressed(input, this.o.tabbed ? CONFIRM_NO_E : CONFIRM)) this.activate(item);\n115\t    if (pressed(input, BACK) || input.wasPressed('MouseRight')) { if (this.o.onBack) { App.sfx('menuBack'); this.o.onBack(); return; } }\n116\t\n117\t    // mouse\n118\t    const dev = App.device;\n119\t    const p = dev.pointerArt(ctx);\n120\t    const inside = (r) => p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;\n121\t    if (dev.moved > 0) {\n122\t      for (const r of this.rects) if (inside(r) && !this.items[r.i].disabled && this.focus !== r.i) { this.focus = r.i; App.sfx('menuMove', { volume: 0.5 }); }\n123\t    }\n124\t    if (input.wheel) {\n125\t      this.top = Math.max(0, Math.min(this.top + Math.sign(input.wheel), Math.max(0, this.items.length - this.visibleRows())));\n126\t      if (this.focus < this.top) this.focus = this.top;\n127\t      if (this.focus >= this.top + this.visibleRows()) this.focus = this.top + this.visibleRows() - 1;\n128\t    }\n129\t    if (input.wasPressed('MouseLeft')) {\n130\t      for (const r of this.rects) if (inside(r)) { this.focus = r.i; if (!this.items[r.i].slider) this.activate(this.items[r.i]); break; }\n131\t    }\n132\t    if (input.isDown('MouseLeft')) {\n133\t      for (const r of this.rects) {\n134\t        const it = this.items[r.i];\n135\t        if (it.slider && r.sx !== undefined && inside(r)) {\n136\t          const f = Math.max(0, Math.min(1, (p.x - r.sx) / r.sw));\n137\t          it.slider.set(it.slider.min + f * (it.slider.max - it.slider.min));\n138\t        }\n139\t      }\n140\t    }\n141\t  }\n142\t\n143\t  draw(ctx) {\n144\t    const { hud } = ctx;\n145\t    const scale = this.o.scale;\n146\t    const rowH = this.rowH;\n147\t    const rows = this.visibleRows();\n148\t    // The panel adds 4 px a side, and all of it stays inside the safe margin. o.x is the panel's left edge.\n149\t    const width = Math.min(this.o.width ?? 300, hud.width - SAFE * 2 - 8 - (this.o.x !== undefined ? this.o.x - SAFE : 0));\n150\t    const x = this.o.x !== undefined ? this.o.x + 4 : Math.round((hud.width - width) / 2);\n151\t    const y = this.o.y ?? 56;\n152\t    const shown = this.items.slice(this.top, this.top + rows);\n153\t    const totalH = shown.length * rowH;\n154\t    if (this.o.panel) panel(hud, x - 4, y - 4, width + 8, totalH + 6, { fill: 'night', border: 'ink', name: 'menu-panel' });\n155\t    this.rects = [];\n156\t    shown.forEach((item, k) => {\n157\t      const i = this.top + k;\n158\t      const ry = y + k * rowH;\n159\t      const focused = i === this.focus;\n160\t      const r = { i, x, y: ry, w: width, h: rowH - 2 };\n161\t      if (focused) hud.rect(x - 1, ry - 1, width + 2, rowH - 1, 'cyan');\n162\t      const color = item.disabled ? 'slate' : focused ? 'ink' : 'white';\n163\t      const shadow = focused ? false : 'ink';\n164\t      const ty = ry + Math.round((rowH - 2 - 9 * scale) / 2) + 1;\n165\t      let label = String(this.label(item));\n166\t      const right = item.value ? String(item.value()) : item.right ? String(item.right()) : '';\n167\t      const sliderW = item.slider ? Math.min(70, Math.round(width * 0.28)) : 0;\n168\t      const starsW = item.stars !== undefined ? starRowWidth(1) + 6 : 0;\n169\t      const room = width - 8 - (right ? textWidth(right, scale) + 8 : 0) - (sliderW ? sliderW + 6 : 0) - starsW;\n170\t      const maxChars = Math.max(1, Math.floor(room / (6 * scale)));\n171\t      if (label.length > maxChars) label = `${label.slice(0, Math.max(1, maxChars - 1))}.`;\n172\t      if (this.o.align === 'center' && !right) sayCentered(hud, x + width / 2, ty, label, { scale, color, shadow, name: 'menu-row' });\n173\t      else say(hud, x + 4, ty, label, { scale, color, shadow, name: 'menu-row' });\n174\t      if (right) sayRight(hud, x + width - 4, ty, right, { scale, color: focused ? 'ink' : (item.disabled ? 'slate' : 'sand'), shadow, name: 'menu-value' });\n175\t      if (item.slider) {\n176\t        const sx = x + width - 8 - (right ? textWidth(right, scale) + 6 : 0) - sliderW;\n177\t        const f = (item.slider.get() - item.slider.min) / (item.slider.max - item.slider.min);\n178\t        bar(hud, sx, ry + Math.round(rowH / 2) - 4, sliderW, 7, f, focused ? 'navy' : 'cyan', focused ? 'white' : 'ink', 'slider');\n179\t        r.sx = sx; r.sw = sliderW;\n180\t      }\n181\t      if (item.stars !== undefined) starRow(hud, x + width - 4 - (right ? textWidth(right, scale) + 6 : 0) - starRowWidth(1), ry + Math.round((rowH - 11) / 2), item.stars, 1);\n182\t      this.rects.push(r);\n183\t    });\n184\t    if (this.top > 0) sayCentered(hud, x + width / 2, y - 12, '^', { color: 'sand', name: 'menu-more' });\n185\t    if (this.top + rows < this.items.length) sayCentered(hud, x + width / 2, y + totalH + 3, 'v', { color: 'sand', name: 'menu-more' });\n186\t    layout.rec('menu', x - 4, y - 4, width + 8, totalH + 6);\n187\t  }\n188\t}\n189\t\n190\t"}]},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"c0e4792f-263a-4223-a2ba-6363bf49feef","timestamp":"2026-11-05T09:34:55.821Z","tool_use_result":{"type":"text","file":{"filePath":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741/src/ui/menu.js","content":"// The one menu. D-pad, stick (with repeat), arrows, WASD, hover, click, wheel, slider drag.\nimport { App } from '../app.js';\nimport { BACK, CONFIRM, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP } from '../core/actions.js';\nimport { ABOVE_PROMPTS, layout } from './layout.js';\nimport { say, sayCentered, sayRight, textWidth } from './font.js';\nimport { bar, panel, SAFE, starRow, starRowWidth } from './widgets.js';\n\nconst REPEAT_FIRST = 0.34;\nconst REPEAT_NEXT = 0.11;\n\nexport class NavRepeat {\n  dir = 0; timer = 0;\n  /** dirNow -1/0/1: returns a step when it should fire. */\n  step(dirNow, dt) {\n    if (dirNow === 0) { this.dir = 0; this.timer = 0; return 0; }\n    if (dirNow !== this.dir) { this.dir = dirNow; this.timer = REPEAT_FIRST; return dirNow; }\n    this.timer -= dt;\n    if (this.timer <= 0) { this.timer = REPEAT_NEXT; return dirNow; }\n    return 0;\n  }\n}\n\n/** Direction helpers shared by menus, the name grid and the Locker Room. */\nexport function navY(input) {\n  const stick = input.padAxis.y;\n  if (input.anyDown(MENU_UP) || stick > 0.5) return -1;\n  if (input.anyDown(MENU_DOWN) || stick < -0.5) return 1;\n  return 0;\n}\nexport function navX(input) {\n  const stick = input.padAxis.x;\n  if (input.anyDown(MENU_LEFT) || stick < -0.5) return -1;\n  if (input.anyDown(MENU_RIGHT) || stick > 0.5) return 1;\n  return 0;\n}\n\nexport const pressed = (input, codes) => input.wasPressed(...codes);\nconst CONFIRM_NO_E = CONFIRM.filter((c) => c !== 'KeyE');\n\nexport class Menu {\n  focus = 0;\n  top = 0;\n  rects = [];\n  vert = new NavRepeat();\n  horz = new NavRepeat();\n\n  /**\n   * items: { label, action, disabled, value() , adjust(dir), slider: {get, set, min, max}, right(), locked, id }\n   * opts: { y, width, scale, rowH, maxRows, onBack, align, panel, tabbed }\n   */\n  constructor(items, opts = {}) {\n    this.items = items;\n    this.o = { scale: 2, maxRows: 8, panel: true, align: 'left', ...opts };\n    this.focus = this.firstEnabled();\n  }\n\n  firstEnabled() {\n    const i = this.items.findIndex((it) => !it.disabled);\n    return i < 0 ? 0 : i;\n  }\n\n  setItems(items) {\n    this.items = items;\n    this.focus = Math.min(this.focus, Math.max(0, items.length - 1));\n    this.keepInView();\n  }\n\n  label(item) { return typeof item.label === 'function' ? item.label() : item.label; }\n\n  get rowH() { return this.o.rowH ?? (this.o.scale >= 2 ? 22 : 14); }\n\n  move(dir) {\n    const n = this.items.length;\n    if (!n) return;\n    let i = this.focus;\n    for (let k = 0; k < n; k++) {\n      i = (i + dir + n) % n;\n      if (!this.items[i].disabled || this.items[i].focusable) break;\n    }\n    if (i !== this.focus) { this.focus = i; App.sfx('menuMove'); }\n    this.keepInView();\n  }\n\n  keepInView() {\n    const max = this.visibleRows();\n    if (this.focus < this.top) this.top = this.focus;\n    if (this.focus >= this.top + max) this.top = this.focus - max + 1;\n    this.top = Math.max(0, Math.min(this.top, Math.max(0, this.items.length - max)));\n  }\n\n  visibleRows() {\n    const hud = App.ctx?.hud;\n    const h = hud ? hud.height : 270;\n    const avail = h - (this.o.y ?? 56) - ABOVE_PROMPTS - 8;\n    return Math.max(1, Math.min(this.o.maxRows, Math.floor(avail / this.rowH)));\n  }\n\n  activate(item) {\n    if (!item || item.disabled) { App.sfx('menuBack'); return; }\n    App.sfx(item.sound ?? 'menuConfirm');\n    item.action?.();\n  }\n\n  update(ctx, dt) {\n    const { input } = ctx;\n    const uiDt = dt || 1 / 60;\n    const dy = this.vert.step(navY(input), uiDt);\n    if (dy) this.move(dy);\n    const dx = this.horz.step(navX(input), uiDt);\n    const item = this.items[this.focus];\n    if (dx && item) {\n      if (item.adjust) { item.adjust(dx); App.sfx('menuMove'); } else if (this.o.onLeftRight) this.o.onLeftRight(dx);\n    }\n    if (pressed(input, this.o.tabbed ? CONFIRM_NO_E : CONFIRM)) this.activate(item);\n    if (pressed(input, BACK) || input.wasPressed('MouseRight')) { if (this.o.onBack) { App.sfx('menuBack'); this.o.onBack(); return; } }\n\n    // mouse\n    const dev = App.device;\n    const p = dev.pointerArt(ctx);\n    const inside = (r) => p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;\n    if (dev.moved > 0) {\n      for (const r of this.rects) if (inside(r) && !this.items[r.i].disabled && this.focus !== r.i) { this.focus = r.i; App.sfx('menuMove', { volume: 0.5 }); }\n    }\n    if (input.wheel) {\n      this.top = Math.max(0, Math.min(this.top + Math.sign(input.wheel), Math.max(0, this.items.length - this.visibleRows())));\n      if (this.focus < this.top) this.focus = this.top;\n      if (this.focus >= this.top + this.visibleRows()) this.focus = this.top + this.visibleRows() - 1;\n    }\n    if (input.wasPressed('MouseLeft')) {\n      for (const r of this.rects) if (inside(r)) { this.focus = r.i; if (!this.items[r.i].slider) this.activate(this.items[r.i]); break; }\n    }\n    if (input.isDown('MouseLeft')) {\n      for (const r of this.rects) {\n        const it = this.items[r.i];\n        if (it.slider && r.sx !== undefined && inside(r)) {\n          const f = Math.max(0, Math.min(1, (p.x - r.sx) / r.sw));\n          it.slider.set(it.slider.min + f * (it.slider.max - it.slider.min));\n        }\n      }\n    }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    const scale = this.o.scale;\n    const rowH = this.rowH;\n    const rows = this.visibleRows();\n    // The panel adds 4 px a side, and all of it stays inside the safe margin. o.x is the panel's left edge.\n    const width = Math.min(this.o.width ?? 300, hud.width - SAFE * 2 - 8 - (this.o.x !== undefined ? this.o.x - SAFE : 0));\n    const x = this.o.x !== undefined ? this.o.x + 4 : Math.round((hud.width - width) / 2);\n    const y = this.o.y ?? 56;\n    const shown = this.items.slice(this.top, this.top + rows);\n    const totalH = shown.length * rowH;\n    if (this.o.panel) panel(hud, x - 4, y - 4, width + 8, totalH + 6, { fill: 'night', border: 'ink', name: 'menu-panel' });\n    this.rects = [];\n    shown.forEach((item, k) => {\n      const i = this.top + k;\n      const ry = y + k * rowH;\n      const focused = i === this.focus;\n      const r = { i, x, y: ry, w: width, h: rowH - 2 };\n      if (focused) hud.rect(x - 1, ry - 1, width + 2, rowH - 1, 'cyan');\n      const color = item.disabled ? 'slate' : focused ? 'ink' : 'white';\n      const shadow = focused ? false : 'ink';\n      const ty = ry + Math.round((rowH - 2 - 9 * scale) / 2) + 1;\n      let label = String(this.label(item));\n      const right = item.value ? String(item.value()) : item.right ? String(item.right()) : '';\n      const sliderW = item.slider ? Math.min(70, Math.round(width * 0.28)) : 0;\n      const starsW = item.stars !== undefined ? starRowWidth(1) + 6 : 0;\n      const room = width - 8 - (right ? textWidth(right, scale) + 8 : 0) - (sliderW ? sliderW + 6 : 0) - starsW;\n      const maxChars = Math.max(1, Math.floor(room / (6 * scale)));\n      if (label.length > maxChars) label = `${label.slice(0, Math.max(1, maxChars - 1))}.`;\n      if (this.o.align === 'center' && !right) sayCentered(hud, x + width / 2, ty, label, { scale, color, shadow, name: 'menu-row' });\n      else say(hud, x + 4, ty, label, { scale, color, shadow, name: 'menu-row' });\n      if (right) sayRight(hud, x + width - 4, ty, right, { scale, color: focused ? 'ink' : (item.disabled ? 'slate' : 'sand'), shadow, name: 'menu-value' });\n      if (item.slider) {\n        const sx = x + width - 8 - (right ? textWidth(right, scale) + 6 : 0) - sliderW;\n        const f = (item.slider.get() - item.slider.min) / (item.slider.max - item.slider.min);\n        bar(hud, sx, ry + Math.round(rowH / 2) - 4, sliderW, 7, f, focused ? 'navy' : 'cyan', focused ? 'white' : 'ink', 'slider');\n        r.sx = sx; r.sw = sliderW;\n      }\n      if (item.stars !== undefined) starRow(hud, x + width - 4 - (right ? textWidth(right, scale) + 6 : 0) - starRowWidth(1), ry + Math.round((rowH - 11) / 2), item.stars, 1);\n      this.rects.push(r);\n    });\n    if (this.top > 0) sayCentered(hud, x + width / 2, y - 12, '^', { color: 'sand', name: 'menu-more' });\n    if (this.top + rows < this.items.length) sayCentered(hud, x + width / 2, y + totalH + 3, 'v', { color: 'sand', name: 'menu-more' });\n    layout.rec('menu', x - 4, y - 4, width + 8, totalH + 6);\n  }\n}\n\n","numLines":190,"startLine":1,"totalLines":190}},"tool_result_meta":[{"id":"toolu_01JrMQa39WHh646kjJxK2gWY","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
