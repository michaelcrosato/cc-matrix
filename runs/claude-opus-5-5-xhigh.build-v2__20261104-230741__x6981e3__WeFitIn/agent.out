{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjKM79kDC8L94te2PeFo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SYZD7Upe22QX6MwTeEghRq","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='src/ui/menu.js'; s=open(p).read()\ns=s.replace(\"import { bar, panel, SAFE } from './widgets.js';\",\"import { bar, panel, SAFE, starRow, starRowWidth } from './widgets.js';\")\ns=s.replace(\"\"\"      const sliderW = item.slider ? Math.min(70, Math.round(width * 0.28)) : 0;\n      const room = width - 8 - (right ? textWidth(right, scale) + 8 : 0) - (sliderW ? sliderW + 6 : 0);\"\"\",\"\"\"      const sliderW = item.slider ? Math.min(70, Math.round(width * 0.28)) : 0;\n      const starsW = item.stars !== undefined ? starRowWidth(1) + 6 : 0;\n      const room = width - 8 - (right ? textWidth(right, scale) + 8 : 0) - (sliderW ? sliderW + 6 : 0) - starsW;\"\"\")\ns=s.replace(\"\"\"      if (item.star !== undefined) item.star(hud, x + width - 44, ry + 2);\n\"\"\",\"\"\"      if (item.stars !== undefined) starRow(hud, x + width - 4 - (right ? textWidth(right, scale) + 6 : 0) - starRowWidth(1), ry + Math.round((rowH - 11) / 2), item.stars, 1);\n\"\"\")\nopen(p,'w').write(s)\np='src/scenes/base.js'; s=open(p).read()\ns=s.replace(\"\"\"    App.attach(ctx, this);\"\"\",\"\"\"    App.ensureInit(ctx.engine);\n    App.attach(ctx, this);\"\"\")\ns=s.replace(\"\"\"    if (!App.dev.hideHud) {\n      this.onDraw(ctx, dt);\n      App.stack.draw(ctx, dt);\n      if (!App.stack.open) this.bark.draw(ctx.hud);\n      this.drawPauseIcon(ctx);\n    }\"\"\",\"\"\"    if (!App.dev.hideHud) this.onDraw(ctx, dt);\n    App.stack.draw(ctx, dt);\n    if (!App.dev.hideHud) {\n      if (!App.stack.open) this.bark.draw(ctx.hud);\n      this.drawPauseIcon(ctx);\n    }\"\"\")\nopen(p,'w').write(s)\np='src/app.js'; s=open(p).read()\ns=s.replace(\"\"\"  init(engine, { storage = null, session = null } = {}) {\n    this.engine = engine;\n    this.session = session;\n    this.store = this.store ?? new Store(storage);\"\"\",\"\"\"  /** Set before the engine starts: { session, storage, touchOnly }. */\n  boot({ session = null, storage = null, touchOnly = false } = {}) {\n    this.session = session;\n    this.bootStorage = storage;\n    this.touchOnly = touchOnly;\n    this.engine = null;\n    this.store = null;\n  },\n\n  ensureInit(engine) {\n    if (this.engine === engine) return;\n    this.init(engine, { storage: this.bootStorage ?? null, session: this.session });\n  },\n\n  init(engine, { storage = null, session = null } = {}) {\n    this.engine = engine;\n    this.session = session;\n    this.store = this.store ?? new Store(storage);\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/data/about.js <<'EOF'\n// One source of truth: feeds the About screen, and tools/build.mjs writes exit-interview.json from it.\nimport { TITLE, TAGLINE } from './title.js';\n\nexport const SOURCE_INFO = {\n  date: '2026-11-04 23:07:41',\n  source: 'Wii Fit',\n  plan: 'PLAN.md',\n  genre: 'Fitness and balance minigame collection inside a light life-sim week (sports)',\n  perspective: 'Isometric on the island; fixed front-on for class activities; other fixed views per activity (behind, side-on, top-down-ish)',\n  tech: 'Pixel Engine 0.46.0 (riftlight engine kit) with three.js r186 and Rapier as bundled in it; esbuild 0.28.2 for packaging; vanilla JavaScript modules',\n  artDirection: 'The engine\\'s native pixel look (toon materials, 16-colour palette), with new models written as data for a spotless white island made of giant gym equipment',\n  animation: 'Engine ClipDefs with THREE.AnimationMixer, plus scrubbed reps, Squash, SpringChain and additive lean layers',\n  audio: 'Engine Song and SoundDef data plus a Web Audio formant voice: all code, no files. Gibberish voices per speaker. Music 10% by default',\n  online: 'AI Hub Session Protocol v1, ghost mode, own card, 1-4 players; Family Hour is local on one screen',\n  testing: 'Headless Node playthroughs with bots, one test command; Chromium, Firefox and WebKit with Playwright on file://; gamepad stub, phone profile, OfflineAudioContext and AnalyserNode checks; the hub harness; screenshots at 1920x1080 only for what a script cannot judge. No subagents for review',\n  research: 'Read the kit guides and the hub README, searched API.md. The director\\'s plan included engine and hub research and spikes',\n  environment: 'Claude Code CLI (headless); Linux',\n  model: 'Anthropic, claude-opus-5-5, reasoning effort xhigh',\n  usage: 'added on import',\n};\n\nexport const TESTING_FEEDBACK = {\n  questions: ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'],\n  answers: ['unknown', 'unknown', 'unknown', 'unknown'],\n};\nexport const ENGINE_FEEDBACK = {\n  questions: ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why?', 'If you could change one thing about the engine, what would it be?'],\n  answers: ['unknown', 'unknown', 'unknown', 'unknown', 'none', 'unknown'],\n};\nexport const PROMPT_FEEDBACK = {\n  questions: ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'],\n  answers: ['unknown', 'unknown', 'unknown', 'unknown'],\n};\n\nexport const AI_HUB = {\n  name: TITLE,\n  tagline: TAGLINE,\n  description: 'A week at a spotless wellness island run by a small, polite, deeply judgmental bathroom scale. Your whole body is one dot. Keep it in the circle.',\n  type: 'Game',\n  genre: 'Sports',\n  source: 'Wii Fit',\n  series: 'Wii Fit',\n  players: '1–4',\n  controls: 'Left stick, WASD or mouse: lean. R2, Space or click: breathe. L1/R1, F/J or mouse buttons: step.',\n  tags: ['pixel art', 'comedy', 'versus', 'arcade', '3d', 'story'],\n};\n\nexport const CREDITS = [\n  `${TITLE}`,\n  'An original comedy. Inspired by Wii Fit. Not affiliated with anyone who makes scales.',\n  'Design, code, art, music and writing by Claude (Opus 5.5), from a director\\'s plan.',\n  'Built on Pixel Engine, the riftlight engine kit.',\n  'Ounce appears courtesy of Ounce.',\n  'Kevin has been with us eleven years.',\n];\nexport const DISCLAIMER = 'This is not medical advice. Ounce is a scale.';\n\nexport function exitInterview() {\n  return {\n    sourceInformation: { ...SOURCE_INFO },\n    testingFeedback: [...TESTING_FEEDBACK.answers],\n    engineFeedback: [...ENGINE_FEEDBACK.answers],\n    promptFeedback: [...PROMPT_FEEDBACK.answers],\n    aiHub: { ...AI_HUB },\n  };\n}\nEOF\ncat > src/ui/screens/about.js <<'EOF'\n// About & Credits: paged, not dense. L1/R1, arrows or click.\nimport { App } from '../../app.js';\nimport { BACK, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP, TAB_LEFT, TAB_RIGHT } from '../../core/actions.js';\nimport { CREDITS, DISCLAIMER, ENGINE_FEEDBACK, PROMPT_FEEDBACK, SOURCE_INFO, TESTING_FEEDBACK } from '../../data/about.js';\nimport { CREDITS_TEXT } from '../../data/credits-text.js';\nimport { promptBar } from '../prompts.js';\nimport { say, sayCentered, sanitize } from '../font.js';\nimport { heading, panel, SAFE } from '../widgets.js';\nimport { dim, wrapTo } from './common.js';\n\nconst SOURCE_LABELS = { date: 'Date', source: 'Source', plan: 'Plan', genre: 'Genre', perspective: 'Perspective', tech: 'Tech', artDirection: 'Art Direction', animation: 'Animation', audio: 'Audio', online: 'Online', testing: 'Testing', research: 'Research', environment: 'Environment', model: 'Model', usage: 'Usage' };\n\nfunction qa(block) { return block.questions.flatMap((q, i) => [{ h: q }, { t: block.answers[i] }]); }\n\nfunction buildPages() {\n  return [\n    { title: 'Credits', rows: CREDITS.map((t) => ({ t })) },\n    { title: 'Please Note', rows: [{ h: DISCLAIMER }, { t: 'The game asks for no health data. Wobble Age is a joke. So is the number it was before.' }] },\n    { title: 'Source Information', rows: Object.keys(SOURCE_LABELS).flatMap((k) => [{ h: SOURCE_LABELS[k] }, { t: SOURCE_INFO[k] }]) },\n    { title: 'Testing Feedback', rows: qa(TESTING_FEEDBACK) },\n    { title: 'Engine Feedback', rows: qa(ENGINE_FEEDBACK) },\n    { title: 'Prompt Feedback', rows: qa(PROMPT_FEEDBACK) },\n    { title: 'Engine Kit Credits', rows: [{ h: 'Pixel Engine\\'s own credits follow, as it asks.' }, { t: 'three.js and Rapier ship under their licences. The library and built-in models are the engine\\'s own work. The full text is on the next page.' }] },\n    { title: 'CREDITS.md', rows: sanitize(CREDITS_TEXT).split('\\n').map((t) => ({ t, raw: true })) },\n  ];\n}\n\nexport class AboutScreen {\n  name = 'about';\n  i = 0;\n  scroll = 0;\n  rows = 0;\n  pages = buildPages();\n  repeat = 0;\n\n  layout(hud, page) {\n    const w = Math.min(hud.width - SAFE * 2, 420);\n    const out = [];\n    for (const r of page.rows) {\n      if (r.h) { for (const l of wrapTo(r.h, w - 12)) out.push({ s: l, color: 'teal' }); } else if (r.raw) {\n        const ls = wrapTo(r.t || ' ', w - 12);\n        for (const l of ls) out.push({ s: l, color: 'ink' });\n      } else { for (const l of wrapTo(r.t, w - 12)) out.push({ s: l, color: 'ink' }); out.push({ s: '', color: 'ink' }); }\n    }\n    return { w, lines: out };\n  }\n\n  update(ctx, dt) {\n    const { input } = ctx;\n    const n = this.pages.length;\n    const page = (d) => { this.i = (this.i + d + n) % n; this.scroll = 0; App.sfx('menuMove'); };\n    if (input.wasPressed(...TAB_RIGHT, ...MENU_RIGHT)) page(1);\n    if (input.wasPressed(...TAB_LEFT, ...MENU_LEFT)) page(-1);\n    if (input.wasPressed('MouseLeft')) {\n      const p = App.device.pointerArt(ctx);\n      page(p.x < ctx.hud.width / 2 ? -1 : 1);\n    }\n    const h = this.visible ?? 10;\n    const maxScroll = Math.max(0, (this.lineCount ?? 0) - h);\n    const uiDt = dt || 1 / 60;\n    const dir = (input.anyDown(MENU_DOWN) || input.padAxis.y < -0.5 ? 1 : 0) - (input.anyDown(MENU_UP) || input.padAxis.y > 0.5 ? 1 : 0);\n    if (dir) {\n      this.repeat -= uiDt;\n      if (this.repeat <= 0) { this.scroll = Math.max(0, Math.min(maxScroll, this.scroll + dir)); this.repeat = 0.09; }\n    } else this.repeat = 0;\n    if (input.wheel) this.scroll = Math.max(0, Math.min(maxScroll, this.scroll + Math.sign(input.wheel) * 3));\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight')) { App.sfx('menuBack'); App.stack.pop(this); }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    const page = this.pages[this.i];\n    heading(hud, page.title, 10, hud.width > 300 ? 2 : 1);\n    const { w, lines } = this.layout(hud, page);\n    this.lineCount = lines.length;\n    const top = 36;\n    const lineH = 11;\n    const avail = hud.height - top - 30;\n    this.visible = Math.max(3, Math.floor((avail - 8) / lineH));\n    const x = Math.round((hud.width - w) / 2);\n    const shown = Math.min(this.visible, lines.length);\n    panel(hud, x, top, w, shown * lineH + 8, { fill: 'white', name: 'about' });\n    for (let k = 0; k < shown; k++) {\n      const l = lines[this.scroll + k];\n      if (l?.s) say(hud, x + 6, top + 4 + k * lineH, l.s, { color: l.color, shadow: false, name: 'about-text' });\n    }\n    if (lines.length > shown) {\n      const bh = shown * lineH;\n      const th = Math.max(6, Math.round((bh * shown) / lines.length));\n      const ty = top + 4 + Math.round(((bh - th) * this.scroll) / Math.max(1, lines.length - shown));\n      hud.rect(x + w - 4, top + 4, 2, bh, 'mist');\n      hud.rect(x + w - 4, ty, 2, th, 'teal');\n    }\n    sayCentered(hud, hud.width / 2, hud.height - 31, `${this.i + 1} / ${this.pages.length}`, { color: 'sand', name: 'about-page' });\n    promptBar(hud, App.device, lines.length > shown ? [['tabs', 'Page'], ['move', 'Scroll'], ['back', 'Back']] : [['tabs', 'Page'], ['back', 'Back']]);\n  }\n}\nEOF\ncat > src/ui/screens/dev.js <<'EOF'\n// Dev Tools: reached from pause. 10-foot legible, fully controller-driven, tabs with L1/R1.\nimport { App } from '../../app.js';\nimport { changedTunables, nudgeTunable, resetTunables, T, TUNABLE_DEFS, TUNABLE_TABS } from '../../core/tunables.js';\nimport { SKILL_NAMES } from '../../core/drivers.js';\nimport { ACTIVITIES, ACTIVITY_IDS } from '../../data/activities.js';\nimport { Menu } from '../menu.js';\nimport { heading } from '../widgets.js';\nimport { promptBar } from '../prompts.js';\nimport { dim, TabBar } from './common.js';\nimport { DialogueScreen } from '../dialogue.js';\nimport { SoundTestScreen } from './soundtest.js';\nimport { allLines } from '../../data/alllines.js';\nimport { SONGS } from '../../audio/songs.js';\n\nconst fmt = (v) => (Math.abs(v) >= 10 ? String(Math.round(v * 10) / 10) : String(Math.round(v * 1000) / 1000));\nconst TOOL_SCENES = ['title', 'hub', 'weighin', 'report', 'locker', 'records', 'jar', 'ferry', 'ending', 'join', 'viewer'];\nconst AUTOPILOT = ['off', ...SKILL_NAMES];\n\nexport class DevScreen {\n  name = 'dev';\n  freezes = false;\n  starPick = 3;\n  sceneI = 1;\n  activityI = 0;\n  dayPick = 1;\n  lineI = 0;\n\n  constructor() {\n    this.tabs = new TabBar([...TUNABLE_TABS, 'Tools'], { onChange: () => this.refresh() });\n    this.menu = new Menu([], { y: 54, width: 400, scale: 1, rowH: 15, maxRows: 11, tabbed: true, onBack: () => App.stack.pop(this) });\n    this.refresh();\n    this.lines = allLines();\n    this.dayPick = App.slot?.day ?? 1;\n  }\n\n  refresh() {\n    this.menu.focus = 0; this.menu.top = 0;\n    const tab = this.tabs.current;\n    this.menu.setItems(tab === 'Tools' ? this.toolItems() : this.sliderItems(tab));\n  }\n\n  sliderItems(tab) {\n    const items = TUNABLE_DEFS.filter((d) => d.tab === tab).map((d) => ({\n      label: d.label, id: d.id,\n      value: () => `${fmt(T[d.id])}  (${fmt(d.def)})`,\n      adjust: (dir) => nudgeTunable(d, dir),\n      slider: { get: () => T[d.id], set: (v) => { T[d.id] = Math.round(Math.min(d.max, Math.max(d.min, Math.round(v / d.step) * d.step)) * 1000) / 1000; }, min: d.min, max: d.max },\n      action: () => nudgeTunable(d, 1),\n      sound: 'menuMove',\n    }));\n    items.push(\n      { label: 'Reset this tab', id: 'resetTab', action: () => resetTunables(tab) },\n      { label: 'Reset everything', id: 'resetAll', action: () => resetTunables() },\n      { label: 'Export changes (console, clipboard)', id: 'export', action: () => this.exportValues() },\n    );\n    return items;\n  }\n\n  exportValues() {\n    const json = JSON.stringify(changedTunables(), null, 2);\n    this.exported = json;\n    console.log(`[We Fit In tunables] ${json}`);\n    try { globalThis.navigator?.clipboard?.writeText?.(json)?.catch?.(() => {}); } catch { /* not allowed */ }\n    App.say('ounce', 'Exported. Paste it into the data. I have kept a copy, for my records.');\n  }\n\n  toolItems() {\n    const onOff = (v) => (v ? 'On' : 'Off');\n    const toggle = (label, id, get, set) => ({ label, id, value: () => onOff(get()), action: () => set(!get()), adjust: () => set(!get()) });\n    return [\n      { label: 'Go to day', id: 'day', value: () => `${this.dayPick}`, adjust: (d) => { this.dayPick = ((this.dayPick - 1 + d + 7) % 7) + 1; }, action: () => this.goDay() },\n      { label: 'Go to scene', id: 'scene', value: () => TOOL_SCENES[this.sceneI], adjust: (d) => { this.sceneI = (this.sceneI + d + TOOL_SCENES.length) % TOOL_SCENES.length; }, action: () => this.goScene() },\n      { label: 'Go to activity', id: 'activity', value: () => ACTIVITIES[ACTIVITY_IDS[this.activityI]].name, adjust: (d) => { this.activityI = (this.activityI + d + ACTIVITY_IDS.length) % ACTIVITY_IDS.length; }, action: () => this.goActivity() },\n      { label: 'Finish activity with stars', id: 'finish', value: () => `${this.starPick}`, adjust: (d) => { this.starPick = (this.starPick + d + 4) % 4; }, action: () => this.finishNow() },\n      { label: 'Give 50 Drips', id: 'drips', action: () => this.giveDrips() },\n      toggle('Unlock all', 'unlock', () => App.dev.allUnlocked, (v) => { App.dev.allUnlocked = v; }),\n      { label: 'Autopilot', id: 'autopilot', value: () => App.dev.autopilot ?? 'off', adjust: (d) => this.cycleAuto(d), action: () => this.cycleAuto(1) },\n      toggle('God mode', 'god', () => App.dev.god, (v) => { App.dev.god = v; }),\n      { label: 'Time scale', id: 'timescale', value: () => `${App.dev.timeScale}`, adjust: (d) => { App.dev.timeScale = Math.max(0.25, Math.min(3, App.dev.timeScale + d * 0.25)); }, action: () => { App.dev.timeScale = App.dev.timeScale >= 3 ? 0.25 : App.dev.timeScale + 0.25; } },\n      toggle('Overlay', 'overlay', () => App.dev.overlay, (v) => { App.dev.overlay = v; }),\n      toggle('Hide HUD', 'hideHud', () => App.dev.hideHud, (v) => { App.dev.hideHud = v; }),\n      toggle('Free camera', 'freeCam', () => App.dev.freeCam, (v) => this.setFreeCam(v)),\n      { label: 'Dialogue tester', id: 'dialogue', value: () => `${this.lineI + 1}/${this.lines?.length ?? 0}`, adjust: (d) => { this.lineI = (this.lineI + d + this.lines.length) % this.lines.length; }, action: () => App.stack.push(new DialogueScreen([this.lines[this.lineI]])) },\n      { label: 'Sound test', id: 'sound', right: () => `${Object.keys(SONGS).length} songs`, action: () => App.stack.push(new SoundTestScreen()) },\n      { label: 'Animation viewer', id: 'anim', action: () => App.go('viewer') },\n      { label: 'Reset save', id: 'resetSave', action: () => { App.store.resetAll(); App.go('title'); } },\n    ];\n  }\n\n  cycleAuto(d) {\n    const i = AUTOPILOT.indexOf(App.dev.autopilot ?? 'off');\n    const next = AUTOPILOT[(i + d + AUTOPILOT.length) % AUTOPILOT.length];\n    App.dev.autopilot = next === 'off' ? null : next;\n  }\n\n  ensureSlot() {\n    if (App.slot) return App.slot;\n    App.store.create(0, 'Guest', undefined);\n    return App.slot;\n  }\n\n  goDay() {\n    const slot = this.ensureSlot();\n    slot.day = this.dayPick;\n    slot.phase = 'morning';\n    App.store.write();\n    this.closeAll();\n    App.go('weighin');\n  }\n\n  goScene() { const id = TOOL_SCENES[this.sceneI]; if (['hub', 'weighin', 'report', 'locker', 'records', 'jar', 'ferry', 'ending'].includes(id)) this.ensureSlot(); this.closeAll(); App.go(id); }\n  goActivity() { this.closeAll(); App.go('activity', { id: ACTIVITY_IDS[this.activityI], mode: App.slot ? 'week' : 'dropin', noPractice: true }); }\n\n  finishNow() {\n    const s = App.scene;\n    if (s?.devFinish) { this.closeAll(); s.devFinish(this.starPick); } else App.say('ounce', 'There is nothing to finish here. I checked.');\n  }\n\n  giveDrips() {\n    const slot = this.ensureSlot();\n    slot.drips += 50;\n    import('../../core/week.js').then(({ awardMilestones }) => { awardMilestones(slot); App.store.write(); });\n  }\n\n  setFreeCam(on) {\n    App.dev.freeCam = on;\n    const engine = App.engine;\n    if (on) engine.setCamera({ preset: 'free' }, { syncUrl: false });\n    else engine.setCamera(App.scene?.cameraConfig?.() ?? { preset: 'iso' }, { syncUrl: false });\n  }\n\n  closeAll() {\n    App.stack.clear();\n    App.engine.timeScale = App.dev.timeScale;\n  }\n\n  update(ctx, dt) { this.tabs.update(ctx); this.menu.update(ctx, dt); }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    heading(hud, 'Dev Tools', 8);\n    this.tabs.draw(ctx, 32);\n    this.menu.draw(ctx);\n    promptBar(hud, App.device, [['adjust', 'Change'], ['confirm', 'Use'], ['tabs', 'Tab'], ['back', 'Back']]);\n  }\n}\nEOF\ncat > src/ui/screens/soundtest.js <<'EOF'\n// Sound test: every song, SFX and speaker.\nimport { App } from '../../app.js';\nimport { SFX_DEFS } from '../../audio/sfx.js';\nimport { SONG_LABELS, SONGS } from '../../audio/songs.js';\nimport { syllabify, VOICES } from '../../audio/voice.js';\nimport { Menu } from '../menu.js';\nimport { MenuScreen } from './common.js';\n\nconst SONG_IDS = Object.keys(SONGS);\nconst SFX_IDS = Object.keys(SFX_DEFS);\nconst SPEAKER_IDS = Object.keys(VOICES).filter((v) => v !== 'narrator');\nconst SPEAK = 'Thank you. I have written that down. Is that close?';\n\nexport class SoundTestScreen extends MenuScreen {\n  freezes = false;\n  constructor() {\n    const menu = new Menu([], { width: 320, onBack: () => App.stack.pop(this) });\n    super('soundtest', 'Sound Test', menu, { prompts: [['adjust', 'Change'], ['confirm', 'Play'], ['back', 'Back']] });\n    this.song = 0; this.sfx = 0; this.who = 0;\n    menu.setItems([\n      { label: 'Song', id: 'song', value: () => SONG_LABELS[SONG_IDS[this.song]], adjust: (d) => { this.song = (this.song + d + SONG_IDS.length) % SONG_IDS.length; }, action: () => App.music(SONG_IDS[this.song]) },\n      { label: 'Stop music', id: 'stop', action: () => App.music(null) },\n      { label: 'SFX', id: 'sfx', value: () => SFX_IDS[this.sfx], adjust: (d) => { this.sfx = (this.sfx + d + SFX_IDS.length) % SFX_IDS.length; }, action: () => App.sfx(SFX_IDS[this.sfx]), sound: 'menuMove' },\n      { label: 'Speaker', id: 'speaker', value: () => SPEAKER_IDS[this.who], adjust: (d) => { this.who = (this.who + d + SPEAKER_IDS.length) % SPEAKER_IDS.length; }, action: () => this.speak(), sound: 'menuMove' },\n    ]);\n  }\n  speak() {\n    const who = SPEAKER_IDS[this.who];\n    if (who === 'kevin') App.sfx('gullSquawk');\n    else App.speak(syllabify(SPEAK, who), who);\n  }\n}\nEOF\ncat > src/data/alllines.js <<'EOF'\n// Every line in one list, for the dialogue tester and the glyph and fit tests.\nimport { AGE_LINES, ATTRACT_LINES, BARKS, CONCERNS, CONFESSION, CONFESSION_AFTER, CREDITS_SIGNOFF, FERRY_LINES, HAMMOCK_LINES, INTRO_LINES, IDLE_BARKS, ISLAND_BARKS, LONG_STAND_LINES, MORNINGS, OW_JOKE, OW_LINES, REPORT_LINES, RESULT_LINES, STATION_REMARKS, WEEK2_LINES } from './lines.js';\nimport { DAYS } from './week.js';\nimport { QUESTIONS, AGE_QUESTION } from './questions.js';\nimport { MILESTONES } from './unlocks.js';\nimport { ACTIVITIES } from './activities.js';\nimport { HOLD_LINES } from './poses.js';\nimport { MEDLEY } from './medley.js';\n\nconst strip = (s) => (typeof s === 'string' ? s.replace(/^[a-z]+:\\s/, '') : s.text);\nconst whoOf = (s, fallback = 'ounce') => {\n  if (typeof s !== 'string') return s.who ?? fallback;\n  const m = /^([a-z]+):\\s/.exec(s);\n  return m ? m[1] : fallback;\n};\n\nexport function allLines() {\n  const out = [];\n  const push = (who, s) => out.push({ who: whoOf(s, who), text: strip(s) });\n  for (const set of Object.values(RESULT_LINES)) for (const list of Object.values(set)) for (const s of list) push('ounce', s);\n  for (const list of Object.values(BARKS)) for (const s of list) push('ounce', s);\n  for (const s of ISLAND_BARKS) push('ounce', s);\n  for (const list of Object.values(IDLE_BARKS)) for (const s of list) push('ounce', s);\n  for (const list of Object.values(AGE_LINES)) for (const s of list) push('ounce', s.replace('%A', '68').replace('%F', '30'));\n  for (const s of MORNINGS) push('ounce', s);\n  for (const s of OW_LINES) push('ounce', s);\n  push('ounce', OW_JOKE);\n  for (const s of INTRO_LINES) push('ounce', s);\n  for (const s of FERRY_LINES) push('narrator', s);\n  for (const s of CONCERNS) push('ounce', s);\n  for (const s of Object.values(REPORT_LINES)) push('ounce', s);\n  for (const s of Object.values(HAMMOCK_LINES)) push('ounce', s);\n  for (const s of Object.values(STATION_REMARKS)) push('ounce', s);\n  for (const s of Object.values(LONG_STAND_LINES)) push('coach', s);\n  for (const s of CONFESSION) push('ounce', s);\n  for (const s of CONFESSION_AFTER) push('ounce', s);\n  push('ounce', CREDITS_SIGNOFF);\n  for (const s of WEEK2_LINES) push('ounce', s);\n  for (const s of ATTRACT_LINES) push('ounce', s);\n  for (const d of DAYS) for (const s of d.beat) push('ounce', s);\n  for (const q of QUESTIONS) { push('ounce', q.q); for (const a of q.a) push('narrator', a); for (const r of q.r) push('ounce', r); }\n  push('ounce', AGE_QUESTION);\n  for (const m of MILESTONES) push('ounce', m.remark);\n  for (const a of Object.values(ACTIVITIES)) { push('coach', a.coach); push('narrator', a.goal); }\n  for (const s of HOLD_LINES) push('coach', s);\n  for (const list of Object.values(MEDLEY.remarks)) for (const s of list) push('ounce', s);\n  return out;\n}\nEOF\ncat > tools/build.mjs <<'EOF'\n// Bundle everything into one html in root, and write the exit interview from src/data/about.js.\nimport { execFileSync } from 'node:child_process';\nimport { mkdirSync, readFileSync, writeFileSync } from 'node:fs';\nimport { dirname, join } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst DEV = join(dirname(fileURLToPath(import.meta.url)), '..');\nprocess.chdir(DEV);\nconst { BASE_NAME, TITLE } = await import('../src/data/title.js');\n\n// The kit asks for CREDITS.md to be shipped: it becomes a data module the About screen reads.\nconst credits = readFileSync('CREDITS.md', 'utf8');\nwriteFileSync('src/data/credits-text.js', `// Generated by tools/build.mjs from the kit's CREDITS.md.\\nexport const CREDITS_TEXT = ${JSON.stringify(credits)};\\n`);\n\nmkdirSync('.build', { recursive: true });\nexecFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--platform=browser', '--target=esnext', '--charset=utf8', '--outfile=.build/bundle.js', '--log-level=warning'], { stdio: 'inherit' });\n\nconst HUB_METAS = `<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Score the most across three events. Stay in the circle.\">\n<meta name=\"hub:session-howto\" content=\"Left stick, WASD or mouse: lean. R2, Space or click: breathe. L1/R1, F/J: step.\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:webgpu\" content=\"required\">`;\n\nconst safe = (s) => s.replace(/<\\/script/gi, '<\\\\/script').replace(/<!--/g, '<\\\\!--');\nconst html = `<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<script>${readFileSync('vendor/hub/session.js', 'utf8')}</script>\n${HUB_METAS}\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<link rel=\"icon\" href=\"data:,\"><title>${TITLE}</title>\n<style>html, body { margin: 0; height: 100%; background: #0d0b14; } #app { position: fixed; inset: 0; }</style>\n</head><body><div id=\"app\"></div>\n<script type=\"module\">${safe(readFileSync('.build/bundle.js', 'utf8'))}</script>\n</body></html>`;\nconst OUTPUT_HTML = join('..', `${BASE_NAME}.html`);\nwriteFileSync(OUTPUT_HTML, html);\n\nconst { exitInterview } = await import('../src/data/about.js');\nconst exitPath = join('..', 'exit-interview.json');\nwriteFileSync(exitPath, `${JSON.stringify(exitInterview(), null, 2)}\\n`);\nJSON.parse(readFileSync(exitPath, 'utf8'));\nEOF\necho 'export const CREDITS_TEXT = \"\";' > src/data/credits-text.js\necho ok","description":"Write about, dev tools, sound test screens and the build script","timeout":30000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9481,"cache_read_input_tokens":336563,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9481},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"9b6da897-cc38-4f1d-89a1-feff2a272465","timestamp":"2026-11-05T06:37:28.664Z","request_id":"req_011CgjKM6qeNRbVTt8LFUbQy","wire_tool_inputs":{"toolu_01SYZD7Upe22QX6MwTeEghRq":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='src/ui/menu.js'; s=open(p).read()\ns=s.replace(\"import { bar, panel, SAFE } from './widgets.js';\",\"import { bar, panel, SAFE, starRow, starRowWidth } from './widgets.js';\")\ns=s.replace(\"\"\"      const sliderW = item.slider ? Math.min(70, Math.round(width * 0.28)) : 0;\n      const room = width - 8 - (right ? textWidth(right, scale) + 8 : 0) - (sliderW ? sliderW + 6 : 0);\"\"\",\"\"\"      const sliderW = item.slider ? Math.min(70, Math.round(width * 0.28)) : 0;\n      const starsW = item.stars !== undefined ? starRowWidth(1) + 6 : 0;\n      const room = width - 8 - (right ? textWidth(right, scale) + 8 : 0) - (sliderW ? sliderW + 6 : 0) - starsW;\"\"\")\ns=s.replace(\"\"\"      if (item.star !== undefined) item.star(hud, x + width - 44, ry + 2);\n\"\"\",\"\"\"      if (item.stars !== undefined) starRow(hud, x + width - 4 - (right ? textWidth(right, scale) + 6 : 0) - starRowWidth(1), ry + Math.round((rowH - 11) / 2), item.stars, 1);\n\"\"\")\nopen(p,'w').write(s)\np='src/scenes/base.js'; s=open(p).read()\ns=s.replace(\"\"\"    App.attach(ctx, this);\"\"\",\"\"\"    App.ensureInit(ctx.engine);\n    App.attach(ctx, this);\"\"\")\ns=s.replace(\"\"\"    if (!App.dev.hideHud) {\n      this.onDraw(ctx, dt);\n      App.stack.draw(ctx, dt);\n      if (!App.stack.open) this.bark.draw(ctx.hud);\n      this.drawPauseIcon(ctx);\n    }\"\"\",\"\"\"    if (!App.dev.hideHud) this.onDraw(ctx, dt);\n    App.stack.draw(ctx, dt);\n    if (!App.dev.hideHud) {\n      if (!App.stack.open) this.bark.draw(ctx.hud);\n      this.drawPauseIcon(ctx);\n    }\"\"\")\nopen(p,'w').write(s)\np='src/app.js'; s=open(p).read()\ns=s.replace(\"\"\"  init(engine, { storage = null, session = null } = {}) {\n    this.engine = engine;\n    this.session = session;\n    this.store = this.store ?? new Store(storage);\"\"\",\"\"\"  /** Set before the engine starts: { session, storage, touchOnly }. */\n  boot({ session = null, storage = null, touchOnly = false } = {}) {\n    this.session = session;\n    this.bootStorage = storage;\n    this.touchOnly = touchOnly;\n    this.engine = null;\n    this.store = null;\n  },\n\n  ensureInit(engine) {\n    if (this.engine === engine) return;\n    this.init(engine, { storage: this.bootStorage ?? null, session: this.session });\n  },\n\n  init(engine, { storage = null, session = null } = {}) {\n    this.engine = engine;\n    this.session = session;\n    this.store = this.store ?? new Store(storage);\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > src/data/about.js <<'EOF'\n// One source of truth: feeds the About screen, and tools/build.mjs writes exit-interview.json from it.\nimport { TITLE, TAGLINE } from './title.js';\n\nexport const SOURCE_INFO = {\n  date: '2026-11-04 23:07:41',\n  source: 'Wii Fit',\n  plan: 'PLAN.md',\n  genre: 'Fitness and balance minigame collection inside a light life-sim week (sports)',\n  perspective: 'Isometric on the island; fixed front-on for class activities; other fixed views per activity (behind, side-on, top-down-ish)',\n  tech: 'Pixel Engine 0.46.0 (riftlight engine kit) with three.js r186 and Rapier as bundled in it; esbuild 0.28.2 for packaging; vanilla JavaScript modules',\n  artDirection: 'The engine\\'s native pixel look (toon materials, 16-colour palette), with new models written as data for a spotless white island made of giant gym equipment',\n  animation: 'Engine ClipDefs with THREE.AnimationMixer, plus scrubbed reps, Squash, SpringChain and additive lean layers',\n  audio: 'Engine Song and SoundDef data plus a Web Audio formant voice: all code, no files. Gibberish voices per speaker. Music 10% by default',\n  online: 'AI Hub Session Protocol v1, ghost mode, own card, 1-4 players; Family Hour is local on one screen',\n  testing: 'Headless Node playthroughs with bots, one test command; Chromium, Firefox and WebKit with Playwright on file://; gamepad stub, phone profile, OfflineAudioContext and AnalyserNode checks; the hub harness; screenshots at 1920x1080 only for what a script cannot judge. No subagents for review',\n  research: 'Read the kit guides and the hub README, searched API.md. The director\\'s plan included engine and hub research and spikes',\n  environment: 'Claude Code CLI (headless); Linux',\n  model: 'Anthropic, claude-opus-5-5, reasoning effort xhigh',\n  usage: 'added on import',\n};\n\nexport const TESTING_FEEDBACK = {\n  questions: ['How many issues did testing catch?', 'How many would be considered critical issues / game breaking?', 'What was the most helpful test you ran?', 'What was the least helpful test you ran?'],\n  answers: ['unknown', 'unknown', 'unknown', 'unknown'],\n};\nexport const ENGINE_FEEDBACK = {\n  questions: ['What did you like most about the engine?', 'Did you get stuck or guess wrong?', 'What was the most important thing you had to build yourself?', 'What was the hardest part about using the engine?', 'What did you change in the engine, and why?', 'If you could change one thing about the engine, what would it be?'],\n  answers: ['unknown', 'unknown', 'unknown', 'unknown', 'none', 'unknown'],\n};\nexport const PROMPT_FEEDBACK = {\n  questions: ['What did you like most about this prompt?', 'What was confusing?', 'What was the hardest thing to do?', 'What would you change in this prompt?'],\n  answers: ['unknown', 'unknown', 'unknown', 'unknown'],\n};\n\nexport const AI_HUB = {\n  name: TITLE,\n  tagline: TAGLINE,\n  description: 'A week at a spotless wellness island run by a small, polite, deeply judgmental bathroom scale. Your whole body is one dot. Keep it in the circle.',\n  type: 'Game',\n  genre: 'Sports',\n  source: 'Wii Fit',\n  series: 'Wii Fit',\n  players: '1\\u20134',\n  controls: 'Left stick, WASD or mouse: lean. R2, Space or click: breathe. L1/R1, F/J or mouse buttons: step.',\n  tags: ['pixel art', 'comedy', 'versus', 'arcade', '3d', 'story'],\n};\n\nexport const CREDITS = [\n  `${TITLE}`,\n  'An original comedy. Inspired by Wii Fit. Not affiliated with anyone who makes scales.',\n  'Design, code, art, music and writing by Claude (Opus 5.5), from a director\\'s plan.',\n  'Built on Pixel Engine, the riftlight engine kit.',\n  'Ounce appears courtesy of Ounce.',\n  'Kevin has been with us eleven years.',\n];\nexport const DISCLAIMER = 'This is not medical advice. Ounce is a scale.';\n\nexport function exitInterview() {\n  return {\n    sourceInformation: { ...SOURCE_INFO },\n    testingFeedback: [...TESTING_FEEDBACK.answers],\n    engineFeedback: [...ENGINE_FEEDBACK.answers],\n    promptFeedback: [...PROMPT_FEEDBACK.answers],\n    aiHub: { ...AI_HUB },\n  };\n}\nEOF\ncat > src/ui/screens/about.js <<'EOF'\n// About & Credits: paged, not dense. L1/R1, arrows or click.\nimport { App } from '../../app.js';\nimport { BACK, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP, TAB_LEFT, TAB_RIGHT } from '../../core/actions.js';\nimport { CREDITS, DISCLAIMER, ENGINE_FEEDBACK, PROMPT_FEEDBACK, SOURCE_INFO, TESTING_FEEDBACK } from '../../data/about.js';\nimport { CREDITS_TEXT } from '../../data/credits-text.js';\nimport { promptBar } from '../prompts.js';\nimport { say, sayCentered, sanitize } from '../font.js';\nimport { heading, panel, SAFE } from '../widgets.js';\nimport { dim, wrapTo } from './common.js';\n\nconst SOURCE_LABELS = { date: 'Date', source: 'Source', plan: 'Plan', genre: 'Genre', perspective: 'Perspective', tech: 'Tech', artDirection: 'Art Direction', animation: 'Animation', audio: 'Audio', online: 'Online', testing: 'Testing', research: 'Research', environment: 'Environment', model: 'Model', usage: 'Usage' };\n\nfunction qa(block) { return block.questions.flatMap((q, i) => [{ h: q }, { t: block.answers[i] }]); }\n\nfunction buildPages() {\n  return [\n    { title: 'Credits', rows: CREDITS.map((t) => ({ t })) },\n    { title: 'Please Note', rows: [{ h: DISCLAIMER }, { t: 'The game asks for no health data. Wobble Age is a joke. So is the number it was before.' }] },\n    { title: 'Source Information', rows: Object.keys(SOURCE_LABELS).flatMap((k) => [{ h: SOURCE_LABELS[k] }, { t: SOURCE_INFO[k] }]) },\n    { title: 'Testing Feedback', rows: qa(TESTING_FEEDBACK) },\n    { title: 'Engine Feedback', rows: qa(ENGINE_FEEDBACK) },\n    { title: 'Prompt Feedback', rows: qa(PROMPT_FEEDBACK) },\n    { title: 'Engine Kit Credits', rows: [{ h: 'Pixel Engine\\'s own credits follow, as it asks.' }, { t: 'three.js and Rapier ship under their licences. The library and built-in models are the engine\\'s own work. The full text is on the next page.' }] },\n    { title: 'CREDITS.md', rows: sanitize(CREDITS_TEXT).split('\\n').map((t) => ({ t, raw: true })) },\n  ];\n}\n\nexport class AboutScreen {\n  name = 'about';\n  i = 0;\n  scroll = 0;\n  rows = 0;\n  pages = buildPages();\n  repeat = 0;\n\n  layout(hud, page) {\n    const w = Math.min(hud.width - SAFE * 2, 420);\n    const out = [];\n    for (const r of page.rows) {\n      if (r.h) { for (const l of wrapTo(r.h, w - 12)) out.push({ s: l, color: 'teal' }); } else if (r.raw) {\n        const ls = wrapTo(r.t || ' ', w - 12);\n        for (const l of ls) out.push({ s: l, color: 'ink' });\n      } else { for (const l of wrapTo(r.t, w - 12)) out.push({ s: l, color: 'ink' }); out.push({ s: '', color: 'ink' }); }\n    }\n    return { w, lines: out };\n  }\n\n  update(ctx, dt) {\n    const { input } = ctx;\n    const n = this.pages.length;\n    const page = (d) => { this.i = (this.i + d + n) % n; this.scroll = 0; App.sfx('menuMove'); };\n    if (input.wasPressed(...TAB_RIGHT, ...MENU_RIGHT)) page(1);\n    if (input.wasPressed(...TAB_LEFT, ...MENU_LEFT)) page(-1);\n    if (input.wasPressed('MouseLeft')) {\n      const p = App.device.pointerArt(ctx);\n      page(p.x < ctx.hud.width / 2 ? -1 : 1);\n    }\n    const h = this.visible ?? 10;\n    const maxScroll = Math.max(0, (this.lineCount ?? 0) - h);\n    const uiDt = dt || 1 / 60;\n    const dir = (input.anyDown(MENU_DOWN) || input.padAxis.y < -0.5 ? 1 : 0) - (input.anyDown(MENU_UP) || input.padAxis.y > 0.5 ? 1 : 0);\n    if (dir) {\n      this.repeat -= uiDt;\n      if (this.repeat <= 0) { this.scroll = Math.max(0, Math.min(maxScroll, this.scroll + dir)); this.repeat = 0.09; }\n    } else this.repeat = 0;\n    if (input.wheel) this.scroll = Math.max(0, Math.min(maxScroll, this.scroll + Math.sign(input.wheel) * 3));\n    if (input.wasPressed(...BACK) || input.wasPressed('MouseRight')) { App.sfx('menuBack'); App.stack.pop(this); }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    const page = this.pages[this.i];\n    heading(hud, page.title, 10, hud.width > 300 ? 2 : 1);\n    const { w, lines } = this.layout(hud, page);\n    this.lineCount = lines.length;\n    const top = 36;\n    const lineH = 11;\n    const avail = hud.height - top - 30;\n    this.visible = Math.max(3, Math.floor((avail - 8) / lineH));\n    const x = Math.round((hud.width - w) / 2);\n    const shown = Math.min(this.visible, lines.length);\n    panel(hud, x, top, w, shown * lineH + 8, { fill: 'white', name: 'about' });\n    for (let k = 0; k < shown; k++) {\n      const l = lines[this.scroll + k];\n      if (l?.s) say(hud, x + 6, top + 4 + k * lineH, l.s, { color: l.color, shadow: false, name: 'about-text' });\n    }\n    if (lines.length > shown) {\n      const bh = shown * lineH;\n      const th = Math.max(6, Math.round((bh * shown) / lines.length));\n      const ty = top + 4 + Math.round(((bh - th) * this.scroll) / Math.max(1, lines.length - shown));\n      hud.rect(x + w - 4, top + 4, 2, bh, 'mist');\n      hud.rect(x + w - 4, ty, 2, th, 'teal');\n    }\n    sayCentered(hud, hud.width / 2, hud.height - 31, `${this.i + 1} / ${this.pages.length}`, { color: 'sand', name: 'about-page' });\n    promptBar(hud, App.device, lines.length > shown ? [['tabs', 'Page'], ['move', 'Scroll'], ['back', 'Back']] : [['tabs', 'Page'], ['back', 'Back']]);\n  }\n}\nEOF\ncat > src/ui/screens/dev.js <<'EOF'\n// Dev Tools: reached from pause. 10-foot legible, fully controller-driven, tabs with L1/R1.\nimport { App } from '../../app.js';\nimport { changedTunables, nudgeTunable, resetTunables, T, TUNABLE_DEFS, TUNABLE_TABS } from '../../core/tunables.js';\nimport { SKILL_NAMES } from '../../core/drivers.js';\nimport { ACTIVITIES, ACTIVITY_IDS } from '../../data/activities.js';\nimport { Menu } from '../menu.js';\nimport { heading } from '../widgets.js';\nimport { promptBar } from '../prompts.js';\nimport { dim, TabBar } from './common.js';\nimport { DialogueScreen } from '../dialogue.js';\nimport { SoundTestScreen } from './soundtest.js';\nimport { allLines } from '../../data/alllines.js';\nimport { SONGS } from '../../audio/songs.js';\n\nconst fmt = (v) => (Math.abs(v) >= 10 ? String(Math.round(v * 10) / 10) : String(Math.round(v * 1000) / 1000));\nconst TOOL_SCENES = ['title', 'hub', 'weighin', 'report', 'locker', 'records', 'jar', 'ferry', 'ending', 'join', 'viewer'];\nconst AUTOPILOT = ['off', ...SKILL_NAMES];\n\nexport class DevScreen {\n  name = 'dev';\n  freezes = false;\n  starPick = 3;\n  sceneI = 1;\n  activityI = 0;\n  dayPick = 1;\n  lineI = 0;\n\n  constructor() {\n    this.tabs = new TabBar([...TUNABLE_TABS, 'Tools'], { onChange: () => this.refresh() });\n    this.menu = new Menu([], { y: 54, width: 400, scale: 1, rowH: 15, maxRows: 11, tabbed: true, onBack: () => App.stack.pop(this) });\n    this.refresh();\n    this.lines = allLines();\n    this.dayPick = App.slot?.day ?? 1;\n  }\n\n  refresh() {\n    this.menu.focus = 0; this.menu.top = 0;\n    const tab = this.tabs.current;\n    this.menu.setItems(tab === 'Tools' ? this.toolItems() : this.sliderItems(tab));\n  }\n\n  sliderItems(tab) {\n    const items = TUNABLE_DEFS.filter((d) => d.tab === tab).map((d) => ({\n      label: d.label, id: d.id,\n      value: () => `${fmt(T[d.id])}  (${fmt(d.def)})`,\n      adjust: (dir) => nudgeTunable(d, dir),\n      slider: { get: () => T[d.id], set: (v) => { T[d.id] = Math.round(Math.min(d.max, Math.max(d.min, Math.round(v / d.step) * d.step)) * 1000) / 1000; }, min: d.min, max: d.max },\n      action: () => nudgeTunable(d, 1),\n      sound: 'menuMove',\n    }));\n    items.push(\n      { label: 'Reset this tab', id: 'resetTab', action: () => resetTunables(tab) },\n      { label: 'Reset everything', id: 'resetAll', action: () => resetTunables() },\n      { label: 'Export changes (console, clipboard)', id: 'export', action: () => this.exportValues() },\n    );\n    return items;\n  }\n\n  exportValues() {\n    const json = JSON.stringify(changedTunables(), null, 2);\n    this.exported = json;\n    console.log(`[We Fit In tunables] ${json}`);\n    try { globalThis.navigator?.clipboard?.writeText?.(json)?.catch?.(() => {}); } catch { /* not allowed */ }\n    App.say('ounce', 'Exported. Paste it into the data. I have kept a copy, for my records.');\n  }\n\n  toolItems() {\n    const onOff = (v) => (v ? 'On' : 'Off');\n    const toggle = (label, id, get, set) => ({ label, id, value: () => onOff(get()), action: () => set(!get()), adjust: () => set(!get()) });\n    return [\n      { label: 'Go to day', id: 'day', value: () => `${this.dayPick}`, adjust: (d) => { this.dayPick = ((this.dayPick - 1 + d + 7) % 7) + 1; }, action: () => this.goDay() },\n      { label: 'Go to scene', id: 'scene', value: () => TOOL_SCENES[this.sceneI], adjust: (d) => { this.sceneI = (this.sceneI + d + TOOL_SCENES.length) % TOOL_SCENES.length; }, action: () => this.goScene() },\n      { label: 'Go to activity', id: 'activity', value: () => ACTIVITIES[ACTIVITY_IDS[this.activityI]].name, adjust: (d) => { this.activityI = (this.activityI + d + ACTIVITY_IDS.length) % ACTIVITY_IDS.length; }, action: () => this.goActivity() },\n      { label: 'Finish activity with stars', id: 'finish', value: () => `${this.starPick}`, adjust: (d) => { this.starPick = (this.starPick + d + 4) % 4; }, action: () => this.finishNow() },\n      { label: 'Give 50 Drips', id: 'drips', action: () => this.giveDrips() },\n      toggle('Unlock all', 'unlock', () => App.dev.allUnlocked, (v) => { App.dev.allUnlocked = v; }),\n      { label: 'Autopilot', id: 'autopilot', value: () => App.dev.autopilot ?? 'off', adjust: (d) => this.cycleAuto(d), action: () => this.cycleAuto(1) },\n      toggle('God mode', 'god', () => App.dev.god, (v) => { App.dev.god = v; }),\n      { label: 'Time scale', id: 'timescale', value: () => `${App.dev.timeScale}`, adjust: (d) => { App.dev.timeScale = Math.max(0.25, Math.min(3, App.dev.timeScale + d * 0.25)); }, action: () => { App.dev.timeScale = App.dev.timeScale >= 3 ? 0.25 : App.dev.timeScale + 0.25; } },\n      toggle('Overlay', 'overlay', () => App.dev.overlay, (v) => { App.dev.overlay = v; }),\n      toggle('Hide HUD', 'hideHud', () => App.dev.hideHud, (v) => { App.dev.hideHud = v; }),\n      toggle('Free camera', 'freeCam', () => App.dev.freeCam, (v) => this.setFreeCam(v)),\n      { label: 'Dialogue tester', id: 'dialogue', value: () => `${this.lineI + 1}/${this.lines?.length ?? 0}`, adjust: (d) => { this.lineI = (this.lineI + d + this.lines.length) % this.lines.length; }, action: () => App.stack.push(new DialogueScreen([this.lines[this.lineI]])) },\n      { label: 'Sound test', id: 'sound', right: () => `${Object.keys(SONGS).length} songs`, action: () => App.stack.push(new SoundTestScreen()) },\n      { label: 'Animation viewer', id: 'anim', action: () => App.go('viewer') },\n      { label: 'Reset save', id: 'resetSave', action: () => { App.store.resetAll(); App.go('title'); } },\n    ];\n  }\n\n  cycleAuto(d) {\n    const i = AUTOPILOT.indexOf(App.dev.autopilot ?? 'off');\n    const next = AUTOPILOT[(i + d + AUTOPILOT.length) % AUTOPILOT.length];\n    App.dev.autopilot = next === 'off' ? null : next;\n  }\n\n  ensureSlot() {\n    if (App.slot) return App.slot;\n    App.store.create(0, 'Guest', undefined);\n    return App.slot;\n  }\n\n  goDay() {\n    const slot = this.ensureSlot();\n    slot.day = this.dayPick;\n    slot.phase = 'morning';\n    App.store.write();\n    this.closeAll();\n    App.go('weighin');\n  }\n\n  goScene() { const id = TOOL_SCENES[this.sceneI]; if (['hub', 'weighin', 'report', 'locker', 'records', 'jar', 'ferry', 'ending'].includes(id)) this.ensureSlot(); this.closeAll(); App.go(id); }\n  goActivity() { this.closeAll(); App.go('activity', { id: ACTIVITY_IDS[this.activityI], mode: App.slot ? 'week' : 'dropin', noPractice: true }); }\n\n  finishNow() {\n    const s = App.scene;\n    if (s?.devFinish) { this.closeAll(); s.devFinish(this.starPick); } else App.say('ounce', 'There is nothing to finish here. I checked.');\n  }\n\n  giveDrips() {\n    const slot = this.ensureSlot();\n    slot.drips += 50;\n    import('../../core/week.js').then(({ awardMilestones }) => { awardMilestones(slot); App.store.write(); });\n  }\n\n  setFreeCam(on) {\n    App.dev.freeCam = on;\n    const engine = App.engine;\n    if (on) engine.setCamera({ preset: 'free' }, { syncUrl: false });\n    else engine.setCamera(App.scene?.cameraConfig?.() ?? { preset: 'iso' }, { syncUrl: false });\n  }\n\n  closeAll() {\n    App.stack.clear();\n    App.engine.timeScale = App.dev.timeScale;\n  }\n\n  update(ctx, dt) { this.tabs.update(ctx); this.menu.update(ctx, dt); }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    dim(hud);\n    heading(hud, 'Dev Tools', 8);\n    this.tabs.draw(ctx, 32);\n    this.menu.draw(ctx);\n    promptBar(hud, App.device, [['adjust', 'Change'], ['confirm', 'Use'], ['tabs', 'Tab'], ['back', 'Back']]);\n  }\n}\nEOF\ncat > src/ui/screens/soundtest.js <<'EOF'\n// Sound test: every song, SFX and speaker.\nimport { App } from '../../app.js';\nimport { SFX_DEFS } from '../../audio/sfx.js';\nimport { SONG_LABELS, SONGS } from '../../audio/songs.js';\nimport { syllabify, VOICES } from '../../audio/voice.js';\nimport { Menu } from '../menu.js';\nimport { MenuScreen } from './common.js';\n\nconst SONG_IDS = Object.keys(SONGS);\nconst SFX_IDS = Object.keys(SFX_DEFS);\nconst SPEAKER_IDS = Object.keys(VOICES).filter((v) => v !== 'narrator');\nconst SPEAK = 'Thank you. I have written that down. Is that close?';\n\nexport class SoundTestScreen extends MenuScreen {\n  freezes = false;\n  constructor() {\n    const menu = new Menu([], { width: 320, onBack: () => App.stack.pop(this) });\n    super('soundtest', 'Sound Test', menu, { prompts: [['adjust', 'Change'], ['confirm', 'Play'], ['back', 'Back']] });\n    this.song = 0; this.sfx = 0; this.who = 0;\n    menu.setItems([\n      { label: 'Song', id: 'song', value: () => SONG_LABELS[SONG_IDS[this.song]], adjust: (d) => { this.song = (this.song + d + SONG_IDS.length) % SONG_IDS.length; }, action: () => App.music(SONG_IDS[this.song]) },\n      { label: 'Stop music', id: 'stop', action: () => App.music(null) },\n      { label: 'SFX', id: 'sfx', value: () => SFX_IDS[this.sfx], adjust: (d) => { this.sfx = (this.sfx + d + SFX_IDS.length) % SFX_IDS.length; }, action: () => App.sfx(SFX_IDS[this.sfx]), sound: 'menuMove' },\n      { label: 'Speaker', id: 'speaker', value: () => SPEAKER_IDS[this.who], adjust: (d) => { this.who = (this.who + d + SPEAKER_IDS.length) % SPEAKER_IDS.length; }, action: () => this.speak(), sound: 'menuMove' },\n    ]);\n  }\n  speak() {\n    const who = SPEAKER_IDS[this.who];\n    if (who === 'kevin') App.sfx('gullSquawk');\n    else App.speak(syllabify(SPEAK, who), who);\n  }\n}\nEOF\ncat > src/data/alllines.js <<'EOF'\n// Every line in one list, for the dialogue tester and the glyph and fit tests.\nimport { AGE_LINES, ATTRACT_LINES, BARKS, CONCERNS, CONFESSION, CONFESSION_AFTER, CREDITS_SIGNOFF, FERRY_LINES, HAMMOCK_LINES, INTRO_LINES, IDLE_BARKS, ISLAND_BARKS, LONG_STAND_LINES, MORNINGS, OW_JOKE, OW_LINES, REPORT_LINES, RESULT_LINES, STATION_REMARKS, WEEK2_LINES } from './lines.js';\nimport { DAYS } from './week.js';\nimport { QUESTIONS, AGE_QUESTION } from './questions.js';\nimport { MILESTONES } from './unlocks.js';\nimport { ACTIVITIES } from './activities.js';\nimport { HOLD_LINES } from './poses.js';\nimport { MEDLEY } from './medley.js';\n\nconst strip = (s) => (typeof s === 'string' ? s.replace(/^[a-z]+:\\s/, '') : s.text);\nconst whoOf = (s, fallback = 'ounce') => {\n  if (typeof s !== 'string') return s.who ?? fallback;\n  const m = /^([a-z]+):\\s/.exec(s);\n  return m ? m[1] : fallback;\n};\n\nexport function allLines() {\n  const out = [];\n  const push = (who, s) => out.push({ who: whoOf(s, who), text: strip(s) });\n  for (const set of Object.values(RESULT_LINES)) for (const list of Object.values(set)) for (const s of list) push('ounce', s);\n  for (const list of Object.values(BARKS)) for (const s of list) push('ounce', s);\n  for (const s of ISLAND_BARKS) push('ounce', s);\n  for (const list of Object.values(IDLE_BARKS)) for (const s of list) push('ounce', s);\n  for (const list of Object.values(AGE_LINES)) for (const s of list) push('ounce', s.replace('%A', '68').replace('%F', '30'));\n  for (const s of MORNINGS) push('ounce', s);\n  for (const s of OW_LINES) push('ounce', s);\n  push('ounce', OW_JOKE);\n  for (const s of INTRO_LINES) push('ounce', s);\n  for (const s of FERRY_LINES) push('narrator', s);\n  for (const s of CONCERNS) push('ounce', s);\n  for (const s of Object.values(REPORT_LINES)) push('ounce', s);\n  for (const s of Object.values(HAMMOCK_LINES)) push('ounce', s);\n  for (const s of Object.values(STATION_REMARKS)) push('ounce', s);\n  for (const s of Object.values(LONG_STAND_LINES)) push('coach', s);\n  for (const s of CONFESSION) push('ounce', s);\n  for (const s of CONFESSION_AFTER) push('ounce', s);\n  push('ounce', CREDITS_SIGNOFF);\n  for (const s of WEEK2_LINES) push('ounce', s);\n  for (const s of ATTRACT_LINES) push('ounce', s);\n  for (const d of DAYS) for (const s of d.beat) push('ounce', s);\n  for (const q of QUESTIONS) { push('ounce', q.q); for (const a of q.a) push('narrator', a); for (const r of q.r) push('ounce', r); }\n  push('ounce', AGE_QUESTION);\n  for (const m of MILESTONES) push('ounce', m.remark);\n  for (const a of Object.values(ACTIVITIES)) { push('coach', a.coach); push('narrator', a.goal); }\n  for (const s of HOLD_LINES) push('coach', s);\n  for (const list of Object.values(MEDLEY.remarks)) for (const s of list) push('ounce', s);\n  return out;\n}\nEOF\ncat > tools/build.mjs <<'EOF'\n// Bundle everything into one html in root, and write the exit interview from src/data/about.js.\nimport { execFileSync } from 'node:child_process';\nimport { mkdirSync, readFileSync, writeFileSync } from 'node:fs';\nimport { dirname, join } from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst DEV = join(dirname(fileURLToPath(import.meta.url)), '..');\nprocess.chdir(DEV);\nconst { BASE_NAME, TITLE } = await import('../src/data/title.js');\n\n// The kit asks for CREDITS.md to be shipped: it becomes a data module the About screen reads.\nconst credits = readFileSync('CREDITS.md', 'utf8');\nwriteFileSync('src/data/credits-text.js', `// Generated by tools/build.mjs from the kit's CREDITS.md.\\nexport const CREDITS_TEXT = ${JSON.stringify(credits)};\\n`);\n\nmkdirSync('.build', { recursive: true });\nexecFileSync('esbuild', ['src/main.js', '--bundle', '--format=esm', '--platform=browser', '--target=esnext', '--charset=utf8', '--outfile=.build/bundle.js', '--log-level=warning'], { stdio: 'inherit' });\n\nconst HUB_METAS = `<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Score the most across three events. Stay in the circle.\">\n<meta name=\"hub:session-howto\" content=\"Left stick, WASD or mouse: lean. R2, Space or click: breathe. L1/R1, F/J: step.\">\n<meta name=\"hub:session-minutes\" content=\"4\">\n<meta name=\"hub:webgpu\" content=\"required\">`;\n\nconst safe = (s) => s.replace(/<\\/script/gi, '<\\\\/script').replace(/<!--/g, '<\\\\!--');\nconst html = `<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<script>${readFileSync('vendor/hub/session.js', 'utf8')}</script>\n${HUB_METAS}\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n<link rel=\"icon\" href=\"data:,\"><title>${TITLE}</title>\n<style>html, body { margin: 0; height: 100%; background: #0d0b14; } #app { position: fixed; inset: 0; }</style>\n</head><body><div id=\"app\"></div>\n<script type=\"module\">${safe(readFileSync('.build/bundle.js', 'utf8'))}</script>\n</body></html>`;\nconst OUTPUT_HTML = join('..', `${BASE_NAME}.html`);\nwriteFileSync(OUTPUT_HTML, html);\n\nconst { exitInterview } = await import('../src/data/about.js');\nconst exitPath = join('..', 'exit-interview.json');\nwriteFileSync(exitPath, `${JSON.stringify(exitInterview(), null, 2)}\\n`);\nJSON.parse(readFileSync(exitPath, 'utf8'));\nEOF\necho 'export const CREDITS_TEXT = \"\";' > src/data/credits-text.js\necho ok","description":"Write about, dev tools, sound test screens and the build script","timeout":30000}}}
