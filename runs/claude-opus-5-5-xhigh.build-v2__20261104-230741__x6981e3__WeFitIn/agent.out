{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjJbhWF1TnW432YUPTyU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EkXppmxYUjjEsdF9LWwjNX","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/art/avatar.js <<'EOF'\n// People: the kit's hero, re-dressed on the same rig. One compiled clip set, shared.\nimport { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PALETTE, setLookLayer, SpringChain, Squash, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { ALL_CLIPS } from './clips.js';\n\nconst { AnimationMixer, BoxGeometry, ConeGeometry, CylinderGeometry, LoopOnce, LoopRepeat, Mesh, SphereGeometry, Vector3 } = THREE;\n\nfunction soften(mesh, kind = 'prism') { // same bounding box, softer shape\n  mesh.geometry.computeBoundingBox();\n  const b = mesh.geometry.boundingBox, s = b.getSize(new Vector3()), c = b.getCenter(new Vector3());\n  const g = kind === 'egg' ? new SphereGeometry(0.5, 10, 8) : new CylinderGeometry(0.5, 0.5, 1, 8);\n  g.scale(s.x, s.y, s.z); g.translate(c.x, c.y, c.z); mesh.geometry = g;\n}\n\nconst tone = (name) => toonMaterial(PALETTE[name]);\n\n/** look: { skin, top, bottom, shoe, hair, long?, bun?, headband?, hairStyle?, cape?, band2?, wrist?, visor?, whistle?, goldShoes? } */\nexport function dress(root, look) {\n  const hide = new Set(['Moustache', 'ButtonR', 'ButtonL', 'Hat', 'Brim', 'Eyes', 'Nose']);\n  const SLOT = {\n    Overalls: 'bottom', ThighR: 'bottom', ThighL: 'bottom', ShinR_Mesh: look.long ? 'bottom' : 'skin', ShinL_Mesh: look.long ? 'bottom' : 'skin',\n    Shirt: 'top', SleeveR: 'top', SleeveL: 'top', ForearmR_Mesh: look.long ? 'top' : 'skin', ForearmL_Mesh: look.long ? 'top' : 'skin',\n    GloveR: 'skin', GloveL: 'skin', Face: 'skin', ShoeR: 'shoe', ShoeL: 'shoe',\n  };\n  root.traverse((o) => {\n    if (!o.isMesh) return;\n    if (hide.has(o.name)) { o.visible = false; return; }\n    if (SLOT[o.name]) o.material = tone(look.goldShoes && SLOT[o.name] === 'shoe' ? 'sand' : look[SLOT[o.name]]);\n    if (o.name === 'Face') soften(o, 'egg');\n    else if (/Sleeve|Forearm|Thigh|Shin|Glove/.test(o.name)) soften(o);\n  });\n  const face = root.getObjectByName('Face');\n  face.geometry.computeBoundingBox();\n  const fb = face.geometry.boundingBox, size = fb.getSize(new Vector3()), c = fb.getCenter(new Vector3());\n  const add = (m, x, y, z, parent = face.parent) => { m.position.set(x, y, z); parent.add(m); return m; };\n  for (const sx of [-1, 1]) add(new Mesh(new BoxGeometry(0.055, 0.09, 0.03), tone('ink')), c.x + sx * size.x * 0.2, c.y + 0.02, c.z + size.z * 0.48);\n  add(new Mesh(new BoxGeometry(0.1, 0.022, 0.03), tone('ink')), c.x, c.y - size.y * 0.2, c.z + size.z * 0.47);\n  const style = look.hairStyle ?? 'cap';\n  if (style !== 'bald') {\n    const hair = add(new Mesh(new SphereGeometry(0.5, 10, 6, 0, Math.PI * 2, 0, Math.PI * (style === 'short' ? 0.42 : 0.55)), tone(look.hair)), c.x, c.y + size.y * 0.04, c.z - size.z * 0.05);\n    hair.scale.set(size.x * 1.08, size.y * 1.04, size.z * 1.08);\n    if (style === 'tall') {\n      const tuft = add(new Mesh(new CylinderGeometry(0.1, 0.16, 0.3, 7), tone(look.hair)), c.x, c.y + size.y * 0.62, c.z - size.z * 0.05);\n      tuft.rotation.x = -0.2;\n    } else if (style === 'side') {\n      add(new Mesh(new BoxGeometry(size.x * 0.32, size.y * 0.72, size.z * 0.7), tone(look.hair)), c.x - size.x * 0.46, c.y - size.y * 0.02, c.z - size.z * 0.1);\n    }\n  }\n  if (look.bun || style === 'bun') add(new Mesh(new SphereGeometry(0.1, 8, 6), tone(look.hair)), c.x, c.y + size.y * 0.6, c.z - size.z * 0.2);\n  const bandAt = (color, y) => {\n    const b2 = add(new Mesh(new CylinderGeometry(0.5, 0.5, 1, 10), tone(color)), c.x, c.y + y, c.z);\n    b2.scale.set(size.x * 1.06, 0.06, size.z * 1.06);\n  };\n  if (look.headband) bandAt(look.headband, size.y * 0.16);\n  if (look.band2) bandAt(look.band2, size.y * 0.3);\n  if (look.visor) {\n    const v = add(new Mesh(new BoxGeometry(size.x * 0.9, 0.04, size.z * 0.5), tone('cyan')), c.x, c.y + size.y * 0.24, c.z + size.z * 0.6);\n    v.rotation.x = 0.2;\n  }\n  const shirt = root.getObjectByName('Shirt');\n  if (shirt && (look.cape || look.whistle)) {\n    shirt.geometry.computeBoundingBox();\n    const sb = shirt.geometry.boundingBox, ss = sb.getSize(new Vector3()), sc = sb.getCenter(new Vector3());\n    if (look.cape) {\n      const cape = add(new Mesh(new BoxGeometry(ss.x * 1.1, ss.y * 1.7, 0.05), tone('white')), sc.x, sc.y - ss.y * 0.4, sc.z - ss.z * 0.62, shirt.parent);\n      cape.rotation.x = 0.1;\n    }\n    if (look.whistle) add(new Mesh(new BoxGeometry(0.08, 0.08, 0.05), tone('sand')), sc.x, sc.y + ss.y * 0.12, sc.z + ss.z * 0.56, shirt.parent);\n  }\n  if (look.wrist) {\n    for (const n of ['ForearmR_Mesh', 'ForearmL_Mesh']) {\n      const f = root.getObjectByName(n);\n      if (!f) continue;\n      f.geometry.computeBoundingBox();\n      const fbb = f.geometry.boundingBox, fs = fbb.getSize(new Vector3()), fc = fbb.getCenter(new Vector3());\n      const w = add(new Mesh(new CylinderGeometry(0.5, 0.5, 1, 8), tone('red')), fc.x, fc.y - fs.y * 0.3, fc.z, f.parent);\n      w.scale.set(fs.x * 1.2, fs.y * 0.24, fs.z * 1.2);\n    }\n  }\n}\n\nlet compiled = null;\nexport function clipsFor(model) {\n  if (!compiled) compiled = compileClips(ALL_CLIPS, HERO_RIG, model);\n  return compiled;\n}\n\nexport class Avatar {\n  feet = new Vector3();\n  yaw = 0;\n\n  constructor(ctx, root, look) {\n    this.ctx = ctx;\n    this.root = root;\n    this.look = look;\n    this.mixer = new AnimationMixer(root);\n    this.clips = new Map(clipsFor(root).map((c) => [c.name, c]));\n    this.actions = new Map();\n    this.current = null;\n    this.torso = root.getObjectByName('Torso');\n    this.pelvis = root.getObjectByName('Pelvis');\n    this.head = root.getObjectByName('Head');\n    this.squash = new Squash();\n    this.flash = 0;\n  }\n\n  action(name) {\n    let a = this.actions.get(name);\n    if (!a) {\n      const clip = this.clips.get(name);\n      if (!clip) throw new Error(`no clip ${name}`);\n      a = this.mixer.clipAction(clip);\n      this.actions.set(name, a);\n    }\n    return a;\n  }\n\n  play(name, { fade = 0.2, once = false, timeScale = 1, then = null } = {}) {\n    const a = this.action(name);\n    if (this.current === a && !once) { a.timeScale = timeScale; return a; }\n    a.paused = false;\n    a.enabled = true;\n    a.timeScale = timeScale;\n    a.reset();\n    a.setLoop(once ? LoopOnce : LoopRepeat, once ? 1 : Infinity);\n    a.clampWhenFinished = once;\n    a.play();\n    if (this.current && this.current !== a) this.current.crossFadeTo(a, fade, false);\n    this.current = a;\n    this.onceThen = once ? then : null;\n    this.onceClip = once ? a : null;\n    return a;\n  }\n\n  /** Scrub a clip with a value 0..1. */\n  scrub(name, r) {\n    const a = this.action(name);\n    if (this.current !== a) {\n      a.reset();\n      a.enabled = true;\n      a.setEffectiveWeight(1);\n      a.play();\n      if (this.current) this.current.stop();\n      this.current = a;\n    }\n    a.paused = true;\n    a.time = Math.max(0, Math.min(1, r)) * a.getClip().duration;\n  }\n\n  /** Lean the body: the player should be able to read the Dot from it. */\n  lean(x, y, tremble = 0, t = 0) {\n    if (this.torso) {\n      this.torso.rotateZ(-x * 0.18 + Math.sin(t * 37) * tremble * 0.03);\n      this.torso.rotateX(-y * 0.12 + Math.sin(t * 29) * tremble * 0.02);\n    }\n    if (this.pelvis) this.pelvis.position.x += x * 0.05 + Math.sin(t * 41) * tremble * 0.006;\n  }\n\n  update(dt) {\n    this.mixer.update(dt);\n    if (this.onceClip && this.onceThen && !this.onceClip.isRunning()) { const f = this.onceThen; this.onceThen = null; this.onceClip = null; f(); }\n    this.squash.update(dt);\n    const [h, v] = this.squash.scale();\n    this.root.scale.set(h, v, h);\n    if (this.shadow) this.shadow.place(this.root.position.x, this.groundY ?? 0, this.root.position.z, Math.max(0, this.root.position.y - (this.groundY ?? 0)));\n    if (this.plumb) this.updatePlumb(dt);\n  }\n\n  place(x, y, z, yaw = 0) {\n    this.root.position.set(x, y, z);\n    this.root.rotation.y = yaw;\n    this.yaw = yaw;\n    this.groundY = y;\n    return this;\n  }\n\n  /** Coach's plumb bob: a spring chain from her wrist that hangs dead true. */\n  addPlumb() {\n    const chain = new SpringChain({ segments: 5, length: 0.11, rest: [0, -1, 0], stiffness: 2, keep: 0.96, gravity: 9 });\n    const parts = [];\n    const string = toonMaterial(PALETTE.slate);\n    for (let i = 0; i < 5; i++) { const m = new Mesh(new BoxGeometry(0.03, 0.11, 0.03), string); parts.push(m); this.ctx.scene.add(m); }\n    const bob = new Mesh(new ConeGeometry(0.075, 0.18, 7), toonMaterial(PALETTE.red));\n    bob.rotation.x = Math.PI;\n    this.ctx.scene.add(bob);\n    setLookLayer(bob, 'actors');\n    this.plumb = { chain, parts, bob, hand: this.root.getObjectByName('HandR') ?? this.root, at: new Vector3(), started: false };\n  }\n\n  updatePlumb(dt) {\n    const p = this.plumb;\n    p.hand.getWorldPosition(p.at);\n    const root = [p.at.x, p.at.y, p.at.z];\n    const basis = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];\n    if (!p.started) { p.chain.reset(root, basis); p.started = true; }\n    p.chain.update(Math.min(dt, 1 / 30), root, basis);\n    const pts = p.chain.points;\n    for (let i = 0; i < p.parts.length; i++) {\n      const a = pts[i], b = pts[i + 1];\n      p.parts[i].position.set((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2);\n    }\n    const end = pts[pts.length - 1];\n    p.bob.position.set(end[0], end[1] - 0.08, end[2]);\n  }\n}\n\n/** Make a dressed avatar. */\nexport async function makeAvatar(ctx, look, { shadow = true, at = [0, 0, 0], yaw = 0, clip = 'Idle' } = {}) {\n  const root = (await ctx.loadModel(HERO_MODEL, { castShadow: false })).scene;\n  dress(root, look);\n  setLookLayer(root, 'actors');\n  ctx.scene.add(root);\n  const a = new Avatar(ctx, root, look);\n  if (shadow) { a.shadow = new ContactShadow(0.42); ctx.scene.add(a.shadow); }\n  a.place(at[0], at[1], at[2], yaw);\n  if (clip) a.play(clip, { fade: 0 });\n  return a;\n}\nEOF\ncat > src/art/props.js <<'EOF'\n// Placing models, and the two characters who aren't people: Ounce and Kevin.\nimport { addModelColliders, buildModel, setLookLayer, Squash, THREE } from '../../pixel-engine.js';\nimport { MODELS } from './models.js';\n\nconst { Vector3 } = THREE;\n\nexport function place(ctx, id, { at = [0, 0, 0], yaw = 0, scale = 1, palette, params, collide = false, shadow = true, actor = false, seed } = {}) {\n  const m = buildModel(id, { catalog: MODELS, palette, params, seed });\n  const o = m.object;\n  o.position.set(...at);\n  o.rotation.y = (yaw * Math.PI) / 180;\n  o.scale.setScalar(scale);\n  o.traverse((c) => { if (c.isMesh) { c.castShadow = shadow; c.receiveShadow = true; } });\n  o.updateMatrixWorld();\n  if (actor) setLookLayer(o, 'actors');\n  ctx.scene.add(o);\n  if (collide) addModelColliders(ctx.physics, m, at, o.rotation.y);\n  return m;\n}\n\nconst MOODS = {\n  neutral: { needle: 0, wiggle: 0.02 },\n  pleased: { needle: 26, wiggle: 0.04 },\n  smug: { needle: 42, wiggle: 0.01 },\n  droop: { needle: -66, wiggle: 0.01 },\n  alarm: { needle: 80, wiggle: 0.5 },\n  concern: { needle: -24, wiggle: 0.03 },\n  spin: { needle: 0, spin: 9 },\n};\nexport const OUNCE_MOODS = Object.keys(MOODS);\n\nexport class Ounce {\n  mood = 'neutral';\n  ang = 0; t = 0; spinning = 0;\n  hopT = 1; from = new Vector3(); to = new Vector3();\n  squash = new Squash();\n\n  constructor(ctx, { at = [0, 0, 0], yaw = 0, scale = 1.4 } = {}) {\n    this.ctx = ctx;\n    this.scale = scale;\n    this.build = place(ctx, 'ounce', { at, yaw, scale, actor: true });\n    this.root = this.build.object;\n    this.needle = this.root.getObjectByName('needle');\n    this.face = this.root.getObjectByName('face');\n    this.head = this.root.getObjectByName('head');\n    this.base = { x: this.needle.rotation.y };\n    this.pos = this.root.position;\n    this.faceTilt = this.face.rotation.x;\n    this.reading = null;\n  }\n\n  setMood(m) { if (MOODS[m]) this.mood = m; }\n  /** Point the needle: -1..1 of the dial, for a reading. null hands it back to mood. */\n  read(v) { this.reading = v; }\n\n  hopTo(x, z, dur = 0.34) {\n    this.from.copy(this.root.position);\n    this.to.set(x, this.root.position.y, z);\n    this.hopT = 0; this.hopDur = dur;\n    this.squash.kick(0.9);\n    this.ctx.audio.play('hop', { volume: 0.5 });\n  }\n\n  get hopping() { return this.hopT < 1; }\n\n  face2(x, z) {\n    const dx = x - this.root.position.x, dz = z - this.root.position.z;\n    this.root.rotation.y += ((Math.atan2(dx, dz) - this.root.rotation.y + Math.PI * 3) % (Math.PI * 2) - Math.PI) * 0.2;\n  }\n\n  update(dt) {\n    this.t += dt;\n    const m = MOODS[this.mood] ?? MOODS.neutral;\n    let target = (m.needle + Math.sin(this.t * 7) * m.wiggle * 60) * (Math.PI / 180);\n    if (this.reading !== null) target = this.reading * 2.2;\n    if (m.spin && this.reading === null) { this.ang += m.spin * dt; } else {\n      const wrap = ((target - this.ang + Math.PI * 3) % (Math.PI * 2)) - Math.PI;\n      this.ang += wrap * Math.min(1, dt * 12);\n    }\n    this.needle.rotation.y = this.base.x + this.ang;\n    this.face.rotation.x = this.faceTilt + Math.sin(this.t * 1.7) * 0.03;\n    if (this.hopT < 1) {\n      this.hopT = Math.min(1, this.hopT + dt / this.hopDur);\n      const u = this.hopT;\n      this.root.position.x = this.from.x + (this.to.x - this.from.x) * u;\n      this.root.position.z = this.from.z + (this.to.z - this.from.z) * u;\n      this.root.position.y = this.from.y + Math.sin(u * Math.PI) * 0.5;\n      if (u >= 1) { this.root.position.y = this.from.y; this.squash.kick(-1.1); }\n    }\n    this.squash.update(dt);\n    const [h, v] = this.squash.scale();\n    this.root.scale.set(h * this.scale, v * this.scale, h * this.scale);\n  }\n}\n\nexport class Kevin {\n  t = 0; flap = 1; state = 'sit';\n  from = new Vector3(); to = new Vector3(); u = 1; dur = 1;\n\n  constructor(ctx, { at = [0, 0, 0], yaw = 0, scale = 1 } = {}) {\n    this.ctx = ctx;\n    this.build = place(ctx, 'kevin', { at, yaw, scale, actor: true, shadow: false });\n    this.root = this.build.object;\n    this.wr = this.root.getObjectByName('wingR');\n    this.wl = this.root.getObjectByName('wingL');\n    this.visible = true;\n  }\n\n  flyTo(x, y, z, dur = 1.2) {\n    this.from.copy(this.root.position); this.to.set(x, y, z); this.u = 0; this.dur = dur; this.state = 'fly';\n    this.ctx.audio.play('gullSquawk', { volume: 0.6 });\n  }\n\n  /** Keep him on someone: call each frame with a world position. */\n  perch(v) { if (this.state !== 'fly') this.root.position.copy(v); }\n\n  update(dt) {\n    this.t += dt;\n    if (this.state === 'fly') {\n      this.u = Math.min(1, this.u + dt / this.dur);\n      const e = this.u * this.u * (3 - 2 * this.u);\n      this.root.position.lerpVectors(this.from, this.to, e);\n      this.root.position.y += Math.sin(this.u * Math.PI) * 1.2;\n      const dx = this.to.x - this.from.x, dz = this.to.z - this.from.z;\n      if (Math.abs(dx) + Math.abs(dz) > 0.01) this.root.rotation.y = Math.atan2(dx, dz);\n      if (this.u >= 1) this.state = 'sit';\n    }\n    const f = this.state === 'fly' ? Math.sin(this.t * 22) * 0.9 : -1.25 + Math.sin(this.t * 2.1) * 0.03;\n    this.wr.rotation.z = f;\n    this.wl.rotation.z = -f;\n  }\n}\nEOF\ncat > src/ui/dialogue.js <<'EOF'\n// Dialogue: bottom strip, typewriter in step with the voice, a dial portrait for Ounce.\nimport { App } from '../app.js';\nimport { CONFIRM } from '../core/actions.js';\nimport { revealAt, syllabify, voiceLength } from '../audio/voice.js';\nimport { SPEAKERS } from '../data/classmates.js';\nimport { say, sanitize, wrap, charsIn, textWidth } from './font.js';\nimport { disc, line, panel, ring } from './widgets.js';\nimport { promptBar } from './prompts.js';\n\nconst MOOD_ANGLE = { neutral: 0, pleased: 0.45, smug: 0.75, droop: -1.15, alarm: 1.4, concern: -0.42, spin: 0 };\n\nexport function drawOuncePortrait(hud, x, y, r, mood = 'neutral', t = 0) {\n  disc(hud, x, y, r + 2, 'slate');\n  disc(hud, x, y, r, 'white');\n  for (const a of [-1, -0.5, 0, 0.5, 1]) {\n    hud.rect(Math.round(x + Math.sin(a) * (r - 2)), Math.round(y - Math.cos(a) * (r - 2)), 1, 1, 'mist');\n  }\n  hud.rect(x - 4, y - 3, 2, 3, 'ink');\n  hud.rect(x + 3, y - 3, 2, 3, 'ink');\n  const a = mood === 'spin' ? t * 9 : (MOOD_ANGLE[mood] ?? 0) + Math.sin(t * 5) * 0.03;\n  line(hud, x, y + 1, x + Math.sin(a) * (r - 3), y + 1 - Math.cos(a) * (r - 3), 'red', 1);\n  disc(hud, x, y + 1, 1, 'red');\n}\n\n/** Lines: strings \"who: text\" or { who, text, mood, run }. */\nexport function normaliseLines(lines) {\n  return (Array.isArray(lines) ? lines : [lines]).map((l) => {\n    if (typeof l !== 'string') return l;\n    const m = /^([a-z]+):\\s?(.*)$/s.exec(l);\n    return m && SPEAKERS[m[1]] ? { who: m[1], text: m[2] } : { who: 'narrator', text: l };\n  });\n}\n\nexport class DialogueScreen {\n  name = 'dialogue';\n  i = 0; t = 0; shown = 0; complete = false; hold = 0;\n\n  constructor(lines, { onDone = null, skippable = true } = {}) {\n    this.lines = normaliseLines(lines);\n    this.onDone = onDone;\n    this.skippable = skippable;\n  }\n\n  onOpen() { this.begin(); }\n\n  begin() {\n    const l = this.lines[this.i];\n    if (!l) return;\n    l.run?.();\n    this.text = sanitize(l.text);\n    this.syl = syllabify(this.text, l.who);\n    this.dur = voiceLength(this.syl);\n    this.t = 0; this.complete = false; this.shown = 0;\n    if (l.who === 'kevin') App.sfx('gullSquawk');\n    else App.speak(this.syl, l.who);\n    if (l.mood && App.scene?.ounce) App.scene.ounce.setMood(l.mood);\n  }\n\n  advance() {\n    App.voice.stop();\n    this.i++;\n    if (this.i >= this.lines.length) {\n      App.stack.pop(this);\n      this.onDone?.();\n      return;\n    }\n    this.begin();\n  }\n\n  update(ctx, dt) {\n    const uiDt = dt || 1 / 60;\n    const { input } = ctx;\n    const pressed = input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft');\n    const held = input.anyDown(CONFIRM) || input.isDown('MouseLeft');\n    this.hold = held ? this.hold + uiDt : 0;\n    this.t += uiDt * (this.hold > 0.45 ? 4 : 1);\n    this.shown = revealAt(this.syl, this.text, this.t);\n    if (!this.complete && (this.t >= this.dur + 0.05 || this.shown >= this.text.length)) { this.complete = true; this.shown = this.text.length; }\n    if (pressed) {\n      if (!this.complete) { this.complete = true; this.shown = this.text.length; this.t = this.dur + 1; App.voice.stop(); } else this.advance();\n    } else if (this.complete && this.hold > 0.45) this.advance();\n  }\n\n  draw(ctx) {\n    const l = this.lines[this.i];\n    if (!l) return;\n    drawDialogueBox(ctx.hud, l.who, this.text.slice(0, this.shown), this.text, l.mood, this.t);\n    const y = ctx.hud.height - 17;\n    if (this.complete) promptBar(ctx.hud, App.device, [['confirm', 'Next']], { y, strip: false });\n  }\n}\n\n/** Box shared by dialogue and barks. Returns its rect. */\nexport function drawDialogueBox(hud, who, shownText, fullText, mood = 'neutral', t = 0) {\n  const speaker = SPEAKERS[who] ?? SPEAKERS.narrator;\n  const portrait = who === 'ounce' ? 26 : 0;\n  const w = Math.min(hud.width - 24, 338 + portrait);\n  const x = Math.round((hud.width - w) / 2);\n  const textW = w - 14 - portrait;\n  const cols = charsIn(textW);\n  const lines = wrap(fullText, cols);\n  const nameH = speaker.name ? 12 : 0;\n  const h = Math.max(portrait ? 34 : 0, nameH + lines.length * 11 + 10);\n  const y = hud.height - h - 22;\n  panel(hud, x, y, w, h, { fill: 'white', border: 'ink', name: 'dialogue' });\n  if (portrait) drawOuncePortrait(hud, x + 15, y + Math.round(h / 2), 11, mood, t);\n  const tx = x + 7 + portrait;\n  if (speaker.name) say(hud, tx, y + 4, speaker.name, { color: speaker.color, shadow: false, name: 'speaker' });\n  // Print the typewriter's part of the wrapped text, so words never jump lines.\n  let left = shownText.length;\n  lines.forEach((ln, i) => {\n    const part = ln.slice(0, Math.max(0, left));\n    if (part) say(hud, tx, y + 4 + nameH + i * 11, part, { color: 'ink', shadow: false, name: 'dialogue-text' });\n    left -= ln.length + 1;\n  });\n  return { x, y, w, h };\n}\n\n/** A remark that doesn't stop anything: small, up for a few seconds, voiced. */\nexport class Bark {\n  who = null; text = ''; t = 0; dur = 0;\n  say(who, text) {\n    this.who = who;\n    this.text = sanitize(text);\n    this.syl = syllabify(this.text, who);\n    this.t = 0;\n    this.dur = Math.max(2.4, voiceLength(this.syl) + 1.5);\n    if (who === 'kevin') App.sfx('gullSquawk'); else App.speak(this.syl, who);\n  }\n  get active() { return this.who !== null; }\n  tick(dt) {\n    if (!this.who) return;\n    this.t += dt;\n    if (this.t > this.dur) this.who = null;\n  }\n  draw(hud) {\n    if (!this.who) return;\n    drawDialogueBox(hud, this.who, this.text.slice(0, revealAt(this.syl, this.text, this.t)), this.text, 'neutral', this.t);\n  }\n}\n\nexport { ring, textWidth };\nEOF\ncat > src/app.js <<'EOF'\n// App: what outlives a scene. Save, settings, tunables, device, scene switching, debug API.\nimport { PALETTE, THREE } from '../pixel-engine.js';\nimport { PAD_BUTTONS } from './core/actions.js';\nimport { Device } from './core/device.js';\nimport { DEFAULT_SETTINGS, Store } from './core/save.js';\nimport { T } from './core/tunables.js';\nimport { VoicePlayer } from './audio/voice.js';\nimport { SONGS } from './audio/songs.js';\nimport { registerSfx } from './audio/sfx.js';\nimport { ScreenStack } from './ui/stack.js';\nimport { layout } from './ui/layout.js';\n\nexport const APP_LOOKS = { default: undefined, storybook: 'storybook', arcade: 'arcade', handheld: 'handheld' };\n\nexport const App = {\n  engine: null, ctx: null, scene: null,\n  T,\n  device: new Device(),\n  stack: new ScreenStack(),\n  voice: new VoicePlayer(),\n  store: null,\n  session: null,\n  touchOnly: false,\n  scenes: {},\n  loading: false,\n  queued: null,\n  attract: null,\n  dev: { god: false, autopilot: null, overlay: false, hideHud: false, timeScale: 1, freeCam: false, allUnlocked: false },\n  bark: null,\n  frame: 0,\n  uiT: 0,\n\n  registerScenes(map) { Object.assign(this.scenes, map); },\n\n  init(engine, { storage = null, session = null } = {}) {\n    this.engine = engine;\n    this.session = session;\n    this.store = this.store ?? new Store(storage);\n    const input = engine.input;\n    input.gamepadButtons = { ...PAD_BUTTONS };\n    input.gamepadDeadzone = 0.12;\n    registerSfx(engine.audio);\n    this.applySettings();\n  },\n\n  get settings() { return this.store?.settings ?? DEFAULT_SETTINGS; },\n  get slot() { return this.store?.slot ?? null; },\n\n  /** Every boot, from our own settings: the engine's own stored volume is shared by every engine game. */\n  applySettings() {\n    const s = this.settings;\n    const audio = this.engine?.audio;\n    if (audio) {\n      audio.setVolume('music', s.music);\n      audio.setVolume('sfx', s.sfx);\n    }\n    this.voice.setLevel(s.voice);\n    this.device.glyphs = s.glyphs;\n    T.mouseLeanRadius = s.mouseLeanRadius;\n    T.stepOffsetMs = s.stepOffsetMs;\n    if (this.engine?.settings) {\n      const look = APP_LOOKS[s.look];\n      const patch = {};\n      if ((this.engine.settings.values.look ?? undefined) !== look) patch.look = look;\n      const px = s.pixelSize ? 'chunky' : undefined;\n      if ((this.engine.settings.values.pixelSize ?? undefined) !== px) patch.pixelSize = px;\n      if (Object.keys(patch).length) this.engine.settings.set(patch);\n    }\n  },\n\n  saveSettings() { this.applySettings(); this.store.write(); },\n\n  /** A ring radius after the player's and the designer's scaling. */\n  ringOf(r) { return r * T.ringScale * (this.settings.gentle ? 1.25 : 1); },\n  noiseScale() { return this.settings.gentle ? 0.8 : 1; },\n\n  sfx(name, opts) { return this.ctx?.audio.play(name, opts); },\n  music(name) {\n    const song = name ? SONGS[name] : null;\n    this.ctx?.audio.playMusic(song, name ?? 'song');\n    this.songName = name ?? null;\n  },\n  speak(syllables, who) { if (this.ctx) this.voice.speak(this.ctx.audio, syllables, who); },\n  say(who, text) { this.bark?.say(who, text); },\n\n  flash(color = 'white', o = { duration: 0.1 }) {\n    if (!this.settings.reduceFlashes) this.engine?.screen.flash(color, o);\n  },\n\n  attach(ctx, scene) {\n    this.ctx = ctx;\n    this.scene = scene;\n    this.stack.clear();\n    this.voice.stop();\n  },\n\n  scene2(id) {\n    const f = this.scenes[id];\n    if (!f) throw new Error(`no scene ${id}`);\n    return f;\n  },\n\n  /** Switch scene with an iris. A second call while one is under way waits its turn. */\n  async go(id, args = {}, { transition = 'iris' } = {}) {\n    if (this.loading) { this.queued = [id, args, { transition }]; return; }\n    this.loading = true;\n    const engine = this.engine;\n    try {\n      const make = this.scene2(id);\n      if (transition) await engine.screen.cover(transition, { duration: 0.28 });\n      const scene = make(args);\n      await engine.loadGame(scene, { camera: scene.cameraConfig?.() });\n      engine.timeScale = this.dev.timeScale;\n      if (transition) await engine.screen.reveal(transition, { duration: 0.28 });\n    } finally {\n      this.loading = false;\n    }\n    if (this.queued) {\n      const q = this.queued;\n      this.queued = null;\n      await this.go(...q);\n    }\n  },\n\n  /** For tests: the whole picture as data. */\n  state() {\n    const engine = this.engine;\n    const slot = this.slot;\n    return {\n      scene: this.scene?.id ?? null,\n      status: this.scene?.status?.(this.ctx) ?? '',\n      stack: this.stack.names(),\n      device: this.device.last,\n      glyphs: this.device.glyphs,\n      column: this.device.promptColumn(),\n      prompts: [...layout.prompts],\n      day: slot?.day ?? null, week: slot?.week ?? null, drips: slot?.drips ?? null, phase: slot?.phase ?? null,\n      music: engine?.audio.volume.music ?? null,\n      attract: !!this.attract,\n      timeScale: engine?.timeScale ?? 1,\n      loading: this.loading,\n      songName: this.songName ?? null,\n      session: !!this.session,\n    };\n  },\n\n  setDriver(skill) { this.dev.autopilot = skill; },\n  tunables: T,\n  palette: PALETTE,\n  THREE,\n};\n\nglobalThis.__GAME__ = App;\nEOF\ncat > src/scenes/base.js <<'EOF'\n// BaseScene owns the frame order: update -> device -> overlays take input first -> scene ->\n// hud.clear() -> scene draw -> overlays draw. Gameplay goes in onFixed, skipped while timeScale is 0.\nimport { THREE } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { Bark } from '../ui/dialogue.js';\nimport { layout } from '../ui/layout.js';\nimport { say, sayRight } from '../ui/font.js';\nimport { drawGlyph } from '../art/glyphs.js';\nimport { PAUSE_KEYS } from '../core/actions.js';\n\nconst { Vector3 } = THREE;\n\nexport class BaseScene {\n  name = 'Scene';\n  id = 'scene';\n  canPause = false;       // Esc / Options opens the pause menu\n  allowsAttract = false;  // the title and its menus\n  idle = 0;\n  focus = new Vector3();\n  args = {};\n  t = 0;\n\n  constructor(args = {}) { this.args = args; }\n\n  cameraConfig() { return undefined; }\n\n  async setup(ctx) {\n    this.ctx = ctx;\n    App.attach(ctx, this);\n    this.bark = new Bark();\n    App.bark = this.bark;\n    await this.build(ctx);\n  }\n\n  async build() {}\n  ready() { App.onSceneReady?.(this); }\n\n  get paused() { return App.stack.open && App.stack.screens.some((s) => s.freezes); }\n  /** True when something else has the input. */\n  get blocked() { return App.loading || App.stack.open; }\n\n  fixedUpdate(ctx, dt) { this.onFixed(ctx, dt); }\n  onFixed() {}\n\n  update(ctx, dt) {\n    App.frame++;\n    const uiDt = dt || 1 / 60;\n    App.uiT += uiDt;\n    this.t += dt;\n    layout.begin();\n    App.device.update(ctx);\n    this.bark.tick(dt);\n    if (App.attract) App.attract.tick(ctx, uiDt);\n\n    if (this.allowsAttract && !App.session && !App.attract) {\n      if (App.device.anyInput || App.loading) this.idle = 0;\n      else this.idle += uiDt;\n      if (this.idle >= 10) { this.idle = 0; App.startAttract?.(); }\n    }\n\n    const hadOverlay = App.stack.open;\n    if (!App.loading && !App.attract) App.stack.update(ctx, dt);\n    if (!App.stack.open && !hadOverlay && !App.loading && !App.attract) {\n      if (this.canPause && this.pausePressed(ctx)) App.openPause?.();\n      else this.onInput(ctx, dt);\n    }\n    if (App.dev.freeCam) { /* the free camera reads input itself */ }\n    this.onUpdate(ctx, dt);\n    ctx.hud.clear();\n    if (!App.dev.hideHud) {\n      this.onDraw(ctx, dt);\n      App.stack.draw(ctx, dt);\n      if (!App.stack.open) this.bark.draw(ctx.hud);\n      this.drawPauseIcon(ctx);\n    }\n    if (App.attract) App.attract.draw(ctx);\n    if (App.dev.overlay) this.drawOverlay(ctx);\n  }\n\n  pausePressed(ctx) {\n    const { input } = ctx;\n    if (input.wasPressed(...PAUSE_KEYS)) return true;\n    if (input.wasPressed('PadOptions') && !input.isDown('PadCreate')) return true;\n    if (this.pauseIconHit && input.wasPressed('MouseLeft')) {\n      const p = App.device.pointerArt(ctx);\n      const r = this.pauseIconHit;\n      if (p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h) return true;\n    }\n    return false;\n  }\n\n  /** Top right, while the mouse moves. */\n  drawPauseIcon(ctx) {\n    if (!this.canPause || App.stack.open || App.attract || App.session) { this.pauseIconHit = null; return; }\n    if (App.device.moved > 0) this.iconT = 2.5;\n    this.iconT = Math.max(0, (this.iconT ?? 0) - (1 / 60));\n    if (this.iconT <= 0 || App.device.last !== 'mouse') { this.pauseIconHit = null; return; }\n    const x = ctx.hud.width - 12 - 11;\n    const y = 6;\n    drawGlyph(ctx.hud, x, y, 'pauseIcon');\n    this.pauseIconHit = { x: x - 3, y: y - 3, w: 17, h: 17 };\n  }\n\n  onInput() {}\n  onUpdate() {}\n  onDraw() {}\n\n  /** Dev overlay: scene, state, Dot, ring, fps, last device. */\n  drawOverlay(ctx) {\n    const { hud } = ctx;\n    const rows = [\n      `scene ${this.id}`,\n      `${String(this.status(ctx)).slice(0, 44)}`,\n      `dot ${this.overlayDot?.() ?? '-'}`,\n      `fps ${Math.round(ctx.engine.fps)}  device ${App.device.last}`,\n      `t ${ctx.time.toFixed(1)}  scale ${ctx.engine.timeScale}`,\n    ];\n    hud.rect(0, 40, 200, rows.length * 10 + 4, 'ink');\n    rows.forEach((r, i) => say(hud, 3, 42 + i * 10, r, { color: 'lime', shadow: false, name: 'overlay' }));\n    void sayRight;\n  }\n\n  cameraTarget() { return this.focus; }\n  status() { return this.id; }\n  fingerprint() { return ''; }\n}\n\n/** A fixed lane camera, pushed back on narrow windows so outer mats don't clip. */\nexport function aspectDistance() {\n  const a = typeof window !== 'undefined' && window.innerHeight ? window.innerWidth / window.innerHeight : 16 / 9;\n  return Math.max(1, (16 / 9) / a);\n}\n\nexport function laneCamera(mats) {\n  const k = aspectDistance();\n  if (mats >= 4) return { preset: 'fixed', position: [0, 3 * k, 9.5 * k], target: [0, 1, 0], fov: 32 };\n  return { preset: 'fixed', position: [0, 2.3 * k, 8.2 * k], target: [0, 1.15, 0], fov: 30 };\n}\nEOF\necho done","description":"Write avatars, props, dialogue, App and the base scene","timeout":30000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6330,"cache_read_input_tokens":267529,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6330},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"c09dfbc1-881c-46b1-83d5-0db587937ef9","timestamp":"2026-11-05T06:27:26.196Z","request_id":"req_011CgjJbh8RmmtsZqKkdjogq","wire_tool_inputs":{"toolu_01EkXppmxYUjjEsdF9LWwjNX":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/art/avatar.js <<'EOF'\n// People: the kit's hero, re-dressed on the same rig. One compiled clip set, shared.\nimport { compileClips, ContactShadow, HERO_MODEL, HERO_RIG, PALETTE, setLookLayer, SpringChain, Squash, THREE, toonMaterial } from '../../pixel-engine.js';\nimport { ALL_CLIPS } from './clips.js';\n\nconst { AnimationMixer, BoxGeometry, ConeGeometry, CylinderGeometry, LoopOnce, LoopRepeat, Mesh, SphereGeometry, Vector3 } = THREE;\n\nfunction soften(mesh, kind = 'prism') { // same bounding box, softer shape\n  mesh.geometry.computeBoundingBox();\n  const b = mesh.geometry.boundingBox, s = b.getSize(new Vector3()), c = b.getCenter(new Vector3());\n  const g = kind === 'egg' ? new SphereGeometry(0.5, 10, 8) : new CylinderGeometry(0.5, 0.5, 1, 8);\n  g.scale(s.x, s.y, s.z); g.translate(c.x, c.y, c.z); mesh.geometry = g;\n}\n\nconst tone = (name) => toonMaterial(PALETTE[name]);\n\n/** look: { skin, top, bottom, shoe, hair, long?, bun?, headband?, hairStyle?, cape?, band2?, wrist?, visor?, whistle?, goldShoes? } */\nexport function dress(root, look) {\n  const hide = new Set(['Moustache', 'ButtonR', 'ButtonL', 'Hat', 'Brim', 'Eyes', 'Nose']);\n  const SLOT = {\n    Overalls: 'bottom', ThighR: 'bottom', ThighL: 'bottom', ShinR_Mesh: look.long ? 'bottom' : 'skin', ShinL_Mesh: look.long ? 'bottom' : 'skin',\n    Shirt: 'top', SleeveR: 'top', SleeveL: 'top', ForearmR_Mesh: look.long ? 'top' : 'skin', ForearmL_Mesh: look.long ? 'top' : 'skin',\n    GloveR: 'skin', GloveL: 'skin', Face: 'skin', ShoeR: 'shoe', ShoeL: 'shoe',\n  };\n  root.traverse((o) => {\n    if (!o.isMesh) return;\n    if (hide.has(o.name)) { o.visible = false; return; }\n    if (SLOT[o.name]) o.material = tone(look.goldShoes && SLOT[o.name] === 'shoe' ? 'sand' : look[SLOT[o.name]]);\n    if (o.name === 'Face') soften(o, 'egg');\n    else if (/Sleeve|Forearm|Thigh|Shin|Glove/.test(o.name)) soften(o);\n  });\n  const face = root.getObjectByName('Face');\n  face.geometry.computeBoundingBox();\n  const fb = face.geometry.boundingBox, size = fb.getSize(new Vector3()), c = fb.getCenter(new Vector3());\n  const add = (m, x, y, z, parent = face.parent) => { m.position.set(x, y, z); parent.add(m); return m; };\n  for (const sx of [-1, 1]) add(new Mesh(new BoxGeometry(0.055, 0.09, 0.03), tone('ink')), c.x + sx * size.x * 0.2, c.y + 0.02, c.z + size.z * 0.48);\n  add(new Mesh(new BoxGeometry(0.1, 0.022, 0.03), tone('ink')), c.x, c.y - size.y * 0.2, c.z + size.z * 0.47);\n  const style = look.hairStyle ?? 'cap';\n  if (style !== 'bald') {\n    const hair = add(new Mesh(new SphereGeometry(0.5, 10, 6, 0, Math.PI * 2, 0, Math.PI * (style === 'short' ? 0.42 : 0.55)), tone(look.hair)), c.x, c.y + size.y * 0.04, c.z - size.z * 0.05);\n    hair.scale.set(size.x * 1.08, size.y * 1.04, size.z * 1.08);\n    if (style === 'tall') {\n      const tuft = add(new Mesh(new CylinderGeometry(0.1, 0.16, 0.3, 7), tone(look.hair)), c.x, c.y + size.y * 0.62, c.z - size.z * 0.05);\n      tuft.rotation.x = -0.2;\n    } else if (style === 'side') {\n      add(new Mesh(new BoxGeometry(size.x * 0.32, size.y * 0.72, size.z * 0.7), tone(look.hair)), c.x - size.x * 0.46, c.y - size.y * 0.02, c.z - size.z * 0.1);\n    }\n  }\n  if (look.bun || style === 'bun') add(new Mesh(new SphereGeometry(0.1, 8, 6), tone(look.hair)), c.x, c.y + size.y * 0.6, c.z - size.z * 0.2);\n  const bandAt = (color, y) => {\n    const b2 = add(new Mesh(new CylinderGeometry(0.5, 0.5, 1, 10), tone(color)), c.x, c.y + y, c.z);\n    b2.scale.set(size.x * 1.06, 0.06, size.z * 1.06);\n  };\n  if (look.headband) bandAt(look.headband, size.y * 0.16);\n  if (look.band2) bandAt(look.band2, size.y * 0.3);\n  if (look.visor) {\n    const v = add(new Mesh(new BoxGeometry(size.x * 0.9, 0.04, size.z * 0.5), tone('cyan')), c.x, c.y + size.y * 0.24, c.z + size.z * 0.6);\n    v.rotation.x = 0.2;\n  }\n  const shirt = root.getObjectByName('Shirt');\n  if (shirt && (look.cape || look.whistle)) {\n    shirt.geometry.computeBoundingBox();\n    const sb = shirt.geometry.boundingBox, ss = sb.getSize(new Vector3()), sc = sb.getCenter(new Vector3());\n    if (look.cape) {\n      const cape = add(new Mesh(new BoxGeometry(ss.x * 1.1, ss.y * 1.7, 0.05), tone('white')), sc.x, sc.y - ss.y * 0.4, sc.z - ss.z * 0.62, shirt.parent);\n      cape.rotation.x = 0.1;\n    }\n    if (look.whistle) add(new Mesh(new BoxGeometry(0.08, 0.08, 0.05), tone('sand')), sc.x, sc.y + ss.y * 0.12, sc.z + ss.z * 0.56, shirt.parent);\n  }\n  if (look.wrist) {\n    for (const n of ['ForearmR_Mesh', 'ForearmL_Mesh']) {\n      const f = root.getObjectByName(n);\n      if (!f) continue;\n      f.geometry.computeBoundingBox();\n      const fbb = f.geometry.boundingBox, fs = fbb.getSize(new Vector3()), fc = fbb.getCenter(new Vector3());\n      const w = add(new Mesh(new CylinderGeometry(0.5, 0.5, 1, 8), tone('red')), fc.x, fc.y - fs.y * 0.3, fc.z, f.parent);\n      w.scale.set(fs.x * 1.2, fs.y * 0.24, fs.z * 1.2);\n    }\n  }\n}\n\nlet compiled = null;\nexport function clipsFor(model) {\n  if (!compiled) compiled = compileClips(ALL_CLIPS, HERO_RIG, model);\n  return compiled;\n}\n\nexport class Avatar {\n  feet = new Vector3();\n  yaw = 0;\n\n  constructor(ctx, root, look) {\n    this.ctx = ctx;\n    this.root = root;\n    this.look = look;\n    this.mixer = new AnimationMixer(root);\n    this.clips = new Map(clipsFor(root).map((c) => [c.name, c]));\n    this.actions = new Map();\n    this.current = null;\n    this.torso = root.getObjectByName('Torso');\n    this.pelvis = root.getObjectByName('Pelvis');\n    this.head = root.getObjectByName('Head');\n    this.squash = new Squash();\n    this.flash = 0;\n  }\n\n  action(name) {\n    let a = this.actions.get(name);\n    if (!a) {\n      const clip = this.clips.get(name);\n      if (!clip) throw new Error(`no clip ${name}`);\n      a = this.mixer.clipAction(clip);\n      this.actions.set(name, a);\n    }\n    return a;\n  }\n\n  play(name, { fade = 0.2, once = false, timeScale = 1, then = null } = {}) {\n    const a = this.action(name);\n    if (this.current === a && !once) { a.timeScale = timeScale; return a; }\n    a.paused = false;\n    a.enabled = true;\n    a.timeScale = timeScale;\n    a.reset();\n    a.setLoop(once ? LoopOnce : LoopRepeat, once ? 1 : Infinity);\n    a.clampWhenFinished = once;\n    a.play();\n    if (this.current && this.current !== a) this.current.crossFadeTo(a, fade, false);\n    this.current = a;\n    this.onceThen = once ? then : null;\n    this.onceClip = once ? a : null;\n    return a;\n  }\n\n  /** Scrub a clip with a value 0..1. */\n  scrub(name, r) {\n    const a = this.action(name);\n    if (this.current !== a) {\n      a.reset();\n      a.enabled = true;\n      a.setEffectiveWeight(1);\n      a.play();\n      if (this.current) this.current.stop();\n      this.current = a;\n    }\n    a.paused = true;\n    a.time = Math.max(0, Math.min(1, r)) * a.getClip().duration;\n  }\n\n  /** Lean the body: the player should be able to read the Dot from it. */\n  lean(x, y, tremble = 0, t = 0) {\n    if (this.torso) {\n      this.torso.rotateZ(-x * 0.18 + Math.sin(t * 37) * tremble * 0.03);\n      this.torso.rotateX(-y * 0.12 + Math.sin(t * 29) * tremble * 0.02);\n    }\n    if (this.pelvis) this.pelvis.position.x += x * 0.05 + Math.sin(t * 41) * tremble * 0.006;\n  }\n\n  update(dt) {\n    this.mixer.update(dt);\n    if (this.onceClip && this.onceThen && !this.onceClip.isRunning()) { const f = this.onceThen; this.onceThen = null; this.onceClip = null; f(); }\n    this.squash.update(dt);\n    const [h, v] = this.squash.scale();\n    this.root.scale.set(h, v, h);\n    if (this.shadow) this.shadow.place(this.root.position.x, this.groundY ?? 0, this.root.position.z, Math.max(0, this.root.position.y - (this.groundY ?? 0)));\n    if (this.plumb) this.updatePlumb(dt);\n  }\n\n  place(x, y, z, yaw = 0) {\n    this.root.position.set(x, y, z);\n    this.root.rotation.y = yaw;\n    this.yaw = yaw;\n    this.groundY = y;\n    return this;\n  }\n\n  /** Coach's plumb bob: a spring chain from her wrist that hangs dead true. */\n  addPlumb() {\n    const chain = new SpringChain({ segments: 5, length: 0.11, rest: [0, -1, 0], stiffness: 2, keep: 0.96, gravity: 9 });\n    const parts = [];\n    const string = toonMaterial(PALETTE.slate);\n    for (let i = 0; i < 5; i++) { const m = new Mesh(new BoxGeometry(0.03, 0.11, 0.03), string); parts.push(m); this.ctx.scene.add(m); }\n    const bob = new Mesh(new ConeGeometry(0.075, 0.18, 7), toonMaterial(PALETTE.red));\n    bob.rotation.x = Math.PI;\n    this.ctx.scene.add(bob);\n    setLookLayer(bob, 'actors');\n    this.plumb = { chain, parts, bob, hand: this.root.getObjectByName('HandR') ?? this.root, at: new Vector3(), started: false };\n  }\n\n  updatePlumb(dt) {\n    const p = this.plumb;\n    p.hand.getWorldPosition(p.at);\n    const root = [p.at.x, p.at.y, p.at.z];\n    const basis = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];\n    if (!p.started) { p.chain.reset(root, basis); p.started = true; }\n    p.chain.update(Math.min(dt, 1 / 30), root, basis);\n    const pts = p.chain.points;\n    for (let i = 0; i < p.parts.length; i++) {\n      const a = pts[i], b = pts[i + 1];\n      p.parts[i].position.set((a[0] + b[0]) / 2, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2);\n    }\n    const end = pts[pts.length - 1];\n    p.bob.position.set(end[0], end[1] - 0.08, end[2]);\n  }\n}\n\n/** Make a dressed avatar. */\nexport async function makeAvatar(ctx, look, { shadow = true, at = [0, 0, 0], yaw = 0, clip = 'Idle' } = {}) {\n  const root = (await ctx.loadModel(HERO_MODEL, { castShadow: false })).scene;\n  dress(root, look);\n  setLookLayer(root, 'actors');\n  ctx.scene.add(root);\n  const a = new Avatar(ctx, root, look);\n  if (shadow) { a.shadow = new ContactShadow(0.42); ctx.scene.add(a.shadow); }\n  a.place(at[0], at[1], at[2], yaw);\n  if (clip) a.play(clip, { fade: 0 });\n  return a;\n}\nEOF\ncat > src/art/props.js <<'EOF'\n// Placing models, and the two characters who aren't people: Ounce and Kevin.\nimport { addModelColliders, buildModel, setLookLayer, Squash, THREE } from '../../pixel-engine.js';\nimport { MODELS } from './models.js';\n\nconst { Vector3 } = THREE;\n\nexport function place(ctx, id, { at = [0, 0, 0], yaw = 0, scale = 1, palette, params, collide = false, shadow = true, actor = false, seed } = {}) {\n  const m = buildModel(id, { catalog: MODELS, palette, params, seed });\n  const o = m.object;\n  o.position.set(...at);\n  o.rotation.y = (yaw * Math.PI) / 180;\n  o.scale.setScalar(scale);\n  o.traverse((c) => { if (c.isMesh) { c.castShadow = shadow; c.receiveShadow = true; } });\n  o.updateMatrixWorld();\n  if (actor) setLookLayer(o, 'actors');\n  ctx.scene.add(o);\n  if (collide) addModelColliders(ctx.physics, m, at, o.rotation.y);\n  return m;\n}\n\nconst MOODS = {\n  neutral: { needle: 0, wiggle: 0.02 },\n  pleased: { needle: 26, wiggle: 0.04 },\n  smug: { needle: 42, wiggle: 0.01 },\n  droop: { needle: -66, wiggle: 0.01 },\n  alarm: { needle: 80, wiggle: 0.5 },\n  concern: { needle: -24, wiggle: 0.03 },\n  spin: { needle: 0, spin: 9 },\n};\nexport const OUNCE_MOODS = Object.keys(MOODS);\n\nexport class Ounce {\n  mood = 'neutral';\n  ang = 0; t = 0; spinning = 0;\n  hopT = 1; from = new Vector3(); to = new Vector3();\n  squash = new Squash();\n\n  constructor(ctx, { at = [0, 0, 0], yaw = 0, scale = 1.4 } = {}) {\n    this.ctx = ctx;\n    this.scale = scale;\n    this.build = place(ctx, 'ounce', { at, yaw, scale, actor: true });\n    this.root = this.build.object;\n    this.needle = this.root.getObjectByName('needle');\n    this.face = this.root.getObjectByName('face');\n    this.head = this.root.getObjectByName('head');\n    this.base = { x: this.needle.rotation.y };\n    this.pos = this.root.position;\n    this.faceTilt = this.face.rotation.x;\n    this.reading = null;\n  }\n\n  setMood(m) { if (MOODS[m]) this.mood = m; }\n  /** Point the needle: -1..1 of the dial, for a reading. null hands it back to mood. */\n  read(v) { this.reading = v; }\n\n  hopTo(x, z, dur = 0.34) {\n    this.from.copy(this.root.position);\n    this.to.set(x, this.root.position.y, z);\n    this.hopT = 0; this.hopDur = dur;\n    this.squash.kick(0.9);\n    this.ctx.audio.play('hop', { volume: 0.5 });\n  }\n\n  get hopping() { return this.hopT < 1; }\n\n  face2(x, z) {\n    const dx = x - this.root.position.x, dz = z - this.root.position.z;\n    this.root.rotation.y += ((Math.atan2(dx, dz) - this.root.rotation.y + Math.PI * 3) % (Math.PI * 2) - Math.PI) * 0.2;\n  }\n\n  update(dt) {\n    this.t += dt;\n    const m = MOODS[this.mood] ?? MOODS.neutral;\n    let target = (m.needle + Math.sin(this.t * 7) * m.wiggle * 60) * (Math.PI / 180);\n    if (this.reading !== null) target = this.reading * 2.2;\n    if (m.spin && this.reading === null) { this.ang += m.spin * dt; } else {\n      const wrap = ((target - this.ang + Math.PI * 3) % (Math.PI * 2)) - Math.PI;\n      this.ang += wrap * Math.min(1, dt * 12);\n    }\n    this.needle.rotation.y = this.base.x + this.ang;\n    this.face.rotation.x = this.faceTilt + Math.sin(this.t * 1.7) * 0.03;\n    if (this.hopT < 1) {\n      this.hopT = Math.min(1, this.hopT + dt / this.hopDur);\n      const u = this.hopT;\n      this.root.position.x = this.from.x + (this.to.x - this.from.x) * u;\n      this.root.position.z = this.from.z + (this.to.z - this.from.z) * u;\n      this.root.position.y = this.from.y + Math.sin(u * Math.PI) * 0.5;\n      if (u >= 1) { this.root.position.y = this.from.y; this.squash.kick(-1.1); }\n    }\n    this.squash.update(dt);\n    const [h, v] = this.squash.scale();\n    this.root.scale.set(h * this.scale, v * this.scale, h * this.scale);\n  }\n}\n\nexport class Kevin {\n  t = 0; flap = 1; state = 'sit';\n  from = new Vector3(); to = new Vector3(); u = 1; dur = 1;\n\n  constructor(ctx, { at = [0, 0, 0], yaw = 0, scale = 1 } = {}) {\n    this.ctx = ctx;\n    this.build = place(ctx, 'kevin', { at, yaw, scale, actor: true, shadow: false });\n    this.root = this.build.object;\n    this.wr = this.root.getObjectByName('wingR');\n    this.wl = this.root.getObjectByName('wingL');\n    this.visible = true;\n  }\n\n  flyTo(x, y, z, dur = 1.2) {\n    this.from.copy(this.root.position); this.to.set(x, y, z); this.u = 0; this.dur = dur; this.state = 'fly';\n    this.ctx.audio.play('gullSquawk', { volume: 0.6 });\n  }\n\n  /** Keep him on someone: call each frame with a world position. */\n  perch(v) { if (this.state !== 'fly') this.root.position.copy(v); }\n\n  update(dt) {\n    this.t += dt;\n    if (this.state === 'fly') {\n      this.u = Math.min(1, this.u + dt / this.dur);\n      const e = this.u * this.u * (3 - 2 * this.u);\n      this.root.position.lerpVectors(this.from, this.to, e);\n      this.root.position.y += Math.sin(this.u * Math.PI) * 1.2;\n      const dx = this.to.x - this.from.x, dz = this.to.z - this.from.z;\n      if (Math.abs(dx) + Math.abs(dz) > 0.01) this.root.rotation.y = Math.atan2(dx, dz);\n      if (this.u >= 1) this.state = 'sit';\n    }\n    const f = this.state === 'fly' ? Math.sin(this.t * 22) * 0.9 : -1.25 + Math.sin(this.t * 2.1) * 0.03;\n    this.wr.rotation.z = f;\n    this.wl.rotation.z = -f;\n  }\n}\nEOF\ncat > src/ui/dialogue.js <<'EOF'\n// Dialogue: bottom strip, typewriter in step with the voice, a dial portrait for Ounce.\nimport { App } from '../app.js';\nimport { CONFIRM } from '../core/actions.js';\nimport { revealAt, syllabify, voiceLength } from '../audio/voice.js';\nimport { SPEAKERS } from '../data/classmates.js';\nimport { say, sanitize, wrap, charsIn, textWidth } from './font.js';\nimport { disc, line, panel, ring } from './widgets.js';\nimport { promptBar } from './prompts.js';\n\nconst MOOD_ANGLE = { neutral: 0, pleased: 0.45, smug: 0.75, droop: -1.15, alarm: 1.4, concern: -0.42, spin: 0 };\n\nexport function drawOuncePortrait(hud, x, y, r, mood = 'neutral', t = 0) {\n  disc(hud, x, y, r + 2, 'slate');\n  disc(hud, x, y, r, 'white');\n  for (const a of [-1, -0.5, 0, 0.5, 1]) {\n    hud.rect(Math.round(x + Math.sin(a) * (r - 2)), Math.round(y - Math.cos(a) * (r - 2)), 1, 1, 'mist');\n  }\n  hud.rect(x - 4, y - 3, 2, 3, 'ink');\n  hud.rect(x + 3, y - 3, 2, 3, 'ink');\n  const a = mood === 'spin' ? t * 9 : (MOOD_ANGLE[mood] ?? 0) + Math.sin(t * 5) * 0.03;\n  line(hud, x, y + 1, x + Math.sin(a) * (r - 3), y + 1 - Math.cos(a) * (r - 3), 'red', 1);\n  disc(hud, x, y + 1, 1, 'red');\n}\n\n/** Lines: strings \"who: text\" or { who, text, mood, run }. */\nexport function normaliseLines(lines) {\n  return (Array.isArray(lines) ? lines : [lines]).map((l) => {\n    if (typeof l !== 'string') return l;\n    const m = /^([a-z]+):\\s?(.*)$/s.exec(l);\n    return m && SPEAKERS[m[1]] ? { who: m[1], text: m[2] } : { who: 'narrator', text: l };\n  });\n}\n\nexport class DialogueScreen {\n  name = 'dialogue';\n  i = 0; t = 0; shown = 0; complete = false; hold = 0;\n\n  constructor(lines, { onDone = null, skippable = true } = {}) {\n    this.lines = normaliseLines(lines);\n    this.onDone = onDone;\n    this.skippable = skippable;\n  }\n\n  onOpen() { this.begin(); }\n\n  begin() {\n    const l = this.lines[this.i];\n    if (!l) return;\n    l.run?.();\n    this.text = sanitize(l.text);\n    this.syl = syllabify(this.text, l.who);\n    this.dur = voiceLength(this.syl);\n    this.t = 0; this.complete = false; this.shown = 0;\n    if (l.who === 'kevin') App.sfx('gullSquawk');\n    else App.speak(this.syl, l.who);\n    if (l.mood && App.scene?.ounce) App.scene.ounce.setMood(l.mood);\n  }\n\n  advance() {\n    App.voice.stop();\n    this.i++;\n    if (this.i >= this.lines.length) {\n      App.stack.pop(this);\n      this.onDone?.();\n      return;\n    }\n    this.begin();\n  }\n\n  update(ctx, dt) {\n    const uiDt = dt || 1 / 60;\n    const { input } = ctx;\n    const pressed = input.wasPressed(...CONFIRM) || input.wasPressed('MouseLeft');\n    const held = input.anyDown(CONFIRM) || input.isDown('MouseLeft');\n    this.hold = held ? this.hold + uiDt : 0;\n    this.t += uiDt * (this.hold > 0.45 ? 4 : 1);\n    this.shown = revealAt(this.syl, this.text, this.t);\n    if (!this.complete && (this.t >= this.dur + 0.05 || this.shown >= this.text.length)) { this.complete = true; this.shown = this.text.length; }\n    if (pressed) {\n      if (!this.complete) { this.complete = true; this.shown = this.text.length; this.t = this.dur + 1; App.voice.stop(); } else this.advance();\n    } else if (this.complete && this.hold > 0.45) this.advance();\n  }\n\n  draw(ctx) {\n    const l = this.lines[this.i];\n    if (!l) return;\n    drawDialogueBox(ctx.hud, l.who, this.text.slice(0, this.shown), this.text, l.mood, this.t);\n    const y = ctx.hud.height - 17;\n    if (this.complete) promptBar(ctx.hud, App.device, [['confirm', 'Next']], { y, strip: false });\n  }\n}\n\n/** Box shared by dialogue and barks. Returns its rect. */\nexport function drawDialogueBox(hud, who, shownText, fullText, mood = 'neutral', t = 0) {\n  const speaker = SPEAKERS[who] ?? SPEAKERS.narrator;\n  const portrait = who === 'ounce' ? 26 : 0;\n  const w = Math.min(hud.width - 24, 338 + portrait);\n  const x = Math.round((hud.width - w) / 2);\n  const textW = w - 14 - portrait;\n  const cols = charsIn(textW);\n  const lines = wrap(fullText, cols);\n  const nameH = speaker.name ? 12 : 0;\n  const h = Math.max(portrait ? 34 : 0, nameH + lines.length * 11 + 10);\n  const y = hud.height - h - 22;\n  panel(hud, x, y, w, h, { fill: 'white', border: 'ink', name: 'dialogue' });\n  if (portrait) drawOuncePortrait(hud, x + 15, y + Math.round(h / 2), 11, mood, t);\n  const tx = x + 7 + portrait;\n  if (speaker.name) say(hud, tx, y + 4, speaker.name, { color: speaker.color, shadow: false, name: 'speaker' });\n  // Print the typewriter's part of the wrapped text, so words never jump lines.\n  let left = shownText.length;\n  lines.forEach((ln, i) => {\n    const part = ln.slice(0, Math.max(0, left));\n    if (part) say(hud, tx, y + 4 + nameH + i * 11, part, { color: 'ink', shadow: false, name: 'dialogue-text' });\n    left -= ln.length + 1;\n  });\n  return { x, y, w, h };\n}\n\n/** A remark that doesn't stop anything: small, up for a few seconds, voiced. */\nexport class Bark {\n  who = null; text = ''; t = 0; dur = 0;\n  say(who, text) {\n    this.who = who;\n    this.text = sanitize(text);\n    this.syl = syllabify(this.text, who);\n    this.t = 0;\n    this.dur = Math.max(2.4, voiceLength(this.syl) + 1.5);\n    if (who === 'kevin') App.sfx('gullSquawk'); else App.speak(this.syl, who);\n  }\n  get active() { return this.who !== null; }\n  tick(dt) {\n    if (!this.who) return;\n    this.t += dt;\n    if (this.t > this.dur) this.who = null;\n  }\n  draw(hud) {\n    if (!this.who) return;\n    drawDialogueBox(hud, this.who, this.text.slice(0, revealAt(this.syl, this.text, this.t)), this.text, 'neutral', this.t);\n  }\n}\n\nexport { ring, textWidth };\nEOF\ncat > src/app.js <<'EOF'\n// App: what outlives a scene. Save, settings, tunables, device, scene switching, debug API.\nimport { PALETTE, THREE } from '../pixel-engine.js';\nimport { PAD_BUTTONS } from './core/actions.js';\nimport { Device } from './core/device.js';\nimport { DEFAULT_SETTINGS, Store } from './core/save.js';\nimport { T } from './core/tunables.js';\nimport { VoicePlayer } from './audio/voice.js';\nimport { SONGS } from './audio/songs.js';\nimport { registerSfx } from './audio/sfx.js';\nimport { ScreenStack } from './ui/stack.js';\nimport { layout } from './ui/layout.js';\n\nexport const APP_LOOKS = { default: undefined, storybook: 'storybook', arcade: 'arcade', handheld: 'handheld' };\n\nexport const App = {\n  engine: null, ctx: null, scene: null,\n  T,\n  device: new Device(),\n  stack: new ScreenStack(),\n  voice: new VoicePlayer(),\n  store: null,\n  session: null,\n  touchOnly: false,\n  scenes: {},\n  loading: false,\n  queued: null,\n  attract: null,\n  dev: { god: false, autopilot: null, overlay: false, hideHud: false, timeScale: 1, freeCam: false, allUnlocked: false },\n  bark: null,\n  frame: 0,\n  uiT: 0,\n\n  registerScenes(map) { Object.assign(this.scenes, map); },\n\n  init(engine, { storage = null, session = null } = {}) {\n    this.engine = engine;\n    this.session = session;\n    this.store = this.store ?? new Store(storage);\n    const input = engine.input;\n    input.gamepadButtons = { ...PAD_BUTTONS };\n    input.gamepadDeadzone = 0.12;\n    registerSfx(engine.audio);\n    this.applySettings();\n  },\n\n  get settings() { return this.store?.settings ?? DEFAULT_SETTINGS; },\n  get slot() { return this.store?.slot ?? null; },\n\n  /** Every boot, from our own settings: the engine's own stored volume is shared by every engine game. */\n  applySettings() {\n    const s = this.settings;\n    const audio = this.engine?.audio;\n    if (audio) {\n      audio.setVolume('music', s.music);\n      audio.setVolume('sfx', s.sfx);\n    }\n    this.voice.setLevel(s.voice);\n    this.device.glyphs = s.glyphs;\n    T.mouseLeanRadius = s.mouseLeanRadius;\n    T.stepOffsetMs = s.stepOffsetMs;\n    if (this.engine?.settings) {\n      const look = APP_LOOKS[s.look];\n      const patch = {};\n      if ((this.engine.settings.values.look ?? undefined) !== look) patch.look = look;\n      const px = s.pixelSize ? 'chunky' : undefined;\n      if ((this.engine.settings.values.pixelSize ?? undefined) !== px) patch.pixelSize = px;\n      if (Object.keys(patch).length) this.engine.settings.set(patch);\n    }\n  },\n\n  saveSettings() { this.applySettings(); this.store.write(); },\n\n  /** A ring radius after the player's and the designer's scaling. */\n  ringOf(r) { return r * T.ringScale * (this.settings.gentle ? 1.25 : 1); },\n  noiseScale() { return this.settings.gentle ? 0.8 : 1; },\n\n  sfx(name, opts) { return this.ctx?.audio.play(name, opts); },\n  music(name) {\n    const song = name ? SONGS[name] : null;\n    this.ctx?.audio.playMusic(song, name ?? 'song');\n    this.songName = name ?? null;\n  },\n  speak(syllables, who) { if (this.ctx) this.voice.speak(this.ctx.audio, syllables, who); },\n  say(who, text) { this.bark?.say(who, text); },\n\n  flash(color = 'white', o = { duration: 0.1 }) {\n    if (!this.settings.reduceFlashes) this.engine?.screen.flash(color, o);\n  },\n\n  attach(ctx, scene) {\n    this.ctx = ctx;\n    this.scene = scene;\n    this.stack.clear();\n    this.voice.stop();\n  },\n\n  scene2(id) {\n    const f = this.scenes[id];\n    if (!f) throw new Error(`no scene ${id}`);\n    return f;\n  },\n\n  /** Switch scene with an iris. A second call while one is under way waits its turn. */\n  async go(id, args = {}, { transition = 'iris' } = {}) {\n    if (this.loading) { this.queued = [id, args, { transition }]; return; }\n    this.loading = true;\n    const engine = this.engine;\n    try {\n      const make = this.scene2(id);\n      if (transition) await engine.screen.cover(transition, { duration: 0.28 });\n      const scene = make(args);\n      await engine.loadGame(scene, { camera: scene.cameraConfig?.() });\n      engine.timeScale = this.dev.timeScale;\n      if (transition) await engine.screen.reveal(transition, { duration: 0.28 });\n    } finally {\n      this.loading = false;\n    }\n    if (this.queued) {\n      const q = this.queued;\n      this.queued = null;\n      await this.go(...q);\n    }\n  },\n\n  /** For tests: the whole picture as data. */\n  state() {\n    const engine = this.engine;\n    const slot = this.slot;\n    return {\n      scene: this.scene?.id ?? null,\n      status: this.scene?.status?.(this.ctx) ?? '',\n      stack: this.stack.names(),\n      device: this.device.last,\n      glyphs: this.device.glyphs,\n      column: this.device.promptColumn(),\n      prompts: [...layout.prompts],\n      day: slot?.day ?? null, week: slot?.week ?? null, drips: slot?.drips ?? null, phase: slot?.phase ?? null,\n      music: engine?.audio.volume.music ?? null,\n      attract: !!this.attract,\n      timeScale: engine?.timeScale ?? 1,\n      loading: this.loading,\n      songName: this.songName ?? null,\n      session: !!this.session,\n    };\n  },\n\n  setDriver(skill) { this.dev.autopilot = skill; },\n  tunables: T,\n  palette: PALETTE,\n  THREE,\n};\n\nglobalThis.__GAME__ = App;\nEOF\ncat > src/scenes/base.js <<'EOF'\n// BaseScene owns the frame order: update -> device -> overlays take input first -> scene ->\n// hud.clear() -> scene draw -> overlays draw. Gameplay goes in onFixed, skipped while timeScale is 0.\nimport { THREE } from '../../pixel-engine.js';\nimport { App } from '../app.js';\nimport { Bark } from '../ui/dialogue.js';\nimport { layout } from '../ui/layout.js';\nimport { say, sayRight } from '../ui/font.js';\nimport { drawGlyph } from '../art/glyphs.js';\nimport { PAUSE_KEYS } from '../core/actions.js';\n\nconst { Vector3 } = THREE;\n\nexport class BaseScene {\n  name = 'Scene';\n  id = 'scene';\n  canPause = false;       // Esc / Options opens the pause menu\n  allowsAttract = false;  // the title and its menus\n  idle = 0;\n  focus = new Vector3();\n  args = {};\n  t = 0;\n\n  constructor(args = {}) { this.args = args; }\n\n  cameraConfig() { return undefined; }\n\n  async setup(ctx) {\n    this.ctx = ctx;\n    App.attach(ctx, this);\n    this.bark = new Bark();\n    App.bark = this.bark;\n    await this.build(ctx);\n  }\n\n  async build() {}\n  ready() { App.onSceneReady?.(this); }\n\n  get paused() { return App.stack.open && App.stack.screens.some((s) => s.freezes); }\n  /** True when something else has the input. */\n  get blocked() { return App.loading || App.stack.open; }\n\n  fixedUpdate(ctx, dt) { this.onFixed(ctx, dt); }\n  onFixed() {}\n\n  update(ctx, dt) {\n    App.frame++;\n    const uiDt = dt || 1 / 60;\n    App.uiT += uiDt;\n    this.t += dt;\n    layout.begin();\n    App.device.update(ctx);\n    this.bark.tick(dt);\n    if (App.attract) App.attract.tick(ctx, uiDt);\n\n    if (this.allowsAttract && !App.session && !App.attract) {\n      if (App.device.anyInput || App.loading) this.idle = 0;\n      else this.idle += uiDt;\n      if (this.idle >= 10) { this.idle = 0; App.startAttract?.(); }\n    }\n\n    const hadOverlay = App.stack.open;\n    if (!App.loading && !App.attract) App.stack.update(ctx, dt);\n    if (!App.stack.open && !hadOverlay && !App.loading && !App.attract) {\n      if (this.canPause && this.pausePressed(ctx)) App.openPause?.();\n      else this.onInput(ctx, dt);\n    }\n    if (App.dev.freeCam) { /* the free camera reads input itself */ }\n    this.onUpdate(ctx, dt);\n    ctx.hud.clear();\n    if (!App.dev.hideHud) {\n      this.onDraw(ctx, dt);\n      App.stack.draw(ctx, dt);\n      if (!App.stack.open) this.bark.draw(ctx.hud);\n      this.drawPauseIcon(ctx);\n    }\n    if (App.attract) App.attract.draw(ctx);\n    if (App.dev.overlay) this.drawOverlay(ctx);\n  }\n\n  pausePressed(ctx) {\n    const { input } = ctx;\n    if (input.wasPressed(...PAUSE_KEYS)) return true;\n    if (input.wasPressed('PadOptions') && !input.isDown('PadCreate')) return true;\n    if (this.pauseIconHit && input.wasPressed('MouseLeft')) {\n      const p = App.device.pointerArt(ctx);\n      const r = this.pauseIconHit;\n      if (p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h) return true;\n    }\n    return false;\n  }\n\n  /** Top right, while the mouse moves. */\n  drawPauseIcon(ctx) {\n    if (!this.canPause || App.stack.open || App.attract || App.session) { this.pauseIconHit = null; return; }\n    if (App.device.moved > 0) this.iconT = 2.5;\n    this.iconT = Math.max(0, (this.iconT ?? 0) - (1 / 60));\n    if (this.iconT <= 0 || App.device.last !== 'mouse') { this.pauseIconHit = null; return; }\n    const x = ctx.hud.width - 12 - 11;\n    const y = 6;\n    drawGlyph(ctx.hud, x, y, 'pauseIcon');\n    this.pauseIconHit = { x: x - 3, y: y - 3, w: 17, h: 17 };\n  }\n\n  onInput() {}\n  onUpdate() {}\n  onDraw() {}\n\n  /** Dev overlay: scene, state, Dot, ring, fps, last device. */\n  drawOverlay(ctx) {\n    const { hud } = ctx;\n    const rows = [\n      `scene ${this.id}`,\n      `${String(this.status(ctx)).slice(0, 44)}`,\n      `dot ${this.overlayDot?.() ?? '-'}`,\n      `fps ${Math.round(ctx.engine.fps)}  device ${App.device.last}`,\n      `t ${ctx.time.toFixed(1)}  scale ${ctx.engine.timeScale}`,\n    ];\n    hud.rect(0, 40, 200, rows.length * 10 + 4, 'ink');\n    rows.forEach((r, i) => say(hud, 3, 42 + i * 10, r, { color: 'lime', shadow: false, name: 'overlay' }));\n    void sayRight;\n  }\n\n  cameraTarget() { return this.focus; }\n  status() { return this.id; }\n  fingerprint() { return ''; }\n}\n\n/** A fixed lane camera, pushed back on narrow windows so outer mats don't clip. */\nexport function aspectDistance() {\n  const a = typeof window !== 'undefined' && window.innerHeight ? window.innerWidth / window.innerHeight : 16 / 9;\n  return Math.max(1, (16 / 9) / a);\n}\n\nexport function laneCamera(mats) {\n  const k = aspectDistance();\n  if (mats >= 4) return { preset: 'fixed', position: [0, 3 * k, 9.5 * k], target: [0, 1, 0], fov: 32 };\n  return { preset: 'fixed', position: [0, 2.3 * k, 8.2 * k], target: [0, 1.15, 0], fov: 30 };\n}\nEOF\necho done","description":"Write avatars, props, dialogue, App and the base scene","timeout":30000}}}
