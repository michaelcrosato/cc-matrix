;\n    }\n    for (const lane of this.lanes) await buildHeaderProps(ctx, lane);\n    for (const o of this.playerLane.objects) o.mesh.scale.setScalar(1.2);\n\"\"\")\nt=t.replace(\"import { LaneActivity, playerInfo } from './lanes.js';\",\"import { LaneActivity, playerInfo, soloSpecs } from './lanes.js';\")\nopen(p,'w').write(t)\n\n# ---------- menu: page, don't scroll\np='src/ui/menu.js'; t=open(p).read()\na=\"\"\"    const max = this.visibleRows();\n    if (this.focus < this.top) this.top = this.focus;\n    if (this.focus >= this.top + max) this.top = this.focus - max + 1;\n    this.top = Math.max(0, Math.min(this.top, Math.max(0, this.items.length - max)));\n  }\n\"\"\"\nassert a in t\nt=t.replace(a,\"\"\"    const max = this.visibleRows();\n    this.top = Math.floor(this.focus / max) * max;\n  }\n\n  get pageCount() { return Math.max(1, Math.ceil(this.items.length / this.visibleRows())); }\n\"\"\")\na=\"\"\"      this.top = Math.max(0, Math.min(this.top + Math.sign(input.wheel), Math.max(0, this.items.length - this.visibleRows())));\n      if (this.focus < this.top) this.focus = this.top;\n      if (this.focus >= this.top + this.visibleRows()) this.focus = this.top + this.visibleRows() - 1;\n\"\"\"\nassert a in t\nt=t.replace(a,\"\"\"      const max = this.visibleRows();\n      const page = Math.max(0, Math.min(this.pageCount - 1, Math.floor(this.top / max) + Math.sign(input.wheel)));\n      if (page * max !== this.top) { this.top = page * max; this.focus = this.top; App.sfx('menuMove', { volume: 0.5 }); }\n\"\"\")\na=\"\"\"    if (this.top > 0) sayCentered(hud, x + width / 2, y - 12, '^', { color: 'sand', name: 'menu-more' });\n    if (this.top + rows < this.items.length) sayCentered(hud, x + width / 2, y + totalH + 3, 'v', { color: 'sand', name: 'menu-more' });\n\"\"\"\nassert a in t\nt=t.replace(a,\"\"\"    if (this.pageCount > 1) sayCentered(hud, x + width / 2, y + totalH + 3, `Page ${Math.floor(this.top / rows) + 1} of ${this.pageCount}`, { color: 'sand', nam