is.tl.update(dt); }\n\"\"\"),\n(\"\"\"  onUpdate(ctx, dt) {\n    for (const a of [this.you, this.coach, this.marguerite, this.dennis, this.june]) a.update(dt);\"\"\",\"\"\"  onUpdate(ctx, dt) {\n    const shot = this.tl.camera();\n    if (shot && !App.dev.freeCam) {\n      const cam = ctx.camera.camera;\n      cam.position.set(...shot.position);\n      cam.lookAt(shot.target[0], shot.target[1], shot.target[2]);\n      if (shot.fov && cam.fov !== shot.fov) { cam.fov = shot.fov; cam.updateProjectionMatrix(); }\n    }\n    for (const a of [this.you, this.coach, this.marguerite, this.dennis, this.june]) a.update(dt);\"\"\"),\n(\"\"\"  onDraw(ctx) {\n    const { hud } = ctx;\n    if (this.phase === 'slide' || this.phase === 'after') {\"\"\",\"\"\"  onDraw(ctx) {\n    const { hud } = ctx;\n    const bars = Math.round(this.tl.bars() * 14);\n    if (bars > 0 && this.phase !== 'credits') { hud.rect(0, 0, hud.width, bars, 'ink'); hud.rect(0, hud.height - bars, hud.width, bars, 'ink'); }\n    if (this.phase === 'slide' || this.phase === 'after') {\"\"\"),\n(\"\"\"  status() { return `ending | ${this.phase} | slide ${this.slide.toFixed(2)}`; }\"\"\",\"\"\"  status() { return `ending | ${this.phase} | slide ${this.slide.toFixed(2)}`; }\n  fingerprint() { return `${this.phase}|${this.slide.toFixed(3)}|${this.tl?.time.toFixed(2)}`; }\"\"\"),\n])\n\n# ---------------- Ferry disembark, fingerprints everywhere\nsub('src/scenes/ferry.js',[\n(\"\"\"{ at: 13.4, name: 'off', run: () => { this.disembark = true; this.avatar.play('Walk', { fade: 0.2 }); } },\"\"\",\"\"\"{ at: 13.4, name: 'off', run: () => { this.disembark = true; this.avatar.play('HopDown', { once: true, fade: 0.1, then: () => this.avatar.play('Walk', { fade: 0.2 }) }); } },\"\"\"),\n(\"\"\"  status() { return `ferry | t ${this.tl?.time?.toFixed(1)}`; }\"\"\",\"\"\"  status() { return `ferry | t ${this.tl?.time?.toFixed(1)}`; }\n  fingerprint() { return `${this.tl?.time?.toFixed(3)}|${this.disembark}`; }\"\"\"),\n])\nsub('s