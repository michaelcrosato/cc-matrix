{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjLkhTVxjLKBipmc9bY1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01CnDcYmdVPBJiM3Jc76bhSZ","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='src/scenes/activity/reps.js'; s=open(p).read()\ns=s.replace(\"import { T } from '../../core/tunables.js';\",\"import { T } from '../../core/tunables.js';\\nimport { CLIP_NAMES } from '../../art/clips.js';\")\ns=s.replace(\"return [App.clipIndex(this.clipFor(rep)), lane.state.rVis];\",\"return [CLIP_NAMES.indexOf(this.clipFor(rep)), lane.state.rVis];\")\nopen(p,'w').write(s)\nEOF\ncat > src/data/slackline.js <<'EOF'\n// Slackline tuning that isn't a live slider.\nexport const SLACK = {\n  length: 30, limit: 75, walkSpeed: 1.1, standInst: 1.2, noise: 1.25, fallAt: 1, gustEvery: 6, gustSeconds: 1, gustWarn: 1.5,\n  checkpoints: [0, 10, 20], kevinOn: 18, kevinOff: 24, kevinBias: 0.18, fallSeconds: 1.2, height: 2.7,\n};\nEOF\ncat > src/scenes/activity/slackline.js <<'EOF'\n// Slackline. X is balance, forward is progress. Stopping to recover is a real choice.\nimport { RippleField, THREE, toonMaterial, PALETTE, WAVES_CALM, WaterSurface } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { Kevin, place } from '../../art/props.js';\nimport { BARKS } from '../../data/lines.js';\nimport { SLACK } from '../../data/slackline.js';\nimport { sayCentered } from '../../ui/font.js';\nimport { bar, disc, line, panel } from '../../ui/widgets.js';\nimport { topRow } from '../../ui/activity-hud.js';\nimport { ActivityScene } from './base.js';\nimport { playerInfo } from './lanes.js';\nimport { setSky } from '../sets.js';\n\nconst { BoxGeometry, Mesh, Vector3 } = THREE;\n\nexport class SlacklineActivity extends ActivityScene {\n  ownCamera = true;\n\n  async stage(ctx) {\n    setSky(ctx, 13);\n    const rip = new RippleField({ size: [40, 60], cells: [80, 120], center: [0, 15] });\n    this.ripples = rip;\n    this.water = new WaterSurface({ size: [40, 60], at: [0, 0, 15], ripples: rip, waves: WAVES_CALM, deep: PALETTE.blue, shallow: PALETTE.cyan, foam: PALETTE.white });\n    ctx.scene.add(this.water);\n    ctx.scene.add(new Mesh(new BoxGeometry(260, 0.2, 160), toonMaterial(PALETTE.blue)).translateZ(100).translateY(-0.6));\n    place(ctx, 'slack-anchor', { at: [0, 0, -1.6] });\n    place(ctx, 'slack-anchor', { at: [0, 0, SLACK.length + 1.6] });\n    for (const [x, z] of [[-14, 8], [13, 18], [-11, 26], [9, 4]]) place(ctx, 'medicine-ball', { at: [x, -0.3, z], scale: 1.3 });\n    for (const [x, z, s] of [[-7, -3, 1.2], [8, -3, 1.1], [-8, 36, 1.2], [8, 36, 1.2]]) place(ctx, 'palm', { at: [x, 0, z], scale: s });\n    const sand1 = new Mesh(new BoxGeometry(24, 0.4, 7), toonMaterial(PALETTE.sand)); sand1.position.set(0, -0.1, -3.8); ctx.scene.add(sand1);\n    const sand2 = new Mesh(new BoxGeometry(24, 0.4, 7), toonMaterial(PALETTE.sand)); sand2.position.set(0, -0.1, SLACK.length + 3.8); ctx.scene.add(sand2);\n    // The line: segments we move each frame so it sags under your feet.\n    const mat = toonMaterial(PALETTE.red);\n    this.segs = [];\n    this.nSegs = 40;\n    for (let i = 0; i < this.nSegs; i++) {\n      const m = new Mesh(new BoxGeometry(0.1, 0.07, (SLACK.length + 2) / this.nSegs + 0.05), mat);\n      ctx.scene.add(m);\n      this.segs.push(m);\n    }\n    // Flags along the line warn of gusts.\n    this.flags = [];\n    for (let z = 6; z < SLACK.length; z += 6) {\n      const pole = place(ctx, 'signpost', { at: [2.6, -0.1, z], scale: 0.5, shadow: false });\n      const f = new Mesh(new BoxGeometry(0.9, 0.5, 0.05), toonMaterial(PALETTE.white));\n      f.position.set(2.6, 2.1, z);\n      ctx.scene.add(f);\n      this.flags.push({ z, f, pole });\n    }\n    const p = playerInfo();\n    this.avatar = await makeAvatar(ctx, p.look, { at: [0, SLACK.height, 0], clip: 'ArmsOut', shadow: false, yaw: 0 });\n    this.kevin = new Kevin(ctx, { at: [4, 3, SLACK.kevinOn], yaw: 3 });\n    this.dot = new Dot(() => this.rng.next());\n    this.head = new Vector3();\n    this.begin(true);\n  }\n\n  begin() {\n    this.z = 0;\n    this.falls = 0;\n    this.lastCheckpoint = 0;\n    this.dot.reset();\n    this.fallT = 0;\n    this.time = 0;\n    this.finished = false;\n    this.gust = null;\n    this.nextGustAt = SLACK.gustEvery;\n    this.kevinOn = false;\n    this.m = {};\n    this.walking = false;\n    this.gustSign = 1;\n    this.engineScaled = false;\n    if (this.avatar) this.avatar.place(0, SLACK.height, 0, 0);\n    if (this.kevin) { this.kevin.root.position.set(4, 3, SLACK.kevinOn); this.kevin.state = 'sit'; }\n  }\n\n  /** Bots walk only while |x| < .45. */\n  botInput(out, dt, brain) {\n    brain.lean(out, this.dot, 0, 0, dt);\n    out.y = !brain.p ? 0 : Math.abs(this.dot.x) < 0.45 ? 1 : 0;\n    this.dot.y = 0;\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    if (this.finished) return;\n    this.time += dt;\n    if (this.fallT > 0) {\n      this.fallT -= dt / Math.max(0.01, ctx.engine.timeScale || 1);\n      if (this.fallT <= 0) this.respawn(ctx);\n      return;\n    }\n    const inp = this.readPlayer(ctx, dt, this.dial);\n    const wantWalk = inp.y > 0.3;\n    this.walking = wantWalk;\n    const instEff = wantWalk ? T.slackWalkInst : SLACK.standInst;\n    const m = this.m;\n    m.inst = instEff / T.dotInstability;\n    m.noise = SLACK.noise * App.noiseScale();\n    m.bx = 0;\n    // Gusts: every 6 m, telegraphed 1.5 s by flags and wind lines.\n    if (!this.gust && this.z >= this.nextGustAt - this.walkLead()) {\n      this.gust = { warn: SLACK.gustWarn, blow: SLACK.gustSeconds, sign: this.rng.chance(0.5) ? 1 : -1 };\n      this.nextGustAt += SLACK.gustEvery;\n      App.sfx('gust', { volume: 0.5 });\n    }\n    if (this.gust) {\n      if (this.gust.warn > 0) this.gust.warn -= dt;\n      else {\n        this.gust.blow -= dt;\n        m.bx += this.gust.sign * T.gustForce * (this.hardData.gust ?? 1);\n        if (this.gust.blow <= 0) this.gust = null;\n      }\n    }\n    if (this.kevinOn) m.bx += SLACK.kevinBias * T.dotAuthority * (this.kevinSign ?? 1);\n    this.dot.step(dt, inp.x, 0, T, m);\n    this.dot.y = 0; this.dot.vy = 0;\n    if (App.dev.god || this.cheatRing) this.dot.clampTo(0, 0, 0.6);\n    if (wantWalk) this.z = Math.min(SLACK.length, this.z + SLACK.walkSpeed * Math.min(1, inp.y) * dt);\n    // Checkpoints and Kevin.\n    for (const c of SLACK.checkpoints) if (this.z >= c) this.lastCheckpoint = Math.max(this.lastCheckpoint, c);\n    if (!this.kevinOn && this.z >= SLACK.kevinOn && this.z < SLACK.kevinOff) {\n      this.kevinOn = true;\n      this.kevinSign = this.rng.chance(0.5) ? 1 : -1;\n      this.kevin.flyTo(this.avatar.root.position.x, SLACK.height + 1.75, this.z, 0.5);\n      if (!this.attractMode) App.say('ounce', 'Kevin is on your head. He is staff. Carry on.');\n    }\n    if (this.kevinOn && this.z >= SLACK.kevinOff) {\n      this.kevinOn = false;\n      this.kevin.flyTo(-6, 5, this.z + 10, 1.4);\n    }\n    if (Math.abs(this.dot.x) > SLACK.fallAt) this.fall(ctx);\n    if (this.z >= SLACK.length) {\n      this.finished = true;\n      this.avatar.play('Victory', { fade: 0.2 });\n      App.sfx('fanfareSoft');\n    }\n  }\n\n  walkLead() { return SLACK.gustWarn * SLACK.walkSpeed * 0.5; }\n\n  fall(ctx) {\n    this.falls++;\n    this.fallT = SLACK.fallSeconds;\n    this.avatar.play('Fall', { fade: 0.1 });\n    if (!this.attractMode) ctx.engine.timeScale = 0.4;\n    this.fallVX = Math.sign(this.dot.x) * -1.3;\n    this.fallVY = 0.4;\n    App.sfx('wobble');\n  }\n\n  respawn(ctx) {\n    if (!this.attractMode) ctx.engine.timeScale = App.dev.timeScale;\n    this.ripples.splash(this.avatar.root.position.x, this.z, 1.4, 1.2);\n    ctx.particles.burst('splash', [this.avatar.root.position.x, 0.2, this.z]);\n    App.sfx('splash');\n    if (this.scoring && !this.attractMode) App.say('ounce', this.cosmetic.pick(BARKS.fall));\n    this.z = this.lastCheckpoint;\n    this.dot.reset();\n    this.avatar.play('ArmsOut', { fade: 0.2 });\n    this.avatar.root.position.y = SLACK.height;\n  }\n\n  isOver() {\n    if (this.finished && (this.overDelay = (this.overDelay ?? 0) + 1 / 60) > 0.7) return true;\n    return this.time >= SLACK.limit;\n  }\n\n  playLength() { return SLACK.limit; }\n\n  result() {\n    const finished = this.z >= SLACK.length;\n    const score = finished ? Math.max(0, Math.min(1000, Math.round(1000 - 60 * this.falls - 8 * (this.time - 27)))) : Math.round((this.z / SLACK.length) * 400);\n    let stars = 0;\n    if (finished) stars = 1;\n    if (finished && this.falls <= 1 && this.time < 45) stars = 2;\n    if (finished && this.falls === 0 && this.time < 32) stars = 3;\n    return { score, stars, seconds: this.time, display: `${score} pts`, falls: this.falls, finished };\n  }\n\n  visual(ctx, dt) {\n    const a = this.avatar.root;\n    if (this.fallT > 0) {\n      this.fallVY -= 12 * dt;\n      a.position.x += this.fallVX * dt;\n      a.position.y = Math.max(0, a.position.y + this.fallVY * dt);\n    } else {\n      a.position.x = -this.dot.x * 0.42;\n      a.position.y = SLACK.height - this.sagAt(this.z);\n    }\n    a.position.z = this.z;\n    if (this.fallT <= 0 && !this.finished) this.avatar.play(this.walking ? 'SlackWalk' : 'ArmsOut', { fade: 0.2 });\n    this.avatar.update(dt);\n    if (this.fallT <= 0) this.avatar.lean(-this.dot.x * 1.6, 0, Math.abs(this.dot.x) > 0.7 ? 1.4 : 0, this.t);\n    if (this.kevinOn && this.kevin.state !== 'fly') this.kevin.root.position.set(a.position.x, a.position.y + 1.74, a.position.z);\n    this.kevin.update(dt);\n    // The line sags under your feet.\n    const len = SLACK.length + 2;\n    this.segs.forEach((s, i) => {\n      const z = -1 + ((i + 0.5) / this.nSegs) * len;\n      const y = SLACK.height - this.sagAtLine(z);\n      s.position.set(0, y - 0.04, z);\n    });\n    // Flags stream when a gust is coming.\n    const blowing = this.gust ? (this.gust.warn > 0 ? 0.5 : 1) * this.gust.sign : 0;\n    for (const fl of this.flags) { fl.f.rotation.y = blowing * 0.9 + Math.sin(this.t * 4 + fl.z) * 0.1; fl.f.position.x = 2.6 + blowing * 0.3; }\n    this.water?.update(ctx.time);\n    this.ripples?.step(dt);\n    // Camera, low behind you.\n    if (!App.dev.freeCam) {\n      const cam = ctx.camera.camera;\n      cam.position.set(a.position.x * 0.2, 3.3, this.z - 6);\n      cam.lookAt(a.position.x * 0.1, 2.2, this.z + 4);\n      if (cam.fov !== 46) { cam.fov = 46; cam.updateProjectionMatrix(); }\n    }\n  }\n\n  sagAt(z) { return this.sagAtLine(z); }\n  sagAtLine(z) {\n    const span = SLACK.length + 2;\n    const u = (z + 1) / span;\n    const base = Math.sin(u * Math.PI) * 0.25;\n    const dd = (z - this.z) / 2.4;\n    return base + 0.26 * Math.exp(-dd * dd) * (this.fallT > 0 ? 0.2 : 1);\n  }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    const { hud } = ctx;\n    const w = Math.min(280, hud.width - 40);\n    const cx = Math.round(hud.width / 2);\n    const y = 34;\n    this.dial = { x: cx, y: Math.round(hud.height / 2) };\n    panel(hud, cx - w / 2, y - 9, w, 18, { fill: 'white', name: 'balance' });\n    hud.rect(cx - 1, y - 9, 2, 18, 'mist');\n    const safe = (0.45 / 1.2) * (w / 2);\n    hud.rect(cx - Math.round(safe), y - 9, 2, 18, 'lime');\n    hud.rect(cx + Math.round(safe) - 2, y - 9, 2, 18, 'lime');\n    hud.rect(cx - w / 2, y - 9, 6, 18, 'red');\n    hud.rect(cx + w / 2 - 6, y - 9, 6, 18, 'red');\n    const dx = cx + (this.dot.x / 1.2) * (w / 2);\n    disc(hud, dx, y, 6, 'ink');\n    disc(hud, dx, y, 5, 'red');\n    bar(hud, cx - w / 2, y + 12, w, 6, this.z / SLACK.length, 'cyan', 'ink', 'progress');\n    if (this.gust?.warn > 0) sayCentered(hud, cx, y + 22, this.gust.sign > 0 ? 'Gust from the left!' : 'Gust from the right!', { color: 'sand', name: 'gust' });\n    if (this.gust && this.gust.warn <= 0) {\n      for (let i = 0; i < 6; i++) {\n        const ly = 70 + i * 16;\n        const lx = ((this.t * 300 + i * 90) % hud.width);\n        const X = this.gust.sign > 0 ? lx : hud.width - lx;\n        line(hud, X, ly, X + (this.gust.sign > 0 ? 18 : -18), ly, 'white', 1);\n      }\n    }\n    if (App.device.last === 'mouse' && !this.autopilot) { const p = App.device.pointerArt(ctx); line(hud, this.dial.x, this.dial.y, p.x, p.y, 'white', 1); }\n  }\n\n  drawGameHud(ctx) {\n    topRow(ctx.hud, `${Math.ceil(Math.max(0, SLACK.limit - this.time))}s`, `${Math.floor(this.z)} m  falls ${this.falls}`);\n  }\n\n  overlayDot() { return `x ${this.dot.x.toFixed(2)} z ${this.z.toFixed(1)}`; }\n  fingerprint() { return `${this.dot.x.toFixed(6)}|${this.z.toFixed(5)}|${this.falls}`; }\n  cameraTarget() { return this.head.set(0, 2, this.z ?? 0); }\n}\nEOF\ncat > src/scenes/activity/tray.js <<'EOF'\n// Vitamin Tray. Tilt gravity, not the tray: colliders stay flat, a visual group tilts.\nimport { RAPIER, THREE, toonMaterial, PALETTE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { place } from '../../art/props.js';\nimport { BOARDS, TRAY_CELL } from '../../data/boards.js';\nimport { sayCentered } from '../../ui/font.js';\nimport { disc, ring as ringLine, line } from '../../ui/widgets.js';\nimport { topRow } from '../../ui/activity-hud.js';\nimport { ActivityScene } from './base.js';\nimport { lagoonSet, box } from '../sets.js';\n\nconst { Group, Mesh, BoxGeometry } = THREE;\nconst COLORS = { R: 'red', B: 'blue', Y: 'sand' };\nconst BALL_R = 0.17;\nconst CUP_R = 0.27;\nconst ENTER_SPEED = 2.6;\n\nexport class TrayActivity extends ActivityScene {\n  ownCamera = false;\n  tiltX = 0; tiltZ = 0;\n  count = 0;\n\n  boardIndex() {\n    if (this.args.board !== undefined) return this.args.board;\n    if (this.hard) return 2;\n    const rec = this.mode === 'week' ? App.slot?.records.tray : App.store.data.dropin?.tray;\n    return (rec?.plays ?? 0) % BOARDS.length;\n  }\n\n  async stage(ctx) {\n    lagoonSet(ctx);\n    box(ctx, 10, 1.6, 7, [0, -1.05, 0], 'white', { cast: false });\n    this.board = BOARDS[this.boardIndex()];\n    const rows = this.board.rows;\n    const h = rows.length, w = rows[0].length;\n    const cell = TRAY_CELL;\n    this.halfW = (w * cell) / 2; this.halfD = (h * cell) / 2;\n    this.tilt = new Group();\n    this.tilt.position.y = 0.3;\n    ctx.scene.add(this.tilt);\n    const tray = place(ctx, 'tray', { params: { w: Math.min(12, w * cell), d: Math.min(10, h * cell) }, at: [0, -0.18, 0] });\n    ctx.scene.remove(tray.object);\n    this.tilt.add(tray.object);\n    this.starts = [];\n    this.cups = [];\n    const { physics } = ctx;\n    this.savedGravity = { ...physics.world.gravity };\n    // A flat, static floor and walls: gravity does the tilting.\n    physics.addStaticBox({ position: [0, -0.1, 0], halfExtents: [this.halfW + 3, 0.1, this.halfD + 3], friction: 0.6 });\n    // Edges fall away: gaps in the rail drop a vitamin past the floor's edge.\n    const wallMat = toonMaterial(PALETTE.navy);\n    for (let r = 0; r < h; r++) {\n      for (let c = 0; c < w; c++) {\n        const ch = rows[r][c];\n        const x = (c + 0.5) * cell - this.halfW, z = (r + 0.5) * cell - this.halfD;\n        if (ch === '#') {\n          physics.addStaticBox({ position: [x, 0.4, z], halfExtents: [cell / 2, 0.4, cell / 2], friction: 0.1 });\n          const m = new Mesh(new BoxGeometry(cell, 0.34, cell), wallMat);\n          m.position.set(x, 0.17, z);\n          m.castShadow = true;\n          this.tilt.add(m);\n        } else if (ch === 'o') this.starts.push([x, z]);\n        else if (COLORS[ch]) {\n          const cup = place(ctx, 'vitamin-cup', { palette: { cup: COLORS[ch] }, shadow: false });\n          ctx.scene.remove(cup.object);\n          cup.object.position.set(x, 0, z);\n          this.tilt.add(cup.object);\n          this.cups.push({ x, z, color: ch });\n        } else if (ch === '_') {\n          // A gap: nothing in the rail, and a hole in what's visible.\n          const m = new Mesh(new BoxGeometry(cell, 0.04, cell), toonMaterial(PALETTE.ink));\n          m.position.set(x, 0.01, z);\n          this.tilt.add(m);\n        }\n      }\n    }\n    this.vits = [];\n    const colors = [...new Set(this.cups.map((c) => c.color))];\n    for (let i = 0; i < this.board.count; i++) {\n      const color = colors[i % colors.length];\n      const mesh = place(ctx, 'vitamin', { palette: { pill: COLORS[color] }, actor: true, shadow: true }).object;\n      ctx.scene.remove(mesh);\n      this.tilt.add(mesh);\n      const body = physics.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0, 0.3, 0).setLinearDamping(0.32).setAngularDamping(0.6).setCcdEnabled(true));\n      physics.world.createCollider(RAPIER.ColliderDesc.ball(BALL_R).setFriction(0.3).setRestitution(0.2).setDensity(2), body);\n      this.vits.push({ mesh, body, color, done: false, wait: 0, i });\n    }\n    this.begin();\n  }\n\n  spawnPos(i) {\n    const s = this.starts[i % this.starts.length];\n    const jitter = (i * 2.399) % 6.28;\n    return [s[0] + Math.cos(jitter) * 0.2, 0.3, s[1] + Math.sin(jitter) * 0.2];\n  }\n\n  begin() {\n    this.score = 0;\n    this.correct = 0;\n    this.wrong = 0;\n    this.dropped = 0;\n    this.time = 0;\n    this.tiltX = 0; this.tiltZ = 0;\n    for (const v of this.vits ?? []) {\n      v.done = false; v.wait = 0;\n      const p = this.spawnPos(v.i);\n      v.body.setTranslation({ x: p[0], y: p[1], z: p[2] }, true);\n      v.body.setLinvel({ x: 0, y: 0, z: 0 }, true);\n      v.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n      v.body.setEnabled(true);\n      v.mesh.visible = true;\n    }\n  }\n\n  get timeLimit() { return 60 * (this.hardData.time ?? 1); }\n  playLength() { return this.timeLimit; }\n  isOver() { return this.time >= this.timeLimit || (this.vits && this.vits.every((v) => v.done)); }\n\n  /** Bots: pick a vitamin, tilt it toward its cup, ease off as it nears. */\n  botInput(out, dt, brain) {\n    out.x = out.y = 0;\n    if (!brain.p) return;\n    const play = brain.play;\n    let best = null, bestD = Infinity, cup = null;\n    for (const v of this.vits) {\n      if (v.done || v.wait > 0) continue;\n      const p = v.body.translation();\n      for (const c of this.cups) {\n        if (c.color !== v.color) continue;\n        const d = Math.hypot(c.x - p.x, c.z - p.z);\n        if (d < bestD) { bestD = d; best = v; cup = c; }\n      }\n    }\n    if (!best) return;\n    const p = best.body.translation(), vel = best.body.linvel();\n    const k = 0.42 * play.speed, kd = 0.3;\n    const t = this.time;\n    out.x = (cup.x - p.x) * k - vel.x * kd + Math.sin(t * 2.3) * play.wander * 0.5;\n    out.y = -(cup.z - p.z) * k + vel.z * kd + Math.sin(t * 1.9) * play.wander * 0.5;\n    const d = Math.hypot(out.x, out.y);\n    if (d > 1) { out.x /= d; out.y /= d; }\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    const dial = { x: ctx.hud.width / 2, y: ctx.hud.height / 2 };\n    const inp = this.readPlayer(ctx, dt, dial);\n    const lag = Math.min(1, dt / 0.12);\n    const maxT = (T.trayMaxTilt * Math.PI) / 180;\n    this.tiltX += (inp.x * maxT - this.tiltX) * lag;\n    this.tiltZ += (-inp.y * maxT - this.tiltZ) * lag;\n    const g = T.trayGravity;\n    ctx.physics.world.gravity = { x: Math.sin(this.tiltX) * g, y: -Math.cos(this.tiltX) * Math.cos(this.tiltZ) * g, z: Math.sin(this.tiltZ) * g };\n    for (const v of this.vits) {\n      if (v.done) continue;\n      if (v.wait > 0) {\n        v.wait -= dt;\n        if (v.wait <= 0) this.respawnVit(v);\n        continue;\n      }\n      const p = v.body.translation();\n      if (p.y < -1.2 || Math.abs(p.x) > this.halfW + 2.4 || Math.abs(p.z) > this.halfD + 2.4) { this.dropVit(ctx, v, scoring); continue; }\n      // Past the rail the floor is out of bounds: a gap drops a vitamin.\n      if (Math.abs(p.x) > this.halfW + 0.05 || Math.abs(p.z) > this.halfD + 0.05) { this.dropVit(ctx, v, scoring); continue; }\n      const vel = v.body.linvel();\n      const speed = Math.hypot(vel.x, vel.z);\n      for (const c of this.cups) {\n        if (Math.hypot(p.x - c.x, p.z - c.z) > CUP_R) continue;\n        if (speed > ENTER_SPEED) continue;\n        if (c.color === v.color) this.scoreVit(ctx, v, c, scoring);\n        else this.wrongVit(ctx, v, c, scoring);\n        break;\n      }\n    }\n  }\n\n  scoreVit(ctx, v, c, scoring) {\n    v.done = true;\n    v.body.setEnabled(false);\n    v.mesh.visible = false;\n    if (scoring) { this.score += 10; this.correct++; }\n    App.sfx('vitaminIn', { pitch: this.correct });\n    ctx.particles.burst('sparkle', [c.x, 0.6, c.z], { count: 8 });\n  }\n\n  wrongVit(ctx, v, c, scoring) {\n    if (scoring) { this.score -= 3; this.wrong++; }\n    App.sfx('vitaminWrong');\n    ctx.particles.burst('puff', [c.x, 0.5, c.z]);\n    this.respawnVit(v);\n  }\n\n  dropVit(ctx, v, scoring) {\n    if (scoring) { this.score -= 1; this.dropped++; }\n    App.sfx('stepMiss');\n    v.wait = 3;\n    v.body.setEnabled(false);\n    v.mesh.visible = false;\n  }\n\n  respawnVit(v) {\n    const p = this.spawnPos(v.i + this.dropped + this.wrong);\n    v.body.setTranslation({ x: p[0], y: 0.34, z: p[1 + 1] }, true);\n    v.body.setLinvel({ x: 0, y: 0, z: 0 }, true);\n    v.body.setEnabled(true);\n    v.mesh.visible = true;\n  }\n\n  result() {\n    const max = this.board.count * 10;\n    const score = Math.max(0, this.score);\n    return { score, max, seconds: this.time, display: `${score} / ${max}` };\n  }\n\n  visual() {\n    this.tilt.rotation.z = -this.tiltX;\n    this.tilt.rotation.x = this.tiltZ;\n    for (const v of this.vits) {\n      if (v.done || v.wait > 0) continue;\n      const p = v.body.translation(), q = v.body.rotation();\n      v.mesh.position.set(p.x, p.y - BALL_R - 0.3, p.z);\n      v.mesh.quaternion.set(q.x, q.y, q.z, q.w);\n    }\n  }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    const { hud } = ctx;\n    const cx = hud.width - 40, cy = 56, r = 22;\n    disc(hud, cx, cy, r + 2, 'slate');\n    disc(hud, cx, cy, r, 'white');\n    const maxT = (T.trayMaxTilt * Math.PI) / 180;\n    disc(hud, cx + (this.tiltX / maxT) * (r - 4), cy + (this.tiltZ / maxT) * (r - 4), 3, 'red');\n    ringLine(hud, cx, cy, 8, 1, 'teal');\n    if (App.device.last === 'mouse' && !this.autopilot) { const p = App.device.pointerArt(ctx); line(hud, hud.width / 2, hud.height / 2, p.x, p.y, 'white', 1); }\n    sayCentered(hud, hud.width / 2, 24, this.board.name, { color: 'white', name: 'board-name' });\n  }\n\n  drawGameHud(ctx) {\n    topRow(ctx.hud, `${Math.ceil(Math.max(0, this.timeLimit - this.time))}s`, `${this.score}`);\n  }\n\n  overlayDot() { return `tilt ${this.tiltX.toFixed(2)},${this.tiltZ.toFixed(2)}`; }\n  fingerprint() { return `${this.score}|${this.correct}|${this.wrong}|${this.tiltX.toFixed(5)}`; }\n  dispose(ctx) { ctx.physics.world.gravity = { x: 0, y: -24, z: 0 }; }\n}\nEOF\ncat > src/scenes/activity/pier.js <<'EOF'\n// Pier Jump. Side-on, three attempts, three judges with paddles.\nimport { RippleField, THREE, toonMaterial, PALETTE, WAVES_CALM, WaterSurface } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { place } from '../../art/props.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { BARKS } from '../../data/lines.js';\nimport { say, sayCentered } from '../../ui/font.js';\nimport { bar, drawDial, panel } from '../../ui/widgets.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { ActivityScene } from './base.js';\nimport { playerInfo } from './lanes.js';\nimport { setSky } from '../sets.js';\n\nconst { BoxGeometry, Mesh, Vector3 } = THREE;\nexport const PIER = { attempts: 3, runup: 5, lipWindow: 0.25, flight: 3.4, ring: 0.45, inst: 3, tuck: [-0.8, -0.4], speedLow: 6, speedHigh: 14, cannonWindow: 0.5, deckY: 2.2 };\n\nexport class PierActivity extends ActivityScene {\n  ownCamera = true;\n  focusV = new Vector3();\n\n  async stage(ctx) {\n    setSky(ctx, 14);\n    const rip = new RippleField({ size: [90, 26], cells: [120, 36], center: [32, 0] });\n    this.ripples = rip;\n    this.water = new WaterSurface({ size: [90, 26], at: [32, 0, 0], ripples: rip, waves: WAVES_CALM, deep: PALETTE.blue, shallow: PALETTE.cyan, foam: PALETTE.white });\n    ctx.scene.add(this.water);\n    ctx.scene.add(new Mesh(new BoxGeometry(400, 0.2, 200), toonMaterial(PALETTE.blue)).translateY(-0.5).translateZ(-40));\n    // The pier, side-on: running up to the lip at x = 0.\n    const pier = place(ctx, 'pier', { at: [-40, -0.4, 0], yaw: 90, params: { len: 40 } });\n    const pier2 = place(ctx, 'pier', { at: [-20, -0.4, 0], yaw: 90, params: { len: 40 } });\n    void pier; void pier2;\n    const lip = new Mesh(new BoxGeometry(0.5, 0.26, 3.4), toonMaterial(PALETTE.red));\n    lip.position.set(-0.2, 1.22, 0);\n    ctx.scene.add(lip);\n    for (const [d, c] of [[18, 'sand'], [28, 'cyan'], [38, 'lime']]) {\n      const buoy = new Mesh(new BoxGeometry(0.7, 1.1, 0.7), toonMaterial(PALETTE[c]));\n      buoy.position.set(d, 0.3, -2.2);\n      buoy.castShadow = true;\n      ctx.scene.add(buoy);\n      place(ctx, 'signpost', { at: [d, 0, -3], scale: 0.7 });\n    }\n    // The judges' raft.\n    const raft = new Mesh(new BoxGeometry(8, 0.5, 2.4), toonMaterial(PALETTE.sand));\n    raft.position.set(24, 0.15, -6.4);\n    ctx.scene.add(raft);\n    this.judges = [];\n    const looks = [LOOKS.marguerite, LOOKS.june, LOOKS.coach];\n    for (let i = 0; i < 3; i++) {\n      const x = 21.6 + i * 2.4;\n      const a = await makeAvatar(ctx, looks[i], { at: [x, 0.4, -6.4], yaw: 0, clip: 'Sit', shadow: false });\n      const paddle = place(ctx, 'judge-paddle', { at: [x + 0.4, 0.4, -5.6], scale: 1.3, actor: true }).object;\n      paddle.visible = false;\n      this.judges.push({ a, paddle, x, y: 0.4, score: 0, shown: false });\n    }\n    const p = playerInfo();\n    this.avatar = await makeAvatar(ctx, p.look, { at: [-30, PIER.deckY - 0.85, 0], yaw: 1.57, clip: 'TuckRun', shadow: false });\n    this.dot = new Dot(() => this.rng.next());\n    this.begin();\n  }\n\n  begin(practice = false) {\n    this.attempt = 0;\n    this.best = 0;\n    this.results = [];\n    this.isPractice = practice;\n    this.startAttempt();\n  }\n\n  startAttempt() {\n    this.stage2 = 'runup';\n    this.st = 0;\n    this.speed = PIER.speedLow;\n    this.dot.reset();\n    this.tuckT = 0;\n    this.power = 0;\n    this.pressed = false;\n    this.ringN = 0; this.ringIn = 0;\n    this.cannon = false;\n    this.distance = 0;\n    this.flight = PIER.flight;\n    this.av().play('TuckRun', { fade: 0.2 });\n    for (const j of this.judges ?? []) { j.shown = false; j.paddle.visible = false; j.a.play('Sit', { fade: 0.2 }); }\n    this.waitT = 0;\n    this.styleBonus = 0;\n  }\n\n  av() { return this.avatar; }\n\n  botInput(out, dt, brain) {\n    out.x = out.y = 0; out.confirm = false;\n    if (!brain.p) return;\n    const play = brain.play;\n    if (this.stage2 === 'runup') {\n      brain.lean(out, this.dot, 0, -0.6, dt);\n      this.botPress ??= PIER.runup + (this.botRand.next() + this.botRand.next() - 1) * play.timing * 1.4;\n      if (this.st >= this.botPress && !this.pressed) { out.confirm = true; this.botPress = undefined; }\n    } else if (this.stage2 === 'flight') {\n      brain.lean(out, this.dot, 0, 0, dt);\n      if (this.flight - this.st < 0.25 && !this.cannon) out.confirm = true;\n    }\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    const inp = this.readPlayer(ctx, dt, this.dial);\n    this.st += dt;\n    switch (this.stage2) {\n      case 'runup': {\n        const y = this.dot.y;\n        const tuck = y >= PIER.tuck[0] && y <= PIER.tuck[1];\n        this.tucked = tuck;\n        this.speed = Math.max(PIER.speedLow, Math.min(PIER.speedHigh, this.speed + (tuck ? 2.2 : -0.8) * dt));\n        this.dot.step(dt, inp.x, inp.y, T, { noise: App.noiseScale() });\n        if (App.dev.god || this.cheatRing) { this.dot.clampTo(0, -0.6, 0.15); this.speed = PIER.speedHigh; }\n        if (inp.confirm) this.jump(ctx);\n        else if (this.st >= PIER.runup + PIER.lipWindow) { this.power = 0; this.leap(ctx, scoring); }\n        break;\n      }\n      case 'flight': {\n        const m = { inst: PIER.inst, noise: App.noiseScale() };\n        this.dot.step(dt, inp.x, inp.y, T, m);\n        const ring = App.ringOf(PIER.ring * (this.hardData.ring ?? 1));\n        if (App.dev.god || this.cheatRing) this.dot.clampTo(0, 0, ring * 0.8);\n        this.ringN++;\n        if (Math.hypot(this.dot.x, this.dot.y) <= ring) this.ringIn++;\n        if (inp.confirm && this.flight - this.st <= PIER.cannonWindow && !this.cannon) {\n          this.cannon = true;\n          this.avatar.play('Cannonball', { fade: 0.08 });\n          this.styleBonus = 1;\n          App.sfx('hop');\n        }\n        if (this.st >= this.flight) this.splashDown(ctx, scoring);\n        break;\n      }\n      case 'splash':\n        if (this.st >= 2.6) this.nextAttempt();\n        break;\n      default:\n        break;\n    }\n  }\n\n  jump(ctx) {\n    const dt = this.st - PIER.runup;\n    this.pressed = true;\n    this.power = Math.max(0, 1 - Math.abs(dt) / PIER.lipWindow);\n    this.leap(ctx, true);\n  }\n\n  leap(ctx) {\n    this.stage2 = 'flight';\n    this.st = 0;\n    this.dot.reset();\n    this.flight = PIER.flight + ((this.speed - PIER.speedLow) / (PIER.speedHigh - PIER.speedLow)) * 0.6;\n    this.avatar.play('Fly', { fade: 0.12 });\n    App.sfx('jump');\n    ctx.engine.shake.add(0.15);\n    this.ringFrac = 0;\n    this.distance = this.distanceNow(0.5);\n  }\n\n  distanceNow(ringFrac) {\n    return this.speed * (0.8 + 0.6 * this.power) * (0.6 + 0.4 * ringFrac) * T.pierBoost;\n  }\n\n  splashDown(ctx, scoring) {\n    const ringFrac = this.ringN ? this.ringIn / this.ringN : 0;\n    this.ringFrac = ringFrac;\n    this.distance = this.distanceNow(ringFrac);\n    this.stage2 = 'splash';\n    this.st = 0;\n    const r = { distance: this.distance, ringFrac, power: this.power, cannon: this.cannon };\n    if (scoring && !this.isPractice) {\n      this.results.push(r);\n      this.best = Math.max(this.best, this.distance);\n    }\n    // Hitstop .1, slow motion for .8 s, huge particles, ripples, shake.\n    if (!this.attractMode) {\n      ctx.engine.hitstop(0.1);\n      ctx.engine.timeScale = 0.25;\n      ctx.tweens.call(0.2, () => { if (App.stack.open) return; ctx.engine.timeScale = App.dev.timeScale; });\n    }\n    const x = this.distance;\n    ctx.particles.burst('splashBig', [x, 0.2, 0], { count: this.cannon ? 110 : 70 });\n    this.ripples.splash(x, 0, this.cannon ? 3 : 1.8, this.cannon ? 2 : 1.2);\n    App.sfx('splash', { volume: this.cannon ? 1 : 0.8 });\n    ctx.engine.shake.add(this.cannon ? 0.7 : 0.4);\n    if (!App.settings.reduceFlashes) {\n      ctx.engine.screen.shockwave([x, 0.2, 0], { radius: 0.3 });\n    }\n    this.judge(r);\n  }\n\n  judge(r) {\n    const quality = Math.min(1, r.distance / 40) * 7 + (r.cannon ? 2 : 0) + r.ringFrac;\n    this.judges.forEach((j, i) => {\n      j.score = Math.max(0, Math.min(10, Math.round(quality + [-1, 0, 0.5][i])));\n      j.shown = true;\n      j.paddle.visible = true;\n      j.a.play('PaddleUp', { once: true, fade: 0.1 });\n    });\n    App.sfx('paddle');\n    if (!this.attractMode) App.say('ounce', r.distance >= 28 ? 'That was far. I could barely read it from here.' : r.distance >= 18 ? 'A respectable splash. The fish have been told.' : this.cosmetic.pick(BARKS.fall));\n  }\n\n  nextAttempt() {\n    if (this.isPractice) { this.startAttempt(); return; }\n    this.attempt++;\n    if (this.attempt >= PIER.attempts) { this.allDone = true; return; }\n    this.startAttempt();\n  }\n\n  isOver() { return !!this.allDone; }\n  playLength() { return 60; }\n\n  result() {\n    const best = Math.round(this.best * 10) / 10;\n    return { score: best, seconds: this.playT, display: `${best.toFixed(1)} m` };\n  }\n\n  visual(ctx, dt) {\n    const a = this.avatar.root;\n    const u = this.stage2 === 'flight' ? Math.min(1, this.st / this.flight) : 1;\n    if (this.stage2 === 'runup') {\n      const left = PIER.runup - this.st;\n      a.position.set(-left * this.speed, PIER.deckY - 0.88, 0);\n      a.rotation.y = 1.57;\n      this.avatar.action('TuckRun').timeScale = this.speed / 8;\n    } else if (this.stage2 === 'flight') {\n      const est = this.distanceNow(this.ringN ? this.ringIn / this.ringN : 0.5);\n      a.position.x = est * u;\n      a.position.y = PIER.deckY - 0.88 + Math.sin(u * Math.PI) * 4.2 - u * (PIER.deckY - 0.5);\n      a.position.z = 0;\n    } else if (this.stage2 === 'splash') {\n      a.position.set(this.distance, Math.max(-1.7, 0.1 - this.st * 2.6), 0);\n    }\n    this.avatar.update(dt);\n    if (this.stage2 === 'flight') this.avatar.lean(this.dot.x * 2, this.dot.y, 0, this.t);\n    else if (this.stage2 === 'runup') this.avatar.lean(0, this.dot.y * 0.6, 0, this.t);\n    for (const j of this.judges) j.a.update(dt);\n    this.water?.update(ctx.time);\n    this.ripples?.step(dt);\n    this.focusV.set(a.position.x + 5, 3.4, 0);\n    if (this.stage2 === 'runup') this.focusV.x = a.position.x + 7;\n  }\n\n  cameraTarget() { return this.focusV; }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    const { hud } = ctx;\n    const cx = Math.round(hud.width * 0.5);\n    const cy = 56;\n    this.dial = { x: cx, y: cy };\n    const mouse = App.device.last === 'mouse' && !this.autopilot ? App.device.pointerArt(ctx) : null;\n    if (this.stage2 === 'runup') {\n      // The tuck zone, low on the dial: hold the Dot in it to build speed.\n      const r = 40;\n      drawDial(hud, { x: cx, y: cy, r, dot: this.dot, ringR: 0.2, ringY: -0.6, inside: this.tucked, brighten: this.tucked ? 1 : 0, mouse });\n      bar(hud, cx - r, cy + r + 5, r * 2, 6, (this.speed - PIER.speedLow) / (PIER.speedHigh - PIER.speedLow), 'orange', 'ink', 'speed');\n      sayCentered(hud, cx, cy + r + 13, `${this.speed.toFixed(1)} m/s`, { color: 'white', name: 'speed-label' });\n      const left = PIER.runup - this.st;\n      if (left < 1 && left > -PIER.lipWindow) {\n        const on = Math.abs(left) < PIER.lipWindow;\n        promptBar(hud, App.device, [['confirm', on ? 'NOW' : 'Jump']], { y: cy + r + 26 });\n      }\n    } else if (this.stage2 === 'flight') {\n      const r = 40;\n      const ring = App.ringOf(PIER.ring * (this.hardData.ring ?? 1));\n      drawDial(hud, { x: cx, y: cy, r, dot: this.dot, ringR: ring, inside: Math.hypot(this.dot.x, this.dot.y) <= ring, mouse });\n      const inWindow = this.flight - this.st <= PIER.cannonWindow;\n      if (inWindow && !this.cannon) promptBar(hud, App.device, [['confirm', 'Cannonball!']], { y: cy + r + 10 });\n    } else if (this.stage2 === 'splash') {\n      panel(hud, cx - 70, 24, 140, 56, { fill: 'white', name: 'pier-result' });\n      sayCentered(hud, cx, 30, `${this.distance.toFixed(1)} m`, { scale: 3, color: 'ink', shadow: false, name: 'distance' });\n      let jx = cx - 48;\n      for (const j of this.judges) {\n        if (j.shown) { hud.rect(jx, 56, 24, 18, 'navy'); sayCentered(hud, jx + 12, 60, String(j.score), { color: 'white', shadow: false, name: 'paddle' }); }\n        jx += 36;\n      }\n    }\n    const marks = [`Attempt ${Math.min(this.attempt + 1, PIER.attempts)} of ${PIER.attempts}`, `Best ${this.best.toFixed(1)} m`];\n    hud.rect(10, 6, 120, 25, 'navy');\n    say(hud, 13, 8, marks[0], { name: 'attempt' });\n    say(hud, 13, 19, marks[1], { color: 'sand', name: 'attempt-best' });\n  }\n\n  overlayDot() { return `${this.stage2} v ${this.speed.toFixed(1)} p ${this.power.toFixed(2)}`; }\n  fingerprint() { return `${this.best.toFixed(4)}|${this.attempt}|${this.dot.x.toFixed(5)}`; }\n}\nEOF\ncat > src/data/jog.js <<'EOF'\n// Island Jog: the path round Tare Island, as (x, z) control points on a closed Catmull-Rom curve.\nexport const JOG_PATH = [\n  [0, 8.5], [6, 12.5], [14, 15.2], [19, 13], [15.8, 7.4], [15.2, 0], [15.8, -4.4], [18.6, -7], [19.4, -13], [14, -15.6],\n  [7, -14.6], [1, -13.6], [-4.4, -11.8], [-6.4, -7], [-13, -6.2], [-20, -7], [-20.6, 1], [-20.2, 10], [-15, 15], [-8, 15.4],\n  [-3.6, 11], [-5.4, 7.2], [-9.4, 7.6], [-11, 9.8], [-3, 9.6],\n];\nexport const JOG = { speed: 3, bandLow: -0.6, bandHigh: 0.6, stitchAfter: 2, stitchSeconds: 3, stitchSpeed: 0.5, stumble: 0.5, wait: 12, cups: 18, strafe: 1.5, strafeSpeed: 3, limit: 110, hitRadius: 0.75, cupRadius: 0.8 };\n/** Obstacles at a share of the way round, offset across the path. */\nexport const JOG_OBSTACLES = [\n  { u: 0.1, x: 0.8, kind: 'sprinkler' }, { u: 0.17, x: -0.8, kind: 'picnic' }, { u: 0.27, x: 0.2, kind: 'dennis' }, { u: 0.35, x: 0.9, kind: 'sprinkler' },\n  { u: 0.43, x: -0.6, kind: 'kevin' }, { u: 0.52, x: 0.7, kind: 'picnic' }, { u: 0.6, x: -0.9, kind: 'sprinkler' }, { u: 0.68, x: 0.3, kind: 'dennis' },\n  { u: 0.77, x: -0.5, kind: 'picnic' }, { u: 0.85, x: 0.6, kind: 'kevin' }, { u: 0.93, x: -0.8, kind: 'sprinkler' },\n];\nEOF\ncat > src/scenes/activity/jog.js <<'EOF'\n// Island Jog: a rail run round the whole island. Coach paces you on a white mobility scooter.\nimport { ContactShadow, THREE, Trail } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { Kevin, place } from '../../art/props.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { JOG, JOG_OBSTACLES, JOG_PATH } from '../../data/jog.js';\nimport { say } from '../../ui/font.js';\nimport { bar } from '../../ui/widgets.js';\nimport { topRow } from '../../ui/activity-hud.js';\nimport { ActivityScene } from './base.js';\nimport { playerInfo } from './lanes.js';\nimport { buildIsland } from '../hub.js';\n\nconst { CatmullRomCurve3, Vector3 } = THREE;\n\nexport class JogActivity extends ActivityScene {\n  focusV = new Vector3();\n  p = new Vector3();\n  tan = new Vector3();\n\n  async stage(ctx) {\n    const world = buildIsland(ctx, { walls: false });\n    this.water = world.water;\n    this.curve = new CatmullRomCurve3(JOG_PATH.map(([x, z]) => new Vector3(x, 0.08, z)), true, 'catmullrom', 0.5);\n    this.length = this.curve.getLength();\n    this.curve.arcLengthDivisions = 800;\n    this.curve.updateArcLengths();\n    const p = playerInfo();\n    this.avatar = await makeAvatar(ctx, p.look, { at: [0, 0.08, 8.5], clip: 'Jog' });\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [0, 0.3, 8], clip: 'Sit', shadow: false });\n    this.scooter = place(ctx, 'mobility-scooter', { actor: true }).object;\n    this.scootShadow = new ContactShadow(0.7);\n    ctx.scene.add(this.scootShadow);\n    this.trail = new Trail({ width: 0.24, life: 0.5, color: 0x74f0f7, tail: 0xffffff });\n    ctx.scene.add(this.trail);\n    // Water cups along the way, on either side.\n    this.cups = [];\n    for (let i = 0; i < JOG.cups; i++) {\n      const u = (i + 0.7) / JOG.cups;\n      const x = [0.9, -0.9, 0, 1.2, -0.4, 0.5][i % 6];\n      const at = this.pointAt(u, x);\n      const m = place(ctx, 'water-cup', { at: [at.x, 0.06, at.z], actor: true, shadow: false }).object;\n      this.cups.push({ u, x, m, taken: false });\n    }\n    // Sprinklers, picnics, Dennis stretching, and Kevin.\n    this.obs = [];\n    for (const o of JOG_OBSTACLES) {\n      const at = this.pointAt(o.u, o.x);\n      let mesh = null;\n      if (o.kind === 'sprinkler') { mesh = place(ctx, 'sprinkler', { at: [at.x, 0.06, at.z], actor: true }).object; } else if (o.kind === 'picnic') { mesh = place(ctx, 'picnic', { at: [at.x, 0.06, at.z], yaw: 30, actor: true }).object; } else if (o.kind === 'dennis') {\n        const d = await makeAvatar(ctx, LOOKS.dennis, { at: [at.x, 0.06, at.z], yaw: 1, clip: 'Stretch' });\n        this.obs.push({ ...o, av: d });\n        continue;\n      } else {\n        const k = new Kevin(ctx, { at: [at.x, 0.06, at.z], yaw: 1 });\n        this.obs.push({ ...o, kevin: k });\n        continue;\n      }\n      this.obs.push({ ...o, mesh });\n    }\n    this.begin();\n  }\n\n  pointAt(u, x, out = new Vector3()) {\n    const uu = ((u % 1) + 1) % 1;\n    this.curve.getPointAt(uu, out);\n    this.curve.getTangentAt(uu, this.tan);\n    const nx = -this.tan.z, nz = this.tan.x;\n    out.x += nx * x; out.z += nz * x;\n    return out;\n  }\n\n  begin() {\n    this.dist = 0;\n    this.coachDist = 3;\n    this.speed = 0;\n    this.cadence = 0;\n    this.lastFoot = null;\n    this.stepEnergy = 0;\n    this.stitchT = 0;\n    this.overT = 0;\n    this.stumbleT = 0;\n    this.inBandT = 0;\n    this.time = 0;\n    this.cupsGot = 0;\n    this.x = 0;\n    this.botNext = 0;\n    this.botFoot = 'L';\n    this.hitCooldown = 0;\n    for (const c of this.cups ?? []) { c.taken = false; c.m.visible = true; }\n    this.trail?.reset();\n  }\n\n  get targetCadence() { return T.jogTargetCadence * (this.hardData.cadence ?? 1); }\n  get bandLow() { return this.targetCadence + JOG.bandLow; }\n  get bandHigh() { return this.targetCadence + JOG.bandHigh; }\n\n  botInput(out, dt, brain) {\n    out.x = out.y = 0; out.stepL = out.stepR = false;\n    if (!brain.p) return;\n    const play = brain.play;\n    if (this.time >= this.botNext) {\n      const interval = 1 / (this.targetCadence + (play.timing > 0.1 ? Math.sin(this.time * 0.6) * 0.8 : Math.sin(this.time * 0.6) * 0.3));\n      const slip = this.botRand.next() < play.miss * 0.3;\n      const foot = slip ? this.lastFoot ?? 'L' : (this.lastFoot === 'L' ? 'R' : 'L');\n      if (foot === 'L') out.stepL = true; else out.stepR = true;\n      this.botNext = this.time + interval + (this.botRand.next() - 0.5) * play.timing;\n    }\n    // Steer: toward the next cup, around the next obstacle.\n    const u = this.dist / this.length;\n    let wantX = 0;\n    const next = this.cups.find((c) => !c.taken && c.u > u && (c.u - u) * this.length < 14);\n    if (next) wantX = next.x;\n    for (const o of this.obs) {\n      const d = (o.u - u) * this.length;\n      if (d > 0 && d < 5 && Math.abs(wantX - o.x) < JOG.hitRadius + 0.05) wantX = o.x + (o.x > 0 ? -1.2 : 1.2);\n    }\n    out.x = -Math.max(-1, Math.min(1, (wantX - this.x) * 3)) * play.speed;\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    const inp = this.readPlayer(ctx, dt, { x: ctx.hud.width / 2, y: ctx.hud.height / 2 });\n    const step = (foot) => {\n      if (foot === this.lastFoot) {\n        this.stumbleT = JOG.stumble;\n        App.sfx('stepMiss');\n        if (this.scoring && !this.attractMode && this.t > (this.remarkT ?? 0)) { this.remarkT = this.t + 5; App.say('ounce', 'Left, right. Not left, left. Left, left is a stumble.'); }\n      } else {\n        this.stepEnergy += 1;\n        App.sfx('step', { volume: 0.2 });\n      }\n      this.lastFoot = foot;\n    };\n    if (inp.stepL) step('L');\n    if (inp.stepR) step('R');\n    // Cadence: smoothed steps/s.\n    const rawCadence = this.stepEnergy / dt;\n    this.stepEnergy = 0;\n    this.cadence += (rawCadence - this.cadence) * Math.min(1, dt / 0.7);\n    if (this.stumbleT > 0) this.stumbleT -= dt;\n    if (this.cadence > this.bandHigh) { this.overT += dt; if (this.overT >= JOG.stitchAfter && this.stitchT <= 0) { this.stitchT = JOG.stitchSeconds; this.overT = 0; App.sfx('stitch'); if (!this.attractMode) App.say('ounce', 'A stitch. Your side has filed a complaint.'); } } else this.overT = Math.max(0, this.overT - dt);\n    if (this.stitchT > 0) this.stitchT -= dt;\n    let v = (this.cadence / this.targetCadence) * JOG.speed;\n    v = Math.min(v, JOG.speed * 1.35);\n    if (this.stitchT > 0) v *= JOG.stitchSpeed;\n    if (this.stumbleT > 0) v = 0.4;\n    this.speed += (v - this.speed) * Math.min(1, dt * 5);\n    if (App.dev.god) this.speed = JOG.speed;\n    if (this.cheatRing) this.speed = JOG.speed * 1.4;\n    this.dist += this.speed * dt;\n    const inBand = this.cadence >= this.bandLow && this.cadence <= this.bandHigh && this.stitchT <= 0;\n    this.inBand = inBand;\n    if (inBand && scoring) this.inBandT += dt;\n    this.x = Math.max(-JOG.strafe, Math.min(JOG.strafe, this.x - inp.x * JOG.strafeSpeed * dt));\n    // Coach goes at exactly target speed. More than 12 m behind, she waits, unimpressed.\n    if (this.coachDist - this.dist < JOG.wait) this.coachDist = Math.min(this.length + 2, this.coachDist + JOG.speed * dt);\n    // Cups and obstacles.\n    const u = this.dist / this.length;\n    if (this.hitCooldown > 0) this.hitCooldown -= dt;\n    for (const c of this.cups) {\n      if (c.taken) continue;\n      if (Math.abs((c.u - u) * this.length) < 0.8 && Math.abs(c.x - this.x) < JOG.cupRadius) {\n        c.taken = true; c.m.visible = false;\n        if (scoring) this.cupsGot++;\n        App.sfx('cupGet', { pitch: this.cupsGot * 0.5 });\n        ctx.particles.burst('dripDrop', [this.avatar.root.position.x, 1, this.avatar.root.position.z]);\n      }\n    }\n    if (this.hitCooldown <= 0 && !this.cheatRing && !App.dev.god) {\n      for (const o of this.obs) {\n        if (Math.abs((o.u - u) * this.length) < 0.8 && Math.abs(o.x - this.x) < JOG.hitRadius) {\n          this.hitCooldown = 1.2;\n          this.stumbleT = 0.7;\n          App.sfx('flipFlopThwap', { volume: 0.5 });\n          if (o.kind === 'kevin') App.sfx('gullSquawk');\n          if (this.scoring && !this.attractMode && this.t > (this.remarkT ?? 0)) { this.remarkT = this.t + 5; App.say('ounce', o.kind === 'dennis' ? 'That was Dennis. He says it\\'s fine.' : o.kind === 'kevin' ? 'That was Kevin. He has been told.' : 'Please watch the amenities.'); }\n          break;\n        }\n      }\n    }\n  }\n\n  isOver() { return this.dist >= this.length || this.time >= JOG.limit; }\n  playLength() { return JOG.limit; }\n\n  result() {\n    const nominal = this.length / JOG.speed;\n    const pace = Math.min(1, this.inBandT / nominal);\n    const cups = this.cupsGot / JOG.cups;\n    const finished = this.dist >= this.length;\n    const score = Math.round((70 * pace + 30 * cups) * (finished ? 1 : 0.8));\n    return { score, seconds: this.time, display: `${score}%`, pace, cups: this.cupsGot };\n  }\n\n  visual(ctx, dt) {\n    const u = Math.min(0.9999, this.dist / this.length);\n    const at = this.pointAt(u, this.x, this.p);\n    const a = this.avatar.root;\n    const uu = u;\n    this.curve.getTangentAt(uu, this.tan);\n    a.position.set(at.x, 0.08, at.z);\n    a.rotation.y = Math.atan2(this.tan.x, this.tan.z);\n    if (this.stumbleT > 0) this.avatar.play('Hurt', { fade: 0.08 });\n    else if (this.speed < 0.3) this.avatar.play('Idle', { fade: 0.2 });\n    else { const act = this.avatar.play('Jog', { fade: 0.15 }); act.timeScale = this.speed / 3; }\n    this.avatar.update(dt);\n    // Coach and her scooter.\n    const cu = Math.min(0.9999, this.coachDist / this.length);\n    const cp = this.pointAt(cu, -0.2, new Vector3());\n    this.curve.getTangentAt(cu, this.tan);\n    const yaw = Math.atan2(this.tan.x, this.tan.z);\n    this.scooter.position.set(cp.x, 0.06, cp.z);\n    this.scooter.rotation.y = yaw;\n    this.scootShadow.place(cp.x, 0.07, cp.z, 0);\n    this.coach.root.position.set(cp.x, 0.24, cp.z);\n    this.coach.root.rotation.y = yaw;\n    this.coach.update(dt);\n    for (const o of this.obs) {\n      if (o.av) o.av.update(dt);\n      if (o.kevin) o.kevin.update(dt);\n      if (o.kind === 'sprinkler' && o.mesh) {\n        const arm = o.mesh.getObjectByName('arm');\n        if (arm) arm.rotation.y = this.t * 6;\n      }\n    }\n    this.trail.push(a.position, ctx.time);\n    this.trail.update(ctx.time, ctx.camera.camera);\n    this.water?.update(ctx.time);\n    this.focusV.set(at.x + this.tan.x * 2, 1, at.z + this.tan.z * 2);\n  }\n\n  cameraTarget() { return this.focusV; }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    const { hud } = ctx;\n    const cx = Math.round(hud.width / 2);\n    const w = Math.min(hud.width - 60, 240);\n    // Cadence: a gauge with its band marked.\n    const y = 30;\n    const max = this.bandHigh + 1.4;\n    hud.rect(cx - w / 2 - 1, y - 1, w + 2, 12, 'ink');\n    hud.rect(cx - w / 2, y, w, 10, 'white');\n    const bx = cx - w / 2 + (this.bandLow / max) * w;\n    hud.rect(Math.round(bx), y, Math.round(((this.bandHigh - this.bandLow) / max) * w), 10, this.inBand ? 'lime' : 'mist');\n    const mx = cx - w / 2 + (Math.min(max, this.cadence) / max) * w;\n    hud.rect(Math.round(mx) - 2, y - 2, 4, 14, this.stitchT > 0 ? 'red' : 'ink');\n    const gap = this.coachDist - this.dist;\n    bar(hud, cx - w / 2, y + 14, w, 5, this.dist / this.length, 'cyan', 'ink', 'jog-progress');\n    if (gap >= JOG.wait - 0.2) { hud.rect(cx - 80, y + 22, 160, 12, 'navy'); say(hud, cx - 76, y + 24, 'Coach waits, unimpressed.', { color: 'sand', name: 'coach-wait' }); }\n    if (this.stitchT > 0) { hud.rect(cx - 30, y + 22, 60, 12, 'navy'); say(hud, cx - 24, y + 24, 'Stitch', { color: 'red', name: 'stitch' }); }\n  }\n\n  drawGameHud(ctx) {\n    const left = Math.max(0, this.length - this.dist);\n    topRow(ctx.hud, `${Math.ceil(left)} m`, `${this.cupsGot}/${JOG.cups} cups`);\n  }\n\n  overlayDot() { return `cad ${this.cadence.toFixed(2)} v ${this.speed.toFixed(2)} x ${this.x.toFixed(2)}`; }\n  fingerprint() { return `${this.dist.toFixed(4)}|${this.cupsGot}|${this.inBandT.toFixed(4)}`; }\n}\nEOF\ncat > src/data/longstand.js <<'EOF'\n// The Long Stand, as a timeline. A new event is a new row.\nexport const STAND_LENGTH = 90;\nexport const STAND_TIMELINE = [\n  { t: 0, say: ['coach', 'Stand.'], ring: 0.4 },\n  { t: 10, kevinOn: true, biasX: 0.1, say: ['ounce', 'Kevin is on your head. He is staff. Carry on.'] },\n  { t: 20, sneeze: true, impulse: [0, -0.6], say: ['dennis', 'Sorry. Sorry. It\\'s just the one nose.'] },\n  { t: 30, ring: 0.34 },\n  { t: 35, rain: true, noise: 1.2 },\n  { t: 45, clap: true, say: ['ounce', 'Ignore her.'] },\n  { t: 50, ring: 0.28 },\n  { t: 55, juneText: 'Are you nearly done?', say: ['june', 'Are you nearly done?'] },\n  { t: 65, rumble: true, randomImpulse: 0.6 },\n  { t: 75, rain: false, noise: 1, sun: true, ring: 0.24, swell: true },\n  { t: 85, kevinOn: false, biasX: 0, impulse: [0.3, 0.2], say: ['ounce', 'Kevin has left. He said nothing. He never does.'] },\n  { t: 90, say: ['coach', 'You may blink.'] },\n];\nEOF\ncat > src/scenes/activity/longstand.js <<'EOF'\n// The Long Stand. 90 seconds of standing still while the whole island tries to distract you.\nimport { applySky, Precipitation, skyAt, THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { Kevin, Ounce } from '../../art/props.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { STAND_LENGTH, STAND_TIMELINE } from '../../data/longstand.js';\nimport { say } from '../../ui/font.js';\nimport { drawDial } from '../../ui/widgets.js';\nimport { topRow } from '../../ui/activity-hud.js';\nimport { ActivityScene } from './base.js';\nimport { playerInfo } from './lanes.js';\nimport { plazaSet } from '../sets.js';\n\nconst { Vector3 } = THREE;\n\nexport class LongStandActivity extends ActivityScene {\n  outroLength = 2.4;\n  rainAt = new Vector3(0, 0, 0);\n\n  async stage(ctx) {\n    plazaSet(ctx, 17.5);\n    applySky(ctx.engine, skyAt(17.5));\n    const p = playerInfo();\n    this.you = await makeAvatar(ctx, p.look, { at: [0, 0, 1], yaw: 0, clip: 'Idle' });\n    this.addOunce(ctx, { at: [-1.7, 0.04, 1.9], yaw: 0.4, scale: 1.3 });\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [3.2, 0, -0.8], yaw: -0.5, clip: 'CoachStand' });\n    this.coach.addPlumb();\n    this.marguerite = await makeAvatar(ctx, LOOKS.marguerite, { at: [-3.4, 0, -0.8], yaw: 0.5, clip: 'Watch' });\n    this.dennis = await makeAvatar(ctx, LOOKS.dennis, { at: [-4.4, 0, 0.8], yaw: 0.7, clip: 'Slump' });\n    this.june = await makeAvatar(ctx, LOOKS.june, { at: [4.5, 0, 0.8], yaw: -0.7, clip: 'Watch' });\n    this.kevin = new Kevin(ctx, { at: [2, 3, -2], yaw: 2 });\n    this.rain = new Precipitation({ kind: 'rain', count: 2400, area: [20, 12, 12] });\n    ctx.scene.add(this.rain);\n    this.rain.intensity = 0;\n    this.dot = new Dot(() => this.rng.next());\n    this.begin(false);\n  }\n\n  startMusic() { App.music('stand'); }\n\n  begin() {\n    this.time = this.args.from ?? 0;\n    this.nextEvent = 0;\n    while (this.nextEvent < STAND_TIMELINE.length && STAND_TIMELINE[this.nextEvent].t < this.time) this.applyEvent(STAND_TIMELINE[this.nextEvent++], true);\n    if (this.nextEvent === 0) { this.ring = 0.4; this.bias = 0; this.noise = 1; }\n    this.dot.reset();\n    this.frames = 0; this.inside = 0;\n    this.juneT = 0;\n    this.wasInside = false;\n    this.clapT = -1;\n  }\n\n  /** Effects from the data. silent: replaying them to reach a later starting point. */\n  applyEvent(e, silent = false) {\n    if (e.ring !== undefined) this.ring = e.ring;\n    if (e.biasX !== undefined) this.bias = e.biasX;\n    if (e.noise !== undefined) this.noise = e.noise;\n    if (e.rain !== undefined) this.raining = e.rain;\n    if (silent) return;\n    const ctx = this.ctx;\n    if (e.say) App.say(e.say[0], e.say[1]);\n    if (e.kevinOn === true) this.kevin.flyTo(0, 1.74, 1, 1.1);\n    if (e.kevinOn === false) { this.kevin.flyTo(-14, 9, -16, 3); this.kevinPerched = false; }\n    if (e.kevinOn === true) this.kevinPerched = true;\n    if (e.sneeze) { App.sfx('sneeze'); this.dennis.play('Sneeze', { once: true, fade: 0.05, then: () => this.dennis.play('Slump', { fade: 0.3 }) }); }\n    if (e.impulse) this.dot.impulse(e.impulse[0], e.impulse[1]);\n    if (e.clap) { this.marguerite.play('SlowClap', { fade: 0.3 }); this.clapT = 0; }\n    if (e.juneText) { this.juneT = 9; this.juneMsg = e.juneText; }\n    if (e.rumble) {\n      App.sfx('rumble');\n      ctx.engine.shake.add(0.8);\n      const a = this.rng.range(0, 6.28);\n      this.dot.impulse(Math.cos(a) * e.randomImpulse, Math.sin(a) * e.randomImpulse);\n    }\n    if (e.sun) {\n      applySky(ctx.engine, skyAt(16));\n      if (!App.settings.reduceFlashes) App.flash('sand', { duration: 0.4 });\n    }\n  }\n\n  botInput(out, dt, brain) { brain.lean(out, this.dot, 0, 0, dt); }\n\n  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    while (this.nextEvent < STAND_TIMELINE.length && STAND_TIMELINE[this.nextEvent].t <= this.time) this.applyEvent(STAND_TIMELINE[this.nextEvent++]);\n    const inp = this.readPlayer(ctx, dt, this.dial);\n    this.dot.step(dt, inp.x, inp.y, T, { noise: this.noise * App.noiseScale(), bx: this.bias * T.dotAuthority });\n    const ring = App.ringOf(this.ring) * this.ringBoost;\n    if (App.dev.god || this.cheatRing) this.dot.clampTo(0, 0, ring * 0.9);\n    const inside = Math.hypot(this.dot.x, this.dot.y) <= ring;\n    if (inside !== this.wasInside) { App.sfx(inside ? 'ringIn' : 'ringOut', { volume: 0.5 }); this.wasInside = inside; }\n    if (scoring) { this.frames++; if (inside) this.inside++; }\n    if (this.clapT >= 0) {\n      this.clapT += dt;\n      if (this.clapT > 1.2 && this.time < 75) { this.clapT = 0; App.sfx('clap'); }\n    }\n    this.you.action('Idle').timeScale = 1;\n  }\n\n  isOver() { return this.time >= STAND_LENGTH; }\n  playLength() { return STAND_LENGTH; }\n\n  result() {\n    const score = Math.round(this.frames ? (100 * this.inside) / this.frames : 0);\n    return { score, seconds: this.time, display: `${score}%` };\n  }\n\n  onOutroStart() {\n    this.coach.play('Bow', { once: true, fade: 0.3 });\n    this.marguerite.play('Idle', { fade: 0.3 });\n  }\n\n  visual(ctx, dt) {\n    this.you.update(dt);\n    const ring = App.ringOf(this.ring ?? 0.4);\n    const d = Math.hypot(this.dot.x, this.dot.y);\n    this.you.lean(this.dot.x, this.dot.y, d > ring ? Math.min(1.5, (d - ring) * 3) : 0, this.t);\n    for (const a of [this.marguerite, this.dennis, this.june]) a.update(dt);\n    this.rain.intensity += ((this.raining ? 1 : 0) - this.rain.intensity) * Math.min(1, dt * 1.2);\n    this.rain.update(dt, this.rainAt);\n    if (this.kevinPerched && this.kevin.state !== 'fly') {\n      const head = this.you.head?.getWorldPosition?.(this.rainAt);\n      if (head) this.kevin.root.position.set(head.x, head.y + 0.42, head.z);\n      this.rainAt.set(0, 0, 0);\n    }\n    this.juneT = Math.max(0, this.juneT - dt);\n    this.camPush = Math.min(1.6, (this.time / STAND_LENGTH) * 1.6);\n  }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro' || this.phase === 'results') return;\n    const { hud } = ctx;\n    const ring = App.ringOf(this.ring ?? 0.4) * this.ringBoost;\n    const x = Math.round(hud.width / 2), y = 56, r = 44;\n    this.dial = { x, y };\n    const mouse = App.device.last === 'mouse' && !this.autopilot ? App.device.pointerArt(ctx) : null;\n    drawDial(hud, { x, y, r, dot: this.dot, ringR: ring, inside: this.wasInside, brighten: 1, mouse });\n    if (this.juneT > 0) {\n      // Text drifting across the dial: June's contribution.\n      const u = 1 - this.juneT / 9;\n      const tx = Math.round(x - 110 + u * 150);\n      say(hud, tx, y - 4 + Math.round(Math.sin(u * 9) * 8), this.juneMsg, { color: 'red', shadow: 'white', name: 'june' });\n    }\n  }\n\n  drawGameHud(ctx) {\n    const left = Math.max(0, STAND_LENGTH - this.time);\n    topRow(ctx.hud, `${Math.ceil(left)}s`, this.frames ? `${Math.round((100 * this.inside) / this.frames)}%` : '');\n  }\n\n  overlayDot() { return `${this.dot.x.toFixed(2)},${this.dot.y.toFixed(2)} ring ${this.ring?.toFixed(2)} t ${this.time?.toFixed(1)}`; }\n  fingerprint() { return `${this.dot.x.toFixed(6)}|${this.inside}|${this.frames}`; }\n}\nEOF\npython3 - <<'EOF'\np='src/scenes/index.js'; s=open(p).read()\ns=s.replace(\"\"\"import { PoseActivity } from './activity/poses.js';\"\"\",\"\"\"import { PoseActivity } from './activity/poses.js';\nimport { RepsActivity } from './activity/reps.js';\nimport { HoopActivity } from './activity/hoop.js';\nimport { StepActivity } from './activity/step.js';\nimport { HeaderActivity } from './activity/header.js';\nimport { SlacklineActivity } from './activity/slackline.js';\nimport { TrayActivity } from './activity/tray.js';\nimport { PierActivity } from './activity/pier.js';\nimport { JogActivity } from './activity/jog.js';\nimport { LongStandActivity } from './activity/longstand.js';\"\"\")\ns=s.replace(\"\"\"  poses: PoseActivity,\n\"\"\",\"\"\"  poses: PoseActivity, reps: RepsActivity, hoop: HoopActivity, step: StepActivity, header: HeaderActivity,\n  slackline: SlacklineActivity, tray: TrayActivity, pier: PierActivity, jog: JogActivity, longstand: LongStandActivity,\n\"\"\")\nopen(p,'w').write(s)\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [ ] 5 Other activities (Hoop, Reps, Header, Step, Slackline, Tray, Pier, Jog)\",\"- [~] 5 Other activities: all written (src/scenes/activity/*) incl longstand; bot tuning/tests next\")\nopen(p,'w').write(s)\nEOF\ncat > .scratch/acts.mjs <<'EOF'\nimport { boot, App } from '../tests/lib.mjs';\nimport { PLAYABLE_IDS, ACTIVITY_IDS, ACTIVITIES } from '../src/data/activities.js';\nconst only = process.argv[2] ? process.argv[2].split(',') : ACTIVITY_IDS;\nconst h = await boot({ scene:'title' });\nfor (const id of only) {\n  const row=[];\n  for (const skill of ['idle','sloppy','average','good','expert']) {\n    try {\n    await h.go('activity',{ id, mode:'dropin', noPractice:true });\n    App.dev.autopilot = skill;\n    const started=Date.now();\n    await h.until(()=>App.scene.resultsShown,{what:id+' '+skill, max:60*200, every:60});\n    const r=App.scene.lastResult;\n    row.push(`${skill}:${typeof r.score==='number'?r.score.toFixed?r.score.toFixed(0):r.score:r.score}/${r.stars}*${(r.seconds||0).toFixed(0)}s`);\n    } catch(e){ row.push(skill+':ERR '+e.message.slice(0,200)); }\n    h.engine.errors.length && row.push('E:'+h.engine.errors.slice(-1)[0].slice(0,100));\n  }\n  console.log(id.padEnd(10), row.join('  '));\n  App.dev.autopilot=null;\n}\nprocess.exit(0);\nEOF\ntimeout 280 node .scratch/acts.mjs </dev/null 2>&1 | tail -30 | cut -c1-320","description":"Write Slackline, Tray, Pier, Jog and Long Stand, then run bots through every activity","timeout":295000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":30425,"cache_read_input_tokens":442611,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":30425},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"33dbdfd0-9748-4def-93f6-2f3ad3f101cf","timestamp":"2026-11-05T06:57:29.614Z","request_id":"req_011CgjLkh7QnNZXBPaLGUqs9","wire_tool_inputs":{"toolu_01CnDcYmdVPBJiM3Jc76bhSZ":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\npython3 - <<'EOF'\np='src/scenes/activity/reps.js'; s=open(p).read()\ns=s.replace(\"import { T } from '../../core/tunables.js';\",\"import { T } from '../../core/tunables.js';\\nimport { CLIP_NAMES } from '../../art/clips.js';\")\ns=s.replace(\"return [App.clipIndex(this.clipFor(rep)), lane.state.rVis];\",\"return [CLIP_NAMES.indexOf(this.clipFor(rep)), lane.state.rVis];\")\nopen(p,'w').write(s)\nEOF\ncat > src/data/slackline.js <<'EOF'\n// Slackline tuning that isn't a live slider.\nexport const SLACK = {\n  length: 30, limit: 75, walkSpeed: 1.1, standInst: 1.2, noise: 1.25, fallAt: 1, gustEvery: 6, gustSeconds: 1, gustWarn: 1.5,\n  checkpoints: [0, 10, 20], kevinOn: 18, kevinOff: 24, kevinBias: 0.18, fallSeconds: 1.2, height: 2.7,\n};\nEOF\ncat > src/scenes/activity/slackline.js <<'EOF'\n// Slackline. X is balance, forward is progress. Stopping to recover is a real choice.\nimport { RippleField, THREE, toonMaterial, PALETTE, WAVES_CALM, WaterSurface } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { Kevin, place } from '../../art/props.js';\nimport { BARKS } from '../../data/lines.js';\nimport { SLACK } from '../../data/slackline.js';\nimport { sayCentered } from '../../ui/font.js';\nimport { bar, disc, line, panel } from '../../ui/widgets.js';\nimport { topRow } from '../../ui/activity-hud.js';\nimport { ActivityScene } from './base.js';\nimport { playerInfo } from './lanes.js';\nimport { setSky } from '../sets.js';\n\nconst { BoxGeometry, Mesh, Vector3 } = THREE;\n\nexport class SlacklineActivity extends ActivityScene {\n  ownCamera = true;\n\n  async stage(ctx) {\n    setSky(ctx, 13);\n    const rip = new RippleField({ size: [40, 60], cells: [80, 120], center: [0, 15] });\n    this.ripples = rip;\n    this.water = new WaterSurface({ size: [40, 60], at: [0, 0, 15], ripples: rip, waves: WAVES_CALM, deep: PALETTE.blue, shallow: PALETTE.cyan, foam: PALETTE.white });\n    ctx.scene.add(this.water);\n    ctx.scene.add(new Mesh(new BoxGeometry(260, 0.2, 160), toonMaterial(PALETTE.blue)).translateZ(100).translateY(-0.6));\n    place(ctx, 'slack-anchor', { at: [0, 0, -1.6] });\n    place(ctx, 'slack-anchor', { at: [0, 0, SLACK.length + 1.6] });\n    for (const [x, z] of [[-14, 8], [13, 18], [-11, 26], [9, 4]]) place(ctx, 'medicine-ball', { at: [x, -0.3, z], scale: 1.3 });\n    for (const [x, z, s] of [[-7, -3, 1.2], [8, -3, 1.1], [-8, 36, 1.2], [8, 36, 1.2]]) place(ctx, 'palm', { at: [x, 0, z], scale: s });\n    const sand1 = new Mesh(new BoxGeometry(24, 0.4, 7), toonMaterial(PALETTE.sand)); sand1.position.set(0, -0.1, -3.8); ctx.scene.add(sand1);\n    const sand2 = new Mesh(new BoxGeometry(24, 0.4, 7), toonMaterial(PALETTE.sand)); sand2.position.set(0, -0.1, SLACK.length + 3.8); ctx.scene.add(sand2);\n    // The line: segments we move each frame so it sags under your feet.\n    const mat = toonMaterial(PALETTE.red);\n    this.segs = [];\n    this.nSegs = 40;\n    for (let i = 0; i < this.nSegs; i++) {\n      const m = new Mesh(new BoxGeometry(0.1, 0.07, (SLACK.length + 2) / this.nSegs + 0.05), mat);\n      ctx.scene.add(m);\n      this.segs.push(m);\n    }\n    // Flags along the line warn of gusts.\n    this.flags = [];\n    for (let z = 6; z < SLACK.length; z += 6) {\n      const pole = place(ctx, 'signpost', { at: [2.6, -0.1, z], scale: 0.5, shadow: false });\n      const f = new Mesh(new BoxGeometry(0.9, 0.5, 0.05), toonMaterial(PALETTE.white));\n      f.position.set(2.6, 2.1, z);\n      ctx.scene.add(f);\n      this.flags.push({ z, f, pole });\n    }\n    const p = playerInfo();\n    this.avatar = await makeAvatar(ctx, p.look, { at: [0, SLACK.height, 0], clip: 'ArmsOut', shadow: false, yaw: 0 });\n    this.kevin = new Kevin(ctx, { at: [4, 3, SLACK.kevinOn], yaw: 3 });\n    this.dot = new Dot(() => this.rng.next());\n    this.head = new Vector3();\n    this.begin(true);\n  }\n\n  begin() {\n    this.z = 0;\n    this.falls = 0;\n    this.lastCheckpoint = 0;\n    this.dot.reset();\n    this.fallT = 0;\n    this.time = 0;\n    this.finished = false;\n    this.gust = null;\n    this.nextGustAt = SLACK.gustEvery;\n    this.kevinOn = false;\n    this.m = {};\n    this.walking = false;\n    this.gustSign = 1;\n    this.engineScaled = false;\n    if (this.avatar) this.avatar.place(0, SLACK.height, 0, 0);\n    if (this.kevin) { this.kevin.root.position.set(4, 3, SLACK.kevinOn); this.kevin.state = 'sit'; }\n  }\n\n  /** Bots walk only while |x| < .45. */\n  botInput(out, dt, brain) {\n    brain.lean(out, this.dot, 0, 0, dt);\n    out.y = !brain.p ? 0 : Math.abs(this.dot.x) < 0.45 ? 1 : 0;\n    this.dot.y = 0;\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    if (this.finished) return;\n    this.time += dt;\n    if (this.fallT > 0) {\n      this.fallT -= dt / Math.max(0.01, ctx.engine.timeScale || 1);\n      if (this.fallT <= 0) this.respawn(ctx);\n      return;\n    }\n    const inp = this.readPlayer(ctx, dt, this.dial);\n    const wantWalk = inp.y > 0.3;\n    this.walking = wantWalk;\n    const instEff = wantWalk ? T.slackWalkInst : SLACK.standInst;\n    const m = this.m;\n    m.inst = instEff / T.dotInstability;\n    m.noise = SLACK.noise * App.noiseScale();\n    m.bx = 0;\n    // Gusts: every 6 m, telegraphed 1.5 s by flags and wind lines.\n    if (!this.gust && this.z >= this.nextGustAt - this.walkLead()) {\n      this.gust = { warn: SLACK.gustWarn, blow: SLACK.gustSeconds, sign: this.rng.chance(0.5) ? 1 : -1 };\n      this.nextGustAt += SLACK.gustEvery;\n      App.sfx('gust', { volume: 0.5 });\n    }\n    if (this.gust) {\n      if (this.gust.warn > 0) this.gust.warn -= dt;\n      else {\n        this.gust.blow -= dt;\n        m.bx += this.gust.sign * T.gustForce * (this.hardData.gust ?? 1);\n        if (this.gust.blow <= 0) this.gust = null;\n      }\n    }\n    if (this.kevinOn) m.bx += SLACK.kevinBias * T.dotAuthority * (this.kevinSign ?? 1);\n    this.dot.step(dt, inp.x, 0, T, m);\n    this.dot.y = 0; this.dot.vy = 0;\n    if (App.dev.god || this.cheatRing) this.dot.clampTo(0, 0, 0.6);\n    if (wantWalk) this.z = Math.min(SLACK.length, this.z + SLACK.walkSpeed * Math.min(1, inp.y) * dt);\n    // Checkpoints and Kevin.\n    for (const c of SLACK.checkpoints) if (this.z >= c) this.lastCheckpoint = Math.max(this.lastCheckpoint, c);\n    if (!this.kevinOn && this.z >= SLACK.kevinOn && this.z < SLACK.kevinOff) {\n      this.kevinOn = true;\n      this.kevinSign = this.rng.chance(0.5) ? 1 : -1;\n      this.kevin.flyTo(this.avatar.root.position.x, SLACK.height + 1.75, this.z, 0.5);\n      if (!this.attractMode) App.say('ounce', 'Kevin is on your head. He is staff. Carry on.');\n    }\n    if (this.kevinOn && this.z >= SLACK.kevinOff) {\n      this.kevinOn = false;\n      this.kevin.flyTo(-6, 5, this.z + 10, 1.4);\n    }\n    if (Math.abs(this.dot.x) > SLACK.fallAt) this.fall(ctx);\n    if (this.z >= SLACK.length) {\n      this.finished = true;\n      this.avatar.play('Victory', { fade: 0.2 });\n      App.sfx('fanfareSoft');\n    }\n  }\n\n  walkLead() { return SLACK.gustWarn * SLACK.walkSpeed * 0.5; }\n\n  fall(ctx) {\n    this.falls++;\n    this.fallT = SLACK.fallSeconds;\n    this.avatar.play('Fall', { fade: 0.1 });\n    if (!this.attractMode) ctx.engine.timeScale = 0.4;\n    this.fallVX = Math.sign(this.dot.x) * -1.3;\n    this.fallVY = 0.4;\n    App.sfx('wobble');\n  }\n\n  respawn(ctx) {\n    if (!this.attractMode) ctx.engine.timeScale = App.dev.timeScale;\n    this.ripples.splash(this.avatar.root.position.x, this.z, 1.4, 1.2);\n    ctx.particles.burst('splash', [this.avatar.root.position.x, 0.2, this.z]);\n    App.sfx('splash');\n    if (this.scoring && !this.attractMode) App.say('ounce', this.cosmetic.pick(BARKS.fall));\n    this.z = this.lastCheckpoint;\n    this.dot.reset();\n    this.avatar.play('ArmsOut', { fade: 0.2 });\n    this.avatar.root.position.y = SLACK.height;\n  }\n\n  isOver() {\n    if (this.finished && (this.overDelay = (this.overDelay ?? 0) + 1 / 60) > 0.7) return true;\n    return this.time >= SLACK.limit;\n  }\n\n  playLength() { return SLACK.limit; }\n\n  result() {\n    const finished = this.z >= SLACK.length;\n    const score = finished ? Math.max(0, Math.min(1000, Math.round(1000 - 60 * this.falls - 8 * (this.time - 27)))) : Math.round((this.z / SLACK.length) * 400);\n    let stars = 0;\n    if (finished) stars = 1;\n    if (finished && this.falls <= 1 && this.time < 45) stars = 2;\n    if (finished && this.falls === 0 && this.time < 32) stars = 3;\n    return { score, stars, seconds: this.time, display: `${score} pts`, falls: this.falls, finished };\n  }\n\n  visual(ctx, dt) {\n    const a = this.avatar.root;\n    if (this.fallT > 0) {\n      this.fallVY -= 12 * dt;\n      a.position.x += this.fallVX * dt;\n      a.position.y = Math.max(0, a.position.y + this.fallVY * dt);\n    } else {\n      a.position.x = -this.dot.x * 0.42;\n      a.position.y = SLACK.height - this.sagAt(this.z);\n    }\n    a.position.z = this.z;\n    if (this.fallT <= 0 && !this.finished) this.avatar.play(this.walking ? 'SlackWalk' : 'ArmsOut', { fade: 0.2 });\n    this.avatar.update(dt);\n    if (this.fallT <= 0) this.avatar.lean(-this.dot.x * 1.6, 0, Math.abs(this.dot.x) > 0.7 ? 1.4 : 0, this.t);\n    if (this.kevinOn && this.kevin.state !== 'fly') this.kevin.root.position.set(a.position.x, a.position.y + 1.74, a.position.z);\n    this.kevin.update(dt);\n    // The line sags under your feet.\n    const len = SLACK.length + 2;\n    this.segs.forEach((s, i) => {\n      const z = -1 + ((i + 0.5) / this.nSegs) * len;\n      const y = SLACK.height - this.sagAtLine(z);\n      s.position.set(0, y - 0.04, z);\n    });\n    // Flags stream when a gust is coming.\n    const blowing = this.gust ? (this.gust.warn > 0 ? 0.5 : 1) * this.gust.sign : 0;\n    for (const fl of this.flags) { fl.f.rotation.y = blowing * 0.9 + Math.sin(this.t * 4 + fl.z) * 0.1; fl.f.position.x = 2.6 + blowing * 0.3; }\n    this.water?.update(ctx.time);\n    this.ripples?.step(dt);\n    // Camera, low behind you.\n    if (!App.dev.freeCam) {\n      const cam = ctx.camera.camera;\n      cam.position.set(a.position.x * 0.2, 3.3, this.z - 6);\n      cam.lookAt(a.position.x * 0.1, 2.2, this.z + 4);\n      if (cam.fov !== 46) { cam.fov = 46; cam.updateProjectionMatrix(); }\n    }\n  }\n\n  sagAt(z) { return this.sagAtLine(z); }\n  sagAtLine(z) {\n    const span = SLACK.length + 2;\n    const u = (z + 1) / span;\n    const base = Math.sin(u * Math.PI) * 0.25;\n    const dd = (z - this.z) / 2.4;\n    return base + 0.26 * Math.exp(-dd * dd) * (this.fallT > 0 ? 0.2 : 1);\n  }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    const { hud } = ctx;\n    const w = Math.min(280, hud.width - 40);\n    const cx = Math.round(hud.width / 2);\n    const y = 34;\n    this.dial = { x: cx, y: Math.round(hud.height / 2) };\n    panel(hud, cx - w / 2, y - 9, w, 18, { fill: 'white', name: 'balance' });\n    hud.rect(cx - 1, y - 9, 2, 18, 'mist');\n    const safe = (0.45 / 1.2) * (w / 2);\n    hud.rect(cx - Math.round(safe), y - 9, 2, 18, 'lime');\n    hud.rect(cx + Math.round(safe) - 2, y - 9, 2, 18, 'lime');\n    hud.rect(cx - w / 2, y - 9, 6, 18, 'red');\n    hud.rect(cx + w / 2 - 6, y - 9, 6, 18, 'red');\n    const dx = cx + (this.dot.x / 1.2) * (w / 2);\n    disc(hud, dx, y, 6, 'ink');\n    disc(hud, dx, y, 5, 'red');\n    bar(hud, cx - w / 2, y + 12, w, 6, this.z / SLACK.length, 'cyan', 'ink', 'progress');\n    if (this.gust?.warn > 0) sayCentered(hud, cx, y + 22, this.gust.sign > 0 ? 'Gust from the left!' : 'Gust from the right!', { color: 'sand', name: 'gust' });\n    if (this.gust && this.gust.warn <= 0) {\n      for (let i = 0; i < 6; i++) {\n        const ly = 70 + i * 16;\n        const lx = ((this.t * 300 + i * 90) % hud.width);\n        const X = this.gust.sign > 0 ? lx : hud.width - lx;\n        line(hud, X, ly, X + (this.gust.sign > 0 ? 18 : -18), ly, 'white', 1);\n      }\n    }\n    if (App.device.last === 'mouse' && !this.autopilot) { const p = App.device.pointerArt(ctx); line(hud, this.dial.x, this.dial.y, p.x, p.y, 'white', 1); }\n  }\n\n  drawGameHud(ctx) {\n    topRow(ctx.hud, `${Math.ceil(Math.max(0, SLACK.limit - this.time))}s`, `${Math.floor(this.z)} m  falls ${this.falls}`);\n  }\n\n  overlayDot() { return `x ${this.dot.x.toFixed(2)} z ${this.z.toFixed(1)}`; }\n  fingerprint() { return `${this.dot.x.toFixed(6)}|${this.z.toFixed(5)}|${this.falls}`; }\n  cameraTarget() { return this.head.set(0, 2, this.z ?? 0); }\n}\nEOF\ncat > src/scenes/activity/tray.js <<'EOF'\n// Vitamin Tray. Tilt gravity, not the tray: colliders stay flat, a visual group tilts.\nimport { RAPIER, THREE, toonMaterial, PALETTE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { place } from '../../art/props.js';\nimport { BOARDS, TRAY_CELL } from '../../data/boards.js';\nimport { sayCentered } from '../../ui/font.js';\nimport { disc, ring as ringLine, line } from '../../ui/widgets.js';\nimport { topRow } from '../../ui/activity-hud.js';\nimport { ActivityScene } from './base.js';\nimport { lagoonSet, box } from '../sets.js';\n\nconst { Group, Mesh, BoxGeometry } = THREE;\nconst COLORS = { R: 'red', B: 'blue', Y: 'sand' };\nconst BALL_R = 0.17;\nconst CUP_R = 0.27;\nconst ENTER_SPEED = 2.6;\n\nexport class TrayActivity extends ActivityScene {\n  ownCamera = false;\n  tiltX = 0; tiltZ = 0;\n  count = 0;\n\n  boardIndex() {\n    if (this.args.board !== undefined) return this.args.board;\n    if (this.hard) return 2;\n    const rec = this.mode === 'week' ? App.slot?.records.tray : App.store.data.dropin?.tray;\n    return (rec?.plays ?? 0) % BOARDS.length;\n  }\n\n  async stage(ctx) {\n    lagoonSet(ctx);\n    box(ctx, 10, 1.6, 7, [0, -1.05, 0], 'white', { cast: false });\n    this.board = BOARDS[this.boardIndex()];\n    const rows = this.board.rows;\n    const h = rows.length, w = rows[0].length;\n    const cell = TRAY_CELL;\n    this.halfW = (w * cell) / 2; this.halfD = (h * cell) / 2;\n    this.tilt = new Group();\n    this.tilt.position.y = 0.3;\n    ctx.scene.add(this.tilt);\n    const tray = place(ctx, 'tray', { params: { w: Math.min(12, w * cell), d: Math.min(10, h * cell) }, at: [0, -0.18, 0] });\n    ctx.scene.remove(tray.object);\n    this.tilt.add(tray.object);\n    this.starts = [];\n    this.cups = [];\n    const { physics } = ctx;\n    this.savedGravity = { ...physics.world.gravity };\n    // A flat, static floor and walls: gravity does the tilting.\n    physics.addStaticBox({ position: [0, -0.1, 0], halfExtents: [this.halfW + 3, 0.1, this.halfD + 3], friction: 0.6 });\n    // Edges fall away: gaps in the rail drop a vitamin past the floor's edge.\n    const wallMat = toonMaterial(PALETTE.navy);\n    for (let r = 0; r < h; r++) {\n      for (let c = 0; c < w; c++) {\n        const ch = rows[r][c];\n        const x = (c + 0.5) * cell - this.halfW, z = (r + 0.5) * cell - this.halfD;\n        if (ch === '#') {\n          physics.addStaticBox({ position: [x, 0.4, z], halfExtents: [cell / 2, 0.4, cell / 2], friction: 0.1 });\n          const m = new Mesh(new BoxGeometry(cell, 0.34, cell), wallMat);\n          m.position.set(x, 0.17, z);\n          m.castShadow = true;\n          this.tilt.add(m);\n        } else if (ch === 'o') this.starts.push([x, z]);\n        else if (COLORS[ch]) {\n          const cup = place(ctx, 'vitamin-cup', { palette: { cup: COLORS[ch] }, shadow: false });\n          ctx.scene.remove(cup.object);\n          cup.object.position.set(x, 0, z);\n          this.tilt.add(cup.object);\n          this.cups.push({ x, z, color: ch });\n        } else if (ch === '_') {\n          // A gap: nothing in the rail, and a hole in what's visible.\n          const m = new Mesh(new BoxGeometry(cell, 0.04, cell), toonMaterial(PALETTE.ink));\n          m.position.set(x, 0.01, z);\n          this.tilt.add(m);\n        }\n      }\n    }\n    this.vits = [];\n    const colors = [...new Set(this.cups.map((c) => c.color))];\n    for (let i = 0; i < this.board.count; i++) {\n      const color = colors[i % colors.length];\n      const mesh = place(ctx, 'vitamin', { palette: { pill: COLORS[color] }, actor: true, shadow: true }).object;\n      ctx.scene.remove(mesh);\n      this.tilt.add(mesh);\n      const body = physics.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0, 0.3, 0).setLinearDamping(0.32).setAngularDamping(0.6).setCcdEnabled(true));\n      physics.world.createCollider(RAPIER.ColliderDesc.ball(BALL_R).setFriction(0.3).setRestitution(0.2).setDensity(2), body);\n      this.vits.push({ mesh, body, color, done: false, wait: 0, i });\n    }\n    this.begin();\n  }\n\n  spawnPos(i) {\n    const s = this.starts[i % this.starts.length];\n    const jitter = (i * 2.399) % 6.28;\n    return [s[0] + Math.cos(jitter) * 0.2, 0.3, s[1] + Math.sin(jitter) * 0.2];\n  }\n\n  begin() {\n    this.score = 0;\n    this.correct = 0;\n    this.wrong = 0;\n    this.dropped = 0;\n    this.time = 0;\n    this.tiltX = 0; this.tiltZ = 0;\n    for (const v of this.vits ?? []) {\n      v.done = false; v.wait = 0;\n      const p = this.spawnPos(v.i);\n      v.body.setTranslation({ x: p[0], y: p[1], z: p[2] }, true);\n      v.body.setLinvel({ x: 0, y: 0, z: 0 }, true);\n      v.body.setAngvel({ x: 0, y: 0, z: 0 }, true);\n      v.body.setEnabled(true);\n      v.mesh.visible = true;\n    }\n  }\n\n  get timeLimit() { return 60 * (this.hardData.time ?? 1); }\n  playLength() { return this.timeLimit; }\n  isOver() { return this.time >= this.timeLimit || (this.vits && this.vits.every((v) => v.done)); }\n\n  /** Bots: pick a vitamin, tilt it toward its cup, ease off as it nears. */\n  botInput(out, dt, brain) {\n    out.x = out.y = 0;\n    if (!brain.p) return;\n    const play = brain.play;\n    let best = null, bestD = Infinity, cup = null;\n    for (const v of this.vits) {\n      if (v.done || v.wait > 0) continue;\n      const p = v.body.translation();\n      for (const c of this.cups) {\n        if (c.color !== v.color) continue;\n        const d = Math.hypot(c.x - p.x, c.z - p.z);\n        if (d < bestD) { bestD = d; best = v; cup = c; }\n      }\n    }\n    if (!best) return;\n    const p = best.body.translation(), vel = best.body.linvel();\n    const k = 0.42 * play.speed, kd = 0.3;\n    const t = this.time;\n    out.x = (cup.x - p.x) * k - vel.x * kd + Math.sin(t * 2.3) * play.wander * 0.5;\n    out.y = -(cup.z - p.z) * k + vel.z * kd + Math.sin(t * 1.9) * play.wander * 0.5;\n    const d = Math.hypot(out.x, out.y);\n    if (d > 1) { out.x /= d; out.y /= d; }\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    const dial = { x: ctx.hud.width / 2, y: ctx.hud.height / 2 };\n    const inp = this.readPlayer(ctx, dt, dial);\n    const lag = Math.min(1, dt / 0.12);\n    const maxT = (T.trayMaxTilt * Math.PI) / 180;\n    this.tiltX += (inp.x * maxT - this.tiltX) * lag;\n    this.tiltZ += (-inp.y * maxT - this.tiltZ) * lag;\n    const g = T.trayGravity;\n    ctx.physics.world.gravity = { x: Math.sin(this.tiltX) * g, y: -Math.cos(this.tiltX) * Math.cos(this.tiltZ) * g, z: Math.sin(this.tiltZ) * g };\n    for (const v of this.vits) {\n      if (v.done) continue;\n      if (v.wait > 0) {\n        v.wait -= dt;\n        if (v.wait <= 0) this.respawnVit(v);\n        continue;\n      }\n      const p = v.body.translation();\n      if (p.y < -1.2 || Math.abs(p.x) > this.halfW + 2.4 || Math.abs(p.z) > this.halfD + 2.4) { this.dropVit(ctx, v, scoring); continue; }\n      // Past the rail the floor is out of bounds: a gap drops a vitamin.\n      if (Math.abs(p.x) > this.halfW + 0.05 || Math.abs(p.z) > this.halfD + 0.05) { this.dropVit(ctx, v, scoring); continue; }\n      const vel = v.body.linvel();\n      const speed = Math.hypot(vel.x, vel.z);\n      for (const c of this.cups) {\n        if (Math.hypot(p.x - c.x, p.z - c.z) > CUP_R) continue;\n        if (speed > ENTER_SPEED) continue;\n        if (c.color === v.color) this.scoreVit(ctx, v, c, scoring);\n        else this.wrongVit(ctx, v, c, scoring);\n        break;\n      }\n    }\n  }\n\n  scoreVit(ctx, v, c, scoring) {\n    v.done = true;\n    v.body.setEnabled(false);\n    v.mesh.visible = false;\n    if (scoring) { this.score += 10; this.correct++; }\n    App.sfx('vitaminIn', { pitch: this.correct });\n    ctx.particles.burst('sparkle', [c.x, 0.6, c.z], { count: 8 });\n  }\n\n  wrongVit(ctx, v, c, scoring) {\n    if (scoring) { this.score -= 3; this.wrong++; }\n    App.sfx('vitaminWrong');\n    ctx.particles.burst('puff', [c.x, 0.5, c.z]);\n    this.respawnVit(v);\n  }\n\n  dropVit(ctx, v, scoring) {\n    if (scoring) { this.score -= 1; this.dropped++; }\n    App.sfx('stepMiss');\n    v.wait = 3;\n    v.body.setEnabled(false);\n    v.mesh.visible = false;\n  }\n\n  respawnVit(v) {\n    const p = this.spawnPos(v.i + this.dropped + this.wrong);\n    v.body.setTranslation({ x: p[0], y: 0.34, z: p[1 + 1] }, true);\n    v.body.setLinvel({ x: 0, y: 0, z: 0 }, true);\n    v.body.setEnabled(true);\n    v.mesh.visible = true;\n  }\n\n  result() {\n    const max = this.board.count * 10;\n    const score = Math.max(0, this.score);\n    return { score, max, seconds: this.time, display: `${score} / ${max}` };\n  }\n\n  visual() {\n    this.tilt.rotation.z = -this.tiltX;\n    this.tilt.rotation.x = this.tiltZ;\n    for (const v of this.vits) {\n      if (v.done || v.wait > 0) continue;\n      const p = v.body.translation(), q = v.body.rotation();\n      v.mesh.position.set(p.x, p.y - BALL_R - 0.3, p.z);\n      v.mesh.quaternion.set(q.x, q.y, q.z, q.w);\n    }\n  }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    const { hud } = ctx;\n    const cx = hud.width - 40, cy = 56, r = 22;\n    disc(hud, cx, cy, r + 2, 'slate');\n    disc(hud, cx, cy, r, 'white');\n    const maxT = (T.trayMaxTilt * Math.PI) / 180;\n    disc(hud, cx + (this.tiltX / maxT) * (r - 4), cy + (this.tiltZ / maxT) * (r - 4), 3, 'red');\n    ringLine(hud, cx, cy, 8, 1, 'teal');\n    if (App.device.last === 'mouse' && !this.autopilot) { const p = App.device.pointerArt(ctx); line(hud, hud.width / 2, hud.height / 2, p.x, p.y, 'white', 1); }\n    sayCentered(hud, hud.width / 2, 24, this.board.name, { color: 'white', name: 'board-name' });\n  }\n\n  drawGameHud(ctx) {\n    topRow(ctx.hud, `${Math.ceil(Math.max(0, this.timeLimit - this.time))}s`, `${this.score}`);\n  }\n\n  overlayDot() { return `tilt ${this.tiltX.toFixed(2)},${this.tiltZ.toFixed(2)}`; }\n  fingerprint() { return `${this.score}|${this.correct}|${this.wrong}|${this.tiltX.toFixed(5)}`; }\n  dispose(ctx) { ctx.physics.world.gravity = { x: 0, y: -24, z: 0 }; }\n}\nEOF\ncat > src/scenes/activity/pier.js <<'EOF'\n// Pier Jump. Side-on, three attempts, three judges with paddles.\nimport { RippleField, THREE, toonMaterial, PALETTE, WAVES_CALM, WaterSurface } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { place } from '../../art/props.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { BARKS } from '../../data/lines.js';\nimport { say, sayCentered } from '../../ui/font.js';\nimport { bar, drawDial, panel } from '../../ui/widgets.js';\nimport { promptBar } from '../../ui/prompts.js';\nimport { ActivityScene } from './base.js';\nimport { playerInfo } from './lanes.js';\nimport { setSky } from '../sets.js';\n\nconst { BoxGeometry, Mesh, Vector3 } = THREE;\nexport const PIER = { attempts: 3, runup: 5, lipWindow: 0.25, flight: 3.4, ring: 0.45, inst: 3, tuck: [-0.8, -0.4], speedLow: 6, speedHigh: 14, cannonWindow: 0.5, deckY: 2.2 };\n\nexport class PierActivity extends ActivityScene {\n  ownCamera = true;\n  focusV = new Vector3();\n\n  async stage(ctx) {\n    setSky(ctx, 14);\n    const rip = new RippleField({ size: [90, 26], cells: [120, 36], center: [32, 0] });\n    this.ripples = rip;\n    this.water = new WaterSurface({ size: [90, 26], at: [32, 0, 0], ripples: rip, waves: WAVES_CALM, deep: PALETTE.blue, shallow: PALETTE.cyan, foam: PALETTE.white });\n    ctx.scene.add(this.water);\n    ctx.scene.add(new Mesh(new BoxGeometry(400, 0.2, 200), toonMaterial(PALETTE.blue)).translateY(-0.5).translateZ(-40));\n    // The pier, side-on: running up to the lip at x = 0.\n    const pier = place(ctx, 'pier', { at: [-40, -0.4, 0], yaw: 90, params: { len: 40 } });\n    const pier2 = place(ctx, 'pier', { at: [-20, -0.4, 0], yaw: 90, params: { len: 40 } });\n    void pier; void pier2;\n    const lip = new Mesh(new BoxGeometry(0.5, 0.26, 3.4), toonMaterial(PALETTE.red));\n    lip.position.set(-0.2, 1.22, 0);\n    ctx.scene.add(lip);\n    for (const [d, c] of [[18, 'sand'], [28, 'cyan'], [38, 'lime']]) {\n      const buoy = new Mesh(new BoxGeometry(0.7, 1.1, 0.7), toonMaterial(PALETTE[c]));\n      buoy.position.set(d, 0.3, -2.2);\n      buoy.castShadow = true;\n      ctx.scene.add(buoy);\n      place(ctx, 'signpost', { at: [d, 0, -3], scale: 0.7 });\n    }\n    // The judges' raft.\n    const raft = new Mesh(new BoxGeometry(8, 0.5, 2.4), toonMaterial(PALETTE.sand));\n    raft.position.set(24, 0.15, -6.4);\n    ctx.scene.add(raft);\n    this.judges = [];\n    const looks = [LOOKS.marguerite, LOOKS.june, LOOKS.coach];\n    for (let i = 0; i < 3; i++) {\n      const x = 21.6 + i * 2.4;\n      const a = await makeAvatar(ctx, looks[i], { at: [x, 0.4, -6.4], yaw: 0, clip: 'Sit', shadow: false });\n      const paddle = place(ctx, 'judge-paddle', { at: [x + 0.4, 0.4, -5.6], scale: 1.3, actor: true }).object;\n      paddle.visible = false;\n      this.judges.push({ a, paddle, x, y: 0.4, score: 0, shown: false });\n    }\n    const p = playerInfo();\n    this.avatar = await makeAvatar(ctx, p.look, { at: [-30, PIER.deckY - 0.85, 0], yaw: 1.57, clip: 'TuckRun', shadow: false });\n    this.dot = new Dot(() => this.rng.next());\n    this.begin();\n  }\n\n  begin(practice = false) {\n    this.attempt = 0;\n    this.best = 0;\n    this.results = [];\n    this.isPractice = practice;\n    this.startAttempt();\n  }\n\n  startAttempt() {\n    this.stage2 = 'runup';\n    this.st = 0;\n    this.speed = PIER.speedLow;\n    this.dot.reset();\n    this.tuckT = 0;\n    this.power = 0;\n    this.pressed = false;\n    this.ringN = 0; this.ringIn = 0;\n    this.cannon = false;\n    this.distance = 0;\n    this.flight = PIER.flight;\n    this.av().play('TuckRun', { fade: 0.2 });\n    for (const j of this.judges ?? []) { j.shown = false; j.paddle.visible = false; j.a.play('Sit', { fade: 0.2 }); }\n    this.waitT = 0;\n    this.styleBonus = 0;\n  }\n\n  av() { return this.avatar; }\n\n  botInput(out, dt, brain) {\n    out.x = out.y = 0; out.confirm = false;\n    if (!brain.p) return;\n    const play = brain.play;\n    if (this.stage2 === 'runup') {\n      brain.lean(out, this.dot, 0, -0.6, dt);\n      this.botPress ??= PIER.runup + (this.botRand.next() + this.botRand.next() - 1) * play.timing * 1.4;\n      if (this.st >= this.botPress && !this.pressed) { out.confirm = true; this.botPress = undefined; }\n    } else if (this.stage2 === 'flight') {\n      brain.lean(out, this.dot, 0, 0, dt);\n      if (this.flight - this.st < 0.25 && !this.cannon) out.confirm = true;\n    }\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    const inp = this.readPlayer(ctx, dt, this.dial);\n    this.st += dt;\n    switch (this.stage2) {\n      case 'runup': {\n        const y = this.dot.y;\n        const tuck = y >= PIER.tuck[0] && y <= PIER.tuck[1];\n        this.tucked = tuck;\n        this.speed = Math.max(PIER.speedLow, Math.min(PIER.speedHigh, this.speed + (tuck ? 2.2 : -0.8) * dt));\n        this.dot.step(dt, inp.x, inp.y, T, { noise: App.noiseScale() });\n        if (App.dev.god || this.cheatRing) { this.dot.clampTo(0, -0.6, 0.15); this.speed = PIER.speedHigh; }\n        if (inp.confirm) this.jump(ctx);\n        else if (this.st >= PIER.runup + PIER.lipWindow) { this.power = 0; this.leap(ctx, scoring); }\n        break;\n      }\n      case 'flight': {\n        const m = { inst: PIER.inst, noise: App.noiseScale() };\n        this.dot.step(dt, inp.x, inp.y, T, m);\n        const ring = App.ringOf(PIER.ring * (this.hardData.ring ?? 1));\n        if (App.dev.god || this.cheatRing) this.dot.clampTo(0, 0, ring * 0.8);\n        this.ringN++;\n        if (Math.hypot(this.dot.x, this.dot.y) <= ring) this.ringIn++;\n        if (inp.confirm && this.flight - this.st <= PIER.cannonWindow && !this.cannon) {\n          this.cannon = true;\n          this.avatar.play('Cannonball', { fade: 0.08 });\n          this.styleBonus = 1;\n          App.sfx('hop');\n        }\n        if (this.st >= this.flight) this.splashDown(ctx, scoring);\n        break;\n      }\n      case 'splash':\n        if (this.st >= 2.6) this.nextAttempt();\n        break;\n      default:\n        break;\n    }\n  }\n\n  jump(ctx) {\n    const dt = this.st - PIER.runup;\n    this.pressed = true;\n    this.power = Math.max(0, 1 - Math.abs(dt) / PIER.lipWindow);\n    this.leap(ctx, true);\n  }\n\n  leap(ctx) {\n    this.stage2 = 'flight';\n    this.st = 0;\n    this.dot.reset();\n    this.flight = PIER.flight + ((this.speed - PIER.speedLow) / (PIER.speedHigh - PIER.speedLow)) * 0.6;\n    this.avatar.play('Fly', { fade: 0.12 });\n    App.sfx('jump');\n    ctx.engine.shake.add(0.15);\n    this.ringFrac = 0;\n    this.distance = this.distanceNow(0.5);\n  }\n\n  distanceNow(ringFrac) {\n    return this.speed * (0.8 + 0.6 * this.power) * (0.6 + 0.4 * ringFrac) * T.pierBoost;\n  }\n\n  splashDown(ctx, scoring) {\n    const ringFrac = this.ringN ? this.ringIn / this.ringN : 0;\n    this.ringFrac = ringFrac;\n    this.distance = this.distanceNow(ringFrac);\n    this.stage2 = 'splash';\n    this.st = 0;\n    const r = { distance: this.distance, ringFrac, power: this.power, cannon: this.cannon };\n    if (scoring && !this.isPractice) {\n      this.results.push(r);\n      this.best = Math.max(this.best, this.distance);\n    }\n    // Hitstop .1, slow motion for .8 s, huge particles, ripples, shake.\n    if (!this.attractMode) {\n      ctx.engine.hitstop(0.1);\n      ctx.engine.timeScale = 0.25;\n      ctx.tweens.call(0.2, () => { if (App.stack.open) return; ctx.engine.timeScale = App.dev.timeScale; });\n    }\n    const x = this.distance;\n    ctx.particles.burst('splashBig', [x, 0.2, 0], { count: this.cannon ? 110 : 70 });\n    this.ripples.splash(x, 0, this.cannon ? 3 : 1.8, this.cannon ? 2 : 1.2);\n    App.sfx('splash', { volume: this.cannon ? 1 : 0.8 });\n    ctx.engine.shake.add(this.cannon ? 0.7 : 0.4);\n    if (!App.settings.reduceFlashes) {\n      ctx.engine.screen.shockwave([x, 0.2, 0], { radius: 0.3 });\n    }\n    this.judge(r);\n  }\n\n  judge(r) {\n    const quality = Math.min(1, r.distance / 40) * 7 + (r.cannon ? 2 : 0) + r.ringFrac;\n    this.judges.forEach((j, i) => {\n      j.score = Math.max(0, Math.min(10, Math.round(quality + [-1, 0, 0.5][i])));\n      j.shown = true;\n      j.paddle.visible = true;\n      j.a.play('PaddleUp', { once: true, fade: 0.1 });\n    });\n    App.sfx('paddle');\n    if (!this.attractMode) App.say('ounce', r.distance >= 28 ? 'That was far. I could barely read it from here.' : r.distance >= 18 ? 'A respectable splash. The fish have been told.' : this.cosmetic.pick(BARKS.fall));\n  }\n\n  nextAttempt() {\n    if (this.isPractice) { this.startAttempt(); return; }\n    this.attempt++;\n    if (this.attempt >= PIER.attempts) { this.allDone = true; return; }\n    this.startAttempt();\n  }\n\n  isOver() { return !!this.allDone; }\n  playLength() { return 60; }\n\n  result() {\n    const best = Math.round(this.best * 10) / 10;\n    return { score: best, seconds: this.playT, display: `${best.toFixed(1)} m` };\n  }\n\n  visual(ctx, dt) {\n    const a = this.avatar.root;\n    const u = this.stage2 === 'flight' ? Math.min(1, this.st / this.flight) : 1;\n    if (this.stage2 === 'runup') {\n      const left = PIER.runup - this.st;\n      a.position.set(-left * this.speed, PIER.deckY - 0.88, 0);\n      a.rotation.y = 1.57;\n      this.avatar.action('TuckRun').timeScale = this.speed / 8;\n    } else if (this.stage2 === 'flight') {\n      const est = this.distanceNow(this.ringN ? this.ringIn / this.ringN : 0.5);\n      a.position.x = est * u;\n      a.position.y = PIER.deckY - 0.88 + Math.sin(u * Math.PI) * 4.2 - u * (PIER.deckY - 0.5);\n      a.position.z = 0;\n    } else if (this.stage2 === 'splash') {\n      a.position.set(this.distance, Math.max(-1.7, 0.1 - this.st * 2.6), 0);\n    }\n    this.avatar.update(dt);\n    if (this.stage2 === 'flight') this.avatar.lean(this.dot.x * 2, this.dot.y, 0, this.t);\n    else if (this.stage2 === 'runup') this.avatar.lean(0, this.dot.y * 0.6, 0, this.t);\n    for (const j of this.judges) j.a.update(dt);\n    this.water?.update(ctx.time);\n    this.ripples?.step(dt);\n    this.focusV.set(a.position.x + 5, 3.4, 0);\n    if (this.stage2 === 'runup') this.focusV.x = a.position.x + 7;\n  }\n\n  cameraTarget() { return this.focusV; }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    const { hud } = ctx;\n    const cx = Math.round(hud.width * 0.5);\n    const cy = 56;\n    this.dial = { x: cx, y: cy };\n    const mouse = App.device.last === 'mouse' && !this.autopilot ? App.device.pointerArt(ctx) : null;\n    if (this.stage2 === 'runup') {\n      // The tuck zone, low on the dial: hold the Dot in it to build speed.\n      const r = 40;\n      drawDial(hud, { x: cx, y: cy, r, dot: this.dot, ringR: 0.2, ringY: -0.6, inside: this.tucked, brighten: this.tucked ? 1 : 0, mouse });\n      bar(hud, cx - r, cy + r + 5, r * 2, 6, (this.speed - PIER.speedLow) / (PIER.speedHigh - PIER.speedLow), 'orange', 'ink', 'speed');\n      sayCentered(hud, cx, cy + r + 13, `${this.speed.toFixed(1)} m/s`, { color: 'white', name: 'speed-label' });\n      const left = PIER.runup - this.st;\n      if (left < 1 && left > -PIER.lipWindow) {\n        const on = Math.abs(left) < PIER.lipWindow;\n        promptBar(hud, App.device, [['confirm', on ? 'NOW' : 'Jump']], { y: cy + r + 26 });\n      }\n    } else if (this.stage2 === 'flight') {\n      const r = 40;\n      const ring = App.ringOf(PIER.ring * (this.hardData.ring ?? 1));\n      drawDial(hud, { x: cx, y: cy, r, dot: this.dot, ringR: ring, inside: Math.hypot(this.dot.x, this.dot.y) <= ring, mouse });\n      const inWindow = this.flight - this.st <= PIER.cannonWindow;\n      if (inWindow && !this.cannon) promptBar(hud, App.device, [['confirm', 'Cannonball!']], { y: cy + r + 10 });\n    } else if (this.stage2 === 'splash') {\n      panel(hud, cx - 70, 24, 140, 56, { fill: 'white', name: 'pier-result' });\n      sayCentered(hud, cx, 30, `${this.distance.toFixed(1)} m`, { scale: 3, color: 'ink', shadow: false, name: 'distance' });\n      let jx = cx - 48;\n      for (const j of this.judges) {\n        if (j.shown) { hud.rect(jx, 56, 24, 18, 'navy'); sayCentered(hud, jx + 12, 60, String(j.score), { color: 'white', shadow: false, name: 'paddle' }); }\n        jx += 36;\n      }\n    }\n    const marks = [`Attempt ${Math.min(this.attempt + 1, PIER.attempts)} of ${PIER.attempts}`, `Best ${this.best.toFixed(1)} m`];\n    hud.rect(10, 6, 120, 25, 'navy');\n    say(hud, 13, 8, marks[0], { name: 'attempt' });\n    say(hud, 13, 19, marks[1], { color: 'sand', name: 'attempt-best' });\n  }\n\n  overlayDot() { return `${this.stage2} v ${this.speed.toFixed(1)} p ${this.power.toFixed(2)}`; }\n  fingerprint() { return `${this.best.toFixed(4)}|${this.attempt}|${this.dot.x.toFixed(5)}`; }\n}\nEOF\ncat > src/data/jog.js <<'EOF'\n// Island Jog: the path round Tare Island, as (x, z) control points on a closed Catmull-Rom curve.\nexport const JOG_PATH = [\n  [0, 8.5], [6, 12.5], [14, 15.2], [19, 13], [15.8, 7.4], [15.2, 0], [15.8, -4.4], [18.6, -7], [19.4, -13], [14, -15.6],\n  [7, -14.6], [1, -13.6], [-4.4, -11.8], [-6.4, -7], [-13, -6.2], [-20, -7], [-20.6, 1], [-20.2, 10], [-15, 15], [-8, 15.4],\n  [-3.6, 11], [-5.4, 7.2], [-9.4, 7.6], [-11, 9.8], [-3, 9.6],\n];\nexport const JOG = { speed: 3, bandLow: -0.6, bandHigh: 0.6, stitchAfter: 2, stitchSeconds: 3, stitchSpeed: 0.5, stumble: 0.5, wait: 12, cups: 18, strafe: 1.5, strafeSpeed: 3, limit: 110, hitRadius: 0.75, cupRadius: 0.8 };\n/** Obstacles at a share of the way round, offset across the path. */\nexport const JOG_OBSTACLES = [\n  { u: 0.1, x: 0.8, kind: 'sprinkler' }, { u: 0.17, x: -0.8, kind: 'picnic' }, { u: 0.27, x: 0.2, kind: 'dennis' }, { u: 0.35, x: 0.9, kind: 'sprinkler' },\n  { u: 0.43, x: -0.6, kind: 'kevin' }, { u: 0.52, x: 0.7, kind: 'picnic' }, { u: 0.6, x: -0.9, kind: 'sprinkler' }, { u: 0.68, x: 0.3, kind: 'dennis' },\n  { u: 0.77, x: -0.5, kind: 'picnic' }, { u: 0.85, x: 0.6, kind: 'kevin' }, { u: 0.93, x: -0.8, kind: 'sprinkler' },\n];\nEOF\ncat > src/scenes/activity/jog.js <<'EOF'\n// Island Jog: a rail run round the whole island. Coach paces you on a white mobility scooter.\nimport { ContactShadow, THREE, Trail } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { Kevin, place } from '../../art/props.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { JOG, JOG_OBSTACLES, JOG_PATH } from '../../data/jog.js';\nimport { say } from '../../ui/font.js';\nimport { bar } from '../../ui/widgets.js';\nimport { topRow } from '../../ui/activity-hud.js';\nimport { ActivityScene } from './base.js';\nimport { playerInfo } from './lanes.js';\nimport { buildIsland } from '../hub.js';\n\nconst { CatmullRomCurve3, Vector3 } = THREE;\n\nexport class JogActivity extends ActivityScene {\n  focusV = new Vector3();\n  p = new Vector3();\n  tan = new Vector3();\n\n  async stage(ctx) {\n    const world = buildIsland(ctx, { walls: false });\n    this.water = world.water;\n    this.curve = new CatmullRomCurve3(JOG_PATH.map(([x, z]) => new Vector3(x, 0.08, z)), true, 'catmullrom', 0.5);\n    this.length = this.curve.getLength();\n    this.curve.arcLengthDivisions = 800;\n    this.curve.updateArcLengths();\n    const p = playerInfo();\n    this.avatar = await makeAvatar(ctx, p.look, { at: [0, 0.08, 8.5], clip: 'Jog' });\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [0, 0.3, 8], clip: 'Sit', shadow: false });\n    this.scooter = place(ctx, 'mobility-scooter', { actor: true }).object;\n    this.scootShadow = new ContactShadow(0.7);\n    ctx.scene.add(this.scootShadow);\n    this.trail = new Trail({ width: 0.24, life: 0.5, color: 0x74f0f7, tail: 0xffffff });\n    ctx.scene.add(this.trail);\n    // Water cups along the way, on either side.\n    this.cups = [];\n    for (let i = 0; i < JOG.cups; i++) {\n      const u = (i + 0.7) / JOG.cups;\n      const x = [0.9, -0.9, 0, 1.2, -0.4, 0.5][i % 6];\n      const at = this.pointAt(u, x);\n      const m = place(ctx, 'water-cup', { at: [at.x, 0.06, at.z], actor: true, shadow: false }).object;\n      this.cups.push({ u, x, m, taken: false });\n    }\n    // Sprinklers, picnics, Dennis stretching, and Kevin.\n    this.obs = [];\n    for (const o of JOG_OBSTACLES) {\n      const at = this.pointAt(o.u, o.x);\n      let mesh = null;\n      if (o.kind === 'sprinkler') { mesh = place(ctx, 'sprinkler', { at: [at.x, 0.06, at.z], actor: true }).object; } else if (o.kind === 'picnic') { mesh = place(ctx, 'picnic', { at: [at.x, 0.06, at.z], yaw: 30, actor: true }).object; } else if (o.kind === 'dennis') {\n        const d = await makeAvatar(ctx, LOOKS.dennis, { at: [at.x, 0.06, at.z], yaw: 1, clip: 'Stretch' });\n        this.obs.push({ ...o, av: d });\n        continue;\n      } else {\n        const k = new Kevin(ctx, { at: [at.x, 0.06, at.z], yaw: 1 });\n        this.obs.push({ ...o, kevin: k });\n        continue;\n      }\n      this.obs.push({ ...o, mesh });\n    }\n    this.begin();\n  }\n\n  pointAt(u, x, out = new Vector3()) {\n    const uu = ((u % 1) + 1) % 1;\n    this.curve.getPointAt(uu, out);\n    this.curve.getTangentAt(uu, this.tan);\n    const nx = -this.tan.z, nz = this.tan.x;\n    out.x += nx * x; out.z += nz * x;\n    return out;\n  }\n\n  begin() {\n    this.dist = 0;\n    this.coachDist = 3;\n    this.speed = 0;\n    this.cadence = 0;\n    this.lastFoot = null;\n    this.stepEnergy = 0;\n    this.stitchT = 0;\n    this.overT = 0;\n    this.stumbleT = 0;\n    this.inBandT = 0;\n    this.time = 0;\n    this.cupsGot = 0;\n    this.x = 0;\n    this.botNext = 0;\n    this.botFoot = 'L';\n    this.hitCooldown = 0;\n    for (const c of this.cups ?? []) { c.taken = false; c.m.visible = true; }\n    this.trail?.reset();\n  }\n\n  get targetCadence() { return T.jogTargetCadence * (this.hardData.cadence ?? 1); }\n  get bandLow() { return this.targetCadence + JOG.bandLow; }\n  get bandHigh() { return this.targetCadence + JOG.bandHigh; }\n\n  botInput(out, dt, brain) {\n    out.x = out.y = 0; out.stepL = out.stepR = false;\n    if (!brain.p) return;\n    const play = brain.play;\n    if (this.time >= this.botNext) {\n      const interval = 1 / (this.targetCadence + (play.timing > 0.1 ? Math.sin(this.time * 0.6) * 0.8 : Math.sin(this.time * 0.6) * 0.3));\n      const slip = this.botRand.next() < play.miss * 0.3;\n      const foot = slip ? this.lastFoot ?? 'L' : (this.lastFoot === 'L' ? 'R' : 'L');\n      if (foot === 'L') out.stepL = true; else out.stepR = true;\n      this.botNext = this.time + interval + (this.botRand.next() - 0.5) * play.timing;\n    }\n    // Steer: toward the next cup, around the next obstacle.\n    const u = this.dist / this.length;\n    let wantX = 0;\n    const next = this.cups.find((c) => !c.taken && c.u > u && (c.u - u) * this.length < 14);\n    if (next) wantX = next.x;\n    for (const o of this.obs) {\n      const d = (o.u - u) * this.length;\n      if (d > 0 && d < 5 && Math.abs(wantX - o.x) < JOG.hitRadius + 0.05) wantX = o.x + (o.x > 0 ? -1.2 : 1.2);\n    }\n    out.x = -Math.max(-1, Math.min(1, (wantX - this.x) * 3)) * play.speed;\n  }\n\n  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    const inp = this.readPlayer(ctx, dt, { x: ctx.hud.width / 2, y: ctx.hud.height / 2 });\n    const step = (foot) => {\n      if (foot === this.lastFoot) {\n        this.stumbleT = JOG.stumble;\n        App.sfx('stepMiss');\n        if (this.scoring && !this.attractMode && this.t > (this.remarkT ?? 0)) { this.remarkT = this.t + 5; App.say('ounce', 'Left, right. Not left, left. Left, left is a stumble.'); }\n      } else {\n        this.stepEnergy += 1;\n        App.sfx('step', { volume: 0.2 });\n      }\n      this.lastFoot = foot;\n    };\n    if (inp.stepL) step('L');\n    if (inp.stepR) step('R');\n    // Cadence: smoothed steps/s.\n    const rawCadence = this.stepEnergy / dt;\n    this.stepEnergy = 0;\n    this.cadence += (rawCadence - this.cadence) * Math.min(1, dt / 0.7);\n    if (this.stumbleT > 0) this.stumbleT -= dt;\n    if (this.cadence > this.bandHigh) { this.overT += dt; if (this.overT >= JOG.stitchAfter && this.stitchT <= 0) { this.stitchT = JOG.stitchSeconds; this.overT = 0; App.sfx('stitch'); if (!this.attractMode) App.say('ounce', 'A stitch. Your side has filed a complaint.'); } } else this.overT = Math.max(0, this.overT - dt);\n    if (this.stitchT > 0) this.stitchT -= dt;\n    let v = (this.cadence / this.targetCadence) * JOG.speed;\n    v = Math.min(v, JOG.speed * 1.35);\n    if (this.stitchT > 0) v *= JOG.stitchSpeed;\n    if (this.stumbleT > 0) v = 0.4;\n    this.speed += (v - this.speed) * Math.min(1, dt * 5);\n    if (App.dev.god) this.speed = JOG.speed;\n    if (this.cheatRing) this.speed = JOG.speed * 1.4;\n    this.dist += this.speed * dt;\n    const inBand = this.cadence >= this.bandLow && this.cadence <= this.bandHigh && this.stitchT <= 0;\n    this.inBand = inBand;\n    if (inBand && scoring) this.inBandT += dt;\n    this.x = Math.max(-JOG.strafe, Math.min(JOG.strafe, this.x - inp.x * JOG.strafeSpeed * dt));\n    // Coach goes at exactly target speed. More than 12 m behind, she waits, unimpressed.\n    if (this.coachDist - this.dist < JOG.wait) this.coachDist = Math.min(this.length + 2, this.coachDist + JOG.speed * dt);\n    // Cups and obstacles.\n    const u = this.dist / this.length;\n    if (this.hitCooldown > 0) this.hitCooldown -= dt;\n    for (const c of this.cups) {\n      if (c.taken) continue;\n      if (Math.abs((c.u - u) * this.length) < 0.8 && Math.abs(c.x - this.x) < JOG.cupRadius) {\n        c.taken = true; c.m.visible = false;\n        if (scoring) this.cupsGot++;\n        App.sfx('cupGet', { pitch: this.cupsGot * 0.5 });\n        ctx.particles.burst('dripDrop', [this.avatar.root.position.x, 1, this.avatar.root.position.z]);\n      }\n    }\n    if (this.hitCooldown <= 0 && !this.cheatRing && !App.dev.god) {\n      for (const o of this.obs) {\n        if (Math.abs((o.u - u) * this.length) < 0.8 && Math.abs(o.x - this.x) < JOG.hitRadius) {\n          this.hitCooldown = 1.2;\n          this.stumbleT = 0.7;\n          App.sfx('flipFlopThwap', { volume: 0.5 });\n          if (o.kind === 'kevin') App.sfx('gullSquawk');\n          if (this.scoring && !this.attractMode && this.t > (this.remarkT ?? 0)) { this.remarkT = this.t + 5; App.say('ounce', o.kind === 'dennis' ? 'That was Dennis. He says it\\'s fine.' : o.kind === 'kevin' ? 'That was Kevin. He has been told.' : 'Please watch the amenities.'); }\n          break;\n        }\n      }\n    }\n  }\n\n  isOver() { return this.dist >= this.length || this.time >= JOG.limit; }\n  playLength() { return JOG.limit; }\n\n  result() {\n    const nominal = this.length / JOG.speed;\n    const pace = Math.min(1, this.inBandT / nominal);\n    const cups = this.cupsGot / JOG.cups;\n    const finished = this.dist >= this.length;\n    const score = Math.round((70 * pace + 30 * cups) * (finished ? 1 : 0.8));\n    return { score, seconds: this.time, display: `${score}%`, pace, cups: this.cupsGot };\n  }\n\n  visual(ctx, dt) {\n    const u = Math.min(0.9999, this.dist / this.length);\n    const at = this.pointAt(u, this.x, this.p);\n    const a = this.avatar.root;\n    const uu = u;\n    this.curve.getTangentAt(uu, this.tan);\n    a.position.set(at.x, 0.08, at.z);\n    a.rotation.y = Math.atan2(this.tan.x, this.tan.z);\n    if (this.stumbleT > 0) this.avatar.play('Hurt', { fade: 0.08 });\n    else if (this.speed < 0.3) this.avatar.play('Idle', { fade: 0.2 });\n    else { const act = this.avatar.play('Jog', { fade: 0.15 }); act.timeScale = this.speed / 3; }\n    this.avatar.update(dt);\n    // Coach and her scooter.\n    const cu = Math.min(0.9999, this.coachDist / this.length);\n    const cp = this.pointAt(cu, -0.2, new Vector3());\n    this.curve.getTangentAt(cu, this.tan);\n    const yaw = Math.atan2(this.tan.x, this.tan.z);\n    this.scooter.position.set(cp.x, 0.06, cp.z);\n    this.scooter.rotation.y = yaw;\n    this.scootShadow.place(cp.x, 0.07, cp.z, 0);\n    this.coach.root.position.set(cp.x, 0.24, cp.z);\n    this.coach.root.rotation.y = yaw;\n    this.coach.update(dt);\n    for (const o of this.obs) {\n      if (o.av) o.av.update(dt);\n      if (o.kevin) o.kevin.update(dt);\n      if (o.kind === 'sprinkler' && o.mesh) {\n        const arm = o.mesh.getObjectByName('arm');\n        if (arm) arm.rotation.y = this.t * 6;\n      }\n    }\n    this.trail.push(a.position, ctx.time);\n    this.trail.update(ctx.time, ctx.camera.camera);\n    this.water?.update(ctx.time);\n    this.focusV.set(at.x + this.tan.x * 2, 1, at.z + this.tan.z * 2);\n  }\n\n  cameraTarget() { return this.focusV; }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro') return;\n    const { hud } = ctx;\n    const cx = Math.round(hud.width / 2);\n    const w = Math.min(hud.width - 60, 240);\n    // Cadence: a gauge with its band marked.\n    const y = 30;\n    const max = this.bandHigh + 1.4;\n    hud.rect(cx - w / 2 - 1, y - 1, w + 2, 12, 'ink');\n    hud.rect(cx - w / 2, y, w, 10, 'white');\n    const bx = cx - w / 2 + (this.bandLow / max) * w;\n    hud.rect(Math.round(bx), y, Math.round(((this.bandHigh - this.bandLow) / max) * w), 10, this.inBand ? 'lime' : 'mist');\n    const mx = cx - w / 2 + (Math.min(max, this.cadence) / max) * w;\n    hud.rect(Math.round(mx) - 2, y - 2, 4, 14, this.stitchT > 0 ? 'red' : 'ink');\n    const gap = this.coachDist - this.dist;\n    bar(hud, cx - w / 2, y + 14, w, 5, this.dist / this.length, 'cyan', 'ink', 'jog-progress');\n    if (gap >= JOG.wait - 0.2) { hud.rect(cx - 80, y + 22, 160, 12, 'navy'); say(hud, cx - 76, y + 24, 'Coach waits, unimpressed.', { color: 'sand', name: 'coach-wait' }); }\n    if (this.stitchT > 0) { hud.rect(cx - 30, y + 22, 60, 12, 'navy'); say(hud, cx - 24, y + 24, 'Stitch', { color: 'red', name: 'stitch' }); }\n  }\n\n  drawGameHud(ctx) {\n    const left = Math.max(0, this.length - this.dist);\n    topRow(ctx.hud, `${Math.ceil(left)} m`, `${this.cupsGot}/${JOG.cups} cups`);\n  }\n\n  overlayDot() { return `cad ${this.cadence.toFixed(2)} v ${this.speed.toFixed(2)} x ${this.x.toFixed(2)}`; }\n  fingerprint() { return `${this.dist.toFixed(4)}|${this.cupsGot}|${this.inBandT.toFixed(4)}`; }\n}\nEOF\ncat > src/data/longstand.js <<'EOF'\n// The Long Stand, as a timeline. A new event is a new row.\nexport const STAND_LENGTH = 90;\nexport const STAND_TIMELINE = [\n  { t: 0, say: ['coach', 'Stand.'], ring: 0.4 },\n  { t: 10, kevinOn: true, biasX: 0.1, say: ['ounce', 'Kevin is on your head. He is staff. Carry on.'] },\n  { t: 20, sneeze: true, impulse: [0, -0.6], say: ['dennis', 'Sorry. Sorry. It\\'s just the one nose.'] },\n  { t: 30, ring: 0.34 },\n  { t: 35, rain: true, noise: 1.2 },\n  { t: 45, clap: true, say: ['ounce', 'Ignore her.'] },\n  { t: 50, ring: 0.28 },\n  { t: 55, juneText: 'Are you nearly done?', say: ['june', 'Are you nearly done?'] },\n  { t: 65, rumble: true, randomImpulse: 0.6 },\n  { t: 75, rain: false, noise: 1, sun: true, ring: 0.24, swell: true },\n  { t: 85, kevinOn: false, biasX: 0, impulse: [0.3, 0.2], say: ['ounce', 'Kevin has left. He said nothing. He never does.'] },\n  { t: 90, say: ['coach', 'You may blink.'] },\n];\nEOF\ncat > src/scenes/activity/longstand.js <<'EOF'\n// The Long Stand. 90 seconds of standing still while the whole island tries to distract you.\nimport { applySky, Precipitation, skyAt, THREE } from '../../../pixel-engine.js';\nimport { App } from '../../app.js';\nimport { Dot } from '../../core/dot.js';\nimport { T } from '../../core/tunables.js';\nimport { makeAvatar } from '../../art/avatar.js';\nimport { Kevin, Ounce } from '../../art/props.js';\nimport { LOOKS } from '../../data/classmates.js';\nimport { STAND_LENGTH, STAND_TIMELINE } from '../../data/longstand.js';\nimport { say } from '../../ui/font.js';\nimport { drawDial } from '../../ui/widgets.js';\nimport { topRow } from '../../ui/activity-hud.js';\nimport { ActivityScene } from './base.js';\nimport { playerInfo } from './lanes.js';\nimport { plazaSet } from '../sets.js';\n\nconst { Vector3 } = THREE;\n\nexport class LongStandActivity extends ActivityScene {\n  outroLength = 2.4;\n  rainAt = new Vector3(0, 0, 0);\n\n  async stage(ctx) {\n    plazaSet(ctx, 17.5);\n    applySky(ctx.engine, skyAt(17.5));\n    const p = playerInfo();\n    this.you = await makeAvatar(ctx, p.look, { at: [0, 0, 1], yaw: 0, clip: 'Idle' });\n    this.addOunce(ctx, { at: [-1.7, 0.04, 1.9], yaw: 0.4, scale: 1.3 });\n    this.coach = await makeAvatar(ctx, LOOKS.coach, { at: [3.2, 0, -0.8], yaw: -0.5, clip: 'CoachStand' });\n    this.coach.addPlumb();\n    this.marguerite = await makeAvatar(ctx, LOOKS.marguerite, { at: [-3.4, 0, -0.8], yaw: 0.5, clip: 'Watch' });\n    this.dennis = await makeAvatar(ctx, LOOKS.dennis, { at: [-4.4, 0, 0.8], yaw: 0.7, clip: 'Slump' });\n    this.june = await makeAvatar(ctx, LOOKS.june, { at: [4.5, 0, 0.8], yaw: -0.7, clip: 'Watch' });\n    this.kevin = new Kevin(ctx, { at: [2, 3, -2], yaw: 2 });\n    this.rain = new Precipitation({ kind: 'rain', count: 2400, area: [20, 12, 12] });\n    ctx.scene.add(this.rain);\n    this.rain.intensity = 0;\n    this.dot = new Dot(() => this.rng.next());\n    this.begin(false);\n  }\n\n  startMusic() { App.music('stand'); }\n\n  begin() {\n    this.time = this.args.from ?? 0;\n    this.nextEvent = 0;\n    while (this.nextEvent < STAND_TIMELINE.length && STAND_TIMELINE[this.nextEvent].t < this.time) this.applyEvent(STAND_TIMELINE[this.nextEvent++], true);\n    if (this.nextEvent === 0) { this.ring = 0.4; this.bias = 0; this.noise = 1; }\n    this.dot.reset();\n    this.frames = 0; this.inside = 0;\n    this.juneT = 0;\n    this.wasInside = false;\n    this.clapT = -1;\n  }\n\n  /** Effects from the data. silent: replaying them to reach a later starting point. */\n  applyEvent(e, silent = false) {\n    if (e.ring !== undefined) this.ring = e.ring;\n    if (e.biasX !== undefined) this.bias = e.biasX;\n    if (e.noise !== undefined) this.noise = e.noise;\n    if (e.rain !== undefined) this.raining = e.rain;\n    if (silent) return;\n    const ctx = this.ctx;\n    if (e.say) App.say(e.say[0], e.say[1]);\n    if (e.kevinOn === true) this.kevin.flyTo(0, 1.74, 1, 1.1);\n    if (e.kevinOn === false) { this.kevin.flyTo(-14, 9, -16, 3); this.kevinPerched = false; }\n    if (e.kevinOn === true) this.kevinPerched = true;\n    if (e.sneeze) { App.sfx('sneeze'); this.dennis.play('Sneeze', { once: true, fade: 0.05, then: () => this.dennis.play('Slump', { fade: 0.3 }) }); }\n    if (e.impulse) this.dot.impulse(e.impulse[0], e.impulse[1]);\n    if (e.clap) { this.marguerite.play('SlowClap', { fade: 0.3 }); this.clapT = 0; }\n    if (e.juneText) { this.juneT = 9; this.juneMsg = e.juneText; }\n    if (e.rumble) {\n      App.sfx('rumble');\n      ctx.engine.shake.add(0.8);\n      const a = this.rng.range(0, 6.28);\n      this.dot.impulse(Math.cos(a) * e.randomImpulse, Math.sin(a) * e.randomImpulse);\n    }\n    if (e.sun) {\n      applySky(ctx.engine, skyAt(16));\n      if (!App.settings.reduceFlashes) App.flash('sand', { duration: 0.4 });\n    }\n  }\n\n  botInput(out, dt, brain) { brain.lean(out, this.dot, 0, 0, dt); }\n\n  stepPlay(ctx, dt, scoring) {\n    this.time += dt;\n    while (this.nextEvent < STAND_TIMELINE.length && STAND_TIMELINE[this.nextEvent].t <= this.time) this.applyEvent(STAND_TIMELINE[this.nextEvent++]);\n    const inp = this.readPlayer(ctx, dt, this.dial);\n    this.dot.step(dt, inp.x, inp.y, T, { noise: this.noise * App.noiseScale(), bx: this.bias * T.dotAuthority });\n    const ring = App.ringOf(this.ring) * this.ringBoost;\n    if (App.dev.god || this.cheatRing) this.dot.clampTo(0, 0, ring * 0.9);\n    const inside = Math.hypot(this.dot.x, this.dot.y) <= ring;\n    if (inside !== this.wasInside) { App.sfx(inside ? 'ringIn' : 'ringOut', { volume: 0.5 }); this.wasInside = inside; }\n    if (scoring) { this.frames++; if (inside) this.inside++; }\n    if (this.clapT >= 0) {\n      this.clapT += dt;\n      if (this.clapT > 1.2 && this.time < 75) { this.clapT = 0; App.sfx('clap'); }\n    }\n    this.you.action('Idle').timeScale = 1;\n  }\n\n  isOver() { return this.time >= STAND_LENGTH; }\n  playLength() { return STAND_LENGTH; }\n\n  result() {\n    const score = Math.round(this.frames ? (100 * this.inside) / this.frames : 0);\n    return { score, seconds: this.time, display: `${score}%` };\n  }\n\n  onOutroStart() {\n    this.coach.play('Bow', { once: true, fade: 0.3 });\n    this.marguerite.play('Idle', { fade: 0.3 });\n  }\n\n  visual(ctx, dt) {\n    this.you.update(dt);\n    const ring = App.ringOf(this.ring ?? 0.4);\n    const d = Math.hypot(this.dot.x, this.dot.y);\n    this.you.lean(this.dot.x, this.dot.y, d > ring ? Math.min(1.5, (d - ring) * 3) : 0, this.t);\n    for (const a of [this.marguerite, this.dennis, this.june]) a.update(dt);\n    this.rain.intensity += ((this.raining ? 1 : 0) - this.rain.intensity) * Math.min(1, dt * 1.2);\n    this.rain.update(dt, this.rainAt);\n    if (this.kevinPerched && this.kevin.state !== 'fly') {\n      const head = this.you.head?.getWorldPosition?.(this.rainAt);\n      if (head) this.kevin.root.position.set(head.x, head.y + 0.42, head.z);\n      this.rainAt.set(0, 0, 0);\n    }\n    this.juneT = Math.max(0, this.juneT - dt);\n    this.camPush = Math.min(1.6, (this.time / STAND_LENGTH) * 1.6);\n  }\n\n  drawGame(ctx) {\n    if (this.phase === 'intro' || this.phase === 'results') return;\n    const { hud } = ctx;\n    const ring = App.ringOf(this.ring ?? 0.4) * this.ringBoost;\n    const x = Math.round(hud.width / 2), y = 56, r = 44;\n    this.dial = { x, y };\n    const mouse = App.device.last === 'mouse' && !this.autopilot ? App.device.pointerArt(ctx) : null;\n    drawDial(hud, { x, y, r, dot: this.dot, ringR: ring, inside: this.wasInside, brighten: 1, mouse });\n    if (this.juneT > 0) {\n      // Text drifting across the dial: June's contribution.\n      const u = 1 - this.juneT / 9;\n      const tx = Math.round(x - 110 + u * 150);\n      say(hud, tx, y - 4 + Math.round(Math.sin(u * 9) * 8), this.juneMsg, { color: 'red', shadow: 'white', name: 'june' });\n    }\n  }\n\n  drawGameHud(ctx) {\n    const left = Math.max(0, STAND_LENGTH - this.time);\n    topRow(ctx.hud, `${Math.ceil(left)}s`, this.frames ? `${Math.round((100 * this.inside) / this.frames)}%` : '');\n  }\n\n  overlayDot() { return `${this.dot.x.toFixed(2)},${this.dot.y.toFixed(2)} ring ${this.ring?.toFixed(2)} t ${this.time?.toFixed(1)}`; }\n  fingerprint() { return `${this.dot.x.toFixed(6)}|${this.inside}|${this.frames}`; }\n}\nEOF\npython3 - <<'EOF'\np='src/scenes/index.js'; s=open(p).read()\ns=s.replace(\"\"\"import { PoseActivity } from './activity/poses.js';\"\"\",\"\"\"import { PoseActivity } from './activity/poses.js';\nimport { RepsActivity } from './activity/reps.js';\nimport { HoopActivity } from './activity/hoop.js';\nimport { StepActivity } from './activity/step.js';\nimport { HeaderActivity } from './activity/header.js';\nimport { SlacklineActivity } from './activity/slackline.js';\nimport { TrayActivity } from './activity/tray.js';\nimport { PierActivity } from './activity/pier.js';\nimport { JogActivity } from './activity/jog.js';\nimport { LongStandActivity } from './activity/longstand.js';\"\"\")\ns=s.replace(\"\"\"  poses: PoseActivity,\n\"\"\",\"\"\"  poses: PoseActivity, reps: RepsActivity, hoop: HoopActivity, step: StepActivity, header: HeaderActivity,\n  slackline: SlacklineActivity, tray: TrayActivity, pier: PierActivity, jog: JogActivity, longstand: LongStandActivity,\n\"\"\")\nopen(p,'w').write(s)\np='../PROGRESS.md'; s=open(p).read()\ns=s.replace(\"- [ ] 5 Other activities (Hoop, Reps, Header, Step, Slackline, Tray, Pier, Jog)\",\"- [~] 5 Other activities: all written (src/scenes/activity/*) incl longstand; bot tuning/tests next\")\nopen(p,'w').write(s)\nEOF\ncat > .scratch/acts.mjs <<'EOF'\nimport { boot, App } from '../tests/lib.mjs';\nimport { PLAYABLE_IDS, ACTIVITY_IDS, ACTIVITIES } from '../src/data/activities.js';\nconst only = process.argv[2] ? process.argv[2].split(',') : ACTIVITY_IDS;\nconst h = await boot({ scene:'title' });\nfor (const id of only) {\n  const row=[];\n  for (const skill of ['idle','sloppy','average','good','expert']) {\n    try {\n    await h.go('activity',{ id, mode:'dropin', noPractice:true });\n    App.dev.autopilot = skill;\n    const started=Date.now();\n    await h.until(()=>App.scene.resultsShown,{what:id+' '+skill, max:60*200, every:60});\n    const r=App.scene.lastResult;\n    row.push(`${skill}:${typeof r.score==='number'?r.score.toFixed?r.score.toFixed(0):r.score:r.score}/${r.stars}*${(r.seconds||0).toFixed(0)}s`);\n    } catch(e){ row.push(skill+':ERR '+e.message.slice(0,200)); }\n    h.engine.errors.length && row.push('E:'+h.engine.errors.slice(-1)[0].slice(0,100));\n  }\n  console.log(id.padEnd(10), row.join('  '));\n  App.dev.autopilot=null;\n}\nprocess.exit(0);\nEOF\ntimeout 280 node .scratch/acts.mjs </dev/null 2>&1 | tail -30 | cut -c1-320","description":"Write Slackline, Tray, Pier, Jog and Long Stand, then run bots through every activity","timeout":295000}}}
