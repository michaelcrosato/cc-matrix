{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgjHu3aqqD3amqYuFLXN7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01FUx4Mt7vSQCnGsyWX6oAwR","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/ui/font.js <<'EOF'\n// Mixed-case text: lowercase through hud.sprite, everything else through hud.text, on a 6 px grid.\n// Rows top to bottom, 5 bits, bit 4 = left. Rows 7-8 are descenders.\nimport { layout } from './layout.js';\n\nconst H = {\n  a: '00 00 0e 01 0f 11 0f 00 00', b: '10 10 1e 11 11 11 1e 00 00', c: '00 00 0e 11 10 11 0e 00 00', d: '01 01 0f 11 11 11 0f 00 00',\n  e: '00 00 0e 11 1f 10 0e 00 00', f: '06 09 08 1c 08 08 08 00 00', g: '00 00 0f 11 11 11 0f 01 0e', h: '10 10 1e 11 11 11 11 00 00',\n  i: '04 00 0c 04 04 04 0e 00 00', j: '02 00 06 02 02 02 02 12 0c', k: '10 10 12 14 18 14 12 00 00', l: '0c 04 04 04 04 04 0e 00 00',\n  m: '00 00 1a 15 15 15 15 00 00', n: '00 00 1e 11 11 11 11 00 00', o: '00 00 0e 11 11 11 0e 00 00', p: '00 00 1e 11 11 11 1e 10 10',\n  q: '00 00 0f 11 11 11 0f 01 01', r: '00 00 16 19 10 10 10 00 00', s: '00 00 0f 10 0e 01 1e 00 00', t: '08 08 1c 08 08 09 06 00 00',\n  u: '00 00 11 11 11 13 0d 00 00', v: '00 00 11 11 11 0a 04 00 00', w: '00 00 11 11 15 15 0a 00 00', x: '00 00 11 0a 04 0a 11 00 00',\n  y: '00 00 11 11 11 11 0f 01 0e', z: '00 00 1f 02 04 08 1f 00 00',\n};\nexport const GLYPHS = Object.fromEntries(Object.entries(H).map(([k, v]) => [k, v.split(' ').map((h) => parseInt(h, 16).toString(2).padStart(5, '0').replace(/0/g, '.').replace(/1/g, 'o'))]));\n\n/** Everything the engine's 5x7 font can draw, besides the lowercase above. */\nexport const ENGINE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .,:-+=/()[]%_!?<>#\\'\"*@{};&|\\\\~^$`';\nconst KNOWN = new Set([...ENGINE_CHARS, ...Object.keys(GLYPHS)]);\n\n/** Hub names can hold anything: every character the font lacks becomes '?'. */\nexport function sanitize(text) {\n  return String(text)\n    .replace(/[‘’]/g, \"'\").replace(/[“”]/g, '\"').replace(/…/g, '...').replace(/[–—]/g, '-')\n    .replace(/[^\\n]/g, (c) => (KNOWN.has(c) ? c : '?'));\n}\n\nexport function hasGlyph(ch) { return KNOWN.has(ch); }\n\nexport const textWidth = (text, scale = 1) => (String(text).length ? String(text).length * 6 - 1 : 0) * scale;\n\n/** Draw text at art-pixel (x, y). Returns the x after the last character. */\nexport function say(hud, x, y, text, { color = 'white', shadow = 'ink', scale = 1, name = 'text' } = {}) {\n  const s = sanitize(text);\n  layout.rec(name, x, y, textWidth(s, scale), 9 * scale, s);\n  for (const ch of s) {\n    const g = GLYPHS[ch];\n    if (g) hud.sprite(x, y, g, { o: color }, { scale, shadow });\n    else if (ch !== ' ') hud.text(x, y, ch, { color, shadow, scale });\n    x += 6 * scale;\n  }\n  return x;\n}\n\nexport function sayCentered(hud, cx, y, text, opts = {}) {\n  const w = textWidth(sanitize(text), opts.scale ?? 1);\n  return say(hud, Math.round(cx - w / 2), y, text, opts);\n}\n\nexport function sayRight(hud, rx, y, text, opts = {}) {\n  const w = textWidth(sanitize(text), opts.scale ?? 1);\n  return say(hud, Math.round(rx - w), y, text, opts);\n}\n\n/** Word wrap by characters per line. */\nexport function wrap(text, maxChars) {\n  const out = [];\n  for (const para of sanitize(text).split('\\n')) {\n    let line = '';\n    for (const word of para.split(' ')) {\n      if (word.length > maxChars) {\n        if (line) { out.push(line); line = ''; }\n        let w = word;\n        while (w.length > maxChars) { out.push(w.slice(0, maxChars)); w = w.slice(maxChars); }\n        line = w;\n        continue;\n      }\n      const next = line ? `${line} ${word}` : word;\n      if (next.length > maxChars) { out.push(line); line = word; } else line = next;\n    }\n    out.push(line);\n  }\n  return out;\n}\n\n/** Chars that fit in a width of art pixels at a scale. */\nexport const charsIn = (width, scale = 1) => Math.max(1, Math.floor((width + scale) / (6 * scale)));\nEOF\ncat > src/ui/layout.js <<'EOF'\n// Every widget records its rect each frame, so a script can check nothing overflows.\nexport const layout = {\n  rects: [],\n  prompts: [],\n  record: false,\n  begin() { this.rects.length = 0; this.prompts.length = 0; },\n  rec(name, x, y, w, h, text = '') { if (this.record) this.rects.push({ name, x, y, w, h, text }); },\n  overflow(width, height) {\n    return this.rects.filter((r) => r.x < 0 || r.y < 0 || r.x + r.w > width || r.y + r.h > height);\n  },\n};\nEOF\ncat > src/ui/widgets.js <<'EOF'\n// Shapes for the pixel HUD. Lines are at least 2 art px thick: a 1 px ring vanishes at 10 feet.\nimport { layout } from './layout.js';\nimport { say, sayCentered, textWidth } from './font.js';\n\nexport const SAFE = 12;\n\nexport function panel(hud, x, y, w, h, { fill = 'white', border = 'ink', name = 'panel', thick = 1 } = {}) {\n  layout.rec(name, x, y, w, h);\n  hud.rect(x + 1, y - thick, w - 2, thick, border);\n  hud.rect(x + 1, y + h, w - 2, thick, border);\n  hud.rect(x - thick, y + 1, thick, h - 2, border);\n  hud.rect(x + w, y + 1, thick, h - 2, border);\n  hud.rect(x, y, w, h, fill);\n}\n\nexport function bar(hud, x, y, w, h, frac, color = 'cyan', back = 'ink', name = 'bar') {\n  layout.rec(name, x, y, w, h);\n  hud.rect(x, y, w, h, back);\n  const f = Math.max(0, Math.min(1, frac));\n  if (f > 0) hud.rect(x + 1, y + 1, Math.max(1, Math.round((w - 2) * f)), Math.max(1, h - 2), color);\n}\n\n/** A filled disc, drawn as scanlines. */\nexport function disc(hud, cx, cy, r, color) {\n  const ir = Math.ceil(r);\n  for (let dy = -ir; dy <= ir; dy++) {\n    const half = Math.sqrt(Math.max(0, r * r - dy * dy));\n    if (half <= 0 && Math.abs(dy) >= r) continue;\n    const hw = Math.round(half);\n    hud.rect(Math.round(cx) - hw, Math.round(cy) + dy, hw * 2 + 1, 1, color);\n  }\n}\n\n/** A ring, drawn as scanlines between two radii. */\nexport function ring(hud, cx, cy, r, thick, color) {\n  const outer = r + thick / 2, inner = Math.max(0, r - thick / 2);\n  const ir = Math.ceil(outer);\n  const X = Math.round(cx), Y = Math.round(cy);\n  for (let dy = -ir; dy <= ir; dy++) {\n    const a = outer * outer - dy * dy;\n    if (a < 0) continue;\n    const ho = Math.round(Math.sqrt(a));\n    const b = inner * inner - dy * dy;\n    if (b <= 0) { hud.rect(X - ho, Y + dy, ho * 2 + 1, 1, color); continue; }\n    const hi = Math.round(Math.sqrt(b));\n    const w = Math.max(1, ho - hi);\n    hud.rect(X - ho, Y + dy, w, 1, color);\n    hud.rect(X + hi + (ho - hi - w) + 1, Y + dy, w, 1, color);\n  }\n}\n\nexport function line(hud, x0, y0, x1, y1, color, thick = 2) {\n  const d = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0), 1);\n  const off = Math.floor(thick / 2);\n  for (let i = 0; i <= d; i++) {\n    const t = i / d;\n    hud.rect(Math.round(x0 + (x1 - x0) * t) - off, Math.round(y0 + (y1 - y0) * t) - off, thick, thick, color);\n  }\n}\n\nconst STAR_ROWS = [\n  '.....o.....',\n  '....ooo....',\n  '....ooo....',\n  'ooooooooooo',\n  '.ooooooooo.',\n  '..ooooooo..',\n  '...ooooo...',\n  '..ooo.ooo..',\n  '..oo...oo..',\n];\nexport const STAR_W = 11;\n\nexport function star(hud, x, y, filled = true, scale = 1) {\n  layout.rec('star', x, y, STAR_W * scale, 9 * scale);\n  hud.sprite(x, y, STAR_ROWS, { o: filled ? 'sand' : 'slate' }, { scale, shadow: 'ink' });\n}\n\nexport function starRow(hud, x, y, count, scale = 1, total = 3) {\n  for (let i = 0; i < total; i++) star(hud, x + i * (STAR_W + 2) * scale, y, i < count, scale);\n  return x + total * (STAR_W + 2) * scale;\n}\n\nexport function starRowWidth(scale = 1, total = 3) { return total * (STAR_W + 2) * scale - 2 * scale; }\n\n/** The balance dial: a white face, the ring, the Dot. p coordinates run to 1.2 at the rim. */\nexport function drawDial(hud, { x, y, r = 44, dot = null, ringR = 0.3, ringX = 0, ringY = 0, inside = false, brighten = 0, target = null, fade = 1, mouse = null, color = 'red', label = null, hideDot = false }) {\n  const X = Math.round(x), Y = Math.round(y);\n  layout.rec('dial', X - r - 2, Y - r - 2, r * 2 + 4, r * 2 + 4);\n  disc(hud, X, Y, r + 2, 'slate');\n  disc(hud, X, Y, r, 'white');\n  const s = r / 1.2;\n  hud.rect(X - r + 3, Y, r * 2 - 5, 1, 'mist');\n  hud.rect(X, Y - r + 3, 1, r * 2 - 5, 'mist');\n  if (fade > 0) {\n    const rc = inside ? (brighten > 0.6 ? 'lime' : 'green') : 'teal';\n    ring(hud, X + ringX * s, Y - ringY * s, Math.max(3, ringR * s), r > 30 ? 3 : 2, rc);\n  }\n  if (target) {\n    disc(hud, X + target.x * s, Y - target.y * s, r > 30 ? 4 : 3, 'orange');\n    ring(hud, X + target.x * s, Y - target.y * s, (r > 30 ? 6 : 4), 1, 'ink');\n  }\n  if (dot && fade > 0 && !hideDot) {\n    const dr = r > 30 ? 4 : 3;\n    disc(hud, X + dot.x * s, Y - dot.y * s, dr + 1, 'ink');\n    disc(hud, X + dot.x * s, Y - dot.y * s, dr, color);\n  }\n  if (mouse) {\n    line(hud, X, Y, mouse.x, mouse.y, 'mist', 1);\n    hud.rect(mouse.x - 3, mouse.y, 7, 1, 'ink');\n    hud.rect(mouse.x, mouse.y - 3, 1, 7, 'ink');\n  }\n  if (label) sayCentered(hud, X, Y + r + 4, label, { color: 'white', name: 'dial-label' });\n}\n\n/** A heading with a soft backing strip. */\nexport function heading(hud, text, y = SAFE, scale = 2, color = 'white') {\n  const w = textWidth(text, scale);\n  const cx = Math.round(hud.width / 2);\n  hud.rect(cx - Math.round(w / 2) - 6, y - 3, w + 12, 9 * scale + 5, 'navy');\n  sayCentered(hud, cx, y, text, { scale, color, name: 'heading' });\n}\n\nexport function pill(hud, x, y, text, { fill = 'navy', color = 'white', scale = 1, name = 'pill' } = {}) {\n  const w = textWidth(text, scale) + 6 * scale;\n  hud.rect(x, y, w, 9 * scale + 2, fill);\n  say(hud, x + 3 * scale, y + 1, text, { color, scale, name });\n  return w;\n}\n\nexport { say, sayCentered };\nEOF\ncat > src/art/glyphs.js <<'EOF'\n// Button prompts, drawn here: PlayStation shapes, Xbox letters, keycaps, a mouse with the used button lit.\nimport { say } from '../ui/font.js';\nimport { disc } from '../ui/widgets.js';\n\nconst PINK = 0xe58fd0;\nconst SHAPES = {\n  cross: { color: 'sky', rows: ['o...o', '.o.o.', '..o..', '.o.o.', 'o...o'] },\n  circle: { color: 'red', rows: ['.ooo.', 'o...o', 'o...o', 'o...o', '.ooo.'] },\n  square: { color: PINK, rows: ['ooooo', 'o...o', 'o...o', 'o...o', 'ooooo'] },\n  triangle: { color: 'lime', rows: ['..o..', '..o..', '.o.o.', '.o.o.', 'ooooo'] },\n  a: { color: 'lime', rows: ['.ooo.', 'o...o', 'ooooo', 'o...o', 'o...o'] },\n  b: { color: 'red', rows: ['oooo.', 'o...o', 'oooo.', 'o...o', 'oooo.'] },\n  x: { color: 'sky', rows: ['o...o', '.o.o.', '..o..', '.o.o.', 'o...o'] },\n  y: { color: 'sand', rows: ['o...o', '.o.o.', '..o..', '..o..', '..o..'] },\n};\nconst PILLS = { l1: 'L1', r1: 'R1', l2: 'L2', r2: 'R2', lb: 'LB', rb: 'RB', lt: 'LT', rt: 'RT' };\n\nexport const GLYPH_NAMES = [...Object.keys(SHAPES), ...Object.keys(PILLS), 'options', 'menu', 'stickL', 'dpad', 'mouse', 'mouseL', 'mouseR', 'wheel', 'pauseIcon'];\n\nconst MOUSE = ['..ooo..', '.obbbo.', 'oLLoRRo', 'oLLoRRo', 'oLLoRRo', 'ooooooo', 'obbbbbo', 'obbbbbo', 'obbbbbo', '.obbbo.', '..ooo..'];\n\nfunction drawMouse(hud, x, y, left, right, wheel = false) {\n  hud.sprite(x, y, MOUSE, { o: 'ink', b: 'white', L: left ? 'red' : 'white', R: right ? 'red' : 'white' }, { shadow: false });\n  if (wheel) hud.rect(x + 3, y + 1, 1, 4, 'red');\n  return 7;\n}\n\nexport function glyphWidth(name) {\n  if (SHAPES[name]) return 11;\n  if (PILLS[name]) return 15;\n  if (name === 'options' || name === 'menu' || name === 'dpad' || name === 'stickL' || name === 'pauseIcon') return 11;\n  if (name === 'mouse' || name === 'mouseL' || name === 'mouseR' || name === 'wheel') return 7;\n  return name.length * 6 + 5; // a keycap\n}\n\nexport function drawGlyph(hud, x, y, name) {\n  const shape = SHAPES[name];\n  if (shape) {\n    disc(hud, x + 5, y + 5, 5.5, 'ink');\n    hud.sprite(x + 3, y + 3, shape.rows, { o: shape.color }, { shadow: false });\n    return 11;\n  }\n  if (PILLS[name]) {\n    hud.rect(x, y + 1, 15, 9, 'ink');\n    hud.rect(x + 1, y, 13, 11, 'ink');\n    say(hud, x + 2, y + 2, PILLS[name], { color: 'white', shadow: false, name: 'glyph' });\n    return 15;\n  }\n  switch (name) {\n    case 'options':\n    case 'menu':\n      disc(hud, x + 5, y + 5, 5.5, 'ink');\n      for (const dy of [3, 5, 7]) hud.rect(x + 3, y + dy, 5, 1, 'white');\n      return 11;\n    case 'pauseIcon':\n      hud.rect(x, y, 11, 11, 'ink');\n      hud.rect(x + 3, y + 2, 2, 7, 'white');\n      hud.rect(x + 6, y + 2, 2, 7, 'white');\n      return 11;\n    case 'stickL':\n      disc(hud, x + 5, y + 5, 5.5, 'ink');\n      disc(hud, x + 5, y + 5, 3, 'mist');\n      hud.rect(x + 4, y + 4, 3, 3, 'white');\n      return 11;\n    case 'dpad':\n      hud.rect(x + 3, y, 5, 11, 'ink');\n      hud.rect(x, y + 3, 11, 5, 'ink');\n      hud.rect(x + 4, y + 1, 3, 9, 'white');\n      hud.rect(x + 1, y + 4, 9, 3, 'white');\n      return 11;\n    case 'mouse': return drawMouse(hud, x, y, false, false);\n    case 'mouseL': return drawMouse(hud, x, y, true, false);\n    case 'mouseR': return drawMouse(hud, x, y, false, true);\n    case 'wheel': return drawMouse(hud, x, y, false, false, true);\n    default: {\n      const w = name.length * 6 + 5;\n      hud.rect(x, y, w, 11, 'ink');\n      hud.rect(x + 1, y + 1, w - 2, 9, 'white');\n      hud.rect(x + 1, y + 9, w - 2, 1, 'mist');\n      say(hud, x + 3, y + 2, name.toUpperCase(), { color: 'ink', shadow: false, name: 'glyph' });\n      return w;\n    }\n  }\n}\nEOF\ncat > src/ui/prompts.js <<'EOF'\n// Prompts read [glyph] verb and follow the last device used.\nimport { PROMPTS } from '../core/actions.js';\nimport { drawGlyph, glyphWidth } from '../art/glyphs.js';\nimport { layout } from './layout.js';\nimport { say, textWidth } from './font.js';\n\nexport function promptGlyphs(action, column) {\n  const entry = PROMPTS[action];\n  if (!entry) return [];\n  const g = entry[column];\n  if (g === null || g === undefined) return [];\n  return Array.isArray(g) ? g : [g];\n}\n\nfunction promptWidth(glyphs, verb) {\n  let w = 0;\n  for (const g of glyphs) w += glyphWidth(g) + 1;\n  return w + 3 + textWidth(verb);\n}\n\n/** Draw one prompt. Returns the x after it. */\nexport function drawPrompt(hud, device, x, y, action, verb) {\n  const column = device.promptColumn();\n  const glyphs = promptGlyphs(action, column);\n  if (!glyphs.length) return x;\n  layout.prompts.push(`${column}:${glyphs.join('+')}:${verb}`);\n  layout.rec('prompt', x, y, promptWidth(glyphs, verb), 11);\n  for (const g of glyphs) x += drawGlyph(hud, x, y, g) + 1;\n  x += 3;\n  return say(hud, x, y + 2, verb, { color: 'white', name: 'prompt-text' });\n}\n\n/** A row of prompts along the bottom of the screen, centred, in a soft strip. */\nexport function promptBar(hud, device, list, { y = null, align = 'center', strip = true } = {}) {\n  const column = device.promptColumn();\n  const items = list.filter(([action]) => promptGlyphs(action, column).length);\n  if (!items.length) return;\n  const gap = 12;\n  let total = 0;\n  for (const [action, verb] of items) total += promptWidth(promptGlyphs(action, column), verb) + gap;\n  total -= gap;\n  const Y = y ?? hud.height - 11 - 6;\n  let x = align === 'left' ? 12 : Math.round((hud.width - total) / 2);\n  if (strip) hud.rect(Math.max(0, x - 5), Y - 3, Math.min(hud.width, total + 10), 17, 'navy');\n  for (const [action, verb] of items) x = drawPrompt(hud, device, x, Y, action, verb) + gap;\n}\nEOF\ncat > src/ui/stack.js <<'EOF'\n// Overlays: pause, menus, dialogue, dev tools. Whatever is on top takes input first.\nexport class ScreenStack {\n  screens = [];\n\n  get top() { return this.screens[this.screens.length - 1] ?? null; }\n  get open() { return this.screens.length > 0; }\n  names() { return this.screens.map((s) => s.name ?? s.constructor.name); }\n\n  push(screen) {\n    this.screens.push(screen);\n    screen.onOpen?.();\n    return screen;\n  }\n\n  pop(screen = null) {\n    const s = screen ?? this.top;\n    const i = this.screens.indexOf(s);\n    if (i < 0) return null;\n    this.screens.splice(i, 1);\n    s.onClose?.();\n    return s;\n  }\n\n  clear() {\n    for (const s of [...this.screens].reverse()) { s.onClose?.(); }\n    this.screens.length = 0;\n  }\n\n  /** Only the screen on top reads input; a screen pushed this frame starts next frame. */\n  update(ctx, dt) {\n    const top = this.top;\n    if (top) top.update?.(ctx, dt);\n    for (const s of this.screens) if (s !== top) s.tick?.(ctx, dt);\n  }\n\n  draw(ctx, dt) {\n    const screens = [...this.screens];\n    let first = 0;\n    for (let i = screens.length - 1; i >= 0; i--) if (screens[i].opaque) { first = i; break; }\n    for (let i = first; i < screens.length; i++) screens[i].draw?.(ctx, dt);\n  }\n}\nEOF\ncat > src/ui/menu.js <<'EOF'\n// The one menu. D-pad, stick (with repeat), arrows, WASD, hover, click, wheel, slider drag.\nimport { App } from '../app.js';\nimport { BACK, CONFIRM, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP, TAB_LEFT, TAB_RIGHT } from '../core/actions.js';\nimport { layout } from './layout.js';\nimport { say, sayCentered, sayRight, textWidth } from './font.js';\nimport { bar, panel, SAFE } from './widgets.js';\n\nconst REPEAT_FIRST = 0.34;\nconst REPEAT_NEXT = 0.11;\n\nexport class NavRepeat {\n  dir = 0; timer = 0;\n  /** dirNow -1/0/1: returns a step when it should fire. */\n  step(dirNow, dt) {\n    if (dirNow === 0) { this.dir = 0; this.timer = 0; return 0; }\n    if (dirNow !== this.dir) { this.dir = dirNow; this.timer = REPEAT_FIRST; return dirNow; }\n    this.timer -= dt;\n    if (this.timer <= 0) { this.timer = REPEAT_NEXT; return dirNow; }\n    return 0;\n  }\n}\n\n/** Direction helpers shared by menus, the name grid and the Locker Room. */\nexport function navY(input) {\n  const stick = input.padAxis.y;\n  if (input.anyDown(MENU_UP) || stick > 0.5) return -1;\n  if (input.anyDown(MENU_DOWN) || stick < -0.5) return 1;\n  return 0;\n}\nexport function navX(input) {\n  const stick = input.padAxis.x;\n  if (input.anyDown(MENU_LEFT) || stick < -0.5) return -1;\n  if (input.anyDown(MENU_RIGHT) || stick > 0.5) return 1;\n  return 0;\n}\n\nexport const pressed = (input, codes) => input.wasPressed(...codes);\nconst CONFIRM_NO_E = CONFIRM.filter((c) => c !== 'KeyE');\n\nexport class Menu {\n  focus = 0;\n  top = 0;\n  rects = [];\n  vert = new NavRepeat();\n  horz = new NavRepeat();\n\n  /**\n   * items: { label, action, disabled, value() , adjust(dir), slider: {get, set, min, max}, right(), locked, id }\n   * opts: { y, width, scale, rowH, maxRows, onBack, align, panel, tabbed }\n   */\n  constructor(items, opts = {}) {\n    this.items = items;\n    this.o = { scale: 2, maxRows: 8, panel: true, align: 'left', ...opts };\n    this.focus = this.firstEnabled();\n  }\n\n  firstEnabled() {\n    const i = this.items.findIndex((it) => !it.disabled);\n    return i < 0 ? 0 : i;\n  }\n\n  setItems(items) {\n    this.items = items;\n    this.focus = Math.min(this.focus, Math.max(0, items.length - 1));\n    this.keepInView();\n  }\n\n  label(item) { return typeof item.label === 'function' ? item.label() : item.label; }\n\n  get rowH() { return this.o.rowH ?? (this.o.scale >= 2 ? 22 : 14); }\n\n  move(dir) {\n    const n = this.items.length;\n    if (!n) return;\n    let i = this.focus;\n    for (let k = 0; k < n; k++) {\n      i = (i + dir + n) % n;\n      if (!this.items[i].disabled || this.items[i].focusable) break;\n    }\n    if (i !== this.focus) { this.focus = i; App.sfx('menuMove'); }\n    this.keepInView();\n  }\n\n  keepInView() {\n    const max = this.visibleRows();\n    if (this.focus < this.top) this.top = this.focus;\n    if (this.focus >= this.top + max) this.top = this.focus - max + 1;\n    this.top = Math.max(0, Math.min(this.top, Math.max(0, this.items.length - max)));\n  }\n\n  visibleRows() {\n    const hud = App.ctx?.hud;\n    const h = hud ? hud.height : 270;\n    const avail = h - (this.o.y ?? 56) - 34;\n    return Math.max(1, Math.min(this.o.maxRows, Math.floor(avail / this.rowH)));\n  }\n\n  activate(item) {\n    if (!item || item.disabled) { App.sfx('menuBack'); return; }\n    App.sfx(item.sound ?? 'menuConfirm');\n    item.action?.();\n  }\n\n  update(ctx, dt) {\n    const { input } = ctx;\n    const uiDt = dt || 1 / 60;\n    const dy = this.vert.step(navY(input), uiDt);\n    if (dy) this.move(dy);\n    const dx = this.horz.step(navX(input), uiDt);\n    const item = this.items[this.focus];\n    if (dx && item) {\n      if (item.adjust) { item.adjust(dx); App.sfx('menuMove'); } else if (this.o.onLeftRight) this.o.onLeftRight(dx);\n    }\n    if (pressed(input, this.o.tabbed ? CONFIRM_NO_E : CONFIRM)) this.activate(item);\n    if (pressed(input, BACK) || input.wasPressed('MouseRight')) { if (this.o.onBack) { App.sfx('menuBack'); this.o.onBack(); return; } }\n\n    // mouse\n    const dev = App.device;\n    const p = dev.pointerArt(ctx);\n    const inside = (r) => p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;\n    if (dev.moved > 0) {\n      for (const r of this.rects) if (inside(r) && !this.items[r.i].disabled && this.focus !== r.i) { this.focus = r.i; App.sfx('menuMove', { volume: 0.5 }); }\n    }\n    if (input.wheel) {\n      this.top = Math.max(0, Math.min(this.top + Math.sign(input.wheel), Math.max(0, this.items.length - this.visibleRows())));\n      if (this.focus < this.top) this.focus = this.top;\n      if (this.focus >= this.top + this.visibleRows()) this.focus = this.top + this.visibleRows() - 1;\n    }\n    if (input.wasPressed('MouseLeft')) {\n      for (const r of this.rects) if (inside(r)) { this.focus = r.i; if (!this.items[r.i].slider) this.activate(this.items[r.i]); break; }\n    }\n    if (input.isDown('MouseLeft')) {\n      for (const r of this.rects) {\n        const it = this.items[r.i];\n        if (it.slider && r.sx !== undefined && inside(r)) {\n          const f = Math.max(0, Math.min(1, (p.x - r.sx) / r.sw));\n          it.slider.set(it.slider.min + f * (it.slider.max - it.slider.min));\n        }\n      }\n    }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    const scale = this.o.scale;\n    const rowH = this.rowH;\n    const rows = this.visibleRows();\n    const width = Math.min(this.o.width ?? 300, hud.width - SAFE * 2);\n    const x = Math.round((hud.width - width) / 2);\n    const y = this.o.y ?? 56;\n    const shown = this.items.slice(this.top, this.top + rows);\n    const totalH = shown.length * rowH;\n    if (this.o.panel) panel(hud, x - 4, y - 4, width + 8, totalH + 6, { fill: 'night', border: 'ink', name: 'menu-panel' });\n    this.rects = [];\n    shown.forEach((item, k) => {\n      const i = this.top + k;\n      const ry = y + k * rowH;\n      const focused = i === this.focus;\n      const r = { i, x, y: ry, w: width, h: rowH - 2 };\n      if (focused) hud.rect(x - 1, ry - 1, width + 2, rowH - 1, 'cyan');\n      const color = item.disabled ? 'slate' : focused ? 'ink' : 'white';\n      const shadow = focused ? false : 'ink';\n      const ty = ry + Math.round((rowH - 2 - 9 * scale) / 2) + 1;\n      let label = String(this.label(item));\n      const right = item.value ? String(item.value()) : item.right ? String(item.right()) : '';\n      const sliderW = item.slider ? Math.min(70, Math.round(width * 0.28)) : 0;\n      const room = width - 8 - (right ? textWidth(right, scale) + 8 : 0) - (sliderW ? sliderW + 6 : 0);\n      const maxChars = Math.max(1, Math.floor(room / (6 * scale)));\n      if (label.length > maxChars) label = `${label.slice(0, Math.max(1, maxChars - 1))}.`;\n      if (this.o.align === 'center' && !right) sayCentered(hud, x + width / 2, ty, label, { scale, color, shadow, name: 'menu-row' });\n      else say(hud, x + 4, ty, label, { scale, color, shadow, name: 'menu-row' });\n      if (right) sayRight(hud, x + width - 4, ty, right, { scale, color: focused ? 'ink' : (item.disabled ? 'slate' : 'sand'), shadow, name: 'menu-value' });\n      if (item.slider) {\n        const sx = x + width - 8 - (right ? textWidth(right, scale) + 6 : 0) - sliderW;\n        const f = (item.slider.get() - item.slider.min) / (item.slider.max - item.slider.min);\n        bar(hud, sx, ry + Math.round(rowH / 2) - 4, sliderW, 7, f, focused ? 'navy' : 'cyan', focused ? 'white' : 'ink', 'slider');\n        r.sx = sx; r.sw = sliderW;\n      }\n      if (item.star !== undefined) item.star(hud, x + width - 44, ry + 2);\n      this.rects.push(r);\n    });\n    if (this.top > 0) sayCentered(hud, x + width / 2, y - 12, '^', { color: 'sand', name: 'menu-more' });\n    if (this.top + rows < this.items.length) sayCentered(hud, x + width / 2, y + totalH + 3, 'v', { color: 'sand', name: 'menu-more' });\n    layout.rec('menu', x - 4, y - 4, width + 8, totalH + 6);\n  }\n}\n\nexport { TAB_LEFT, TAB_RIGHT };\nEOF\necho written","description":"Write the UI kit: font, layout, widgets, glyphs, prompts, stack and menu","timeout":30000},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1395,"cache_read_input_tokens":191394,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1395},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d2ae2eb7-ae7f-44a8-ac16-77fd998e0107","uuid":"4597029c-3e0e-4c58-bf6c-7e6bdbc11970","timestamp":"2026-11-05T06:18:33.316Z","request_id":"req_011CgjHu3Ky5NzNW7KLnn8At","wire_tool_inputs":{"toolu_01FUx4Mt7vSQCnGsyWX6oAwR":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build-v2__20261104-230741__x6981e3/work/WeFitIn-WiiFit-claude-opus-5-5-xhigh-20261104-230741\ncat > src/ui/font.js <<'EOF'\n// Mixed-case text: lowercase through hud.sprite, everything else through hud.text, on a 6 px grid.\n// Rows top to bottom, 5 bits, bit 4 = left. Rows 7-8 are descenders.\nimport { layout } from './layout.js';\n\nconst H = {\n  a: '00 00 0e 01 0f 11 0f 00 00', b: '10 10 1e 11 11 11 1e 00 00', c: '00 00 0e 11 10 11 0e 00 00', d: '01 01 0f 11 11 11 0f 00 00',\n  e: '00 00 0e 11 1f 10 0e 00 00', f: '06 09 08 1c 08 08 08 00 00', g: '00 00 0f 11 11 11 0f 01 0e', h: '10 10 1e 11 11 11 11 00 00',\n  i: '04 00 0c 04 04 04 0e 00 00', j: '02 00 06 02 02 02 02 12 0c', k: '10 10 12 14 18 14 12 00 00', l: '0c 04 04 04 04 04 0e 00 00',\n  m: '00 00 1a 15 15 15 15 00 00', n: '00 00 1e 11 11 11 11 00 00', o: '00 00 0e 11 11 11 0e 00 00', p: '00 00 1e 11 11 11 1e 10 10',\n  q: '00 00 0f 11 11 11 0f 01 01', r: '00 00 16 19 10 10 10 00 00', s: '00 00 0f 10 0e 01 1e 00 00', t: '08 08 1c 08 08 09 06 00 00',\n  u: '00 00 11 11 11 13 0d 00 00', v: '00 00 11 11 11 0a 04 00 00', w: '00 00 11 11 15 15 0a 00 00', x: '00 00 11 0a 04 0a 11 00 00',\n  y: '00 00 11 11 11 11 0f 01 0e', z: '00 00 1f 02 04 08 1f 00 00',\n};\nexport const GLYPHS = Object.fromEntries(Object.entries(H).map(([k, v]) => [k, v.split(' ').map((h) => parseInt(h, 16).toString(2).padStart(5, '0').replace(/0/g, '.').replace(/1/g, 'o'))]));\n\n/** Everything the engine's 5x7 font can draw, besides the lowercase above. */\nexport const ENGINE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .,:-+=/()[]%_!?<>#\\'\"*@{};&|\\\\~^$`';\nconst KNOWN = new Set([...ENGINE_CHARS, ...Object.keys(GLYPHS)]);\n\n/** Hub names can hold anything: every character the font lacks becomes '?'. */\nexport function sanitize(text) {\n  return String(text)\n    .replace(/[\\u2018\\u2019]/g, \"'\").replace(/[\\u201c\\u201d]/g, '\"').replace(/\\u2026/g, '...').replace(/[\\u2013\\u2014]/g, '-')\n    .replace(/[^\\n]/g, (c) => (KNOWN.has(c) ? c : '?'));\n}\n\nexport function hasGlyph(ch) { return KNOWN.has(ch); }\n\nexport const textWidth = (text, scale = 1) => (String(text).length ? String(text).length * 6 - 1 : 0) * scale;\n\n/** Draw text at art-pixel (x, y). Returns the x after the last character. */\nexport function say(hud, x, y, text, { color = 'white', shadow = 'ink', scale = 1, name = 'text' } = {}) {\n  const s = sanitize(text);\n  layout.rec(name, x, y, textWidth(s, scale), 9 * scale, s);\n  for (const ch of s) {\n    const g = GLYPHS[ch];\n    if (g) hud.sprite(x, y, g, { o: color }, { scale, shadow });\n    else if (ch !== ' ') hud.text(x, y, ch, { color, shadow, scale });\n    x += 6 * scale;\n  }\n  return x;\n}\n\nexport function sayCentered(hud, cx, y, text, opts = {}) {\n  const w = textWidth(sanitize(text), opts.scale ?? 1);\n  return say(hud, Math.round(cx - w / 2), y, text, opts);\n}\n\nexport function sayRight(hud, rx, y, text, opts = {}) {\n  const w = textWidth(sanitize(text), opts.scale ?? 1);\n  return say(hud, Math.round(rx - w), y, text, opts);\n}\n\n/** Word wrap by characters per line. */\nexport function wrap(text, maxChars) {\n  const out = [];\n  for (const para of sanitize(text).split('\\n')) {\n    let line = '';\n    for (const word of para.split(' ')) {\n      if (word.length > maxChars) {\n        if (line) { out.push(line); line = ''; }\n        let w = word;\n        while (w.length > maxChars) { out.push(w.slice(0, maxChars)); w = w.slice(maxChars); }\n        line = w;\n        continue;\n      }\n      const next = line ? `${line} ${word}` : word;\n      if (next.length > maxChars) { out.push(line); line = word; } else line = next;\n    }\n    out.push(line);\n  }\n  return out;\n}\n\n/** Chars that fit in a width of art pixels at a scale. */\nexport const charsIn = (width, scale = 1) => Math.max(1, Math.floor((width + scale) / (6 * scale)));\nEOF\ncat > src/ui/layout.js <<'EOF'\n// Every widget records its rect each frame, so a script can check nothing overflows.\nexport const layout = {\n  rects: [],\n  prompts: [],\n  record: false,\n  begin() { this.rects.length = 0; this.prompts.length = 0; },\n  rec(name, x, y, w, h, text = '') { if (this.record) this.rects.push({ name, x, y, w, h, text }); },\n  overflow(width, height) {\n    return this.rects.filter((r) => r.x < 0 || r.y < 0 || r.x + r.w > width || r.y + r.h > height);\n  },\n};\nEOF\ncat > src/ui/widgets.js <<'EOF'\n// Shapes for the pixel HUD. Lines are at least 2 art px thick: a 1 px ring vanishes at 10 feet.\nimport { layout } from './layout.js';\nimport { say, sayCentered, textWidth } from './font.js';\n\nexport const SAFE = 12;\n\nexport function panel(hud, x, y, w, h, { fill = 'white', border = 'ink', name = 'panel', thick = 1 } = {}) {\n  layout.rec(name, x, y, w, h);\n  hud.rect(x + 1, y - thick, w - 2, thick, border);\n  hud.rect(x + 1, y + h, w - 2, thick, border);\n  hud.rect(x - thick, y + 1, thick, h - 2, border);\n  hud.rect(x + w, y + 1, thick, h - 2, border);\n  hud.rect(x, y, w, h, fill);\n}\n\nexport function bar(hud, x, y, w, h, frac, color = 'cyan', back = 'ink', name = 'bar') {\n  layout.rec(name, x, y, w, h);\n  hud.rect(x, y, w, h, back);\n  const f = Math.max(0, Math.min(1, frac));\n  if (f > 0) hud.rect(x + 1, y + 1, Math.max(1, Math.round((w - 2) * f)), Math.max(1, h - 2), color);\n}\n\n/** A filled disc, drawn as scanlines. */\nexport function disc(hud, cx, cy, r, color) {\n  const ir = Math.ceil(r);\n  for (let dy = -ir; dy <= ir; dy++) {\n    const half = Math.sqrt(Math.max(0, r * r - dy * dy));\n    if (half <= 0 && Math.abs(dy) >= r) continue;\n    const hw = Math.round(half);\n    hud.rect(Math.round(cx) - hw, Math.round(cy) + dy, hw * 2 + 1, 1, color);\n  }\n}\n\n/** A ring, drawn as scanlines between two radii. */\nexport function ring(hud, cx, cy, r, thick, color) {\n  const outer = r + thick / 2, inner = Math.max(0, r - thick / 2);\n  const ir = Math.ceil(outer);\n  const X = Math.round(cx), Y = Math.round(cy);\n  for (let dy = -ir; dy <= ir; dy++) {\n    const a = outer * outer - dy * dy;\n    if (a < 0) continue;\n    const ho = Math.round(Math.sqrt(a));\n    const b = inner * inner - dy * dy;\n    if (b <= 0) { hud.rect(X - ho, Y + dy, ho * 2 + 1, 1, color); continue; }\n    const hi = Math.round(Math.sqrt(b));\n    const w = Math.max(1, ho - hi);\n    hud.rect(X - ho, Y + dy, w, 1, color);\n    hud.rect(X + hi + (ho - hi - w) + 1, Y + dy, w, 1, color);\n  }\n}\n\nexport function line(hud, x0, y0, x1, y1, color, thick = 2) {\n  const d = Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0), 1);\n  const off = Math.floor(thick / 2);\n  for (let i = 0; i <= d; i++) {\n    const t = i / d;\n    hud.rect(Math.round(x0 + (x1 - x0) * t) - off, Math.round(y0 + (y1 - y0) * t) - off, thick, thick, color);\n  }\n}\n\nconst STAR_ROWS = [\n  '.....o.....',\n  '....ooo....',\n  '....ooo....',\n  'ooooooooooo',\n  '.ooooooooo.',\n  '..ooooooo..',\n  '...ooooo...',\n  '..ooo.ooo..',\n  '..oo...oo..',\n];\nexport const STAR_W = 11;\n\nexport function star(hud, x, y, filled = true, scale = 1) {\n  layout.rec('star', x, y, STAR_W * scale, 9 * scale);\n  hud.sprite(x, y, STAR_ROWS, { o: filled ? 'sand' : 'slate' }, { scale, shadow: 'ink' });\n}\n\nexport function starRow(hud, x, y, count, scale = 1, total = 3) {\n  for (let i = 0; i < total; i++) star(hud, x + i * (STAR_W + 2) * scale, y, i < count, scale);\n  return x + total * (STAR_W + 2) * scale;\n}\n\nexport function starRowWidth(scale = 1, total = 3) { return total * (STAR_W + 2) * scale - 2 * scale; }\n\n/** The balance dial: a white face, the ring, the Dot. p coordinates run to 1.2 at the rim. */\nexport function drawDial(hud, { x, y, r = 44, dot = null, ringR = 0.3, ringX = 0, ringY = 0, inside = false, brighten = 0, target = null, fade = 1, mouse = null, color = 'red', label = null, hideDot = false }) {\n  const X = Math.round(x), Y = Math.round(y);\n  layout.rec('dial', X - r - 2, Y - r - 2, r * 2 + 4, r * 2 + 4);\n  disc(hud, X, Y, r + 2, 'slate');\n  disc(hud, X, Y, r, 'white');\n  const s = r / 1.2;\n  hud.rect(X - r + 3, Y, r * 2 - 5, 1, 'mist');\n  hud.rect(X, Y - r + 3, 1, r * 2 - 5, 'mist');\n  if (fade > 0) {\n    const rc = inside ? (brighten > 0.6 ? 'lime' : 'green') : 'teal';\n    ring(hud, X + ringX * s, Y - ringY * s, Math.max(3, ringR * s), r > 30 ? 3 : 2, rc);\n  }\n  if (target) {\n    disc(hud, X + target.x * s, Y - target.y * s, r > 30 ? 4 : 3, 'orange');\n    ring(hud, X + target.x * s, Y - target.y * s, (r > 30 ? 6 : 4), 1, 'ink');\n  }\n  if (dot && fade > 0 && !hideDot) {\n    const dr = r > 30 ? 4 : 3;\n    disc(hud, X + dot.x * s, Y - dot.y * s, dr + 1, 'ink');\n    disc(hud, X + dot.x * s, Y - dot.y * s, dr, color);\n  }\n  if (mouse) {\n    line(hud, X, Y, mouse.x, mouse.y, 'mist', 1);\n    hud.rect(mouse.x - 3, mouse.y, 7, 1, 'ink');\n    hud.rect(mouse.x, mouse.y - 3, 1, 7, 'ink');\n  }\n  if (label) sayCentered(hud, X, Y + r + 4, label, { color: 'white', name: 'dial-label' });\n}\n\n/** A heading with a soft backing strip. */\nexport function heading(hud, text, y = SAFE, scale = 2, color = 'white') {\n  const w = textWidth(text, scale);\n  const cx = Math.round(hud.width / 2);\n  hud.rect(cx - Math.round(w / 2) - 6, y - 3, w + 12, 9 * scale + 5, 'navy');\n  sayCentered(hud, cx, y, text, { scale, color, name: 'heading' });\n}\n\nexport function pill(hud, x, y, text, { fill = 'navy', color = 'white', scale = 1, name = 'pill' } = {}) {\n  const w = textWidth(text, scale) + 6 * scale;\n  hud.rect(x, y, w, 9 * scale + 2, fill);\n  say(hud, x + 3 * scale, y + 1, text, { color, scale, name });\n  return w;\n}\n\nexport { say, sayCentered };\nEOF\ncat > src/art/glyphs.js <<'EOF'\n// Button prompts, drawn here: PlayStation shapes, Xbox letters, keycaps, a mouse with the used button lit.\nimport { say } from '../ui/font.js';\nimport { disc } from '../ui/widgets.js';\n\nconst PINK = 0xe58fd0;\nconst SHAPES = {\n  cross: { color: 'sky', rows: ['o...o', '.o.o.', '..o..', '.o.o.', 'o...o'] },\n  circle: { color: 'red', rows: ['.ooo.', 'o...o', 'o...o', 'o...o', '.ooo.'] },\n  square: { color: PINK, rows: ['ooooo', 'o...o', 'o...o', 'o...o', 'ooooo'] },\n  triangle: { color: 'lime', rows: ['..o..', '..o..', '.o.o.', '.o.o.', 'ooooo'] },\n  a: { color: 'lime', rows: ['.ooo.', 'o...o', 'ooooo', 'o...o', 'o...o'] },\n  b: { color: 'red', rows: ['oooo.', 'o...o', 'oooo.', 'o...o', 'oooo.'] },\n  x: { color: 'sky', rows: ['o...o', '.o.o.', '..o..', '.o.o.', 'o...o'] },\n  y: { color: 'sand', rows: ['o...o', '.o.o.', '..o..', '..o..', '..o..'] },\n};\nconst PILLS = { l1: 'L1', r1: 'R1', l2: 'L2', r2: 'R2', lb: 'LB', rb: 'RB', lt: 'LT', rt: 'RT' };\n\nexport const GLYPH_NAMES = [...Object.keys(SHAPES), ...Object.keys(PILLS), 'options', 'menu', 'stickL', 'dpad', 'mouse', 'mouseL', 'mouseR', 'wheel', 'pauseIcon'];\n\nconst MOUSE = ['..ooo..', '.obbbo.', 'oLLoRRo', 'oLLoRRo', 'oLLoRRo', 'ooooooo', 'obbbbbo', 'obbbbbo', 'obbbbbo', '.obbbo.', '..ooo..'];\n\nfunction drawMouse(hud, x, y, left, right, wheel = false) {\n  hud.sprite(x, y, MOUSE, { o: 'ink', b: 'white', L: left ? 'red' : 'white', R: right ? 'red' : 'white' }, { shadow: false });\n  if (wheel) hud.rect(x + 3, y + 1, 1, 4, 'red');\n  return 7;\n}\n\nexport function glyphWidth(name) {\n  if (SHAPES[name]) return 11;\n  if (PILLS[name]) return 15;\n  if (name === 'options' || name === 'menu' || name === 'dpad' || name === 'stickL' || name === 'pauseIcon') return 11;\n  if (name === 'mouse' || name === 'mouseL' || name === 'mouseR' || name === 'wheel') return 7;\n  return name.length * 6 + 5; // a keycap\n}\n\nexport function drawGlyph(hud, x, y, name) {\n  const shape = SHAPES[name];\n  if (shape) {\n    disc(hud, x + 5, y + 5, 5.5, 'ink');\n    hud.sprite(x + 3, y + 3, shape.rows, { o: shape.color }, { shadow: false });\n    return 11;\n  }\n  if (PILLS[name]) {\n    hud.rect(x, y + 1, 15, 9, 'ink');\n    hud.rect(x + 1, y, 13, 11, 'ink');\n    say(hud, x + 2, y + 2, PILLS[name], { color: 'white', shadow: false, name: 'glyph' });\n    return 15;\n  }\n  switch (name) {\n    case 'options':\n    case 'menu':\n      disc(hud, x + 5, y + 5, 5.5, 'ink');\n      for (const dy of [3, 5, 7]) hud.rect(x + 3, y + dy, 5, 1, 'white');\n      return 11;\n    case 'pauseIcon':\n      hud.rect(x, y, 11, 11, 'ink');\n      hud.rect(x + 3, y + 2, 2, 7, 'white');\n      hud.rect(x + 6, y + 2, 2, 7, 'white');\n      return 11;\n    case 'stickL':\n      disc(hud, x + 5, y + 5, 5.5, 'ink');\n      disc(hud, x + 5, y + 5, 3, 'mist');\n      hud.rect(x + 4, y + 4, 3, 3, 'white');\n      return 11;\n    case 'dpad':\n      hud.rect(x + 3, y, 5, 11, 'ink');\n      hud.rect(x, y + 3, 11, 5, 'ink');\n      hud.rect(x + 4, y + 1, 3, 9, 'white');\n      hud.rect(x + 1, y + 4, 9, 3, 'white');\n      return 11;\n    case 'mouse': return drawMouse(hud, x, y, false, false);\n    case 'mouseL': return drawMouse(hud, x, y, true, false);\n    case 'mouseR': return drawMouse(hud, x, y, false, true);\n    case 'wheel': return drawMouse(hud, x, y, false, false, true);\n    default: {\n      const w = name.length * 6 + 5;\n      hud.rect(x, y, w, 11, 'ink');\n      hud.rect(x + 1, y + 1, w - 2, 9, 'white');\n      hud.rect(x + 1, y + 9, w - 2, 1, 'mist');\n      say(hud, x + 3, y + 2, name.toUpperCase(), { color: 'ink', shadow: false, name: 'glyph' });\n      return w;\n    }\n  }\n}\nEOF\ncat > src/ui/prompts.js <<'EOF'\n// Prompts read [glyph] verb and follow the last device used.\nimport { PROMPTS } from '../core/actions.js';\nimport { drawGlyph, glyphWidth } from '../art/glyphs.js';\nimport { layout } from './layout.js';\nimport { say, textWidth } from './font.js';\n\nexport function promptGlyphs(action, column) {\n  const entry = PROMPTS[action];\n  if (!entry) return [];\n  const g = entry[column];\n  if (g === null || g === undefined) return [];\n  return Array.isArray(g) ? g : [g];\n}\n\nfunction promptWidth(glyphs, verb) {\n  let w = 0;\n  for (const g of glyphs) w += glyphWidth(g) + 1;\n  return w + 3 + textWidth(verb);\n}\n\n/** Draw one prompt. Returns the x after it. */\nexport function drawPrompt(hud, device, x, y, action, verb) {\n  const column = device.promptColumn();\n  const glyphs = promptGlyphs(action, column);\n  if (!glyphs.length) return x;\n  layout.prompts.push(`${column}:${glyphs.join('+')}:${verb}`);\n  layout.rec('prompt', x, y, promptWidth(glyphs, verb), 11);\n  for (const g of glyphs) x += drawGlyph(hud, x, y, g) + 1;\n  x += 3;\n  return say(hud, x, y + 2, verb, { color: 'white', name: 'prompt-text' });\n}\n\n/** A row of prompts along the bottom of the screen, centred, in a soft strip. */\nexport function promptBar(hud, device, list, { y = null, align = 'center', strip = true } = {}) {\n  const column = device.promptColumn();\n  const items = list.filter(([action]) => promptGlyphs(action, column).length);\n  if (!items.length) return;\n  const gap = 12;\n  let total = 0;\n  for (const [action, verb] of items) total += promptWidth(promptGlyphs(action, column), verb) + gap;\n  total -= gap;\n  const Y = y ?? hud.height - 11 - 6;\n  let x = align === 'left' ? 12 : Math.round((hud.width - total) / 2);\n  if (strip) hud.rect(Math.max(0, x - 5), Y - 3, Math.min(hud.width, total + 10), 17, 'navy');\n  for (const [action, verb] of items) x = drawPrompt(hud, device, x, Y, action, verb) + gap;\n}\nEOF\ncat > src/ui/stack.js <<'EOF'\n// Overlays: pause, menus, dialogue, dev tools. Whatever is on top takes input first.\nexport class ScreenStack {\n  screens = [];\n\n  get top() { return this.screens[this.screens.length - 1] ?? null; }\n  get open() { return this.screens.length > 0; }\n  names() { return this.screens.map((s) => s.name ?? s.constructor.name); }\n\n  push(screen) {\n    this.screens.push(screen);\n    screen.onOpen?.();\n    return screen;\n  }\n\n  pop(screen = null) {\n    const s = screen ?? this.top;\n    const i = this.screens.indexOf(s);\n    if (i < 0) return null;\n    this.screens.splice(i, 1);\n    s.onClose?.();\n    return s;\n  }\n\n  clear() {\n    for (const s of [...this.screens].reverse()) { s.onClose?.(); }\n    this.screens.length = 0;\n  }\n\n  /** Only the screen on top reads input; a screen pushed this frame starts next frame. */\n  update(ctx, dt) {\n    const top = this.top;\n    if (top) top.update?.(ctx, dt);\n    for (const s of this.screens) if (s !== top) s.tick?.(ctx, dt);\n  }\n\n  draw(ctx, dt) {\n    const screens = [...this.screens];\n    let first = 0;\n    for (let i = screens.length - 1; i >= 0; i--) if (screens[i].opaque) { first = i; break; }\n    for (let i = first; i < screens.length; i++) screens[i].draw?.(ctx, dt);\n  }\n}\nEOF\ncat > src/ui/menu.js <<'EOF'\n// The one menu. D-pad, stick (with repeat), arrows, WASD, hover, click, wheel, slider drag.\nimport { App } from '../app.js';\nimport { BACK, CONFIRM, MENU_DOWN, MENU_LEFT, MENU_RIGHT, MENU_UP, TAB_LEFT, TAB_RIGHT } from '../core/actions.js';\nimport { layout } from './layout.js';\nimport { say, sayCentered, sayRight, textWidth } from './font.js';\nimport { bar, panel, SAFE } from './widgets.js';\n\nconst REPEAT_FIRST = 0.34;\nconst REPEAT_NEXT = 0.11;\n\nexport class NavRepeat {\n  dir = 0; timer = 0;\n  /** dirNow -1/0/1: returns a step when it should fire. */\n  step(dirNow, dt) {\n    if (dirNow === 0) { this.dir = 0; this.timer = 0; return 0; }\n    if (dirNow !== this.dir) { this.dir = dirNow; this.timer = REPEAT_FIRST; return dirNow; }\n    this.timer -= dt;\n    if (this.timer <= 0) { this.timer = REPEAT_NEXT; return dirNow; }\n    return 0;\n  }\n}\n\n/** Direction helpers shared by menus, the name grid and the Locker Room. */\nexport function navY(input) {\n  const stick = input.padAxis.y;\n  if (input.anyDown(MENU_UP) || stick > 0.5) return -1;\n  if (input.anyDown(MENU_DOWN) || stick < -0.5) return 1;\n  return 0;\n}\nexport function navX(input) {\n  const stick = input.padAxis.x;\n  if (input.anyDown(MENU_LEFT) || stick < -0.5) return -1;\n  if (input.anyDown(MENU_RIGHT) || stick > 0.5) return 1;\n  return 0;\n}\n\nexport const pressed = (input, codes) => input.wasPressed(...codes);\nconst CONFIRM_NO_E = CONFIRM.filter((c) => c !== 'KeyE');\n\nexport class Menu {\n  focus = 0;\n  top = 0;\n  rects = [];\n  vert = new NavRepeat();\n  horz = new NavRepeat();\n\n  /**\n   * items: { label, action, disabled, value() , adjust(dir), slider: {get, set, min, max}, right(), locked, id }\n   * opts: { y, width, scale, rowH, maxRows, onBack, align, panel, tabbed }\n   */\n  constructor(items, opts = {}) {\n    this.items = items;\n    this.o = { scale: 2, maxRows: 8, panel: true, align: 'left', ...opts };\n    this.focus = this.firstEnabled();\n  }\n\n  firstEnabled() {\n    const i = this.items.findIndex((it) => !it.disabled);\n    return i < 0 ? 0 : i;\n  }\n\n  setItems(items) {\n    this.items = items;\n    this.focus = Math.min(this.focus, Math.max(0, items.length - 1));\n    this.keepInView();\n  }\n\n  label(item) { return typeof item.label === 'function' ? item.label() : item.label; }\n\n  get rowH() { return this.o.rowH ?? (this.o.scale >= 2 ? 22 : 14); }\n\n  move(dir) {\n    const n = this.items.length;\n    if (!n) return;\n    let i = this.focus;\n    for (let k = 0; k < n; k++) {\n      i = (i + dir + n) % n;\n      if (!this.items[i].disabled || this.items[i].focusable) break;\n    }\n    if (i !== this.focus) { this.focus = i; App.sfx('menuMove'); }\n    this.keepInView();\n  }\n\n  keepInView() {\n    const max = this.visibleRows();\n    if (this.focus < this.top) this.top = this.focus;\n    if (this.focus >= this.top + max) this.top = this.focus - max + 1;\n    this.top = Math.max(0, Math.min(this.top, Math.max(0, this.items.length - max)));\n  }\n\n  visibleRows() {\n    const hud = App.ctx?.hud;\n    const h = hud ? hud.height : 270;\n    const avail = h - (this.o.y ?? 56) - 34;\n    return Math.max(1, Math.min(this.o.maxRows, Math.floor(avail / this.rowH)));\n  }\n\n  activate(item) {\n    if (!item || item.disabled) { App.sfx('menuBack'); return; }\n    App.sfx(item.sound ?? 'menuConfirm');\n    item.action?.();\n  }\n\n  update(ctx, dt) {\n    const { input } = ctx;\n    const uiDt = dt || 1 / 60;\n    const dy = this.vert.step(navY(input), uiDt);\n    if (dy) this.move(dy);\n    const dx = this.horz.step(navX(input), uiDt);\n    const item = this.items[this.focus];\n    if (dx && item) {\n      if (item.adjust) { item.adjust(dx); App.sfx('menuMove'); } else if (this.o.onLeftRight) this.o.onLeftRight(dx);\n    }\n    if (pressed(input, this.o.tabbed ? CONFIRM_NO_E : CONFIRM)) this.activate(item);\n    if (pressed(input, BACK) || input.wasPressed('MouseRight')) { if (this.o.onBack) { App.sfx('menuBack'); this.o.onBack(); return; } }\n\n    // mouse\n    const dev = App.device;\n    const p = dev.pointerArt(ctx);\n    const inside = (r) => p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;\n    if (dev.moved > 0) {\n      for (const r of this.rects) if (inside(r) && !this.items[r.i].disabled && this.focus !== r.i) { this.focus = r.i; App.sfx('menuMove', { volume: 0.5 }); }\n    }\n    if (input.wheel) {\n      this.top = Math.max(0, Math.min(this.top + Math.sign(input.wheel), Math.max(0, this.items.length - this.visibleRows())));\n      if (this.focus < this.top) this.focus = this.top;\n      if (this.focus >= this.top + this.visibleRows()) this.focus = this.top + this.visibleRows() - 1;\n    }\n    if (input.wasPressed('MouseLeft')) {\n      for (const r of this.rects) if (inside(r)) { this.focus = r.i; if (!this.items[r.i].slider) this.activate(this.items[r.i]); break; }\n    }\n    if (input.isDown('MouseLeft')) {\n      for (const r of this.rects) {\n        const it = this.items[r.i];\n        if (it.slider && r.sx !== undefined && inside(r)) {\n          const f = Math.max(0, Math.min(1, (p.x - r.sx) / r.sw));\n          it.slider.set(it.slider.min + f * (it.slider.max - it.slider.min));\n        }\n      }\n    }\n  }\n\n  draw(ctx) {\n    const { hud } = ctx;\n    const scale = this.o.scale;\n    const rowH = this.rowH;\n    const rows = this.visibleRows();\n    const width = Math.min(this.o.width ?? 300, hud.width - SAFE * 2);\n    const x = Math.round((hud.width - width) / 2);\n    const y = this.o.y ?? 56;\n    const shown = this.items.slice(this.top, this.top + rows);\n    const totalH = shown.length * rowH;\n    if (this.o.panel) panel(hud, x - 4, y - 4, width + 8, totalH + 6, { fill: 'night', border: 'ink', name: 'menu-panel' });\n    this.rects = [];\n    shown.forEach((item, k) => {\n      const i = this.top + k;\n      const ry = y + k * rowH;\n      const focused = i === this.focus;\n      const r = { i, x, y: ry, w: width, h: rowH - 2 };\n      if (focused) hud.rect(x - 1, ry - 1, width + 2, rowH - 1, 'cyan');\n      const color = item.disabled ? 'slate' : focused ? 'ink' : 'white';\n      const shadow = focused ? false : 'ink';\n      const ty = ry + Math.round((rowH - 2 - 9 * scale) / 2) + 1;\n      let label = String(this.label(item));\n      const right = item.value ? String(item.value()) : item.right ? String(item.right()) : '';\n      const sliderW = item.slider ? Math.min(70, Math.round(width * 0.28)) : 0;\n      const room = width - 8 - (right ? textWidth(right, scale) + 8 : 0) - (sliderW ? sliderW + 6 : 0);\n      const maxChars = Math.max(1, Math.floor(room / (6 * scale)));\n      if (label.length > maxChars) label = `${label.slice(0, Math.max(1, maxChars - 1))}.`;\n      if (this.o.align === 'center' && !right) sayCentered(hud, x + width / 2, ty, label, { scale, color, shadow, name: 'menu-row' });\n      else say(hud, x + 4, ty, label, { scale, color, shadow, name: 'menu-row' });\n      if (right) sayRight(hud, x + width - 4, ty, right, { scale, color: focused ? 'ink' : (item.disabled ? 'slate' : 'sand'), shadow, name: 'menu-value' });\n      if (item.slider) {\n        const sx = x + width - 8 - (right ? textWidth(right, scale) + 6 : 0) - sliderW;\n        const f = (item.slider.get() - item.slider.min) / (item.slider.max - item.slider.min);\n        bar(hud, sx, ry + Math.round(rowH / 2) - 4, sliderW, 7, f, focused ? 'navy' : 'cyan', focused ? 'white' : 'ink', 'slider');\n        r.sx = sx; r.sw = sliderW;\n      }\n      if (item.star !== undefined) item.star(hud, x + width - 44, ry + 2);\n      this.rects.push(r);\n    });\n    if (this.top > 0) sayCentered(hud, x + width / 2, y - 12, '^', { color: 'sand', name: 'menu-more' });\n    if (this.top + rows < this.items.length) sayCentered(hud, x + width / 2, y + totalH + 3, 'v', { color: 'sand', name: 'menu-more' });\n    layout.rec('menu', x - 4, y - 4, width + 8, totalH + 6);\n  }\n}\n\nexport { TAB_LEFT, TAB_RIGHT };\nEOF\necho written","description":"Write the UI kit: font, layout, widgets, glyphs, prompts, stack and menu","timeout":30000}}}
