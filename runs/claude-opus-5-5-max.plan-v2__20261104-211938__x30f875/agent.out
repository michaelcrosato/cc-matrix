json'))\nitems=d if isinstance(d,list) else d.get('clips',d)\nnames=[(c.get('name') if isinstance(c,dict) else c) for c in (items if isinstance(items,list) else items.keys())]\nprint(len(names)); print(', '.join(names[:90]))\n\"; ls -la src/mocap/sets 2>/dev/null | head; ls -la tools/anim-set.mjs; ls src/assets/sets | head -40; ls src/assets/sets | wc -l; cd dist/handoff && node tools/asset-find.mjs \"gothic cathedral\" 2>/dev/null | head -14; node tools/asset-find.mjs \"coffin grave tomb\" 2>/dev/null | head -14","description":"Survey mocap clips and asset store for gothic props"}}}
