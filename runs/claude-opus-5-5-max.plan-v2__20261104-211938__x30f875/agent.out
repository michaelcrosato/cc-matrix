s:3: * A BOSS is def('bosses', id, { name, title, arch (archetype for the body),\nsrc/emberdeep/35-bosses-core.js:182:  def('bosses', id, { name: o.body ? bossName(R) : q.name, title, arch, el\nsrc/emberdeep/33-beasts.js:1087:def('bosses', 'broodmother', { name: 'The Brood Mother', title: 'Queen of the \nsrc/emberdeep/33-beasts.js:1212:def('bosses', 'wyrm', { name: 'The Deep Wyrm', title: 'That Which Bores Below'\nsrc/emberdeep/36-bosses.js:1195:def('bosses', 'cinderking', { name: 'The Cinder King', title: 'Sovereign of As\n--- layouts/themes\nsrc/emberdeep/52-layouts.js:70:def('layouts', 'islands', { name: 'Islands', gen(R, o) {\nsrc/emberdeep/52-layouts.js:124:def('layouts', 'caves', { name: 'Caves', gen(R, o) {\nsrc/emberdeep/52-layouts.js:192:def('layouts', 'arena', { name: 'Arena', bossOnly: true, gen(R, o) {\nsrc/emberdeep/52-layouts.js:220:def('layouts', 'ring', { name: 'Ring', gen(R, o) {\nsrc/emberdeep/50-levels-core.js:3: * A LAYOUT is def('layouts', id, { name, gen(R, o) -> { w, h, cells, tags, \nsrc/emberdeep/50-levels-core.js:5: * A THEME is def('themes', id, { name, nouns: ['Vaults'], pal, floor(L, x, \nsrc/emberdeep/50-levels-core.js:183:def('layouts', 'halls', { name: 'Halls', gen(R, o) {\nsrc/emberdeep/50-levels-core.js:225:def('themes', 'crypt', { name: 'Crypt', nouns: ['Vaults', 'Crypts', 'Halls\nsrc/emberdeep/51-themes.js:1167:def('themes', 'ruins', { name: 'Ruins', nouns: ['Ruins', 'Colonnades', 'Fallen\nsrc/emberdeep/51-themes.js:1202:def('themes', 'forge', { name: 'Forge', nouns: ['Forge', 'Foundry', 'Smelterie\nsrc/emberdeep/51-themes.js:1233:def('themes', 'frost', { name: 'Frost', nouns: ['Rime', 'Glaciers', 'Hoarfrost\nsrc/emberdeep/51-themes.js:1260:def('themes', 'fungal', { name: 'Fungal', nouns: ['Warrens', 'Mycelia', 'Spore\nsrc/emberdeep/51-themes.js:1289:def('themes', 'mine', { name: 'Mine', nouns: ['Mines', 'Diggings', 'Shafts', '\nsrc/emberdeep/51-themes.js:1316:def('themes', 'clockwork', { name: 'Clockwork', nouns: ['Clockworks', '