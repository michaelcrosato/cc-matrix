('skills', 'dan_reap', {\nsrc/emberdeep/22-char-dan.js:374:def('skills', 'dan_pounce', {\nsrc/emberdeep/22-char-dan.js:413:def('skills', 'dan_whirl', {\nsrc/emberdeep/22-char-dan.js:441:def('skills', 'dan_hatch', {\nsrc/emberdeep/22-char-dan.js:465:def('skills', 'dan_frenzy', {\nsrc/emberdeep/22-char-dan.js:489:def('skills', 'dan_burst', {\nsrc/emberdeep/28-progression.js:1084:  UI.def('skills', { title: 'SKILLS', w: W => Math.min(W - 8, 470), h: (W\nsrc/emberdeep/29-codex-skills.js:214:\treturn def(\"skills\", \"cx_\" + id, {\nsrc/emberdeep/26-skills-melee.js:151:def('skills', 'cleave', {\nsrc/emberdeep/26-skills-melee.js:202:def('skills', 'whirlwind', {\nsrc/emberdeep/26-skills-melee.js:267:def('skills', 'lunge', {\nsrc/emberdeep/26-skills-melee.js:339:def('skills', 'leap', {\nsrc/emberdeep/26-skills-melee.js:416:def('skills', 'uppercut', {\nsrc/emberdeep/26-skills-melee.js:525:def('skills', 'kick', {\nsrc/emberdeep/26-skills-melee.js:595:def('skills', 'flurry', {\nsrc/emberdeep/26-skills-melee.js:706:def('skills', 'bladethrow', {\nsrc/emberdeep/27-skills-spells.js:283:def('skills', 'frostnova', {\nsrc/emberdeep/27-skills-spells.js:366:def('skills', 'chainlightning', {\nsrc/emberdeep/27-skills-spells.js:453:def('skills', 'meteor', {\nsrc/emberdeep/27-skills-spells.js:555:def('skills', 'voidrift', {\nsrc/emberdeep/27-skills-spells.js:658:def('skills', 'bladestorm', {\nsrc/emberdeep/27-skills-spells.js:793:def('skills', 'echo', {\nsrc/emberdeep/27-skills-spells.js:835:def('skills', 'warcry', {\nsrc/emberdeep/27-skills-spells.js:897:def('skills', 'blink', {\n--- archetypes\nsrc/emberdeep/00-core.js:83:/** register a part: def('archetypes', 'husk', { ... }). Returns the spec (with .id set) */\nsrc/emberdeep/32-wardens.js:26:def('archetypes', 'warden', { name: 'Warden', tags: ['undead', 'melee', 'sentry'], minDepth: 3, wei\nsrc/emberdeep/31-monsters.js:268:def('archetypes', 'bonethrower', { name: 'Bonethrower', tags: ['undead', 'ranged'], themes: ['cry\nsrc/emberdeep/3