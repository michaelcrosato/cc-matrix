.view),{xray:true});for(const f of foes){r.shadow(f.x,f.y,5);r.actor(f.x,f.y,0,(g,ox,oy)=>f.rig.draw(g,ox,oy,r.view));}r.text('LIFE 100  The quick brown fox jumps over the lazy dog',14,14,'#fff',{shadow:'#000',outline:false});}}}});\n})();\n</script></body></html>\nEOF\ncat > res.py <<'EOF'\nimport sys\nfrom playwright.sync_api import sync_playwright\npath = sys.argv[1]\nwith sync_playwright() as p:\n    b = p.chromium.launch()\n    for (w,h,name) in [(1920,1080,'fhd'),(1280,720,'hd'),(3840,2160,'uhd')]:\n        pg = b.new_page(viewport={'width':w,'height':h})\n        errs=[]; pg.on('pageerror', lambda e: errs.append(str(e)))\n        pg.goto('file://'+path); pg.wait_for_timeout(2500)\n        print(name, pg.evaluate(\"__measure()\"), errs[:2])\n        if name=='fhd': pg.screenshot(path='res-fhd.png')\n        pg.close()\n    b.close()\nEOF\npython3 res.py \"$PWD/res.html\" 2>&1 | tail -6","description":"Measure 480x270 expand resolution and hero size at TV sizes","timeout":90000}}}
