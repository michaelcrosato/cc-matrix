5:  if (bk[2] <= fr[2]) return;   // its back is turned toward the camera: the seam shows\n90-scenes.js:7:  if (!gpu) { gpu = game.enableGPU({ map, ambient: [.15, .14, .24], wrap: .5, bands: 6 }); gpu.enabled = OPT.gpu !== false; }\n92-gallery.js:65:/** the set, built for the view so it faces the camera: d is the ground axis toward the camera (he climbs away from it,\n60-ui-core.js:558:function chooseView(id) { game.setView(id); OPT.view = game.baseView.id; saveOpts(); }\n60-ui-core.js:599:  const C = RUN.cv, V = RUN.view || (RUN.view = new E.View('portrait', 'Killer', 0, 16, 1, 1)), tall = (m.head || 28) * (m.scale || 1) + 10;\n99-start.js:7:if (!qs.has('view') && VIEW_IDS.includes(OPT.view)) game.setView(OPT.view);\n46-mechanics-a.js:90:  for (let i = 0; i < L0.w * L0.h && n < 60; i++) {   // probe just inside edges whose rock lies away from the camera: a painted cliff shows there\n46-mechanics-a.js:101:/** the cliff faces of every pit edge turned to the camera: the floor slab, then rock in strata, fading into the dark */\n64-menu.js:81:  { page: 'graphics', group: 'Camera', label: 'Reset the camera', keys: '0', about: 'Back to the game\\'s own camera: 1.25× zoom, no turn.', ctl: row => formButton(row, 'Reset the camera', () => { resetCamer\n63-character-menu.js:91:\tconst V = new E.View(\"character\", \"Preview\", 0, 20, 3.6);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01DtE6tP7je19Rs13fwXgZKH","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9Fqoheu1bbuSR3c8vr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WGSKHd9N7U2MaxV2vq3FL2","name":"Bash","input":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211938__x30f875/work/.research/engine && sed -n 1,90p docs/HANDOFF-MATRIX.md | cut -c1-420","description":"Read engine repo's matrix handoff notes"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13185,"cache_read_input_tokens":155981,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13185},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d255c30e-7719-4824-967e-28ca23bddd23","uuid":"f48883da-2fa8-4c03-87bc-3b4bffaefd63","timestamp":"2026-11-05T04:23:45.204Z","request_id":"req_011Cgj9FqXqTNiq6a2SGKjsV","wire_tool_inputs":{"toolu_01WGSKHd9N7U2MaxV2vq3FL2":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211938__x30f875/work/.research/engine && sed -n 1,90p docs/HANDOFF-MATRIX.md | cut -c1-420","description":"Read engine repo's matrix handoff notes"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WGSKHd9N7U2MaxV2vq3FL2","type":"tool_result","content":"# Handoff: what the cc-matrix run's 96 builders patched, hit and asked for\n\n> **Status (2026-11-04, at v0.86.0):** open. Written from the cc-matrix run of Nov 3 and 4 (96 builds on the handoff\n> package v0.85.2). v0.86.0 landed the quick ones (below); everything else is here, in the order to take it. It is\n> temporary: when an item lands, its line goes (say so in the changelog); when none is left, this file goes. What we\n> decided not to do is in `docs/FEEDBACK-LOG.md` (F8).\n\n## Where this comes from\n\n- **The run:** `~/dev/cc-matrix/runs/<model>.build__<time>__<id>__<Game>/`, the folders from `20261103-174700` on: 24\n  plans by Opus 5.5 (max), each built by Opus xhigh, Opus medium, Sonnet medium and Haiku medium. Each build's\n  `work/exit-interview.json` has six `engineFeedback` answers (liked, stuck or guessed wrong, built yourself, hardest,\n  what you changed, one thing to change), and `work/<Game>/` holds its copy of the engine as the builder left it.\n  `~/dev/cc-matrix/audit.json` is the run's audit (ENGINE-1 to ENGINE-4, TEST-1: tagged from the answers, not\n  reproduced). Weigh Opus first, then Sonnet; Haiku cut features and says so.\n- **The patches, measured:** each build's `my-3d2dge.js` and `modules/*.js` diffed against v0.85.2's\n  (`git show 4390a98:dist/handoff/my-3d2dge.js`), every hunk placed in its engine section. 79 of 96 builds changed the\n  engine (all 48 Opus, 20 Sonnet, 11 Haiku). Builds that changed each place (engine files only; more patched it in\n  their game's code):\n  | What | Builds |\n  |---|---|\n  | the button symbols' default (`STANDARD_SETTINGS.glyphs`, `Input.glyphs`) | 53 |\n  | the Humanoid (weapons 12, hats 13, outfits 6, draw hooks 7, held poses 4) | 37 |\n  | an audio bus or a voice bus | 35 |\n  | the font tables (✕ ○ □ △ in 29) | 32 |\n  | `E.Dialog`'s voice per letter | 28 |\n  | the AI Hub's Create + Options kept from the pause | 20 |\n  | the players' section (glyphs for a joining player, half keyboards) | 12 |\n  | E.Shell (settings rows on any screen 8, a TV size 6) | 15 |\n  | `E.HOOKS` exported (a per-step hook), analog triggers | 8, 8 |\n  | the floor bakes' cache size raised (6 to 10-16) | 6 |\n- **Checked:** every bug below was read in the code at v0.85.2 and, where it runs headless, reproduced in Node; the\n  3D ones in Chromium (WebGL 2 on SwiftShader). Each says what it is: **confirmed**, **partly**, **by design** (then the\n  fix is a doc), or what the builder actually hit.\n\n## Already done in v0.86.0 (don't redo)\n\nThe font's ✕ ○ □ △ − and marks and accents (both editions); a standard setting's default from the game\n(`menu.settings: [{ key: 'glyphs', value: 'playstation' }]`) and the controller's settings on every player;\n`E.Dialog`'s voice function, `say({ voice })`, `width`; `audio.bus()` and the voice bus; the rig's `NaN` from `vx`\nwithout `vy`; the music's look-ahead with an audio offset; a script's `tap`/`hold` no device, a tap leaving a hold,\n`feed('move')` a mouse move, a real mouse move setting `lastDevice`, a script's pad codes kept with no pad;\n`after`/`every` `{ keep: true }`; the floor bakes' least-recently-used drop; `window.Mocap`; the card's lines and D77;\nthe handoff README's 3D pointer and headless pitfalls. Tests: `matrixFixes` in `tools/contract-test.mjs`, part 5 of\n`tools/audio-test.mjs`.\n\n## Rules for this plan\n\n- **Reproduce first.** A failing check before the fix: in `tools/contract-test.mjs` (`matrixFixes`, or its Node part\n  for anything headless; its browser part for drawing), `tools/kit3d-test.mjs` for the 3D engine, `tools/views-test.mjs`\n  for mode7 and road. Run it against the old code once to see it fail.\n- **Headless stays the browser's twin** (principle 5). Never make a headless game behave differently from a page\n  (`game.go` keeps its fade; a test advances past it or sets `game.fadeTime = 0`).\n- **Make room before adding.** The kits sit near their budgets (cl100k, as `doctrine-check` counts; `gpt-tokenizer`'s\n  default `encode` is o200k and reads high). v0.86.1 gave each about 2,650 back (the fonts as digit rows): adventure\n  207,306 of 210,000, rpg 238,221 of 241,000, brawler 203,988 of 207,000, rts 204,769 of 208,000, shooter 220,660 of\n  224,000, sim 206,399 of 210,000; the API card 21,027 of 21,100; the agent header 9,974 of 10,000. The card's \"Common\n  mistakes\" (Part 8) and any line a part adds come out of that room, not new raises.\n- **Both editions:** a bug in code the agent edition has is fixed there too; an addition may stay the full engine's\n  (the agent edition's API is a subset: `npm run test:agent`).\n- **Process:** `CLAUDE.md`: a version per pull request, its changelog lines, `node tools/build.mjs`,\n  `npm run test:changed`, squash merge, then `npm test` in the background. Each budget raise or design call in its\n  own commit, with its line in `docs/DECISIONS.md`. A big design (marked **prototype**) starts as a Temporary lab\n  (`src/labs.json`: its date, the question it answers) for the owner to judge, and graduates only on their word.\n\n## Part 3: 2D rendering and cameras\n\n- **3.4 A perspective camera for 2D games** (**prototype**; the most asked-for addition: 13 runs, and all four Big Buck\n  Hunter and all four Time Crisis builders wrote their own renderer). First, point light-gun and first-person games at\n  the 3D engine (the README does now). Then a light-gun gallery on the mode7 module as a Temporary lab: `m7.pick(x, y)`\n  (the billboard or shape under the crosshair, by its drawn box), `m7.wall`/`m7.quad` (world polygons sorted with the\n  billboards), shapes with their params (3.5), lights; or a perspective `E.View`. The owner picks.\n\n## Part 4: the Humanoid\n\n- **4.1 Open registries** (37 builds changed the rig: weapons in 12, hats in 13). The weapon list is closed\n  (`['sword', 'gun', 'staff']` in the constructor). `E.Humanoid.weapon(id, { length, rest, grip, draw })`,\n  `E.Humanoid.hat(id, draw)`, a draw hook with the projected joints (`o.draw: { under, over }`) for outfits and\n  accessories, named held poses as data (`E.Humanoid.pose(id, (J, w) => ...)`, blended by weight), and a whole-body\n  tilt and roll for dives, falls and acrobatics (Europhoria, Olympiyikes). Every built-in weapon, hat and pose moves\n  onto the same registries (the proof that they are enough).\n- **4.2 `Math.random` in the rig** (confirmed: one call in the constructor, one in the blink): give each rig its own\n  stream (a seed in its options, else a counter), so a headless run's rig state is the same twice. TideCrisis reseeded\n  every rig's clock by hand.\n\n## Part 5: sound\n\n- **5.1 Effects with pan and length:** `sfx(name, { pan, loop })` returning `{ stop(), set({ pan, vol }) }`, and\n  continuous loops (an engine, rain) that follow the bus.\n- **5.2 Instruments of a game's own** (9 builds extended the synth): `audio.instrument(name, (ctx, bus, time, freq,","is_error":false}]},"parent_tool_use_id":null,"session_id":"d255c30e-7719-4824-967e-28ca23bddd23","uuid":"20182d9d-ebfa-4370-8edc-e24892b37ca3","timestamp":"2026-11-05T04:23:45.265Z","tool_use_result":{"stdout":"# Handoff: what the cc-matrix run's 96 builders patched, hit and asked for\n\n> **Status (2026-11-04, at v0.86.0):** open. Written from the cc-matrix run of Nov 3 and 4 (96 builds on the handoff\n> package v0.85.2). v0.86.0 landed the quick ones (below); everything else is here, in the order to take it. It is\n> temporary: when an item lands, its line goes (say so in the changelog); when none is left, this file goes. What we\n> decided not to do is in `docs/FEEDBACK-LOG.md` (F8).\n\n## Where this comes from\n\n- **The run:** `~/dev/cc-matrix/runs/<model>.build__<time>__<id>__<Game>/`, the folders from `20261103-174700` on: 24\n  plans by Opus 5.5 (max), each built by Opus xhigh, Opus medium, Sonnet medium and Haiku medium. Each build's\n  `work/exit-interview.json` has six `engineFeedback` answers (liked, stuck or guessed wrong, built yourself, hardest,\n  what you changed, one thing to change), and `work/<Game>/` holds its copy of the engine as the builder left it.\n  `~/dev/cc-matrix/audit.json` is the run's audit (ENGINE-1 to ENGINE-4, TEST-1: tagged from the answers, not\n  reproduced). Weigh Opus first, then Sonnet; Haiku cut features and says so.\n- **The patches, measured:** each build's `my-3d2dge.js` and `modules/*.js` diffed against v0.85.2's\n  (`git show 4390a98:dist/handoff/my-3d2dge.js`), every hunk placed in its engine section. 79 of 96 builds changed the\n  engine (all 48 Opus, 20 Sonnet, 11 Haiku). Builds that changed each place (engine files only; more patched it in\n  their game's code):\n  | What | Builds |\n  |---|---|\n  | the button symbols' default (`STANDARD_SETTINGS.glyphs`, `Input.glyphs`) | 53 |\n  | the Humanoid (weapons 12, hats 13, outfits 6, draw hooks 7, held poses 4) | 37 |\n  | an audio bus or a voice bus | 35 |\n  | the font tables (✕ ○ □ △ in 29) | 32 |\n  | `E.Dialog`'s voice per letter | 28 |\n  | the AI Hub's Create + Options kept from the pause | 20 |\n  | the players' section (glyphs for a joining player, half keyboards) | 12 |\n  | E.Shell (settings rows on any screen 8, a TV size 6) | 15 |\n  | `E.HOOKS` exported (a per-step hook), analog triggers | 8, 8 |\n  | the floor bakes' cache size raised (6 to 10-16) | 6 |\n- **Checked:** every bug below was read in the code at v0.85.2 and, where it runs headless, reproduced in Node; the\n  3D ones in Chromium (WebGL 2 on SwiftShader). Each says what it is: **confirmed**, **partly**, **by design** (then the\n  fix is a doc), or what the builder actually hit.\n\n## Already done in v0.86.0 (don't redo)\n\nThe font's ✕ ○ □ △ − and marks and accents (both editions); a standard setting's default from the game\n(`menu.settings: [{ key: 'glyphs', value: 'playstation' }]`) and the controller's settings on every player;\n`E.Dialog`'s voice function, `say({ voice })`, `width`; `audio.bus()` and the voice bus; the rig's `NaN` from `vx`\nwithout `vy`; the music's look-ahead with an audio offset; a script's `tap`/`hold` no device, a tap leaving a hold,\n`feed('move')` a mouse move, a real mouse move setting `lastDevice`, a script's pad codes kept with no pad;\n`after`/`every` `{ keep: true }`; the floor bakes' least-recently-used drop; `window.Mocap`; the card's lines and D77;\nthe handoff README's 3D pointer and headless pitfalls. Tests: `matrixFixes` in `tools/contract-test.mjs`, part 5 of\n`tools/audio-test.mjs`.\n\n## Rules for this plan\n\n- **Reproduce first.** A failing check before the fix: in `tools/contract-test.mjs` (`matrixFixes`, or its Node part\n  for anything headless; its browser part for drawing), `tools/kit3d-test.mjs` for the 3D engine, `tools/views-test.mjs`\n  for mode7 and road. Run it against the old code once to see it fail.\n- **Headless stays the browser's twin** (principle 5). Never make a headless game behave differently from a page\n  (`game.go` keeps its fade; a test advances past it or sets `game.fadeTime = 0`).\n- **Make room before adding.** The kits sit near their budgets (cl100k, as `doctrine-check` counts; `gpt-tokenizer`'s\n  default `encode` is o200k and reads high). v0.86.1 gave each about 2,650 back (the fonts as digit rows): adventure\n  207,306 of 210,000, rpg 238,221 of 241,000, brawler 203,988 of 207,000, rts 204,769 of 208,000, shooter 220,660 of\n  224,000, sim 206,399 of 210,000; the API card 21,027 of 21,100; the agent header 9,974 of 10,000. The card's \"Common\n  mistakes\" (Part 8) and any line a part adds come out of that room, not new raises.\n- **Both editions:** a bug in code the agent edition has is fixed there too; an addition may stay the full engine's\n  (the agent edition's API is a subset: `npm run test:agent`).\n- **Process:** `CLAUDE.md`: a version per pull request, its changelog lines, `node tools/build.mjs`,\n  `npm run test:changed`, squash merge, then `npm test` in the background. Each budget raise or design call in its\n  own commit, with its line in `docs/DECISIONS.md`. A big design (marked **prototype**) starts as a Temporary lab\n  (`src/labs.json`: its date, the question it answers) for the owner to judge, and graduates only on their word.\n\n## Part 3: 2D rendering and cameras\n\n- **3.4 A perspective camera for 2D games** (**prototype**; the most asked-for addition: 13 runs, and all four Big Buck\n  Hunter and all four Time Crisis builders wrote their own renderer). First, point light-gun and first-person games at\n  the 3D engine (the README does now). Then a light-gun gallery on the mode7 module as a Temporary lab: `m7.pick(x, y)`\n  (the billboard or shape under the crosshair, by its drawn box), `m7.wall`/`m7.quad` (world polygons sorted with the\n  billboards), shapes with their params (3.5), lights; or a perspective `E.View`. The owner picks.\n\n## Part 4: the Humanoid\n\n- **4.1 Open registries** (37 builds changed the rig: weapons in 12, hats in 13). The weapon list is closed\n  (`['sword', 'gun', 'staff']` in the constructor). `E.Humanoid.weapon(id, { length, rest, grip, draw })`,\n  `E.Humanoid.hat(id, draw)`, a draw hook with the projected joints (`o.draw: { under, over }`) for outfits and\n  accessories, named held poses as data (`E.Humanoid.pose(id, (J, w) => ...)`, blended by weight), and a whole-body\n  tilt and roll for dives, falls and acrobatics (Europhoria, Olympiyikes). Every built-in weapon, hat and pose moves\n  onto the same registries (the proof that they are enough).\n- **4.2 `Math.random` in the rig** (confirmed: one call in the constructor, one in the blink): give each rig its own\n  stream (a seed in its options, else a counter), so a headless run's rig state is the same twice. TideCrisis reseeded\n  every rig's clock by hand.\n\n## Part 5: sound\n\n- **5.1 Effects with pan and length:** `sfx(name, { pan, loop })` returning `{ stop(), set({ pan, vol }) }`, and\n  continuous loops (an engine, rain) that follow the bus.\n- **5.2 Instruments of a game's own** (9 builds extended the synth): `audio.instrument(name, (ctx, bus, time, freq,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WGSKHd9N7U2MaxV2vq3FL2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Cgj9Fqoheu1bbuSR3c8vr","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WDBWy9mU6CEjpuCucqx9L7","name":"Bash","input":{"command":"sed -n 1,115p docs/CHARACTERS.md | cut -c1-360","description":"Read recipe for building new character bodies"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13185,"cache_read_input_tokens":155981,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13185},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d255c30e-7719-4824-967e-28ca23bddd23","uuid":"3beda7ad-8a97-467f-83f8-81dbca230c05","timestamp":"2026-11-05T04:23:46.857Z","request_id":"req_011Cgj9FqXqTNiq6a2SGKjsV","wire_tool_inputs":{"toolu_01WDBWy9mU6CEjpuCucqx9L7":{"command":"cd /home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211938__x30f875/work/.research/engine && sed -n 1,115p docs/CHARACTERS.md | cut -c1-360","description":"Read recipe for building new character bodies"}},"wire_ingest_context":{"toolu_01WDBWy9mU6CEjpuCucqx9L7":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-max.plan-v2__20261104-211938__x30f875/work/.research/engine"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WDBWy9mU6CEjpuCucqx9L7","type":"tool_result","content":"# Adding a playable character to Emberdeep\n\nA playable character is one file. It registers with `def('characters', id, spec)` (`src/emberdeep/18-characters.js`), and every place the game treats heroes differently asks that entry: its body, starting skills and gear, save slot, stats, arrival, title pose, paper doll, captured clips. No shared file changes. This page is the recipe, from a brief to a chec\n\n## The loop\n\n```\nnpm run new:character -- <id> [--body humanoid|custom] [--name \"Ranger\"] [--title \"The Far-Sighted\"]\nnpm run character:check -- <id> [--quick]     # after every change: syntax, build, the character test, the sheet\nnode tools/ed-balance.mjs --character <id> --to 5   # once its skills are real: the autopilot against the Wanderer\nnpm test                                      # before you push: every hero, the templates, everything else\n```\n\n1. `new:character` writes `src/emberdeep/22-char-<id>.js`, a hero that already passes every check: an entry, a body (a dressed Humanoid, or a custom body that keeps the contract) and two skills of its own.\n2. Change one thing (the brief, the look, a skill), then run `character:check` (`--quick` skips every shared skill and the phone while you iterate). Read its summary and the sheet image (`check-output/sheet-<id>.png`); open the test's screenshots (`check-output/character-<id>/`) only when something failed.\n3. Play it: `examples/emberdeep.html?character=<id>#town`, or one gallery entry: `#gallery/poses/fall`, `#gallery/skills/<skill id>` (add `?view=topdown` to change the view). For an animation, record a filmstrip: `node tools/filmstrip.mjs \"examples/emberdeep.html?character=<id>#gallery/skills/<skill>\" --seed 1 --steps \"wait:200 rec:16:20\"`.\n4. Bump the version and add a line to `CHANGELOG.md` under **Characters** (see `CLAUDE.md`).\n\n## 1. The brief, first\n\nWrite it before any code, in the entry's `desc` and `style` and the file's header comment. A brief that answers these keeps every later choice consistent:\n\n- **Who**: who it is and why it goes down, in a sentence. The game has no story; a line is enough.\n- **Silhouette**: three words that tell it from the Wanderer and Codex at 40 pixels tall (a hood and floating hands; a broad shield; a tail and a crouch).\n- **Motion language**: how it moves and turns (grounded strides, a hover with inertia, quick hops), and how it dodges (a roll, a fold, a blink).\n- **Combat**: its role and its starting skills as verbs (cleave, pin, pull, mark). One should hurt what stands in front of it; the character test checks that.\n- **Palette**: three materials, each shaded with `E.tones(color)` (deep, shadow, base, light, highlight). Shadows lean cool and highlights warm by themselves.\n- **Readability**: it must read at game scale in all four of the game's views (iso, three-quarter, top-down, brawler) on every theme's floor. The sheet measures this.\n\n## 2. Pick the body\n\n| | `--body humanoid` (the default) | `--body custom` |\n|---|---|---|\n| What it is | The engine's `E.Humanoid`, dressed with the entry's `look` (build, outfit, hair, hat, armor, colors) under the gear | A class of your own, drawn with `px` and `E.tones`, that keeps the body contract |\n| What it gets for free | Every move of `E.MOVES`, every pose, IK legs and arms, cloth cape and hair, captured clips, the somersault dodge, the IK potion, the wounded hunch, weapon trails, portraits | Nothing: it animates everything itself (`ownLayers: true`) |\n| What it costs | A `look` and a `kit`: tens of lines | A body: Codex's is about 440 lines, Dan's about 250 |\n| Pick it when | The hero is a person | The hero is not a person (a book, a wisp, a beast), or the body is the point |\n\n## 3. The entry\n\n`def('characters', id, spec)` in your file. The required fields are `name`, `title`, `color`, `desc`, `style`, `skills` (1 to 6 starting skill ids, slotted LMB, RMB, then 1-4) and the movement numbers `speed`, `acceleration`, `dodgeTime`, `dodgeSpeed` (the Wanderer: 84, 1000, .27, 255). Every hook is optional and falls back to the Wanderer's behavior:\n\n| Field | What it changes |\n|---|---|\n| `look` | Its Humanoid look under the gear (any `E.Humanoid` option and `colors`); the Echo and paper doll wear it too |\n| `rig(h, look, over)` | Its body: return a custom rig (`over` carries the Echo's spectral colors, for a body that wants them) |\n| `ownLayers: true` | It animates its own dodge, potion and wounds (the Wanderer's layers would bend a Humanoid's joints) |\n| `clips: false` | No captured clips (a Humanoid hero plays the HERO set's moments by default) |\n| `head`, `r` | How tall it is (bars and effects sit there) and its collision radius (26 and 4.5) |\n| `stats(h, add)` | Flat bonuses: `add('ember', 25)` (stat names: `15-stats.js`) |\n| `prime(h)` | Fill its own resource for a cast outside real play: the gallery's demos, Tools' unlimited resources and the character test call it (Dan: a ripe brood) |\n| `init(h)` | Fields of its own on every new or loaded hero (Codex: its manuscript pages) |\n| `kit(h)` | Its starting gear, over the shared kit (longsword, tunic, shoes, cape) |\n| `dropIn(h, from)` | Its arrival in a depth (returns an action, see `20-hero.js`) |\n| `titlePose(t)` | Its rig state over the title screen's 12 s loop |\n| `preview(h, part, t)` | Extra rig state for the character menu's preview (part 0 idle, 1 run, 2 dodge, 3 cast) |\n| `titleZoom`, `dollHeight` | Framing on the title ([1.05, 1.75]) and on the paper doll (31) |\n| `menuNotes(el, C)` | Extra lines in the character menu |\n| `saveKey` | Its save slot (default `ed:save:<id>`) |\n\nIts own rules (a resource, a passive) go in its file as `BUS.on(...)` listeners that check `h.character === '<id>'`, the way Codex's manuscript pages do in `29-codex-skills.js`.\n\n## 4. A custom body\n\nThe body contract is the comment block at the top of `18-characters.js`: `update(dt, s)`, `draw(g, ox, oy, view)`, `drawSmear(r)`, `drawPortrait(g, x, y, size)`, `kick(v)`, `hand(side)`, `head()`, `tip()`, `worldOffset(p)`, joints `J` (at least `hipC`, `shC`, `head`, `handL`, `handR`, `bladeDir`), options `o` (at least `size`), colors `C`, and `x, y, z, faci\n\nWhat makes a custom body look like it belongs:\n\n- **Ease every weight.** Each state (`dash`, `down`, `pose`, `attack`) moves a number toward its target with `approach(w, target, dt * rate)`, and the joints are built from those numbers. A pose that sets a joint directly snaps, and the sheet flags it as a pop.\n- **Project through the view.** Points in its own frame go through `worldOffset`, then `view.p(...)`; use `E.charView(view)` so faces stay readable in steep views, and keep it in `this.lastView` (held items and effects use it).\n- **Sort its parts** by `view.depth(...)` and draw far to near, so an arm passes behind the body when it turns away.\n- **Pixel rules**: only `px.*` and the engine's primitives, whole pixels, `E.tones` for every material. No `ctx.arc`, no gradients.\n- **Keep bones rigid.** Solve a limb with `E.ik3` (a hip to a hock, a shoulder to a wrist) and build a spine as one length at an angle, then list those pairs in `rig.bones` (`[['hipL', 'kneeL'], ...]`): the sheet measures exactly those for stretching. A Humanoid's limbs are measured without it; a custom body that lists none has nothing measured.\n- **Blend directions as angles.** A blade's direction blended as a vector passes through zero when two poses point opposite ways and flips; blend its pitch and yaw instead (`DanRig` does).\n- **Swing on a spring.** A strike's wind-up, sweep and recovery driven through a critically damped spring gathers speed and settles instead of jumping a frame where one phase hands over to the next.\n- Start from the template (`--body custom`), from `CodexRig` in `21-codex.js` (a floating body) or from `DanRig` in `22-char-dan.js` (a beast on reverse-kneed legs with a tail).\n\n## 5. Skills\n\nA skill is `def('skills', id, spec)`; the spec is documented at the top of `25-skills-core.js`. Add `character: '<id>'` to keep it the hero's own. The templates show the two common shapes: a melee swing (`swingAction` with an `E.Attack`, any move of `E.MOVES`) and a projectile (`FX.bolt` from `h.rig.hand('L')`). `26-skills-melee.js` and `27-skills-spells.js`\n\n## 6. Reading the checks\n\n**The character test** (`tools/ed-character-test.mjs`) fails with the reason in one line. It checks that:\n- the entry is complete and the body keeps the contract;\n- the hero is picked in the menu and saves to its own slot, and survives a reload;\n- it moves and dodges;\n- its starting skills cast and one of them hurts;\n- every shared skill works with its body, and its Echo has its body;\n- it shows on the paper doll;\n- it drops into a depth, drinks, is knocked down, dies and is revived;\n- it plays in every view, on the title and in the gallery, and on a phone held upright;\n- the game throws no error and the engine prints no warning.\n\n**The sheet** (`tools/ed-sheet.mjs`) is one image: every state in every view, a turnaround, and game scale on each theme's floor. Its numbers and what to do about each:\n\n| It says | Do this |\n|---|---|\n| a pop: a joint jumps far in one step (against the steps around it: a fast, steady sweep is not one) | Ease that pose's weight instead of setting the joint |\n| its feet slide while it stands | Keep the feet still in idle; sway the hips instead |\n| a joint goes under the floor | Clamp it (`Math.max(1, z)`) or lift the pose |\n| a bone stretches | Solve the limb with `E.ik3` so its length holds |\n| it nearly vanishes in one view | Give it size or a shape in that view (top-down shows the head and shoulders) |\n| few colors | Shade each material with `E.tones` (3 to 5 tones) |\n| only n% of it stands out on a floor | Lighten or darken a big area, or add a light trim or glow; the renderer's dark outline does not help on dark floors |\n\n**The balance run** (`tools/ed-balance.mjs`) is a rough guide: the autopilot plays every hero the same way, so a hero that needs a human's timing will look weaker than it is.\n\n## 7. Done\n\n- [ ] The brief is in the file and in `desc` and `style`.\n- [ ] `npm run character:check -- <id>` passes and the sheet has nothing left to look at that you did not choose.\n- [ ] It looks right in all four views and plays well in the gallery and a depth.\n- [ ] The balance run is within reach of the Wanderer's.\n- [ ] `npm test` passes; the version is bumped and `CHANGELOG.md` says what was added.","is_error":false}]},"parent_tool_use_id":null,"session_id":"d255c30e-7719-4824-967e-28ca23bddd23","uuid":"50e1a976-63c6-4c2e-88fc-127eae4b326c","timestamp":"2026-11-05T04:23:46.921Z","tool_use_result":{"stdout":"# Adding a playable character to Emberdeep\n\nA playable character is one file. It registers with `def('characters', id, spec)` (`src/emberdeep/18-characters.js`), and every place the game treats heroes differently asks that entry: its body, starting skills and gear, save slot, stats, arrival, title pose, paper doll, captured clips. No shared file changes. This page is the recipe, from a brief to a chec\n\n## The loop\n\n```\nnpm run new:character -- <id> [--body humanoid|custom] [--name \"Ranger\"] [--title \"The Far-Sighted\"]\nnpm run character:check -- <id> [--quick]     # after every change: syntax, build, the character test, the sheet\nnode tools/ed-balance.mjs --character <id> --to 5   # once its skills are real: the autopilot against the Wanderer\nnpm test                                      # before you push: every hero, the templates, everything else\n```\n\n1. `new:character` writes `src/emberdeep/22-char-<id>.js`, a hero that already passes every check: an entry, a body (a dressed Humanoid, or a custom body that keeps the contract) and two skills of its own.\n2. Change one thing (the brief, the look, a skill), then run `character:check` (`--quick` skips every shared skill and the phone while you iterate). Read its summary and the sheet image (`check-output/sheet-<id>.png`); open the test's screenshots (`check-output/character-<id>/`) only when something failed.\n3. Play it: `examples/emberdeep.html?character=<id>#town`, or one gallery entry: `#gallery/poses/fall`, `#gallery/skills/<skill id>` (add `?view=topdown` to change the view). For an animation, record a filmstrip: `node tools/filmstrip.mjs \"examples/emberdeep.html?character=<id>#gallery/skills/<skill>\" --seed 1 --steps \"wait:200 rec:16:20\"`.\n4. Bump the version and add a line to `CHANGELOG.md` under **Characters** (see `CLAUDE.md`).\n\n## 1. The brief, first\n\nWrite it before any code, in the entry's `desc` and `style` and the file's header comment. A brief that answers these keeps every later choice consistent:\n\n- **Who**: who it is and why it goes down, in a sentence. The game has no story; a line is enough.\n- **Silhouette**: three words that tell it from the Wanderer and Codex at 40 pixels tall (a hood and floating hands; a broad shield; a tail and a crouch).\n- **Motion language**: how it moves and turns (grounded strides, a hover with inertia, quick hops), and how it dodges (a roll, a fold, a blink).\n- **Combat**: its role and its starting skills as verbs (cleave, pin, pull, mark). One should hurt what stands in front of it; the character test checks that.\n- **Palette**: three materials, each shaded with `E.tones(color)` (deep, shadow, base, light, highlight). Shadows lean cool and highlights warm by themselves.\n- **Readability**: it must read at game scale in all four of the game's views (iso, three-quarter, top-down, brawler) on every theme's floor. The sheet measures this.\n\n## 2. Pick the body\n\n| | `--body humanoid` (the default) | `--body custom` |\n|---|---|---|\n| What it is | The engine's `E.Humanoid`, dressed with the entry's `look` (build, outfit, hair, hat, armor, colors) under the gear | A class of your own, drawn with `px` and `E.tones`, that keeps the body contract |\n| What it gets for free | Every move of `E.MOVES`, every pose, IK legs and arms, cloth cape and hair, captured clips, the somersault dodge, the IK potion, the wounded hunch, weapon trails, portraits | Nothing: it animates everything itself (`ownLayers: true`) |\n| What it costs | A `look` and a `kit`: tens of lines | A body: Codex's is about 440 lines, Dan's about 250 |\n| Pick it when | The hero is a person | The hero is not a person (a book, a wisp, a beast), or the body is the point |\n\n## 3. The entry\n\n`def('characters', id, spec)` in your file. The required fields are `name`, `title`, `color`, `desc`, `style`, `skills` (1 to 6 starting skill ids, slotted LMB, RMB, then 1-4) and the movement numbers `speed`, `acceleration`, `dodgeTime`, `dodgeSpeed` (the Wanderer: 84, 1000, .27, 255). Every hook is optional and falls back to the Wanderer's behavior:\n\n| Field | What it changes |\n|---|---|\n| `look` | Its Humanoid look under the gear (any `E.Humanoid` option and `colors`); the Echo and paper doll wear it too |\n| `rig(h, look, over)` | Its body: return a custom rig (`over` carries the Echo's spectral colors, for a body that wants them) |\n| `ownLayers: true` | It animates its own dodge, potion and wounds (the Wanderer's layers would bend a Humanoid's joints) |\n| `clips: false` | No captured clips (a Humanoid hero plays the HERO set's moments by default) |\n| `head`, `r` | How tall it is (bars and effects sit there) and its collision radius (26 and 4.5) |\n| `stats(h, add)` | Flat bonuses: `add('ember', 25)` (stat names: `15-stats.js`) |\n| `prime(h)` | Fill its own resource for a cast outside real play: the gallery's demos, Tools' unlimited resources and the character test call it (Dan: a ripe brood) |\n| `init(h)` | Fields of its own on every new or loaded hero (Codex: its manuscript pages) |\n| `kit(h)` | Its starting gear, over the shared kit (longsword, tunic, shoes, cape) |\n| `dropIn(h, from)` | Its arrival in a depth (returns an action, see `20-hero.js`) |\n| `titlePose(t)` | Its rig state over the title screen's 12 s loop |\n| `preview(h, part, t)` | Extra rig state for the character menu's preview (part 0 idle, 1 run, 2 dodge, 3 cast) |\n| `titleZoom`, `dollHeight` | Framing on the title ([1.05, 1.75]) and on the paper doll (31) |\n| `menuNotes(el, C)` | Extra lines in the character menu |\n| `saveKey` | Its save slot (default `ed:save:<id>`) |\n\nIts own rules (a resource, a passive) go in its file as `BUS.on(...)` listeners that check `h.character === '<id>'`, the way Codex's manuscript pages do in `29-codex-skills.js`.\n\n## 4. A custom body\n\nThe body contract is the comment block at the top of `18-characters.js`: `update(dt, s)`, `draw(g, ox, oy, view)`, `drawSmear(r)`, `drawPortrait(g, x, y, size)`, `kick(v)`, `hand(side)`, `head()`, `tip()`, `worldOffset(p)`, joints `J` (at least `hipC`, `shC`, `head`, `handL`, `handR`, `bladeDir`), options `o` (at least `size`), colors `C`, and `x, y, z, faci\n\nWhat makes a custom body look like it belongs:\n\n- **Ease every weight.** Each state (`dash`, `down`, `pose`, `attack`) moves a number toward its target with `approach(w, target, dt * rate)`, and the joints are built from those numbers. A pose that sets a joint directly snaps, and the sheet flags it as a pop.\n- **Project through the view.** Points in its own frame go through `worldOffset`, then `view.p(...)`; use `E.charView(view)` so faces stay readable in steep views, and keep it in `this.lastView` (held items and effects use it).\n- **Sort its parts** by `view.depth(...)` and draw far to near, so an arm passes behind the body when it turns away.\n- **Pixel rules**: only `px.*` and the engine's primitives, whole pixels, `E.tones` for every material. No `ctx.arc`, no gradients.\n- **Keep bones rigid.** Solve a limb with `E.ik3` (a hip to a hock, a shoulder to a wrist) and build a spine as one length at an angle, then list those pairs in `rig.bones` (`[['hipL', 'kneeL'], ...]`): the sheet measures exactly those for stretching. A Humanoid's limbs are measured without it; a custom body that lists none has nothing measured.\n- **Blend directions as angles.** A blade's direction blended as a vector passes through zero when two poses point opposite ways and flips; blend its pitch and yaw instead (`DanRig` does).\n- **Swing on a spring.** A strike's wind-up, sweep and recovery driven through a critically damped spring gathers speed and settles instead of jumping a frame where one phase hands over to the next.\n- Start from the template (`--body custom`), from `CodexRig` in `21-codex.js` (a floating body) or from `DanRig` in `22-char-dan.js` (a beast on reverse-kneed legs with a tail).\n\n## 5. Skills\n\nA skill is `def('skills', id, spec)`; the spec is documented at the top of `25-skills-core.js`. Add `character: '<id>'` to keep it the hero's own. The templates show the two common shapes: a melee swing (`swingAction` with an `E.Attack`, any move of `E.MOVES`) and a projectile (`FX.bolt` from `h.rig.hand('L')`). `26-skills-melee.js` and `27-skills-spells.js`\n\n## 6. Reading the checks\n\n**The character test** (`tools/ed-character-test.mjs`) fails with the reason in one line. It checks that:\n- the entry is complete and the body keeps the contract;\n- the hero is picked in the menu and saves to its own slot, and survives a reload;\n- it moves and dodges;\n- its starting skills cast and one of them hurts;\n- every shared skill works with its body, and its Echo has its body;\n- it shows on the paper doll;\n- it drops into a depth, drinks, is knocked down, dies and is revived;\n- it plays in every view, on the title and in the gallery, and on a phone held upright;\n- the game throws no error and the engine prints no warning.\n\n**The sheet** (`tools/ed-sheet.mjs`) is one image: every state in every view, a turnaround, and game scale on each theme's floor. Its numbers and what to do about each:\n\n| It says | Do this |\n|---|---|\n| a pop: a joint jumps far in one step (against the steps around it: a fast, steady sweep is not one) | Ease that pose's weight instead of setting the joint |\n| its feet slide while it stands | Keep the feet still in idle; sway the hips instead |\n| a joint goes under the floor | Clamp it (`Math.max(1, z)`) or lift the pose |\n| a bone stretches | Solve the limb with `E.ik3` so its length holds |\n| it nearly vanishes in one view | Give it size or a shape in that view (top-down shows the head and shoulders) |\n| few colors | Shade each material with `E.tones` (3 to 5 tones) |\n| only n% of it stands out on a floor | Lighten or darken a big area, or add a light trim or glow; the renderer's dark outline does not help on dark floors |\n\n**The balance run** (`tools/ed-balance.mjs`) is a rough guide: the autopilot plays every hero the same way, so a hero that needs a human's timing will look weaker than it is.\n\n## 7. Done\n\n- [ ] The brief is in the file and in `desc` and `style`.\n- [ ] `npm run character:check -- <id>` passes and the sheet has nothing left to look at that you did not choose.\n- [ ] It looks right in all four views and plays well in the gallery and a depth.\n- [ ] The balance run is within reach of the Wanderer's.\n- [ ] `npm test` passes; the version is bumped and `CHANGELOG.md` says what was added.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01WDBWy9mU6CEjpuCucqx9L7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
