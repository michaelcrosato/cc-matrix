(rc.width || 1), v = (e.clientY - rc.top) * mini.height / (rc.height || 1); m.onClick(X ? (u - X.ox) / X.k : 0, X ? (v - X\n  }\n  /** the name of the open screen ('pause', 'settings', 'controls', ...), or null while the game plays */\n--- PAD_GLYPHS\n1296:const PAD_GLYPHS = {\nconst PAD_GLYPHS = {\n  xbox: ['A', 'B', 'X', 'Y', 'LB', 'RB', 'LT', 'RT', 'View', 'Menu', 'LS', 'RS', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Guide'],\n  playstation: ['✕', '○', '□', '△', 'L1', 'R1', 'L2', 'R2', 'Create', 'Options', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'PS'],\n  nintendo: ['B', 'A', 'Y', 'X', 'L', 'R', 'ZL', 'ZR', '−', '+', 'L stick', 'R stick', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home'],\n  generic: ['Bottom', 'Right', 'Left', 'Top', 'L1', 'R1', 'L2', 'R2', 'Select', 'Start', 'L3', 'R3', 'D-pad ↑', 'D-pad ↓', 'D-pad ←', 'D-pad →', 'Home']\n};\nconst CODE_LABELS = { Space: 'Space', ShiftLeft: 'Shift', ShiftRight: 'R Shift', ControlLeft: 'Ctrl', ControlRight: 'R Ctrl', AltLeft: 'Alt', AltRight: 'R Alt',\n--- allowJoin\n2493:  /** the players: [game.input (player 1), ...the ones who joined (game.allowJoin, game.addPlayer: section 10j)]; each an\n3724: *    numpad on the right), touch for player 1. game.allowJoin({ max, onJoin }) lets them in: Start on a free pad, or 2 (the\n3755: *  (input, number) as each does. allowJoin(false) closes it (the names split and join are String's and Array's) */\n3756:Game.prototype.allowJoin = function (o = {}) {\n3776:  if (this._join && this._join.onJoin) try { this._join.onJoin(q, n); } catch (e) { this.fail('allowJoin onJoin', e); }\nsed: -e expression #1, char 1: unknown command: `,'\n--- live\n2396:     *  errors caught in update and draw, each { where, scene, message, stack }, once per kind; live: true (o.live): a pause\n2399:    this.paused = false; this.pauseOverlay = true; this._timers = []; this.errors = []; this._errKeys = new Set(); this.live = !!o.live; this._goOn = false;\n2543:   * o: { pause: fal