ign({ wave: 'square' }, S7.reg.personas[id].voice);\\nObject.assign(S7.reg.voices, VOICES);\\n\",\"Object.assign(S7.reg.voices, VOICES);\\nconst voiceOf = who => S7.reg.voices[who] || (S7.reg.personas[who] && Object.assign({ wave: 'square' }, S7.reg.personas[who].voice)) || VOICES.narrator;\\n\")\ns=s.replace(\"const v = S7.reg.voices[who] || VOICES.narrator, code\",\"const v = voiceOf(who), code\")\nopen(p,'w').write(s)\nE\nnode --check src/30-audio.js && echo ok"}}}
