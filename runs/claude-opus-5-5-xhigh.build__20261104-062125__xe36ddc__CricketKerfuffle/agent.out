{ label: 'HIGHLIGHTS', hidden: () => !(m && m.highlights.length), act: () => this.playHighlights() },\"\"\"\nnew_c=\"\"\"      { label: 'HIGHLIGHTS', hidden: () => !(m && m.highlights.some(h => h.frames)), act: () => this.playHighlights() },\"\"\"\nassert old_c in s; s=s.replace(old_c,new_c)\nold_d=\"\"\"    const m = this.m, top = m.highlights.slice().sort((a, b) => b.w - a.w).slice(0, 3).filter(h => h.frames);\"\"\"\nnew_d=\"\"\"    const m = this.m, top = m.highlights.filter(h => h.frames).sort((a, b) => b.w - a.w).slice(0, 3);   // (only moments with a recording)\"\"\"\nassert old_d in s; s=s.replace(old_d,new_d)\ns=s.replace(\"continueLabel: won ? 'CONTINUE' : 'CONTINUE'\",\"continueLabel: 'CONTINUE'\")\nopen(p,'w').write(s)\np='src/53-story.js'; s=open(p).read()\nif \"continueLabel: won ? 'CONTINUE' : 'CONTINUE'\" in s: s=s.replace(\"continueLabel: won ? 'CONTINUE' : 'CONTINUE'\",\"continueLabel: 'CONTINUE'\"); open(p,'w').write(s); print('story ternary simplified')\np='test/suites/sim-menus.mjs'; s=open(p).read()\nold=\"\"\"  check('every menu item was pressed (\"\"\"\nnew=\"\"\"  // with only two teams unlocked (a new profile), YOUR TEAM's arrow swaps the sides instead of doing nothing\n  { const env = fresh(); env.game.go('setup', { mode: 'quick' }, { fade: 0 }); env.game.advance(.2); const L = env.K.scenes.setup.list, a = L.items[0], b = L.items[1];\n    const v0 = [a.value(), b.value()]; a.right(); const v1 = [a.value(), b.value()];\n    check('quick match with two teams unlocked: picking the opponents\\\\' team swaps the sides', env.K.Profile.data.unlocked.length === 2 && v1[0] === v0[1] && v1[1] === v0[0], { v0, v1 }); }\n  check('every menu item was pressed (\"\"\"\nassert old in s; s=s.replace(old,new,1); open(p,'w').write(s)\nEOF\ngrep -n \"help: () =>\\|help:\" src/45-ui.js | head -3; node tools/build.mjs | tail -1 && node test/run.mjs sim-menus 2>&1 | cut -c1-800","description":"Fix the team rows and Highlights button, add a swap check","timeout":6