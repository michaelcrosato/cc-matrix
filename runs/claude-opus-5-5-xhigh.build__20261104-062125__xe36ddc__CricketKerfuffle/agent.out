 v) => { g.audio.voiceVolume = v; g.audio.applyVolume(); } },\")\n# 4 glyphs default playstation, options PS / Xbox\nrep(\"glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'auto', options: [['auto', 'Auto'], ['xbox', 'Xbox'], ['playstation', 'PlayStation'], ['nintendo', 'Nintendo'], ['generic', 'Positions']],\",\n    \"glyphs: { group: 'Controller', label: 'Button symbols', type: 'select', value: 'playstation', options: [['playstation', 'PlayStation'], ['xbox', 'Xbox (A B X Y)']],\")\n# 5 hub: Create + Options is the hub's\nrep(\"if (s && s.pausable && this.input.pressed('pause')) { this.paused = !this.paused;\",\"if (s && s.pausable && this.input.pressed('pause') && !(this.hubActive && this.input.held.has('Pad8'))) { this.paused = !this.paused;\")\nrep(\"if (game.scene && game.scene.pausable && q.pressed('pause')) {\",\"if (game.scene && game.scene.pausable && q.pressed('pause') && !(game.hubActive && q.held.has('Pad8'))) {\")\n# 6 floor bakes kept: 10\nrep(\"if (Object.keys(this.floors).length > 6) this.floors = {};\",\"if (Object.keys(this.floors).length > 10) this.floors = {};   // (Kerfuffle: 6 -> 10, so a match's four cameras and the story's views never re-bake)\")\nopen(p,'w').write(s)\nprint('ok')\nEOF\ncat > CHANGES-KERFUFFLE.md <<'EOF'\n# Engine changes made for Cricket Kerfuffle\n\nThe engine (my-3D2dge v0.85.2, `my-3d2dge.js`) is the builder's to change. Every change is marked `(Kerfuffle)` in the code.\n\n1. **Cricket bat** (`weapon: 'bat'`): a flat willow blade with a grip, sticker band and toe (`_drawBat`, HD and classic\n   styles), a grounded rest direction (`batRest`), `batLen` / `batScale` (the Giant Bat item), `tip()` and the swing smear\n   treat it as a blade, and a two-handed grip: the top hand is IK'd onto the handle (`rig.oneHand = true` lets go while running).\n2. **Cricket gear**: `pads: true` (white leg guards with buckles), hat style `'brim'` (umpires, sun hats),\n   `hat: { style: 'helmet', grille: true }` (a batting helmet's face grille), `bigHands` (keeper's gloves), and\n   `face: { moustache: 'handlebar' | 'walrus', beard: 'full' | 'goatee', glasses: true }`.\n3. **Voice bus**: `audio._voiceBus` beside the sfx and music buses, a `voiceVolume` setting (Sound, \"Voices\"), and\n   `audio.bus('sfx' | 'music' | 'voice')` so the game's own Web Audio graphs (crowd, gibberish voices) follow the player's volumes.\n4. **Button symbols**: the Controller setting defaults to PlayStation, with Xbox (A B X Y) as the other choice.\n5. **AI Hub's Create + Options**: while `game.hubActive` is set and Create (Pad8) is held, Options doesn't pause.\n6. **Floor bakes**: `TileMap._floor` keeps up to 10 baked floors (was 6), so the match's cameras never re-bake.\nEOF\nnode -e \"require('./my-3d2dge.js')\" 2>&1 | head -5; node -e \"\nconst vm=require('vm'),fs=require('fs');const ctx={console};vm.createContext(ctx);vm.runInContext(fs.readFileSync('my-3d2dge.js','utf8'),ctx);\nconst E=ctx.My3D2dge; const r=new E.Humanoid({weapon:'bat',pads:true,hat:{style:'brim'},face:{moustache:'walrus'}}); r.update(1/120,{x:0,y:0,z:0,vx:0,vy:0,facing:0}); console.log('rig ok', E.version, r.tip().map(v=>v.toFixed(1)).join(','));\n\"","description":"Patch voice bus, glyphs, hub pause, floor cache; log changes; smoke test"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":792,"cache_read_input_tokens":239443,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":792},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"17695eeb-ca5d-4805-90b6-169496893b17","uuid":"a920ccc7-5ef3-4156-8a44-7116b7de1c3e","timestamp":"2026-11-04T13:27:36.664Z","request_id":"req_011CghxwaMrxqcY2cQJPQttJ","wire_tool_inputs":{"toolu_0196RWNkhVbnuTPSzQh3