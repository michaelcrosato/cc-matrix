eOutcome('runout')\", G + \"const m=D.match();for(let i=0;i<1200&&!(m.decision&&m.decision.kind==='third'&&m.decision.t>2.6);i++)g.advance(1/60);\"]);\nawait run('ring', [G + \"D.startMatch({humans:{0:[g.input]},battingFirst:1})\", 1500, G + \"const m=D.match();for(let i=0;i<600&&m.phase!=='setup'&&m.phase!=='pickBowler';i++)g.advance(1/60);if(m.phase==='pickBowler')m.pickBowler(0);for(let i=0;i<60;i++)g.advance(1/60);D.forceOutcome('caughtHuman');m.startRunup(m.deliveryChoices[0]);for(let i=0;i<900&&!(m.catchRing&&m.time>m.catchRing.t0+.3);i++)g.advance(1/60);\"]);\nawait run('lesson', [G + \"g.go('nets',{},{fade:0})\", 500, G + \"K.scenes.nets.run([2,3])\", 1500]);\nawait run('results', [G + \"D.startMatch({humans:{},overs:1,wickets:3})\", 800, G + \"for(let i=0;i<400&&g.sceneName==='match';i++)g.advance(1);\", 1800]);\nawait b.close();\nEOF\nnode .scratch/screens.mjs && node .scratch/sheet.mjs test/out/review5.png test/out/scr-toss.png test/out/scr-rain.png test/out/scr-owl.png test/out/scr-third.png test/out/scr-ring.png test/out/scr-lesson.png test/out/scr-results.png","description":"Capture interrupt screens in the browser","timeout":400000}},"wire_ingest_context":{"toolu_01MSyBaJJcjpsny9KjfsTFtU":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-062125__xe36ddc/work/CricketKerfuffle-Cricket-claude-opus-5-5-xhigh-20261104-062125"}}}
