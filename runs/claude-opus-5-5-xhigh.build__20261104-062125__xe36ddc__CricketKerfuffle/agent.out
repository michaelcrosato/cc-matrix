smoke(x, y, 2, 10, { color: '#bfe8ff' }); } else P.dust(x, y, d.z, 6); }\n155:  nearestGroup(x, y) { let best = null, bd = 1e9; for (const g of this.B.groups) { const d = hyp(g.x - x, g.y - y); if (d < bd) { bd = d; best = g; } } return bd < 260 ? best : null; },\n299:  drawCrowd(r, W) {\n62:  nets: { id: 'nets', name: 'The Nets', short: 'THE NETS', ends: ['Net End', 'Machine End'], rx: 520, ry: 560, nets: true,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_011ncEdF6nkrczhUy7XGFobe","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
