ane is open)', !m.netCollide(0, 60, 8));\n    env.game.advance(20); check('the Nets play on without errors', !env.game.errors.length, env.game.errors.map(e => e.message)); }\n}\nEOF\nnode tools/build.mjs --quiet && node test/run.mjs sim-extras 2>&1 | tail -6","description":"Keeper inside the net; write and run the sim-extras suite","timeout":400000}},"wire_ingest_context":{"toolu_01J6ZbEGCxYdYBfo25mxVp5j":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-062125__xe36ddc/work/CricketKerfuffle-Cricket-claude-opus-5-5-xhigh-20261104-062125"}}}
