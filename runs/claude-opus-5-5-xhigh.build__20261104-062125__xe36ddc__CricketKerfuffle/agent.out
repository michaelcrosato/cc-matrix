face(5, { id: 'dobber', target: [-18, 60] }, { off: 0, aim: [-.77, .64], hold: 'left' }); check('a ball outside a drive\\'s zone takes an edge', r.m.cur.edge || (r.m.contact && r.m.contact.kind === 'edge') || r.m.cur.beaten, { edge: r.m.cur.edge, c: r.m.contact && r.m.contact.kind });\n  r = face(6, { id: 'dobber', target: [-4, 80] }, { off: 0, btn: 'loft', hold: 'down' }); check('a PERFECT loft goes in the air', r.m.contact && r.m.contact.launch > 25, r.m.contact && r.m.contact.launch);\n  r = face(7, { id: 'dobber', target: [-4, 80] }, { off: 0, btn: 'block' }); check('a block is a defensive stroke', r.m.cur.shot === 'forwardDefence' || r.m.cur.shot === 'backDefence', r.m.cur.shot);\n  // the AI never presses after the contact plane (its batPress returns false then): a CPU v CPU match has no late presses\n  const env = load({ seed: 9 }); env.game.advance(.3); env.D.startMatch({ humans: {}, seed: 9 }); env.game.advance(.1); const m = env.D.match(); let late = 0; env.K.bus.on('bat:press', d => { if (d.delta > .2) late++; });\n  until(env.game, () => m.phase === 'done', 400, 1 / 30); check('the CPU never presses after the ball has passed', late === 0, late);\n}\nEOF\ncat > test/suites/sim-bowling.mjs <<'EOF'\nimport { load, until, quickMatch } from '../lib.mjs';\nfunction bowl(seed) {\n  const env = load({ seed }), { game, I } = env, m = quickMatch(env, { seed, battingFirst: 1 });\n  until(game, () => m.phase === 'pickBowler' || m.phase === 'setup', 8);\n  if (m.phase === 'pickBowler') { I.tap('confirm'); game.advance(.2); }\n  until(game, () => m.phase === 'setup', 4);\n  return { env, m };\n}\n/** start a run-up with delivery 1 and press at meter position u (null: no press) */\nfunction deliver(env, m, u, after) {\n  const { game, I } = env; I.tap('shot'); game.advance(.05);\n  if (m.phase !== 'runup') return false;\n  const f = m.env && env.K.T('meterSpeed'), start = m.meter.start, tPress = u === null ? null : start + (u <= .5 ? u / 2 / f : (1 - u) / 2 / f + .5 / f);\n  if (tPress !== null) { game.advance(Math.max(0, tPress - m.pt) - 1 / 120); I.tap('shot'); }\n  if (after) after();\n  until(game, () => m.phase !== 'runup' && m.phase !== 'flight', 6);\n  return true;\n}\nexport async function run(check) {\n  let { env, m } = bowl(1);\n  check('the human bowls (setup waits for a delivery)', m.phase === 'setup' && !!m.bowlerInput(), m.phase);\n  const fam = m.bowlerFamily(); env.I.tap('shot'); env.game.advance(.05);\n  check('the run-up takes the family\\'s time (' + fam + ')', Math.abs(m.runupTime - env.K.FAMILY[fam].runup) < .01, m.runupTime);\n  until(env.game, () => m.phase === 'between', 10);\n  ({ env, m } = bowl(2)); m.marker = [-6, 100];\n  deliver(env, m, .5); const c = m.cur;\n  check('a green release pitches near the marker', c.meter === 'green' && c.pitch && Math.hypot(c.pitch[0] - (-6), c.pitch[1] - 100) < 8, { meter: c.meter, pitch: c.pitch });\n  until(env.game, () => m.phase === 'setup', 10);\n  deliver(env, m, .97); check('the far-right tip oversteps: a no-ball', m.cur.extras.nb === 1 && m.cur.noBall === 'overstep', { meter: m.cur.meter, nb: m.cur.extras });\n  until(env.game, () => m.phase === 'setup', 10); check('a free hit follows', m.inn.freeHit === true);\n  deliver(env, m, null); check('no press auto-releases amber', m.cur.meter === 'amber', m.cur.meter);\n  until(env.game, () => m.phase === 'setup', 10);\n  m.marker = [0, 90]; deliver(env, m, .5, () => { until(env.game, () => m.phase === 'flight', 3); env.I.hold('right'); env.game.advance(.3); env.I.hold('right', false); });\n  check('aftertouch right moves the ball +x', m.cur.aftertouch > 0 && m.cur.pitch && m.cur.pitch[0] - m.cur.target[0] > 3, { at: m.cur.aftertouch, pitch: m.cur.pitch, target: m.cur.target });\n  until(env.game, () => m.phase === 'setup', 10);\n  const before = m.fieldPreset, homes = JSON.stringify(m.fielders.map(f => f.home)); env.I.tap('run'); env.game.advance(.1);\n  check('run cycles the field preset and moves the fielders', m.fieldPreset !== before && JSON.stringify(m.fielders.map(f => f.home)) !== homes, [before, m.fieldPreset]);\n  const rx = m.releasePoint().x; env.I.tap('back'); env.game.advance(.1);\n  check('back switches over / round the wicket (the release moves across)', m.overRound === 'round' && m.releasePoint().x !== rx && m.releasePoint().x > 0, [m.overRound, rx, m.releasePoint().x]);\n  check('no errors', !env.game.errors.length, env.game.errors.map(e => e.message));\n}\nEOF\ncat > test/suites/sim-running-fielding.mjs <<'EOF'\nimport { load, until, quickMatch } from '../lib.mjs';\nexport async function run(check) {\n  // running: R1 once for a single, the strike rotates\n  let env = load({ seed: 3 }), m = quickMatch(env, { seed: 3 });\n  until(env.game, () => m.phase === 'setup', 6); const s0 = m.striker.id; env.D.forceOutcome('1'); m.flags.forceRun = 0;\n  until(env.game, () => m.phase === 'inPlay', 8); env.I.tap('run'); until(env.game, () => m.phase === 'between', 12);\n  let last = m.inn.recs[m.inn.recs.length - 1]; check('R1 once on a push gives one run', last && last.ran === 1, last && { ran: last.ran, w: last.wicket });\n  check('the strike rotates after a single', m.inn.striker !== s0, [s0, m.inn.striker]);\n  // R1 twice for two\n  env = load({ seed: 4 }); m = quickMatch(env, { seed: 4 });\n  until(env.game, () => m.phase === 'setup', 6); env.D.forceOutcome('2'); m.flags.forceRun = 0;\n  until(env.game, () => m.phase === 'inPlay', 8); env.I.tap('run'); env.game.advance(.8); env.I.tap('run'); until(env.game, () => m.phase === 'between', 14);\n  last = m.inn.recs[m.inn.recs.length - 1]; check('R1 twice on a shot into the deep gives two', last && (last.ran === 2 || last.boundary), last && { ran: last.ran, b: last.boundary, w: last.wicket && last.wicket.how });\n  // L1 sends both back\n  env = load({ seed: 5 }); m = quickMatch(env, { seed: 5 });\n  until(env.game, () => m.phase === 'setup', 6); env.D.forceOutcome('1'); m.flags.forceRun = 0;\n  until(env.game, () => m.phase === 'inPlay', 8); env.I.tap('run'); env.game.advance(.4); env.I.tap('back'); until(env.game, () => m.phase === 'between', 12);\n  last = m.inn.recs[m.inn.recs.length - 1]; check('L1 mid-run sends both back (no run)', last && last.ran === 0 && !last.wicket, last && { ran: last.ran, w: last.wicket });\n  // the dive: the bat slides the last 20 units\n  const b = m.striker; b.y = 300 - 18; b.dive = 0; const no = m.grounded(b, 'B'); b.dive = .5; const yes = m.grounded(b, 'B');\n  check('a dive grounds the bat 20 units out (6 without)', !no && yes, [no, yes]);\n  // the catch ring: a human fielding side catches with a press at the overlap, drops with none\n  const ring = (seed, press) => {\n    const e = load({ seed }), mm = quickMatch(e, { seed, battingFirst: 1 }); until(e.game, () => mm.phase === 'pickBowler' || mm.phase === 'setup', 8); if (mm.phase === 'pickBowler') { e.I.tap('confirm'); e.game.advance(.2); }\n    until(e.game, () => mm.phase === 'setup', 4); e.D.forceOutcome('caughtHuman'); e.I.tap('shot'); e.game.advance(.1);\n    until(e.game, () => !!mm.catchRing || mm.phase === 'between', 10); const had = !!mm.catchRing;\n    if (had && press) { const t = mm.catchRing.tc - mm.time; e.game.advance(Math.max(0, t) - 1 / 120); e.I.tap('shot'); }\n    until(e.game, () => mm.phase === 'between', 10); const l = mm.inn.recs[mm.inn.recs.length - 1]; return { had, l };\n  };\n  let rr = ring(7, true); check('a catch chance shows the catch ring to a human fielder', rr.had);\n  check('a press at the overlap catches', rr.l && rr.l.wicket && rr.l.wicket.how === 'caught', rr.l && rr.l.wicket);\n  rr = ring(7, false); check('no press drops it', rr.l && !(rr.l.wicket && rr.l.wicket.how === 'caught') && rr.l.dropped, rr.l && { w: rr.l.wicket, d: rr.l.dropped });\n  // a human throw: Cross throws to the keeper's end; a direct hit with the batter short is out\n  env = load({ seed: 8 }); m = quickMatch(env, { seed: 8, battingFirst: 1 }); until(env.game, () => m.phase === 'pickBowler' || m.phase === 'setup', 8); if (m.phase === 'pickBowler') { env.I.tap('confirm'); env.game.advance(.2); }\n  until(env.game, () => m.phase === 'setup', 4); env.D.forceOutcome('runout'); m.cfg.cheat.directHit = true; env.I.tap('shot'); env.game.advance(.1);\n  until(env.game, () => (m.holder && m.holder !== m.keeper && m.holder !== m.bowler) || m.phase === 'between', 10);\n  let threw = false; const off = env.K.bus.on('field:throw', () => { threw = true; });\n  if (m.holder) { env.game.advance(.25); env.I.tap('shot'); }\n  until(env.game, () => m.phase === 'between', 10); off();\n  last = m.inn.recs[m.inn.recs.length - 1]; check('Cross throws in for the human fielder', threw); check('a direct hit with the batter short is a run out', last && last.wicket && last.wicket.how === 'run out', last && last.wicket);\n  // overthrows: a wild throw with nobody minding the stumps runs on\n  env = load({ seed: 12 }); env.game.advance(.3); env.D.startMatch({ humans: {}, seed: 12 }); env.game.advance(.1); m = env.D.match(); env.K.Tuning.persist = false; env.D.setTuning('throwError', 30);\n  let ot = 0; env.K.bus.on('field:overthrow', () => ot++); until(env.game, () => m.phase === 'done', 600, 1 / 30);\n  check('a missed shy with nobody backing up gives overthrows (throw error 30)', ot > 0, ot);\n  check('no errors', !env.game.errors.length, env.game.errors.map(e => e.message));\n}\nEOF\nnode test/run.mjs sim-batting sim-bowling sim-running-fielding","description":"Write and run batting, bowling, running and fielding sim suites","timeout":600000}},"wire_ingest_context":{"toolu_012E9vRJMayhAHR5j42yJngd":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-xhigh.build__20261104-062125__xe36ddc/work/CricketKerfuffle-Cricket-claude-opus-5-5-xhigh-20261104-062125"}}}
