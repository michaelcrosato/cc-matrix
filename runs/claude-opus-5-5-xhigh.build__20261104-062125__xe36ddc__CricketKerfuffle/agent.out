tgt = V3.add(J.handR, V3.mul(J.bladeDir, -2.4)), [el2, h3] = ik3(J.shL, tgt, o.armUpper, o.armLower, [-1, -.7, -.2]);\n      const gw = clamp(1 - (PW.cheer || 0) - (PW.wave || 0) - (this.hurtW || 0), 0, 1);\n      J.elbowL = V3.lerp(J.elbowL, el2, gw); J.handL = V3.lerp(J.handL, h3, gw);\n    }\n    const dw = this.downW || 0;\"\"\")\n# 1e draw bat in HD (after the sword block in _drawHD): find the HD sword block end\nhd_anchor = \"\"\"        px.disc(g, pom[0], pom[1], Math.max(.5, .6 * u - .35), h.base); px.dot(g, tip[0], tip[1], '#ffffff');\n      } });\n    }\n    ops.sort((a, b) => a.d - b.d);\"\"\"\nrep(hd_anchor, \"\"\"        px.disc(g, pom[0], pom[1], Math.max(.5, .6 * u - .35), h.base); px.dot(g, tip[0], tip[1], '#ffffff');\n      } });\n    }\n    if (o.weapon === 'bat') this._drawBat(g, Sp, J, Q.handR, u, ops);\n    ops.sort((a, b) => a.d - b.d);\"\"\")\ncl_anchor = \"\"\"          px.line(g, b0[0] + 1, b0[1], tip[0], tip[1], C.metalDk); px.line(g, b0[0], b0[1], tip[0], tip[1], C.metal); px.dot(g, tip[0], tip[1], '#ffffff');\n        }\n      });\n    }\n    ops.sort((a, b) => a.d - b.d);\"\"\"\nrep(cl_anchor, \"\"\"          px.line(g, b0[0] + 1, b0[1], tip[0], tip[1], C.metalDk); px.line(g, b0[0], b0[1], tip[0], tip[1], C.metal); px.dot(g, tip[0], tip[1], '#ffffff');\n        }\n      });\n    }\n    if (o.weapon === 'bat') this._drawBat(g, Sp, J, Q.handR, sc, ops);\n    ops.sort((a, b) => a.d - b.d);\"\"\")\n# the bat painter + pads + moustache, added before _hat\nrep(\"\"\"  _hat(g, Sp, J, r, H) {\n    const h = this.o.hat,\"\"\",\"\"\"  /** (Kerfuffle) a cricket bat: a flat willow blade along bladeDir from the bottom hand, a handle with a grip above it,\n   *  a darker edge, a toe and a sticker band; o.batLen (15: 5 handle, 10 blade), o.batScale (a giant bat), colors.willow,\n   *  colors.grip, colors.sticker */\n  _drawBat(g, Sp, J, Hn, u, ops) {\n    const o = this.o, C = this.C, hd = J.handR, bd = J.bladeDir, L = (o.batLen || 15) * (o.batScale || 1), wd = 1.7 * (o.batScale || 1);\n    const top = Sp(hd, -bd[0] * 3, -bd[1] * 3, -bd[2] * 3), sh = Sp(hd, bd[0] * (L * .3), bd[1] * (L * .3), bd[2] * (L * .3)), toe = Sp(hd, bd[0] * (L - 3), bd[1] * (L - 3), bd[2] * (L - 3));\n    const wt = tones(C.willow || '#e2c890'), gt = tones(C.grip || '#2f6b3a'), st = tones(C.sticker || '#c8202a');\n    ops.push({ d: (Hn[2] + toe[2]) / 2 + .01, f: () => {\n      const vx = toe[0] - sh[0], vy = toe[1] - sh[1], l = Math.hypot(vx, vy) || 1, ww = Math.max(.8, wd * u * .5), nx = -vy / l * ww, ny = vx / l * ww;\n      px.line(g, top[0], top[1], sh[0], sh[1], gt.sh, Math.max(1, Math.round(u * .65)));\n      px.line(g, top[0] - .5, top[1] - .5, lerp(top[0], sh[0], .7) - .5, lerp(top[1], sh[1], .7) - .5, gt.lt);\n      const q = [[sh[0] + nx * .7, sh[1] + ny * .7], [toe[0] + nx, toe[1] + ny], [toe[0] - nx, toe[1] - ny], [sh[0] - nx * .7, sh[1] - ny * .7]];\n      px.poly(g, q, wt.sh); px.poly(g, [[sh[0] + nx * .35, sh[1] + ny * .35], [toe[0] + nx * .5, toe[1] + ny * .5], [toe[0] - nx * .2, toe[1] - ny * .2], [sh[0] - nx * .2, sh[1] - ny * .2]], wt.base);\n      px.line(g, sh[0] + nx * .5 - .5, sh[1] + ny * .5 - .5, toe[0] + nx * .7 - .5, toe[1] + ny * .7 - .5, wt.hi);\n      const b0 = [lerp(sh[0], toe[0], .12), lerp(sh[1], toe[1], .12)], b1 = [lerp(sh[0], toe[0], .26), lerp(sh[1], toe[1], .26)];\n      px.line(g, b0[0], b0[1], b1[0], b1[1], st.base, Math.max(1, Math.round(ww * 1.4)));\n      px.line(g, toe[0] + nx, toe[1] + ny, toe[0] - nx, toe[1] - ny, wt.deep);\n    } });\n  }\n  _hat(g, Sp, J, r, H) {\n    const h = this.o.hat,\"\"\")\n# 2 brim hat + helmet grille + moustache: add styles in _hat\nrep(\"\"\"    } else if (st === 'crown') {\n      for (const k of [-1, 0, 1])\"\"\",\"\"\"    } else if (st === 'brim') {    // (Kerfuffle) an umpire's or sun hat: a crown and a wide brim all round\n      const t = Sp(J.head, -.2, 0, R * .75), cr = Sp(J.head, -.2, 0, R * 1.2);\n      px.ell(g, t[0], t[1] + 1, r * 1.55, Math.max(1, r * .45), dk); px.disc(g, cr[0], cr[1], r * .72, c); px.rect(g, cr[0] - r * .7, cr[1], r * 1.4, Math.max(1, r * .3), shade(c, -.15));\n      if (h.band) px.rect(g, cr[0] - r * .7, cr[1] + Math.max(1, r * .3) - 1, r * 1.4, 1, h.band);\n    } else if (st === 'crown') {\n      for (const k of [-1, 0, 1])\"\"\")\nrep(\"\"\"      const f = Sp(J.head, R * .75, 0, -.2); px.disc(g, f[0], f[1], r * .55, this.C.skin);\n    } else if (st === 'band') {\"\"\",\"\"\"      const f = Sp(J.head, R * .75, 0, -.2); px.disc(g, f[0], f[1], r * .55, this.C.skin);\n      if (h.grille) { const g0 = Sp(J.head, R * 1.15, 0, -R * .1), gg = tones(h.grille === true ? '#c8ccd4' : h.grille); for (const dz of [0, -R * .35]) { const a = Sp(J.head, R * 1.05, -R * .6, dz - R * .1), b = Sp(J.head, R * 1.05, R * .6, dz - R * .1); px.line(g, a[0], a[1], b[0], b[1], gg.base); } px.dot(g, g0[0], g0[1], gg.hi); }\n    } else if (st === 'band') {\"\"\")\nopen(p,'w').write(s)\nprint('ok bat/hat')\nEOF","description":"Patch engine: bat weapon, brim hat, helmet grille"}}}
