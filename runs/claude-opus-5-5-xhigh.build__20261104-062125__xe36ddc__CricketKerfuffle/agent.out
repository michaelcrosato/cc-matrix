&& I.clicked(); if (c && this.gateBtn && c[0] >= this.gateBtn[0] && c[0] < this.gateBtn[0] + this.gateBtn[2] && c[1] >= this.gateBtn[1] && c[1] < this.gateBtn[1] + this.gateBtn[3]) game.menu('settings'); return; }\n    if (this.state === 'press') { if (I.pressed('confirm') || I.pressed('start') || I.pressed('shot') || (I.clicked && I.clicked())) { I.consumeAll(); this.state = 'menu'; K.sfx('confirm'); } return; }\n    const L = this.sub || this.menu; L.update(dt, I);\n  },\n  back() { if (this.sub) { this.sub = null; return true; } if (this.state === 'menu') { this.state = 'press'; return true; } return false; },\n  draw(r) {\nsrc/50-front.js:13:  step(dt) { const P = K.game.players || [K.game.input]; if (P.some(I => this.any(I))) this.t = 0; else this.t += dt; if (P.some(I => I.anyPressed() && (I.lastDevice === 'gamepad' |\nsrc/50-front.js:17:const touchOnly = () => { try { return !matchMedia('(any-pointer: fine)').matches && (navigator.maxTouchPoints || 0) > 0 && !K.sawKeys; } catch (e) { return false; } };\nsrc/50-front.js:19:addEventListener('keydown', () => { K.sawKeys = true; });\nsrc/50-front.js:20:addEventListener('gamepadconnected', () => { K.sawKeys = true; });","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01Ezs7MfJvfJX7qAhCF67xow","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
