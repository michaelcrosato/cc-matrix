    if (m.phase === 'intro' && m.cfg.mode !== 'nets') r.overlay(g => { UI.panel(g, r.W / 2 - 140, 40, 280, 40); UI.text(g, m.ground.name.toUpperCase(), r.W / 2, 48, UI.gold, { align: 'center' }); UI.text(g, m.teams[m.bat].name + ' to bat', r.W / 2, 62, '#ffffff', { align: 'center' }); });\\n    if (!(this.talk && this.talk.open) && !(K.dev && K.dev.isOpen) && !card) Commentary.draw(r);\\n    if (this.extra && this.extra.draw) this.extra.draw(r, m);\"),\n(\"    if (m.phase === 'intro') r.overlay(g => { UI.panel(g, r.W / 2 - 140, 40, 280, 40); UI.text(g, m.ground.name.toUpperCase(), r.W / 2, 48, UI.gold, { align: 'center' }); UI.text(g, m.teams[m.bat].name + ' to bat', r.W / 2, 62, '#ffffff', { align: 'center' }); });\\n\",\"\"),\n(\"      sixes: tb ? tb.c.sixes : 0, targetLine:\",\"      sixes: tb ? (tb.c.sixes === 0 ? 'not a six among them' : tb.c.sixes === 1 ? 'one six' : tb.c.sixes + ' sixes') : 'no sixes', targetLine:\"),\n(\"    const a = fill(pool[0], vars), b = pool.length > 1 ? fill(pool[1 + (m.cfg.seed % (pool.length - 1))], vars) : '';\",\n \"    const lost = (all.find(i => i.bat === res.loser) || {}).wkts || 0, second = pool === REPORTS.win ? (lost >= 3 ? pool[1] : pool[2]) : pool[1];\\n    const a = fill(pool[0], vars), b = second ? fill(second, vars) : '';\"),\n])\npatch('src/17-data-lines.js',[\n(\"  win: ['{winner}, set {target}, were indebted to {topBat} ({topRuns}{notOut}, {sixes} sixes{targetLine}). Play was held up while {chaosThing} was persuaded off the square.',\",\n \"  win: ['{winner}, set {target}, were indebted to {topBat} ({topRuns}{notOut}, {sixes}{targetLine}). Play was held up while {chaosThing} was persuaded off the square.',\"),\n])\nprint('ok')\nEOF\ngrep -n \"ready = !!m.inn\" src/34-view.js | head -2; node tools/build.mjs --quiet && node .scratch/screens.mjs && node .scratch/sheet.mjs test/out/review6.png test/out/scr-toss.png test/out/scr-lesson.png","description":"Fix the toss draw crash, lesson overlays and report wording","timeo