ved && Math.hypot(x - g.x0, y - g.y0) > 4) { g.moved = true; g.mode = (!g.touch && g.button === 0) || (g.touch && g.long) ? 'box' : g.touch || g.button > 0 ? 'pan' : null; }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01MTpgsyqgjKQ6Fms4psYBZj","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
