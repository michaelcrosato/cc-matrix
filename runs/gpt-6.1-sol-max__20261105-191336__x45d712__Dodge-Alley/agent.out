{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('tests/run.mjs');s=p.read_text().replace(\\\"for(const [cmd,args]of suites){\\\", \\\"for(const [cmd,args]of suites){if(process.argv.includes('--browser')&&args[0].endsWith('core.mjs'))continue;if(process.argv.includes('--core')&&args[0].endsWith('browser.py'))continue;\\\")\np.write_text(s)\np=Path('tests/browser.py');s=p.read_text().replace(\\\"        page.screenshot(path=str(root/'tests/title.png'))\\\",\\\"\\\")\ns=s.replace(\\\"    if page.evaluate('\"'!!window.__dodge'\"'):\\\\n        def solo():\\\", \\\"    page.close()\\\\n    page=browser.new_page(viewport={'width':1920,'height':1080})\\\\n    errors=[]\\\\n    page.on('pageerror',lambda e: errors.append(str(e)))\\\\n    page.on('console',lambda e: errors.append(e.text) if e.type=='error' else None)\\\\n    page.goto((root/'index.html').as_uri()+'?test=1&webgl=1',wait_until='load')\\\\n    page.wait_for_function('window.__dodge?.ready',timeout=60000)\\\\n    page.evaluate('window.__dodge.idle(0)')\\\\n    page.screenshot(path=str(root/'tests/title.png'))\\\\n    if page.evaluate('\"'!!window.__dodge'\"'):\\\\n        def solo():\\\")\ns=s.replace(\\\"page.get_by_role('button',name='PLAY SOLO',exact=True).click()\\\", \\\"page.keyboard.press('ArrowUp')\\\\n            page.get_by_role('button',name='PLAY SOLO',exact=True).click(force=True)\\\")\np.write_text(s)\nPY\nnpm test -- --browser\"","aggregated_output":"npm notice run dodge-alley@1.0.0 test\nnpm notice run node tests/run.mjs --browser\nFAIL browser: title launches arcade gameplay — Locator.click: Timeout 30000ms exceeded.\n2 checks, 1 failures\n","exit_code":1,"status":"failed"}}
