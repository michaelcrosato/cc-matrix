{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"rg -n 'class ActiveCollisionTypes|setActiveCollisionTypes|setSensor|drainCollisionEvents|intersectionPair|setNextKinematicRotation' node_modules/@dimforge/rapier3d-compat/geometry/collider.d.ts node_modules/@dimforge/rapier3d-compat/pipeline/*.d.ts node_modules/@dimforge/rapier3d-compat/dynamics/rigid_body.d.ts && cat node_modules/@dimforge/rapier3d-compat/package.json && command -v bun && head -c 1000 hub/session.js\"","aggregated_output":"node_modules/@dimforge/rapier3d-compat/dynamics/rigid_body.d.ts:178:     * If this rigid-body is kinematic this value is set by the `setNextKinematicRotation`\nnode_modules/@dimforge/rapier3d-compat/dynamics/rigid_body.d.ts:252:    setNextKinematicRotation(rot: Rotation): void;\nnode_modules/@dimforge/rapier3d-compat/pipeline/world.d.ts:450:    intersectionPairsWith(collider1: Collider, f: (collider2: Collider) => void): void;\nnode_modules/@dimforge/rapier3d-compat/pipeline/world.d.ts:466:    intersectionPair(collider1: Collider, collider2: Collider): boolean;\nnode_modules/@dimforge/rapier3d-compat/pipeline/event_queue.d.ts:88:    drainCollisionEvents(f: (handle1: ColliderHandle, handle2: ColliderHandle, started: boolean) => void): void;\nnode_modules/@dimforge/rapier3d-compat/geometry/collider.d.ts:120:    setSensor(isSensor: boolean): void;\nnode_modules/@dimforge/rapier3d-compat/geometry/collider.d.ts:252:    setActiveCollisionTypes(activeCollisionTypes: ActiveCollisionTypes): void;\nnode_modules/@dimforge/rapier3d-compat/geometry/collider.d.ts:747:    setSensor(sensor: boolean): ColliderDesc;\nnode_modules/@dimforge/rapier3d-compat/geometry/collider.d.ts:866:    setActiveCollisionTypes(activeCollisionTypes: ActiveCollisionTypes): ColliderDesc;\n{\n  \"name\": \"@dimforge/rapier3d-compat\",\n  \"type\": \"module\",\n  \"collaborators\": [\n    \"Sébastien Crozet <developer@crozet.re>\"\n  ],\n  \"description\": \"3-dimensional physics engine in Rust - official JS bindings. Compatibility package with inlined webassembly as base64.\",\n  \"version\": \"0.19.3\",\n  \"license\": \"Apache-2.0\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"https://github.com/dimforge/rapier.js\"\n  },\n  \"files\": [\n    \"*\"\n  ],\n  \"main\": \"rapier.cjs\",\n  \"homepage\": \"https://rapier.rs\",\n  \"types\": \"rapier.d.ts\",\n  \"sideEffects\": [\n    \"./snippets/*\"\n  ],\n  \"keywords\": [\n    \"physics\",\n    \"dynamics\",\n    \"rigid\",\n    \"real-time\",\n    \"joints\"\n  ],\n  \"module\": \"rapier.mjs\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./rapier.d.ts\",\n      \"require\": \"./rapier.cjs\",\n      \"import\": \"./rapier.mjs\"\n    }\n  }\n}/home/micha/.bun/bin/bun\n/*! aihub-session 1.4.0 — AI Hub Session Protocol v1 client. Paste it into your game unmodified. */\n(function (root) {\n  'use strict';\n  if (root.AIHub) return;\n\n  var VERSION = '1.4.0';\n  var HELLO_EVERY_MS = 500;\n  var HELLO_TIMEOUT_MS = 10000;\n  var PROGRESS_EVERY_MS = 1000;\n  /** The hub's welcome may change these; a newer hub never needs a newer copy of this file for it. */\n  var limits = { maxBytes: 16384, ratePerS: 20, burst: 40 };\n\n  var framed = false;\n  try {\n    framed = root.parent && root.parent !== root;\n  } catch (e) {\n    framed = true;\n  }\n  var search = String(root.location && root.location.search);\n  var flagged = /[?&]aihub=/.test(search);\n  var seedArg = /[?&]aihub-seed=(\\d+)/.exec(search);\n\n  var hub = {\n    version: VERSION,\n    protocol: 1,\n    /** True when the hub launched this page for a session (?aihub=1 inside a frame). */\n    active: !!(flagged && framed),\n    me: null,\n    host: null,\n    isHost: false,\n    players: [],\n    mode: null,\n    seed: 0,\n    ","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > core.js <<'EOF'\nexport const DEFAULTS = Object.freeze({ playerSpeed: 11.5, enemySpeed: 8.2, boostMultiplier: 1.72, recharge: 9, gateWidth: 3.8, invincible: false, autopilot: false });\nexport const LEVELS = [\n  { name: 'THE NIGHT SHIFT', subtitle: 'Four lanes. One way out.', rivals: 1, speed: 1, color: '#ffbd69', radio: 'Keep your cool. Sweep the loop.' },\n  { name: 'RUSH HOUR', subtitle: 'Company coming. Mind the gaps.', rivals: 2, speed: 1.1, color: '#fc796b', radio: 'Two on your tail. Make that your nose.' },\n  { name: 'THE LAST LAUGH', subtitle: 'Three rivals. One clean getaway.', rivals: 3, speed: 1.19, color: '#a89aeb', radio: 'One last sweep. Bring it home\"'!'\"' },\n];\nexport const LANES = [0,1,2,3].map(i=>({ hx:18-i*2.4, hz:12.6-i*2.4, r:3.5-i*.12, count:32-i*4 }));\nexport const wrap = x => ((x % 1) + 1) % 1;\nexport const clamp = (x,a,b) => Math.max(a,Math.min(b,x));\nexport function rng(seed) { return () => { let t=seed+=0x6D2B79F5; t=Math.imul(t\"'^t>>>15,t|1); t''^=t+Math.imul(t''^t>>>7,t|61); return ((t''^t>>>14)>>>0)/4294967296; }; }\nexport function lengthOf(lane) { const a=typeof lane==='\"'number'?LANES[clamp(Math.round(lane),0,3)]:lane; return 4*(a.hx+a.hz-2*a.r)+2*Math.PI*a.r; }\nexport function trackPoint(u,lane=0) {\n  const a=typeof lane==='number'?LANES[clamp(Math.round(lane),0,3)]:lane;\n  const {hx,hz,r}=a, qf=wrap(u)*4, q=Math.floor(qf), quarter=lengthOf(a)/4;\n  let s=(qf-q)*quarter, first=q%2===0?hx-r:hz-r, arc=Math.PI*r/2;\n  const starts=[[0,-hz],[hx,0],[0,hz],[-hx,0]], dirs=[[1,0],[0,1],[-1,0],[0,-1]];\n  const corners=[[hx-r,-hz+r],[hx-r,hz-r],[-hx+r,hz-r],[-hx+r,-hz+r]];\n  let x,z,dx,dz;\n  if(s<first){ [dx,dz]=dirs[q]; x=starts[q][0]+dx*s; z=starts[q][1]+dz*s; }\n  else if(s<first+arc){ const angle=-Math.PI/2+q*Math.PI/2+(s-first)/r; x=corners[q][0]+Math.cos(angle)*r; z=corners[q][1]+Math.sin(angle)*r; dx=-Math.sin(angle); dz=Math.cos(angle); }\n  else { const end=dirs[(q+1)%4]; dx=end[0]; dz=end[1]; const endAngle=q*Math.PI/2; x=corners[q][0]+Math.cos(endAngle)*r+dx*(s-first-arc); z=corners[q][1]+Math.sin(endAngle)*r+dz*(s-first-arc); }\n  return {x,z,dx,dz,yaw:Math.atan2(dx,dz)};\n}\nexport function actorPoint(a) {\n  const p=trackPoint(a.u,a.lane), f=a.switchLeft>0 ? 1-a.switchLeft/.28 : 1;\n  if(a.switchLeft>0) { const p0=trackPoint(a.u,a.fromLane), t=f*f*(3-2*f); p.x=p0.x+(p.x-p0.x)*t; p.z=p0.z+(p.z-p0.z)*t; }\n  return p;\n}\nexport class Game {\n  constructor(R,onEvent=()=>{}) { this.R=R; this.onEvent=onEvent; this.tuning={...DEFAULTS}; this.phase='idle'; this.players=[]; this.rivals=[]; this.tokens=[]; this.debris=[]; this.elapsed=0; this.totalCollected=0; this.nearMisses=0; this.gatesTaken=0; this.boostTime=0; this.world=null; this.queue=null; this.serial=0; }\n  emit(type,data={}) { this.onEvent({type,...data}); }\n  start({mode='arcade',players=1,seed=1980,attract=false}={}) {\n    this.mode=mode; this.playerCount=players; this.random=rng(seed); this.seed=seed; this.attract=attract; this.stage=0; this.score=0; this.lives=players>1?4:3; this.elapsed=0; this.timeLeft=150; this.totalCollected=0; this.nearMisses=0; this.gatesTaken=0; this.boostTime=0; this.chain=0; this.multiplier=1; this.resultReported=false; this.buildStage(); this.phase='countdown'; this.wait=attract?.6:2.8; this.emit('start');\n  }\n  buildStage() {\n    const R=this.R; this.world?.free(); this.queue?.free(); this.world=new R.World({x:0,y:-18,z:0}); this.world.timestep=1/60; this.queue=new R.EventQueue(true); this.entities=new Map(); this.debris=[];\n    this.world.createCollider(R.ColliderDesc.cuboid(28,.3,22).setTranslation(0,-.55,0).setRestitution(.3));\n    this.tokens=[]; this.players=[]; this.rivals=[];\n    for(let lane=0;lane<4;lane++) for(let j=0;j<LANES[lane].count;j++) this.addToken(lane,(j+.5)/LANES[lane].count,'dot');\n    this.addToken(1,.125,'cell'); this.addToken(2,.625,'cell');\n    this.remaining=this.tokens.filter(t=>t.type==='dot').length; this.stageTotal=this.remaining;\n    for(let i=0;i<this.playerCount;i++) this.players.push(this.makeCar({id:i,lane:i===0?0:2,u:i===0?.01:.51,dir:1,enemy:false}));\n    const level=LEVELS[this.stage%3];\n    for(let i=0;i<level.rivals;i++) this.rivals.push(this.makeCar({id:i+10,lane:i%4,u:.43+i*.21,dir:-1,enemy:true}));\n    // Physical curb blocks catch the rigid-body crash debris.\n    for(let lane=0;lane<3;lane++){ const a=LANES[lane], b=LANES[lane+1], middle={hx:(a.hx+b.hx)/2,hz:(a.hz+b.hz)/2,r:(a.r+b.r)/2};\n      for(let j=0;j<64;j++){ const u=(j+.5)/64; if(Math.abs(u*4-Math.round(u*4))*lengthOf(middle)/4<2.3)continue; const p=trackPoint(u,middle); this.world.createCollider(R.ColliderDesc.cuboid(.1,.2,lengthOf(middle)/128).setTranslation(p.x,0,p.z).setRotation({x:0,y:Math.sin(p.yaw/2),z:0,w:Math.cos(p.yaw/2)})); }\n    }\n    this.emit('stage',{stage:this.stage,level});\n  }\n  addToken(lane,u,type) {\n    const R=this.R,p=trackPoint(u,lane),t={id:this.tokens.length,lane,u,type,taken:false,x:p.x,z:p.z};\n    t.collider=this.world.createCollider(R.ColliderDesc.ball(type==='cell'?.7:.6).setTranslation(p.x,.45,p.z).setSensor(true).setActiveCollisionTypes(R.ActiveCollisionTypes.ALL).setActiveEvents(R.ActiveEvents.COLLISION_EVENTS));\n    this.entities.set(t.collider.handle,{kind:'token',data:t}); this.tokens.push(t);\n  }\n  makeCar(data) {\n    const R=this.R,a={...data,fromLane:data.lane,switchLeft:0,lastGate:-999,queueDir:0,speed:0,boost:100,invuln:data.enemy?0:3,shield:0,spin:0,nearCooldown:0,input:{lane:0,boost:false,brake:false},gateCount:0};\n    const p=actorPoint(a); a.x=p.x;a.z=p.z;a.yaw=p.yaw+(a.dir<0?Math.PI:0);\n    a.body=this.world.createRigidBody(R.RigidBodyDesc.kinematicPositionBased().setTranslation(p.x,.45,p.z));\n    a.collider=this.world.createCollider(R.ColliderDesc.cuboid(.46,.3,.81).setSensor(true).setActiveCollisionTypes(R.ActiveCollisionTypes.ALL).setActiveEvents(R.ActiveEvents.COLLISION_EVENTS),a.body);\n    this.entities.set(a.collider.handle,{kind:data.enemy?'rival':'player',data:a}); return a;\n  }\n  setInput(id,input) { if(this.players[id])Object.assign(this.players[id].input,input); }\n  queueLane(id,direction) { const a=this.players[id]; if(a) a.queueDir=direction; }\n  autoInput(a) {\n    const counts=LANES.map((_,i)=>this.tokens.filter(t=>\"'!t.taken&&t.type==='\"'dot'&&t.lane===i).length);\n    let target=a.lane;\n    if(\"'!counts[target]) { let best=100; for(let i=0;i<4;i++)if(counts[i]&&Math.abs(i-a.lane)<best){best=Math.abs(i-a.lane);target=i;} }\n    let danger=this.rivals.some(b=>b.lane===a.lane&&wrap(b.u-a.u)<.12);\n    if(danger && !this.attract && !this.tuning.invincible){ const choices=[a.lane+1,a.lane-1].filter(i=>i>=0&&i<4); if(choices.length)target=choices.sort((l,r)=>counts[r]-counts[l])[0]; }\n    return {lane:Math.sign(target-a.lane),boost:!danger&&a.boost>35,brake:danger&&!this.attract&&!this.tuning.invincible};\n  }\n  tryLane(a,dir) {\n    if(!dir||a.switchLeft>0)return;\n    const k=Math.round(a.u*4), dist=Math.abs(a.u-k/4)*lengthOf(a.lane);\n    if(dist>this.tuning.gateWidth/2||a.lastGate===k)return;\n    const lane=clamp(a.lane+dir,0,3); if(lane===a.lane){a.queueDir=0;return;}\n    a.lastGate=k; a.fromLane=a.lane; a.lane=lane;a.switchLeft=.28;a.queueDir=0;\n    if(!a.enemy){this.gatesTaken++;this.emit('\"'switch',{actor:a});}\n  }\n  updateActor(a,dt) {\n    const level=LEVELS[this.stage%3];\n    a.invuln=Math.max(0,a.invuln-dt);a.shield=Math.max(0,a.shield-dt);a.spin=Math.max(0,a.spin-dt);a.nearCooldown=Math.max(0,a.nearCooldown-dt);a.switchLeft=Math.max(0,a.switchLeft-dt);\n    let desired;\n    if(a.enemy) {\n      desired=this.tuning.enemySpeed*level.speed*(a.id===12?1.12:1);\n      const k=Math.round(a.u*4),dist=Math.abs(a.u-k/4)*lengthOf(a.lane);\n      if(dist<this.tuning.gateWidth/2&&a.lastGate\"'!==k&&a.switchLeft===0){\n        const target=this.players.reduce((best,p)=>Math.abs(p.lane-a.lane)<Math.abs(best.lane-a.lane)?p:best,this.players[0]);\n        let dir=Math.sign(target.lane-a.lane);\n        if(this.stage===0&&a.gateCount++%2===0)dir=a.lane===0?1:-1;\n        if(!dir&&this.stage>0&&this.random()<.32)dir=this.random()<.5?-1:1;\n        this.tryLane(a,dir); a.lastGate=k;\n      }\n    } else {\n      const inp=(this.attract||this.tuning.autopilot)?this.autoInput(a):a.input;\n      if(inp.lane)a.queueDir=inp.lane;\n      this.tryLane(a,a.queueDir);\n      const boosting=inp.boost&&a.boost>1&&!inp.brake&&!a.spin;\n      a.boosting=boosting; desired=this.tuning.playerSpeed*(inp.brake?.44:boosting?this.tuning.boostMultiplier:1);\n      if(boosting){a.boost=Math.max(0,a.boost-33*dt);this.boostTime+=dt;}else a.boost=Math.min(100,a.boost+this.tuning.recharge*dt);\n      if(a.spin)desired*=.28;\n    }\n    a.speed+=(desired-a.speed)*(1-Math.exp(-dt*7));\n    a.u+=a.dir*a.speed/lengthOf(a.lane)*dt;\n    const p=actorPoint(a);a.x=p.x;a.z=p.z;a.yaw=p.yaw+(a.dir<0?Math.PI:0);\n    a.body.setNextKinematicTranslation({x:a.x,y:.45,z:a.z});a.body.setNextKinematicRotation({x:0,y:Math.sin(a.yaw/2),z:0,w:Math.cos(a.yaw/2)});\n  }\n  collect(a,t) {\n    if(t.taken)return;t.taken=true;this.world.removeCollider(t.collider,true);this.entities.delete(t.collider.handle);\n    if(t.type==='\"'cell'){a.boost=100;a.shield=4;this.score+=100;this.emit('cell',{actor:a,token:t});}\n    else {this.remaining--;this.totalCollected++;this.chain++;this.multiplier=Math.min(5,1+Math.floor(this.chain/16));this.score+=10*this.multiplier;a.boost=Math.min(100,a.boost+1.1);this.emit('token',{actor:a,token:t});}\n  }\n  crash(a,b) {\n    if(a.invuln>0||this.attract||this.tuning.invincible)return;\n    if(a.shield>0){a.shield=0;a.invuln=1.5;this.score+=200;this.spawnDebris(a.x,a.z);this.emit('deflect',{actor:a});return;}\n    this.lives--;this.chain=0;this.multiplier=1;a.invuln=3.2;a.spin=.65;a.boost=Math.max(15,a.boost-25);this.spawnDebris(a.x,a.z);this.emit('crash',{actor:a,rival:b});\n    if(this.lives<=0){this.phase='lost';this.emit('finish',{won:false});}\n  }\n  spawnDebris(x,z) {\n    const R=this.R;\n    for(let i=0;i<9;i++) {const r=this.random(),angle=this.random()*Math.PI*2;const body=this.world.createRigidBody(R.RigidBodyDesc.dynamic().setTranslation(x,.8+i*.04,z).setLinvel(Math.cos(angle)*(2+r*3),4+r*4,Math.sin(angle)*(2+r*3)).setAngvel({x:r*8,y:(r-.5)*12,z:r*7}).setLinearDamping(.4));this.world.createCollider(R.ColliderDesc.cuboid(.12,.12,.22).setRestitution(.6).setDensity(.4),body);this.debris.push({id:++this.serial,body,life:3,color:i%3});}\n  }\n  finishStage() {\n    this.score+=1000+this.lives*250;this.phase='stageclear';this.wait=this.attract?1.1:3.1;this.emit('clear',{stage:this.stage});\n  }\n  skipStage() { if(this.phase==='playing'){this.tokens.filter(t=>\"'!t.taken).forEach(t=>this.collect(this.players[0],t));this.finishStage();} }\n  tick(dt=1/60) {\n    if(['\"'idle','won','lost','ended'].includes(this.phase))return;\n    if(this.phase==='countdown'){this.wait-=dt;if(this.wait<=0){this.phase='playing';this.emit('go');}return;}\n    if(this.phase==='stageclear') {\n      this.wait-=dt;\n      if(this.wait<=0){this.stage++;if(this.stage>=3&&this.mode==='arcade'&&\"'!this.attract){this.phase='\"'won';this.emit('finish',{won:true});}else{this.buildStage();this.phase='countdown';this.wait=this.attract?.6:1.8;}}\n      return;\n    }\n    this.elapsed+=dt;\n    if(this.mode==='attack') {this.timeLeft=Math.max(0,this.timeLeft-dt);if(this.timeLeft<=0){this.phase='won';this.emit('finish',{won:true});return;}}\n    for(const a of [...this.players,...this.rivals])this.updateActor(a,dt);\n    this.world.step(this.queue);\n    const contacts=[]; this.queue.drainCollisionEvents((h1,h2,started)=>{if(started)contacts.push([this.entities.get(h1),this.entities.get(h2)]);});\n    for(let [a,b] of contacts){if(\"'!a||!b)continue;if(b.kind==='\"'player')[a,b]=[b,a];if(a.kind\"'!=='\"'player')continue;if(b.kind==='token')this.collect(a.data,b.data);if(b.kind==='rival')this.crash(a.data,b.data);}\n    for(const a of this.players){if(a.nearCooldown>0||a.spin)continue;for(const b of this.rivals){const d=Math.hypot(a.x-b.x,a.z-b.z);if(d<2.8&&d>1.25&&Math.abs(a.lane-b.lane)===1){a.nearCooldown=1.8;this.nearMisses++;this.score+=100*this.multiplier;a.boost=Math.min(100,a.boost+12);this.emit('near',{actor:a});break;}}}\n    for(let i=this.debris.length-1;i>=0;i--){const d=this.debris[i];d.life-=dt;if(d.life<=0){this.world.removeRigidBody(d.body);this.debris.splice(i,1);}}\n    if(this.remaining===0&&this.phase==='playing')this.finishStage();\n  }\n  snapshot() {return {phase:this.phase,mode:this.mode,stage:this.stage,score:this.score,lives:this.lives,remaining:this.remaining,stageTotal:this.stageTotal,timeLeft:this.timeLeft,elapsed:this.elapsed,multiplier:this.multiplier,chain:this.chain,totalCollected:this.totalCollected,nearMisses:this.nearMisses,gatesTaken:this.gatesTaken,boostTime:this.boostTime,players:this.players.map(a=>({id:a.id,lane:a.lane,u:wrap(a.u),boost:a.boost,invuln:a.invuln,shield:a.shield,speed:a.speed,queueDir:a.queueDir,x:a.x,z:a.z})),rivals:this.rivals.map(a=>({lane:a.lane,u:wrap(a.u),speed:a.speed})),tuning:{...this.tuning}};}\n  dispose(){this.world?.free();this.queue?.free();this.world=null;this.queue=null;}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > core.js <<'EOF'\nexport const DEFAULTS = Object.freeze({ playerSpeed: 11.5, enemySpeed: 8.2, boostMultiplier: 1.72, recharge: 9, gateWidth: 3.8, invincible: false, autopilot: false });\nexport const LEVELS = [\n  { name: 'THE NIGHT SHIFT', subtitle: 'Four lanes. One way out.', rivals: 1, speed: 1, color: '#ffbd69', radio: 'Keep your cool. Sweep the loop.' },\n  { name: 'RUSH HOUR', subtitle: 'Company coming. Mind the gaps.', rivals: 2, speed: 1.1, color: '#fc796b', radio: 'Two on your tail. Make that your nose.' },\n  { name: 'THE LAST LAUGH', subtitle: 'Three rivals. One clean getaway.', rivals: 3, speed: 1.19, color: '#a89aeb', radio: 'One last sweep. Bring it home\"'!'\"' },\n];\nexport const LANES = [0,1,2,3].map(i=>({ hx:18-i*2.4, hz:12.6-i*2.4, r:3.5-i*.12, count:32-i*4 }));\nexport const wrap = x => ((x % 1) + 1) % 1;\nexport const clamp = (x,a,b) => Math.max(a,Math.min(b,x));\nexport function rng(seed) { return () => { let t=seed+=0x6D2B79F5; t=Math.imul(t\"'^t>>>15,t|1); t''^=t+Math.imul(t''^t>>>7,t|61); return ((t''^t>>>14)>>>0)/4294967296; }; }\nexport function lengthOf(lane) { const a=typeof lane==='\"'number'?LANES[clamp(Math.round(lane),0,3)]:lane; return 4*(a.hx+a.hz-2*a.r)+2*Math.PI*a.r; }\nexport function trackPoint(u,lane=0) {\n  const a=typeof lane==='number'?LANES[clamp(Math.round(lane),0,3)]:lane;\n  const {hx,hz,r}=a, qf=wrap(u)*4, q=Math.floor(qf), quarter=lengthOf(a)/4;\n  let s=(qf-q)*quarter, first=q%2===0?hx-r:hz-r, arc=Math.PI*r/2;\n  const starts=[[0,-hz],[hx,0],[0,hz],[-hx,0]], dirs=[[1,0],[0,1],[-1,0],[0,-1]];\n  const corners=[[hx-r,-hz+r],[hx-r,hz-r],[-hx+r,hz-r],[-hx+r,-hz+r]];\n  let x,z,dx,dz;\n  if(s<first){ [dx,dz]=dirs[q]; x=starts[q][0]+dx*s; z=starts[q][1]+dz*s; }\n  else if(s<first+arc){ const angle=-Math.PI/2+q*Math.PI/2+(s-first)/r; x=corners[q][0]+Math.cos(angle)*r; z=corners[q][1]+Math.sin(angle)*r; dx=-Math.sin(angle); dz=Math.cos(angle); }\n  else { const end=dirs[(q+1)%4]; dx=end[0]; dz=end[1]; const endAngle=q*Math.PI/2; x=corners[q][0]+Math.cos(endAngle)*r+dx*(s-first-arc); z=corners[q][1]+Math.sin(endAngle)*r+dz*(s-first-arc); }\n  return {x,z,dx,dz,yaw:Math.atan2(dx,dz)};\n}\nexport function actorPoint(a) {\n  const p=trackPoint(a.u,a.lane), f=a.switchLeft>0 ? 1-a.switchLeft/.28 : 1;\n  if(a.switchLeft>0) { const p0=trackPoint(a.u,a.fromLane), t=f*f*(3-2*f); p.x=p0.x+(p.x-p0.x)*t; p.z=p0.z+(p.z-p0.z)*t; }\n  return p;\n}\nexport class Game {\n  constructor(R,onEvent=()=>{}) { this.R=R; this.onEvent=onEvent; this.tuning={...DEFAULTS}; this.phase='idle'; this.players=[]; this.rivals=[]; this.tokens=[]; this.debris=[]; this.elapsed=0; this.totalCollected=0; this.nearMisses=0; this.gatesTaken=0; this.boostTime=0; this.world=null; this.queue=null; this.serial=0; }\n  emit(type,data={}) { this.onEvent({type,...data}); }\n  start({mode='arcade',players=1,seed=1980,attract=false}={}) {\n    this.mode=mode; this.playerCount=players; this.random=rng(seed); this.seed=seed; this.attract=attract; this.stage=0; this.score=0; this.lives=players>1?4:3; this.elapsed=0; this.timeLeft=150; this.totalCollected=0; this.nearMisses=0; this.gatesTaken=0; this.boostTime=0; this.chain=0; this.multiplier=1; this.resultReported=false; this.buildStage(); this.phase='countdown'; this.wait=attract?.6:2.8; this.emit('start');\n  }\n  buildStage() {\n    const R=this.R; this.world?.free(); this.queue?.free(); this.world=new R.World({x:0,y:-18,z:0}); this.world.timestep=1/60; this.queue=new R.EventQueue(true); this.entities=new Map(); this.debris=[];\n    this.world.createCollider(R.ColliderDesc.cuboid(28,.3,22).setTranslation(0,-.55,0).setRestitution(.3));\n    this.tokens=[]; this.players=[]; this.rivals=[];\n    for(let lane=0;lane<4;lane++) for(let j=0;j<LANES[lane].count;j++) this.addToken(lane,(j+.5)/LANES[lane].count,'dot');\n    this.addToken(1,.125,'cell'); this.addToken(2,.625,'cell');\n    t