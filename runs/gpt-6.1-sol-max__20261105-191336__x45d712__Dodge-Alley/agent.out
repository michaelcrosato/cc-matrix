{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.js');s=p.read_text().replace(\\\"const TEST=new URLSearchParams(location.search).has('test');\\\", \\\"const TEST=new URLSearchParams(location.search).has('test');\\\\nlet testNoRender=TEST&&new URLSearchParams(location.search).has('headless');\\\")\ns=s.replace(\\\"\"'!['\"'won','lost','waiting'].includes(game.phase)\\\", \\\"\"'!['\"'won','lost','waiting','ended'].includes(game.phase)\\\")\ns=s.replace(\\\"view.render();sound.update\\\", \\\"if(\"'!testNoRender)view.render();sound.update\")\ns=s.replace(\"audioProbe:()=>sound.probe()\", \"setRendering(enabled){testNoRender=!enabled;if(enabled){view.update(game,0,!shouldTick());view.render();}},audioProbe:()=>sound.probe()\")\ns=s.replace(\"function renderLobby(){if(!net)return;\", \"function renderLobby(){if(!net)return;const live=new Set(net.players.map(p=>p.id));for(const [id,v]of view.ghosts){if(!live.has(id)){view.scene.remove(v.root);view.ghosts.delete(id);}}\")\np.write_text(s)\np=Path('\"'core.js');s=p.read_text().replace(\\\"return {phase:this.phase,mode:this.mode,stage:this.stage\\\", \\\"return {phase:this.phase,seed:this.seed,mode:this.mode,stage:this.stage\\\");p.write_text(s)\np=Path('tests/browser.py');s=p.read_text().replace(\\\"        records.append({'name':name,'pass':True})\\\", \\\"        records.append({'name':name,'pass':True})\\\\n        (root/'tests/browser-progress.json').write_text(json.dumps(records,indent=2))\\\").replace(\\\"        records.append({'name':name,'pass':False,'error':str(e)})\\\", \\\"        records.append({'name':name,'pass':False,'error':str(e)})\\\\n        (root/'tests/browser-progress.json').write_text(json.dumps(records,indent=2))\\\")\ns=s.replace(\\\"?test=1&webgl=1\\\", \\\"?test=1&webgl=1&headless=1\\\")\ns=s.replace(\\\"        page.screenshot(path=str(root/'tests/title.png'))\\\", \\\"        page.evaluate('window.__dodge.setRendering(true)')\\\\n        page.screenshot(path=str(root/'tests/title.png'))\\\\n        page.evaluate('window.__dodge.setRendering(false)')\\\")\ns=s.replace(\\\"        action(page,'pause')\\\\n        page.screenshot(path=str(root/'tests/game.png'))\\\\n        action(page,'resume')\\\", \\\"        page.evaluate('window.__dodge.setRendering(true)')\\\\n        page.screenshot(path=str(root/'tests/game.png'))\\\\n        page.evaluate('window.__dodge.setRendering(false)')\\\")\ns=s.replace(\\\"require('A' in page.locator('#playPrompts').inner_text(),page.locator('#playPrompts').inner_text())\\\", \\\"require(page.locator('#playPrompts .key.pad').first.inner_text()=='A',page.locator('#playPrompts').inner_text())\\\")\ns=s.replace(\\\"require(state(host)['seed']==state(guest)['seed'] if 'seed' in state(host) else True,'seed')\\\", \\\"require(state(host)['seed']==state(guest)['seed'],'seed')\\\")\ns=s.replace(\\\"'game':'../index.html?webgl=1'\\\", \\\"'game':'../index.html?webgl=1&test=1&headless=1'\\\")\ns=s.replace(\\\"        mobile.screenshot(path=str(root/'tests/touch-pause.png'))\\\", \\\"        mobile.evaluate('window.__dodge.setRendering(true)')\\\\n        mobile.screenshot(path=str(root/'tests/touch-pause.png'))\\\\n        mobile.evaluate('window.__dodge.setRendering(false)')\\\")\np.write_text(s)\nPY\nnpm run build\nnpm test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
