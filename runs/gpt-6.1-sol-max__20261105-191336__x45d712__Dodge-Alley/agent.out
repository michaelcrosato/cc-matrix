{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('shell.html');s=p.read_text().replace('.title-stamp{position:', '.title-stamp{text-align:center;position:');p.write_text(s)\np=Path('view.js');s=p.read_text().replace('Number(id)+1,false','(data.seat??0)+1,false');p.write_text(s)\np=Path('main.js');s=p.read_text().replace('online:net.online,players:net.players', 'online:net.online,links:net.links.size,players:net.players');p.write_text(s)\nPY\ncat > tests/browser.py <<'EOF'\nimport functools\nimport http.server\nimport json\nimport re\nimport threading\nimport urllib.parse\nimport urllib.request\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nroot=Path(__file__).resolve().parents[1]\ncount=0\nfailures=0\nrecords=[]\n\ndef check(name,fn):\n    global count,failures\n    try:\n        fn()\n        count+=1\n        records.append({'name':name,'pass':True})\n        return True\n    except Exception as e:\n        failures+=1\n        records.append({'name':name,'pass':False,'error':str(e)})\n        print('FAIL browser: '+name+' — '+str(e).replace('\\\\n',' ')[:1900],flush=True)\n        return False\n\ndef require(value,message):\n    if not value:\n        raise AssertionError(str(message))\n\ndef state(page):\n    return page.evaluate('window.__dodge.state')\n\ndef action(page,name):\n    page.evaluate('(name)=>window.__dodge.action(name)',name)\n\ndef advance(page,seconds):\n    return page.evaluate('(s)=>window.__dodge.advance(s)',seconds)\n\ndef ready(page,url):\n    page.set_default_timeout(9000)\n    page.goto(url,wait_until='load')\n    try:\n        page.wait_for_function('window.__dodge?.ready',timeout=60000)\n    except Exception:\n        raise AssertionError({'status':page.locator('#bootStatus').inner_text(),'error':page.locator('#bootError').inner_text()})\n    page.evaluate('window.__dodge.idle(-600000)')\n\ndef click(page,selector):\n    page.locator(selector).evaluate('(el)=>el.click()')\n\ndef slider(page,selector,value):\n    page.locator(selector).evaluate('(el,v)=>{el.value=v;el.dispatchEvent(new Event(\\\"input\\\",{bubbles:true}));}',str(value))\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self,*args):\n        pass\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(root)))\nserver.daemon_threads=True\nthread=threading.Thread(target=server.serve_forever,daemon=True)\nthread.start()\norigin='http://127.0.0.1:'+str(server.server_address[1])\nrequire('<title>Dodge Alley</title>' in urllib.request.urlopen(origin+'/index.html').read().decode(),'wrong loopback page')\ntry:\n with sync_playwright() as p:\n    browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--disable-dev-shm-usage'])\n    context=browser.new_context(viewport={'width':1920,'height':1080})\n    gpu=context.new_page()\n    gpu_errors=[]\n    gpu.on('pageerror',lambda e:gpu_errors.append(str(e)))\n    def gpu_boot():\n        ready(gpu,(root/'index.html').as_uri()+'?test=1')\n        s=state(gpu)\n        require(s['renderer']=='WebGPU',s)\n        require(s['screen']=='title' and s['renderCount']>0,s)\n        require(not gpu_errors,gpu_errors)\n    check('self-contained file boots with the WebGPU backend',gpu_boot)\n    gpu.close()\n    page=context.new_page()\n    js_errors=[]\n    page.on('pageerror',lambda e:js_errors.append(str(e)))\n    ready(page,(root/'index.html').as_uri()+'?test=1&webgl=1')\n    def defaults():\n        s=state(page)\n        require(s['musicVolume']==.1,s['musicVolume'])\n        require(s['renderer']=='WebGL2 fallback',s['renderer'])\n        require(page.locator('#title.active').count()==1,s)\n        page.screenshot(path=str(root/'tests/title.png'))\n    check('fallback, title layout and 10% music default',defaults)\n    def launch():\n        action(page,'quit')\n        page.locator('#title button[data-action=\\\"solo\\\"]').click(force=True)\n        advance(page,4)\n        require(state(page)['phase']=='playing',state(page))\n        action(page,'pause')\n        page.screenshot(path=str(root/'tests/game.png'))\n        action(page,'resume')\n    check('mouse title selection launches the arcade run',launch)\n    def keyboard():\n        before=state(page)\n        page.keyboard.down('a')\n        page.wait_for_timeout(180)\n        after=state(page)\n        page.keyboard.up('a')\n        require(after['players'][0]['queueDir']==1 or after['gatesTaken']>before['gatesTaken'],after)\n        page.keyboard.down(' ')\n        page.wait_for_timeout(180)\n        advance(page,.8)\n        page.keyboard.up(' ')\n        require(state(page)['boostTime']>0,state(page))\n    check('keyboard buffers a turn and fires turbo',keyboard)\n    def pause_freezes():\n        page.keyboard.press('Escape')\n        before=state(page)\n        require(before['screen']=='pause',before)\n        advance(page,5)\n        require(state(page)['elapsed']==before['elapsed'],state(page))\n    check('pause stops the simulation',pause_freezes)\n    page.evaluate('''() => {window.__pads=[{index:0,id:'DualSense test',mapping:'standard',connected:true,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))}];Object.defineProperty(navigator,'getGamepads',{configurable:true,value:()=>window.__pads});}''')\n    def pad_button(n,held=False):\n        page.evaluate('(n)=>{__pads[0].buttons[n]={pressed:true,value:1};}',n)\n        page.wait_for_timeout(180)\n        if not held:\n            page.evaluate('(n)=>{__pads[0].buttons[n]={pressed:false,value:0};}',n)\n            page.wait_for_timeout(120)\n    def pad_menus():\n        pad_button(13)\n        pad_button(0)\n        require(state(page)['screen']=='settings',state(page))\n        require(state(page)['lastInput']=='gamepad',state(page))\n        page.locator('#musicVolume').focus()\n        pad_button(15)\n        require(state(page)['settings']['music']==11,state(page))\n        slider(page,'#musicVolume',10)\n        click(page,'#glyphSetting')\n        pad_button(14)\n        require('A' in page.locator('#playPrompts').inner_text(),page.locator('#playPrompts').inner_text())\n        click(page,'#glyphSetting')\n        action(page,'back')\n        action(page,'resume')\n        pad_button(8,True)\n        pad_button(9)\n        require(state(page)['screen']=='',state(page))\n        page.evaluate('__pads[0].buttons[8]={pressed:false,value:0}')\n        pad_button(9)\n        require(state(page)['screen']=='pause',state(page))\n        page.evaluate('__pads=[]')\n    check('standard controller navigates menus, sliders and reserved chord',pad_menus)\n    def developer():\n        click(page,'#devButton')\n        require(state(page)['screen']=='dev',state(page))\n        slider(page,'#tune-playerSpeed',16)\n        slider(page,'#tune-enemySpeed',9)\n        require(state(page)['tuning']['playerSpeed']==16,state(page))\n        click(page,'#godButton')\n        click(page,'#autoButton')\n        action(page,'repair')\n        require(state(page)['tuning']['invincible'] and state(page)['tuning']['autopilot'],state(page))\n        action(page,'resetTuning')\n        require(state(page)['tuning']['playerSpeed']==11.5 and not state(page)['tuning']['invincible'],state(page))\n        click(page,'#godButton')\n        click(page,'#autoButton')\n        action(page,'resume')\n    check('garage applies live tuning, repair, assists and default reset',developer)\n    def campaign():\n        advance(page,500)\n        s=state(page)\n        require(s['phase']=='won' and s['screen']=='results',s)\n        require(s['totalCollected']==312,s)\n        require(s['stage']==3 and s['gatesTaken']>=9,s)\n        require(page.locator('#resultTitle').inner_text()=='CLEAN GETAWAY\"'!'\"',s)\n        require(int(page.locator('#resultTokens').inner_text())==312,s)\n    check('full browser campaign drives and clears all three shifts',campaign)\n    def audio():\n        result=page.evaluate('window.__dodge.audioProbe()')\n        require(result['finite'] and .005<result['rms']<.6 and .01<result['peak']<1,result)\n        require(result['duration']==2 and result['channels']==2,result)\n        page.wait_for_timeout(350)\n        require(state(page)['audio']['events']>0,state(page)['audio'])\n        (root/'tests/audio-probe.json').write_text(json.dumps(result,indent=2))\n    check('offline synth music, effects and gibberish produce finite audio',audio)\n    def attract_mode():\n        action(page,'resultBack')\n        page.evaluate('window.__dodge.idle(10001)')\n        page.wait_for_function('window.__dodge.state.attract')\n        advance(page,100)\n        require(state(page)['totalCollected']>104,state(page))\n        page.keyboard.press('Enter')\n        require(state(page)['screen']=='title' and not state(page)['attract'],state(page))\n    check('10-second attract mode drives stages and any input exits',attract_mode)\n    def about():\n        action(page,'about')\n        headings=[]\n        for i in range(7):\n            headings.append(page.locator('#aboutHeading').inner_text())\n            require(len(page.locator('#aboutContent').inner_text())>50,i)\n            action(page,'aboutNext')\n        require(set(headings)=={'SOURCE INFORMATION','TESTING FEEDBACK','ENGINE FEEDBACK','PROMPT FEEDBACK'},headings)\n        require(page.evaluate('window.__dodge.credits.sourceInformation.usage')=='added on import','usage')\n        action(page,'back')\n    check('About includes all source and feedback pages',about)\n    def keypad():\n        action(page,'together')\n        action(page,'joinRoom')\n        for n in '1274':\n            click(page,f'button[data-digit=\\\"{n}\\\"]')\n        require(page.locator('#joinCode').input_value()=='1274','keypad')\n        require(page.locator('#connectRoomButton').is_enabled(),'join button')\n        action(page,'erase')\n        require(page.locator('#joinCode').input_value()=='127','erase')\n        action(page,'back')\n        action(page,'back')\n    check('online code entry works entirely with focusable buttons',keypad)\n    def couch():\n        action(page,'together')\n        action(page,'coop')\n        page.evaluate('window.__dodge.tune({invincible:false,autopilot:false})')\n        advance(page,3)\n        before=state(page)\n        require(len(before['players'])==2 and before['lives']==4,before)\n        page.keyboard.down('a')\n        page.keyboard.down('ArrowRight')\n        page.wait_for_timeout(220)\n        after=state(page)\n        page.keyboard.up('a')\n        page.keyboard.up('ArrowRight')\n        require(after['players'][0]['queueDir']==1 or after['players'][0]['lane']==1,after)\n        require(after['players'][1]['queueDir']==-1 or after['players'][1]['lane']==1,after)\n    check('couch crew has two independently controlled cars and shared lives',couch)\n    check('no application JavaScript errors during the full UI flow',lambda:require(not js_errors,js_errors))\n    page.close()\n    context.close()\n\n    # Standalone multiplayer uses actual pages on the same verified loopback origin.\n    rooms=browser.new_context(viewport={'width':960,'height':600})\n    host=rooms.new_page()\n    guest=rooms.new_page()\n    ready(host,origin+'/index.html?test=1&webgl=1')\n    ready(guest,origin+'/index.html?test=1&webgl=1')\n    def room_join():\n        host.evaluate('window.__dodge.createRoom()')\n        code=state(host)['room']['code']\n        guest.evaluate('(code)=>window.__dodge.createRoom(code)',code)\n        host.wait_for_function('window.__dodge.state.room?.players.length===2')\n        guest.wait_for_function('window.__dodge.state.room?.players.length===2')\n        require(state(guest)['room']['connected'],state(guest))\n    joined=check('two standalone pages join the same room',room_join)\n    if joined:\n        def room_race():\n            action(host,'startRoom')\n            guest.wait_for_function('window.__dodge.state.runActive')\n            advance(host,4)\n            advance(guest,4)\n            host.wait_for_function('window.__dodge.state.room.ghosts===1')\n            guest.wait_for_function('window.__dodge.state.room.ghosts===1')\n            require(state(host)['mode']=='attack' and state(guest)['mode']=='attack','race mode')\n            require(state(host)['seed']==state(guest)['seed'] if 'seed' in state(host) else True,'seed')\n            require(host.locator('#devButton').evaluate('(e)=>e.classList.contains(\\\"hidden\\\")'),'race cheats')\n        check('standalone race starts in sync and exchanges visible ghosts',room_race)\n        def room_finish():\n            host.evaluate('window.__dodge.tune({invincible:true})')\n            guest.evaluate('window.__dodge.tune({invincible:true})')\n            advance(host,151)\n            advance(guest,151)\n            require(state(host)['phase']=='won' and state(guest)['phase']=='won','time limit')\n            host.wait_for_function('document.querySelectorAll(\\\"#resultRanks > div\\\").length===2')\n            require(guest.locator('#resultRanks > div').count()==2,'two results')\n            action(host,'resultBack')\n            guest.wait_for_function('window.__dodge.state.screen===\\\"lobby\\\"')\n            require(state(host)['screen']=='lobby','host rematch lobby')\n            (root/'tests/network-observation.json').write_text(json.dumps({'host':state(host)['room'],'guest':state(guest)['room']},indent=2))\n        check('both standalone racers finish, see scores and return to the lobby',room_finish)\n        def room_departure():\n            action(guest,'leaveRoom')\n            host.wait_for_function('window.__dodge.state.room.players.length===1')\n            guest.evaluate('(code)=>window.__dodge.createRoom(code)',state(host)['room']['code'])\n            guest.wait_for_function('window.__dodge.state.room?.players.length===2')\n            action(host,'leaveRoom')\n            guest.wait_for_function('window.__dodge.state.screen===\\\"title\\\" && \"'!window.__dodge.state.room'\"')\n        check('standalone guest and host departures clean up the room',room_departure)\n    rooms.close()\n\n    # Touchscreen emulation exercises real multitouch dispatch.\n    phone=browser.new_context(**p.devices['Pixel 7'])\n    mobile=phone.new_page()\n    ready(mobile,origin+'/index.html?test=1&webgl=1')\n    def touch():\n        mobile.locator('#title button[data-action=\\\"solo\\\"]').tap()\n        advance(mobile,3)\n        session=phone.new_cdp_session(mobile)\n        session.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':170,'y':580,'id':1},{'x':350,'y':620,'id':2}]})\n        session.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':95,'y':580,'id':1},{'x':350,'y':620,'id':2}]})\n        mobile.wait_for_timeout(350)\n        s=state(mobile)\n        require(s['lastInput']=='touch',s)\n        require(mobile.locator('body').evaluate('(e)=>e.classList.contains(\\\"touch-playing\\\")'),'touch UI')\n        require(s['players'][0]['queueDir']==1 or s['players'][0]['lane']==1,s)\n        require(s['boostTime']>0,s)\n        session.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n        mobile.locator('#pauseButton').tap()\n        require(state(mobile)['screen']=='pause',state(mobile))\n        mobile.screenshot(path=str(root/'tests/touch-pause.png'))\n    check('phone multitouch swipes lanes, boosts and opens the menu',touch)\n    phone.close()\n\n    # The official unmodified AI Hub harness validates the session contract.\n    harness=browser.new_context(viewport={'width':1440,'height':900})\n    for seats,scenario,latency,jitter,loss in [(2,'standard',0,0,0),(4,'standard',150,50,5),(4,'host-leave',150,50,5)]:\n        hp=harness.new_page()\n        label=f'official Hub: {seats} seats, {scenario}, {latency} ms, {loss}% loss'\n        def hub_case(hp=hp,seats=seats,scenario=scenario,latency=latency,jitter=jitter,loss=loss):\n            query=urllib.parse.urlencode({'game':'../index.html?webgl=1','players':seats,'auto':1,'scenario':scenario,'latency':latency,'jitter':jitter,'loss':loss,'play':6000})\n            hp.goto(origin+'/hub/harness.html?'+query,wait_until='load')\n            hp.wait_for_function('window.__hubCheck?.done',timeout=100000)\n            report=hp.evaluate('window.__hubCheck')\n            (root/f'tests/hub-{seats}-{scenario}.json').write_text(json.dumps(report,indent=2))\n            require(report['pass'],[c for c in report['checks'] if not c['pass']])\n            frames=[f for f in hp.frames if 'index.html' in f.url]\n            require(all(f.evaluate('\"'!window.__dodge || window.__dodge.state.hub.ended'\"') for f in frames),'end lifecycle')\n        check(label,hub_case)\n        hp.close()\n    harness.close()\n    browser.close()\nfinally:\n    server.shutdown()\n    server.server_close()\n    (root/'tests/browser-results.json').write_text(json.dumps({'count':count,'failures':failures,'checks':records},indent=2))\nprint(json.dumps({'suite':'browser','count':count,'failures':failures}))\nEOF\nnpm run build\nnpm test -- --browser\"","aggregated_output":"npm notice run dodge-alley@1.0.0 build\nnpm notice run node build.mjs\nBuilt Dodge-Alley-Dodge-Em-1980-gpt-6.1-sol-max-20261105-191336.html (3.11 MiB)\nnpm notice run dodge-alley@1.0.0 test\nnpm notice run node tests/run.mjs --browser\n","exit_code":143,"status":"failed"}}
