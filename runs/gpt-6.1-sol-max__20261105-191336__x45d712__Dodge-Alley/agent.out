{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.js');s=p.read_text().replace(\\\"progressClock=0,toastTimer=0\\\", \\\"progressClock=0,inputFrames=0,toastTimer=0\\\")\ns=s.replace(\\\"function pollPads(dt){const pads\\\", \\\"function pollPads(dt){inputFrames++;const pads\\\")\ns=s.replace(\\\"...game.snapshot(),screen,runActive\\\", \\\"...game.snapshot(),debug:TEST?{inputFrames,focus:{tag:document.activeElement?.tagName,id:document.activeElement?.id,action:document.activeElement?.dataset.action},keys:[...keys],input:game.players.map(a=>({...a.input}))}:undefined,screen,runActive\\\")\np.write_text(s)\np=Path('tests/run.mjs');s=p.read_text().replace(\\\"const suites=[[\\\", \\\"const suites=process.argv.includes('--input')?[['/home/micha/.local/share/pipx/venvs/playwright/bin/python',['tests/input-probe.py']]]:[[\\\")\np.write_text(s)\nPY\ncat > tests/input-probe.py <<'EOF'\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\nroot=Path(__file__).resolve().parents[1]\nlog=[]\ncount=0\nfailures=0\nwith sync_playwright() as p:\n b=p.chromium.launch(headless=True,args=['--disable-dev-shm-usage'])\n pg=b.new_page(viewport={'width':1280,'height':720})\n pg.goto((root/'index.html').as_uri()+'?test=1&webgl=1&headless=1')\n pg.wait_for_function('window.__dodge?.ready',timeout=60000)\n def record(label):\n  s=pg.evaluate('window.__dodge.state')\n  log.append({'label':label,'screen':s['screen'],'debug':s['debug'],'players':s['players']})\n def action(name):pg.evaluate('(n)=>__dodge.action(n)',name)\n def frames(n=2):\n  current=pg.evaluate('__dodge.state.debug.inputFrames')\n  pg.wait_for_function('(v)=>__dodge.state.debug.inputFrames>=v',arg=current+n,timeout=9000)\n def button(n):\n  pg.evaluate('(n)=>{__pads[0].buttons[n]={pressed:true,value:1}}',n)\n  frames()\n  record('button '+str(n)+' down')\n  pg.evaluate('(n)=>{__pads[0].buttons[n]={pressed:false,value:0}}',n)\n  frames()\n action('solo');pg.evaluate('__dodge.advance(4)');action('pause');record('paused')\n pg.evaluate(\\\"window.__pads=[{index:0,id:'test',mapping:'standard',connected:true,axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0}))}];Object.defineProperty(navigator,'getGamepads',{configurable:true,value:()=>__pads})\\\")\n button(13);record('after down')\n button(0);record('after cross')\n if pg.evaluate('__dodge.state.screen')\"'!='\"'settings':\n  print('FAIL input probe: menu did not open settings');failures+=1\n else:count+=1\n pg.evaluate('__pads=[]')\n action('quit');action('together');action('joinRoom');pg.locator('#joinCode').focus();record('join focused');action('back');action('back');action('together');action('coop');pg.evaluate('__dodge.advance(3)');record('couch starting')\n pg.keyboard.down('a');pg.keyboard.down('ArrowRight');frames();record('couch held');pg.keyboard.up('a');pg.keyboard.up('ArrowRight');frames();record('couch released')\n s=pg.evaluate('__dodge.state')\n if s['players'][0]['queueDir']\"'!=1 and s['\"'players'][0]['lane']\"'!=1:\n  print('\"'FAIL input probe: keyboard input not applied');failures+=1\n else:count+=1\n b.close()\n(root/'tests/input-probe.json').write_text(json.dumps(log,indent=2))\nprint(json.dumps({'suite':'input-probe','count':count,'failures':failures}))\nEOF\nnpm --silent test -- --input\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
