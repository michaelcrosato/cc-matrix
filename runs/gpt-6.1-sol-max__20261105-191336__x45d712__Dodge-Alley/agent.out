{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('main.js');s=p.read_text().replace(\\\"prompts();requestAnimationFrame(defaultFocus);\\\", \\\"prompts();if(\"'!name){document.activeElement?.blur();$('\"'world').focus({preventScroll:true});}else defaultFocus();\\\")\ns=s.replace(\\\"function showTitle(){if(hubInfo)return;\\\", \\\"function showTitle(){if(hubInfo)return;view.playerColor=0x92f1c7;view.playerNumber=1;\\\")\ns=s.replace(\\\"runActive=true;attract=false;stack=[];keys.clear();\\\", \\\"const me=hubInfo?hubInfo.players.find(p=>p.id===hubInfo.me):net?.players.find(p=>p.id===net.uid);view.playerColor=me?parseInt(me.color.slice(1),16):0x92f1c7;view.playerNumber=me?(me.seat??me.id)+1:1;runActive=true;attract=false;stack=[];keys.clear();\\\")\ns=s.replace(\\\"ghosts:view.ghosts.size}:null\\\", \\\"ghosts:view.ghosts.size,ghostData:[...view.ghosts].map(([id,v])=>({id,u:v.data.u,lane:v.data.lane,score:v.data.score}))}:null\\\")\ns=s.replace(\\\"setRendering(enabled){\\\", \\\"renderOnce(){view.update(game,0,\"'!shouldTick());view.render();},useWebRTCOnly(){net?.bc?.close();if(net)net.bc=null;},setRendering(enabled){\")\np.write_text(s)\np=Path('\"'shell.html');s=p.read_text().replace('<canvas id=\\\"world\\\"', '<canvas tabindex=\\\"0\\\" id=\\\"world\\\"');p.write_text(s)\np=Path('view.js');s=p.read_text().replace(\\\"(a.id===0?C.mint:C.gold),a.id+1,a.enemy\\\", \\\"(a.id===0?(this.playerColor??C.mint):C.gold),a.enemy?a.id+1:a.id===0?(this.playerNumber??1):2,a.enemy\\\")\np.write_text(s)\np=Path('tests/browser.py');s=p.read_text().replace(\\\"window.__dodge.setRendering(true)\\\",\\\"window.__dodge.renderOnce()\\\")\ns=s.replace(\\\"page.screenshot(path=str(root/'tests/title.png'))\\\", \\\"page.screenshot(path=str(root/'tests/title.png'),timeout=45000)\\\")\ns=s.replace(\\\"page.screenshot(path=str(root/'tests/game.png'))\\\", \\\"page.screenshot(path=str(root/'tests/game.png'),timeout=45000)\\\")\ns=s.replace(\\\"mobile.screenshot(path=str(root/'tests/touch-pause.png'))\\\", \\\"mobile.screenshot(path=str(root/'tests/touch-pause.png'),timeout=45000)\\\")\ns=s.replace(\\\"phone=browser.new_context(**p.devices['Pixel 7'])\\\", \\\"phone_options=dict(p.devices['Pixel 7']);phone_options['device_scale_factor']=1\\\\n    phone=browser.new_context(**phone_options)\\\")\ns=s.replace(\\\"        require(state(guest)['room']['connected'],state(guest))\\\", \\\"        require(state(guest)['room']['connected'],state(guest))\\\\n        host.wait_for_function('window.__dodge.state.room.links===1',timeout=30000)\\\\n        guest.wait_for_function('window.__dodge.state.room.links===1',timeout=30000)\\\\n        host.evaluate('window.__dodge.useWebRTCOnly()')\\\\n        guest.evaluate('window.__dodge.useWebRTCOnly()')\\\")\ns=s.replace(\\\"            require(state(host)['seed']==state(guest)['seed'],'seed')\\\", \\\"            require(state(host)['seed']==state(guest)['seed'],'seed')\\\\n            before=state(guest)['room']['ghostData'][0]['u']\\\\n            advance(host,1)\\\\n            guest.wait_for_function('(before)=>Math.abs(window.__dodge.state.room.ghostData[0].u-before)>.01',arg=before)\\\")\ns=s.replace(\\\"        page.evaluate('__pads=[]')\\\", \\\"        page.evaluate('__pads=[]')\\\")\np.write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
