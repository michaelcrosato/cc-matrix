template-columns:repeat(3,1fr);gap:1em;margin:1.5em 0}.stat{border-left:1px solid #4e5d6f;font-size:calc(var(--unit)*.62);color:var(--muted);letter-spacing:.06em}.stat:first-child{border-left:0}.stat b{display:block;color:var(--cream);font-family:Impact,sans-serif;font-size:2.6em;margin-bottom:.2em;letter-spacing:.02em}.race-scores{display:grid;gap:.4em;margin:1em 0;text-align:left}.race-scores>div{display:flex;justify-content:space-between;background:#24364a;padding:.6em 1em;font-size:calc(var(--unit)*.85)}.race-scores small{color:var(--muted)}.raceboard{position:fixed;top:21%;right:3vw;min-width:9em;z-index:2;pointer-events:none;font-size:calc(var(--unit)*.63);display:none}.raceboard>div{display:flex;gap:1em;justify-content:space-between;padding:.55em .6em;background:#111b2cdb;margin:.3em 0;border-left:3px solid}.about-grid{display:grid;gap:.9em;margin:1.6em 0;min-height:18em}.about-item{display:grid;grid-template-columns:10.5em 1fr;gap:1em;border-bottom:1px solid #344256;padding-bottom:.8em;font-size:calc(var(--unit)*.78);line-height:1.45}.about-item b{color:var(--mint);font-weight:700}.about-item span{color:#e1e0d5;font-weight:500}.about-feedback .about-item{display:block}.about-feedback .about-item b{display:block;margin-bottom:.3em}.page-counter{font-size:calc(var(--unit)*.7);color:var(--mint);white-space:nowrap;text-align:center}.about-foot{display:flex;align-items:center;gap:1em;justify-content:space-between}.about-foot button{font-size:calc(var(--unit)*.8)}#boot{position:fixed;inset:0;background:var(--ink);z-index:30;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.4em;text-align:center}.boot-word{font-family:Impact,sans-serif;font-size:clamp(60px,7vw,130px);letter-spacing:-.025em;color:var(--mint);transform:rotate(-3deg)}.boot-track{width:220px;height:4px;background:#3a4a5c;overflow:hidden}.boot-track i{display:block;height:100%;background:var(--mint);animation:loading 1.6s ease-in-out infinite}.boot-status{color:var(--muted);font-size:18px;max-width:70vw;line-height:1.5}.boot-error{display:none;max-width:700px;font-size:20px;font-weight:500;padding:20px}#touchBoost{position:fixed;right:5vw;bottom:10vh;border-radius:50%;width:4.7em;height:4.7em;padding:0;background:#92f1c722;border:2px solid #92f1c7bb;color:var(--mint);font-size:17px;z-index:4;display:none;box-shadow:none}body.touch-playing #touchBoost{display:block}body.touch-playing .controls-strip,body.touch-playing .boost-box,body.touch-playing .tokens-left,body.touch-playing .shift-block,body.touch-playing .score-label{display:none}body.touch-playing .hud-top{top:2vh}body.touch-playing .score-number{font-size:30px}body.touch-playing .hud-right{min-width:0}.touch-note{display:none}body.touch-device .touch-note{display:block}body.touch-device .desktop-note{display:none}.focus-row{display:flex;gap:.6em}.pill{display:inline-block;background:#92f1c718;color:var(--mint);padding:.4em .65em;border-radius:3px;border:1px solid #92f1c740;font-size:calc(var(--unit)*.6);letter-spacing:.12em}.hidden{display:none\"'!important}@keyframes loading{0%{width:0;transform:translateX(0)}50%{width:100%;transform:translateX(0)}100%{width:0;transform:translateX(220px)}}\n@media(max-aspect-ratio:4/3){.title-screen{padding:4vh 6vw;align-items:flex-end;background:linear-gradient(0deg,#111b2c 0%,#111b2cf9 28%,#111b2c8f 52%,transparent 72%)}.title-copy{width:100%;margin-bottom:5vh}h1{font-size:clamp(70px,14vw,150px);display:block;line-height:.8}h1 br{display:none}h1 span{margin-left:.12em}.title-copy .tagline{font-size:20px;max-width:none;margin:2vh 0}.title-buttons{max-width:none;grid-template-columns:1fr 1fr 1fr 1fr;gap:.6em}.title-buttons .primary{grid-column:span 4}.title-stamp{top:4vh;font-size:13px}.edition{margin-bottom:2vh}.title-buttons button{font-size:16px}.title-bottom{font-size:11px;bottom:1.8vh}.panel{width:90vw;padding:26px}h2{font-size:32px}.panel p{font-size:17px}.how-grid{gap:.6em}.how-card{padding:.8em}.how-card h3{font-size:18px}.how-card p{font-size:14px}.hud .shift-block{min-width:12em}.hud-top{left:3vw;right:3vw}.hud-bottom{bottom:2vh}.controls-strip{gap:.8em;font-size:11px}.score-number{font-size:34px}.shift-name{font-size:15px}.kicker{font-size:11px}.setting{font-size:16px}.setting button{font-size:14px}.about-item{font-size:15px}.about-grid{min-height:21em}.roster .seat{font-size:14px}.room-code{font-size:44px}.dev-layout{gap:1em}.boost-box{width:11em}.boost-label,.queue-label{font-size:10px}}\n@media(max-width:600px){:root{--unit:16px}.title-buttons{grid-template-columns:1fr 1fr}.title-buttons .primary{grid-column:span 2}.title-buttons .quiet{grid-column:span 2}.title-copy{margin-bottom:5vh}.title-stamp{width:6em;height:6em;right:6vw}.title-bottom span:last-child{display:none}.panel{padding:20px;max-height:91vh;overflow:auto}.panel.wide{width:94vw}.how-grid{grid-template-columns:1fr;gap:.4em;margin:.8em 0}.how-card{display:grid;grid-template-columns:2em 1fr;padding:.6em .9em;gap:0 .6em}.how-card b{grid-row:span 2;font-size:28px}.how-card h3{margin:0}.how-card p{margin:.25em 0 0;font-size:13px}.how-note{font-size:12px;padding:.6em}.panel .row{margin-top:1em}.panel .row button{font-size:14px}.together-grid{grid-template-columns:1fr;margin:.8em 0;gap:.7em}.together-card{padding:1em}.together-card p{min-height:0;font-size:14px;margin:.1em 0 .5em}.together-card h3{font-size:24px}.together-card button{font-size:15px}.dev-layout{grid-template-columns:1fr}.settings-grid{gap:.4em;margin:.8em 0}.setting{font-size:14px;min-height:2.6em;padding-bottom:.3em}.setting button{font-size:13px;min-width:9em}.dev-actions{grid-template-columns:1fr 1fr;gap:.5em;margin:0}.dev-actions button{font-size:12px}.dev-status{display:none}.about-item{grid-template-columns:7.1em 1fr;font-size:13px;gap:.5em}.about-grid{gap:.7em;min-height:22em;margin:1.2em 0}.about-feedback .about-item{font-size:14px}.about-foot{gap:.5em}.about-foot button{font-size:12px;padding:.8em}.page-counter{font-size:12px}.roster{grid-template-columns:1fr 1fr}.roster .seat{min-height:4em;padding:.7em}.result-panel h2{font-size:36px}.result-score{font-size:68px}.stats{gap:.4em}.stat{font-size:10px}.result-panel .lead{font-size:15px}.room-head{margin:.5em 0}.room-code{font-size:40px}.shift-block{display:none}.hud-right{min-width:0;gap:.6em}.score-block{min-width:0}.lives{font-size:17px;gap:.2em}.pause-button{font-size:18px}.controls-strip{display:none}.run-clock{font-size:28px}.callout strong{font-size:42px}.callout small{font-size:14px;max-width:90vw;margin:.6em auto}.toast{font-size:18px;left:5%;right:5%;top:18%}.raceboard{font-size:10px;top:14%;right:3vw}.demo-bottom{font-size:14px;padding:1em}.demo-tag{font-size:13px}.nav-hint{display:none}.boost-box{max-width:40vw}.menu-stack{gap:.6em;margin-top:1em}.menu-stack button{font-size:16px}.how-controls{font-size:12px!important}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<canvas id=\"world\" aria-label=\"Dodge Alley game arena\"></canvas>\n<div id=\"boot\"><div class=\"boot-word\">DODGE ALLEY.</div><div class=\"boot-track\"><i></i></div><div class=\"boot-status\" id=\"bootStatus\">Warming up the night shift…</div><div class=\"boot-error\" id=\"bootError\"></div></div>\n<div id=\"hud\" class=\"hud\">\n <div class=\"hud-top\"><div class=\"score-block\"><div class=\"score-label\">NIGHT'\"'S TAKINGS</div><div class=\\\"score-number\\\"><span id=\\\"score\\\">000 000</span><span class=\\\"multiplier\\\" id=\\\"multiplier\\\">×1</span></div><div class=\\\"tokens-left\\\" id=\\\"tokensLeft\\\">● 104 TOKENS LEFT</div></div><div class=\\\"shift-block\\\"><div class=\\\"shift-number\\\" id=\\\"shiftNumber\\\">SHIFT 01 / 03</div><div class=\\\"shift-name\\\" id=\\\"shiftName\\\">THE NIGHT SHIFT</div><div class=\\\"shift-progress\\\"><i id=\\\"shiftProgress\\\"></i></div></div><div class=\\\"hud-right\\\"><div class=\\\"lives\\\" id=\\\"lives\\\" aria-label=\\\"Lives\\\"></div><button id=\\\"pauseButton\\\" class=\\\"pause-button\\\" data-action=\\\"pause\\\" aria-label=\\\"Pause\\\">Ⅱ</button></div></div>\n <div class=\\\"hud-bottom\\\"><div class=\\\"boost-box\\\"><div class=\\\"queue-label\\\" id=\\\"queueLabel\\\">AUTO-DRIVE · FIND A GAP</div><div class=\\\"boost-label\\\"><span>1 / TURBO</span><span id=\\\"boostAmount\\\">100%</span></div><div class=\\\"boost-bar\\\"><i id=\\\"boostBar\\\"></i></div></div><div class=\\\"controls-strip\\\" id=\\\"playPrompts\\\"></div><div class=\\\"boost-box hidden\\\" id=\\\"p2Boost\\\"><div class=\\\"queue-label\\\" id=\\\"p2Queue\\\">DRIVER 2</div><div class=\\\"boost-label\\\"><span>2 / TURBO</span><span id=\\\"p2BoostAmount\\\">100%</span></div><div class=\\\"boost-bar\\\"><i id=\\\"p2BoostBar\\\" style=\\\"background:var(--gold)\\\"></i></div></div><div class=\\\"run-clock hidden\\\" id=\\\"runClock\\\">2:30</div></div>\n</div>\n<div id=\\\"callout\\\" class=\\\"callout\\\"><strong id=\\\"calloutTitle\\\"></strong><small id=\\\"calloutSubtitle\\\"></small></div>\n<div id=\\\"toast\\\" class=\\\"toast\\\" role=\\\"status\\\"></div><div id=\\\"raceboard\\\" class=\\\"raceboard\\\"></div>\n<button id=\\\"touchBoost\\\" aria-label=\\\"Hold to boost\\\">BOOST<br>↟</button>\n<section id=\\\"title\\\" class=\\\"screen title-screen\\\" aria-label=\\\"Title menu\\\">\n <div class=\\\"title-copy\\\"><div class=\\\"edition\\\"><i class=\\\"dot\\\"></i> AFTER HOURS · EST. 1980</div><h1>DODGE<br><span>ALLEY.</span></h1><p class=\\\"tagline\\\">Good drivers take turns.<br>Great drivers take the gaps.</p><div class=\\\"title-buttons\\\"><button class=\\\"primary\\\" data-action=\\\"solo\\\" autofocus>PLAY SOLO <b>↗</b></button><button data-action=\\\"together\\\">PLAY TOGETHER</button><button data-action=\\\"how\\\">HOW TO PLAY</button><button data-action=\\\"settings\\\">SETTINGS</button><button class=\\\"quiet\\\" data-action=\\\"about\\\">ABOUT & CREDITS ↗</button></div></div><div class=\\\"title-stamp\\\">FOUR LANES<b>ALL</b>NIGHT LONG</div><div class=\\\"title-bottom\\\"><span id=\\\"titleDevice\\\">KEYBOARD + MOUSE READY</span><span id=\\\"bestScore\\\">BEST 000 000</span><span>A LITTLE NERVE. A LOT OF LEFT TURNS.</span></div>\n</section>\n<section id=\\\"attract\\\" class=\\\"screen attract-screen\\\" aria-label=\\\"Attract mode\\\"><div class=\\\"demo-tag\\\">AFTER-HOURS DEMO ↗</div><div class=\\\"demo-bottom\\\">PRESS ANY BUTTON TO TAKE THE WHEEL<small>AUTOPILOT ON · BUMPERS UNLIMITED</small></div></section>\n<section id=\\\"pause\\\" class=\\\"screen overlay\\\" aria-label=\\\"Pause menu\\\"><div class=\\\"panel\\\"><div class=\\\"kicker\\\">PARK IT FOR A MINUTE</div><h2>TAKE A BREATHER.</h2><p class=\\\"lead\\\" id=\\\"pauseDescription\\\">The road can wait.</p><div class=\\\"menu-stack\\\"><button class=\\\"primary\\\" data-action=\\\"resume\\\">BACK TO THE ROAD <span>↗</span></button><button data-action=\\\"settings\\\">SETTINGS <span>+</span></button><button data-action=\\\"how\\\">HOW TO PLAY <span>?</span></button><button data-action=\\\"dev\\\" id=\\\"devButton\\\">DEVELOPER GARAGE <span>⚙</span></button><button data-action=\\\"restart\\\" id=\\\"restartButton\\\">RESTART THE RUN <span>↺</span></button><button class=\\\"quiet\\\" data-action=\\\"quit\\\" id=\\\"quitButton\\\">RETURN TO TITLE</button></div></div></section>\n<section id=\\\"how\\\" class=\\\"screen overlay\\\" aria-label=\\\"How to play\\\"><div class=\\\"panel wide\\\"><div class=\\\"kicker\\\">THE CAR DRIVES ITSELF. THE NERVE IS YOURS.</div><h2>MAKE THE GAPS.</h2><p class=\\\"lead\\\">Sweep every gold token. Survive three shifts. Keep your bumpers.</p><div class=\\\"how-grid\\\"><div class=\\\"how-card\\\"><b>01</b><h3>PICK YOUR LANE</h3><p>Left goes inward. Right goes outward. Tap early to queue a turn at the next mint crossover.</p></div><div class=\\\"how-card\\\"><b>02</b><h3>PLAY IT COOL</h3><p>Rivals come the other way. Brake to let trouble pass. Boost to slip through before it arrives.</p></div><div class=\\\"how-card\\\"><b>03</b><h3>MAKE IT COUNT</h3><p>Tokens build your multiplier, up to ×5. Close shaves earn extra points. A bump breaks your streak.</p></div></div><div class=\\\"how-note\\\"><span class=\\\"cell-icon\\\"></span><span>Mint power cells refill turbo and give 4 seconds of shield. Turbo also recharges on its own.</span></div><p id=\\\"howControls\\\" class=\\\"how-controls small-copy desktop-note\\\"></p><p class=\\\"small-copy touch-note\\\">Swipe left or right anywhere to queue a lane. Hold the right side to boost. Gentle auto-braking helps you dodge.</p><p class=\\\"small-copy\\\" id=\\\"coopHow\\\">Couch team: share tokens and lives. Driver 1 uses A/D, Space, S. Driver 2 uses ←/→, Enter, ↓. Two controllers work too.</p><div class=\\\"row\\\"><button class=\\\"quiet\\\" data-action=\\\"back\\\">← BACK</button><button class=\\\"primary\\\" data-action=\\\"howPlay\\\">LET'S DRIVE ↗</button></div></div></section>\n<section id=\\\"settings\\\" class=\\\"screen overlay\\\" aria-label=\\\"Settings\\\"><div class=\\\"panel\\\"><div class=\\\"kicker\\\">YOUR KIND OF NIGHT</div><h2>FINE TUNING.</h2><div class=\\\"settings-grid\\\"><div class=\\\"setting\\\"><label for=\\\"musicVolume\\\">Music</label><input id=\\\"musicVolume\\\" type=\\\"range\\\" min=\\\"0\\\" max=\\\"100\\\" step=\\\"1\\\" value=\\\"10\\\" aria-label=\\\"Music volume\\\"><output id=\\\"musicOutput\\\">10%</output></div><div class=\\\"setting\\\"><label for=\\\"effectsVolume\\\">Sound & voices</label><input id=\\\"effectsVolume\\\" type=\\\"range\\\" min=\\\"0\\\" max=\\\"100\\\" step=\\\"1\\\" value=\\\"70\\\" aria-label=\\\"Effects volume\\\"><output id=\\\"effectsOutput\\\">70%</output></div><div class=\\\"setting\\\"><label>Controller prompts</label><button id=\\\"glyphSetting\\\" data-action=\\\"glyphs\\\">PLAYSTATION</button></div><div class=\\\"setting\\\"><label>Camera</label><button id=\\\"cameraSetting\\\" data-action=\\\"camera\\\">ARCADE ANGLE</button></div><div class=\\\"setting\\\"><label>Motion effects</label><button id=\\\"motionSetting\\\" data-action=\\\"motion\\\">FULL</button></div><div class=\\\"setting\\\"><label>Display</label><button data-action=\\\"fullscreen\\\">TOGGLE FULLSCREEN</button></div></div><button class=\\\"primary\\\" data-action=\\\"back\\\" style=\\\"width:100%\\\">ALL SET ↗</button></div></section>\n<section id=\\\"dev\\\" class=\\\"screen overlay\\\" aria-label=\\\"Developer mode\\\"><div class=\\\"panel dev-panel\\\"><div class=\\\"kicker\\\">DEVELOPER GARAGE · LIVE CONTROLS</div><h2>POP THE HOOD.</h2><div class=\\\"dev-layout\\\"><div class=\\\"settings-grid\\\" id=\\\"tuningSliders\\\"></div><div><div class=\\\"dev-actions\\\"><button data-action=\\\"god\\\" id=\\\"godButton\\\">INVINCIBLE: OFF</button><button data-action=\\\"auto\\\" id=\\\"autoButton\\\">AUTOPILOT: OFF</button><button data-action=\\\"repair\\\">REPAIR & REFILL</button><button data-action=\\\"skip\\\">CLEAR THIS SHIFT</button><button data-action=\\\"nextStage\\\">LOAD NEXT SHIFT</button><button data-action=\\\"resetTuning\\\">RESET TO DEFAULTS</button></div><div class=\\\"dev-status\\\" id=\\\"devStatus\\\"></div></div></div><div class=\\\"row\\\"><button class=\\\"quiet\\\" data-action=\\\"back\\\">← PAUSE MENU</button><button class=\\\"primary\\\" data-action=\\\"resume\\\">TEST DRIVE ↗</button></div></div></section>\n<section id=\\\"together\\\" class=\\\"screen overlay\\\" aria-label=\\\"Multiplayer\\\"><div class=\\\"panel wide\\\"><div class=\\\"kicker\\\">A LITTLE FRIENDLY TRAFFIC</div><h2>BETTER WITH COMPANY.</h2><div class=\\\"together-grid\\\"><div class=\\\"together-card\\\"><span class=\\\"pill\\\">1 SCREEN · 2 DRIVERS</span><h3>COUCH CREW</h3><p>Same streets. Shared tokens and bumpers. Two cars are better than one.</p><button class=\\\"primary\\\" data-action=\\\"coop\\\">START A TEAM RUN ↗</button></div><div class=\\\"together-card\\\"><span class=\\\"pill\\\">2–4 SCREENS · GHOST RACE</span><h3>NIGHT RIVALS</h3><p>Two and a half minutes. Matching streets. Highest score buys breakfast.</p><div class=\\\"row\\\"><button class=\\\"primary\\\" data-action=\\\"createRoom\\\">HOST ROOM</button><button data-action=\\\"joinRoom\\\">JOIN ROOM</button></div></div></div><p class=\\\"small-copy\\\">Ghosts show your friends without bumping into them. AI Hub sessions start a ghost race automatically.</p><button class=\\\"quiet\\\" data-action=\\\"back\\\">← BACK</button></div></section>\n<section id=\\\"join\\\" class=\\\"screen overlay\\\" aria-label=\\\"Join online room\\\"><div class=\\\"panel\\\" style=\\\"max-width:560px\\\"><div class=\\\"kicker\\\">FOLLOW YOUR FRIENDS INTO TROUBLE</div><h2>GOT A CODE?</h2><input id=\\\"joinCode\\\" class=\\\"join-code\\\" inputmode=\\\"numeric\\\" pattern=\\\"[0-9]*\\\" maxlength=\\\"4\\\" placeholder=\\\"0000\\\" autocomplete=\\\"off\\\" aria-label=\\\"Four digit room code\\\"><div class=\\\"keypad\\\"><button data-digit=\\\"1\\\">1</button><button data-digit=\\\"2\\\">2</button><button data-digit=\\\"3\\\">3</button><button data-digit=\\\"4\\\">4</button><button data-digit=\\\"5\\\">5</button><button data-digit=\\\"6\\\">6</button><button data-digit=\\\"7\\\">7</button><button data-digit=\\\"8\\\">8</button><button data-digit=\\\"9\\\">9</button><button data-action=\\\"erase\\\">⌫ <small>ERASE</small></button><button data-digit=\\\"0\\\">0</button><button class=\\\"primary\\\" data-action=\\\"connectRoom\\\" id=\\\"connectRoomButton\\\" disabled>JOIN ↗</button></div><button class=\\\"quiet\\\" data-action=\\\"back\\\" style=\\\"width:100%;margin-top:1em\\\">← BACK</button></div></section>\n<section id=\\\"lobby\\\" class=\\\"screen overlay\\\" aria-label=\\\"Online lobby\\\"><div class=\\\"panel wide\\\"><div class=\\\"kicker\\\">NIGHT RIVALS · 2–4 DRIVERS</div><h2>MEET YOU IN THE ALLEY.</h2><div class=\\\"room-head\\\"><div><div class=\\\"small-copy\\\">SHARE THIS ROOM CODE</div><div class=\\\"room-code\\\" id=\\\"roomCode\\\">----</div></div><button data-action=\\\"copyCode\\\">COPY CODE ↗</button></div><div class=\\\"roster\\\" id=\\\"roster\\\"></div><p class=\\\"room-status\\\" id=\\\"roomStatus\\\">Opening the room…</p><div class=\\\"how-note\\\">150 SECONDS · SAME STREETS · FRIENDLY GHOSTS · HIGHEST SCORE WINS</div><div class=\\\"row\\\"><button class=\\\"quiet\\\" data-action=\\\"leaveRoom\\\">← LEAVE ROOM</button><button class=\\\"primary\\\" data-action=\\\"startRoom\\\" id=\\\"startRoomButton\\\" disabled>WAITING FOR DRIVERS</button></div></div></section>\n<section id=\\\"results\\\" class=\\\"screen overlay\\\" aria-label=\\\"Results\\\"><div class=\\\"panel wide result-panel\\\"><div class=\\\"kicker\\\" id=\\\"resultKicker\\\">THAT'S A WRAP</div><h2 id=\\\"resultTitle\\\">CLEAN GETAWAY\"'!</h2><p class=\"lead\" id=\"resultCopy\">The night is yours. Diner'\"'s on the house.</p><div class=\\\"result-score\\\" id=\\\"resultScore\\\">000 000</div><div class=\\\"best-line\\\" id=\\\"resultBest\\\">PERSONAL BEST</div><div class=\\\"stats\\\"><div class=\\\"stat\\\"><b id=\\\"resultTokens\\\">0</b>TOKENS SCOOPED</div><div class=\\\"stat\\\"><b id=\\\"resultNear\\\">0</b>CLOSE SHAVES</div><div class=\\\"stat\\\"><b id=\\\"resultGaps\\\">0</b>GAPS TAKEN</div></div><div class=\\\"race-scores\\\" id=\\\"resultRanks\\\"></div><div class=\\\"row\\\" id=\\\"resultActions\\\"><button class=\\\"quiet\\\" data-action=\\\"resultBack\\\" id=\\\"resultBack\\\">TITLE SCREEN</button><button class=\\\"primary\\\" data-action=\\\"again\\\" id=\\\"againButton\\\">RUN IT BACK ↗</button></div></div></section>\n<section id=\\\"about\\\" class=\\\"screen overlay\\\" aria-label=\\\"About and credits\\\"><div class=\\\"panel wide\\\"><div class=\\\"kicker\\\">DODGE ALLEY · BUILT AFTER HOURS</div><h2 id=\\\"aboutHeading\\\">SOURCE INFORMATION</h2><div class=\\\"about-grid\\\" id=\\\"aboutContent\\\"></div><div class=\\\"about-foot\\\"><button class=\\\"quiet\\\" data-action=\\\"back\\\">← BACK</button><button data-action=\\\"aboutPrev\\\">← PREVIOUS</button><span class=\\\"page-counter\\\" id=\\\"aboutPage\\\">1 / 7</span><button class=\\\"primary\\\" data-action=\\\"aboutNext\\\">NEXT →</button></div></div></section>\n<div class=\\\"nav-hint hidden\\\" id=\\\"navHint\\\"></div>\n<script id=\\\"creditsData\\\" type=\\\"application/json\\\"><\"'!--CREDITS--></script>\n<script type=\"module\"><!--GAME--></script>\n</body>\n</html>\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"agent_message","text":"The core rules now include queued turns at the four crossovers, token streaks, boost, braking, shield cells, and shared couch-team lives. I’m finishing the controller and touch controls, then I’ll test complete runs and the AI Hub protocol."}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {Game,DEFAULTS,LEVELS,LANES,clamp,wrap} from './core.js';\nimport {View} from './view.js';\nimport {Sound} from './audio.js';\nimport {RoomNet} from './net.js';\nconst \"'$=id=>document.getElementById(id), hub=window.AIHub;\nconst TEST=new URLSearchParams(location.search).has('\"'test');\nlet game,view,ready=false,screen='title',stack=[],lastInput='keyboard',lastActivity=performance.now(),runActive=false,attract=false,net=null,netScores=new Map(),hubInfo=null,hubStarted=false,hubRunning=false,hubEnded=false,hubReported=false,remoteClock=0,progressClock=0,toastTimer=0,goTimer=0,lastFrame=0,accumulator=0,mouseBoost=false,menuRepeat=0,aboutPage=0;\nconst sound=new Sound(),keys=new Set(),pointers=new Map(),padHistory=new Map();\nconst touchDevice=navigator.maxTouchPoints>0;document.body.classList.toggle('touch-device',touchDevice);\nfunction readStore(key,fallback){try{return JSON.parse(localStorage.getItem(key))??fallback;}catch{return fallback;}}\nfunction writeStore(key,data){try{localStorage.setItem(key,JSON.stringify(data));}catch{}}\nconst settings={music:10,effects:70,glyphs:'ps',camera:'arcade',reduced:matchMedia('(prefers-reduced-motion: reduce)').matches,...readStore('dodge-alley-settings',{})};\nlet highScore=readStore('dodge-alley-best',0);\nfunction keycap(text,pad=false){return \"'`<b class=\"key${pad?'\"' pad':''}\\\">\"'${text}</b>`;}\nfunction prompts(){const pad=lastInput==='\"'gamepad',xbox=settings.glyphs==='xbox';\n  const turn=pad?\"'`${keycap('\"'←')} \"'${keycap('\"'→')}\"'`:`${keycap('\"'A')} \"'${keycap('\"'D')}\"'`;\n  const boost=pad?keycap(xbox?'\"'A':'×',true):keycap('SPACE');const brake=pad?keycap(xbox?'LT':'L2'):keycap('S');\n  \"'$('\"'playPrompts').innerHTML=\"'`<span>${turn} IN / OUT</span><span>${boost} BOOST</span><span>${brake} BRAKE</span>`;\n  $('\"'navHint').innerHTML=pad?\"'`${keycap(xbox?'\"'A':'×',true)} SELECT &nbsp; \"'${keycap(xbox?'\"'B':'○',true)} BACK\"'`:`${keycap('\"'ENTER')} SELECT &nbsp; \"'${keycap('\"'ESC')} BACK\"'`;\n  $('\"'howControls').innerHTML=pad?\"'`Left stick / D-pad: inward & outward · ${xbox?'\"'A / RT':'Cross / R2'}: boost · \"'${xbox?'\"'LT':'L2'}: brake · Options: pause.\"'`:'\"'A/D or ←/→: inward & outward · Space: boost · S or ↓: brake · Esc: pause. Mouse: click a lane to queue a turn; hold right-click to boost.';\n  \"'$('\"'titleDevice').textContent=pad?'STANDARD GAMEPAD READY':lastInput==='touch'?'TOUCH CONTROLS READY':'KEYBOARD + MOUSE READY';\n  document.body.classList.toggle('touch-playing',lastInput==='touch'&&runActive&&screen==='');\n}\nfunction activity(type){lastActivity=performance.now();if(type&&type\"'!==lastInput){lastInput=type;prompts();}if(attract){showTitle();return true;}return false;}\nfunction focusables(){const area=screen?$(screen):null;if(!area)return[];return [...area.querySelectorAll('\"'button:not(:disabled), input:not(:disabled)')].filter(e=>e.getClientRects().length>0&&\"'!e.closest('\"'.hidden'));}\nfunction focus(el){document.querySelectorAll('.focused').forEach(e=>e.classList.remove('focused'));if(el){el.classList.add('focused');el.focus({preventScroll:true});}}\nfunction defaultFocus(){const els=focusables();focus(els.find(e=>e.classList.contains('primary'))||els[0]);}\nfunction navigate(dx,dy){const all=focusables();if(\"'!all.length)return;let current=document.activeElement;if(!all.includes(current)){focus(all[0]);return;}\n  if(dx&&current.type==='\"'range'){const step=Number(current.step)||1;current.value=String(clamp(Number(current.value)+dx*step,Number(current.min),Number(current.max)));current.dispatchEvent(new Event('input',{bubbles:true}));return;}\n  const r=current.getBoundingClientRect(),cx=r.x+r.width/2,cy=r.y+r.height/2;let best=null,bestScore=Infinity;\n  for(const el of all){if(el===current)continue;const b=el.getBoundingClientRect(),x=b.x+b.width/2-cx,y=b.y+b.height/2-cy,along=x*dx+y*dy,cross=Math.abs(dx?y:x);if(along<8)continue;const score=along+cross*2.8;if(score<bestScore){best=el;bestScore=score;}}\n  if(\"'!best){const idx=all.indexOf(current);best=all[(idx+(dx+dy>0?1:-1)+all.length)%all.length];}focus(best);sound.event({type:'\"'menu'});\n}\nfunction display(name,remember=false){if(remember&&screen\"'!==name)stack.push(screen);screen=name;document.querySelectorAll('\"'.screen').forEach(e=>e.classList.toggle('active',e.id===name));\"'$('\"'hud').classList.toggle('visible',runActive||attract);\"'$('\"'navHint').classList.toggle('hidden',\"'!name||name==='\"'attract'||name==='title'||hubEnded);\"'$('\"'raceboard').style.display=(hubInfo||net?.racing)&&(\"'!name||name==='\"'pause')?'block':'none';view.mode=(name==='title'||(\"'!runActive&&['\"'settings','how','about','together','join','lobby'].includes(name)))?'title':'game';prompts();requestAnimationFrame(defaultFocus);}\nfunction open(name){if(name==='about'){aboutPage=0;renderAbout();}if(name==='dev')syncDev();display(name,true);}\nfunction back(){if(screen==='pause'){resume();return;}const name=stack.pop()||'title';if(name==='title'&&\"'!runActive)display('\"'title');else display(name);}\nfunction showTitle(){if(hubInfo)return;net?.close();net=null;view.clearGhosts();netScores.clear();runActive=false;attract=false;stack=[];keys.clear();pointers.clear();game.start({seed:1980,attract:true});display('title');lastActivity=performance.now();\"'$('\"'bestScore').textContent='BEST '+formatScore(highScore);}\nfunction startRun({mode='arcade',players=1,seed=crypto.getRandomValues(new Uint32Array(1))[0],network=false}={}){if(hubEnded)return;runActive=true;attract=false;stack=[];keys.clear();pointers.clear();netScores.clear();view.clearGhosts();game.start({mode,players,seed});if(network)game.wait=Math.max(.1,(network.startAt-Date.now())/1000);display('');\"'$('\"'p2Boost').classList.toggle('hidden',players<2);\"'$('\"'runClock').classList.toggle('hidden',mode\"'!=='\"'attack');\"'$('\"'devButton').classList.toggle('hidden',\"'!!hubInfo||!!net?.racing);$('\"'restartButton').classList.toggle('hidden',\"'!!hubInfo||!!net?.racing);$('\"'quitButton').classList.toggle('hidden',\"'!!hubInfo);$('\"'pauseDescription').textContent=hubInfo||net?.racing?'The race clock keeps running.':'The road can wait.';}\nfunction pause(){if(\"'!runActive||hubEnded||attract||screen)return;keys.clear();mouseBoost=false;pointers.clear();display('\"'pause');}\nfunction resume(){if(\"'!runActive)return;stack=[];keys.clear();pointers.clear();display('\"'');}\nfunction toast(text,color='var(--gold)'){if(attract||hubEnded)return;\"'$('\"'toast').textContent=text;\"'$('\"'toast').style.color=color;\"'$('\"'toast').classList.add('visible');toastTimer=1.8;}\nfunction formatScore(n){return Math.floor(n).toString().padStart(6,'0').replace(/(.{3})\"'$/,'\"' \"'$1'\"');}\nfunction event(ev){view?.event(ev);if(\"'!attract&&screen!=='\"'title')sound.event(ev);\n  if(ev.type==='go')goTimer=.65;\n  if(ev.type==='near')toast('CLOSE SHAVE\"'!  +'\"'+100*game.multiplier);\n  if(ev.type==='cell')toast('TURBO FULL · SHIELD UP', 'var(--mint)');\n  if(ev.type==='deflect')toast('SHIELD SAVE\"'!  +200'\"','var(--mint)');\n  if(ev.type==='crash'){toast(game.lives>0?'BUMPED\"'!  '\"'+game.lives+' BUMPERS LEFT':'THAT’S YOUR LAST BUMPER','var(--coral)');rumble(.6,220);}\n  if(ev.type==='switch')rumble(.12,45);\n  if(ev.type==='finish'&&runActive){if(hubInfo)reportHub();if(net?.racing){net.send({t:'result',score:game.score});netScores.set(net.uid,{score:game.score,done:true});}showResults(ev.won);}\n}\nfunction rumble(strength,duration){for(const pad of navigator.getGamepads?.()||[]){const actuator=pad?.vibrationActuator;if(actuator?.playEffect)actuator.playEffect('dual-rumble',{duration,strongMagnitude:strength,weakMagnitude:strength*.5}).catch(()=>{});}}\nfunction showResults(won){const isRace=game.mode==='attack';const personal=\"'!net&&!hubInfo;\n  if(personal&&game.score>highScore){highScore=game.score;writeStore('\"'dodge-alley-best',highScore);}\n  \"'$('\"'resultKicker').textContent=isRace?'NIGHT RIVALS · YOUR RUN IS IN':game.playerCount===2?'COUCH CREW · TEAM RESULT':'THAT’S A WRAP';\n  \"'$('\"'resultTitle').textContent=isRace?'NIGHT’S TAKINGS.':won?'CLEAN GETAWAY\"'!'\"':'BUMPED OUT\"'!'\"';\n  \"'$('\"'resultCopy').textContent=isRace?'Same streets. Different stories. Let’s count the tokens.':won?'The night is yours. Diner’s on the house.':'The road always gets another night. So do you.';\n  \"'$('\"'resultScore').textContent=formatScore(game.score);\"'$('\"'resultBest').textContent=personal?(game.score>=highScore?'PERSONAL BEST':'BEST '+formatScore(highScore)):'150 SECOND SCORE CHASE';\n  \"'$('\"'resultTokens').textContent=game.totalCollected;\"'$('\"'resultNear').textContent=game.nearMisses;\"'$('\"'resultGaps').textContent=game.gatesTaken;\n  \"'$('\"'resultActions').classList.toggle('hidden',\"'!!hubInfo);$('\"'resultBack').textContent=net?(net.isHost?'BACK TO ROOM':'LEAVE ROOM'):'TITLE SCREEN';\"'$('\"'againButton').disabled=\"'!!net&&!net.isHost;$('\"'againButton').textContent=net?(net.isHost?'RACE AGAIN ↗':'WAITING FOR HOST'):'RUN IT BACK ↗';\n  display('results');renderRanks();\n}\nfunction rosterPlayers(){return hubInfo?hubInfo.players:(net?.players||[]);}\nfunction myID(){return hubInfo?hubInfo.me:net?.uid;}\nfunction renderRanks(){const rows=rosterPlayers().map(p=>({p,...(netScores.get(p.id)||{score:0,done:false})})).sort((a,b)=>b.score-a.score);for(const id of ['raceboard','resultRanks']){const root=\"'$(id);root.replaceChildren();for(const {p,score,done}of rows){const row=document.createElement('\"'div'),name=document.createElement('span'),n=document.createElement('b');name.textContent=p.name+(p.id===myID()?' · YOU':'');name.style.color=p.color;n.textContent=String(Math.floor(p.id===myID()?game.score:score)).padStart(5,'0')+(id==='resultRanks'&&\"'!done?'\"' · racing':'');row.append(name,n);row.style.borderLeftColor=p.color;root.append(row);}}\n}\nfunction applySettings(){sound.setMusic(settings.music/100);sound.setEffects(settings.effects/100);if(view){view.cameraStyle=settings.camera;view.reduced=settings.reduced;}\"'$('\"'musicVolume').value=settings.music;\"'$('\"'musicOutput').textContent=settings.music+'%';\"'$('\"'effectsVolume').value=settings.effects;\"'$('\"'effectsOutput').textContent=settings.effects+'%';\"'$('\"'glyphSetting').textContent=settings.glyphs==='ps'?'PLAYSTATION':'XBOX';\"'$('\"'cameraSetting').textContent=settings.camera==='arcade'?'ARCADE ANGLE':'BIRD’S-EYE';\"'$('\"'motionSetting').textContent=settings.reduced?'REDUCED':'FULL';prompts();writeStore('dodge-alley-settings',settings);}\nconst tuningSpecs=[['playerSpeed','Cruise speed',6,22,.5,''],['enemySpeed','Rival speed',3,18,.5,''],['boostMultiplier','Turbo power',1.1,2.5,.05,'×'],['recharge','Turbo recharge',0,24,1,'/s'],['gateWidth','Crossover window',1.4,5.5,.1,'']];\nfunction makeDev(){const parent=\"'$('\"'tuningSliders');for(const [key,label,min,max,step,suffix]of tuningSpecs){const row=document.createElement('div');row.className='setting';const l=document.createElement('label');l.htmlFor='tune-'+key;l.textContent=label;const input=document.createElement('input');input.id='tune-'+key;input.type='range';Object.assign(input,{min:String(min),max:String(max),step:String(step),value:String(game.tuning[key])});input.dataset.tune=key;const out=document.createElement('output');out.id='value-'+key;out.textContent=game.tuning[key]+suffix;row.append(l,input,out);parent.append(row);}}\nfunction syncDev(){for(const [key,,a,b,c,suffix]of tuningSpecs){\"'$('\"'tune-'+key).value=game.tuning[key];\"'$('\"'value-'+key).textContent=Number(game.tuning[key].toFixed(2))+suffix;}\"'$('\"'godButton').textContent='INVINCIBLE: '+(game.tuning.invincible?'ON':'OFF');\"'$('\"'autoButton').textContent='AUTOPILOT: '+(game.tuning.autopilot?'ON':'OFF');\"'$('\"'devStatus').textContent=\"'`RAPIER 0.19.3 · ${view.backend}'\"\\\\n\"'${game.phase.toUpperCase()} · SHIFT ${game.stage+1}'\"\\\\n\"'${game.remaining} TOKENS · ${game.lives} BUMPERS`;}\nfunction roomEvent(ev){if(ev.type==='\"'roster'){renderLobby();renderRanks();}\n  if(ev.type==='status')\"'$('\"'roomStatus').textContent=ev.text;\n  if(ev.type==='start'){startRun({mode:'attack',seed:ev.seed,network:ev});}\n  if(ev.type==='ghost'){const p=net?.players.find(p=>p.id===ev.id);if(p){view.setGhost(ev.id,{...ev,...p});netScores.set(ev.id,{score:ev.score,done:netScores.get(ev.id)?.done||false});renderRanks();}}\n  if(ev.type==='result'){netScores.set(ev.id,{score:ev.score,done:true});renderRanks();}\n  if(ev.type==='host-left'){showTitle();toast('HOST LEFT · ROOM CLOSED','var(--coral)');}\n  if(ev.type==='lobby'){runActive=false;view.clearGhosts();display('lobby');renderLobby();}\n}\nfunction renderLobby(){if(\"'!net)return;$('\"'roomCode').textContent=net.code||'----';\"'$('\"'roster').replaceChildren();for(let i=0;i<4;i++){const p=net.players.find(p=>p.seat===i),box=document.createElement('div');box.className='seat';const dot=document.createElement('i'),name=document.createElement('span'),status=document.createElement('small');if(p)dot.style.background=p.color;name.textContent=p?p.name:'EMPTY SEAT';status.textContent=p?(p.id===net.uid?'YOU':i===0?'HOST':'READY'):'WAITING';box.append(dot,name,status);\"'$('\"'roster').append(box);}\"'$('\"'startRoomButton').disabled=\"'!net.isHost||net.players.length<2;$('\"'startRoomButton').textContent=\"'!net.isHost?'\"'WAITING FOR HOST':net.players.length<2?'WAITING FOR DRIVERS':'START THE RACE ↗';}\nasync function createRoom(code=null){net?.close();net=new RoomNet(roomEvent);runActive=false;display('lobby');\"'$('\"'roomStatus').textContent=code?'Finding your room…':'Opening internet signalling…';await net.open(code);renderLobby();}\nconst data=JSON.parse(\"'$('\"'creditsData').textContent);const sourceKeys=[['date','Date'],['source','Source'],['plan','Plan'],['genre','Genre'],['perspective','Perspective'],['tech','Tech'],['artDirection','Art direction'],['animation','Animation'],['audio','Audio'],['online','Online'],['testing','Testing'],['research','Research'],['environment','Environment'],['model','Model'],['usage','Usage']];\nconst testingQuestions=['How many issues did testing catch?','How many were critical / game breaking?','Most helpful test?','Least helpful test?'];\nconst engineQuestions=['What did you like most?','Did you get stuck or guess wrong?','Most important thing built by hand?','Hardest part of the engine?','What changed in the engine?','One thing you would change?'];\nconst promptQuestions=['What did you like most?','What was confusing?','What was hardest?','What would you change?'];\nfunction aboutPages(){return [0,1,2].map(i=>({title:'SOURCE INFORMATION',items:sourceKeys.slice(i*5,i*5+5).map(([k,l])=>[l,data.sourceInformation[k]])})).concat([{title:'TESTING FEEDBACK',items:testingQuestions.map((q,i)=>[q,data.testingFeedback[i]])},{title:'ENGINE FEEDBACK',items:engineQuestions.slice(0,3).map((q,i)=>[q,data.engineFeedback[i]])},{title:'ENGINE FEEDBACK',items:engineQuestions.slice(3).map((q,i)=>[q,data.engineFeedback[i+3]])},{title:'PROMPT FEEDBACK',items:promptQuestions.map((q,i)=>[q,data.promptFeedback[i]])}]);}\nfunction renderAbout(){const pages=aboutPages(),page=pages[(aboutPage+pages.length)%pages.length];\"'$('\"'aboutHeading').textContent=page.title;\"'$('\"'aboutContent').classList.toggle('about-feedback',aboutPage>=3);\"'$('\"'aboutContent').replaceChildren();for(const [k,v]of page.items){const row=document.createElement('div');row.className='about-item';const title=document.createElement('b'),value=document.createElement('span');title.textContent=k;value.textContent=v;row.append(title,value);\"'$('\"'aboutContent').append(row);}\"'$('\"'aboutPage').textContent=(aboutPage+1)+' / '+pages.length;}\nconst actions={\n solo:()=>startRun(), coop:()=>startRun({players:2}),together:()=>open('together'), how:()=>open('how'), settings:()=>open('settings'),about:()=>open('about'),pause,resume,back,\n howPlay:()=>{if(runActive)resume();else startRun();},dev:()=>{if(\"'!hubInfo&&!net?.racing)open('\"'dev');},\n quit:()=>{if(\"'!hubInfo)showTitle();},restart:()=>{if(!hubInfo&&!net?.racing)startRun({players:game.playerCount,mode:game.mode,seed:game.seed});},\n glyphs:()=>{settings.glyphs=settings.glyphs==='\"'ps'?'xbox':'ps';applySettings();},camera:()=>{settings.camera=settings.camera==='arcade'?'overhead':'arcade';applySettings();},motion:()=>{settings.reduced=\"'!settings.reduced;applySettings();},\n fullscreen:()=>{if(document.fullscreenElement)document.exitFullscreen?.().catch(()=>{});else document.documentElement.requestFullscreen?.().catch(()=>toast('\"'FULLSCREEN UNAVAILABLE'));},\n god:()=>{game.tuning.invincible=\"'!game.tuning.invincible;syncDev();},auto:()=>{game.tuning.autopilot=!game.tuning.autopilot;syncDev();},\n repair:()=>{game.lives=game.playerCount>1?4:3;game.players.forEach(p=>{p.boost=100;p.invuln=3;p.shield=4;});syncDev();toast('\"'BUMPERS FIXED · TURBO FULL');},\n skip:()=>{game.skipStage();syncDev();},nextStage:()=>{game.stage=(game.stage+1)%3;game.buildStage();game.phase='countdown';game.wait=2;syncDev();},resetTuning:()=>{Object.assign(game.tuning,DEFAULTS);syncDev();},\n createRoom:()=>createRoom(),joinRoom:()=>{open('join');\"'$('\"'joinCode').value='';updateJoin();},connectRoom:()=>{if(/\"'^'\"\\\\d{4}\"'$/.test($('\"'joinCode').value))createRoom(\"'$('\"'joinCode').value);},erase:()=>{\"'$('\"'joinCode').value=\"'$('\"'joinCode').value.slice(0,-1);updateJoin();},\n leaveRoom:()=>showTitle(),copyCode:async()=>{try{await navigator.clipboard.writeText(net.code);\"'$('\"'roomStatus').textContent='Code copied. Send it to your friends.';}catch{\"'$('\"'roomStatus').textContent='Room code: '+net.code+' · Share these four digits.';}},startRoom:()=>net?.start(),\n resultBack:()=>{if(hubInfo)return;if(net){if(net.isHost)net.lobby();else showTitle();}else showTitle();},again:()=>{if(hubInfo)return;if(net)net.start();else startRun({players:game.playerCount,mode:game.mode});},\n aboutPrev:()=>{aboutPage=(aboutPage+6)%7;renderAbout();},aboutNext:()=>{aboutPage=(aboutPage+1)%7;renderAbout();}\n};\nfunction perform(name){if(\"'!ready||hubEnded)return;if(hubInfo&&['\"'quit','restart','solo','coop','together','createRoom','connectRoom','again','resultBack','dev'].includes(name))return;actions[name]?.();sound.event({type:'menu'});}\nfunction updateJoin(){\"'$('\"'joinCode').value=\"'$('\"'joinCode').value.replace(/\\\\D/g,'').slice(0,4);\"'$('\"'connectRoomButton').disabled=\"'$('\"'joinCode').value.length\"'!==4;}\ndocument.addEventListener('\"'click',e=>{const el=e.target.closest('button');if(\"'!el||!ready)return;if(el.id==='\"'touchBoost')return;const used=activity(e.pointerType==='touch'?'touch':lastInput==='gamepad'?'gamepad':'mouse');if(used)return;sound.unlock();if(el.dataset.action)perform(el.dataset.action);if(el.dataset.digit){\"'$('\"'joinCode').value=(\"'$('\"'joinCode').value+el.dataset.digit).slice(0,4);updateJoin();}});\ndocument.addEventListener('pointerover',e=>{if(\"'!ready||e.pointerType==='\"'touch')return;const el=e.target.closest('button,input');if(el&&screen){focus(el);}});\ndocument.addEventListener('pointermove',e=>{if(\"'!ready)return;if(e.pointerType==='\"'mouse'&&(Math.abs(e.movementX)+Math.abs(e.movementY)>2))activity('mouse');const p=pointers.get(e.pointerId);if(p&&runActive&&\"'!screen){const delta=e.clientX-p.x;if(Math.abs(delta)>32){game.queueLane(0,delta<0?1:-1);p.x=e.clientX;}}});\ndocument.addEventListener('\"'pointerdown',e=>{if(\"'!ready||hubEnded)return;const was=activity(e.pointerType==='\"'touch'?'touch':'mouse');sound.unlock();if(was){e.preventDefault();return;}if(e.pointerType==='touch'&&runActive&&\"'!screen){if(e.target.closest('\"'button')&&e.target.id\"'!=='\"'touchBoost')return;e.preventDefault();pointers.set(e.pointerId,{x:e.clientX,y:e.clientY,boost:e.target.id==='touchBoost'||e.clientX>innerWidth*.6});e.target.setPointerCapture?.(e.pointerId);}else if(e.target===\"'$('\"'world')&&runActive&&\"'!screen){if(e.button===2){mouseBoost=true;e.preventDefault();}else if(e.button===0){const lane=view.pickLane(e.clientX,e.clientY);game.queueLane(0,Math.sign(lane-game.players[0].lane));}}});\nfor(const name of ['\"'pointerup','pointercancel'])document.addEventListener(name,e=>{pointers.delete(e.pointerId);if(e.button===2)mouseBoost=false;});\ndocument.addEventListener('contextmenu',e=>{if(e.target===\"'$('\"'world'))e.preventDefault();});\ndocument.addEventListener('input',e=>{const el=e.target;if(el.id==='joinCode')updateJoin();if(el.id==='musicVolume'){settings.music=Number(el.value);applySettings();}if(el.id==='effectsVolume'){settings.effects=Number(el.value);applySettings();}if(el.dataset.tune){game.tuning[el.dataset.tune]=Number(el.value);syncDev();}});\ndocument.addEventListener('keydown',e=>{if(\"'!ready||hubEnded)return;const was=activity('\"'keyboard');sound.unlock();if(was){e.preventDefault();return;}const key=e.key.toLowerCase(),input=e.target.tagName==='INPUT';if(input&&e.target.type==='text'&&key\"'!=='\"'escape'){if(key==='enter'&&screen==='join'){e.preventDefault();perform('connectRoom');}return;}\n  if([' ','arrowup','arrowdown','arrowleft','arrowright'].includes(key))e.preventDefault();\n  if(key==='escape'||key==='p'){e.preventDefault();if(screen==='')pause();else if(screen==='pause')resume();else back();return;}\n  if(screen){if(e.repeat)return;if(key==='arrowup'||key==='w')navigate(0,-1);else if(key==='arrowdown'||key==='s')navigate(0,1);else if(key==='arrowleft'||key==='a')navigate(-1,0);else if(key==='arrowright'||key==='d')navigate(1,0);else if(key==='enter'||key===' '){e.preventDefault();document.activeElement?.click();}return;}\n  keys.add(key);\n});\ndocument.addEventListener('keyup',e=>keys.delete(e.key.toLowerCase()));\nwindow.addEventListener('blur',()=>{keys.clear();pointers.clear();mouseBoost=false;if(ready&&runActive&&\"'!hubInfo&&!net?.racing&&!attract&&!screen)pause();});\ndocument.addEventListener('\"'visibilitychange',()=>{if(document.hidden){keys.clear();pointers.clear();mouseBoost=false;if(ready&&runActive&&\"'!hubInfo&&!net?.racing&&!attract&&!screen)pause();}});\nfunction pollPads(dt){const pads=[...(navigator.getGamepads?.()||[])].filter(p=>p&&p.connected!==false),values=[];for(let pi=0;pi<pads.length;pi++){const pad=pads[pi],buttons=pad.buttons.map(b=>typeof b==='\"'number'?b:Math.max(b.value||0,b.pressed?1:0)),previous=padHistory.get(pad.index)||[],edge=n=>buttons[n]>.5&&\"'!(previous[n]>.5);const x=pad.axes[0]||0,y=pad.axes[1]||0;const active=buttons.some(b=>b>.5)||Math.abs(x)>.45||Math.abs(y)>.45;\n    let consumed=false;if(active){consumed=activity('\"'gamepad');sound.unlock();}\n    if(\"'!consumed&&pi===0){if(edge(9)&&!(buttons[8]>.5)){if(!screen)pause();else if(screen==='\"'pause')resume();}\n      else if(screen&&screen\"'!=='\"'attract'){menuRepeat-=dt;const dx=buttons[14]>.5?-1:buttons[15]>.5?1:x<-.5?-1:x>.5?1:0,dy=buttons[12]>.5?-1:buttons[13]>.5?1:y<-.5?-1:y>.5?1:0;\n        if((dx||dy)&&menuRepeat<=0){navigate(Math.abs(x)>Math.abs(y)||dx&& \"'!dy?dx:0,Math.abs(x)>Math.abs(y)||dx&&!dy?0:dy);menuRepeat=.2;}\n        if(!dx&&!dy)menuRepeat=0;if(edge(0))document.activeElement?.click();if(edge(1))back();}\n    }\n    values.push({lane:buttons[14]>.5||x<-.4?1:buttons[15]>.5||x>.4?-1:0,boost:buttons[0]>.5||buttons[7]>.3,brake:buttons[6]>.3||buttons[2]>.5});padHistory.set(pad.index,buttons);\n  }return values;\n}\nfunction readInputs(pads){if(!runActive||screen||hubEnded)return;\n  const coop=game.playerCount>1;\n  for(let i=0;i<game.playerCount;i++){let lane=0,boost=false,brake=false;const left=i===0?(keys.has('\"'a')||\"'!coop&&keys.has('\"'arrowleft')):keys.has('arrowleft'),right=i===0?(keys.has('d')||\"'!coop&&keys.has('\"'arrowright')):keys.has('arrowright');lane=left?1:right?-1:0;boost=i===0?keys.has(' ')||mouseBoost:keys.has('enter');brake=i===0?keys.has('s')||\"'!coop&&keys.has('\"'arrowdown'):keys.has('arrowdown');\n    if(pads[i]){lane=pads[i].lane||lane;boost||=pads[i].boost;brake||=pads[i].brake;}\n    if(i===0&&lastInput==='touch'){boost||=[...pointers.values()].some(p=>p.boost);const a=game.players[0],danger=game.rivals.some(b=>b.lane===a.lane&&wrap(b.u-a.u)<.085);if(danger){brake=true;if(\"'!a.queueDir){const options=[1,-1].filter(dir=>a.lane+dir>=0&&a.lane+dir<4);const dir=options.find(dir=>!game.rivals.some(b=>b.lane===a.lane+dir&&wrap(b.u-a.u)<.12));if(dir)game.queueLane(0,dir);}}}\n    game.setInput(i,{lane,boost,brake});\n  }\n}\nfunction shouldTick(){return !hubEnded&&(screen==='\"'title'||attract||runActive&&(\"'!screen||hubInfo||net?.racing)&&!['\"'won','lost','waiting'].includes(game.phase));}\nfunction simulate(dt){if(hubInfo){if(\"'!hubStarted||hubEnded)return;if(!hubRunning&&hub.time()>=0){hubRunning=true;game.phase='\"'playing';event({type:'go'});}if(\"'!hubRunning)return;}if(shouldTick())game.tick(dt);}\nfunction sendOnline(dt){if(hubEnded)return;remoteClock+=dt;progressClock+=dt;if(!(hubInfo&&hubRunning||net?.racing&&runActive))return;\n  if(remoteClock>=.1){remoteClock=0;const a=game.players[0];if(a){const data={u:wrap(a.u),lane:a.lane,stage:game.stage,score:game.score};if(hubInfo)hub.send({type:'\"'ghost',...data},{reliable:false});else net.send({t:'ghost',data});netScores.set(myID(),{score:game.score,done:hubReported||['won','lost'].includes(game.phase)});renderRanks();}}\n  if(hubInfo&&progressClock>=.75){progressClock=0;hub.progress({score:game.score,label:\"'`${game.totalCollected} tokens · shift ${game.stage+1}`});}\n}\nfunction reportHub(){if(!hubInfo||hubReported||hubEnded)return;hubReported=true;hub.progress({score:game.score,label:game.totalCollected+'\"' tokens'});hub.result({score:game.score,stats:{Tokens:game.totalCollected,'Close shaves':game.nearMisses,Gaps:game.gatesTaken,'Shifts cleared':game.stage}});}\nasync function initHub(){hubInfo=await hub.connect({mode:'ghost',seats:[1,4]});if(\"'!hubInfo){showTitle();return;}\n  hub.on('\"'start',()=>{hubStarted=true;});hub.on('message',(data,from)=>{if(hubEnded||data?.type\"'!=='\"'ghost'||\"'!Number.isFinite(data.u)||!Number.isInteger(data.lane)||data.lane<0||data.lane>3)return;const p=hubInfo.players.find(p=>p.id===from);if(p){view.setGhost(from,{...data,...p});netScores.set(from,{score:data.score,done:false});renderRanks();}});\n  hub.on('\"'leave',({id})=>{const v=view.ghosts.get(id);if(v){view.scene.remove(v.root);view.ghosts.delete(id);}netScores.delete(id);});\n  hub.on('time-up',()=>{if(\"'!hubReported){game.phase='\"'won';reportHub();showResults(true);}});\n  hub.on('end',()=>{hubEnded=true;game.phase='ended';sound.mute(true);keys.clear();pointers.clear();\"'$('\"'pauseButton').classList.add('hidden');\"'$('\"'resultActions').classList.add('hidden');\"'$('\"'navHint').classList.add('hidden');if(screen\"'!=='\"'results'){showResults(true);}});\n  startRun({mode:'attack',seed:hubInfo.seed});game.phase='waiting';game.wait=3;view.update(game,0);await view.renderer.compileAsync(view.scene,view.camera);hub.ready();\n}\nfunction updateHud(dt){if(toastTimer>0){toastTimer-=dt;if(toastTimer<=0)\"'$('\"'toast').classList.remove('visible');}goTimer=Math.max(0,goTimer-dt);if(\"'!runActive&&!attract)return;\n  $('\"'score').textContent=formatScore(game.score);\"'$('\"'multiplier').textContent='×'+game.multiplier;\"'$('\"'tokensLeft').textContent='● '+game.remaining+' TOKENS LEFT';\"'$('\"'shiftNumber').textContent=(game.mode==='attack'?'NIGHT RIVALS · ':'SHIFT ')+String(game.stage+1).padStart(2,'0')+(game.mode==='arcade'?' / 03':'');\"'$('\"'shiftName').textContent=LEVELS[game.stage%3].name;\"'$('\"'shiftProgress').style.width=(1-game.remaining/game.stageTotal)*100+'%';\n  const lifeHTML=Array.from({length:Math.max(game.playerCount>1?4:3,game.lives)},(_,i)=>\"'`<i class=\"life ${i>=game.lives?'\"'empty':''}\\\"></i>\"'`).join('\"'');if(\"'$('\"'lives').innerHTML\"'!==lifeHTML)$('\"'lives').innerHTML=lifeHTML;\"'$('\"'lives').setAttribute('aria-label',game.lives+' lives');\n  for(let i=0;i<game.players.length;i++){const a=game.players[i],prefix=i?'p2Boost':'boost';\"'$(i?'\"'p2BoostBar':'boostBar').style.width=a.boost+'%';\"'$(i?'\"'p2BoostAmount':'boostAmount').textContent=Math.floor(a.boost)+'%';\"'$(i?'\"'p2Queue':'queueLabel').textContent=a.shield>0?'SHIELD · '+a.shield.toFixed(1)+'s':a.queueDir>0?'← INWARD QUEUED':a.queueDir<0?'OUTWARD QUEUED →':i?'DRIVER 2 · FIND A GAP':'AUTO-DRIVE · FIND A GAP';}\n  const sec=Math.max(0,Math.ceil(game.timeLeft));\"'$('\"'runClock').textContent=Math.floor(sec/60)+':'+String(sec%60).padStart(2,'0');\n  let title='',sub='';if(hubInfo&&\"'!hubRunning&&!hubEnded){title=hubStarted&&Number.isFinite(hub.time())?Math.max(1,Math.ceil(-hub.time()/1000)):'\"'NIGHT RIVALS';sub=hubStarted?'READY TO ROLL':'WAITING FOR THE HUB';}\n  else if(game.phase==='countdown'){title=String(Math.max(1,Math.ceil(game.wait)));sub=LEVELS[game.stage%3].name+' · '+LEVELS[game.stage%3].subtitle;}\n  else if(game.phase==='stageclear'){title='SHIFT CLEARED\"'!'\"';sub='BONUS +'+(1000+game.lives*250)+' · '+(game.stage%3===2&&game.mode==='arcade'?'THE NIGHT IS YOURS':'NEXT SHIFT COMING UP');}\n  else if(goTimer>0&&game.phase==='playing'){title='LET’S ROLL\"'!'\"';sub='TAKE THE GAPS. KEEP YOUR BUMPERS.';}\n  const visible=\"'!!title&&(!screen||attract);$('\"'callout').classList.toggle('visible',visible);if(visible){\"'$('\"'calloutTitle').textContent=title;\"'$('\"'calloutSubtitle').textContent=sub;}\n}\nfunction frame(ms){if(\"'!ready)return;const dt=Math.min(.05,(ms-(lastFrame||ms))/1000);lastFrame=ms;const pads=pollPads(dt);readInputs(pads);net?.tick(dt);\n  if(!hubInfo&&['\"'title','together'].includes(screen)&&ms-lastActivity>=10000){attract=true;runActive=false;stack=[];game.start({seed:1980,attract:true});display('attract');\"'$('\"'p2Boost').classList.add('hidden');\"'$('\"'runClock').classList.add('hidden');}\n  accumulator+=dt;let safety=0;while(accumulator>=1/60&&safety++<6){simulate(1/60);accumulator-=1/60;}\n  sendOnline(dt);updateHud(dt);view.update(game,dt,\"'!shouldTick());view.render();sound.update(game,!shouldTick());requestAnimationFrame(frame);\n}\nfunction installTestAPI(){window.__dodge={get state(){return {...game.snapshot(),screen,runActive,attract,lastInput,renderer:view.backend,renderCount:view.renderCount,hub:hubInfo?{started:hubStarted,running:hubRunning,ended:hubEnded,reported:hubReported,me:hubInfo.me}:null,room:net?{code:net.code,isHost:net.isHost,connected:net.connected,online:net.online,players:net.players,racing:net.racing,ghosts:view.ghosts.size}:null,musicVolume:sound.musicVolume,audio:sound.levels(),settings:{...settings}};},ready:true};if(TEST)Object.assign(window.__dodge,{action:perform,start:startRun,advance(seconds){const frames=Math.ceil(seconds*60);for(let i=0;i<frames;i++)simulate(1/60);view.update(game,0,!shouldTick());updateHud(0);return game.snapshot();},tune(values){Object.assign(game.tuning,values);syncDev();},input:(id,data)=>game.setInput(id,data),queue:(id,dir)=>game.queueLane(id,dir),idle(ms){lastActivity=performance.now()-ms;},audioProbe:()=>sound.probe(),createRoom:code=>createRoom(code),get ghosts(){return [...view.ghosts.keys()];},get credits(){return data;}});}\nasync function boot(){try{await RAPIER.init();$('\"'bootStatus').textContent='Painting the city. Checking the bumpers…';view=new View(\"'$('\"'world'));game=new Game(RAPIER,event);game.start({seed:1980,attract:true});view.update(game,0);await view.init();makeDev();applySettings();ready=true;if(hub.active)await initHub();else showTitle();\"'$('\"'boot').style.display='none';installTestAPI();requestAnimationFrame(frame);}catch(err){console.error(err);\"'$('\"'bootStatus').textContent='The alley couldn’t open.';\"'$('\"'bootError').style.display='block';\"'$('\"'bootError').textContent='This game needs WebGPU or WebGL 2 and WebAssembly. Try a recent Chrome, Edge, or Safari. '+String(err.message||err);if(hub.active)hub.fail(String(err.message||err));}}\nboot();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cat > main.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nimport {Game,DEFAULTS,LEVELS,LANES,clamp,wrap} from './core.js';\nimport {View} from './view.js';\nimport {Sound} from './audio.js';\nimport {RoomNet} from './net.js';\nconst \"'$=id=>document.getElementById(id), hub=window.AIHub;\nconst TEST=new URLSearchParams(location.search).has('\"'test');\nlet game,view,ready=false,screen='title',stack=[],lastInput='keyboard',lastActivity=performance.now(),runActive=false,attract=false,net=null,netScores=new Map(),hubInfo=null,hubStarted=false,hubRunning=false,hubEnded=false,hubReported=false,remoteClock=0,progressClock=0,toastTimer=0,goTimer=0,lastFrame=0,accumulator=0,mouseBoost=false,menuRepeat=0,aboutPage=0;\nconst sound=new Sound(),keys=new Set(),pointers=new Map(),padHistory=new Map();\nconst touchDevice=navigator.maxTouchPoints>0;document.body.classList.toggle('touch-device',touchDevice);\nfunction readStore(key,fallback){try{return JSON.parse(localStorage.getItem(key))??fallback;}catch{return fallback;}}\nfunction writeStore(key,data){try{localStorage.setItem(key,JSON.stringify(data));}catch{}}\nconst settings={music:10,effects:70,glyphs:'ps',camera:'arcade',reduced:matchMedia('(prefers-reduced-motion: reduce)').matches,...readStore('dodge-alley-settings',{})};\nlet highScore=readStore('dodge-alley-best',0);\nfunction keycap(text,pad=false){return \"'`<b class=\"key${pad?'\"' pad':''}\\\">\"'${text}</b>`;}\nfunction prompts(){const pad=lastInput==='\"'gamepad',xbox=settings.glyphs==='xbox';\n  const turn=pad?\"'`${keycap('\"'←')} \"'${keycap('\"'→')}\"'`:`${keycap('\"'A')} \"'${keycap('\"'D')}\"'`;\n  const boost=pad?keycap(xbox?'\"'A':'×',true):keycap('SPACE');const brake=pad?keycap(xbox?'LT':'L2'):keycap('S');\n  \"'$('\"'playPrompts').innerHTML=\"'`<span>${turn} IN / OUT</span><span>${boost} BOOST</span><span>${brake} BRAKE</span>`;\n  $('\"'navHint').innerHTML=pad?\"'`${keycap(xbox?'\"'A':'×',true)} SELECT &nbsp; \"'${keycap(xbox?'\"'B':'○',true)} BACK\"'`:`${keycap('\"'ENTER')} SELECT &nbsp; \"'${keycap('\"'ESC')} BACK\"'`;\n  $('\"'howControls').innerHTML=pad?\"'`Left stick / D-pad: inward & outward · ${xbox?'\"'A / RT':'Cross / R2'}: boost · \"'${xbox?'\"'LT':'L2'}: brake · Options: pause.\"'`:'\"'A/D or ←/→: inward & outward · Space: boost · S or ↓: brake · Esc: pause. Mouse: click a lane to queue a turn; hold right-click to boost.';\n  \"'$('\"'titleDevice').textContent=pad?'STANDARD GAMEPAD READY':lastInput==='touch'?'TOUCH CONTROLS READY':'KEYBOARD + MOUSE READY';\n  document.body.classList.toggle('touch-playing',lastInput==='touch'&&runActive&&screen==='');\n}\nfunction activity(type){lastActivity=performance.now();if(type&&type\"'!==lastInput){lastInput=type;prompts();}if(attract){showTitle();return true;}return false;}\nfunction focusables(){const area=screen?$(screen):null;if(!area)return[];return [...area.querySelectorAll('\"'button:not(:disabled), input:not(:disabled)')].filter(e=>e.getClientRects().length>0&&\"'!e.closest('\"'.hidden'));}\nfunction focus(el){document.querySelectorAll('.focused').forEach(e=>e.classList.remove('focused'));if(el){el.classList.add('focused');el.focus({preventScroll:true});}}\nfunction defaultFocus(){const els=focusables();focus(els.find(e=>e.classList.contains('primary'))||els[0]);}\nfunction navigate(dx,dy){const all=focusables();if(\"'!all.length)return;let current=document.activeElement;if(!all.includes(current)){focus(all[0]);return;}\n  if(dx&&current.type==='\"'range'){const step=Number(current.step)||1;current.value=String(clamp(Number(current.value)+dx*step,Number(current.min),Number(current.max)));current.dispatchEvent(new Event('input',{bubbles:true}));return;}\n  const r=current.getBoundingClientRect(),cx=r.x+r.width/2,cy=r.y+r.height/2;let best=null,bestScore=Infinity;\n  for(const el of all){if(el===current)continue;const b=el.getBoundingClientRect(),x=b.x+b.width/2-cx,y=b.y+b.height/2-cy,along=x*dx+y*dy,cross=Math.abs(dx?y:x);if(along<8)continue;const score=along+cross*2.8;if(score<bestScore){best=el;bestScore=score;}}\n  if(\"'!best){const idx=all.indexOf(current);best=all[(idx+(dx+dy>0?1:-1)+all.length)%all.length];}focus(best);sound.event({type:'\"'menu'});\n}\nfunction display(name,remember=false){if(remember&&screen\"'!==name)stack.push(screen);screen=name;document.querySelectorAll('\"'.screen').forEach(e=>e.classList.toggle('active',e.id===name));\"'$('\"'hud').classList.toggle('visible',runActive||attract);\"'$('\"'navHint').classList.toggle('hidden',\"'!name||name==='\"'attract'||name==='title'||hubEnded);\"'$('\"'raceboard').style.display=(hubInfo||net?.racing)&&(\"'!name||name==='\"'pause')?'block':'none';view.mode=(name==='title'||(\"'!runActive&&['\"'settings','how','about','together','join','lobby'].includes(name)))?'title':'game';prompts();requestAnimationFrame(defaultFocus);}\nfunction open(name){if(name==='about'){aboutPage=0;renderAbout();}if(name==='dev')syncDev();display(name,true);}\nfunction back(){if(screen==='pause'){resume();return;}const name=stack.pop()||'title';if(name==='title'&&\"'!runActive)display('\"'title');else display(name);}\nfunction showTitle(){if(hubInfo)return;net?.close();net=null;view.clearGhosts();netScores.clear();runActive=false;attract=false;stack=[];keys.clear();pointers.clear();game.start({seed:1980,attract:true});display('title');lastActivity=performance.now();\"'$('\"'bestScore').textContent='BEST '+formatScore(highScore);}\nfunction startRun({mode='arcade',players=1,seed=crypto.getRandomValues(new Uint32Array(1))[0],network=false}={}){if(hubEnded)return;runActive=true;attract=false;stack=[];keys.clear();pointers.clear();netScores.clear();view.clearGhosts();game.start({mode,players,seed});if(network)game.wait=Math.max(.1,(network.startAt-Date.now())/1000);display('');\"'$('\"'p2Boost').classList.toggle('hidden',players<2);\"'$('\"'runClock').classList.toggle('hidden',mode\"'!=='\"'attack');\"'$('\"'devButton').classList.toggle('hidden',\"'!!hubInfo||!!net?.racing);$('\"'restartButton').classList.toggle('hidden',\"'!!hubInfo||!!net?.racing);$('\"'quitButton').classList.toggle('hidden',\"'!!hubInfo);$('\"'pauseDescription').textContent=hubInfo||net?.racing?'The race clock keeps running.':'The road can wait.';}\nfunction pause(){if(\"'!runActive||hubEnded||attract||screen)return;keys.clear();mouseBoost=false;pointers.clear();display('\"'pause');}\nfunction resume(){if(\"'!runActive)return;stack=[];keys.clear();pointers.clear();display('\"'');}\nfunction toast(text,color='var(--gold)'){if(attract||hubEnded)return;\"'$('\"'toast').textContent=text;\"'$('\"'toast').style.color=color;\"'$('\"'toast').classList.add('visible');toastTimer=1.8;}\nfunction formatScore(n){return Math.floor(n).toString().padStart(6,'0').replace(/(.{3})\"'$/,'\"' \"'$1'\"');}\nfunction event(ev){view?.event(ev);if(\"'!attract&&screen!=='\"'title')sound.event(ev);\n  if(ev.type==='go')goTimer=.65;\n  if(ev.type==='near')toast('CLOSE SHAVE\"'!  +'\"'+100*game.multiplier);\n  if(ev.type==='cell')toast('TURBO FULL · SHIELD UP', 'var(--mint)');\n  if(ev.type==='deflect')toast('SHIELD SAVE\"'!  +200'\"','var(--mint)');\n  if(ev.type==='crash'){toast(game.lives>0?'BUMPED\"'!  '\"'+game.lives+' BUMPERS LEFT':'THAT’S YOUR LAST BUMPER','var(--coral)');rumble(.6,220);}\n  if(ev.type==='switch')rumble(.12,45);\n  if(ev.type==='finish'&&runActive){if(hubInfo)reportHub();if(net?.racing){net.send({t:'result',score:game.score});netScores.set(net.uid,{score:game.score,done:true});}showResults(ev.won);}\n}\nfunction rumble(strength,duration){for(const pad of navigator.getGamepads?.()||[]){const actuator=pad?.vibrationActuator;if(actuator?.playEffect)actuator.playEffect('dual-rumble',{duration,strongMagnitude:strength,weakMagnitude:strength*.5}).catch(()=>{});}}\nfunction showResults(won){const isRace=game.mode==='attack';const personal=\"'!net&&!hubInfo;\n  if(personal&&game.score>highScore){highScore=game.score;writeStore('\"'dodge-alley-best',highScore);}\n  \"'$('\"'resultKicker').textContent=isRace?'NIGHT RIVALS · YOUR RUN IS IN':game.playerCount===2?'COUCH CREW · TEAM RESULT':'THAT’S A WRAP';\n  \"'$('\"'resultTitle').textContent=isRace?'NIGHT’S TAKINGS.':won?'CLEAN GETAWAY\"'!'\"':'BUMPED OUT\"'!'\"';\n  \"'$('\"'resultCopy').textContent=isRace?'Same streets. Different stories. Let’s count the tokens.':won?'The night is yours. Diner’s on the house.':'The road always gets another night. So do you.';\n  \"'$('\"'resultScore').textContent=formatScore(game.score);\"'$('\"'resultBest').textContent=personal?(game.score>=highScore?'PERSONAL BEST':'BEST '+formatScore(highScore)):'150 SECOND SCORE CHASE';\n  \"'$('\"'resultTokens').textContent=game.totalCollected;\"'$('\"'resultNear').textContent=game.nearMisses;\"'$('\"'resultGaps').textContent=game.gatesTaken;\n  \"'$('\"'resultActions').classList.toggle('hidden',\"'!!hubInfo);$('\"'resultBack').textContent=net?(net.isHost?'BACK TO ROOM':'LEAVE ROOM'):'TITLE SCREEN';\"'$('\"'againButton').disabled=\"'!!net&&!net.isHost;$('\"'againButton').textContent=net?(net.isHost?'RACE AGAIN ↗':'WAITING FOR HOST'):'RUN IT BACK ↗';\n  display('results');renderRanks();\n}\nfunction rosterPlayers(){return hubInfo?hubInfo.players:(net?.players||[]);}\nfunction myID(){return hubInfo?hubInfo.me:net?.uid;}\nfunction renderRanks(){const rows=rosterPlayers().map(p=>({p,...(netScores.get(p.id)||{score:0,done:false})})).sort((a,b)=>b.score-a.score);for(const id of ['raceboard','resultRanks']){const root=\"'$(id);root.replaceChildren();for(const {p,score,done}of rows){const row=document.createElement('\"'div'),name=document.createElement('span'),n=document.createElement('b');name.textContent=p.name+(p.id===myID()?' · YOU':'');name.style.color=p.color;n.textContent=String(Math.floor(p.id===myID()?game.score:score)).padStart(5,'0')+(id==='resultRanks'&&\"'!done?'\"' · racing':'');row.append(name,n);row.style.borderLeftColor=p.color;root.append(row);}}\n}\nfunction applySettings(){sound.setMusic(settings.music/100);sound.setEffects(settings.effects/100);if(view){view.cameraStyle=settings.camera;view.reduced=settings.reduced;}\"'$('\"'musicVolume').value=settings.music;\"'$('\"'musicOutput').textContent=settings.music+'%';\"'$('\"'effectsVolume').value=settings.effects;\"'$('\"'effectsOutput').textContent=settings.effects+'%';\"'$('\"'glyphSetting').textContent=settings.glyphs==='ps'?'PLAYSTATION':'XBOX';\"'$('\"'cameraSetting').textContent=settings.camera==='arcade'?'ARCADE ANGLE':'BIRD’S-EYE';\"'$('\"'motionSetting').textContent=settings.reduced?'REDUCED':'FULL';prompts();writeStore('dodge-alley-settings',settings);}\nconst tuningSpecs=[['playerSpeed','Cruise speed',6,22,.5,''],['enemySpeed','Rival speed',3,18,.5,''],['boostMultiplier','Turbo power',1.1,2.5,.05,'×'],['recharge','Turbo recharge',0,24,1,'/s'],['gateWidth','Crossover window',1.4,5.5,.1,'']];\nfunction makeDev(){const parent=\"'$('\"'tuningSliders');for(const [key,label,min,max,step,suffix]of tuningSpecs){const row=document.createElement('div');row.className='setting';const l=document.createElement('label');l.htmlFor='tune-'+key;l.textContent=label;const input=document.createElement('input');input.id='tune-'+key;input.type='range';Object.assign(input,{min:String(min),max:String(max),step:String(step),value:String(game.tuning[key])});input.dataset.tune=key;const out=document.createElement('output');out.id='value-'+key;out.textContent=game.tuning[key]+suffix;row.append(l,input,out);parent.append(row);}}\nfunction syncDev(){for(const [key,,a,b,c,suffix]of tuningSpecs){\"'$('\"'tune-'+key).value=game.tuning[key];\"'$('\"'value-'+key).textContent=Number(game.tuning[key].toFixed(2))+suffix;}\"'$('\"'godButton').textContent='INVINCIBLE: '+(game.tuning.invincible?'ON':'OFF');\"'$('\"'autoButton').textContent='AUTOPILOT: '+(game.tuning.autopilot?'ON':'OFF');\"'$('\"'devStatus').textContent=\"'`RAPIER 0.19.3 · ${view.backend}'\"\\\\n\"'${game.phase.toUpperCase()} · SHIFT ${game.stage+1}'\"\\\\n\"'${game.remaining} TOKENS · ${game.lives} BUMPERS`;}\nfunction roomEvent(ev){if(ev.type==='\"'roster'){renderLobby();renderRanks();}\n  if(ev.type==='status')\"'$('\"'roomStatus').textContent=ev.text;\n  if(ev.type==='start'){startRun({mode:'attack',seed:ev.seed,network:ev});}\n  if(ev.type==='ghost'){const p=net?.players.find(p=>p.id===ev.id);if(p){view.setGhost(ev.id,{...ev,...p});netScores.set(ev.id,{score:ev.score,done:netScores.get(ev.id)?.done||false});renderRanks();}}\n  if(ev.type==='result'){netScores.set(ev.id,{score:ev.score,done:true});renderRanks();}\n  if(ev.type==='host-left'){showTitle();toast('HOST LEFT · ROOM CLOSED','var(--coral)');}\n  if(ev.type==='lobby'){runActive=false;view.clearGhosts();display('lobby');renderLobby();}\n}\nfunction renderLobby(){if(\"'!net)return;$('\"'roomCode').textContent=net.code||'----';\"'$('\"'roster').replaceChildren();for(let i=0;i<4;i++){const p=net.players.find(p=>p.seat===i),box=document.createElement('div');box.className='seat';const dot=document.createElement('i'),name=document.createElement('span'),status=document.createElement('small');if(p)dot.style.background=p.color;name.textContent=p?p.name:'EMPTY SEAT';status.textContent=p?(p.id===net.uid?'YOU':i===0?'HOST':'READY'):'WAITING';box.append(dot,name,status);\"'$('\"'roster').append(box);}\"'$('\"'startRoomButton').disabled=\"'!net.isHost||net.players.length<2;$('\"'startRoomButton').textContent=\"'!net.isHost?'\"'WAITING FOR HOST':net.players.length<2?'WAITING FOR DRIVERS':'START THE RACE ↗';}\nasync function createRoom(code=null){net?.close();net=new RoomNet(roomEvent);runActive=false;display('lobby');\"'$('\"'roomStatus').textContent=code?'Finding your room…':'Opening internet signalling…';await net.open(code);renderLobby();}\nconst data=JSON.parse(\"'$('\"'creditsData').textContent);const sourceKeys=[['date','Date'],['source','Source'],['plan','Plan'],['genre','Genre'],['perspective','Perspective'],['tech','Tech'],['artDirection','Art direction'],['animation','Animation'],['audio','Audio'],['online','Online'],['testing','Testing'],['research','Research'],['environment','Environment'],['model','Model'],['usage','Usage']];\nconst testingQuestions=['How many issues did testing catch?','How many were critical / game breaking?','Most helpful test?','Least helpful test?'];\nconst engineQuestions=['What did you like most?','Did you get stuck or guess wrong?','Most important thing built by hand?','Hardest part of the engine?','What changed in the engine?','One thing you would change?'];\nconst promptQuestions=['What did you like most?','What was confusing?','What was hardest?','What would you change?'];\nfunction aboutPages(){return [0,1,2].map(i=>({title:'SOURCE INFORMATION',items:sourceKeys.slice(i*5,i*5+5).map(([k,l])=>[l,data.sourceInformation[k]])})).concat([{title:'TESTING FEEDBACK',items:testingQuestions.map((q,i)=>[q,data.testingFeedback[i]])},{title:'ENGINE FEEDBACK',items:engineQuestions.slice(0,3).map((q,i)=>[q,data.engineFeedback[i]])},{title:'ENGINE FEEDBACK',items:engineQuestions.slice(3).map((q,i)=>[q,data.engineFeedback[i+3]])},{title:'PROMPT FEEDBACK',items:promptQuestions.map((q,i)=>[q,data.promptFeedback[i]])}]);}\nfunction renderAbout(){const pages=aboutPages(),page=pages[(aboutPage+pages.length)%pages.length];\"'$('\"'aboutHeading').textContent=page.title;\"'$('\"'aboutContent').classList.toggle('about-feedback',aboutPage>=3);\"'$('\"'aboutContent').replaceChildren();for(const [k,v]of page.items){const row=document.createElement('div');row.className='about-item';const title=document.createElement('b'),value=document.createElement('span');title.textContent=k;value.textContent=v;row.append(title,value);\"'$('\"'aboutContent').append(row);}\"'$('\"'aboutPage').textContent=(aboutPage+1)+' / '+pages.length;}\nconst actions={\n solo:()=>startRun(), coop:()=>startRun({players:2}),together:()=>open('together'), how:()=>open('how'), settings:()=>open('settings'),about:()=>open('about'),pause,resume,back,\n howPlay:()=>{if(runActive)resume();else startRun();},dev:()=>{if(\"'!hubInfo&&!net?.racing)open('\"'dev');},\n quit:()=>{if(\"'!hubInfo)showTitle();},restart:()=>{if(!hubInfo&&!net?.racing)startRun({players:game.playerCount,mode:game.mode,seed:game.seed});},\n glyphs:()=>{settings.glyphs=settings.glyphs==='\"'ps'?'xbox':'ps';applySettings();},camera:()=>{settings.camera=settings.camera==='arcade'?'overhead':'arcade';applySettings();},motion:()=>{settings.reduced=\"'!settings.reduced;applySettings();},\n fullscreen:()=>{if(document.fullscreenElement)document.exitFullscreen?.().catch(()=>{});else document.documentElement.requestFullscreen?.().catch(()=>toast('\"'FULLSCREEN UNAVAILABLE'));},\n god:()=>{game.tuning.invincible=\"'!game.tuning.invincible;syncDev();},auto:()=>{game.tuning.autopilot=!game.tuning.autopilot;syncDev();},\n repair:()=>{game.lives=game.playerCount>1?4:3;game.players.forEach(p=>{p.boost=100;p.invuln=3;p.shield=4;});syncDev();toast('\"'BUMPERS FIXED · TURBO FULL');},\n skip:()=>{game.skipStage();syncDev();},nextStage:()=>{game.stage=(game.stage+1)%3;game.buildStage();game.phase='countdown';game.wait=2;syncDev();},resetTuning:()=>{Object.assign(game.tuning,DEFAULTS);syncDev();},\n createRoom:()=>createRoom(),joinRoom:()=>{open('join');\"'$('\"'joinCode').value='';updateJoin();},connectRoom:()=>{if(/\"'^'\"\\\\d{4}\"'$/.test($('\"'joinCode').value))createRoom(\"'$('\"'joinCode').value);},erase:()=>{\"'$('\"'joinCode').value=\"'$('\"'joinCode').value.slice(0,-1);updateJoin();},\n leaveRoom:()=>showTitle(),copyCode:async()=>{try{await navigator.clipboard.writeText(net.code);\"'$('\"'roomStatus').textContent='Code copied. Send it to your friends.';}catch{\"'$('\"'roomStatus').textContent='Room code: '+net.code+' · Share these four digits.';}},startRoom:()=>net?.start(),\n resultBack:()=>{if(hubInfo)return;if(net){if(net.isHost)net.lobby();else showTitle();}else showTitle();},again:()=>{if(hubInfo)return;if(net)net.start();else startRun({players:game.playerCount,mode:game.mode});},\n aboutPrev:()=>{aboutPage=(aboutPage+6)%7;renderAbout();},aboutNext:()=>{aboutPage=(aboutPage+1)%7;renderAbout();}\n};\nfunction perform(name){if(\"'!ready||hubEnded)return;if(hubInfo&&['\"'quit','restart','solo','coop','together','createRoom','connectRoom','again','resultBack','dev'].includes(name))return;actions[name]?.();sound.event({type:'menu'});}\nfunction updateJoin(){\"'$('\"'joinCode').value=\"'$('\"'joinCode').value.replace(/\\\\D/g,'').slice(0,4);\"'$('\"'connectRoomButton').disabled=\"'$('\"'joinCode').value.length\"'!==4;}\ndocument.addEventListener('\"'click',e=>{const el=e.target.closest('button');if(\"'!el||!ready)return;if(el.id==='\"'touchBoost')return;const used=activity(e.pointerType==='touch'?'touch':lastInput==='gamepad'?'gamepad':'mouse');if(used)return;sound.unlock();if(el.dataset.action)perform(el.dataset.action);if(el.dataset.digit){\"'$('\"'joinCode').value=(\"'$('\"'joinCode').value+el.dataset.digit).slice(0,4);updateJoin();}});\ndocument.addEventListener('pointerover',e=>{if(\"'!ready||e.pointerType==='\"'touch')return;const el=e.target.closest('button,input');if(el&&screen){focus(el);}});\ndocument.addEventListener('pointermove',e=>{if(\"'!ready)return;if(e.pointerType==='\"'mouse'&&(Math.abs(e.movementX)+Math.abs(e.movementY)>2))activity('mouse');const p=pointers.get(e.pointerId);if(p&&runActive&&\"'!screen){const delta=e.clientX-p.x;if(Math.abs(delta)>32){game.queueLane(0,delta<0?1:-1);p.x=e.clientX;}}});\ndocument.addEventListener('\"'pointerdown',e=>{if(\"'!ready||hubEnded)return;const was=activity(e.pointerType==='\"'touch'?'touch':'mouse');sound.unlock();if(was){e.preventDefault();return;}if(e.pointerType==='touch'&&runActive&&\"'!screen){if(e.target.closest('\"'button')&&e.target.id\"'!=='\"'touchBoost')return;e.preventDefault();pointers.set(e.pointerId,{x:e.clientX,y:e.clientY,boost:e.target.id==='touchBoost'||e.clientX>innerWidth*.6});e.target.setPointerCapture?.(e.pointerId);}else if(e.target===\"'$('\"'world')&&runActive&&\"'!screen){if(e.button===2){mouseBoost=true;e.preventDefault();}else if(e.button===0){const lane=view.pickLane(e.clientX,e.clientY);game.queueLane(0,Math.sign(lane-game.players[0].lane));}}});\nfor(const name of ['\"'pointerup','pointercancel'])document.addEventListener(name,e=>{pointers.delete(e.pointerId);if(e.button===2)mouseBoost=false;});\ndocument.addEventListener('contextmenu',e=>{if(e.target===\"'$('\"'world'))e.preventDefault();});\ndocument.addEventListener('input',e=>{const el=e.target;if(el.id==='joinCode')updateJoin();if(el.id==='musicVolume'){settings.music=Number(el.value);applySettings();}if(el.id==='effectsVolume'){settings.effects=Number(el.value);applySettings();}if(el.dataset.tune){game.tuning[el.dataset.tune]=Number(el.value);syncDev();}});\ndocument.addEventListener('keydown',e=>{if(\"'!ready||hubEnded)return;const was=activity('\"'keyboard');sound.unlock();if(was){e.preventDefault();return;}const key=e.key.toLowerCase(),input=e.target.tagName==='INPUT';if(input&&e.target.type==='text'&&key\"'!=='\"'escape'){if(key==='enter'&&screen==='join'){e.preventDefault();perform('connectRoom');}return;}\n  if([' ','arrowup','arrowdown','arrowleft','arrowright'].includes(key))e.preventDefault();\n  if(key==='escape'||key==='p'){e.preventDefault();if(screen==='')pause();else if(screen==='pause')resume();else back();return;}\n  if(screen){if(e.repeat)return;if(key==='arrowup'||key==='w')navigate(0,-1);else if(key==='arrowdown'||key==='s')navigate(0,1);else if(key==='arrowleft'||key==='a')navigate(-1,0);else if(key==='arrowright'||key==='d')navigate(1,0);else if(key==='enter'||key===' '){e.preventDefault();document.activeElement?.click();}return;}\n  keys.add(key);\n});\ndocument.addEventListener('keyup',e=>keys.delete(e.key.toLowerCase()));\nwindow.addEventListener('blur',()=>{keys.clear();pointers.clear();mouseBoost=false;if(ready&&runActive&&\"'!hubInfo&&!net?.racing&&!attract&&!screen)pause();});\ndocument.addEventListener('\"'visibilitychange',()=>{if(document.hidden){keys.clear();pointers.clear();mouseBoost=false;if(ready&&runActive&&\"'!hubInfo&&!net?.racing&&!attract&&!screen)pause();}});\nfunction pollPads(dt){const pads=[...(navigator.getGamepads?.()||[])].filter(p=>p&&p.connected!==false),values=[];for(let pi=0;pi<pads.length;pi++){const pad=pads[pi],buttons=pad.buttons.map(b=>typeof b==='\"'number'?b:Math.max(b.value||0,b.pressed?1:0)),previous=padHistory.get(pad.index)||[],edge=n=>buttons[n]>.5&&\"'!(previous[n]>.5);const x=pad.axes[0]||0,y=pad.axes[1]||0;const active=buttons.some(b=>b>.5)||Math.abs(x)>.45||Math.abs(y)>.45;\n    let consumed=false;if(active){consumed=activity('\"'gamepad');sound.unlock();}\n    if(\"'!consumed&&pi===0){if(edge(9)&&!(buttons[8]>.5)){if(!screen)pause();else if(screen==='\"'pause')resume();}\n      else if(screen&&screen\"'!=='\"'attract'){menuRepeat-=dt;const dx=buttons[14]>.5?-1:buttons[15]>.5?1:x<-.5?-1:x>.5?1:0,dy=buttons[12]>.5?-1:buttons[13]>.5?1:y<-.5?-1:y>.5?1:0;\n        if((dx||dy)&&menuRepeat<=0){navigate(Math.abs(x)>Math.abs(y)||dx&& \"'!dy?dx:0,Math.abs(x)>Math.abs(y)||dx&&!dy?0:dy);menuRepeat=.2;}\n        if(!dx&&!dy)menuRepeat=0;if(edge(0))document.activeElement?.click();if(edge(1))back();}\n    }\n    values.push({lane:buttons[14]>.5||x<-.4?1:buttons[15]>.5||x>.4?-1:0,boost:buttons[0]>.5||buttons[7]>.3,brake:buttons[6]>.3||buttons[2]>.5});padHistory.set(pad.index,buttons);\n  }return values;\n}\nfunction readInputs(pads){if(!runActive||screen||hubEnded)return;\n  const coop=game.playerCount>1;\n  for(let i=0;i<game.playerCount;i++){let lane=0,boost=false,brake=false;const left=i===0?(keys.has('\"'a')||\"'!coop&&keys.has('\"'arrowleft')):keys.has('arrowleft'),right=i===0?(keys.has('d')||\"'!coop&&keys.has('\"'arrowright')):keys.has('arrowright');lane=left?1:right?-1:0;boost=i===0?keys.has(' ')||mouseBoost:keys.has('enter');brake=i===0?keys.has('s')||\"'!coop&&keys.has('\"'arrowdown'):keys.has('arrowdown');\n    if(pads[i]){lane=pads[i].lane||lane;boost||=pads[i].boost;brake||=pads[i].brake;}\n    if(i===0&&lastInput==='touch'){boost||=[...pointers.values()].some(p=>p.boost);const a=game.players[0],danger=game.rivals.some(b=>b.lane===a.lane&&wrap(b.u-a.u)<.085);if(danger){brake=true;if(\"'!a.queueDir){const options=[1,-1].filter(dir=>a.lane+dir>=0&&a.lane+dir<4);const dir=options.find(dir=>!game.rivals.some(b=>b.lane===a.lane+dir&&wrap(b.u-a.u)<.12));if(dir)game.queueLane(0,dir);}}}\n    game.setInput(i,{lane,boost,brake});\n  }\n}\nfunction shouldTick(){return !hubEnded&&(screen==='\"'title'||attract||runActive&&(\"'!screen||hubInfo||net?.racing)&&!['\"'won','lost','waiting'].includes(game.phase));}\nfunction simulate(dt){if(hubInfo){if(\"'!hubStarted||hubEnded)return;if(!hubRunning&&hub.time()>=0){hubRunning=true;game.phase='\"'playing';event({type:'go'});}if(\"'!hubRunning)return;}if(shouldTick())game.tick(dt);}\nfunction sendOnline(dt){if(hubEnded)return;remoteClock+=dt;progressClock+=dt;if(!(hubInfo&&hubRunning||net?.racing&&runActive))return;\n  if(remoteClock>=.1){remoteClock=0;const a=game.players[0];if(a){const data={u:wrap(a.u),lane:a.lane,stage:game.stage,score:game.score};if(hubInfo)hub.send({type:'\"'ghost',...data},{reliable:false});else net.send({t:'ghost',data});netScores.set(myID(),{score:game.score,done:hubReported||['won','lost'].includes(game.phase)});renderRanks();}}\n  if(hubInfo&&progressClock>=.75){progressClock=0;hub.progress({score:game.score,label:\"'`${game.totalCollected} tokens · shift ${game.stage+1}`});}\n}\nfunction reportHub(){if(!hubInfo||hubReported||hubEnded)return;hubReported=true;hub.progress({score:game.score,label:game.totalCollected+'\"' tokens'});hub.result({score:game.score,stats:{Tokens:game.totalCollected,'Close shaves':game.nearMisses,Gaps:game.gatesTaken,'Shifts cleared':game.stage}});}\nasync function initHub(){hubInfo=await hub.connect({mode:'ghost',seats:[1,4]});if(\"'