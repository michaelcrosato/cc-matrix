m{position:absolute;bottom:3.1vh;left:3vw;right:3vw;display:flex;align-items:flex-end;justify-content:space-between;gap:1.5em}.boost-box{width:12em;max-width:24vw}.boost-label{display:flex;justify-content:space-between;font-size:calc(var(--unit)*.6);letter-spacing:.1em;margin-bottom:.55em}.boost-bar{height:.6em;border:2px solid var(--ink);background:#3a4b5e;box-shadow:0 0 0 1px #6b7b83;transform:skew(-12deg)}.boost-bar i{display:block;height:100%;background:var(--mint);width:100%;transition:width .1s}.queue-label{font-size:calc(var(--unit)*.6);color:var(--mint);letter-spacing:.05em;margin-bottom:.65em;min-height:1.2em}.controls-strip{display:flex;align-items:center;justify-content:center;gap:1.2em;font-size:calc(var(--unit)*.6);letter-spacing:.04em;background:#111b2ccc;padding:.85em 1.15em;border-radius:4px}.controls-strip>span{display:inline-flex;gap:.45em;align-items:center;white-space:nowrap}.run-clock{font-family:Impact,sans-serif;font-size:calc(var(--unit)*1.8);color:var(--gold);min-width:4.2em;text-align:right}.callout{position:fixed;left:0;right:0;top:37%;text-align:center;z-index:2;pointer-events:none;display:none;filter:drop-shadow(0 4px 0 var(--ink))}.callout.visible{display:block}.callout strong{display:inline-block;font-family:Impact,\\\"Arial Black\\\",sans-serif;font-size:clamp(42px,6vw,110px);line-height:1.05;color:var(--cream);background:#111b2ccf;padding:.03em .2em;transform:rotate(-3deg);letter-spacing:.02em}.callout small{display:block;color:var(--mint);font-size:var(--unit);margin-top:.75em;letter-spacing:.05em}.toast{position:fixed;top:21%;left:25%;right:25%;text-align:center;z-index:2;pointer-events:none;color:var(--gold);font-size:calc(var(--unit)*1.2);font-weight:900;opacity:0;transform:translateY(10px);transition:opacity .15s,transform .15s;text-shadow:0 3px 0 var(--ink)}.toast.visible{opacity:1;transform:translateY(0)}.attract-screen{pointer-events:none;flex-direction:column;align-items:center;justify-content:space-between;padding:4vh 4vw}.