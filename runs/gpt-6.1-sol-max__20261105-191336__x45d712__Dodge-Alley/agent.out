'$('\"'lives').setAttribute('aria-label',game.lives+' lives');\n  for(let i=0;i<game.players.length;i++){const a=game.players[i],prefix=i?'p2Boost':'boost';\"'$(i?'\"'p2BoostBar':'boostBar').style.width=a.boost+'%';\"'$(i?'\"'p2BoostAmount':'boostAmount').textContent=Math.floor(a.boost)+'%';\"'$(i?'\"'p2Queue':'queueLabel').textContent=a.shield>0?'SHIELD · '+a.shield.toFixed(1)+'s':a.queueDir>0?'← INWARD QUEUED':a.queueDir<0?'OUTWARD QUEUED →':i?'DRIVER 2 · FIND A GAP':'AUTO-DRIVE · FIND A GAP';}\n  const sec=Math.max(0,Math.ceil(game.timeLeft));\"'$('\"'runClock').textContent=Math.floor(sec/60)+':'+String(sec%60).padStart(2,'0');\n  let title='',sub='';if(hubInfo&&\"'!hubRunning&&!hubEnded){title=hubStarted&&Number.isFinite(hub.time())?Math.max(1,Math.ceil(-hub.time()/1000)):'\"'NIGHT RIVALS';sub=hubStarted?'READY TO ROLL':'WAITING FOR THE HUB';}\n  else if(game.phase==='countdown'){title=String(Math.max(1,Math.ceil(game.wait)));sub=LEVELS[game.stage%3].name+' · '+LEVELS[game.stage%3].subtitle;}\n  else if(game.phase==='stageclear'){title='SHIFT CLEARED\"'!'\"';sub='BONUS +'+(1000+game.lives*250)+' · '+(game.stage%3===2&&game.mode==='arcade'?'THE NIGHT IS YOURS':'NEXT SHIFT COMING UP');}\n  else if(goTimer>0&&game.phase==='playing'){title='LET’S ROLL\"'!'\"';sub='TAKE THE GAPS. KEEP YOUR BUMPERS.';}\n  const visible=\"'!!title&&(!screen||attract);$('\"'callout').classList.toggle('visible',visible);if(visible){\"'$('\"'calloutTitle').textContent=title;\"'$('\"'calloutSubtitle').textContent=sub;}\n}\nfunction frame(ms){if(\"'!ready)return;const dt=Math.min(.05,(ms-(lastFrame||ms))/1000);lastFrame=ms;const pads=pollPads(dt);readInputs(pads);net?.tick(dt);\n  if(!hubInfo&&['\"'title','together'].includes(screen)&&ms-lastActivity>=10000){attract=true;runActive=false;stack=[];game.start({seed:1980,attract:true});display('attract');\"'$('\"'p2Boost').classList.add('hidden');\"'$('\"'runClock').classList.add('hidden');}\n  accumulator+=dt;let safety=0;while(accumulator>=1/60&&safety++<6){simulate(1/60);accumulator-=1/60;}\n  sendOnline(dt);updateHud(dt);view.update(game,dt,\"'!shouldTick());view.render();sound.update(game,!shouldTick());requestAnimationFrame(frame);\n}\nfunction installTestAPI(){window.__dodge={get state(){return {...game.snapshot(),screen,runActive,attract,lastInput,renderer:view.backend,renderCount:view.renderCount,hub:hubInfo?{started:hubStarted,running:hubRunning,ended:hubEnded,reported:hubReported,me:hubInfo.me}:null,room:net?{code:net.code,isHost:net.isHost,connected:net.connected,online:net.online,players:net.players,racing:net.racing,ghosts:view.ghosts.size}:null,musicVolume:sound.musicVolume,audio:sound.levels(),settings:{...settings}};},ready:true};if(TEST)Object.assign(window.__dodge,{action:perform,start:startRun,advance(seconds){const frames=Math.ceil(seconds*60);for(let i=0;i<frames;i++)simulate(1/60);view.update(game,0,!shouldTick());updateHud(0);return game.snapshot();},tune(values){Object.assign(game.tuning,values);syncDev();},input:(id,data)=>game.setInput(id,data),queue:(id,dir)=>game.queueLane(id,dir),idle(ms){lastActivity=performance.now()-ms;},audioProbe:()=>sound.probe(),createRoom:code=>createRoom(code),get ghosts(){return [...view.ghosts.keys()];},get credits(){return data;}});}\nasync function boot(){try{await RAPIER.init();$('\"'bootStatus').textContent='Painting the city. Checking the bumpers…';view=new View(\"'$('\"'world'));game=new Game(RAPIER,event);game.start({seed:1980,attract:true});view.update(game,0);await view.init();makeDev();applySettings();ready=true;if(hub.active)await initHub();else showTitle();\"'$('\"'boot').style.display='none';installTestAPI();requestAnimationFrame(frame);}catch(err){console.error(err);\"'$('\"'bootStatus').textContent='The alley couldn’t open.';\"'$('\"'bootError').style.display='block';\"'$('\"'bootError').textContent='This game needs WebGPU or WebGL 2 and WebAssembly. Try a recent Chrome, Edge, or Safari. '+String(err.message||err);if(hub.active)hub.f