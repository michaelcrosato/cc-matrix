dth:1.65em;padding:0;font-size:.95em}.hud{position:fixed;inset:0;pointer-events:none;z-index:2;display:none;text-shadow:0 2px 0 #111b2c}.hud.visible{display:block}.hud-top{position:absolute;top:3vh;left:3vw;right:3vw;display:flex;align-items:flex-start;justify-content:space-between;gap:1em}.score-block{min-width:11em}.score-label{font-size:calc(var(--unit)*.58);letter-spacing:.21em;color:var(--muted)}.score-number{font-family:Impact,\"Arial Black\",sans-serif;font-size:calc(var(--unit)*2.15);letter-spacing:.025em;line-height:1.2}.multiplier{display:inline-block;font:800 .4em Arial,sans-serif;background:var(--gold);color:var(--ink);text-shadow:none;padding:.35em .4em;border-radius:3px;vertical-align:middle;margin-left:.45em}.tokens-left{color:var(--gold);font-size:calc(var(--unit)*.73);letter-spacing:.04em}.shift-block{text-align:center;background:#111b2cd9;padding:.6em 1.3em;border:1px solid #65717c;border-radius:4px;min-width:15em}.shift-block .shift-number{font-size:calc(var(--unit)*.58);color:var(--mint);letter-spacing:.2em}.shift-name{font-size:calc(var(--unit)*.95);margin-top:.25em;letter-spacing:.05em}.shift-progress{height:3px;background:#485565;margin-top:.5em}.shift-progress i{display:block;height:100%;background:var(--mint);width:0;transition:width .2s}.hud-right{display:flex;align-items:center;gap:1.1em;min-width:11em;justify-content:flex-end}.lives{display:flex;align-items:center;gap:.4em;color:var(--coral);font-size:calc(var(--unit)*1.25)}.life{display:inline-block;width:1.15em;height:.7em;border-radius:4px 4px 2px 2px;background:var(--cream);border:2px solid var(--ink);position:relative;box-shadow:0 2px 0 var(--ink)}.life:before,.life:after{content:'\"'';position:absolute;bottom:-.23em;width:.23em;height:.28em;background:var(--ink)}.life:before{left:.08em}.life:after{right:.08em}.life.empty{background:#53606b}.pause-button{pointer-events:auto;width:2.5em;height:2.5em;padding:0;font-size:var(--unit);background:#111b2ccf;border-color:#65717c}.hud-bottom{position:absolute;bottom:3.1vh;left:3vw;right:3vw;display:flex;align-items:flex-end;justify-content:space-between;gap:1.5em}.boost-box{width:12em;max-width:24vw}.boost-label{display:flex;justify-content:space-between;font-size:calc(var(--unit)*.6);letter-spacing:.1em;margin-bottom:.55em}.boost-bar{height:.6em;border:2px solid var(--ink);background:#3a4b5e;box-shadow:0 0 0 1px #6b7b83;transform:skew(-12deg)}.boost-bar i{display:block;height:100%;background:var(--mint);width:100%;transition:width .1s}.queue-label{font-size:calc(var(--unit)*.6);color:var(--mint);letter-spacing:.05em;margin-bottom:.65em;min-height:1.2em}.controls-strip{display:flex;align-items:center;justify-content:center;gap:1.2em;font-size:calc(var(--unit)*.6);letter-spacing:.04em;background:#111b2ccc;padding:.85em 1.15em;border-radius:4px}.controls-strip>span{display:inline-flex;gap:.45em;align-items:center;white-space:nowrap}.run-clock{font-family:Impact,sans-serif;font-size:calc(var(--unit)*1.8);color:var(--gold);min-width:4.2em;text-align:right}.callout{position:fixed;left:0;right:0;top:37%;text-align:center;z-index:2;pointer-events:none;display:none;filter:drop-shadow(0 4px 0 var(--ink))}.callout.visible{display:block}.callout strong{display:inline-block;font-family:Impact,\\\"Arial Black\\\",sans-serif;font-size:clamp(42px,6vw,110px);line-height:1.05;color:var(--cream);background:#111b2ccf;padding:.03em .2em;transform:rotate(-3deg);letter-spacing:.02em}.callout small{display:block;color:var(--mint);font-size:var(--unit);margin-top:.75em;letter-spacing:.05em}.toast{position:fixed;top:21%;left:25%;right:25%;text-align:center;z-index:2;pointer-events:none;color:var(--gold);font-size:calc(var(--unit)*1.2);font-weight:900;opacity:0;transform:translateY(10px);transition:opacity .15s,transform .15s;text-shadow:0 3px 0 var(--ink)}.toast.visible{opacity:1;transform:translateY(0)}.attract-screen{pointer-events:none;flex-direction:column;align-items:center;justify-content:space-between;padding:4vh 4vw}.demo-tag{align-self:flex-start;background:var(--gold);color:var(--ink);padding:.7em 1em;font-size:var(--unit);letter-spacing:.1em;border:3px solid var(--ink);box-shadow:5px 5px 0 #111b2c}.demo-bottom{background:#111b2ceb;padding:1em 2em;border:1px solid #6e7c87;text-align:center;font-size:var(--unit);letter-spacing:.08em}.demo-bottom small{font-size:.6em;display:block;color:var(--mint);margin-top:.6em}.how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1em;margin:1.5em 0}.how-card{border-top:3px solid var(--mint);background:#1b2c40;padding:1.1em}.how-card b{color:var(--mint);font-family:Impact,sans-serif;font-size:calc(var(--unit)*2)}.how-card h3{font-size:calc(var(--unit)*1.1);line-height:1.1;margin:.5em 0}.how-card p{font-size:calc(var(--unit)*.78);color:#c4ced0;line-height:1.5;margin-bottom:0}.how-note{display:flex;align-items:center;gap:1.2em;padding:.8em;background:#ffce7010;border:1px solid #ffce7040;font-size:calc(var(--unit)*.72);line-height:1.5;color:var(--gold)}.cell-icon{display:inline-block;width:1em;height:1em;background:var(--mint);transform:rotate(45deg);margin:0 .3em}.settings-grid{display:grid;gap:.75em;margin:1.3em 0}.setting{display:flex;align-items:center;justify-content:space-between;gap:1.4em;min-height:2.7em;border-bottom:1px solid #334357;padding-bottom:.55em;font-size:calc(var(--unit)*.86)}.setting label{flex:1}.setting output{width:3.2em;color:var(--mint);text-align:right}.setting input{width:40%;accent-color:var(--mint);height:1.5em;cursor:pointer}.setting input:focus{outline:3px solid var(--mint);outline-offset:5px;border-radius:5px}.setting button{font-size:calc(var(--unit)*.76);min-width:10em}.dev-panel{width:min(1100px,90vw)}.dev-layout{display:grid;grid-template-columns:1.3fr 1fr;gap:2em}.dev-actions{display:grid;gap:.6em;align-content:start;margin-top:1em}.dev-actions button{font-size:calc(var(--unit)*.78)}.dev-status{font-family:monospace;font-size:calc(var(--unit)*.68);color:var(--muted);line-height:1.7;margin-top:1em}.together-grid{display:grid;grid-template-columns:1fr 1fr;gap:1em;margin:1.5em 0}.together-card{background:#1c2e43;border:2px solid #526273;border-radius:5px;padding:1.4em;display:flex;flex-direction:column;gap:.7em}.together-card h3{font-family:Impact,sans-serif;font-size:calc(var(--unit)*1.7);letter-spacing:.035em;margin:0}.together-card p{font-size:calc(var(--unit)*.8);margin:0 0 1em;min-height:3.2em;color:#c2cacc}.together-card button{font-size:calc(var(--unit)*.8);margin-top:auto}.together-card .row{margin:0}.join-code{display:block;background:#25394d;border:2px solid #607484;border-radius:5px;color:var(--gold);font-family:monospace;font-weight:900;font-size:calc(var(--unit)*2.7);letter-spacing:.4em;text-align:center;width:100%;padding:.2em;margin:.4em 0 .6em;user-select:text}.keypad{display:grid;grid-template-columns:repeat(3,1fr);gap:.6em}.keypad button{font-size:calc(var(--unit)*1.1);padding:.6em;min-height:2.2em}.keypad button small{display:inline;font-size:.6em}.room-head{display:flex;justify-content:space-between;align-items:center;margin:1em 0}.room-code{font-family:monospace;font-size:calc(var(--unit)*3);color:var(--gold);letter-spacing:.15em}.roster{display:grid;grid-template-columns:repeat(4,1fr);gap:.6em;margin:1.3em 0}.seat{background:#1e3045;border:2px solid #45576c;min-height:5em;padding:1em .5em;text-align:center;font-size:calc(var(--unit)*.76)}.seat i{display:block;width:1em;height:1em;border-radius:50%;background:#495a6d;margin:0 auto .65em}.seat small{display:block;font-size:.7em;margin-top:.5em;color:var(--muted)}.room-status{font-size:calc(var(--unit)*.72);color:var(--mint);min-height:1.7em}.result-panel{text-align:center}.result-panel h2{font-size:calc(var(--unit)*3)}.result-score{font-family:Impact,\\\"Arial Black\\\",sans-serif;color:var(--gold);font-size:calc(var(--unit)*4.4);letter-spacing:.025em;line-height:1.15}.best-line{font-size:calc(var(--unit)*.65);color:var(--mint);letter-spacing:.15em;margin:.6em 0 1.5em}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1em;margin:1.5em 0}.stat{border-left:1px solid #4e5d6f;font-size:calc(var(--unit)*.62);color:var(--muted);letter-spacing:.06em}.stat:first-child{border-left:0}.stat b{display:block;color:var(--cream);font-family:Impact,sans-serif;font-size:2.6em;margin-bottom:.2em;letter-spacing:.02em}.race-scores{display:grid;gap:.4em;margin:1em 0;text-align:left}.race-scores>div{display:flex;justify-content:space-between;background:#24364a;padding:.6em 1em;font-size:calc(var(--unit)*.85)}.race-scores small{color:var(--muted)}.raceboard{position:fixed;top:21%;right:3vw;min-width:9em;z-index:2;pointer-events:none;font-size:calc(var(--unit)*.63);display:none}.raceboard>div{display:flex;gap:1em;justify-content:space-between;padding:.55em .6em;background:#111b2cdb;margin:.3em 0;border-left:3px solid}.about-grid{display:grid;gap:.9em;margin:1.6em 0;min-height:18em}.about-item{display:grid;grid-template-columns:10.5em 1fr;gap:1em;border-bottom:1px solid #344256;padding-bottom:.8em;font-size:calc(var(--unit)*.78);line-height:1.45}.about-item b{color:var(--mint);font-weight:700}.about-item span{color:#e1e0d5;font-weight:500}.about-feedback .about-item{display:block}.about-feedback .about-item b{display:block;margin-bottom:.3em}.page-counter{font-size:calc(var(--unit)*.7);color:var(--mint);white-space:nowrap;text-align:center}.about-foot{display:flex;align-items:center;gap:1em;justify-content:space-between}.about-foot button{font-size:calc(var(--unit)*.8)}#boot{position:fixed;inset:0;background:var(--ink);z-index:30;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1.4em;text-align:center}.boot-word{font-family:Impact,sans-serif;font-size:clamp(60px,7vw,130px);letter-spacing:-.025em;color:var(--mint);transform:rotate(-3deg)}.boot-track{width:220px;height:4px;background:#3a4a5c;overflow:hidden}.boot-track i{display:block;height:100%;background:var(--mint);animation:loading 1.6s ease-in-out infinite}.boot-status{color:var(--muted);font-size:18px;max-width:70vw;line-height:1.5}.boot-error{display:none;max-width:700px;font-size:20px;font-weight:500;padding:20px}#touchBoost{position:fixed;right:5vw;bottom:10vh;border-radius:50%;width:4.7em;height:4.7em;padding:0;background:#92f1c722;border:2px solid #92f1c7bb;color:var(--mint);font-size:17px;z-index:4;display:none;box-shadow:none}body.touch-playing #touchBoost{display:block}body.touch-playing .controls-strip,body.touch-playing .boost-box,body.touch-playing .tokens-left,body.touch-playing .shift-block,body.touch-playing .score-label{display:none}body.touch-playing .hud-top{top:2vh}body.touch-playing .score-number{font-size:30px}body.touch-playing .hud-right{min-width:0}.touch-note{display:none}body.touch-device .touch-note{display:block}body.touch-device .desktop-note{display:none}.focus-row{display:flex;gap:.6em}.pill{display:inline-block;background:#92f1c718;color:var(--mint);padding:.4em .65em;border-radius:3px;border:1px solid #92f1c740;font-size:calc(var(--unit)*.6);letter-spacing:.12em}.hidden{display:none\"'!important}@keyframes loading{0%{width:0;transform:translateX(0)}50%{width:100%;transform:translateX(0)}100%{width:0;transform:translateX(220px)}}\n@media(max-aspect-ratio:4/3){.title-screen{padding:4vh 6vw;align-items:flex-end;background:linear-gradient(0deg,#111b2c 0%,#111b2cf9 28%,#111b2c8f 52%,transparent 72%)}.title-copy{width:100%;margin-bottom:5vh}h1{font-size:clamp(70px,14vw,150px);display:block;line-height:.8}h1 br{display:none}h1 span{margin-left:.12em}.title-copy .tagline{font-size:20px;max-width:none;margin:2vh 0}.title-buttons{max-width:none;grid-template-columns:1fr 1fr 1fr 1fr;gap:.6em}.title-buttons .primary{grid-column:span 4}.title-stamp{top:4vh;font-size:13px}.edition{margin-bottom:2vh}.title-buttons button{font-size:16px}.title-bottom{font-size:11px;bottom:1.8vh}.panel{width:90vw;padding:26px}h2{font-size:32px}.panel p{font-size:17px}.how-grid{gap:.6em}.how-card{padding:.8em}.how-card h3{font-size:18px}.how-card p{font-size:14px}.hud .shift-block{min-width:12em}.hud-top{left:3vw;right:3vw}.hud-bottom{bottom:2vh}.controls-strip{gap:.8em;font-size:11px}.score-number{font-size:34px}.shift-name{font-size:15px}.kicker{font-size:11px}.setting{font-size:16px}.setting button{font-size:14px}.about-item{font-size:15px}.about-grid{min-height:21em}.roster .seat{font-size:14px}.room-code{font-size:44px}.dev-layout{gap:1em}.boost-box{width:11em}.boost-label,.queue-label{font-size:10px}}\n@media(max-width:600px){:root{--unit:16px}.title-buttons{grid-template-columns:1fr 1fr}.title-buttons .primary{grid-column:span 2}.title-buttons .quiet{grid-column:span 2}.title-copy{margin-bottom:5vh}.title-stamp{width:6em;height:6em;right:6vw}.title-bottom span:last-child{display:none}.panel{padding:20px;max-height:91vh;overflow:auto}.panel.wide{width:94vw}.how-grid{grid-template-columns:1fr;gap:.4em;margin:.8em 0}.how-card{display:grid;grid-template-columns:2em 1fr;padding:.6em .9em;gap:0 .6em}.how-card b{grid-row:span 2;font-size:28px}.how-card h3{margin:0}.how-card p{margin:.25em 0 0;font-size:13px}.how-note{font-size:12px;padding:.6em}.panel .row{margin-top:1em}.panel .row button{font-size:14px}.together-grid{grid-template-columns:1fr;margin:.8em 0;gap:.7em}.together-card{padding:1em}.together-card p{min-height:0;font-size:14px;margin:.1em 0 .5em}.together-card h3{font-size:24px}.together-card button{font-size:15px}.dev-layout{grid-template-columns:1fr}.settings-grid{gap:.4em;margin:.8em 0}.setting{font-size:14px;min-height:2.6em;padding-bottom:.3em}.setting button{font-size:13px;min-width:9em}.dev-actions{grid-template-columns:1fr 1fr;gap:.5em;margin:0}.dev-actions button{font-size:12px}.dev-status{display:none}.about-item{grid-template-columns:7.1em 1fr;font-size:13px;gap:.5em}.about-grid{gap:.7em;min-height:22em;margin:1.2em 0}.about-feedback .about-item{font-size:14px}.about-foot{gap:.5em}.about-foot button{font-size:12px;padding:.8em}.page-counter{font-size:12px}.roster{grid-template-columns:1fr 1fr}.roster .seat{min-height:4em;padding:.7em}.result-panel h2{font-size:36px}.result-score{font-size:68px}.stats{gap:.4em}.stat{font-size:10px}.result-panel .lead{font-size:15px}.room-head{margin:.5em 0}.room-code{font-size:40px}.shift-block{display:none}.hud-right{min-width:0;gap:.6em}.score-block{min-width:0}.lives{font-size:17px;gap:.2em}.pause-button{font-size:18px}.controls-strip{display:none}.run-clock{font-size:28px}.callout strong{font-size:42px}.callout small{font-size:14px;max-width:90vw;margin:.6em auto}.toast{font-size:18px;left:5%;right:5%;top:18%}.raceboard{font-size:10px;top:14%;right:3vw}.demo-bottom{font-size:14px;padding:1em}.demo-tag{font-size:13px}.nav-hint{display:none}.boost-box{max-width:40vw}.menu-stack{gap:.6em;margin-top:1em}.menu-stack button{font-size:16px}.how-controls{font-size:12px!important}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}\n</style>\n</head>\n<body>\n<canvas id=\"world\" aria-label=\"Dodge Alley game arena\"></canvas>\n<div id=\"boot\"><div class=\"boot-word\">DODGE ALLEY.</div><div class=\"boot-track\"><i></i></div><div class=\"boot-status\" id=\"bootStatus\">Warming up the night shift…</div><div class=\"boot-error\" id=\"bootError\"></div></div>\n<div id=\"hud\" class=\"hud\">\n <div class=\"hud-top\"><div class=\"score-block\"><div class=\"score-label\">NIGHT'\"'S TAKINGS</div><div class=\\\"score-number\\\"><span id=\\\"score\\\">000 000</span><span class=\\\"multiplier\\\" id=\\\"multiplier\\\">×1</span></div><div class=\\\"tokens-left\\\" id=\\\"tokensLeft\\\">● 104 TOKENS LEFT</div></div><div class=\\\"shift-block\\\"><div class=\\\"shift-number\\\" id=\\\"shiftNumber\\\">SHIFT 01 / 03</div><div class=\\\"shift-name\\\" id=\\\"shiftName\\\">THE NIGHT SHIFT</div><div class=\\\"shift-progress\\\"><i id=\\\"shiftProgress\\\"></i></div></div><div class=\\\"hud-right\\\"><div class=\\\"lives\\\" id=\\\"lives\\\" aria-label=\\\"Lives\\\"></div><button id=\\\"pauseButton\\\" class=\\\"pause-button\\\" data-action=\\\"pause\\\" aria-label=\\\"Pause\\\">Ⅱ</button></div></div>\n <div class=\\\"hud-bottom\\\"><div class=\\\"boost-box\\\"><div class=\\\"queue-label\\\" id=\\\"queueLabel\\\">AUTO-DRIVE · FIND A GAP</div><div class=\\\"boost-label\\\"><span>1 / TURBO</span><span id=\\\"boostAmount\\\">100%</span></div><div class=\\\"boost-bar\\\"><i id=\\\"boostBar\\\"></i></div></div><div class=\\\"controls-strip\\\" id=\\\"playPrompts\\\"></div><div class=\\\"boost-box hidden\\\" id=\\\"p2Boost\\\"><div class=\\\"queue-label\\\" id=\\\"p2Queue\\\">DRIVER 2</div><div class=\\\"boost-label\\\"><span>2 / TURBO</span><span id=\\\"p2BoostAmount\\\">100%</span></div><div class=\\\"boost-bar\\\"><i id=\\\"p2BoostBar\\\" style=\\\"background:var(--gold)\\\"></i></div></div><div class=\\\"run-clock hidden\\\" id=\\\"runClock\\\">2:30</div></div>\n</div>\n<div id=\\\"callout\\\" class=\\\"callout\\\"><strong id=\\\"calloutTitle\\\"></strong><small id=\\\"calloutSubtitle\\\"></small></div>\n<div id=\\\"toast\\\" class=\\\"toast\\\" role=\\\"status\\\"></div><div id=\\\"raceboard\\\" class=\\\"raceboard\\\"></div>\n<button id=\\\"touchBoost\\\" aria-label=\\\"Hold to boost\\\">BOOST<br>↟</button>\n<section id=\\\"title\\\" class=\\\"screen title-screen\\\" aria-label=\\\"Title menu\\\">\n <div class=\\\"title-copy\\\"><div class=\\\"edition\\\"><i class=\\\"dot\\\"></i> AFTER HOURS · EST. 1980</div><h1>DODGE<br><span>ALLEY.</span></h1><p class=\\\"tagline\\\">Good drivers take turns.<br>Great drivers take the gaps.</p><div class=\\\"title-buttons\\\"><button class=\\\"primary\\\" data-action=\\\"solo\\\" autofocus>PLAY SOLO <b>↗</b></button><button data-action=\\\"together\\\">PLAY TOGETHER</button><button data-action=\\\"how\\\">HOW TO PLAY</button><button data-action=\\\"settings\\\">SETTINGS</button><button class=\\\"quiet\\\" data-action=\\\"about\\\">ABOUT & CREDITS ↗</button></div></div><div class=\\\"title-stamp\\\">FOUR LANES<b>ALL</b>NIGHT LONG</div><div class=\\\"title-bottom\\\"><span id=\\\"titleDevice\\\">KEYBOARD + MOUSE READY</span><span id=\\\"bestScore\\\">BEST 000 000</span><span>A LITTLE NERVE. A LOT OF LEFT TURNS.</span></div>\n</section>\n<section id=\\\"attract\\\" class=\\\"screen attract-screen\\\" aria-label=\\\"Attract mode\\\"><div class=\\\"demo-tag\\\">AFTER-HOURS DEMO ↗</div><div class=\\\"demo-bottom\\\">PRESS ANY BUTTON TO TAKE THE WHEEL<small>AUTOPILOT ON · BUMPERS UNLIMITED</small></div></section>\n<section id=\\\"pause\\\" class=\\\"screen overlay\\\" aria-label=\\\"Pause menu\\\"><div class=\\\"panel\\\"><div class=\\\"kicker\\\">PARK IT FOR A MINUTE</div><h2>TAKE A BREATHER.</h2><p class=\\\"lead\\\" id=\\\"pauseDescription\\\">The road can wait.</p><div class=\\\"menu-stack\\\"><button class=\\\"primary\\\" data-action=\\\"resume\\\">BACK TO THE ROAD <span>↗</span></button><button data-action=\\\"settings\\\">SETTINGS <span>+</span></button><button data-action=\\\"how\\\">HOW TO PLAY <span>?</span></button><button data-action=\\\"dev\\\" id=\\\"devButton\\\">DEVELOPER GARAGE <span>⚙</span></button><button data-action=\\\"restart\\\" id=\\\"restartButton\\\">RESTART THE RUN <span>↺</span></button><button class=\\\"quiet\\\" data-action=\\\"quit\\\" id=\\\"quitButton\\\">RETURN TO TITLE</button></div></div></section>\n<section id=\\\"how\\\" class=\\\"screen overlay\\\" aria-label=\\\"How to play\\\"><div class=\\\"panel wide\\\"><div class=\\\"kicker\\\">THE CAR DRIVES ITSELF. THE NERVE IS YOURS.</div><h2>MAKE THE GAPS.</h2><p class=\\\"lead\\\">Sweep every gold token. Survive three shifts. Keep your bumpers.</p><div class=\\\"how-grid\\\"><div class=\\\"how-card\\\"><b>01</b><h3>PICK YOUR LANE</h3><p>Left goes inward. Right goes outward. Tap early to queue a turn at the next mint crossover.</p></div><div class=\\\"how-card\\\"><b>02</b><h3>PLAY IT COOL</h3><p>Rivals come the other way. Brake to let trouble pass. Boost to slip through before it arrives.</p></div><div class=\\\"how-card\\\"><b>03</b><h3>MAKE IT COUNT</h3><p>Tokens build your multiplier, up to ×5. Close shaves earn extra points. A bump breaks your streak.</p></div></div><div class=\\\"how-note\\\"><span class=\\\"cell-icon\\\"></span><span>Mint power cells refill turbo and give 4 seconds of shield. Turbo also recharges on its own.</span></div><p id=\\\"howControls\\\" class=\\\"how-controls small-copy desktop-note\\\"></p><p class=\\\"small-copy touch-note\\\">Swipe left or right anywhere to queue a lane. Hold the right side to boost. Gentle auto-braking helps you dodge.</p><p class=\\\"small-copy\\\" id=\\\"coopHow\\\">Couch team: share tokens and lives. Driver 1 uses A/D, Space, S. Driver 2 uses ←/→, Enter, ↓. Two controllers work too.</p><div class=\\\"row\\\"><button class=\\\"quiet\\\" data-action=\\\"back\\\">← BACK</button><button class=\\\"primary\\\" data-action=\\\"howPlay\\\">LET'S DRIVE ↗</button></div></div></section>\n<section id=\\\"settings\\\" class=\\\"screen overlay\\\" aria-label=\\\"Settings\\\"><div class=\\\"panel\\\"><div class=\\\"kicker\\\">YOUR KIND OF NIGHT</div><h2>FINE TUNING.</h2><div class=\\\"settings-grid\\\"><div class=\\\"setting\\\"><label for=\\\"musicVolume\\\">Music</label><input id=\\\"musicVolume\\\" type=\\\"range\\\" min=\\\"0\\\" max=\\\"100\\\" step=\\\"1\\\" value=\\\"10\\\" aria-label=\\\"Music volume\\\"><output id=\\\"musicOutput\\\">10%</output></div><div class=\\\"setting\\\"><label for=\\\"effectsVolume\\\">Sound & voices</label><input id=\\\"effectsVolume\\\" type=\\\"range\\\" min=\\\"0\\\" max=\\\"100\\\" step=\\\"1\\\" value=\\\"70\\\" aria-label=\\\"Effects volume\\\"><output id=\\\"effectsOutput\\\">70%</output></div><div class=\\\"setting\\\"><label>Controller prompts</label><button id=\\\"glyphSetting\\\" data-action=\\\"glyphs\\\">PLAYSTATION</button></div><div class=\\\"setting\\\"><label>Camera</label><button id=\\\"cameraSetting\\\" data-action=\\\"camera\\\">ARCADE ANGLE</button></div><div class=\\\"setting\\\"><label>Motion effects</label><button id=\\\"motionSetting\\\" data-action=\\\"motion\\\">FULL</button></div><div class=\\\"setting\\\"><label>Display</label><button data-action=\\\"fullscreen\\\">TOGGLE FULLSCREEN</button></div></div><button class=\\\"primary\\\" data-action=\\\"back\\\" style=\\\"width:100%\\\">ALL SET ↗</button></div></section>\n<section id=\\\"dev\\\" class=\\\"screen overlay\\\" aria-label=\\\"Developer mode\\\"><div class=\\\"panel dev-panel\\\"><div class=\\\"kicker\\\">DEVELOPER GARAGE · LIVE CONTROLS</div><h2>POP THE HOOD.</h2><div class=\\\"dev-layout\\\"><div class=\\\"settings-grid\\\" id=\\\"tuningSliders\\\"></div><div><div class=\\\"dev-actions\\\"><button data-action=\\\"god\\\" id=\\\"godButton\\\">INVINCIBLE: OFF</button><button data-action=\\\"auto\\\" id=\\\"autoButton\\\">AUTOPILOT: OFF</button><button data-action=\\\"repair\\\">REPAIR & REFILL</button><button data-action=\\\"skip\\\">CLEAR THIS SHIFT</button><button data-action=\\\"nextStage\\\">LOAD NEXT SHIFT</button><button data-action=\\\"resetTuning\\\">RESET TO DEFAULTS</button></div><div class=\\\"dev-status\\\" id=\\\"devStatus\\\"></div></div></div><div class=\\\"row\\\"><button class=\\\"quiet\\\" data-action=\\\"back\\\">← PAUSE MENU</button><button class=\\\"primary\\\" data-action=\\\"resume\\\">TEST DRIVE ↗</button></div></div></section>\n<section id=\\\"together\\\" class=\\\"screen overlay\\\" aria-label=\\\"Multiplayer\\\"><div class=\\\"panel wide\\\"><div class=\\\"kicker\\\">A LITTLE FRIENDLY TRAFFIC</div><h2>BETTER WITH COMPANY.</h2><div class=\\\"together-grid\\\"><div class=\\\"together-card\\\"><span class=\\\"pill\\\">1 SCREEN · 2 DRIVERS</span><h3>COUCH CREW</h3><p>Same streets. Shared tokens and bumpers. Two cars are better than one.</p><button class=\\\"primary\\\" data-action=\\\"coop\\\">START A TEAM RUN ↗</button></div><div class=\\\"together-card\\\"><span class=\\\"pill\\\">2–4 SCREENS · GHOST RACE</span><h3>NIGHT RIVALS</h3><p>Two and a half minutes. Matching streets. Highest score buys breakfast.</p><div class=\\\"row\\\"><button class=\\\"primary\\\" data-action=\\\"createRoom\\\">HOST ROOM</button><button data-action=\\\"joinRoom\\\">JOIN ROOM</button></div></div></div><p class=\\\"small-copy\\\">Ghosts show your friends without bumping into them. AI Hub sessions start a ghost race automatically.</p><button class=\\\"quiet\\\" data-action=\\\"back\\\">← BACK</button></div></section>\n<section id=\\\"join\\\" class=\\\"screen overlay\\\" aria-label=\\\"Join online room\\\"><div class=\\\"panel\\\" style=\\\"max-width:560px\\\"><div class=\\\"kicker\\\">FOLLOW YOUR FRIENDS INTO TROUBLE</div><h2>GOT A CODE?</h2><input id=\\\"joinCode\\\" class=\\\"join-code\\\" inputmode=\\\"numeric\\\" pattern=\\\"[0-9]*\\\" maxlength=\\\"4\\\" placeholder=\\\"0000\\\" autocomplete=\\\"off\\\" aria-label=\\\"Four digit room code\\\"><div class=\\\"keypad\\\"><button data-digit=\\\"1\\\">1</button><button data-digit=\\\"2\\\">2</button><button data-digit=\\\"3\\\">3</button><button data-digit=\\\"4\\\">4</button><button data-digit=\\\"5\\\">5</button><button data-digit=\\\"6\\\">6</button><button data-digit=\\\"7\\\">7</button><button data-digit=\\\"8\\\">8</button><button data-digit=\\\"9\\\">9</button><button data-action=\\\"erase\\\">⌫ <small>ERASE</small></button><button data-digit=\\\"0\\\">0</button><button class=\\\"primary\\\" data-action=\\\"connectRoom\\\" id=\\\"connectRoomButton\\\" disabled>JOIN ↗</button></div><button class=\\\"quiet\\\" data-action=\\\"back\\\" style=\\\"width:100%;margin-top:1em\\\">← BACK</button></div></section>\n<section id=\\\"lobby\\\" class=\\\"screen overlay\\\" aria-label=\\\"Online lobby\\\"><div class=\\\"panel wide\\\"><div class=\\\"kicker\\\">NIGHT RIVALS · 2–4 DRIVERS</div><h2>MEET YOU IN THE ALLEY.</h2><div class=\\\"room-head\\\"><div><div class=\\\"small-copy\\\">SHARE THIS ROOM CODE</div><div class=\\\"room-code\\\" id=\\\"roomCode\\\">----</div></div><button data-action=\\\"copyCode\\\">COPY CODE ↗</button></div><div class=\\\"roster\\\" id=\\\"roster\\\"></div><p class=\\\"room-status\\\" id=\\\"roomStatus\\\">Opening the room…</p><div class=\\\"how-note\\\">150 SECONDS · SAME STREETS · FRIENDLY GHOSTS · HIGHEST SCORE WINS</div><div class=\\\"row\\\"><button class=\\\"quiet\\\" data-action=\\\"leaveRoom\\\">← LEAVE ROOM</button><button class=\\\"primary\\\" data-action=\\\"startRoom\\\" id=\\\"startRoomButton\\\" disabled>WAITING FOR DRIVERS</button></div></div></section>\n<section id=\\\"results\\\" class=\\\"screen overlay\\\" aria-label=\\\"Results\\\"><div class=\\\"panel wide result-panel\\\"><div class=\\\"kicker\\\" id=\\\"resultKicker\\\">THAT'S A WRAP</div><h2 id=\\\"resultTitle\\\">CLEAN GETAWAY\"'!</h2><p class=\"lead\" id=\"resultCopy\">The night is yours. Diner'\"'s on the house.</p><div class=\\\"result-score\\\" id=\\\"resultScore\\\">000 000</div><div class=\\\"best-line\\\" id=\\\"resultBest\\\">PERSONAL BEST</div><div class=\\\"stats\\\"><div class=\\\"stat\\\"><b id=\\\"resultTokens\\\">0</b>TOKENS SCOOPED</div><div class=\\\"stat\\\"><b id=\\\"resultNear\\\">0</b>CLOSE SHAVES</div><div class=\\\"stat\\\"><b id=\\\"resultGaps\\\">0</b>GAPS TAKEN</div></div><div class=\\\"race-scores\\\" id=\\\"resultRanks\\\"></div><div class=\\\"row\\\" id=\\\"resultActions\\\"><button class=\\\"quiet\\\" data-action=\\\"resultBack\\\" id=\\\"resultBack\\\">TITLE SCREEN</button><button class=\\\"primary\\\" data-action=\\\"again\\\" id=\\\"againButton\\\">RUN IT BACK ↗</button></div></div></section>\n<section id=\\\"about\\\" class=\\\"screen overlay\\\" aria-label=\\\"About and credits\\\"><div class=\\\"panel wide\\\"><div class=\\\"kicker\\\">DODGE ALLEY · BUILT AFTER HOURS</div><h2 id=\\\"aboutHeading\\\">SOURCE INFORMATION</h2><div class=\\\"about-grid\\\" id=\\\"aboutContent\\\"></div><div class=\\\"about-foot\\\"><button class=\\\"quiet\\\" data-action=\\\"back\\\">← BACK</button><button data-action=\\\"aboutPrev\\\">← PREVIOUS</button><span class=\\\"page-counter\\\" id=\\\"aboutPage\\\">1 / 7</span><button class=\\\"primary\\\" data-action=\\\"aboutNext\\\">NEXT →</button></div></div></section>\n<div class=\\\"nav-hint hidden\\\" id=\\\"navHint\\\"></div>\n<script id=\\\"creditsData\\\" type=\\\"application/json\\\"><\"'!--CREDITS--></script>\n<script type=\"module\"><!--GAME--></script>\n</body>\n</html>\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"cat > shell.html <<'EOF'\n<\"'!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<!--SESSION-->\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#111b2c\">\n<meta name=\"description\" content=\"Dodge Alley — a four-lane, after-hours arcade getaway.\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"ghost\">\n<meta name=\"hub:session-goal\" content=\"Collect tokens and dodge traffic. Highest score wins.\">\n<meta name=\"hub:session-howto\" content=\"Left/right: change at gaps. Space / Cross: boost. Down / L2: brake.\">\n<meta name=\"hub:session-minutes\" content=\"2.5\">\n<title>Dodge Alley</title>\n<style>\n:root{--ink:#111b2c;--deep:#1a283d;--cream:#ffefd1;--mint:#92f1c7;--coral:#ff796c;--gold:#ffce70;--lilac:#b2a0ed;--muted:#b2bec6;--unit:clamp(12px,1.22vw,23px)}\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{width:100%;height:100%;margin:0;overflow:hidden;background:var(--ink);color:var(--cream);font-family:\"Trebuchet MS\",Arial,sans-serif;font-weight:700;touch-action:none;user-select:none}button,input{font:inherit}button{cursor:pointer}canvas#world{display:block;position:fixed;inset:0;width:100%;height:100%;outline:none}button{border:2px solid #65717c;border-radius:5px;background:var(--deep);color:var(--cream);padding:.72em 1.1em;font-size:var(--unit);font-weight:800;letter-spacing:.025em;line-height:1.1;min-height:2.65em;transition:background .1s,transform .1s,border-color .1s;box-shadow:0 4px 0 #080f1b}button:hover,button.focused,button:focus-visible{border-color:var(--mint);outline:3px solid var(--mint);outline-offset:4px;background:#2b4351;z-index:1}button:active{transform:translateY(3px);box-shadow:0 1px 0 #080f1b}button.primary{background:var(--mint);color:var(--ink);border-color:var(--mint);box-shadow:0 5px 0 #397e6c}button.primary:hover,button.primary.focused{background:#c0ffdf}button.gold{background:var(--gold);color:var(--ink);border-color:var(--gold)}button.quiet{border-color:transparent;background:transparent;box-shadow:none;color:var(--muted)}button:disabled{opacity:.4;cursor:default;outline:none}button small{font-size:.65em;font-weight:700;display:block;opacity:.7;margin-top:.4em}button:focus{outline:none}button.focused{outline:3px solid var(--mint)}.screen{position:fixed;inset:0;display:none;z-index:3}.screen.active{display:flex}.kicker{text-transform:uppercase;font-size:calc(var(--unit)*.67);letter-spacing:.22em;color:var(--mint);line-height:1.5}.subtle{color:var(--muted)}.title-screen{padding:5.5vh 5vw;background:linear-gradient(90deg,rgba(17,27,44,.98) 0%,rgba(17,27,44,.95) 27%,rgba(17,27,44,.73) 37%,transparent 61%);align-items:center}.title-copy{width:36%;position:relative}.edition{display:inline-flex;align-items:center;gap:1em;color:var(--cream);font-size:calc(var(--unit)*.63);letter-spacing:.15em;margin-bottom:2.2vh}.edition .dot{width:.6em;height:.6em;border-radius:50%;background:var(--coral);box-shadow:0 0 0 5px #ff796c20}h1{font-family:Impact,\"Arial Black\",sans-serif;font-weight:900;font-size:clamp(60px,7.75vw,148px);letter-spacing:-.045em;line-height:.84;margin:0 0 .2em;transform:rotate(-3deg);text-shadow:5px 6px 0 #080e19}h1 span{color:var(--mint)}.title-copy .tagline{font-size:calc(var(--unit)*.9);line-height:1.45;font-weight:500;max-width:22em;margin:2.5vh 0 3vh;color:#e4dbca}.title-buttons{display:grid;grid-template-columns:1fr 1fr;gap:.7em;max-width:24em}.title-buttons .primary{grid-column:span 2;text-align:left;display:flex;justify-content:space-between;align-items:center}.title-buttons button{font-size:calc(var(--unit)*.8)}.title-buttons .primary{font-size:var(--unit);min-height:3em}.title-buttons .primary b{font-size:1.5em}.title-bottom{position:fixed;bottom:3.4vh;left:5v