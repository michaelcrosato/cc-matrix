ll ops"}},"wire_ingest_context":{"toolu_01CjnheowMuWRaDFNprPSTh5":{"cwd":"/home/micha/dev/cc-matrix/runs/claude-opus-5-5-medium.build__20261103-184337__xe162c9/work/OperationWolfpack-OperationWolf-claude-opus-5-5-medium-20261103-184337"}}}
