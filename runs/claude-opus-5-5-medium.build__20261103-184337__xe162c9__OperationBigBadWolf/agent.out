assert a in s\ns=s.replace(a,\"    if (e.gone || e.hidden || (e.dead && !(e.T.wreck && e.deadT < 6))) return;\\n    const v = this.view;\\n    if (e.T.shapes) return e.T.shapes(this, e, out);\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"approach\" engine/API-INDEX.md | head -3","description":"Patch wreck cover shapes; check approach"}}}
