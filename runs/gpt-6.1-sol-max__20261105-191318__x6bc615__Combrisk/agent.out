p:t.hp,score:t.score,alive:t.alive,reveal:t.reveal,invuln:t.invuln,shield:t.shield,rapid:t.rapid,dash:t.dash,boostCd:t.boostCd,reload:t.reload,respawn:t.respawn,fireSeq:t.fireSeq,kills:t.kills,bankKills:t.bankKills,shots:t.shots,deaths:t.deaths})),bullets:this.bullets.map(b=>({...b})),pickups:this.pickups.map(p=>({...p})),destroyed:[...this.destroyed],events:this.events};}\n  applyRemote(s,localSeat=1){const changed=!this.remoteState||s.serial!==this.remoteState.serial||s.heat!==this.remoteState.heat;this.remote=true;this.remoteState=s;s.tanks.forEach(t=>t.local=t.seat===localSeat);if(changed){this.buildHeat(s.heat);this.remote=true;this.mode=s.mode;this.remoteState=s;this.lastRemoteEvent=0;}for(const e of s.events||[])if(e.seq>(this.lastRemoteEvent||0)){this.onEvent(e);this.lastRemoteEvent=e.seq;}this.phase=s.phase;this.heat=s.heat;this.finished=s.finished;}\n  aimPath(t,max=26){if(!t||!t.alive||!this.world||this.remote)return[];let x=t.x,z=t.z,dx=-Math.sin(t.aim),dz=-Math.cos(t.aim),banks=0;const points=[];for(let i=0;i<max;i++){const d=.65;const hit=this.world.castRayAndGetNormal(new RAPIER.Ray({x,y:.8,z},{x:dx,y:0,z:dz}),d,true,undefined,undefined,undefined,t.body,c=>this.colliderData.get(c.handle)?.type!=='\"'tank');if(hit){if(banks>=this.level.bounces)break;const dot=dx*hit.normal.x+dz*hit.normal.z;dx-=2*dot*hit.normal.x;dz-=2*dot*hit.normal.z;x+=hit.normal.x*.12;z+=hit.normal.z*.12;banks++;}else{x+=dx*d;z+=dz*d;}if(i>1)points.push({x,z});}return points;}\n  dev(action){if(action==='repair')for(const t of this.tanks)if(t.human){if(\"'!t.alive)this.spawn(t);t.hp=3;t.shield=true;}if(action==='\"'pickups'){this.pickups=[];this.addPickup('repair',-12,3);this.addPickup('shield',0,7);this.addPickup('rapid',12,-3);}if(action==='next'){this.finished=false;this.buildHeat((this.heat+1)%4);}if(action==='restart'){this.finished=false;this.buildHeat(this.heat);}if(action==='win'){const t=this.tanks[0];t.score=this.tuning.target;this.endHeat();}}\n}\nexport {RAPIER,ZERO};\n