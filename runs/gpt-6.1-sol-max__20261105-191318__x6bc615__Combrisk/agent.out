{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The random title draw selected **Combrisk**. I’m giving it a paper-and-ink tabletop look: chunky toy vehicles, warm sand, teal shadows, and bright ricochet trails. The four-heat circuit introduces open duels, bank-shot scoring, ghost tanks, and biplane flight in sequence."}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > src/audio.js <<'EOF'\nexport class Sound {\n  constructor() { this.ctx=null; this.music=.1; this.sfx=.65; this.master=.75; this.on=true; this.next=0; this.step=0; this.history=[]; }\n  async wake() {\n    if(\"'!this.ctx){\n      const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;\n      this.ctx=new AC();this.out=this.ctx.createGain();this.out.gain.value=this.master;this.out.connect(this.ctx.destination);\n      this.analyser=this.ctx.createAnalyser();this.analyser.fftSize=512;this.out.connect(this.analyser);\n      this.musicBus=this.ctx.createGain();this.musicBus.gain.value=this.music;this.musicBus.connect(this.out);\n      this.fxBus=this.ctx.createGain();this.fxBus.gain.value=this.sfx;this.fxBus.connect(this.out);\n      const n=this.ctx.createBuffer(1,this.ctx.sampleRate,this.ctx.sampleRate), a=n.getChannelData(0);let seed=7483;\n      for(let i=0;i<a.length;i++){seed=(Math.imul(seed,1664525)+1013904223)|0;a[i]=(seed/2147483648)*.7;}this.noise=n;\n    }\n    if(this.ctx.state==='\"'suspended')await this.ctx.resume();\n  }\n  volumes(settings){this.music=settings.music;this.sfx=settings.sfx;this.master=settings.master;if(this.ctx){this.musicBus.gain.value=this.music;this.fxBus.gain.value=this.sfx;this.out.gain.value=this.on?this.master:0;}}\n  mute(v){this.on=\"'!v;if(this.out)this.out.gain.setTargetAtTime(v?0:this.master,this.ctx.currentTime,.025);}\n  tone(freq,dur=.1,type='\"'square',vol=.1,bus=null,when=0,end=null){\n    if(\"'!this.ctx)return;const t=when||this.ctx.currentTime,o=this.ctx.createOscillator(),g=this.ctx.createGain();o.type=type;o.frequency.setValueAtTime(freq,t);if(end)o.frequency.exponentialRampToValueAtTime(Math.max(end,10),t+dur);\n    g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(Math.max(vol,.0002),t+.006);g.gain.exponentialRampToValueAtTime(.0001,t+dur);\n    o.connect(g);g.connect(bus||this.fxBus);o.start(t);o.stop(t+dur+.02);this.history.push({freq,dur,type,vol,bus:bus===this.musicBus?'\"'music':'sfx'});if(this.history.length>100)this.history.shift();\n  }\n  hiss(dur,vol=.2,cutoff=1400){if(\"'!this.ctx)return;const t=this.ctx.currentTime,n=this.ctx.createBufferSource(),f=this.ctx.createBiquadFilter(),g=this.ctx.createGain();n.buffer=this.noise;f.type='\"'lowpass';f.frequency.value=cutoff;g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.0001,t+dur);n.connect(f);f.connect(g);g.connect(this.fxBus);n.start(t);n.stop(t+dur);}\n  play(name){\n    if(\"'!this.ctx||!this.on)return;\n    if(name==='\"'shot'){this.tone(140,.12,'triangle',.25,null,0,48);this.hiss(.065,.18,1700);}\n    if(name==='bounce'){this.tone(760,.09,'square',.085,null,0,1250);this.tone(1580,.12,'sine',.08);}\n    if(name==='hit'){this.tone(90,.16,'sawtooth',.18,null,0,32);this.hiss(.18,.3,1000);}\n    if(name==='boom'){this.tone(82,.45,'triangle',.45,null,0,20);this.hiss(.55,.5,650);this.tone(240,.13,'square',.08,null,0,40);}\n    if(name==='boost'){this.tone(100,.25,'sawtooth',.12,null,0,500);this.hiss(.3,.18,2400);}\n    if(name==='pickup'){[440,660,880].forEach((n,i)=>this.tone(n,.14,'square',.1,null,this.ctx.currentTime+i*.07));}\n    if(name==='click')this.tone(480,.055,'triangle',.12,null,0,680);\n    if(name==='tick')this.tone(620,.12,'square',.08);\n    if(name==='go'){this.tone(880,.25,'square',.14);this.voice('go');}\n    if(name==='win'){[440,554,659,880].forEach((n,i)=>this.tone(n,.3,'triangle',.2,null,this.ctx.currentTime+i*.13));this.voice('win');}\n    if(name==='lose'){this.tone(220,.5,'triangle',.17,null,0,98);this.voice('oops');}\n  }\n  voice(line='go') {if(\"'!this.ctx)return;const seq=line==='\"'win'?[640,880,720,1050,840]:line==='oops'?[440,330,280]:[350,590,450,790];seq.forEach((f,i)=>{this.tone(f,.065+i*.004,'sawtooth',.028,null,this.ctx.currentTime+i*.095,f*1.35);this.tone(f*2.2,.05,'sine',.035,null,this.ctx.currentTime+i*.095);});}\n  update(playing){if(\"'!this.ctx||!this.on||this.ctx.state!=='\"'running')return;const now=this.ctx.currentTime;if(this.next<now-.2)this.next=now+.03;const bpm=playing?118:96,beat=60/bpm/2;const bass=[110,110,146.83,130.81,110,164.81,146.83,98];const lead=[440,0,523.25,587.33,0,659.25,587.33,523.25,440,0,329.63,392,440,0,392,329.63];let catchup=0;\n    while(this.next<now+.12&&catchup++<4){const s=this.step++;if(s%2===0)this.tone(bass[(s/2)%8|0],beat*1.4,'triangle',.19,this.musicBus,this.next);const n=lead[s%16];if(n)this.tone(n,beat*.55,'square',.035,this.musicBus,this.next);this.tone(s%4===0?65:180,beat*.2,'triangle',s%4===0?.24:.06,this.musicBus,this.next,s%4===0?30:120);this.next+=beat;}\n  }\n  levels(){if(\"'!this.analyser)return {rms:0,peak:0};const a=new Float32Array(this.analyser.fftSize);this.analyser.getFloatTimeDomainData(a);let sum=0,peak=0;for(const v of a){sum+=v*v;peak=Math.max(peak,Math.abs(v));}return {rms:Math.sqrt(sum/a.length),peak};}\n}\nEOF\ncat > src/input.js <<'\"'EOF'\nconst clamp=(x,a,b)=>Math.min(b,Math.max(a,x));\nexport class Input {\n  constructor(canvas){\n    this.canvas=canvas;this.keys=new Set();this.mouse={x:0,y:0,down:false,active:false};this.device='keyboard';this.pads=[];this.edges={};this.oldPads=new Map();this.touch=new Map();this.lastInput=performance.now();this.onActivity=()=>{};this.onPause=()=>{};this.onConfirm=()=>{};this.onMenu=()=>{};this.onBack=()=>{};this.onTouch=()=>{};this.menu=true;this.blocked=false;this.justBoost=false;this.lastTap=0;\n    const activity=(d)=>this.activity(d);\n    window.addEventListener('keydown',e=>{if(e.target.matches('textarea,input:not([type=range])'))return;activity('keyboard');this.keys.add(e.code);if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Tab'].includes(e.code))e.preventDefault();if(\"'!e.repeat){if(e.code==='\"'Escape')this.onPause();if(this.menu){if(e.code==='Enter'||e.code==='Space')this.onConfirm();if(e.code==='ArrowUp'||e.code==='KeyW')this.onMenu(0,-1);if(e.code==='ArrowDown'