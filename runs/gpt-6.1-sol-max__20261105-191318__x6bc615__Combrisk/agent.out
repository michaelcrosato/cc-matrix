y\">A pocket-sized ricochet rivalry.<br>Four heats. Two tracks. Absolutely no brakes.</p><div class=\"menu-stack\">${btn(\"solo\", \"Play the circuit\", \"1 PLAYER\")}${btn(\"versus\", \"Settle a score\", \"VERSUS\")}</div><div class=\"secondary-row\">${textbtn(\"how\", \"How to play\")}${textbtn(\"settings\", \"Settings\")}${textbtn(\"about\", \"About\")}</div><div class=\"title-foot\">INSPIRED BY COMBAT · 1977<br><span id=\"title-prompts\">${this.menuPrompts()}</span><br>STAND BY FOR A LITTLE FRIENDLY FIRE.</div></div><div class=\"title-sticker\"><strong>4 HEATS.<br>1 GOOD<br>GRUDGE.</strong><span>TANKS · RICOCHETS · GHOSTS · BIPLANES</span></div>`,\n\t\t);\n\t\tthis.hideHud();\n\t\t$(\"attract\").hidden = true;\n\t}\n\tmenuPrompts() {\n\t\treturn this.input.device === \"pad\"\n\t\t\t? `${this.glyph(\"move\")} Choose &nbsp; ${this.glyph(\"confirm\")} Select &nbsp; ${this.glyph(\"back\")} Back`\n\t\t$(\"announce\").textContent = \"\";\n\t\t$(\"dev-badge\").textContent = \"\";\n\t}\n\ttoast(text) {\n\t\t$(\"toast\").textContent = text;\n\t\tthis.toastUntil = performance.now() + 3000;\n\t}\n\tannounce(text) {\n\t\t$(\"announce\").textContent = text;\n\t\tthis.announceUntil = performance.now() + 1800;\n\t}\n\ttouchSticks(touches) {\n\t\tfor (const id of [\"touch-left\", \"touch-right\"])\n\t\t\t$(id).style.display = \"none\";\n\t\t$(\"touch-boost\").style.display = \"none\";\n\t\tif (this.name !== \"game\") return;\n\t\tfor (const t of touches.values()) {\n\t\t\tconst e = $(t.right ? \"touch-right\" : \"touch-left\");\n\t\t\te.style.display = \"block\";\n\t\t\te.style.left = `${t.sx}px`;\n\t\t\te.style.top = `${t.sy}px`;\n\t\t\tconst dx = t.x - t.sx,\n\t\t\t\tdz = t.y - t.sy,\n\t\t\t\tl = Math.hypot(dx, dz),\n\t\t\t\tf = l > 55 ? 55 / l : 1;\n\t\t\te.firstChild.style.transform = `translate(${dx * f}px,${dz * f}px)`;\n\t\t\tif (t.right) {\n\t\t\t\tconst b = $(\"touch-boost\");\n\t\t\t\tb.style.display = \"block\";\n\t\t\t\tb.style.left = `${Math.min(innerWidth - 55, t.sx + 65)}px`;\n\t\t\t\tb.style.top = `${Math.max(70, t.sy - 90)}px`;\n\t\t\t}\n\t\t}\n\t}\n\tupdate(state, dt, attract = false, game = null) {\n\t\tconst now = performance.now();\n\t\tif (now > this.toastUntil) $(\"toast\").textContent = \"\";\n\t\tif (now > this.announceUntil) $(\"announce\").textContent = \"\";\n\"\"\"One command: npm test. Prints failures and one count; artifacts stay here.\"\"\"\n\nfrom __future__ import annotations\n\nimport functools\nimport http.server\nimport json\nimport os\nimport threading\nimport time\nimport urllib.parse\nimport urllib.request\nfrom pathlib import Path\n\nfrom playwright.sync_api import sync_playwright\n\nROOT = Path(__file__).resolve().parents[1]\nSTEM = json.loads((ROOT / \"title-selection.json\").read_text())[\"stem\"]\nGAME = ROOT.parent / (STEM + \".html\")\nART = ROOT / \"artifacts\"\nos.environ[\"TMPDIR\"] = str(ART / \"browser-tmp\")\n(ART / \"browser-tmp\").mkdir(exist_ok=True)\nchecks = []\nfailures = []\nreports = {}\n\n\ndef check(name, condition, detail=\"\"):\n    checks.append(name)\n    (ART / \"test-progress.json\").write_text(\n        json.dumps({\"last\": name, \"checks\": checks, \"failures\": failures}, indent=2)\n    )\n    if not condition:\n        failures.append({\"test\": name, \"detail\": str(detail)})\n        print(\"FAIL \" + name + (\": \" + str(detail) if detail else \"\"), flush=True)\n                            frame.evaluate(\n                                \"({url:location.href,ready:window.COMBRISK?.ready,error:window.COMBRISK?.error,boot:document.getElementById('boot-status')?.textContent,kind:window.COMBRISK?.net.kind,backend:window.COMBRISK?.backend,info:window.COMBRISK?.net.info,frames:window.COMBRISK?.frameCount})\"\n                            )\n                        )\n                    except Exception as e:\n                        details.append(str(e))\n                bad.append({\"frames\": details, \"log\": report[\"log\"][-12:]})\n            check(\n                f\"AI Hub {players} players / {scenario}\"\n                + (\" / latency and loss\" if rough else \"\"),\n                report[\"pass\"],\n                bad,\n            )\n            c.close()\n\n        for players, scenario, rough in [\n            (2, \"standard\", False),\n            (4, \"standard\", True),\n            (4, \"host-leave\", True),\n            (2, \"server\", False),\n        ]:\n            guarded(\n                f\"Hub scenario {players}/{scenario}\",\n                lambda n=players, s=scenario, r=rough: hub_scenario(n, s, r),\n            )\n        browser.close()\nfinally:\n    server.shutdown()\n    server.server_close()\n    result = {\n        \"checks\": len(checks),\n        \"passed\": len(checks) - len(failures),\n        \"failures\": failures,\n        \"reports\": reports,\n    }\n    (ART / \"test-results.json\").write_text(json.dumps(result, indent=2) + \"\\n\")\n    print(\n        f\"{len(checks) - len(failures)}/{len(checks)} checks passed; {len(failures)} failures\",\n        flush=True,\n    )\nraise SystemExit(1 if failures else 0)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/game.js');s=p.read_text().replace(': names[i]),', ': this.mode === \\\"link\\\" ? (i === 0 ? \\\"HOST\\\" : \\\"RIVAL\\\") : names[i]),');p.write_text(s)\np=Path('src/ui.js');s=p.read_text();s=s.replace('const e = a[i];\\\\n\\\\t\\\\tif (x', '''const e = a[i];\n        if(y && e?.classList.contains(\\\"about-scroll\\\")){\n            const end=e.scrollHeight-e.clientHeight;\n            if((y>0 && e.scrollTop<end-4)||(y<0 && e.scrollTop>4)){\n                e.scrollBy({top:y*130,behavior:\\\"smooth\\\"});return;\n            }\n        }\n        if (x''',1)\ns=s.replace('if (t.right) {\\\\n\\\\t\\\\t\\\\t\\\\tconst b', 'if (t.right && (this.lastState?.tanks.find(v=>v.local)?.boostCd||0)<=0) {\\\\n\\\\t\\\\t\\\\t\\\\tconst b')\ns=s.replace('b.style.display = \\\"block\\\";\\\\n\\\\t\\\\t\\\\t\\\\tb.style.left', 'b.style.display = \\\"block\\\";\\\\n                b.textContent=this.lastState?.vehicle===\\\"plane\\\"?\\\"ROLL\\\":\\\"BOOST\\\";\\\\n\\\\t\\\\t\\\\t\\\\tb.style.left')\ns=s.replace('update(state, dt, attract = false, game = null) {\\\\n', 'update(state, dt, attract = false, game = null) {\\\\n        this.lastState=state;\\\\n')\ns=s.replace('this.hudTick = 0;\\\\n\\\\t\\\\t\"'$(\"hud\").hidden'\"', 'this.hudTick = 0;\\\\n        if(this.input.device===\\\"touch\\\")this.touchSticks(this.input.touch);\\\\n\\\\t\\\\t\"'$(\"hud\").hidden'\"')\np.write_text(s)\np=Path('tests/check.py');s=p.read_text().replace('import os\\\\n','import os\\\\nimport sys\\\\n').replace('except Exception:\\\\n','except Exception:  # noqa: BLE001 - test groups must report every failure\\\\n').replace('except Exception as e:\\\\n','except Exception as e:  # noqa: BLE001 - diagnostic for a removed frame\\\\n')\n# Insert the couch-ghost fairness check before the campaign starts.\npos=s.index('        def campaign():')\nextra='''        def couch_ghosts():\n            js(page,\\\"COMBRISK.game.start('local',2);COMBRISK.ui.clear();COMBRISK.game.tanks.forEach(t=>{t.invuln=0;t.reveal=0});COMBRISK.view.sync(COMBRISK.snapshot(),.02)\\\")\n            check(\\\"couch ghost duel treats both players equally\\\",js(page,\\\"\"'!COMBRISK.view.tanks.get(0).root.visible&&!COMBRISK.view.tanks.get(1).root.visible\"))\n        guarded(\"couch ghost fairness\",couch_ghosts)\n\n'\"'''\ns=s[:pos]+extra+s[pos:]\n# Scroll the About screen with the same navigation path used by a pad.\nneedle='''            page.keyboard.press(\\\"Escape\\\")\n            page.locator(\\\"[data-action=quit]\\\").click()'''\nrep='''            page.locator(\\\".about-scroll\\\").focus()\n            js(page,\\\"COMBRISK.ui.navigate(0,1)\\\")\n            page.wait_for_function(\\\"document.querySelector('.about-scroll').scrollTop>0\\\")\n            check(\\\"controller scrolls long credits\\\",page.locator('.about-scroll').evaluate('(e)=>e.scrollTop')>0)\n            page.keyboard.press(\\\"Escape\\\")\n            page.locator(\\\"[data-action=quit]\\\").click()'''\ns=s.replace(needle,rep)\n# Optional visual composition captures; no screenshots used as a gameplay assertion.\nneedle='''        check(\\\"standalone has no runtime errors\\\", not errors, errors[:6])'''\nextra='''        if \\\"--capture\\\" in sys.argv:\n            page.set_viewport_size({\\\"width\\\":1920,\\\"height\\\":1080})\n            js(page,\\\"COMBRISK.title()\\\")\n            page.wait_for_timeout(500)\n            page.screenshot(path=str(ART/\\\"final-title.png\\\"))\n            js(page,\\\"COMBRISK.start();COMBRISK.game.countdown=0;COMBRISK.game.cheats.aiPaused=true;COMBRISK.game.tanks.forEach(t=>t.invuln=0)\\\")\n            page.wait_for_timeout(500)\n            page.screenshot(path=str(ART/\\\"final-tanks.png\\\"))\n            js(page,\\\"COMBRISK.game.buildHeat(3);COMBRISK.game.countdown=0;COMBRISK.game.tanks.forEach(t=>t.invuln=0)\\\")\n            page.wait_for_timeout(500)\n            page.screenshot(path=str(ART/\\\"final-air.png\\\"))\n'''\ns=s.replace(needle,extra+needle)\nneedle='''            p.locator(\\\"[data-action=solo]\\\").tap()'''\ns=s.replace(needle,'''            if \\\"--capture\\\" in sys.argv:p.screenshot(path=str(ART/\\\"final-phone-title.png\\\"))\n'''+needle)\n# Add rendered harness coverage in a fresh GPU process, avoiding retained GL test devices.\ns=s.replace('def hub_scenario(players, scenario=\\\"standard\\\", rough=False):','def hub_scenario(players, scenario=\\\"standard\\\", rough=False, rendered=False):')\ns=s.replace('\\\"game\\\": \\\"../../\\\" + GAME.name + \\\"?headless=1\\\",','\\\"game\\\": \\\"../../\\\" + GAME.name + (\\\"\\\" if rendered else \\\"?headless=1\\\"),')\ns=s.replace('f\\\"AI Hub {players} players / {scenario}\\\"\\\\n', 'f\\\"AI Hub {players} players / {scenario}\\\" + (\\\" / rendered\\\" if rendered else \\\" / headless\\\")\\\\n')\nneedle='''        browser.close()\nfinally:'''\nrep='''        browser.close()\n        # A normal rendered session also has to pass the supplied harness.\n        for n in [2,4]:\n            browser=pw.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n            guarded(f\\\"rendered Hub {n}\\\",lambda n=n:hub_scenario(n,rough=n==4,rendered=True))\n            browser.close()\nfinally:'''\ns=s.replace(needle,rep)\np.write_text(s)\nPY\ncat > README.md <<'EOF'\n# Combrisk\n\nAn original paper-and-ink arena shooter inspired by **Combat (1977)**. The distributable is the single HTML file beside this folder. Open it directly in a current browser. All code, art, textures, physics WASM and engine code are embedded; playing offline needs no downloads.\n\n## Play\n\n- **Circuit:** four 75-second heats, each first to five points. Open tank duels, double-value bank shots, ghost tanks, then wrapping biplanes. A complete circuit takes about five minutes.\n- **Couch duel:** two players share a screen. Select any arena on the Versus screen.\n- **Link duel:** host creates an invitation; guest pastes it and sends back a reply; host pastes the reply. Connections use native WebRTC and public STUN, with no account or signalling server. No TURN relay is supplied, so some NAT/firewall combinations cannot connect.\n- **AI Hub:** launch the file from a Hub session. Protocol v1 shared world, 1–4 seats, authoritative host, playerless server support, automatic ready, timed results, departure handling and no networking outside the Hub transport during sessions.\n\nLeft stick moves, right stick aims, R2/RT fires, L1/LB or Cross/A boosts. Keyboard: WASD + mouse, click/Space fires, Shift boosts, Escape pauses. Couch P2 uses arrows, IJKL, \"'`/` and `.`. One pad controls P2 in couch mode; two pads control both. Touch uses contact-only invisible sticks, assisted aim/fire for one-thumb play, and a contextual boost button. Ghost couch duels hide both tanks equally between shots.\n\nThe title enters an AI-played attract loop after ten idle seconds; any input returns to the title. Settings save locally. Music defaults to 10%. Pause → Developer tools provides six live balance sliders, invincibility, AI freeze, slow motion, physics wireframes, healing, pickup spawning and heat skip/restart.\n\n## Build and test\n\nExact dependencies are in `package-lock.json`. From this folder:\n\n```sh\nnpm ci\nnpm run build\nnpm test\n```\n\n`npm test` uses the installed Playwright Python environment, opens its own loopback server on an OS-selected port, confirms the served title, and closes that server and its browsers. Output contains only failed checks and one count. JSON results are in `artifacts/test-results.json`. `npm test -- --capture` also captures title, tank, air and phone compositions for visual review. Screenshots do not stand in for gameplay assertions.\n\nThe suite covers file-URL WebGPU startup, the WebGL fallback, Rapier collisions and swept ricochets, cover destruction, armour, respawn, all pickups, ghost visibility, aircraft/shot wrapping, a four-heat playthrough, dev controls, controller emulation, touch, Web Audio signal levels, two-page WebRTC and the supplied Hub conformance scenarios. Protocol stress checks can run without graphics using `?headless=1`; normal rendered Hub scenarios run separately with fresh GPU processes. `?renderer=webgl` forces Three'\"'s fallback for visual checking on software GPUs.\n\n## Content and architecture\n\nEdit \"'`content/arenas.json` to author heat copy, vehicle rules, bounce limits and cover layouts. Every obstacle has `x`, `z`, `w`, `d` and `crate`; the same definition builds the visual mesh, physics collider and AI navigation obstacle. Courts are 36 × 24 world units, centred on the origin. Fixed perimeter walls and safe respawn points are supplied by the simulation. Rebuild to embed changes into the shareable HTML.\n\n`src/game.js` owns simulation and scoring; `view.js` creates the procedural diorama and native Three AnimationMixers; `input.js` normalises pad, keyboard, mouse and touch; `audio.js` synthesises every sound; `network.js` contains host authority and transports; `ui.js` owns menus and HUD; `main.js` coordinates lifecycle. `build.mjs` bundles everything with esbuild, embeds the unmodified AI Hub client first in the head, and embeds the exit interview into About/Credits.\n\nThree.js r180: MIT. Rapier 0.19.3: Apache-2.0. The supplied Hub integration files are preserved in `reference/`. No source game assets, external images, recorded audio or internet research were used. `title-selection.json` records the real cryptographic random draw among fifty brainstormed titles.\nEOF\nrm tests/smoke.py tests/visual.py\nbiome check --write src/*.js build.mjs --max-diagnostics=5\nruff check --fix tests/check.py\nruff format tests/check.py\nnode build.mjs\nTMPDIR=\"$PWD/artifacts/browser-tmp\" /home/micha/.local/share/pipx/venvs/playwright/bin/python tests/check.py --capture'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
