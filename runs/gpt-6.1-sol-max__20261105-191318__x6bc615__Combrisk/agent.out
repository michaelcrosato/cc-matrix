nActivity(d);}\n  poll(){\n    this.pads=Array.from(navigator.getGamepads?.()||[]).filter(Boolean);const now=performance.now();\n    for(const p of this.pads){const old=this.oldPads.get(p.index)||{b:[],nav:0};const b=p.buttons.map(v=>v.pressed||v.value>.5);const axes=p.axes.map(v=>Math.abs(v)>.18?v:0);if(b.some(Boolean)||axes.some(v=>Math.abs(v)>.25))this.activity('\"'pad');\n      if(\"'!b[8]&&b[9]&&!old.b[9])this.onPause();\n      if(this.menu){if(b[0]&&!old.b[0])this.onConfirm();if(b[1]&&!old.b[1])this.onBack();let x=b[14]?-1:b[15]?1:Math.abs(axes[0]||0)>.6?Math.sign(axes[0]):0;let y=b[12]?-1:b[13]?1:Math.abs(axes[1]||0)>.6?Math.sign(axes[1]):0;if((x||y)&&now>old.nav){this.onMenu(x,y);old.nav=now+210;}if(!x&&!y)old.nav=0;}\n      this.edges[p.index]={boost:(b[4]&&!old.b[4])||(b[0]&&!old.b[0]),fire:b[7]||b[5],axes,b};old.b=b;this.oldPads.set(p.index,old);\n    }\n  }\n  read(index=0,local=false){\n    const out={x:0,z:0,ax:0,az:0,aim:false,fire:false,boost:false,mouse:false};if(this.menu||this.blocked)return out;\n    const k=this.keys;\n    if(index===0){out.x=(k.has('\"'KeyD')?1:0)-(k.has('KeyA')?1:0);out.z=(k.has('KeyS')?1:0)-(k.has('KeyW')?1:0);out.fire=k.has('Space')||this.mouse.down;out.boost=this.justBoost;this.justBoost=false;out.mouse=this.mouse.active&&this.device==='keyboard';}\n    else if(local&&index===1){out.x=(k.has('ArrowRight')?1:0)-(k.has('ArrowLeft')?1:0);out.z=(k.has('ArrowDown')?1:0)-(k.has('ArrowUp')?1:0);out.ax=(k.has('KeyL')?1:0)-(k.has('KeyJ')?1:0);out.az=(k.has('KeyK')?1:0)-(k.has('KeyI')?1:0);out.aim=\"'!!(out.ax||out.az);out.fire=k.has('\"'Slash')||k.has('ControlRight');out.boost=k.has('Period');}\n    let pad;\n    if(local)pad=this.pads.length===1?(index===1?this.pads[0]:null):this.pads[index];else pad=this.pads[0];\n    if(pad){const e=this.edges[pad.index];if(e){out.x+=e.axes[0]||0;out.z+=e.axes[1]||0;if(Math.hypot(e.axes[2]||0,e.axes[3]||0)>.25){out.ax=e.axes[2];out.az=e.axes[3];out.aim=true;}out.fire=out.fire||e.fire;out.boost=ou