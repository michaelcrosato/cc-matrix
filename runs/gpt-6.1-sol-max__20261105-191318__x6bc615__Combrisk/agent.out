{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\nimport {Game,LEVELS,ZERO,RAPIER} from './game.js';\nimport {View,T} from './view.js';\nimport {Input} from './input.js';\nimport {Sound} from './audio.js';\nimport {Network} from './network.js';\nimport {UI} from './ui.js';\nconst BASE_SETTINGS={master:.75,music:.1,sfx:.65,glyphs:'playstation',guide:true,shake:true,best:0};\nlet saved={};try{saved=JSON.parse(localStorage.getItem('combrisk-v1')||'{}');}catch{}\nconst settings={...BASE_SETTINGS,...saved};const canvas=document.getElementById('scene');\nconst input=new Input(canvas),sound=new Sound(),game=new Game(),net=new Network(),ui=new UI(input,settings);let view=null,loaded=false,attract=false,hubStarted=false,menuStack=[],lastPhase='',resultKey='',suppressUntil=0,debugLines=null,realClock=0,frameCount=0;\nconst persist=()=>{try{localStorage.setItem('combrisk-v1',JSON.stringify(settings));}catch{}sound.volumes(settings);};\nfunction resume(){menuStack=[];game.paused=false;ui.clear();lastPhase='';}\nfunction show(name,push=true){if(push)menuStack.push(ui.name);game.paused=\"'!net.active;switch(name){case'\"'title':title();break;case'pause':ui.pause(game.snapshot(),net.active);break;case'versus':ui.versus();break;case'settings':ui.settingsMenu();break;case'how':ui.how();break;case'about':ui.about();break;case'dev':ui.dev(game);break;case'link':ui.link();break;}}\nfunction back(){if(ui.name==='title')return;if(ui.name==='pause'){resume();return;}const previous=menuStack.pop()||'title';if(previous==='game')resume();else show(previous,false);}\nfunction title(){if(net.hub)return;attract=false;net.close(true);game.cheats={invincible:false,aiPaused:false,colliders:false,slowmo:1};game.start('title',0);game.paused=false;ui.title();input.menu=true;menuStack=[];resultKey='';lastPhase='';input.lastInput=performance.now();document.getElementById('attract').hidden=true;document.getElementById('touch-boost').style.display='none';}\nfunction start(mode='solo'){attract=false;net.close(true);game.cheats={invincible:false,aiPaused:false,colliders:false,slowmo:1};game.start(mode,mode==='solo'?0:ui.selectedHeat);ui.clear();menuStack=[];resultKey='';lastPhase='playing';sound.voice('go');}\nfunction exitAttract(){if(\"'!attract)return;title();suppressUntil=performance.now()+300;}\nfunction pause(){if(!loaded||net.ended||performance.now()<suppressUntil)return;if(attract){exitAttract();return;}if(ui.name==='\"'game'){menuStack=[];show('pause');}else if(ui.name\"'!=='\"'title')back();}\ninput.onActivity=()=>{if(loaded){if(attract)exitAttract();sound.wake().then(()=>sound.volumes(settings)).catch(()=>{});}};\ninput.onPause=pause;input.onBack=back;input.onConfirm=()=>{if(performance.now()>suppressUntil&&input.menu)ui.confirm();};input.onMenu=(x,y)=>ui.navigate(x,y);input.onTouch=t=>ui.touchSticks(t);\nui.onSetting=(key,value)=>{settings[key]=value;persist();};ui.onTune=(key,value)=>{game.tuning[key]=value;if(key==='roundTime')game.timer=Math.min(game.timer,value);};\nui.onAction=async(action,button)=>{\n  if(\"'!loaded||net.ended||performance.now()<suppressUntil)return;sound.wake().then(()=>sound.volumes(settings)).catch(()=>{});sound.play('\"'click');input.lastInput=performance.now();\n  try{switch(action){\n    case'solo':start('solo');break;case'local':start('local');break;case'resume':resume();break;case'pause':pause();break;case'back':back();break;\n    case'versus':case'settings':case'how':case'about':case'dev':case'link':show(action);break;\n    case'arena':ui.selectedHeat=(ui.selectedHeat+1)%4;ui.versus();break;\n    case'quit':title();break;\n    case'continue':game.nextHeat();resume();break;\n    case'rematch':if(net.active&&net.kind==='host'){game.start('link',ui.selectedHeat);ui.clear();resultKey='';}else start(game.mode==='solo'?'solo':'local');break;\n    case'glyphs':settings.glyphs=settings.glyphs==='xbox'?'playstation':'xbox';persist();ui.settingsMenu();break;\n    case'guide':settings.guide=\"'!settings.guide;persist();ui.settingsMenu();break;\n    case'\"'shake':settings.shake=\"'!settings.shake;persist();ui.settingsMenu();break;\n    case'\"'resetSettings':Object.assign(settings,BASE_SETTINGS);persist();ui.settingsMenu();ui.toast('Settings restored. Music: 10%.');break;\n    case'fullscreen':if(\"'!document.fullscreenElement)await document.documentElement.requestFullscreen?.();else await document.exitFullscreen?.();break;\n    case'\"'god':game.cheats.invincible=\"'!game.cheats.invincible;ui.dev(game);break;case'\"'freezeAI':game.cheats.aiPaused=\"'!game.cheats.aiPaused;ui.dev(game);break;case'\"'colliders':game.cheats.colliders=\"'!game.cheats.colliders;ui.dev(game);break;case'\"'slowmo':game.cheats.slowmo=game.cheats.slowmo===1?.35:1;ui.dev(game);break;\n    case'repair':case'pickups':game.dev(action);ui.toast(action==='repair'?'Armour restored. Shield on.':'All three pickups are on the field.');break;\n    case'next':case'restart':game.dev(action);game.paused=true;ui.dev(game);break;\n    case'resetTune':game.resetTuning();ui.dev(game);ui.toast('Default balance restored.');break;\n    case'linkHost':net.close(true);ui.linkRole='host';ui.linkOut='';ui.linkMenu();break;case'linkJoin':net.close(true);ui.linkRole='guest';ui.linkOut='';ui.linkMenu();break;\n    case'createOffer':{button.disabled=true;ui.linkStatus('Gathering the invitation…');const code=await net.hostOffer();ui.linkOut=code;document.getElementById('link-out').value=code;ui.linkStatus('Invitation ready. Send it to your friend.');button.disabled=false;break;}\n    case'createAnswer':{const code=document.getElementById('link-in').value;if(\"'!code)throw Error('\"'Paste a host invitation first.');button.disabled=true;ui.linkStatus('Preparing your reply…');const reply=await net.joinOffer(code);ui.linkOut=reply;const out=document.getElementById('link-out');if(out)out.value=reply;ui.linkStatus('Reply ready. Send it back to the host, then wait here.');button.disabled=false;break;}\n    case'acceptAnswer':await net.acceptAnswer(document.getElementById('link-in').value);ui.linkStatus('Connecting the pilots…');break;\n    case'copyCode':{const code=document.getElementById('link-out').value;if(\"'!code)throw Error('\"'Generate a code first.');try{await navigator.clipboard.writeText(code);ui.linkStatus('Code copied.');}catch{document.getElementById('link-out').select();ui.linkStatus('Code selected. Use Ctrl+C to copy.');}break;}\n  }}catch(e){if(button)button.disabled=false;if(ui.name==='link')ui.linkStatus(e.message,true);else ui.toast(e.message||String(e));}\n};\nnet.onInput=(seat,data)=>{const t=game.tanks.find(t=>t.seat===seat&&t.human);if(t)game.input(t.id,data);};\nnet.onSnapshot=s=>{game.applyRemote(s,net.hub?net.info.me:1);if(ui.name==='waiting')ui.clear();};\nnet.onConnected=role=>{if(role==='host'){game.start('link',ui.selectedHeat);game.tanks[0].name='HOST';game.tanks[1].name='RIVAL';ui.clear();resultKey='';}else{ui.waiting('The host is setting the angles.');}menuStack=[];sound.play('pickup');};\nnet.onDisconnect=msg=>{if(\"'!net.hub&&loaded){game.paused=true;ui.waiting(msg);ui.toast(msg);}};\nnet.onStart=()=>{hubStarted=true;game.paused=false;ui.clear();game.countdown=Math.max(0,-window.AIHub.time()/1000);};\nnet.onTimeUp=()=>net.finish(game.snapshot());\nnet.onLeave=id=>{net.leftPlayer(id);const t=game.tanks.find(t=>t.seat===id);if(t){t.human=false;t.local=false;}if(net.kind==='\"'host')ui.toast('A pilot left. The field carries on.');};\nnet.onEnd=()=>{game.paused=true;game.phase='ended';input.blocked=true;input.clear();sound.mute(true);ui.screen.innerHTML='';ui.name='ended';input.menu=false;document.getElementById('round-intro').hidden=true;};\ngame.onEvent=e=>{\n  if(\"'!loaded&&e.type!=='\"'stage')return;if(e.type==='stage')return;\n  if(e.type==='dust'){view?.fx('dust',e.x,e.z,e.color,e.extra);return;}\n  if(['shot','bounce','hit','boom','crate','pickup','boost'].includes(e.type)){view?.fx(e.type,e.x,e.z,e.color,e.extra);sound.play(e.type==='crate'?'hit':e.type);}\n  if(['tick','go','win','lose'].includes(e.type))sound.play(e.type);\n  if(e.type==='boom'&&\"'!attract){const state=game.snapshot(),shooter=state.tanks.find(t=>t.id===e.extra.owner);ui.announce(`${e.extra.bank?'\"'BANK SHOT\"'!'\"':'KNOCKOUT\"'!'\"'} \"'${shooter?.name||'\"''} +\"'${e.extra.points||1}`);if(shooter?.local){const pad=input.pads[0];try{pad?.vibrationActuator?.playEffect('\"'dual-rumble',{duration:130,strongMagnitude:.35,weakMagnitude:.6})?.catch(()=>{});}catch{}}}\n  if(e.type==='pickup'&&e.extra.type){const state=game.snapshot();if(state.tanks.find(t=>t.id===e.extra.id)?.local)ui.announce(e.extra.type==='repair'?'PATCHED UP.':e.extra.type==='shield'?'SHIELD ON.':'RAPID FIRE\"'!'\"');}\n};\nfunction aimInput(data,t){if(data.mouse&&t&&view){const p=view.mouseWorld(input.mouse);data.ax=p.x-t.x;data.az=p.z-t.z;const len=Math.hypot(data.ax,data.az);if(len>.1){data.ax/=len;data.az/=len;data.aim=true;}}return data;}\nfunction gatherInputs(){if(net.hub&&net.info?.server)return ZERO();const state=game.snapshot();const me=net.hub?net.info?.me:net.kind==='guest'?1:0;const local=state.tanks.find(t=>t.seat===me)||state.tanks[0];const data=aimInput(input.read(0,game.mode==='local'),local);if(\"'!game.remote&&local?.human)game.input(local.id,data);if(game.mode==='\"'local')game.input(1,input.read(1,true));return data;}\nfunction fixedStep(dt){if(net.hub&&\"'!hubStarted)return;if(net.kind==='\"'guest'&&net.active)return;game.step(dt);}\nfunction debugPhysics(){if(\"'!view)return;if(!game.cheats.colliders||!game.world){if(debugLines)debugLines.visible=false;return;}const d=game.world.debugRender();if(!debugLines){debugLines=new T.LineSegments(new T.BufferGeometry(),new T.LineBasicMaterial({vertexColors:true,depthTest:false,transparent:true,opacity:.8}));debugLines.renderOrder=999;view.scene.add(debugLines);}debugLines.visible=true;debugLines.geometry.dispose();debugLines.geometry=new T.BufferGeometry();debugLines.geometry.setAttribute('\"'position',new T.BufferAttribute(d.vertices,3));debugLines.geometry.setAttribute('color',new T.BufferAttribute(d.colors,4));}\nlet previous=0,accumulator=0;\nfunction frame(ms){\n  if(\"'!loaded)return;const dt=Math.min(.1,previous?(ms-previous)/1000:1/60);previous=ms;realClock+=dt;frameCount++;\n  input.poll();\n  if(ui.name==='\"'title'&&performance.now()-input.lastInput>=10000){attract=true;game.start('attract',0);ui.clear();ui.name='attract';input.menu=true;document.getElementById('attract').hidden=false;}\n  const data=gatherInputs();accumulator+=dt;let steps=0;while(accumulator>=1/60&&steps++<8){fixedStep(1/60);accumulator-=1/60;}\n  const state=game.snapshot();\n  if(net.active)net.update(dt,data,()=>game.snapshot());\n  if(net.hub&&hubStarted&&net.kind==='host'&&game.finished)net.finish(state);\n  if(\"'!net.hub&&state.phase==='\"'results'&&\"'!attract){const key=state.serial+'\"':'+state.heat;if(resultKey\"'!==key){resultKey=key;if(state.mode==='\"'solo'&&state.finished){settings.best=Math.max(settings.best,state.heatWins);persist();}ui.results(state,net.active&&net.kind==='guest');menuStack=[];}}\n  view.sync(state,dt);const local=state.tanks.find(t=>t.local);const paths=ui.name==='game'&&settings.guide&&\"'!game.remote&&local?game.aimPath(game.tanks.find(t=>t.id===local.id)):[];const target=ui.name==='\"'game'&&input.device==='keyboard'&&input.mouse.active?view.mouseWorld(input.mouse):null;view.aimPath(paths,target,state.vehicle==='plane');\n  if(\"'!settings.shake)view.shake=0;view.update(dt,ui.name==='\"'title');debugPhysics();view.render();ui.update(state,dt,attract,game);sound.update(ui.name==='game'||attract);requestAnimationFrame(frame);\n}\nasync function init(){\n  const infoPromise=net.initHub();view=new View(canvas);game.onStage=(level,obstacles)=>{view.arena(level,obstacles);};await game.init();const info=await infoPromise;\n  if(net.hub&&info){game.start('hub',0,info.players);for(const t of game.tanks)t.local=t.se