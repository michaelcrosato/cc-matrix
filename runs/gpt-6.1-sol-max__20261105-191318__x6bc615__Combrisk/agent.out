{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > src/view.js <<'EOF'\nimport * as T from 'three/webgpu';\nconst C={ink:0x182b31,sand:0xe4c78d,cream:0xfff2cf,teal:0x2d7973,dark:0x173e42,orange:0xe9a147,yellow:0xffd34e,coral:0xef7059};\nconst rand=(s)=>()=>{s=(Math.imul(s,1664525)+1013904223)|0;return(s>>>0)/4294967296;};\nexport class View {\n  constructor(canvas){\n    this.canvas=canvas;this.scene=new T.Scene();this.scene.background=new T.Color(0x367b78);this.scene.fog=new T.Fog(0x367b78,70,130);\n    this.camera=new T.OrthographicCamera(-24,24,14,-14,.1,180);this.camera.position.set(0,38,27);this.camera.lookAt(0,0,0);\n    this.renderer=new T.WebGPURenderer({canvas,antialias:true,alpha:false,powerPreference:'high-performance'});this.renderer.setPixelRatio(Math.min(devicePixelRatio,2));this.renderer.shadowMap.enabled=true;this.renderer.shadowMap.type=T.PCFSoftShadowMap;this.renderer.outputColorSpace=T.SRGBColorSpace;this.renderer.toneMapping=T.NoToneMapping;\n    this.materials=new Map();const data=new Uint8Array([70,70,70,255,155,155,155,255,255,255,255,255]);this.gradient=new T.DataTexture(data,3,1);this.gradient.needsUpdate=true;this.gradient.minFilter=T.NearestFilter;this.gradient.magFilter=T.NearestFilter;\n    this.ink=new T.LineBasicMaterial({color:C.ink,transparent:true,opacity:.8});\n    this.scene.add(new T.HemisphereLight(0xfff0cf,0x477d77,2.7));const sun=new T.DirectionalLight(0xfff0cc,3.1);sun.position.set(-13,30,18);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-26;sun.shadow.camera.right=26;sun.shadow.camera.top=23;sun.shadow.camera.bottom=-23;sun.shadow.normalBias=.035;sun.shadow.bias=-.00015;this.scene.add(sun);\n    this.stage=new T.Group();this.scene.add(this.stage);this.arenaGroup=new T.Group();this.stage.add(this.arenaGroup);this.tanks=new Map();this.shells=new Map();this.pickups=new Map();this.effects=[];this.trails=[];this.mixers=[];this.time=0;this.shake=0;this.title=true;this.target=new T.Vector3();this.raycaster=new T.Raycaster();this.ground=new T.Plane(new T.Vector3(0,1,0),0);this.hit=new T.Vector3();\n    this.geometries={box:new T.BoxGeometry(1,1,1),sphere:new T.IcosahedronGeometry(1,1),cyl:new T.CylinderGeometry(1,1,1,12),ring:new T.TorusGeometry(1,.035,5,40)};\n    this.makeTable();this.makeAim();window.addEventListener('resize',()=>this.resize());this.resize();\n  }\n  async init(){await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'WebGPU':'WebGL 2';await this.renderer.compileAsync(this.scene,this.camera);}\n  mat(c,extra={}){const key=c+JSON.stringify(extra);if(\"'!this.materials.has(key))this.materials.set(key,new T.MeshToonMaterial({color:c,gradientMap:this.gradient,...extra}));return this.materials.get(key);}\n  mesh(g,c,parent,x=0,y=0,z=0,outline=false){const m=new T.Mesh(g,this.mat(c));m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;parent.add(m);if(outline){const e=new T.LineSegments(new T.EdgesGeometry(g,25),this.ink);m.add(e);}return m;}\n  box(parent,x,y,z,w,h,d,c,outline=true){const m=this.mesh(new T.BoxGeometry(w,h,d),c,parent,x,y,z,outline);return m;}\n  cyl(parent,x,y,z,r,h,c){return this.mesh(new T.CylinderGeometry(r,r,h,12),c,parent,x,y,z,true);}\n  label(text,w=4,h=1,color='\"'#173e42',bg=null){const canvas=document.createElement('canvas');canvas.width=512;canvas.height=Math.round(512*h/w);const ctx=canvas.getContext('2d');if(bg){ctx.fillStyle=bg;ctx.fillRect(0,0,canvas.width,canvas.height);}ctx.fillStyle=color;ctx.font=\"'`900 ${Math.round(canvas.height*.65)}px Arial`;ctx.textAlign='\"'center';ctx.textBaseline='middle';ctx.fillText(text,256,canvas.height*.52,490);const tex=new T.CanvasTexture(canvas);tex.colorSpace=T.SRGBColorSpace;const mesh=new T.Mesh(new T.PlaneGeometry(w,h),new T.MeshBasicMaterial({map:tex,transparent:\"'!bg,depthWrite:!!bg}));return mesh;}\n  makeTable(){\n    const base=this.stage;\n    this.box(base,0,-1.35,0,39.6,1.5,27.6,C.ink);this.box(base,0,-.5,0,39.2,.5,27.2,0xd58a49);this.box(base,0,-.18,0,38.7,.3,26.7,C.cream);\n    const canvas=document.createElement('\"'canvas');canvas.width=1024;canvas.height=768;const ctx=canvas.getContext('2d');ctx.fillStyle='#e8ce95';ctx.fillRect(0,0,1024,768);const r=rand(1977);\n    for(let i=0;i<9000;i++){ctx.fillStyle=i%2?'rgba(60,66,45,.045)':'rgba(255,252,210,.18)';ctx.fillRect(r()*1024,r()*768,r()*2+1,r()*2+1);}ctx.strokeStyle='rgba(100,98,61,.10)';ctx.lineWidth=1;for(let x=0;x<1024;x+=64){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,768);ctx.stroke();}for(let y=0;y<768;y+=64){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(1024,y);ctx.stroke();}const texture=new T.CanvasTexture(canvas);texture.colorSpace=T.SRGBColorSpace;\n    this.floor=new T.Mesh(new T.BoxGeometry(36,.18,24),new T.MeshToonMaterial({map:texture,color:0xffffff,gradientMap:this.gradient}));this.floor.position.y=-.03;this.floor.receiveShadow=true;base.add(this.floor);\n    const title=this.label('COMBRISK   /   FIELD OPERATIONS',12,.65,'#8c7956');title.rotation.x=-Math.PI/2;title.position.set(0,.071,10.85);base.add(title);\n    const under=this.label('77',2.4,1.6,'#d4b67b');under.rotation.x=-Math.PI/2;under.position.set(0,.075,0);base.add(under);\n    const plank=this.box(base,0,-.1,12.8,9,.42,.7,C.ink);const plate=this.label('THE WEEKEND WAR DEPT.',7,.48,'#f8e7b7');plate.position.set(0,-.05,13.18);base.add(plate);\n    for(const [x,z] of [[-18,-12],[18,-12],[-18,12],[18,12]]){this.cyl(base,x,.2,z,.16,.7,C.ink);this.cyl(base,x,.58,z,.24,.12,C.orange);}\n    this.backdrop=new T.Mesh(new T.PlaneGeometry(250,250),this.mat(0x367b78));this.backdrop.rotation.x=-Math.PI/2;this.backdrop.position.y=-3.5;this.backdrop.receiveShadow=true;this.scene.add(this.backdrop);\n    for(const side of [-1,1]){for(let i=0;i<7;i++){const z=-9+i*3;this.box(base,side*19.1,.16,z,.22,.2,1.45,i%2?C.ink:C.orange,false);}for(const z of [-11,11]){this.box(base,side*18.9,.3,z,.7,.65,.7,C.ink);const screw=this.cyl(base,side*18.9,.68,z,.15,.08,C.cream);}}\n    this.makeScenery();\n  }\n  makeScenery(){\n    const r=rand(3442),g=this.stage;\n    for(let i=0;i<24;i++){let x=(r()-.5)*34,z=(r()-.5)*22;if(Math.abs(x)<14&&Math.abs(z)<9)continue;const a=this.mesh(new T.DodecahedronGeometry(.12+r()*.26,0),0xa7a170,g,x,.14,z,true);a.scale.y=.5;a.rotation.y=r()*6;}\n    for(const [x,z] of [[-17,-10],[16,9],[17,-8],[-15,10]]){const c=new T.Group();c.position.set(x,0,z);g.add(c);this.cyl(c,0,.85,0,.17,1.7,C.teal);const arm=this.cyl(c,.38,.93,0,.12,.5,C.teal);arm.rotation.z=Math.PI/2;this.cyl(c,.63,1.15,0,.12,.45,C.teal);const arm2=this.cyl(c,-.3,.6,0,.1,.5,C.teal);arm2.rotation.z=Math.PI/2;this.cyl(c,-.52,.78,0,.1,.4,C.teal);this.box(c,0,.1,0,.8,.15,.65,0xc4ab78,false);}\n    for(const [x,z,c] of [[-19.9,-8,C.coral],[19.9,8,C.teal]]){this.cyl(g,x,2,z,.07,4.3,C.ink);const flag=this.box(g,x+.7,3.8,z,1.4,.75,.045,c);flag.rotation.z=-.06;this.cyl(g,x,.05,z,.55,.14,C.ink);}\n    const radio=new T.Group();radio.position.set(23,-2,8);radio.rotation.y=-.25;g.add(radio);this.box(radio,0,.5,0,3.2,1.7,2,C.ink);this.box(radio,0,1.4,.1,2.8,.12,1.6,C.teal);this.cyl(radio,-.7,1.55,0,.2,.18,C.cream);const ant=this.cyl(radio,.8,3,0,.035,3,C.ink);ant.rotation.z=-.2;for(let i=0;i<4;i++)this.box(radio,-.7,.5,1.015,1.4,.07,.03,0x467a78,false);this.cyl(radio,.9,.55,1,.23,.15,C.orange).rotation.x=Math.PI/2;\n    const cup=this.cyl(g,-24,-1,9,.85,2.5,C.cream);this.cyl(g,-24,.28,9,.68,.05,C.ink);const h=new T.Mesh(new T.TorusGeometry(.65,.15,8,18),this.mat(C.cream));h.position.set(-22.9,-.7,9);g.add(h);\n  }\n  disposeGroup(g){g.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.material&&\"'!Array.isArray(o.material)&&o.material.map&&!this.materials.has(o.material)){} });g.clear();}\n  arena(level,obstacles=[]){\n    this.disposeGroup(this.arenaGroup);this.blockMeshes=new Map();const g=this.arenaGroup;const air=level.vehicle==='\"'plane';\n    this.floor.material.color.set(air?0xd1e6cd:level.ghost?0xbfc4a0:0xffffff);\n    for(const o of obstacles){if(o.border){this.box(g,o.x,.33,o.z,o.w,.65,o.d,air?C.teal:0xa48c65);for(let v=-o.w/2+1;v<o.w/2;v+=2.3)if(o.w>3)this.box(g,o.x+v,.7,o.z,.7,.07,o.d*.9,0xd8b275,false);continue;}\n      const group=new T.Group();group.position.set(o.x,0,o.z);g.add(group);this.blockMeshes.set(o.id,group);\n      if(o.crate){this.box(group,0,.65,0,o.w,1.3,o.d,0xbf8451);this.box(group,0,.69,0,o.w+.05,.13,o.d+.05,0xe4b271);const a=this.box(group,0,.67,o.d/2+.014,o.w*.85,.12,.04,C.ink,false);a.rotation.z=.52;const b=a.clone();b.rotation.z=-.52;group.add(b);this.box(group,0,1.32,0,o.w+.1,.12,o.d+.1,0xe8c28b);}\n      else {const h=o.h||1.35;this.box(group,0,h*.5,0,o.w,h,o.d,level.ghost?0x648c80:0xb69663);this.box(group,0,h+.07,0,o.w+.14,.16,o.d+.14,level.ghost?0x9fbea1:0xf2dcab);const n=Math.floor(Math.max(o.w,o.d)/1.5);for(let i=0;i<n;i++){if(o.w>o.d)this.box(group,-o.w/2+(i+.5)*o.w/n,h*.36,o.d/2+.012,.025,h*.65,.025,0x756f56,false);else this.box(group,o.w/2+.012,h*.36,-o.d/2+(i+.5)*o.d/n,.025,h*.65,.025,0x756f56,false);}}\n    }\n    if(air){for(const [x,z,s] of [[-6,-3,1],[7,3,1.3],[0,7,.65]]){const cloud=new T.Group();cloud.position.set(x,2.6,z);g.add(cloud);for(let i=0;i<5;i++){const c=this.mesh(new T.IcosahedronGeometry((1.4+i%2*.5)*s,1),0xe8f1d7,cloud,(i-2)*1.1,.1+(i%2)*.4,0,false);c.scale.set(1,.3,1);}cloud.userData.cloud=true;}\n      for(const [x,z] of [[-12,-6],[13,5]]){this.cyl(g,x,2,z,.035,4,C.ink);const balloon=this.mesh(new T.SphereGeometry(.6,10,8),C.coral,g,x,4.3,z,true);balloon.scale.y=1.3;}}\n    this.level=level;\n  }\n  makeTank(t){\n    const root=new T.Group(),body=new T.Group();root.add(body);this.scene.add(root);const color=t.color;\n    const chassis=this.box(body,0,.66,0,1.35,.45,1.65,color);const nose=this.box(body,0,.96,-.12,1.18,.22,1.3,color);nose.rotation.x=.06;\n    for(const x of [-.78,.78]){this.box(body,x,.39,0,.4,.6,1.92,C.ink);for(let i=0;i<5;i++){const wh=this.cyl(body,x,.38,-.72+i*.36,.2,.44,0x566b64);wh.rotation.z=Math.PI/2;}for(let i=0;i<8;i++){this.box(body,x,.72,-.81+i*.23,.44,.075,.10,0x3e5352,false);}this.box(body,x,.82,-.1,.48,.12,1.9,color);}\n    const turret=new T.Group();turret.name='turret';turret.position.set(0,1.1,-.03);root.add(turret);this.cyl(turret,0,.02,0,.5,.32,color);const cap=this.cyl(turret,0,.23,.06,.23,.12,C.ink);this.cyl(turret,0,.3,.06,.18,.07,C.cream);const barrel=new T.Group();barrel.name='barrel';turret.add(barrel);const gun=this.cyl(barrel,0,.06,-.69,.14,1.2,color);gun.rotation.x=Math.PI/2;this.box(barrel,0,.06,-1.32,.31,.29,.2,C.ink);this.box(barrel,0,.06,-1.43,.14,.13,.025,C.cream,false);\n    this.box(body,-.4,1.1,.68,.25,.12,.15,C.yellow);this.box(body,.4,1.1,.68,.25,.12,.15,C.yellow);this.cyl(body,-.45,1.43,.49,.027,.6,C.ink);const flag=this.box(body,-.33,1.65,.5,.27,.19,.035,color,false);flag.rotation.z=-.1;\n    const stripe=this.box(body,0,.92,.63,.26,.02,.35,C.cream,false);\n    const badge=this.label(String(t.id+1),.5,.45,'#fff3ce');badge.rotation.x=-Math.PI/2;badge.position.set(0,.904,.58);body.add(badge);\n    const mixer=new T.AnimationMixer(root);const recoil=new T.AnimationClip('cannon-kick',.24,[new T.NumberKeyframeTrack('barrel.position[z]',[0,.035,.24],[0,.22,0])]);const kick=mixer.clipAction(recoil);kick.setLoop(T.LoopOnce);kick.clampWhenFinished=true;\n    const idle=new T.AnimationClip('engine-rumble',.7,[new T.NumberKeyframeTrack(chassis.uuid+'.position[y]',[0,.175,.35,.525,.7],[.66,.68,.66,.65,.66])]);const idleAct=mixer.clipAction(idle);idleAct.play();\n    const shadow=this.shadow(.95);root.add(shadow);const ring=this.ring(color,1.2);ring.rotation.x=Math.PI/2;ring.position.y=.09;root.add(ring);\n    const health=new T.Group();health.position.set(0,2.35,0);root.add(health);for(let i=0;i<3;i++){const dot=this.box(health,(i-1)*.27,0,0,.18,.13,.18,C.cream,false);dot.userData.hp=i;}\n    const entry={root,body,turret,mixer,kick,health,ring,shadow,plane:false,baseY:0};this.tanks.set(t.id,entry);return entry;\n  }\n  makePlane(t){\n    const root=new T.Group(),body=new T.Group();body.name='airframe';root.add(body);this.scene.add(root);const c=t.color;\n    const fus=this.mesh(new T.CylinderGeometry(.29,.46,2.5,8),c,body,0,.65,0,true);fus.rotation.x=Math.PI/2;this.box(body,0,.6,-.15,3.8,.12,.7,c);this.box(body,0,1.34,-.15,3.8,.12,.7,c);\n    for(const x of [-1.4,1.4]){this.box(body,x,.97,-.35,.055,.67,.05,C.ink,false);this.box(body,x,.97,.15,.055,.67,.05,C.ink,false);this.box(body,x,1.412,-.15,.38,.02,.66,C.cream,false);}\n    this.box(body,0,.73,1.18,1.55,.09,.49,c);this.box(body,0,1,1.03,.1,.75,.55,c);this.cyl(body,0,1.03,.26,.23,.15,C.ink);const head=this.mesh(new T.SphereGeometry(.17,8,8),C.cream,body,0,1.18,.33,true);\n    const prop=new T.Group();prop.name='prop';prop.position.set(0,.66,-1.4);body.add(prop);this.box(prop,0,0,0,.09,1.45,.09,C.ink);this.cyl(prop,0,0,-.08,.16,.21,C.cream).rotation.x=Math.PI/2;\n    const mixer=new T.AnimationMixer(root);mixer.clipAction(new T.AnimationClip('propeller',.09,[new T.NumberKeyframeTrack('prop.rotation[z]',[0,.09],[0,Math.PI*2])])).play();const roll=mixer.clipAction(new T.AnimationClip('barrel-roll',.55,[new T.NumberKeyframeTrack('airframe.rotation[z]',[0,.55],[0,Math.PI*2])]));roll.setLoop(T.LoopOnce);roll.clampWhenFinished=true;\n    const shadow=this.shadow(1.2);shadow.position.y=-2.85;root.add(shadow);const ring=this.ring(c,1.4);ring.rotation.x=Math.PI/2;ring.position.y=-2.88;root.add(ring);const health=new T.Group();health.position.y=2;root.add(health);for(let i=0;i<3;i++)this.box(health,(i-1)*.27,0,0,.18,.13,.18,C.cream,false);\n    const entry={root,body,turret:body,mixer,kick:roll,health,ring,shadow,plane:true,baseY:3};this.tanks.set(t.id,entry);return entry;\n  }\n  shadow(r){const m=new T.Mesh(new T.CircleGeometry(r,24),new T.MeshBasicMaterial({color:C.ink,transparent:true,opacity:.2,depthWrite:false}));m.rotation.x=-Math.PI/2;m.position.y=.09;return m;}\n  ring(color,r){return new T.Mesh(new T.TorusGeometry(r,.028,5,40),new T.MeshBasicMaterial({color,transparent:true,opacity:.6}));}\n  sync(state,dt){\n    for(const t of state.tanks){let e=this.tanks.get(t.id);if(\"'!e||e.plane!==(state.vehicle==='\"'plane')){if(e){this.scene.remove(e.root);e.mixer.stopAllAction();this.disposeGroup(e.root);}e=state.vehicle==='plane'?this.makePlane(t):this.makeTank(t);}e.root.visible=t.alive;e.root.position.set(t.x,e.baseY,t.z);e.body.rotation.y=t.angle;if(\"'!e.plane)e.turret.rotation.y=t.aim;else e.body.rotation.y=t.aim;\n      const hidden=state.ghost&&t.reveal<=0&&!t.local;e.root.visible=t.alive&&!hidden;\n      if(t.invuln>0&&Math.sin(this.time*25)>0.3)e.root.visible=false;\n      e.ring.material.opacity=t.shield?.95:.32;e.ring.scale.setScalar(t.shield?1.2+Math.sin(this.time*6)*.04:1);e.health.children.forEach((o,i)=>o.visible=i<t.hp);e.health.rotation.y=-e.root.rotation.y;e.mixer.update(dt);\n      if(t.dash>0&&!e.wasDash&&e.plane){e.kick.reset().play();}e.wasDash=t.dash>0;\n      if(t.fireSeq!==e.fireSeq){if(e.fireSeq!==undefined&&!e.plane)e.kick.reset().play();e.fireSeq=t.fireSeq;}\n    }\n    for(const [id,e]of this.tanks)if(!state.tanks.some(t=>t.id===id)){this.scene.remove(e.root);this.disposeGroup(e.root);this.tanks.delete(id);}\n    const active=new Set();for(const b of state.bullets){active.add(b.id);let e=this.shells.get(b.id);if(!e){e=new T.Group();const core=this.mesh(new T.SphereGeometry(.145,7,6),b.banks?C.yellow:C.cream,e,0,0,0,false);const tail=this.mesh(new T.ConeGeometry(.13,.8,5),b.color,e,0,0,.38,false);tail.rotation.x=-Math.PI/2;this.scene.add(e);this.shells.set(b.id,e);}e.position.set(b.x,state.vehicle==='\"'plane'?3.7:.9,b.z);e.rotation.y=Math.atan2(-b.vx,-b.vz);}\n    for(const[id,e]of this.shells)if(\"'!active.has(id)){this.scene.remove(e);this.disposeGroup(e);this.shells.delete(id);}\n    const pActive=new Set();for(const p of state.pickups){pActive.add(p.id);let e=this.pickups.get(p.id);if(!e){e=new T.Group();this.scene.add(e);this.pickups.set(p.id,e);const color=p.type==='\"'repair'?0x71c69a:p.type==='shield'?0x7fcce4:C.yellow;const shape=this.mesh(new T.OctahedronGeometry(.53),color,e,0,.8,0,true);const badge=this.label(p.type==='repair'?'+':p.type==='shield'?'S':'\"'!'\"',.6,.6,'#173e42','#fff0cb');badge.position.set(0,.8,.42);e.add(badge);const ring=this.ring(color,.75);ring.rotation.x=Math.PI/2;ring.position.y=.1;e.add(ring);}e.position.set(p.x,state.vehicle==='plane'?2.4:Math.sin(this.time*3)*.12,p.z);e.rotation.y=this.time*.7;}\n    for(const[id,e]of this.pickups)if(\"'!pActive.has(id)){this.scene.remove(e);this.disposeGroup(e);this.pickups.delete(id);}\n    for(const [id,m]of this.blockMeshes||[])m.visible=!state.destroyed.includes(id);\n  }\n  makeAim(){this.aim=new T.Group();this.scene.add(this.aim);this.aim.visible=false;this.aimDots=[];for(let i=0;i<28;i++){const m=new T.Mesh(new T.SphereGeometry(i%3===0?.07:.04,5,4),new T.MeshBasicMaterial({color:C.cream,transparent:true,opacity:.6}));this.aim.add(m);this.aimDots.push(m);}this.reticle=this.ring(C.cream,.38);this.reticle.rotation.x=-Math.PI/2;this.scene.add(this.reticle);this.reticle.visible=false;for(const [x,z]of [[.6,0],[-.6,0],[0,.6],[0,-.6]])this.box(this.reticle,x,z,0,.12,.04,.02,C.cream,false);}\n  aimPath(points,reticle=null,plane=false){this.aim.visible=points.length>0;const y=plane?3.65:.18;this.aimDots.forEach((m,i)=>{m.visible=!!points[i];if(points[i])m.position.set(points[i].x,y,points[i].z);});this.reticle.visible=!!reticle;if(reticle)this.reticle.position.set(reticle.x,y+.02,reticle.z);}\n  mouseWorld(mouse){this.raycaster.setFromCamera(new T.Vector2(mouse.x/innerWidth*2-1,1-mouse.y/innerHeight*2),this.camera);this.raycaster.ray.intersectPlane(this.ground,this.hit);return {x:this.hit.x,z:this.hit.z};}\n  fx(type,x,z,color=C.yellow,extra={}){\n    const y=extra.air?3.6:.8;\n    if(type==='\"'shot'){const ring=this.ring(C.cream,.3);ring.position.set(x,y,z);ring.rotation.x=Math.PI/2;this.scene.add(ring);this.effects.push({m:ring,life:.15,max:.15,kind:'ring'});return;}\n    if(type==='dust'){const m=this.mesh(new T.IcosahedronGeometry(.18,0),0xcebc90,this.scene,x,.22,z,false);this.effects.push({m,life:.5,max:.5,kind:'dust',vx:(Math.random()-.5)*.4,vz:(Math.random()-.5)*.4,vy:.6});return;}\n    if(type==='boom'||type==='hit'||type==='crate'||type==='bounce'||type==='pickup'||type==='boost'){\n      if(type==='boom')this.shake=Math.max(this.shake,.22);else if(type==='hit')this.shake=Math.max(this.shake,.08);\n      const count=type==='boom'?22:type==='crate'?12:type==='bounce'?5:8;\n      for(let i=0;i<count;i++){const a=Math.random()*6.28,s=type==='boom'?2+Math.random()*6:1+Math.random()*3;const m=this.mesh(new T.BoxGeometry(.15+Math.random()*.12,.15+Math.random()*.16,.15+Math.random()*.16),i%3===0?C.ink:i%2?color:C.cream,this.scene,x,y,z,false);m.rotation.set(Math.random()*3,Math.random()*3,Math.random()*3);this.effects.push({m,life:.35+Math.random()*.6,max:1,kind:'particle',vx:Math.cos(a)*s,vz:Math.sin(a)*s,vy:2+Math.random()*4});}\n      const r=this.ring(color,type==='boom'?.6:.25);r.position.set(x,y,z);r.rotation.x=Math.PI/2;this.scene.add(r);this.effects.push({m:r,life:.4,max:.4,kind:'ring'});\n      if(type==='boom'){const text=this.label(extra.bank?'BANK\"'!'\"':'POP\"'!'\"',3,1,'#173e42','#ffd34e');text.position.set(x,y+1,z);text.rotation.x=-.45;this.scene.add(text);this.effects.push({m:text,life:1,max:1,kind:'text'});}\n    }\n  }\n  update(dt,title=false){this.time+=dt;this.title=title;const desiredX=title?-8:0;this.target.x+=(desiredX-this.target.x)*Math.min(1,dt*3);const offset=this.shake;this.shake=Math.max(0,this.shake-dt*.7);this.camera.position.set(this.target.x+Math.sin(this.time*80)*offset,38,27+Math.cos(this.time*91)*offset);this.camera.lookAt(this.target.x,0,0);\n    for(let i=this.effects.length-1;i>=0;i--){const f=this.effects[i];f.life-=dt;if(f.life<=0){this.scene.remove(f.m);if(f.m.geometry)f.m.geometry.dispose();if(f.m.material?.map)f.m.material.map.dispose();this.effects.splice(i,1);continue;}if(f.kind==='ring'){f.m.scale.multiplyScalar(1+dt*5);f.m.material.opacity=f.life/f.max;}else if(f.kind==='text'){f.m.position.y+=dt*.9;f.m.scale.setScalar(.85+Math.sin((1-f.life)*3)*.25);}else{f.m.position.x+=(f.vx||0)*dt;f.m.position.z+=(f.vz||0)*dt;f.m.position.y+=(f.vy||0)*dt;f.vy-=dt*9;f.m.rotation.x+=dt*3;f.m.rotation.z+=dt*2;f.m.scale.setScalar(Math.min(1,f.life*3));}}\n  }\n  resize(){const a=innerWidth/innerHeight;let h=14.7;if(a<1.3)h=21/a;this.camera.left=-h*a;this.camera.right=h*a;this.camera.top=h;this.camera.bottom=-h;this.camera.updateProjectionMatrix();this.renderer.setSize(innerWidth,innerHeight);}\n  render(){this.renderer.render(this.scene,this.camera);}\n}\nexport {T,C};\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat > src/view.js <<'EOF'\nimport * as T from 'three/webgpu';\nconst C={ink:0x182b31,sand:0xe4c78d,cream:0xfff2cf,teal:0x2d7973,dark:0x173e42,orange:0xe9a147,yellow:0xffd34e,coral:0xef7059};\nconst rand=(s)=>()=>{s=(Math.imul(s,1664525)+1013904223)|0;return(s>>>0)/4294967296;};\nexport class View {\n  constructor(canvas){\n    this.canvas=canvas;this.scene=new T.Scene();this.scene.background=new T.Color(0x367b78);this.scene.fog=new T.Fog(0x367b78,70,130);\n    this.camera=new T.OrthographicCamera(-24,24,14,-14,.1,180);this.camera.position.set(0,38,27);this.camera.lookAt(0,0,0);\n    this.renderer=new T.WebGPURenderer({canvas,antialias:true,alpha:false,powerPreference:'high-performance'});this.renderer.setPixelRatio(Math.min(devicePixelRatio,2));this.renderer.shadowMap.enabled=true;this.renderer.shadowMap.type=T.PCFSoftShadowMap;this.renderer.outputColorSpace=T.SRGBColorSpace;this.renderer.toneMapping=T.NoToneMapping;\n    this.materials=new Map();const data=new Uint8Array([70,70,70,255,155,155,155,255,255,255,255,255]);this.gradient=new T.DataTexture(data,3,1);this.gradient.needsUpdate=true;this.gradient.minFilter=T.NearestFilter;this.gradient.magFilter=T.NearestFilter;\n    this.ink=new T.LineBasicMaterial({color:C.ink,transparent:true,opacity:.8});\n    this.scene.add(new T.HemisphereLight(0xfff0cf,0x477d77,2.7));const sun=new T.DirectionalLight(0xfff0cc,3.1);sun.position.set(-13,30,18);sun.castShadow=true;sun.shadow.mapSize.set(2048,2048);sun.shadow.camera.left=-26;sun.shadow.camera.right=26;sun.shadow.camera.top=23;sun.shadow.camera.bottom=-23;sun.shadow.normalBias=.035;sun.shadow.bias=-.00015;this.scene.add(sun);\n    this.stage=new T.Group();this.scene.add(this.stage);this.arenaGroup=new T.Group();this.stage.add(this.arenaGroup);this.tanks=new Map();this.shells=new Map();this.pickups=new Map();this.effects=[];this.trails=[];this.mixers=[];this.time=0;this.shake=0;this.title=true;this.target=new T.Vector3();this.raycaster=new T.Raycaster();this.ground=new T.Plane(new T.Vector3(0,1,0),0);this.hit=new T.Vector3();\n    this.geometries={box:new T.BoxGeometry(1,1,1),sphere:new T.IcosahedronGeometry(1,1),cyl:new T.CylinderGeometry(1,1,1,12),ring:new T.TorusGeometry(1,.035,5,40)};\n    this.makeTable();this.makeAim();window.addEventListener('resize',()=>this.resize());this.resize();\n  }\n  async init(){await this.renderer.init();this.backend=this.renderer.backend.isWebGPUBackend?'WebGPU':'WebGL 2';await this.renderer.compileAsync(this.scene,this.camera);}\n  mat(c,extra={}){const key=c+JSON.stringify(extra);if(\"'!this.materials.has(key))this.materials.set(key,new T.MeshToonMaterial({color:c,gradientMap:this.gradient,...extra}));return this.materials.get(key);}\n  mesh(g,c,parent,x=0,y=0,z=0,outline=false){const m=new T.Mesh(g,this.mat(c));m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;parent.add(m);if(outline){const e=new T.LineSegments(new T.EdgesGeometry(g,25),this.ink);m.add(e);}return m;}\n  box(parent,x,y,z,w,h,d,c,outline=true){const m=this.mesh(new T.BoxGeometry(w,h,d),c,parent,x,y,z,outline);return m;}\n  cyl(parent,x,y,z,r,h,c){return this.mesh(new T.CylinderGeometry(r,r,h,12),c,parent,x,y,z,true);}\n  label(text,w=4,h=1,color='\"'#173e42',bg=null){const canvas=document.createElement('canvas');canvas.width=512;canvas.height=Math.round(512*h/w);const ctx=canvas.getContext('2d');if(bg){ctx.fillStyle=bg;ctx.fillRect(0,0,canvas.width,canvas.height);}ctx.fillStyle=color;ctx.font=\"'`900 ${Math.round(canvas.height*.65)}px Arial`;ctx.textAlign='\"'center';ctx.textBaseline='middle';ctx.fillText(text,256,canvas.height*.52,490);const tex=new T.CanvasTexture(canvas);tex.colorSpace=T.SRGBColorSpace;const mesh=new T.Mesh(new T.PlaneGeometry(w,h),new T.MeshBasicMaterial({map:tex,transparent:\"'!bg,depthWrite:!!bg}));return mesh;}\n  makeTable(){\n    const base=this.stage;\n    this.box(base,0,-1.35,0,39.6,1.5,27.6,C.ink);this.box(base,0,-.5,0,39.2,.5,27.2,0xd58a49);this.box(base,0,-.18,0,38.7,.3,26.7,C.cream);\n    const canvas=document.createElement('\"'canvas');canvas.width=1024;canvas.height=768;const ctx=canvas.getContext('2d');ctx.fillStyle='#e8ce95';ctx.fillRect(0,0,1024,768);const r=rand(1977);\n    for(let i=0;i<9000;i++){ctx.fillStyle=i%2?'rgba(60,66,45,.045)':'rgba(255,252,210,.18)';ctx.fillRect(r()*1024,r()*768,r()*2+1,r()*2+1);}ctx.strokeStyle='rgba(100,98,61,.10)';ctx.lineWidth=1;for(let x=0;x<1024;x+=64){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,768);ctx.stroke();}for(let y=0;y<768;y+=64){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(1024,y);ctx.stroke();}const texture=new T.CanvasTexture(canvas);texture.colorSpace=T.SRGBColorSpace;\n    this.floor=new T.Mesh(new T.BoxGeometry(36,.18,24),new T.MeshToonMaterial({map:texture,color:0xffffff,gradientMap:this.gradient}));this.floor.position.y=-.03;this.floor.receiveShadow=true;base.add(this.floor);\n    const title=this.label('COMBRISK   /   FIELD OPERATIONS',12,.65,'#8c7956');title.rotation.x=-Math.PI/2;title.position.set(0,.071,10.85);base.add(title);\n    const under=this.label('77',2.4,1.6,'#d4b67b');under.rotation.x=-Math.PI/2;under.position.set(0,.075,0);base.add(under);\n    const plank=this.box(base,0,-.1,12.8,9,.42,.7,C.ink);const plate=this.label('THE WEEKEND WAR DEPT.',7,.48,'#f8e7b7');plate.position.set(0,-.05,13.18);base.add(plate);\n    for(const [x,z] of [[-18,-12],[18,-12],[-18,12],[18,12]]){this.cyl(base,x,.2,z,.16,.7,C.ink);this.cyl(base,x,.58,z,.24,.12,C.orange);}\n    this.backdrop=new T.Mesh(new T.PlaneGeometry(250,250),this.mat(0x367b78));this.backdrop.rotation.x=-Math.PI/2;this.backdrop.position.y=-3.5;this.backdrop.receiveShadow=true;this.scene.add(this.backdrop);\n    for(const side of [-1,1]){for(let i=0;i<7;i++){const z=-9+i*3;this.box(base,side*19.1,.16,z,.22,.2,1.45,i%2?C.ink:C.orange,false);}for(const z of [-11,11]){this.box(base,side*18.9,.3,z,.7,.65,.7,C.ink);const screw=this.cyl(base,side*18.9,.68,z,.15,.08,C.cream);}}\n    this.makeScenery();\n  }\n  makeScenery(){\n    const r=rand(3442),g=this.stage;\n    for(let i=0;i<24;i++){let x=(r()-.5)*34,z=(r()-.5)*22;if(Math.abs(x)<14&&Math.abs(z)<9)continue;const a=this.mesh(new T.DodecahedronGeometry(.12+r()*.26,0),0xa7a170,g,x,.14,z,true);a.scale.y=.5;a.rotation.y=r()*6;}\n    for(const [x,z] of [[-17,-10],[16,9],[17,-8],[-15,10]]){const c=new T.Group();c.position.set(x,0,z);g.add(c);this.cyl(c,0,.85,0,.17,1.7,C.teal);const arm=this.cyl(c,.38,.93,0,.12,.5,C.teal);arm.rotation.z=Math.PI/2;this.cyl(c,.63,1.15,0,.12,.45,C.teal);const arm2=this.cyl(c,-.3,.6,0,.1,.5,C.teal);arm2.rotation.z=Math.PI/2;this.cyl(c,-.52,.78,0,.1,.4,C.teal);this.box(c,0,.1,0,.8,.15,.65,0xc4ab78,false);}\n    for(const [x,z,c] of [[-19.9,-8,C.coral],[19.9,8,C.teal]]){this.cyl(g,x,2,z,.07,4.3,C.ink);const flag=this.box(g,x+.7,3.8,z,1.4,.75,.045,c);flag.rotation.z=-.06;this.cyl(g,x,.05,z,.55,.14,C.ink);}\n    const radio=new T.Group();radio.position.set(23,-2,8);radio.rotation.y=-.25;g.add(radio);this.box(radio,0,.5,0,3.2,1.7,2,C.ink);this.box(radio,0,1.4,.1,2.8,.12,1.6,C.teal);this.cyl(radio,-.7,1.55,0,.2,.18,C.cream);const ant=this.cyl(radio,.8,3,0,.035,3,C.ink);ant.rotation.z=-.2;for(let i=0;i<4;i++)this.box(radio,-.7,.5,1.015,1.4,.07,.03,0x467a78,false);this.cyl(radio,.9,.55,1,.23,.15,C.orange).rotation.x=Math.PI/2;\n    const cup=this.cyl(g,-24,-1,9,.85,2.5,C.cream);this.cyl(g,-24,.28,9,.68,.05,C.ink);const h=new T.Mesh(new T.TorusGeometry(.65,.15,8,18),this.mat(C.cream));h.position.set(-22.9,-.7,9);g.add(h);\n  }\n  disposeGroup(g){g.traverse(o=>{if(o.geometry)o.geometry.dispose();if(o.material&&\"'!Array.isArray(o.material)&&o.material.map&&!this.materials.has(o.material)){} });g.clear();}\n  arena(level,obstacles=[]){\n    this.disposeGroup(this.arenaGroup);this.blockMeshes=new Map();const g=this.arenaGroup;const air=level.vehicle==='\"'plane';\n    this.floor.material.color.set(air?0xd1e6cd:level.ghost?0xbfc4a0:0xffffff);\n    for(const o of obstacles){if(o.border){this.box(g,o.x,.33,o.z,o.w,.65,o.d,air?C.teal:0xa48c65);for(let v=-o.w/2+1;v<o.w/2;v+=2.3)if(o.w>3)this.box(g,o.x+v,.7,o.z,.7,.07,o.d*.9,0xd8b275,false);continue;}\n      const group=new T.Group();group.position.set(o.x,0,o.z);g.add(group);this.blockMeshes.set(o.id,group);\n      if(o.crate){this.box(group,0,.65,0,o.w,1.3,o.d,0xbf8451);this.box(group,0,.69,0,o.w+.05,.13,o.d+.05,0xe4b271);const a=this.box(group,0,.67,o.d/2+.014,o.w*.85,.12,.04,C.ink,false);a.rotation.z=.52;const b=a.clone();b.rotation.z=-.52;group.add(b);this.box(group,0,1.32,0,o.w+.1,.12,o.d+.1,0xe8c28b);}\n      else {const h=o.h||1.35;this.box(group,0,h*.5,0,o.w,h,o.d,level.ghost?0x648c80:0xb69663);this.box(group,0,h+.07,0,o.w+.14,.16,o.d+.14,level.ghost?0x9fbea1:0xf2dcab);const n=Math.floor(Math.max(o.w,o.d)/1.5);for(let i=0;i<n;i++){if(o.w>o.d)this.box(group,-o.w/2+(i+.5)*o.w/n,h*.36,o.d/2+.012,.025,h*.65,.025,0x756f56,false);else this.box(group,o.w/2+.012,h*.36,-o.d/2+(i+.5)*o.d/n,.025,h*.65,.025,0x756f56,false);}}\n    }\n    if(air){for(const [x,z,s] of [[-6,-3,1],[7,3,1.3],[0,7,.65]]){const cloud=new T.Group();cloud.position.set(x,2.6,z);g.add(cloud);for(let i=0;i<5;i++){const c=this.mesh(new T.IcosahedronGeometry((1.4+i%2*.5)*s,1),0xe8f1d7,cloud,(i-2)*1.1,.1+(i%2)*.4,0,false);c.scale.set(1,.3,1);}cloud.userData.cloud=true;}\n      for(const [x,z] of [[-12,-6],[13,5]]){this.cyl(g,x,2,z,.035,4,C.ink);const balloon=this.mesh(new T.SphereGeometry(.6,10,8),C.coral,g,x,4.3,z,true);balloon.scale.y=1.3;}}\n    this.level=level;\n  }\n  makeTank(t){\n    const root=new T.Group(),body=new T.Group();root.add(body);this.scene.add(root);const color=t.color;\n    const chassis=this.box(body,0,.66,0,1.35,.45,1.65,color);const nose=this.box(body,0,.96,-.12,1.18,.22,1.3,color);nose.rotation.x=.06;\n    for(const x of [-.78,.78]){this.box(body,x,.39,0,.4,.6,1.92,C.ink);for(let i=0;i<5;i++){const wh=this.cyl(body,x,.38,-.72+i*.36,.2,.44,0x566b64);wh.rotation.z=Math.PI/2;}for(let i=0;i<8;i++){this.box(body,x,.72,-.81+i*.23,.44,.075,.10,0x3e5352,false);}this.box(body,x,.82,-.1,.48,.12,1.9,color);}\n    const turret=new T.Group();turret.name='turret';turret.position.set(0,1.1,-.03);root.add(turret);this.cyl(turret,0,.02,0,.5,.32,color);const cap=this.cyl(turret,0,.23,.06,.23,.12,C.ink);this.cyl(turret,0,.3,.06,.18,.07,C.cream);const barrel=new T.Group();barrel.name='barrel';turret.add(barrel);const gun=this.cyl(barrel,0,.06,-.69,.14,1.2,color);gun.rotation.x=Math.PI/2;this.box(barrel,0,.06,-1.32,.31,.29,.2,C.ink);this.box(barrel,0,.06,-1.43,.14,.13,.025,C.cream,false);\n    this.box(body,-.4,1.1,.68,.25,.12,.15,C.yellow);this.box(body,.4,1.1,.68,.25,.12,.15,C.yellow);this.cyl(body,-.45,1.43,.49,.027,.6,C.ink);const flag=this.box(body,-.33,1.65,.5,.27,.19,.035,color,false);flag.rotation.z=-.1;\n    const stripe=this.box(body,0,.92,.63,.26,.02,.35,C.cream,false);\n    const badge=this.label(String(t.id+1),.5,.45,'#fff3ce');badge.rotation.x=-Math.PI/2;badge.position.set(0,.904,.58);body.add(badge);\n    const mixer=new T.AnimationMixer(root);const recoil=new T.AnimationClip('cannon-kick',.24,[new T.NumberKeyframeTrack('barrel.position[z]',[0,.035,.24],[0,.22,0])]);const kick=mixer.clipAction(recoil);kick.setLoop(T.LoopOnce);kick.clampWhenFinished=true;\n    const idle=new T.AnimationClip('engine-rumble',.7,[new T.NumberKeyframeTrack(chassis.uuid+'.position[y]',[0,.175,.35,.525,.7],[.66,.68,.66,.65,.66])]);const idleAct=mixer.clipAction(idle);idleAct.play();\n    const shadow=this.shadow(.95);root.add(shadow);const ring=this.ring(color,1.2);ring.rotation.x=Math.PI/2;ring.position.y=.09;root.add(ring);\n    const health=new T.Group();health.position.set(0,2.35,0);root.add(health);for(let i=0;i<3;i++){const dot=this.box(health,(i-1)*.27,0,0,.18,.13,.18,C.cream,false);dot.userData.hp=i;}\n    const entry={root,body,turret,mixer,kick,health,ring,shadow,plane:false,baseY:0};this.tanks.set(t.id,entry);return entry;\n  }\n  makePlane(t){\n    const root=new T.Group(),body=new T.Group();body.name='airframe';root.add(body);this.scene.add(root);const c=t.color;\n    const fus=this.mesh(new T.CylinderGeometry(.29,.46,2.5,8),c,body,0,.65,0,true);fus.rotation.x=Math.PI/2;this.box(body,0,.6,-.15,3.8,.12,.7,c);this.box(body,0,1.34,-.15,3.8,.12,.7,c);\n    for(const x of [-1.4,1.4]){this.box(body,x,.97,-.35,.055,.67,.05,C.ink,false);this.box(body,x,.97,.15,.055,.67,.05,C.ink,false);this.box(body,x,1.412,-.15,.38,.02,.66,C.cream,false);}\n    this.box(body,0,.73,1.18,1.55,.09,.49,c);this.box(body,0,1,1.03,.1,.75,.55,c);this.cyl(body,0,1.03,.26,.23,.15,C.ink);const head=this.mesh(new T.SphereGeometry(.17,8,8),C.cream,body,0,1.18,.33,true);\n    const prop=new T.Group();prop.name='prop';prop.position.set(0,.66,-1.4);body.add(prop);this.box(prop,0,0,0,.09,1.45,.09,C.ink);this.cyl(prop,0,0,-.08,.16,.21,C.cream).rotation.x=Math.PI/2;\n    const mixer=new T.AnimationMixer(root);mixer.clipAction(new T.AnimationClip('propeller',.09,[new T.NumberKeyframeTrack('prop.rotation[z]',[0,.09],[0,Math.PI*2])])).play();const roll=mixer.clipAction(new T.AnimationClip('barrel-roll',.55,[new T.NumberKeyframeTrack('airframe.rotation[z]',[0,.55],[0,Math.PI*2])]));roll.setLoop(T.LoopOnce);roll.clampWhenFinished=true;\n    const shadow=this.shadow(1.2);shadow.position.y=-2.85;root.add(shadow);const ring=this.ring(c,1.4);ring.rotation.x=Math.PI/2;ring.position.y=-2.88;root.add(ring);const health=new T.Group();health.position.y=2;root.add(health);for(let i=0;i<3;i++)this.box(health,(i-1)*.27,0,0,.18,.13,.18,C.cream,false);\n    const entry={root,body,turret:body,mixer,kick:roll,health,ring,shadow,plane:true,baseY:3};this.tanks.set(t.id,entry);return entry;\n  }\n  shadow(r){const m=new T.Mesh(new T.CircleGeometry(r,24),new T.MeshBasicMaterial({color:C.ink,transparent:true,opacity:.2,depthWrite:false}));m.rotation.x=-Math.PI/2;m.position.y=.09;return m;}\n  ring(color,r){return new T.Mesh(new T.TorusGeometry(r,.028,5,40),new T.MeshBasicMaterial({color,transparent:true,opacity:.6}));}\n  sync(state,dt){\n    for(const t of state.tanks){let e=this.tanks.get(t.id);if(\"'!e||e.plane!==(state.vehicle==='\"'plane')){if(e){this.scene.remove(e.root);e.mixer.stopAllAction();this.disposeGroup(e.root);}e=state.vehicle==='plane'?this.makePlane(t):this.makeTank(t);}e.root.visible=t.alive;e.root.position.set(t.x,e.baseY,t.z);e.body.rotation.y=t.angle;if(\"'!e.plane)e.turret.rotation.y=t.aim;else e.body.rotation.y=t.aim;\n      const hidden=state.ghost&&t.reveal<=0&&!t.local;e.root.visible=t.alive&&!hidden;\n      if(t.invuln>0&&Math.sin(this.time*25)>0.3)e.root.visible=false;\n      e.ring.material.opacity=t.shield?.95:.32;e.ring.scale.setScalar(t.shield?1.2+Math.sin(this.time*6)*.04:1);e.health.children.forEach((o,i)=>o.visible=i<t.hp);e.health.rotation.y=-e.root.rotation.y;e.mixer.update(dt);\n      if(t.dash>0&&!e.wasDash&&e.plane){e.kick.reset().play();}e.wasDash=t.dash>0;\n      if(t.fireSeq!==e.fireSeq){if(e.fireSeq!==undefined&&!e.plane)e.kick.reset().play();e.fireSeq=t.fireSeq;}\n    }\n    for(const [id,e]of this.tanks)if(!state.tanks.some(t=>t.id===id)){this.scene.remove(e.root);this.disposeGroup(e.root);this.tanks.delete(id);}\n    const active=new Set();for(const b of state.bullets){active.add(b.id);let e=this.shells.get(b.id);if(!e){e=new T.Group();const core=this.mesh(new T.SphereGeometry(.145,7,6),b.banks?C.yellow:C.cream,e,0,0,0,false);const tail=this.mesh(new T.ConeGeometry(.13,.8,5),b.color,e,0,0,.38,false);tail.rotation.x=-Math.PI/2;this.scene.add(e);this.shells.set(b.id,e);}e.position.set(b.x,state.vehicle==='\"'plane'?3.7:.9,b.z);e.rotation.y=Math.atan2(-b.vx,-b.vz);}\n    for(const[id,e]of this.shells)if(\"'!active.has(id)){this.scene.remove(e);this.disposeGroup(e);this.shells.delete(id);}\n    const pActive=new Set();for(const p of state.pickups){pActive.add(p.id);let e=this.pickups.get(p.id);if(!e){e=new T.Group();this.scene.add(e);this.pickups.set(p.id,e);const color=p.type==='\"'repair'?0x71c69a:p.type==='shield'?0x7fcce4:C.yellow;const shape=this.mesh(new T.OctahedronGeometry(.53),color,e,0,.8,0,true);const badge=this.label(p.type==='repair'?'+':p.type==='shield'?'S':'\"'!'\"',.6,.6,'#173e42','#fff0cb');badge.position.set(0,.8,.42);e.add(badge);const ring=this.ring(color,.75);ring.rotation.x=Math.PI/2;ring.position.y=.1;e.add(ring);}e.position.set(p.x,state.vehicle==='plane'?2.4:Math.sin(this.time*3)*.12,p.z);e.rotation.y=this.time*.7;}\n    for(const[id,e]of this.pickups)if(\"'!pActive.has(id)){this.scene.remove(e);this.disposeGroup(e);this.pickups.delete(id);}\n    for(const [id,m]of this.blockMeshes||[])m.visible=!state.destroyed.includes(id);\n  }\n  makeAim(){this.aim=new T.Group();this.scene.add(this.aim);this.aim.visible=false;this.aimDots=[];for(let i=0;i<28;i++){const m=new T.Mesh(new T.SphereGeometry(i%3===0?.07:.04,5,4),new T.MeshBasicMaterial({color:C.cream,transparent:true,opacity:.6}));this.aim.add(m);this.aimDots.push(m);}this.reticle=this.ring(C.cream,.38);this.reticle.rotation.x=-Math.PI/2;this.scene.add(this.reticle);this.reticle.visible=false;for(const [x,z]of [[.6,0],[-.6,0],[0,.6],[0,-.6]])this.box(this.reticle,x,z,0,.12,.04,.02,C.cream,false);}\n  aimPath(points,reticle=null,plane=false){this.aim.visible=points.length>0;const y=plane?3.65:.18;this.aimDots.forEach((m,i)=>{m.visible=!!points[i];if(points[i])m.position.set(points[i].x,y,points[i].z);});this.reticle.visible=!!reticle;if(reticle)this.reticle.position.set(reticle.x,y+.02,reticle.z);}\n  mouseWorld(mouse){this.raycaster.setFromCamera(new T.Vector2(mouse.x/innerWidth*2-1,1-mouse.y/innerHeight*2),this.camera);this.raycaster.ray.intersectPlane(this.ground,this.hit);return {x:this.hit.x,z:this.hit.z};}\n  fx(type,x,z,color=C.yellow,extra={}){\n    const y=extra.air?3.6:.8;\n    if(type==='\"'shot'){const ring=this.ring(C.cream,.3);ring.position.set(x,y,z);ring.rotation.x=Math.PI/2;this.scene.add(ring);this.effects.push({m:ring,life:.15,max:.15,kind:'ring'});return;}\n    if(type==='dust'){const m=this.mesh(new T.IcosahedronGeometry(.18,0),0xcebc90,this.scene,x,.22,z,false);this.effects.push({m,life:.5,max:.5,kind:'dust',vx:(Math.random()-.5)*.4,vz:(Math.random()-.5)*.4,vy:.6});return;}\n    if(type==='boom'||type==='hit'||type==='crate'||type==='bounce'||type==='pickup'||type==='boost'){\n      if(type==='boom')this.shake=Math.max(this.shake,.22);else if(type==='hit')this.shake=Math.max(this.shake,.08);\n      const count=type==='boom'?22:type==='crate'?12:type==='bounce'?5:8;\n      for(let i=0;i<count;i++){const a=Math.random()*6.28,s=type==='boom'?2+Math.random()*6:1+Math.random()*3;const m=this.mesh(new T.BoxGeometry(.15+Math.random()*.12,.15+Math.random()*.16,.15+Math.random()*.16),i%3===0?C.ink:i%2?color:C.cream,this.scene,x,y,z,false);m.rotation.set(Math.random()*3,Math.random()*3,Math.random()*3);this.effects.push({m,life:.35+Math.random()*.6,max:1,kind:'particle',vx:Math.cos(a)*s,vz:Math.sin(a)*s,vy:2+Math.random()*4});}\n      const r=this.ring(color,type==='boom'?.6:.25);r.position.set(x,y,z);r.rotation.x=Math.PI/2;this.scene.add(r);this.effects.push({m:r,life:.4,max:.4,kind:'ring'});\n      if(type==='boom'){const text=this.label(extra.bank?'BANK\"'!'\"':'POP\"'!'\"',3,1,'#173e42','#ffd34e');text.position.set(x,y+1,z);text.rotation.x=-.45;this.scene.add(text);this.effects.push({m:text,life:1,max:1,kind:'text'});}\n    }\n  }\n  update(dt,title=false){this.time+=dt;this.title=title;const desiredX=title?-8:0;this.target.x+=(desiredX-this.target.x)*Math.min(1,dt*3);const offset=this.shake;this.shake=Math.max(0,this.shake-dt*.7);this.camera.position.set(this.target.x+Math.sin(this.time*80)*offset,38,27+Math.cos(this.time*91)*offset);this.camera.lookAt(this.target.x,0,0);\n    for(let i=this.effects.length-1;i>=0;i--){const f=this.effects[i];f.life-=dt;if(f.life<=0){this.scene.remove(f.m);if(f.m.geometry)f.m.geometry.dispose();if(f.m.material?.map)f.m.material.map.dispose();this.effects.splice(i,1);continue;}if(f.kind==='ring'){f.m.scale.multiplyScalar(1+dt*5);f.m.material.opacity=f.life/f.max;}else if(f.kind==='text'){f.m.position.y+=dt*.9;f.m.scale.setScalar(.85+Math.sin((1-f.life)*3)*.25);}else{f.m.position.x+=(f.vx||0)*dt;f.m.position.z+=(f.vz||0)*dt;f.m.position.y+=(f.vy||0)*dt;f.vy-=dt*9;f.m.rotation.x+=dt*3;f.m.rotation.z+=dt*2;f.m.scale.setScalar(Math.min(1,f.life*3));}}\n  }\n  resize(){const a=innerWidth/innerHeight;let h=14.7;if(a<1.3)h=21/a;this.camera.left=-h*a;this.camera.right=h*a;this.camera.top=h;this.camera.bottom=-h;this.camera.updateProjectionMatrix();this.renderer.setSize(innerWidth,innerHeight);}\n  render(){this.renderer.render(this.scene,this.camera);}\n}\nexport {T,C};\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > src/game.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nexport const DEFAULTS=Object.freeze({speed:5.2,shellSpeed:22,reload:.58,aiSkill:.72,roundTime:75,target:5});\nexport const COLORS=['#f4c34d','#ef7059','#66bca6','#93b6e5'];\nexport const LEVELS=[\n  {name:'THE OPENING SALVO',short:'Sandlot',tag:'A little friendly fire.',rule:'First to 5. One bounce. No hard feelings.',tip:'Move, aim, fire. Every wall is a second chance.',vehicle:'tank',ghost:false,bounces:1,bankBonus:false},\n  {name:'BANK ON IT',short:'Ricochet yard',tag:'An angle on the competition.',rule:'Bank-shot knockouts score double.',tip:'Aim at a wall. Bounce around cover. Mind the return trip.',vehicle:'tank',ghost:false,bounces:3,bankBonus:true},\n  {name:'HIDE & SQUEAK',short:'Ghost garden',tag:'Now you see them. Now you shoot.',rule:'Ghosts reveal themselves when they fire.',tip:'Watch for dust and muzzle flashes. Your own tank stays visible.',vehicle:'tank',ghost:true,bounces:2,bankBonus:false},\n  {name:'PROP & CIRCUMSTANCE',short:'The flyover',tag:'Same grudge. Higher altitude.',rule:'Keep flying. The edges wrap around.',tip:'Steer your nose, fire ahead, and barrel-roll out of trouble.',vehicle:'plane',ghost:false,bounces:0,bankBonus:false}\n];\nconst clamp=(x,a,b)=>Math.max(a,Math.min(b,x)), angleDiff=(a,b)=>Math.atan2(Math.sin(a-b),Math.cos(a-b));\nconst ZERO=()=>({x:0,z:0,ax:0,az:0,aim:false,fire:false,boost:false});\nexport class Game {\n  constructor(){this.tuning={...DEFAULTS};this.cheats={invincible:false,aiPaused:false,colliders:false,slowmo:1};this.world=null;this.obstacles=[];this.tanks=[];this.bullets=[];this.pickups=[];this.destroyed=[];this.events=[];this.eventSeq=0;this.bulletId=0;this.pickupId=0;this.t=0;this.heat=0;this.mode='title';this.phase='title';this.paused=false;this.countdown=0;this.timer=75;this.total=[0,0,0,0];this.heatWins=0;this.results=[];this.onStage=()=>{};this.onEvent=()=>{};this.rng=Math.random;this.inputs=new Map();this.remote=false;this.remoteState=null;this.stats={shots:0,hits:0,banks:0,knockouts:0,boosts:0,pickups:0};this.serial=0;}\n  async init(){await RAPIER.init();}\n  resetTuning(){Object.assign(this.tuning,DEFAULTS);}\n  start(mode='solo',heat=0,players=null){this.remote=false;this.remoteState=null;this.mode=mode;this.heat=heat;this.total=[0,0,0,0];this.heatWins=0;this.results=[];this.players=players;this.finished=false;this.stats={shots:0,hits:0,banks:0,knockouts:0,boosts:0,pickups:0};this.serial++;this.buildHeat(heat);}\n  buildHeat(index){\n    this.heat=((index%4)+4)%4;this.level=LEVELS[this.heat];this.phase=this.mode==='title'?'title':'playing';this.paused=false;this.countdown=['attract','title'].includes(this.mode)?0:2.6;this.timer=this.tuning.roundTime;this.t=0;this.pickupTimer=7;this.bullets=[];this.pickups=[];this.destroyed=[];this.obstacles=[];this.events=[];this.inputs.clear();if(this.world)this.world.free();this.world=new RAPIER.World({x:0,y:0,z:0});this.world.timestep=1/60;this.colliderData=new Map();\n    const wall=(x,z,w,d,opt={})=>{const o={id:this.obstacles.length,x,z,w,d,...opt,h:opt.crate?1.3:1.45,hp:opt.crate?2:999};this.obstacles.push(o);if(this.level.vehicle\"'!=='\"'plane'){const co=this.world.createCollider(RAPIER.ColliderDesc.cuboid(w/2,o.h/2,d/2).setTranslation(x,o.h/2,z));o.collider=co;this.colliderData.set(co.handle,{type:opt.crate?'crate':'wall',o});}return o;};\n    wall(0,-12.25,36.9,.5,{border:true});wall(0,12.25,36.9,.5,{border:true});wall(-18.25,0,.5,24,{border:true});wall(18.25,0,.5,24,{border:true});\n    if(this.heat===0){wall(0,-3.7,6,1.1);wall(0,3.7,6,1.1);wall(-8,0,1.1,5);wall(8,0,1.1,5);wall(-3,-7.7,1.2,1.2,{crate:true});wall(3,7.7,1.2,1.2,{crate:true});wall(0,0,1.3,1.3,{crate:true});}\n    if(this.heat===1){wall(-7,-4,6,1);wall(7,4,6,1);wall(-4,-1.5,1,6);wall(4,1.5,1,6);wall(0,-8,5,1);wall(0,8,5,1);wall(-11,4,1,4);wall(11,-4,1,4);for(const[x,z]of[[-7,2],[7,-2],[0,0],[-1.4,0],[1.4,0]])wall(x,z,1.2,1.2,{crate:true});}\n    if(this.heat===2){wall(-6,-4,5,1.1);wall(6,4,5,1.1);wall(-6,4,5,1.1);wall(6,-4,5,1.1);wall(0,0,1.6,4);for(const[x,z]of[[-11,0],[11,0],[-1,-8],[1,8]])wall(x,z,1.2,1.2,{crate:true});}\n    const count=this.mode==='local'||this.mode==='link'?2:this.players?Math.max(2,this.players.length):this.heat===0?2:3;\n    this.tanks=[];const names=['YOU','MAJOR MAYBE','CAPT. CRANK','LT. LOOPY'];for(let i=0;i<count;i++){\n      const player=this.players?.[i];const human=this.mode==='local'||this.mode==='link'?i<2:this.mode==='hub'?\"'!!player:i===0&&!['\"'attract','title'].includes(this.mode);\n      const tank={id:i,seat:player?.id??i,name:player?.name??(this.mode==='local'?(i===0?'PLAYER 1':'PLAYER 2'):names[i]),color:player?.color||COLORS[i],human,local:i===0,alive:true,hp:3,score:0,angle:0,aim:0,x:0,z:0,vx:0,vz:0,shield:false,rapid:0,dash:0,boostCd:0,reload:0,respawn:0,reveal:1.5,invuln:1.7,fireSeq:0,aiTime:0,pathTime:0,path:[],aiAim:0,dust:0,kills:0,bankKills:0,shots:0,deaths:0};\n      const body=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0,.7,0).enabledTranslations(true,false,true).enabledRotations(false,false,false).setLinearDamping(8).setAdditionalMass(2));tank.body=body;const co=this.world.createCollider(RAPIER.ColliderDesc.ball(.67).setFriction(.1).setRestitution(.1),body);tank.collider=co;this.colliderData.set(co.handle,{type:'tank',tank});this.tanks.push(tank);this.spawn(tank,true);\n    }\n    this.world.step();this.onStage(this.level,this.obstacles);this.emit('stage',0,0,null,{heat:this.heat});\n  }\n  spawn(t,first=false){const spots=[[-13,-8],[13,8],[13,-8],[-13,8],[0,-9],[0,9]];let spot=spots[t.id%4];if(\"'!first){let best=-1;for(const p of spots){const d=Math.min(...this.tanks.filter(v=>v.id!==t.id&&v.alive).map(v=>Math.hypot(v.x-p[0],v.z-p[1])),99);if(d>best){best=d;spot=p;}}}t.x=spot[0];t.z=spot[1];t.body.setTranslation({x:t.x,y:.7,z:t.z},true);t.body.setLinvel({x:0,y:0,z:0},true);t.body.setEnabled(true);t.alive=true;t.hp=3;t.invuln=first?1.7:2;t.reveal=2;t.shield=false;t.rapid=0;t.aim=t.id%2===0?Math.PI*1.2:Math.PI*.2;t.angle=t.aim;t.reload=.45;}\n  emit(type,x=0,z=0,color=null,extra={}){const e={seq:++this.eventSeq,type,x,z,color,extra:{...extra,air:this.level?.vehicle==='\"'plane'}};this.events.push(e);if(this.events.length>14)this.events.shift();this.onEvent(e);}\n  input(id,data){this.inputs.set(id,data);}\n  canSee(a,b){const dx=b.x-a.x,dz=b.z-a.z,d=Math.hypot(dx,dz);if(d<.1)return true;const h=this.world.castRay(new RAPIER.Ray({x:a.x,y:.8,z:a.z},{x:dx/d,y:0,z:dz/d}),d,true,undefined,undefined,undefined,a.body,c=>this.colliderData.get(c.handle)?.type\"'!=='\"'tank');return \"'!h;}\n  pathTo(a,b){\n    const cols=17,rows=11,idx=(x,z)=>z*cols+x;let sx=clamp(Math.round((a.x+16)/2),0,16),sz=clamp(Math.round((a.z+10)/2),0,10),tx=clamp(Math.round((b.x+16)/2),0,16),tz=clamp(Math.round((b.z+10)/2),0,10);const open=(x,z)=>!this.obstacles.some(o=>!o.border&&!this.destroyed.includes(o.id)&&Math.abs(-16+x*2-o.x)<o.w/2+.8&&Math.abs(-10+z*2-o.z)<o.d/2+.8);const queue=[[sx,sz]],prev=new Map([[idx(sx,sz),null]]);let end=null;\n    for(let i=0;i<queue.length;i++){const[x,z]=queue[i];if(x===tx&&z===tz){end=[x,z];break;}for(const[dx,dz]of[[1,0],[-1,0],[0,1],[0,-1]]){let nx=x+dx,nz=z+dz,k=idx(nx,nz);if(nx<0||nx>=cols||nz<0||nz>=rows||prev.has(k)||!open(nx,nz))continue;prev.set(k,[x,z]);queue.push([nx,nz]);}}\n    if(!end)return [];let path=[];for(let n=end;n;n=prev.get(idx(n[0],n[1])))path.push({x:-16+n[0]*2,z:-10+n[1]*2});path.reverse();return path.slice(1);\n  }\n  ai(t,dt){\n    if(this.cheats.aiPaused)return ZERO();const targets=this.tanks.filter(v=>v.id!==t.id&&v.alive);if(!targets.length)return ZERO();let target=targets.reduce((a,b)=>Math.hypot(a.x-t.x,a.z-t.z)<Math.hypot(b.x-t.x,b.z-t.z)?a:b);const dx=target.x-t.x,dz=target.z-t.z,d=Math.hypot(dx,dz),air=this.level.vehicle==='\"'plane';let x=0,z=0,visible=air||this.canSee(t,target