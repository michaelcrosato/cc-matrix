{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > src/game.js <<'EOF'\nimport RAPIER from '@dimforge/rapier3d-compat';\nexport const DEFAULTS=Object.freeze({speed:5.2,shellSpeed:22,reload:.58,aiSkill:.72,roundTime:75,target:5});\nexport const COLORS=['#f4c34d','#ef7059','#66bca6','#93b6e5'];\nexport const LEVELS=[\n  {name:'THE OPENING SALVO',short:'Sandlot',tag:'A little friendly fire.',rule:'First to 5. One bounce. No hard feelings.',tip:'Move, aim, fire. Every wall is a second chance.',vehicle:'tank',ghost:false,bounces:1,bankBonus:false},\n  {name:'BANK ON IT',short:'Ricochet yard',tag:'An angle on the competition.',rule:'Bank-shot knockouts score double.',tip:'Aim at a wall. Bounce around cover. Mind the return trip.',vehicle:'tank',ghost:false,bounces:3,bankBonus:true},\n  {name:'HIDE & SQUEAK',short:'Ghost garden',tag:'Now you see them. Now you shoot.',rule:'Ghosts reveal themselves when they fire.',tip:'Watch for dust and muzzle flashes. Your own tank stays visible.',vehicle:'tank',ghost:true,bounces:2,bankBonus:false},\n  {name:'PROP & CIRCUMSTANCE',short:'The flyover',tag:'Same grudge. Higher altitude.',rule:'Keep flying. The edges wrap around.',tip:'Steer your nose, fire ahead, and barrel-roll out of trouble.',vehicle:'plane',ghost:false,bounces:0,bankBonus:false}\n];\nconst clamp=(x,a,b)=>Math.max(a,Math.min(b,x)), angleDiff=(a,b)=>Math.atan2(Math.sin(a-b),Math.cos(a-b));\nconst ZERO=()=>({x:0,z:0,ax:0,az:0,aim:false,fire:false,boost:false});\nexport class Game {\n  constructor(){this.tuning={...DEFAULTS};this.cheats={invincible:false,aiPaused:false,colliders:false,slowmo:1};this.world=null;this.obstacles=[];this.tanks=[];this.bullets=[];this.pickups=[];this.destroyed=[];this.events=[];this.eventSeq=0;this.bulletId=0;this.pickupId=0;this.t=0;this.heat=0;this.mode='title';this.phase='title';this.paused=false;this.countdown=0;this.timer=75;this.total=[0,0,0,0];this.heatWins=0;this.results=[];this.onStage=()=>{};this.onEvent=()=>{};this.rng=Math.random;this.inputs=new Map();this.remote=false;this.remoteState=null;this.stats={shots:0,hits:0,banks:0,knockouts:0,boosts:0,pickups:0};this.serial=0;}\n  async init(){await RAPIER.init();}\n  resetTuning(){Object.assign(this.tuning,DEFAULTS);}\n  start(mode='solo',heat=0,players=null){this.remote=false;this.remoteState=null;this.mode=mode;this.heat=heat;this.total=[0,0,0,0];this.heatWins=0;this.results=[];this.players=players;this.finished=false;this.stats={shots:0,hits:0,banks:0,knockouts:0,boosts:0,pickups:0};this.serial++;this.buildHeat(heat);}\n  buildHeat(index){\n    this.heat=((index%4)+4)%4;this.level=LEVELS[this.heat];this.phase=this.mode==='title'?'title':'playing';this.paused=false;this.countdown=['attract','title'].includes(this.mode)?0:2.6;this.timer=this.tuning.roundTime;this.t=0;this.pickupTimer=7;this.bullets=[];this.pickups=[];this.destroyed=[];this.obstacles=[];this.events=[];this.inputs.clear();if(this.world)this.world.free();this.world=new RAPIER.World({x:0,y:0,z:0});this.world.timestep=1/60;this.colliderData=new Map();\n    const wall=(x,z,w,d,opt={})=>{const o={id:this.obstacles.length,x,z,w,d,...opt,h:opt.crate?1.3:1.45,hp:opt.crate?2:999};this.obstacles.push(o);if(this.level.vehicle\"'!=='\"'plane'){const co=this.world.createCollider(RAPIER.ColliderDesc.cuboid(w/2,o.h/2,d/2).setTranslation(x,o.h/2,z));o.collider=co;this.colliderData.set(co.handle,{type:opt.crate?'crate':'wall',o});}return o;};\n    wall(0,-12.25,36.9,.5,{border:true});wall(0,12.25,36.9,.5,{border:true});wall(-18.25,0,.5,24,{border:true});wall(18.25,0,.5,24,{border:true});\n    if(this.heat===0){wall(0,-3.7,6,1.1);wall(0,3.7,6,1.1);wall(-8,0,1.1,5);wall(8,0,1.1,5);wall(-3,-7.7,1.2,1.2,{crate:true});wall(3,7.7,1.2,1.2,{crate:true});wall(0,0,1.3,1.3,{crate:true});}\n    if(this.heat===1){wall(-7,-4,6,1);wall(7,4,6,1);wall(-4,-1.5,1,6);wall(4,1.5,1,6);wall(0,-8,5,1);wall(0,8,5,1);wall(-11,4,1,4);wall(11,-4,1,4);for(const[x,z]of[[-7,2],[7,-2],[0,0],[-1.4,0],[1.4,0]])wall(x,z,1.2,1.2,{crate:true});}\n    if(this.heat===2){wall(-6,-4,5,1.1);wall(6,4,5,1.1);wall(-6,4,5,1.1);wall(6,-4,5,1.1);wall(0,0,1.6,4);for(const[x,z]of[[-11,0],[11,0],[-1,-8],[1,8]])wall(x,z,1.2,1.2,{crate:true});}\n    const count=this.mode==='local'||this.mode==='link'?2:this.players?Math.max(2,this.players.length):this.heat===0?2:3;\n    this.tanks=[];const names=['YOU','MAJOR MAYBE','CAPT. CRANK','LT. LOOPY'];for(let i=0;i<count;i++){\n      const player=this.players?.[i];const human=this.mode==='local'||this.mode==='link'?i<2:this.mode==='hub'?\"'!!player:i===0&&!['\"'attract','title'].includes(this.mode);\n      const tank={id:i,seat:player?.id??i,name:player?.name??(this.mode==='local'?(i===0?'PLAYER 1':'PLAYER 2'):names[i]),color:player?.color||COLORS[i],human,local:i===0,alive:true,hp:3,score:0,angle:0,aim:0,x:0,z:0,vx:0,vz:0,shield:false,rapid:0,dash:0,boostCd:0,reload:0,respawn:0,reveal:1.5,invuln:1.7,fireSeq:0,aiTime:0,pathTime:0,path:[],aiAim:0,dust:0,kills:0,bankKills:0,shots:0,deaths:0};\n      const body=this.world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(0,.7,0).enabledTranslations(true,false,true).enabledRotations(false,false,false).setLinearDamping(8).setAdditionalMass(2));tank.body=body;const co=this.world.createCollider(RAPIER.ColliderDesc.ball(.67).setFriction(.1).setRestitution(.1),body);tank.collider=co;this.colliderData.set(co.handle,{type:'tank',tank});this.tanks.push(tank);this.spawn(tank,true);\n    }\n    this.world.step();this.onStage(this.level,this.obstacles);this.emit('stage',0,0,null,{heat:this.heat});\n  }\n  spawn(t,first=false){const spots=[[-13,-8],[13,8],[13,-8],[-13,8],[0,-9],[0,9]];let spot=spots[t.id%4];if(\"'!first){let best=-1;for(const p of spots){const d=Math.min(...this.tanks.filter(v=>v.id!==t.id&&v.alive).map(v=>Math.hypot(v.x-p[0],v.z-p[1])),99);if(d>best){best=d;spot=p;}}}t.x=spot[0];t.z=spot[1];t.body.setTranslation({x:t.x,y:.7,z:t.z},true);t.body.setLinvel({x:0,y:0,z:0},true);t.body.setEnabled(true);t.alive=true;t.hp=3;t.invuln=first?1.7:2;t.reveal=2;t.shield=false;t.rapid=0;t.aim=t.id%2===0?Math.PI*1.2:Math.PI*.2;t.angle=t.aim;t.reload=.45;}\n  emit(type,x=0,z=0,color=null,extra={}){const e={seq:++this.eventSeq,type,x,z,color,extra:{...extra,air:this.level?.vehicle==='\"'plane'}};this.events.push(e);if(this.events.length>14)this.events.shift();this.onEvent(e);}\n  input(id,data){this.inputs.set(id,data);}\n  canSee(a,b){const dx=b.x-a.x,dz=b.z-a.z,d=Math.hypot(dx,dz);if(d<.1)return true;const h=this.world.castRay(new RAPIER.Ray({x:a.x,y:.8,z:a.z},{x:dx/d,y:0,z:dz/d}),d,true,undefined,undefined,undefined,a.body,c=>this.colliderData.get(c.handle)?.type\"'!=='\"'tank');return \"'!h;}\n  pathTo(a,b){\n    const cols=17,rows=11,idx=(x,z)=>z*cols+x;let sx=clamp(Math.round((a.x+16)/2),0,16),sz=clamp(Math.round((a.z+10)/2),0,10),tx=clamp(Math.round((b.x+16)/2),0,16),tz=clamp(Math.round((b.z+10)/2),0,10);const open=(x,z)=>!this.obstacles.some(o=>!o.border&&!this.destroyed.includes(o.id)&&Math.abs(-16+x*2-o.x)<o.w/2+.8&&Math.abs(-10+z*2-o.z)<o.d/2+.8);const queue=[[sx,sz]],prev=new Map([[idx(sx,sz),null]]);let end=null;\n    for(let i=0;i<queue.length;i++){const[x,z]=queue[i];if(x===tx&&z===tz){end=[x,z];break;}for(const[dx,dz]of[[1,0],[-1,0],[0,1],[0,-1]]){let nx=x+dx,nz=z+dz,k=idx(nx,nz);if(nx<0||nx>=cols||nz<0||nz>=rows||prev.has(k)||!open(nx,nz))continue;prev.set(k,[x,z]);queue.push([nx,nz]);}}\n    if(!end)return [];let path=[];for(let n=end;n;n=prev.get(idx(n[0],n[1])))path.push({x:-16+n[0]*2,z:-10+n[1]*2});path.reverse();return path.slice(1);\n  }\n  ai(t,dt){\n    if(this.cheats.aiPaused)return ZERO();const targets=this.tanks.filter(v=>v.id!==t.id&&v.alive);if(!targets.length)return ZERO();let target=targets.reduce((a,b)=>Math.hypot(a.x-t.x,a.z-t.z)<Math.hypot(b.x-t.x,b.z-t.z)?a:b);const dx=target.x-t.x,dz=target.z-t.z,d=Math.hypot(dx,dz),air=this.level.vehicle==='\"'plane';let x=0,z=0,visible=air||this.canSee(t,target);\n    if(air||visible){const dir=(t.id%2?1:-1),radius=air?6:7;x=dx/d*(d-radius)*.28+(-dz/d)*.65*dir;z=dz/d*(d-radius)*.28+dx/d*.65*dir;}else{t.pathTime-=dt;if(t.pathTime<=0||\"'!t.path.length){t.pathTime=.8+this.rng()*.4;t.path=this.pathTo(t,target);}if(t.path.length){const p=t.path[0],pd=Math.hypot(p.x-t.x,p.z-t.z);if(pd<.7)t.path.shift();else{x=(p.x-t.x)/pd;z=(p.z-t.z)/pd;}}else{x=dx/d;z=dz/d;}}\n    // Keep pilots inside the field long enough to show the edge wrap deliberately.\n    if(air){x+=-t.x*.015;z+=-t.z*.02;}else{\n      let near=null;for(const o of this.obstacles){if(this.destroyed.includes(o.id))continue;const px=clamp(t.x,o.x-o.w/2-.8,o.x+o.w/2+.8),pz=clamp(t.z,o.z-o.d/2-.8,o.z+o.d/2+.8);const ax=t.x-px,az=t.z-pz,ad=Math.hypot(ax,az);if(ad<.8&&ad>.001){x+=ax/ad*(.8-ad)*1.7;z+=az/ad*(.8-ad)*1.7;}}\n    }\n    const l=Math.hypot(x,z);if(l>1){x/=l;z/=l;}t.aiTime-=dt;\n    if(t.aiTime<=0){t.aiTime=.25+(1-this.tuning.aiSkill)*.6;t.aiAim=Math.atan2(-(dx+target.vx*d/this.tuning.shellSpeed*.65),-(dz+target.vz*d/this.tuning.shellSpeed*.65))+(this.rng()-.5)*(1.25-this.tuning.aiSkill)*.42;\n      if(!visible&&!air&&this.rng()<.45){const mirrors=[{x:36-target.x,z:target.z},{x:-36-target.x,z:target.z},{x:target.x,z:24-target.z},{x:target.x,z:-24-target.z}];const m=mirrors[(this.rng()*4)|0];t.aiAim=Math.atan2(-(m.x-t.x),-(m.z-t.z));}\n    }\n    const error=Math.abs(angleDiff(t.aiAim,t.aim));return{x,z,ax:-Math.sin(t.aiAim),az:-Math.cos(t.aiAim),aim:true,fire:error<.2&&t.reload<=0&&(visible||this.rng()<.35),boost:d<4&&t.boostCd<=0&&this.rng()<dt*.6};\n  }\n  step(dt){\n    if(this.remote||this.paused||this.phase==='\"'results'||this.phase==='ended')return;dt*=this.cheats.slowmo;dt=Math.min(dt,.05);this.t+=dt;const air=this.level.vehicle==='plane';\n    if(this.countdown>0){const before=Math.ceil(this.countdown);this.countdown=Math.max(0,this.countdown-dt);if(Math.ceil(this.countdown)<before)this.emit(this.countdown===0?'go':'tick');return;}\n    if(this.mode\"'!=='\"'title')this.timer-=dt;\n    for(const t of this.tanks){\n      t.reveal=Math.max(0,t.reveal-dt);t.invuln=Math.max(0,t.invuln-dt);t.reload=Math.max(0,t.reload-dt);t.boostCd=Math.max(0,t.boostCd-dt);t.rapid=Math.max(0,t.rapid-dt);t.dash=Math.max(0,t.dash-dt);\n      if(\"'!t.alive){t.respawn-=dt;if(t.respawn<=0)this.spawn(t);continue;}\n      const input=t.human?(this.inputs.get(t.id)||ZERO()):this.ai(t,dt);let mx=clamp(input.x||0,-1,1),mz=clamp(input.z||0,-1,1);let moveLen=Math.hypot(mx,mz);if(moveLen>1){mx/=moveLen;mz/=moveLen;moveLen=1;}\n      if(input.aim&&Math.hypot(input.ax,input.az)>.15){const a=Math.atan2(-input.ax,-input.az);t.aim+=angleDiff(a,t.aim)*Math.min(1,dt*(air?6:12));}else if(moveLen>.2){const a=Math.atan2(-mx,-mz);t.aim+=angleDiff(a,t.aim)*Math.min(1,dt*(air?5:8));}\n      if(input.assist||input.autoAim){const target=this.tanks.filter(v=>v.id!==t.id&&v.alive&&this.canSee(t,v)).sort((a,b)=>Math.hypot(a.x-t.x,a.z-t.z)-Math.hypot(b.x-t.x,b.z-t.z))[0];if(target){const a=Math.atan2(-(target.x-t.x),-(target.z-t.z));t.aim+=angleDiff(a,t.aim)*Math.min(1,dt*8);input.fire=true;}}\n      if(input.boost&&t.boostCd<=0){t.dash=air?.5:.3;t.boostCd=3.8;t.invuln=Math.max(t.invuln,air?.52:.16);this.emit('\"'boost',t.x,t.z,t.color);if(t.id===0)this.stats.boosts++;}\n      if(air&&moveLen<.2){mx=-Math.sin(t.aim)*.62;mz=-Math.cos(t.aim)*.62;moveLen=.62;}\n      let speed=this.tuning.speed*(air?1.35:1)*(t.dash>0?2.6:1);if(t.dash>0&&moveLen<.15){mx=-Math.sin(t.aim);mz=-Math.cos(t.aim);}\n      const old=t.body.linvel(),f=Math.min(1,dt*(air?5:15));t.vx=old.x+(mx*speed-old.x)*f;t.vz=old.z+(mz*speed-old.z)*f;t.body.setLinvel({x:t.vx,y:0,z:t.vz},true);\n      if(moveLen>.12)t.angle+=angleDiff(Math.atan2(-mx,-mz),t.angle)*Math.min(1,dt*8);\n      if(input.fire&&t.reload<=0)this.fire(t);\n      t.dust-=dt;if((moveLen>.25||air)&&t.dust<=0){t.dust=air?.16:.13;if(\"'!air)this.emit('\"'dust',t.x,t.z,t.color);}\n    }\n    this.world.timestep=dt;this.world.step();\n    for(const t of this.tanks){if(\"'!t.alive)continue;const p=t.body.translation();t.x=p.x;t.z=p.z;if(air&&(Math.abs(t.x)>18||Math.abs(t.z)>12)){t.x=t.x>18?-17.8:t.x< -18?17.8:t.x;t.z=t.z>12?-11.8:t.z< -12?11.8:t.z;t.body.setTranslation({x:t.x,y:.7,z:t.z},true);this.emit('\"'wrap',t.x,t.z,t.color);}if(\"'!air&&(Math.abs(t.x)>18||Math.abs(t.z)>12)){t.x=clamp(t.x,-17.2,17.2);t.z=clamp(t.z,-11.2,11.2);t.body.setTranslation({x:t.x,y:.7,z:t.z},true);}}\n    this.stepBullets(dt);\n    for(let i=this.pickups.length-1;i>=0;i--){const p=this.pickups[i];p.life-=dt;let got=false;for(const t of this.tanks)if(t.alive&&Math.hypot(t.x-p.x,t.z-p.z)<1.25){this.takePickup(t,p);got=true;break;}if(got||p.life<=0)this.pickups.splice(i,1);}\n    this.pickupTimer-=dt;if(this.pickupTimer<=0){this.pickupTimer=10;this.addPickup();}\n    if(['\"'attract','title'].includes(this.mode)){if(this.mode==='attract'&&this.t>20)this.buildHeat((this.heat+1)%4);return;}\n    if(this.timer<=0||this.tanks.some(t=>t.score>=this.tuning.target)){this.endHeat();}\n  }\n  fire(t){const dx=-Math.sin(t.aim),dz=-Math.cos(t.aim);const b={id:++this.bulletId,owner:t.id,x:t.x+dx*1.48,z:t.z+dz*1.48,vx:dx*this.tuning.shellSpeed,vz:dz*this.tuning.shellSpeed,color:t.color,life:4.4,age:0,banks:0,wraps:0};this.bullets.push(b);t.reload=this.tuning.reload*(t.rapid>0?.38:1)*(this.level.vehicle==='plane'?.7:1);t.reveal=1.35;t.fireSeq++;t.shots++;if(t.id===0)this.stats.shots++;this.emit('shot',b.x,b.z,t.color);}\n  stepBullets(dt){const air=this.level.vehicle==='plane';for(let i=this.bullets.length-1;i>=0;i--){const b=this.bullets[i];b.life-=dt;b.age+=dt;if(b.life<=0){this.bullets.splice(i,1);continue;}let remaining=dt,dead=false;for(let pass=0;pass<5&&remaining>1e-5;pass++){\n      const speed=Math.hypot(b.vx,b.vz),dx=b.vx/speed,dz=b.vz/speed,dist=speed*remaining;\n      const hit=this.world.castRayAndGetNormal(new RAPIER.Ray({x:b.x,y:.8,z:b.z},{x:dx,y:0,z:dz}),dist+.10,true,undefined,undefined,undefined,undefined,c=>{const data=this.colliderData.get(c.handle);if(\"'!data)return false;if(data.type==='\"'tank'){if(\"'!data.tank.alive||data.tank.invuln>0)return false;if(data.tank.id===b.owner&&b.banks===0)return false;}return true;});\n      if(hit){const travel=Math.max(0,hit.timeOfImpact-.015);b.x+=dx*travel;b.z+=dz*travel;remaining=Math.max(0,remaining-travel/speed);const data=this.colliderData.get(hit.collider.handle);\n        if(data?.type==='\"'tank'){this.damage(data.tank,b);dead=true;break;}\n        if(data?.type==='crate'){data.o.hp--;if(data.o.hp<=0){this.destroyed.push(data.o.id);this.colliderData.delete(hit.collider.handle);this.world.removeCollider(hit.collider,true);this.emit('crate',data.o.x,data.o.z,0xe4ad64);}else this.emit('hit',b.x,b.z,0xe4ad64);dead=true;break;}\n        if(b.banks>=this.level.bounces){this.emit('hit',b.x,b.z,b.color);dead=true;break;}const dot=dx*hit.normal.x+dz*hit.normal.z;b.vx=(dx-2*dot*hit.normal.x)*speed;b.vz=(dz-2*dot*hit.normal.z)*speed;b.x+=hit.normal.x*.11;b.z+=hit.normal.z*.11;b.banks++;if(b.owner===0)this.stats.banks++;this.emit('bounce',b.x,b.z,b.color);\n      }else{b.x+=b.vx*remaining;b.z+=b.vz*remaining;remaining=0;}\n    }\n      if(air&&(Math.abs(b.x)>18.2||Math.abs(b.z)>12.2)){if(b.wraps++>0)dead=true;else{b.x=b.x>18.2?-18:b.x< -18.2?18:b.x;b.z=b.z>12.2?-12:b.z< -12.2?12:b.z;}}if(dead)this.bullets.splice(i,1);\n    }}\n  damage(t,b){if(t.invuln>0||this.cheats.invincible&&t.human||['attract','title'].includes(this.mode))return false;if(t.shield){t.shield=false;t.invuln=.3;this.emit('pickup',t.x,t.z,0x80c4e1);return false;}t.hp--;t.reveal=1.5;t.invuln=.22;t.body.applyImpulse({x:b.vx*.09,y:0,z:b.vz*.09},true);if(b.owner===0)this.stats.hits++;this.emit('hit',t.x,t.z,t.color);\n    if(t.hp<=0){t.hp=0;t.alive=false;t.body.setEnabled(false);t.respawn=1.9;t.deaths++;const shooter=this.tanks[b.owner];const bank=b.banks>0,points=this.level.bankBonus&&bank?2:1;if(shooter&&shooter.id\"'!==t.id){shooter.score+=points;shooter.kills++;if(bank)shooter.bankKills++;if(shooter.id===0)this.stats.knockouts++;}else t.score=Math.max(0,t.score-1);this.emit('\"'boom',t.x,t.z,t.color,{bank,owner:b.owner,points});}return true;\n  }\n  addPickup(type=null,x=null,z=null){if(this.pickups.length>=3)return;const spots=[[0,7],[0,-7],[-12,0],[12,0],[0,0],[-7,7],[7,-7]];let pos=spots[(this.rng()*spots.length)|0];if(x\"'!==null)pos=[x,z];if(this.obstacles.some(o=>!this.destroyed.includes(o.id)&&Math.abs(pos[0]-o.x)<o.w/2+.7&&Math.abs(pos[1]-o.z)<o.d/2+.7))pos=[-13,3];this.pickups.push({id:++this.pickupId,type:type||['\"'repair','shield','rapid'][(this.rng()*3)|0],x:pos[0],z:pos[1],life:15});}\n  takePickup(t,p){if(p.type==='repair')t.hp=Math.min(3,t.hp+1);if(p.type==='shield')t.shield=true;if(p.type==='rapid')t.rapid=8;if(t.id===0)this.stats.pickups++;this.emit('pickup',t.x,t.z,t.color,{type:p.type,id:t.id});}\n  endHeat(){\n    if(this.phase==='results'||this.phase==='ended')return;this.phase='results';const scores=this.tanks.map(t=>t.score),best=Math.max(...scores),win=scores[0]===best&&best>0;this.total=this.total.map((v,i)=>v+(scores[i]||0));if(win)this.heatWins++;this.results.push({heat:this.heat,scores,win});this.emit(win?'win':'lose');if(this.mode==='hub'){this.finished=true;}else if(this.mode\"'!=='\"'solo'||this.heat===3)this.finished=true;\n  }\n  nextHeat(){if(this.mode==='solo'&&this.heat<3)this.buildHeat(this.heat+1);}\n  snapshot(){if(this.remote&&this.remoteState)return this.remoteState;return {serial:this.serial,mode:this.mode,phase:this.phase,heat:this.heat,vehicle:this.level?.vehicle||'tank',ghost:this.level?.ghost||false,bounces:this.level?.bounces||0,bankBonus:this.level?.bankBonus||false,timer:this.timer,countdown:this.countdown,target:this.tuning.target,total:[...this.total],heatWins:this.heatWins,finished:\"'!!this.finished,results:this.results,stats:{...this.stats},tanks:this.tanks.map(t=>({id:t.id,seat:t.seat,name:t.name,color:t.color,human:t.human,local:t.local,x:t.x,z:t.z,vx:t.vx,vz:t.vz,angle:t.angle,aim:t.aim,hp:t.hp,score:t.score,alive:t.alive,reveal:t.reveal,invuln:t.invuln,shield:t.shield,rapid:t.rapid,dash:t.dash,boostCd:t.boostCd,reload:t.reload,respawn:t.respawn,fireSeq:t.fireSeq,kills:t.kills,bankKills:t.bankKills,shots:t.shots,deaths:t.deaths})),bullets:this.bullets.map(b=>({...b})),pickups:this.pickups.map(p=>({...p})),destroyed:[...this.destroyed],events:this.events};}\n  applyRemote(s,localSeat=1){const changed=!this.remoteState||s.serial!==this.remoteState.serial||s.heat!==this.remoteState.heat;this.remote=true;this.remoteState=s;s.tanks.forEach(t=>t.local=t.seat===localSeat);if(changed){this.buildHeat(s.heat);this.remote=true;this.mode=s.mode;this.remoteState=s;this.lastRemoteEvent=0;}for(const e of s.events||[])if(e.seq>(this.lastRemoteEvent||0)){this.onEvent(e);this.lastRemoteEvent=e.seq;}this.phase=s.phase;this.heat=s.heat;this.finished=s.finished;}\n  aimPath(t,max=26){if(!t||!t.alive||!this.world||this.remote)return[];let x=t.x,z=t.z,dx=-Math.sin(t.aim),dz=-Math.cos(t.aim),banks=0;const points=[];for(let i=0;i<max;i++){const d=.65;const hit=this.world.castRayAndGetNormal(new RAPIER.Ray({x,y:.8,z},{x:dx,y:0,z:dz}),d,true,undefined,undefined,undefined,t.body,c=>this.colliderData.get(c.handle)?.type!=='\"'tank');if(hit){if(banks>=this.level.bounces)break;const dot=dx*hit.normal.x+dz*hit.normal.z;dx-=2*dot*hit.normal.x;dz-=2*dot*hit.normal.z;x+=hit.normal.x*.12;z+=hit.normal.z*.12;banks++;}else{x+=dx*d;z+=dz*d;}if(i>1)points.push({x,z});}return points;}\n  dev(action){if(action==='repair')for(const t of this.tanks)if(t.human){if(\"'!t.alive)this.spawn(t);t.hp=3;t.shield=true;}if(action==='\"'pickups'){this.pickups=[];this.addPickup('repair',-12,3);this.addPickup('shield',0,7);this.addPickup('rapid',12,-3);}if(action==='next'){this.finished=false;this.buildHeat((this.heat+1)%4);}if(action==='restart'){this.finished=false;this.buildHeat(this.heat);}if(action==='win'){const t=this.tanks[0];t.score=this.tuning.target;this.endHeat();}}\n}\nexport {RAPIER,ZERO};\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > src/network.js <<'EOF'\nconst pack=(o)=>btoa(unescape(encodeURIComponent(JSON.stringify(o))));\nconst unpack=(s)=>JSON.parse(decodeURIComponent(escape(atob(s.trim().replace(/\"'^COMBRISK:/,'\"'')))));\nexport class Network {\n  constructor(){this.kind='none';this.active=false;this.ended=false;this.hub=\"'!!window.AIHub?.active;this.info=null;this.channel=null;this.peer=null;this.tick=0;this.frame=0;this.lastFrame=-1;this.lastInput=new Map();this.sent=0;this.received=0;this.onInput=()=>{};this.onSnapshot=()=>{};this.onConnected=()=>{};this.onDisconnect=()=>{};this.onStart=()=>{};this.onEnd=()=>{};this.onTimeUp=()=>{};this.onLeave=()=>{};this.error='\"'';}\n  async initHub(){if(\"'!this.hub)return null;const h=window.AIHub;h.on('\"'start',()=>{this.active=true;this.onStart();});h.on('message',(data,from)=>this.receive(data,from));h.on('time-up',()=>this.onTimeUp());h.on('leave',e=>this.onLeave(e.id));h.on('end',e=>{this.ended=true;this.active=false;this.onEnd(e);});this.info=await h.connect({mode:'shared-world',seats:[1,4]});if(\"'!this.info){this.hub=false;return null;}this.kind=this.info.isHost?'\"'host':'guest';this.players=this.info.players;return this.info;}\n  ready(){if(this.hub)window.AIHub.ready();}\n  receive(data,from=1){if(this.ended||\"'!data||typeof data!=='\"'object')return;this.received++;if(data.t==='i'&&this.kind==='host'){\n      const i=data.i;if(\"'!i||typeof i!=='\"'object')return;const clean={};for(const key of ['x','z','ax','az'])clean[key]=Number.isFinite(i[key])?Math.max(-1,Math.min(1,i[key])):0;for(const key of ['aim','fire','boost','assist'])clean[key]=\"'!!i[key];this.lastInput.set(from,{data:clean,time:performance.now()});this.onInput(from,clean);\n    }else if(data.t==='\"'s'&&this.kind==='guest'&&data.f>this.lastFrame){if(this.hub&&from\"'!==this.info.host)return;this.lastFrame=data.f;this.onSnapshot(data.s);}}\n  send(data){if(this.ended)return false;if(this.hub){const ok=window.AIHub.send(data,{to:this.kind==='\"'guest'?this.info.host:undefined,reliable:false});if(ok)this.sent++;return ok;}if(this.channel?.readyState==='open'){this.channel.send(JSON.stringify(data));this.sent++;return true;}return false;}\n  update(dt,input,snapshot){if(\"'!this.active||this.ended)return;this.tick+=dt;if(this.tick<1/15)return;this.tick=0;if(this.kind==='\"'host'){this.send({t:'s',f:++this.frame,s:snapshot()});for(const[id,v]of this.lastInput)if(performance.now()-v.time>700){this.onInput(id,{x:0,z:0,ax:0,az:0,fire:false,boost:false,aim:false});this.lastInput.delete(id);}}else this.send({t:'i',i:input});}\n  finish(state){if(\"'!this.hub||this.kind!=='\"'host'||this.ended||this.finished)return;this.finished=true;const players=this.players.filter(p=>\"'!this.left?.has(p.id));const score=(id)=>state.tanks.find(t=>t.seat===id)?.score||0;players.sort((a,b)=>score(b.id)-score(a.id));const standings=[];for(const p of players){const prev=standings[standings.length-1];if(prev&&score(prev[0])===score(p.id))prev.push(p.id);else standings.push([p.id]);}const scores={},stats={};for(const p of players){const t=state.tanks.find(t=>t.seat===p.id);scores[p.id]=score(p.id);stats[p.id]={'\"'Knockouts':t?.kills||0,'Bank shots':t?.bankKills||0,'Shots fired':t?.shots||0};}window.AIHub.finish({standings,scores,stats});}\n  leftPlayer(id){if(\"'!this.left)this.left=new Set();this.left.add(id);}\n  createPeer(role){\n    this.close(true);this.ended=false;this.finished=false;this.kind=role;this.lastFrame=-1;this.frame=0;this.peer=new RTCPeerConnection({iceServers:[{urls:'\"'stun:stun.l.google.com:19302'}]});\n    this.peer.ondatachannel=e=>this.bindChannel(e.channel);\n    this.peer.onconnectionstatechange=()=>{if(['failed','closed'].includes(this.peer?.connectionState)&&this.active){this.active=false;this.onDisconnect('The other pilot has left the field.');}};\n    return this.peer;\n  }\n  bindChannel(ch){this.channel=ch;ch.onopen=()=>{this.active=true;this.onConnected(this.kind);};ch.onmessage=e=>{try{this.receive(JSON.parse(e.data),this.kind==='host'?1:0);}catch{}};ch.onclose=()=>{if(this.active){this.active=false;this.onDisconnect('The link has closed.');}};}\n  async gather(){if(this.peer.iceGatheringState==='complete')return;const peer=this.peer;await new Promise(resolve=>{const done=()=>{if(peer.iceGatheringState==='complete'){clearTimeout(timer);peer.removeEventListener('icegatheringstatechange',done);resolve();}};const timer=setTimeout(()=>{peer.removeEventListener('icegatheringstatechange',done);resolve();},6500);peer.addEventListener('icegatheringstatechange',done);});}\n  async hostOffer(){if(\"'!window.RTCPeerConnection)throw Error('\"'This browser does not support direct links. Try a current browser.');const p=this.createPeer('host');this.bindChannel(p.createDataChannel('combrisk',{ordered:false,maxRetransmits:0}));await p.setLocalDescription(await p.createOffer());await this.gather();return 'COMBRISK:'+pack({v:1,type:'offer',sdp:p.localDescription.sdp});}\n  async joinOffer(code){let offer;try{offer=unpack(code);}catch{throw Error('That invitation is not a Combrisk code. Paste the complete code.');}if(offer.v\"'!==1||offer.type!=='\"'offer')throw Error('Paste the host’s invitation here.');const p=this.createPeer('guest');await p.setRemoteDescription({type:'offer',sdp:offer.sdp});await p.setLocalDescription(await p.createAnswer());await this.gather();return 'COMBRISK:'+pack({v:1,type:'answer',sdp:p.localDescription.sdp});}\n  async acceptAnswer(code){let a;try{a=unpack(code);}catch{throw Error('That reply is not a Combrisk code. Paste the complete code.');}if(a.type\"'!=='\"'answer'||\"'!this.peer)throw Error('\"'Create an invitation first, then paste your friend’s reply.');await this.peer.setRemoteDescription({type:'answer',sdp:a.sdp});}\n  close(silent=false){this.active=false;if(this.channel){this.channel.onclose=null;this.channel.close();}if(this.peer){this.peer.onconnectionstatechange=null;this.peer.close();}this.peer=null;this.channel=null;this.kind='none';this.lastInput.clear();if(\"'!silent)this.onDisconnect('\"'Link closed.');}\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > src/network.js <<'EOF'\nconst pack=(o)=>btoa(unescape(encodeURIComponent(JSON.stringify(o))));\nconst unpack=(s)=>JSON.parse(decodeURIComponent(escape(atob(s.trim().replace(/\"'^COMBRISK:/,'\"'')))));\nexport class Network {\n  constructor(){this.kind='none';this.active=false;this.ended=false;this.hub=\"'!!window.AIHub?.active;this.info=null;this.channel=null;this.peer=null;this.tick=0;this.frame=0;this.lastFrame=-1;this.lastInput=new Map();this.sent=0;this.received=0;this.onInput=()=>{};this.onSnapshot=()=>{};this.onConnected=()=>{};this.onDisconnect=()=>{};this.onStart=()=>{};this.onEnd=()=>{};this.onTimeUp=()=>{};this.onLeave=()=>{};this.error='\"'';}\n  async initHub(){if(\"'!this.hub)return null;const h=window.AIHub;h.on('\"'start',()=>{this.active=true;this.onStart();});h.on('message',(data,from)=>this.receive(data,from));h.on('time-up',()=>this.onTimeUp());h.on('leave',e=>this.onLeave(e.id));h.on('end',e=>{this.ended=true;this.active=false;this.onEnd(e);});this.info=await h.connect({mode:'shared-world',seats:[1,4]});if(\"'!this.info){this.hub=false;return null;}this.kind=this.info.isHost?'\"'host':'guest';this.players=this.info.players;return this.info;}\n  ready(){if(this.hub)window.AIHub.ready();}\n  receive(data,from=1){if(this.ended||\"'!data||typeof data!=='\"'object')return;this.received++;if(data.t==='i'&&this.kind==='host'){\n      const i=data.i;if(\"'!i||typeof i!=='\"'object')return;const clean={};for(const key of ['x','z','ax','az'])clean[key]=Number.isFinite(i[key])?Math.max(-1,Math.min(1,i[key])):0;for(const key of ['aim','fire','boost','assist'])clean[key]=\"'!!i[key];this.lastInput.set(from,{data:clean,time:performance.now()});this.onInput(from,clean);\n    }else if(data.t==='\"'s'&&this.kind==='guest'&&data.f>this.lastFrame){if(this.hub&&from\"'!==this.info.host)return;this.lastFrame=data.f;this.onSnapshot(data.s);}}\n  send(data){if(this.ended)return false;if(this.hub){const ok=window.AIHub.send(data,{to:this.kind==='\"'guest'?this.info.host:undefined,reliable:false});if(ok)this.sent++;return ok;}if(this.channel?.readyState==='open'){this.channel.send(JSON.stringify(data));this.sent++;return true;}return false;}\n  update(dt,input,snapshot){if(\"'!this.active||this.ended)return;this.tick+=dt;if(this.tick<1/15)return;this.tick=0;if(this.kind==='\"'host'){this.send({t:'s',f:++this.frame,s:snapshot()});for(const[id,v]of this.lastInput)if(performance.now()-v.time>700){this.onInput(id,{x:0,z:0,ax:0,az:0,fire:false,boost:false,aim:false});this.lastInput.delete(id);}}else this.send({t:'i',i:input});}\n  finish(state){if(\"'!this.hub||this.kind!=='\"'host'||this.ended||this.finished)return;this.finished=true;const players=this.players.filter(p=>\"'!this.left?.has(p.id));const score=(id)=>state.tanks.find(t=>t.seat===id)?.score||0;players.sort((a,b)=>score(b.id)-score(a.id));const standings=[];for(const p of players){const prev=standings[standings.length-1];if(prev&&score(prev[0])===score(p.id))prev.push(p.id);else standings.push([p.id]);}const scores={},stats={};for(const p of players){const t=state.tanks.find(t=>t.seat===p.id);scores[p.id]=score(p.id);stats[p.id]={'\"'Knockouts':t?.kills||0,'Bank shots':t?.bankKills||0,'Shots fired':t?.shots||0};}window.AIHub.finish({standings,scores,stats});}\n  leftPlayer(id){if(\"'!this.left)this.left=new Set();this.left.add(id);}\n  createPeer(role){\n    this.close(true);this.ended=false;this.finished=false;this.kind=role;this.lastFrame=-1;this.frame=0;this.peer=new RTCPeerConnection({iceServers:[{urls:'\"'stun:stun.l.google.com:19302'}]});\n    this.peer.ondatachannel=e=>this.bindChannel(e.channel);\n    this.peer.onconnectionstatechange=()=>{if(['failed','closed'].includes(this.peer?.connectionState)&&this.active){this.active=false;this.onDisconnect('The other pilot has left the field.');}};\n    return this.peer;\n  }\n  bindChannel(ch){this.channel=ch;ch.onopen=()=>{this.active=true;this.onConnected(this.kind);};ch.onmessage=e=>{try{this.receive(JSON.parse(e.data),this.kind==='host'?1:0);}catch{}};ch.onclose=()=>{if(this.active){this.active=false;this.onDisconnect('The link has closed.');}};}\n  async gather(){if(this.peer.iceGatheringState==='complete')return;const peer=this.peer;await new Promise(resolve=>{const done=()=>{if(peer.iceGatheringState==='complete'){clearTimeout(timer);peer.removeEventListener('icegatheringstatechange',done);resolve();}};const timer=setTimeout(()=>{peer.removeEventListener('icegatheringstatechange',done);resolve();},6500);peer.addEventListener('icegatheringstatechange',done);});}\n  async hostOffer(){if(\"'!window.RTCPeerConnection)throw Error('\"'This browser does not support direct links. Try a current browser.');const p=this.createPeer('host');this.bindChannel(p.createDataChannel('combrisk',{ordered:false,maxRetransmits:0}));await p.setLocalDescription(await p.createOffer());await this.gather();return 'COMBRISK:'+pack({v:1,type:'offer',sdp:p.localDescription.sdp});}\n  async joinOffer(code){let offer;try{offer=unpack(code);}catch{throw Error('That invitation is not a Combrisk code. Paste the complete code.');}if(offer.v\"'!==1||offer.type!=='\"'offer')throw Error('Paste the host’s invitation here.');const p=this.createPeer('guest');await p.setRemoteDescription({type:'offer',sdp:offer.sdp});await p.setLocalDescription(await p.createAnswer());await this.gather();return 'COMBRISK:'+pack({v:1,type:'answer',sdp:p.localDescription.sdp});}\n  async acceptAnswer(code){let a;try{a=unpack(code);}catch{throw Error('That reply is not a Combrisk code. Paste the complete code.');}if(a.type\"'!=='\"'answer'||\"'!this.peer)throw Error('\"'Create an invitation first, then paste your friend’s reply.');await this.peer.setRemoteDescription({type:'answer',sdp:a.sdp});}\n  close(silent=false){this.active=false;if(this.channel){this.channel.onclose=null;this.channel.close();}if(this.peer){this.peer.onconnectionstatechange=null;this.peer.close();}this.peer=null;this.channel=null;this.kind='none';this.lastInput.clear();if(\"'!silent)this.onDisconnect('\"'Link closed.');}\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"agent_message","text":"The simulation now includes physical tank collisions, destructible cover, ricochet damage, respawns, pickups, boosts, ghost visibility, and wrapping air combat. I’m adding the menus and control prompts next, along with host-authoritative multiplayer for AI Hub and standalone direct-link duels."}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat > src/style.css <<'EOF'\n:root{--ink:#182e34;--cream:#fff0cc;--paper:#f5e5bd;--yellow:#ffd34e;--teal:#87d1bb;--coral:#f17a60;--dim:#c0d3c3;--scale:1;font-family:Arial,Helvetica,sans-serif;color:var(--cream);font-size:clamp(16px,1.38vw,25px);font-weight:600;font-synthesis:none}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#367b78}body{touch-action:none;user-select:none}button,input,textarea{font:inherit}button{cursor:pointer}button:disabled{opacity:.48;cursor:wait}button,textarea,input{outline:none}button{border:0}#scene{position:fixed;inset:0;width:100%;height:100%;outline:none;touch-action:none}.vignette{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 55% 45%,transparent 30%,#133b4033 100%);box-shadow:inset 0 0 100px #0e303b18}.screen{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:4.5vh 5vw;background:#102f38b8;backdrop-filter:blur(5px);z-index:10}.screen:empty{display:none}.screen.title{align-items:stretch;justify-content:flex-start;padding:6.3vh 5.5vw 5vh;background:linear-gradient(90deg,#153840fa 0%,#153840ef 29%,#153840b0 43%,transparent 72%);backdrop-filter:none}.title-content{display:flex;flex-direction:column;align-items:flex-start;max-width:46vw;width:41rem}.eyebrow{font-size:.64rem;letter-spacing:.24em;font-weight:800;display:flex;align-items:center;gap:.7rem;color:var(--teal);text-transform:uppercase}.eyebrow::before{content:'✦';font-size:1.2rem;letter-spacing:0;color:var(--yellow)}.logo{font-weight:1000;letter-spacing:-.085em;line-height:.82;transform:skewY(-5deg);font-size:clamp(78px,8.8vw,172px);margin:4.5vh 0 3.2vh;text-shadow:6px 7px 0 #0d252c;color:var(--cream);position:relative;white-space:nowrap}.logo span{color:var(--yellow)}.logo sup{position:absolute;right:-.6em;top:-.3em;font-size:.2em;line-height:1.5;letter-spacing:-.04em;color:var(--ink);background:var(--yellow);padding:.05em .32em;transform:rotate(7deg);text-shadow:none;box-shadow:4px 4px 0 #0c292e}.tagline{font-size:1.5rem;letter-spacing:-.035em;font-weight:900;margin:1.2vh 0 1vh}.title-copy{font-size:.82rem;line-height:1.55;color:var(--dim);max-width:22rem;margin:0 0 3.1vh;font-weight:500}.menu-stack{display:flex;flex-direction:column;gap:.7rem;width:22rem;max-width:100%}.menu-button{position:relative;min-height:3.2rem;padding:.8rem 1.1rem;text-align:left;font-weight:900;font-size:1.06rem;background:#153c44;border:2px solid #779b9760;color:var(--cream);box-shadow:4px 4px 0 #10272c;transition:transform .1s,background .1s;display:flex;justify-content:space-between;align-items:center;gap:1rem}.menu-button .arrow{font-size:1.3rem;color:var(--yellow)}.menu-button.selected,.menu-button:focus-visible,.menu-button:hover{background:var(--yellow);color:var(--ink);border-color:var(--yellow);transform:translate(-2px,-2px);box-shadow:6px 6px 0 #10272c}.menu-button.selected .arrow,.menu-button:hover .arrow{color:var(--ink)}.menu-button small{font-size:.58rem;letter-spacing:.08em;font-weight:800;opacity:.8}.secondary-row{display:flex;flex-wrap:wrap;gap:.55rem;margin:1.2rem 0 0}.text-button{padding:.5rem .55rem;background:transparent;border:1px solid #7caba277;color:var(--cream);font-size:.71rem;font-weight:800}.text-button.selected,.text-button:focus-visible,.text-button:hover{color:var(--ink);background:var(--cream);border-color:var(--cream)}.title-foot{margin-top:auto;padding-top:2vh;color:#a8c6ba;font-size:.57rem;letter-spacing:.12em;line-height:1.8}.title-sticker{position:absolute;right:7vw;bottom:13vh;width:11.6rem;transform:rotate(-7deg);background:var(--yellow);color:var(--ink);padding:1.1rem 1.4rem;box-shadow:8px 8px 0 #14383b;border:2px solid var(--ink);pointer-events:none}.title-sticker strong{display:block;font-size:1.9rem;line-height:1;letter-spacing:-.055em}.title-sticker span{display:block;font-size:.58rem;letter-spacing:.12em;margin-top:.6rem}.title-sticker::before{content:'↗';position:absolute;right:.7rem;top:.45rem;font-size:1.8rem}.panel{width:min(39rem,92vw);max-height:89vh;overflow:auto;padding:2.1rem 2.4rem;background:var(--ink);border:2px solid #8ca99c;box-shadow:12px 12px 0 #0b242a70;position:relative;scrollbar-color:var(--yellow) var(--ink);scrollbar-width:thin}.panel.wide{width:min(58rem,94vw)}.panel::before{content:'';position:absolute;left:0;top:0;height:.28rem;width:30%;background:var(--yellow)}.panel h1{font-size:2.6rem;line-height:.98;letter-spacing:-.055em;margin:.8rem 0 1rem;font-weight:1000;color:var(--cream)}.panel .subtitle{font-size:.88rem;line-height:1.5;color:var(--dim);margin:.6rem 0 1.5rem;font-weight:500}.panel .eyebrow{font-size:.62rem}.panel .menu-stack{width:100%}.panel .menu-button{min-height:2.65rem;font-size:.9rem}.panel .back{margin-top:1.2rem}.panel .back .menu-button{background:transparent;box-shadow:none;border-color:#71918c60;color:var(--dim);font-size:.75rem;min-height:2.4rem}.panel .back .menu-button.selected{background:var(--cream);color:var(--ink)}.button-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.option-card{border:2px solid #7d9b8b80;background:#24454b;padding:1.25rem;text-align:left;color:var(--cream);min-height:8rem;box-shadow:5px 5px 0 #0c252b}.option-card strong{display:block;font-size:1.35rem;letter-spacing:-.035em;margin:.5rem 0}.option-card small{display:block;font-size:.73rem;line-height:1.5;color:var(--dim);font-weight:500}.option-card .symbol{font-size:1.5rem;color:var(--yellow)}.option-card.selected,.option-card:hover,.option-card:focus-visible{border-color:var(--yellow);background:#385b57;transform:translateY(-2px)}.arena-select{background:#102e35;border-left:4px solid var(--yellow);padding:.9rem 1rem;margin:0 0 1rem;display:flex;align-items:center;justify-content:space-between;gap:.5rem}.arena-select strong{font-size:.95rem}.arena-select small{display:block;color:var(--teal);font-size:.6rem;letter-spacing:.1em;margin-bottom:.3rem}.arena-select button{background:transparent;color:var(--yellow);font-size:1.6rem;padding:.3rem .6rem}.arena-select button.selected{background:var(--yellow);color:var(--ink)}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem 1.4rem}.range-row{display:block;background:#24454b;border:2px solid transparent;padding:.85rem 1rem;font-size:.8rem;position:relative}.range-row:focus-within{border-color:var(--yellow)}.range-row .row-head{display:flex;justify-content:space-between;gap:1rem}.range-row output{font-variant-numeric:tabular-nums;color:var(--yellow);font-weight:900}.range-row input{width:100%;height:1rem;margin:.7rem 0 0;accent-color:var(--yellow);cursor:pointer;display:block;appearance:none;background:transparent}.range-row input::-webkit-slider-runnable-track{height:.17rem;background:#64847c}.range-row input::-webkit-slider-thumb{appearance:none;width:.64rem;height:.9rem;background:var(--yellow);margin-top:-.36rem;border:2px solid var(--ink)}.toggle{background:#24454b;color:var(--cream);border:2px solid transparent;padding:.85rem 1rem;text-align:left;font-size:.8rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;min-height:3rem}.toggle b{color:var(--yellow);font-size:.72rem}.toggle.selected,.toggle:focus-visible,.toggle:hover{border-color:var(--yellow)}.settings-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}.setting-single{margin-bottom:1.1rem}.how-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem}.how-card{background:#24454b;padding:1.1rem;border-top:3px solid var(--yellow)}.how-card .diagram{height:2.2rem;color:var(--yellow);font-size:1.9rem;font-weight:900;letter-spacing:.1em}.how-card h3{font-size:.96rem;margin:.6rem 0}.how-card p{font-size:.73rem;color:var(--dim);line-height:1.55;margin:.5rem 0;font-weight:500}.how-card .control{font-size:.72rem;line-height:1.7}.how-card kbd{font-size:.7rem}.how-local{font-size:.75rem;color:var(--dim);line-height:1.6;margin:1.2rem 0 0}.about-scroll{max-height:58vh;overflow:auto;user-select:text;padding-right:1rem;scrollbar-color:var(--yellow) #24454b}.about-scroll h2{font-size:1.25rem;margin:1.5rem 0 .7rem;color:var(--yellow)}.about-scroll h3{font-size:.8rem;color:var(--teal);margin:.8rem 0 .3rem}.about-scroll p,.about-scroll dl{font-size:.75rem;line-height:1.6;font-weight:500;color:var(--dim);margin:.3rem 0}.about-scroll dl{display:grid;grid-template-columns:8rem 1fr;gap:.5rem 1rem}.about-scroll dt{font-weight:800;color:var(--cream)}.about-scroll dd{margin:0}.hud{position:fixed;top:3.2vh;left:4vw;right:4vw;pointer-events:none;display:grid;grid-template-columns:1fr auto 1fr;align-items:start;gap:1.5rem;z-index:3}.hud[hidden]{display:none}.score-side{display:flex;gap:.6rem;flex-wrap:wrap}.score-side.right{justify-content:flex-end}.score-card{min-width:8.5rem;padding:.6rem .8rem;background:#153a40ed;border-top:4px solid var(--player);box-shadow:4px 4px 0 #0d2a3060;position:relative}.score-card .who{font-size:.61rem;letter-spacing:.07em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:10rem;color:var(--player);font-weight:900}.score-card .score{font-size:1.8rem;line-height:1.2;font-variant-numeric:tabular-nums;font-weight:900;letter-spacing:-.04em;display:flex;gap:.7rem;align-items:center}.score-card .score small{font-size:.7rem;color:#a8c4b6;letter-spacing:0}.score-card .armor{display:flex;gap:.2rem;margin-top:.3rem}.armor i{display:block;background:var(--player);height:.16rem;width:.7rem}.armor i.empty{background:#627a74}.clock{text-align:center;padding:.4rem 1rem;color:var(--cream);background:#163c42f2;box-shadow:4px 4px 0 #0b242a60;min-width:8rem}.clock .time{font-size:1.9rem;letter-spacing:-.04em;line-height:1.2;font-weight:1000;font-variant-numeric:tabular-nums}.clock small{display:block;color:var(--teal);font-size:.55rem;letter-spacing:.16em;margin-top:.25rem}.clock .hurry{color:var(--coral)}.pause-button{position:fixed;top:8.5rem;right:4vw;z-index:5;width:2.4rem;height:2.4rem;display:grid;place-items:center;background:#183c43d9;border:1px solid #7baba1;color:var(--cream);font-size:.85rem;pointer-events:auto}.pause-button:hover{background:var(--yellow);color:var(--ink)}.bottom-hud{position:fixed;bottom:3vh;left:4vw;right:4vw;display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;z-index:3;pointer-events:none}.objective{color:var(--cream);font-size:.75rem;padding:.65rem .8rem;background:#153a40ed;border-left:3px solid var(--yellow);max-width:48vw}.objective small{display:block;color:var(--teal);font-size:.55rem;letter-spacing:.13em;margin-bottom:.3rem}.controls-bar{display:flex;gap:1.25rem;flex-wrap:wrap;justify-content:flex-end;font-size:.65rem;color:var(--cream);background:#153a40ed;padding:.65rem 1rem;line-height:1.8}.controls-bar span{white-space:nowrap}kbd,.glyph{display:inline-flex;align-items:center;justify-content:center;min-width:1.35rem;min-height:1.25rem;border:1px solid #a6c3b3;border-bottom:3px solid #a6c3b3;border-radius:3px;color:var(--cream);padding:.02rem .2rem;margin-right:.3rem;font-family:inherit;font-size:.67rem;line-height:1.15;font-weight:900;vertical-align:middle;letter-spacing:0}.glyph{border:1.5px solid var(--cream);border-radius:50%;min-width:1.35rem;font-size:.9rem;border-bottom-width:1.5px}.boost-meter{display:inline-block;width:2.2rem;height:.18rem;background:#617d74;margin-left:.4rem;vertical-align:middle}.boost-meter i{display:block;height:100%;background:var(--yellow)}.round-intro{position:fixed;z-index:4;top:41%;left:50%;transform:translate(-50%,-50%) rotate(-2deg);text-align:center;background:var(--cream);border:3px solid var(--ink);color:var(--ink);box-shadow:9px 9px 0 #183c4280;padding:1.2rem 2rem;max-width:75vw;width:max-content;pointer-events:none}.round-intro[hidden]{display:none}.round-intro .heat-num{display:block;color:#3c786f;font-size:.65rem;letter-spacing:.2em}.round-intro strong{display:block;font-size:2.15rem;letter-spacing:-.045em;margin:.5rem 0}.round-intro p{font-size:.82rem;margin:.