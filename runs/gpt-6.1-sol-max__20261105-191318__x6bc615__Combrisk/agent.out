{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"sed -n '140,165p' reference/harness.html\nsed -n '190,254p' reference/harness.html\nrg -n 'this._initialized|compileAsync|requestAnimationFrame|createRenderObject|new WeakMap' node_modules/three/src/renderers/common/Renderer.js | head -35\nsed -n '1,95p' node_modules/three/src/renderers/common/ChainMap.js\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"sed -n '140,165p' reference/harness.html\nsed -n '190,254p' reference/harness.html\nrg -n 'this._initialized|compileAsync|requestAnimationFrame|createRenderObject|new WeakMap' node_modules/three/src/renderers/common/Renderer.js | head -35\nsed -n '1,95p' node_modules/three/src/renderers/common/ChainMap.js\"","aggregated_output":"  try {\n    const win = cell.frame.contentWindow;\n    for (const name of ['alert', 'confirm', 'prompt', 'open']) {\n      const original = win[name];\n      win[name] = (...args) => {\n        cell.violations.push(`${name}() called`);\n        log(`${cell.name}: ${name}() called — not allowed in a session`);\n        return name === 'confirm' ? false : name === 'prompt' ? null : undefined;\n      };\n      void original;\n    }\n    win.addEventListener('error', (e) => cell.violations.push(`error: ${e.message}`));\n    win.addEventListener('unhandledrejection', (e) => cell.violations.push(`unhandled rejection: ${e.reason?.message || e.reason}`));\n  } catch {\n    cell.instrumented = false;\n  }\n}\n\nasync function newRound() {\n  endCurrent();\n  applyNet();\n  const game = $('game').value.trim();\n  if (!game) return null;\n  if (!gameUrl(game)) {\n    log(`Not loading ${game}: the harness only plays pages from this site.`);\n    return null;\n    mode,\n    seed,\n    limitMs,\n    gate: true,\n    deliver: (key, m) => hubEnd.send(key, { k: 'h', r: round, m }),\n    onStatus: (s) => { state.status = s; render(state); },\n    onEnd: (record) => {\n      state.record = record;\n      log(`round ${round} ${record.status}: ${record.reason}${record.standings ? ' — standings ' + JSON.stringify(record.standings) : ''}`);\n      render(state);\n    },\n  });\n  hubEnd.onMessage((from, env) => {\n    if (env.k !== 'c' || env.r !== round) return;\n    if (env.m?.type !== 'vis') log(`${from} → hub: ${env.m?.type}${env.m?.type === 'result' ? ' ' + JSON.stringify({ time: env.m.time, score: env.m.score }) : ''}${env.m?.type === 'finish' ? ' ' + JSON.stringify(env.m.standings) : ''}`);\n    state.coordinator.receive(from, env.m);\n  });\n\n  for (const p of [...players, ...(serverMode ? [{ key: 'server', slot: null, name: 'Server', server: true }] : [])]) {\n    const color = p.server ? '#8a8a8a' : ['#e8443a', '#3b82f6', '#22c55e', '#f5b700'][p.slot];\n    const frame = document.createElement('iframe');\n    frame.allow = 'fullscreen; autoplay; gamepad; pointer-lock';\n    frame.title = p.name;\n    const label = document.createElement('div');\n    label.className = 'cell__bar';\n    label.innerHTML = `<span class=\"cell__dot\" style=\"background:${color}\"></span><b></b><span class=\"cell__state\"></span>`;\n    label.querySelector('b').textContent = `${p.name} (${p.key})`;\n    const el = document.createElement('div');\n    el.className = 'cell';\n    el.style.borderColor = color;\n    el.append(label, frame);\n    grid.append(el);\n\n    const endpoint = net.endpoint(p.key);\n    const cell = { ...p, el, label, frame, endpoint, violations: [], instrumented: true, gone: false, progress: [], cardSent: '' };\n    const post = postTo(frame);\n    cell.bridge = createBridge({\n      key: p.key,\n      round,\n      coordinator: 'hub',\n      post: (msg) => {\n        if (msg.type !== 'message') log(`hub → ${p.key}: ${msg.type}${msg.type === 'start' ? ` in ${msg.in} ms` : ''}${msg.type === 'leave' ? ` ${msg.id} (${msg.reason})` : ''}${msg.type === 'end' ? ` ${msg.reason}` : ''}`);\n        post(msg);\n      },\n      net: endpoint,\n      onIssue: (i) => log(`${p.key} ✗ ${i.problem}`),\n      onFullscreen: (on) => log(`${p.key} asked for fullscreen ${on ? 'on' : 'off'}: the hub's page takes it`),\n      onAnswer: (what) => answerCard(state, cell, what),\n      // The scoreboard's feed: this cell's own progress, as its bridge passes it on.\n      onProgress: (id, report) => {\n        if (id !== cell.bridge?.me) return;\n        cell.progress.push({ at: performance.now(), ...report });\n        state.coordinator.progress(id, report.score);\n        render(state);\n      },\n    });\n    endpoint.onMessage((from, env) => cell.bridge.fromNet(from, env));\n    cell.detach = attachFrame(frame, (msg) => cell.bridge.fromGame(msg));\n    frame.addEventListener('load', () => instrument(cell), { once: true });\n    frame.src = gameUrl(game, { tag: metas?.mode, seed });\n    state.cells.push(cell);\n  }\n  renderWho(state);\n  render(state);\n  // By hand, the card lifts by itself after ten seconds (more when a player asks), as in a session;\n584:\t\t * use and only relevant for `compileAsync()` right now. Instead of using\n631:\t\tthis._initialized = false;\n643:\t\t * An array of compilation promises which are used in `compileAsync()`.\n715:\t\t\t\tawait this.compileAsync( scene, camera );\n741:\t\tif ( this._initialized ) {\n804:\t\t\tthis._initialized = true;\n843:\tasync compileAsync( scene, camera, targetScene = null ) {\n847:\t\tif ( this._initialized === false ) await this.init();\n977:\t\tif ( this._initialized === false ) await this.init();\n1189:\t\tif ( this._initialized === false ) {\n1613:\t * with this method and not manually with `requestAnimationFrame()`\n1622:\t\tif ( this._initialized === false ) await this.init();\n1731:\t\tif ( this._initialized ) this.backend.updateSize();\n1762:\t\tif ( this._initialized ) this.backend.updateSize();\n2017:\t\tif ( this._initialized === false ) {\n2107:\t\tif ( this._initialized === false ) await this.init();\n2190:\t\tif ( this._initialized === true ) {\n2339:\t\tif ( this._initialized === false ) {\n2436:\t\tif ( this._initialized === false ) await this.init();\n2451:\t\tif ( this._initialized === false ) await this.init();\n2459:\t\tif ( this._initialized === false ) await this.init();\n2474:\t\tif ( this._initialized === false ) {\n2493:\t\treturn this._initialized;\n2507:\t\tif ( this._initialized === false ) await this.init();\n2523:\t\tif ( this._initialized === false ) {\n3032:\t * Used in `compileAsync()`.\n3066:\t * Alias for `compileAsync()`.\n3076:\t\treturn this.compileAsync;\n/**\n * Data structure for the renderer. It allows defining values\n * with chained, hierarchical keys. Keys are meant to be\n * objects since the module internally works with Weak Maps\n * for performance reasons.\n *\n * @private\n */\nclass ChainMap {\n\n\t/**\n\t * Constructs a new Chain Map.\n\t */\n\tconstructor() {\n\n\t\t/**\n\t\t * The root Weak Map.\n\t\t *\n\t\t * @type {WeakMap<Object, WeakMap>}\n\t\t */\n\t\tthis.weakMap = new WeakMap();\n\n\t}\n\n\t/**\n\t * Returns the value for the given array of keys.\n\t *\n\t * @param {Array<Object>} keys - List of keys.\n\t * @return {any} The value. Returns `undefined` if no value was found.\n\t */\n\tget( keys ) {\n\n\t\tlet map = this.weakMap;\n\n\t\tfor ( let i = 0; i < keys.length - 1; i ++ ) {\n\n\t\t\tmap = map.get( keys[ i ] );\n\n\t\t\tif ( map === undefined ) return undefined;\n\n\t\t}\n\n\t\treturn map.get( keys[ keys.length - 1 ] );\n\n\t}\n\n\t/**\n\t * Sets the value for the given keys.\n\t *\n\t * @param {Array<Object>} keys - List of keys.\n\t * @param {any} value - The value to set.\n\t * @return {ChainMap} A reference to this Chain Map.\n\t */\n\tset( keys, value ) {\n\n\t\tlet map = this.weakMap;\n\n\t\tfor ( let i = 0; i < keys.length - 1; i ++ ) {\n\n\t\t\tconst key = keys[ i ];\n\n\t\t\tif ( map.has( key ) === false ) map.set( key, new WeakMap() );\n\n\t\t\tmap = map.get( key );\n\n\t\t}\n\n\t\tmap.set( keys[ keys.length - 1 ], value );\n\n\t\treturn this;\n\n\t}\n\n\t/**\n\t * Deletes a value for the given keys.\n\t *\n\t * @param {Array<Object>} keys - The keys.\n\t * @return {boolean} Returns `true` if the value has been removed successfully and `false` if the value has not be found.\n\t */\n\tdelete( keys ) {\n\n\t\tlet map = this.weakMap;\n\n\t\tfor ( let i = 0; i < keys.length - 1; i ++ ) {\n\n\t\t\tmap = map.get( keys[ i ] );\n\n\t\t\tif ( map === undefined ) return false;\n\n\t\t}\n\n\t\treturn map.delete( keys[ keys.length - 1 ] );\n\n\t}\n\n","exit_code":0,"status":"completed"}}
