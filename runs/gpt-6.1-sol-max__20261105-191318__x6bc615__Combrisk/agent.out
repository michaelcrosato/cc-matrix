n-card .symbol{float:right}.option-card strong{font-size:1.3rem}.how-grid{grid-template-columns:1fr 1fr;gap:.6rem}.how-card{padding:.7rem}.how-card .diagram{height:1.5rem;font-size:1.4rem}.how-card h3{font-size:.84rem;margin:.45rem 0}.how-card p{font-size:.68rem}.how-card .control{font-size:.6rem}.how-card kbd{font-size:.6rem}.how-local{font-size:.66rem}.about-scroll dl{grid-template-columns:5.5rem 1fr;font-size:.69rem;gap:.45rem .6rem}.about-scroll p{font-size:.7rem}.hud{top:2vh;left:3vw;right:3vw;gap:.35rem}.score-side{flex-direction:column;gap:.4rem}.score-card{min-width:5rem;padding:.45rem .5rem;border-top-width:3px}.score-card .who{font-size:.45rem;max-width:6rem}.score-card .score{font-size:1.45rem;gap:.45rem}.score-card .score small{font-size:.55rem}.armor i{width:.5rem}.clock{min-width:4.8rem;padding:.4rem .5rem}.clock .time{font-size:1.45rem}.clock small{font-size:.39rem;letter-spacing:.08em}.round-intro{top:43%;padding:1rem;max-width:92vw;width:88vw}.round-intro strong{font-size:1.8rem}.round-intro p{font-size:.76rem}.round-intro .count{font-size:1.5rem;width:2.3rem;height:2.3rem}.bottom-hud{left:3vw;right:3vw;bottom:2vh}.controls-bar{display:none}.objective{max-width:80vw;font-size:.66rem;padding:.6rem .7rem}.objective small{font-size:.45rem}.pause-button{top:auto;right:3vw;bottom:2vh;width:2.8rem;height:2.8rem}.announce{font-size:.8rem;max-width:92vw;white-space:normal;text-align:center;top:22%}.attract{bottom:12vh}.attract b{font-size:1rem}.attract span{font-size:.6rem}.result-stats{gap:1rem}.result-score{padding:.5rem .7rem;font-size:.75rem}.settings-actions{gap:.4rem}.settings-actions .text-button{font-size:.64rem}.result-banner{font-size:2.8rem}}\n@media(max-height:600px) and (orientation:landscape){:root{font-size:14px}.screen.title{padding:4vh 5vw}.title-copy{margin-bottom:2vh;max-width:22rem}.logo{font-size:12vh;margin:3vh 0 2vh}.tagline{font-size:1.2rem}.menu-button{min-height:2.6rem;padding:.5rem .85rem}.secondary-row{margin-top:.8rem}.title-sticker{bottom:12vh}.title-foot{padding-top:1vh}.panel{max-height:92vh;padding:1.2rem 1.5rem}.panel h1{font-size:2rem}.panel .subtitle{margin:.4rem 0 .9rem}.pause-button{top:6.5rem}.settings-grid{gap:.6rem}.range-row{padding:.55rem .7rem}.how-card{padding:.7rem}.round-intro strong{font-size:1.7rem}.round-intro{padding:.8rem 1.5rem}.panel .menu-stack{gap:.4rem}.panel .menu-button{min-height:2.3rem}.title-sticker strong{font-size:1.5rem}}\nEOF\ncat > src/template.html <<'\"'EOF'\n<\"'!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<!--HUB_CLIENT-->\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#182e34\">\n<title>Combrisk — Little tanks. Big nerve.</title>\n<meta name=\"description\" content=\"A pocket-sized ricochet rivalry. Four arcade heats, ghost tanks, biplanes, and a whole lot of friendly fire. Inspired by Combat (1977).\">\n<meta name=\"hub:session\" content=\"1\">\n<meta name=\"hub:session-players\" content=\"1-4\">\n<meta name=\"hub:session-mode\" content=\"shared-world\">\n<meta name=\"hub:session-goal\" content=\"Score 5 knockouts before your rivals. Ricochet shells off walls, boost out of danger, and collect power-ups.\">\n<meta name=\"hub:session-howto\" content=\"Left stick moves, right stick aims, R2 fires, L1 or Cross boosts. Keyboard: WASD, mouse aim, click or Space fires, Shift boosts. Escape or Options pauses.\">\n<meta name=\"hub:session-minutes\" content=\"1.5\">\n<style>/*GAME_CSS*/</style>\n</head>\n<body data-input=\"keyboard\">\n<canvas id=\"scene\" aria-label=\"Combrisk three-dimensional battlefield\" tabindex=\"-1\"></canvas>\n<div class=\"vignette\"></div>\n<div id=\"hud\" class=\"hud\" hidden></div>\n<button id=\"pause-button\" class=\"pause-button\" aria-label=\"Pause game\" hidden>Ⅱ</button>\n<div id=\"bottom-hud\" class=\"bottom-hud\" hidden></div>\n<div id=\"round-intro\" class=\"round-intro\" hidden></div>\n<div id=\"announce\" class=\"announce\" role=\"status\" aria-live=\"polite\"></div>\n<div id=\"attract\" class=\"attract\" hidden><b>A LITTLE FRIENDLY FIRE.</b><span>DEMO IN PROGRESS · Any input to take the wheel</span></div>\n<div id=\"dev-badge\" class=\"dev-badge\"></div>\n<main id=\"screen\" class=\"screen\" aria-label=\"Game menu\"></main>\n<div id=\"touch-left\" class=\"touch-stick\"><i></i></div>\n<div id=\"touch-right\" class=\"touch-stick\"><i></i></div>\n<button id=\"touch-boost\" class=\"touch-boost\" aria-label=\"Boost\">BOOST</button>\n<div id=\"toast\" class=\"toast\" role=\"status\"></div>\n<div id=\"boot\"><div class=\"boot-logo\">COMBRISK</div><div class=\"spinner\"></div><p id=\"boot-status\">Warming the engines. Sharpening the angles.</p></div>\n<script>/*GAME_JS*/</script>\n</body></html>\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui.js <<'EOF'\nimport {LEVELS,DEFAULTS} from './game.js';\nconst credits=__CREDITS__;\nexport const esc=(s)=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst \"'$=id=>document.getElementById(id);\nconst btn=(action,label,sub='\"'',cls='menu-button')=>\"'`<button class=\"${cls}\" data-action=\"${action}\"><span>${label}${sub?` <small>${sub}</small>`:'\"''}</span><span class=\\\"arrow\\\" aria-hidden=\\\"true\\\">↗</span></button>\"'`;\nconst back=(label='\"'Back',action='back')=>\"'`<div class=\"back\">${btn(action,`← ${label}`)}</div>`;\nconst textbtn=(a,l)=>`<button class=\"text-button\" data-action=\"${a}\">${l}</button>`;\nconst panel=(eye,title,sub,body,wide=false)=>`<section class=\"panel${wide?'\"' wide':''}\\\" role=\\\"dialog\\\" aria-modal=\\\"true\\\" aria-label=\\\"\"'${esc(title)}\"><div class=\"eyebrow\">${eye}</div><h1>${title}</h1>${sub?`<p class=\"subtitle\">${sub}</p>`:'\"''}\"'${body}</section>`;\nconst range=(key,label,min,max,step,value,kind='\"'setting',format=null)=>\"'`<label class=\"range-row\"><span class=\"row-head\"><span>${label}</span><output data-output=\"${key}\">${format||value}</output></span><input aria-label=\"${label}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\" data-${kind}=\"${key}\"></label>`;\nexport class UI {\n  constructor(input,settings){this.input=input;this.settings=settings;this.screen=$('\"'screen');this.name='boot';this.onAction=()=>{};this.onSetting=()=>{};this.onTune=()=>{};this.backTo='title';this.selectedHeat=0;this.linkRole='host';this.linkOut='';this.linkReply='';this.toastUntil=0;this.announceUntil=0;this.hudTick=0;this.lastDevice='';\n    this.screen.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b&&\"'!b.disabled)this.onAction(b.dataset.action,b);});\n    this.screen.addEventListener('\"'pointerover',e=>{const b=e.target.closest('button,input,textarea');if(b&&document.activeElement\"'!==b&&!b.disabled)b.focus({preventScroll:true});});\n    this.screen.addEventListener('\"'focusin',e=>{this.screen.querySelectorAll('.selected').forEach(b=>b.classList.remove('selected'));e.target.classList.add('selected');});\n    this.screen.addEventListener('input',e=>{const k=e.target.dataset.setting,t=e.target.dataset.tune;if(k)this.onSetting(k,Number(e.target.value));if(t)this.onTune(t,Number(e.target.value));this.screen.querySelector(\"'`[data-output=\"${k||t}\"]`).textContent=k?`${Math.round(Number(e.target.value)*100)}%`:Number(e.target.value).toFixed(e.target.step.includes('\"'.')?2:0);});\n    \"'$('\"'pause-button').addEventListener('click',()=>this.onAction('pause'));\"'$('\"'touch-boost').addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();this.input.justBoost=true;});\n  }\n  show(name,html){this.name=name;this.screen.className='screen'+(name==='title'?' title':'');this.screen.innerHTML=html;this.input.menu=true;this.input.clear();requestAnimationFrame(()=>{const b=this.focusables()[0];b?.focus({preventScroll:true});});}\n  focusables(){return Array.from(this.screen.querySelectorAll('button,input,textarea,[tabindex=\\\"0\\\"]')).filter(e=>\"'!e.disabled&&e.getBoundingClientRect().width>0);}\n  navigate(x,y){const a=this.focusables();if(!a.length)return;let i=a.indexOf(document.activeElement);if(i<0)i=0;const e=a[i];if(x&&e?.type==='\"'range'){e.value=Number(e.value)+x*Number(e.step||1);e.dispatchEvent(new Event('input',{bubbles:true}));return;}a[(i+(y||x)+a.length)%a.length]?.focus();}\n  confirm(){const e=document.activeElement;if(this.screen.contains(e)&&e.matches('button'))e.click();else this.focusables().find(e=>e.matches('button'))?.click();}\n  clear(){this.name='game';this.screen.innerHTML='';this.input.menu=false;this.input.clear();\"'$('\"'scene').focus({preventScroll:true});}\n  title(){this.show('title',\"'`<div class=\"title-content\"><div class=\"eyebrow\">THE WEEKEND WAR DEPARTMENT</div><h1 class=\"logo\">COM<span>BRISK</span><sup>77</sup></h1><p class=\"tagline\">Little tanks. Big nerve.</p><p class=\"title-copy\">A pocket-sized ricochet rivalry.<br>Four heats. Two tracks. Absolutely no brakes.</p><div class=\"menu-stack\">${btn('\"'solo','Play the circuit','1 PLAYER')}\"'${btn('\"'versus','Settle a score','VERSUS')}</div><div class=\\\"secondary-row\\\">\"'${textbtn('\"'how','How to play')}\"'${textbtn('\"'settings','Settings')}\"'${textbtn('\"'about','About')}</div><div class=\\\"title-foot\\\">INSPIRED BY COMBAT · 1977<br><span id=\\\"title-prompts\\\">\"'${this.menuPrompts()}</span><br>STAND BY FOR A LITTLE FRIENDLY FIRE.</div></div><div class=\"title-sticker\"><strong>4 HEATS.<br>1 GOOD<br>GRUDGE.</strong><span>TANKS · RICOCHETS · GHOSTS · BIPLANES</span></div>`);this.hideHud();$('\"'attract').hidden=true;}\n  menuPrompts(){return this.input.device==='pad'?\"'`${this.glyph('\"'move')} Choose &nbsp; \"'${this.glyph('\"'confirm')} Select &nbsp; \"'${this.glyph('\"'back')} Back\"'`:'\"'↑ ↓ Choose &nbsp; ENTER Select &nbsp; ESC Back';}\n  glyph(action){const pad=this.input.device==='pad',xbox=this.settings.glyphs==='xbox';const map={move:pad?'L':this.input.device==='touch'?'DRAG':'WASD',aim:pad?'R':'MOUSE',fire:pad?(xbox?'RT':'R2'):'LMB',boost:pad?(xbox?'LB':'L1'):'SHIFT',pause:pad?(xbox?'☰':'OPTIONS'):'ESC',confirm:pad?(xbox?'A':'×'):'ENTER',back:pad?(xbox?'B':'○'):'ESC'};return \"'`<${pad?'\"'span class=\\\"glyph\\\"':'kbd'}>\"'${map[action]}</${pad?'\"'span':'kbd'}>\"'`;}\n  versus(){const l=LEVELS[this.selectedHeat];this.show('\"'versus',panel('KEEP IT FRIENDLY','SETTLE A SCORE.','Same screen or across the wire. Bring a rival.',\"'`<div class=\"arena-select\"><div><small>FIELD ${this.selectedHeat+1} / 4</small><strong>${l.name}</strong></div><button data-action=\"arena\" aria-label=\"Change arena\">↔</button></div><div class=\"button-grid\"><button class=\"option-card\" data-action=\"local\"><span class=\"symbol\">▰ ▰</span><strong>Couch duel</strong><small>Two pilots. One screen.<br>Two pads, or share the keyboard.</small></button><button class=\"option-card\" data-action=\"link\"><span class=\"symbol\">↔</span><strong>Link duel</strong><small>Two devices. One battlefield.<br>Exchange a direct connection code.</small></button></div><p class=\"how-local\">AI Hub sessions support up to four pilots in a shared arena. Open this game from the Hub lobby to join.</p>${back()}`));}\n  pause(state,hub=false){this.show('\"'pause',panel('A TACTICAL TEA BREAK','HOLD THAT<br>THOUGHT.',\"'`${LEVELS[state.heat].name} · ${hub?'\"'Online play continues while this menu is open.':'Your grudge can wait.'}\"'`,`<div class=\"menu-stack\">${btn('\"'resume','Back to the fray')}\"'${btn('\"'settings','Settings')}\"'${btn('\"'how','How to play')}\"'${!hub?btn('\"'dev','Developer tools'):''}\"'${btn('\"'about','About & credits')}\"'${!hub?btn('\"'quit','Return to title'):''}</div>\"'`));}\n  settingsMenu(){const s=this.settings;this.show('\"'settings',panel('MAKE YOURSELF COMFORTABLE','DIAL IT IN.','Your music starts at a neighbourly ten percent.',\"'`<div class=\"settings-grid\">${range('\"'master','Master volume',0,1,.05,s.master,'setting',\"'`${Math.round(s.master*100)}%`)}${range('\"'music','Music',0,1,.01,s.music,'setting',\"'`${Math.round(s.music*100)}%`)}${range('\"'sfx','Effects & gibberish',0,1,.05,s.sfx,'setting',\"'`${Math.round(s.sfx*100)}%`)}<button class=\"toggle\" data-action=\"glyphs\">Controller glyphs <b>${s.glyphs==='\"'xbox'?'XBOX · A B X Y':'PLAYSTATION · × ○ □ △'}</b></button><button class=\\\"toggle\\\" data-action=\\\"guide\\\">Ricochet guide <b>\"'${s.guide?'\"'ON':'OFF'}</b></button><button class=\\\"toggle\\\" data-action=\\\"shake\\\">Camera shake <b>\"'${s.shake?'\"'ON':'OFF'}</b></button></div><div class=\\\"settings-actions\\\">\"'${textbtn('\"'fullscreen','Fullscreen ↗')}\"'${textbtn('\"'resetSettings','Restore defaults')}</div>\"'${back()}`));}\n  how(){this.show('\"'how',panel('FIELD MANUAL / FOUR SIMPLE ORDERS','A LITTLE ANGLE.<br>A LOT OF ATTITUDE.','Win a heat with five points, or lead when the clock runs out. A knockout is worth one.',\"'`<div class=\"how-grid\"><div class=\"how-card\"><div class=\"diagram\">▰ →</div><h3>1. Make tracks.</h3><div class=\"control\">${this.glyph('\"'move')} Move &nbsp; \"'${this.glyph('\"'boost')} Boost</div><p>Drive in any direction. Boost recharges in four seconds. Roll through trouble in the air.</p></div><div class=\\\"how-card\\\"><div class=\\\"diagram\\\">⊕ · · ↗</div><h3>2. Take your shot.</h3><div class=\\\"control\\\">\"'${this.glyph('\"'aim')} Aim &nbsp; \"'${this.glyph('\"'fire')} Fire</div><p>Aim independently of your tracks. In a biplane, your nose follows your aim. No input? Keep cruising.</p></div><div class=\\\"how-card\\\"><div class=\\\"diagram\\\">→ ┃ ↙</div><h3>3. Play the angles.</h3><p>Shells bounce off walls and break crates. In heat two, a bank-shot knockout is worth two. Your own ricochets can bite back.</p></div><div class=\\\"how-card\\\"><div class=\\\"diagram\\\">◌ · · ▰</div><h3>4. Mind the ghosts.</h3><p>In heat three, firing reveals hidden tanks. Watch for their dust. In heat four, aircraft and shots wrap at the edges.</p></div><div class=\\\"how-card\\\"><div class=\\\"diagram\\\">+ ◇ \"'!</div><h3>A little assistance.</h3><p>Green: repair one armour. Blue: shield one hit. Yellow: eight seconds of rapid fire. Three hits knock a tank out.</p></div><div class=\"how-card\"><div class=\"diagram\">☝ ↔ ☝</div><h3>Touch & go.</h3><p>Left thumb moves. Right thumb aims and fires. One thumb? Aim and fire are assisted. Double-tap the right side to boost.</p></div></div><p class=\"how-local\">Couch keyboard: P1 uses WASD + mouse, click/Space, Shift. P2 uses arrows to move, IJKL to aim, / to fire, . to boost. One connected pad controls P2; two pads control P1 and P2.</p>${back()}`,true));}\n  dev(game){const t=game.tuning,c=game.cheats;this.show('\"'dev',panel('DEVELOPER MODE / LIVE BALANCE','THE TEST RANGE.','Adjust the next exchange. Changes apply immediately; the battlefield is paused.',\"'`<div class=\"settings-grid\">${range('\"'speed','Drive speed',2,10,.1,t.speed,'tune')}\"'${range('\"'shellSpeed','Shell speed',8,40,.5,t.shellSpeed,'tune')}\"'${range('\"'reload','Seconds per shot',.1,1.5,.02,t.reload,'tune')}\"'${range('\"'aiSkill','AI accuracy',.1,1.2,.05,t.aiSkill,'tune')}\"'${range('\"'roundTime','Heat seconds',20,180,5,t.roundTime,'tune')}\"'${range('\"'target','Points to win',1,15,1,t.target,'tune')}<button class=\\\"toggle\\\" data-action=\\\"god\\\">Player invincibility <b>\"'${c.invincible?'\"'ON':'OFF'}</b></button><button class=\\\"toggle\\\" data-action=\\\"freezeAI\\\">Freeze AI <b>\"'${c.aiPaused?'\"'ON':'OFF'}</b></button><button class=\\\"toggle\\\" data-action=\\\"colliders\\\">Physics wireframe <b>\"'${c.colliders?'\"'ON':'OFF'}</b></button><button class=\\\"toggle\\\" data-action=\\\"slowmo\\\">Simulation speed <b>\"'${c.slowmo===1?'\"'1×':'0.35×'}</b></button></div><div class=\\\"settings-actions\\\">\"'${textbtn('\"'repair','Repair & shield')}\"'${textbtn('\"'pickups','Spawn all pickups')}\"'${textbtn('\"'next','Next heat')}\"'${textbtn('\"'restart','Restart heat')}\"'${textbtn('\"'resetTune','Reset balance')}</div><div class=\\\"back\\\">\"'${btn('\"'resume','Playtest →')}\"'${textbtn('\"'pause','← Pause menu')}</div>\"'`,true));}\n  about(){const si=credits.sourceInformation;const qs={testingFeedback:['\"'How many issues did testing catch?','How many were critical or game breaking?','Most helpful test?','Least helpful test?'],engineFeedback:['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important thing you built yourself?','Hardest part of using the engine?','What did you change in the engine, and why?','If you could change one thing?'],promptFeedback:['What did you like most about this prompt?','What was confusing?','What was the hardest thing to do?','What would you change?']};let copy=\"'`<h2>Source Information</h2><dl>${Object.entries(si).map(([k,v])=>`<dt>${esc(k[0].toUpperCase()+k.slice(1))}</dt><dd>${esc(v)}</dd>`).join('\"'')}</dl>\"'`;for(const[k,title]of[['\"'testingFeedback','Testing Feedback'],['engineFeedback','Engine Feedback'],['promptFeedback','Prompt Feedback']])copy+=\"'`<h2>${title}</h2>${credits[k].map((v,i)=>`<h3>${qs[k][i]}</h3><p>${esc(v)}</p>`).join('\"'')}\"'`;\n    this.show('\"'about',panel('THE SMALL PRINT','MADE OF ANGLES.','An original, affectionate riff on the tank-and-biplane rivalry of Combat (1977).',\"'`<div class=\"about-scroll\" tabindex=\"0\">${copy}<h2>Credits & licences</h2><p>Original game, procedural art, animation, music, sound and gibberish voice created in code. Three.js r180 — MIT. Rapier 0.19.3 — Apache-2.0. AI Hub Session Protocol v1 client 1.4.0, from the supplied michaelcrosato/ai-hub repository. Standalone direct links use WebRTC with public STUN; relay service: none.</p><p>No source assets or audio recordings are used. Combat belongs to its respective rights holders. This is an independent homage.</p></div>${back()}`,true));}\n  results(state,guest=false){const final=state.finished,solo=state.mode==='\"'solo',last=state.results[state.results.length-1],wins=state.heatWins||0;const title=solo&&final?(wins>=3?'THE WEEKEND<br>IS YOURS.':'A GRUDGE<br>WELL PLAYED.'):last?.win?'NICE<br>SHOOTING.':'NEXT TIME,<br>TIGER.';const sub=solo&&final?\"'`${wins} / 4 heats won. ${wins>=3?'\"'Your Golden Ricochet is in the post.':'The rematch is already personal.'}\"'`:LEVELS[state.heat].tag;\n    const scores=state.tanks.map(t=>({...t,shown:solo&&final?(state.total[t.id]||0):t.score})).sort((a,b)=>b.shown-a.shown);const stats=state.stats||{};\n    this.show('\"'results',panel(solo&&final?'CIRCUIT COMPLETE':\"'`HEAT ${state.heat+1} / COMPLETE`,title,sub,`${solo&&final?'\"'<div class=\\\"result-banner\\\">✦ ✦ ✦</div>':''}<div class=\\\"result-scores\\\">\"'${scores.map(t=>`<div class=\"result-score\" style=\"--player:${esc(t.color)}\"><span>${esc(t.name)}</span><span class=\"value\">${t.shown} <small>PTS</small></span></div>`).join('\"'')}</div>\"'${solo?`<div class=\"result-stats\"><span><strong>${stats.knockouts||0}</strong>KNOCKOUTS</span><span><strong>${stats.banks||0}</strong>RICOCHETS</span><span><strong>${stats.pickups||0}</strong>PICKUPS</span><span><strong>${stats.boosts||0}</strong>BOOSTS</span></div>`:'\"''}<div class=\\\"menu-stack\\\">\"'${guest?'\"'<p class=\\\"link-help\\\">Waiting for the host to call a rematch.</p>':btn(solo&&\"'!final?'\"'continue':'rematch',solo&&\"'!final?'\"'Next heat →':'One more round?')}\"'${btn('\"'quit','Back to title')}</div>\"'`));}\n  link(){this.linkRole='\"'host';this.linkOut='';this.linkReply='';this.linkMenu();}\n  linkMenu(){const host=this.linkRole==='host';this.show('link',panel('DIRECT LINK / TWO DEVICES','CALL IN A RIVAL.','No account. No lobby server. Just a good old-fashioned exchange.',\"'`<div class=\"link-tabs\">${textbtn('\"'linkHost','I’m hosting')}\"'${textbtn('\"'linkJoin','I’m joining')}</div><p class=\\\"link-help\\\">\"'${host?'\"'1. Create an invitation and send it to your friend.<br>2. Paste their reply below. The duel starts when you connect.':'1. Paste your friend’s invitation below.<br>2. Generate a reply and send it back. Keep this screen open.'}</p><label class=\\\"link-label\\\" for=\\\"link-in\\\">\"'${host?'\"'YOUR FRIEND’S REPLY':'HOST’S INVITATION'}</label><textarea id=\\\"link-in\\\" class=\\\"link-code\\\" placeholder=\\\"Paste the complete COMBRISK: code here\\\" aria-label=\\\"\"'${host?'\"'Friend reply code':'Host invitation code'}\\\" spellcheck=\\\"false\\\"></textarea><div class=\\\"settings-actions\\\">\"'${textbtn(host?'\"'createOffer':'createAnswer',host?'1. Create invitation':'Generate reply')}\"'${host?textbtn('\"'acceptAnswer','2. Connect with reply'):''}</div><label class=\\\"link-label\\\" for=\\\"link-out\\\">\"'${host?'\"'YOUR INVITATION':'YOUR REPLY'}</label><textarea id=\\\"link-out\\\" class=\\\"link-code\\\" readonly aria-label=\\\"Code to share\\\" spellcheck=\\\"false\\\">\"'${esc(this.linkOut)}</textarea><div class=\"settings-actions\">${textbtn('\"'copyCode','Copy code')}</div><p id=\\\"link-status\\\" class=\\\"link-error\\\" role=\\\"status\\\"></p><p class=\\\"link-help\\\">Direct peer-to-peer connections. Some networks require a relay; no relay is provided. AI Hub handles its own network when launched from a session.</p>\"'${back('\"'Versus','versus')}\"'`));}\n  linkStatus(text,error=false){const e=$('\"'link-status');if(e){e.textContent=text;e.style.color=error?'var(--coral)':'var(--teal)';}}\n  waiting(msg='Waiting for the other pilot…'){this.show('waiting',panel('LINK ESTABLISHED','STAND BY.',msg,btn('quit','Return to title')));}\n  hideHud(){for(const id of ['hud','bottom-hud','pause-button','round-intro'])\"'$(id).hidden=true;$('\"'announce').textContent='';\"'$('\"'dev-badge').textContent='';}\n  toast(text){\"'$('\"'toast').textContent=text;this.toastUntil=performance.now()+3000;}\n  announce(text){\"'$('\"'announce').textContent=text;this.announceUntil=performance.now()+1800;}\n  touchSticks(touches){for(const id of ['touch-left','touch-right'])\"'$(id).style.display='\"'none';\"'$('\"'touch-boost').style.display='none';if(this.name\"'!=='\"'game')return;for(const t of touches.values()){const e=\"'$(t.right?'\"'touch-right':'touch-left');e.style.display='block';e.style.left=t.sx+'px';e.style.top=t.sy+'px';const dx=t.x-t.sx,dz=t.y-t.sy,l=Math.hypot(dx,dz),f=l>55?55/l:1;e.firstChild.style.transform=\"'`translate(${dx*f}px,${dz*f}px)`;if(t.right){const b=$('\"'touch-boost');b.style.display='block';b.style.left=Math.min(innerWidth-55,t.sx+65)+'px';b.style.top=Math.max(70,t.sy-90)+'px';}}}\n  update(state,dt,attract=false,game=null){\n    const now=performance.now();if(now>this.toastUntil)\"'$('\"'toast').textContent='';if(now>this.announceUntil)\"'$('\"'announce').textContent='';if(this.name==='title'&&this.input.device\"'!==this.lastDevice){const e=$('\"'title-prompts');if(e)e.innerHTML=this.menuPrompts();}this.lastDevice=this.input.device;\n    if(this.name\"'!=='\"'game'&&\"'!attract)return;this.hudTick+=dt;if(this.hudTick<.09)return;this.hudTick=0;\n    $('\"'hud').hidden=false;\"'$('\"'bottom-hud').hidden=false;\"'$('\"'pause-button').hidden=attract;\n    const left=state.tanks.filter(t=>t.id<2),right=state.tanks.filter(t=>t.id>=2);const card=t=>\"'`<div class=\"score-card\" style=\"--player:${esc(t.color)}\"><div class=\"who\">${esc(t.name)}${t.local?'\"' ◂':''}</div><div class=\\\"score\\\">\"'${t.score}<small>/ ${state.target}</small>${!t.alive?`<small>↺ ${Math.ceil(t.respawn)}</small>`:'\"''}</div><div class=\\\"armor\\\">\"'${[0,1,2].map(i=>`<i class=\"${i>=t.hp?'\"'empty':''}\\\"></i>\"'`).join('\"'')}</div></div>\"'`;let sides=state.tanks.length===2?[[state.tanks[0]],[state.tanks[1]]]:[left,right];\n    const sec=Math.max(0,Math.ceil(state.timer)),tm=`${Math.floor(sec/60)}:${String(sec%60).padStart(2,'\"'0')}\"'`;$('\"'hud').innerHTML=\"'`<div class=\"score-side\">${sides[0].map(card).join('\"'')}</div><div class=\\\"clock\\\"><div class=\\\"time \"'${sec<15?'\"'hurry':''}\\\">\"'${tm}</div><small>${state.mode==='\"'solo'?\"'`HEAT ${state.heat+1} / 4`:state.vehicle==='\"'plane'?'AIR DUEL':'TANK DUEL'}</small></div><div class=\\\"score-side right\\\">\"'${sides[1].map(card).join('\"'')}</div>\"'`;\n    const level=LEVELS[state.heat],local=state.tanks.find(t=>t.local)||state.tanks[0];const status=local?.rapid>0?`RAPID FIRE · ${Math.ceil(local.rapid)}s`:local?.shield?'\"'SHIELD READY':level.rule;\n    \"'$('\"'bottom-hud').innerHTML=\"'`<div class=\"objective\"><small>${level.name}</small>${esc(status)}</div><div class=\"controls-bar\"><span>${this.glyph('\"'move')} \"'${state.vehicle==='\"'plane'?'Steer':'Move'}</span><span>\"'${this.glyph('\"'aim')} Aim</span><span>\"'${this.glyph('\"'fire')} Fire</span><span>\"'${this.glyph('\"'boost')} Boost <span class=\\\"boost-meter\\\"><i style=\\\"width:\"'${100*(1-Math.min(1,(local?.boostCd||0)/3.8))}%\"></i></span></span></div>`;\n    const intro=$('\"'round-intro');intro.hidden=state.countdown<=0;if(state.countdown>0)intro.innerHTML=\"'`<span class=\"heat-num\">${state.mode==='\"'solo'?\"'`CIRCUIT / HEAT 0${state.heat+1}`:'\"'FIELD BRIEFING'}</span><strong>\"'${level.name}</strong><p>${level.tip}</p><div class=\"count\">${Math.ceil(state.countdown)}</div>`;\n    if(game){const c=game.cheats;const marks=[c.invincible?'\"'INVINCIBLE':'',c.aiPaused?'AI FROZEN':'',c.slowmo\"'!==1?'\"'SLOW MOTION':'',c.colliders?'PHYSICS VIEW':''].filter(Boolean);\"'$('\"'dev-badge').textContent=marks.length?'DEV · '+marks.join(' / '):'';}\n  }\n}\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > src/ui.js <<'EOF'\nimport {LEVELS,DEFAULTS} from './game.js';\nconst credits=__CREDITS__;\nexport const esc=(s)=>String(s).replace(/[&<>\\\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst \"'$=id=>document.getElementById(id);\nconst btn=(action,label,sub='\"'',cls='menu-button')=>\"'`<button class=\"${cls}\" data-action=\"${action}\"><span>${label}${sub?` <small>${sub}</small>`:'\"''}</span><span class=\\\"arrow\\\" aria-hidden=\\\"true\\\">↗</span></button>\"'`;\nconst back=(label='\"'Back',action='back')=>\"'`<div class=\"back\">${btn(action,`← ${label}`)}</div>`;\nconst textbtn=(a,l)=>`<button class=\"text-button\" data-action=\"${a}\">${l}</button>`;\nconst panel=(eye,title,sub,body,wide=false)=>`<section class=\"panel${wide?'\"' wide':''}\\\" role=\\\"dialog\\\" aria-modal=\\\"true\\\" aria-label=\\\"\"'${esc(title)}\"><div class=\"eyebrow\">${eye}</div><h1>${title}</h1>${sub?`<p class=\"subtitle\">${sub}</p>`:'\"''}\"'${body}</section>`;\nconst range=(key,label,min,max,step,value,kind='\"'setting',format=null)=>\"'`<label class=\"range-row\"><span class=\"row-head\"><span>${label}</span><output data-output=\"${key}\">${format||value}</output></span><input aria-label=\"${label}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${value}\" data-${kind}=\"${key}\"></label>`;\nexport class UI {\n  constructor(input,settings){this.input=input;this.settings=settings;this.screen=$('\"'screen');this.name='boot';this.onAction=()=>{};this.onSetting=()=>{};this.onTune=()=>{};this.backTo='title';this.selectedHeat=0;this.linkRole='host';this.linkOut='';this.linkReply='';this.toastUntil=0;this.announceUntil=0;this.hudTick=0;this.lastDevice='';\n    this.screen.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b&&\"'!b.disabled)this.onAction(b.dataset.action,b);});\n    this.screen.addEventListener('\"'pointerover',e=>{const b=e.target.closest('button,input,textarea');if(b&&document.activeElement\"'!==b&&!b.disabled)b.focus({preventScroll:true});});\n    this.screen.addEventListener('\"'focusin',e=>{this.screen.querySelectorAll('.selected').forEach(b=>b.classList.remove('selected'));e.target.classList.add('selected');});\n    this.screen.addEventListener('input',e=>{const k=e.target.dataset.setting,t=e.target.dataset.tune;if(k)this.onSetting(k,Number(e.target.value));if(t)this.onTune(t,Number(e.target.value));this.screen.querySelector(\"'`[data-output=\"${k||t}\"]`).textContent=k?`${Math.round(Number(e.target.value)*100)}%`:Number(e.target.value).toFixed(e.target.step.includes('\"'.')?2:0);});\n    \"'$('\"'pause-button').addEventListener('click',()=>this.onAction('pause'));\"'$('\"'touch-boost').addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();this.input.justBoost=true;});\n  }\n  show(name,html){this.name=name;this.screen.className='screen'+(name==='title'?' title':'');this.screen.innerHTML=html;this.input.menu=true;this.input.clear();requestAnimationFrame(()=>{const b=this.focusables()[0];b?.focus({preventScroll:true});});}\n  focusables(){return Array.from(this.screen.querySelectorAll('button,input,textarea,[tabindex=\\\"0\\\"]')).filter(e=>\"'!e.disabled&&e.getBoundingClientRect().width>0);}\n  navigate(x,y){const a=this.focusables();if(!a.length)return;let i=a.indexOf(document.activeElement);if(i<0)i=0;const e=a[i];if(x&&e?.type==='\"'range'){e.value=Number(e.value)+x*Number(e.step||1);e.dispatchEvent(new Event('input',{bubbles:true}));return;}a[(i+(y||x)+a.length)%a.length]?.focus();}\n  confirm(){const e=document.activeElement;if(this.screen.contains(e)&&e.matches('button'))e.click();else this.focusables().find(e=>e.matches('button'))?.click();}\n  clear(){this.name='game';this.screen.innerHTML='';this.input.menu=false;this.input.clear();\"'$('\"'scene').focus({preventScroll:true});}\n  title(){this.show('title',\"'`<div class=\"title-content\"><div class=\"eyebrow\">THE WEEKEND WAR DEPARTMENT</div><h1 class=\"logo\">COM<span>BRISK</span><sup>77</sup></h1><p class=\"tagline\">Little tanks. Big nerve.</p><p class=\"title-copy\">A pocket-sized ricochet rivalry.<br>Four heats. Two tracks. Absolutely no brakes.</p><div class=\"menu-stack\">${btn('\"'solo','Play the circuit','1 PLAYER')}\"'${btn('\"'versus','Settle a score','VERSUS')}</div><div class=\\\"secondary-row\\\">\"'${textbtn('\"'how','How to play')}\"'${textbtn('\"'settings','Settings')}\"'${textbtn('\"'about','About')}</div><div class=\\\"title-foot\\\">INSPIRED BY COMBAT · 1977<br><span id=\\\"title-prompts\\\">\"'${this.menuPrompts()}</span><br>STAND BY FOR A LITTLE FRIENDLY FIRE.</div></div><div class=\"title-sticker\"><strong>4 HEATS.<br>1 GOOD<br>GRUDGE.</strong><span>TANKS · RICOCHETS · GHOSTS · BIPLANES</span></div>`);this.hideHud();$('\"'attract').hidden=true;}\n  menuPrompts(){return this.input.device==='pad'?\"'`${this.glyph('\"'move')} Choose &nbsp; \"'${this.glyph('\"'confirm')} Select &nbsp; \"'${this.glyph('\"'back')} Back\"'`:'\"'↑ ↓ Choose &nbsp; ENTER Select &nbsp; ESC Back';}\n  glyph(action){const pad=this.input.device==='pad',xbox=this.settings.glyphs==='xbox';const map={move:pad?'L':this.input.device==='touch'?'DRAG':'WASD',aim:pad?'R':'MOUSE',fire:pad?(xbox?'RT':'R2'):'LMB',boost:pad?(xbox?'LB':'L1'):'SHIFT',pause:pad?(xbox?'☰':'OPTIONS'):'ESC',confirm:pad?(xbox?'A':'×'):'ENTER',back:pad?(xbox?'B':'○'):'ESC'};return \"'`<${pad?'\"'span class=\\\"glyph\\\"':'kbd'}>\"'${map[action]}</${pad?'\"'span':'kbd'}>\"'`;}\n  versus(){const l=LEVELS[this.selectedHeat];this.show('\"'versus',panel('KEEP IT FRIENDLY','SETTLE A SCORE.','Same screen or across the wire. Bring a rival.',\"'`<div class=\"arena-select\"><div><small>FIELD ${this.selectedHeat+1} / 4</small><strong>${l.name}</strong></div><button data-action=\"arena\" aria-label=\"Change arena\">↔</button></div><div class=\"button-grid\"><button class=\"option-card\" data-action=\"local\"><span class=\"symbol\">▰ ▰</span><strong>Couch duel</strong><small>Two pilots. One screen.<br>Two pads, or share the keyboard.</small></button><button class=\"option-card\" data-action=\"link\"><span class=\"symbol\">↔</span><strong>Link duel</strong><small>Two devices. One battlefield.<br>Exchange a direct connection code.</small></button></div><p class=\"how-local\">AI Hub sessions support up to four pilots in a shared arena. Open this game from the Hub lobby to join.</p>${back()}`));}\n  pause(state,hub=false){this.show('\"'pause',panel('A TACTICAL TEA BREAK','HOLD THAT<br>THOUGHT.',\"'`${LEVELS[state.heat].name} · ${hub?'\"'Online play continues while this menu is open.':'Your grudge can wait.'}\"'`,`<div class=\"menu-stack\">${btn('\"'resume','Back to the fray')}\"'${btn('\"'settings','Settings')}\"'${btn('\"'how','How to play')}\"'${!hub?btn('\"'dev','Developer tools'):''}\"'${btn('\"'about','About & credits')}\"'${!hub?btn('\"'quit','Return to title'):''}</div>\"'`));}\n  settingsMenu(){const s=this.settings;this.show('\"'settings',panel('MAKE YOURSELF COMFORTABLE','DIAL IT IN.','Your music starts at a neighbourly ten percent.',\"'`<div class=\"settings-grid\">${range('\"'master','Master volume',0,1,.05,s.master,'setting',\"'`${Math.round(s.master*100)}%`)}${range('\"'music','Music',0,1,.01,s.music,'setting',\"'`${Math.round(s.music*100)}%`)}${range('\"'sfx','Effects & gibberish',0,1,.05,s.sfx,'setting',\"'`${Math.round(s.sfx*100)}%`)}<button class=\"toggle\" data-action=\"glyphs\">Controller glyphs <b>${s.glyphs==='\"'xbox'?'XBOX · A B X Y':'PLAYSTATION · × ○ □ △'}</b></button><button class=\\\"toggle\\\" data-action=\\\"guide\\\">Ricochet guide <b>\"'${s.guide?'\"'ON':'OFF'}</b></button><button class=\\\"toggle\\\" data-action=\\\"shake\\\">Camera shake <b>\"'${s.shake?'\"'ON':'OFF'}</b></button></div><div class=\\\"settings-actions\\\">\"'${textbtn('\"'fullscreen','Fullscreen ↗')}\"'${textbtn('\"'resetSettings','Restore defaults')}</div>\"'${back()}`));}\n  how(){this.show('\"'how',panel('FIELD MANUAL / FOUR SIMPLE ORDERS','A LITTLE ANGLE.<br>A LOT OF ATTITUDE.','Win a heat with five points, or lead when the clock runs out. A knockout is worth one.',\"'`<div class=\"how-grid\"><div class=\"how-card\"><div class=\"diagram\">▰ →</div><h3>1. Make tracks.</h3><div class=\"control\">${this.glyph('\"'move')} Move &nbsp; \"'${this.glyph('\"'boost')} Boost</div><p>Drive in any direction. Boost recharges in four seconds. Roll through trouble in the air.</p></div><div class=\\\"how-card\\\"><div class=\\\"diagram\\\">⊕ · · ↗</div><h3>2. Take your shot.</h3><div class=\\\"control\\\">\"'${this.glyph('\"'aim')} Aim &nbsp; \"'${this.glyph('\"'fire')} Fire</div><p>Aim independently of your tracks. In a biplane, your nose follows your aim. No input? Keep cruising.</p></div><div class=\\\"how-card\\\"><div class=\\\"diagram\\\">→ ┃ ↙</div><h3>3. Play the angles.</h3><p>Shells bounce off walls and break crates. In heat two, a bank-shot knockout is worth two. Your own ricochets can bite back.</p></div><div class=\\\"how-card\\\"><div class=\\\"diagram\\\">◌ · · ▰</div><h3>4. Mind the ghosts.</h3><p>In heat three, firing reveals hidden tanks. Watch for their dust. In heat four, aircraft and shots wrap at the edges.</p></div><div class=\\\"how-card\\\"><div class=\\\"diagram\\\">+ ◇ \"'!</div><h3>A little assistance.</h3><p>Green: repair one armour. Blue: shield one hit. Yellow: eight seconds of rapid fire. Three hits knock a tank out.</p></div><div class=\"how-card\"><div class=\"diagram\">☝ ↔ ☝</div><h3>Touch & go.</h3><p>Left thumb moves. Right thumb aims and fires. One thumb? Aim and fire are assisted. Double-tap the right side to boost.</p></div></div><p class=\"how-local\">Couch keyboard: P1 uses WASD + mouse, click/Space, Shift. P2 uses arrows to move, IJKL to aim, / to fire, . to boost. One connected pad controls P2; two pads control P1 and P2.</p>${back()}`,true));}\n  dev(game){const t=game.tuning,c=game.cheats;this.show('\"'dev',panel('DEVELOPER MODE / LIVE BALANCE','THE TEST RANGE.','Adjust the next exchange. Changes apply immediately; the battlefield is paused.',\"'`<div class=\"settings-grid\">${range('\"'speed','Drive speed',2,10,.1,t.speed,'tune')}\"'${range('\"'shellSpeed','Shell speed',8,40,.5,t.shellSpeed,'tune')}\"'${range('\"'reload','Seconds per shot',.1,1.5,.02,t.reload,'tune')}\"'${range('\"'aiSkill','AI accuracy',.1,1.2,.05,t.aiSkill,'tune')}\"'${range('\"'roundTime','Heat seconds',20,180,5,t.roundTime,'tune')}\"'${range('\"'target','Points to win',1,15,1,t.target,'tune')}<button class=\\\"toggle\\\" data-action=\\\"god\\\">Player invincibility <b>\"'${c.invincible?'\"'ON':'OFF'}</b></button><button class=\\\"toggle\\\" data-action=\\\"freezeAI\\\">Freeze AI <b>\"'${c.aiPaused?'\"'ON':'OFF'}</b></button><button class=\\\"toggle\\\" data-action=\\\"colliders\\\">Physics wireframe <b>\"'${c.colliders?'\"'ON':'OFF'}</b></button><button class=\\\"toggle\\\" data-action=\\\"slowmo\\\">Simulation speed <b>\"'${c.slowmo===1?'\"'1×':'0.35×'}</b></button></div><div class=\\\"settings-actions\\\">\"'${textbtn('\"'repair','Repair & shield')}\"'${textbtn('\"'pickups','Spawn all pickups')}\"'${textbtn('\"'next','Next heat')}\"'${textbtn('\"'restart','Restart heat')}\"'${textbtn('\"'resetTune','Reset balance')}</div><div class=\\\"back\\\">\"'${btn('\"'resume','Playtest →')}\"'${textbtn('\"'pause','← Pause menu')}</div>\"'`,true));}\n  about(){const si=credits.sourceInformation;const qs={testingFeedback:['\"'How many issues did testing catch?','How many were critical or game breaking?','Most helpful test?','Least helpful test?'],engineFeedback:['What did you like most about the engine?','Did you get stuck or guess wrong?','Most important thing you built yourself?','Hardest part of using the engine?','What did you change in the engine, and why?','If you could change one thing?'],promptFeedback:['What did you like most about this prompt?','What was confusing?','What was the hardest thing to do?','What would you change?']};let copy=\"'`<h2>Source Information</h2><dl>${Object.entries(si).map(([k,v])=>`<dt>${esc(k[0].toUpperCase()+k.slice(1))}</dt><dd>${esc(v)}</dd>`).join('\"'')}</dl>\"'`;for(const[k,title]of[['\"'testingFeedback','Testing Feedback'],['engineFeedback','Engine Feedback'],['promptFeedback','Prompt Feedback']])copy+=\"'`<h2>${title}</h2>${credits[k].map((v,i)=>`<h3>${qs[k][i]}</h3><p>${esc(v)}</p>`).join('\"'')}\"'`;\n    this.show('\"'about',panel('THE SMALL PRINT','MADE OF ANGLES.','An original, affectionate riff on the tank-and-biplane rivalry of Combat (1977).',\"'`<div class=\"about-scroll\" tabindex=\"0\">${copy}<h2>Credits & licences</h2><p>Original game, procedural art, animation, music, sound and gibberish voice created in code. Three.js r180 — MIT. Rapier 0.19.3 — Apache-2.0. AI Hub Session Protocol v1 client 1.4.0, from the supplied michaelcrosato/ai-hub repository. Standalone direct links use WebRTC with public STUN; relay service: none.</p><p>No source assets or audio recordings are used. Combat belongs to its respective rights holders. This is an independent homage.</p></div>${back()}`,true));}\n  results(state,guest=false){const final=state.finished,solo=state.mode==='\"'solo',last=state.results[state.results.length-1],wins=state.heatWins||0;const title=solo&&final?(wins>=3?'THE WEEKEND<br>IS YOURS.':'A GRUDGE<br>WELL PLAYED.'):last?.win?'NICE<br>SHOOTING.':'NEXT TIME,<br>TIGER.';const sub=solo&&final?\"'`${wins} / 4 heats won. ${wins>=3?'\"'Your Golden Ricochet is in the post.':'The rematch is already personal.'}\"'`:LEVELS[state.heat].tag;\n    const scores=state.tanks.map(t=>({...t,shown:solo&&final?(state.total[t.id]||0):t.score})).sort((a,b)=>b.shown-a.shown);const stats=state.stats||{};\n    this.show('\"'results',panel(solo&&final?'CIRCUIT COMPLETE':\"'`HEAT ${state.heat+1} / COMPLETE`,title,sub,`${solo&&final?'\"'<div class=\\\"result-banner\\\">✦ ✦ ✦</div>':''}<div class=\\\"result-scores\\\">\"'${scores.map(t=>`<div class=\"result-score\" style=\"--player:${esc(t.color)}\"><span>${esc(t.name)}</span><span class=\"value\">${t.shown} <small>PTS</small></span></div>`).join('\"'')}</div>\"'${solo?`<div class=\"result-stats\"><span><strong>${stats.knockouts||0}</strong>KNOCKOUTS</span><span><strong>${stats.banks||0}</strong>RICOCHETS</span><span><strong>${stats.pickups||0}</strong>PICKUPS</span><span><strong>${stats.boosts||0}</strong>BOOSTS</span></div>`:'\"''}<div class=\\\"menu-stack\\\">\"'${guest?'\"'<p class=\\\"link-help\\\">Waiting for the host to call a rematch.</p>':btn(solo&&\"'!final?'\"'continue':'rematch',solo&&\"'!final?'\"'Next heat →':'One more round?')}\"'${btn('\"'quit','Back to title')}</div>\"'`));}\n  link(){this.linkRole='\"'host';this.linkOut='';this.linkReply='';this.linkMenu();}\n  linkMenu(){const host=this.linkRole==='host';this.show('link',panel('DIRECT LINK / TWO DEVICES','CALL IN A RIVAL.','No account. No lobby server. Just a good old-fashioned exchange.',\"'`<div class=\"link-tabs\">${textbtn('\"'linkHost','I’m hosting')}\"'${textbtn('\"'linkJoin','I’m joining')}</div><p class=\\\"link-help\\\">\"'${host?'\"'1. Create an invitation and send it to your friend.<br>2. Paste their reply below. The duel starts when you connect.':'1. Paste your friend’s invitation below.<br>2. Generate a reply and send it back. Keep this screen open.'}</p><label class=\\\"link-label\\\" for=\\\"link-in\\\">\"'${host?'\"'YOUR FRIEND’S REPLY':'HOST’S INVITATION'}</label><textarea id=\\\"link-in\\\" class=\\\"link-code\\\" placeholder=\\\"Paste the complete COMBRISK: code here\\\" aria-label=\\\"\"'${host?'\"'Friend reply code':'Host invitation code'}\\\" spellcheck=\\\"false\\\"></textarea><div class=\\\"settings-actions\\\">\"'${textbtn(host?'\"'createOffer':'createAnswer',host?'1. Create invitation':'Generate reply')}\"'${host?textbtn('\"'acceptAnswer','2. Connect with reply'):''}</div><label class=\\\"link-label\\\" for=\\\"link-out\\\">\"'${host?'\"'YOUR INVITATION':'YOUR REPLY'}</label><textarea id=\\\"link-out\\\" class=\\\"link-code\\\" readonly aria-label=\\\"Code to share\\\" spellcheck=\\\"false\\\">\"'${esc(this.linkOut)}</textarea><div class=\"settings-actions\">${textbtn('\"'copyCode','Copy code')}</div><p id=\\\"link-status\\\" class=\\\"link-error\\\" role=\\\"status\\\"></p><p class=\\\"link-help\\\">Direct peer-to-peer connections. Some networks require a relay; no relay is provided. AI Hub handles its own network when launched from a session.</p>\"'${back('\"'Versus','versus')}\"'`));}\n  linkStatus(text,error=false){const e=$('\"'link-status');if(e){e.textContent=text;e.style.color=error?'var(--coral)':'var(--teal)';}}\n  waiting(msg='Waiting for the other pilot…'){this.show('waiting',panel('LINK ESTABLISHED','STAND BY.',msg,btn('quit','Return to title')));}\n  hideHud(){for(const id of ['hud','bottom-hud','pause-button','round-intro'])\"'$(id).hidden=true;$('\"'announce').textContent='';\"'$('\"'dev-badge').textContent='';}\n  toast(text){\"'$('\"'toast').textContent=text;this.toastUntil=performance.now()+3000;}\n  announce(text){\"'$('\"'announce').textContent=text;this.announceUntil=performance.now()+1800;}\n  touchSticks(touches){for(const id of ['touch-left','touch-right'])\"'$(id).style.display='\"'none';\"'$('\"'touch-boost').style.display='none';if(this.name\"'!=='\"'game')return;for(const t of touches.values()){const e=\"'$(t.right?'\"'touch-right':'touch-left');e.style.display='block';e.style.left=t.sx+'px';e.style.top=t.sy+'px';const dx=t.x-t.sx,dz=t.y-t.sy,l=Math.hypot(dx,dz),f=l>55?55/l:1;e.firstChild.style.transform=\"'`translate(${dx*f}px,${dz*f}px)`;if(t.right){const b=$('\"'touch-boost');b.style.display='block';b.style.left=Math.min(innerWidth-55,t.sx+65)+'px';b.style.top=Math.max(70,t.sy-90)+'px';}}}\n  update(state,dt,attract=false,game=null){\n    const now=performance.now();if(now>this.toastUntil)\"'$('\"'toast').textContent='';if(now>this.announceUntil)\"'$('\"'announce').textContent='';if(this.name==='title'&&this.input.device\"'!==this.lastDevice){const e=$('\"'title-prompts');if(e)e.innerHTML=this.menuPrompts();}this.lastDevice=this.input.device;\n    if(this.name\"'!=='\"'game'&&\"'!attract)return;this.hudTick+=dt;if(this.hudTick<.09)return;this.hudTick=0;\n    $('\"'hud').hidden=false;\"'$('\"'bottom-hud').hidden=false;\"'$('\"'pause-button').hidden=attract;\n    const left=state.tanks.filter(t=>t.id<2),right=state.tanks.filter(t=>t.id>=2);const card=t=>\"'`<div class=\"score-card\" style=\"--player:${esc(t.color)}\"><div class=\"who\">${esc(t.name)}${t.local?'\"' ◂':''}</div><div class=\\\"score\\\">\"'${t.score}<small>/ ${state.target}</small>${!t.alive?`<small>↺ ${Math.ceil(t.respawn)}</small>`:'\"''}</div><div class=\\\"armor\\\">\"'${[0,1,2].map(i=>`<i class=\"${i>=t.hp?'\"'empty':''}\\\"></i>\"'`).join('\"'')}</div></div>\"'`;let sides=state.tanks.length===2?[[state.tanks[0]],[state.tanks[1]]]:[left,right];\n    const sec=Math.max(0,Math.ceil(state.timer)),tm=`${Math.floor(sec/60)}:${String(sec%60).padStart(2,'\"'0')}\"'`;$('\"'hud').innerHTML=\"'`<div class=\"score-side\">${sides[0].map(card).join('\"'')}</div><div class=\\\"clock\\\"><div class=\\\"time \"'${sec<15?'\"'hurry':''}\\\">\"'${tm}</div><small>${state.mode==='\"'solo'?\"'`HEAT ${state.heat+1} / 4`:state.vehicle==='\"'plane'?'AIR DUEL':'TANK DUEL'}</small></div><div class=\\\"score-side right\\\">\"'${sides[1].map(card).join('\"'')}</div>\"'`;\n    const level=LEVELS[state.heat],local=state.tanks.find(t=>t.local)||state.tanks[0];const status=local?.rapid>0?`RAPID FIRE · ${Math.ceil(local.rapid)}s`:local?.shield?'\"'SHIELD READY':level.rule;\n    \"'$('\"'bottom-hud').innerHTML=\"'`<div class=\"objective\"><small>${level.name}</small>${esc(status)}</div><div class=\"controls-bar\"><span>${this.glyph('\"'move')} \"'${state.vehicle==='\"'plane'?'Steer':'Move'}</span><span>\"'${this.glyph('\"'aim')} Aim</span><span>\"'${this.glyph('\"'fire')} Fire</span><span>\"'${this.glyph('\"'boost')} Boost <span class=\\\"boost-meter\\\"><i style=\\\"width:\"'${100*(1-Math.min(1,(local?.boostCd||0)/3.8))}%\"></i></span></span></div>`;\n    const intro=$('\"'round-intro');intro.hidden=state.countdown<=0;if(state.countdown>0)intro.innerHTML=\"'`<span class=\"heat-num\">${state.mode==='\"'solo'?\"'`CIRCUIT / HEAT 0${state.heat+1}`:'\"'FIELD BRIEFING'}</span><strong>\"'${level.name}</strong><p>${level.tip}</p><div class=\"count\">${Math.ceil(state.countdown)}</div>`;\n    if(game){const c=game.cheats;const marks=[c.invincible?'\"'INVINCIBLE':'',c.aiPaused?'AI FROZEN':'',c.slowmo\"'!==1?'\"'SLOW MOTION':'',c.colliders?'PHYSICS VIEW':''].filter(Boolean);\"'$('\"'dev-badge').textContent=marks.length?'DEV · '+marks.join(' / '):'';}\n  }\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cat > src/main.js <<'EOF'\nimport {Game,LEVELS,ZERO,RAPIER} from './game.js';\nimport {View,T} from './view.js';\nimport {Input} from './input.js';\nimport {Sound} from './audio.js';\nimport {Network} from './network.js';\nimport {UI} from './ui.js';\nconst BASE_SETTINGS={master:.75,music:.1,sfx:.65,glyphs:'playstation',guide:true,shake:true,best:0};\nlet saved={};try{saved=JSON.parse(localStorage.getItem('combrisk-v1')||'{}');}catch{}\nconst settings={...BASE_SETTINGS,...saved};const canvas=document.getElementById('scene');\nconst input=new Input(canvas),sound=new Sound(),game=new Game(),net=new Network(),ui=new UI(input,settings);let view=null,loaded=false,attract=false,hubStarted=false,menuStack=[],lastPhase='',resultKey='',suppressUntil=0,debugLines=null,realClock=0,frameCount=0;\nconst persist=()=>{try{localStorage.setItem('combrisk-v1',JSON.stringify(settings));}catch{}sound.volumes(settings);};\nfunction resume(){menuStack=[];game.paused=false;ui.clear();lastPhase='';}\nfunction show(name,push=true){if(push)menuStack.push(ui.name);game.paused=\"'!net.active;switch(name){case'\"'title':title();break;case'pause':ui.pause(game.snapshot(),net.active);break;case'versus':ui.versus();break;case'settings':ui.settingsMenu();break;case'how':ui.how();break;case'about':ui.about();break;case'dev':ui.dev(game);break;case'link':ui.link();break;}}\nfunction back(){if(ui.name==='title')return;if(ui.name==='pause'){resume();return;}const previous=menuStack.pop()||'title';if(previous==='game')resume();else show(previous,false);}\nfunction title(){if(net.hub)return;attract=false;net.close(true);game.cheats={invincible:false,aiPaused:false,colliders:false,slowmo:1};game.start('title',0);game.paused=false;ui.title();input.menu=true;menuStack=[];resultKey='';lastPhase='';input.lastInput=performance.now();document.getElementById('attract').hidden=true;document.getElementById('touch-boost').style.display='none';}\nfunction start(mode='solo'){attract=false;net.close(true);game.cheats={invincible:false,aiPaused:false,colliders:false,slowmo:1};game.start(mode,mode==='solo'?0:ui.selectedHeat);ui.clear();menuStack=[];resultKey='';lastPhase='playing';sound.voice('go');}\nfunction exitAttract(){if(\"'!attract)return;title();suppressUntil=performance.now()+300;}\nfunction pause(){if(!loaded||net.ended||performance.now()<suppressUntil)return;if(attract){exitAttract();return;}if(ui.name==='\"'game'){menuStack=[];show('pause');}else if(ui.name\"'!=='\"'title')back();}\ninput.onActivity=()=>{if(loaded){if(attract)exitAttract();sound.wake().then(()=>sound.volumes(settings)).catch(()=>{});}};\ninput.onPause=pause;input.onBack=back;input.onConfirm=()=>{if(performance.now()>suppressUntil&&input.menu)ui.confirm();};input.onMenu=(x,y)=>ui.navigate(x,y);input.onTouch=t=>ui.touchSticks(t);\nui.onSetting=(key,value)=>{settings[key]=value;persist();};ui.onTune=(key,value)=>{game.tuning[key]=value;if(key==='roundTime')game.timer=Math.min(game.timer,value);};\nui.onAction=async(action,button)=>{\n  if(\"'!loaded||net.ended||performance.now()<suppressUntil)return;sound.wake().then(()=>sound.volumes(settings)).catch(()=>{});sound.play('\"'click');input.lastInput=performance.now();\n  try{switch(action){\n    case'solo':start('solo');break;case'local':start('local');break;case'resume':resume();break;case'pause':pause();break;case'back':back();break;\n    case'versus':case'settings':case'how':case'about':case'dev':case'link':show(action);break;\n    case'arena':ui.selectedHeat=(ui.selectedHeat+1)%4;ui.versus();break;\n    case'quit':title();break;\n    case'continue':game.nextHeat();resume();break;\n    case'rematch':if(net.active&&net.kind==='host'){game.start('link',ui.selectedHeat);ui.clear();resultKey='';}else start(game.mode==='solo'?'solo':'local');break;\n    case'glyphs':settings.glyphs=settings.glyphs==='xbox'?'playstation':'xbox';persist();ui.settingsMenu();break;\n    case'guide':settings.guide=\"'!settings.guide;persist();ui.settingsMenu();break;\n    case'\"'shake':settings.shake=\"'!settings.shake;persist();ui.settingsMenu();break;\n    case'\"'resetSettings':Object.assign(settings,BASE_SETTINGS);persist();ui.settingsMenu();ui.toast('Settings restored. Music: 10%.');break;\n    case'fullscreen':if(\"'!document.fullscreenElement)await document.documentElement.requestFullscreen?.();else await document.exitFullscreen?.();break;\n    case'\"'god':game.cheats.invincible=\"'!game.cheats.invincible;ui.dev(game);break;case'\"'freezeAI':game.cheats.aiPaused=\"'!game.cheats.aiPaused;ui.dev(game);break;case'\"'colliders':game.cheats.colliders=\"'!game.cheats.colliders;ui.dev(game);break;case'\"'slowmo':game.cheats.slowmo=game.cheats.slowmo===1?.35:1;ui.dev(game);break;\n    case'repair':case'pickups':game.dev(action);ui.toast(action==='repair'?'Armour restored. Shield on.':'All three pickups are on the field.');break;\n    case'next':case'restart':game.dev(action);game.paused=true;ui.dev(game);break;\n    case'resetTune':game.resetTuning();ui.dev(game);ui.toast('Default balance restored.');break;\n    case'linkHost':net.close(true);ui.linkRole='host';ui.linkOut='';ui.linkMenu();break;case'linkJoin':net.close(true);ui.linkRole='guest';ui.linkOut='';ui.linkMenu();break;\n    case'createOffer':{button.disabled=true;ui.linkStatus('Gathering the invitation…');const code=await net.hostOffer();ui.linkOut=code;document.getElementById('link-out').value=code;ui.linkStatus('Invitation ready. Send it to your friend.');button.disabled=false;break;}\n    case'createAnswer':{const code=document.getElementById('link-in').value;if(\"'!code)throw Error('\"'Paste a host invitation first.');button.disabled=true;ui.linkStatus('Preparing your reply…');const reply=await net.joinOffer(code);ui.linkOut=reply;const out=document.getElementById('link-out');if(out)out.value=reply;ui.linkStatus('Reply ready. Send it back to the host, then wait here.');button.disabled=false;break;}\n    case'acceptAnswer':await net.acceptAnswer(document.getElementById('link-in').value);ui.linkStatus('Connecting the pilots…');break;\n    case'copyCode':{const code=document.getElementById('link-out').value;if(\"'!code)throw Error('\"'Generate a code first.');try{await navigator.clipboard.writeText(code);ui.linkStatus('Code copied.');}catch{document.getElementById('link-out').select();ui.linkStatus('Code selected. Use Ctrl+C to copy.');}break;}\n  }}catch(e){if(button)button.disabled=false;if(ui.name==='link')ui.linkStatus(e.message,true);else ui.toast(e.message||String(e));}\n};\nnet.onInput=(seat,data)=>{const t=game.tanks.find(t=>t.seat===seat&&t.human);if(t)game.input(t.id,data);};\nnet.onSnapshot=s=>{game.applyRemote(s,net.hub?net.info.me:1);if(ui.name==='waiting')ui.clear();};\nnet.onConnected=role=>{if(role==='host'){game.start('link',ui.selectedHeat);game.tanks[0].name='HOST';game.tanks[1].name='RIVAL';ui.clear();resultKey='';}else{ui.waiting('The host is setting the angles.');}menuStack=[];sound.play('pickup');};\nnet.onDisconnect=msg=>{if(\"'!net.hub&&loaded){game.paused=true;ui.waiting(msg);ui.toast(msg);}};\nnet.onStart=()=>{hubStarted=true;game.paused=false;ui.clear();game.countdown=Math.max(0,-window.AIHub.time()/1000);};\nnet.onTimeUp=()=>net.finish(game.snapshot());\nnet.onLeave=id=>{net.leftPlayer(id);const t=game.tanks.find(t=>t.seat===id);if(t){t.human=false;t.local=false;}if(net.kind==='\"'host')ui.toast('A pilot left. The field carries on.');};\nnet.onEnd=()=>{game.paused=true;game.phase='ended';input.blocked=true;input.clear();sound.mute(true);ui.screen.innerHTML='';ui.name='ended';input.menu=false;document.getElementById('round-intro').hidden=true;};\ngame.onEvent=e=>{\n  if(\"'!loaded&&e.type!=='\"'stage')return;if(e.type==='stage')return;\n  if(e.type==='dust'){view?.fx('dust',e.x,e.z,e.color,e.extra);return;}\n  if(['shot','bounce','hit','boom','crate','pickup','boost'].includes(e.type)){view?.fx(e.type,e.x,e.z,e.color,e.extra);sound.play(e.type==='crate'?'hit':e.type);}\n  if(['tick','go','win','lose'].includes(e.type))sound.play(e.type);\n  if(e.type==='boom'&&\"'!attract){const state=game.snapshot(),shooter=state.tanks.find(t=>t.id===e.extra.owner);ui.announce(`${e.extra.bank?'\"'BANK SHOT\"'!'\"':'KNOCKOUT\"'!'\"'} \"'${shooter?.name||'\"''} +\"'${e.extra.points||1}`);if(shooter?.local){const pad=input.pads[0];try{pad?.vibrationActuator?.playEffect('\"'dual-rumble',{duration:130,strongMagnitude:.35,weakMagnitude:.6})?.catch(()=>{});}catch{}}}\n  if(e.type==='pickup'&&e.extra.type){const state=game.snapshot();if(state.tanks.find(t=>t.id===e.extra.id)?.local)ui.announce(e.extra.type==='repair'?'PATCHED UP.':e.extra.type==='shield'?'SHIELD ON.':'RAPID FIRE\"'!'\"');}\n};\nfunction aimInput(data,t){if(data.mouse&&t&&view){const p=view.mouseWorld(input.mouse);data.ax=p.x-t.x;data.az=p.z-t.z;const len=Math.hypot(data.ax,data.az);if(len>.1){data.ax/=len;data.az/=len;data.aim=true;}}return data;}\nfunction gatherInputs(){if(net.hub&&net.info?.server)return ZERO();const state=game.snapshot();const me=net.hub?net.info?.me:net.kind==='guest'?1:0;const local=state.tanks.find(t=>t.seat===me)||state.tanks[0];const data=aimInput(input.read(0,game.mode==='local'),local);if(\"'!game.remote&&local?.human)game.input(local.id,data);if(game.mode==='\"'local')game.input(1,input.read(1,true));return data;}\nfunction fixedStep(dt){if(net.hub&&\"'!hubStarted)return;if(net.kind==='\"'guest'&&net.active)return;game.step(dt);}\nfunction debugPhysics(){if(\"'!view)return;if(!game.cheats.colliders||!game.world){if(debugLines)debugLines.visible=false;return;}const d=game.world.debugRender();if(!debugLines){debugLines=new T.LineSegments(new T.BufferGeometry(),new T.LineBasicMaterial({vertexColors:true,depthTest:false,transparent:true,opacity:.8}));debugLines.renderOrder=999;view.scene.add(debugLines);}debugLines.visible=true;debugLines.geometry.dispose();debugLines.geometry=new T.BufferGeometry();debugLines.geometry.setAttribute('\"'position',new T.BufferAttribute(d.vertices,3));debugLines.geometry.setAttribute('color',new T.BufferAttribute(d.colors,4));}\nlet previous=0,accumulator=0;\nfunction frame(ms){\n  if(\"'!loaded)return;const dt=Math.min(.1,previous?(ms-previous)/1000:1/60);previous=ms;realClock+=dt;frameCount++;\n  input.poll();\n  if(ui.name==='\"'title'&&performance.now()-input.lastInput>=10000){attract=true;game.start('attract',0);ui.clear();ui.name='attract';input.menu=true;document.getElementById('attract').hidden=false;}\n  const data=gatherInputs();accumulator+=dt;let steps=0;while(accumulator>=1/60&&steps++<8){fixedStep(1/60);accumulator-=1/60;}\n  const state=game.snapshot();\n  if(net.active)net.update(dt,data,()=>game.snapshot());\n  if(net.hub&&hubStarted&&net.kind==='host'&&game.finished)net.finish(state);\n  if(\"'!net.hub&&state.phase==='\"'results'&&\"'!attract){const key=state.serial+'\"':'+state.heat;if(resultKey\"'!==key){resultKey=key;if(state.mode==='\"'solo'&&state.finished){settings.best=Math.max(settings.best,state.heatWins);persist();}ui.results(state,net.active&&net.kind==='guest');menuStack=[];}}\n  view.sync(state,dt);const local=state.tanks.find(t=>t.local);const paths=ui.name==='game'&&settings.guide&&\"'!game.remote&&local?game.aimPath(game.tanks.find(t=>t.id===local.id)):[];const target=ui.name==='\"'game'&&input.device==='keyboard'&&input.mouse.active?view.mouseWorld(input.mouse):null;view.aimPath(paths,target,state.vehicle==='plane');\n  if(\"'!settings.shake)view.shake=0;view.update(dt,ui.name==='\"'title');debugPhysics();view.render();ui.update(state,dt,attract,game);sound.update(ui.name==='game'||attract);requestAnimationFrame(frame);\n}\nasync function init(){\n  const infoPromise=net.initHub();view=new View(canvas);game.onStage=(level,obstacles)=>{view.arena(level,obstacles);};await game.init();const info=await infoPromise;\n  if(net.hub&&info){game.start('hub',0,info.players);for(const t of game.tanks)t.local=t.seat===info.me;game.paused=true;ui.clear();}\n  else {game.start('title',0);ui.title();}\n  view.sync(game.snapshot(),0);document.getElementById('boot-status').textContent='Laying the ink. Loading the battlefield.';await view.init();loaded=true;window.COMBRISK.ready=true;document.getElementById('boot').remove();persist();net.ready();requestAnimationFrame(frame);\n}\nwindow.COMBRISK={ready:false,game,input,ui,net,sound,settings,get view(){return view;},get backend(){return view?.backend||'unknown';},get frameCount(){return frameCount;},get attract(){return attract;},snapshot:()=>game.snapshot(),start:(m='solo',h=0)=>{ui.selectedHeat=h;start(m);},advance:(seconds)=>{const steps=Math.ceil(seconds*60);for(let i=0;i<steps;i++)fixedStep(1/60);return game.snapshot();},command:(a)=>game.dev(a),pause,resume,title,exitAttract,version:'1.0.0'};\ninit().catch(e=>{console.error(e);document.getElementById('boot-status').textContent='The engines could not start. '+(e.message||String(e))+' Try a browser with WebGPU or WebGL 2 support.';const b=document.createElement('button');b.textContent='Try again';b.onclick=()=>location.reload();document.getElementById('boot').append(b);if(net.hub)window.AIHub.fail('Combrisk could not initialise: '+e.message);window.COMBRISK.error=e.message;});\nEOF\ncat > build.mjs <<'EOF'\nimport {build} from 'esbuild';\nimport fs from 'node:fs';\nconst {stem}=JSON.parse(fs.readFileSync('title-selection.json','utf8'));\nconst metadata=fs.readFileSync('../exit-interview.json','utf8');JSON.parse(metadata);\nconst out=await build({entryPoints:['src/main.js'],bundle:true,write:false,format:'iife',target:['es2022'],minify:true,legalComments:'inline',define:{__CREDITS__:metadata},logLevel:'silent'});\nlet html=fs.readFileSync('src/template.html','utf8');const escapeScript=s=>s.replaceAll('</script','<\\\\\\\\/script');\nhtml=html.replace('<\"'!--HUB_CLIENT-->'\"','<script>'+escapeScript(fs.readFileSync('reference/session.js','utf8'))+'</script>').replace('/*GAME_CSS*/',fs.readFileSync('src/style.css','utf8')).replace('/*GAME_JS*/',escapeScript(out.outputFiles[0].text));\nfs.writeFileSync('../'+stem+'.html',html);fs.writeFileSync('artifacts/build-info.json',JSON.stringify({file:stem+'.html',bytes:Buffer.byteLength(html),three:'0.180.0',rapier:'0.19.3',selfContained:true},null,2)+'\\\\n');console.log(\"'`Built ${stem}.html (${(Buffer.byteLength(html)/1048576).toFixed(2)} MiB)`);\nEOF\nnode --input-type=module <<'\"'JS'\nimport fs from 'node:fs';\nconst data={sourceInformation:{date:'2026-11-05 19:13:18',source:'Combat (1977)',plan:'none',genre:'Arcade vehicular arena shooter; ricochet duels and dogfighting',perspective:'Elevated orthographic three-dimensional view',tech:'Three.js r180 (0.180.0), WebGPURenderer with WebGPU primary and WebGL 2 fallback; Rapier 0.19.3; native Gamepad API; Web Audio API; WebRTC; AI Hub Session Protocol v1 client 1.4.0; esbuild 0.25.11',artDirection:'Stylized cel-shaded paper-and-ink tabletop diorama; procedural low-poly tanks and biplanes, warm sand, teal shadows, ink outlines',animation:'Three.js AnimationMixer and AnimationClip keyframe tracks for tank rumble, cannon recoil, propellers, and barrel rolls; procedural movement and particles',audio:'Code-generated Web Audio chiptune march, synthesized sound effects and Animalese-style gibberish; music defaults to 10%',online:'Host-authoritative AI Hub shared-world sessions for 1–4 players; standalone two-player WebRTC direct-link duel with manual invitation/reply; two-player couch versus',testing:'Headless Chromium with software WebGPU; scripted gameplay, physics, campaign, menus, controller stub, touch profiles, audio analyser, two-page WebRTC, and supplied AI Hub conformance harness; visual screenshots for composition',research:'none; native model knowledge only. Supplied AI Hub integration files fetched as implementation requirements; no internet searches.',environment:'Codex CLI (headless); Linux',model:'OpenAI, gpt-6.1-sol, reasoning effort max',usa