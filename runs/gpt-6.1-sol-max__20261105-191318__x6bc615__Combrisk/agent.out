{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"mkdir -p artifacts/browser-tmp\ncat > tests/smoke.py <<'PY'\nimport json\nfrom pathlib import Path\nfrom playwright.sync_api import sync_playwright\n\nroot=Path(__file__).resolve().parents[1]\nmeta=json.loads((root/'title-selection.json').read_text())\nerrors=[]\nwith sync_playwright() as p:\n    browser=p.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n    page=browser.new_page(viewport={'width':1920,'height':1080},device_scale_factor=1)\n    page.on('pageerror',lambda e:errors.append(str(e)))\n    page.on('console',lambda m:errors.append('console: '+m.text) if m.type=='error' else None)\n    page.goto((root.parent/(meta['stem']+'.html')).as_uri())\n    try:page.wait_for_function('window.COMBRISK?.ready || window.COMBRISK?.error',timeout=90000)\n    except Exception as e:errors.append(str(e))\n    print(json.dumps({'ready':page.evaluate('window.COMBRISK?.ready'),'error':page.evaluate('window.COMBRISK?.error'),'backend':page.evaluate('window.COMBRISK?.backend'),'boot':page.locator('#boot').inner_text() if page.locator('#boot').count() else None,'errors':errors},indent=2))\n    page.screenshot(path=str(root/'artifacts/title.png'))\n    if page.evaluate('window.COMBRISK?.ready'):\n        page.get_by_role('button',name='Play the circuit').click()\n        page.wait_for_timeout(1500)\n        print(json.dumps(page.evaluate('({state:COMBRISK.snapshot(),frames:COMBRISK.frameCount,ui:COMBRISK.ui.name})'),indent=2)[:12000])\n        page.screenshot(path=str(root/'artifacts/play.png'))\n        print(json.dumps({'errors':errors},indent=2))\n    browser.close()\nPY\nTMPDIR=\\\"\"'$PWD/artifacts/browser-tmp\" /home/micha/.local/share/pipx/venvs/playwright/bin/python tests/smoke.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
