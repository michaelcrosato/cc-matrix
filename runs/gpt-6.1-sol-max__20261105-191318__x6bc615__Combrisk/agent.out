(net.settings, {\n    latency: Math.max(0, Number($('latency').value) || 0),\n    jitter: Math.max(0, Number($('jitter').value) || 0),\n    loss: Math.min(0.5, Math.max(0, (Number($('loss').value) || 0) / 100)),\n  });\n}\n\n/** Wrap what a game must not call in hub mode, where the page can reach it. */\nfunction instrument(cell) {\n  try {\n-rw-r--r-- 1 micha micha 3.2M Nov  5 19:32 ../Combrisk-Combat-1977-gpt-6.1-sol-max-20261105-191318.html\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat > tests/check.py <<'PY'\n\\\"\\\"\\\"One command: npm test. Prints failures and one count; artifacts stay here.\\\"\\\"\\\"\nfrom __future__ import annotations\nimport functools\nimport http.server\nimport json\nimport os\nfrom pathlib import Path\nimport threading\nimport time\nimport urllib.parse\nimport urllib.request\nfrom playwright.sync_api import sync_playwright\n\nROOT=Path(__file__).resolve().parents[1]\nSTEM=json.loads((ROOT/'title-selection.json').read_text())['stem']\nGAME=ROOT.parent/(STEM+'.html')\nART=ROOT/'artifacts'\nos.environ['TMPDIR']=str(ART/'browser-tmp')\n(ART/'browser-tmp').mkdir(exist_ok=True)\nchecks=[]\nfailures=[]\nreports={}\n\ndef check(name,condition,detail=''):\n    checks.append(name)\n    if not condition:\n        failures.append({'test':name,'detail':str(detail)})\n        print('FAIL '+name+(': '+str(detail) if detail else ''),flush=True)\n\ndef guarded(name,fn):\n    try:fn()\n    except Exception as error:check(name,False,str(error))\n\ndef wait_ready(page):\n    page.wait_for_function('window.COMBRISK?.ready || window.COMBRISK?.error',timeout=90000)\n    assert page.evaluate('COMBRISK.ready'),page.evaluate('COMBRISK.error')\n\ndef load(page,url):\n    page.goto(url,wait_until='load')\n    wait_ready(page)\n\ndef js(page,source):return page.evaluate(source)\n\n# A safe, known, empty lane. All bullets still use the actual Rapier ray queries.\nSETUP=\\\"\\\"\\\"(heat=0)=>{\nconst c=COMBRISK,g=c.game;g.start('solo',heat);c.ui.clear();g.cheats.aiPaused=true;g.countdown=0;\nfor(const t of g.tanks){t.invuln=0;t.reveal=2;t.reload=0;t.body.setLinvel({x:0,y:0,z:0},true);}\nconst a=g.tanks[0],b=g.tanks[1];\nfor(const [t,x,z] of [[a,-14,-9],[b,-8,-9]]){t.x=x;t.z=z;t.body.setTranslation({x,y:.7,z},true);t.aim=-Math.PI/2;t.angle=t.aim;}\nfor(const t of g.tanks.slice(2)){t.x=14;t.z=9;t.body.setTranslation({x:14,y:.7,z:9},true);}\ng.world.step();g.inputs.clear();return true;\n}\\\"\\\"\\\"\n\nclass QuietHandler(http.server.SimpleHTTPRequestHandler):\n    def log_message(self,*args):pass\n\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(QuietHandler,directory=str(ROOT.parent)))\nthread=threading.Thread(target=server.serve_forever,daemon=True)\nthread.start()\nBASE='http://127.0.0.1:'+str(server.server_address[1])\nURL=BASE+'/'+urllib.parse.quote(GAME.name)\n\ntry:\n    html=GAME.read_text()\n    check('single HTML has no external asset dependency','https://cdn' not in html and 'type=\\\"module\\\" src=' not in html)\n    check('Hub client is embedded unmodified',(ROOT/'reference/session.js').read_text() in html)\n    metadata=json.loads((ROOT.parent/'exit-interview.json').read_text())\n    check('exit interview schema',set(metadata)=={'sourceInformation','testingFeedback','engineFeedback','promptFeedback','aiHub'} and len(metadata['testingFeedback'])==4 and len(metadata['engineFeedback'])==6 and len(metadata['promptFeedback'])==4)\n    check('server returns this game','<title>Combrisk' in urllib.request.urlopen(URL).read().decode())\n    with sync_playwright() as pw:\n        # Native WebGPU runtime. No canvas screenshot: SwiftShader readback can lose the device.\n        browser=pw.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader'])\n        page=browser.new_page(viewport={'width':1280,'height':720})\n        gpu_errors=[]\n        page.on('pageerror',lambda e:gpu_errors.append(str(e)))\n        def gpu_test():\n            load(page,GAME.as_uri())\n            check('WebGPU initialises from file URL',js(page,'COMBRISK.backend')=='WebGPU')\n            js(page,'COMBRISK.start();COMBRISK.game.countdown=0')\n            page.keyboard.down('KeyD')\n            page.wait_for_function('COMBRISK.snapshot().tanks[0].x > -12.5',timeout=10000)\n            page.keyboard.up('KeyD')\n            check('WebGPU gameplay advances',js(page,'COMBRISK.snapshot().tanks[0].x')>-12.5)\n            check('WebGPU runtime has no JS errors',not gpu_errors,gpu_errors)\n        guarded('WebGPU runtime',gpu_test)\n        browser.close()\n\n        browser=pw.chromium.launch(headless=True,args=['--enable-unsafe-swiftshader','--use-angle=swiftshader'])\n        context=browser.new_context(viewport={'width':1600,'height':900},device_scale_factor=1)\n        context.add_init_script(\\\"\\\"\\\"window.__pad=null;Object.defineProperty(navigator,'getGamepads',{value:()=>window.__pad?[window.__pad]:[]});\\\"\\\"\\\")\n        page=context.new_page()\n        errors=[]\n        page.on('pageerror',lambda e:errors.append(str(e)))\n        page.on('console',lambda m:errors.append(m.text) if m.type=='error' else None)\n        load(page,URL+'?renderer=webgl')\n        check('fallback initialises',js(page,'COMBRISK.backend')=='WebGL 2')\n        check('music defaults to ten percent',js(page,'COMBRISK.settings.music')==.1)\n        check('title is controller focusable',page.locator('[data-action=solo]').evaluate('(e)=>e===document.activeElement'))\n        serial=js(page,'COMBRISK.snapshot().serial')\n        page.keyboard.press('Enter')\n        page.wait_for_function(\\\"COMBRISK.ui.name==='game'\\\")\n        check('Enter launches once',js(page,'COMBRISK.snapshot().serial')==serial+1)\n        js(page,'COMBRISK.game.countdown=0;COMBRISK.game.cheats.aiPaused=true')\n        x=js(page,'COMBRISK.snapshot().tanks[0].x')\n        page.keyboard.down('KeyD')\n        page.wait_for_function('(x)=>COMBRISK.snapshot().tanks[0].x>x+.5',arg=x,timeout=10000)\n        page.keyboard.up('KeyD')\n        check('keyboard movement moves a tank',js(page,'COMBRISK.snapshot().tanks[0].x')>x+.5)\n        page.mouse.move(1100,320)\n        page.mouse.down()\n        page.wait_for_function('COMBRISK.snapshot().stats.shots>0',timeout=5000)\n        page.mouse.up()\n        check('mouse aim and fire',js(page,'COMBRISK.snapshot().stats.shots')>0)\n        page.keyboard.press('ShiftLeft')\n        page.wait_for_function('COMBRISK.snapshot().stats.boosts>0',timeout=5000)\n        check('keyboard boost',js(page,'COMBRISK.snapshot().tanks[0].boostCd')>0)\n\n        def physics_tests():\n            js(page,SETUP)\n            result=js(page,\\\"\\\"\\\"()=>{const g=COMBRISK.game,t=g.tanks[0];t.x=17;t.z=0;t.body.setTranslation({x:17,y:.7,z:0},true);g.input(0,{x:1,z:0});COMBRISK.advance(1);return t.x;}\\\"\\\"\\\")\n            check('Rapier walls contain tanks',16<result<17.5,result)\n            js(page,SETUP)\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game,t=g.tanks[0];t.x=14;t.z=5;t.body.setTranslation({x:14,y:.7,z:5},true);t.aim=-Math.PI/2;g.world.step();g.fire(t);c.advance(.22);return g.bullets.map(b=>({banks:b.banks,vx:b.vx}));}\\\"\\\"\\\")\n            check('shell reflects from wall',any(b['banks']==1 and b['vx']<0 for b in result),result)\n            js(page,SETUP)\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game,t=g.tanks[0];t.x=15;t.z=5;t.body.setTranslation({x:15,y:.7,z:5},true);t.aim=-Math.PI/2;g.world.step();g.fire(t);c.advance(.6);return t.hp;}\\\"\\\"\\\")\n            check('own ricochet can damage player',result==2,result)\n            js(page,SETUP)\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game,t=g.tanks[0];t.x=-4;t.z=0;t.body.setTranslation({x:-4,y:.7,z:0},true);t.aim=-Math.PI/2;g.world.step();for(let i=0;i<2;i++){g.fire(t);c.advance(.3);}return g.destroyed;}\\\"\\\"\\\")\n            check('cover breaks after two real impacts',len(result)==1,result)\n            js(page,SETUP)\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game,a=g.tanks[0],b=g.tanks[1];for(let i=0;i<3;i++){g.fire(a);c.advance(.5);}const killed=\"'!b.alive&&a.score===1;c.advance(2.3);return {killed,alive:b.alive,hp:b.hp,invuln:b.invuln};}\"\"\")\n            check('\"'three hits score a knockout',result['killed'],result)\n            check('knocked-out tank respawns protected',result['alive'] and result['hp']==3 and result['invuln']>0,result)\n            js(page,SETUP)\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game,a=g.tanks[0];a.hp=2;g.addPickup('repair',a.x,a.z);c.advance(.02);const repaired=a.hp===3;g.addPickup('shield',a.x,a.z);c.advance(.02);const shield=a.shield;g.addPickup('rapid',a.x,a.z);c.advance(.02);a.reload=0;g.fire(a);const rapid=a.rapid>7&&a.reload<g.tuning.reload*.5;const b=g.tanks[1];b.aim=Math.PI/2;b.reload=0;g.fire(b);c.advance(.5);return {repaired,shield,rapid,absorbed:\"'!a.shield&&a.hp===3};}\"\"\")\n            for name,key in [('\"'repair pickup heals','repaired'),('shield pickup grants protection','shield'),('rapid pickup reduces reload','rapid'),('shield absorbs a real shell','absorbed')]:check(name,result[key],result)\n            # Ghost concealment is a view concern, not just a state flag.\n            js(page,SETUP.replace('(heat=0)','(heat=2)'))\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game;g.tanks.forEach(t=>{t.invuln=0;t.reveal=0});c.view.sync(g.snapshot(),.1);return {enemyHidden:\"'!c.view.tanks.get(1).root.visible,selfVisible:c.view.tanks.get(0).root.visible};}\"\"\")\n            check('\"'ghosts hide opponents but preserve local visibility',result['enemyHidden'] and result['selfVisible'],result)\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game,b=g.tanks[1];g.fire(b);c.view.sync(g.snapshot(),.02);return b.reveal>0&&c.view.tanks.get(1).root.visible;}\\\"\\\"\\\")\n            check('firing reveals ghost tank',result)\n            js(page,SETUP.replace('(heat=0)','(heat=1)'))\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game,a=g.tanks[0],b=g.tanks[1];for(const [t,x,z]of[[a,14,8],[b,10,8]]){t.x=x;t.z=z;t.body.setTranslation({x,y:.7,z},true);}b.hp=1;a.aim=-Math.PI/2;g.world.step();g.fire(a);c.advance(.8);return {score:a.score,dead:\"'!b.alive,banks:g.stats.banks};}\"\"\")\n            check('\"'bank-shot knockout scores double',result['score']==2 and result['dead'] and result['banks']>0,result)\n            js(page,SETUP.replace('(heat=0)','(heat=3)'))\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game,a=g.tanks[0];a.x=17.8;a.z=-5;a.aim=-Math.PI/2;a.body.setTranslation({x:17.8,y:.7,z:-5},true);g.input(0,{x:1,z:0,boost:true});c.advance(.4);return {x:a.x,boost:a.boostCd};}\\\"\\\"\\\")\n            check('aircraft wraps across field edge',result['x']<0,result)\n            check('aircraft roll ability recharges',result['boost']>0,result)\n            result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game,a=g.tanks[0];a.x=16;a.z=0;a.aim=-Math.PI/2;a.body.setTranslation({x:16,y:.7,z:0},true);g.input(0,{x:0,z:0});g.fire(a);c.advance(.15);return g.bullets.some(b=>b.wraps===1&&b.x<0);}\\\"\\\"\\\")\n            check('aircraft shell wraps once',result)\n        guarded('physics and combat group',physics_tests)\n\n        def campaign():\n            js(page,\\\"COMBRISK.start();COMBRISK.game.tuning.target=1;COMBRISK.game.cheats.aiPaused=true\\\")\n            for heat in range(4):\n                result=js(page,\\\"\\\"\\\"()=>{const c=COMBRISK,g=c.game;g.countdown=0;g.cheats.aiPaused=true;const a=g.tanks[0],b=g.tanks[1];for(const [t,x,z]of[[a,-14,-9],[b,-8,-9]]){t.x=x;t.z=z;t.body.setTranslation({x,y:.7,z},true);t.body.setLinvel({x:0,y:0,z:0},true);t.invuln=0;t.aim=-Math.PI/2;t.hp=3;t.reveal=2;}for(const t of g.tanks.slice(2)){t.invuln=50;t.body.setTranslation({x:14,y:.7,z:8},true);}g.world.step();g.input(0,{x:0,z:0});for(let i=0;i<8&&g.phase\"'!=='\"'results';i++){g.fire(a);c.advance(.48);}return {heat:g.heat,phase:g.phase,score:a.score,enemyHP:b.hp};}\\\"\\\"\\\")\n                check('scripted circuit heat '+str(heat+1),result['heat']==heat and result['phase']=='results' and result['score']>=1,result)\n                page.wait_for_function(\\\"COMBRISK.ui.name==='results'\\\",timeout=10000)\n                if heat<3:page.locator('[data-action=continue]').click()\n            s=js(page,'COMBRISK.snapshot()')\n            check('complete circuit has four results',s['finished'] and len(s['results'])==4 and s['heatWins']==4,s['results'])\n            check('campaign finale is reachable','THE WEEKEND' in page.locator('#screen').inner_text())\n            page.locator('[data-action=rematch]').click()\n            check('circuit rematch resets progression',js(page,'COMBRISK.snapshot().heat===0&&\"'!COMBRISK.snapshot().finished&&COMBRISK.snapshot().results.length===0'\"'))\n        guarded('full campaign playthrough',campaign)\n\n        def menu_tests():\n            page.keyboard.press('Escape')\n            page.locator('[data-action=dev]').click()\n            check('dev mode is reachable from pause',js(page,\\\"COMBRISK.ui.name==='dev'\\\"))\n            page.locator('input[data-tune=speed]').evaluate(\\\"e=>{e.value=7.2;e.dispatchEvent(new Event('input',{bubbles:true}))}\\\")\n            check('live tuning changes simulation',abs(js(page,'COMBRISK.game.tuning.speed')-7.2)<.01)\n            page.locator('[data-action=resetTune]').click()\n            check('balance resets to defaults',js(page,'COMBRISK.game.tuning.speed===5.2&&COMBRISK.game.tuning.target===5'))\n            page.locator('[data-action=god]').click()\n            check('invincibility toggle works',js(page,'COMBRISK.game.cheats.invincible'))\n            page.locator('[data-action=next]').click()\n            check('dev heat skip reaches next map',js(page,'COMBRISK.game.heat')==1)\n            page.locator('[data-action=resume]').click()\n            page.keyboard.press('Escape')\n            page.locator('[data-action=settings]').click()\n            page.locator('[data-action=glyphs]').click()\n            check('Xbox glyph preference switches',js(page,\\\"COMBRISK.settings.glyphs==='xbox'\\\"))\n            page.locator('[data-action=back]').click()\n            page.locator('[data-action=about]').click()\n            text=page.locator('#screen').inner_text()\n            check('credits include required feedback',all(s in text for s in ['Source Information','Testing Feedback','Engine Feedback','Prompt Feedback','added on import']))\n            page.keyboard.press('Escape')\n            page.locator('[data-action=quit]').click()\n            # Menu-pad test, then movement and firing with a standard-mapped virtual pad.\n            js(page,\\\"window.__pad={index:0,id:'Virtual standard pad',connected:true,mapping:'standard',axes:[0,0,0,0],buttons:Array.from({length:17},()=>({pressed:false,value:0,touched:false}))};__pad.buttons[0]={pressed:true,value:1}\\\")\n            page.wait_for_function(\\\"COMBRISK.ui.name==='game'\\\",timeout=10000)\n            js(page,'__pad.buttons[0]={pressed:false,value:0};COMBRISK.game.countdown=0;COMBRISK.game.cheats.aiPaused=true')\n            before=js(page,'COMBRISK.snapshot().tanks[0].x')\n            js(page,'__pad.axes=[1,0,0,-1];__pad.buttons[7]={pressed:true,value:1}')\n            page.wait_for_function('(x)=>COMBRISK.snapshot().tanks[0].x>x+.5&&COMBRISK.snapshot().stats.shots>0',arg=before,timeout=12000)\n            check('virtual pad moves aims and fires',js(page,'COMBRISK.input.device')=='pad' and js(page,'COMBRISK.snapshot().tanks[0].x')>before+.5)\n            check('Xbox prompts follow active controller','RT' in page.locator('#bottom-hud').inner_text())\n            js(page,'window.__pad=null;COMBRISK.title();COMBRISK.input.lastInput=performance.now()-11000')\n            page.wait_for_function('COMBRISK.attract',timeout=10000)\n            check('ten-second attract mode starts',js(page,'COMBRISK.snapshot().mode')=='attract')\n            result=js(page,'COMBRISK.advance(21).heat')\n            check('attract mode tours different mechanics',result==1,result)\n            page.keyboard.press('Enter')\n            check('any input exits attract without starting a game',js(page,\\\"\"'!COMBRISK.attract&&COMBRISK.ui.name==='\"'title'\\\"))\n        guarded('menus controller and attract group',menu_tests)\n\n        def audio_test():\n            page.locator('[data-action=settings]').click()\n            result=js(page,\\\"\\\"\\\"async()=>{const s=COMBRISK.sound;await s.wake();s.play('boom');s.voice('go');s.update(true);return {state:s.ctx.state,music:s.musicBus.gain.value,voices:s.history.filter(v=>v.type==='sawtooth').length,scheduled:s.history.length};}\\\"\\\"\\\")\n            time.sleep(.025)\n            levels=js(page,'COMBRISK.sound.levels()')\n            check('audio graph runs at configured music volume',result['state']=='running' and abs(result['music']-.1)<.001,result)\n            check('procedural sound produces an audible signal',levels['peak']>.0001,levels)\n            check('gibberish voices are synthesised',result['voices']>0 and result['scheduled']>5,result)\n        guarded('audio group',audio_test)\n        check('standalone has no runtime errors',not errors,errors[:6])\n        context.close()\n\n        def touch_test():\n            phone=browser.new_context(viewport={'width':390,'height':844},device_scale_factor=1,is_mobile=True,has_touch=True)\n            p=phone.new_page();load(p,URL+'?renderer=webgl')\n            boxes=p.locator('#screen button').evaluate_all('(es)=>es.map(e=>{let r=e.getBoundingClientRect();return{x:r.x,y:r.y,w:r.width,h:r.height}})')\n            check('phone title buttons remain on screen',all(b['x']>=0 and b['x']+b['w']<=391 and b['y']+b['h']<=845 for b in boxes),boxes)\n            p.locator('[data-action=solo]').tap()\n            js(p,'COMBRISK.game.countdown=0;COMBRISK.game.cheats.aiPaused=true')\n            session=phone.new_cdp_session(p)\n            session.send('Input.dispatchTouchEvent',{'type':'touchStart','touchPoints':[{'x':70,'y':650,'id':0},{'x':310,'y':650,'id':1}]})\n            session.send('Input.dispatchTouchEvent',{'type':'touchMove','touchPoints':[{'x':120,'y':610,'id':0},{'x':315,'y':600,'id':1}]})\n            p.wait_for_function('COMBRISK.snapshot().stats.shots>0',timeout=10000)\n            check('multitouch invisible sticks move and fire',js(p,'COMBRISK.input.touch.size===2&&COMBRISK.input.device===\\\"touch\\\"&&COMBRISK.snapshot().tanks[0].x> -13'))\n            check('touch boost appears at contact',p.locator('#touch-boost').is_visible())\n            session.send('Input.dispatchTouchEvent',{'type':'touchEnd','touchPoints':[]})\n            check('touch UI clears on release',js(p,'COMBRISK.input.touch.size')==0)\n            phone.close()\n        guarded('touch group',touch_test)\n\n        def standalone_link():\n            c=browser.new_context(viewport={'width':900,'height':650})\n            a=c.new_page();b=c.new_page()\n            load(a,URL+'?renderer=webgl');load(b,URL+'?renderer=webgl')\n            offer=js(a,'COMBRISK.net.hostOffer()')\n            answer=b.evaluate('(o)=>COMBRISK.net.joinOffer(o)',offer)\n            a.evaluate('(r)=>COMBRISK.net.acceptAnswer(r)',answer)\n            a.wait_for_function('COMBRISK.net.active',timeout=20000);b.wait_for_function('COMBRISK.net.active&&COMBRISK.game.remote',timeout=20000)\n            js(a,'COMBRISK.game.countdown=0')\n            b.keyboard.down('KeyA')\n            a.wait_for_function('COMBRISK.snapshot().tanks[1].x<12.4',timeout=12000)\n            b.keyboard.up('KeyA')\n            check('standalone WebRTC remote input reaches host',js(a,'COMBRISK.snapshot().tanks[1].x')<12.4)\n            b.wait_for_function('COMBRISK.snapshot().tanks[1].x<12.4',timeout=10000)\n            check('standalone host state reaches guest',js(b,'COMBRISK.net.received>2&&COMBRISK.game.remote'))\n            b.close();a.wait_for_function('\"'!COMBRISK.net.active'\"',timeout=12000)\n            check('standalone peer departure is handled',js(a,\\\"COMBRISK.ui.name==='waiting'\\\"))\n            c.close()\n        guarded('standalone multiplayer group',standalone_link)\n\n        def hub_scenario(players,scenario='standard',rough=False):\n            c=browser.new_context(viewport={'width':1280,'height':850})\n            p=c.new_page()\n            params={'game':'../../'+GAME.name+'?renderer=webgl','players':str(players),'auto':'1','play':'3500','limit':'45','scenario':scenario}\n            if rough:params.update({'latency':'150','jitter':'50','loss':'5'})\n            harness=BASE+'/'+ROOT.name+'/reference/harness.html?'+urllib.parse.urlencode(params)\n            p.goto(harness)\n            p.wait_for_function('window.__hubCheck?.done',timeout=110000)\n            report=js(p,'window.__hubCheck')\n            reports[f'hub-{players}-{scenario}']=report\n            bad=[v for v in report['checks'] if not v['pass']]\n            check(f'AI Hub {players} players / {scenario}'+(' / latency and loss' if rough else ''),report['pass'],bad)\n            c.close()\n        for players,scenario,rough in [(2,'standard',False),(4,'standard',True),(4,'host-leave',True),(2,'server',False)]:\n            guarded(f'Hub scenario {players}/{scenario}',lambda n=players,s=scenario,r=rough:hub_scenario(n,s,r))\n        browser.close()\nfinally:\n    server.shutdown();server.server_close()\n    result={'checks':len(checks),'passed':len(checks)-len(failures),'failures':failures,'reports':reports}\n    (ART/'test-results.json').write_text(json.dumps(result,indent=2)+'\\\\n')\n    print(f'{len(checks)-len(failures)}/{len(checks)} checks passed; {len(failures)} failures',flush=True)\nraise SystemExit(1 if failures else 0)\nPY\nTMPDIR=\\\"\"'$PWD/artifacts/browser-tmp\" /home/micha/.local/share/pipx/venvs/playwright/bin/python tests/check.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"agent_message","text":"The broader checks are running through combat, the circuit, controls, audio, and multiplayer. Some failures came from the test setup selecting the wrong arena; I’ve also reproduced a rendering error during repeated arena changes and a stalled controller test. I’m checking those before the final pass."}}
