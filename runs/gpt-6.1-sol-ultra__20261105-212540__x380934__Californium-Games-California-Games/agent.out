{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'nl -ba Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/main.js'","aggregated_output":"     1\timport * as THREE from 'three';\n     2\timport RAPIER from 'https://esm.sh/@dimforge/rapier3d-compat@0.19.3';\n     3\timport {createArt} from './art.js';\n     4\timport {AudioSystem} from './audio.js';\n     5\timport {FestivalNetwork} from './network.js';\n     6\t\n     7\tconst $=id=>document.getElementById(id), TAU=Math.PI*2, clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\n     8\tconst esc=s=>String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n     9\tconst EVENTS=[{id:'skate',name:'HALF-PIPE HEAT',short:'Half-pipe',tag:'Concrete. Courage. Questionable shorts.',goal:'Pump the bowl. Pop at the lip. Bring it home.',guide:[['MOVE','Build speed through the bowl. Hold down to pump.'],['POP','Jump near a high wall for the biggest air.'],['STYLE','Grab or flip in the air. Release to level out.']],gold:3500,silver:1800,bronze:650},{id:'surf',name:'SALTWATER SWING',short:'Surfing',tag:'The forecast calls for absolutely tubular.',goal:'Follow the golden pocket. Carve, pop, repeat.',guide:[['CARVE','Steer left and right to follow the golden wave pocket.'],['SCORE','Stay in the pocket to earn flow points. Grab for a cutback.'],['AIR','Pop off the wave, then grab or flip. Watch the red buoy.']],gold:4200,silver:2200,bronze:800},{id:'bmx',name:'BOARDWALK BMX',short:'BMX',tag:'Two wheels. Zero sensible decisions.',goal:'Pedal the ramps. Clear the cones. Land your style.',guide:[['PEDAL','Hold right to sprint. Left slows you down.'],['POP','Jump at the ramp lip; jump over orange cones.'],['STYLE','Tailwhip or barspin in the air. Release before landing.']],gold:3500,silver:1800,bronze:650}];\n    10\tconst DEFAULTS={speed:1,gravity:18,jump:8,assist:.78,duration:60,timeScale:1};\n    11\tlet config={...DEFAULTS},audio=new AudioSystem(),world,body,art,renderer,ready=false;\n    12\tlet state={screen:'loading',event:'skate',eventIndex:0,time:0,elapsed:0,airborne:false,speed:0,trick:'',crashed:false,total:0,score:0,pending:0,mult:1,rotation:0,combo:[],bestCombo:0,bails:0,landings:0,flow:0,started:false};\n    13\tlet currentPlayer=0,playerCount=1,players=[],practice=false,attract=false,lastInput=performance.now(),inputKind='keyboard',glyphs='ps',soundOn=true,reduceMotion=false,bot=false,infinite=false,hubInfo=null,hubEnded=false,hubResult=false,hubStarting=false,network=null,networkScores=[],onlineWaiting=false;\n    14\tlet eventElapsed=0,crashTime=0,lastGround=true,airTime=0,lastTrick=-9,dir=1,pipeSpeed=9,targetX=0,flowClock=0,foamClock=0,toastTime=0,scoreFlash=0,lastRender=0,lastNetwork=0,lookOffset=0;\n    15\tconst keys=new Set(),pressed=new Set(),padPrev=[],touch={active:false,x:0,y:0,startX:0,startY:0,moveX:0,moveY:0},stats={frames:0,physicsSteps:0,errors:[],bailReasons:[]};\n    16\tlet best={};try{best=JSON.parse(localStorage.getItem('californium-best')||'{}')}catch{}\n    17\tfunction persist(){if(!AIHub.active)try{localStorage.setItem('californium-best',JSON.stringify(best))}catch{}}\n    18\tfunction isPlay(){return state.screen==='playing'}\n    19\tfunction noteInput(kind='keyboard'){inputKind=kind;lastInput=performance.now();if(attract){attract=false;bot=false;showTitle();return true}updatePrompts();audio.unlock();return false}\n    20\tfunction label(action){const maps={keyboard:{pop:'SPACE',grab:'J',flip:'K',pause:'ESC',move:'A D / ← →',pump:'S / ↓',accept:'ENTER'},ps:{pop:'✕',grab:'□',flip:'○',pause:'OPTIONS',move:'L STICK',pump:'L STICK ↓',accept:'✕'},xbox:{pop:'A',grab:'X',flip:'B',pause:'MENU',move:'L STICK',pump:'L STICK ↓',accept:'A'},touch:{pop:'TAP',grab:'AUTO',flip:'AUTO',pause:'Ⅱ',move:'DRAG',pump:'ASSIST',accept:'TAP'}};return maps[inputKind==='gamepad'?glyphs:inputKind]?.[action]||action}\n    21\tfunction updatePrompts(){document.querySelectorAll('[data-key]').forEach(e=>e.textContent=label(e.dataset.key));document.body.dataset.input=inputKind;$('touch-pop').textContent='POP';}\n    22\tfunction toast(text,kind=''){ $('toast').textContent=text;$('toast').className='toast visible '+kind;toastTime=3; }\n    23\tfunction visiblePanel(id){document.querySelectorAll('.panel').forEach(e=>e.hidden=e.id!==id);$('overlay').hidden=!id;$('hud').hidden=!isPlay();$('attract').hidden=!attract;focusFirst();}\n    24\tfunction focusFirst(){requestAnimationFrame(()=>{const a=[...document.querySelectorAll('.panel:not([hidden]) button,.panel:not([hidden]) input')].find(e=>!e.disabled);a?.focus({preventScroll:true})})}\n    25\tfunction setScreen(s,p){state.screen=s;visiblePanel(p);updatePrompts()}\n    26\tfunction showTitle(){state.screen='title';attract=false;state.crashed=false;art?.setEvent('skate');state.event='skate';if(body){body.setTranslation({x:-2,y:1,z:0},true);body.setLinvel({x:0,y:0,z:0},true)}$('title-best').textContent=best.festival?`PERSONAL BEST  ${best.festival.toLocaleString()}`:'THREE EVENTS. ONE GOLDEN COAST.';setScreen('title','title-panel');lastInput=performance.now();}\n    27\tfunction makePlayers(){players=Array.from({length:playerCount},(_,i)=>({name:network?.connected?`RIDER ${network.me+1}`:`RIDER ${i+1}`,scores:[0,0,0],total:0}));currentPlayer=0;}\n    28\tfunction beginFestival(single=-1){if(AIHub.active&&!hubStarting)return;practice=single>=0;makePlayers();state.eventIndex=single>=0?single:0;showBrief();}\n    29\tfunction showBrief(){const e=EVENTS[state.eventIndex];state.event=e.id;art.setEvent(e.id);$('brief-num').textContent=`${practice?'FREE SESSION':`EVENT ${state.eventIndex+1} / 3`}  ·  ${players[currentPlayer].name}`;$('brief-title').textContent=e.name;$('brief-tag').textContent=e.tag;$('brief-goal').textContent=e.goal;$('brief-guide').innerHTML=e.guide.map(([a,b],i)=>`<div class=\"guide-row\"><b>0${i+1}</b><div><strong>${a}</strong><p>${b}</p></div></div>`).join('');$('brief-medals').textContent=`BRONZE ${e.bronze}   /   SILVER ${e.silver}   /   GOLD ${e.gold}`;setScreen('brief','brief-panel');}\n    30\tfunction height(x,id=state.event){if(id==='skate'){const a=Math.max(0,Math.abs(x)-4);return 4*(a/8)**2}if(id==='bmx'){for(const c of [-9,3,15])if(x>=c-3&&x<=c)return (x-(c-3))/3*3;return 0}return .4+.5*Math.sin(x*.22+state.elapsed*1.8)}\n    31\tfunction buildPhysics(){if(world)world.free();world=new RAPIER.World({x:0,y:-config.gravity,z:0});world.timestep=1/60;body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(-5,3,0).lockRotations().enabledTranslations(true,true,false).setLinearDamping(.03).setCcdEnabled(true));world.createCollider(RAPIER.ColliderDesc.ball(.38).setFriction(.02).setRestitution(0),body);if(state.event!=='surf'){for(let x=-20;x<20;x+=.4){const h1=height(x),h2=height(x+.4),a=Math.atan2(h2-h1,.4),length=Math.hypot(.4,h2-h1);if(Math.abs(h2-h1)>1)continue;const ground=world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x+.2,(h1+h2)/2-.12,0).setRotation({x:0,y:0,z:Math.sin(a/2),w:Math.cos(a/2)}));world.createCollider(RAPIER.ColliderDesc.cuboid(length/2,.12,4).setFriction(0),ground)}}}\n    32\tfunction startEvent(){eventElapsed=0;state.time=config.duration;state.elapsed=0;state.score=0;state.pending=0;state.mult=1;state.rotation=0;state.combo=[];state.trick='';state.crashed=false;state.airborne=false;state.flow=0;crashTime=0;pipeSpeed=9;dir=1;flowClock=0;foamClock=0;lastTrick=-9;airTime=0;lastGround=true;state.started=true;state.bestCombo=0;state.bails=0;state.landings=0;buildPhysics();const x=state.event==='skate'?-6:state.event==='bmx'?-17:0;body.setTranslation({x,y:height(x)+.42,z:0},true);body.setLinvel({x:0,y:0,z:0},true);art.setEvent(state.event);setScreen('playing',null);audio.resume();audio.voice('start');toast(state.event==='surf'?'CHASE THE GOLDEN POCKET':'GET RAD. LAND CLEAN.');}\n    33\tfunction medal(score,e=EVENTS[state.eventIndex]){return score>=e.gold?'GOLD':score>=e.silver?'SILVER':score>=e.bronze?'BRONZE':'SUN-SEEKER'}\n    34\tfunction bank(){if(!state.pending)return;let pts=Math.round(state.pending*state.mult);state.score+=pts;state.bestCombo=Math.max(state.bestCombo,pts);state.landings++;toast(`${state.combo.join(' + ')}   +${pts.toLocaleString()}`,'good');audio.sfx('land');audio.sfx('score');if(pts>700)audio.voice('rad');state.pending=0;state.combo=[];state.mult=clamp(state.mult+1,1,8);scoreFlash=.4;publish();}\n    35\tfunction bail(reason){if(attract||bot||inputKind==='touch'){state.rotation=0;bank();return}state.bails++;state.pending=0;state.combo=[];state.mult=1;state.crashed=true;crashTime=1.25;state.rotation=0;stats.bailReasons.push(reason);toast(reason+' · BACK ON IN A BEAT','bad');audio.sfx('bail');audio.voice('bail');}\n    36\tfunction trick(kind){if(state.crashed||state.elapsed-lastTrick<.32)return;if(!state.airborne){if(state.event==='surf'&&kind==='grab'&&state.elapsed-lastTrick>1){lastTrick=state.elapsed;state.score+=90;toast('CUTBACK  +90');audio.sfx('score');publish()}return}lastTrick=state.elapsed;const name=state.event==='bmx'?(kind==='grab'?'TAILWHIP':'BARSPIN'):state.event==='surf'?(kind==='grab'?'MELON AIR':'REVERSE AIR'):(kind==='grab'?'METHOD GRAB':'KICKFLIP');const repeat=state.combo.includes(name);state.pending+=repeat?65:kind==='grab'?180:280;state.combo.push(name);state.trick=kind;state.rotation+=kind==='flip'?TAU:Math.PI*.18;audio.sfx('score');$('trick-call').textContent=name;scoreFlash=.3;}\n    37\tfunction jump(){if(!lastGround||state.crashed)return;let v=body.linvel(),bonus=state.event==='skate'?Math.max(0,(Math.abs(body.translation().x)-6)*.5):0;body.setLinvel({x:v.x,y:config.jump+bonus,z:0},true);body.setTranslation({x:body.translation().x,y:body.translation().y+.12,z:0},true);state.airborne=true;lastGround=false;airTime=0;audio.sfx('jump');}\n    38\tfunction publish(){const total=players[currentPlayer]?.total||0;const score=total+state.score;if(AIHub.active&&!hubEnded&&!hubResult)AIHub.progress({score,label:`${EVENTS[state.eventIndex].short} · ${medal(state.score)}`});if(network?.connected)network.sendScore({event:state.eventIndex,score:state.score,total:score,finished:false});}\n    39\tfunction finishEvent(){bank();const p=players[currentPlayer],e=EVENTS[state.eventIndex];p.scores[state.eventIndex]=state.score;p.total=p.scores.reduce((a,b)=>a+b,0);best[e.id]=Math.max(best[e.id]||0,state.score);persist();audio.sfx('finish');$('result-eyebrow').textContent=`${p.name}  /  ${e.short.toUpperCase()}`;$('result-medal').textContent=medal(state.score);$('result-score').textContent=state.score.toLocaleString();$('result-copy').textContent=medal(state.score)==='GOLD'?'That coast is officially toast.':`Next medal: ${state.score<e.bronze?e.bronze:state.score<e.silver?e.silver:e.gold} points. Keep the good times rolling.`;$('result-detail').textContent=`BEST COMBO ${state.bestCombo}  ·  CLEAN LANDINGS ${state.landings}  ·  WIPEOUTS ${state.bails}`;$('result-next').textContent=practice?'RIDE AGAIN':currentPlayer+1<playerCount?'NEXT RIDER':state.eventIndex<2?'NEXT EVENT':'FESTIVAL RESULTS';setScreen('event-result','result-panel');if(attract){setTimeout(()=>{if(attract)advance()},1500)}else if(AIHub.active||network?.connected){setTimeout(()=>{if(state.screen==='event-result'&&!hubEnded)advance()},3500)}}\n    40\tfunction advance(){if(practice){startEvent();return}if(currentPlayer+1<playerCount){currentPlayer++;showBrief()}else if(state.eventIndex<2){currentPlayer=0;state.eventIndex++;state.event=EVENTS[state.eventIndex].id;showBrief()}else{finishFestival();return}if(attract||AIHub.active||network?.connected)startEvent();}\n    41\tfunction finishFestival(){best.festival=Math.max(best.festival||0,...players.map(p=>p.total));persist();$('podium-list').innerHTML=[...players].sort((a,b)=>b.total-a.total).map((p,i)=>`<div class=\"standing\"><span>0${i+1}</span><strong>${esc(p.name)}</strong><b>${p.total.toLocaleString()}</b></div>`).join('');$('festival-copy').textContent=players[0].total