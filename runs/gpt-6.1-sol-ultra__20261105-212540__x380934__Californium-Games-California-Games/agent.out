ion({x:0,y:3,z:0},true)}\n}\nfunction updateHUD(){const e=EVENTS[state.eventIndex];\"'$('\"'hud-event').textContent=e.short.toUpperCase();\"'$('\"'hud-count').textContent=practice?'FREE SESSION':\"'`EVENT ${state.eventIndex+1} / 3`;const score=state.score.toLocaleString();if($('\"'hud-score').textContent\"'!==score)$('\"'hud-score').textContent=score;\"'$('\"'hud-time').textContent=Math.ceil(state.time).toString().padStart(2,'0');\"'$('\"'hud-time').classList.toggle('urgent',state.time<10);\"'$('\"'combo').hidden=\"'!state.pending;$('\"'combo-points').textContent=\"'`${state.pending} × ${state.mult}`;$('\"'combo-name').textContent=state.combo.slice(-2).join(' + ');\"'$('\"'flow-meter').style.width=\"'`${state.event==='\"'surf'?state.flow*100:clamp(Math.abs(state.speed)/16,0,1)*100}%\"'`;$('\"'flow-label').textContent=state.event==='surf'?'WAVE FLOW':'MOMENTUM';\"'$('\"'medal-label').textContent=medal(state.score);\"'$('\"'medal-progress').style.width=\"'`${Math.min(100,state.score/e.gold*100)}%`;$('\"'hud-rider').textContent=network?.connected?\"'`ONLINE  ·  RIDER ${network.me+1}`:players[currentPlayer]?.name||'\"'RIDER 1';\"'$('\"'live-standings').hidden=\"'!network?.connected;if(network?.connected)$('\"'live-standings').textContent=networkScores.map(p=>\"'`R${p.seat+1}  ${p.total||0}`).join('\"'   /   ');\"'$('\"'touch-pop').hidden=inputKind\"'!=='\"'touch'||\"'!isPlay()||!lastGround;}\nlet marker,buoy;\nfunction makeMarkers(){marker=new THREE.Mesh(new THREE.TorusGeometry(1.1,.07,8,40),new THREE.MeshBasicMaterial({color:0xffd34f}));art.scene.add(marker);buoy=new THREE.Group();const m=new THREE.Mesh(new THREE.ConeGeometry(.5,1.3,10),new THREE.MeshStandardMaterial({color:0xe7503d,flatShading:true}));m.position.y=.4;buoy.add(m);art.scene.add(buoy)}\nfunction visual(dt){let p=body?.translation()||{x:-2,y:1,z:0};if(state.screen==='\"'title'||state.screen==='loading'){p={x:-3,y:.5,z:0};state.speed=0;state.airborne=false}art.athlete.position.set(p.x,p.y-.38,p.z);let slope=state.event==='skate'?Math.atan(Math.sign(p.x)*Math.max(0,Math.abs(p.x)-4)/8):state.event==='bmx'&&[-9,3,15].some(c=>p.x>=c-3&&p.x<=c)?Math.atan(2.2/3):0;art.athlete.rotation.z=state.crashed?-1.4:state.airborne?state.rotation: slope;art.athlete.scale.x=state.event==='skate'?dir:1;art.update(dt,{...state,time:state.elapsed,paused:\"'!isPlay()});marker.visible=buoy.visible=state.event==='\"'surf'&&isPlay();if(marker.visible){marker.position.set(targetX,height(targetX)+1.6,0);marker.rotation.y=Math.sin(state.elapsed)*.25;buoy.position.set(-Math.sin(state.elapsed*.37+1.2)*11,height(-Math.sin(state.elapsed*.37+1.2)*11),0)}if(\"'!reduceMotion)art.camera.position.x+=lookOffset*.02;}\nfunction loop(t){if(!ready)return;const dt=Math.min(.05,(t-lastRender)/1000||.016);lastRender=t;stats.frames++;const pad=readPad();if(hubStarting&&AIHub.time()>=0){hubStarting=false;practice=false;playerCount=1;makePlayers();state.eventIndex=0;state.event='\"'skate';startEvent()}\nif(state.screen==='title'&&\"'!AIHub.active&&performance.now()-lastInput>10000){attract=true;bot=true;playerCount=1;practice=false;makePlayers();state.eventIndex=0;state.event='\"'skate';startEvent();\"'$('\"'attract').hidden=false;toast('THE COAST IS CLEAR. PRESS ANYTHING TO PLAY.')}\nif(isPlay()&&\"'!hubEnded){let remain=dt*config.timeScale;while(remain>0&&isPlay()){const fixed=Math.min(1/60,remain);step(fixed,pad);remain-=fixed}updateHUD();if(t-lastNetwork>900){publish();lastNetwork=t}}\nvisual(dt);audio.update(dt,{...state,playing:isPlay(),attract});if(toastTime>0){toastTime-=dt;if(toastTime<=0)$('\"'toast').classList.remove('visible')}if(scoreFlash>0){scoreFlash-=dt;\"'$('\"'trick-call').style.opacity=scoreFlash>0?'1':'0'}if(state.screen==='dev')\"'$('\"'dev-stats').textContent=\"'`RAPIER ${stats.physicsSteps} steps · ${stats.frames} frames · ${state.event} · x ${body.translation().x.toFixed(2)} / y ${body.translation().y.toFixed(2)} · ${state.airborne?'\"'AIR':'GROUND'}\"'`;pressed.clear();renderer.render(art.scene,art.camera);}\nfunction buttons(){const actions={start:()=>{playerCount=1;beginFestival()},hotseat:()=>{playerCount=playerCount%4+1;if(playerCount<2)playerCount=2;$('\"'hotseat').textContent=\"'`COUCH CREW  ·  ${playerCount} RIDERS`},'\"'start-hotseat':()=>{if(playerCount<2)playerCount=2;beginFestival()},practice:()=>openPanel('practice'),settings:()=>openPanel('settings'),about:()=>{fillAbout();openPanel('about')},online:()=>openPanel('online'),'brief-go':startEvent,'brief-back':back,'result-next':advance,'festival-again':()=>{if(\"'!AIHub.active){beginFestival()}},'\"'festival-home':()=>{if(\"'!AIHub.active)showTitle()},resume:pause,'\"'pause-settings':()=>openPanel('settings'),'pause-dev':()=>{renderDev();openPanel('dev')},'pause-about':()=>{fillAbout();openPanel('about')},'pause-quit':()=>{if(\"'!AIHub.active&&!network?.running){state.started=false;audio.resume();showTitle()}},'\"'dev-restart':startEvent,'dev-next':()=>{state.eventIndex=(state.eventIndex+1)%3;state.event=EVENTS[state.eventIndex].id;startEvent()},'dev-bank':()=>{state.score+=1000;toast('DEV: +1000');publish()},'dev-reset':()=>{config={...DEFAULTS};renderDev()},'dev-bot':()=>{bot=\"'!bot;$('\"'dev-bot').textContent=\"'`AUTO RIDER: ${bot?'\"'ON':'OFF'}\"'`},'\"'dev-infinite':()=>{infinite=\"'!infinite;$('\"'dev-infinite').textContent=\"'`INFINITE TIME: ${infinite?'\"'ON':'OFF'}\"'`},'\"'touch-menu':pause,'touch-pop':()=>pressed.add('Space'),'online-create':()=>onlineAction('create'),'online-join':()=>onlineAction('join'),'online-start':()=>network?.startFestival(),'online-leave':()=>{network?.disconnect();networkScores=[];\"'$('\"'online-status').textContent='ROOM CLOSED';\"'$('\"'online-start').hidden=true},'settings-back':back,'about-back':back,'dev-back':back,'online-back':back,'practice-back':back};Object.entries(actions).forEach(([id,fn])=>\"'$(id)?.addEventListener('\"'click',()=>{audio.unlock();audio.sfx('click');fn()}));document.querySelectorAll('[data-event]').forEach(b=>b.onclick=()=>{playerCount=1;beginFestival(+b.dataset.event)});\"'$('\"'music').oninput=e=>{audio.setMusic(+e.target.value);\"'$('\"'music-value').textContent=Math.round(e.target.value*100)+'%'};\"'$('\"'effects').oninput=e=>{audio.setEffects(+e.target.value);\"'$('\"'effects-value').textContent=Math.round(e.target.value*100)+'%'};\"'$('\"'glyphs').onclick=()=>{glyphs=glyphs==='ps'?'xbox':'ps';\"'$('\"'glyphs').textContent=\"'`CONTROLLER GLYPHS: ${glyphs==='\"'ps'?'PLAYSTATION':'XBOX'}\"'`;updatePrompts()};$('\"'motion').onclick=()=>{reduceMotion=\"'!reduceMotion;$('\"'motion').textContent=\"'`CAMERA MOTION: ${reduceMotion?'\"'REDUCED':'FULL'}\"'`};$('\"'fullscreen').onclick=()=>{if(\"'!document.fullscreenElement)document.documentElement.requestFullscreen?.().catch(()=>toast('\"'FULLSCREEN IS UNAVAILABLE HERE'));else document.exitFullscreen?.()};}\nfunction renderDev(){const defs=[['speed','Ride speed',.4,2,.05],['gravity','Gravity',6,30,.5],['jump','Pop strength',4,15,.25],['assist','Landing assist',0,1,.05],['duration','Heat length (next heat)',15,180,5],['timeScale','Simulation speed',.25,2,.05]];\"'$('\"'dev-sliders').innerHTML=defs.map(([id,name,min,max,step])=>\"'`<label>${name}<output id=\"v-${id}\">${config[id]}</output><input data-config=\"${id}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${config[id]}\"></label>`).join('\"'');document.querySelectorAll('[data-config]').forEach(el=>el.oninput=()=>{config[el.dataset.config]=+el.value;\"'$('\"'v-'+el.dataset.config).textContent=el.value})}\nasync function onlineAction(which){try{if(\"'!network)network=new FestivalNetwork({onStatus:(s,snap)=>{$('\"'online-status').textContent=s;\"'$('\"'online-room').textContent=snap?.room?\"'`ROOM ${snap.room}`:'\"'';\"'$('\"'online-start').hidden=\"'!snap?.isHost||!snap?.connected;},onScores:s=>{networkScores=s;$('\"'online-riders').textContent=s.map(p=>\"'`RIDER ${p.seat+1}: ${p.total||0}`).join('\"'  /  ')},onStart:p=>{onlineWaiting=true;\"'$('\"'online-status').textContent='WAX UP. STARTING IN 3…';setTimeout(()=>{onlineWaiting=false;playerCount=1;practice=false;makePlayers();state.eventIndex=0;state.event='skate';startEvent()},Math.max(0,p.startAt-Date.now()))}});if(which==='create')await network.createRoom();else await network.joinRoom(\"'$('\"'room-code').value.trim().toUpperCase())}catch(e){\"'$('\"'online-status').textContent=e.message;}}\nasync function boot(){buttons();updatePrompts();try{await RAPIER.init();art=createArt();renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.setClearColor(0xf9d9ac);renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;\"'$('\"'view').appendChild(renderer.domElement);await renderer.init();\"'$('\"'engine-tag').textContent=\"'`THREE r180 · ${renderer.backend.isWebGPUBackend?'\"'WEBGPU':'WEBGL2'} · RAPIER 0.19.3\"'`;makeMarkers();buildPhysics();ready=true;window.addEventListener('\"'resize',()=>{renderer.setSize(innerWidth,innerHeight);art.camera.aspect=innerWidth/innerHeight;art.camera.updateProjectionMatrix()});renderer.setAnimationLoop(loop);if(AIHub.active){\"'$('\"'overlay').hidden=true;\"'$('\"'hud').hidden=true;state.screen='hub-wait';AIHub.on('start',()=>{hubStarting=true});AIHub.on('time-up',()=>reportHub());AIHub.on('end',()=>{hubEnded=true;state.screen='hub-end';audio.suspend();keys.clear();pressed.clear()});hubInfo=await AIHub.connect({mode:'parallel',seats:[1,4]});if(hubInfo)AIHub.ready();else showTitle()}else showTitle()}catch(e){stats.errors.push(e.stack||e.message);\"'$('\"'loading-copy').textContent='COULD NOT LOAD THE COAST. '+e.message;\"'$('\"'loading-retry').hidden=false;console.error(e)}}\nwindow.__game={get state(){return {...state,attract,bot,playerCount,currentPlayer,players:structuredClone(players),config:{...config},ready,renderer:renderer?.backend?.isWebGPUBackend?'webgpu':'webgl2',position:body?{...body.translation()}:null,stats:structuredClone(stats)}},get audio(){return audio},start:(id='skate')=>{playerCount=1;practice=false;makePlayers();state.eventIndex=EVENTS.findIndex(e=>e.id===id);state.event=id;startEvent()},action:a=>pressed.add(a==='jump'?'Space':a==='grab'?'KeyJ':'KeyK'),setConfig:c=>Object.assign(config,c),setBot:v=>bot=v,finish:finishEvent,advance,pause,title:showTitle,setIdle:()=>lastInput=performance.now()-10001,teleport:(x,y,vx=0,vy=0)=>{body.setTranslation({x,y,z:0},true);body.setLinvel({x:vx,y:vy,z:0},true);lastGround=false},network:()=>network,version:'1.0.0'};\nwindow.addEventListener('error',e=>stats.errors.push(e.message));window.addEventListener('unhandledrejection',e=>stats.errors.push(String(e.reason)));\nfunction fillAbout(){const feedback=window.GAME_CREDITS;\"'$('\"'about-content').innerHTML=feedback?Object.entries(feedback).filter(([k])=>k\"'!=='\"'aiHub').map(([k,v])=>\"'`<h3>${esc(k.replace(/([A-Z])/g,'\"' \"'$1'\"').toUpperCase())}</h3>\"'${Array.isArray(v)?v.map(a=>`<p>${esc(a)}</p>`).join('\"''):Object.entries(v).map(([a,b])=>\"'`<p><strong>${esc(a)}:</strong> ${esc(b)}</p>`).join('\"'')}\"'`).join('\"''):'Credits are loading.';}\nboot();\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/main.js <<'EOF'\nimport * as THREE from 'three';\nimport RAPIER from 'https://esm.sh/@dimforge/rapier3d-compat@0.19.3';\nimport {createArt} from './art.js';\nimport {AudioSystem} from './audio.js';\nimport {FestivalNetwork} from './network.js';\n\nconst \"'$=id=>document.getElementById(id), TAU=Math.PI*2, clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst esc=s=>String(s).replace(/[&<>\"'\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;',\\\"'\\\":'&#39;'}[c]));\nconst EVENTS=[{id:'skate',name:'HALF-PIPE HEAT',short:'Half-pipe',tag:'Concrete. Courage. Questionable shorts.',goal:'Pump the bowl. Pop at the lip. Bring it home.',guide:[['MOVE','Build speed through the bowl. Hold down to pump.'],['POP','Jump near a high wall for the biggest air.'],['STYLE','Grab or flip in the air. Release to level out.']],gold:3500,silver:1800,bronze:650},{id:'surf',name:'SALTWATER SWING',short:'Surfing',tag:'The forecast calls for absolutely tubular.',goal:'Follow the golden pocket. Carve, pop, repeat.',guide:[['CARVE','Steer left and right to follow the golden wave pocket.'],['SCORE','Stay in the pocket to earn flow points. Grab for a cutback.'],['AIR','Pop off the wave, then grab or flip. Watch the red buoy.']],gold:4200,silver:2200,bronze:800},{id:'bmx',name:'BOARDWALK BMX',short:'BMX',tag:'Two wheels. Zero sensible decisions.',goal:'Pedal the ramps. Clear the cones. Land your style.',guide:[['PEDAL','Hold right to sprint. Left slows you down.'],['POP','Jump at the ramp lip; jump over orange cones.'],['STYLE','Tailwhip or barspin in the air. Release before landing.']],gold:3500,silver:1800,bronze:650}];\nconst DEFAULTS={speed:1,gravity:18,jump:8,assist:.78,duration:60,timeScale:1};\nlet config={...DEFAULTS},audio=new AudioSystem(),world,body,art,renderer,ready=false;\nlet state={screen:'loading',event:'skate',eventIndex:0,time:0,elapsed:0,airborne:false,speed:0,trick:'',crashed:false,total:0,score:0,pending:0,mult:1,rotation:0,combo:[],bestCombo:0,bails:0,landings:0,flow:0,started:false};\nlet currentPlayer=0,playerCount=1,players=[],practice=false,attract=false,lastInput=performance.now(),inputKind='keyboard',glyphs='ps',soundOn=true,reduceMotion=false,bot=false,infinite=false,hubInfo=null,hubEnded=false,hubResult=false,hubStarting=false,network=null,networkScores=[],onlineWaiting=false;\nlet eventElapsed=0,crashTime=0,lastGround=true,airTime=0,lastTrick=-9,dir=1,pipeSpeed=9,targetX=0,flowClock=0,foamClock=0,toastTime=0,scoreFlash=0,lastRender=0,lastNetwork=0,lookOffset=0;\nconst keys=new Set(),pressed=new Set(),padPrev=[],touch={active:false,x:0,y:0,startX:0,startY:0,moveX:0,moveY:0},stats={frames:0,physicsSteps:0,errors:[],bailReasons:[]};\nlet best={};try{best=JSON.parse(localStorage.getItem('californium-best')||'{}')}catch{}\nfunction persist(){if(\"'!AIHub.active)try{localStorage.setItem('\"'californium-best',JSON.stringify(best))}catch{}}\nfunction isPlay(){return state.screen==='playing'||attract}\nfunction noteInput(kind='keyboard'){inputKind=kind;lastInput=performance.now();if(attract){attract=false;bot=false;showTitle();return true}updatePrompts();audio.unlock();return false}\nfunction label(action){const maps={keyboard:{pop:'SPACE',grab:'J',flip:'K',pause:'ESC',move:'A D / ← →',pump:'S / ↓',accept:'ENTER'},ps:{pop:'✕',grab:'□',flip:'○',pause:'OPTIONS',move:'L STICK',pump:'L STICK ↓',accept:'✕'},xbox:{pop:'A',grab:'X',flip:'B',pause:'MENU',move:'L STICK',pump:'L STICK ↓',accept:'A'},touch:{pop:'TAP',grab:'AUTO',flip:'AUTO',pause:'Ⅱ',move:'DRAG',pump:'ASSIST',accept:'TAP'}};return maps[inputKind==='gamepad'?glyphs:inputKind]?.[action]||action}\nfunction updatePrompts(){document.querySelectorAll('[data-key]').forEach(e=>e.textContent=label(e.dataset.key));document.body.dataset.input=inputKind;\"'$('\"'touch-pop').textContent='POP';}\nfunction toast(text,kind=''){ \"'$('\"'toast').textContent=text;\"'$('\"'toast').className='toast visible '+kind;toastTime=3; }\nfunction visiblePanel(id){document.querySelectorAll('.panel').forEach(e=>e.hidden=e.id\"'!==id);$('\"'overlay').hidden=\"'!id;$('\"'hud').hidden=\"'!isPlay();$('\"'attract').hidden=\"'!attract;focusFirst();}\nfunction focusFirst(){requestAnimationFrame(()=>{const a=[...document.querySelectorAll('\"'.panel:not([hidden]) button,.panel:not([hidden]) input')].find(e=>\"'!e.disabled);a?.focus({preventScroll:true})})}\nfunction setScreen(s,p){state.screen=s;visiblePanel(p);updatePrompts()}\nfunction showTitle(){state.screen='\"'title';attract=false;state.crashed=false;art?.setEvent('skate');state.event='skate';if(body){body.setTranslation({x:-2,y:1,z:0},true);body.setLinvel({x:0,y:0,z:0},true)}\"'$('\"'title-best').textContent=best.festival?\"'`PERSONAL BEST  ${best.festival.toLocaleString()}`:'\"'THREE EVENTS. ONE GOLDEN COAST.';setScreen('title','title-panel');lastInput=performance.now();}\nfunction makePlayers(){players=Array.from({length:playerCount},(_,i)=>({name:network?.connected?\"'`RIDER ${network.me+1}`:`RIDER ${i+1}`,scores:[0,0,0],total:0}));currentPlayer=0;}\nfunction beginFestival(single=-1){if(AIHub.active&&!hubStarting)return;practice=single>=0;makePlayers();state.eventIndex=single>=0?single:0;showBrief();}\nfunction showBrief(){const e=EVENTS[state.eventIndex];state.event=e.id;art.setEvent(e.id);$('\"'brief-num').textContent=\"'`${practice?'\"'FREE SESSION':\"'`EVENT ${state.eventIndex+1} / 3`}  ·  ${players[currentPlayer].name}`;$('\"'brief-title').textContent=e.name;\"'$('\"'brief-tag').textContent=e.tag;\"'$('\"'brief-goal').textContent=e.goal;\"'$('\"'brief-guide').innerHTML=e.guide.map(([a,b],i)=>\"'`<div class=\"guide-row\"><b>0${i+1}</b><div><strong>${a}</strong><p>${b}</p></div></div>`).join('\"'');\"'$('\"'brief-medals').textContent=\"'`BRONZE ${e.bronze}   /   SILVER ${e.silver}   /   GOLD ${e.gold}`;setScreen('\"'brief','brief-panel');}\nfunction height(x,id=state.event){if(id==='skate'){const a=Math.max(0,Math.abs(x)-4);return 4*(a/8)**2}if(id==='bmx'){for(const c of [-9,3,15])if(x>=c-3&&x<=c)return (x-(c-3))/3*2.2;return 0}return .4+.5*Math.sin(x*.22+state.elapsed*1.8)}\nfunction buildPhysics(){if(world)world.free();world=new RAPIER.World({x:0,y:-config.gravity,z:0});world.timestep=1/60;body=world.createRigidBody(RAPIER.RigidBodyDesc.dynamic().setTranslation(-5,3,0).lockRotations().enabledTranslations(true,true,false).setLinearDamping(.03).setCcdEnabled(true));world.createCollider(RAPIER.ColliderDesc.ball(.38).setFriction(.02).setRestitution(0),body);if(state.event\"'!=='\"'surf'){for(let x=-20;x<20;x+=.4){const h1=height(x),h2=height(x+.4),a=Math.atan2(h2-h1,.4),length=Math.hypot(.4,h2-h1);if(Math.abs(h2-h1)>1)continue;const ground=world.createRigidBody(RAPIER.RigidBodyDesc.fixed().setTranslation(x+.2,(h1+h2)/2-.12,0).setRotation({x:0,y:0,z:Math.sin(a/2),w:Math.cos(a/2)}));world.createCollider(RAPIER.ColliderDesc.cuboid(length/2,.12,4).setFriction(0),ground)}}}\nfunction startEvent(){eventElapsed=0;state.time=config.duration;state.elapsed=0;state.score=0;state.pending=0;state.mult=1;state.rotation=0;state.combo=[];state.trick='';state.crashed=false;state.airborne=false;state.flow=0;crashTime=0;pipeSpeed=9;dir=1;flowClock=0;foamClock=0;lastTrick=-9;airTime=0;lastGround=true;state.started=true;buildPhysics();const x=state.event==='skate'?-6:state.event==='bmx'?-17:0;body.setTranslation({x,y:height(x)+.42,z:0},true);body.setLinvel({x:0,y:0,z:0},true);art.setEvent(state.event);setScreen('playing',null);audio.resume();audio.voice('start');toast(state.event==='surf'?'CHASE THE GOLDEN POCKET':'GET RAD. LAND CLEAN.');}\nfunction medal(score,e=EVENTS[state.eventIndex]){return score>=e.gold?'GOLD':score>=e.silver?'SILVER':score>=e.bronze?'BRONZE':'SUN-SEEKER'}\nfunction bank(){if(\"'!state.pending)return;let pts=Math.round(state.pending*state.mult);state.score+=pts;state.bestCombo=Math.max(state.bestCombo,pts);state.landings++;toast(`${state.combo.join('\"' + ')}   +\"'${pts.toLocaleString()}`,'\"'good');audio.sfx('land');audio.sfx('score');if(pts>700)audio.voice('rad');state.pending=0;state.combo=[];state.mult=clamp(state.mult+1,1,8);scoreFlash=.4;publish();}\nfunction bail(reason){if(attract||bot||inputKind==='touch'){state.rotation=0;bank();return}state.bails++;state.pending=0;state.combo=[];state.mult=1;state.crashed=true;crashTime=1.25;state.rotation=0;stats.bailReasons.push(reason);toast(reason+' · BACK ON IN A BEAT','bad');audio.sfx('bail');audio.voice('bail');}\nfunction trick(kind){if(state.crashed||state.elapsed-lastTrick<.32)return;if(\"'!state.airborne){if(state.event==='\"'surf'&&kind==='grab'&&state.elapsed-lastTrick>1){lastTrick=state.elapsed;state.score+=90;toast('CUTBACK  +90');audio.sfx('score');publish()}return}lastTrick=state.elapsed;const name=state.event==='bmx'?(kind==='grab'?'TAILWHIP':'BARSPIN'):state.event==='surf'?(kind==='grab'?'MELON AIR':'REVERSE AIR'):(kind==='grab'?'METHOD GRAB':'KICKFLIP');const repeat=state.combo.includes(name);state.pending+=repeat?65:kind==='grab'?180:280;state.combo.push(name);state.trick=kind;state.rotation+=kind==='flip'?TAU:Math.PI*.18;audio.sfx('score');\"'$('\"'trick-call').textContent=name;scoreFlash=.3;}\nfunction jump(){if(\"'!lastGround||state.crashed)return;let v=body.linvel(),bonus=state.event==='\"'skate'?Math.max(0,(Math.abs(body.translation().x)-6)*.5):0;body.setLinvel({x:v.x,y:config.jump+bonus,z:0},true);body.setTranslation({x:body.translation().x,y:body.translation().y+.12,z:0},true);state.airborne=true;lastGround=false;airTime=0;audio.sfx('jump');}\nfunction publish(){const total=players[currentPlayer]?.total||0;const score=total+state.score;if(AIHub.active&&\"'!hubEnded&&!hubResult)AIHub.progress({score,label:`${EVENTS[state.eventIndex].short} · ${medal(state.score)}`});if(network?.connected)network.sendScore({event:state.eventIndex,score:state.score,total:score,finished:false});}\nfunction finishEvent(){bank();const p=players[currentPlayer],e=EVENTS[state.eventIndex];p.scores[state.eventIndex]=state.score;p.total=p.scores.reduce((a,b)=>a+b,0);best[e.id]=Math.max(best[e.id]||0,state.score);persist();audio.sfx('\"'finish');\"'$('\"'result-eyebrow').textContent=\"'`${p.name}  /  ${e.short.toUpperCase()}`;$('\"'result-medal').textContent=medal(state.score);\"'$('\"'result-score').textContent=state.score.toLocaleString();\"'$('\"'result-copy').textContent=medal(state.score)==='GOLD'?'That coast is officially toast.':\"'`Next medal: ${state.score<e.bronze?e.bronze:state.score<e.silver?e.silver:e.gold} points. Keep the good times rolling.`;$('\"'result-detail').textContent=\"'`BEST COMBO ${state.bestCombo}  ·  CLEAN LANDINGS ${state.landings}  ·  WIPEOUTS ${state.bails}`;$('\"'result-next').textContent=practice?'RIDE AGAIN':currentPlayer+1<playerCount?'NEXT RIDER':state.eventIndex<2?'NEXT EVENT':'FESTIVAL RESULTS';setScreen('event-result','result-panel');if(attract){setTimeout(()=>{if(attract)advance()},1500)}else if(AIHub.active||network?.connected){setTimeout(()=>{if(state.screen==='event-result'&&\"'!hubEnded)advance()},3500)}}\nfunction advance(){if(practice){startEvent();return}if(currentPlayer+1<playerCount){currentPlayer++;showBrief()}else if(state.eventIndex<2){currentPlayer=0;state.eventIndex++;state.event=EVENTS[state.eventIndex].id;showBrief()}else{finishFestival();return}if(attract||AIHub.active||network?.connected)startEvent();}\nfunction finishFestival(){best.festival=Math.max(best.festival||0,...players.map(p=>p.total));persist();$('\"'podium-list').innerHTML=[...players].sort((a,b)=>b.total-a.total).map((p,i)=>\"'`<div class=\"standing\"><span>0${i+1}</span><strong>${esc(p.name)}</strong><b>${p.total.toLocaleString()}</b></div>`).join('\"'');\"'$('\"'festival-copy').textContent=players[0].total>=11000?'GOLDEN COAST LEGEND. Put that on a T-shirt.':'Three sports. One seriously excellent afternoon.';setScreen('festival-result','festival-panel');if