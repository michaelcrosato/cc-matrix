{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,35p' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/art.js && sed -n '77,115p' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/art.js && rg -n 'limit|__hubCheck|setTimeout|scenario' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/harness.html\"","aggregated_output":"import * as THREE from 'three';\n\nexport function createArt() {\n  const C={ink:0x183a46,cream:0xffefc3,sand:0xf1c887,coral:0xf57966,pink:0xffad91,teal:0x2c9e9d,aqua:0x70cbbb,blue:0x27788e,navy:0x264755,yellow:0xffca58,white:0xfff7dd,purple:0x79628c};\n  const scene=new THREE.Scene();scene.background=new THREE.Color(0xf7b595);scene.fog=new THREE.Fog(0xf7b595,65,185);\n  const camera=new THREE.PerspectiveCamera(43,innerWidth/innerHeight,.1,240);camera.position.set(23,17,31);camera.lookAt(0,2,0);\n  const hemi=new THREE.HemisphereLight(0xffeac6,0x3f686c,1.65);scene.add(hemi);\n  const sunLight=new THREE.DirectionalLight(0xffd1a3,2.1);sunLight.position.set(-25,40,25);sunLight.castShadow=true;sunLight.shadow.mapSize.set(2048,2048);Object.assign(sunLight.shadow.camera,{left:-38,right:38,top:32,bottom:-32,near:1,far:120});sunLight.shadow.bias=-.001;scene.add(sunLight);\n  const mats=new Map();\n  function mat(color,roughness=1){const k=color+':'+roughness;if(!mats.has(k))mats.set(k,new THREE.MeshStandardMaterial({color,roughness,metalness:0,flatShading:true}));return mats.get(k);}\n  const ink=new THREE.MeshBasicMaterial({color:C.ink,side:THREE.BackSide});\n  function mesh(g,color,parent,x=0,y=0,z=0,outline=true){const m=new THREE.Mesh(g,typeof color==='number'?mat(color):color);m.position.set(x,y,z);m.castShadow=true;m.receiveShadow=true;if(outline){const o=new THREE.Mesh(g,ink);o.scale.setScalar(1.025);m.add(o);}parent.add(m);return m;}\n  function box(p,x,y,z,w,h,d,c,o=true){return mesh(new THREE.BoxGeometry(w,h,d),c,p,x,y,z,o);}\n  function cyl(p,x,y,z,r,h,c,seg=8,rt=r){return mesh(new THREE.CylinderGeometry(rt,r,h,seg),c,p,x,y,z);}\n  function ball(p,x,y,z,r,c,seg=8){return mesh(new THREE.IcosahedronGeometry(r,seg>8?1:0),c,p,x,y,z);}\n  function rod(p,a,b,r,c){const aa=new THREE.Vector3(...a),bb=new THREE.Vector3(...b);const v=bb.clone().sub(aa);const m=cyl(p,...aa.clone().add(bb).multiplyScalar(.5).toArray(),r,v.length(),c,7);m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),v.normalize());return m;}\n  function textPanel(p,text,x,y,z,w,h,bg=C.cream,fg=C.ink){const cv=document.createElement('canvas');cv.width=1024;cv.height=256;const ct=cv.getContext('2d');ct.fillStyle='#'+bg.toString(16).padStart(6,'0');ct.fillRect(0,0,1024,256);ct.fillStyle='#'+fg.toString(16).padStart(6,'0');ct.font='900 108px Arial';ct.textAlign='center';ct.textBaseline='middle';ct.fillText(text,512,137,960);const m=mesh(new THREE.PlaneGeometry(w,h),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(cv),side:THREE.DoubleSide}),p,x,y,z,false);return m;}\n  function palm(p,x,z,s=1,lean=0){const g=new THREE.Group();g.position.set(x,0,z);g.scale.setScalar(s);p.add(g);const top=[lean,7,0];rod(g,[0,0,0],top,.24,0xa77856);for(let j=0;j<7;j++){const a=j*Math.PI*2/7;const end=[lean+Math.cos(a)*3.7,6.4+(j%2)*.55,Math.sin(a)*3.7];const middle=[lean+Math.cos(a)*1.8,8.2,Math.sin(a)*1.8];rod(g,top,middle,.1,0x2c7261);const sh=new THREE.Shape();sh.moveTo(0,0);sh.quadraticCurveTo(1,1.2,4,0);sh.quadraticCurveTo(1,-.65,0,0);const leaf=mesh(new THREE.ShapeGeometry(sh,6),0x3c8666,g,...top,false);leaf.rotation.set(-Math.PI*.35,a,0);leaf.scale.set(1,.8,1);rod(g,middle,end,.1,0x3c8666);}for(let j=0;j<3;j++)ball(g,lean+(j-1)*.3,6.8,.1,.22,0x745244);return g;}\n  function umbrella(p,x,z,color){cyl(p,x,1.4,z,.055,2.8,C.cream);const con=mesh(new THREE.ConeGeometry(1.65,.6,8),color,p,x,2.9,z);for(let j=0;j<8;j++){let a=j*Math.PI/4;rod(p,[x,3.2,z],[x+Math.cos(a)*1.65,2.6,z+Math.sin(a)*1.65],.025,C.ink);}return con;}\n  function person(p,x,y,z,c,scale=1){const g=new THREE.Group();p.add(g);g.position.set(x,y,z);g.scale.setScalar(scale);cyl(g,0,.9,0,.21,.65,c);ball(g,0,1.45,0,.22,0xb47c56);rod(g,[-.12,.6,0],[-.18,0,.04],.075,C.ink);rod(g,[.12,.6,0],[.2,0,-.04],.075,C.ink);rod(g,[-.17,1.1,0],[-.4,.65,0],.065,0xb47c56);rod(g,[.17,1.1,0],[.45,1.5,0],.065,0xb47c56);return g;}\n  function pennant(p,x,y,z,color){rod(p,[x,y-3,z],[x,y+.9,z],.045,C.ink);const sh=new THREE.Shape();sh.moveTo(0,0);sh.lineTo(1.65,-.35);sh.lineTo(0,-.85);sh.closePath();const m=mesh(new THREE.ShapeGeometry(sh),new THREE.MeshBasicMaterial({color,side:THREE.DoubleSide}),p,x,y+.8,z,false);return m;}\n  const coast=new THREE.Group();scene.add(coast);\n  box(coast,0,-.65,5,180,1,105,C.sand,false);\n  box(coast,0,-.8,-74,230,.8,93,C.teal,false);\n  for(let j=0;j<12;j++)box(coast,0,-.31,-29-j*4.9,190,.035,.3+j*.04,j%2?C.aqua:0x50b5ab,false);\n  // Graphic sunset and headland silhouettes.\n  const sun=mesh(new THREE.CircleGeometry(10,64),new THREE.MeshBasicMaterial({color:0xffd37f}),coast,-31,27,-95,false);\n  for(let i=0;i<5;i++)box(coast,-31,21.5+i*1.6,-94.95,21,.25+i*.04,.01,0xf7b595,false);\n  const mountainMat=new THREE.MeshBasicMaterial({color:0x8d8f86});\n  for(let i=0;i<13;i++){const m=mesh(new THREE.ConeGeometry(11+3*(i%3),14+(i%4)*4,4),mountainMat,coast,45+i*9,3,-89,false);m.rotation.y=Math.PI/4;}\n  // Water's edge, promenade, and distant pier.\n  for(let j=0;j<4;j++)box(coast,0,-.18,-24-j*.9,170,.025,.35,0xffe8bc,false);\n  box(coast,-27,.4,-22,5,.6,34,0xb98362);for(let j=0;j<9;j++)box(coast,-27,.73,-7-j*3.6,5,.035,.08,C.cream,false);\n  for(let i=0;i<12;i++){let z=-6-i*2.8;rod(coast,[-29.4,-1.3,z],[-29.4,1.9,z],.09,C.ink);rod(coast,[-24.6,-1.3,z],[-24.6,1.9,z],.09,C.ink);}rod(coast,[-29.4,1.6,-6],[-29.4,1.6,-37],.07,C.cream);rod(coast,[-24.6,1.6,-6],[-24.6,1.6,-37],.07,C.cream);\n  for(let i=0;i<7;i++){let x=-40+i*12;umbrella(coast,x,-17-(i%2)*2,[C.coral,C.yellow,C.aqua][i%3]);box(coast,x+.6,.05,-15.5-(i%2)*2,1.7,.08,3,[C.coral,C.teal][i%2]);}\n    box(bmx,x,.065,0,.95,.13,.95,C.ink);\n    mesh(new THREE.ConeGeometry(.43,1.06,10),0xff762f,bmx,x,.64,0);\n    cyl(bmx,x,.71,0,.235,.15,C.cream,10,.175);\n    box(bmx,x-1.6,.012,0,.12,.025,2,C.yellow,false);\n  }\n  textPanel(bmx,'DIRT / STYLE / GLORY',0,.62,4.6,10,1.1,C.coral,C.cream);\n  // Articulated athlete; animation tracks target named joints.\n  const athlete=new THREE.Group();scene.add(athlete);const rig=new THREE.Group();rig.name='rider';athlete.add(rig);\n  const torso=new THREE.Group();torso.name='torso';torso.position.y=1.15;rig.add(torso);\n  box(torso,0,.23,0,.65,.7,.38,C.cream);box(torso,0,.22,.202,.66,.14,.025,C.coral);box(torso,0,-.18,0,.62,.26,.4,C.teal);\n  cyl(torso,0,.66,0,.13,.18,0xc5835a);ball(torso,0,.94,0,.29,0xc5835a);const cap=mesh(new THREE.SphereGeometry(.3,12,6,0,Math.PI*2,0,Math.PI*.55),C.coral,torso,0,1.02,0);box(torso,.1,1.07,.26,.48,.06,.32,C.coral);box(torso,0,.99,.263,.37,.1,.04,C.ink);box(torso,.11,.99,.288,.1,.07,.03,C.cream);\n  const joints={};\n  for(let side of [-1,1]){let label=side<0?'L':'R';const arm=new THREE.Group();arm.name='arm'+label;arm.position.set(side*.4,.43,0);torso.add(arm);rod(arm,[0,0,0],[side*.42,-.35,0],.1,C.cream);rod(arm,[side*.42,-.35,0],[side*.65,-.65,.12],.075,0xc5835a);ball(arm,side*.65,-.65,.12,.105,0xc5835a);joints['arm'+label]=arm;\n    const leg=new THREE.Group();leg.name='leg'+label;leg.position.set(side*.2,.9,0);rig.add(leg);rod(leg,[0,0,0],[side*.12,-.4,0],.13,C.teal);rod(leg,[side*.12,-.4,0],[side*.24,-.74,.02],.09,0xc5835a);cyl(leg,side*.24,-.66,.02,.095,.2,C.cream);box(leg,side*.25,-.79,.09,.38,.17,.31,C.coral);joints['leg'+label]=leg;}\n  const equipment=new THREE.Group();equipment.name='equipment';athlete.add(equipment);\n  function boardShape(l,w){const s=new THREE.Shape();s.moveTo(-l/2+w/2,-w/2);s.lineTo(l/2-w/2,-w/2);s.quadraticCurveTo(l/2, -w/2,l/2,0);s.quadraticCurveTo(l/2,w/2,l/2-w/2,w/2);s.lineTo(-l/2+w/2,w/2);s.quadraticCurveTo(-l/2,w/2,-l/2,0);s.quadraticCurveTo(-l/2,-w/2,-l/2+w/2,-w/2);return new THREE.ExtrudeGeometry(s,{depth:.08,bevelEnabled:true,bevelSegments:1,steps:1,bevelSize:.03,bevelThickness:.03});}\n  const skateBoard=new THREE.Group();equipment.add(skateBoard);const deck=mesh(boardShape(1.65,.48),C.coral,skateBoard,0,.15,0);deck.rotation.x=-Math.PI/2;box(skateBoard,0,.205,0,1,.02,.25,C.ink);for(let x of [-.53,.53]){rod(skateBoard,[x,.08,-.32],[x,.08,.32],.045,C.cream);for(let z of [-.3,.3]){const w=cyl(skateBoard,x,.08,z,.115,.12,C.yellow,10);w.rotation.x=Math.PI/2;}}\n  const surfBoard=new THREE.Group();equipment.add(surfBoard);const sd=mesh(boardShape(3.1,.75),C.yellow,surfBoard,0,.05,0);sd.rotation.x=-Math.PI/2;box(surfBoard,0,.12,0,2.5,.018,.1,C.coral);box(surfBoard,-.9,-.15,0,.3,.4,.08,C.teal);\n  const bike=new THREE.Group();equipment.add(bike);bike.position.y=.05;\n  const wheels=[];for(let x of [-.85,.85]){const wheel=new THREE.Group();wheel.position.set(x,.4,0);bike.add(wheel);const tire=mesh(new THREE.TorusGeometry(.43,.075,7,16),C.ink,wheel,0,0,0,false);const rim=mesh(new THREE.TorusGeometry(.35,.025,4,16),C.cream,wheel,0,0,0,false);for(let a=0;a<Math.PI*2;a+=Math.PI/4)rod(wheel,[0,0,0],[Math.cos(a)*.35,Math.sin(a)*.35,0],.013,C.cream);wheels.push(wheel);}\n  for(const [a,b] of [[[-.85,.4,0],[-.27,1,0]],[[-.85,.4,0],[0,.42,0]],[[-.27,1,0],[0,.42,0]],[[-.27,1,0],[.55,1,0]],[[.55,1,0],[0,.42,0]],[[.55,1,0],[.85,.4,0]]])rod(bike,a,b,.048,C.coral);\n  rod(bike,[-.27,1,0],[-.35,1.22,0],.04,C.ink);box(bike,-.35,1.24,0,.42,.1,.24,C.ink);rod(bike,[.55,1,0],[.6,1.47,0],.045,C.cream);rod(bike,[.6,1.47,-.33],[.6,1.47,.33],.04,C.ink);rod(bike,[0,.42,-.2],[0,.42,.2],.035,C.cream);box(bike,.13,.42,.25,.25,.08,.17,C.ink);box(bike,-.13,.42,-.25,.25,.08,.17,C.ink);\n  // Native mixer cycles are the base; root movement and trick rotation remain gameplay-owned.\n  const mixer=new THREE.AnimationMixer(rig);\n  function clip(name,span,tracks){return new THREE.AnimationClip(name,span,tracks.map(([path,v])=>new THREE.NumberKeyframeTrack(path,[0,span*.25,span*.5,span*.75,span],v)));}\n  const rideClip=clip('coast-pump',1.1,[['torso.position[y]',[1.15,1.08,1.02,1.08,1.15]],['armL.rotation[z]',[.1,.3,.15,-.1,.1]],['armR.rotation[z]',[-.1,-.3,-.15,.1,-.1]],['legL.rotation[z]',[-.2,-.27,-.3,-.27,-.2]],['legR.rotation[z]',[.2,.27,.3,.27,.2]]]);\n  const airClip=clip('grab-and-tweak',.7,[['torso.position[y]',[.96,.9,.94,.9,.96]],['armL.rotation[z]',[.65,.8,.9,.8,.65]],['armR.rotation[z]',[-.4,-.6,-.7,-.6,-.4]],['legL.rotation[z]',[-.4,-.5,-.4,-.3,-.4]],['legR.rotation[z]',[.35,.5,.4,.3,.35]]]);\n  const bikeClip=clip('pedal-power',.65,[['torso.position[y]',[1.4,1.43,1.4,1.43,1.4]],['torso.rotation[z]',[-.22,-.25,-.22,-.25,-.22]],['legL.position[y]',[1.2,1.2,1.2,1.2,1.2]],['legR.position[y]',[1.2,1.2,1.2,1.2,1.2]],['legL.rotation[z]',[.45,0,-.45,0,.45]],['legR.rotation[z]',[-.45,0,.45,0,-.45]],['armL.rotation[z]',[.95,.98,.95,.92,.95]],['armR.rotation[z]',[-.4,-.43,-.4,-.37,-.4]]]);\n  const actions={ride:mixer.clipAction(rideClip),air:mixer.clipAction(airClip),bike:mixer.clipAction(bikeClip)};actions.ride.play();actions.air.play();actions.bike.play();actions.air.setEffectiveWeight(0);actions.bike.setEffectiveWeight(0);\n  const spray=new THREE.Group();scene.add(spray);const sprayBits=[];for(let i=0;i<28;i++){const m=ball(spray,0,-10,0,.035+(i%3)*.023,C.cream);sprayBits.push(m);}\n  const shadow=mesh(new THREE.CircleGeometry(.8,24),new THREE.MeshBasicMaterial({color:C.ink,transparent:true,opacity:.16,depthWrite:false}),scene,0,.023,0,false);shadow.rotation.x=-Math.PI/2;\n  let active='skate',elapsed=0;\n  function setEvent(id){active=id;for(const [k,g]of Object.entries(arenas))g.visible=k===id;skateBoard.visible=id==='skate';surfBoard.visible=id==='surf';bike.visible=id==='bmx';}\n  function update(dt,state={}){elapsed+=dt;const airborne=!!state.airborne;actions.ride.setEffectiveWeight(active!=='bmx'&&!airborne?1:0);actions.air.setEffectiveWeight(airborne?1:0);actions.bike.setEffectiveWeight(active==='bmx'&&!airborne?1:0);mixer.timeScale=Math.max(.35,Math.min(2,Math.abs(state.speed||5)/9));mixer.update(dt);\n    for(let i=0;i<gulls.length;i++){gulls[i].position.x=-39+i*9+Math.sin(elapsed*.13+i)*5;gulls[i].position.y=15+(i%3)*3+Math.sin(elapsed*.7+i)*.45;gulls[i].rotation.z=Math.sin(elapsed*1.1+i)*.12;}\n    for(let i=0;i<wheels.length;i++)wheels[i].rotation.z-=dt*(state.speed||0)*1.8;\n    shadow.position.set(athlete.position.x,.035,athlete.position.z);shadow.scale.setScalar(Math.max(.3,1-(athlete.position.y||0)*.055));shadow.visible=active!=='surf';\n    spray.visible=active==='surf'||airborne;for(let i=0;i<sprayBits.length;i++){const q=(elapsed*1.8+i/28)%1;const p=sprayBits[i];p.position.set(athlete.position.x-(state.speed<0?-1:1)*q*(active==='surf'?3:1.8),athlete.position.y+.12+Math.sin(q*Math.PI)*.65,athlete.position.z+Math.sin(i*7.2)*q*.9);p.scale.setScalar((1-q)*(active==='surf'?1.3:.7));}\n    crest.position.x=Math.sin(elapsed*.7)*.25;\n67:import { createRound, limitFor, modeOf, seedsRandom, SELF_REPORTED, TIMINGS } from './round.js';\n73:const scenario = params.get('scenario') || 'standard';\n74:/** ?scenario=server: the shared world runs on one more copy with no player of its own, as a dedicated server would run it. */\n75:const serverMode = scenario === 'server';\n170:  const limitMs = params.has('limit') ? Number(params.get('limit')) * 1000 : limitFor(metas?.minutes);\n181:  const state = { round, n, metas, mode, limitMs, seed, players, cells: [], hubEnd, status: null, record: null, hidden: false, splashUntil: performance.now() + SPLASH_MS, answers: { ready: new Set(),  [... omitted end of long line]\n183:  log(`round ${round}: ${n} player${n > 1 ? 's' : ''}, seed ${seed}, limit ${Math.round(limitMs / 1000)} s, mode ${mode || '(from hello)'}`);\n192:    limitMs,\n379: * page's origin). Results land in window.__hubCheck, and body[data-complete]\n383:const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n400:  setTimeout(() => target.dispatchEvent(new win.KeyboardEvent('keyup', init)), 120);\n411:  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n412:  window.__hubCheck = report;\n477:    if (scenario === 'host-leave') removeCell(state.cells[0]);\n505:    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"sed -n '112,125p' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/art.js && sed -n '410,530p' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/harness.html\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"sed -n '112,125p' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/art.js && sed -n '410,530p' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/harness.html\"","aggregated_output":"    for(let i=0;i<wheels.length;i++)wheels[i].rotation.z-=dt*(state.speed||0)*1.8;\n    shadow.position.set(athlete.position.x,.035,athlete.position.z);shadow.scale.setScalar(Math.max(.3,1-(athlete.position.y||0)*.055));shadow.visible=active!=='surf';\n    spray.visible=active==='surf'||airborne;for(let i=0;i<sprayBits.length;i++){const q=(elapsed*1.8+i/28)%1;const p=sprayBits[i];p.position.set(athlete.position.x-(state.speed<0?-1:1)*q*(active==='surf'?3:1.8),athlete.position.y+.12+Math.sin(q*Math.PI)*.65,athlete.position.z+Math.sin(i*7.2)*q*.9);p.scale.setScalar((1-q)*(active==='surf'?1.3:.7));}\n    crest.position.x=Math.sin(elapsed*.7)*.25;\n  }\n  setEvent('skate');\n  return {scene,camera,athlete,rig,mixer,update,setEvent,pipeHeight,rampHeight,arenas,palette:C};\n}\n  };\n  const report = { done: false, pass: false, game: $('game').value, players: Number($('players').value), scenario, checks, log: logLines };\n  window.__hubCheck = report;\n  try {\n    const state = await newRound();\n    if (!state) {\n      check('game named', false, 'pass ?game=<path> of a page on this site');\n      return;\n    }\n    const n = state.n;\n    const m = state.metas;\n    check('head metas', m && m.session === '1' && modeOf(m.mode), m ? `hub:session=${m.session} mode=${m.mode}` : 'could not fetch the page');\n    const seats = String(m?.players ?? '').match(/\\d+/g)?.map(Number) ?? [];\n    const [least, most = least] = seats;\n    check('hub:session-players is a range within 1–4', seats.length >= 1 && seats.length <= 2 && least >= 1 && least <= most && most <= 4, `hub:session-players=${m?.players}`);\n    if (m?.minutes != null) check('hub:session-minutes, when given, is a number', Number(m.minutes) > 0, `hub:session-minutes=${m.minutes}`);\n\n    // Every copy: the players, and in a server round the server's copy.\n    const copies = () => [...(state.status?.players ?? []), ...(state.status?.server ? [state.status.server] : [])];\n    const helloed = await until(() => copies().every((p) => p.hello), TIMINGS.helloMs + 1000);\n    check('every copy says hello', helloed, copies().filter((p) => !p.hello).map((p) => p.key).join(', '));\n    if (!helloed) return;\n    const caps = state.coordinator.seats().map((s) => s.caps);\n    check('hello names protocol 1 and the mode', caps.every((c) => c.v === 1 && modeOf(c.mode) === state.coordinator.mode), JSON.stringify(caps[0]));\n    check('hello seats cover this player count', caps.every((c) => Array.isArray(c.seats) && c.seats[0] <= Math.max(2, n) && c.seats[1] >= n), JSON.stringify(caps[0]?.seats));\n    if (state.cells.some((c) => !c.frame.contentDocument)) {\n      check('frames reachable for synthetic input', false, 'serve the game from the same origin as this harness');\n      return;\n    }\n\n    // The card collects ready: every game readies up by itself once loaded, with no prompt and no key.\n    const loaded = await until(() => copies().every((p) => p.ready), 20_000);\n    check('ready without a key press (the card asks the players)', loaded, copies().filter((p) => !p.ready).map((p) => p.key).join(', '));\n    // A game that shows its own card takes the players' answers on it: Enter is Ready.\n    if (caps.some((c) => c?.card)) {\n      const players = state.cells.filter((c) => !c.server);\n      const sent = await until(() => players.every((c) => c.cardSent), 2000);\n      for (const cell of players) poke(cell, 'Enter');\n      const answered = await until(() => players.every((c) => state.answers.ready.has(c.key)), 3000);\n      check('its own card: Enter answers Ready', sent && answered, players.filter((c) => !state.answers.ready.has(c.key)).map((c) => `${c.key}${c.cardSent ? '' : ' (no card yet)'}`).join(', '));\n    }\n    releaseRound(state);\n    const started = await until(() => state.status?.phase !== 'loading', 15_000);\n    check('the round starts when the card ends', started && copies().every((p) => p.ready), copies().filter((p) => !p.ready).map((p) => p.key).join(', ') || state.status?.phase);\n    if (!started || state.record) return;\n\n    await until(() => state.status.phase === 'playing' || state.record, TIMINGS.countdownMs + 2000);\n    const arrows = ['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'a', 'd', 'w', 's'];\n    const randomly = async (ms) => {\n      const end = performance.now() + ms;\n      while (performance.now() < end && !state.record) {\n        for (const cell of state.cells) if (!cell.gone && !cell.server) poke(cell, arrows[Math.floor(Math.random() * arrows.length)]);\n        await sleep(150);\n      }\n    };\n    await randomly(Math.min(1500, playMs / 4));\n\n    const mode = state.coordinator.mode;\n    // Parallel and ghost: every copy runs its own world from the same seeded start. A game\n    // still tagged race was built to race's contract: no seeded start, and no progress asked.\n    const own = SELF_REPORTED.includes(mode);\n    const legacyRace = own && !seedsRandom(m?.mode);\n    if (own && !legacyRace) {\n      const seeded = state.cells.every((c) => c.frame.contentWindow?.AIHub?.seeded === true);\n      check(`${mode}: Math.random is seeded, the same on every copy`, seeded, state.cells.map((c) => `${c.key}: client ${c.frame.contentWindow?.AIHub?.version ?? '?'} seeded ${c.frame.contentWindow?.AIHub?.seeded}`).join('; '));\n    }\n\n    if (scenario === 'host-leave') removeCell(state.cells[0]);\n    else if (n >= 3) removeCell(state.cells[n - 1]);\n    await randomly(playMs / 2);\n    const remaining = state.cells.filter((c) => !c.gone);\n    if (own) {\n      if (mode === 'parallel') {\n        check('parallel: no game traffic', state.cells.every((c) => c.bridge.stats.sent === 0),\n          state.cells.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      } else {\n        check('ghost: every copy sends its player', remaining.every((c) => c.bridge.stats.sent > 0) || n === 1,\n          remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent}`).join(' '));\n      }\n      if (!legacyRace) check(`${mode}: every copy reports its progress`, remaining.every((c) => c.progress.length > 0 || state.status?.players.find((p) => p.key === c.key)?.result),\n        remaining.map((c) => `${c.key}: ${c.progress.length} report${c.progress.length === 1 ? '' : 's'}`).join(', '));\n    } else {\n      check('game traffic flows both ways', remaining.every((c) => c.bridge.stats.sent > 0 && c.bridge.stats.received > 0) || n === 1,\n        remaining.map((c) => `${c.key} ↑${c.bridge.stats.sent} ↓${c.bridge.stats.received}`).join(' '));\n    }\n\n    if (!state.record) state.coordinator.timeUp();\n    const ended = await until(() => state.record, TIMINGS.graceMs + 2000);\n    const record = state.record;\n    if (serverMode) {\n      // The world ran on the server: the players heard it, and only the host may finish a shared world.\n      const serverCell = state.cells.find((c) => c.server);\n      check('a copy with no player of its own runs the world (as a server would)', ended && record.status === 'played' && record.hostId === serverCell.bridge.me && serverCell.bridge.stats.sent > 0,\n        record ? `${record.status} (${record.reason}), host ${record.hostId}, server sent ${serverCell.bridge.stats.sent}` : 'no end');\n    }\n    if (scenario === 'host-leave' && !SELF_REPORTED.includes(state.coordinator.mode)) {\n      check('host leaving voids the round', ended && record.status === 'void' && record.endReason === 'host-left', record ? `${record.status} (${record.reason})` : 'no end');\n    } else {\n      check('the round ends with a valid result', ended && record.status === 'played', record ? `${record.status} (${record.reason})` : 'no end within the grace period');\n    }\n    await sleep(300);\n    check('every remaining copy is told the round ended', remaining.every((c) => c.bridge.ended), remaining.filter((c) => !c.bridge.ended).map((c) => c.key).join(', '));\n    const issues = [...(state.status?.issues ?? []), ...state.cells.flatMap((c) => c.bridge.issues)];\n    check('no protocol problems', issues.length === 0, issues.map((i) => `${i.key}: ${i.problem}`).join('; '));\n    const violations = state.cells.flatMap((c) => {\n      let extra = [];\n      try {\n        extra = c.frame.contentWindow?.__hubViolations ?? [];\n      } catch {}\n      return [...c.violations, ...extra].map((v) => `${c.key}: ${v}`);\n    });\n    check('no errors, dialogs, popups or sockets', violations.length === 0, violations.slice(0, 6).join('; '));\n  } catch (error) {\n    check('harness ran', false, String(error?.stack || error));\n  } finally {\n    report.pass = checks.length > 0 && checks.every((c) => c.pass);\n    report.done = true;\n    document.body.dataset.complete = 'true';\n    log(`conformance: ${report.pass ? 'PASS' : 'FAIL'}`);\n  }\n}\n","exit_code":0,"status":"completed"}}
