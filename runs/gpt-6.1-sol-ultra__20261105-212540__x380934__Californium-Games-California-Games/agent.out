e/K.\"><meta name=\"hub:session-minutes\" content=\"3.3\">\n<title>Californium Games — A golden coast sports festival</title>\n<script type=\"importmap\">{\"imports\":{\"three\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/webgpu\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.webgpu.js\",\"three/tsl\":\"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.tsl.js\"}}</script>\n<style>/*STYLE*/</style></head><body>\n<div id=\"view\"></div>\n<div id=\"hud\" hidden><div class=\"hud-top\"><div class=\"hud-event\"><small id=\"hud-count\">EVENT 1 / 3</small><strong id=\"hud-event\">HALF-PIPE</strong><p id=\"hud-rider\">RIDER 1</p></div><div class=\"hud-right\"><div class=\"hud-score\"><div class=\"score-label\">STYLE POINTS</div><div class=\"score\" id=\"hud-score\">0</div></div><div class=\"hud-timer\"><b id=\"hud-time\">60</b><small>SECONDS</small></div></div></div><div class=\"hud-bottom\"><div class=\"hud-prompts\"><span><kbd data-key=\"move\">A D / ← →</kbd>STEER</span><span><kbd data-key=\"pop\">SPACE</kbd>POP</span><span><kbd data-key=\"grab\">J</kbd>GRAB</span><span><kbd data-key=\"flip\">K</kbd>FLIP</span><span><kbd data-key=\"pause\">ESC</kbd>MENU</span></div><div class=\"meters\"><div class=\"meter-label\"><span id=\"flow-label\">MOMENTUM</span></div><div class=\"meter\"><i id=\"flow-meter\"></i></div><div class=\"meter-label\"><span>MEDAL</span><span id=\"medal-label\">SUN-SEEKER</span></div><div class=\"meter\"><i id=\"medal-progress\"></i></div></div></div></div>\n<div id=\"combo\" class=\"combo\" hidden><strong id=\"combo-points\">0 × 1</strong><p id=\"combo-name\">METHOD GRAB</p></div><div id=\"trick-call\"></div><div id=\"toast\" class=\"toast\"></div><div id=\"live-standings\" hidden></div>\n<div id=\"attract\" hidden>POSTCARD IN MOTION<span>DEMO PLAY · PRESS ANYTHING TO JOIN THE GOOD TIMES</span></div>\n<div id=\"overlay\">\n<section class=\"panel\" id=\"loading-panel\"><div class=\"eyebrow\">OPENING THE COAST</div><h2>GOOD TIMES<br>AHEAD.</h2><div class=\"loading-dot\"></div><p id=\"loading-copy\">Packing boards, bikes, and impossibly good weather…</p><button id=\"loading-retry\" class=\"secondary\" onclick=\"location.reload()\" hidden>TRY AGAIN</button></section>\n<section class=\"panel\" id=\"title-panel\" hidden><div class=\"eyebrow\">THE PACIFIC COAST · SUMMER '\"'88-ISH</div><h1><span class=\\\"outline\\\">CALIFORNIUM</span><span class=\\\"orange\\\">GAMES</span></h1><div class=\\\"stamp\\\"><span>✳</span> LOCALLY GROWN. FULLY RAD.</div><p class=\\\"title-sub\\\">Chase the swell. Catch some air.<br>Make a little coast-to-coast history.</p><div class=\\\"menu\\\"><button id=\\\"start\\\" class=\\\"primary\\\"><kbd data-key=\\\"accept\\\">ENTER</kbd>RIDE THE FESTIVAL <span style=\\\"float:right\\\">↗</span></button><div class=\\\"split\\\"><button id=\\\"start-hotseat\\\">COUCH CREW · TAKE TURNS</button><button id=\\\"hotseat\\\" aria-label=\\\"Change local player count\\\" title=\\\"Change local player count\\\">2–4</button></div><button id=\\\"practice\\\">PICK A SPORT <span style=\\\"float:right\\\">＋</span></button></div><div class=\\\"subnav\\\"><button class=\\\"text-button\\\" id=\\\"online\\\">ONLINE ROOMS</button><button class=\\\"text-button\\\" id=\\\"settings\\\">SETTINGS</button><button class=\\\"text-button\\\" id=\\\"about\\\">ABOUT</button></div><div class=\\\"fine\\\" id=\\\"title-best\\\">THREE EVENTS. ONE GOLDEN COAST.</div></section>\n<section class=\\\"panel\\\" id=\\\"brief-panel\\\" hidden><div class=\\\"eyebrow\\\" id=\\\"brief-num\\\"></div><h2 id=\\\"brief-title\\\"></h2><p class=\\\"tagline\\\" id=\\\"brief-tag\\\"></p><p class=\\\"goal\\\" id=\\\"brief-goal\\\"></p><div id=\\\"brief-guide\\\"></div><div class=\\\"medals\\\" id=\\\"brief-medals\\\"></div><div class=\\\"button-row\\\"><button class=\\\"primary\\\" id=\\\"brief-go\\\"><kbd data-key=\\\"accept\\\"></kbd>LET'S RIDE</button><button class=\\\"text-button\\\" id=\\\"brief-back\\\">BACK</button></div></section>\n<section class=\\\"panel\\\" id=\\\"practice-panel\\\" hidden><div class=\\\"eyebrow\\\">YOUR AFTERNOON. YOUR RULES.</div><h2>PICK YOUR<br>GOOD TIME.</h2><p class=\\\"goal\\\">One sport. One minute. Unlimited do-overs.</p><div class=\\\"menu\\\"><button data-event=\\\"0\\\">01 &nbsp; HALF-PIPE HEAT</button><button data-event=\\\"1\\\">02 &nbsp; SALTWATER SWING</button><button data-event=\\\"2\\\">03 &nbsp; BOARDWALK BMX</button></div><button id=\\\"practice-back\\\" class=\\\"text-button\\\">BACK TO THE COAST</button></section>\n<section class=\\\"panel\\\" id=\\\"result-panel\\\" hidden><div class=\\\"eyebrow\\\" id=\\\"result-eyebrow\\\"></div><h2 id=\\\"result-medal\\\"></h2><div class=\\\"big-score\\\" id=\\\"result-score\\\"></div><p class=\\\"result-copy\\\" id=\\\"result-copy\\\"></p><div class=\\\"medals\\\" id=\\\"result-detail\\\"></div><button class=\\\"primary\\\" id=\\\"result-next\\\">NEXT EVENT</button></section>\n<section class=\\\"panel\\\" id=\\\"festival-panel\\\" hidden><div class=\\\"eyebrow\\\">THE SUN SETS. THE LEGEND STAYS.</div><h2>COAST<br>COMPLETE.</h2><p class=\\\"result-copy\\\" id=\\\"festival-copy\\\"></p><div id=\\\"podium-list\\\"></div><div class=\\\"button-row\\\" style=\\\"margin-top:25px\\\"><button class=\\\"primary\\\" id=\\\"festival-again\\\">ONE MORE SUMMER</button><button class=\\\"text-button\\\" id=\\\"festival-home\\\">TITLE SCREEN</button></div></section>\n<section class=\\\"panel\\\" id=\\\"pause-panel\\\" hidden><div class=\\\"eyebrow\\\">TAKE A BREATHER</div><h2>STILL<br>SUMMER.</h2><div class=\\\"menu\\\"><button class=\\\"primary\\\" id=\\\"resume\\\"><kbd data-key=\\\"accept\\\"></kbd>KEEP RIDING</button><button id=\\\"pause-settings\\\">SETTINGS</button><button id=\\\"pause-dev\\\">DEV WORKSHOP</button><button id=\\\"pause-about\\\">ABOUT / CREDITS</button><button id=\\\"pause-quit\\\">BACK TO THE COAST</button></div></section>\n<section class=\\\"panel\\\" id=\\\"settings-panel\\\" hidden><div class=\\\"eyebrow\\\">DIAL IN YOUR DAY</div><h2>GOOD<br>VIBRATIONS.</h2><label>Music <output id=\\\"music-value\\\">10%</output><input id=\\\"music\\\" aria-label=\\\"Music volume\\\" type=\\\"range\\\" min=\\\"0\\\" max=\\\"1\\\" step=\\\".01\\\" value=\\\".1\\\"></label><label>Effects & chatter <output id=\\\"effects-value\\\">55%</output><input id=\\\"effects\\\" aria-label=\\\"Effects volume\\\" type=\\\"range\\\" min=\\\"0\\\" max=\\\"1\\\" step=\\\".01\\\" value=\\\".55\\\"></label><div class=\\\"menu\\\" style=\\\"margin:22px 0\\\"><button id=\\\"glyphs\\\">CONTROLLER GLYPHS: PLAYSTATION</button><button id=\\\"motion\\\">CAMERA MOTION: FULL</button><button id=\\\"fullscreen\\\">FULLSCREEN</button></div><button id=\\\"settings-back\\\" class=\\\"primary\\\">ALL SET</button></section>\n<section class=\\\"panel\\\" id=\\\"dev-panel\\\" hidden><div class=\\\"eyebrow\\\">SANDBOX / LIVE TUNING</div><h2>THE RAD LAB.</h2><div id=\\\"dev-sliders\\\"></div><div class=\\\"compact-menu\\\"><button class=\\\"secondary\\\" id=\\\"dev-bot\\\">AUTO RIDER: OFF</button><button class=\\\"secondary\\\" id=\\\"dev-infinite\\\">INFINITE TIME: OFF</button><button class=\\\"secondary\\\" id=\\\"dev-restart\\\">RESTART HEAT</button><button class=\\\"secondary\\\" id=\\\"dev-next\\\">NEXT SPORT</button><button class=\\\"secondary\\\" id=\\\"dev-bank\\\">ADD 1000 POINTS</button><button class=\\\"secondary\\\" id=\\\"dev-reset\\\">RESET DEFAULTS</button></div><p id=\\\"dev-stats\\\"></p><button id=\\\"dev-back\\\" class=\\\"primary\\\">BACK</button></section>\n<section class=\\\"panel\\\" id=\\\"online-panel\\\" hidden><div class=\\\"eyebrow\\\">SAME SUN. DIFFERENT SOFAS.</div><h2>COAST<br>CONNECTION.</h2><p class=\\\"goal\\\">Up to four riders. Three synchronized heats. Highest total wins.</p><div class=\\\"menu\\\"><button class=\\\"primary\\\" id=\\\"online-create\\\">CREATE A ROOM</button></div><input id=\\\"room-code\\\" aria-label=\\\"Room code\\\" type=\\\"text\\\" maxlength=\\\"6\\\" placeholder=\\\"ROOM CODE\\\" autocomplete=\\\"off\\\"><div class=\\\"button-row\\\"><button class=\\\"secondary\\\" id=\\\"online-join\\\">JOIN ROOM</button><button class=\\\"secondary\\\" id=\\\"online-leave\\\">LEAVE ROOM</button></div><div id=\\\"online-status\\\">Room codes connect over public PeerJS signaling. Internet required.</div><div id=\\\"online-room\\\"></div><p id=\\\"online-riders\\\"></p><button id=\\\"online-start\\\" class=\\\"primary\\\" hidden>START THE FESTIVAL</button><div style=\\\"margin-top:20px\\\"><button id=\\\"online-back\\\" class=\\\"text-button\\\">BACK</button></div></section>\n<section class=\\\"panel\\\" id=\\\"about-panel\\\" hidden><div class=\\\"eyebrow\\\">THE PEOPLE & THE PIXELS</div><h2>POSTCARDS<br>& CREDITS.</h2><p style=\\\"font-size:15px;line-height:1.6\\\">An original, unofficial love letter to California Games (1988). All coast, characters, sounds, and music are generated in code. No original game assets are used.</p><div id=\\\"about-content\\\"></div><button id=\\\"about-back\\\" class=\\\"primary\\\">BACK TO THE SUN</button></section>\n</div><div class=\\\"screen-decoration\\\">3 SPORTS.<span>NO BAD DAYS.</span></div><div class=\\\"footer-mark\\\" id=\\\"engine-tag\\\">THREE r180 · WEBGPU · RAPIER 0.19.3</div><button id=\\\"touch-menu\\\" aria-label=\\\"Pause menu\\\">Ⅱ</button><button id=\\\"touch-pop\\\" hidden>POP</button>\n<\"'!--CREDITS-->\n<script type=\"module\">/*GAME*/</script></body></html>\nEOF\ncat > Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/build.py <<'\"'EOF'\nfrom pathlib import Path\nimport json\np=Path(__file__).resolve().parent\nname=p.name\nhtml=(p/'template.html').read_text().replace('<\"'!--HUB-->'\"','<script>'+(p/'session.js').read_text()+'</script>').replace('/*STYLE*/',(p/'style.css').read_text())\njs='\\\\n'.join((p/f).read_text().replace(\\\"import * as THREE from 'three';\\\",'') for f in ['art.js','audio.js','network.js'])\nmain=(p/'main.js').read_text()\nfor s in [\\\"import {createArt} from './art.js';\\\", \\\"import {AudioSystem} from './audio.js';\\\", \\\"import {FestivalNetwork} from './network.js';\\\"]:main=main.replace(s,'')\njs=js.replace('export default AudioSystem;','')\nhtml=html.replace('/*GAME*/',js+'\\\\n'+main)\ncredits=p.parent/'exit-interview.json'\nif credits.exists():html=html.replace('<\"'!--CREDITS-->'\"','<script>window.GAME_CREDITS='+credits.read_text().replace('</','<\\\\\\\\/')+'</script>')\n(p.parent/(name+'.html')).write_text(html)\nprint(name+'.html')\nEOF\npython3 Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/build.py\"","aggregated_output":"Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540.html\n","exit_code":0,"status":"completed"}}
