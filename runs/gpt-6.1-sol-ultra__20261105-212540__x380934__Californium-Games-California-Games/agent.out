{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,30p' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/network.js && sed -n '60,77p' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/art.js && sed -n '200,235p' Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/audio.js\"","aggregated_output":"// Standalone room score attack. The AI Hub session client owns its own transport.\nconst ROOM_PREFIX = 'californium-games-';\nconst COLORS = ['#ff6954', '#42bec1', '#b7db61', '#f2bb4c'];\nconst MAX_PLAYERS = 4;\nconst cleanScore = value => Math.max(0, Math.min(1e9, Math.round(Number(value) || 0)));\nconst roomCode = () => Array.from(crypto.getRandomValues(new Uint8Array(6)), n => 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'[n % 32]).join('');\nlet peerModule;\nasync function getPeer() {\n  if (globalThis.Peer) return globalThis.Peer;\n  peerModule ||= import('https://esm.sh/peerjs@1.5.5?bundle');\n  return (await peerModule).default;\n}\nexport class FestivalNetwork {\n  constructor({ onStart = () => {}, onScores = () => {}, onStatus = () => {} } = {}) {\n    this.onStart = onStart; this.onScores = onScores; this.onStatus = onStatus;\n    this.peer = null; this.connections = new Map(); this.hostConnection = null;\n    this.room = ''; this.isHost = false; this.me = 0; this.players = [];\n    this.connected = false; this.running = false; this.round = 0;\n    this._epoch = 0; this._startTimer = null; this._clockOffset = 0;\n    this.status = 'Share a room. Shred together.';\n  }\n  get snapshot() {\n    return { room: this.room, isHost: this.isHost, me: this.me, players: this.players.map(p => ({ ...p })), connected: this.connected, running: this.running, round: this.round, status: this.status };\n  }\n  _status(text) { this.status = text; this.onStatus(text, this.snapshot); }\n  _scores() { this.onScores(this.players.map(p => ({ ...p }))); }\n  _player(id) { return { id, name: `Rider ${id + 1}`, color: COLORS[id], event: 'lobby', score: 0, total: 0, finished: false, connected: true }; }\n  _send(connection, data) { if (connection?.open) { try { connection.send(data); } catch { /* The close handler removes disconnected riders. */ } } }\n  _broadcast(data) { for (const connection of this.connections.values()) this._send(connection, data); }\n  _publish() { this._broadcast({ type: 'roster', players: this.players, round: this.round, running: this.running }); this._scores(); }\n  for(let j=0;j<26;j++){const z=-12+j*.75;const h=waveHeight(z);box(surf,0,h*.4-.2,z,48,.17,.85,[0x237c89,0x29989d,0x38aba8,0x61c3b4][Math.floor(j/7)%4],false);}\n  for(let j=0;j<9;j++){let z=-6+j*1.1;box(surf,0,.06,z,47,.035,.07,0x9fddc6,false);}\n  const crest=new THREE.Group();surf.add(crest);for(let i=0;i<35;i++){let x=-23+i*1.4;ball(crest,x,2.3+Math.sin(i*.6)*.18,-9,.7,0xe3eed2);ball(crest,x+.3,1.8,-8.6,.55,C.aqua);}\n  for(let x of [-17,17]){cyl(surf,x,.4,1,.28,.8,C.coral);ball(surf,x,.85,1,.35,C.yellow);pennant(surf,x,3.3,1,C.cream);}\n  // Far-side surf judges' hut.\n  box(surf,-21,1.1,10,5,2.2,3,C.cream);box(surf,-21,2.5,10,6,.5,4,C.coral);textPanel(surf,'WAVE GOODBYE',-21,1.8,11.53,4.5,.65,C.cream,C.ink);\n  // BMX dirt course and sculpted launch rollers.\n  const bmx=arenas.bmx;box(bmx,0,-.1,0,49,.2,9,0xcd9b6d,false);\n  const rampSpecs=[[-9,3,3],[3,3,3],[15,3,3]];\n  function rampHeight(x){let h=0;for(const [cx,w,hh] of rampSpecs){if(x>=cx-w&&x<=cx)h=Math.max(h,(x-(cx-w))/w*hh);}return h;}\n  stripSurface(bmx,rampHeight,-22,22,-3.5,3.5,0xe4b078,176);\n  for(let z of [-3.52,3.52]){for(const [cx,w,hh] of rampSpecs){const sh=new THREE.Shape();sh.moveTo(cx-w,0);sh.lineTo(cx,hh);sh.lineTo(cx,0);const s=mesh(new THREE.ShapeGeometry(sh),C.coral,bmx,0,0,z,false);s.material=new THREE.MeshStandardMaterial({color:C.coral,roughness:1,side:THREE.DoubleSide});}}\n  for(let x=-21;x<23;x+=3){box(bmx,x,.025,0,1.3,.03,.13,C.cream,false);for(let z of [-4.4,4.4]){cyl(bmx,x,.35,z,.1,.7,C.cream);rod(bmx,[x,.65,z],[x+3,.65,z],.04,C.teal);}}\n  for(let x of [-18,18]){rod(bmx,[x,0,-4.3],[x,5,-4.3],.1,C.ink);rod(bmx,[x,0,4.3],[x,5,4.3],.1,C.ink);box(bmx,x,4.8,0,.25,.8,9,C.teal);const sign=textPanel(bmx,x<0?'PEDAL TO THE METAL':'RAD TO THE BONE',x,4.8,0,8,.65,C.teal,C.cream);sign.rotation.y=Math.PI/2;}\n  for(let i=0;i<18;i++)person(bmx,-19+i*2.2,0,-5.7,[C.yellow,C.coral,C.teal][i%3],.85);\n  textPanel(bmx,'DIRT / STYLE / GLORY',0,.62,4.6,10,1.1,C.coral,C.cream);\n  // Articulated athlete; animation tracks target named joints.\n  const athlete=new THREE.Group();scene.add(athlete);const rig=new THREE.Group();rig.name='rider';athlete.add(rig);\n    if (this.context && this.unlocked && this.context.state === 'suspended') this.context.resume().catch(() => {});\n  }\n  getDiagnostics() {\n    let rms = 0, peak = 0;\n    if (this.analyser) {\n      const samples = new Float32Array(this.analyser.fftSize);\n      this.analyser.getFloatTimeDomainData(samples);\n      for (const sample of samples) { rms += sample * sample; peak = Math.max(peak, Math.abs(sample)); }\n      rms = Math.sqrt(rms / samples.length);\n    }\n    return {unlocked: this.unlocked, state: this.context?.state || 'locked', musicVolume: this.musicVolume,\n      effectsVolume: this.effectsVolume, musicSteps: this.step, eventsPlayed: this.eventsPlayed,\n      syllablesPlayed: this.syllablesPlayed, rms, peak, paused: this.paused};\n  }\n  async testOffline() {\n    const Offline = globalThis.OfflineAudioContext || globalThis.webkitOfflineAudioContext;\n    if (!Offline) return {supported: false, rms: 0, peak: 0, nonzeroFrames: 0};\n    const ctx = new Offline(1, 44100 * 3, 44100);\n    const music = ctx.createGain(); music.gain.value = 0.10; music.connect(ctx.destination);\n    const effects = ctx.createGain(); effects.gain.value = 0.55; effects.connect(ctx.destination);\n    const buffer = noiseBuffer(ctx);\n    for (let s = 0; s < 16; s++) musicStep(ctx, music, buffer, s, 0.03 + s * RHYTHM, 'surf');\n    tone(ctx, effects, 0.12, 210, 0.15, 0.18, 'triangle', {endFrequency: 620});\n    hiss(ctx, effects, buffer, 0.65, 0.1, 0.14, 850, true);\n    [72, 76, 79].forEach((n, i) => tone(ctx, effects, 1 + i * 0.055, midi(n), 0.22, 0.14, 'triangle'));\n    [1, 0, 2, 4, 0].forEach((v, i) => syllable(ctx, effects, 1.5 + i * 0.105, 255 * [1, 1.3, 1.12, 1.5, 1.2][i], v, 0.09, 0.065));\n    const rendered = await ctx.startRendering();\n    const samples = rendered.getChannelData(0);\n    let rms = 0, peak = 0, nonzeroFrames = 0;\n    for (const sample of samples) {rms += sample * sample; peak = Math.max(peak, Math.abs(sample)); if (Math.abs(sample) > 0.00001) nonzeroFrames++;}\n    return {supported: true, rms: Math.sqrt(rms / samples.length), peak, nonzeroFrames, frames: samples.length,\n      musicVolume: 0.10, effectsVolume: 0.55, duration: 3};\n  }\n}\n\nexport default AudioSystem;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/main.js'\ns=open(p).read().replace(\\\"return state.screen==='playing'||attract\\\",\\\"return state.screen==='playing'\\\").replace('p.seat+1','p.id+1')\ns=s.replace('state.started=true;buildPhysics();','state.started=true;state.bestCombo=0;state.bails=0;state.landings=0;buildPhysics();')\ns=s.replace('return (x-(c-3))/3*2.2','return (x-(c-3))/3*3').replace('Math.atan(2.2/3)','Math.atan(3/3)')\ns=s.replace(\\\"\"'$('\"'hotseat').textContent=\"'`COUCH CREW  ·  ${playerCount} RIDERS`\",\"$('\"'start-hotseat').textContent=\"'`COUCH CREW · ${playerCount} RIDERS`; $('\"'hotseat').textContent='＋'\\\")\nopen(p,'w').write(s)\nPY\npython3 Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/build.py\ncat > Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/smoke.py <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json\np=Path(__file__).resolve().parent\nwith sync_playwright() as pw:\n b=pw.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--no-sandbox'])\n page=b.new_page(viewport={'width':1600,'height':1000},device_scale_factor=1)\n errors=[]\n page.on('pageerror',lambda e: errors.append(str(e)))\n page.goto('http://127.0.0.1:35981/'+p.name+'.html',wait_until='networkidle',timeout=90000)\n page.wait_for_function('window.__game?.state.ready',timeout=90000)\n print(json.dumps({'title':page.title(),'state':page.evaluate('__game.state'),'errors':errors}))\n page.screenshot(path=str(p/'title.png'))\n page.click('#start');page.click('#brief-go');page.evaluate('__game.setBot(true)');page.wait_for_timeout(4500)\n print(json.dumps({'state':page.evaluate('__game.state'),'errors':errors}))\n page.screenshot(path=str(p/'game.png'))\n b.close()\nPY\n/home/micha/.local/share/pipx/venvs/playwright/bin/python Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/smoke.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
