&&!pad.buttons[8]?.pressed)pause();if(isPlay()){if(edges[0])pressed.add('Space');if(edges[2])pressed.add('KeyJ');if(edges[1])pressed.add('KeyK')}else{if(edges[12])navigate(-1);if(edges[13])navigate(1);if(edges[0])document.activeElement?.click();if(edges[1])back();if((edges[14]||edges[15])&&document.activeElement?.type==='range'){const el=document.activeElement;el.value=+el.value+(edges[15]?1:-1)*+el.step;el.dispatchEvent(new Event('input'))}}pad.buttons.forEach((b,i)=>padPrev[i]=b.pressed);return{x:axis,y:ay}}\n    55\tfunction controls(pad){let x=clamp((keys.has('KeyD')||keys.has('ArrowRight')?1:0)-(keys.has('KeyA')||keys.has('ArrowLeft')?1:0)+pad.x+touch.moveX,-1,1),y=clamp((keys.has('KeyS')||keys.has('ArrowDown')?1:0)-(keys.has('KeyW')||keys.has('ArrowUp')?1:0)+pad.y+touch.moveY,-1,1);if(bot||attract){const p=body.translation();x=state.event==='surf'?clamp((targetX-p.x)*.65,-1,1):state.event==='bmx'?1:dir;y=1;if(lastGround&&(state.event==='skate'?Math.abs(p.x)>8:state.event==='bmx'?[-9,3,15].some(c=>p.x>c-.8&&p.x<c+.5):state.elapsed%3<.08))pressed.add('Space');if(state.airborne&&airTime>.18&&airTime<.5)pressed.add('KeyJ');if(state.airborne&&airTime>.55&&airTime<.8)pressed.add('KeyK')}if(inputKind==='touch'&&state.airborne&&airTime>.2&&airTime<.3)pressed.add('KeyJ');return{x,y}}\n    56\tfunction step(dt,pad){if(hubEnded)return;if(state.crashed){crashTime-=dt;if(crashTime<=0){state.crashed=false;const p=body.translation();body.setTranslation({x:clamp(p.x,-11,11),y:height(clamp(p.x,-11,11))+.42,z:0},true);body.setLinvel({x:0,y:0,z:0},true);pipeSpeed=8;lastGround=true}return}state.elapsed+=dt;eventElapsed+=dt;if(!infinite)state.time-=dt;if(state.time<=0){finishEvent();return}const c=controls(pad);let p=body.translation(),v=body.linvel();if(pressed.has('Space'))jump();if(pressed.has('KeyJ'))trick('grab');if(pressed.has('KeyK'))trick('flip');v=body.linvel();let vx=v.x;\n    57\tif(state.event==='skate'){if(p.x>12.3&&v.y<0)dir=-1;if(p.x< -12.3&&v.y<0)dir=1;const slope=Math.sign(p.x)*Math.max(0,Math.abs(p.x)-4)/8;pipeSpeed=clamp(pipeSpeed+(c.y>.3?2.7:0)*dt-(Math.sign(vx)*slope*10)*dt,6,16);if(Math.abs(p.x)<8&&Math.abs(c.x)>.3)dir=Math.sign(c.x);vx=dir*pipeSpeed*config.speed;if(Math.abs(p.x)>15){dir=-Math.sign(p.x);vx=dir*10} }\n    58\tif(state.event==='bmx'){vx=(7.5+c.x*4+(c.y>.3?1:0))*config.speed;if(p.x>18){body.setTranslation({x:-18,y:Math.max(.42,p.y),z:0},true);p=body.translation();toast('ONE MORE LAP. MAKE IT COUNT.')}const hazard=[-4.6,7.4].find(x=>Math.abs(p.x-x)<.5);if(hazard&&p.y<1.15&&state.elapsed>1.5){bail('CONE CRUNCH');return}}\n    59\tif(state.event==='surf'){targetX=Math.sin(state.elapsed*.63)*10;vx=clamp(v.x+c.x*18*dt-v.x*2.5*dt,-10,10)*config.speed;if(Math.abs(p.x)>15)vx=-Math.sign(p.x)*4;const surface=height(p.x);if(p.y<surface+.55&&v.y<2){v.y+=(surface+.42-p.y)*55*dt;v.y+=config.gravity*dt*.95}flowClock+=dt;if(Math.abs(p.x-targetX)<2.5&&!state.airborne){state.flow=clamp(state.flow+dt*.6,0,1);if(flowClock>.55){state.score+=Math.round(35+state.flow*45);flowClock=0;audio.sfx('score');publish()}}else state.flow=Math.max(0,state.flow-dt*.25);foamClock+=dt;const buoyX=-Math.sin(state.elapsed*.37+1.2)*11;if(Math.abs(p.x-buoyX)<.72&&p.y<surface+1&&foamClock>5){foamClock=0;bail('BUOY OH BUOY');return}}\n    60\tbody.setLinvel({x:vx,y:v.y,z:0},true);world.gravity.y=-config.gravity;world.timestep=dt;world.step();stats.physicsSteps++;p=body.translation();v=body.linvel();let ground=height(p.x),grounded=p.y<=ground+.46&&v.y<2;\n    61\tif(state.event==='bmx'&&[-9,3,15].some(c=>p.x>c&&p.x<c+.8)&&p.y>1)grounded=false;\n    62\tif(p.y<ground+.36&&v.y<0){body.setTranslation({x:p.x,y:ground+.4,z:0},true);body.setLinvel({x:vx,y:0,z:0},true);grounded=true;p=body.translation()}\n    63\tif(grounded&&!lastGround){let angle=Math.abs(Math.atan2(Math.sin(state.rotation),Math.cos(state.rotation)));if(angle>1.2+config.assist*2||p.y< -5)bail('ROUGH LANDING');else bank();state.rotation=0;airTime=0;state.trick=''}\n    64\tif(!grounded){airTime+=dt;state.rotation*=Math.exp(-dt*(2+config.assist*7));}else{airTime=0;state.rotation*=.7}state.airborne=!grounded;lastGround=grounded;state.speed=vx;state.time=Math.max(0,state.time);if(p.y< -8){bail('OUT TO SEA');body.setTranslation({x:0,y:3,z:0},true)}\n    65\t}\n    66\tfunction updateHUD(){const e=EVENTS[state.eventIndex];$('hud-event').textContent=e.short.toUpperCase();$('hud-count').textContent=practice?'FREE SESSION':`EVENT ${state.eventIndex+1} / 3`;const score=state.score.toLocaleString();if($('hud-score').textContent!==score)$('hud-score').textContent=score;$('hud-time').textContent=Math.ceil(state.time).toString().padStart(2,'0');$('hud-time').classList.toggle('urgent',state.time<10);$('combo').hidden=!state.pending;$('combo-points').textContent=`${state.pending} × ${state.mult}`;$('combo-name').textContent=state.combo.slice(-2).join(' + ');$('flow-meter').style.width=`${state.event==='surf'?state.flow*100:clamp(Math.abs(state.speed)/16,0,1)*100}%`;$('flow-label').textContent=state.event==='surf'?'WAVE FLOW':'MOMENTUM';$('medal-label').textContent=medal(state.score);$('medal-progress').style.width=`${Math.min(100,state.score/e.gold*100)}%`;$('hud-rider').textContent=network?.connected?`ONLINE  ·  RIDER ${network.me+1}`:players[currentPlayer]?.name||'RIDER 1';$('live-standings').hidden=!network?.connected;if(network?.connected)$('live-standings').textContent=networkScores.map(p=>`R${p.id+1}  ${p.total||0}`).join('   /   ');$('touch-pop').hidden=inputKind!=='touch'||!isPlay()||!lastGround;}\n    67\tlet marker,buoy;\n    68\tfunction makeMarkers(){marker=new THREE.Mesh(new THREE.TorusGeometry(1.1,.07,8,40),new THREE.MeshBasicMaterial({color:0xffd34f}));art.scene.add(marker);buoy=new THREE.Group();const m=new THREE.Mesh(new THREE.ConeGeometry(.5,1.3,10),new THREE.MeshStandardMaterial({color:0xe7503d,flatShading:true}));m.position.y=.4;buoy.add(m);art.scene.add(buoy)}\n    69\tfunction visual(dt){let p=body?.translation()||{x:-2,y:1,z:0};if(state.screen==='title'||state.screen==='loading'){p={x:-3,y:.5,z:0};state.speed=0;state.airborne=false}art.athlete.position.set(p.x,p.y-.38,p.z);let slope=state.event==='skate'?Math.atan(Math.sign(p.x)*Math.max(0,Math.abs(p.x)-4)/8):state.event==='bmx'&&[-9,3,15].some(c=>p.x>=c-3&&p.x<=c)?Math.atan(3/3):0;art.athlete.rotation.z=state.crashed?-1.4:state.airborne?state.rotation: slope;art.athlete.scale.x=state.event==='skate'?dir:1;art.update(dt,{...state,time:state.elapsed,paused:!isPlay()});marker.visible=buoy.visible=state.event==='surf'&&isPlay();if(marker.visible){marker.position.set(targetX,height(targetX)+1.6,0);marker.rotation.y=Math.sin(state.elapsed)*.25;buoy.position.set(-Math.sin(state.elapsed*.37+1.2)*11,height(-Math.sin(state.elapsed*.37+1.2)*11),0)}if(!reduceMotion)art.camera.position.x+=lookOffset*.02;}\n    70\tfunction loop(t){if(!ready)return;const dt=Math.min(.05,(t-lastRender)/1000||.016);lastRender=t;stats.frames++;const pad=readPad();if(hubStarting&&AIHub.time()>=0){hubStarting=false;practice=false;playerCount=1;makePlayers();state.eventIndex=0;state.event='skate';startEvent()}\n    71\tif(state.screen==='title'&&!AIHub.active&&performance.now()-lastInput>10000){attract=true;bot=true;playerCount=1;practice=false;makePlayers();state.eventIndex=0;state.event='skate';startEvent();$('attract').hidden=false;toast('THE COAST IS CLEAR. PRESS ANYTHING TO PLAY.')}\n    72\tif(isPlay()&&!hubEnded){let remain=dt*config.timeScale;while(remain>0&&isPlay()){const fixed=Math.min(1/60,remain);step(fixed,pad);remain-=fixed}updateHUD();if(t-lastNetwork>900){publish();lastNetwork=t}}\n    73\tvisual(dt);audio.update(dt,{...state,playing:isPlay(),attract});if(toastTime>0){toastTime-=dt;if(toastTime<=0)$('toast').classList.remove('visible')}if(scoreFlash>0){scoreFlash-=dt;$('trick-call').style.opacity=scoreFlash>0?'1':'0'}if(state.screen==='dev')$('dev-stats').textContent=`RAPIER ${stats.physicsSteps} steps · ${stats.frames} frames · ${state.event} · x ${body.translation().x.toFixed(2)} / y ${body.translation().y.toFixed(2)} · ${state.airborne?'AIR':'GROUND'}`;pressed.clear();renderer.render(art.scene,art.camera);}\n    74\tfunction buttons(){const actions={start:()=>{playerCount=1;beginFestival()},hotseat:()=>{playerCount=playerCount%4+1;if(playerCount<2)playerCount=2;$('start-hotseat').textContent=`COUCH CREW · ${playerCount} RIDERS`; $('hotseat').textContent='＋'},'start-hotseat':()=>{if(playerCount<2)playerCount=2;beginFestival()},practice:()=>openPanel('practice'),settings:()=>openPanel('settings'),about:()=>{fillAbout();openPanel('about')},online:()=>openPanel('online'),'brief-go':startEvent,'brief-back':back,'result-next':advance,'festival-again':()=>{if(!AIHub.active){beginFestival()}},'festival-home':()=>{if(!AIHub.active)showTitle()},resume:pause,'pause-settings':()=>openPanel('settings'),'pause-dev':()=>{renderDev();openPanel('dev')},'pause-about':()=>{fillAbout();openPanel('about')},'pause-quit':()=>{if(!AIHub.active&&!network?.running){state.started=false;audio.resume();showTitle()}},'dev-restart':startEvent,'dev-next':()=>{state.eventIndex=(state.eventIndex+1)%3;state.event=EVENTS[state.eventIndex].id;startEvent()},'dev-bank':()=>{state.score+=1000;toast('DEV: +1000');publish()},'dev-reset':()=>{config={...DEFAULTS};renderDev()},'dev-bot':()=>{bot=!bot;$('dev-bot').textContent=`AUTO RIDER: ${bot?'ON':'OFF'}`},'dev-infinite':()=>{infinite=!infinite;$('dev-infinite').textContent=`INFINITE TIME: ${infinite?'ON':'OFF'}`},'touch-menu':pause,'touch-pop':()=>pressed.add('Space'),'online-create':()=>onlineAction('create'),'online-join':()=>onlineAction('join'),'online-start':()=>network?.startFestival(),'online-leave':()=>{network?.disconnect();networkScores=[];$('online-status').textContent='ROOM CLOSED';$('online-start').hidden=true},'settings-back':back,'about-back':back,'dev-back':back,'online-back':back,'practice-back':back};Object.entries(actions).forEach(([id,fn])=>$(id)?.addEventListener('click',()=>{audio.unlock();audio.sfx('click');fn()}));document.querySelectorAll('[data-event]').forEach(b=>b.onclick=()=>{playerCount=1;beginFestival(+b.dataset.event)});$('music').oninput=e=>{audio.setMusic(+e.target.value);$('music-value').textContent=Math.round(e.target.value*100)+'%'};$('effects').oninput=e=>{audio.setEffects(+e.target.value);$('effects-value').textContent=Math.round(e.target.value*100)+'%'};$('glyphs').onclick=()=>{glyphs=glyphs==='ps'?'xbox':'ps';$('glyphs').textContent=`CONTROLLER GLYPHS: ${glyphs==='ps'?'PLAYSTATION':'XBOX'}`;updatePrompts()};$('motion').onclick=()=>{reduceMotion=!reduceMotion;$('motion').textContent=`CAMERA MOTION: ${reduceMotion?'REDUCED':'FULL'}`};$('fullscreen').onclick=()=>{if(!document.fullscreenElement)document.documentElement.requestFullscreen?.().catch(()=>toast('FULLSCREEN IS UNAVAILABLE HERE'));else document.exitFullscreen?.()};}\n    75\tfunction renderDev(){const defs=[['speed','Ride speed',.4,2,.05],['gravity','Gravity',6,30,.5],['jump','Pop strength',4,15,.25],['assist','Landing assist',0,1,.05],['duration','Heat length (next heat)',15,180,5],['timeScale','Simulation speed',.25,2,.05]];$('dev-sliders').innerHTML=defs.map(([id,name,min,max,step])=>`<label>${name}<output id=\"v-${id}\">${config[id]}</output><input data-config=\"${id}\" type=\"range\" min=\"${min}\" max=\"${max}\" step=\"${step}\" value=\"${config[id]}\"></label>`).join('');document.querySelectorAll('[data-config]').forEach(el=>el.oninput=()=>{config[el.dataset.config]=+el.value;$('v-'+el.dataset.config).textContent=el.value})}\n    76\tasync function onlineAction(which){try{if(!network)network=new FestivalNetwork({onStatus:(s,snap)=>{$('online-status').textContent=s;$('online-room').textContent=snap?.room?`ROOM ${snap.room}`:'';$('online-start').hidden=!snap?.isHost||!snap?.connected;},onScores:s=>{networkScores=s;$('online-riders').textContent=s.map(p=>`RIDER ${p.id+1}: ${p.total||0}`).join('  /  ')},onStart:p=>{onlineWaiting=true;$('online-status').textContent='WAX UP. STARTING IN 3…';setTimeout(()=>{onlineWaiting=false;playerCount=1;practice=false;makePlayers();state.eventIndex=0;state.event='skate';startEvent()},Math.max(0,p.startAt-Date.now()))}});if(which==='create')await network.createRoom();else await network.joinRoom($('room-code').value.trim().toUpperCase())}catch(e){$('online-status').textContent=e.message;}}\n    77\tasync function boot(){buttons();updatePrompts();try{await RAPIER.init();art=createArt();renderer=new THREE.WebGPURenderer({antialias:true,alpha:false});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(innerWidth,innerHeight);renderer.setClearColor(0xf9d9ac);renderer.toneMapping=THREE.ACESFilmicToneMapping;renderer.toneMappingExposure=1.15;$('view').appendChild(renderer.domElement);await renderer.init();$('engine-tag').textContent=`THREE r180 · ${renderer.backend.isWebGPUBackend?'WEBGPU':'WEBGL2'} · RAPIER 0.19.3`;makeMarkers();buildPhysics();ready=true;window.addEventListener('resize',()=>{renderer.setSize(innerWidth,innerHeight);art.camera.aspect=innerWidth/innerHeight;art.camera.updateProjectionMatrix()});renderer.setAnimationLoop(loop);if(AIHub.active){$('overlay').hidden=true;$('hud').hidden=true;state.screen='hub-wait';AIHub.on('start',()=>{hubStarting=true});AIHub.on('time-up',()=>reportHub());AIHub.on('end',()=>{hubEnded=true;state.screen='hub-end';audio.suspend();keys.clear();pressed.clear()});hubInfo=await AIHub.connect({mode:'parallel',seats:[1,4]});if(hubInfo)AIHub.ready();else showTitle()}else showTitle()}catch(e){stats.errors.push(e.stack||e.message);$('loading-copy').textContent='COULD NOT LOAD THE COAST. '+e.message;$('loading-retry').hidden=false;console.error(e)}}\n    78\twindow.__game={get state(){return {...state,attract,bot,playerCount,currentPlayer,players:structuredClone(players),config:{...config},ready,renderer:renderer?.backend?.isWebGPUBackend?'webgpu':'webgl2',position:body?{...body.translation()}:null,stats:structuredClone(stats)}},get audio(){return audio},start:(id