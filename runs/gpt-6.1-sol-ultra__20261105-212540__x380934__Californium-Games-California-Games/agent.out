opacity:0;pointer-events:none;transition:.2s;text-align:center;max-width:80vw;z-index:8}.toast.visible{opacity:1;transform:translate(-50%,0)}.toast.good{background:var(--teal)}.toast.bad{background:var(--orange)}#attract{position:fixed;left:50%;top:15vh;transform:translateX(-50%) rotate(-3deg);background:var(--yellow);border:2px solid var(--ink);padding:8px 22px;font-size:16px;font-weight:900;letter-spacing:.12em;box-shadow:3px 3px var(--ink);pointer-events:none;z-index:5}#attract span{display:block;font-size:11px;letter-spacing:.05em;text-align:center;margin-top:3px}.display{font-size:95px;line-height:1;font-weight:900;color:var(--orange)}.big-score{font-size:100px;font-weight:900;line-height:1;margin:12px 0}.result-copy{font-size:21px;line-height:1.5;margin:15px 0;max-width:480px}.standing{display:flex;gap:20px;border-top:2px solid var(--ink);padding:19px 0;font-size:24px;align-items:center}.standing span{font-family:'Barlow Condensed',sans-serif;color:var(--orange);font-size:42px;font-weight:900}.standing b{margin-left:auto}.settings-row,label{display:block;padding:15px 0;border-bottom:1px solid var(--line);font-size:18px;font-weight:700;max-width:500px}output{float:right;color:var(--orange)}input[type=range]{width:100%;accent-color:var(--orange);height:30px;display:block;margin-top:10px}input[type=text]{width:100%;padding:15px;border:2px solid var(--ink);background:var(--cream);text-transform:uppercase;font-size:24px;letter-spacing:.2em;border-radius:4px;margin:16px 0}.compact-menu{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:18px 0}.compact-menu button{font-size:13px;min-height:48px;padding:10px 14px}#dev-panel h2,#about-panel h2{font-size:55px}#dev-sliders{display:grid;grid-template-columns:1fr 1fr;gap:0 25px}#dev-sliders label{font-size:14px}#dev-stats{font-family:monospace;font-size:12px;line-height:1.6;background:#153c3a11;padding:10px;margin:12px 0}#about-panel{width:700px;background:var(--cream);border:2px solid var(--ink);padding:28px;max-h