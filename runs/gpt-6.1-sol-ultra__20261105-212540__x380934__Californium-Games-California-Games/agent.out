ipeHeight(x);rod(half,[x,y+.02,-4.5],[x,y+.02,4.5],.015,0xc18f67);}\n  // Pipe fascia and structural ribs.\n  for(let z of [-4.53,4.53]){const sh=new THREE.Shape();sh.moveTo(-12,-.4);for(let i=0;i<=48;i++){let x=-12+i*.5;sh.lineTo(x,pipeHeight(x));}sh.lineTo(12,-.4);sh.closePath();const f=mesh(new THREE.ShapeGeometry(sh),C.teal,half,0,0,z,false);f.material=new THREE.MeshStandardMaterial({color:C.teal,side:THREE.DoubleSide,roughness:1});for(let x of [-11,-9,-7,7,9,11])box(half,x,pipeHeight(x)/2-.2,z,.12,pipeHeight(x)+.4,.12,C.ink);}\n  for(let side of [-1,1]){rod(half,[side*12,4.07,-4.7],[side*12,4.07,4.7],.1,C.ink);box(half,side*13,3.87,0,2,.3,9.7,C.teal);for(let j=0;j<4;j++)rod(half,[side*13.9,4,j*2.9-4.3],[side*13.9,5.1,j*2.9-4.3],.065,C.cream);rod(half,[side*13.9,5.1,-4.3],[side*13.9,5.1,4.4],.065,C.cream);pennant(half,side*14,7,-4,C.coral);}\n  textPanel(half,'DROP IN. FREAK OUT.',0,-.08,4.6,9,.75,C.teal,C.cream);\n  // Spectators on low bleachers.\n  for(let row=0;row<2;row++){box(half,0,.35+row*.7,-6.4-row*.9,22,.3,.8,C.cream);for(let i=0;i<14;i++)person(half,-10+i*1.5,.55+row*.7,-6.4-row*.9,[C.coral,C.teal,C.yellow,C.purple][(i+row)%4],.8);}\n  // Surf water bowl: concentric face strips make a graphic wave.\n  const surf=arenas.surf;box(surf,0,-.18,0,48,.3,32,C.teal,false);\n  const waveHeight=z=>Math.max(0,-z)*.45;\n  for(let j=0;j<26;j++){const z=-12+j*.75;const h=waveHeight(z);box(surf,0,h*.4-.2,z,48,.17,.85,[0x237c89,0x29989d,0x38aba8,0x61c3b4][Math.floor(j/7)%4],false);}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\np='Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/main.js'\ns=open(p).read().replace('const a=Math.max(0,Math.abs(x)-4);return 4*(a/8)**2','const a=Math.max(0,Math.min(12,Math.abs(x))-4);return 4*(a/8)**2')\ns=s.replace(\\\"const total=players[currentPlayer]?.total||0;const score=total+state.score;\\\",\\\"const p=players[currentPlayer];const total=(p?.total||0)-(p?.scores[state.eventIndex]||0);const score=total+state.score;\\\")\ns=s.replace(\\\"if(state.crashed){crashTime-=dt;\\\",\\\"if(state.crashed){state.time=Math.max(0,state.time-dt);state.elapsed+=dt;if(state.time<=0){finishEvent();return}crashTime-=dt;\\\")\ns=s.replace(\\\"\"'$('\"'hud').hidden=\"'!isPlay();$('\"'attract')\\\",\\\"\"'$('\"'hud').hidden=\"'!isPlay();$('\"'combo').hidden=\"'!isPlay()||!state.pending;$('\"'touch-pop').hidden=\"'!isPlay()||inputKind!=='\"'touch';\"'$('\"'attract')\\\")\ns=s.replace(\\\"if(\"'!reduceMotion)art.camera.position.x=23+lookOffset*.8;\",\"const titleView=['\"'title','loading','brief','settings','about','practice','online'].includes(state.screen)&&\"'!state.started;const camX=titleView?23:state.event==='\"'surf'?8:12;art.camera.position.set(camX+(reduceMotion?0:lookOffset*.7),titleView?17:state.event==='surf'?12:15,titleView?31:state.event==='bmx'?38:34);art.camera.lookAt(0,titleView?2:4,0);if(innerWidth<700){art.camera.position.set(p.x*.45+8,17,43);art.camera.lookAt(p.x*.45,3,0);}\\\")\ns=s.replace(\\\"function showTitle(){state.screen='title';\\\",\\\"function showTitle(){state.started=false;state.screen='title';\\\")\ns=s.replace(\\\"'pause-dev':()=>{renderDev();openPanel('dev')}\\\",\\\"'pause-dev':()=>{if(AIHub.active||network?.running){toast('THE RAD LAB OPENS AFTER THE COMPETITION.');return}renderDev();openPanel('dev')}\\\")\nopen(p,'w').write(s)\nPY\nnode --check Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/main.js\npython3 Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/build.py\ncat > Californium-Games-California-Games-gpt-6.1-sol-ultra-20261105-212540/test_game.py <<'PY'\nfrom playwright.sync_api import sync_playwright\nfrom pathlib import Path\nimport json,sys,threading,http.server,functools,subprocess,time\nP=Path(__file__).resolve().parent\nchecks=0;failures=[]\ndef check(ok,label):\n global checks\n checks+=1\n if not ok:failures.append(label);print('FAIL:',label,flush=True)\nclass Quiet(http.server.SimpleHTTPRequestHandler):\n def log_message(self,*args):pass\nserver=http.server.ThreadingHTTPServer(('127.0.0.1',0),functools.partial(Quiet,directory=str(P.parent)))\nthreading.Thread(target=server.serve_forever,daemon=True).start()\nbase=f'http://127.0.0.1:{server.server_port}/'\nURL=base+P.name+'.html'\nwith sync_playwright() as pw:\n b=pw.chromium.launch(headless=True,args=['--enable-unsafe-webgpu','--enable-features=Vulkan','--use-webgpu-adapter=swiftshader','--no-sandbox'])\n ctx=b.new_context(viewport={'width':1280,'height':800})\n page=ctx.new_page();errors=[];page.on('pageerror',lambda e:errors.append(str(e)))\n try:\n  page.goto(URL,wait_until='domcontentloaded');page.wait_for_function('window.__game?.state.ready',timeout=45000)\n  check('Californium Games' in page.title(),'served page identity')\n  check(page.evaluate('__game.state.screen')=='title','title opens')\n  check(page.evaluate('__game.state.renderer')=='webgpu','WebGPU backend initialized')\n  check(page.evaluate('__game.audio.getDiagnostics().musicVolume')==.1,'music defaults to ten percent')\n  offline=page.evaluate('__game.audio.testOffline()');check(offline['supported'] and offline['nonzeroFrames']>44100 and offline['rms']>.001 and offline['peak']<1,'procedural audio renders without clipping')\n  page.keyboard.press('Enter');page.wait_for_function('__game.state.screen===\\\"brief\\\"');check(page.is_visible('#brief-panel'),'keyboard starts brief')\n  page.keyboa