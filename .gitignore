node_modules/
node_modules
*:Zone.Identifier
runs/.smoke.json
runs/.stop
runs/.session.json
runs/.session.json.tmp
runs/.batches/
runs/*/tmp/

# In a run's work folder, what the agent fetched rather than made stays on the computer that ran it.
# Caches, and clones of the engine and hub: a clone's own .git would go in as a broken submodule link. A clone that's
# just vendor/engine or vendor/hub can't be told from the game's own copy here, so that computer's .git/info/exclude
# lists it.
runs/*/work/**/.cache/
runs/*/work/**/.uv-cache/
runs/*/work/**/engine-upstream/
runs/*/work/**/vendor/*-repo/
runs/*/work/**/vendor/*-upstream/
# The source material a research run downloads: the original game's manual, comic, commercials and footage, magazine
# and box scans, saved web pages, and frames of the original (the agents name those source-*, manual*, original-*).
# They're third-party and copyrighted, and this repo is public. The agents' own notes about them still go in.
runs/*/work/**/*.pdf
runs/*/work/**/*.mp4
runs/*/work/**/*.mov
runs/*/work/**/*.ogv
runs/*/work/**/*.webm
runs/*/work/**/source-*.png
runs/*/work/**/source-*.gif
runs/*/work/**/source-*.jpg
runs/*/work/**/source-*.webp
runs/*/work/**/manual*.png
runs/*/work/**/manual*.webp
runs/*/work/**/original*.png
runs/*/work/**/original*.gif
runs/*/work/**/comic*.png
runs/*/work/**/research*/**/*.png
runs/*/work/**/research*/**/*.gif
runs/*/work/**/research*/**/*.jpg
runs/*/work/**/research*/**/*.webp
runs/*/work/**/research*/**/*.html
runs/*/work/**/reference*/**/*.png
runs/*/work/**/reference*/**/*.gif
runs/*/work/**/reference*/**/*.jpg
runs/*/work/**/reference*/**/*.html
runs/*/work/**/docs/**/*.gif
runs/*/work/**/docs/**/*.jpg
runs/*/work/**/docs/**/*.webp
runs/*/work/**/docs/**/*.html
runs/*/work/**/artifacts/**/*.jpg
